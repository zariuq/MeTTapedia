import Mettapedia.TypeTheory.LocallyThinWhiskeredCellMappingOut
import Mettapedia.TypeTheory.OperationalIntensionalExtensionalLocallyThinModeTheory

/-!
# Point probes force semantic cell thinness

The concrete operational/intensional/extensional semantics has a stronger
property than the locally thin candidate initially required: between the
interpretations of any two parallel modality paths, every two natural
transformations are equal.

The proof is specific to the selected semantic functors.  Each source mode has
a one-point probe.  Point maps out of that probe jointly cover every carrier,
and every modality path preserves this coverage.  Applying any target path to
the probe has a subsingleton carrier.  Naturality along the point maps then
forces two parallel transformations to agree on every element.

This does not say that the ambient categories or their hom-sets are thin.  A
negative control retains the two distinct endomorphisms of the codiscrete
intensional pair.  The theorem concerns natural transformations between the
particular path functors generated by the six selected modalities.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory
namespace OperationalIntensionalExtensionalSemanticThinness

open CategoryTheory CategoryTheory.Bicategory
open LocallyThinCellReflection
open LocallyThinWhiskeredCellBicategory
open LocallyThinWhiskeredCellMappingOut
open OperationalIntensionalExtensionalModes
open OperationalIntensionalExtensionalTwoComputad
open OperationalIntensionalExtensionalLocallyThinModeTheory

universe u

/-! ## Mode-indexed carriers and their one-point probes -/

/-- The concrete category carried by one semantic mode. -/
abbrev SemanticObject (mode : Mode) : Type (u + 1) :=
  semanticPseudofunctor.{u}.obj mode

/-- The underlying carrier of a semantic object. -/
def Carrier : {mode : Mode} → SemanticObject.{u} mode → Type u
  | .operational, object => object.carrier
  | .intensional, object => object.carrier
  | .extensional, object => object.carrier

/-- The underlying function of a semantic morphism. -/
def homFunction : {mode : Mode} → {source target : SemanticObject.{u} mode} →
    (source ⟶ target) → Carrier source → Carrier target
  | .operational, _, _, morphism => morphism.toFun
  | .intensional, _, _, morphism => morphism.toFun
  | .extensional, _, _, morphism => morphism.toFun

@[simp] theorem homFunction_comp
    {mode : Mode} {first middle last : SemanticObject.{u} mode}
    (earlier : first ⟶ middle) (later : middle ⟶ last)
    (element : Carrier first) :
    homFunction (earlier ≫ later) element =
      homFunction later (homFunction earlier element) := by
  cases mode <;> rfl

@[simp] theorem homFunction_id
    {mode : Mode} {object : SemanticObject.{u} mode}
    (element : Carrier object) :
    homFunction (𝟙 object) element = element := by
  cases mode <;> rfl

/-- Morphisms in every selected semantic mode are determined by their carrier
functions. -/
theorem semanticHom_ext
    {mode : Mode} {source target : SemanticObject.{u} mode}
    {left right : source ⟶ target}
    (equal : ∀ element, homFunction left element = homFunction right element) :
    left = right := by
  cases mode with
  | operational => exact DynHom.ext equal
  | intensional => exact RouteHom.ext equal
  | extensional => exact ExtHom.ext equal

/-- A one-point object in each semantic mode. -/
def pointProbe : (mode : Mode) → SemanticObject.{u} mode
  | .operational => ⟨ULift.{u} Unit, fun _ _ => False⟩
  | .intensional => ⟨ULift.{u} Unit, Eq, fun _ => rfl⟩
  | .extensional => ⟨ULift.{u} Unit⟩

/-- The unique carrier point of the mode-indexed probe. -/
def probePoint (mode : Mode) : Carrier (pointProbe mode) := by
  cases mode <;> exact ULift.up ()

/-- Every carrier element determines a morphism from the corresponding
one-point probe. -/
def pointMap {mode : Mode} (object : SemanticObject.{u} mode)
    (element : Carrier object) : pointProbe mode ⟶ object := by
  cases mode with
  | operational =>
      exact ⟨fun _ => element, fun step => False.elim step⟩
  | intensional =>
      exact ⟨fun _ => element, fun _route => object.route_refl element⟩
  | extensional =>
      exact ⟨fun _ => element⟩

@[simp] theorem pointMap_apply
    {mode : Mode} (object : SemanticObject.{u} mode)
    (element : Carrier object) :
    homFunction (pointMap object element) (probePoint mode) = element := by
  cases mode <;> rfl

/-! ## Subsingleton probes survive every modality path -/

/-- The underlying carrier of an object is a subsingleton. -/
def CarrierSubsingleton {mode : Mode}
    (object : SemanticObject.{u} mode) : Prop :=
  ∀ left right : Carrier object, left = right

theorem uliftUnit_allEq (left right : ULift.{u} Unit) : left = right := by
  cases left with
  | up leftValue =>
      cases right with
      | up rightValue =>
          cases leftValue
          cases rightValue
          rfl

theorem quotient_carrier_subsingleton
    {α : Type u} {relation : α → α → Prop}
    (thin : ∀ left right : α, left = right) :
    ∀ left right : Quot relation, left = right := by
  intro left right
  induction left using Quot.ind with
  | _ leftRepresentative =>
      induction right using Quot.ind with
      | _ rightRepresentative =>
          exact congrArg (Quot.mk relation)
            (thin leftRepresentative rightRepresentative)

theorem pointProbe_carrier_subsingleton (mode : Mode) :
    CarrierSubsingleton (pointProbe mode) := by
  cases mode <;> intro left right <;> exact uliftUnit_allEq left right

/-- Every primitive modality preserves carrier subsingletons. -/
theorem modality_preserves_carrier_subsingleton
    {source target : Mode} (modality : Modality source target)
    (object : SemanticObject.{u} source)
    (thin : CarrierSubsingleton object) :
    CarrierSubsingleton
      ((semanticPrefunctor.{u}.map modality).toFunctor.obj object) := by
  cases modality with
  | evidence => exact thin
  | forgetEvidence => exact thin
  | readout => exact quotient_carrier_subsingleton thin
  | discrete => exact thin
  | points => exact thin
  | observe => exact quotient_carrier_subsingleton thin

/-- Every finite modality path sends a carrier-subsingleton object to another
carrier-subsingleton object. -/
theorem path_preserves_carrier_subsingleton
    {source target : Mode} (path : ModePath source target)
    (object : SemanticObject.{u} source)
    (thin : CarrierSubsingleton object) :
    CarrierSubsingleton
      ((semanticPseudofunctor.{u}.map path).toFunctor.obj object) := by
  induction path with
  | of modality =>
      exact modality_preserves_carrier_subsingleton modality object thin
  | id mode =>
      exact thin
  | comp first second firstInduction secondInduction =>
      exact secondInduction
        ((semanticPseudofunctor.{u}.map first).toFunctor.obj object)
        (firstInduction object thin)

theorem path_pointProbe_carrier_subsingleton
    {source target : Mode} (path : ModePath source target) :
    CarrierSubsingleton
      ((semanticPseudofunctor.{u}.map path).toFunctor.obj
        (pointProbe source)) :=
  path_preserves_carrier_subsingleton path (pointProbe source)
    (pointProbe_carrier_subsingleton source)

/-! ## Point maps remain jointly surjective along every path -/

/-- A family of morphisms is jointly surjective on underlying carriers. -/
def JointlySurjective
    {mode : Mode} {Index : Type u}
    {domain : Index → SemanticObject.{u} mode}
    {target : SemanticObject.{u} mode}
    (family : ∀ index, domain index ⟶ target) : Prop :=
  ∀ element : Carrier target,
    ∃ index, ∃ preimage : Carrier (domain index),
      homFunction (family index) preimage = element

/-- Map a morphism family through one primitive modality. -/
def mapFamily
    {source target : Mode} (modality : Modality source target)
    {Index : Type u} {domain : Index → SemanticObject.{u} source}
    {codomain : SemanticObject.{u} source}
    (family : ∀ index, domain index ⟶ codomain) :
    ∀ index,
      (semanticPrefunctor.{u}.map modality).toFunctor.obj (domain index) ⟶
        (semanticPrefunctor.{u}.map modality).toFunctor.obj codomain :=
  fun index => (semanticPrefunctor.{u}.map modality).toFunctor.map (family index)

/-- Every primitive modality preserves jointly-surjective carrier families. -/
theorem modality_preserves_jointlySurjective
    {source target : Mode} (modality : Modality source target)
    {Index : Type u} {domain : Index → SemanticObject.{u} source}
    {codomain : SemanticObject.{u} source}
    {family : ∀ index, domain index ⟶ codomain}
    (surjective : JointlySurjective family) :
    JointlySurjective (mapFamily modality family) := by
  cases modality with
  | evidence => exact surjective
  | forgetEvidence => exact surjective
  | readout =>
      intro element
      induction element using Quot.ind with
      | _ representative =>
          obtain ⟨index, preimage, equal⟩ := surjective representative
          exact ⟨index, Quot.mk _ preimage,
            congrArg (Quot.mk _) equal⟩
  | discrete => exact surjective
  | points => exact surjective
  | observe =>
      intro element
      induction element using Quot.ind with
      | _ representative =>
          obtain ⟨index, preimage, equal⟩ := surjective representative
          exact ⟨index, Quot.mk _ preimage,
            congrArg (Quot.mk _) equal⟩

/-- Map a morphism family through a finite modality path. -/
def mapFamilyPath
    {source target : Mode} (path : ModePath source target)
    {Index : Type u} {domain : Index → SemanticObject.{u} source}
    {codomain : SemanticObject.{u} source}
    (family : ∀ index, domain index ⟶ codomain) :
    ∀ index,
      (semanticPseudofunctor.{u}.map path).toFunctor.obj (domain index) ⟶
        (semanticPseudofunctor.{u}.map path).toFunctor.obj codomain :=
  fun index => (semanticPseudofunctor.{u}.map path).toFunctor.map (family index)

/-- Every finite modality path preserves jointly-surjective carrier families. -/
theorem path_preserves_jointlySurjective
    {source target : Mode} (path : ModePath source target)
    {Index : Type u} {domain : Index → SemanticObject.{u} source}
    {codomain : SemanticObject.{u} source}
    {family : ∀ index, domain index ⟶ codomain}
    (surjective : JointlySurjective family) :
    JointlySurjective (mapFamilyPath path family) := by
  induction path with
  | of modality =>
      exact modality_preserves_jointlySurjective modality surjective
  | id mode =>
      exact surjective
  | comp first second firstInduction secondInduction =>
      exact secondInduction (firstInduction surjective)

/-- The images of all point maps jointly cover the carrier reached by any
modality path. -/
theorem path_pointMaps_jointlySurjective
    {source target : Mode} (path : ModePath source target)
    (object : SemanticObject.{u} source) :
    JointlySurjective
      (mapFamilyPath path
        (fun element : Carrier object => pointMap object element)) := by
  apply path_preserves_jointlySurjective path
  intro element
  exact ⟨element, probePoint source, pointMap_apply object element⟩

/-! ## Global semantic thinness and descent -/

/-- Any two semantic transformations between parallel generated modality paths
are equal. -/
theorem semanticCell_subsingleton
    {source target : Mode} (first second : ModePath source target) :
    Subsingleton (SemanticCell.{u} first second) := by
  constructor
  intro left right
  apply Cat.Hom₂.ext
  apply NatTrans.ext
  funext object
  apply semanticHom_ext
  intro element
  obtain ⟨point, preimage, covers⟩ :=
    path_pointMaps_jointlySurjective first object element
  rw [← covers]
  have leftNaturality :=
    congrArg
      (fun morphism => homFunction morphism preimage)
      (left.toNatTrans.naturality (pointMap object point))
  have rightNaturality :=
    congrArg
      (fun morphism => homFunction morphism preimage)
      (right.toNatTrans.naturality (pointMap object point))
  calc
    homFunction (left.toNatTrans.app object)
        (homFunction
          ((semanticPseudofunctor.{u}.map first).toFunctor.map
            (pointMap object point)) preimage) =
      homFunction
        ((semanticPseudofunctor.{u}.map second).toFunctor.map
          (pointMap object point))
        (homFunction (left.toNatTrans.app (pointProbe source)) preimage) := by
          simpa only [homFunction_comp] using leftNaturality
    _ = homFunction
        ((semanticPseudofunctor.{u}.map second).toFunctor.map
          (pointMap object point))
        (homFunction (right.toNatTrans.app (pointProbe source)) preimage) := by
          apply congrArg
          exact path_pointProbe_carrier_subsingleton second _ _
    _ = homFunction (right.toNatTrans.app object)
        (homFunction
          ((semanticPseudofunctor.{u}.map first).toFunctor.map
            (pointMap object point)) preimage) := by
          simpa only [homFunction_comp] using rightNaturality.symm

instance semanticCellSubsingleton
    {source target : Mode} {first second : ModePath source target} :
    Subsingleton (SemanticCell.{u} first second) :=
  semanticCell_subsingleton first second

/-- The raw mixed Cat semantics is constant on every generated parallel-cell
fibre. -/
theorem global_semantic_fibreInvariant
    {source target : Mode} (first second : ModePath source target) :
    SemanticFibreInvariant.{u} first second := by
  intro left right
  exact Subsingleton.elim _ _

/-- Consequently the raw mixed Cat semantics descends through every cell fibre
of the locally thin candidate. -/
theorem global_semantic_factors_through_thin
    {source target : Mode} (first second : ModePath source target) :
    FactorsThrough
      (@interpretMixedCell.{u} source target first second) :=
  (semantic_factors_through_thin_iff first second).2
    (global_semantic_fibreInvariant first second)

/-! ## The descended semantic pseudofunctor -/

/-- Interpret a reflected cell using its representative-independent Cat
meaning. -/
def descendedSemanticCell
    {source target : Mode} {first second : ModePath source target} :
    ThinCell (B := FreeModeBicategory) CellGenerator first second →
      SemanticCell.{u} first second :=
  descend (@interpretMixedCell.{u} source target first second)
    (global_semantic_fibreInvariant first second)

@[simp] theorem descendedSemanticCell_reflect
    {source target : Mode} {first second : ModePath source target}
    (cell : RawGeneratedCell (B := FreeModeBicategory)
      CellGenerator first second) :
    descendedSemanticCell.{u} (reflect cell) = interpretMixedCell.{u} cell :=
  rfl

/-- The checked Cat interpretation is an actual pseudofunctor out of the whole
locally thin O/I/E bicategory. -/
def thinSemanticPseudofunctor : ThinMode ⥤ᵖ Cat.{u, u + 1} :=
  extend CellGenerator semanticPseudofunctor.{u}
    (fun first second => semanticCell_subsingleton first second)
    interpretGenerator.{u}

/-- The descended pseudofunctor has exactly the original semantic action on
objects and one-cells. -/
theorem thinSemanticPseudofunctor_map
    {source target : ThinMode} (path : source ⟶ target) :
    thinSemanticPseudofunctor.{u}.map path =
      semanticPseudofunctor.{u}.map path.as :=
  rfl

/-- The generic mapping-out construction agrees with the direct descended
interpretation on every reflected cell. -/
theorem thinSemanticPseudofunctor_map₂
    {source target : ThinMode} {first second : source ⟶ target}
    (cell : first ⟶ second) :
    thinSemanticPseudofunctor.{u}.map₂ cell =
      descendedSemanticCell.{u} cell :=
  (semanticCell_subsingleton first.as second.as).elim _ _

/-! ## Negative control -/

/-- The theorem is not caused by the intensional semantic category itself
being thin: it retains distinct endomorphisms of a route-rich pair. -/
theorem ambient_intensional_hom_not_subsingleton :
    ¬ Subsingleton (codiscretePair ⟶ codiscretePair) := by
  intro thin
  obtain ⟨left, right, distinct, _identified⟩ := quotient_not_faithful
  exact distinct (thin.elim left right)

/-! ## Axiom audit -/

#print axioms semanticCell_subsingleton
#print axioms global_semantic_fibreInvariant
#print axioms global_semantic_factors_through_thin
#print axioms thinSemanticPseudofunctor
#print axioms ambient_intensional_hom_not_subsingleton

end OperationalIntensionalExtensionalSemanticThinness
end Mettapedia.TypeTheory
