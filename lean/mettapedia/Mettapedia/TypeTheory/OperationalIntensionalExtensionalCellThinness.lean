import Mettapedia.TypeTheory.FreeWhiskeredCellCoherenceObservation
import Mettapedia.TypeTheory.LocallyThinCellReflection
import Mettapedia.TypeTheory.OperationalIntensionalExtensionalTwoComputad

/-!
# Local thinness boundary for the operational/intensional/extensional cells

The three-mode two-computad has three different proof-identity questions:

1. the primitive authored comparison at a fixed boundary;
2. the raw constructor history generated by composition and whiskering; and
3. the semantic natural transformation in `Cat`.

They do not have the same answer.  The primitive generator fibre is
subsingleton.  Raw cells retain constructor history and therefore support a
history-sensitive discriminator.  The checked categorical semantics already
identifies one such raw distinction: the factor isomorphism followed by its
inverse has the same semantic image as reflexivity.

Thus the current core signature is compatible with a locally thin quotient at
the primitive layer, while the raw certificate syntax remains proof-relevant.
Choosing a proof-relevant final mode theory still requires a discriminator
that survives the selected coherence laws and acts differently on a required
dependent consumer.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory
namespace OperationalIntensionalExtensionalCellThinness

open FreeWhiskeredCell
open FreeWhiskeredCell.CoherenceObservation
open LocallyThinCellReflection
open OperationalIntensionalExtensionalTwoComputad

universe u

/-! ## Primitive authored comparisons are pointwise thin -/

/-- At any fixed pair of modality paths, there is at most one primitive
authored comparison generator in the current core signature. -/
theorem cellGenerator_subsingleton
    {source target : Mode} {first second : ModePath source target} :
    Subsingleton (CellGenerator first second) := by
  constructor
  intro left right
  cases left <;> cases right <;> rfl

/-- Consequently, thinning the primitive generator fibre loses no generator
identity. -/
theorem primitive_generator_reflection_injective
    {source target : Mode} {first second : ModePath source target} :
    Function.Injective
      (@reflect (CellGenerator first second)) :=
  (reflect_injective_iff_subsingleton _).2 cellGenerator_subsingleton

/-! ## Raw construction history is not thin -/

/-- The reflexive raw cell at the factorization source. -/
def factorIdentityCell :
    ModeCell evidenceReadoutPath evidenceReadoutPath :=
  FreeWhiskeredCell.Cell.refl (base := modeCellBase)
    (Generator := CellGenerator) evidenceReadoutPath

/-- Raw shape distinguishes an explicit factor-forward/factor-backward history
from the reflexive cell at the same boundary. -/
def rawFactorHistoryDiscriminator :
    Discriminator
      (ModeCell evidenceReadoutPath evidenceReadoutPath) RawShape where
  left := factorRoundTrip
  right := factorIdentityCell
  observe := rawShape
  separates := by
    simp [factorRoundTrip, factorCell, factorCellInverse,
      factorIdentityCell, rawShape]

/-- A consumer which explicitly asks for raw construction history cannot
factor through a locally thin cell quotient. -/
theorem raw_history_does_not_factor_through_thin_cells :
    ¬ FactorsThrough
      (rawShape :
        ModeCell evidenceReadoutPath evidenceReadoutPath → RawShape) :=
  rawFactorHistoryDiscriminator.not_factorsThrough

/-- The raw cell fibre is genuinely non-subsingleton. -/
theorem raw_factor_cell_fibre_not_subsingleton :
    ¬ Subsingleton
      (ModeCell evidenceReadoutPath evidenceReadoutPath) :=
  rawFactorHistoryDiscriminator.not_subsingleton

/-- Pointwise local thinning is therefore non-injective on raw construction
history. -/
theorem raw_factor_cell_reflection_not_injective :
    ¬ Function.Injective
      (@reflect (ModeCell evidenceReadoutPath evidenceReadoutPath)) :=
  rawFactorHistoryDiscriminator.reflect_not_injective

/-! ## The checked semantic model identifies this administrative history -/

/-- Although the raw constructor trees differ, their independently defined
categorical meanings agree. -/
theorem semantic_factor_history_identified :
    interpretCell.{u} factorRoundTrip =
      interpretCell.{u} factorIdentityCell := by
  rw [interpret_factorRoundTrip]
  simp [factorIdentityCell, interpretCell, semanticCellAlgebra]

/-- The forward factor comparison survives the thin reflection as an
inhabited, necessarily subsingleton cell fibre. -/
theorem reflected_factor_cell_inhabited :
    Nonempty
      (ThinReflection
        (ModeCell evidenceReadoutPath observePath)) :=
  ⟨reflect factorCell⟩

/-! ## Connected boundary -/

/-- The exact current discriminator boundary: primitive comparisons are
already thin; raw construction histories are not; and the checked semantic
model validates at least one of the expected coherence identifications. -/
theorem core_cell_thinness_boundary :
    (∀ {source target : Mode} {first second : ModePath source target},
      Function.Injective
        (@reflect (CellGenerator first second))) /\
      ¬ FactorsThrough
        (rawShape :
          ModeCell evidenceReadoutPath evidenceReadoutPath → RawShape) /\
      interpretCell.{u} factorRoundTrip =
        interpretCell.{u} factorIdentityCell /\
      Nonempty
        (ThinReflection
          (ModeCell evidenceReadoutPath observePath)) :=
  ⟨by
      intro source target first second
      exact primitive_generator_reflection_injective,
    raw_history_does_not_factor_through_thin_cells,
    semantic_factor_history_identified,
    reflected_factor_cell_inhabited⟩

/-! ## Axiom audit -/

#print axioms cellGenerator_subsingleton
#print axioms primitive_generator_reflection_injective
#print axioms raw_history_does_not_factor_through_thin_cells
#print axioms raw_factor_cell_fibre_not_subsingleton
#print axioms raw_factor_cell_reflection_not_injective
#print axioms semantic_factor_history_identified
#print axioms reflected_factor_cell_inhabited
#print axioms core_cell_thinness_boundary

end OperationalIntensionalExtensionalCellThinness
end Mettapedia.TypeTheory
