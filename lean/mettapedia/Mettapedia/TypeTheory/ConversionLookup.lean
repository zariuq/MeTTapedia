import Mettapedia.TypeTheory.ConversionGraph

/-!
# Lookups as guarded firings

In the conversion step of `ConversionRuns` every firing carries a declared step. A store of proved
conversions is used by a second kind of firing: one that carries no step and is permitted because
the knowledge already entails what it needs. This module adds that firing as an admission on the
same effect.

* **Admission by evidence or by lookup** (`lookedUp`, `lookupStep`). A candidate is permitted
  when it carries a declared step, or when it moves under a shared context between two terms that
  the graph of the goal's ledger relates. The second case is an ask of the knowledge the goal
  has before the firing tells anything. (The guard profile of the step interface asks after the
  tell; `ConversionStoreCore` gives lookups in that profile, as moves that tell nothing.)
* **Lookups are sound** (`lookup_run_sound`): if the declared steps cross every shared context,
  a run of the lookup step from a ledger of conversions relates only terms that the bubble
  converts.
* **Lookups add no conversion** (`lookup_conservative`): the terms reachable by runs of the lookup
  step from the empty ledger are exactly those the bubble converts. What a lookup changes is the
  length of runs, not what is convertible.
* The statements about ledgers and runs hold for every admission on the conversion effect
  (`ledger_subset_of`, `run_entails_of`, `models_last_of`): soundness of a policy is the validity
  of what each permitted candidate tells.

## Controls (`Controls`)

On the dependent comparison core with the recursion equations of addition, with `Vec` as the
shared context, at the goal that has learnt `n + 0 ≐ n`:
* the candidate from `Vec (n + 0)` to `Vec n` with no declared step is admitted by lookup
  (`lookup_admitted`) and refused by the step that asks for evidence (`lookup_not_witnessed`);
  runs from that goal stay sound (`learned_run_sound`);
* with nothing learnt the same candidate is refused (`lookup_refused_without_merge`);
* the candidate from `Vec (0 + n)` to `Vec n` is refused although `n + 0 ≐ n` is known
  (`wrong_lookup_refused`).

Scope: one bubble and one fibre; shared contexts are given as a predicate, and the graph is the
equivalence generated by the ledger.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.ConversionLookup

open Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting
open Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Interface
open Mettapedia.TypeTheory.BubbleConversion
open Mettapedia.TypeTheory.FreeConversion
open Mettapedia.TypeTheory.JudgmentalEquality
open Mettapedia.TypeTheory.ConversionRuns
open Mettapedia.TypeTheory.ConversionGraph

universe uIndex uState uBubble uStep

variable {Index : Type uIndex}

section Policies

variable {B : Bubbles.{uIndex, uState, uBubble, uStep} Index} {bubble : B.Bubble} {index : Index}

/-- Told equations stay told, under every admission. -/
theorem ledger_subset_of (allow : (core B bubble index).Admission) :
    ∀ {goal : Goal B index} (run : (Step.ofEffect (core B bubble index) allow).Run goal),
      ∀ e ∈ goal.ledger, e ∈ run.last.ledger
  | _, .nil _, _, member => member
  | _, .cons _ _ rest, e, member =>
      ledger_subset_of allow rest e (List.mem_append_left _ member)

/-- Under every admission, an identification that validates the last ledger relates the first
term with the last. -/
theorem run_entails_of (allow : (core B bubble index).Admission) :
    ∀ {goal : Goal B index} (run : (Step.ofEffect (core B bubble index) allow).Run goal)
      (model : Identification (B.State index)),
      (∀ e ∈ run.last.ledger, model.rel e.1 e.2) → model.rel goal.cursor run.last.cursor
  | _, .nil goal, model, _ => model.equivalence.refl goal.cursor
  | goal, .cons claim _ rest, model, holds =>
      model.equivalence.trans
        (holds (goal.cursor, claim.target)
          (ledger_subset_of allow rest _ (List.mem_append_right _ (List.mem_singleton_self _))))
        (run_entails_of allow rest model holds)

/-- **Soundness of an admission is the validity of what it lets be told.** If every permitted
candidate tells an equation that an identification validates whenever it validates the goal's
ledger, then the identification validates the ledger after every run. -/
theorem models_last_of (allow : (core B bubble index).Admission)
    (model : Identification (B.State index))
    (valid : ∀ {goal : Goal B index} (claim : Claim B bubble goal.cursor)
      (prepared : (core B bubble index).Prepares claim), allow claim prepared →
        (∀ e ∈ goal.ledger, model.rel e.1 e.2) → model.rel goal.cursor claim.target) :
    ∀ {goal : Goal B index} (run : (Step.ofEffect (core B bubble index) allow).Run goal),
      (∀ e ∈ goal.ledger, model.rel e.1 e.2) → ∀ e ∈ run.last.ledger, model.rel e.1 e.2
  | _, .nil _, holds => holds
  | goal, .cons claim admitted rest, holds =>
      models_last_of allow model valid rest (by
        intro e member
        rcases List.mem_append.mp member with old | told
        · exact holds e old
        · obtain rfl := List.mem_singleton.mp told
          exact admitted.elim fun prepared permitted => valid claim prepared permitted holds)

end Policies

section Lookup

variable (B : Bubbles.{uIndex, uState, uBubble, uStep} Index) (bubble : B.Bubble) (index : Index)

/-- **Admission by evidence or by lookup.** A candidate is permitted when it carries a declared
step, or when it moves under a shared context between two terms that the graph of the goal's
ledger relates. -/
def lookedUp (shared : (B.State index → B.State index) → Prop) :
    (core B bubble index).Admission :=
  fun {goal} claim _ => claim.Witnessed ∨
    ∃ context, shared context ∧ ∃ a b, goal.cursor = context a ∧ claim.target = context b ∧
      (graph goal.ledger).rel a b

/-- The conversion step with lookups. -/
abbrev lookupStep (shared : (B.State index → B.State index) → Prop) :
    Step (conversionFrames (B.State index)) Nat (Goal B index)
      (fun goal => Claim B bubble goal.cursor) :=
  Step.ofEffect (core B bubble index) (lookedUp B bubble index shared)

variable {B bubble index}

/-- Equal terms are related by every identification. -/
theorem rel_of_eq (model : Identification (B.State index)) {s t : B.State index} (same : s = t) :
    model.rel s t :=
  same ▸ model.equivalence.refl s

/-- What a permitted candidate tells is a conversion of the bubble, when the goal's ledger is. -/
theorem lookup_valid (shared : (B.State index → B.State index) → Prop)
    (crosses : ∀ context, shared context → ∀ {s t : B.State index},
      B.Step bubble s t → B.Step bubble (context s) (context t))
    {goal : Goal B index} (claim : Claim B bubble goal.cursor)
    (prepared : (core B bubble index).Prepares claim)
    (permitted : lookedUp B bubble index shared claim prepared)
    (holds : ∀ e ∈ goal.ledger, (conversion B bubble index).rel e.1 e.2) :
    (conversion B bubble index).rel goal.cursor claim.target := by
  rcases permitted with seen | ⟨context, isShared, a, b, atCursor, atTarget, related⟩
  · exact claim.valid seen (conversion B bubble index) conversion_contains_steps
  · have under : (conversion B bubble index).rel (context a) (context b) :=
      (graph_le_of_validates (conversion B bubble index) holds related).elim fun path =>
        ⟨underContext context (crosses context isShared) path⟩
    exact (conversion B bubble index).equivalence.trans
      (rel_of_eq (conversion B bubble index) atCursor)
      ((conversion B bubble index).equivalence.trans under
        (rel_of_eq (conversion B bubble index) atTarget.symm))

/-- **Lookups are sound.** If the declared steps cross every shared context, a run of the lookup
step from a ledger of conversions leads to a term that the bubble converts with the first. -/
theorem lookup_run_sound (shared : (B.State index → B.State index) → Prop)
    (crosses : ∀ context, shared context → ∀ {s t : B.State index},
      B.Step bubble s t → B.Step bubble (context s) (context t))
    {goal : Goal B index} (run : (lookupStep B bubble index shared).Run goal)
    (sound : ∀ e ∈ goal.ledger, Nonempty (B.Conv bubble e.1 e.2)) :
    Nonempty (B.Conv bubble goal.cursor run.last.cursor) :=
  run_entails_of (lookedUp B bubble index shared) run (conversion B bubble index)
    (models_last_of (lookedUp B bubble index shared) (conversion B bubble index)
      (fun claim prepared permitted holds =>
        lookup_valid shared crosses claim prepared permitted holds)
      run sound)

/-- Every zigzag is followed by a run of the lookup step, by its declared steps. -/
theorem lookup_run_of_zigzag (shared : (B.State index → B.State index) → Prop) :
    ∀ {source target : B.State index}, Zigzag B bubble source target →
      ∀ (ledger : EquationStore (B.State index)) (clock : Nat),
        ∃ run : (lookupStep B bubble index shared).Run ⟨source, ledger, clock⟩,
          run.last.cursor = target
  | source, _, .nil _, ledger, clock =>
      ⟨Step.Run.nil (P := lookupStep B bubble index shared) (Goal.mk source ledger clock), rfl⟩
  | source, _, .forward (middle := middle) step rest, ledger, clock =>
      (lookup_run_of_zigzag shared rest (ledger ++ [(source, middle)]) (clock + 1)).elim
        fun run ends =>
          ⟨Step.Run.cons (P := lookupStep B bubble index shared) (s := Goal.mk source ledger clock)
            (Claim.forward middle step)
            ⟨prepared B bubble index (goal := Goal.mk source ledger clock) (Claim.forward middle step),
              Or.inl trivial⟩
            run, ends⟩
  | source, _, .backward (middle := middle) step rest, ledger, clock =>
      (lookup_run_of_zigzag shared rest (ledger ++ [(source, middle)]) (clock + 1)).elim
        fun run ends =>
          ⟨Step.Run.cons (P := lookupStep B bubble index shared) (s := Goal.mk source ledger clock)
            (Claim.backward middle step)
            ⟨prepared B bubble index (goal := Goal.mk source ledger clock)
              (Claim.backward middle step), Or.inl trivial⟩
            run, ends⟩

/-- **Lookups add no conversion.** The terms reachable by runs of the lookup step from the empty
ledger are exactly those the bubble converts. -/
theorem lookup_conservative (shared : (B.State index → B.State index) → Prop)
    (crosses : ∀ context, shared context → ∀ {s t : B.State index},
      B.Step bubble s t → B.Step bubble (context s) (context t))
    {s t : B.State index} :
    (∃ run : (lookupStep B bubble index shared).Run ⟨s, [], 0⟩, run.last.cursor = t) ↔
      Nonempty (B.Conv bubble s t) := by
  constructor
  · rintro ⟨run, ends⟩
    subst ends
    exact lookup_run_sound shared crosses run (fun _ member => absurd member List.not_mem_nil)
  · rintro ⟨path⟩
    exact lookup_run_of_zigzag shared (Zigzag.ofConv path) [] 0

end Lookup

/-! ## Controls -/

namespace Controls

open Mettapedia.Logic.HOL
open Mettapedia.Logic.HOL.Embedding.SimpleSliceOfDependent
open Expr
open Mettapedia.TypeTheory.BubbleConversion.Arith
open Mettapedia.TypeTheory.ConversionRuns.Controls

/-- The one shared context: `Vec`. -/
def sharedVec : (AExpr → AExpr) → Prop := fun context => context = fun x => vec x

/-- The declared steps cross the shared context. -/
def sharedVec_crosses : ∀ context, sharedVec context → ∀ {s t : AExpr},
    arithBubbles.Step Rule (index := ()) s t →
      arithBubbles.Step Rule (index := ()) (context s) (context t) := by
  intro context isShared s t step
  have same : context = fun x => vec x := isShared
  subst same
  exact PLift.up (Rewrite.appArgument (PLift.down step))

/-- The goal at `Vec (n + 0)` that has learnt `n + 0 ≐ n`. -/
def learned : Goal arithBubbles () :=
  ⟨vec (addE (bvar 1) zeroE), [(addE (bvar 1) zeroE, bvar 1)], 1⟩

/-- The candidate from `Vec (n + 0)` to `Vec n` with no declared step. -/
def lookupClaim : Claim arithBubbles Rule (index := ()) learned.cursor := .asserted (vec (bvar 1))

/-- **It is admitted by lookup.** -/
theorem lookup_admitted : (lookupStep arithBubbles Rule () sharedVec).Admits lookupClaim :=
  ⟨prepared arithBubbles Rule () lookupClaim,
    Or.inr ⟨fun x => vec x, rfl, addE (bvar 1) zeroE, bvar 1, rfl, rfl,
      graph_validates _ (addE (bvar 1) zeroE, bvar 1) (List.mem_singleton_self _)⟩⟩

/-- **The step that asks for evidence refuses it.** -/
theorem lookup_not_witnessed : ¬ (conversionStep arithBubbles Rule ()).Admits lookupClaim :=
  fun admitted => (admits_iff arithBubbles Rule () lookupClaim).mp admitted

/-- **Runs with lookups stay sound**: a run of the lookup step from the learnt goal leads only to
terms that the recursion equations convert with `Vec (n + 0)`. -/
theorem learned_run_sound (run : (lookupStep arithBubbles Rule () sharedVec).Run learned) :
    Nonempty (arithBubbles.Conv Rule (index := ()) learned.cursor run.last.cursor) :=
  lookup_run_sound (goal := learned) sharedVec sharedVec_crosses run (by
    intro e member
    have single : e ∈ [((addE (bvar 1) zeroE, bvar 1) : AExpr × AExpr)] := member
    obtain rfl := List.mem_singleton.mp single
    exact ⟨ConversionEvidence.step (PLift.up (Rewrite.root (Rule.addZero (bvar 1))))⟩)

/-- The same goal with nothing learnt. -/
def unlearned : Goal arithBubbles () := ⟨vec (addE (bvar 1) zeroE), [], 0⟩

/-- **With nothing learnt the candidate is refused.** -/
theorem lookup_refused_without_merge :
    ¬ (lookupStep arithBubbles Rule () sharedVec).Admits
      (Claim.asserted (B := arithBubbles) (bubble := Rule) (index := ())
        (source := unlearned.cursor) (vec (bvar 1))) := by
  rintro ⟨_, seen | ⟨context, isShared, a, b, atCursor, atTarget, related⟩⟩
  · exact seen
  · have shape : context = fun x => vec x := isShared
    subst shape
    have same : a = b :=
      graph_le_of_validates Identification.equality
        (fun _ member => absurd member List.not_mem_nil) related
    have first : vec (addE (bvar 1) zeroE) = vec a := atCursor
    have second : vec (bvar 1) = vec b := atTarget
    rw [← same] at second
    have clash := first.trans second.symm
    simp [vec, addE] at clash

/-- Equality of normal forms for the recursion equations, as an identification. -/
def normIdentification : Identification AExpr :=
  ⟨fun e e' => Arith.norm false e = Arith.norm false e',
    ⟨fun _ => rfl, fun same => same.symm, fun first second => first.trans second⟩⟩

/-- The goal at `Vec (0 + n)` that has learnt `n + 0 ≐ n`. -/
def wrongGoal : Goal arithBubbles () :=
  ⟨vec (addE zeroE (bvar 1)), [(addE (bvar 1) zeroE, bvar 1)], 1⟩

/-- **A lookup of something the knowledge does not entail is refused.** -/
theorem wrong_lookup_refused :
    ¬ (lookupStep arithBubbles Rule () sharedVec).Admits
      (Claim.asserted (B := arithBubbles) (bubble := Rule) (index := ())
        (source := wrongGoal.cursor) (vec (bvar 1))) := by
  rintro ⟨_, seen | ⟨context, isShared, a, b, atCursor, atTarget, related⟩⟩
  · exact seen
  · have shape : context = fun x => vec x := isShared
    subst shape
    have normal : Arith.norm false a = Arith.norm false b :=
      graph_le_of_validates normIdentification
        (fun e member => by
          obtain rfl := List.mem_singleton.mp member
          rfl)
        related
    have first : vec (addE zeroE (bvar 1)) = vec a := atCursor
    have second : vec (bvar 1) = vec b := atTarget
    have atA : (addE zeroE (bvar 1) : AExpr) = a := (Expr.app.inj first).2
    have atB : (bvar 1 : AExpr) = b := (Expr.app.inj second).2
    subst atA
    subst atB
    simp [Arith.norm, appNorm, addNorm, addE, zeroE] at normal

end Controls

