import Mettapedia.GSLT.Core.IndexedOperational
import Mettapedia.TypeTheory.OperationalIntensionalExtensionalModes
import Mathlib.CategoryTheory.Whiskering

/-!
# GSLTs in the operational / intensional / extensional mode triangle

The operational mode becomes relevant to GSLT-IL only after the authored
equations have been taken seriously.  This module sends every operational
GSLT to the dynamics on its equation classes and every equation-respecting
step translation to the induced map of those dynamics.

The existing commuting mode triangle then applies functorially:

```
 authored GSLT
      |
      | quotient by E, retain R
      v
 semantic dynamics ---> reflexive relational routes
      |                           |
      | step-component quotient   | route quotient
      v                           v
             extensional carrier
```

The final carrier here is specifically the quotient generated by the step
relation.  A checked counterexample proves that this need not be behavioral
bisimilarity.  Thus the construction is a useful extensional readout, but it
must not be silently identified with observer-relative behavioral identity,
set-theoretic equality, or intensional identity types.

Likewise, `evidenceCompletion` retains a reflexive relation in `Prop`; it is
the relational skeleton of an intensional mode, not proof-relevant path data.
Proof-relevant routes and dependent identity elimination remain additional
displayed capabilities.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.GSLTOperationalModeBridge

open CategoryTheory
open Relation
open Mettapedia.GSLT
open Mettapedia.GSLT.IndexedOperational
open Mettapedia.TypeTheory.OperationalIntensionalExtensionalModes

universe u

/-! ## The semantic dynamics functor -/

/-- Forget presentation representatives only after quotienting by the GSLT's
equations.  The remaining dynamics is the well-defined one-step relation on
equation classes. -/
def semanticDynamics : OperationalTheory.{u} ⥤ DynSys.{u} where
  obj theory := ⟨SemanticTerm theory.theory, SemanticStep theory.theory⟩
  map translation :=
    ⟨translation.mapSemantic,
      fun step => translation.mapSemanticStep step⟩
  map_id theory := by
    apply DynHom.ext
    intro term
    exact OperationalTranslation.mapSemantic_id theory.theory term
  map_comp earlier later := by
    apply DynHom.ext
    intro term
    exact OperationalTranslation.mapSemantic_comp earlier later term

/-- The relational intensional readout of semantic GSLT dynamics. -/
def semanticRoutes : OperationalTheory.{u} ⥤ RouteType.{u} :=
  semanticDynamics ⋙ evidenceCompletion

/-- Direct quotient by the semantic one-step relation.  This is named for
what it computes: connected components generated by steps. -/
def semanticStepComponents : OperationalTheory.{u} ⥤ ExtType.{u} :=
  semanticDynamics ⋙ dynQuotient

/-- The same component readout factored through reflexive relational routes. -/
def semanticRouteComponents : OperationalTheory.{u} ⥤ ExtType.{u} :=
  semanticDynamics ⋙ (evidenceCompletion ⋙ routeQuotient)

/-- The operational/intensional/extensional triangle commutes on actual GSLT
equation classes, naturally in every operational translation. -/
def semanticObservationFactors :
    semanticRouteComponents.{u} ≅ semanticStepComponents.{u} :=
  Functor.isoWhiskerLeft semanticDynamics observationFactors

@[simp]
theorem semanticDynamics_mapTerm
    {source target : OperationalTheory.{u}} (translation : source ⟶ target) :
    (semanticDynamics.map translation).toFun = translation.mapSemantic :=
  rfl

@[simp]
theorem semanticObservationFactors_hom_rep
    (theory : OperationalTheory.{u})
    (term : SemanticTerm theory.theory) :
    (semanticObservationFactors.hom.app theory).toFun
        (Quot.mk (ReflGen (SemanticStep theory.theory)) term) =
      Quot.mk (SemanticStep theory.theory) term :=
  rfl

/-! ## What the component readout does and does not mean -/

namespace Canary

/-- A one-way two-state machine. -/
def oneWay : GSLT where
  Term := Bool
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites := fun source target => source = false ∧ target = true
  rewrites_resp_left := by
    intro source source' target equal step
    subst source'
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    intro source target target' step equal
    subst target'
    exact step

def oneWayObject : OperationalTheory.{0} := ⟨oneWay⟩

def semanticFalse : SemanticTerm oneWay :=
  Quotient.mk oneWay.equations false

def semanticTrue : SemanticTerm oneWay :=
  Quotient.mk oneWay.equations true

/-- Before the step quotient, the two equation classes remain distinct. -/
theorem semantic_states_distinct : semanticFalse ≠ semanticTrue := by
  intro equalClasses
  have equalBooleans : false = true := Quotient.exact equalClasses
  exact Bool.false_ne_true equalBooleans

/-- The component readout identifies endpoints of the one-way step. -/
theorem step_components_identify :
    Quot.mk (SemanticStep oneWay) semanticFalse =
      Quot.mk (SemanticStep oneWay) semanticTrue := by
  apply Quot.sound
  exact semanticStep_mk ⟨rfl, rfl⟩

/-- Yet the source and target are not bisimilar: only the source can step.
This separates step-component equality from behavioral identity. -/
theorem not_bisimilar : ¬ oneWay.Bisimilar false true := by
  rintro ⟨relation, ⟨forward, _⟩, related⟩
  obtain ⟨target, targetStep, _⟩ := forward related ⟨rfl, rfl⟩
  exact Bool.false_ne_true targetStep.1.symm

/-- Consequently the component quotient can identify states that the
behavioral quotient must keep apart. -/
theorem component_equality_not_behavioral :
    (Quot.mk (SemanticStep oneWay) semanticFalse =
      Quot.mk (SemanticStep oneWay) semanticTrue) ∧
      ¬ oneWay.Bisimilar false true :=
  ⟨step_components_identify, not_bisimilar⟩

end Canary

#print axioms semanticDynamics
#print axioms semanticObservationFactors
#print axioms Canary.semantic_states_distinct
#print axioms Canary.step_components_identify
#print axioms Canary.not_bisimilar
#print axioms Canary.component_equality_not_behavioral

end Mettapedia.TypeTheory.GSLTOperationalModeBridge
