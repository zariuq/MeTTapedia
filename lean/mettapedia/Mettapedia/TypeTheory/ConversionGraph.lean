import Mettapedia.TypeTheory.ConversionRuns
import Mettapedia.TypeTheory.KnowledgeFrames
import Mettapedia.TypeTheory.ScopedIdentity

/-!
# The conversion graph: proved conversions as growing knowledge

A checker that has established conversions should not establish them twice. The **graph** of a
ledger of told equations is the identification they generate (`graph`); it is what a store of
proved conversions answers from. This module proves, over the conversion step of a bubble
(`ConversionRuns.conversionStep`):

* **The graph is the solved form of the ledger** (`graph_principal`): the coarsening from equality
  to the graph is a principal answer of the ledger, in the frames of identifications.
  A lookup is an ask (`ask_iff_graph`): an equation holds at every solution of the ledger exactly
  when the graph relates its two sides. Over the frames with no instantiation, the graph is the
  frame that has learnt the ledger (`graph_iff_tell`).
* **Sound** (`graph_sound`): along a run from a ledger of conversions, the graph relates only
  terms that the bubble converts. Every merge is justified by a declared step of a firing.
* **Only growing** (`graph_grows`, `graph_mono`): the graph after a run contains the graph before
  it. Merging two stores is the join of their graphs (`graph_append_least`).
* **Complete inside the bubble** (`graph_complete`, `conv_iff_graph`): two terms are convertible in
  the bubble exactly when some run from the empty ledger leads to a graph that relates them.
* **Sharing** (`graph_sound_under`): if the declared steps cross a context, a merge found once is
  a conversion under that context, with no further run.
* **Knowledge is proof-irrelevant, evidence is not** (`bubbleLayer`, `known_proofIrrelevant`,
  `Controls.loops_evidence_plural`, `Controls.loops_not_routeUIP`): in the vocabulary of
  `ScopedIdentity`, what a graph holds is the support of a layer whose routes are the conversion
  trees. The support has one proof for each pair; the routes can be many.

## Controls (`Controls`)

On the dependent comparison core with the recursion equations of addition:
* after the run of `n + 0 ↦ n` at the index, the graph relates `n + 0` and `n`
  (`index_hit`), and under the context `Vec` the same merge converts `Vec (n + 0)` with `Vec n`
  (`shared_under_vec`);
* no run from the empty ledger leads to a graph relating `Vec (0 + n)` and `Vec n` (`miss`).

For the bubble with no declared step, the graph of the unevidenced ledger `false ≐ true` relates
two terms the bubble does not convert (`unjustified_merge_unsound`): soundness of the graph is
soundness of what was told.

Scope: one bubble and one fibre; the graph is the equivalence generated by told equations, and
closure under contexts is the separate statement `graph_sound_under`.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.ConversionGraph

open Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting
open Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Interface
open Mettapedia.TypeTheory.BubbleConversion
open Mettapedia.TypeTheory.FreeConversion
open Mettapedia.TypeTheory.JudgmentalEquality
open Mettapedia.TypeTheory.ConversionRuns

universe u uIndex uState uBubble uStep

/-! ## The graph of a ledger -/

section Graph

variable {T : Type u}

/-- The graph of a ledger: the identification generated by its equations. -/
def graph (ledger : EquationStore T) : Identification T :=
  ⟨Relation.EqvGen fun s t => (s, t) ∈ ledger, Relation.EqvGen.is_equivalence _⟩

/-- The graph relates the two sides of every told equation. -/
theorem graph_validates (ledger : EquationStore T) : ∀ e ∈ ledger, (graph ledger).rel e.1 e.2 :=
  fun _ member => Relation.EqvGen.rel _ _ member

/-- The graph is contained in every identification that validates the ledger. -/
theorem graph_le_of_validates (model : Identification T) {ledger : EquationStore T}
    (validates : ∀ e ∈ ledger, model.rel e.1 e.2) {s t : T} (related : (graph ledger).rel s t) :
    model.rel s t := by
  induction related with
  | rel _ _ told => exact validates _ told
  | refl _ => exact model.equivalence.refl _
  | symm _ _ _ ih => exact model.equivalence.symm ih
  | trans _ _ _ _ _ ihFirst ihSecond => exact model.equivalence.trans ihFirst ihSecond

/-- **The graph is the solved form of the ledger**: a principal answer, in the frames of
identifications. -/
theorem graph_principal (ledger : EquationStore T) :
    (conversionFrames T).Principal (a := Identification.equality) ledger
      (fromEquality (graph ledger)) where
  sound := graph_validates ledger
  factors := fun model _ solved =>
    ⟨⟨fun _ _ related => graph_le_of_validates model solved related⟩,
      fun term => model.equivalence.refl term⟩

/-- **A lookup is an ask**: an equation holds at every solution of the ledger exactly when the
graph relates its two sides. -/
theorem ask_iff_graph (ledger : EquationStore T) (s t : T) :
    (conversionFrames T).Entails (a := Identification.equality) ledger
        (fun model _ => model.rel s t) ↔
      (graph ledger).rel s t :=
  ⟨fun entailed => entailed (graph ledger) (fromEquality _) (graph_validates ledger),
    fun related model _ solved => graph_le_of_validates model solved related⟩

/-- **More told, more related.** -/
theorem graph_mono {small large : EquationStore T} (included : ∀ e ∈ small, e ∈ large) {s t : T}
    (related : (graph small).rel s t) : (graph large).rel s t :=
  graph_le_of_validates (graph large)
    (fun e member => graph_validates large e (included e member)) related

/-- **Merging two stores is the join of their graphs**: an identification that contains both
graphs contains the graph of the concatenated ledger. -/
theorem graph_append_least (model : Identification T) {first second : EquationStore T}
    (containsFirst : ∀ s t : T, (graph first).rel s t → model.rel s t)
    (containsSecond : ∀ s t : T, (graph second).rel s t → model.rel s t) {s t : T}
    (related : (graph (first ++ second)).rel s t) : model.rel s t :=
  graph_le_of_validates model
    (fun e member => by
      rcases List.mem_append.mp member with inFirst | inSecond
      · exact containsFirst _ _ (graph_validates first e inFirst)
      · exact containsSecond _ _ (graph_validates second e inSecond))
    related

/-- The frames with one object, no instantiation and syntactic equality. -/
def discrete (T : Type u) : Frames (fun _ : Unit => T) (fun _ _ : Unit => Unit) where
  E := fun {_} s t => s = t
  equivalence := fun _ =>
    ⟨fun _ => rfl, fun same => same.symm, fun first second => first.trans second⟩
  act := fun _ term => term
  id := fun _ => ()
  comp := fun _ _ => ()
  act_id := fun _ => rfl
  act_comp := fun _ _ _ => rfl
  preserves := fun {_ _} _ {_ _} same => same

/-- **The graph of a ledger is the frame that has learnt it**, over the discrete frames: the
identifications of `ConversionRuns` are the frames with knowledge of `KnowledgeFrames` in the case
with no instantiation. -/
theorem graph_iff_tell (ledger : EquationStore T) (s t : T) :
    (graph ledger).rel s t ↔
      ((KnowledgeFrames.Knowing.plain (discrete T) ()).tell ledger).known s t := by
  constructor
  · intro related
    induction related with
    | rel _ _ told => exact Relation.EqvGen.rel _ _ (Or.inr told)
    | refl _ => exact Relation.EqvGen.refl _
    | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
    | trans _ _ _ _ _ ihFirst ihSecond => exact Relation.EqvGen.trans _ _ _ ihFirst ihSecond
  · intro related
    induction related with
    | rel first second base =>
        rcases base with same | told
        · cases (show first = second from same)
          exact Relation.EqvGen.refl _
        · exact Relation.EqvGen.rel _ _ told
    | refl _ => exact Relation.EqvGen.refl _
    | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
    | trans _ _ _ _ _ ihFirst ihSecond => exact Relation.EqvGen.trans _ _ _ ihFirst ihSecond

end Graph

/-! ## Sound, growing and complete along runs of a bubble -/

section Bubble

variable {Index : Type uIndex} {B : Bubbles.{uIndex, uState, uBubble, uStep} Index}
  {bubble : B.Bubble} {index : Index}

variable (B bubble index) in
/-- The conversion of a bubble in one fibre, as an identification. -/
def conversion : Identification (B.State index) where
  rel := fun s t => Nonempty (B.Conv bubble s t)
  equivalence :=
    ⟨fun state => ⟨convRefl B bubble state⟩,
      fun converted => converted.elim fun path => ⟨ConversionEvidence.symm path⟩,
      fun first second =>
        first.elim fun firstPath => second.elim fun secondPath =>
          ⟨ConversionEvidence.trans firstPath secondPath⟩⟩

theorem conversion_contains_steps (s t : B.State index) (step : B.Step bubble s t) :
    (conversion B bubble index).rel s t :=
  ⟨ConversionEvidence.step step⟩

/-- **Soundness of the graph.** Along a run from a ledger of conversions, the graph relates only
terms that the bubble converts. -/
theorem graph_sound {goal : Goal B index} (run : (conversionStep B bubble index).Run goal)
    (sound : ∀ e ∈ goal.ledger, Nonempty (B.Conv bubble e.1 e.2)) {s t : B.State index}
    (related : (graph run.last.ledger).rel s t) : Nonempty (B.Conv bubble s t) :=
  graph_le_of_validates (conversion B bubble index)
    (models_last_of_model (conversion B bubble index) conversion_contains_steps run sound) related

/-- **The graph only grows along a run.** -/
theorem graph_grows {goal : Goal B index} (run : (conversionStep B bubble index).Run goal)
    {s t : B.State index} (related : (graph goal.ledger).rel s t) :
    (graph run.last.ledger).rel s t :=
  graph_mono (ledger_subset run) related

/-- **Completeness inside the bubble.** The run of a conversion leads to a graph that relates its
two terms. -/
theorem graph_complete {s t : B.State index} (path : B.Conv bubble s t)
    (ledger : EquationStore (B.State index)) (clock : Nat) :
    (graph (runOfConv path ledger clock).last.ledger).rel s t := by
  have entailed := run_entails (runOfConv path ledger clock) (graph _) (fromEquality _)
    (graph_validates _)
  rwa [last_runOfConv] at entailed

/-- **The graphs reached by runs are exactly the bubble's conversion.** -/
theorem conv_iff_graph {s t : B.State index} :
    Nonempty (B.Conv bubble s t) ↔
      ∃ run : (conversionStep B bubble index).Run ⟨s, [], 0⟩, (graph run.last.ledger).rel s t :=
  ⟨fun converted => converted.elim fun path => ⟨runOfConv path [] 0, graph_complete path [] 0⟩,
    fun ⟨run, related⟩ => graph_sound run (fun _ member => absurd member List.not_mem_nil) related⟩

/-- A conversion under a context that declared steps cross. -/
def underContext (context : B.State index → B.State index)
    (crosses : ∀ {s t : B.State index}, B.Step bubble s t → B.Step bubble (context s) (context t)) :
    {s t : B.State index} → B.Conv bubble s t → B.Conv bubble (context s) (context t)
  | _, _, .step step => ConversionEvidence.step (crosses step)
  | _, _, .refl state => convRefl B bubble (context state)
  | _, _, .symm path => ConversionEvidence.symm (underContext context crosses path)
  | _, _, .trans first second =>
      ConversionEvidence.trans (underContext context crosses first)
        (underContext context crosses second)

/-- **Sharing.** If the declared steps cross a context, every pair the graph relates is converted
under that context: a merge found once serves every occurrence. -/
theorem graph_sound_under (context : B.State index → B.State index)
    (crosses : ∀ {s t : B.State index}, B.Step bubble s t → B.Step bubble (context s) (context t))
    {goal : Goal B index} (run : (conversionStep B bubble index).Run goal)
    (sound : ∀ e ∈ goal.ledger, Nonempty (B.Conv bubble e.1 e.2)) {s t : B.State index}
    (related : (graph run.last.ledger).rel s t) :
    Nonempty (B.Conv bubble (context s) (context t)) :=
  (graph_sound run sound related).elim fun path => ⟨underContext context crosses path⟩

variable (B bubble index) in
/-- The identity layer of a bubble in one fibre, in the sense of `ScopedIdentity`: the routes are
the conversion trees, and the proposition-valued support is the bubble's conversion, which is
what graphs and frames know. -/
def bubbleLayer : ScopedIdentity.Layer (B.State index) where
  Route := fun s t => B.Conv bubble s t
  refl := fun state => convRefl B bubble state
  Support := (conversion B bubble index).rel
  forget := fun route => ⟨route⟩

/-- **What is known has one proof.** The support of the layer, which is what a graph or a frame
holds, is proof-irrelevant whatever the routes are. -/
theorem known_proofIrrelevant (s t : B.State index) :
    Subsingleton ((bubbleLayer B bubble index).Support s t) :=
  ScopedIdentity.support_is_proofIrrelevant _ s t

end Bubble

/-! ## Controls -/

namespace Controls

open Mettapedia.Logic.HOL
open Mettapedia.Logic.HOL.Embedding.SimpleSliceOfDependent
open Expr
open Mettapedia.TypeTheory.BubbleConversion.Arith
open Mettapedia.TypeTheory.ConversionRuns.Controls

/-- The recursion equation at the index: `n + 0 ↦ n`. -/
def indexZigzag : Zigzag arithBubbles Rule (index := ()) (addE (bvar 1) zeroE) (bvar 1) :=
  Zigzag.forward (B := arithBubbles) (bubble := Rule) (index := ())
    (source := addE (bvar 1) zeroE) (middle := bvar 1) (target := bvar 1)
    (PLift.up (Rewrite.root (Rule.addZero (bvar 1))))
    (Zigzag.nil (B := arithBubbles) (bubble := Rule) (index := ()) (bvar 1))

/-- Its run, from the goal with nothing told. -/
def indexRun : (conversionStep arithBubbles Rule ()).Run ⟨addE (bvar 1) zeroE, [], 0⟩ :=
  runOfZigzag indexZigzag [] 0

/-- **After the run, the graph relates `n + 0` and `n`.** -/
theorem index_hit : (graph indexRun.last.ledger).rel (addE (bvar 1) zeroE) (bvar 1) := by
  have entailed := run_entails indexRun (graph _) (fromEquality _) (graph_validates _)
  rwa [show indexRun.last.cursor = bvar 1 from last_runOfZigzag indexZigzag [] 0] at entailed

/-- **The same merge serves the type**: under the context `Vec`, with no further run. -/
theorem shared_under_vec :
    Nonempty (arithBubbles.Conv Rule (index := ()) (vec (addE (bvar 1) zeroE)) (vec (bvar 1))) :=
  graph_sound_under (B := arithBubbles) (bubble := Rule) (index := ()) (fun x => vec x)
    (fun step => PLift.up (Rewrite.appArgument step.down)) indexRun
    (fun _ member => absurd member List.not_mem_nil) index_hit

/-- **A miss.** No run of the recursion equations from the empty ledger leads to a graph that
relates `Vec (0 + n)` and `Vec n`. -/
theorem miss {start : AExpr} (run : (conversionStep arithBubbles Rule ()).Run ⟨start, [], 0⟩) :
    ¬ (graph run.last.ledger).rel (vec (addE zeroE (bvar 1))) (vec (bvar 1)) := by
  intro related
  obtain ⟨path⟩ := graph_sound run (fun _ member => absurd member List.not_mem_nil) related
  have same := bubble_conv_norm false path
  simp [Arith.norm, appNorm, addNorm, vec, addE, zeroE] at same

/-- **An unevidenced merge is unsound**: in the bubble with no declared step, the graph of the
ledger `false ≐ true` relates two terms the bubble does not convert. -/
theorem unjustified_merge_unsound :
    (graph ([(false, true)] : EquationStore Bool)).rel false true ∧
      ¬ Nonempty (silent.Conv () (index := ()) false true) :=
  ⟨graph_validates _ (false, true) (List.mem_singleton_self _),
    fun converted => converted.elim fun path =>
      Bool.false_ne_true (silent_zigzag (Zigzag.ofConv path))⟩

/-- **The evidence has more than one route.** In the bubble with a declared loop, the step and the
empty conversion are two different routes between the same terms. -/
theorem loops_evidence_plural : ScopedIdentity.HasDistinctRoutes (bubbleLayer loops () ()) :=
  ⟨(), (), loopStep, convRefl loops () (index := ()) (), fun same =>
    absurd
      (congrArg (fun route : loops.Conv () (index := ()) () () => (Zigzag.ofConv route).length) same)
      (by decide)⟩

/-- So the routes of that layer do not satisfy uniqueness of identity proofs, while its support
does (`known_proofIrrelevant`): holding conversions as knowledge is proof-irrelevant by
construction, and holding them as evidence is not. -/
theorem loops_not_routeUIP : ¬ ScopedIdentity.RouteUIP (bubbleLayer loops () ()) :=
  fun uip => ScopedIdentity.routeUIP_excludes_distinctRoutes uip loops_evidence_plural

end Controls

