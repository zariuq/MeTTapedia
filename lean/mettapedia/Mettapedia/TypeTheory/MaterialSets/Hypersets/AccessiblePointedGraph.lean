import Mettapedia.TypeTheory.MaterialSets.Hypersets.Bisimulation

/-!
# Accessible pointed graphs

An accessible pointed graph has nodes in `Type u`, an edge relation and a point from which
every node is reachable. It pictures a set: the point is the set, and the children of a node
picture its members.

* `generated r a`: the subgraph of a graph `r` generated by a node `a`, that is, the nodes
  reachable from `a`, pointed at `a`;
* `repoint G n`: `G` re-pointed at its node `n`;
* `sup g`: a new point whose children are the points of a small family of graphs;
* `G ≈ H`: a bisimulation relates the points. Bisimilarity is an equivalence (`setoid`).

Re-pointing respects bisimilarity (`repoint_equiv_repoint_iff`), and re-pointing at the point
gives a bisimilar graph (`repoint_point`). Bisimilarity forgets the multiplicity of edges
(`sup_equiv_of_surjective`): a point with two childless children is bisimilar to a point with
one (`sup_bool_equiv_sup_unit`), whereas a childless point is bisimilar to neither
(`not_empty_equiv_sup`).

P. Aczel, *Non-well-founded Sets*, CSLI Lecture Notes 14, 1988.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.MaterialSets.Hypersets

open Relation

universe u

/-- An accessible pointed graph: nodes in `Type u`, an edge relation, where `edge n m` says
that `m` is a child of `n`, and a point from which every node is reachable. -/
structure AccessiblePointedGraph : Type (u + 1) where
  /-- The nodes. -/
  Node : Type u
  /-- `edge n m`: the node `m` is a child of `n`. -/
  edge : Node → Node → Prop
  /-- The point. -/
  point : Node
  /-- Every node is reachable from the point. -/
  reachable : ∀ n, ReflTransGen edge point n

namespace AccessiblePointedGraph

/-! ## Generated subgraphs and re-pointing -/

section Generated

variable {α : Type u} (r : α → α → Prop)

/-- Reachability from `a` lifts to the subgraph generated by `a`. -/
theorem reflTransGen_generated {a b : α} (h : ReflTransGen r a b) :
    ReflTransGen (fun b c : {b // ReflTransGen r a b} => r b.1 c.1) ⟨a, .refl⟩ ⟨b, h⟩ := by
  induction h with
  | refl => exact .refl
  | tail _ hbc ih => exact ih.tail hbc

/-- The subgraph of `r` generated by `a`: the nodes reachable from `a`, pointed at `a`. -/
def generated (a : α) : AccessiblePointedGraph.{u} where
  Node := {b // ReflTransGen r a b}
  edge b c := r b.1 c.1
  point := ⟨a, .refl⟩
  reachable b := reflTransGen_generated r b.2

/-- Each node of a generated subgraph is bisimilar to itself in the whole graph. -/
theorem bisimilar_generated (a : α) (b : (generated r a).Node) :
    Bisimilar (generated r a).edge r b b.1 :=
  bisimilar_apply (f := Subtype.val) (fun _ _ h => h)
    (fun b c h => ⟨⟨c, b.2.tail h⟩, h, rfl⟩) b

end Generated

/-- `G` re-pointed at the node `n`: the subgraph generated by `n`. -/
def repoint (G : AccessiblePointedGraph.{u}) (n : G.Node) : AccessiblePointedGraph.{u} :=
  generated G.edge n

/-! ## Bisimilarity -/

/-- Bisimilarity of accessible pointed graphs: a bisimulation relates the points. It is an
equivalence. -/
instance setoid : Setoid AccessiblePointedGraph.{u} where
  r G H := Bisimilar G.edge H.edge G.point H.point
  iseqv := ⟨fun G => Bisimilar.refl G.point, fun h => h.symm, fun h h' => h.trans h'⟩

theorem equiv_iff {G H : AccessiblePointedGraph.{u}} :
    G ≈ H ↔ Bisimilar G.edge H.edge G.point H.point :=
  Iff.rfl

/-- Bisimilarity of accessible pointed graphs is an equivalence relation. -/
theorem bisimilar_equivalence :
    Equivalence fun G H : AccessiblePointedGraph.{u} =>
      Bisimilar G.edge H.edge G.point H.point :=
  setoid.iseqv

section Generated

variable {α β : Type u} {r : α → α → Prop} {s : β → β → Prop}

theorem generated_equiv_iff {a : α} {G : AccessiblePointedGraph.{u}} :
    generated r a ≈ G ↔ Bisimilar r G.edge a G.point :=
  ⟨fun h => (bisimilar_generated r a (generated r a).point).symm.trans h,
    fun h => (bisimilar_generated r a (generated r a).point).trans h⟩

theorem generated_equiv_generated_iff {a : α} {b : β} :
    generated r a ≈ generated s b ↔ Bisimilar r s a b :=
  generated_equiv_iff.trans
    ⟨fun h => h.trans (bisimilar_generated s b (generated s b).point),
      fun h => h.trans (bisimilar_generated s b (generated s b).point).symm⟩

end Generated

theorem repoint_equiv_repoint_iff {G H : AccessiblePointedGraph.{u}} {n : G.Node} {m : H.Node} :
    G.repoint n ≈ H.repoint m ↔ Bisimilar G.edge H.edge n m :=
  generated_equiv_generated_iff

/-- Re-pointing at the point gives a bisimilar graph. -/
theorem repoint_point (G : AccessiblePointedGraph.{u}) : G.repoint G.point ≈ G :=
  generated_equiv_iff.mpr Bisimilar.rfl

/-! ## A new point over a family of graphs -/

section Sup

variable {ι : Type u} (g : ι → AccessiblePointedGraph.{u})

/-- The edges of `sup g`: from the new point to the point of each graph of the family, and the
edges of each graph of the family. -/
inductive SupEdge : Option (Σ i, (g i).Node) → Option (Σ i, (g i).Node) → Prop
  | point (i : ι) : SupEdge none (some ⟨i, (g i).point⟩)
  | edge (i : ι) {n m : (g i).Node} : (g i).edge n m → SupEdge (some ⟨i, n⟩) (some ⟨i, m⟩)

/-- Reachability in `g i` lifts to `sup g`. -/
theorem reflTransGen_supEdge {i : ι} {n : (g i).Node}
    (h : ReflTransGen (g i).edge (g i).point n) :
    ReflTransGen (SupEdge g) (some ⟨i, (g i).point⟩) (some ⟨i, n⟩) := by
  induction h with
  | refl => exact .refl
  | tail _ hbc ih => exact ih.tail (.edge i hbc)

/-- A new point whose children are the points of the graphs `g i`. -/
def sup : AccessiblePointedGraph.{u} where
  Node := Option (Σ i, (g i).Node)
  edge := SupEdge g
  point := none
  reachable
    | none => .refl
    | some ⟨i, n⟩ => .head (.point i) (reflTransGen_supEdge g ((g i).reachable n))

variable {g}

theorem supEdge_none_iff {x : (sup g).Node} :
    SupEdge g none x ↔ ∃ i, x = some ⟨i, (g i).point⟩ := by
  constructor
  · rintro ⟨i⟩
    exact ⟨i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact .point i

theorem supEdge_some_iff {i : ι} {n : (g i).Node} {x : (sup g).Node} :
    SupEdge g (some ⟨i, n⟩) x ↔ ∃ m, (g i).edge n m ∧ x = some ⟨i, m⟩ := by
  constructor
  · rintro (_ | ⟨_, h⟩)
    exact ⟨_, h, rfl⟩
  · rintro ⟨m, h, rfl⟩
    exact .edge i h

/-- Each graph of the family sits inside `sup g`, up to bisimilarity. -/
theorem bisimilar_sup (i : ι) (n : (g i).Node) :
    Bisimilar (g i).edge (sup g).edge n (some ⟨i, n⟩) :=
  bisimilar_apply (r := (g i).edge) (s := (sup g).edge)
    (f := fun m => (some ⟨i, m⟩ : (sup g).Node)) (fun _ _ h => SupEdge.edge i h)
    (fun _ _ h => by
      obtain ⟨m, hm, rfl⟩ := supEdge_some_iff.mp h
      exact ⟨m, hm, rfl⟩) n

/-- Re-pointing `sup g` at the point of `g i` gives `g i`, up to bisimilarity. -/
theorem repoint_sup_equiv (i : ι) : (sup g).repoint (some ⟨i, (g i).point⟩) ≈ g i :=
  generated_equiv_iff.mpr (bisimilar_sup i (g i).point).symm

/-- Families that cover each other up to bisimilarity give bisimilar graphs. -/
theorem sup_equiv_sup {κ : Type u} {h : κ → AccessiblePointedGraph.{u}}
    (forth : ∀ i, ∃ k, g i ≈ h k) (back : ∀ k, ∃ i, g i ≈ h k) : sup g ≈ sup h := by
  refine ⟨fun x y => (x = none ∧ y = none) ∨
      ∃ i k n m, x = some ⟨i, n⟩ ∧ y = some ⟨k, m⟩ ∧ Bisimilar (g i).edge (h k).edge n m,
    ?_, Or.inl ⟨rfl, rfl⟩⟩
  rintro x y (⟨rfl, rfl⟩ | ⟨i, k, n, m, rfl, rfl, hnm⟩)
  · refine ⟨fun x' hx => ?_, fun y' hy => ?_⟩
    · obtain ⟨i, rfl⟩ := supEdge_none_iff.mp hx
      obtain ⟨k, hk⟩ := forth i
      exact ⟨_, .point k, Or.inr ⟨i, k, _, _, rfl, rfl, hk⟩⟩
    · obtain ⟨k, rfl⟩ := supEdge_none_iff.mp hy
      obtain ⟨i, hi⟩ := back k
      exact ⟨_, .point i, Or.inr ⟨i, k, _, _, rfl, rfl, hi⟩⟩
  · refine ⟨fun x' hx => ?_, fun y' hy => ?_⟩
    · obtain ⟨n', hn, rfl⟩ := supEdge_some_iff.mp hx
      obtain ⟨m', hm, h'⟩ := hnm.exists_child_left hn
      exact ⟨_, .edge k hm, Or.inr ⟨i, k, n', m', rfl, rfl, h'⟩⟩
    · obtain ⟨m', hm, rfl⟩ := supEdge_some_iff.mp hy
      obtain ⟨n', hn, h'⟩ := hnm.exists_child_right hm
      exact ⟨_, .edge i hn, Or.inr ⟨i, k, n', m', rfl, rfl, h'⟩⟩

/-- Reindexing a family along a surjection gives a bisimilar graph: multiplicity is
forgotten. -/
theorem sup_equiv_of_surjective {κ : Type u} (f : κ → ι) (hf : Function.Surjective f) :
    sup (g ∘ f) ≈ sup g :=
  sup_equiv_sup (fun k => ⟨f k, Setoid.refl _⟩)
    (fun i => (hf i).elim fun k hk => ⟨k, hk ▸ Setoid.refl _⟩)

end Sup

/-! ## Examples -/

/-- The graph of the empty set: a point without children. -/
def empty : AccessiblePointedGraph.{u} :=
  sup (PEmpty.elim : PEmpty.{u + 1} → AccessiblePointedGraph.{u})

theorem not_edge_empty (x : empty.{u}.Node) : ¬ empty.edge empty.point x := by
  intro h
  obtain ⟨i, _⟩ := supEdge_none_iff.mp h
  exact i.elim

/-- A childless point is not bisimilar to a point with a child. -/
theorem not_empty_equiv_sup {ι : Type u} (g : ι → AccessiblePointedGraph.{u}) (i : ι) :
    ¬ empty ≈ sup g :=
  fun h => not_bisimilar_of_child (SupEdge.point i) not_edge_empty h.symm

/-- Two edges to childless nodes and one edge to a childless node give bisimilar graphs. -/
theorem sup_bool_equiv_sup_unit :
    sup (fun _ : ULift.{u} Bool => empty.{u}) ≈ sup fun _ : PUnit.{u + 1} => empty.{u} :=
  sup_equiv_of_surjective (g := fun _ : PUnit.{u + 1} => empty.{u}) (fun _ => PUnit.unit)
    fun _ => ⟨⟨true⟩, rfl⟩

end AccessiblePointedGraph

end Mettapedia.TypeTheory.MaterialSets.Hypersets
