import Mettapedia.TypeTheory.MaterialSets.Hypersets.ContextualRealizedGraphs

/-!
# Actual contextual graphs generated by retained witness occurrences

A small origin carrier assigns a source context, an initial arrival and
an actual rooted graph value. The constructed diagram retains every
terminal arrow and every node of that value. Its roots retain arrivals
from the initial context; a root edge exists exactly along the stated
factorization of that arrival. Transport postcomposes terminal arrows
and applies the witness's own node functor.

The whole diagram is constructed in the original universe. No coherent
choice of witnesses or graph representatives is required. A component's
future-indexed comparison with its original witness is built by explicit
coiteration over literal nodes.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.MaterialSets.Hypersets.ContextualGraphGenerators

open CategoryTheory ContextualGraphDiagrams ContextualRealizedGraphs
universe u
variable {D : Type u} [Category.{u} D]
variable {initial : D} {Origin : Type u}
variable (source : Origin → D) (arrival : (origin : Origin) → initial ⟶ source origin)
variable (witness : (origin : Origin) → Value D (source origin))

abbrev Node (point : D) : Type u :=
  (initial ⟶ point) ⊕ (Σ origin : Origin, (source origin ⟶ point) × (witness origin).1.nodes.obj point)

def nodeMap {first second : D} (step : first ⟶ second)
    (node : Node (initial := initial) source witness first) : Node (initial := initial) source witness second :=
  match node with
  | .inl root => .inl (root ≫ step)
  | .inr ⟨origin, tail, value⟩ =>
      .inr ⟨origin, tail ≫ step, (witness origin).1.nodes.map step value⟩

theorem nodeMap_identity (point : D) (node : Node (initial := initial) source witness point) :
    nodeMap (initial := initial) source witness (𝟙 point) node = node := by
  cases node with
  | inl root => exact congrArg Sum.inl (Category.comp_id root)
  | inr receipt =>
    rcases receipt with ⟨origin, tail, value⟩
    change (Sum.inr ⟨origin, tail ≫ 𝟙 point, (witness origin).1.nodes.map (𝟙 point) value⟩ :
      Node (initial := initial) source witness point) = _
    rw [Category.comp_id, (witness origin).1.nodes.map_id_apply]

theorem nodeMap_composition {first middle last : D} (earlier : first ⟶ middle)
    (later : middle ⟶ last) (node : Node (initial := initial) source witness first) :
    nodeMap (initial := initial) source witness (earlier ≫ later) node =
      nodeMap (initial := initial) source witness later (nodeMap (initial := initial) source witness earlier node) := by
  cases node with
  | inl root => exact congrArg Sum.inl (Category.assoc root earlier later).symm
  | inr receipt =>
    rcases receipt with ⟨origin, tail, value⟩
    change (Sum.inr ⟨origin, tail ≫ (earlier ≫ later),
      (witness origin).1.nodes.map (earlier ≫ later) value⟩ :
      Node (initial := initial) source witness last) = _
    rw [← Category.assoc, (witness origin).1.nodes.map_comp_apply]
    rfl

def nodes : D ⥤ Type u where
  obj := Node (initial := initial) source witness
  map step := TypeCat.ofHom (nodeMap (initial := initial) source witness step)
  map_id point := by
    apply ConcreteCategory.hom_ext
    exact nodeMap_identity (initial := initial) source witness point
  map_comp earlier later := by
    apply ConcreteCategory.hom_ext
    exact nodeMap_composition (initial := initial) source witness earlier later

inductive Edge (point : D) : Node (initial := initial) source witness point → Node (initial := initial) source witness point → Prop
  | root (origin : Origin) (tail : source origin ⟶ point) :
      Edge point (.inl (arrival origin ≫ tail))
        (.inr ⟨origin, tail, (witness origin).1.nodes.map tail (witness origin).2⟩)
  | inner (origin : Origin) (tail : source origin ⟶ point)
      {first second : (witness origin).1.nodes.obj point}
      (available : (witness origin).1.edge point first second) :
      Edge point (.inr ⟨origin, tail, first⟩) (.inr ⟨origin, tail, second⟩)

theorem edge_transport {first second : D} (step : first ⟶ second)
    {parent child : Node (initial := initial) source witness first} (available : Edge source arrival witness first parent child) :
    Edge source arrival witness second (nodeMap (initial := initial) source witness step parent) (nodeMap (initial := initial) source witness step child) := by
  cases available with
  | root origin tail =>
    change Edge source arrival witness second (.inl ((arrival origin ≫ tail) ≫ step))
      (.inr ⟨origin, tail ≫ step,
        (witness origin).1.nodes.map step ((witness origin).1.nodes.map tail (witness origin).2)⟩)
    rw [Category.assoc, ← (witness origin).1.nodes.map_comp_apply]
    exact Edge.root origin (tail ≫ step)
  | inner origin tail edge =>
    exact Edge.inner origin (tail ≫ step) ((witness origin).1.edge_transport step edge)

def diagram : Diagram D where
  nodes := nodes (initial := initial) source witness
  edge := Edge source arrival witness
  edge_transport := edge_transport source arrival witness

def root {point : D} (path : initial ⟶ point) : Value D point :=
  ⟨diagram source arrival witness, .inl path⟩

def component {point : D} (origin : Origin) (tail : source origin ⟶ point)
    (node : (witness origin).1.nodes.obj point) : Value D point :=
  ⟨diagram source arrival witness, .inr ⟨origin, tail, node⟩⟩

theorem root_move {first second : D} (step : first ⟶ second) (path : initial ⟶ first) :
    move D step (root source arrival witness path) = root source arrival witness (path ≫ step) := rfl

theorem component_move {first second : D} (step : first ⟶ second)
    (origin : Origin) (tail : source origin ⟶ first) (node : (witness origin).1.nodes.obj first) :
    move D step (component source arrival witness origin tail node) =
      component source arrival witness origin (tail ≫ step) ((witness origin).1.nodes.map step node) := rfl

def rootChild {point : D} (path : initial ⟶ point) (origin : Origin)
    (tail : source origin ⟶ point) (same : arrival origin ≫ tail = path) :
    ContextualGraphDiagrams.Child D (root source arrival witness path) :=
  ⟨.inr ⟨origin, tail, (witness origin).1.nodes.map tail (witness origin).2⟩,
    same ▸ Edge.root origin tail⟩

def liftChild {point : D} (origin : Origin) (tail : source origin ⟶ point)
    (node : (witness origin).1.nodes.obj point)
    (child : ContextualGraphDiagrams.Child D (component source arrival witness origin tail node)) :
    {receipt : ContextualGraphRealizers.Child (witness origin).1 point node //
      (.inr ⟨origin, tail, receipt.val⟩ : Node (initial := initial) source witness point) = child.val} := by
  rcases child with ⟨child, edge⟩
  cases child with
  | inl impossible => exact False.elim (by cases edge)
  | inr receipt =>
    rcases receipt with ⟨other, otherTail, target⟩
    have same : other = origin := by cases edge; rfl
    subst other
    have sameTail : otherTail = tail := by cases edge; rfl
    subst otherTail
    have actual : (witness origin).1.edge point node target := by
      cases edge with
      | inner _ _ available => exact available
    exact ⟨⟨target, actual⟩, rfl⟩

abbrev ComponentWitness (origin : Origin) (point : D)
    (first : (witness origin).1.nodes.obj point)
    (second : (diagram source arrival witness).nodes.obj point) : Type u :=
  Σ tail : source origin ⟶ point, PLift (second = Sum.inr ⟨origin, tail, first⟩)

def componentForth (origin : Origin) (point : D)
    (first : (witness origin).1.nodes.obj point)
    (second : (diagram source arrival witness).nodes.obj point)
    (proof : ComponentWitness source arrival witness origin point first second)
    (future : ContextualGraphRealizers.Future point)
    (child : ContextualGraphRealizers.Child (witness origin).1 future.1
      ((witness origin).1.nodes.map future.2 first)) :
    Σ matched : ContextualGraphRealizers.Child (diagram source arrival witness) future.1
      ((diagram source arrival witness).nodes.map future.2 second),
      ComponentWitness source arrival witness origin future.1 child.val matched.val := by
  rcases proof with ⟨tail, ⟨same⟩⟩
  subst second
  exact ⟨⟨.inr ⟨origin, tail ≫ future.2, child.val⟩,
    Edge.inner origin (tail ≫ future.2) child.property⟩, tail ≫ future.2, ⟨rfl⟩⟩

def componentBack (origin : Origin) (point : D)
    (first : (witness origin).1.nodes.obj point)
    (second : (diagram source arrival witness).nodes.obj point)
    (proof : ComponentWitness source arrival witness origin point first second)
    (future : ContextualGraphRealizers.Future point)
    (child : ContextualGraphRealizers.Child (diagram source arrival witness) future.1
      ((diagram source arrival witness).nodes.map future.2 second)) :
    Σ matched : ContextualGraphRealizers.Child (witness origin).1 future.1
      ((witness origin).1.nodes.map future.2 first),
      ComponentWitness source arrival witness origin future.1 matched.val child.val := by
  rcases proof with ⟨tail, ⟨same⟩⟩
  subst second
  let decoded := liftChild source arrival witness origin (tail ≫ future.2)
    ((witness origin).1.nodes.map future.2 first) child
  exact ⟨decoded.val, tail ≫ future.2, ⟨decoded.property.symm⟩⟩

def componentEquality {point : D} (origin : Origin) (tail : source origin ⟶ point)
    (node : (witness origin).1.nodes.obj point) :
    Equal (⟨(witness origin).1, node⟩ : Value D point)
      (component source arrival witness origin tail node) :=
  ContextualGraphRealizers.corec (witness origin).1 (diagram source arrival witness)
    (componentForth source arrival witness origin) (componentBack source arrival witness origin)
    ⟨tail, ⟨rfl⟩⟩

def rootIntro {point : D} (path : initial ⟶ point) (origin : Origin)
    (tail : source origin ⟶ point) (same : arrival origin ≫ tail = path) :
    Member (move D tail (witness origin)) (root source arrival witness path) :=
  ⟨rootChild source arrival witness path origin tail same,
    componentEquality source arrival witness origin tail _⟩

def rootDecode {point : D} (path : initial ⟶ point)
    (child : ContextualGraphDiagrams.Child D (root source arrival witness path)) :
    Σ origin : Origin, Σ tail : source origin ⟶ point,
      PLift (arrival origin ≫ tail = path) ×
        Equal (childValue D (root source arrival witness path) child) (move D tail (witness origin)) := by
  rcases child with ⟨child, edge⟩
  cases child with
  | inl impossible => exact False.elim (by cases edge)
  | inr receipt =>
    rcases receipt with ⟨origin, tail, node⟩
    have pathSame : arrival origin ≫ tail = path := by cases edge; rfl
    have nodeSame : node = (witness origin).1.nodes.map tail (witness origin).2 := by
      cases edge; rfl
    subst node
    exact ⟨origin, tail, ⟨pathSame⟩, (componentEquality source arrival witness origin tail _).symm⟩

end Mettapedia.TypeTheory.MaterialSets.Hypersets.ContextualGraphGenerators
