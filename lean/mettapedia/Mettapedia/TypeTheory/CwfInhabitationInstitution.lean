#print axioms globalModel
#print axioms ofCwf
#print axioms satisfies_iff
#print axioms satisfies_of_term
#print axioms witnessSupport
#print axioms witnessSupport_injective_iff_subsingleton

end Mettapedia.TypeTheory.CwfInhabitationInstitution
