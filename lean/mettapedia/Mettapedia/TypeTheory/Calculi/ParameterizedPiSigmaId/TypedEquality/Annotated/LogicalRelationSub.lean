import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.TypedEquality.Annotated.LogicalRelationLaws

/-!
# The subtyping mode of the witness-indexed relation

`RTSub Γ t A B`: the type `A` is usable at the type `B` as far as the type token `t`
observes. The clauses follow the cumulative subtyping of the calculus:

* at the tag of universes, both types reduce to universe heads, the first below the
  second in the order generated by head equality and cumulativity (`HeadLe`);
* at a dependent function type, the domains are equal and related as far as the
  domain tokens observe; a family entry `Z ↦ W` asks that the codomains at an
  argument related to itself as far as `Z` observes be in the subtyping mode as far
  as `W` observes;
* at a dependent pair type, the domains are in the subtyping mode as far as the
  domain tokens observe; a family entry asks the same of the families at one
  argument, and that the family of the larger type be related to itself at related
  arguments of its domain;
* at every other token, the types are related as in the relation: identity types,
  the numbers, the declared datatypes, the proposition codes and the ground types are
  invariant.

Laws proved here:

* **from equality** (`RT.toSub`): types related at a type token are in the subtyping
  mode;
* **head expansion** (`RTSub.expand`);
* **subsumption** (`RT.subConv`): terms related at `A` as far as a token observes are
  related at `B`, when `A ⊑ B` and `A` is usable at `B` as far as the token's type
  witness observes. At a dependent pair type the second projections move from the
  family of `A` at the first projection of the left term to the family of `B` there,
  and then, along the family of `B` related to itself, to every term with a common
  reduct with that projection. At identity types, the numbers and the declared
  datatypes the subtyping mode is the relation and gives an equality of types, and
  subsumption is conversion;
* **transitivity** (`RTSub.trans`).
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
namespace TypedEquality
namespace Annotated

open Impredicative.Domain
open Normalization (LevelModel HeadSame)
open UniverseLevel (LevelOrder)

variable {Head : Type} {R : Rules Head}

/-- One step of the order of universe heads: head equality or cumulativity. -/
def HeadLe (R : Rules Head) (h h' : Head) : Prop := HeadSame R h h' ∨ R.cumulative h h'

variable {P : ChurchRules R} {K : RigidTypes P} (H : HeadReduction P K)

/-! ## The canonical forms of the subtyping mode -/

section Shapes

variable {n : Nat} (Γ : CCtx Head n)

/-- Both types reduce to universe heads, the first below the second in the order of
heads. -/
def UnivSub (A B : CTm Head n) : Prop :=
  ∃ h h', CRedTy H Γ A (.head h) ∧ CRedTy H Γ B (.head h') ∧ R.isUniverse h ∧
    R.isUniverse h' ∧ Relation.ReflTransGen (HeadLe R) h h'

/-- Both types reduce to dependent function types with equal domains, the first
codomain usable at the second. -/
def PiSub (A B D : CTm Head n) (E : CTm Head (n + 1)) (D' : CTm Head n)
    (E' : CTm Head (n + 1)) : Prop :=
  CRedTy H Γ A (.pi D E) ∧ CRedTy H Γ B (.pi D' E') ∧ CTypeEq P Γ D D' ∧
    CBelow P (.snoc Γ D) E E'

/-- Both types reduce to dependent pair types, each component of the first usable at
the second's. -/
def SigmaSub (A B D : CTm Head n) (E : CTm Head (n + 1)) (D' : CTm Head n)
    (E' : CTm Head (n + 1)) : Prop :=
  CRedTy H Γ A (.sigma D E) ∧ CRedTy H Γ B (.sigma D' E') ∧ CBelow P Γ D D' ∧
    CBelow P (.snoc Γ D) E E'

end Shapes

/-- **The subtyping mode at one token.** -/
def RTSub {n : Nat} (Γ : CCtx Head n) : Tok → CTm Head n → CTm Head n → Prop
  | t, A, B => ent [] t = true ∨
      match t with
      | .tag .univ => UnivSub H Γ A B
      | .tag .pi => ∃ D E D' E', PiSub H Γ A B D E D' E'
      | .arg .pi i C d => ∃ D E D' E', PiSub H Γ A B D E D' E' ∧
          (∀ c ∈ C, RT H Γ false c D D D') ∧ (i = 0 → RT H Γ false d D D D')
      | .fn .pi C Z W => ∃ D E D' E', PiSub H Γ A B D E D' E' ∧
          (∀ c ∈ C, RT H Γ false c D D D') ∧
          (∀ N, CTyped P Γ N D → (∀ z ∈ Z, RT H Γ true z D N N) →
            ∀ w ∈ W.attach, RTSub Γ w.1 (CTm.inst0 N E) (CTm.inst0 N E'))
      | .tag .sigma => ∃ D E D' E', SigmaSub H Γ A B D E D' E'
      | .arg .sigma i C d => ∃ D E D' E', SigmaSub H Γ A B D E D' E' ∧
          (∀ c ∈ C.attach, RTSub Γ c.1 D D') ∧ (i = 0 → RTSub Γ d D D')
      | .fn .sigma C Z W => ∃ D E D' E', SigmaSub H Γ A B D E D' E' ∧
          (∀ c ∈ C.attach, RTSub Γ c.1 D D') ∧
          (∀ N N', CEqual P Γ N N' D' → (∀ z ∈ Z, RT H Γ true z D' N N') →
            ∀ w ∈ W, RT H Γ false w (CTm.inst0 N E') (CTm.inst0 N E') (CTm.inst0 N' E')) ∧
          (∀ N, CTyped P Γ N D → (∀ z ∈ Z, RT H Γ true z D N N) →
            ∀ w ∈ W.attach, RTSub Γ w.1 (CTm.inst0 N E) (CTm.inst0 N E'))
      | _ => RT H Γ false t A A B
termination_by t => t.depth
decreasing_by
  all_goals first
    | exact depth_lt_fn_right w.2
    | exact Tok.depth_lt_of_mem_dep (t := .arg _ _ _ _) c.2
    | exact Tok.depth_lt_of_mem_dep (t := .fn _ _ _ _) c.2
    | exact depth_lt_arg _ _ _ _

/-! ## The clauses -/

/-- The tokens of the subtyping mode's own clauses, and the others. -/
theorem subTok_cases (s : Tok) :
    s = .tag .univ ∨ s.kind = .pi ∨ s.kind = .sigma ∨
      (s ≠ .tag .univ ∧ s.kind ≠ .pi ∧ s.kind ≠ .sigma) := by
  cases s with
  | tag k => cases k <;> simp [Tok.kind]
  | arg k i C d => cases k <;> simp [Tok.kind]
  | fn k C X Y => cases k <;> simp [Tok.kind]

section Clauses

variable {H} {n : Nat} {Γ : CCtx Head n}

/-- A token entailed by the empty witness puts every two types in the subtyping mode. -/
theorem RTSub.of_vacuous {t : Tok} {A B : CTm Head n} (h : ent [] t = true) :
    RTSub H Γ t A B := by
  rw [RTSub.eq_def]
  exact Or.inl h

theorem RTSub.univ_iff {A B : CTm Head n} : RTSub H Γ (.tag .univ) A B ↔ UnivSub H Γ A B := by
  rw [RTSub.eq_def]
  simp only [ent_nil_tag, Bool.false_eq_true, false_or]

theorem RTSub.pi_iff {A B : CTm Head n} :
    RTSub H Γ (.tag .pi) A B ↔ ∃ D E D' E', PiSub H Γ A B D E D' E' := by
  rw [RTSub.eq_def]
  simp only [ent_nil_tag, Bool.false_eq_true, false_or]

theorem RTSub.argPi_iff {i : Nat} {C : List Tok} {d : Tok} {A B : CTm Head n} :
    RTSub H Γ (.arg .pi i C d) A B ↔ ent [] (.arg .pi i C d) = true ∨
      ∃ D E D' E', PiSub H Γ A B D E D' E' ∧ (∀ c ∈ C, RT H Γ false c D D D') ∧
        (i = 0 → RT H Γ false d D D D') := by
  rw [RTSub.eq_def]

theorem RTSub.fnPi_iff {C Z W : List Tok} {A B : CTm Head n} :
    RTSub H Γ (.fn .pi C Z W) A B ↔ ent [] (.fn .pi C Z W) = true ∨
      ∃ D E D' E', PiSub H Γ A B D E D' E' ∧ (∀ c ∈ C, RT H Γ false c D D D') ∧
        (∀ N, CTyped P Γ N D → (∀ z ∈ Z, RT H Γ true z D N N) →
          ∀ w ∈ W, RTSub H Γ w (CTm.inst0 N E) (CTm.inst0 N E')) := by
  rw [RTSub.eq_def]
  simp only [List.mem_attach, forall_const, Subtype.forall]

theorem RTSub.sigma_iff {A B : CTm Head n} :
    RTSub H Γ (.tag .sigma) A B ↔ ∃ D E D' E', SigmaSub H Γ A B D E D' E' := by
  rw [RTSub.eq_def]
  simp only [ent_nil_tag, Bool.false_eq_true, false_or]

theorem RTSub.argSigma_iff {i : Nat} {C : List Tok} {d : Tok} {A B : CTm Head n} :
    RTSub H Γ (.arg .sigma i C d) A B ↔ ent [] (.arg .sigma i C d) = true ∨
      ∃ D E D' E', SigmaSub H Γ A B D E D' E' ∧ (∀ c ∈ C, RTSub H Γ c D D') ∧
        (i = 0 → RTSub H Γ d D D') := by
  rw [RTSub.eq_def]
  simp only [List.mem_attach, forall_const, Subtype.forall]

theorem RTSub.fnSigma_iff {C Z W : List Tok} {A B : CTm Head n} :
    RTSub H Γ (.fn .sigma C Z W) A B ↔ ent [] (.fn .sigma C Z W) = true ∨
      ∃ D E D' E', SigmaSub H Γ A B D E D' E' ∧ (∀ c ∈ C, RTSub H Γ c D D') ∧
        (∀ N N', CEqual P Γ N N' D' → (∀ z ∈ Z, RT H Γ true z D' N N') →
          ∀ w ∈ W, RT H Γ false w (CTm.inst0 N E') (CTm.inst0 N E') (CTm.inst0 N' E')) ∧
        (∀ N, CTyped P Γ N D → (∀ z ∈ Z, RT H Γ true z D N N) →
          ∀ w ∈ W, RTSub H Γ w (CTm.inst0 N E) (CTm.inst0 N E')) := by
  rw [RTSub.eq_def]
  simp only [List.mem_attach, forall_const, Subtype.forall]

/-- **At the other tokens the subtyping mode is the relation.** -/
theorem RTSub.iff_of_kind {t : Tok} (hk : t ≠ .tag .univ ∧ t.kind ≠ .pi ∧ t.kind ≠ .sigma)
    {A B : CTm Head n} : RTSub H Γ t A B ↔ RT H Γ false t A A B := by
  have key : RTSub H Γ t A B ↔ ent [] t = true ∨ RT H Γ false t A A B := by
    obtain ⟨h1, h2, h3⟩ := hk
    rw [RTSub.eq_def]
    cases t with
    | tag k =>
        cases k <;> first | exact absurd rfl h1 | exact absurd rfl h2 | exact absurd rfl h3 |
          exact Iff.rfl
    | arg k i C d =>
        cases k <;> first | exact absurd rfl h2 | exact absurd rfl h3 | exact Iff.rfl
    | fn k C Z W =>
        cases k <;> first | exact absurd rfl h2 | exact absurd rfl h3 | exact Iff.rfl
  rw [key]
  exact ⟨fun h => h.elim RT.of_vacuous id, .inr⟩

theorem RTSub.codes_iff {A B : CTm Head n} :
    RTSub H Γ (.tag .codes) A B ↔ CRedTy H Γ A (.const K.prop) ∧ CRedTy H Γ B (.const K.prop) :=
  (RTSub.iff_of_kind (t := .tag .codes) ⟨nofun, nofun, nofun⟩).trans
    RT.ty_codes_iff

theorem RTSub.nat_iff {A B : CTm Head n} :
    RTSub H Γ (.tag .nat) A B ↔ CRedTy H Γ A (.const K.num) ∧ CRedTy H Γ B (.const K.num) :=
  (RTSub.iff_of_kind (t := .tag .nat) ⟨nofun, nofun, nofun⟩).trans
    RT.ty_nat_iff

theorem RTSub.data_iff {d : DeclName} {A B : CTm Head n} :
    RTSub H Γ (.tag (.data d)) A B ↔ DataRed H Γ d A B :=
  (RTSub.iff_of_kind (t := .tag (.data d)) ⟨nofun, nofun, nofun⟩).trans RT.ty_data_iff

theorem RTSub.ident_iff {A B : CTm Head n} :
    RTSub H Γ (.tag .ident) A B ↔ ∃ C x y C' x' y', IdRed H Γ A B C x y C' x' y' :=
  (RTSub.iff_of_kind (t := .tag .ident) ⟨nofun, nofun, nofun⟩).trans
    RT.ty_ident_iff

end Clauses

/-! ## Aligning reducts and reading components -/

section Components

variable {H} {n : Nat} {Γ : CCtx Head n}

theorem PiSub.align {A B D D' D₁ D₁' : CTm Head n} {E E' E₁ E₁' : CTm Head (n + 1)}
    (hp : PiSub H Γ A B D E D' E') (hp₁ : PiSub H Γ A B D₁ E₁ D₁' E₁') :
    D₁ = D ∧ E₁ = E ∧ D₁' = D' ∧ E₁' = E' := by
  obtain ⟨h1, h2⟩ := CRedTy.pi_align hp.1 hp₁.1
  obtain ⟨h3, h4⟩ := CRedTy.pi_align hp.2.1 hp₁.2.1
  exact ⟨h1, h2, h3, h4⟩

theorem SigmaSub.align {A B D D' D₁ D₁' : CTm Head n} {E E' E₁ E₁' : CTm Head (n + 1)}
    (hp : SigmaSub H Γ A B D E D' E') (hp₁ : SigmaSub H Γ A B D₁ E₁ D₁' E₁') :
    D₁ = D ∧ E₁ = E ∧ D₁' = D' ∧ E₁' = E' := by
  obtain ⟨h1, h2⟩ := CRedTy.sigma_align hp.1 hp₁.1
  obtain ⟨h3, h4⟩ := CRedTy.sigma_align hp.2.1 hp₁.2.1
  exact ⟨h1, h2, h3, h4⟩

theorem RTSub.pi_shape {s : Tok} (hk : s.kind = .pi) (hn : ent [] s = false)
    {A B : CTm Head n} (h : RTSub H Γ s A B) : ∃ D E D' E', PiSub H Γ A B D E D' E' := by
  cases s with
  | tag k =>
      cases hk
      exact RTSub.pi_iff.1 h
  | arg k i C d =>
      cases hk
      rcases RTSub.argPi_iff.1 h with hv | ⟨D, E, D', E', hp, _⟩
      · rw [hv] at hn; cases hn
      · exact ⟨D, E, D', E', hp⟩
  | fn k C Z W =>
      cases hk
      rcases RTSub.fnPi_iff.1 h with hv | ⟨D, E, D', E', hp, _⟩
      · rw [hv] at hn; cases hn
      · exact ⟨D, E, D', E', hp⟩

theorem RTSub.sigma_shape {s : Tok} (hk : s.kind = .sigma) (hn : ent [] s = false)
    {A B : CTm Head n} (h : RTSub H Γ s A B) : ∃ D E D' E', SigmaSub H Γ A B D E D' E' := by
  cases s with
  | tag k =>
      cases hk
      exact RTSub.sigma_iff.1 h
  | arg k i C d =>
      cases hk
      rcases RTSub.argSigma_iff.1 h with hv | ⟨D, E, D', E', hp, _⟩
      · rw [hv] at hn; cases hn
      · exact ⟨D, E, D', E', hp⟩
  | fn k C Z W =>
      cases hk
      rcases RTSub.fnSigma_iff.1 h with hv | ⟨D, E, D', E', hp, _⟩
      · rw [hv] at hn; cases hn
      · exact ⟨D, E, D', E', hp⟩

/-- **The subtyping mode is the relation below a type of another shape**: when `A`
reduces to a normal form that is no universe head and no dependent function or pair
type, the subtyping mode at every token of a witness is the relation there. -/
theorem RTSub.toEq_of_normal {a : List Tok} {A B X : CTm Head n}
    (hAB : ∀ s ∈ a, RTSub H Γ s A B) (rA : CRedTy H Γ A X) (normal : H.Normal X)
    (hX : (∀ h, X ≠ .head h) ∧ (∀ D E, X ≠ .pi D E) ∧ (∀ D E, X ≠ .sigma D E)) :
    ∀ s ∈ a, RT H Γ false s A A B := by
  intro s hs
  cases hv : ent [] s with
  | true => exact RT.of_vacuous hv
  | false =>
  rcases subTok_cases s with rfl | hk | hk | hk
  · obtain ⟨h₁, -, r₁, -⟩ := RTSub.univ_iff.1 (hAB _ hs)
    exact absurd (CRedTy.nf_unique rA r₁ normal (H.normal_head _)) (hX.1 h₁)
  · obtain ⟨D, E, -, -, r₁, -⟩ := RTSub.pi_shape hk hv (hAB _ hs)
    exact absurd (CRedTy.nf_unique rA r₁ normal (H.normal_pi _ _)) (hX.2.1 D E)
  · obtain ⟨D, E, -, -, r₁, -⟩ := RTSub.sigma_shape hk hv (hAB _ hs)
    exact absurd (CRedTy.nf_unique rA r₁ normal (H.normal_sigma _ _)) (hX.2.2 D E)
  · exact (RTSub.iff_of_kind hk).1 (hAB _ hs)

/-- The domain tokens of the subtyping mode at dependent function types relate the
domains. -/
theorem RTSub.pi_dom {v : List Tok} {A B D D' : CTm Head n} {E E' : CTm Head (n + 1)}
    (hp : PiSub H Γ A B D E D' E') (hv : ∀ s ∈ v, s.kind = .pi → RTSub H Γ s A B) :
    ∀ r ∈ args .pi 0 v, RT H Γ false r D D D' := by
  intro r hr
  rcases mem_args_iff.1 hr with ⟨C, hC⟩ | ⟨-, s, hs, hk, hd⟩
  · rcases RTSub.argPi_iff.1 (hv _ hC rfl) with hvac | ⟨D₁, E₁, D₁', E₁', hp₁, -, hr₁⟩
    · exact RT.of_vacuous (vacuous_arg hvac)
    · obtain ⟨rfl, rfl, rfl, rfl⟩ := hp.align hp₁
      exact hr₁ rfl
  · cases s with
    | tag k => cases hd
    | arg k i C d =>
        cases hk
        rcases RTSub.argPi_iff.1 (hv _ hs rfl) with hvac | ⟨D₁, E₁, D₁', E₁', hp₁, hC₁, -⟩
        · exact RT.of_vacuous (vacuous_dep hvac hd)
        · obtain ⟨rfl, rfl, rfl, rfl⟩ := hp.align hp₁
          exact hC₁ r hd
    | fn k C Z W =>
        cases hk
        rcases RTSub.fnPi_iff.1 (hv _ hs rfl) with hvac | ⟨D₁, E₁, D₁', E₁', hp₁, hC₁, -⟩
        · exact RT.of_vacuous (vacuous_dep hvac hd)
        · obtain ⟨rfl, rfl, rfl, rfl⟩ := hp.align hp₁
          exact hC₁ r hd

/-- The family entries of the subtyping mode at dependent function types put the
codomains at an argument related to itself in the subtyping mode, as far as the
outputs of the entries whose inputs the argument's tokens entail observe. -/
theorem RTSub.pi_fam {v X : List Tok} {A B D D' N : CTm Head n} {E E' : CTm Head (n + 1)}
    (hp : PiSub H Γ A B D E D' E') (hv : ∀ s ∈ v, s.kind = .pi → RTSub H Γ s A B)
    (tN : CTyped P Γ N D) (hN : ∀ x ∈ X, RT H Γ true x D N N) :
    ∀ r ∈ fnApp .pi v X, RTSub H Γ r (CTm.inst0 N E) (CTm.inst0 N E') := by
  intro r hr
  obtain ⟨C', Z', W', hm, hZ', hr'⟩ := mem_fnApp.1 hr
  rcases RTSub.fnPi_iff.1 (hv _ hm rfl) with hvac | ⟨D₁, E₁, D₁', E₁', hp₁, -, hg⟩
  · exact RTSub.of_vacuous (vacuous_out hvac hr')
  · obtain ⟨rfl, rfl, rfl, rfl⟩ := hp.align hp₁
    exact hg N tN (fun z hz => RT.closed' (hZ' z hz) hN) r hr'

/-- The domain tokens of the subtyping mode at dependent pair types put the domains in
the subtyping mode. -/
theorem RTSub.sigma_dom {v : List Tok} {A B D D' : CTm Head n} {E E' : CTm Head (n + 1)}
    (hp : SigmaSub H Γ A B D E D' E') (hv : ∀ s ∈ v, s.kind = .sigma → RTSub H Γ s A B) :
    ∀ r ∈ args .sigma 0 v, RTSub H Γ r D D' := by
  intro r hr
  rcases mem_args_iff.1 hr with ⟨C, hC⟩ | ⟨-, s, hs, hk, hd⟩
  · rcases RTSub.argSigma_iff.1 (hv _ hC rfl) with hvac | ⟨D₁, E₁, D₁', E₁', hp₁, -, hr₁⟩
    · exact RTSub.of_vacuous (vacuous_arg hvac)
    · obtain ⟨rfl, rfl, rfl, rfl⟩ := hp.align hp₁
      exact hr₁ rfl
  · cases s with
    | tag k => cases hd
    | arg k i C d =>
        cases hk
        rcases RTSub.argSigma_iff.1 (hv _ hs rfl) with hvac | ⟨D₁, E₁, D₁', E₁', hp₁, hC₁, -⟩
        · exact RTSub.of_vacuous (vacuous_dep hvac hd)
        · obtain ⟨rfl, rfl, rfl, rfl⟩ := hp.align hp₁
          exact hC₁ r hd
    | fn k C Z W =>
        cases hk
        rcases RTSub.fnSigma_iff.1 (hv _ hs rfl) with hvac | ⟨D₁, E₁, D₁', E₁', hp₁, hC₁, -⟩
        · exact RTSub.of_vacuous (vacuous_dep hvac hd)
        · obtain ⟨rfl, rfl, rfl, rfl⟩ := hp.align hp₁
          exact hC₁ r hd

/-- The family entries of the subtyping mode at dependent pair types put the families
at an argument related to itself in the subtyping mode. -/
theorem RTSub.sigma_famSub {v X : List Tok} {A B D D' N : CTm Head n}
    {E E' : CTm Head (n + 1)}
    (hp : SigmaSub H Γ A B D E D' E') (hv : ∀ s ∈ v, s.kind = .sigma → RTSub H Γ s A B)
    (tN : CTyped P Γ N D) (hN : ∀ x ∈ X, RT H Γ true x D N N) :
    ∀ r ∈ fnApp .sigma v X, RTSub H Γ r (CTm.inst0 N E) (CTm.inst0 N E') := by
  intro r hr
  obtain ⟨C', Z', W', hm, hZ', hr'⟩ := mem_fnApp.1 hr
  rcases RTSub.fnSigma_iff.1 (hv _ hm rfl) with hvac | ⟨D₁, E₁, D₁', E₁', hp₁, -, -, hg⟩
  · exact RTSub.of_vacuous (vacuous_out hvac hr')
  · obtain ⟨rfl, rfl, rfl, rfl⟩ := hp.align hp₁
    exact hg N tN (fun z hz => RT.closed' (hZ' z hz) hN) r hr'

/-- The family entries of the subtyping mode at dependent pair types relate the family
of the larger type at related arguments of its domain. -/
theorem RTSub.sigma_famRight {v X : List Tok} {A B D D' N N' : CTm Head n}
    {E E' : CTm Head (n + 1)}
    (hp : SigmaSub H Γ A B D E D' E') (hv : ∀ s ∈ v, s.kind = .sigma → RTSub H Γ s A B)
    (e : CEqual P Γ N N' D') (hN : ∀ x ∈ X, RT H Γ true x D' N N') :
    ∀ r ∈ fnApp .sigma v X,
      RT H Γ false r (CTm.inst0 N E') (CTm.inst0 N E') (CTm.inst0 N' E') := by
  intro r hr
  obtain ⟨C', Z', W', hm, hZ', hr'⟩ := mem_fnApp.1 hr
  rcases RTSub.fnSigma_iff.1 (hv _ hm rfl) with hvac | ⟨D₁, E₁, D₁', E₁', hp₁, -, hf, -⟩
  · exact RT.of_vacuous (vacuous_out hvac hr')
  · obtain ⟨rfl, rfl, rfl, rfl⟩ := hp.align hp₁
    exact hf N N' e (fun z hz => RT.closed' (hZ' z hz) hN) r hr'

end Components

/-! ## From equality, and head expansion -/

section Basic

variable {H} {L : Type} [LevelOrder L] (levels : LevelModel R L) {n : Nat} {Γ : CCtx Head n}
  (formed : CCtxFormed P Γ)

include levels formed in
theorem RT.toSub_aux : ∀ (N : Nat) {t : Tok}, t.depth < N → TyTok Elem.univ t →
    ∀ {A B : CTm Head n}, RT H Γ false t A A B → RTSub H Γ t A B
  | 0, _, h => absurd h (Nat.not_lt_zero _)
  | N + 1, t, ht => by
    intro hty A B h
    have IH := fun {s : Tok} (hs : s.depth < N) => RT.toSub_aux N hs
    have sub : ∀ {s : Tok}, s.depth < t.depth → s.depth < N := fun hs => by omega
    cases hv : ent [] t with
    | true => exact RTSub.of_vacuous hv
    | false =>
    have other : (t ≠ .tag .univ ∧ t.kind ≠ .pi ∧ t.kind ≠ .sigma) → RTSub H Γ t A B :=
      fun hk => (RTSub.iff_of_kind hk).2 h
    cases t with
    | tag k =>
        cases k
        case univ =>
          obtain ⟨h₁, h₂, r₁, r₂, u₁, u₂, same⟩ := RT.ty_univ_iff.1 h
          exact RTSub.univ_iff.2 ⟨h₁, h₂, r₁, r₂, u₁, u₂, .single (.inl same)⟩
        case pi =>
          obtain ⟨D, E, D', E', r₁, r₂, eD, eE⟩ := RT.ty_pi_iff.1 h
          exact RTSub.pi_iff.2 ⟨D, E, D', E', r₁, r₂, eD, eE.below⟩
        case sigma =>
          obtain ⟨D, E, D', E', r₁, r₂, eD, eE⟩ := RT.ty_sigma_iff.1 h
          exact RTSub.sigma_iff.2 ⟨D, E, D', E', r₁, r₂, eD.below, eE.below⟩
        all_goals exact other ⟨nofun, nofun, nofun⟩
    | arg k i C d =>
        rcases kind_cases_tySigma k with rfl | rfl | rfl | ⟨dn, rfl⟩ | hk
        · rcases RT.ty_argPi_iff.1 h with hvac | ⟨D, E, D', E', ⟨r₁, r₂, eD, eE⟩, hC, hd⟩
          · exact RTSub.of_vacuous hvac
          · exact RTSub.argPi_iff.2 (.inr ⟨D, E, D', E', ⟨r₁, r₂, eD, eE.below⟩, hC, hd⟩)
        · exact other ⟨nofun, nofun, nofun⟩
        · rcases i with _ | i
          · obtain ⟨-, rfl, hd⟩ := (tyTok_dom (.inr (.inl rfl))).1 hty
            rcases RT.ty_argSigma_iff.1 h with hvac | ⟨D, E, D', E', ⟨r₁, r₂, eD, eE⟩, -, hdd⟩
            · exact RTSub.of_vacuous hvac
            · exact RTSub.argSigma_iff.2 (.inr ⟨D, E, D', E', ⟨r₁, r₂, eD.below, eE.below⟩,
                fun c hc => absurd hc List.not_mem_nil,
                fun _ => IH (sub (depth_lt_arg _ _ _ _)) hd (hdd rfl)⟩)
          · exact absurd hty tyTok_argSigma_succ
        · exact other ⟨nofun, nofun, nofun⟩
        · exact other ⟨nofun, hk.1, hk.2.2.1⟩
    | fn k C Z W =>
        rcases kind_cases_tySigma k with rfl | rfl | rfl | ⟨dn, rfl⟩ | hk
        · obtain ⟨-, -, -, hW⟩ := (tyTok_family (.inl rfl)).1 hty
          rcases RT.ty_fnPi_iff.1 h with hvac | ⟨D, E, D', E', ⟨r₁, r₂, eD, eE⟩, hc, -, hg⟩
          · exact RTSub.of_vacuous hvac
          · exact RTSub.fnPi_iff.2 (.inr ⟨D, E, D', E', ⟨r₁, r₂, eD, eE.below⟩, hc,
              fun N₁ tN hz w hw => IH (sub (depth_lt_fn_right hw)) (hW w hw) (hg N₁ tN hz w hw)⟩)
        · exact other ⟨nofun, nofun, nofun⟩
        · obtain ⟨-, hC, hZ, hW⟩ := (tyTok_family (.inr rfl)).1 hty
          rcases RT.ty_fnSigma_iff.1 h with hvac | ⟨D, E, D', E', ⟨r₁, r₂, eD, eE⟩, hc, hf, hg⟩
          · exact RTSub.of_vacuous hvac
          -- arguments related at the larger domain are related at the smaller one
          have zConv : ∀ {N₁ N₁' : CTm Head n}, (∀ z ∈ Z, RT H Γ true z D' N₁ N₁') →
              ∀ z ∈ Z, RT H Γ true z D N₁ N₁' := fun hz z hzZ =>
            (RT.conv_iff levels formed hC (hZ z hzZ) hc eD).2 (hz z hzZ)
          exact RTSub.fnSigma_iff.2 (.inr ⟨D, E, D', E', ⟨r₁, r₂, eD.below, eE.below⟩,
            fun c hc' => IH (sub (Tok.depth_lt_of_mem_dep (t := .fn .sigma C Z W) hc'))
              (hC c hc') (hc c hc'),
            fun N₁ N₁' hNN hz w hw => (hf N₁ N₁' (hNN.convType eD.symm) (zConv hz) w hw).2,
            fun N₁ tN hz w hw => IH (sub (depth_lt_fn_right hw)) (hW w hw) (hg N₁ tN hz w hw)⟩)
        · exact other ⟨nofun, nofun, nofun⟩
        · exact other ⟨nofun, hk.1, hk.2.2.1⟩

include levels formed in
/-- **Related types are in the subtyping mode.** -/
theorem RT.toSub {t : Tok} (hty : TyTok Elem.univ t) {A B : CTm Head n}
    (h : RT H Γ false t A A B) : RTSub H Γ t A B :=
  RT.toSub_aux levels formed _ (Nat.lt_succ_self _) hty h

include levels in
/-- **Head expansion of the subtyping mode**: types in the subtyping mode as far as a
token observes stay so when either is replaced by a type that reduces to it. -/
theorem RTSub.expand {t : Tok} {x x' y y' : CTm Head n} (rx : CRedTy H Γ x y)
    (rx' : CRedTy H Γ x' y') (h : RTSub H Γ t y y') : RTSub H Γ t x x' := by
  cases hv : ent [] t with
  | true => exact RTSub.of_vacuous hv
  | false =>
  have pi : ∀ {D D' : CTm Head n} {E E' : CTm Head (n + 1)}, PiSub H Γ y y' D E D' E' →
      PiSub H Γ x x' D E D' E' := fun ⟨r, r', e, e'⟩ =>
    ⟨rx.trans levels r, rx'.trans levels r', e, e'⟩
  have sigma : ∀ {D D' : CTm Head n} {E E' : CTm Head (n + 1)}, SigmaSub H Γ y y' D E D' E' →
      SigmaSub H Γ x x' D E D' E' := fun ⟨r, r', e, e'⟩ =>
    ⟨rx.trans levels r, rx'.trans levels r', e, e'⟩
  have other : (t ≠ .tag .univ ∧ t.kind ≠ .pi ∧ t.kind ≠ .sigma) → RTSub H Γ t x x' :=
    fun hk => (RTSub.iff_of_kind hk).2
      (RT.expand_ty levels rx rx' ((RTSub.iff_of_kind hk).1 h))
  cases t with
  | tag k =>
      cases k
      case univ =>
        obtain ⟨h₁, h₂, r₁, r₂, u₁, u₂, le⟩ := RTSub.univ_iff.1 h
        exact RTSub.univ_iff.2 ⟨h₁, h₂, rx.trans levels r₁, rx'.trans levels r₂, u₁, u₂, le⟩
      case pi =>
        obtain ⟨D, E, D', E', hp⟩ := RTSub.pi_iff.1 h
        exact RTSub.pi_iff.2 ⟨D, E, D', E', pi hp⟩
      case sigma =>
        obtain ⟨D, E, D', E', hp⟩ := RTSub.sigma_iff.1 h
        exact RTSub.sigma_iff.2 ⟨D, E, D', E', sigma hp⟩
      all_goals exact other ⟨nofun, nofun, nofun⟩
  | arg k i C d =>
      rcases kind_cases_tySigma k with rfl | rfl | rfl | ⟨dn, rfl⟩ | hk
      · rcases RTSub.argPi_iff.1 h with hvac | ⟨D, E, D', E', hp, rest⟩
        · exact RTSub.of_vacuous hvac
        · exact RTSub.argPi_iff.2 (.inr ⟨D, E, D', E', pi hp, rest⟩)
      · exact other ⟨nofun, nofun, nofun⟩
      · rcases RTSub.argSigma_iff.1 h with hvac | ⟨D, E, D', E', hp, rest⟩
        · exact RTSub.of_vacuous hvac
        · exact RTSub.argSigma_iff.2 (.inr ⟨D, E, D', E', sigma hp, rest⟩)
      · exact other ⟨nofun, nofun, nofun⟩
      · exact other ⟨nofun, hk.1, hk.2.2.1⟩
  | fn k C Z W =>
      rcases kind_cases_tySigma k with rfl | rfl | rfl | ⟨dn, rfl⟩ | hk
      · rcases RTSub.fnPi_iff.1 h with hvac | ⟨D, E, D', E', hp, rest⟩
        · exact RTSub.of_vacuous hvac
        · exact RTSub.fnPi_iff.2 (.inr ⟨D, E, D', E', pi hp, rest⟩)
      · exact other ⟨nofun, nofun, nofun⟩
      · rcases RTSub.fnSigma_iff.1 h with hvac | ⟨D, E, D', E', hp, rest⟩
        · exact RTSub.of_vacuous hvac
        · exact RTSub.fnSigma_iff.2 (.inr ⟨D, E, D', E', sigma hp, rest⟩)
      · exact other ⟨nofun, nofun, nofun⟩
      · exact other ⟨nofun, hk.1, hk.2.2.1⟩

end Basic

/-! ## Subsumption -/

section SubConv

variable {H} {L : Type} [LevelOrder L] (levels : LevelModel R L) {n : Nat} {Γ : CCtx Head n}
  (formed : CCtxFormed P Γ)

/-- A typed reduction at a type is one at every type it is usable at. -/
theorem CRedTm.sub {a b A B : CTm Head n} (r : CRedTm H Γ a b A) (le : CBelow P Γ A B) :
    CRedTm H Γ a b B :=
  ⟨r.1, .subEq r.2 le⟩

include levels formed in
theorem RT.subConv_aux : ∀ (N : Nat) {t : Tok} {a : List Tok}, t.depth < N →
    Ty a Elem.univ → TyTok a t → ∀ {A B M M' : CTm Head n}, (∀ s ∈ a, RTSub H Γ s A B) →
      CBelow P Γ A B → RT H Γ true t A M M' → RT H Γ true t B M M'
  | 0, _, _, h => absurd h (Nat.not_lt_zero _)
  | N + 1, t, a, ht => by
    intro ha hta A B M M' hAB le h
    have IH := fun {s : Tok} {a : List Tok} (hs : s.depth < N) => RT.subConv_aux N (a := a) hs
    have sub : ∀ {s : Tok}, s.depth < t.depth → s.depth < N := fun hs => by omega
    cases hv : ent [] t with
    | true => exact RT.of_vacuous hv
    | false =>
    cases htk : typeKind t.kind with
    | true =>
        obtain ⟨hU, -⟩ := tyTok_univ_of_typeKind htk hta
        rcases (RT.tm_type_iff htk).1 h with hvac | ⟨_, _, hA, hr⟩ | ⟨hA, hr⟩
        · exact RT.of_vacuous hvac
        · rcases hU with hu | hc
          · obtain ⟨_, _, _, r₂, _, u₂, _⟩ := RTSub.univ_iff.1 (hAB _ hu)
            exact RT.ofType htk u₂ r₂ hr
          · exact (CRedTy.head_ne_prop hA (RTSub.codes_iff.1 (hAB _ hc)).1).elim
        · rcases hU with hu | hc
          · obtain ⟨_, _, r₁, _, _, _, _⟩ := RTSub.univ_iff.1 (hAB _ hu)
            exact (CRedTy.head_ne_prop r₁ hA).elim
          · exact RT.ofCodes htk (RTSub.codes_iff.1 (hAB _ hc)).2 hr
    | false =>
    -- below a type of another shape, subsumption is conversion
    have viaNormal : ∀ {X : CTm Head n}, CRedTy H Γ A X → H.Normal X →
        ((∀ h, X ≠ .head h) ∧ (∀ D E, X ≠ .pi D E) ∧ (∀ D E, X ≠ .sigma D E)) →
        CTypeEq P Γ A B → RT H Γ true t B M M' := fun rA nX hX eAB =>
      (RT.conv_iff levels formed ha hta (RTSub.toEq_of_normal hAB rA nX hX) eAB).1 h
    have viaIdent : Tok.tag .ident ∈ a → RT H Γ true t B M M' := fun hid => by
      obtain ⟨B₁, y₁, z₁, B₂, y₂, z₂, hi⟩ := RTSub.ident_iff.1 (hAB _ hid)
      obtain ⟨u, hu, eB⟩ := hi.2.2.1
      have eId : CTypeEq P Γ (.id B₁ y₁ z₁) (.id B₂ y₂ z₂) :=
        ⟨u, hu, .idCong eB hu hi.2.2.2.1 hi.2.2.2.2⟩
      exact viaNormal hi.1 (H.normal_id _ _ _)
        ⟨fun _ => nofun, fun _ _ => nofun, fun _ _ => nofun⟩
        (CTypeEq.trans levels hi.1.2 (CTypeEq.trans levels eId hi.2.1.2.symm))
    have viaNat : Tok.tag .nat ∈ a → RT H Γ true t B M M' := fun hnat => by
      obtain ⟨rA, rB⟩ := RTSub.nat_iff.1 (hAB _ hnat)
      exact viaNormal rA H.normal_num
        ⟨fun _ => nofun, fun _ _ => nofun, fun _ _ => nofun⟩
        (CTypeEq.trans levels rA.2 rB.2.symm)
    have viaData : ∀ {d : DeclName}, Tok.tag (.data d) ∈ a → RT H Γ true t B M M' :=
      fun hdat => by
        obtain ⟨hd, rA, rB⟩ := RTSub.data_iff.1 (hAB _ hdat)
        exact viaNormal rA (H.normal_data hd)
          ⟨fun _ => nofun, fun _ _ => nofun, fun _ _ => nofun⟩
          (CTypeEq.trans levels rA.2 rB.2.symm)
    cases t with
    | tag k =>
        cases k
        case refl => exact viaIdent (tyTok_tag_refl.1 hta)
        case zero => exact viaNat (tyTok_tag_zero.1 hta)
        case succ => exact viaNat (tyTok_tag_succ.1 hta)
        case pair => exact absurd hta tyTok_tag_pair
        case ctor d c fs => exact viaData (tyTok_tag_ctor.1 hta)
        all_goals
          exact RT.tm_other htk (fun _ _ _ e => nomatch e)
            (by intro e; cases e) (by intro e; cases e) (by intro e; cases e) (by intro e; cases e)
            (fun _ _ _ e => nomatch e)
    | arg k i C d =>
        rcases kind_cases_tmPair k with rfl | rfl | rfl | rfl | ⟨dn, cn, fs, rfl⟩ | hk
        · exact RT.tm_other htk (fun _ _ _ e => nomatch e) (by intro e; cases e)
            (fun e => nomatch e) (by intro e; cases e) (by intro e; cases e)
            (fun _ _ _ e => nomatch e)
        · refine viaIdent ?_
          rcases i with _ | i
          · exact (tyTok_reflPoint.1 hta).1
          · exact absurd hta tyTok_reflPoint_succ
        · refine viaNat ?_
          rcases i with _ | i
          · exact (tyTok_pred.1 hta).1
          · exact absurd hta tyTok_pred_succ
        · rcases i with _ | _ | i
          · -- the first projections
            obtain ⟨hsig, hC, hsa⟩ := tyTok_fst.1 hta
            subst hC
            obtain ⟨D₁, E₁, D₂, E₂, hp⟩ := RTSub.sigma_iff.1 (hAB _ hsig)
            have hdom := RTSub.sigma_dom hp (fun s hs _ => hAB s hs)
            have hdomTy : Ty (args .sigma 0 a) Elem.univ := Ideal.ty_args_dom (.inr rfl) ha
            have hd : d.depth < N := sub (depth_lt_arg .pair 0 [] d)
            rcases RT.tm_argPair_iff.1 h with hvac | hcl
            · exact RT.of_vacuous hvac
            refine RT.tm_argPair_iff.2 (.inr fun D E hB => ?_)
            obtain ⟨rfl, rfl⟩ := CRedTy.sigma_align hB hp.2.1
            obtain ⟨e₀, -, h0, -⟩ := hcl D₁ E₁ hp.1
            exact ⟨.subEq e₀ hp.2.2.1, fun c hc => absurd hc List.not_mem_nil,
              fun _ => IH hd hdomTy hsa hdom hp.2.2.1 (h0 rfl), fun h1 => absurd h1 (by decide)⟩
          · -- the second projections
            obtain ⟨hsig, hCty, hsa⟩ := tyTok_snd.1 hta
            obtain ⟨D₁, E₁, D₂, E₂, hp⟩ := RTSub.sigma_iff.1 (hAB _ hsig)
            have hdom := RTSub.sigma_dom hp (fun s hs _ => hAB s hs)
            have hdomTy : Ty (args .sigma 0 a) Elem.univ := Ideal.ty_args_dom (.inr rfl) ha
            have hfamTy : Ty (fnApp .sigma a C) Elem.univ := Ideal.ty_fnApp (.inr rfl) ha C
            have hd : d.depth < N := sub (depth_lt_arg .pair 1 C d)
            rcases RT.tm_argPair_iff.1 h with hvac | hcl
            · exact RT.of_vacuous hvac
            refine RT.tm_argPair_iff.2 (.inr fun D E hB => ?_)
            obtain ⟨rfl, rfl⟩ := CRedTy.sigma_align hB hp.2.1
            obtain ⟨e₀, hC, -, h1⟩ := hcl D₁ E₁ hp.1
            have hC₂ : ∀ c ∈ C, RT H Γ true c D₂ (.fst M) (.fst M') := fun c hc =>
              IH (sub (Tok.depth_lt_of_mem_dep (t := .arg .pair 1 C d) hc)) hdomTy (hCty c hc)
                hdom hp.2.2.1 (hC c hc)
            refine ⟨.subEq e₀ hp.2.2.1, hC₂, fun h0 => absurd h0 (by decide),
              fun _ N₁ Q hQ hNQ => ?_⟩
            -- at the first projection of the left term, from the family of `A` to that of `B`
            have tfst : CTyped P Γ (.fst M) D₁ := (CEqual.typed levels e₀ formed).1
            have h₂ : RT H Γ true d (CTm.inst0 (.fst M) E₂) (.snd M) (.snd M') :=
              IH hd hfamTy hsa
                (RTSub.sigma_famSub hp (fun s hs _ => hAB s hs) tfst fun c hc => RT.left (hC c hc))
                (hp.2.2.2.instantiate tfst)
                (h1 rfl (.fst M) (.fst M) (CRedTm.refl tfst) (CRedTm.refl tfst))
            -- along the family of `B`, to a term with a common reduct
            have tfst₂ : CTyped P Γ (.fst M) D₂ := .sub tfst hp.2.2.1
            have eN : CEqual P Γ (.fst M) N₁ D₂ := .trans hQ.2 (.symm hNQ.2)
            have hZ : ∀ c ∈ C, RT H Γ true c D₂ (.fst M) N₁ := fun c hc =>
              RT.retarget levels formed tfst₂ (RT.left (hC₂ c hc)) hQ hNQ
            have hE₂ : CIsType P (.snoc Γ D₂) E₂ :=
              ((CTypeEq.isType levels hp.2.1.2 formed).2.sigma_parts).2
            exact (RT.conv_iff levels formed hfamTy hsa
              (RTSub.sigma_famRight hp (fun s hs _ => hAB s hs) eN hZ)
              (hE₂.instantiateEq tfst₂ eN)).1 h₂
          · exact absurd hta tyTok_pair_high
        · exact viaData (tyTok_field.1 hta).1
        · exact RT.tm_other htk (fun _ _ _ e => nomatch e) hk.2.1
            (fun e => nomatch e) hk.2.2.1 hk.2.2.2.1 hk.2.2.2.2
    | fn k C X Y =>
        rcases kind_cases_tmPair k with rfl | rfl | rfl | rfl | ⟨dn, cn, fs, rfl⟩ | hk
        · obtain ⟨hpi, -, hX, hY⟩ := tyTok_lam.1 hta
          obtain ⟨D₁, E₁, D₂, E₂, hp⟩ := RTSub.pi_iff.1 (hAB _ hpi)
          have hdom : ∀ r ∈ args .pi 0 a, RT H Γ false r D₁ D₁ D₂ :=
            RTSub.pi_dom hp (fun s hs _ => hAB s hs)
          have hdomTy : Ty (args .pi 0 a) Elem.univ := Ideal.ty_args_dom (.inl rfl) ha
          have hfamTy : Ty (fnApp .pi a X) Elem.univ := Ideal.ty_fnApp (.inl rfl) ha X
          have eD : CTypeEq P Γ D₁ D₂ := hp.2.2.1
          -- arguments at the larger domain are arguments at the smaller one
          have argConv : ∀ {N₁ N₁' : CTm Head n}, (∀ x ∈ X, RT H Γ true x D₂ N₁ N₁') →
              ∀ x ∈ X, RT H Γ true x D₁ N₁ N₁' := fun h' x hx =>
            (RT.conv_iff levels formed hdomTy (hX x hx) hdom eD).2 (h' x hx)
          -- values at the smaller codomain are values at the larger one
          have famSub : ∀ {N₁ : CTm Head n}, CTyped P Γ N₁ D₁ →
              (∀ x ∈ X, RT H Γ true x D₁ N₁ N₁) → ∀ y ∈ Y, ∀ {M₁ M₂ : CTm Head n},
                RT H Γ true y (CTm.inst0 N₁ E₁) M₁ M₂ → RT H Γ true y (CTm.inst0 N₁ E₂) M₁ M₂ :=
            fun tN₁ hN₁ y hy _ _ hy' =>
              IH (sub (depth_lt_fn_right hy)) hfamTy (hY y hy)
                (RTSub.pi_fam hp (fun s hs _ => hAB s hs) tN₁ hN₁) (hp.2.2.2.instantiate tN₁) hy'
          rcases RT.tm_lam_iff.1 h with hvac | hcl
          · exact RT.of_vacuous hvac
          refine RT.tm_lam_iff.2 (.inr fun D E hB => ?_)
          obtain ⟨rfl, rfl⟩ := CRedTy.pi_align hB hp.2.1
          obtain ⟨hi, hii⟩ := hcl D₁ E₁ hp.1
          refine ⟨fun N₁ N₁' hNN hX' y hy => ?_, fun N₁ tN₁ hX' y hy => ?_⟩
          · have hNN₁ : CEqual P Γ N₁ N₁' D₁ := hNN.convType eD.symm
            have hX₁ := argConv hX'
            have tN₁ := (CEqual.typed levels hNN₁ formed).1
            have hself : ∀ x ∈ X, RT H Γ true x D₁ N₁ N₁ := fun x hx => RT.left (hX₁ x hx)
            obtain ⟨h1, h2⟩ := hi N₁ N₁' hNN₁ hX₁ y hy
            exact ⟨famSub tN₁ hself y hy h1, famSub tN₁ hself y hy h2⟩
          · have tN₁' : CTyped P Γ N₁ D₁ := tN₁.convType eD.symm
            have hX₁ := argConv hX'
            exact famSub tN₁' hX₁ y hy (hii N₁ tN₁' hX₁ y hy)
        · exact absurd hta (tyTok_fn_other (by simp))
        · exact absurd hta (tyTok_fn_other (by simp))
        · exact absurd hta (tyTok_fn_other (by simp))
        · exact absurd hta (tyTok_fn_other (by simp))
        · exact RT.tm_other htk (fun _ _ _ e => by cases e; exact hk.1 rfl) hk.2.1
            (fun e => nomatch e) hk.2.2.1 hk.2.2.2.1 hk.2.2.2.2

include levels formed in
/-- **Subsumption.** At a token typed at a type witness `a`, terms related at `A` are
related at `B`, when `A ⊑ B` and `A` is usable at `B` as far as `a` observes. -/
theorem RT.subConv {t : Tok} {a : List Tok} (ha : Ty a Elem.univ) (hta : TyTok a t)
    {A B M M' : CTm Head n} (hAB : ∀ s ∈ a, RTSub H Γ s A B) (le : CBelow P Γ A B)
    (h : RT H Γ true t A M M') : RT H Γ true t B M M' :=
  RT.subConv_aux levels formed _ (Nat.lt_succ_self _) ha hta hAB le h

end SubConv

/-! ## Transitivity -/

section Trans

variable {H} {L : Type} [LevelOrder L] (levels : LevelModel R L) {n : Nat} {Γ : CCtx Head n}
  (formed : CCtxFormed P Γ)

theorem UnivSub.trans {A₁ A₂ A₃ : CTm Head n} (h₁ : UnivSub H Γ A₁ A₂)
    (h₂ : UnivSub H Γ A₂ A₃) : UnivSub H Γ A₁ A₃ := by
  obtain ⟨u₁, u₂, r₁, r₂, hu₁, -, le₁⟩ := h₁
  obtain ⟨u₂', u₃, r₂', r₃, -, hu₃, le₂⟩ := h₂
  have e := CRedTy.nf_unique r₂' r₂ (H.normal_head _) (H.normal_head _)
  injection e with _ e
  subst e
  exact ⟨u₁, u₃, r₁, r₃, hu₁, hu₃, le₁.trans le₂⟩

include levels in
theorem PiSub.trans {A₁ A₂ A₃ D₁ D₂ D₂' D₃ : CTm Head n} {E₁ E₂ E₂' E₃ : CTm Head (n + 1)}
    (h₁ : PiSub H Γ A₁ A₂ D₁ E₁ D₂ E₂) (h₂ : PiSub H Γ A₂ A₃ D₂' E₂' D₃ E₃) :
    PiSub H Γ A₁ A₃ D₁ E₁ D₃ E₃ := by
  obtain ⟨rfl, rfl⟩ := CRedTy.pi_align h₁.2.1 h₂.1
  exact ⟨h₁.1, h₂.2.1, CTypeEq.trans levels h₁.2.2.1 h₂.2.2.1,
    .subTrans h₁.2.2.2 (h₂.2.2.2.ctxConv h₁.2.2.1.symm)⟩

theorem SigmaSub.trans {A₁ A₂ A₃ D₁ D₂ D₂' D₃ : CTm Head n} {E₁ E₂ E₂' E₃ : CTm Head (n + 1)}
    (h₁ : SigmaSub H Γ A₁ A₂ D₁ E₁ D₂ E₂) (h₂ : SigmaSub H Γ A₂ A₃ D₂' E₂' D₃ E₃) :
    SigmaSub H Γ A₁ A₃ D₁ E₁ D₃ E₃ := by
  obtain ⟨rfl, rfl⟩ := CRedTy.sigma_align h₁.2.1 h₂.1
  exact ⟨h₁.1, h₂.2.1, .subTrans h₁.2.2.1 h₂.2.2.1,
    .subTrans h₁.2.2.2 (h₂.2.2.2.ctxBelow h₁.2.2.1)⟩

include levels formed in
theorem RTSub.trans_aux : ∀ (N : Nat) {t : Tok}, t.depth < N → TyTok Elem.univ t →
    ∀ {A₁ A₂ A₃ : CTm Head n}, RTSub H Γ t A₁ A₂ → RTSub H Γ t A₂ A₃ → RTSub H Γ t A₁ A₃
  | 0, _, h => absurd h (Nat.not_lt_zero _)
  | N + 1, t, ht => by
    intro hty A₁ A₂ A₃ h₁ h₂
    have IH := fun {s : Tok} (hs : s.depth < N) => RTSub.trans_aux N hs
    have sub : ∀ {s : Tok}, s.depth < t.depth → s.depth < N := fun hs => by omega
    cases hv : ent [] t with
    | true => exact RTSub.of_vacuous hv
    | false =>
    have other : (t ≠ .tag .univ ∧ t.kind ≠ .pi ∧ t.kind ≠ .sigma) → RTSub H Γ t A₁ A₃ :=
      fun hk => (RTSub.iff_of_kind hk).2 (RT.trans_ty levels formed hty
        ((RTSub.iff_of_kind hk).1 h₁) ((RTSub.iff_of_kind hk).1 h₂))
    cases t with
    | tag k =>
        cases k
        case univ => exact RTSub.univ_iff.2 ((RTSub.univ_iff.1 h₁).trans (RTSub.univ_iff.1 h₂))
        case pi =>
          obtain ⟨D₁, E₁, D₂, E₂, p₁⟩ := RTSub.pi_iff.1 h₁
          obtain ⟨D₂', E₂', D₃, E₃, p₂⟩ := RTSub.pi_iff.1 h₂
          exact RTSub.pi_iff.2 ⟨D₁, E₁, D₃, E₃, p₁.trans levels p₂⟩
        case sigma =>
          obtain ⟨D₁, E₁, D₂, E₂, p₁⟩ := RTSub.sigma_iff.1 h₁
          obtain ⟨D₂', E₂', D₃, E₃, p₂⟩ := RTSub.sigma_iff.1 h₂
          exact RTSub.sigma_iff.2 ⟨D₁, E₁, D₃, E₃, p₁.trans p₂⟩
        all_goals exact other ⟨nofun, nofun, nofun⟩
    | arg k i C d =>
        rcases kind_cases_tySigma k with rfl | rfl | rfl | ⟨dn, rfl⟩ | hk
        · rcases i with _ | i
          · obtain ⟨-, rfl, hd⟩ := (tyTok_dom (.inl rfl)).1 hty
            rcases RTSub.argPi_iff.1 h₁ with hvac | ⟨D₁, E₁, D₂, E₂, p₁, -, hd₁⟩
            · exact RTSub.of_vacuous hvac
            rcases RTSub.argPi_iff.1 h₂ with hvac | ⟨D₂', E₂', D₃, E₃, p₂, -, hd₂⟩
            · exact RTSub.of_vacuous hvac
            obtain ⟨rfl, rfl⟩ := CRedTy.pi_align p₁.2.1 p₂.1
            exact RTSub.argPi_iff.2 (.inr ⟨D₁, E₁, D₃, E₃, p₁.trans levels p₂,
              fun c hc => absurd hc List.not_mem_nil,
              fun _ => RT.trans_ty levels formed hd (hd₁ rfl) (hd₂ rfl)⟩)
          · exact absurd hty tyTok_argPi_succ
        · exact other ⟨nofun, nofun, nofun⟩
        · rcases i with _ | i
          · obtain ⟨-, rfl, hd⟩ := (tyTok_dom (.inr (.inl rfl))).1 hty
            rcases RTSub.argSigma_iff.1 h₁ with hvac | ⟨D₁, E₁, D₂, E₂, p₁, -, hd₁⟩
            · exact RTSub.of_vacuous hvac
            rcases RTSub.argSigma_iff.1 h₂ with hvac | ⟨D₂', E₂', D₃, E₃, p₂, -, hd₂⟩
            · exact RTSub.of_vacuous hvac
            obtain ⟨rfl, rfl⟩ := CRedTy.sigma_align p₁.2.1 p₂.1
            exact RTSub.argSigma_iff.2 (.inr ⟨D₁, E₁, D₃, E₃, p₁.trans p₂,
              fun c hc => absurd hc List.not_mem_nil,
              fun _ => IH (sub (depth_lt_arg _ _ _ _)) hd (hd₁ rfl) (hd₂ rfl)⟩)
          · exact absurd hty tyTok_argSigma_succ
        · exact other ⟨nofun, nofun, nofun⟩
        · exact other ⟨nofun, hk.1, hk.2.2.1⟩
    | fn k C Z W =>
        rcases kind_cases_tySigma k with rfl | rfl | rfl | ⟨dn, rfl⟩ | hk
        · obtain ⟨-, hC, hZ, hW⟩ := (tyTok_family (.inl rfl)).1 hty
          rcases RTSub.fnPi_iff.1 h₁ with hvac | ⟨D₁, E₁, D₂, E₂, p₁, hc₁, hg₁⟩
          · exact RTSub.of_vacuous hvac
          rcases RTSub.fnPi_iff.1 h₂ with hvac | ⟨D₂', E₂', D₃, E₃, p₂, hc₂, hg₂⟩
          · exact RTSub.of_vacuous hvac
          obtain ⟨rfl, rfl⟩ := CRedTy.pi_align p₁.2.1 p₂.1
          refine RTSub.fnPi_iff.2 (.inr ⟨D₁, E₁, D₃, E₃, p₁.trans levels p₂,
            fun c hc => RT.trans_ty levels formed (hC c hc) (hc₁ c hc) (hc₂ c hc),
            fun N₁ tN₁ hz w hw => ?_⟩)
          have tN₂ := tN₁.convType p₁.2.2.1
          have hz₂ : ∀ z ∈ Z, RT H Γ true z _ N₁ N₁ := fun z hz' =>
            (RT.conv_iff levels formed hC (hZ z hz') hc₁ p₁.2.2.1).1 (hz z hz')
          exact IH (sub (depth_lt_fn_right hw)) (hW w hw) (hg₁ N₁ tN₁ hz w hw)
            (hg₂ N₁ tN₂ hz₂ w hw)
        · exact other ⟨nofun, nofun, nofun⟩
        · obtain ⟨-, hC, hZ, hW⟩ := (tyTok_family (.inr rfl)).1 hty
          rcases RTSub.fnSigma_iff.1 h₁ with hvac | ⟨D₁, E₁, D₂, E₂, p₁, hc₁, -, hg₁⟩
          · exact RTSub.of_vacuous hvac
          rcases RTSub.fnSigma_iff.1 h₂ with hvac | ⟨D₂', E₂', D₃, E₃, p₂, hc₂, hf₂, hg₂⟩
          · exact RTSub.of_vacuous hvac
          obtain ⟨rfl, rfl⟩ := CRedTy.sigma_align p₁.2.1 p₂.1
          refine RTSub.fnSigma_iff.2 (.inr ⟨D₁, E₁, D₃, E₃, p₁.trans p₂,
            fun c hc => IH (sub (Tok.depth_lt_of_mem_dep (t := .fn .sigma C Z W) hc)) (hC c hc)
              (hc₁ c hc) (hc₂ c hc),
            hf₂, fun N₁ tN₁ hz w hw => ?_⟩)
          have tN₂ := CDerivable.sub tN₁ p₁.2.2.1
          have hz₂ : ∀ z ∈ Z, RT H Γ true z _ N₁ N₁ := fun z hz' =>
            RT.subConv levels formed hC (hZ z hz') hc₁ p₁.2.2.1 (hz z hz')
          exact IH (sub (depth_lt_fn_right hw)) (hW w hw) (hg₁ N₁ tN₁ hz w hw)
            (hg₂ N₁ tN₂ hz₂ w hw)
        · exact other ⟨nofun, nofun, nofun⟩
        · exact other ⟨nofun, hk.1, hk.2.2.1⟩

include levels formed in
/-- **Transitivity of the subtyping mode.** -/
theorem RTSub.trans {t : Tok} (hty : TyTok Elem.univ t) {A₁ A₂ A₃ : CTm Head n}
    (h₁ : RTSub H Γ t A₁ A₂) (h₂ : RTSub H Γ t A₂ A₃) : RTSub H Γ t A₁ A₃ :=
  RTSub.trans_aux levels formed _ (Nat.lt_succ_self _) hty h₁ h₂

end Trans

