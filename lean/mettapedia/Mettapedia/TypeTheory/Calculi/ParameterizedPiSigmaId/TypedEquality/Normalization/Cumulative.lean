import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.TypedEquality.Normalization.WrittenDomains
import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.TypedEquality.Normalization.Algorithmic.TypeForms

/-!
# Cumulative subtyping of types

`Below R Γ A B` is the third statement form of the judgment: a term of `A` is
usable at `B`. It is generated by equal types, universes by cumulativity,
dependent function types with equal domains and codomains below, and
dependent pair types with both components below; the dependent function and
pair rules carry the well-formedness of both sides. The typing rule `sub` and
the equality rule `subEq` use it.

Inversion by the shape of either side is proved from the facts about the
weak-head forms of types (`Below.pi_inv`, `Below.sigma_inv`, `Below.pi_source`,
`Below.sigma_source`, `Below.universe_source`, `Below.universe_target`,
`Below.rigid`). This module
adds the renaming and substitution forms, and that usable at is not equal to: `Π A 𝒰₀` is usable at
`Π A 𝒰₁` while the two are not equal types.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
namespace TypedEquality
namespace Normalization

open UniverseLevel (LevelOrder)

variable {Head L : Type} [LevelOrder L]

section Structural

variable {R : Rules Head}

theorem TypeEq.substitute {n m : Nat} {Γ : Ctx Head n} {Δ : Ctx Head m} {σ : Sub Head n m}
    {A B : Tm Head n} (equal : TypeEq R Γ A B) (typed : SubstMor R Γ Δ σ) :
    TypeEq R Δ (subst σ A) (subst σ B) := by
  obtain ⟨u, hu, e⟩ := equal
  exact ⟨u, hu, e.substitute typed⟩

theorem IsType.substitute {n m : Nat} {Γ : Ctx Head n} {Δ : Ctx Head m} {σ : Sub Head n m}
    {A : Tm Head n} (type : IsType R Γ A) (typed : SubstMor R Γ Δ σ) :
    IsType R Δ (subst σ A) := by
  obtain ⟨u, hu, t⟩ := type
  exact ⟨u, hu, t.substitute typed⟩

theorem Below.rename {n m : Nat} {Γ : Ctx Head n} {Δ : Ctx Head m} {A B : Tm Head n}
    (le : Below R Γ A B) {ρ : Ren n m} (compatible : CtxRen Γ Δ ρ) :
    Below R Δ (Presentation.rename ρ A) (Presentation.rename ρ B) :=
  Derivable.renames le compatible

theorem Below.substitute {n m : Nat} {Γ : Ctx Head n} {Δ : Ctx Head m} {σ : Sub Head n m}
    {A B : Tm Head n} (le : Below R Γ A B) (typed : SubstMor R Γ Δ σ) :
    Below R Δ (subst σ A) (subst σ B) :=
  Derivable.substitutes le typed

end Structural

section Model

variable {S : Setting Head L} (facts : FormFacts S.R S.roles)
include facts

/-- The two dependent function types over a family in a universe and in a
universe above it: the first is usable at the second, and when the levels
differ they are not equal types. Usable at is not equal to. -/
theorem Below.pi_codomain_raise {n : Nat} {Γ : Ctx Head n} {A : Tm Head n} {u v : Head}
    (formed : CtxFormed S.R Γ) (typeA : IsType S.R Γ A) (hu : S.R.isUniverse u)
    (c : S.R.cumulative u v) (lt : S.levels.level u < S.levels.level v) :
    Below S.R Γ (.pi A (.head u)) (.pi A (.head v)) ∧
      ¬ TypeEq S.R Γ (.pi A (.head u)) (.pi A (.head v)) := by
  refine ⟨?_, fun equal => ?_⟩
  · obtain ⟨w, hw, tA⟩ := id typeA
    obtain ⟨_, hv, _⟩ := S.levels.cumulative_universe c
    obtain ⟨u', hu', typing, _⟩ := S.levels.successor hu
    obtain ⟨v', hv', typing', _⟩ := S.levels.successor hv
    obtain ⟨j, join⟩ := S.levels.join_exists hw hu'
    obtain ⟨j', join'⟩ := S.levels.join_exists hw hv'
    exact .subPi (.piForm tA hw (.headType typing) hu' join) (S.levels.join_level join).1
      (.piForm tA hw (.headType typing') hv' join') (S.levels.join_level join').1
      (.refl tA) hw (.subUniv c)
  · obtain ⟨_, eB⟩ := TypeEq.pi_injective facts equal formed
    have same := HeadSame.level_eq
      (TypeEq.head_injective facts eB (.snoc formed typeA))
    exact absurd same (ne_of_lt lt)

end Model

end Normalization
end TypedEquality
end Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
