import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.TypedEquality.Impredicative.Domain.Typing

/-!
# Ideals and finitary projections

The elements of the domain are the ideals of its compact elements (Carneiro,
Coquand, Frabetti Mathieu, Lennon-Bertrand, Melliès and Weirich, *Definitional
Inversion, Without Normalisation*, §2.1). With compact elements presented by
tokens, an ideal is a set of tokens closed under entailment by its finite
subsets (`Ideal`); the principal ideal of a compact element is the set of the
tokens it entails, and every set of tokens generates an ideal (`Ideal.closure`).

A type is interpreted by a finitary projection (§2.3–2.4 of the paper). For a
compact type `a`, the projection `Ideal.proj a` sends an ideal to the ideal
generated by its tokens typed at `a`; for a type given as an ideal `T`, the
projection `Ideal.projT T` keeps the tokens typed at some compact type below
`T` that is itself an element of the universe. Both are deflationary,
idempotent and monotone, and their images are generated by typed compact
elements: they are finitary projections.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
namespace TypedEquality
namespace Impredicative
namespace Domain

/-- An ideal: a set of tokens closed under entailment by its finite subsets. -/
structure Ideal where
  /-- The tokens of the ideal. -/
  Mem : Tok → Prop
  closed : ∀ {v : List Tok} {t : Tok}, (∀ s ∈ v, Mem s) → ent v t = true → Mem t

namespace Ideal

@[ext] theorem ext {I J : Ideal} (h : ∀ t, I.Mem t ↔ J.Mem t) : I = J := by
  cases I; cases J
  congr
  funext t
  exact propext (h t)

/-- `I ≤ J`: every token of `I` is a token of `J`. -/
instance : LE Ideal := ⟨fun I J => ∀ t, I.Mem t → J.Mem t⟩

theorem le_def {I J : Ideal} : I ≤ J ↔ ∀ t, I.Mem t → J.Mem t := Iff.rfl

theorem le_refl (I : Ideal) : I ≤ I := fun _ h => h

theorem le_trans {I J K : Ideal} (h₁ : I ≤ J) (h₂ : J ≤ K) : I ≤ K := fun t h => h₂ t (h₁ t h)

theorem le_antisymm {I J : Ideal} (h₁ : I ≤ J) (h₂ : J ≤ I) : I = J :=
  ext fun t => ⟨h₁ t, h₂ t⟩

/-- The ideal generated by a set of tokens: the tokens its finite subsets
entail. -/
def closure (P : Tok → Prop) : Ideal where
  Mem t := ∃ v : List Tok, (∀ s ∈ v, P s) ∧ ent v t = true
  closed := by
    intro v t hv ht
    induction v with
    | nil => exact ⟨[], fun _ h => absurd h List.not_mem_nil, (ent_cut ht (Le.nil _))⟩
    | cons s v ih =>
      obtain ⟨w₁, hw₁, hs⟩ := hv s List.mem_cons_self
      obtain ⟨w₂, hw₂, hv'⟩ : ∃ w, (∀ r ∈ w, P r) ∧ v ⊑ w := by
        clear ih ht
        induction v with
        | nil => exact ⟨[], fun _ h => absurd h List.not_mem_nil, Le.nil _⟩
        | cons r v ih' =>
          obtain ⟨w₃, hw₃, hr⟩ := hv r (List.mem_cons_of_mem _ List.mem_cons_self)
          obtain ⟨w₄, hw₄, hv₄⟩ := ih' fun q hq => by
            rcases List.mem_cons.1 hq with rfl | hq
            · exact hv q List.mem_cons_self
            · exact hv q (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hq))
          refine ⟨w₃ ++ w₄, fun q hq => ?_, ?_⟩
          · rcases List.mem_append.1 hq with hq | hq
            · exact hw₃ q hq
            · exact hw₄ q hq
          · exact Le.cons_iff.2 ⟨ent_cut hr (Le.append_left _ _),
              hv₄.trans (Le.append_right _ _)⟩
      refine ⟨w₁ ++ w₂, fun q hq => ?_, ent_cut ht ?_⟩
      · rcases List.mem_append.1 hq with hq | hq
        · exact hw₁ q hq
        · exact hw₂ q hq
      · exact Le.cons_iff.2 ⟨ent_cut hs (Le.append_left _ _),
          hv'.trans (Le.append_right _ _)⟩

theorem subset_closure {P : Tok → Prop} {t : Tok} (h : P t) : (closure P).Mem t :=
  ⟨[t], fun s hs => by rw [List.mem_singleton.1 hs]; exact h, ent_of_mem List.mem_cons_self⟩

/-- The closure of a set of tokens is the least ideal containing it. -/
theorem closure_le {P : Tok → Prop} {I : Ideal} (h : ∀ t, P t → I.Mem t) : closure P ≤ I := by
  rintro t ⟨v, hv, ht⟩
  exact I.closed (fun s hs => h s (hv s hs)) ht

theorem closure_mono {P Q : Tok → Prop} (h : ∀ t, P t → Q t) : closure P ≤ closure Q := by
  rintro t ⟨v, hv, ht⟩
  exact ⟨v, fun s hs => h s (hv s hs), ht⟩

/-- The ideal of the tokens a compact element entails. -/
def principal (u : List Tok) : Ideal where
  Mem t := ent u t = true
  closed := fun hv ht => ent_cut ht hv

@[simp] theorem mem_principal {u : List Tok} {t : Tok} : (principal u).Mem t ↔ ent u t = true :=
  Iff.rfl

/-- A compact element is below an ideal when all its tokens are in it. -/
def Below (u : List Tok) (I : Ideal) : Prop := ∀ t ∈ u, I.Mem t

theorem principal_le_iff {u : List Tok} {I : Ideal} : principal u ≤ I ↔ Below u I := by
  constructor
  · intro h t ht
    exact h t (ent_of_mem ht)
  · intro h t ht
    exact I.closed h ht

theorem Below.mono {u : List Tok} {I J : Ideal} (hu : Below u I) (h : I ≤ J) : Below u J :=
  fun t ht => h t (hu t ht)

theorem Below.of_le {u v : List Tok} {I : Ideal} (huv : u ⊑ v) (hv : Below v I) : Below u I :=
  fun t ht => I.closed hv (huv t ht)

theorem Below.append {u v : List Tok} {I : Ideal} (hu : Below u I) (hv : Below v I) :
    Below (u ++ v) I := by
  intro t ht
  rcases List.mem_append.1 ht with ht | ht
  · exact hu t ht
  · exact hv t ht

/-- The least ideal: the tokens entailed by the empty element. -/
def bot : Ideal := principal []

theorem bot_le (I : Ideal) : bot ≤ I := fun _ ht => I.closed (fun _ h => absurd h List.not_mem_nil) ht

/-! ## Finitary projections -/

/-- The projection onto a compact type: the ideal generated by the tokens typed
at it. -/
def proj (a : List Tok) (I : Ideal) : Ideal := closure fun t => I.Mem t ∧ TyTok a t

/-- The projection is deflationary. -/
theorem proj_le (a : List Tok) (I : Ideal) : proj a I ≤ I :=
  closure_le fun _ h => h.1

/-- The projection is idempotent. -/
theorem proj_proj (a : List Tok) (I : Ideal) : proj a (proj a I) = proj a I :=
  le_antisymm (proj_le a _) (closure_mono fun _ h => ⟨subset_closure h, h.2⟩)

/-- The projection is monotone in the ideal. -/
theorem proj_mono {a : List Tok} {I J : Ideal} (h : I ≤ J) : proj a I ≤ proj a J :=
  closure_mono fun t ht => ⟨h t ht.1, ht.2⟩

/-- The projection is monotone in the type. -/
theorem proj_mono_type {a a' : List Tok} (h : a ⊑ a') (I : Ideal) : proj a I ≤ proj a' I :=
  closure_mono fun _ ht => ⟨ht.1, ht.2.mono h⟩

/-- The image of the projection is generated by typed compact elements: every
token of the projection is entailed by a finite list of typed tokens of the
ideal. -/
theorem mem_proj {a : List Tok} {I : Ideal} {t : Tok} :
    (proj a I).Mem t ↔ ∃ v, Below v I ∧ Ty v a ∧ ent v t = true := by
  constructor
  · rintro ⟨v, hv, ht⟩
    exact ⟨v, fun s hs => (hv s hs).1, fun s hs => (hv s hs).2, ht⟩
  · rintro ⟨v, hI, hT, ht⟩
    exact ⟨v, fun s hs => ⟨hI s hs, hT s hs⟩, ht⟩

/-- A token is typed at an ideal type when it is typed at a compact element of
the universe below it. -/
def TypedAt (T : Ideal) (t : Tok) : Prop := ∃ a, Below a T ∧ Ty a Elem.univ ∧ TyTok a t

theorem TypedAt.mono {T T' : Ideal} (h : T ≤ T') {t : Tok} (ht : TypedAt T t) : TypedAt T' t :=
  let ⟨a, ha, hu, ht⟩ := ht
  ⟨a, ha.mono h, hu, ht⟩

/-- The projection onto a type given as an ideal. -/
def projT (T I : Ideal) : Ideal := closure fun t => I.Mem t ∧ TypedAt T t

theorem projT_le (T I : Ideal) : projT T I ≤ I := closure_le fun _ h => h.1

theorem projT_projT (T I : Ideal) : projT T (projT T I) = projT T I :=
  le_antisymm (projT_le T _) (closure_mono fun _ h => ⟨subset_closure h, h.2⟩)

theorem projT_mono {T I J : Ideal} (h : I ≤ J) : projT T I ≤ projT T J :=
  closure_mono fun t ht => ⟨h t ht.1, ht.2⟩

theorem projT_mono_type {T T' : Ideal} (h : T ≤ T') (I : Ideal) : projT T I ≤ projT T' I :=
  closure_mono fun _ ht => ⟨ht.1, ht.2.mono h⟩

/-- The projection onto a type is the join of the projections onto the compact
types below it. -/
theorem projT_eq_iSup {T I : Ideal} {t : Tok} :
    (projT T I).Mem t ↔
      ∃ v, Below v I ∧ (∀ s ∈ v, TypedAt T s) ∧ ent v t = true := by
  constructor
  · rintro ⟨v, hv, ht⟩
    exact ⟨v, fun s hs => (hv s hs).1, fun s hs => (hv s hs).2, ht⟩
  · rintro ⟨v, hI, hT, ht⟩
    exact ⟨v, fun s hs => ⟨hI s hs, hT s hs⟩, ht⟩

end Ideal

end Domain
end Impredicative
end TypedEquality
end Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
