import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.TypedEquality.Impredicative.Domain.Projections

/-!
# The operations of the domain on ideals

The term formers act on ideals (Carneiro, Coquand, Frabetti Mathieu,
Lennon-Bertrand, Melliès and Weirich, *Definitional Inversion, Without
Normalisation*, Fig. 4, left column). Each operation is the ideal generated by
the tokens it produces:

* a dependent type of kind `k` (`Ideal.former`) has its tag, the domain tokens
  of its domain, and the family entries `fn k D X Y` whose dependency `D` is in
  the domain and whose output `Y` is in the family's value at `X`;
* a function (`Ideal.lam`) has the entries `fn lam [] X Y` whose output is in
  the body's value at `X`; its inputs are not restricted, since a function
  term carries no domain;
* application (`Ideal.app`) collects the outputs of the entries whose inputs
  are in the argument;
* a pair, its projections, an identity type and reflexivity act on
  components.

Membership in each operation is characterized exactly: a family entry of a
dependent type is in it iff its dependency is in the domain and its output in
the family's value (`Ideal.mem_former_fn`), a function entry iff its output is in
the body's value (`Ideal.mem_lam_fn`), and a token of an application iff it is
entailed by the output of one entry whose input is in the argument
(`Ideal.mem_app`).
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
namespace TypedEquality
namespace Impredicative
namespace Domain
namespace Ideal

/-! ## Generation -/

theorem mem_closure {P : Tok → Prop} {t : Tok} :
    (closure P).Mem t ↔ ∃ v : List Tok, (∀ s ∈ v, P s) ∧ ent v t = true := Iff.rfl

theorem below_closure {P : Tok → Prop} {v : List Tok} (h : ∀ s ∈ v, P s) :
    Below v (closure P) := fun _ hs => subset_closure (h _ hs)

/-- A finite list of tokens of an ideal generated by `P` is entailed by a
finite list of generators. -/
theorem below_closure_iff {P : Tok → Prop} {v : List Tok} :
    Below v (closure P) ↔ ∃ w, (∀ s ∈ w, P s) ∧ v ⊑ w := by
  constructor
  · intro h
    induction v with
    | nil => exact ⟨[], fun _ h => absurd h List.not_mem_nil, Le.nil _⟩
    | cons t v ih =>
      obtain ⟨w₁, hw₁, ht⟩ := h t List.mem_cons_self
      obtain ⟨w₂, hw₂, hv⟩ := ih fun s hs => h s (List.mem_cons_of_mem _ hs)
      refine ⟨w₁ ++ w₂, fun s hs => ?_, Le.cons_iff.2 ⟨ent_cut ht (Le.append_left _ _),
        hv.trans (Le.append_right _ _)⟩⟩
      rcases List.mem_append.1 hs with hs | hs
      · exact hw₁ s hs
      · exact hw₂ s hs
  · rintro ⟨w, hw, hvw⟩ t ht
    exact ⟨w, hw, hvw t ht⟩

/-- A list whose tokens are in an ideal is below the ideal's principal
generation: its entailments are in the ideal. -/
theorem Below.ent {v : List Tok} {I : Ideal} (h : Below v I) {t : Tok} (ht : ent v t = true) :
    I.Mem t :=
  I.closed h ht

theorem Below.args {v : List Tok} {I : Ideal} (h : Below v I) {k : Kind} {i : Nat}
    {C : List Tok} {t : Tok} (ht : Tok.arg k i C t ∈ v) : I.Mem (.arg k i C t) :=
  h _ ht

/-! ## Dependent types -/

/-- The dependent type of kind `k` with domain `A` and family `F`. -/
def former (k : Kind) (A : Ideal) (F : List Tok → Ideal) : Ideal :=
  closure fun t => t = .tag k ∨ (∃ d, t = .arg k 0 [] d ∧ A.Mem d) ∨
    ∃ D X Y, t = .fn k D X Y ∧ Below D A ∧ Below Y (F X)

/-- A family: monotone in its argument. -/
def Monotone (F : List Tok → Ideal) : Prop := ∀ {X X' : List Tok}, X ⊑ X' → F X ≤ F X'

/-- The domain component of a generated list is in the domain. -/
private theorem former_args_below {k : Kind} {A : Ideal} {F : List Tok → Ideal} {w : List Tok}
    (hw : ∀ s ∈ w, s = .tag k ∨ (∃ d, s = .arg k 0 [] d ∧ A.Mem d) ∨
      ∃ D X Y, s = .fn k D X Y ∧ Below D A ∧ Below Y (F X)) :
    Below (args k 0 w) A := by
  intro c hc
  rcases mem_args_iff.1 hc with ⟨C, hC⟩ | ⟨-, t, ht, -, hd⟩
  · rcases hw _ hC with h | ⟨d, h, hd⟩ | ⟨D, X, Y, h, -⟩
    · cases h
    · cases h
      exact hd
    · cases h
  · rcases hw _ ht with rfl | ⟨d, rfl, -⟩ | ⟨D, X, Y, rfl, hD, -⟩
    · cases hd
    · cases hd
    · exact hD c hd

theorem mem_former_tag (k : Kind) (A : Ideal) (F : List Tok → Ideal) :
    (former k A F).Mem (.tag k) :=
  subset_closure (.inl rfl)

theorem mem_former_dom {k : Kind} {A : Ideal} {F : List Tok → Ideal} {d : Tok} :
    (former k A F).Mem (.arg k 0 [] d) ↔ A.Mem d := by
  constructor
  · rintro ⟨w, hw, hd⟩
    rw [ent_arg, List.all_nil, Bool.true_and] at hd
    exact (former_args_below hw).ent hd
  · intro hd
    exact subset_closure (.inr (.inl ⟨d, rfl, hd⟩))

/-- **A family entry of a dependent type** is in it iff its dependency is in the
domain and its output in the family's value at its input. -/
theorem mem_former_fn {k : Kind} {A : Ideal} {F : List Tok → Ideal} (hF : Monotone F)
    {D X Y : List Tok} :
    (former k A F).Mem (.fn k D X Y) ↔ Below D A ∧ Below Y (F X) := by
  constructor
  · rintro ⟨w, hw, h⟩
    rw [ent_fn, Bool.and_eq_true, List.all_eq_true, List.all_eq_true] at h
    refine ⟨fun c hc => (former_args_below hw).ent (h.1 c hc), fun y hy => ?_⟩
    have hy := h.2 y hy
    refine Ideal.closed (F X) (v := fnApp k w X) ?_ hy
    intro s hs
    obtain ⟨C, X', Y', hp, hX, hs⟩ := mem_fnApp'.1 hs
    rcases hw _ hp with h | ⟨d, h, -⟩ | ⟨D', X'', Y'', h, -, hY⟩
    · cases h
    · cases h
    · cases h
      exact hF hX s (hY s hs)
  · rintro ⟨hD, hY⟩
    exact subset_closure (.inr (.inr ⟨D, X, Y, rfl, hD, hY⟩))

theorem former_mono {k : Kind} {A A' : Ideal} {F F' : List Tok → Ideal} (hA : A ≤ A')
    (hF : ∀ X, F X ≤ F' X) : former k A F ≤ former k A' F' := by
  refine closure_mono fun t ht => ?_
  rcases ht with rfl | ⟨d, rfl, hd⟩ | ⟨D, X, Y, rfl, hD, hY⟩
  · exact .inl rfl
  · exact .inr (.inl ⟨d, rfl, hA d hd⟩)
  · exact .inr (.inr ⟨D, X, Y, rfl, hD.mono hA, hY.mono (hF X)⟩)

/-! ## Functions and application -/

/-- The function whose value at `X` is `F X`. -/
def lam (F : List Tok → Ideal) : Ideal :=
  closure fun t => ∃ X Y, t = .fn .lam [] X Y ∧ Below Y (F X)

/-- **A function entry** is in a function iff its output is in the body's value
at its input. -/
theorem mem_lam_fn {F : List Tok → Ideal} (hF : Monotone F) {X Y : List Tok} :
    (lam F).Mem (.fn .lam [] X Y) ↔ Below Y (F X) := by
  constructor
  · rintro ⟨w, hw, h⟩
    rw [ent_fn, Bool.and_eq_true, List.all_eq_true, List.all_eq_true] at h
    intro y hy
    refine Ideal.closed (F X) (v := fnApp .lam w X) ?_ (h.2 y hy)
    intro s hs
    obtain ⟨C, X', Y', hp, hX, hs⟩ := mem_fnApp'.1 hs
    obtain ⟨X'', Y'', h', hY⟩ := hw _ hp
    cases h'
    exact hF hX s (hY s hs)
  · intro hY
    exact subset_closure ⟨X, Y, rfl, hY⟩

theorem lam_mono {F F' : List Tok → Ideal} (h : ∀ X, F X ≤ F' X) : lam F ≤ lam F' :=
  closure_mono fun _ ⟨X, Y, e, hY⟩ => ⟨X, Y, e, hY.mono (h X)⟩

/-- Application: the outputs of the entries whose inputs are in the argument. -/
def app (I J : Ideal) : Ideal :=
  closure fun t => ∃ C X Y, I.Mem (.fn .lam C X Y) ∧ Below X J ∧ t ∈ Y

theorem app_mono {I I' J J' : Ideal} (hI : I ≤ I') (hJ : J ≤ J') : app I J ≤ app I' J' :=
  closure_mono fun _ ⟨C, X, Y, h, hX, ht⟩ => ⟨C, X, Y, hI _ h, hX.mono hJ, ht⟩

/-- Joining the entries of a function: finitely many entries whose inputs are in
an ideal combine into one entry whose input is in the ideal. -/
theorem lam_entries_join {I J : Ideal} {v : List Tok}
    (hv : ∀ s ∈ v, ∃ C X Y, I.Mem (.fn .lam C X Y) ∧ Below X J ∧ s ∈ Y) :
    ∃ X Y, Below X J ∧ I.Mem (.fn .lam [] X Y) ∧ v ⊑ Y := by
  induction v with
  | nil =>
    refine ⟨[], [], fun _ h => absurd h List.not_mem_nil, ?_, Le.nil _⟩
    exact I.closed (v := []) (fun _ h => absurd h List.not_mem_nil) (by rw [ent_fn]; rfl)
  | cons s v ih =>
    obtain ⟨C, X₁, Y₁, h₁, hX₁, hs⟩ := hv s List.mem_cons_self
    obtain ⟨X₂, Y₂, hX₂, h₂, hv₂⟩ := ih fun r hr => hv r (List.mem_cons_of_mem _ hr)
    refine ⟨X₁ ++ X₂, Y₁ ++ Y₂, hX₁.append hX₂, ?_, ?_⟩
    · refine I.closed (v := [.fn .lam C X₁ Y₁, .fn .lam [] X₂ Y₂]) ?_ ?_
      · intro r hr
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
        rcases hr with rfl | rfl
        · exact h₁
        · exact h₂
      · rw [ent_fn, Bool.and_eq_true, List.all_eq_true, List.all_eq_true]
        refine ⟨fun c hc => absurd hc List.not_mem_nil, fun y hy => ?_⟩
        apply ent_of_mem
        rw [mem_fnApp']
        rcases List.mem_append.1 hy with hy | hy
        · exact ⟨C, X₁, Y₁, List.mem_cons_self, Le.append_left _ _, hy⟩
        · exact ⟨[], X₂, Y₂, List.mem_cons_of_mem _ List.mem_cons_self,
            Le.append_right _ _, hy⟩
    · exact Le.cons_iff.2 ⟨ent_of_mem (List.mem_append_left _ hs),
        hv₂.trans (Le.append_right _ _)⟩

/-- **A token of an application** is entailed by the output of one entry of the
function whose input is in the argument. -/
theorem mem_app {I J : Ideal} {t : Tok} :
    (app I J).Mem t ↔ ∃ X Y, Below X J ∧ I.Mem (.fn .lam [] X Y) ∧ ent Y t = true := by
  constructor
  · rintro ⟨v, hv, ht⟩
    obtain ⟨X, Y, hX, hI, hvY⟩ := lam_entries_join hv
    exact ⟨X, Y, hX, hI, ent_cut ht hvY⟩
  · rintro ⟨X, Y, hX, hI, ht⟩
    exact (app I J).closed (v := Y) (fun s hs => subset_closure ⟨[], X, Y, hI, hX, hs⟩) ht

/-! ## Pairs -/

/-- The pair of two ideals. -/
def pair (I J : Ideal) : Ideal :=
  closure fun t => (∃ s, t = .arg .pair 0 [] s ∧ I.Mem s) ∨
    ∃ C s, t = .arg .pair 1 C s ∧ Below C I ∧ J.Mem s

/-- The first projection. -/
def fst (I : Ideal) : Ideal := closure fun s => I.Mem (.arg .pair 0 [] s)

/-- The second projection. -/
def snd (I : Ideal) : Ideal := closure fun s => ∃ C, I.Mem (.arg .pair 1 C s)

theorem fst_mono {I I' : Ideal} (h : I ≤ I') : fst I ≤ fst I' :=
  closure_mono fun _ hs => h _ hs

theorem snd_mono {I I' : Ideal} (h : I ≤ I') : snd I ≤ snd I' :=
  closure_mono fun _ ⟨C, hs⟩ => ⟨C, h _ hs⟩

theorem pair_mono {I I' J J' : Ideal} (hI : I ≤ I') (hJ : J ≤ J') : pair I J ≤ pair I' J' := by
  refine closure_mono fun t ht => ?_
  rcases ht with ⟨s, rfl, hs⟩ | ⟨C, s, rfl, hC, hs⟩
  · exact .inl ⟨s, rfl, hI s hs⟩
  · exact .inr ⟨C, s, rfl, hC.mono hI, hJ s hs⟩

/-- The pair's generators have their components in the components. -/
private theorem pair_gen_args {I J : Ideal} {w : List Tok}
    (hw : ∀ s ∈ w, (∃ r, s = .arg .pair 0 [] r ∧ I.Mem r) ∨
      ∃ C r, s = .arg .pair 1 C r ∧ Below C I ∧ J.Mem r) :
    Below (args .pair 0 w) I ∧ Below (args .pair 1 w) J := by
  constructor
  · intro c hc
    rcases mem_args_iff.1 hc with ⟨C, hC⟩ | ⟨-, t, ht, -, hd⟩
    · rcases hw _ hC with ⟨r, h, hr⟩ | ⟨C', r, h, -, -⟩
      · cases h; exact hr
      · cases h
    · rcases hw _ ht with ⟨r, rfl, -⟩ | ⟨C', r, rfl, hC', -⟩
      · cases hd
      · exact hC' c hd
  · intro c hc
    rcases mem_args_iff.1 hc with ⟨C, hC⟩ | ⟨h1, -⟩
    · rcases hw _ hC with ⟨r, h, -⟩ | ⟨C', r, h, -, hr⟩
      · cases h
      · cases h; exact hr
    · cases h1

/-- The first projection of a pair is its first component. -/
theorem fst_pair (I J : Ideal) : fst (pair I J) = I := by
  refine le_antisymm (closure_le fun _ hs => ?_) fun s hs => subset_closure ?_
  · obtain ⟨w, hw, h⟩ := hs
    rw [ent_arg, List.all_nil, Bool.true_and] at h
    exact (pair_gen_args hw).1.ent h
  · exact subset_closure (.inl ⟨s, rfl, hs⟩)

/-- The second projection of a pair is its second component. -/
theorem snd_pair (I J : Ideal) : snd (pair I J) = J := by
  refine le_antisymm (closure_le fun s hs => ?_) fun s hs => subset_closure ⟨[], ?_⟩
  · obtain ⟨C, w, hw, h⟩ := hs
    rw [ent_arg, Bool.and_eq_true] at h
    exact (pair_gen_args hw).2.ent h.2
  · exact subset_closure (.inr ⟨[], s, rfl, fun _ h => absurd h List.not_mem_nil, hs⟩)

/-! ## Identity types and reflexivity -/

/-- The identity type of carrier `A` between `I` and `J`. -/
def ident (A I J : Ideal) : Ideal :=
  closure fun t => t = .tag .ident ∨ (∃ d, t = .arg .ident 0 [] d ∧ A.Mem d) ∨
    (∃ C s, t = .arg .ident 1 C s ∧ Below C A ∧ I.Mem s) ∨
    ∃ C s, t = .arg .ident 2 C s ∧ Below C A ∧ J.Mem s

/-- Reflexivity at a point. -/
def refl (I : Ideal) : Ideal :=
  closure fun t => t = .tag .refl ∨ ∃ s, t = .arg .refl 0 [] s ∧ I.Mem s

theorem ident_mono {A A' I I' J J' : Ideal} (hA : A ≤ A') (hI : I ≤ I') (hJ : J ≤ J') :
    ident A I J ≤ ident A' I' J' := by
  refine closure_mono fun t ht => ?_
  rcases ht with rfl | ⟨d, rfl, hd⟩ | ⟨C, s, rfl, hC, hs⟩ | ⟨C, s, rfl, hC, hs⟩
  · exact .inl rfl
  · exact .inr (.inl ⟨d, rfl, hA d hd⟩)
  · exact .inr (.inr (.inl ⟨C, s, rfl, hC.mono hA, hI s hs⟩))
  · exact .inr (.inr (.inr ⟨C, s, rfl, hC.mono hA, hJ s hs⟩))

theorem refl_mono {I I' : Ideal} (h : I ≤ I') : refl I ≤ refl I' := by
  refine closure_mono fun t ht => ?_
  rcases ht with rfl | ⟨s, rfl, hs⟩
  · exact .inl rfl
  · exact .inr ⟨s, rfl, h s hs⟩

end Ideal
end Domain
end Impredicative
end TypedEquality
