import Mettapedia.TypeTheory.Calculi.NativeDependent.ExternalBinderSubstitution
import Mettapedia.TypeTheory.JudgmentDerivation

/-!
# Generated external dependent judgments

Every judgment is authored syntax. Formation, typing, contextual substitution
and equations are generated by local rules whose ordered premises are explicit.
The primitive rules require formation of the declaration header and a typed
argument substitution. They do not assume a global semantic interpretation.

Dependent function and pair rules admit arbitrary generated domains. Full pair
elimination has a motive over the complete pair context and a branch over both
component binders. The equation rules include dependent beta and eta, context
conversion, and typed substitution congruence.

The shared generated-tree construction supplies a rule-algebra interpreter.
A coherent interpretation into arbitrary dependent models and classifying CwF
initiality require additional semantic and quotient constructions.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.Calculi.NativeDependent.External

universe u

inductive Judgment (S : Symbols.{u}) : Type u where
  | context {n : Nat} (context : ContextExpr S n) : Judgment S
  | type {n : Nat} (context : ContextExpr S n) (type : TypeExpr S n) : Judgment S
  | term {n : Nat} (context : ContextExpr S n) (term : TermExpr S n) (type : TypeExpr S n) : Judgment S
  | substitution {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (substitution : Substitution S m n) : Judgment S
  | contextEq {n : Nat} (first second : ContextExpr S n) : Judgment S
  | typeEq {n : Nat} (context : ContextExpr S n) (first second : TypeExpr S n) : Judgment S
  | termEq {n : Nat} (context : ContextExpr S n) (first second : TermExpr S n)
      (type : TypeExpr S n) : Judgment S
  | substitutionEq {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (first second : Substitution S m n) : Judgment S

variable {S : Symbols.{u}}

/-- A local rule specifies data for its conclusion. Its premises are computed
from that data below, independently of generated derivations or a model. -/
inductive RuleCode (D : Signature S) : Type u where
  | contextNil
  | contextExtend {n : Nat} (context : ContextExpr S n) (type : TypeExpr S n)
  | variable {n : Nat} (context : ContextExpr S n) (index : Fin n)
  | typeFamily {n : Nat} (context : ContextExpr S n) (symbol : S.TypeSymbol)
      (arguments : Substitution S (S.typeArity symbol) n)
  | primitive {n : Nat} (context : ContextExpr S n) (symbol : S.TermSymbol)
      (arguments : Substitution S (S.termArity symbol) n)
  | piFormation {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n) (body : TypeExpr S (n + 1))
  | sigmaFormation {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n) (body : TypeExpr S (n + 1))
  | lambda {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n) (body : TypeExpr S (n + 1))
      (term : TermExpr S (n + 1))
  | application {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n) (body : TypeExpr S (n + 1))
      (function argument : TermExpr S n)
  | pairIntroduction {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n) (body : TypeExpr S (n + 1))
      (first second : TermExpr S n)
  | firstProjection {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n) (body : TypeExpr S (n + 1))
      (pair : TermExpr S n)
  | secondProjection {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n) (body : TypeExpr S (n + 1))
      (pair : TermExpr S n)
  | sigmaElimination {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body motive : TypeExpr S (n + 1)) (branch : TermExpr S (n + 2)) (pair : TermExpr S n)
  | termConversion {n : Nat} (context : ContextExpr S n) (term : TermExpr S n) (first second : TypeExpr S n)
  | substitutionNil {n : Nat} (context : ContextExpr S n)
  | substitutionExtend {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (type : TypeExpr S m) (substitution : Substitution S m n) (term : TermExpr S n)
  | substitutionIdentity {n : Nat} (context : ContextExpr S n)
  | substitutionCompose {n m k : Nat} (source : ContextExpr S n) (middle : ContextExpr S m)
      (target : ContextExpr S k) (first : Substitution S m n) (second : Substitution S k m)
  | substitutionWeaken {n : Nat} (context : ContextExpr S n) (type : TypeExpr S n)
  | substituteType {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (substitution : Substitution S m n) (type : TypeExpr S m)
  | substituteTerm {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (substitution : Substitution S m n) (term : TermExpr S m) (type : TypeExpr S m)
  | contextReflexivity {n : Nat} (context : ContextExpr S n)
  | contextSymmetry {n : Nat} (first second : ContextExpr S n)
  | contextTransitivity {n : Nat} (first middle last : ContextExpr S n)
  | contextExtendEquality {n : Nat} (first second : ContextExpr S n) (firstType secondType : TypeExpr S n)
  | transportType {n : Nat} (first second : ContextExpr S n) (type : TypeExpr S n)
  | transportTerm {n : Nat} (first second : ContextExpr S n) (term : TermExpr S n) (type : TypeExpr S n)
  | transportSubstitution {n m : Nat} (source source' : ContextExpr S n) (target target' : ContextExpr S m)
      (substitution : Substitution S m n)
  | typeReflexivity {n : Nat} (context : ContextExpr S n) (type : TypeExpr S n)
  | typeSymmetry {n : Nat} (context : ContextExpr S n) (first second : TypeExpr S n)
  | typeTransitivity {n : Nat} (context : ContextExpr S n) (first middle last : TypeExpr S n)
  | termReflexivity {n : Nat} (context : ContextExpr S n) (term : TermExpr S n) (type : TypeExpr S n)
  | termSymmetry {n : Nat} (context : ContextExpr S n) (first second : TermExpr S n) (type : TypeExpr S n)
  | termTransitivity {n : Nat} (context : ContextExpr S n) (first middle last : TermExpr S n) (type : TypeExpr S n)
  | equalityConversion {n : Nat} (context : ContextExpr S n) (first second : TermExpr S n)
      (firstType secondType : TypeExpr S n)
  | transportTypeEquality {n : Nat} (source target : ContextExpr S n) (first second : TypeExpr S n)
  | transportTermEquality {n : Nat} (source target : ContextExpr S n)
      (first second : TermExpr S n) (type : TypeExpr S n)
  | piCongruence {n : Nat} (context : ContextExpr S n) (firstDomain secondDomain : TypeExpr S n)
      (firstBody secondBody : TypeExpr S (n + 1))
  | sigmaCongruence {n : Nat} (context : ContextExpr S n) (firstDomain secondDomain : TypeExpr S n)
      (firstBody secondBody : TypeExpr S (n + 1))
  | familyCongruence {n : Nat} (context : ContextExpr S n) (symbol : S.TypeSymbol)
      (first second : Substitution S (S.typeArity symbol) n)
  | primitiveCongruence {n : Nat} (context : ContextExpr S n) (symbol : S.TermSymbol)
      (first second : Substitution S (S.termArity symbol) n)
  | lambdaCongruence {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body : TypeExpr S (n + 1)) (first second : TermExpr S (n + 1))
  | applicationCongruence {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body : TypeExpr S (n + 1)) (firstFunction secondFunction firstArgument secondArgument : TermExpr S n)
  | pairCongruence {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body : TypeExpr S (n + 1)) (firstLeft secondLeft firstRight secondRight : TermExpr S n)
  | firstCongruence {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body : TypeExpr S (n + 1)) (first second : TermExpr S n)
  | secondCongruence {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body : TypeExpr S (n + 1)) (first second : TermExpr S n)
  | sigmaEliminationCongruence {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body motive : TypeExpr S (n + 1)) (firstBranch secondBranch : TermExpr S (n + 2))
      (firstPair secondPair : TermExpr S n)
  | lambdaAnnotationCongruence {n : Nat} (context : ContextExpr S n)
      (firstDomain secondDomain : TypeExpr S n) (firstBody secondBody : TypeExpr S (n + 1))
      (first second : TermExpr S (n + 1))
  | applicationAnnotationCongruence {n : Nat} (context : ContextExpr S n)
      (firstDomain secondDomain : TypeExpr S n) (firstBody secondBody : TypeExpr S (n + 1))
      (firstFunction secondFunction firstArgument secondArgument : TermExpr S n)
  | pairAnnotationCongruence {n : Nat} (context : ContextExpr S n)
      (firstDomain secondDomain : TypeExpr S n) (firstBody secondBody : TypeExpr S (n + 1))
      (firstLeft secondLeft firstRight secondRight : TermExpr S n)
  | firstAnnotationCongruence {n : Nat} (context : ContextExpr S n)
      (firstDomain secondDomain : TypeExpr S n) (firstBody secondBody : TypeExpr S (n + 1))
      (first second : TermExpr S n)
  | secondAnnotationCongruence {n : Nat} (context : ContextExpr S n)
      (firstDomain secondDomain : TypeExpr S n) (firstBody secondBody : TypeExpr S (n + 1))
      (first second : TermExpr S n)
  | sigmaEliminationAnnotationCongruence {n : Nat} (context : ContextExpr S n)
      (firstDomain secondDomain : TypeExpr S n) (firstBody secondBody : TypeExpr S (n + 1))
      (firstMotive secondMotive : TypeExpr S (n + 1))
      (firstBranch secondBranch : TermExpr S (n + 2)) (firstPair secondPair : TermExpr S n)
  | piBeta {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body : TypeExpr S (n + 1)) (term : TermExpr S (n + 1)) (argument : TermExpr S n)
  | piEta {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body : TypeExpr S (n + 1)) (function : TermExpr S n)
  | sigmaFirstBeta {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body : TypeExpr S (n + 1)) (first second : TermExpr S n)
  | sigmaSecondBeta {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body : TypeExpr S (n + 1)) (first second : TermExpr S n)
  | sigmaEta {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body : TypeExpr S (n + 1)) (pair : TermExpr S n)
  | sigmaEliminationBeta {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body motive : TypeExpr S (n + 1)) (branch : TermExpr S (n + 2)) (first second : TermExpr S n)
  | sigmaEliminationEta {n : Nat} (context : ContextExpr S n) (domain : TypeExpr S n)
      (body motive : TypeExpr S (n + 1)) (term : TermExpr S (n + 1)) (pair : TermExpr S n)
  | substituteTypeEquality {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (substitution : Substitution S m n) (first second : TypeExpr S m)
  | substituteTermEquality {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (substitution : Substitution S m n) (first second : TermExpr S m) (type : TypeExpr S m)
  | substitutionReflexivity {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (substitution : Substitution S m n)
  | substitutionSymmetry {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (first second : Substitution S m n)
  | substitutionTransitivity {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (first middle last : Substitution S m n)
  | substitutionExtendEquality {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (type : TypeExpr S m) (first second : Substitution S m n) (firstTerm secondTerm : TermExpr S n)
  | typeSubstitutionCongruence {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (first second : Substitution S m n) (type : TypeExpr S m)
  | termSubstitutionCongruence {n m : Nat} (source : ContextExpr S n) (target : ContextExpr S m)
      (first second : Substitution S m n) (term : TermExpr S m) (type : TypeExpr S m)

namespace RuleCode

variable {D : Signature S}

@[reducible] def conclusion : RuleCode D → Judgment S
  | .contextNil => .context .nil
  | .contextExtend context type => .context (.snoc context type)
  | .variable context index => .term context (.var index) (context.lookup index)
  | .typeFamily context symbol arguments => .type context (.family symbol arguments)
  | .primitive context symbol arguments =>
      .term context (.primitive symbol arguments) ((D.termResult symbol).substitute arguments)
  | .piFormation context domain body => .type context (.pi domain body)
  | .sigmaFormation context domain body => .type context (.sigma domain body)
  | .lambda context domain body term => .term context (.lam domain body term) (.pi domain body)
  | .application context domain body function argument =>
      .term context (.app domain body function argument) (body.substitute (instantiate argument))
  | .pairIntroduction context domain body first second => .term context (.pair domain body first second) (.sigma domain body)
  | .firstProjection context domain body pair => .term context (.fst domain body pair) domain
  | .secondProjection context domain body pair =>
      .term context (.snd domain body pair) (body.substitute (instantiate (.fst domain body pair)))
  | .sigmaElimination context domain body motive branch pair =>
      .term context (.sigmaElim domain body motive branch pair) (motive.substitute (instantiate pair))
  | .termConversion context term _ second => .term context term second
  | .substitutionNil context => .substitution context .nil Fin.elim0
  | .substitutionExtend source target type substitution term =>
      .substitution source (.snoc target type) (extendSubstitution substitution term)
  | .substitutionIdentity context => .substitution context context TermExpr.var
  | .substitutionCompose source _ target first second =>
      .substitution source target (composeSubstitution second first)
  | .substitutionWeaken context type => .substitution (.snoc context type) context (fun index => .var index.succ)
  | .substituteType source _ substitution type => .type source (type.substitute substitution)
  | .substituteTerm source _ substitution term type =>
      .term source (term.substitute substitution) (type.substitute substitution)
  | .contextReflexivity context => .contextEq context context
  | .contextSymmetry first second => .contextEq second first
  | .contextTransitivity first _ last => .contextEq first last
  | .contextExtendEquality first second firstType secondType =>
      .contextEq (.snoc first firstType) (.snoc second secondType)
  | .transportType _ second type => .type second type
  | .transportTerm _ second term type => .term second term type
  | .transportSubstitution _ source' _ target' substitution => .substitution source' target' substitution
  | .typeReflexivity context type => .typeEq context type type
  | .typeSymmetry context first second => .typeEq context second first
  | .typeTransitivity context first _ last => .typeEq context first last
  | .termReflexivity context term type => .termEq context term term type
  | .termSymmetry context first second type => .termEq context second first type
  | .termTransitivity context first _ last type => .termEq context first last type
  | .equalityConversion context first second _ secondType => .termEq context first second secondType
  | .transportTypeEquality _ target first second => .typeEq target first second
  | .transportTermEquality _ target first second type => .termEq target first second type
  | .piCongruence context firstDomain secondDomain firstBody secondBody =>
      .typeEq context (.pi firstDomain firstBody) (.pi secondDomain secondBody)
  | .sigmaCongruence context firstDomain secondDomain firstBody secondBody =>
      .typeEq context (.sigma firstDomain firstBody) (.sigma secondDomain secondBody)
  | .familyCongruence context symbol first second =>
      .typeEq context (.family symbol first) (.family symbol second)
  | .primitiveCongruence context symbol first second =>
      .termEq context (.primitive symbol first) (.primitive symbol second) ((D.termResult symbol).substitute first)
  | .lambdaCongruence context domain body first second =>
      .termEq context (.lam domain body first) (.lam domain body second) (.pi domain body)
  | .applicationCongruence context domain body firstFunction secondFunction firstArgument secondArgument =>
      .termEq context (.app domain body firstFunction firstArgument) (.app domain body secondFunction secondArgument)
        (body.substitute (instantiate firstArgument))
  | .pairCongruence context domain body firstLeft secondLeft firstRight secondRight =>
      .termEq context (.pair domain body firstLeft firstRight) (.pair domain body secondLeft secondRight) (.sigma domain body)
  | .firstCongruence context domain body first second =>
      .termEq context (.fst domain body first) (.fst domain body second) domain
  | .secondCongruence context domain body first second =>
      .termEq context (.snd domain body first) (.snd domain body second)
        (body.substitute (instantiate (.fst domain body first)))
  | .sigmaEliminationCongruence context domain body motive firstBranch secondBranch firstPair secondPair =>
      .termEq context (.sigmaElim domain body motive firstBranch firstPair)
        (.sigmaElim domain body motive secondBranch secondPair) (motive.substitute (instantiate firstPair))
  | .lambdaAnnotationCongruence context firstDomain secondDomain firstBody secondBody first second =>
      .termEq context (.lam firstDomain firstBody first) (.lam secondDomain secondBody second)
        (.pi firstDomain firstBody)
  | .applicationAnnotationCongruence context firstDomain secondDomain firstBody secondBody
      firstFunction secondFunction firstArgument secondArgument =>
      .termEq context (.app firstDomain firstBody firstFunction firstArgument)
        (.app secondDomain secondBody secondFunction secondArgument)
        (firstBody.substitute (instantiate firstArgument))
  | .pairAnnotationCongruence context firstDomain secondDomain firstBody secondBody
      firstLeft secondLeft firstRight secondRight =>
      .termEq context (.pair firstDomain firstBody firstLeft firstRight)
        (.pair secondDomain secondBody secondLeft secondRight) (.sigma firstDomain firstBody)
  | .firstAnnotationCongruence context firstDomain secondDomain firstBody secondBody first second =>
      .termEq context (.fst firstDomain firstBody first) (.fst secondDomain secondBody second) firstDomain
  | .secondAnnotationCongruence context firstDomain secondDomain firstBody secondBody first second =>
      .termEq context (.snd firstDomain firstBody first) (.snd secondDomain secondBody second)
        (firstBody.substitute (instantiate (.fst firstDomain firstBody first)))
  | .sigmaEliminationAnnotationCongruence context firstDomain secondDomain firstBody secondBody
      firstMotive secondMotive firstBranch secondBranch firstPair secondPair =>
      .termEq context (.sigmaElim firstDomain firstBody firstMotive firstBranch firstPair)
        (.sigmaElim secondDomain secondBody secondMotive secondBranch secondPair)
        (firstMotive.substitute (instantiate firstPair))
  | .piBeta context domain body term argument =>
      .termEq context (.app domain body (.lam domain body term) argument)
        (term.substitute (instantiate argument)) (body.substitute (instantiate argument))
  | .piEta context domain body function =>
      .termEq context (.lam domain body (.app (domain.rename Fin.succ)
        (body.rename (liftRenaming Fin.succ)) (function.rename Fin.succ) (.var 0))) function (.pi domain body)
  | .sigmaFirstBeta context domain body first second =>
      .termEq context (.fst domain body (.pair domain body first second)) first domain
  | .sigmaSecondBeta context domain body first second =>
      .termEq context (.snd domain body (.pair domain body first second)) second (body.substitute (instantiate first))
  | .sigmaEta context domain body pair =>
      .termEq context (.pair domain body (.fst domain body pair) (.snd domain body pair)) pair (.sigma domain body)
  | .sigmaEliminationBeta context domain body motive branch first second =>
      .termEq context (.sigmaElim domain body motive branch (.pair domain body first second))
        (branch.substitute (instantiateComponents first second))
        (motive.substitute (instantiate (.pair domain body first second)))
  | .sigmaEliminationEta context domain body motive term pair =>
      .termEq context (.sigmaElim domain body motive (term.substitute (packSubstitution domain body)) pair)
        (term.substitute (instantiate pair)) (motive.substitute (instantiate pair))
  | .substituteTypeEquality source _ substitution first second =>
      .typeEq source (first.substitute substitution) (second.substitute substitution)
  | .substituteTermEquality source _ substitution first second type =>
      .termEq source (first.substitute substitution) (second.substitute substitution) (type.substitute substitution)
  | .substitutionReflexivity source target substitution => .substitutionEq source target substitution substitution
  | .substitutionSymmetry source target first second => .substitutionEq source target second first
  | .substitutionTransitivity source target first _ last => .substitutionEq source target first last
  | .substitutionExtendEquality source target type first second firstTerm secondTerm =>
      .substitutionEq source (.snoc target type)
        (extendSubstitution first firstTerm) (extendSubstitution second secondTerm)
  | .typeSubstitutionCongruence source _ first second type =>
      .typeEq source (type.substitute first) (type.substitute second)
  | .termSubstitutionCongruence source _ first second term type =>
      .termEq source (term.substitute first) (term.substitute second) (type.substitute first)

/-- Every displayed premise position belongs to this rule occurrence. -/
@[reducible] def premises : RuleCode D → List (Judgment S)
  | .contextNil => []
  | .contextExtend context type => [.context context, .type context type]
  | .variable context _ => [.context context]
  | .typeFamily context symbol arguments =>
      [.context context, .context (D.typeParameters symbol),
        .substitution context (D.typeParameters symbol) arguments]
  | .primitive context symbol arguments =>
      [.context context, .context (D.termParameters symbol), .type (D.termParameters symbol) (D.termResult symbol),
        .substitution context (D.termParameters symbol) arguments]
  | .piFormation context domain body => [.type context domain, .type (.snoc context domain) body]
  | .sigmaFormation context domain body => [.type context domain, .type (.snoc context domain) body]
  | .lambda context domain body term =>
      [.type context domain, .type (.snoc context domain) body, .term (.snoc context domain) term body]
  | .application context domain body function argument =>
      [.type context domain, .type (.snoc context domain) body,
        .term context function (.pi domain body), .term context argument domain]
  | .pairIntroduction context domain body first second =>
      [.type context domain, .type (.snoc context domain) body,
        .term context first domain, .term context second (body.substitute (instantiate first))]
  | .firstProjection context domain body pair =>
      [.type context domain, .type (.snoc context domain) body, .term context pair (.sigma domain body)]
  | .secondProjection context domain body pair =>
      [.type context domain, .type (.snoc context domain) body, .term context pair (.sigma domain body)]
  | .sigmaElimination context domain body motive branch pair =>
      [.type context domain, .type (.snoc context domain) body,
        .type (.snoc context (.sigma domain body)) motive,
        .term (.snoc (.snoc context domain) body) branch (motive.substitute (packSubstitution domain body)),
        .term context pair (.sigma domain body)]
  | .termConversion context term first second =>
      [.term context term first, .typeEq context first second]
  | .substitutionNil context => [.context context]
  | .substitutionExtend source target type substitution term =>
      [.substitution source target substitution, .type target type,
        .term source term (type.substitute substitution)]
  | .substitutionIdentity context => [.context context]
  | .substitutionCompose source middle target first second =>
      [.substitution source middle first, .substitution middle target second]
  | .substitutionWeaken context type => [.type context type]
  | .substituteType source target substitution type =>
      [.substitution source target substitution, .type target type]
  | .substituteTerm source target substitution term type =>
      [.substitution source target substitution, .term target term type]
  | .contextReflexivity context => [.context context]
  | .contextSymmetry first second => [.contextEq first second]
  | .contextTransitivity first middle last => [.contextEq first middle, .contextEq middle last]
  | .contextExtendEquality first second firstType secondType =>
      [.contextEq first second, .typeEq first firstType secondType, .type second secondType]
  | .transportType first second type => [.contextEq first second, .type first type]
  | .transportTerm first second term type => [.contextEq first second, .term first term type]
  | .transportSubstitution source source' target target' substitution =>
      [.contextEq source source', .contextEq target target', .substitution source target substitution]
  | .typeReflexivity context type => [.type context type]
  | .typeSymmetry context first second => [.typeEq context first second]
  | .typeTransitivity context first middle last => [.typeEq context first middle, .typeEq context middle last]
  | .termReflexivity context term type => [.term context term type]
  | .termSymmetry context first second type => [.termEq context first second type]
  | .termTransitivity context first middle last type => [.termEq context first middle type, .termEq context middle last type]
  | .equalityConversion context first second firstType secondType =>
      [.termEq context first second firstType, .typeEq context firstType secondType]
  | .transportTypeEquality source target first second => [.contextEq source target, .typeEq source first second]
  | .transportTermEquality source target first second type => [.contextEq source target, .termEq source first second type]
  | .piCongruence context firstDomain secondDomain firstBody secondBody =>
      [.typeEq context firstDomain secondDomain, .typeEq (.snoc context firstDomain) firstBody secondBody,
        .type (.snoc context secondDomain) secondBody]
  | .sigmaCongruence context firstDomain secondDomain firstBody secondBody =>
      [.typeEq context firstDomain secondDomain, .typeEq (.snoc context firstDomain) firstBody secondBody,
        .type (.snoc context secondDomain) secondBody]
  | .familyCongruence context symbol first second =>
      [.context (D.typeParameters symbol), .substitutionEq context (D.typeParameters symbol) first second]
  | .primitiveCongruence context symbol first second =>
      [.type (D.termParameters symbol) (D.termResult symbol),
        .substitutionEq context (D.termParameters symbol) first second]
  | .lambdaCongruence context domain body first second =>
      [.type context domain, .type (.snoc context domain) body, .termEq (.snoc context domain) first second body]
  | .applicationCongruence context domain body firstFunction secondFunction firstArgument secondArgument =>
      [.type context domain, .type (.snoc context domain) body,
        .termEq context firstFunction secondFunction (.pi domain body),
        .termEq context firstArgument secondArgument domain]
  | .pairCongruence context domain body firstLeft secondLeft firstRight secondRight =>
      [.type context domain, .type (.snoc context domain) body,
        .termEq context firstLeft secondLeft domain,
        .termEq context firstRight secondRight (body.substitute (instantiate firstLeft)),
        .term context secondRight (body.substitute (instantiate secondLeft))]
  | .firstCongruence context domain body first second =>
      [.type context domain, .type (.snoc context domain) body, .termEq context first second (.sigma domain body)]
  | .secondCongruence context domain body first second =>
      [.type context domain, .type (.snoc context domain) body, .termEq context first second (.sigma domain body)]
  | .sigmaEliminationCongruence context domain body motive firstBranch secondBranch firstPair secondPair =>
      [.type context domain, .type (.snoc context domain) body, .type (.snoc context (.sigma domain body)) motive,
        .termEq (.snoc (.snoc context domain) body) firstBranch secondBranch (motive.substitute (packSubstitution domain body)),
        .termEq context firstPair secondPair (.sigma domain body)]
  | .lambdaAnnotationCongruence context firstDomain secondDomain firstBody secondBody first second =>
      [.typeEq context firstDomain secondDomain,
        .typeEq (.snoc context firstDomain) firstBody secondBody,
        .type (.snoc context secondDomain) secondBody,
        .termEq (.snoc context firstDomain) first second firstBody,
        .term (.snoc context secondDomain) second secondBody]
  | .applicationAnnotationCongruence context firstDomain secondDomain firstBody secondBody
      firstFunction secondFunction firstArgument secondArgument =>
      [.typeEq context firstDomain secondDomain,
        .typeEq (.snoc context firstDomain) firstBody secondBody,
        .type (.snoc context secondDomain) secondBody,
        .termEq context firstFunction secondFunction (.pi firstDomain firstBody),
        .termEq context firstArgument secondArgument firstDomain,
        .term context secondFunction (.pi secondDomain secondBody),
        .term context secondArgument secondDomain]
  | .pairAnnotationCongruence context firstDomain secondDomain firstBody secondBody
      firstLeft secondLeft firstRight secondRight =>
      [.typeEq context firstDomain secondDomain,
        .typeEq (.snoc context firstDomain) firstBody secondBody,
        .type (.snoc context secondDomain) secondBody,
        .termEq context firstLeft secondLeft firstDomain,
        .termEq context firstRight secondRight (firstBody.substitute (instantiate firstLeft)),
        .term context secondLeft secondDomain,
        .term context secondRight (secondBody.substitute (instantiate secondLeft))]
  | .firstAnnotationCongruence context firstDomain secondDomain firstBody secondBody first second =>
      [.typeEq context firstDomain secondDomain,
        .typeEq (.snoc context firstDomain) firstBody secondBody,
        .type (.snoc context secondDomain) secondBody,
        .termEq context first second (.sigma firstDomain firstBody),
        .term context second (.sigma secondDomain secondBody)]
  | .secondAnnotationCongruence context firstDomain secondDomain firstBody secondBody first second =>
      [.typeEq context firstDomain secondDomain,
        .typeEq (.snoc context firstDomain) firstBody secondBody,
        .type (.snoc context secondDomain) secondBody,
        .termEq context first second (.sigma firstDomain firstBody),
        .term context second (.sigma secondDomain secondBody)]
  | .sigmaEliminationAnnotationCongruence context firstDomain secondDomain firstBody secondBody
      firstMotive secondMotive firstBranch secondBranch firstPair secondPair =>
      [.typeEq context firstDomain secondDomain,
        .typeEq (.snoc context firstDomain) firstBody secondBody,
        .type (.snoc context secondDomain) secondBody,
        .typeEq (.snoc context (.sigma firstDomain firstBody)) firstMotive secondMotive,
        .type (.snoc context (.sigma secondDomain secondBody)) secondMotive,
        .termEq (.snoc (.snoc context firstDomain) firstBody) firstBranch secondBranch
          (firstMotive.substitute (packSubstitution firstDomain firstBody)),
        .term (.snoc (.snoc context secondDomain) secondBody) secondBranch
          (secondMotive.substitute (packSubstitution secondDomain secondBody)),
        .termEq context firstPair secondPair (.sigma firstDomain firstBody),
        .term context secondPair (.sigma secondDomain secondBody)]
  | .piBeta context domain body term argument =>
      [.type context domain, .type (.snoc context domain) body, .term (.snoc context domain) term body,
        .term context argument domain]
  | .piEta context domain body function =>
      [.type context domain, .type (.snoc context domain) body, .term context function (.pi domain body)]
  | .sigmaFirstBeta context domain body first second =>
      [.type context domain, .type (.snoc context domain) body,
        .term context first domain, .term context second (body.substitute (instantiate first))]
  | .sigmaSecondBeta context domain body first second =>
      [.type context domain, .type (.snoc context domain) body,
        .term context first domain, .term context second (body.substitute (instantiate first))]
  | .sigmaEta context domain body pair =>
      [.type context domain, .type (.snoc context domain) body, .term context pair (.sigma domain body)]
  | .sigmaEliminationBeta context domain body motive branch first second =>
      [.type context domain, .type (.snoc context domain) body, .type (.snoc context (.sigma domain body)) motive,
        .term (.snoc (.snoc context domain) body) branch (motive.substitute (packSubstitution domain body)),
        .term context first domain, .term context second (body.substitute (instantiate first))]
  | .sigmaEliminationEta context domain body motive term pair =>
      [.type context domain, .type (.snoc context domain) body, .type (.snoc context (.sigma domain body)) motive,
        .term (.snoc context (.sigma domain body)) term motive, .term context pair (.sigma domain body)]
  | .substituteTypeEquality source target substitution first second =>
      [.substitution source target substitution, .typeEq target first second]
  | .substituteTermEquality source target substitution first second type =>
      [.substitution source target substitution, .termEq target first second type]
  | .substitutionReflexivity source target substitution => [.substitution source target substitution]
  | .substitutionSymmetry source target first second => [.substitutionEq source target first second]
  | .substitutionTransitivity source target first middle last =>
      [.substitutionEq source target first middle, .substitutionEq source target middle last]
  | .substitutionExtendEquality source target type first second firstTerm secondTerm =>
      [.substitutionEq source target first second, .type target type,
        .termEq source firstTerm secondTerm (type.substitute first),
        .term source secondTerm (type.substitute second)]
  | .typeSubstitutionCongruence source target first second type =>
      [.substitutionEq source target first second, .type target type]
  | .termSubstitutionCongruence source target first second term type =>
      [.substitutionEq source target first second, .term target term type]

end RuleCode

/-- The indexed rule adapter checks that a rule's independently computed
conclusion is the requested judgment. Premise occurrences remain ordered. -/
def judgmentSignature (D : Signature S) : JudgmentDerivation.Signature.{u} where
  Judgment := Judgment S
  Rule judgment := {rule : RuleCode D // rule.conclusion = judgment}
  Premise rule := ULift (Fin rule.val.premises.length)
  hypothesis rule position := rule.val.premises.get position.down

abbrev Derivation (D : Signature S) (judgment : Judgment S) :=
  JudgmentDerivation.Derivation (judgmentSignature D) judgment

/-- Build exactly one supplied rule occurrence from its supplied premises. -/
def derive {D : Signature S} (rule : RuleCode D)
    (premises : (position : Fin rule.premises.length) → Derivation D (rule.premises.get position)) :
    Derivation D rule.conclusion := .node ⟨rule, rfl⟩ (fun position => premises position.down)

end Mettapedia.TypeTheory.Calculi.NativeDependent.External
