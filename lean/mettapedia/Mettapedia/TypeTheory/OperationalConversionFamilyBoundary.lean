import Mettapedia.TypeTheory.FreeConversion
import Mettapedia.TypeTheory.SetFamilyTypeOverEssentialImage

/-!
# Operational conversion and dependent-family transport

A type family can respect a conversion relation only if every conversion
path induces an equivalence between its endpoint fibres.  This deliberately
weak requirement assumes no functoriality or coherence; failure already means
that the relation cannot serve as judgmental conversion for that family.

For the response-indexed protocol, freely symmetrizing and composing all
operational steps makes the two completed branches convertible through their
common initial state.  Their result fibres are `PUnit` and `Bool`, so no
family transport exists.  Constant families and ordinary endpoint equality
provide positive controls.

The conclusion is a boundary on conversion, not on execution: the branching
steps remain valid proof-relevant operational routes.  They simply cannot all
be reclassified as global judgmental conversion in a dependent theory that
retains the response-indexed result family.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.OperationalConversionFamilyBoundary

open Mettapedia.GSLT.Core.InteractionEvent
open Mettapedia.GSLT.Dynamics.IndexedPolynomialProtocol
open Mettapedia.GSLT.Dynamics.IndexedPolynomialProtocol.VaryingCanary
open Mettapedia.GSLT.Dynamics.DependentReflectiveProtocolComparison
open Mettapedia.TypeTheory.DependentFamilyObserverFactorization
open Mettapedia.TypeTheory.FreeConversion
open Mettapedia.TypeTheory.JudgmentalEquality

universe uState uConversion uFamily

/-! ## Minimal conversion stability -/

/-- Every retained conversion path transports the selected dependent family
by equivalence.  No identity or composition law is assumed. -/
structure FamilyTransport
    {State : Type uState}
    (Conversion : State → State → Type uConversion)
    (Family : State → Type uFamily) where
  fibreEquiv : ∀ {source target},
    Conversion source target → Family source ≃ Family target

/-- Constant families respect every conversion relation. -/
def constantFamilyTransport
    {State : Type uState}
    (Conversion : State → State → Type uConversion)
    (Carrier : Type uFamily) :
    FamilyTransport Conversion (fun _ => Carrier) where
  fibreEquiv := fun _path => Equiv.refl Carrier

/-- Every family respects literal equality of its indices. -/
def equalityFamilyTransport
    {State : Type uState} (Family : State → Type uFamily) :
    FamilyTransport (fun source target => PLift (source = target)) Family where
  fibreEquiv := fun equality =>
    Equiv.cast (congrArg Family equality.down)

/-! ## Free conversion generated by protocol execution -/

/-- One judgment index is sufficient for this boundary; the states are
protocol phases and primitive conversion generators are operational steps. -/
abbrev PhaseState (_index : Unit) : Type :=
  Phase

def phaseOperationalStep {index : Unit}
    (source target : PhaseState index) : Type :=
  PLift ((lts codedQuery).Step source target)

/-- Reflexive, symmetric, transitive conversion freely generated by all coded
protocol steps. -/
abbrev OperationalConversion (source target : Phase) : Type :=
  Path PhaseState (fun {index} => phaseOperationalStep (index := index))
    (index := ()) source target

def unitConversion :
    OperationalConversion Phase.start Phase.unitDone :=
  ConversionEvidence.step ⟨unitEvent.step⟩

def boolConversion :
    OperationalConversion Phase.start Phase.boolDone :=
  ConversionEvidence.step ⟨boolEvent.step⟩

/-- Symmetry and transitivity identify the two branches through their common
source. -/
def completedBranchConversion :
    OperationalConversion Phase.unitDone Phase.boolDone :=
  ConversionEvidence.trans
    (ConversionEvidence.symm unitConversion)
    boolConversion

/-- The response-indexed result family cannot respect the free symmetric
closure of operational execution.  Even incoherent path-by-path transport is
impossible. -/
theorem result_has_no_operational_conversion_transport :
    ¬ Nonempty (FamilyTransport OperationalConversion Result) := by
  rintro ⟨transport⟩
  have unitBool := transport.fibreEquiv completedBranchConversion
  change PUnit ≃ Bool at unitBool
  exact Canary.unit_not_equiv_bool ⟨unitBool⟩

/-- A constant family remains stable under the same conversion paths. -/
def unitConstantOperationalTransport :
    FamilyTransport OperationalConversion (fun _ : Phase => PUnit) :=
  constantFamilyTransport OperationalConversion PUnit

/-- The result family remains stable under actual equality of phase indices;
the obstruction is specifically the extra operational identifications. -/
def resultEqualityTransport :
    FamilyTransport (fun source target : Phase => PLift (source = target))
      Result :=
  equalityFamilyTransport Result

/-- Positive and negative controls for the conversion boundary. -/
theorem operational_conversion_family_boundary :
    Nonempty
        (FamilyTransport OperationalConversion (fun _ : Phase => PUnit)) /\
      Nonempty
        (FamilyTransport
          (fun source target : Phase => PLift (source = target)) Result) /\
      Nonempty
        (OperationalConversion Phase.unitDone Phase.boolDone) /\
      ¬ Nonempty (FamilyTransport OperationalConversion Result) :=
  ⟨⟨unitConstantOperationalTransport⟩,
    ⟨resultEqualityTransport⟩,
    ⟨completedBranchConversion⟩,
    result_has_no_operational_conversion_transport⟩

#print axioms constantFamilyTransport
#print axioms equalityFamilyTransport
#print axioms completedBranchConversion
#print axioms result_has_no_operational_conversion_transport
#print axioms operational_conversion_family_boundary

end Mettapedia.TypeTheory.OperationalConversionFamilyBoundary
