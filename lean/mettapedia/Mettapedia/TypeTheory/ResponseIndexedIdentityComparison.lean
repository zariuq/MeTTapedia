import Mettapedia.TypeTheory.EqualityIdentityRouteStructure
import Mettapedia.TypeTheory.OperationalPathIdentityComparison
import Mettapedia.TypeTheory.OperationalConversionFamilyBoundary
import Mettapedia.TypeTheory.EqualityFamilyObserverFactorization

/-!
# Identity comparisons on a response-indexed protocol

One three-state response protocol supports several mathematically different
notions that must not be conflated:

* literal equality of protocol phases;
* intrinsic identity in the set-families CwF;
* directed operational execution paths;
* symmetric conversion freely generated by execution; and
* equality after the coarse completion observation.

Literal equality and the intrinsic set-family identity agree fibrewise and
carry the expected identity structure.  Execution has an endpoint-changing
path, so its path layer cannot carry that structure.  The completion observer
is sound on strict equality but incomplete: it identifies the two completed
phases.  Their dependent result fibres differ, so neither source equality nor
the result family descends through completion.

These results form a comparison battery.  They do not select judgmental
equality, propositional identity, equality reflection, UIP, univalence, or an
operational-equivalence policy for any language.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.ResponseIndexedIdentityComparison

open Mettapedia.GSLT.Core.ContextualLadder
open Mettapedia.GSLT.Dynamics.IndexedPolynomialProtocol
open Mettapedia.GSLT.Dynamics.IndexedPolynomialProtocol.VaryingCanary
open Mettapedia.GSLT.Dynamics.DependentReflectiveProtocolComparison
open Mettapedia.TypeTheory.ContextualIdentityTypes
open Mettapedia.TypeTheory.DecidableIdentityRouteStructure
open Mettapedia.TypeTheory.DependentFamilyObserverFactorization
open Mettapedia.TypeTheory.EqualityFamilyObserverFactorization
open Mettapedia.TypeTheory.EqualityIdentityRouteStructure
open Mettapedia.TypeTheory.IdentityObservationComparison
open Mettapedia.TypeTheory.IdentityRouteCapabilities
open Mettapedia.TypeTheory.OperationalConversionFamilyBoundary
open Mettapedia.TypeTheory.OperationalPathIdentityComparison

/-! ## Strict phase equality -/

/-- Literal phase equality as the strict comparison layer. -/
abbrev StrictPhaseIdentity := equalityLayer Phase

/-- Protocol phases have decidable strict identity. -/
def strictPhaseIdentityStructure : Structure StrictPhaseIdentity :=
  equalityStructure Phase

/-- Strict equality remains sound after observing only completion. -/
def strictCompletionComparison : Comparison StrictPhaseIdentity completion :=
  ofEndpointReflection (endpointReflection Phase) completion

/-- The completion observation identifies two distinct completed phases. -/
theorem completion_not_injective : ¬ Function.Injective completion := by
  intro injective
  have sameCompletion :
      completion Phase.unitDone = completion Phase.boolDone := rfl
  have samePhase : Phase.unitDone = Phase.boolDone :=
    injective sameCompletion
  exact (by decide : Phase.unitDone ≠ Phase.boolDone) samePhase

/-- Hence strict identity is sound but not complete after completion is
observed: completion invents an equality not present between source phases. -/
theorem strictCompletionComparison_not_complete :
    ¬ strictCompletionComparison.Complete := by
  rw [strictCompletionComparison.complete_iff_observe_injective
    (endpointReflection Phase)]
  exact completion_not_injective

/-- Equivalently, the source equality family itself cannot factor through
the completion observation. -/
theorem strictEquality_not_completion_factorized :
    ¬ Nonempty (EqualityFamilyFactorization completion) := by
  rw [EqualityFamilyFactorization.nonempty_iff_injective]
  exact completion_not_injective

/-! ## Intrinsic identity in the set-families CwF -/

/-- Protocol phases as a contextual type over the one-point context. -/
def phaseType : (familiesCwf.{0}).Ty PUnit := fun _ => Phase

/-- A phase as a contextual term. -/
def phaseTerm (phase : Phase) : (familiesCwf.{0}).Tm PUnit phaseType :=
  fun _ => phase

/-- Intrinsic identity terms between two protocol phases in the standard
set-families model. -/
abbrev IntrinsicPhaseIdentity (source target : Phase) :=
  (familiesCwf.{0}).Tm PUnit
    (ContextualIdentityTypes.Families.identityFormation.idTy phaseType
      (phaseTerm source) (phaseTerm target))

/-- On this shared corpus, intrinsic set-family identity agrees exactly with
the strict lifted-equality route. -/
def intrinsicStrictEquiv (source target : Phase) :
    IntrinsicPhaseIdentity source target ≃
      StrictPhaseIdentity.Route source target where
  toFun proof := (proof PUnit.unit).down
  invFun route := fun _ => ⟨route⟩
  left_inv proof :=
    (ContextualIdentityTypes.Families.proofIrrelevance
      (phaseTerm source) (phaseTerm target)).allEq
        (fun _ => ⟨(proof PUnit.unit).down⟩) proof
  right_inv _route := rfl

/-- The intrinsic identity fibre reflects equality of the selected phases. -/
theorem intrinsicPhaseIdentity_reflects
    {source target : Phase} :
    IntrinsicPhaseIdentity source target → source = target :=
  fun proof => (intrinsicStrictEquiv source target proof).down

/-- Intrinsic phase identity is proof-irrelevant in this particular model.
This is a model property, not a global identity-policy selection. -/
theorem intrinsicPhaseIdentity_subsingleton (source target : Phase) :
    Subsingleton (IntrinsicPhaseIdentity source target) :=
  ContextualIdentityTypes.Families.proofIrrelevance
    (phaseTerm source) (phaseTerm target)

/-- The set-families CwF supplies full contextual J and beta for the identity
formation used by the phase corpus. -/
def setFamiliesIdentityElimination :
    IdentityEliminationBeta (familiesCwf.{0})
      ContextualIdentityTypes.Families.identityFormation
      ContextualIdentityTypes.Families.identityReflexivity :=
  ContextualIdentityTypes.Families.identityElimination

/-- Negative control: there is no intrinsic identity witness between the two
different completed phases. -/
theorem completedBranches_have_no_intrinsicIdentity :
    ¬ Nonempty
      (IntrinsicPhaseIdentity Phase.unitDone Phase.boolDone) := by
  rintro ⟨proof⟩
  exact (by decide : Phase.unitDone ≠ Phase.boolDone)
    (intrinsicPhaseIdentity_reflects proof)

/-! ## Operational routes are not identity proofs -/

/-- The real transition from the initial phase to the unit-result phase is an
endpoint-changing operational route. -/
theorem protocolExecution_changes_endpoint :
    HasEndpointChangingRoute (executionLayer (lts codedQuery)) := by
  refine ⟨Phase.start, Phase.unitDone, ?_, ⟨unitExecutionPath⟩⟩
  intro samePhase
  cases samePhase

/-- Therefore operational execution paths cannot carry the complete
decidable identity-route structure. -/
theorem protocolExecution_has_no_identityStructure :
    ¬ Nonempty (Structure (executionLayer (lts codedQuery))) :=
  endpointChangingRoute_excludes_structure protocolExecution_changes_endpoint

/-! ## The combined comparison boundary -/

/-- Strict and intrinsic identity agree on phases, while execution and coarse
observation remain deliberately distinct.  The final conjunct retains the
existing dependent-family obstruction for the same completed branches. -/
theorem response_indexed_identity_boundary :
    Nonempty (Structure StrictPhaseIdentity) ∧
      (∀ source target,
        Nonempty
          (IntrinsicPhaseIdentity source target ≃
            StrictPhaseIdentity.Route source target)) ∧
      Nonempty
        (IdentityEliminationBeta (familiesCwf.{0})
          ContextualIdentityTypes.Families.identityFormation
          ContextualIdentityTypes.Families.identityReflexivity) ∧
      (¬ Nonempty
        (IntrinsicPhaseIdentity Phase.unitDone Phase.boolDone)) ∧
      HasEndpointChangingRoute (executionLayer (lts codedQuery)) ∧
      (¬ Nonempty (Structure (executionLayer (lts codedQuery)))) ∧
      Nonempty (Comparison StrictPhaseIdentity completion) ∧
      (¬ strictCompletionComparison.Complete) ∧
      completion Phase.unitDone = completion Phase.boolDone ∧
      (¬ Nonempty (EqualityFamilyFactorization completion)) ∧
      (¬ Nonempty (FamilyFactorization completion Result)) :=
  ⟨⟨strictPhaseIdentityStructure⟩,
    fun source target => ⟨intrinsicStrictEquiv source target⟩,
    ⟨setFamiliesIdentityElimination⟩,
    completedBranches_have_no_intrinsicIdentity,
    protocolExecution_changes_endpoint,
    protocolExecution_has_no_identityStructure,
    ⟨strictCompletionComparison⟩,
    strictCompletionComparison_not_complete,
    rfl,
    strictEquality_not_completion_factorized,
    result_not_completion_determined⟩

#print axioms completion_not_injective
#print axioms strictCompletionComparison_not_complete
#print axioms strictEquality_not_completion_factorized
#print axioms intrinsicStrictEquiv
#print axioms intrinsicPhaseIdentity_reflects
#print axioms completedBranches_have_no_intrinsicIdentity
#print axioms protocolExecution_has_no_identityStructure
#print axioms response_indexed_identity_boundary

end Mettapedia.TypeTheory.ResponseIndexedIdentityComparison
