import Mettapedia.TypeTheory.ConversionDecisionComparison
import Mettapedia.UniversalAlgebra.Instances.FreeMonoidNormalization

/-!
# Conversion for types indexed by free-monoid expressions

This file is a concrete conversion experiment on a genuinely indexed type
fragment.  Family types carry an index in the monoid term language.  Their
conversion has three independently defined faces:

* proof-relevant paths generated by accepted equational certificates;
* direct equality of canonical free-monoid words; and
* conversion after erasure to canonical codes.

All three recognize the same endpoint pairs.  Two negative controls delimit
that result.  Erasing the family tag is unsound even though it preserves every
source conversion, and arbitrary substitution preserves conversion but need
not reflect it.  A simple family-name readout is likewise too coarse to
recover indexed conversion or the semantic result fibre.

The fragment is a conversion laboratory, not a proposed complete dependent
type theory.  In particular it selects no universe, identity, effect, or
surface-language policy.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.MonoidIndexedFamilyConversion

open Mettapedia.Logic
open Mettapedia.TypeTheory.FreeConversion
open Mettapedia.TypeTheory.JudgmentalEquality
open Mettapedia.TypeTheory.ConversionDecisionComparison
open Mettapedia.UniversalAlgebra
open Mettapedia.UniversalAlgebra.Monoid
open Mettapedia.UniversalAlgebra.Monoid.FreeNormalization

/-! ## Indexed types and certificate-bearing conversion -/

/-- Two intentionally distinct dependent family symbols. -/
inductive Family where
  | packet
  | channel
deriving DecidableEq

/-- A family application indexed by a symbolic free-monoid word. -/
structure IndexedType where
  family : Family
  index : Term signature
deriving DecidableEq

/-- The complete endpoint invariant: retain the family symbol and normalize
its symbolic index. -/
def normalCode (type : IndexedType) : Family × List Nat :=
  (type.family, flatten type.index)

/-- One primitive conversion step carries an accepted replay certificate for
the index equation and cannot change the family symbol. -/
inductive ConversionStep : IndexedType → IndexedType → Type where
  | certified (family : Family) {source target : Term signature}
      (certificate : AcceptedCertificate
        (equationalRuleInterface equationSystem) (source, target)) :
      ConversionStep
        { family := family, index := source }
        { family := family, index := target }

/-- Indexed types as a one-index conversion state family. -/
abbrev State (_index : Unit) := IndexedType

/-- Certificate-bearing reflexive/symmetric/transitive conversion paths. -/
abbrev ConversionPath (source target : IndexedType) :=
  Path State (fun {_index : Unit} => ConversionStep)
    (index := ()) source target

/-- Canonical words form a complete invariant for certificate-bearing
conversion. -/
def completeInvariant : CompleteInvariant
    State (fun {_index : Unit} => ConversionStep)
    (fun _index : Unit => Family × List Nat) where
  classify := fun _index type => normalCode type
  generatorInvariant := by
    intro index source target evidence
    cases evidence with
    | certified family certificate =>
        apply Prod.ext
        · rfl
        · exact flatten_eq_of_consequence
            (consequenceOfAccepted certificate)
  complete := by
    intro index source target codesEqual
    rcases source with ⟨sourceFamily, sourceIndex⟩
    rcases target with ⟨targetFamily, targetIndex⟩
    have familiesEqual : sourceFamily = targetFamily :=
      congrArg Prod.fst codesEqual
    have wordsEqual : flatten sourceIndex = flatten targetIndex :=
      congrArg Prod.snd codesEqual
    subst targetFamily
    obtain ⟨certificate⟩ := nonemptyAcceptedOfConsequence
      (consequence_of_flatten_eq wordsEqual)
    exact ⟨.step (.certified sourceFamily certificate)⟩

/-- Execute the direct canonical-word conversion decision. -/
def decideConversion (source target : IndexedType) : Bool :=
  completeInvariant.decideConversion () source target

theorem decideConversion_eq_true_iff {source target : IndexedType} :
    decideConversion source target = true ↔
      Nonempty (ConversionPath source target) :=
  completeInvariant.decideConversion_eq_true_iff (index := ())

theorem path_preserves_normalCode {source target : IndexedType}
    (path : ConversionPath source target) :
    normalCode source = normalCode target :=
  completeInvariant.pathInvariant path

/-! ## A small syntax-directed dependent checker -/

/-- Values are tokens whose exact type retains both a family and its symbolic
index. -/
inductive Value where
  | token (family : Family) (index : Term signature)

def inferredType : Value → IndexedType
  | .token family index => { family := family, index := index }

/-- The conversion-free typing judgment is syntax directed. -/
inductive HasType : Value → IndexedType → Prop where
  | token (family : Family) (index : Term signature) :
      HasType (.token family index) { family := family, index := index }

theorem HasType.unique {value : Value} {first : IndexedType}
    (typing : HasType value first) :
    ∀ {second : IndexedType}, HasType value second → first = second := by
  intro second other
  cases typing
  cases other
  rfl

theorem inferred_hasType (value : Value) : HasType value (inferredType value) := by
  cases value
  exact .token _ _

/-- A typed conversion receipt retains the syntax-directed source type and
the complete conversion path to the requested type. -/
structure TypingReceipt (value : Value) (target : IndexedType) where
  source : IndexedType
  typing : HasType value source
  conversion : ConversionPath source target

/-- Canonical-word checking recognizes exactly the types admitting a typed
conversion receipt. -/
theorem decideConversion_iff_nonemptyTypingReceipt
    {value : Value} {target : IndexedType} :
    decideConversion (inferredType value) target = true ↔
      Nonempty (TypingReceipt value target) := by
  constructor
  · intro accepted
    obtain ⟨path⟩ := decideConversion_eq_true_iff.mp accepted
    exact ⟨
      { source := inferredType value
        typing := inferred_hasType value
        conversion := path }⟩
  · rintro ⟨receipt⟩
    have sourceEqual := (inferred_hasType value).unique receipt.typing
    exact decideConversion_eq_true_iff.mpr
      ⟨sourceEqual.symm ▸ receipt.conversion⟩

/-! ## Safe canonical erasure -/

/-- Raw canonical codes use equality as their primitive step evidence. -/
abbrev Code := Family × List Nat

/-- Equality evidence lifted into `Type`, as required by a proof-relevant
primitive-step family. -/
abbrev EqualityStep (Carrier : Type) (source target : Carrier) : Type :=
  PLift (source = target)

def codeInvariant : CompleteInvariant
    (fun _index : Unit => Code)
    (fun {_index : Unit} source target => EqualityStep Code source target)
    (fun _index : Unit => Code) where
  classify := fun _index code => code
  generatorInvariant := fun equality => equality.down
  complete := fun equality => ⟨.step ⟨equality⟩⟩

/-- Normalization erases syntax but retains exactly the endpoint information
needed for conversion. -/
def canonicalErasure : ExactConversionErasure
    State (fun {_index : Unit} => ConversionStep)
    Code (EqualityStep Code) where
  erase := normalCode
  onStep := fun evidence =>
    ⟨completeInvariant.generatorInvariant evidence⟩
  reflects := by
    intro index source target rawPath
    obtain ⟨path⟩ := rawPath
    exact completeInvariant.complete (codeInvariant.pathInvariant path)

/-- The decision performed on canonical erased codes is exact for the source
dependent-family conversion. -/
theorem canonicalErasedDecision_eq_true_iff
    {source target : IndexedType} :
    codeInvariant.decideConversion ()
        (canonicalErasure.erase (index := ()) source)
        (canonicalErasure.erase (index := ()) target) = true ↔
      Nonempty (ConversionPath source target) :=
  canonicalErasure.erasedDecision_eq_true_iff codeInvariant

/-- Direct normalization and normalization followed by raw code equality are
the same executable endpoint test. -/
theorem directDecision_eq_canonicalErasedDecision
    (source target : IndexedType) :
    decideConversion source target =
      codeInvariant.decideConversion ()
        (canonicalErasure.erase (index := ()) source)
        (canonicalErasure.erase (index := ()) target) := by
  rfl

/-! ## Positive and negative endpoint controls -/

def packetX : IndexedType := { family := .packet, index := x }
def packetY : IndexedType := { family := .packet, index := y }
def packetXUnit : IndexedType :=
  { family := .packet, index := mul x one }
def channelX : IndexedType := { family := .channel, index := x }

/-- The positive conversion carries the concrete one-node monoid replay
certificate rather than merely appealing to certificate existence. -/
def rightUnitPath : ConversionPath packetXUnit packetX :=
  .step (.certified .packet rightUnitXCertificate)

theorem rightUnit_has_conversion :
    Nonempty (ConversionPath packetXUnit packetX) :=
  ⟨rightUnitPath⟩

theorem rightUnitPath_certificate_nodeCount :
    rightUnitXCertificate.nodeCount = 1 := rfl

theorem rightUnit_is_accepted :
    decideConversion packetXUnit packetX = true :=
  decideConversion_eq_true_iff.mpr rightUnit_has_conversion

theorem packetVariables_have_distinct_codes :
    normalCode packetX ≠ normalCode packetY := by
  simp [normalCode, packetX, packetY, x, y]

theorem packetVariables_have_no_conversion :
    ¬ Nonempty (ConversionPath packetX packetY) := by
  rintro ⟨path⟩
  exact packetVariables_have_distinct_codes (path_preserves_normalCode path)

theorem distinct_packet_indices_are_rejected :
    decideConversion packetX packetY = false := by
  apply Bool.eq_false_iff.mpr
  intro accepted
  exact packetVariables_have_no_conversion
    (decideConversion_eq_true_iff.mp accepted)

def packetValueXUnit : Value := .token .packet (mul x one)

theorem packetValue_checks_at_normalized_index :
    Nonempty (TypingReceipt packetValueXUnit packetX) :=
  decideConversion_iff_nonemptyTypingReceipt.mp rightUnit_is_accepted

theorem packetValue_wrong_index_rejected :
    decideConversion (inferredType packetValueXUnit) packetY = false := by
  apply Bool.eq_false_iff.mpr
  intro accepted
  obtain ⟨path⟩ := decideConversion_eq_true_iff.mp accepted
  have codeEquality := path_preserves_normalCode path
  simp [normalCode, inferredType, packetValueXUnit, packetY, x, y] at codeEquality

theorem packetValue_has_no_wrong_index_receipt :
    ¬ Nonempty (TypingReceipt packetValueXUnit packetY) := by
  intro receipt
  have accepted := decideConversion_iff_nonemptyTypingReceipt.mpr receipt
  rw [packetValue_wrong_index_rejected] at accepted
  cases accepted

theorem crossFamily_has_distinct_codes :
    normalCode packetX ≠ normalCode channelX := by
  simp [normalCode, packetX, channelX]

theorem crossFamily_has_no_conversion :
    ¬ Nonempty (ConversionPath packetX channelX) := by
  rintro ⟨path⟩
  exact crossFamily_has_distinct_codes (path_preserves_normalCode path)

/-! ## Unsafe erasure of the family tag -/

/-- This tempting readout keeps only the normalized symbolic index. -/
def dropFamily (type : IndexedType) : List Nat := flatten type.index

/-- Dropping the family tag preserves every valid primitive conversion. -/
def dropFamilyMap : ConversionMap
    State (fun {_index : Unit} => ConversionStep)
    (List Nat) (EqualityStep (List Nat)) where
  erase := dropFamily
  onStep := by
    intro index source target evidence
    exact ⟨congrArg Prod.snd
      (completeInvariant.generatorInvariant evidence)⟩

theorem dropFamily_identifies_distinct_families :
    dropFamily packetX = dropFamily channelX := rfl

/-- Preservation alone is insufficient: raw reflexivity across erased family
tags cannot be reflected to typed conversion. -/
theorem dropFamily_does_not_reflect : ¬ dropFamilyMap.Reflects := by
  intro reflects
  have rawPath : Nonempty
      (RawPath (List Nat) (EqualityStep (List Nat))
        (dropFamilyMap.erase (index := ()) packetX)
        (dropFamilyMap.erase (index := ()) channelX)) := by
    change Nonempty
      (RawPath (List Nat) (EqualityStep (List Nat))
        (dropFamily packetX) (dropFamily channelX))
    rw [dropFamily_identifies_distinct_families]
    exact ⟨ConversionEvidence.refl
      (computation := computation (fun _index : Unit => List Nat)
        (fun {_index : Unit} source target =>
          EqualityStep (List Nat) source target)) _⟩
  exact crossFamily_has_no_conversion
    (reflects (index := ()) (source := packetX) (target := channelX) rawPath)

/-! ## Simple observation does not recover dependency -/

/-- The STT-shaped observation remembers the family name but not its index. -/
def simpleReadout (type : IndexedType) : Family := type.family

theorem simpleReadout_identifies_distinct_indices :
    simpleReadout packetX = simpleReadout packetY := rfl

theorem simpleReadout_does_not_reflect_conversion :
    ¬ ∀ source target : IndexedType,
        simpleReadout source = simpleReadout target →
          Nonempty (ConversionPath source target) := by
  intro reflects
  exact packetVariables_have_no_conversion
    (reflects packetX packetY simpleReadout_identifies_distinct_indices)

/-- An independent denotation whose result type genuinely varies with the
normalized packet index. -/
def SemanticFibre (type : IndexedType) : Type :=
  match type.family with
  | .packet => Fin (flatten type.index).length.succ
  | .channel => PUnit

/-- Every certificate-bearing conversion transports the independently
defined semantic result fibre. -/
def semanticFibreEquivOfPath {source target : IndexedType}
    (path : ConversionPath source target) :
    SemanticFibre source ≃ SemanticFibre target := by
  have codesEqual := path_preserves_normalCode path
  rcases source with ⟨sourceFamily, sourceIndex⟩
  rcases target with ⟨targetFamily, targetIndex⟩
  have familiesEqual : sourceFamily = targetFamily :=
    congrArg Prod.fst codesEqual
  have wordsEqual : flatten sourceIndex = flatten targetIndex :=
    congrArg Prod.snd codesEqual
  subst targetFamily
  cases sourceFamily with
  | packet =>
      exact Equiv.cast
        (congrArg (fun word : List Nat => Fin word.length.succ) wordsEqual)
  | channel => exact Equiv.refl PUnit

def packetXY : IndexedType :=
  { family := .packet, index := mul x y }

theorem packet_fibres_are_genuinely_indexed :
    ¬ Nonempty (SemanticFibre packetX ≃ SemanticFibre packetXY) := by
  change ¬ Nonempty (Fin 2 ≃ Fin 3)
  rintro ⟨equivalence⟩
  have cardsEqual := Fintype.card_congr equivalence
  simp at cardsEqual

/-! ## Substitution: preservation without reflection -/

def IndexedType.subst (substitution : Nat → Term signature)
    (type : IndexedType) : IndexedType :=
  { family := type.family, index := type.index.subst substitution }

/-- Substitution maps every primitive certificate structurally. -/
def substitutionMap (substitution : Nat → Term signature) :
    ConversionMap State (fun {_index : Unit} => ConversionStep)
      IndexedType ConversionStep where
  erase := IndexedType.subst substitution
  onStep := by
    intro index source target evidence
    cases evidence with
    | certified family certificate =>
        exact .certified family
          (EquationalCertificate.instantiateAccepted substitution certificate)

/-- Every complete conversion path remains valid after substitution. -/
def substPath (substitution : Nat → Term signature)
    {source target : IndexedType} :
    ConversionPath source target →
      ConversionPath (source.subst substitution) (target.subst substitution) :=
  fun path => by
    simpa only [ConversionPath, RawPath, substitutionMap] using
      (substitutionMap substitution).mapPath path

theorem substitution_preserves_decision
    (substitution : Nat → Term signature)
    {source target : IndexedType}
    (accepted : decideConversion source target = true) :
    decideConversion (source.subst substitution)
      (target.subst substitution) = true := by
  obtain ⟨path⟩ := decideConversion_eq_true_iff.mp accepted
  exact decideConversion_eq_true_iff.mpr ⟨substPath substitution path⟩

/-- Substituting the same unit word for every variable identifies two packet
indices which were previously rejected. -/
theorem substitution_does_not_reflect_decision :
    ∃ substitution : Nat → Term signature,
      decideConversion (packetX.subst substitution)
          (packetY.subst substitution) = true ∧
        decideConversion packetX packetY = false := by
  refine ⟨fun _index => one, ?_, distinct_packet_indices_are_rejected⟩
  apply decideConversion_eq_true_iff.mpr
  exact completeInvariant.complete (by
    simp [IndexedType.subst, packetX, packetY, x, y])

/-! ## Decisions cannot reconstruct supplied conversion history -/

def reflexivePath (type : IndexedType) : ConversionPath type type :=
  ConversionEvidence.refl
    (computation := computation State
      (fun {_index : Unit} => ConversionStep)) type

def doubledReflexivePath (type : IndexedType) : ConversionPath type type :=
  .trans (reflexivePath type) (reflexivePath type)

theorem reflexivePath_ne_doubled (type : IndexedType) :
    reflexivePath type ≠ doubledReflexivePath type := by
  simp [reflexivePath, doubledReflexivePath]

theorem decision_cannot_recover_supplied_history (type : IndexedType) :
    ¬ ∃ recover : Nonempty (ConversionPath type type) → ConversionPath type type,
        ∀ path, recover ⟨path⟩ = path :=
  no_path_history_retraction
    (reflexivePath type) (doubledReflexivePath type)
    (reflexivePath_ne_doubled type)

