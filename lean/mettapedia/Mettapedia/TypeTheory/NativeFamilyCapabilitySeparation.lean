import Mettapedia.TypeTheory.IndexedPolynomial
import Mettapedia.TypeTheory.IndexedContainer

/-!
# Native-family capabilities are independent

An indexed polynomial exposes recursive constructor positions and their child
indices.  An indexed container exposes occurrences of one covariant parameter
in an already constructed value.  These structures license different native
operations and neither should be inferred merely from the other's name.

The positive List example has both structures.  The negative example below is
an indexed polynomial, hence strictly positive in its recursive family by
construction, but stores its parameter in a negative position.  It has no
covariant action and therefore no unary indexed-container representation.

Together with the infinitary Reader control in `IndexedContainer`, this gives
three separate capability boundaries:

* indexed-polynomial structure licenses recursive construction/elimination;
* a parameter-container representation licenses covariant map and relator
  structure; and
* `IndexedContainer.Finitary` separately licenses exact finite search.
-/

namespace Mettapedia.TypeTheory
namespace NativeFamilyCapabilitySeparation

open IndexedPolynomial

/-! ## Parameter-container representations -/

/-- A unary family is represented by one common shape/parameter-position
container.  This is deliberately stronger than merely being a strictly
positive recursive family. -/
structure UnaryContainerRepresentation (Family : Type → Type) where
  container : IndexedContainer.{0, 0, 0} Unit
  exact : ∀ Parameter : Type,
    Family Parameter ≃ container.Extension Parameter ()

/-- Every unary container representation supplies a covariant action by
transporting the generic container map across its exact representation. -/
noncomputable def UnaryContainerRepresentation.map
    {Family : Type → Type} (representation : UnaryContainerRepresentation Family)
    {Source Target : Type} (function : Source → Target) :
    Family Source → Family Target :=
  fun source =>
    (representation.exact Target).symm
      (representation.container.map function
        (representation.exact Source source))

@[simp] theorem UnaryContainerRepresentation.map_id
    {Family : Type → Type} (representation : UnaryContainerRepresentation Family)
    {Parameter : Type} (source : Family Parameter) :
    representation.map (fun value : Parameter => value) source = source := by
  apply (representation.exact Parameter).injective
  simp [UnaryContainerRepresentation.map]

@[simp] theorem UnaryContainerRepresentation.map_comp
    {Family : Type → Type} (representation : UnaryContainerRepresentation Family)
    {First Middle Last : Type} (earlier : First → Middle)
    (later : Middle → Last) (source : Family First) :
    representation.map later (representation.map earlier source) =
      representation.map (fun value => later (earlier value)) source := by
  apply (representation.exact Last).injective
  simp [UnaryContainerRepresentation.map, IndexedContainer.map_comp]

/-! ## A recursively positive but parameter-negative family -/

/-- One constructor shape stores a refutation of its parameter.  The
recursive family itself occurs nowhere negatively; indeed the polynomial has
no recursive positions at all. -/
inductive NegativeParameterShape (Parameter : Type) : Type where
  | observe (refute : Parameter → Empty) : NegativeParameterShape Parameter

/-- The empty position type makes `observe` a nullary recursive constructor.
The description is an ordinary indexed polynomial and hence strictly positive
in the recursively defined family by construction. -/
def negativeParameterPolynomial (Parameter : Type) :
    IndexedPolynomial Unit (fun _ => Unit) where
  Shape := fun _ _ => NegativeParameterShape Parameter
  Position := fun _ => Empty
  next := fun _ position => nomatch position

/-- The fixed family generated by the parameter-negative polynomial. -/
abbrev NegativeParameterFamily (Parameter : Type) : Type :=
  IndexedPolynomial.Fix (negativeParameterPolynomial Parameter) () ()

/-- At the empty parameter there is a canonical observed value. -/
def negativeEmpty : NegativeParameterFamily Empty :=
  .roll (.observe (fun value => value)) (fun position => nomatch position)

/-- At the inhabited unit parameter, no observed value can exist. -/
def negativeUnitElim : NegativeParameterFamily Unit → Empty
  | .roll (.observe refute) _children => refute ()

instance negativeUnitIsEmpty : IsEmpty (NegativeParameterFamily Unit) where
  false value := (negativeUnitElim value).elim

/-- Strict positivity of the recursive family does not manufacture covariance
in an unrelated parameter.  The unique function `Empty → Unit` would have to
send the inhabited empty-parameter fibre into the empty unit-parameter fibre. -/
theorem negativeParameterFamily_has_no_covariant_map :
    ¬ Nonempty (∀ {Source Target : Type},
      (Source → Target) →
        NegativeParameterFamily Source → NegativeParameterFamily Target) := by
  rintro ⟨mapping⟩
  exact (negativeUnitElim
    (mapping (fun source : Empty => source.elim) negativeEmpty)).elim

/-- Consequently the recursively positive family has no unary indexed-
container representation.  Any such representation would provide exactly the
covariant map refuted above. -/
theorem negativeParameterFamily_has_no_container_representation :
    ¬ Nonempty (UnaryContainerRepresentation NegativeParameterFamily) := by
  rintro ⟨representation⟩
  apply negativeParameterFamily_has_no_covariant_map
  exact ⟨fun function => representation.map function⟩

/-! ## Positive comparison: native polynomial List has both views -/

/-- Polynomial List is also represented by the ordinary List parameter
container.  The recursive and parameter-position descriptions agree through
their independently proved ordinary-List equivalences. -/
noncomputable def listContainerRepresentation :
    UnaryContainerRepresentation IndexedPolynomial.ListExample.ListP where
  container := IndexedContainer.Examples.list
  exact Parameter :=
    (IndexedPolynomial.ListExample.equivList Parameter).trans
      (IndexedContainer.Examples.listExtensionEquiv Parameter)

/-- The positive comparison really transports a singleton polynomial List to
the singleton value of the container extension. -/
theorem listContainerRepresentation_singleton
    (value : Unit) :
    (listContainerRepresentation.exact Unit)
        (IndexedPolynomial.ListExample.cons value
          IndexedPolynomial.ListExample.nil) =
      (⟨1, fun _ => value⟩ :
        Σ length : Nat, Fin length → Unit) := by
  change List.equivSigmaTuple
      (IndexedPolynomial.ListExample.toList
        (IndexedPolynomial.ListExample.cons value
          IndexedPolynomial.ListExample.nil)) = _
  rw [IndexedPolynomial.ListExample.toList_cons,
    IndexedPolynomial.ListExample.toList_nil]
  apply Sigma.ext
  · rfl
  · apply heq_of_eq
    funext position
    exact Subsingleton.elim _ _

/-! ## Positive comparison: the infinitary reader has covariance, not finitarity -/

/-- The positive reader/product is also exactly represented by its parameter
container.  Unlike List, its position fibre is infinite; this representation
therefore licenses mapping and relational lifting but not finite search. -/
noncomputable def readerContainerRepresentation :
    UnaryContainerRepresentation (fun Parameter : Type => Nat → Parameter) where
  container := IndexedContainer.Examples.reader
  exact Parameter :=
    (IndexedContainer.Examples.readerExtensionEquiv Parameter).symm

/-! ## Axiom audit -/

#print axioms UnaryContainerRepresentation.map
#print axioms UnaryContainerRepresentation.map_id
#print axioms UnaryContainerRepresentation.map_comp
#print axioms negativeParameterFamily_has_no_covariant_map
#print axioms negativeParameterFamily_has_no_container_representation
#print axioms listContainerRepresentation
#print axioms listContainerRepresentation_singleton
#print axioms readerContainerRepresentation

end NativeFamilyCapabilitySeparation
end Mettapedia.TypeTheory
