import Mettapedia.TypeTheory.CwfDependentRightAdjointComposition
import Mettapedia.TypeTheory.EvidenceCompletionDependentRightAdjoint
import Mettapedia.TypeTheory.RouteQuotientDependentRightAdjoint

/-!
# Dependent operational--intensional--extensional factorization

The object-level observation of an operational system factors through free
reflexive evidence completion.  This module lifts that statement to dependent
types and terms:

* evidence completion is a dependent right adjoint;
* route quotient is a dependent right adjoint;
* their composite is therefore a dependent right adjoint from operational
  families to extensional families; and
* its context action agrees naturally, up to the already proved quotient
  isomorphism, with direct operational observation.

The final calculations show that a family and a section pulled back through
the composite have exactly the same pointwise observations as direct
quotient pullback.  The result is a factorization theorem, not a claim that
every operational or intensional family descends through an identifying
quotient.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.OperationalIntensionalExtensionalDependentFactorization

open CategoryTheory
open Mettapedia.TypeTheory.CwfDependentRightAdjoint
open Mettapedia.TypeTheory.EvidenceCompletionDependentRightAdjoint
open Mettapedia.TypeTheory.OperationalFamilyCwf
open Mettapedia.TypeTheory.OperationalIntensionalExtensionalModes
open Mettapedia.TypeTheory.RouteFamilyCwf
open Mettapedia.TypeTheory.RouteQuotientDependentRightAdjoint

universe u

/-! ## The composite dependent modality -/

/-- Operational evidence completion followed by extensional route readout,
lifted to dependent types and terms. -/
def evidenceReadoutDra :
    DependentRightAdjoint dynCwf.{u} extCwf.{u} :=
  DependentRightAdjoint.comp evidenceCompletionDra routeQuotientDra

/-- The same composite over the selected terminal CwFs. -/
def evidenceReadoutDraWithTerminal :
    DependentRightAdjointWithTerminal dynCwfWithTerminal.{u}
      extCwfWithTerminal.{u} :=
  DependentRightAdjointWithTerminal.comp evidenceCompletionDraWithTerminal
    routeQuotientDraWithTerminal

/-- The context part of the dependent composite is naturally isomorphic to
direct operational quotient observation. -/
def evidenceReadoutContextIso (context : DynSys.{u}) :
    routeQuotient.obj (evidenceCompletion.obj context) ≅
      dynQuotient.obj context :=
  quotEvidenceIso context

@[simp]
theorem evidenceReadoutDra_leftContext (context : DynSys.{u}) :
    evidenceReadoutDra.leftContext context =
      routeQuotient.obj (evidenceCompletion.obj context) :=
  rfl

/-! ## Directly indexed families and their factorized presentation -/

/-- Pull an extensional family over the direct operational quotient back to
the operational context. -/
def directReadoutFamily (context : DynSys.{u})
    (family : (dynQuotient.obj context).carrier -> Type u) :
    DynFamily context where
  fibre point := family (Quot.mk context.Step point)
  transport step value :=
    cast (congrArg family (Quot.sound step)) value

/-- Move a family over direct operational observation across the canonical
context isomorphism to the composite observation context. -/
def familyAlongContextIso (context : DynSys.{u})
    (family : (dynQuotient.obj context).carrier -> Type u) :
    (routeQuotient.obj (evidenceCompletion.obj context)).carrier -> Type u :=
  fun observed => family ((evidenceReadoutContextIso context).hom.toFun observed)

/-- The operational family obtained by the dependent composite after moving
the extensional family across the context isomorphism. -/
def factorizedReadoutFamily (context : DynSys.{u})
    (family : (dynQuotient.obj context).carrier -> Type u) :
    DynFamily context :=
  restrictFamily context
    (pullbackReadoutFamily (evidenceCompletion.obj context)
      (familyAlongContextIso context family))

/-- The explicit factorized family is exactly the right action of the
composite dependent modality. -/
theorem factorizedReadoutFamily_is_composite (context : DynSys.{u})
    (family : (dynQuotient.obj context).carrier -> Type u) :
    factorizedReadoutFamily context family =
      evidenceReadoutDra.rightType context
        (familyAlongContextIso context family) :=
  rfl

@[simp]
theorem factorizedReadoutFamily_fibre (context : DynSys.{u})
    (family : (dynQuotient.obj context).carrier -> Type u)
    (point : context.carrier) :
    (factorizedReadoutFamily context family).fibre point =
      family (Quot.mk context.Step point) :=
  rfl

/-- Factorized transport along a primitive step is direct equality transport
along the quotient equation generated by that step. -/
theorem factorizedReadoutFamily_transport (context : DynSys.{u})
    (family : (dynQuotient.obj context).carrier -> Type u)
    {source target : context.carrier} (step : context.Step source target)
    (value : family (Quot.mk context.Step source)) :
    (factorizedReadoutFamily context family).transport step value =
      cast (congrArg family (Quot.sound step)) value := by
  change
    cast
      (congrArg (familyAlongContextIso context family)
        (Quot.sound (Relation.ReflGen.single step))) value =
    cast (congrArg family (Quot.sound step)) value
  have sameEquality :
      congrArg (familyAlongContextIso context family)
          (Quot.sound (Relation.ReflGen.single step)) =
        congrArg family (Quot.sound step) :=
    Subsingleton.elim _ _
  cases sameEquality
  rfl

/-- Thus the factorized and direct presentations of a pulled-back family are
equal as operational families, including their chosen primitive transports. -/
theorem factorizedReadoutFamily_eq_direct (context : DynSys.{u})
    (family : (dynQuotient.obj context).carrier -> Type u) :
    factorizedReadoutFamily context family =
      directReadoutFamily context family := by
  apply DynFamily.ext rfl
  apply heq_of_eq
  funext source target step value
  exact factorizedReadoutFamily_transport context family step value

/-! ## Sections compute through the factorization -/

/-- Pull a direct extensional section through the composite dependent
modality. -/
def factorizedReadoutSection (context : DynSys.{u})
    (family : (dynQuotient.obj context).carrier -> Type u)
    (term : forall observed, family observed) :
    DynSection
      (evidenceReadoutDra.rightType context
        (familyAlongContextIso context family)) :=
  (evidenceReadoutDra.termEquiv context
    (familyAlongContextIso context family))
      (fun observed =>
        term ((evidenceReadoutContextIso context).hom.toFun observed))

@[simp]
theorem factorizedReadoutSection_value (context : DynSys.{u})
    (family : (dynQuotient.obj context).carrier -> Type u)
    (term : forall observed, family observed)
    (point : context.carrier) :
    (factorizedReadoutSection context family term).value point =
      term (Quot.mk context.Step point) :=
  rfl

/-- The dependent triangle simultaneously carries the composite DRA and its
natural context comparison with direct observation. -/
theorem dependent_observation_factorization :
    Nonempty (DependentRightAdjoint dynCwf.{u} extCwf.{u}) ∧
      forall context : DynSys.{u},
        Nonempty
          (routeQuotient.obj (evidenceCompletion.obj context) ≅
            dynQuotient.obj context) :=
  ⟨⟨evidenceReadoutDra⟩, fun context => ⟨evidenceReadoutContextIso context⟩⟩

