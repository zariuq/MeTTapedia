import Mettapedia.TypeTheory.FreeConversion

/-!
# Comparing conversion evidence, erasure, and decision procedures

Conversion can be organized in several ways without changing the judgment it
recognizes.  This file separates four such faces:

* proof-relevant conversion paths;
* their propositional shadow, given by mere path existence;
* conversion after a representation-erasing map; and
* equality of a complete, decidable conversion invariant.

The comparison is conditional.  A representation map always transports
paths forward, but using erased conversion for typed checking additionally
requires reflection.  Likewise, a classifier decides conversion only when it
is both invariant under primitive steps and complete for path existence.

The finite canaries exhibit both sides of the boundary.  An exact recoding of
a three-state conversion system makes all four faces agree and has both an
accepted and a rejected query.  A map which erases two disconnected states to
one raw state preserves every source step vacuously but cannot reflect raw
conversion.  Finally, mere conversion cannot recover proof-relevant path
history.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.ConversionDecisionComparison

open Mettapedia.TypeTheory.FreeConversion
open Mettapedia.TypeTheory.JudgmentalEquality

universe uIndex uState uStep uCode uRawState uRawStep

/-! ## Complete invariants for conversion -/

/-- A complete invariant for the equivalence relation freely generated by a
primitive conversion step family.  `classify` need not literally compute a
normal form: normal forms, semantic values, and canonical codes are all
instances when they satisfy the two stated laws. -/
structure CompleteInvariant
    {Index : Type uIndex}
    (State : Index → Type uState)
    (Step : {index : Index} → State index → State index → Type uStep)
    (Code : Index → Type uCode) where
  classify : (index : Index) → State index → Code index
  generatorInvariant : ∀ {index : Index} {source target : State index},
    Step source target → classify index source = classify index target
  complete : ∀ {index : Index} {source target : State index},
    classify index source = classify index target →
      Nonempty (Path State Step source target)

namespace CompleteInvariant

/-- Every explicit conversion path preserves a complete invariant. -/
theorem pathInvariant
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {Code : Index → Type uCode}
    (invariant : CompleteInvariant State Step Code) :
    ∀ {index : Index} {source target : State index},
      Path State Step source target →
        invariant.classify index source = invariant.classify index target
  | _, _, _, .step evidence => invariant.generatorInvariant evidence
  | _, _, _, .refl _state => rfl
  | _, _, _, .symm path => (pathInvariant invariant path).symm
  | _, _, _, .trans first second =>
      (pathInvariant invariant first).trans
        (pathInvariant invariant second)

/-- Mere conversion is exactly equality of a complete invariant. -/
theorem nonemptyPath_iff_classify_eq
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {Code : Index → Type uCode}
    (invariant : CompleteInvariant State Step Code)
    {index : Index} {source target : State index} :
    Nonempty (Path State Step source target) ↔
      invariant.classify index source = invariant.classify index target := by
  constructor
  · rintro ⟨path⟩
    exact invariant.pathInvariant path
  · exact invariant.complete

/-- Equality of a decidable complete invariant gives a Boolean conversion
decision procedure. -/
def decideConversion
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {Code : Index → Type uCode}
    (invariant : CompleteInvariant State Step Code)
    [∀ index, DecidableEq (Code index)]
    (index : Index) (source target : State index) : Bool :=
  decide (invariant.classify index source = invariant.classify index target)

/-- The Boolean classifier accepts exactly the merely inhabited conversion
fibres. -/
theorem decideConversion_eq_true_iff
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {Code : Index → Type uCode}
    (invariant : CompleteInvariant State Step Code)
    [∀ index, DecidableEq (Code index)]
    {index : Index} {source target : State index} :
    invariant.decideConversion index source target = true ↔
      Nonempty (Path State Step source target) := by
  rw [invariant.nonemptyPath_iff_classify_eq]
  simp [decideConversion]

end CompleteInvariant

/-! ## Erasing conversion representations -/

/-- Proof-relevant conversion paths for an unindexed raw representation. -/
abbrev RawPath
    (RawState : Type uRawState)
    (RawStep : RawState → RawState → Type uRawStep)
    (source target : RawState) : Type (max uRawState uRawStep) :=
  Path (Index := Unit) (fun _ => RawState)
    (fun {_index : Unit} => RawStep) (index := ()) source target

/-- A representation map preserves primitive conversion evidence.  This is
only the sound direction: it does not assert that raw conversion reflects to
the source. -/
structure ConversionMap
    {Index : Type uIndex}
    (State : Index → Type uState)
    (Step : {index : Index} → State index → State index → Type uStep)
    (RawState : Type uRawState)
    (RawStep : RawState → RawState → Type uRawStep) where
  erase : {index : Index} → State index → RawState
  onStep : ∀ {index : Index} {source target : State index},
    Step source target → RawStep (erase source) (erase target)

namespace ConversionMap

/-- Every conversion map transports complete proof-relevant paths. -/
def mapPath
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {RawState : Type uRawState}
    {RawStep : RawState → RawState → Type uRawStep}
    (mapping : ConversionMap State Step RawState RawStep) :
    ∀ {index : Index} {source target : State index},
      Path State Step source target →
        RawPath RawState RawStep (mapping.erase source) (mapping.erase target)
  | _, _, _, .step evidence => .step (mapping.onStep evidence)
  | _, _, _, .refl state =>
      ConversionEvidence.refl
        (computation := computation (fun _ : Unit => RawState)
          (fun {_index : Unit} => RawStep))
        (mapping.erase state)
  | _, _, _, .symm path => .symm (mapping.mapPath path)
  | _, _, _, .trans first second =>
      .trans (mapping.mapPath first) (mapping.mapPath second)

/-- Reflection is the extra obligation required to use conversion after
erasure as a checker for the source conversion system. -/
def Reflects
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {RawState : Type uRawState}
    {RawStep : RawState → RawState → Type uRawStep}
    (mapping : ConversionMap State Step RawState RawStep) : Prop :=
  ∀ {index : Index} {source target : State index},
    Nonempty
        (RawPath RawState RawStep
          (mapping.erase source) (mapping.erase target)) →
      Nonempty (Path State Step source target)

/-- Every conversion map preserves mere path existence. -/
theorem preservesNonemptyPath
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {RawState : Type uRawState}
    {RawStep : RawState → RawState → Type uRawStep}
    (mapping : ConversionMap State Step RawState RawStep)
    {index : Index} {source target : State index} :
    Nonempty (Path State Step source target) →
      Nonempty
        (RawPath RawState RawStep
          (mapping.erase source) (mapping.erase target)) := by
  rintro ⟨path⟩
  exact ⟨mapping.mapPath path⟩

end ConversionMap

/-- A conversion erasure is exact when raw path existence also reflects to
the source conversion system. -/
structure ExactConversionErasure
    {Index : Type uIndex}
    (State : Index → Type uState)
    (Step : {index : Index} → State index → State index → Type uStep)
    (RawState : Type uRawState)
    (RawStep : RawState → RawState → Type uRawStep)
    extends ConversionMap State Step RawState RawStep where
  reflects : toConversionMap.Reflects

namespace ExactConversionErasure

/-- Exact erasure characterizes source conversion by raw conversion. -/
theorem nonemptyPath_iff_rawPath
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {RawState : Type uRawState}
    {RawStep : RawState → RawState → Type uRawStep}
    (erasure : ExactConversionErasure State Step RawState RawStep)
    {index : Index} {source target : State index} :
    Nonempty (Path State Step source target) ↔
      Nonempty
        (RawPath RawState RawStep
          (erasure.erase source) (erasure.erase target)) := by
  constructor
  · exact erasure.toConversionMap.preservesNonemptyPath
  · exact erasure.reflects

/-- A complete invariant for raw conversion pulls back through an exact
conversion erasure. -/
def pullbackInvariant
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {RawState : Type uRawState}
    {RawStep : RawState → RawState → Type uRawStep}
    {Code : Type uCode}
    (erasure : ExactConversionErasure State Step RawState RawStep)
    (rawInvariant : CompleteInvariant
      (fun _ : Unit => RawState) (fun {_index : Unit} => RawStep)
      (fun _ : Unit => Code)) :
    CompleteInvariant State Step (fun _ : Index => Code) where
  classify := fun _index state =>
    rawInvariant.classify () (erasure.erase state)
  generatorInvariant := fun evidence =>
    rawInvariant.generatorInvariant (index := ()) (erasure.onStep evidence)
  complete := fun equality =>
    erasure.reflects (rawInvariant.complete (index := ()) equality)

/-- The exact comparison square: source conversion, erased conversion, and
raw canonical classification recognize the same endpoint pairs. -/
theorem sourcePath_iff_rawClassify_eq
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {RawState : Type uRawState}
    {RawStep : RawState → RawState → Type uRawStep}
    {Code : Type uCode}
    (erasure : ExactConversionErasure State Step RawState RawStep)
    (rawInvariant : CompleteInvariant
      (fun _ : Unit => RawState) (fun {_index : Unit} => RawStep)
      (fun _ : Unit => Code))
    {index : Index} {source target : State index} :
    Nonempty (Path State Step source target) ↔
      rawInvariant.classify () (erasure.erase source) =
        rawInvariant.classify () (erasure.erase target) :=
  erasure.nonemptyPath_iff_rawPath.trans
    (rawInvariant.nonemptyPath_iff_classify_eq (index := ()))

/-- The Boolean decision performed on the erased representation is correct
for the source conversion system exactly because erasure reflects and the raw
classifier is complete. -/
theorem erasedDecision_eq_true_iff
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {RawState : Type uRawState}
    {RawStep : RawState → RawState → Type uRawStep}
    {Code : Type uCode}
    (erasure : ExactConversionErasure State Step RawState RawStep)
    (rawInvariant : CompleteInvariant
      (fun _ : Unit => RawState) (fun {_index : Unit} => RawStep)
      (fun _ : Unit => Code))
    [DecidableEq Code]
    {index : Index} {source target : State index} :
    rawInvariant.decideConversion ()
        (erasure.erase source) (erasure.erase target) = true ↔
      Nonempty (Path State Step source target) := by
  rw [rawInvariant.decideConversion_eq_true_iff (index := ())]
  exact erasure.nonemptyPath_iff_rawPath.symm

end ExactConversionErasure

/-! ## Proof relevance cannot be reconstructed from decision -/

/-- If two explicit paths differ, no function out of their propositional
shadow can be a left inverse for forgetting every path.  A decision procedure
may recover convertibility, but it cannot recover the original conversion
history. -/
theorem no_path_history_retraction
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {index : Index} {source target : State index}
    (first second : Path State Step source target)
    (different : first ≠ second) :
    ¬ ∃ recover : Nonempty (Path State Step source target) →
          Path State Step source target,
        ∀ path, recover ⟨path⟩ = path := by
  rintro ⟨recover, leftInverse⟩
  apply different
  have shadowsEqual :
      (⟨first⟩ : Nonempty (Path State Step source target)) = ⟨second⟩ :=
    Subsingleton.elim _ _
  calc
    first = recover ⟨first⟩ := (leftInverse first).symm
    _ = recover ⟨second⟩ := congrArg recover shadowsEqual
    _ = second := leftInverse second

/-- Structural certificate size.  This counts primitive, reflexive, symmetric,
and transitive constructors; it is a certificate observation, not an endpoint
property. -/
def pathConstructorCount
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {index : Index} {source target : State index} :
    Path State Step source target → Nat
  | .step _evidence => 1
  | .refl _state => 1
  | .symm path => pathConstructorCount path + 1
  | .trans first second =>
      pathConstructorCount first + pathConstructorCount second + 1

/-- Any path observation that distinguishes two histories fails to factor
through mere conversion.  In particular, endpoint decision cannot determine
certificate size or provenance. -/
theorem no_path_observer_factors_through_mere
    {Index : Type uIndex}
    {State : Index → Type uState}
    {Step : {index : Index} → State index → State index → Type uStep}
    {Observation : Type uCode}
    {index : Index} {source target : State index}
    (observe : Path State Step source target → Observation)
    (first second : Path State Step source target)
    (distinguished : observe first ≠ observe second) :
    ¬ ∃ observeMere : Nonempty (Path State Step source target) → Observation,
        ∀ path, observeMere ⟨path⟩ = observe path := by
  rintro ⟨observeMere, factorization⟩
  apply distinguished
  have shadowsEqual :
      (⟨first⟩ : Nonempty (Path State Step source target)) = ⟨second⟩ :=
    Subsingleton.elim _ _
  calc
    observe first = observeMere ⟨first⟩ := (factorization first).symm
    _ = observeMere ⟨second⟩ := congrArg observeMere shadowsEqual
    _ = observe second := factorization second

/-! ## Exact three-state comparison canary -/

namespace ExactCanary

inductive State where
  | alpha
  | beta
  | isolated
  deriving DecidableEq

inductive Step : State → State → Type where
  | bridge : Step .alpha .beta

abbrev IndexedState (_index : Unit) : Type := State
abbrev IndexedStep : {index : Unit} →
    IndexedState index → IndexedState index → Type :=
  fun {_index : Unit} => Step

abbrev SourcePath (source target : State) : Type :=
  Path IndexedState IndexedStep (index := ()) source target

def component : State → Bool
  | .alpha => false
  | .beta => false
  | .isolated => true

theorem pathOfSameComponent : ∀ source target : State,
    component source = component target →
      Nonempty (SourcePath source target)
  | .alpha, .alpha, _ =>
      ⟨ConversionEvidence.refl
        (computation := computation IndexedState IndexedStep) .alpha⟩
  | .alpha, .beta, _ => ⟨.step .bridge⟩
  | .alpha, .isolated, equality => by simp [component] at equality
  | .beta, .alpha, _ => ⟨.symm (.step .bridge)⟩
  | .beta, .beta, _ =>
      ⟨ConversionEvidence.refl
        (computation := computation IndexedState IndexedStep) .beta⟩
  | .beta, .isolated, equality => by simp [component] at equality
  | .isolated, .alpha, equality => by simp [component] at equality
  | .isolated, .beta, equality => by simp [component] at equality
  | .isolated, .isolated, _ =>
      ⟨ConversionEvidence.refl
        (computation := computation IndexedState IndexedStep) .isolated⟩

def sourceInvariant : CompleteInvariant IndexedState IndexedStep
    (fun _ : Unit => Bool) where
  classify := fun _index => component
  generatorInvariant := fun evidence => by cases evidence; rfl
  complete := fun {_index} {source} {target} =>
    pathOfSameComponent source target

abbrev EncodedState := Option Bool

inductive EncodedStep : EncodedState → EncodedState → Type where
  | bridge : EncodedStep none (some false)

def encode : State → EncodedState
  | .alpha => none
  | .beta => some false
  | .isolated => some true

def decode : EncodedState → State
  | none => .alpha
  | some false => .beta
  | some true => .isolated

@[simp] theorem decode_encode (state : State) : decode (encode state) = state := by
  cases state <;> rfl

@[simp] theorem encode_decode (state : EncodedState) : encode (decode state) = state := by
  cases state with
  | none => rfl
  | some value => cases value <;> rfl

def encodePath : ∀ {source target : State},
    SourcePath source target →
      RawPath EncodedState EncodedStep (encode source) (encode target)
  | _, _, .step evidence => by cases evidence; exact .step .bridge
  | _, _, .refl state =>
      ConversionEvidence.refl
        (computation := computation (fun _ : Unit => EncodedState)
          (fun {_index : Unit} => EncodedStep))
        (encode state)
  | _, _, .symm path => .symm (encodePath path)
  | _, _, .trans first second =>
      .trans (encodePath first) (encodePath second)

def decodePath : ∀ {source target : EncodedState},
    RawPath EncodedState EncodedStep source target →
      SourcePath (decode source) (decode target)
  | _, _, .step evidence => by cases evidence; exact .step .bridge
  | _, _, .refl state =>
      ConversionEvidence.refl
        (computation := computation IndexedState IndexedStep)
        (decode state)
  | _, _, .symm path => .symm (decodePath path)
  | _, _, .trans first second =>
      .trans (decodePath first) (decodePath second)

def encodedInvariant : CompleteInvariant
    (fun _ : Unit => EncodedState)
    (fun {_index : Unit} => EncodedStep)
    (fun _ : Unit => Bool) where
  classify := fun _index state => component (decode state)
  generatorInvariant := fun evidence => by cases evidence; rfl
  complete := fun {_index} {source} {target} equality => by
    rcases pathOfSameComponent (decode source) (decode target) equality with
      ⟨path⟩
    exact ⟨by simpa using encodePath path⟩

def encodingMap : ConversionMap IndexedState IndexedStep
    EncodedState EncodedStep where
  erase := encode
  onStep := fun evidence => by cases evidence; exact .bridge

def exactEncoding : ExactConversionErasure IndexedState IndexedStep
    EncodedState EncodedStep where
  toConversionMap := encodingMap
  reflects := by
    intro _index source target rawConversion
    rcases rawConversion with ⟨path⟩
    exact ⟨by simpa [encodingMap] using decodePath path⟩

def directBridge : SourcePath .alpha .beta := .step .bridge

def paddedBridge : SourcePath .alpha .beta :=
  .trans
    (ConversionEvidence.refl
      (computation := computation IndexedState IndexedStep) .alpha)
    directBridge

theorem directBridge_ne_paddedBridge : directBridge ≠ paddedBridge := by
  intro equality
  cases equality

theorem directBridge_constructorCount :
    pathConstructorCount directBridge = 1 := rfl

theorem paddedBridge_constructorCount :
    pathConstructorCount paddedBridge = 3 := rfl

/-- Equal endpoints and equal conversion decisions do not determine the
amount of explicit certificate work. -/
theorem bridge_constructor_count_not_endpoint_determined :
    ¬ ∃ account : Nonempty (SourcePath .alpha .beta) → Nat,
        ∀ path, account ⟨path⟩ = pathConstructorCount path :=
  no_path_observer_factors_through_mere
    pathConstructorCount directBridge paddedBridge (by decide)

/-- Positive control: a genuinely generated conversion is accepted by the
source path, encoded path, complete invariant, and Boolean decision faces. -/
theorem bridge_four_faces :
    Nonempty (SourcePath .alpha .beta) ∧
      Nonempty
        (RawPath EncodedState EncodedStep (encode .alpha) (encode .beta)) ∧
      encodedInvariant.classify () (encode .alpha) =
        encodedInvariant.classify () (encode .beta) ∧
      encodedInvariant.decideConversion () (encode .alpha) (encode .beta) = true :=
  ⟨⟨directBridge⟩, ⟨.step .bridge⟩, rfl, rfl⟩

/-- Negative control: the isolated component is rejected by all extensional
faces. -/
theorem isolated_four_faces :
    ¬ Nonempty (SourcePath .alpha .isolated) ∧
      ¬ Nonempty
        (RawPath EncodedState EncodedStep
          (encode .alpha) (encode .isolated)) ∧
      encodedInvariant.classify () (encode .alpha) ≠
        encodedInvariant.classify () (encode .isolated) ∧
      encodedInvariant.decideConversion ()
        (encode .alpha) (encode .isolated) = false := by
  have sourceRejected : ¬ Nonempty (SourcePath .alpha .isolated) := by
    rintro ⟨path⟩
    have equality := sourceInvariant.pathInvariant path
    change false = true at equality
    exact Bool.noConfusion equality
  have encodedRejected :
      ¬ Nonempty
        (RawPath EncodedState EncodedStep
          (encode .alpha) (encode .isolated)) := by
    intro rawPath
    exact sourceRejected (exactEncoding.reflects rawPath)
  exact ⟨sourceRejected, encodedRejected, by decide, rfl⟩

/-- Even when every extensional face agrees, the propositional shadow cannot
recover which explicit bridge history was supplied. -/
theorem bridge_history_not_recoverable :
    ¬ ∃ recover : Nonempty (SourcePath .alpha .beta) →
          SourcePath .alpha .beta,
        ∀ path, recover ⟨path⟩ = path :=
  no_path_history_retraction directBridge paddedBridge
    directBridge_ne_paddedBridge

end ExactCanary

/-! ## Unsafe erasure canary -/

namespace UnsafeErasureCanary

abbrev IndexedState (_index : Unit) : Type := Bool
abbrev IndexedStep : {index : Unit} →
    IndexedState index → IndexedState index → Type :=
  fun {_index : Unit} _source _target => PEmpty

abbrev SourcePath (source target : Bool) : Type :=
  Path IndexedState IndexedStep (index := ()) source target

abbrev ErasedState := Unit
abbrev ErasedStep : ErasedState → ErasedState → Type :=
  fun _source _target => PEmpty

/-- Both disconnected source states are represented by the same raw state. -/
def collapsingMap : ConversionMap IndexedState IndexedStep
    ErasedState ErasedStep where
  erase := fun _state => ()
  onStep := fun evidence => nomatch evidence

def endpointEqualityAlgebra :
    Algebra IndexedState IndexedStep
      (fun {_index : Unit} source target => PLift (source = target)) where
  onStep := fun evidence => nomatch evidence
  onRefl := fun _state => ⟨rfl⟩
  onSymm := fun equality => ⟨equality.down.symm⟩
  onTrans := fun first second => ⟨first.down.trans second.down⟩

def pathEndpointEquality {source target : Bool} :
    SourcePath source target → source = target :=
  fun path => (endpointEqualityAlgebra.fold path).down

def erasedReflexivity :
    RawPath ErasedState ErasedStep () () :=
  ConversionEvidence.refl
    (computation := computation (fun _ : Unit => ErasedState)
      (fun {_index : Unit} => ErasedStep)) ()

/-- Preserving primitive steps is insufficient: after a non-injective
erasure, raw reflexivity would falsely identify two disconnected source
states. -/
theorem collapsingMap_not_reflecting : ¬ collapsingMap.Reflects := by
  intro reflects
  have falseToTrue : Nonempty (SourcePath false true) :=
    reflects ⟨erasedReflexivity⟩
  rcases falseToTrue with ⟨path⟩
  exact Bool.noConfusion (pathEndpointEquality path)

end UnsafeErasureCanary

