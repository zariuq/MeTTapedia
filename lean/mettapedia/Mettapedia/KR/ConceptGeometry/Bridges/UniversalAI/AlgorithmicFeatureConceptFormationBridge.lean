import Mettapedia.KR.ConceptGeometry.Bridges.UniversalAI.AlgorithmicFeatureInheritanceBridge

/-!
# Algorithmic features as formed concepts

An executable feature determines more than an arbitrary extent/intent pair.
For a fixed conditional algorithm, let a source be incident with a feature
when the feature strictly compresses and reconstructs that source.  Then:

* the feature's extent is its set of incident sources;
* the feature's intent is its theory of strict algorithmic consequences; and
* these two sets are mutual formal-concept polars.

Thus every algorithmic feature denotes a genuine (possibly infinite) formal
concept for the feature-incidence relation.  Order between the resulting
formal concepts is exactly strict feature implication.  This supplies a
concept-formation semantics without turning learned compression scores into
proof or PLN evidence.
-/

namespace Mettapedia.KR.ConceptGeometry.Bridges.UniversalAI.AlgorithmicFeatureConceptFormation

open KolmogorovComplexity
open Mettapedia.KR.ConceptGeometry.AbstractInheritance
open Mettapedia.KR.ConceptGeometry.Bridges.UniversalAI.AlgorithmicFeatureInheritance
open Mettapedia.Logic.WorldModel.Algorithmic
open Mettapedia.Logic.WorldModel.FeatureContainment

/-- Incidence between a source and an executable strict feature. -/
def featureRelation (U : ConditionalAlgorithm) (source feature : BinString) : Prop :=
  StrictFeatureOf U feature source

@[simp]
theorem featureRelation_iff
    (U : ConditionalAlgorithm) (source feature : BinString) :
    featureRelation U source feature ↔ StrictFeatureOf U feature source :=
  Iff.rfl

/-- The common features of a feature's instances are exactly its strict
algorithmic consequences. -/
theorem upperPolar_featureConcept_extent
    (U : ConditionalAlgorithm) (feature : BinString) :
    _root_.upperPolar (featureRelation U) (featureConcept U feature).extent =
      (featureConcept U feature).intent := by
  ext consequent
  constructor
  · intro common certificate source realizesFeature
    exact common ⟨certificate, realizesFeature⟩
  · intro implication source featureOfSource
    obtain ⟨certificate, realizesFeature⟩ := featureOfSource
    exact implication certificate source realizesFeature

/-- The sources satisfying every strict consequence of a feature are exactly
the sources satisfying the feature itself.  Reflexivity of implication is the
key reverse inclusion. -/
theorem lowerPolar_featureConcept_intent
    (U : ConditionalAlgorithm) (feature : BinString) :
    _root_.lowerPolar (featureRelation U) (featureConcept U feature).intent =
      (featureConcept U feature).extent := by
  ext source
  constructor
  · intro satisfiesTheory
    exact satisfiesTheory (strictFeatureImplication_refl U feature)
  · intro featureOfSource consequent implication
    obtain ⟨certificate, realizesFeature⟩ := featureOfSource
    exact implication certificate source realizesFeature

/-- Every executable feature concept is closed under the feature-incidence
Galois connection. -/
theorem featureConcept_isClosed
    (U : ConditionalAlgorithm) (feature : BinString) :
    DualConcept.IsClosed (featureRelation U) (featureConcept U feature) :=
  ⟨upperPolar_featureConcept_extent U feature,
    lowerPolar_featureConcept_intent U feature⟩

/-- The formal concept generated by an executable feature.  The carrier is not
assumed finite: open-ended source and feature spaces remain available. -/
def featureFormalConcept
    (U : ConditionalAlgorithm) (feature : BinString) :
    _root_.Concept BinString BinString (featureRelation U) :=
  DualConcept.toConcept (featureConcept U feature)
    (featureConcept_isClosed U feature)

@[simp]
theorem featureFormalConcept_extent
    (U : ConditionalAlgorithm) (feature : BinString) :
    (featureFormalConcept U feature).extent =
      (featureConcept U feature).extent :=
  rfl

@[simp]
theorem featureFormalConcept_intent
    (U : ConditionalAlgorithm) (feature : BinString) :
    (featureFormalConcept U feature).intent =
      (featureConcept U feature).intent :=
  rfl

/-- Formal-concept order is exactly strict algorithmic implication. -/
theorem featureFormalConcept_le_iff_strictFeatureImplication
    (U : ConditionalAlgorithm) (premise consequent : BinString) :
    featureFormalConcept U premise ≤ featureFormalConcept U consequent ↔
      StrictFeatureImplication U premise consequent := by
  rw [← inherits_iff_strictFeatureImplication]
  exact DualConcept.toConcept_inherits_iff
    (featureConcept U premise) (featureConcept U consequent)
    (featureConcept_isClosed U premise) (featureConcept_isClosed U consequent)

/-! ## Positive and negative controls -/

/-- The finite compression witness inhabits the extent of the corresponding
formed concept. -/
theorem finiteCompressionSource_mem_featureFormalConcept_extent :
    fourTrue ∈
      (featureFormalConcept finiteCompressionAlgorithm
        finiteCompressionStep.featureProgram).extent :=
  finiteCompressionStep_strictFeature

/-- The witnessed finite feature is below itself in formal-concept order. -/
theorem finiteCompressionFeature_formalConcept_le_self :
    featureFormalConcept finiteCompressionAlgorithm
        finiteCompressionStep.featureProgram ≤
      featureFormalConcept finiteCompressionAlgorithm
        finiteCompressionStep.featureProgram :=
  le_rfl

/-- Image inclusion without strict compression does not promote to order in
the formed-concept lattice. -/
theorem imageInclusion_does_not_imply_featureFormalConceptOrder :
    ImageIncluded imageCompressionAlgorithm [false] fourTrue ∧
      ¬ featureFormalConcept imageCompressionAlgorithm [false] ≤
        featureFormalConcept imageCompressionAlgorithm fourTrue := by
  refine ⟨shortImage_included_in_longImage, ?_⟩
  rw [featureFormalConcept_le_iff_strictFeatureImplication]
  exact imageInclusion_does_not_imply_strictFeatureImplication.2.2

