/-!
# Native type theory generated by the graph-walk LanguageDef

The native walk judgment combines two constructions from the authored
LanguageDef:

* its grammar-derived `Walk` predicate; and
* the pullback, along the authored `ReverseRequest : Walk → State`
  constructor, of finite-path possibility for the actual rewrite relation.

The target predicate is purely syntactic: a successful state must be a
`WalkDone` value whose endpoints are reversed.  Mathlib's dependent
`SimpleGraph.Walk` family appears only in adequacy theorems and is not hidden
inside the definition of the native type.
-/

namespace Mettapedia.GraphTheory.Walk.NativeTypeTheory

open Mettapedia.GSLT
open Mettapedia.GSLT.LanguageDef.CarrierWellSorted
open Mettapedia.GSLT.LanguageDef.WellSorted
open Mettapedia.GraphTheory.Walk.LanguageDef
open Mettapedia.GraphTheory.Walk.Operational
open Mettapedia.OSLF.Framework
open Mettapedia.OSLF.Framework.ConstructorCategory
open Mettapedia.OSLF.Framework.ConstructorFibration
open Mettapedia.OSLF.Framework.PathTypeSynthesis
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis
open Mettapedia.OSLF.Framework.TypeSynthesis
open Mettapedia.OSLF.MeTTaIL.NonrecursiveReduction
open Mettapedia.OSLF.MeTTaIL.Syntax
open SimpleGraph

set_option autoImplicit false

/-! ## Source-derived structural and constructor data -/

/-- The walk program has no recursive congruence premises.  Relation guards
remain fully active; this theorem says only that one positive contextual layer
executes every authored row exactly. -/
theorem language_nonrecursive : LanguageDefNonrecursive language := by
  intro rule membership premise premiseMembership
  simp only [language_rewrites, rewrites, List.mem_cons, List.mem_nil_iff,
    or_false] at membership
  rcases membership with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl <;>
    simp_all [PremiseNonrecursive,
      appendStartRule, appendScanConsRule, appendScanNilRule,
      appendRebuildConsRule, appendRebuildNilRule,
      reverseStartRule, reverseScanConsRule, reverseScanNilRule,
      mapStartRule, mapScanConsRule, mapScanNilRule,
      mapRebuildConsRule, mapRebuildNilRule,
      sourceAdjacent, targetAdjacent, mapVertex]
  rcases premiseMembership with rfl | rfl | rfl <;>
    simp

/-- The least walk reduction relation is exactly one execution of the authored
row table. -/
theorem step_iff_mem_rewriteOnce {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) (before after : Pattern) :
    (theory source target hom).Step before after ↔
      after ∈ rewriteOnce source target hom before := by
  change
    Mettapedia.GSLT.LanguageDef.EquationSemantics.StepModuloEquations
      (Mettapedia.OSLF.MeTTaIL.ContextualStep.engineBasePremises
        (relationEnv source target hom)) language before after ↔ _
  rw [Mettapedia.GSLT.LanguageDef.EquationSemantics.stepModuloEquations_iff_step_of_no_generators
    (free := rfl)]
  exact step_iff_mem_rewriteAt_one
    (Mettapedia.OSLF.MeTTaIL.ContextualStep.engineBasePremises
      (relationEnv source target hom)) language language_nonrecursive before after

def walkSort : LangSort language := ⟨"Walk", by decide⟩

def stateSort : LangSort language := ⟨"State", by decide⟩

def walkObject : ConstructorObj language := ⟨walkSort⟩

def stateObject : ConstructorObj language := ⟨stateSort⟩

theorem reverseRequest_crossing :
    ("ReverseRequest", "Walk", "State") ∈ unaryCrossings language := by
  decide +kernel

/-- The actual source-declared constructor arrow used to reindex the state
acceptance predicate back into the walk fiber. -/
def reverseRequestArrow : SortArrow language walkSort stateSort :=
  ⟨"ReverseRequest", reverseRequest_crossing⟩

def reverseRequestMorphism : walkObject ⟶ stateObject :=
  reverseRequestArrow.toPath

@[simp] theorem reverseRequest_pathSem (term : Pattern) :
    pathSem language reverseRequestMorphism term =
      .apply "ReverseRequest" [term] := rfl

/-! ## The generated native walk predicate -/

/-- Declarative membership in the authored `Walk` sort. -/
def grammarHasType (term : Pattern) : Prop :=
  Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType
    language FreeTypeContext.empty [] term (.base "Walk")

/-- Executable grammar membership generated from the complete authored
constructor table.  Unlike an ad-hoc recognizer, this is the generic
`CarrierWellSorted` checker instantiated only with `language`. -/
def grammarWalk (term : Pattern) : Prop :=
  Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType
    language FreeTypeContext.empty [] term (.base "Walk") = true

/-- A syntax-only terminal predicate indexed by the desired reversed
endpoints.  It does not mention Mathlib walks. -/
def walkDoneAt {n : Nat} (source target : Fin n) (term : Pattern) : Prop :=
  ∃ node, term = .apply "WalkDone"
    [.apply "WalkValue" [finPattern source, finPattern target, node]]

/-- The endpoint-indexed fiber of the authored `WalkValue` constructor.  The
index is carried by syntax, not by a host-language walk predicate. -/
def walkValueAt {n : Nat} (source target : Fin n) (term : Pattern) : Prop :=
  ∃ node, term = .apply "WalkValue"
    [finPattern source, finPattern target, node]

/-- Finite-path acceptance in the state fiber, generated from the actual
walk GSLT. -/
def reverseAcceptance {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) (start finish : Fin n) : Pattern → Prop :=
  let walkTheory := theory source target hom
  pathDiamond walkTheory
    (saturatePredicate (pathGSLT walkTheory) (walkDoneAt finish start))

/-- Pull the state acceptance predicate back along the source-declared
`ReverseRequest : Walk → State` constructor. -/
def reverseAcceptanceOnWalks {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) (start finish : Fin n) : Pattern → Prop :=
  constructorPullback language reverseRequestMorphism
    (reverseAcceptance source target hom start finish)

/-- Authored generator for the native walk predicate.  The generated OSLF
admits it through closure under equations; the walk language's empty equation
presentation makes that saturation extensionally exact. -/
def nativeWalkGenerator {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) (start finish : Fin n) : Pattern → Prop :=
  fun term => grammarWalk term ∧ walkValueAt start finish term ∧
    reverseAcceptanceOnWalks source target hom start finish term

/-- The native type of walks from `start` to `finish`.  Sorting comes from the
authored constructor signature, its index is the corresponding constructor
fiber, and adjacency comes from successful execution of the authored reversal
machine. -/
def nativeWalkType {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) (start finish : Fin n) :
    Mettapedia.OSLF.Framework.TypeSynthesis.langNativeTypeUsing
      (relationEnv source target hom) language "State" where
  sort := "Walk"
  pred := saturatePredicate
    (langGSLTUsing (relationEnv source target hom) language)
    (nativeWalkGenerator source target hom start finish)

/-- Inhabitation notation for the generated native walk type. -/
def NativeWalk {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) (start finish : Fin n)
    (term : Pattern) : Prop :=
  (Mettapedia.OSLF.Framework.TypeSynthesis.langOSLFUsing
      (relationEnv source target hom) language "State").satisfies term
    (nativeWalkType source target hom start finish).pred

theorem nativeWalk_iff {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) (start finish : Fin n) (term : Pattern) :
    NativeWalk source target hom start finish term ↔
      grammarWalk term ∧
      walkValueAt start finish term ∧
      ∃ result, Nonempty ((theory source target hom).RewritePath
          (.apply "ReverseRequest" [term]) result) ∧
        walkDoneAt finish start result := by
  change saturatePredicate
      (langGSLTUsing (relationEnv source target hom) language)
      (nativeWalkGenerator source target hom start finish) term ↔ _
  rw [saturatePredicate_langGSLTUsing_apply_iff_of_equation_free
    (relationEnv source target hom) rfl]
  change grammarWalk term ∧ walkValueAt start finish term ∧
      pathDiamond (theory source target hom)
        (saturatePredicate (pathGSLT (theory source target hom))
          (walkDoneAt finish start))
        (.apply "ReverseRequest" [term]) ↔ _
  have pathEquivIffEq : ∀ left right,
      (pathGSLT (theory source target hom)).Equiv left right ↔
        left = right := fun left right =>
    (pathGSLT_equiv (theory source target hom) left right).trans
      (theory_equiv_iff_eq source target hom left right)
  constructor
  · rintro ⟨grammar, indexed, accepts⟩
    obtain ⟨result, semanticPath, terminal⟩ :=
      (pathDiamond_spec _ _ _).1 accepts
    exact ⟨grammar, indexed, result,
      (nonempty_semanticPath_iff_rewritePath_of_equiv_iff_eq
        (theory source target hom)
        (theory_equiv_iff_eq source target hom) _ _).1 semanticPath,
      (saturatePredicate_apply_iff_of_equiv_iff_eq
        (pathGSLT (theory source target hom)) pathEquivIffEq
        (walkDoneAt finish start) result).1 terminal⟩
  · rintro ⟨grammar, indexed, accepts⟩
    obtain ⟨result, concretePath, terminal⟩ := accepts
    refine ⟨grammar, indexed, (pathDiamond_spec _ _ _).2
      ⟨result, ?_, ?_⟩⟩
    · exact (nonempty_semanticPath_iff_rewritePath_of_equiv_iff_eq
        (theory source target hom)
        (theory_equiv_iff_eq source target hom) _ _).2 concretePath
    · exact (saturatePredicate_apply_iff_of_equiv_iff_eq
        (pathGSLT (theory source target hom)) pathEquivIffEq
        (walkDoneAt finish start) result).2 terminal

/-! ## Canonical Mathlib walks inhabit the generated native type -/

theorem vertexPattern_typed (vertex : Nat) :
    Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType
      language FreeTypeContext.empty [] (vertexPattern vertex)
        (.base "Vertex") := by
  induction vertex with
  | zero =>
      apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType.constructor
        (rule := constructor "VertexZero" "Vertex" [])
      · simp [language, terms, LanguageDef.ofCore]
      · simp [Mettapedia.GSLT.LanguageDef.WellSorted.UsesBareCollection,
          constructor]
      · exact Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.nil
  | succ vertex inductionHypothesis =>
      apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType.constructor
        (rule := constructor "VertexSucc" "Vertex"
          [parameter "vertex" "Vertex"])
      · simp [language, terms, LanguageDef.ofCore]
      · simp [Mettapedia.GSLT.LanguageDef.WellSorted.UsesBareCollection,
          constructor, parameter]
      · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
        · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
            parameter]
        · rfl
        · exact inductionHypothesis
        · exact Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.nil

/-- Canonical walk values and their recursive nodes are both typed solely by
the authored constructor inventory. -/
theorem walkPattern_and_node_typed {n : Nat}
    {graph : SimpleGraph (Fin n)} {start finish : Fin n}
    (walk : graph.Walk start finish) :
    grammarHasType (walkPattern walk) ∧
      Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType
        language FreeTypeContext.empty [] (walkNodePattern walk)
          (.base "WalkNode") := by
  induction walk with
  | @nil vertex =>
      simp only [walkPattern, walkNodePattern]
      have vertexTyped := vertexPattern_typed vertex.val
      have nodeTyped :
          Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType
            language FreeTypeContext.empty []
              (.apply "WalkNil" [finPattern vertex]) (.base "WalkNode") := by
        apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType.constructor
          (rule := constructor "WalkNil" "WalkNode"
            [parameter "vertex" "Vertex"])
        · simp [language, terms, LanguageDef.ofCore]
        · simp [Mettapedia.GSLT.LanguageDef.WellSorted.UsesBareCollection,
            constructor, parameter]
        · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
          · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
              parameter]
          · rfl
          · exact vertexTyped
          · exact Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.nil
      constructor
      · unfold grammarHasType
        apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType.constructor
          (rule := constructor "WalkValue" "Walk"
            [parameter "source" "Vertex", parameter "target" "Vertex",
              parameter "node" "WalkNode"])
        · simp [language, terms, LanguageDef.ofCore]
        · simp [Mettapedia.GSLT.LanguageDef.WellSorted.UsesBareCollection,
            constructor, parameter]
        · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
          · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
              parameter]
          · rfl
          · exact vertexTyped
          · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
            · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
                parameter]
            · rfl
            · exact vertexTyped
            · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
              · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
                  parameter]
              · rfl
              · exact nodeTyped
              · exact Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.nil
      · exact nodeTyped
  | @cons start next finish edge tail inductionHypothesis =>
      simp only [walkPattern, walkNodePattern]
      have startTyped := vertexPattern_typed start.val
      have nextTyped := vertexPattern_typed next.val
      have finishTyped := vertexPattern_typed finish.val
      have tailWalkTyped := inductionHypothesis.1
      simp only [walkPattern] at tailWalkTyped
      have nodeTyped :
          Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType
            language FreeTypeContext.empty []
              (.apply "WalkCons"
                [finPattern start, finPattern next, finPattern finish,
                  .apply "WalkValue"
                    [finPattern next, finPattern finish,
                      walkNodePattern tail]]) (.base "WalkNode") := by
        apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType.constructor
          (rule := constructor "WalkCons" "WalkNode"
            [parameter "source" "Vertex", parameter "next" "Vertex",
              parameter "target" "Vertex", parameter "tail" "Walk"])
        · simp [language, terms, LanguageDef.ofCore]
        · simp [Mettapedia.GSLT.LanguageDef.WellSorted.UsesBareCollection,
            constructor, parameter]
        · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
          · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
              parameter]
          · rfl
          · exact startTyped
          · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
            · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
                parameter]
            · rfl
            · exact nextTyped
            · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
              · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
                  parameter]
              · rfl
              · exact finishTyped
              · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
                · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
                    parameter]
                · rfl
                · exact tailWalkTyped
                · exact Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.nil
      constructor
      · unfold grammarHasType
        apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.HasType.constructor
          (rule := constructor "WalkValue" "Walk"
            [parameter "source" "Vertex", parameter "target" "Vertex",
              parameter "node" "WalkNode"])
        · simp [language, terms, LanguageDef.ofCore]
        · simp [Mettapedia.GSLT.LanguageDef.WellSorted.UsesBareCollection,
            constructor, parameter]
        · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
          · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
              parameter]
          · rfl
          · exact startTyped
          · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
            · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
                parameter]
            · rfl
            · exact finishTyped
            · apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.cons
              · simp [Mettapedia.GSLT.LanguageDef.WellSorted.MatchesParameterRepresentation,
                  parameter]
              · rfl
              · exact nodeTyped
              · exact Mettapedia.GSLT.LanguageDef.CarrierWellSorted.ArgumentsHaveTypes.nil
      · exact nodeTyped

theorem vertexPattern_object (vertex : Nat) :
    isObjectPattern (vertexPattern vertex) = true := by
  induction vertex with
  | zero => rfl
  | succ vertex inductionHypothesis =>
      simp [vertexPattern, isObjectPattern, isObjectPatternList,
        inductionHypothesis]

/-- The executable generic checker recognizes every canonical unary vertex
encoding from the authored `VertexZero`/`VertexSucc` constructors. -/
theorem vertexPattern_checked (vertex : Nat) :
    Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType
      language FreeTypeContext.empty [] (vertexPattern vertex)
        (.base "Vertex") = true := by
  apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType_complete_of_object
    (vertexPattern_typed vertex)
  exact vertexPattern_object vertex

/-- Inverting the generated `WalkValue` check recovers the recursively checked
node argument.  This is a compiler theorem for the authored constructor row,
not a separately maintained graph recognizer. -/
theorem grammarWalk_node_checked {n : Nat}
    (start finish : Fin n) (node : Pattern)
    (checked : grammarWalk (.apply "WalkValue"
      [finPattern start, finPattern finish, node])) :
    Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType
      language FreeTypeContext.empty [] node (.base "WalkNode") = true := by
  unfold grammarWalk at checked
  simp only [
    Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType,
    Bool.or_eq_true, Bool.and_eq_true, List.isEmpty_cons,
    Bool.false_and, List.any_eq_true, beq_iff_eq,
    Bool.not_eq_true'] at checked
  rcases checked with impossible | ⟨rule, ruleMember, checks⟩
  · contradiction
  simp only [language, terms, LanguageDef.ofCore, List.mem_cons,
    List.mem_nil_iff, or_false] at ruleMember
  rcases ruleMember with
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals try {simp_all [constructor, parameter]}
  case inr.inr.inr.inr.inr.inl =>
    have argumentChecks := checks.2
    simp [constructor, parameter,
      Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkArgumentsHaveTypes,
      parameterType?, matchesParameterRepresentation?] at argumentChecks
    exact argumentChecks.2.2

/-- The generated checker admits exactly the two authored outer forms of a
walk node.  Recursive endpoint and adjacency coherence are deliberately left
to the GSLT execution component of `NativeWalk`. -/
theorem checkedWalkNode_outer_shape (node : Pattern)
    (checked :
      Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType
        language FreeTypeContext.empty [] node (.base "WalkNode") = true) :
    (∃ vertex, node = .apply "WalkNil" [vertex]) ∨
      ∃ source next target tail,
        node = .apply "WalkCons" [source, next, target, tail] := by
  cases node with
  | bvar index =>
      simp [Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType]
        at checked
  | fvar name =>
      simp [Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType,
        FreeTypeContext.empty] at checked
  | lambda binder body =>
      simp [Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType]
        at checked
  | multiLambda arity binders body =>
      simp [Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType]
        at checked
  | subst body replacement =>
      simp [Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType]
        at checked
  | collection collectionType elements rest =>
      simp [Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType,
        language, terms, types, LanguageDef.ofCore,
        bareCollectionElementType?, constructor, parameter] at checked
  | apply label arguments =>
      unfold Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType
        at checked
      simp only [Bool.or_eq_true, Bool.and_eq_true, List.any_eq_true,
        beq_iff_eq, Bool.not_eq_true'] at checked
      rcases checked with builtin | ⟨rule, ruleMember, conditions⟩
      · simp [
          Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkBuiltinAtomHasType,
          Mettapedia.GSLT.LanguageDef.CarrierWellSorted.carrierAcceptsAtom,
          language, types, LanguageDef.ofCore, TypeDecl.plain] at builtin
      · simp only [language, terms, LanguageDef.ofCore, List.mem_cons,
          List.mem_nil_iff, or_false] at ruleMember
        rcases ruleMember with
          rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
          rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
          rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
        all_goals try {simp_all [constructor, parameter]}
        · have lengthEquality :=
            Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkArgumentsHaveTypes_length_eq
                language FreeTypeContext.empty [] arguments
                  [parameter "vertex" "Vertex"] conditions.2
          obtain ⟨vertex, rfl⟩ :=
            List.length_eq_one_iff.mp lengthEquality
          exact Or.inl ⟨vertex,
            congrArg (fun name => Pattern.apply name [vertex])
              (by simpa [constructor] using conditions.1.1.1.symm)⟩
        · have lengthEquality :=
            Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkArgumentsHaveTypes_length_eq
                language FreeTypeContext.empty [] arguments
                  [parameter "source" "Vertex", parameter "next" "Vertex",
                    parameter "target" "Vertex",
                    parameter "tail" "Walk"] conditions.2
          rcases arguments with _ | ⟨source, arguments⟩
          · simp at lengthEquality
          rcases arguments with _ | ⟨next, arguments⟩
          · simp at lengthEquality
          rcases arguments with _ | ⟨target, arguments⟩
          · simp at lengthEquality
          rcases arguments with _ | ⟨tail, arguments⟩
          · simp at lengthEquality
          cases arguments with
          | nil =>
              exact Or.inr ⟨source, next, target, tail,
                congrArg
                  (fun name =>
                    Pattern.apply name [source, next, target, tail])
                  (by simpa [constructor] using
                    conditions.1.1.1.symm)⟩
          | cons extra rest => simp at lengthEquality

theorem walkPattern_and_node_object {n : Nat}
    {graph : SimpleGraph (Fin n)} {start finish : Fin n}
    (walk : graph.Walk start finish) :
    isObjectPattern (walkPattern walk) = true ∧
      isObjectPattern (walkNodePattern walk) = true := by
  induction walk with
  | nil =>
      simp [walkPattern, walkNodePattern, finPattern,
        isObjectPattern, isObjectPatternList, vertexPattern_object]
  | cons edge tail inductionHypothesis =>
      simp [walkPattern, walkNodePattern, finPattern,
        isObjectPattern, isObjectPatternList, vertexPattern_object,
        inductionHypothesis]

theorem walkPattern_grammarWalk {n : Nat} {graph : SimpleGraph (Fin n)}
    {start finish : Fin n} (walk : graph.Walk start finish) :
    grammarWalk (walkPattern walk) := by
  apply Mettapedia.GSLT.LanguageDef.CarrierWellSorted.checkHasType_complete_of_object
    (walkPattern_and_node_typed walk).1
  exact (walkPattern_and_node_object walk).1

/-- The canonical walk encoding retains the complete proof object.  In
particular, distinct Mathlib walks cannot collapse to the same native term. -/
theorem walkPattern_injective {n : Nat} {graph : SimpleGraph (Fin n)}
    {start finish : Fin n} :
    Function.Injective (@walkPattern n graph start finish) := by
  intro left
  induction left with
  | nil =>
      intro right equality
      cases right with
      | nil => rfl
      | cons edge tail => simp [walkPattern, walkNodePattern] at equality
  | @cons start next finish edge tail inductionHypothesis =>
      intro right equality
      cases right with
      | nil => simp [walkPattern, walkNodePattern] at equality
      | @cons _ next' _ edge' tail' =>
          simp only [walkPattern, walkNodePattern, Pattern.apply.injEq,
            List.cons.injEq] at equality
          have nextPatternEquality : finPattern next = finPattern next' := by
            aesop
          have nodeEquality :
              walkNodePattern tail = walkNodePattern tail' := by
            aesop
          have nextEquality : next = next' :=
            finPattern_injective nextPatternEquality
          subst next'
          have tailPatternEquality : walkPattern tail = walkPattern tail' := by
            simp [walkPattern, nodeEquality]
          have tailEquality : tail = tail' :=
            inductionHypothesis tailPatternEquality
          subst tail'
          rfl

/-- Completeness of the generated judgment: every Mathlib walk supplies both
its grammar evidence and its exact GSLT execution witness. -/
theorem walkPattern_inhabits_nativeWalk {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) {start finish : Fin n}
    (walk : source.Walk start finish) :
    NativeWalk source target hom start finish (walkPattern walk) := by
  apply (nativeWalk_iff source target hom start finish (walkPattern walk)).2
  refine ⟨walkPattern_grammarWalk walk,
    ⟨walkNodePattern walk, by simp [walkPattern]⟩,
    donePattern walk.reverse,
    ⟨reversePath source target hom walk⟩, ?_⟩
  exact ⟨walkNodePattern walk.reverse, by simp [donePattern, walkPattern]⟩

/-! ## Exact-work behavioral native judgments -/

theorem append_inhabits_exact_work_type {n m : Nat}
    (graph : SimpleGraph (Fin n)) (other : SimpleGraph (Fin m))
    [DecidableRel graph.Adj] [DecidableRel other.Adj]
    (hom : graph →g other) {start middle finish : Fin n}
    (left : graph.Walk start middle) (right : graph.Walk middle finish) :
    gradedPathDiamond (theory graph other hom) (2 * left.length + 3)
      (saturatePredicate
        (gradedPathGSLT (theory graph other hom) (2 * left.length + 3))
        (fun candidate => candidate = donePattern (left.append right)))
      (appendRequestPattern left right) := by
  apply (gradedPathDiamond_spec _ _ _ _).2
  refine ⟨donePattern (left.append right), ⟨
    GradedSemanticPath.ofRewritePath (appendPath graph other hom left right)
      (appendPath_length graph other hom left right)⟩, ?_⟩
  exact ⟨donePattern (left.append right),
    (gradedPathGSLT (theory graph other hom)
      (2 * left.length + 3)).equations.iseqv.refl _, rfl⟩

theorem reverse_inhabits_exact_work_type {n m : Nat}
    (graph : SimpleGraph (Fin n)) (other : SimpleGraph (Fin m))
    [DecidableRel graph.Adj] [DecidableRel other.Adj]
    (hom : graph →g other) {start finish : Fin n}
    (walk : graph.Walk start finish) :
    gradedPathDiamond (theory graph other hom) (walk.length + 2)
      (saturatePredicate
        (gradedPathGSLT (theory graph other hom) (walk.length + 2))
        (fun candidate => candidate = donePattern walk.reverse))
      (reverseRequestPattern walk) := by
  apply (gradedPathDiamond_spec _ _ _ _).2
  refine ⟨donePattern walk.reverse, ⟨
    GradedSemanticPath.ofRewritePath (reversePath graph other hom walk)
      (reversePath_length graph other hom walk)⟩, ?_⟩
  exact ⟨donePattern walk.reverse,
    (gradedPathGSLT (theory graph other hom)
      (walk.length + 2)).equations.iseqv.refl _, rfl⟩

theorem map_inhabits_exact_work_type {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) {start finish : Fin n}
    (walk : source.Walk start finish) :
    gradedPathDiamond (theory source target hom) (2 * walk.length + 3)
      (saturatePredicate
        (gradedPathGSLT (theory source target hom) (2 * walk.length + 3))
        (fun candidate => candidate = donePattern (walk.map hom)))
      (mapRequestPattern walk) := by
  apply (gradedPathDiamond_spec _ _ _ _).2
  refine ⟨donePattern (walk.map hom), ⟨
    GradedSemanticPath.ofRewritePath (mapPath source target hom walk)
      (mapPath_length source target hom walk)⟩, ?_⟩
  exact ⟨donePattern (walk.map hom),
    (gradedPathGSLT (theory source target hom)
      (2 * walk.length + 3)).equations.iseqv.refl _, rfl⟩

/-! ## First library-organization layer -/

/-- Closed walks are the diagonal fibers of the generated endpoint-indexed
native walk family. -/
def NativeClosedWalk {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) (vertex : Fin n) : Type :=
  {term : Pattern // NativeWalk source target hom vertex vertex term}

def closedWalkInhabitant {n m : Nat}
    (source : SimpleGraph (Fin n)) (target : SimpleGraph (Fin m))
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) (vertex : Fin n)
    (walk : source.Walk vertex vertex) :
    NativeClosedWalk source target hom vertex :=
  ⟨walkPattern walk, walkPattern_inhabits_nativeWalk source target hom walk⟩

