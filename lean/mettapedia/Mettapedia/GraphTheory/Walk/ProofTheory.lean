import Mettapedia.GraphTheory.Walk.NativeTypeTheory

/-!
# Reachability proofs certified by the graph-walk native type theory

A walk is a proof of graph reachability.  This module keeps that familiar
Mathlib proof object while attaching the native judgment generated by the
walk LanguageDef.  Composition, identity, inversion, and homomorphic map are
therefore simultaneously:

* ordinary operations on dependent `SimpleGraph.Walk` proofs;
* operations on endpoint-indexed native certificates; and
* computations witnessed by exact, proof-relevant GSLT executions.

The `NativeProof` carrier is deliberately restricted to the canonical image
of Mathlib walks.  Showing that every raw pattern accepted by `NativeWalk` is
in this image is a separate no-junk theorem; it is not assumed here.
-/

namespace Mettapedia.GraphTheory.Walk.ProofTheory

open Mettapedia.GraphTheory.Walk.LanguageDef
open Mettapedia.GraphTheory.Walk.NativeTypeTheory
open Mettapedia.OSLF.Framework.PathTypeSynthesis
open SimpleGraph

set_option autoImplicit false

/-- A reachability proof together with its generated native certificate. -/
structure NativeProof {n : Nat} (graph : SimpleGraph (Fin n))
    [DecidableRel graph.Adj] (start finish : Fin n) where
  walk : graph.Walk start finish
  native : NativeWalk graph graph Hom.id start finish (walkPattern walk)

namespace NativeProof

/-- Every Mathlib walk enters the canonical native proof carrier. -/
def ofWalk {n : Nat} (graph : SimpleGraph (Fin n))
    [DecidableRel graph.Adj] {start finish : Fin n}
    (walk : graph.Walk start finish) : NativeProof graph start finish :=
  ⟨walk, walkPattern_inhabits_nativeWalk graph graph Hom.id walk⟩

/-- The program term certified by a native reachability proof. -/
def term {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {start finish : Fin n}
    (proof : NativeProof graph start finish) :
    Mettapedia.OSLF.MeTTaIL.Syntax.Pattern :=
  walkPattern proof.walk

@[ext] theorem ext {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {start finish : Fin n}
    {left right : NativeProof graph start finish}
    (walks : left.walk = right.walk) : left = right := by
  cases left
  cases right
  cases walks
  rfl

/-- Canonical native terms retain their reachability proof uniquely. -/
theorem term_injective {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {start finish : Fin n} :
    Function.Injective
      (@term n graph _ start finish) := by
  intro left right equality
  apply ext
  exact walkPattern_injective equality

/-- Reflexivity of reachability. -/
def identity {n : Nat} (graph : SimpleGraph (Fin n))
    [DecidableRel graph.Adj] (vertex : Fin n) :
    NativeProof graph vertex vertex :=
  ofWalk graph .nil

/-- Transitivity of reachability, implemented by walk append. -/
def comp {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {start middle finish : Fin n}
    (left : NativeProof graph start middle)
    (right : NativeProof graph middle finish) :
    NativeProof graph start finish :=
  ofWalk graph (left.walk.append right.walk)

/-- Symmetry of reachability in an undirected graph. -/
def inverse {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {start finish : Fin n}
    (proof : NativeProof graph start finish) :
    NativeProof graph finish start :=
  ofWalk graph proof.walk.reverse

/-- Functorial action of a graph homomorphism on reachability proofs. -/
def map {n m : Nat} {source : SimpleGraph (Fin n)}
    {target : SimpleGraph (Fin m)} [DecidableRel source.Adj]
    [DecidableRel target.Adj] (hom : source →g target)
    {start finish : Fin n} (proof : NativeProof source start finish) :
    NativeProof target (hom start) (hom finish) :=
  ofWalk target (proof.walk.map hom)

/-! ## Proof-theoretic laws -/

theorem comp_assoc {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {a b c d : Fin n}
    (first : NativeProof graph a b) (second : NativeProof graph b c)
    (third : NativeProof graph c d) :
    first.comp (second.comp third) = (first.comp second).comp third := by
  apply ext
  exact Walk.append_assoc _ _ _

@[simp] theorem identity_comp {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {a b : Fin n}
    (proof : NativeProof graph a b) :
    (identity graph a).comp proof = proof := by
  apply ext
  exact Walk.nil_append _

@[simp] theorem comp_identity {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {a b : Fin n}
    (proof : NativeProof graph a b) :
    proof.comp (identity graph b) = proof := by
  apply ext
  exact Walk.append_nil _

@[simp] theorem inverse_inverse {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {a b : Fin n}
    (proof : NativeProof graph a b) :
    proof.inverse.inverse = proof := by
  apply ext
  exact Walk.reverse_reverse _

theorem inverse_comp {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {a b c : Fin n}
    (first : NativeProof graph a b) (second : NativeProof graph b c) :
    (first.comp second).inverse = second.inverse.comp first.inverse := by
  apply ext
  exact Walk.reverse_append _ _

@[simp] theorem map_identity {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {a b : Fin n}
    (proof : NativeProof graph a b) :
    proof.map Hom.id = proof := by
  apply ext
  exact Walk.map_id _

theorem map_comp {n m k : Nat}
    {firstGraph : SimpleGraph (Fin n)}
    {secondGraph : SimpleGraph (Fin m)}
    {thirdGraph : SimpleGraph (Fin k)}
    [DecidableRel firstGraph.Adj] [DecidableRel secondGraph.Adj]
    [DecidableRel thirdGraph.Adj]
    (firstHom : firstGraph →g secondGraph)
    (secondHom : secondGraph →g thirdGraph)
    {a b : Fin n} (proof : NativeProof firstGraph a b) :
    (proof.map firstHom).map secondHom =
      proof.map (secondHom.comp firstHom) := by
  apply ext
  exact Walk.map_map _ _ _

theorem map_preserves_comp {n m : Nat}
    {source : SimpleGraph (Fin n)} {target : SimpleGraph (Fin m)}
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) {a b c : Fin n}
    (first : NativeProof source a b) (second : NativeProof source b c) :
    (first.comp second).map hom =
      (first.map hom).comp (second.map hom) := by
  apply ext
  exact Walk.map_append _ _ _

/-! ## The same proof operations as exact GSLT executions -/

theorem comp_executes {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {start middle finish : Fin n}
    (left : NativeProof graph start middle)
    (right : NativeProof graph middle finish) :
    gradedPathDiamond (theory graph graph Hom.id)
      (2 * left.walk.length + 3)
      (Mettapedia.OSLF.Framework.GSLTTypeSynthesis.saturatePredicate
        (gradedPathGSLT (theory graph graph Hom.id)
          (2 * left.walk.length + 3))
        (fun candidate => candidate = donePattern (left.walk.append right.walk)))
      (appendRequestPattern left.walk right.walk) :=
  append_inhabits_exact_work_type graph graph Hom.id left.walk right.walk

theorem inverse_executes {n : Nat} {graph : SimpleGraph (Fin n)}
    [DecidableRel graph.Adj] {start finish : Fin n}
    (proof : NativeProof graph start finish) :
    gradedPathDiamond (theory graph graph Hom.id) (proof.walk.length + 2)
      (Mettapedia.OSLF.Framework.GSLTTypeSynthesis.saturatePredicate
        (gradedPathGSLT (theory graph graph Hom.id) (proof.walk.length + 2))
        (fun candidate => candidate = donePattern proof.walk.reverse))
      (reverseRequestPattern proof.walk) :=
  reverse_inhabits_exact_work_type graph graph Hom.id proof.walk

theorem map_executes {n m : Nat}
    {source : SimpleGraph (Fin n)} {target : SimpleGraph (Fin m)}
    [DecidableRel source.Adj] [DecidableRel target.Adj]
    (hom : source →g target) {start finish : Fin n}
    (proof : NativeProof source start finish) :
    gradedPathDiamond (theory source target hom)
      (2 * proof.walk.length + 3)
      (Mettapedia.OSLF.Framework.GSLTTypeSynthesis.saturatePredicate
        (gradedPathGSLT (theory source target hom)
          (2 * proof.walk.length + 3))
        (fun candidate => candidate = donePattern (proof.walk.map hom)))
      (mapRequestPattern proof.walk) :=
  map_inhabits_exact_work_type source target hom proof.walk

section AxiomAudit

#print axioms term_injective
#print axioms comp_assoc
#print axioms inverse_comp
#print axioms map_comp
#print axioms map_preserves_comp
#print axioms comp_executes
#print axioms inverse_executes
#print axioms map_executes

end AxiomAudit

end NativeProof

end Mettapedia.GraphTheory.Walk.ProofTheory
