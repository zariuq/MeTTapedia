import Mettapedia.Coalgebra.StreamFinality
import Mettapedia.GSLT.Core.GSLT

/-!
# The operational GSLT of a stream coalgebra

A deterministic stream coalgebra has a natural operational face: its states
are terms and one rewrite advances to the successor state.  Its independently
defined denotation is the unique map into the final stream coalgebra.

One operational step always denotes stream tail.  The converse is valid
exactly when the final behavior map is faithful.  A collapsed two-state
coalgebra supplies the negative control: equal stream behavior need not imply
an operational step when distinct states are observationally identified.

This is a representative use of GSLT for an ordinary mathematical object.  A
GSLT contributes the transition structure; final-coalgebra semantics remains
an independent construction and the reflection premise remains visible.
-/

set_option autoImplicit false

namespace Mettapedia.Coalgebra.StreamGSLT

open Mettapedia.Coalgebra.StreamFinality
open Mettapedia.GSLT

universe uLabel uState

/-! ## The operational face -/

/-- The deterministic GSLT generated by a coalgebra's successor operation. -/
def stateGSLT {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label) : GSLT where
  Term := coalgebra.Carrier
  equations :=
    { r := Eq
      iseqv := ⟨Eq.refl, Eq.symm, Eq.trans⟩ }
  rewrites := fun source target => target = coalgebra.next source
  rewrites_resp_left := by
    intro source source' target equalSource step
    cases equalSource
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    intro source target target' step equalTarget
    cases equalTarget
    exact step

@[simp]
theorem stateGSLT_equiv_iff {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label)
    (first second : coalgebra.Carrier) :
    (stateGSLT coalgebra).Equiv first second ↔ first = second :=
  Iff.rfl

@[simp]
theorem stateGSLT_step_iff {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label)
    (source target : coalgebra.Carrier) :
    (stateGSLT coalgebra).Step source target ↔
      target = coalgebra.next source :=
  Iff.rfl

/-- Advance a coalgebra state by exactly the indicated number of steps. -/
def advance {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label) :
    Nat → coalgebra.Carrier → coalgebra.Carrier
  | 0, state => state
  | depth + 1, state => advance coalgebra depth (coalgebra.next state)

theorem multiStep_advance {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label)
    (depth : Nat) (state : coalgebra.Carrier) :
    (stateGSLT coalgebra).MultiStep state (advance coalgebra depth state) := by
  induction depth generalizing state with
  | zero =>
      exact GSLT.MultiStep.refl (S := stateGSLT coalgebra) state
  | succ depth inductionHypothesis =>
      exact GSLT.MultiStep.step (S := stateGSLT coalgebra) rfl
        (inductionHypothesis (coalgebra.next state))

/-- Every finite operational path reaches one exact iterate of the successor
map. -/
theorem multiStep_target_eq_advance {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label)
    {source target : coalgebra.Carrier}
    (path : (stateGSLT coalgebra).MultiStep source target) :
    ∃ depth, target = advance coalgebra depth source := by
  exact GSLT.MultiStep.recOn path
    (motive := fun first last _ =>
      ∃ depth, last = advance coalgebra depth first)
    (fun state => ⟨0, rfl⟩)
    (@fun first middle _last firstStep _rest inductionHypothesis => by
      rcases inductionHypothesis with ⟨depth, targetEquality⟩
      have middleEquality : middle = coalgebra.next first := firstStep
      subst middle
      exact ⟨depth + 1, targetEquality⟩)

theorem multiStep_iff_advance {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label)
    (source target : coalgebra.Carrier) :
    (stateGSLT coalgebra).MultiStep source target ↔
      ∃ depth, target = advance coalgebra depth source := by
  constructor
  · exact multiStep_target_eq_advance coalgebra
  · rintro ⟨depth, rfl⟩
    exact multiStep_advance coalgebra depth source

/-! ## Independent final-stream semantics -/

/-- Drop a finite number of observations from a stream. -/
def drop {Label : Type uLabel} : Nat → Stream Label → Stream Label
  | 0, stream => stream
  | depth + 1, stream => drop depth (tail stream)

theorem unfold_advance {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label)
    (depth : Nat) (state : coalgebra.Carrier) :
    unfold coalgebra (advance coalgebra depth state) =
      drop depth (unfold coalgebra state) := by
  induction depth generalizing state with
  | zero => rfl
  | succ depth inductionHypothesis =>
      calc
        unfold coalgebra
            (advance coalgebra depth (coalgebra.next state)) =
            drop depth (unfold coalgebra (coalgebra.next state)) :=
          inductionHypothesis (coalgebra.next state)
        _ = drop depth (tail (unfold coalgebra state)) := by
          rw [tail_unfold]
        _ = drop (depth + 1) (unfold coalgebra state) := rfl

/-- Every operational path has the corresponding finite-tail denotation. -/
theorem multiStep_preserves_stream_semantics {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label)
    {source target : coalgebra.Carrier}
    (path : (stateGSLT coalgebra).MultiStep source target) :
    ∃ depth, unfold coalgebra target =
      drop depth (unfold coalgebra source) := by
  rcases multiStep_target_eq_advance coalgebra path with
    ⟨depth, rfl⟩
  exact ⟨depth, unfold_advance coalgebra depth source⟩

/-- The final behavior map loses no state identity.  This is a semantic
separation property, not part of the coalgebra definition. -/
def BehaviorallyFaithful {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label) : Prop :=
  Function.Injective (unfold coalgebra)

/-- Under behavioral faithfulness, stream-tail agreement reflects one exact
operational step. -/
theorem step_iff_tail_semantics {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label)
    (faithful : BehaviorallyFaithful coalgebra)
    (source target : coalgebra.Carrier) :
    (stateGSLT coalgebra).Step source target ↔
      unfold coalgebra target = tail (unfold coalgebra source) := by
  constructor
  · intro step
    have targetEquality : target = coalgebra.next source := step
    subst target
    exact (tail_unfold coalgebra source).symm
  · intro semanticEquality
    apply faithful
    exact semanticEquality.trans (tail_unfold coalgebra source)

/-- Under the same premise, finite-tail denotation reflects the complete
multi-step relation. -/
theorem multiStep_iff_finiteTail_semantics {Label : Type uLabel}
    (coalgebra : Coalgebra.{uLabel, uState} Label)
    (faithful : BehaviorallyFaithful coalgebra)
    (source target : coalgebra.Carrier) :
    (stateGSLT coalgebra).MultiStep source target ↔
      ∃ depth, unfold coalgebra target =
        drop depth (unfold coalgebra source) := by
  constructor
  · exact multiStep_preserves_stream_semantics coalgebra
  · rintro ⟨depth, semanticEquality⟩
    have targetEquality : target = advance coalgebra depth source :=
      faithful
        (semanticEquality.trans
          (unfold_advance coalgebra depth source).symm)
    subst target
    exact multiStep_advance coalgebra depth source

/-! ## Positive and negative controls -/

namespace Canary

/-- The current Boolean state is directly observable. -/
def observableBoolean : Coalgebra Bool where
  Carrier := Bool
  observe := id
  next := Bool.not

theorem observableBoolean_faithful :
    BehaviorallyFaithful observableBoolean := by
  intro first second equalBehaviors
  have atHead := congrFun equalBehaviors 0
  exact atHead

theorem observableBoolean_step_exact (source target : Bool) :
    (stateGSLT observableBoolean).Step source target ↔
      unfold observableBoolean target =
        tail (unfold observableBoolean source) :=
  step_iff_tail_semantics observableBoolean
    observableBoolean_faithful source target

/-- Two hidden Boolean states emit the same unit label forever. -/
def collapsedBoolean : Coalgebra Unit where
  Carrier := Bool
  observe := fun _ => ()
  next := id

theorem collapsedBoolean_behaviors_equal :
    unfold collapsedBoolean false = unfold collapsedBoolean true := by
  funext depth
  exact Subsingleton.elim _ _

theorem collapsedBoolean_not_faithful :
    ¬ BehaviorallyFaithful collapsedBoolean := by
  intro faithful
  exact Bool.false_ne_true
    (faithful collapsedBoolean_behaviors_equal)

/-- Semantic tail agreement can hold between distinct collapsed states even
though the operational GSLT has no corresponding step. -/
theorem semantic_tail_without_operational_step :
    unfold collapsedBoolean true =
        tail (unfold collapsedBoolean false) ∧
      ¬ (stateGSLT collapsedBoolean).Step false true := by
  constructor
  · funext depth
    exact Subsingleton.elim _ _
  · intro step
    have impossible : true = false := step
    exact Bool.false_ne_true impossible.symm

end Canary

/-! ## Axiom audit -/

#print axioms multiStep_iff_advance
#print axioms unfold_advance
#print axioms multiStep_preserves_stream_semantics
#print axioms step_iff_tail_semantics
#print axioms multiStep_iff_finiteTail_semantics
#print axioms Canary.observableBoolean_step_exact
#print axioms Canary.collapsedBoolean_not_faithful
#print axioms Canary.semantic_tail_without_operational_step

end Mettapedia.Coalgebra.StreamGSLT
