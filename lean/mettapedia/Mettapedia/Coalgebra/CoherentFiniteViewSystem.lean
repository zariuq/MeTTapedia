import Mettapedia.Coalgebra.CoherentPrefixTower

/-!
# Coherent inverse systems of finite observations

A finite-view system is an inverse sequence of observation types indexed by
natural-number depth.  Its semantic limit is the type of coherent towers:
one view at every depth, compatible with every restriction map.

A behavior observation maps a behavior into that limit.  Faithfulness,
completeness, and exactness are kept separate.  Every fixed component may be
lossy while the coherent tower remains exact, as demonstrated by streams.

This is the general finite-view layer needed by computational-trinity
comparisons.  It does not assume that behaviors are streams or that the view
system is generated by a particular polynomial functor.
-/

set_option autoImplicit false

namespace Mettapedia.Coalgebra.CoherentFiniteViewSystem

open Mettapedia.Coalgebra.StreamFinality

universe uView uBehavior uLabel

/-- An inverse system of depth-indexed finite observations. -/
structure FiniteViewSystem where
  View : Nat → Type uView
  restrict : {earlier later : Nat} → earlier ≤ later →
    View later → View earlier
  restrict_refl : ∀ (depth : Nat) (view : View depth),
    restrict (Nat.le_refl depth) view = view
  restrict_trans : ∀ {earlier middle later : Nat}
    (earlierMiddle : earlier ≤ middle) (middleLater : middle ≤ later)
    (view : View later),
    restrict earlierMiddle (restrict middleLater view) =
      restrict (earlierMiddle.trans middleLater) view

namespace FiniteViewSystem

variable (system : FiniteViewSystem.{uView})

/-- One observation at every depth, compatible with restriction. -/
structure Tower where
  view : (depth : Nat) → system.View depth
  coherent : ∀ {earlier later : Nat} (bounded : earlier ≤ later),
    system.restrict bounded (view later) = view earlier

namespace Tower

@[ext]
theorem ext {first second : system.Tower}
    (views : first.view = second.view) : first = second := by
  cases first
  cases second
  cases views
  rfl

end Tower

end FiniteViewSystem

/-- A behavior supplies coherent observations at every finite depth. -/
structure BehaviorObservation
    (system : FiniteViewSystem.{uView}) (Behavior : Type uBehavior) where
  observe : (depth : Nat) → Behavior → system.View depth
  coherent : ∀ {earlier later : Nat} (bounded : earlier ≤ later)
    (behavior : Behavior),
    system.restrict bounded (observe later behavior) =
      observe earlier behavior

namespace BehaviorObservation

variable {system : FiniteViewSystem.{uView}} {Behavior : Type uBehavior}

/-- Assemble all finite observations into their coherent inverse-limit
tower. -/
def toTower (observation : BehaviorObservation system Behavior) :
    Behavior → system.Tower :=
  fun behavior =>
    { view := fun depth => observation.observe depth behavior
      coherent := fun bounded => observation.coherent bounded behavior }

/-- The complete finite-view tower separates behaviors. -/
def Faithful (observation : BehaviorObservation system Behavior) : Prop :=
  Function.Injective observation.toTower

/-- Every coherent tower represents a behavior. -/
def Complete (observation : BehaviorObservation system Behavior) : Prop :=
  Function.Surjective observation.toTower

/-- Behaviors and coherent towers carry exactly the same information. -/
def Exact (observation : BehaviorObservation system Behavior) : Prop :=
  Function.Bijective observation.toTower

theorem exact_iff_faithful_and_complete
    (observation : BehaviorObservation system Behavior) :
    observation.Exact ↔ observation.Faithful ∧ observation.Complete :=
  Iff.rfl

/-- Exact finite-view semantics yields the corresponding equivalence. -/
noncomputable def equivalenceOfExact
    (observation : BehaviorObservation system Behavior)
    (exact : observation.Exact) :
    Behavior ≃ system.Tower :=
  Equiv.ofBijective observation.toTower exact

end BehaviorObservation

/-! ## Streams instantiate the general inverse system -/

/-- Prefixes and restriction form the finite-view system of streams. -/
def streamPrefixSystem (Label : Type uLabel) :
    FiniteViewSystem.{uLabel} where
  View := Prefix Label
  restrict := restrictPrefix
  restrict_refl := by
    intro depth view
    funext index
    rfl
  restrict_trans := by
    intro earlier middle later earlierMiddle middleLater view
    funext index
    rfl

/-- Ordinary finite prefixes are a coherent behavior observation. -/
def streamObservation (Label : Type uLabel) :
    BehaviorObservation (streamPrefixSystem Label) (Stream Label) where
  observe := finiteView
  coherent := by
    intro earlier later bounded stream
    exact restrictPrefix_finiteView bounded stream

/-- The general coherent tower for stream prefixes is equivalent to the
existing stream-specific tower. -/
def streamTowerEquiv (Label : Type uLabel) :
    (streamPrefixSystem Label).Tower ≃
      Mettapedia.Coalgebra.CoherentPrefixTower.Tower Label where
  toFun := fun tower =>
    { view := tower.view
      coherent := tower.coherent }
  invFun := fun tower =>
    { view := tower.view
      coherent := tower.coherent }
  left_inv := by
    intro tower
    apply FiniteViewSystem.Tower.ext
    rfl
  right_inv := by
    intro tower
    apply Mettapedia.Coalgebra.CoherentPrefixTower.Tower.ext
    rfl

/-- The generic stream observation followed by the tower equivalence is the
existing coherent-prefix construction. -/
theorem streamTowerEquiv_toTower (Label : Type uLabel)
    (stream : Stream Label) :
    streamTowerEquiv Label ((streamObservation Label).toTower stream) =
      Mettapedia.Coalgebra.CoherentPrefixTower.Tower.ofStream stream :=
  rfl

/-- Streams are exactly their coherent system of all finite views. -/
theorem streamObservation_exact (Label : Type uLabel) :
    (streamObservation Label).Exact := by
  constructor
  · intro first second equalTowers
    apply Mettapedia.Coalgebra.CoherentPrefixTower.Tower.ofStream_injective
    rw [← streamTowerEquiv_toTower, ← streamTowerEquiv_toTower,
      equalTowers]
  · intro tower
    let existingTower := streamTowerEquiv Label tower
    let stream :=
      Mettapedia.Coalgebra.CoherentPrefixTower.Tower.toStream existingTower
    refine ⟨stream, ?_⟩
    apply (streamTowerEquiv Label).injective
    rw [streamTowerEquiv_toTower]
    exact
      Mettapedia.Coalgebra.CoherentPrefixTower.Tower.ofStream_toStream
        existingTower

/-- Negative control: no fixed Boolean prefix is faithful even though the
coherent tower is exact. -/
theorem fixed_view_lossy_complete_tower_exact (depth : Nat) :
    ¬ Function.Injective ((streamObservation Bool).observe depth) ∧
      (streamObservation Bool).Exact :=
  ⟨finiteView_not_injective depth Bool.false_ne_true,
    streamObservation_exact Bool⟩

#print axioms FiniteViewSystem.Tower.ext
#print axioms BehaviorObservation.exact_iff_faithful_and_complete
#print axioms streamTowerEquiv
#print axioms streamObservation_exact
#print axioms fixed_view_lossy_complete_tower_exact

end Mettapedia.Coalgebra.CoherentFiniteViewSystem
