import Mettapedia.Enactive.Bennett2023
import Mettapedia.Enactive.PrimeSupport
import Mettapedia.GSLT.Core.PolicyFamilyTransport

/-!
# Completion queries as a GSLT policy family

Michael Timothy Bennett's task policies are aspects whose completion cones
select correct outputs.  A `GSLT.Core.PolicyFamily` is a different object: it
lists the observations that a consumer may request of retained semantic state.
This module relates the two without identifying them.

For a completion relation, the canonical observation family asks whether a
candidate is a completion of the current state.  Its complete vector is the
characteristic function of the state's extension.  Thus Bennett's extension
becomes an instance of the existing least-sufficient-readout theory, and
relation embeddings transport every completion query naturally.  A concrete
non-surjective presentation map shows why reflection still requires coverage.
-/

set_option autoImplicit false

namespace Mettapedia.Enactive.GSLTPolicyBridge

open Mettapedia.GSLT.Core

universe uState uTarget

namespace CompletionQuery

variable {State : Type uState}

/-- The observation family generated by a decidable completion relation.
Policies here are *queries* for candidate completions, not Bennett task
policies. -/
def family (completion : State → State → Prop)
    [DecidableRel completion] : PolicyFamily State where
  Policy := State
  Result := fun _ => Bool
  decide := fun candidate source => decide (completion source candidate)

@[simp]
theorem decide_eq_true_iff (completion : State → State → Prop)
    [DecidableRel completion] (candidate source : State) :
    (family completion).decide candidate source = true ↔
      completion source candidate := by
  simp [family]

/-- Equality of complete policy vectors means equality of every principal
completion query. -/
theorem vector_eq_iff_same_completions
    (completion : State → State → Prop) [DecidableRel completion]
    (left right : State) :
    (family completion).vector left = (family completion).vector right ↔
      ∀ candidate, completion left candidate ↔ completion right candidate := by
  constructor
  · intro equal candidate
    have decisionEqual := congrFun equal candidate
    exact decide_eq_decide.mp decisionEqual
  · intro same
    funext candidate
    exact decide_eq_decide.mpr (same candidate)

/-- Principal completion queries separate states whenever completion is
reflexive and antisymmetric.  This is the abstract reason the complete vector
is a faithful readout for Bennett aspects. -/
theorem vector_injective_of_reflexive_antisymmetric
    (completion : State → State → Prop) [DecidableRel completion]
    (reflexive : ∀ state, completion state state)
    (antisymmetric : ∀ {left right},
      completion left right → completion right left → left = right) :
    Function.Injective (family completion).vector := by
  intro left right equal
  have same :=
    (vector_eq_iff_same_completions completion left right).mp equal
  exact antisymmetric
    ((same right).mpr (reflexive right))
    ((same left).mp (reflexive left))

/-- Relation embeddings make completion-query decisions commute with state
pullback and policy reindexing.  This is the exact transport law; no claim is
made for maps that fail to preserve and reflect completion. -/
theorem decide_natural_of_relEmbedding
    {Source : Type uState} {Target : Type uTarget}
    {sourceCompletion : Source → Source → Prop}
    {targetCompletion : Target → Target → Prop}
    [DecidableRel sourceCompletion] [DecidableRel targetCompletion]
    (embedding : sourceCompletion ↪r targetCompletion)
    (candidate source : Source) :
    (((family targetCompletion).pullback embedding).reindex embedding).decide
        candidate source =
      (family sourceCompletion).decide candidate source := by
  exact decide_eq_decide.mpr embedding.map_rel_iff

/-- The complete vectors themselves commute under the same relation
embedding. -/
theorem vector_natural_of_relEmbedding
    {Source : Type uState} {Target : Type uTarget}
    {sourceCompletion : Source → Source → Prop}
    {targetCompletion : Target → Target → Prop}
    [DecidableRel sourceCompletion] [DecidableRel targetCompletion]
    (embedding : sourceCompletion ↪r targetCompletion)
    (source : Source) :
    (((family targetCompletion).pullback embedding).reindex embedding).vector
        source =
      (family sourceCompletion).vector source := by
  funext candidate
  exact decide_natural_of_relEmbedding embedding candidate source

/-- Executable readout support is invariant between a source completion-query
family and the target family pulled back and reindexed along a relation
embedding.  This reuses the existing `PolicyFamily` realization boundary;
the embedding does not manufacture a compiled language route. -/
theorem supportsReadout_iff_of_relEmbedding
    {Source : Type uState} {Target : Type uTarget}
    {sourceCompletion : Source → Source → Prop}
    {targetCompletion : Target → Target → Prop}
    [DecidableRel sourceCompletion] [DecidableRel targetCompletion]
    (embedding : sourceCompletion ↪r targetCompletion)
    {Readout : Type*} (readout : Source → Readout) :
    PolicyFamily.SupportsReadout
        (((family targetCompletion).pullback embedding).reindex embedding)
        readout ↔
      (family sourceCompletion).SupportsReadout readout := by
  constructor
  · rintro ⟨realization⟩
    refine ⟨{
      run := realization.run
      agrees := ?_ }⟩
    intro candidate source
    exact (realization.agrees candidate source).trans
      (decide_natural_of_relEmbedding embedding candidate source)
  · rintro ⟨realization⟩
    refine ⟨{
      run := realization.run
      agrees := ?_ }⟩
    intro candidate source
    exact (realization.agrees candidate source).trans
      (decide_natural_of_relEmbedding embedding candidate source).symm

end CompletionQuery

/-! ## Bennett completion specialization -/

namespace Bennett

open Mettapedia.Enactive.Finite

universe uWorld

variable {World : Type uWorld} [Fintype World] [DecidableEq World]

/-- Finite Bennett completion, exposed as the relation observed by the GSLT
policy-family layer. -/
def completion {finiteLayer : Finite.Layer World}
    (source target : finiteLayer.Statement) : Prop :=
  source.val ⊆ target.val

instance {finiteLayer : Finite.Layer World} :
    DecidableRel (completion (finiteLayer := finiteLayer)) := by
  intro source target
  unfold completion
  infer_instance

/-- The canonical family asks every yes/no question "does this candidate
complete the current Bennett aspect?" -/
abbrev completionQueries (finiteLayer : Finite.Layer World) :=
  CompletionQuery.family (completion (finiteLayer := finiteLayer))

/-- Completion in Bennett's 2023 Boolean-program presentation. -/
def completion2023 {oldLayer : Bennett2023.Layer World}
    (source target : oldLayer.Statement) : Prop :=
  source.val ⊆ target.val

instance {oldLayer : Bennett2023.Layer World} :
    DecidableRel (completion2023 (oldLayer := oldLayer)) := by
  intro source target
  unfold completion2023
  infer_instance

/-- Bennett's principal extensions separate finite aspects, so their complete
query vectors retain the aspect itself.  Bennett's Razor can therefore rank
extensions without making their support readout the underlying semantics. -/
theorem completionQueryVector_injective (finiteLayer : Finite.Layer World) :
    Function.Injective (completionQueries finiteLayer).vector := by
  apply CompletionQuery.vector_injective_of_reflexive_antisymmetric
  · intro source
    exact Finset.Subset.rfl
  · intro left right leftRight rightLeft
    apply Subtype.ext
    exact Finset.Subset.antisymm leftRight rightLeft

/-- The characteristic-set equivalence from Bennett's 2023 presentation to
the finite 2024 presentation is a completion-relation embedding. -/
def statementCompletionEmbedding
    (oldLayer : Bennett2023.Layer World) :
    (completion2023 (oldLayer := oldLayer)) ↪r
      (completion (finiteLayer := oldLayer.toFinite)) where
  toEmbedding := (Bennett2023.Layer.statementEquiv oldLayer).toEmbedding
  map_rel_iff' :=
    Bennett2023.Layer.statementEquiv_le_iff («layer» := oldLayer)

/-- Every completion query has the same answer before and after the 2023-to-
2024 representation change.  Together with the existing extension and
weakness agreement theorems, this makes the GSLT observation transport
source-faithful rather than an encoding slogan. -/
theorem statement_completion_query_natural
    (oldLayer : Bennett2023.Layer World)
    (candidate source : oldLayer.Statement) :
    (completionQueries oldLayer.toFinite).decide
        (Bennett2023.Layer.statementEquiv oldLayer candidate)
      (Bennett2023.Layer.statementEquiv oldLayer source) =
      PolicyFamily.decide
        (CompletionQuery.family (completion2023 (oldLayer := oldLayer)))
        candidate source := by
  exact CompletionQuery.decide_natural_of_relEmbedding
    (statementCompletionEmbedding oldLayer) candidate source

/-! ### A lossy presentation map can conceal refusal -/

def includeSingleton :
    PrimeSupport.Completion.singletonLayer.Statement →
      Finite.Canary.boolLayer.Statement :=
  fun _ => Finite.Canary.emptyStatement

def collapsedReadout (_ : Finite.Canary.boolLayer.Statement) : Unit := ()

/-- Positive source-side control: after a non-surjective pullback to the sole
empty aspect, a collapsed readout can answer every target completion query. -/
theorem singleton_pullback_supports_collapsed :
    PolicyFamily.SupportsReadout
      ((completionQueries Finite.Canary.boolLayer).pullback includeSingleton)
      (collapsedReadout ∘ includeSingleton) := by
  refine ⟨{
    run := fun candidate _ =>
      (completionQueries Finite.Canary.boolLayer).decide
        candidate Finite.Canary.emptyStatement
    agrees := ?_ }⟩
  intro candidate source
  rw [PrimeSupport.Completion.singletonLayer_statement_eq source]
  rfl

/-- Negative target-side control: the same collapsed readout cannot answer
all Boolean completion queries.  The empty-candidate query distinguishes the
empty aspect from the true-only aspect. -/
theorem bool_completion_queries_refuse_collapsed :
    ¬ PolicyFamily.SupportsReadout
      (completionQueries Finite.Canary.boolLayer) collapsedReadout := by
  apply PolicyFamily.not_supportsReadout_of_policy_collision
    (completionQueries Finite.Canary.boolLayer) collapsedReadout
      (first := Finite.Canary.emptyStatement)
      (second := Finite.Canary.trueStatement) rfl
      Finite.Canary.emptyStatement
  change true ≠ false
  decide

/-- A concrete Bennett presentation map exhibits the coverage premise: its
pullback accepts a lossy readout that the full target family rejects. -/
theorem nonsurjective_map_can_hide_completion_refusal :
    PolicyFamily.SupportsReadout
        ((completionQueries Finite.Canary.boolLayer).pullback includeSingleton)
        (collapsedReadout ∘ includeSingleton) ∧
      ¬ PolicyFamily.SupportsReadout
        (completionQueries Finite.Canary.boolLayer) collapsedReadout :=
  ⟨singleton_pullback_supports_collapsed,
    bool_completion_queries_refuse_collapsed⟩

end Bennett

#print axioms CompletionQuery.vector_injective_of_reflexive_antisymmetric
#print axioms CompletionQuery.supportsReadout_iff_of_relEmbedding
#print axioms Bennett.statement_completion_query_natural
#print axioms Bennett.nonsurjective_map_can_hide_completion_refusal

end Mettapedia.Enactive.GSLTPolicyBridge
