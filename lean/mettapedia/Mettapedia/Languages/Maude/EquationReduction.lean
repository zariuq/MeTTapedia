import Mettapedia.Languages.Maude.Semantics
import Mathlib.Logic.Relation

/-! The chosen forward orientation of E, closed under typed argument
contexts. Equation paths retain normalization evidence separately from the
histories generated by transition rules R. -/

set_option autoImplicit false

namespace Mettapedia.Languages.Maude

inductive EquationReduction (theory : Theory) (context : VariableContext) : String → Term → Term → Prop where
  | root {row : Row} {sort : String} (assignment : Valuation) :
      row ∈ theory.equations → row.check theory.signature = true →
      HasSort theory.signature row.usedContext row.left sort →
      HasSort theory.signature row.usedContext row.right sort →
      TypedValuation theory.signature context row.usedContext assignment →
      Conditions theory context assignment row.conditions →
      EquationReduction theory context sort (row.left.substitute assignment) (row.right.substitute assignment)
  | argument {hole sort : String} (frame : ArgumentContext theory.signature context hole sort)
      {source target : Term} :
      EquationReduction theory context hole source target →
      EquationReduction theory context sort (frame.plug source) (frame.plug target)

theorem EquationReduction.equivalent {theory : Theory} {context : VariableContext}
    {sort : String} {source target : Term} (step : EquationReduction theory context sort source target) :
    Equivalent theory context sort source target := by
  induction step with
  | root assignment declared checked left right typed conditions =>
      exact .equation assignment declared checked left right typed conditions
  | argument frame _ ih => exact .argument frame ih

theorem EquationReduction.sorted {theory : Theory} {context : VariableContext}
    {sort : String} {source target : Term} (step : EquationReduction theory context sort source target) :
    HasSort theory.signature context source sort ∧ HasSort theory.signature context target sort :=
  step.equivalent.sorted

abbrev EquationPath (theory : Theory) (context : VariableContext) (sort : String) : Term → Term → Prop :=
  Relation.ReflTransGen (EquationReduction theory context sort)

theorem EquationPath.equivalent {theory : Theory} {context : VariableContext}
    {sort : String} {source target : Term} (typed : HasSort theory.signature context source sort)
    (path : EquationPath theory context sort source target) : Equivalent theory context sort source target := by
  induction path with
  | refl => exact .refl typed
  | tail _ step ih => exact .trans ih step.equivalent

theorem EquationPath.inArgument {theory : Theory} {context : VariableContext}
    {hole sort : String} (frame : ArgumentContext theory.signature context hole sort)
    {source target : Term} (path : EquationPath theory context hole source target) :
    EquationPath theory context sort (frame.plug source) (frame.plug target) := by
  induction path with
  | refl => exact .refl
  | tail _ step ih => exact ih.tail (.argument frame step)

end Mettapedia.Languages.Maude
