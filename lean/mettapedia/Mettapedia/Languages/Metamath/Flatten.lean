/-! ## Soundness -/

/-- The machine meaning is invariant along any declarative reduction chain. -/
private theorem M_star {a b : Pattern} (h : Star a b) : M a = M b := by
  induction h with
  | refl => rfl
  | tail _ hstep ih => exact ih.trans (step_preserves hstep)

/-- Any `CompileDone p` reachable from `Compile db` has `p = flattenDb db`.
No shape hypothesis: off-shape databases jam the machine before `CompileDone`. -/
theorem flatten_sound {db p : Pattern}
    (h : Star (.apply "Compile" [db]) (.apply "CompileDone" [p])) :
    flattenDb db = some p := by
  have hM := M_star h
  simp only [M] at hM
  rw [flattenDb_phases]
  exact hM

