    split at h
    · rename_i body
      cases hb : envDb body with
      | none => rw [hb] at h; exact absurd h (by simp)
      | some es =>
        rw [hb, Option.map_some] at h
        injection h with h; subst h
        exact .head (step_CompileLoadEnvFrontBlock body k)
          (.trans (envDb_star body es hb (.apply "EnvKWrapBlock" [k]))
            (.single (step_CompileReturnEnvDbWrapBlock es k)))
    · injection h with h; subst h
      exact .single (step_CompileLoadEnvFrontBlockEmpty k)
    · rename_i syms
      injection h with h; subst h
      exact .single (step_CompileLoadEnvFrontConstDecl syms k)
    · rename_i syms
      injection h with h; subst h
      exact .single (step_CompileLoadEnvFrontVarDecl syms k)
    · rename_i syms
      injection h with h; subst h
      exact .single (step_CompileLoadEnvFrontDjDecl syms k)
    · rename_i path
