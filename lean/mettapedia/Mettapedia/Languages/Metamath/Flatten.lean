import Mettapedia.Languages.Metamath.NTTDiagnostics
import Mettapedia.OSLF.MeTTaIL.ContextualStep
import Mettapedia.OSLF.MeTTaIL.MatchSpec
import Mathlib.Logic.Relation

/-!
# The Flatten Theorem for the `metamathCore` Compile Machine

`metamathCore` (`Mettapedia/Languages/Metamath/LanguageDefDSL.lean`) carries a
`Database → FrontDb → FrontEnv → CoreProg` lowering machine as rewrite rules
under the `CompileAfter*` wrappers.  This file proves that machine correct
against a declarative specification `flattenDb : Pattern → Option Pattern`:

* `flatten_complete`: `flattenDb db = some p` implies the least reduction
  generated by the authored `metamathCore` rules drives `Compile db` to
  `CompileDone p` — proved by constructing the reduction chain one top-level
  authored-rule step at a time.
* `flatten_sound`: any `CompileDone p` reachable from `Compile db` satisfies
  `flattenDb db = some p` — proved by a machine invariant (`M` below), a
  total state-meaning function preserved by every one of the 110 rewrite
  rules (quantifying over rule *membership*, never over reduct-list
  positions.  No rule in this machine carries a congruence premise, so every
  step is top-level by construction.
* `flattenDb_eq_some_iff`: the two directions packaged as an equivalence.
* `compile_correct`: for every well-formed database (`DbShape db`), there is
  a *unique* `p` with `Compile db ⟶* CompileDone p`.

The `#guard` twins below cross-check `flattenDb` against the permanent
regression fixtures in `NTTDiagnostics` (the executable machine's actual
normal forms), keeping the declarative spec and the machine content-locked.

LLM primer (hard-won facts):
* Rule literals `r0`–`r109` are extracted from `metamathCore.rewrites`
  post-`resolveNullaryPatterns` (nullary constructors are `.apply "K" []` on
  both sides); `mm_rewrites_eq` pins the whole list by `rfl`.
* Soundness never inverts `matchPattern`: since every rule LHS is a linear
  `.apply`/`.fvar` tree, `MatchSpec.matchPattern_correct` factors the matched
  state as `applyBindings bs r.left`, so per-rule preservation is a purely
  denotational lemma over arbitrary leaf values.
* Kont denotations must be **eta-expanded** at use sites (`fun v => lowKDb k v`);
  simp cannot rewrite partially applied equations.
-/

namespace Mettapedia.Languages.Metamath.Flatten

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.Match
open Mettapedia.OSLF.MeTTaIL.MatchSpec
open Mettapedia.OSLF.MeTTaIL.ContextualStep
open Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical
open Mettapedia.OSLF.MeTTaIL.ReflectiveSubstitution
open Mettapedia.Languages.Metamath.LanguageDefDSL

/-- Non-contextual premise evaluation for the Metamath compile machine.  The
machine's rules have no premises; making the boundary explicit keeps the step
relation derived from the authored `LanguageDef`. -/
private abbrev StepBase : BasePremiseEvaluator :=
  engineBasePremises Mettapedia.OSLF.MeTTaIL.Engine.RelationEnv.empty

/-- One step in the least relation generated by the authored Metamath rules. -/
abbrev Step :=
  Mettapedia.OSLF.MeTTaIL.ContextualStep.Step StepBase metamathCore

/-- Reflexive-transitive closure of the declarative step. -/
abbrev Star := Relation.ReflTransGen Step

/-! ## The declarative flatten function

Shapes mirror the machine exactly:
* `ReturnCoreWrapBlock` wraps a nonempty block body `b` as
  `CoreProgCat (CoreProgOne CoreEnterScope) (CoreProgCat b (CoreProgOne CoreExitScope))`;
* `LinearizeFrontEntryBlockEmpty` produces
  `CoreProgCat (CoreProgOne CoreEnterScope) (CoreProgOne CoreExitScope)`;
* `ReturnCoreCat` folds statement lists head-first:
  `DbMore s rest ↦ CoreProgCat (flattenStmt s) (flattenDb rest)`. -/

/-- `CoreProgOne` node. -/
def progOne (s : Pattern) : Pattern := .apply "CoreProgOne" [s]

/-- `CoreProgCat` node. -/
def progCat (a b : Pattern) : Pattern := .apply "CoreProgCat" [a, b]

/-- `CoreProgOne CoreEnterScope`. -/
def enterScope : Pattern := progOne (.apply "CoreEnterScope" [])

/-- `CoreProgOne CoreExitScope`. -/
def exitScope : Pattern := progOne (.apply "CoreExitScope" [])

/-- Scope bracket around a nonempty block body, exactly as
`ReturnCoreWrapBlock` builds it. -/
def wrapBlock (p : Pattern) : Pattern := progCat enterScope (progCat p exitScope)

mutual
/-- Flatten a `Stmt`-shaped pattern to its `CoreProg`, `none` off-shape. -/
def flattenStmt : Pattern → Option Pattern
  | .apply "Block" [body] => (flattenDb body).map wrapBlock
  | .apply "BlockEmpty" [] => some (progCat enterScope exitScope)
  | .apply "ConstDecl" [syms] => some (progOne (.apply "CoreConstDecl" [syms]))
  | .apply "VarDecl" [syms] => some (progOne (.apply "CoreVarDecl" [syms]))
  | .apply "DjDecl" [syms] => some (progOne (.apply "CoreDjDecl" [syms]))
  | .apply "IncludeDecl" [path] => some (progOne (.apply "CoreIncludeDecl" [path]))
  | .apply "FloatDecl" [label, typecode, var] =>
      some (progOne (.apply "CoreFloatDecl" [label, typecode, var]))
  | .apply "EssHyp" [label, math] => some (progOne (.apply "CoreEssHyp" [label, math]))
  | .apply "Axiom" [label, math] => some (progOne (.apply "CoreAxiom" [label, math]))
  | .apply "Provable" [label, math, proof] =>
      some (progOne (.apply "CoreProvable" [label, math, proof]))
  | _ => none
termination_by p => sizeOf p

/-- Flatten a `Database`-shaped pattern to its `CoreProg`, `none` off-shape. -/
def flattenDb : Pattern → Option Pattern
  | .apply "DbOne" [s] => flattenStmt s
  | .apply "DbMore" [s, rest] =>
      (flattenStmt s).bind fun ps => (flattenDb rest).map fun pr => progCat ps pr
  | _ => none
termination_by p => sizeOf p
end

/-! ## Well-formed database shapes -/

mutual
/-- `Stmt`-shaped patterns: exactly the domain of `flattenStmt`.
Leaf payloads (`syms`, `label`, …) are opaque to the compile machine, so they
are unconstrained here. -/
inductive StmtShape : Pattern → Prop where
  | block {d : Pattern} : DbShape d → StmtShape (.apply "Block" [d])
  | blockEmpty : StmtShape (.apply "BlockEmpty" [])
  | constDecl (syms : Pattern) : StmtShape (.apply "ConstDecl" [syms])
  | varDecl (syms : Pattern) : StmtShape (.apply "VarDecl" [syms])
  | djDecl (syms : Pattern) : StmtShape (.apply "DjDecl" [syms])
  | includeDecl (path : Pattern) : StmtShape (.apply "IncludeDecl" [path])
  | floatDecl (label typecode var : Pattern) :
      StmtShape (.apply "FloatDecl" [label, typecode, var])
  | essHyp (label math : Pattern) : StmtShape (.apply "EssHyp" [label, math])
  | ax (label math : Pattern) : StmtShape (.apply "Axiom" [label, math])
  | provable (label math proof : Pattern) :
      StmtShape (.apply "Provable" [label, math, proof])

/-- `Database`-shaped patterns: exactly the domain of `flattenDb`. -/
inductive DbShape : Pattern → Prop where
  | one {s : Pattern} : StmtShape s → DbShape (.apply "DbOne" [s])
  | more {s d : Pattern} : StmtShape s → DbShape d → DbShape (.apply "DbMore" [s, d])
end

mutual
/-- `flattenStmt` is total on `Stmt` shapes. -/
theorem flattenStmt_isSome_of_shape : ∀ s : Pattern, StmtShape s → (flattenStmt s).isSome
  | _, .block hd => by
      obtain ⟨p, hp⟩ := Option.isSome_iff_exists.mp (flattenDb_isSome_of_shape _ hd)
      simp [flattenStmt, hp]
  | _, .blockEmpty => by simp [flattenStmt]
  | _, .constDecl _ => by simp [flattenStmt]
  | _, .varDecl _ => by simp [flattenStmt]
  | _, .djDecl _ => by simp [flattenStmt]
  | _, .includeDecl _ => by simp [flattenStmt]
  | _, .floatDecl _ _ _ => by simp [flattenStmt]
  | _, .essHyp _ _ => by simp [flattenStmt]
  | _, .ax _ _ => by simp [flattenStmt]
  | _, .provable _ _ _ => by simp [flattenStmt]
termination_by s _ => sizeOf s

/-- `flattenDb` is total on `Database` shapes. -/
theorem flattenDb_isSome_of_shape : ∀ db : Pattern, DbShape db → (flattenDb db).isSome
  | _, .one hs => by
      obtain ⟨p, hp⟩ := Option.isSome_iff_exists.mp (flattenStmt_isSome_of_shape _ hs)
      simp [flattenDb, hp]
  | _, .more hs hd => by
      obtain ⟨p, hp⟩ := Option.isSome_iff_exists.mp (flattenStmt_isSome_of_shape _ hs)
      obtain ⟨q, hq⟩ := Option.isSome_iff_exists.mp (flattenDb_isSome_of_shape _ hd)
      simp [flattenDb, hp, hq]
termination_by db _ => sizeOf db
end

mutual
/-- Conversely, `flattenStmt` succeeds only on `Stmt` shapes. -/
theorem stmtShape_of_flattenStmt_isSome : ∀ s : Pattern, (flattenStmt s).isSome → StmtShape s
  | s, h => by
    rw [flattenStmt.eq_def] at h
    split at h
    · rename_i body
      exact .block (dbShape_of_flattenDb_isSome body (by simpa using h))
    · exact .blockEmpty
    · exact .constDecl _
    · exact .varDecl _
    · exact .djDecl _
    · exact .includeDecl _
    · exact .floatDecl _ _ _
    · exact .essHyp _ _
    · exact .ax _ _
    · exact .provable _ _ _
    · simp at h
termination_by s _ => sizeOf s

/-- Conversely, `flattenDb` succeeds only on `Database` shapes. -/
theorem dbShape_of_flattenDb_isSome : ∀ db : Pattern, (flattenDb db).isSome → DbShape db
  | db, h => by
    rw [flattenDb.eq_def] at h
    split at h
    · rename_i s
      exact .one (stmtShape_of_flattenStmt_isSome s h)
    · rename_i s rest
      cases h1 : flattenStmt s with
      | none => rw [h1] at h; simp at h
      | some ps =>
        cases h2 : flattenDb rest with
        | none => rw [h1, h2] at h; simp at h
        | some pr =>
          exact .more (stmtShape_of_flattenStmt_isSome s (by simp [h1]))
            (dbShape_of_flattenDb_isSome rest (by simp [h2]))
    · simp at h
termination_by db _ => sizeOf db
end

/-- The shape predicate characterizes the domain of `flattenDb`. -/
theorem flattenDb_isSome_iff {db : Pattern} : (flattenDb db).isSome ↔ DbShape db :=
  ⟨dbShape_of_flattenDb_isSome db, flattenDb_isSome_of_shape db⟩

/-! ## Executable twins of the NTTDiagnostics regression fixtures

The fixtures in `NTTDiagnostics` run the actual engine
(`rewriteToNormalForm`) and content-assert the result; here we pin
`flattenDb` to the very same content, and additionally to the machine's
normal form directly. -/

section FixtureTwins
open Mettapedia.Languages.Metamath.NTTDiagnostics

-- Content twin of `twoStmtCompileNF` (two-axiom database).
#guard flattenDb twoStmtDb
    = some (.apply "CoreProgCat"
        [.apply "CoreProgOne" [.apply "CoreAxiom" [ax1Label, minimalMath]],
         .apply "CoreProgOne" [.apply "CoreAxiom" [ax1Label, minimalMath]]])

-- Machine twin: `flattenDb` agrees with the engine's normal form.
#guard (match twoStmtCompileNF with
        | .apply "CompileDone" [p] => flattenDb twoStmtDb == some p
        | _ => false)

-- Content twin of `emptyBlockCompileNF` (`${ $}` database).
#guard flattenDb (.apply "DbOne" [.apply "BlockEmpty" []])
    = some (.apply "CoreProgCat"
        [.apply "CoreProgOne" [.apply "CoreEnterScope" []],
         .apply "CoreProgOne" [.apply "CoreExitScope" []]])

-- Machine twin for the empty block.
#guard (match emptyBlockCompileNF with
        | .apply "CompileDone" [p] =>
            flattenDb (.apply "DbOne" [.apply "BlockEmpty" []]) == some p
        | _ => false)

-- Negative examples: off-shape patterns flatten to `none`.
#guard flattenDb (.fvar "x") = none
#guard flattenDb (.apply "DbOne" [.fvar "x"]) = none
#guard flattenStmt (.apply "Block" [.fvar "x"]) = none

end FixtureTwins

/-! ## Phase denotations

The machine runs three CPS phases; each gets a structural denotation
(`none` off-shape) plus a kont denotation.  The state meaning `M` composes
them.  All right-hand sides use explicit `.apply` trees (matching the rule
literals) and keep kont applications eta-expanded. -/

mutual
private def lowStmt : Pattern → Option Pattern
  | .apply "Block" [body] => (lowDb body).map fun f => .apply "FrontBlock" [f]
  | .apply "BlockEmpty" [] => some (.apply "FrontBlockEmpty" [])
  | .apply "ConstDecl" [syms] => some (.apply "FrontConstDecl" [syms])
  | .apply "VarDecl" [syms] => some (.apply "FrontVarDecl" [syms])
  | .apply "DjDecl" [syms] => some (.apply "FrontDjDecl" [syms])
  | .apply "IncludeDecl" [path] => some (.apply "FrontIncludeDecl" [path])
  | .apply "FloatDecl" [label, typecode, var] =>
      some (.apply "FrontFloatDecl" [label, typecode, var])
  | .apply "EssHyp" [label, math] => some (.apply "FrontEssHyp" [label, math])
  | .apply "Axiom" [label, math] => some (.apply "FrontAxiom" [label, math])
  | .apply "Provable" [label, math, proof] =>
      some (.apply "FrontProvable" [label, math, proof])
  | _ => none
termination_by p => sizeOf p

private def lowDb : Pattern → Option Pattern
  | .apply "DbOne" [s] => (lowStmt s).map fun f => .apply "FrontDbOne" [f]
  | .apply "DbMore" [s, rest] =>
      (lowStmt s).bind fun f => (lowDb rest).map fun r => .apply "FrontDbMore" [f, r]
  | _ => none
termination_by p => sizeOf p
end

mutual
private def envStmt : Pattern → Option Pattern
  | .apply "FrontBlock" [body] =>
      (envDb body).map fun es => .apply "FrontEntryBlock" [.apply "FrontEnvNode" [es]]
  | .apply "FrontBlockEmpty" [] => some (.apply "FrontEntryBlockEmpty" [])
  | .apply "FrontConstDecl" [syms] => some (.apply "FrontEntryConstDecl" [syms])
  | .apply "FrontVarDecl" [syms] => some (.apply "FrontEntryVarDecl" [syms])
  | .apply "FrontDjDecl" [syms] => some (.apply "FrontEntryDjDecl" [syms])
  | .apply "FrontIncludeDecl" [path] => some (.apply "FrontEntryIncludeDecl" [path])
  | .apply "FrontFloatDecl" [label, typecode, var] =>
      some (.apply "FrontEntryFloatDecl" [label, typecode, var])
  | .apply "FrontEssHyp" [label, math] => some (.apply "FrontEntryEssHyp" [label, math])
  | .apply "FrontAxiom" [label, math] => some (.apply "FrontEntryAxiom" [label, math])
  | .apply "FrontProvable" [label, math, proof] =>
      some (.apply "FrontEntryProvable" [label, math, proof])
  | _ => none
termination_by p => sizeOf p

private def envDb : Pattern → Option Pattern
  | .apply "FrontDbOne" [s] => (envStmt s).map fun e => .apply "FrontEntriesOne" [e]
  | .apply "FrontDbMore" [s, rest] =>
      (envStmt s).bind fun e => (envDb rest).map fun t => .apply "FrontEntriesMore" [e, t]
  | _ => none
termination_by p => sizeOf p
end

mutual
private def linEntry : Pattern → Option Pattern
  | .apply "FrontEntryBlock" [.apply "FrontEnvNode" [entries]] =>
      (linEntries entries).map fun p =>
        .apply "CoreProgCat" [.apply "CoreProgOne" [.apply "CoreEnterScope" []],
          .apply "CoreProgCat" [p, .apply "CoreProgOne" [.apply "CoreExitScope" []]]]
  | .apply "FrontEntryBlockEmpty" [] =>
      some (.apply "CoreProgCat" [.apply "CoreProgOne" [.apply "CoreEnterScope" []],
        .apply "CoreProgOne" [.apply "CoreExitScope" []]])
  | .apply "FrontEntryConstDecl" [syms] =>
      some (.apply "CoreProgOne" [.apply "CoreConstDecl" [syms]])
  | .apply "FrontEntryVarDecl" [syms] =>
      some (.apply "CoreProgOne" [.apply "CoreVarDecl" [syms]])
  | .apply "FrontEntryDjDecl" [syms] =>
      some (.apply "CoreProgOne" [.apply "CoreDjDecl" [syms]])
  | .apply "FrontEntryIncludeDecl" [path] =>
      some (.apply "CoreProgOne" [.apply "CoreIncludeDecl" [path]])
  | .apply "FrontEntryFloatDecl" [label, typecode, var] =>
      some (.apply "CoreProgOne" [.apply "CoreFloatDecl" [label, typecode, var]])
  | .apply "FrontEntryEssHyp" [label, math] =>
      some (.apply "CoreProgOne" [.apply "CoreEssHyp" [label, math]])
  | .apply "FrontEntryAxiom" [label, math] =>
      some (.apply "CoreProgOne" [.apply "CoreAxiom" [label, math]])
  | .apply "FrontEntryProvable" [label, math, proof] =>
      some (.apply "CoreProgOne" [.apply "CoreProvable" [label, math, proof]])
  | _ => none
termination_by p => sizeOf p

private def linEntries : Pattern → Option Pattern
  | .apply "FrontEntriesOne" [e] => linEntry e
  | .apply "FrontEntriesMore" [e, tail] =>
      (linEntry e).bind fun p => (linEntries tail).map fun t => .apply "CoreProgCat" [p, t]
  | _ => none
termination_by p => sizeOf p
end

/-! Kont denotations (recursion on the kont). -/

mutual
private def lowKDb : Pattern → Pattern → Option Pattern
  | .apply "KDone" [], v => some v
  | .apply "KDbCons" [stmt, k], v => lowKDb k (.apply "FrontDbMore" [stmt, v])
  | .apply "KWrapBlock" [k], v => lowKStmt k (.apply "FrontBlock" [v])
  | _, _ => none
termination_by k _ => sizeOf k

private def lowKStmt : Pattern → Pattern → Option Pattern
  | .apply "KDbLast" [k], v => lowKDb k (.apply "FrontDbOne" [v])
  | .apply "KDbMore" [rest, k], v =>
      (lowDb rest).bind fun r => lowKDb k (.apply "FrontDbMore" [v, r])
  | _, _ => none
termination_by k _ => sizeOf k
end

mutual
private def envKDb : Pattern → Pattern → Option Pattern
  | .apply "EnvKDone" [], v => some v
  | .apply "EnvKDbCons" [e, k], v => envKDb k (.apply "FrontEntriesMore" [e, v])
  | .apply "EnvKWrapBlock" [k], v =>
      envKStmt k (.apply "FrontEntryBlock" [.apply "FrontEnvNode" [v]])
  | _, _ => none
termination_by k _ => sizeOf k

private def envKStmt : Pattern → Pattern → Option Pattern
  | .apply "EnvKDbLast" [k], v => envKDb k (.apply "FrontEntriesOne" [v])
  | .apply "EnvKDbMore" [rest, k], v =>
      (envDb rest).bind fun r => envKDb k (.apply "FrontEntriesMore" [v, r])
  | _, _ => none
termination_by k _ => sizeOf k
end

private def linK : Pattern → Pattern → Option Pattern
  | .apply "LinKDone" [], v => some v
  | .apply "LinKCat" [head, k], v => linK k (.apply "CoreProgCat" [head, v])
  | .apply "LinKEntriesMore" [tail, k], v =>
      (linEntries tail).bind fun t => linK k (.apply "CoreProgCat" [v, t])
  | .apply "LinKWrapBlock" [k], v =>
      linK k (.apply "CoreProgCat" [.apply "CoreProgOne" [.apply "CoreEnterScope" []],
        .apply "CoreProgCat" [v, .apply "CoreProgOne" [.apply "CoreExitScope" []]]])
  | _, _ => none
termination_by k _ => sizeOf k

/-! Phase-state meanings and the machine invariant `M`. -/

private def envNodeEntries : Pattern → Option Pattern
  | .apply "FrontEnvNode" [es] => some es
  | _ => none

private def lowState : Pattern → Option Pattern
  | .apply "Lower" [db] => lowDb db
  | .apply "LowerDb" [db, k] => (lowDb db).bind fun v => lowKDb k v
  | .apply "LowerStmt" [s, k] => (lowStmt s).bind fun v => lowKStmt k v
  | .apply "ReturnDb" [v, k] => lowKDb k v
  | .apply "ReturnStmt" [v, k] => lowKStmt k v
  | .apply "LowerDone" [v] => some v
  | _ => none

private def envState : Pattern → Option Pattern
  | .apply "LoadEnv" [db] => envDb db
  | .apply "LoadEnvDb" [db, k] => (envDb db).bind fun v => envKDb k v
  | .apply "LoadEnvStmt" [s, k] => (envStmt s).bind fun v => envKStmt k v
  | .apply "ReturnEnvDb" [v, k] => envKDb k v
  | .apply "ReturnEnvStmt" [v, k] => envKStmt k v
  | .apply "LoadEnvDone" [e] => envNodeEntries e
  | _ => none

private def linState : Pattern → Option Pattern
  | .apply "Linearize" [e] => (envNodeEntries e).bind fun es => linEntries es
  | .apply "LinearizeEntries" [es, k] => (linEntries es).bind fun v => linK k v
  | .apply "LinearizeEntry" [e, k] => (linEntry e).bind fun v => linK k v
  | .apply "ReturnCore" [v, k] => linK k v
  | .apply "LinearizeDone" [v] => some v
  | _ => none

/-- The three phases composed: the meaning of `Compile db`. -/
private def phases (db : Pattern) : Option Pattern :=
  (lowDb db).bind fun f => (envDb f).bind fun es => linEntries es

/-- The machine invariant: a total meaning for every pattern, preserved by
every `metamathCore` rewrite (proved rule-by-rule below).  Non-`Compile*`
states mean `none`. -/
private def M : Pattern → Option Pattern
  | .apply "Compile" [db] => phases db
  | .apply "CompileAfterLower" [l] =>
      (lowState l).bind fun f => (envDb f).bind fun es => linEntries es
  | .apply "CompileAfterEnv" [e] => (envState e).bind fun es => linEntries es
  | .apply "CompileAfterLinearize" [l] => linState l
  | .apply "CompileDone" [p] => some p
  | _ => none

/-- Compile-machine head constructors (the only states with meanings). -/
private def isCompileHead (c : String) : Bool :=
  c == "Compile" || c == "CompileAfterLower" || c == "CompileAfterEnv" ||
    c == "CompileAfterLinearize" || c == "CompileDone"

private theorem M_bare {c : String} (hc : isCompileHead c = false) (args : List Pattern) :
    M (.apply c args) = none := by
  rw [M.eq_def]
  split <;> first
    | rfl
    | (rename_i heq; injection heq with h1 h2; subst h1; simp [isCompileHead] at hc)

/-! ## The phase decomposition of `flattenDb` -/

mutual
private theorem flattenStmt_phases : ∀ s : Pattern,
    flattenStmt s = (lowStmt s).bind fun f => (envStmt f).bind fun e => linEntry e
  | s => by
    rw [flattenStmt.eq_def]
    split
    · rename_i body
      rw [flattenDb_phases body]
      simp only [phases, lowStmt]
      cases hb : lowDb body with
      | none => simp
      | some fb =>
        simp only [Option.map_some, Option.bind_some, envStmt]
        cases he : envDb fb with
        | none => simp
        | some es =>
          simp only [Option.map_some, Option.bind_some, linEntry]
          cases hl : linEntries es <;>
            simp [wrapBlock, progCat, progOne, enterScope, exitScope]
    · simp [lowStmt, envStmt, linEntry, progCat, progOne, enterScope, exitScope]
    · simp [lowStmt, envStmt, linEntry, progOne]
    · simp [lowStmt, envStmt, linEntry, progOne]
    · simp [lowStmt, envStmt, linEntry, progOne]
    · simp [lowStmt, envStmt, linEntry, progOne]
    · simp [lowStmt, envStmt, linEntry, progOne]
    · simp [lowStmt, envStmt, linEntry, progOne]
    · simp [lowStmt, envStmt, linEntry, progOne]
    · simp [lowStmt, envStmt, linEntry, progOne]
    · -- catch-all: `lowStmt` has literally the same arms, so it is `none` too.
      rw [lowStmt.eq_def]
      split <;> simp_all
termination_by s => sizeOf s

private theorem flattenDb_phases : ∀ db : Pattern, flattenDb db = phases db
  | db => by
    rw [flattenDb.eq_def]
    simp only [phases]
    split
    · rename_i s
      rw [flattenStmt_phases s]
      simp only [lowDb]
      cases hs : lowStmt s with
      | none => simp
      | some fs =>
        simp only [Option.map_some, Option.bind_some, envDb]
        cases he : envStmt fs with
        | none => simp
        | some e =>
          simp only [Option.map_some, Option.bind_some, linEntries]
    · rename_i s rest
      rw [flattenStmt_phases s, flattenDb_phases rest]
      simp only [phases, lowDb]
      cases h1 : lowStmt s with
      | none => simp
      | some f1 =>
        simp only [Option.bind_some]
        cases h2 : lowDb rest with
        | none => simp
        | some f2 =>
          simp only [Option.map_some, Option.bind_some, envDb]
          cases h3 : envStmt f1 with
          | none => simp
          | some e1 =>
            simp only [Option.bind_some]
            cases h4 : envDb f2 with
            | none => simp
            | some e2 =>
              simp only [Option.map_some, Option.bind_some, linEntries]
              cases h5 : linEntry e1 with
              | none => simp
              | some p1 =>
                simp only [Option.bind_some]
                cases h6 : linEntries e2 <;> simp [progCat]
    · -- catch-all: `lowDb` has literally the same arms.
      rw [lowDb.eq_def]
      split <;> simp_all
termination_by db => sizeOf db
end

