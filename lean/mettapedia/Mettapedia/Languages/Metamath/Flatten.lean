/-! ## Completeness: the reduction chains -/

mutual
private theorem lowStmt_star : ∀ s f : Pattern, lowStmt s = some f → ∀ k : Pattern,
    Star (.apply "CompileAfterLower" [.apply "LowerStmt" [s, k]])
         (.apply "CompileAfterLower" [.apply "ReturnStmt" [f, k]])
  | s, f, h, k => by
    rw [lowStmt.eq_def] at h
    split at h
    · rename_i body
      cases hb : lowDb body with
      | none => rw [hb] at h; exact absurd h (by simp)
      | some fb =>
        rw [hb, Option.map_some] at h
        injection h with h; subst h
        exact .head (step_CompileLowerBlock body k)
          (.trans (lowDb_star body fb hb (.apply "KWrapBlock" [k]))
            (.single (step_CompileReturnDbWrapBlock fb k)))
    · injection h with h; subst h
      exact .single (step_CompileLowerBlockEmpty k)
    · rename_i syms
      injection h with h; subst h
      exact .single (step_CompileLowerConstDecl syms k)
    · rename_i syms
      injection h with h; subst h
      exact .single (step_CompileLowerVarDecl syms k)
    · rename_i syms
      injection h with h; subst h
      exact .single (step_CompileLowerDjDecl syms k)
    · rename_i path
      injection h with h; subst h
      exact .single (step_CompileLowerIncludeDecl path k)
    · rename_i label typecode var
      injection h with h; subst h
      exact .single (step_CompileLowerFloatDecl label typecode var k)
    · rename_i label math
      injection h with h; subst h
      exact .single (step_CompileLowerEssHyp label math k)
    · rename_i label math
      injection h with h; subst h
      exact .single (step_CompileLowerAxiom label math k)
    · rename_i label math proof
      injection h with h; subst h
      exact .single (step_CompileLowerProvable label math proof k)
    · exact absurd h (by simp)
termination_by s _ _ _ => sizeOf s

private theorem lowDb_star : ∀ db f : Pattern, lowDb db = some f → ∀ k : Pattern,
    Star (.apply "CompileAfterLower" [.apply "LowerDb" [db, k]])
         (.apply "CompileAfterLower" [.apply "ReturnDb" [f, k]])
  | db, f, h, k => by
    rw [lowDb.eq_def] at h
    split at h
    · rename_i s
      cases hs : lowStmt s with
      | none => rw [hs] at h; exact absurd h (by simp)
      | some fs =>
        rw [hs, Option.map_some] at h
        injection h with h; subst h
        exact .head (step_CompileLowerDbOne s k)
          (.trans (lowStmt_star s fs hs (.apply "KDbLast" [k]))
            (.single (step_CompileReturnStmtDbLast fs k)))
    · rename_i s rest
      cases hs : lowStmt s with
      | none => rw [hs] at h; exact absurd h (by simp)
      | some fs =>
        rw [hs, Option.bind_some] at h
        cases hr : lowDb rest with
        | none => rw [hr] at h; exact absurd h (by simp)
        | some fr =>
          rw [hr, Option.map_some] at h
          injection h with h; subst h
          exact .head (step_CompileLowerDbMore s rest k)
            (.trans (lowStmt_star s fs hs (.apply "KDbMore" [rest, k]))
              (.head (step_CompileReturnStmtDbMore fs rest k)
                (.trans (lowDb_star rest fr hr (.apply "KDbCons" [fs, k]))
                  (.single (step_CompileReturnDbCons fr fs k)))))
    · exact absurd h (by simp)
termination_by db _ _ _ => sizeOf db
end

mutual
private theorem envStmt_star : ∀ s f : Pattern, envStmt s = some f → ∀ k : Pattern,
    Star (.apply "CompileAfterEnv" [.apply "LoadEnvStmt" [s, k]])
