termination_by s _ _ _ => sizeOf s

private theorem envDb_star : ∀ db f : Pattern, envDb db = some f → ∀ k : Pattern,
    Star (.apply "CompileAfterEnv" [.apply "LoadEnvDb" [db, k]])
         (.apply "CompileAfterEnv" [.apply "ReturnEnvDb" [f, k]])
  | db, f, h, k => by
    rw [envDb.eq_def] at h
    split at h
    · rename_i s
      cases hs : envStmt s with
      | none => rw [hs] at h; exact absurd h (by simp)
      | some e =>
        rw [hs, Option.map_some] at h
        injection h with h; subst h
        exact .head (step_CompileLoadEnvDbOne s k)
          (.trans (envStmt_star s e hs (.apply "EnvKDbLast" [k]))
            (.single (step_CompileReturnEnvStmtDbLast e k)))
    · rename_i s rest
      cases hs : envStmt s with
      | none => rw [hs] at h; exact absurd h (by simp)
      | some e =>
        rw [hs, Option.bind_some] at h
        cases hr : envDb rest with
        | none => rw [hr] at h; exact absurd h (by simp)
        | some t =>
          rw [hr, Option.map_some] at h
          injection h with h; subst h
          exact .head (step_CompileLoadEnvDbMore s rest k)
            (.trans (envStmt_star s e hs (.apply "EnvKDbMore" [rest, k]))
              (.head (step_CompileReturnEnvStmtDbMore e rest k)
                (.trans (envDb_star rest t hr (.apply "EnvKDbCons" [e, k]))
                  (.single (step_CompileReturnEnvDbCons t e k)))))
    · exact absurd h (by simp)
termination_by db _ _ _ => sizeOf db
end

mutual
private theorem linEntry_star : ∀ e p : Pattern, linEntry e = some p → ∀ k : Pattern,
    Star (.apply "CompileAfterLinearize" [.apply "LinearizeEntry" [e, k]])
         (.apply "CompileAfterLinearize" [.apply "ReturnCore" [p, k]])
  | e, p, h, k => by
    rw [linEntry.eq_def] at h
    split at h
    · rename_i entries
      cases hb : linEntries entries with
      | none => rw [hb] at h; exact absurd h (by simp)
      | some pb =>
        rw [hb, Option.map_some] at h
        injection h with h; subst h
        exact .head (step_CompileLinearizeFrontEntryBlock entries k)
          (.trans (linEntries_star entries pb hb (.apply "LinKWrapBlock" [k]))
            (.single (step_CompileReturnCoreWrapBlock pb k)))
    · injection h with h; subst h
      exact .single (step_CompileLinearizeFrontEntryBlockEmpty k)
    · rename_i syms
      injection h with h; subst h
      exact .single (step_CompileLinearizeFrontEntryConstDecl syms k)
    · rename_i syms
      injection h with h; subst h
      exact .single (step_CompileLinearizeFrontEntryVarDecl syms k)
    · rename_i syms
      injection h with h; subst h
      exact .single (step_CompileLinearizeFrontEntryDjDecl syms k)
    · rename_i path
      injection h with h; subst h
      exact .single (step_CompileLinearizeFrontEntryIncludeDecl path k)
    · rename_i label typecode var
      injection h with h; subst h
      exact .single (step_CompileLinearizeFrontEntryFloatDecl label typecode var k)
    · rename_i label math
      injection h with h; subst h
      exact .single (step_CompileLinearizeFrontEntryEssHyp label math k)
    · rename_i label math
      injection h with h; subst h
      exact .single (step_CompileLinearizeFrontEntryAxiom label math k)
    · rename_i label math proof
      injection h with h; subst h
      exact .single (step_CompileLinearizeFrontEntryProvable label math proof k)
    · exact absurd h (by simp)
termination_by e _ _ _ => sizeOf e

private theorem linEntries_star : ∀ es p : Pattern, linEntries es = some p → ∀ k : Pattern,
    Star (.apply "CompileAfterLinearize" [.apply "LinearizeEntries" [es, k]])
         (.apply "CompileAfterLinearize" [.apply "ReturnCore" [p, k]])
  | es, p, h, k => by
    rw [linEntries.eq_def] at h
    split at h
    · rename_i e
      exact .head (step_CompileLinearizeEntriesOne e k) (linEntry_star e p h k)
    · rename_i e tail
      cases h1 : linEntry e with
      | none => rw [h1] at h; exact absurd h (by simp)
      | some pe =>
        rw [h1, Option.bind_some] at h
        cases h2 : linEntries tail with
        | none => rw [h2] at h; exact absurd h (by simp)
        | some pt =>
          rw [h2, Option.map_some] at h
          injection h with h; subst h
          exact .head (step_CompileLinearizeEntriesMore e tail k)
            (.trans (linEntry_star e pe h1 (.apply "LinKEntriesMore" [tail, k]))
              (.head (step_CompileReturnCoreEntriesMore pe tail k)
                (.trans (linEntries_star tail pt h2 (.apply "LinKCat" [pe, k]))
                  (.single (step_CompileReturnCoreCat pt pe k)))))
    · exact absurd h (by simp)
termination_by es _ _ _ => sizeOf es
end

/-! ## Completeness -/

/-- `flattenDb db = some p` implies the machine drives `Compile db` to
`CompileDone p`, by an explicit reduction chain through all three phases. -/
theorem flatten_complete {db p : Pattern} (h : flattenDb db = some p) :
    Star (.apply "Compile" [db]) (.apply "CompileDone" [p]) := by
  rw [flattenDb_phases db] at h
  simp only [phases] at h
  cases hf : lowDb db with
  | none => rw [hf] at h; exact absurd h (by simp)
  | some fdb =>
    rw [hf, Option.bind_some] at h
    cases he : envDb fdb with
    | none => rw [he] at h; exact absurd h (by simp)
    | some es =>
      rw [he, Option.bind_some] at h
      refine .head (step_BeginCompile db) ?_
      refine .head (step_CompileLowerBegin db) ?_
      refine .trans (lowDb_star db fdb hf (.apply "KDone" [])) ?_
      refine .head (step_CompileReturnDbDone fdb) ?_
      refine .head (step_CompileLowerDone fdb) ?_
      refine .head (step_CompileEnvBegin fdb) ?_
      refine .trans (envDb_star fdb es he (.apply "EnvKDone" [])) ?_
      refine .head (step_CompileReturnEnvDbDone es) ?_
      refine .head (step_CompileEnvDone (.apply "FrontEnvNode" [es])) ?_
      refine .head (step_CompileLinearizeBegin es) ?_
      refine .trans (linEntries_star es p h (.apply "LinKDone" [])) ?_
      refine .head (step_CompileReturnCoreDone p) ?_
      exact .single (step_CompileLinearizeDone p)

/-! ## The flatten theorem -/

/-- **Flatten theorem**: the declarative machine computes exactly
`flattenDb`. -/
theorem flattenDb_eq_some_iff {db p : Pattern} :
    flattenDb db = some p ↔ Star (.apply "Compile" [db]) (.apply "CompileDone" [p]) :=
  ⟨flatten_complete, flatten_sound⟩

/-- For a well-formed database there is a unique compiled program. -/
theorem compile_correct {db : Pattern} (hdb : DbShape db) :
    ∃! p : Pattern, Star (.apply "Compile" [db]) (.apply "CompileDone" [p]) := by
  obtain ⟨p, hp⟩ := Option.isSome_iff_exists.mp (flattenDb_isSome_of_shape db hdb)
  exact ⟨p, flatten_complete hp,
    fun q hq => Option.some.inj ((flatten_sound hq).symm.trans hp)⟩

/-- Negative example: an off-shape "database" never compiles. -/
example (p : Pattern) :
    ¬ Star (.apply "Compile" [.fvar "x"]) (.apply "CompileDone" [p]) := fun h => by
  simpa [flattenDb] using flatten_sound h

