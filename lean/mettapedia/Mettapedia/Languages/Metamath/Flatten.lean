/-- Introduce a premise-free top-level authored rule into the least contextual
relation.  The Metamath presentation has no reflective canonical declaration,
so matching and substitution use their structural fallbacks exactly. -/
private theorem contextualTopRule {source target : Pattern}
    (rule : RewriteRule) (member : rule ∈ metamathCore.rewrites)
    (noPremises : rule.premises = []) (bindings : Bindings)
    (matched : bindings ∈ matchPattern rule.left source)
    (instantiated : applyBindings bindings rule.right = target) :
    Step source target := by
  refine ⟨1, .rule (initialBindings := bindings) (finalBindings := bindings)
    member ?_ ?_ ?_⟩
  · rw [matchPatternForRule_eq_syntactic_of_no_presentations (by rfl)]
    exact matched
  · rw [noPremises]
    exact .nil bindings
  · rw [applyBindingsForRule_eq_syntactic_of_no_presentations (by rfl)]
    exact instantiated

