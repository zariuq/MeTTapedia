/-! ## One-step preservation of `M` -/

private theorem applyBindings_apply (bs : Bindings) (c : String) (args : List Pattern) :
    applyBindings bs (.apply c args) = .apply c (args.map (applyBindings bs)) := by
  simp [applyBindings]

/-- Per-rule preservation package. -/
private abbrev PresOf (r : RewriteRule) : Prop :=
  ∀ (bs : Bindings) (s q : Pattern),
    bs ∈ matchPattern r.left s → applyBindings bs r.right = q → M s = M q

/-- Every rule LHS here is a linear `.apply`/`.fvar` tree, so a matched state
*is* `applyBindings bs r.left` (`matchPattern_correct`); preservation reduces
to a denotational key over arbitrary leaf values. -/
private theorem pres_of (r : RewriteRule) (hmc : Pattern.isMatchCorrect r.left = true)
    (key : ∀ bs : Bindings, M (applyBindings bs r.left) = M (applyBindings bs r.right)) :
    PresOf r := by
  intro bs s q hbs happ
  rw [← matchPattern_correct hbs hmc, ← happ]
  exact key bs

/-- Bare (unwrapped) phase rules move between non-`Compile*` heads: both
sides mean `none`. -/
private theorem bare_key {c c' : String} {ps qs : List Pattern} {bs : Bindings}
    (hc : isCompileHead c = false) (hc' : isCompileHead c' = false) :
    M (applyBindings bs (.apply c ps)) = M (applyBindings bs (.apply c' qs)) := by
  rw [applyBindings_apply, applyBindings_apply, M_bare hc, M_bare hc']

/-! ### Denotational keys, one per wrapped rule -/


private theorem key_BeginCompile (db : Pattern) :
    M (.apply "Compile" [db]) =
      M (.apply "CompileAfterLower" [(.apply "Lower" [db])]) := by
  simp only [M, lowState, phases]
private theorem key_CompileLowerBegin (db : Pattern) :
    M (.apply "CompileAfterLower" [(.apply "Lower" [db])]) =
      M (.apply "CompileAfterLower" [(.apply "LowerDb" [db, (.apply "KDone" [])])]) := by
  simp only [M, lowState]
  cases lowDb db <;> simp [lowKDb]
