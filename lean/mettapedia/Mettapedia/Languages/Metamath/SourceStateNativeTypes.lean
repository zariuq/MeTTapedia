import Mettapedia.Languages.Metamath.SourceStateGSLT
import Mettapedia.OSLF.Framework.GSLTTypeSynthesis

/-!
# OSLF native types for the Metamath source-state GSLT

This module applies the generic OSLF construction to the complete authored
Metamath source-state transition relation.  It introduces no separate
Metamath type system: exact-target native inhabitation means exactly one
source-state transition, including the retained local, normal-proof, or
compressed-proof evidence.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.Metamath.SourceStateNativeTypes

open Mettapedia.GSLT
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis
open Mettapedia.Languages.Metamath.SourceGSLTState
open Mettapedia.Languages.Metamath.SourceGSLTOperations
open Mettapedia.Languages.Metamath.SourceStateGSLT

/-- The predicate-valued native-type carrier generated by OSLF from the
authored Metamath state calculus. -/
abbrev SourceStateNativeType : Type :=
  GSLTNativeType SourceStateGSLT.theory

/-- The behavioral native type of source states that take one step to the
specified target state. -/
def sourceStateExactTargetNativeType (target : SourceState) :
    SourceStateNativeType :=
  exactTargetNativeType SourceStateGSLT.theory target

/-- The generated exact-target native type has precisely the meaning of the
authored source-state step relation. -/
theorem satisfies_sourceStateExactTargetNativeType_iff_step
    (source target : SourceState) :
    (gsltOSLF SourceStateGSLT.theory).satisfies source
        (sourceStateExactTargetNativeType target).pred ↔
      SourceStateGSLT.theory.Step source target :=
  satisfies_exactTargetNativeType_iff_step
    SourceStateGSLT.theory source target

/-- Every retained authored transition occurrence inhabits the exact OSLF
native type of its target. -/
theorem transition_inhabits_exact_target
    {action : StateAction} {source target : SourceState}
    (transition : Transition action source target) :
    (gsltOSLF SourceStateGSLT.theory).satisfies source
      (sourceStateExactTargetNativeType target).pred := by
  apply (satisfies_sourceStateExactTargetNativeType_iff_step
    source target).2
  exact ⟨⟨action, transition⟩⟩

/-- A successful authored local operation is therefore accepted by the NTT
generated from the complete source-state calculus.  Source-data transforms
use this theorem instead of assigning an independent meaning to declarations.
-/
theorem local_payload_inhabits_exact_target
    {payload : LocalPayload} {source target : SourceState}
    (applied : applyLocalPayload? payload source = some target) :
    (gsltOSLF SourceStateGSLT.theory).satisfies source
      (sourceStateExactTargetNativeType target).pred :=
  transition_inhabits_exact_target
    (Transition.localTransition applied)

/-! ## Positive and negative boundary controls -/

/-- The repository's constant-declaration transition inhabits its generated
native target type. -/
theorem declare_constant_inhabits_native_type :
    (gsltOSLF SourceStateGSLT.theory).satisfies initialState
      (sourceStateExactTargetNativeType oneConstantState).pred :=
  transition_inhabits_exact_target
    (Transition.localTransition declare_constant_applies)

/-- The rejected active-variable redeclaration has no authored occurrence.
This proof-relevant negative is intentionally stronger than merely observing
that a chosen endpoint is absent. -/
theorem active_variable_redeclaration_has_no_occurrence
    (target : SourceState) :
    IsEmpty
      (Transition (.localAction (.declareVariables ["x"]))
        oneActiveVariableState target) :=
  no_active_variable_redeclaration target

section AxiomAudit

#print axioms satisfies_sourceStateExactTargetNativeType_iff_step
#print axioms transition_inhabits_exact_target
#print axioms local_payload_inhabits_exact_target
#print axioms active_variable_redeclaration_has_no_occurrence

end AxiomAudit

end Mettapedia.Languages.Metamath.SourceStateNativeTypes
