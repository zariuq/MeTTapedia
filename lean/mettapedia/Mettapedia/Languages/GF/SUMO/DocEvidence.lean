import Mettapedia.Languages.GF.SUMO.EvidenceModel

/-!
# SUMO documentation evidence

The table records the English documentation, KIF rendering, and GF parse
evidence extracted for the active repair decisions in February 2026.
An assessment is reused across records with the same source type and score.
Each occurrence retains its claim, source, expression, independence group,
and artifact hash. Documentation evidence provides corroboration.
-/

namespace Mettapedia.Languages.GF.SUMO.DocEvidence

open EvidenceModel

private structure SupportAssessment where
  sourceType : SourceType
  score : Float

private structure EvidenceOccurrence where
  claimId : String
  sourceRef : String
  formalExpr : String
  independenceGroup : String
  artifactHash : String

private def EvidenceAtom.occurrence (a : EvidenceAtom) : EvidenceOccurrence :=
  ⟨a.claimId, a.sourceRef, a.formalExpr, a.independenceGroup, a.artifactHash⟩

@[inline] private def supportAt (decision : Nat) (kind : RepairArchetype)
    (record : SupportAssessment × EvidenceOccurrence) : EvidenceAtom :=
  { claimId := record.2.claimId
    decisionId := decision
    archetype := kind
    direction := .supports
    sourceType := record.1.sourceType
    sourceRef := record.2.sourceRef
    formalExpr := record.2.formalExpr
    strength := record.1.score
    confidence := record.1.score
    independenceGroup := record.2.independenceGroup
    artifactHash := record.2.artifactHash }

private def supportFor (decision : Nat) (kind : RepairArchetype)
    (records : List (SupportAssessment × EvidenceOccurrence)) : List EvidenceAtom :=
  records.map (supportAt decision kind)

/-- Decoding preserves ordered evidence occurrences, including repeated records. -/
private theorem supportFor_occurrences (decision : Nat) (kind : RepairArchetype)
    (records : List (SupportAssessment × EvidenceOccurrence)) :
    (supportFor decision kind records).map EvidenceAtom.occurrence = records.map Prod.snd := by
  induction records with
  | nil => rfl
  | cons record tail ih => exact congrArg (record.2 :: ·) ih

declare_syntax_cat docSupportRow
syntax "(" term "," term ")" : docSupportRow

/-- Expand a batch into typed support constructions at its declared decision. -/
syntax "doc_support_rows% " term:max term:max " [" docSupportRow,* "]" : term

macro_rules
  | `(doc_support_rows% $decision:term $kind:term [$rows:docSupportRow,*]) => do
      let entries ← rows.getElems.mapM fun row => do
        match row with
        | `(docSupportRow| ($assessment:term, $occurrence:term)) =>
            `(supportAt $decision $kind ($assessment, $occurrence))
        | _ => Lean.Macro.throwUnsupported
      `([$entries,*])

private def renderedUse : SupportAssessment := ⟨.kifRendered, 0.4⟩
private def renderedAxiom : SupportAssessment := ⟨.kifRendered, 0.55⟩
private def parsedAxiom : SupportAssessment := ⟨.engGFParsed, 0.55⟩
private def parsedDocumentation : SupportAssessment := ⟨.docGFParsed, 0.5⟩
private def documentation (score : Float) : SupportAssessment := ⟨.englishDoc, score⟩

private def originalOccurrence : EvidenceOccurrence :=
  ⟨"claim", "axiom:1", "premise", "first-group", "digest"⟩

private def secondOccurrence : EvidenceOccurrence :=
  { originalOccurrence with independenceGroup := "second-group" }

example :
    (doc_support_rows% 1 .ontologyReclassification [
      (renderedAxiom, originalOccurrence), (renderedAxiom, secondOccurrence),
      (renderedAxiom, originalOccurrence)
    ]).map EvidenceAtom.occurrence =
      [originalOccurrence, secondOccurrence, originalOccurrence] :=
  supportFor_occurrences 1 .ontologyReclassification [
    (renderedAxiom, originalOccurrence), (renderedAxiom, secondOccurrence),
    (renderedAxiom, originalOccurrence)
  ]

example :
    (supportAt 1 .ontologyReclassification (renderedAxiom, originalOccurrence)).independenceGroup ≠
      (supportAt 1 .ontologyReclassification (renderedAxiom, secondOccurrence)).independenceGroup := by
  decide +kernel

