import Mettapedia.Languages.ProcessCalculi.PolyadicPi.Bridges.MonadicProtocolUnaryInvariant
import Mettapedia.Languages.ProcessCalculi.PolyadicPi.Bridges.RhoUnaryCode

/-!
# A scoped guarded-unary compiler into the actual rho core

The domain is a syntactic subset of the existing intrinsic pi signature.
Inputs, outputs, parallel composition and private scopes are unrestricted
within that subset. Replication is an input-guarded persistent server. No
binary former or free process variable is silently interpreted.

The compiler emits core rho processes. Private scope and persistent-server
installation request names from the shared allocator. Extra stored-code
binders are accounted for by the target name environment, including within
the recursively compiled server body. Names generated by the allocator are
forwarded as their seed code, preserving their quotation identity.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.PolyadicPi.Bridges.RhoUnaryCompiler

open Mettapedia.OSLF.Binding
open Mettapedia.Languages.ProcessCalculi.PolyadicPi
open Mettapedia.Languages.ProcessCalculi.PolyadicPi.Bridges.RhoUnaryCode

abbrev World (Γ : Ctx sig) (depth : Nat) := Var Γ Srt.nm → NameValue depth

def evalName {Γ : Ctx sig} {depth : Nat} (world : World Γ depth) : Name Γ → NameValue depth
  | .var name => world name
  | .op op _ => nomatch op

def liftWorld {Γ : Ctx sig} {depth : Nat} (world : World Γ depth) : World (.nm :: Γ) (depth + 1)
  | .zero => .bound ⟨0, by omega⟩
  | .succ old => (world old).weaken

def serverHandlerWorld {Γ : Ctx sig} {depth : Nat} (world : World Γ depth) :
    World (.nm :: Γ) (depth + 2)
  | .zero => .bound ⟨0, by omega⟩
  | .succ old => (world old).weaken.weaken

def storedHandlerWorld {Γ : Ctx sig} {depth : Nat} (world : World Γ depth) :
    World (.nm :: Γ) (depth + 4)
  | .zero => .bound ⟨0, by omega⟩
  | .succ old => (world old).weaken.weaken.weaken.weaken

/-- At this position the allocated self name is index one. The two inner
inputs then place it at index three and the stored code at index one. -/
def storedCode {depth : Nat} (channel : NameValue depth) (body : Code (depth + 4)) :
    Code (depth + 2) :=
  Code.listen (.bound ⟨1, by omega⟩)
    (Code.listen channel.weaken.weaken.weaken
      (Code.triple
        (Code.sendName (.bound ⟨3, by omega⟩) (.bound ⟨1, by omega⟩))
        (Code.datum (.bound ⟨1, by omega⟩)) body))

/-- The stored code and request-dependent handler are both built in their
own actual scopes; no synthetic replication constructor is emitted. -/
def waitingServer {depth : Nat} (channel : NameValue depth)
    (handler : Code (depth + 2)) (storedHandler : Code (depth + 4)) : Code (depth + 1) :=
  Code.listen channel.weaken
    (Code.triple (Code.emit (.bound ⟨1, by omega⟩) (storedCode channel storedHandler))
      (storedCode channel storedHandler) handler)

/-- An input-guarded unary fragment of the shared intrinsic pi syntax. -/
inductive GuardedUnary : {Γ : Ctx sig} → Proc Γ → Prop where
  | nil {Γ} : GuardedUnary (nil : Proc Γ)
  | par {Γ} {first second : Proc Γ} :
      GuardedUnary first → GuardedUnary second → GuardedUnary (par first second)
  | inp1 {Γ} (channel : Name Γ) {body : Proc (.nm :: Γ)} :
      GuardedUnary body → GuardedUnary (inp1 channel body)
  | out1 {Γ} (channel datum : Name Γ) : GuardedUnary (out1 channel datum)
  | nu {Γ} {body : Proc (.nm :: Γ)} : GuardedUnary body → GuardedUnary (nu body)
  | server {Γ} (channel : Name Γ) {body : Proc (.nm :: Γ)} :
      GuardedUnary body → GuardedUnary (rep (inp1 channel body))

/-- Reindexing preserves the same guarded unary source domain. -/
theorem GuardedUnary.rename {Γ Δ : Ctx sig} {process : Proc Γ}
    (guarded : GuardedUnary process) (environment : Ren sig Γ Δ) :
    GuardedUnary (Mettapedia.OSLF.Binding.rename environment process) := by
  induction guarded generalizing Δ with
  | nil => exact .nil
  | par _ _ firstIH secondIH =>
      exact .par (firstIH environment) (secondIH environment)
  | inp1 channel _ ih => exact .inp1 _ (ih (liftRen environment [.nm]))
  | out1 channel datum => exact .out1 _ _
  | nu _ ih => exact .nu (ih (liftRen environment [.nm]))
  | server channel _ ih => exact .server _ (ih (liftRen environment [.nm]))

/-- This subset uses the existing unary presentation. -/
theorem GuardedUnary.unary {Γ : Ctx sig} {process : Proc Γ} (guarded : GuardedUnary process) :
    MonadicProtocol.Unary process := by
  induction guarded with
  | nil => exact .nil
  | par _ _ firstIH secondIH => exact .par firstIH secondIH
  | inp1 channel _ ih => exact .inp1 _ ih
  | out1 channel datum => exact .out1 _ _
  | nu _ ih => exact .nu ih
  | server channel _ ih => exact .rep (.inp1 _ ih)

/-- Unsupported source constructors are rejected by the option result.
Every successful result already carries independently derived rho sorting,
scope and semantic-normalization facts. -/
def compile : {Γ : Ctx sig} → {depth : Nat} → World Γ depth → Proc Γ → Option (Code depth)
  | _, _, _, .var _ => none
  | _, depth, _, .op .nil .nil => some (Code.zero depth)
  | _, _, world, .op .par (.cons first (.cons second .nil)) => do
      let firstCode ← compile world first
      let secondCode ← compile world second
      pure (Code.par firstCode secondCode)
  | _, _, world, .op .inp1 (.cons channel (.cons body .nil)) => do
      let bodyCode ← compile (liftWorld world) body
      pure (Code.listen (evalName world channel) bodyCode)
  | _, _, _, .op .inp2 (.cons _ (.cons _ .nil)) => none
  | _, _, world, .op .out1 (.cons channel (.cons datum .nil)) =>
      some (Code.sendName (evalName world channel) (evalName world datum))
  | _, _, _, .op .out2 (.cons _ (.cons _ (.cons _ .nil))) => none
  | _, _, world, .op .nu (.cons body .nil) => do
      let bodyCode ← compile (liftWorld world) body
      pure (Code.reserve bodyCode)
  | _, _, world, .op .rep (.cons repeated .nil) =>
      match repeated with
      | .var _ => none
      | .op .nil .nil => none
      | .op .par (.cons _ (.cons _ .nil)) => none
      | .op .inp1 (.cons channel (.cons body .nil)) => do
          let handler ← compile (serverHandlerWorld world) body
          let storedHandler ← compile (storedHandlerWorld world) body
          pure (Code.reserve (waitingServer (evalName world channel) handler storedHandler))
      | .op .inp2 (.cons _ (.cons _ .nil)) => none
      | .op .out1 (.cons _ (.cons _ .nil)) => none
      | .op .out2 (.cons _ (.cons _ (.cons _ .nil))) => none
      | .op .nu (.cons _ .nil) => none
      | .op .rep (.cons _ .nil) => none
termination_by _ _ _ process => termSize process
decreasing_by all_goals simp only [termSize, argsSize]; omega

/-- Every process in the declared fragment has a concrete compiled result,
at every target scope and every supplied name environment. -/
theorem compile_guarded {Γ : Ctx sig} {process : Proc Γ} (guarded : GuardedUnary process) :
    ∀ {depth : Nat} (world : World Γ depth), ∃ code, compile world process = some code := by
  induction guarded with
  | nil => intro depth world; exact ⟨Code.zero depth, by simp [nil, compile]⟩
  | par _ _ firstIH secondIH =>
      intro depth world
      obtain ⟨first, firstEq⟩ := firstIH world
      obtain ⟨second, secondEq⟩ := secondIH world
      exact ⟨Code.par first second, by simp [par, compile, firstEq, secondEq]⟩
  | inp1 channel _ ih =>
      intro depth world
      obtain ⟨body, bodyEq⟩ := ih (liftWorld world)
      exact ⟨Code.listen (evalName world channel) body, by simp [inp1, compile, bodyEq]⟩
  | out1 channel datum =>
      intro depth world
      exact ⟨Code.sendName (evalName world channel) (evalName world datum), by simp [out1, compile]⟩
  | nu _ ih =>
      intro depth world
      obtain ⟨body, bodyEq⟩ := ih (liftWorld world)
      exact ⟨Code.reserve body, by simp [nu, compile, bodyEq]⟩
  | server channel _ ih =>
      intro depth world
      obtain ⟨handler, handlerEq⟩ := ih (serverHandlerWorld world)
      obtain ⟨storedHandler, storedEq⟩ := ih (storedHandlerWorld world)
      exact ⟨Code.reserve (waitingServer (evalName world channel) handler storedHandler),
        by simp [rep, inp1, compile, handlerEq, storedEq]⟩

end Mettapedia.Languages.ProcessCalculi.PolyadicPi.Bridges.RhoUnaryCompiler
