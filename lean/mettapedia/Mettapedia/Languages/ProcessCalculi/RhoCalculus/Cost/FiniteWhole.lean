import Mettapedia.GSLT.LanguageDef.Cost.FiniteReflection
import Mettapedia.GSLT.LanguageDef.WellSortedChecker
import Mettapedia.Languages.ProcessCalculi.RhoCalculus.Cost.FiniteContinuationControls
import Mettapedia.OSLF.MeTTaIL.ReflectiveEngine

/-!
# The finite synchronous Cost language with admitted reflection

The existing three-continuation profile generates both source equation
copies and an admitted reflective interpretation of its funded interaction.
The construction inhabits the existing validated language/reflection fibre.
One actual reflective firing requires equivalent channels, substitutes the
sent payload into a local dropped name, releases the distinct continuation,
and retains the remaining funding cell. Exact funding guards remain active.

This is the complete static theory and selected communication rule. The
source's separate contextual rule is not generated by this construction.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.RhoCalculus.Synchronous.FiniteWhole

open Mettapedia.GSLT.LanguageDef
open Mettapedia.GSLT.LanguageDef.WellSorted
open Mettapedia.GSLT.LanguageDef.ReflectionExtension
open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical
open Mettapedia.OSLF.MeTTaIL.ReflectiveEngine

/-- Synchronous communication uses the same quote/drop declaration and the
same selected rule name; its output constructor has the extra continuation. -/
def sourceReflection : AdmittedProfile rhoSyncCalc :=
  ⟨rhoReflectionProfile, by decide +kernel⟩

theorem equation_premiseFree (equation : Equation) (member : equation ∈ rhoSyncCalc.equations) :
    equation.premises = [] := by
  obtain rfl := List.mem_singleton.mp member
  rfl

theorem base_equation_sorted (equation : Equation) (member : equation ∈ rhoSyncCalc.equations) :
    EquationWellSorted communicationDecoration.generatedLanguage (costBaseEquation equation) := by
  obtain rfl := List.mem_singleton.mp member
  refine ⟨.base (costBaseSortName "Name"), ?_, ?_⟩ <;>
    exact checkHasType_sound (by decide +kernel)

theorem wrapped_equation_sorted (equation : Equation) (member : equation ∈ rhoSyncCalc.equations) :
    EquationWellSorted communicationDecoration.generatedLanguage
      (costWrappedEquation rhoSyncIGSLT equation) := by
  obtain rfl := List.mem_singleton.mp member
  refine ⟨.base (costBaseSortName "Name"), ?_, ?_⟩ <;>
    exact checkHasType_sound (by decide +kernel)

theorem language_valid : communicationDecoration.costWholeLanguage.validate = [] :=
  communicationDecoration.costWholeLanguage_validate rhoSyncContinuationRetyping.noDuplicates
    communicationDecoration_redexRetypable communicationDecoration_wrappable
    equation_premiseFree base_equation_sorted wrapped_equation_sorted

theorem reflection_witnesses (declaration : ReflectivePresentationDecl)
    (member : declaration ∈ sourceReflection.1.presentations) :
    Nonempty (LanguageDef.ReflectivePresentationWitness
      communicationDecoration.reflectiveRetypingLanguage
      (costBaseReflectivePresentationDecl declaration)) ∧
    Nonempty (LanguageDef.ReflectivePresentationWitness
      communicationDecoration.reflectiveRetypingLanguage
      (costWrappedReflectivePresentationDecl rhoSyncIGSLT declaration)) := by
  obtain rfl := List.mem_singleton.mp member
  constructor <;>
    exact LanguageDef.reflectivePresentationWitness_of_validate_eq_nil _ _ (by decide +kernel)

theorem reflection_valid : Mettapedia.OSLF.MeTTaIL.Reflection.validate
    communicationDecoration.costWholeLanguage
    (communicationDecoration.costWholeReflectionProfile sourceReflection.1) = [] :=
  communicationDecoration.costWholeReflectionProfile_validate
    rhoSyncContinuationRetyping.noDuplicates sourceReflection reflection_witnesses

/-- A constructive inhabitant of the pre-existing admitted reflection fibre. -/
def presentation : ValidatedReflectiveLanguageDef where
  core := ⟨communicationDecoration.costWholeLanguage, language_valid⟩
  reflection := ⟨communicationDecoration.costWholeReflectionProfile sourceReflection.1,
    reflection_valid⟩

theorem both_equations_retained : presentation.core.language.equations =
    [costBaseEquationDecl rhoQuoteDropEquation,
      costWrappedEquationDecl rhoSyncIGSLT rhoQuoteDropEquation] := rfl

theorem all_three_payloads_retained :
    communicationDecoration.costRetypedSourceContext =
      [(costSourceSchemaName "n", .base (costBaseSortName "Name")),
       (costSourceSchemaName "p", .base costWrappedSortName),
       (costSourceSchemaName "q", .base costWrappedSortName),
       (costSourceSchemaName "k", .base costWrappedSortName)] := by
  decide +kernel

def baseZero : Pattern := .apply (costBaseConstructorName "PZero") []
def zero : Pattern := .apply (costWrappedConstructorName "PZero") []
def canonicalChannel : Pattern := .apply (costBaseConstructorName "NQuote") [baseZero]
def expandedChannel : Pattern := .apply (costBaseConstructorName "NQuote")
  [.collection .hashBag [baseZero, baseZero] none]
def localBody : Pattern := .apply (costWrappedConstructorName "PDrop") [.bvar 0]
def afterOutput : Pattern := .collection .hashBag [zero, zero] none
def unitSignature : Pattern := .apply costSignatureUnitConstructorName []
def emptyStack : Pattern := .apply costTokenStackEmptyConstructorName []
def retainedTail : Pattern := .apply costTokenStackConsConstructorName [unitSignature, emptyStack]

def sourceWithStack (stack : Pattern) : Pattern := .apply costContactConstructorName
  [.apply costSignedConstructorName
    [.collection .hashBag
      [.apply (costBaseConstructorName "PInput") [expandedChannel, .lambda none localBody],
       .apply (costBaseConstructorName "POutputK") [canonicalChannel, zero, afterOutput]] none,
      unitSignature],
    .apply costFundingConstructorName [stack]]

def source : Pattern := sourceWithStack
  (.apply costTokenStackConsConstructorName [unitSignature, retainedTail])

def target : Pattern := .apply costContactConstructorName
  [.collection .hashBag [zero, afterOutput] none,
    .apply costFundingConstructorName [retainedTail]]

def wrongStack : Pattern := .apply costTokenStackConsConstructorName
  [.apply costSignatureProductConstructorName [unitSignature, unitSignature], retainedTail]

theorem source_typed : HasSort presentation.core.language FreeTypeContext.empty []
    source costWrappedSortName := checkHasType_sound (by decide +kernel)

theorem target_typed : HasSort presentation.core.language FreeTypeContext.empty []
    target costWrappedSortName := checkHasType_sound (by decide +kernel)

theorem ordinary_match_empty : matchPatternForRule presentation.core.language
    communicationDecoration.costWholeRedexRewrite source = [] := by
  decide +kernel

/-- The actual admitted reflective runtime both activates the sent process
at the local drop occurrence and releases the output continuation. -/
theorem reflective_reducts_exact : rewriteStepWithReflection presentation.reflection.1
    presentation.core.language source = [target] := by
  decide +kernel

theorem empty_stack_blocks : rewriteStepWithReflection presentation.reflection.1
    presentation.core.language (sourceWithStack emptyStack) = [] := by
  decide +kernel

theorem wrong_key_blocks : rewriteStepWithReflection presentation.reflection.1
    presentation.core.language (sourceWithStack wrongStack) = [] := by
  decide +kernel

#print axioms language_valid
#print axioms reflection_valid
#print axioms source_typed
#print axioms target_typed
#print axioms reflective_reducts_exact
#print axioms empty_stack_blocks
#print axioms wrong_key_blocks

end Mettapedia.Languages.ProcessCalculi.RhoCalculus.Synchronous.FiniteWhole
