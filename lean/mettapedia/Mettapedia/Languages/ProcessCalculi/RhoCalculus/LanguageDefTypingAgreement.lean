import Mettapedia.GSLT.LanguageDef.WellSorted
import Mettapedia.OSLF.MeTTaIL.DerivedPresentationSyntax

/-!
# Agreement of generic LanguageDef sorting with rho sorting

The generic judgment generated from constructor signatures accepts every term
of the established reflective-presentation judgment.  This is the first half
of the carrier agreement: it shows that moving to the generic structural
category loses none of the already formalized rho terms.
-/

namespace Mettapedia.Languages.ProcessCalculi.RhoCalculus.LanguageDefTypingAgreement

open Mettapedia.GSLT.LanguageDef.WellSorted
open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.DerivedPresentationSyntax

/-- Embed the established free-variable sort assignment into the generic
type-expression assignment. -/
def liftFreeSortContext (free : FreeSortContext) : FreeTypeContext :=
  fun name => (free name).map TypeExpr.base

/-- Embed the established de Bruijn sort stack into the generic type stack. -/
def liftBoundSortContext (bound : List String) : List TypeExpr :=
  bound.map TypeExpr.base

theorem liftFreeSortContext_eq_name_iff
    (free : FreeSortContext) (name sort : String) :
    liftFreeSortContext free name = some (.base sort) ↔
      free name = some sort := by
  simp [liftFreeSortContext]

theorem liftBoundSortContext_getElem?_eq_name_iff
    (bound : List String) (index : Nat) (sort : String) :
    (liftBoundSortContext bound)[index]? = some (.base sort) ↔
      bound[index]? = some sort := by
  simp [liftBoundSortContext]

mutual
  /-- Every established rho name derivation is generated by the exact
  constructor declarations of `rhoCalc`. -/
  theorem nameWellSorted_toLanguageDefHasSort
      {free : FreeSortContext} {bound : List String} {name : Pattern}
      (typed : NameWellSorted rhoReflectivePresentation free bound name) :
      HasSort rhoCalc (liftFreeSortContext free) (liftBoundSortContext bound)
        name "Name" := by
    cases typed with
    | @bvar bound index lookup =>
        apply HasType.bvar
        simpa [liftBoundSortContext, rhoReflectivePresentation] using
          congrArg (Option.map TypeExpr.base) lookup
    | @fvar bound name lookup =>
        apply HasType.fvar
        simpa [liftFreeSortContext, rhoReflectivePresentation] using
          congrArg (Option.map TypeExpr.base) lookup
    | quote processTyped =>
        exact rho_quote_hasSort
          (procWellSorted_toLanguageDefHasSort processTyped)

  /-- Every established rho process derivation is generated by the exact
  constructor declarations of `rhoCalc`. -/
  theorem procWellSorted_toLanguageDefHasSort
      {free : FreeSortContext} {bound : List String} {process : Pattern}
      (typed : ProcWellSorted rhoReflectivePresentation free bound process) :
      HasSort rhoCalc (liftFreeSortContext free) (liftBoundSortContext bound)
        process "Proc" := by
    cases typed with
    | @bvar bound index lookup =>
        apply HasType.bvar
        simpa [liftBoundSortContext, rhoReflectivePresentation] using
          congrArg (Option.map TypeExpr.base) lookup
    | @fvar bound name lookup =>
        apply HasType.fvar
        simpa [liftFreeSortContext, rhoReflectivePresentation] using
          congrArg (Option.map TypeExpr.base) lookup
    | unit =>
        exact rho_zero_hasSort _ _
    | drop nameTyped =>
        exact rho_drop_hasSort
          (nameWellSorted_toLanguageDefHasSort nameTyped)
    | output channelTyped payloadTyped =>
        exact rho_output_hasSort
          (nameWellSorted_toLanguageDefHasSort channelTyped)
          (procWellSorted_toLanguageDefHasSort payloadTyped)
    | @input bound channel body channelTyped bodyTyped =>
        apply rho_input_hasSort
          (nameWellSorted_toLanguageDefHasSort channelTyped)
        simpa [liftBoundSortContext, rhoReflectivePresentation,
          TypeExpr.name, TypeExpr.baseType] using
            procWellSorted_toLanguageDefHasSort bodyTyped
    | parallel processesTyped =>
        exact rho_parallel_hasSort
          (procListWellSorted_toLanguageDefElementsHaveType processesTyped)

  /-- List agreement for the parallel collection. -/
  theorem procListWellSorted_toLanguageDefElementsHaveType
      {free : FreeSortContext} {bound : List String}
      {processes : List Pattern}
      (typed : ProcListWellSorted rhoReflectivePresentation free bound processes) :
      ElementsHaveType rhoCalc (liftFreeSortContext free)
        (liftBoundSortContext bound) processes TypeExpr.proc := by
    cases typed with
    | nil => exact .nil _ _
    | cons processTyped processesTyped =>
        exact .cons (procWellSorted_toLanguageDefHasSort processTyped)
          (procListWellSorted_toLanguageDefElementsHaveType processesTyped)
end

/-! ## Representation invariants of the established carrier -/

mutual
  theorem nameWellSorted_object_canonical
      {free : FreeSortContext} {bound : List String} {name : Pattern}
      (typed : NameWellSorted rhoReflectivePresentation free bound name) :
      isObjectPattern name = true ∧
        name.hasCanonicalBinderMetadata = true := by
    cases typed with
    | bvar lookup | fvar lookup =>
        simp [isObjectPattern, Pattern.hasCanonicalBinderMetadata]
    | quote processTyped =>
        have properties := procWellSorted_object_canonical processTyped
        simpa [isObjectPattern, isObjectPatternList,
          Pattern.hasCanonicalBinderMetadata,
          Pattern.hasCanonicalBinderMetadataList] using properties

  theorem procWellSorted_object_canonical
      {free : FreeSortContext} {bound : List String} {process : Pattern}
      (typed : ProcWellSorted rhoReflectivePresentation free bound process) :
      isObjectPattern process = true ∧
        process.hasCanonicalBinderMetadata = true := by
    cases typed with
    | bvar lookup | fvar lookup | unit =>
        simp [isObjectPattern, isObjectPatternList,
          Pattern.hasCanonicalBinderMetadata,
          Pattern.hasCanonicalBinderMetadataList]
    | drop nameTyped =>
        have properties := nameWellSorted_object_canonical nameTyped
        simpa [isObjectPattern, isObjectPatternList,
          Pattern.hasCanonicalBinderMetadata,
          Pattern.hasCanonicalBinderMetadataList] using properties
    | output channelTyped payloadTyped =>
        have channelProperties := nameWellSorted_object_canonical channelTyped
        have payloadProperties := procWellSorted_object_canonical payloadTyped
        simp [isObjectPattern, isObjectPatternList,
          Pattern.hasCanonicalBinderMetadata,
          Pattern.hasCanonicalBinderMetadataList, channelProperties,
          payloadProperties]
    | input channelTyped bodyTyped =>
        have channelProperties := nameWellSorted_object_canonical channelTyped
        have bodyProperties := procWellSorted_object_canonical bodyTyped
        simp [isObjectPattern, isObjectPatternList,
          Pattern.hasCanonicalBinderMetadata,
          Pattern.hasCanonicalBinderMetadataList, channelProperties,
          bodyProperties]
    | parallel processesTyped =>
        have properties := procListWellSorted_object_canonical processesTyped
        simpa [isObjectPattern,
          Pattern.hasCanonicalBinderMetadata] using properties

  theorem procListWellSorted_object_canonical
      {free : FreeSortContext} {bound : List String}
      {processes : List Pattern}
      (typed : ProcListWellSorted rhoReflectivePresentation free bound processes) :
      isObjectPatternList processes = true ∧
        Pattern.hasCanonicalBinderMetadataList processes = true := by
    cases typed with
    | nil =>
        simp [isObjectPatternList, Pattern.hasCanonicalBinderMetadataList]
    | cons processTyped processesTyped =>
        have processProperties := procWellSorted_object_canonical processTyped
        have processesProperties :=
          procListWellSorted_object_canonical processesTyped
        simp [isObjectPatternList, Pattern.hasCanonicalBinderMetadataList,
          processProperties, processesProperties]
end

/-! ## Reflection on object patterns -/

mutual
  /-- An object-pattern derivation whose result type is rho's name type
  reflects to the established name judgment.  Keeping the result type
  explicit makes the proof inspect the authored grammar rule rather than
  relying on dependent elimination from a fixed result sort. -/
  theorem languageDefHasType_to_nameWellSorted
      {free : FreeSortContext} {bound : List String} {name : Pattern}
      {resultType : TypeExpr}
      (typed : HasType rhoCalc (liftFreeSortContext free)
        (liftBoundSortContext bound) name resultType)
      (resultType_eq : resultType = TypeExpr.name)
      (object : isObjectPattern name = true)
      (canonical : name.hasCanonicalBinderMetadata = true) :
      NameWellSorted rhoReflectivePresentation free bound name := by
    cases typed with
    | @bvar _ index _ lookup =>
        cases resultType_eq
        apply NameWellSorted.bvar
        exact (liftBoundSortContext_getElem?_eq_name_iff
          bound index "Name").mp lookup
    | @fvar _ name _ lookup =>
        cases resultType_eq
        apply NameWellSorted.fvar
        exact (liftFreeSortContext_eq_name_iff free name "Name").mp lookup
    | @constructor _ rule arguments membership notBare argumentsTyped =>
        simp [rhoCalc] at membership
        rcases membership with rfl | rfl | rfl | rfl | rfl | rfl
        · simp [TypeExpr.name, TypeExpr.baseType] at resultType_eq
        · simp [TypeExpr.name, TypeExpr.baseType] at resultType_eq
        · cases argumentsTyped with
          | @cons _ argument arguments parameter parameters expected
              representation parameterType argumentTyped argumentsTyped =>
              cases argumentsTyped
              have : expected = TypeExpr.proc := by
                simpa [parameterType?, TypeExpr.proc, TypeExpr.baseType] using
                  parameterType.symm
              subst expected
              simp [isObjectPattern, isObjectPatternList,
                Pattern.hasCanonicalBinderMetadata,
                Pattern.hasCanonicalBinderMetadataList] at object canonical
              exact NameWellSorted.quote
                (languageDefHasType_to_procWellSorted argumentTyped rfl
                  object canonical)
        · simp [TypeExpr.name, TypeExpr.baseType] at resultType_eq
        · simp [TypeExpr.name, TypeExpr.baseType] at resultType_eq
        · simp [TypeExpr.name, TypeExpr.baseType] at resultType_eq
    | lambda bodyTyped => cases resultType_eq
    | multiLambda bodyTyped => cases resultType_eq
    | subst bodyTyped replacementTyped =>
        simp [isObjectPattern] at object
    | collection elementsTyped => cases resultType_eq
    | @collectionConstructor _ rule parameterName collectionType elements rest
        elementType membership parameterShape elementsTyped =>
        simp [rhoCalc] at membership
        rcases membership with rfl | rfl | rfl | rfl | rfl | rfl
        · simp at parameterShape
        · simp [TypeExpr.name, TypeExpr.baseType] at parameterShape
        · simp [TypeExpr.proc, TypeExpr.baseType] at parameterShape
        · simp [TypeExpr.name, TypeExpr.baseType] at resultType_eq
        · simp at parameterShape
        · simp at parameterShape

  /-- Process-sort reflection, stated with an explicit result-type equality
  for the same dependent-elimination boundary as the name theorem. -/
  theorem languageDefHasType_to_procWellSorted
      {free : FreeSortContext} {bound : List String} {process : Pattern}
      {resultType : TypeExpr}
      (typed : HasType rhoCalc (liftFreeSortContext free)
        (liftBoundSortContext bound) process resultType)
      (resultType_eq : resultType = TypeExpr.proc)
      (object : isObjectPattern process = true)
      (canonical : process.hasCanonicalBinderMetadata = true) :
      ProcWellSorted rhoReflectivePresentation free bound process := by
    cases typed with
    | @bvar _ index _ lookup =>
        cases resultType_eq
        apply ProcWellSorted.bvar
        exact (liftBoundSortContext_getElem?_eq_name_iff
          bound index "Proc").mp lookup
    | @fvar _ name _ lookup =>
        cases resultType_eq
        apply ProcWellSorted.fvar
        exact (liftFreeSortContext_eq_name_iff free name "Proc").mp lookup
    | @constructor _ rule arguments membership notBare argumentsTyped =>
        simp [rhoCalc] at membership
        rcases membership with rfl | rfl | rfl | rfl | rfl | rfl
        · cases argumentsTyped
          exact ProcWellSorted.unit
        · cases argumentsTyped with
          | @cons _ argument arguments parameter parameters expected
              representation parameterType argumentTyped argumentsTyped =>
              cases argumentsTyped
              have expected_eq : expected = TypeExpr.name := by
                simpa [parameterType?, TypeExpr.name, TypeExpr.baseType] using
                  parameterType.symm
              subst expected
              simp [isObjectPattern, isObjectPatternList,
                Pattern.hasCanonicalBinderMetadata,
                Pattern.hasCanonicalBinderMetadataList] at object canonical
              exact ProcWellSorted.drop
                (languageDefHasType_to_nameWellSorted argumentTyped rfl
                  object canonical)
        · simp [TypeExpr.proc, TypeExpr.baseType] at resultType_eq
        · simp [UsesBareCollection, TypeExpr.bag, TypeExpr.proc,
            TypeExpr.baseType] at notBare
        · cases argumentsTyped with
          | @cons _ channel arguments parameter parameters channelType
              channelRepresentation channelParameterType channelTyped
              argumentsTyped =>
              cases argumentsTyped with
              | @cons _ payload arguments parameter parameters payloadType
                  payloadRepresentation payloadParameterType payloadTyped
                  argumentsTyped =>
                  cases argumentsTyped
                  have channelType_eq : channelType = TypeExpr.name := by
                    simpa [parameterType?, TypeExpr.name, TypeExpr.baseType]
                      using channelParameterType.symm
                  have payloadType_eq : payloadType = TypeExpr.proc := by
                    simpa [parameterType?, TypeExpr.proc, TypeExpr.baseType]
                      using payloadParameterType.symm
                  subst channelType
                  subst payloadType
                  simp [isObjectPattern, isObjectPatternList,
                    Pattern.hasCanonicalBinderMetadata,
                    Pattern.hasCanonicalBinderMetadataList] at object canonical
                  exact ProcWellSorted.output
                    (languageDefHasType_to_nameWellSorted channelTyped rfl
                      object.1 canonical.1)
                    (languageDefHasType_to_procWellSorted payloadTyped rfl
                      object.2 canonical.2)
        · cases argumentsTyped with
          | @cons _ channel arguments parameter parameters channelType
              channelRepresentation channelParameterType channelTyped
              argumentsTyped =>
              cases argumentsTyped with
              | @cons _ abstraction arguments parameter parameters bodyType
                  bodyRepresentation bodyParameterType abstractionTyped
                  argumentsTyped =>
                  cases argumentsTyped
                  have channelType_eq : channelType = TypeExpr.name := by
                    simpa [parameterType?, TypeExpr.name, TypeExpr.baseType]
                      using channelParameterType.symm
                  have bodyType_eq : bodyType =
                      TypeExpr.arrow TypeExpr.name TypeExpr.proc := by
                    simpa [parameterType?, TypeExpr.name, TypeExpr.proc,
                      TypeExpr.funType, TypeExpr.baseType] using
                        bodyParameterType.symm
                  subst channelType
                  subst bodyType
                  cases abstraction with
                  | lambda binder body =>
                      cases binder with
                      | none =>
                          cases abstractionTyped with
                          | lambda bodyTyped =>
                              simp [isObjectPattern, isObjectPatternList] at object
                              simp [Pattern.hasCanonicalBinderMetadata,
                                Pattern.hasCanonicalBinderMetadataList] at canonical
                              exact ProcWellSorted.input
                                (languageDefHasType_to_nameWellSorted channelTyped
                                  rfl object.1 canonical.1)
                                (languageDefHasType_to_procWellSorted bodyTyped
                                  rfl object.2 canonical.2)
                      | some binderName =>
                          simp [MatchesParameterRepresentation] at bodyRepresentation
                  | bvar index =>
                      simp [MatchesParameterRepresentation] at bodyRepresentation
                  | fvar name =>
                      simp [MatchesParameterRepresentation] at bodyRepresentation
                  | apply name arguments =>
                      simp [MatchesParameterRepresentation] at bodyRepresentation
                  | multiLambda arity binders body =>
                      simp [MatchesParameterRepresentation] at bodyRepresentation
                  | subst body replacement =>
                      simp [MatchesParameterRepresentation] at bodyRepresentation
                  | collection collectionType elements rest =>
                      simp [MatchesParameterRepresentation] at bodyRepresentation
    | lambda bodyTyped => cases resultType_eq
    | multiLambda bodyTyped => cases resultType_eq
    | subst bodyTyped replacementTyped =>
        simp [isObjectPattern] at object
    | collection elementsTyped => cases resultType_eq
    | @collectionConstructor _ rule parameterName collectionType elements rest
        elementType membership parameterShape elementsTyped =>
        simp [rhoCalc] at membership
        rcases membership with rfl | rfl | rfl | rfl | rfl | rfl
        · simp at parameterShape
        · simp [TypeExpr.name, TypeExpr.baseType] at parameterShape
        · simp [TypeExpr.proc, TypeExpr.baseType] at parameterShape
        · simp [TypeExpr.bag, TypeExpr.proc, TypeExpr.baseType] at parameterShape
          rcases parameterShape with ⟨rfl, rfl, rfl⟩
          cases rest with
          | none =>
              simp [isObjectPattern] at object
              simp [Pattern.hasCanonicalBinderMetadata] at canonical
              exact ProcWellSorted.parallel
                (languageDefElementsType_to_procListWellSorted elementsTyped rfl
                  object canonical)
          | some restName =>
              simp [isObjectPattern] at object
        · simp at parameterShape
        · simp at parameterShape

  /-- Element-list reflection with the element type kept explicit. -/
  theorem languageDefElementsType_to_procListWellSorted
      {free : FreeSortContext} {bound : List String}
      {processes : List Pattern} {elementType : TypeExpr}
      (typed : ElementsHaveType rhoCalc (liftFreeSortContext free)
        (liftBoundSortContext bound) processes elementType)
      (elementType_eq : elementType = TypeExpr.proc)
      (object : isObjectPatternList processes = true)
      (canonical : Pattern.hasCanonicalBinderMetadataList processes = true) :
      ProcListWellSorted rhoReflectivePresentation free bound processes := by
    cases typed with
    | nil => exact .nil
    | cons elementTyped elementsTyped =>
        cases elementType_eq
        simp only [isObjectPatternList, Bool.and_eq_true] at object
        obtain ⟨elementObject, elementsObject⟩ := object
        simp only [Pattern.hasCanonicalBinderMetadataList,
          Bool.and_eq_true] at canonical
        obtain ⟨elementCanonical, elementsCanonical⟩ := canonical
        exact .cons
          (languageDefHasType_to_procWellSorted elementTyped rfl
            elementObject elementCanonical)
          (languageDefElementsType_to_procListWellSorted elementsTyped rfl
            elementsObject elementsCanonical)
end

/-- On object patterns, generic sorting at rho's name sort reflects back to
the established name judgment. -/
theorem languageDefHasSort_to_nameWellSorted
    {free : FreeSortContext} {bound : List String} {name : Pattern}
    (typed : HasSort rhoCalc (liftFreeSortContext free)
      (liftBoundSortContext bound) name "Name")
    (object : isObjectPattern name = true)
    (canonical : name.hasCanonicalBinderMetadata = true) :
    NameWellSorted rhoReflectivePresentation free bound name :=
  languageDefHasType_to_nameWellSorted typed rfl object canonical

/-- On object patterns, generic sorting at rho's process sort reflects back
to the established process judgment. -/
theorem languageDefHasSort_to_procWellSorted
    {free : FreeSortContext} {bound : List String} {process : Pattern}
    (typed : HasSort rhoCalc (liftFreeSortContext free)
      (liftBoundSortContext bound) process "Proc")
    (object : isObjectPattern process = true)
    (canonical : process.hasCanonicalBinderMetadata = true) :
    ProcWellSorted rhoReflectivePresentation free bound process :=
  languageDefHasType_to_procWellSorted typed rfl object canonical

/-- List reflection for rho's parallel collection. -/
theorem languageDefElements_to_procListWellSorted
    {free : FreeSortContext} {bound : List String}
    {processes : List Pattern}
    (typed : ElementsHaveType rhoCalc (liftFreeSortContext free)
      (liftBoundSortContext bound) processes TypeExpr.proc)
    (object : isObjectPatternList processes = true)
    (canonical : Pattern.hasCanonicalBinderMetadataList processes = true) :
    ProcListWellSorted rhoReflectivePresentation free bound processes :=
  languageDefElementsType_to_procListWellSorted typed rfl object canonical

/-! ## Exact carrier agreement -/

/-- The established and declaration-derived rho name judgments coincide once
the generic schema language is restricted to semantic object patterns. -/
theorem nameWellSorted_iff_languageDefWellSorted
    {free : FreeSortContext} {bound : List String} {name : Pattern} :
    NameWellSorted rhoReflectivePresentation free bound name ↔
      HasSort rhoCalc (liftFreeSortContext free) (liftBoundSortContext bound)
          name "Name" ∧
        isObjectPattern name = true ∧
        name.hasCanonicalBinderMetadata = true := by
  constructor
  · intro typed
    have properties := nameWellSorted_object_canonical typed
    exact ⟨nameWellSorted_toLanguageDefHasSort typed, properties.1,
      properties.2⟩
  · rintro ⟨typed, object, canonical⟩
    exact languageDefHasSort_to_nameWellSorted typed object canonical

/-- The established and declaration-derived rho process judgments coincide
on exactly the same object-pattern boundary. -/
theorem procWellSorted_iff_languageDefWellSorted
    {free : FreeSortContext} {bound : List String} {process : Pattern} :
    ProcWellSorted rhoReflectivePresentation free bound process ↔
      HasSort rhoCalc (liftFreeSortContext free) (liftBoundSortContext bound)
          process "Proc" ∧
        isObjectPattern process = true ∧
        process.hasCanonicalBinderMetadata = true := by
  constructor
  · intro typed
    have properties := procWellSorted_object_canonical typed
    exact ⟨procWellSorted_toLanguageDefHasSort typed, properties.1,
      properties.2⟩
  · rintro ⟨typed, object, canonical⟩
    exact languageDefHasSort_to_procWellSorted typed object canonical

/-- Exact list-form agreement for rho's authored parallel collection. -/
theorem procListWellSorted_iff_languageDefElements
    {free : FreeSortContext} {bound : List String}
    {processes : List Pattern} :
    ProcListWellSorted rhoReflectivePresentation free bound processes ↔
      ElementsHaveType rhoCalc (liftFreeSortContext free)
          (liftBoundSortContext bound) processes TypeExpr.proc ∧
        isObjectPatternList processes = true ∧
        Pattern.hasCanonicalBinderMetadataList processes = true := by
  constructor
  · intro typed
    have properties := procListWellSorted_object_canonical typed
    exact ⟨procListWellSorted_toLanguageDefElementsHaveType typed,
      properties.1, properties.2⟩
  · rintro ⟨typed, object, canonical⟩
    exact languageDefElements_to_procListWellSorted typed object canonical

/-! ## Positive control -/

/-- The established closed input example is accepted by the generic
declaration-derived sorter through the agreement theorem. -/
example :
    HasSort rhoCalc (liftFreeSortContext FreeSortContext.empty) []
      (.apply "PInput"
        [.apply "NQuote" [.apply "PZero" []],
          .lambda none (.apply "PZero" [])]) "Proc" := by
  have typed :
      ProcWellSorted rhoReflectivePresentation FreeSortContext.empty []
        (.apply "PInput"
          [.apply "NQuote" [.apply "PZero" []],
            .lambda none (.apply "PZero" [])]) := by
    simpa [rhoReflectivePresentation] using
      (ProcWellSorted.input (NameWellSorted.quote ProcWellSorted.unit)
        ProcWellSorted.unit)
  simpa [liftBoundSortContext] using
    procWellSorted_toLanguageDefHasSort typed

end Mettapedia.Languages.ProcessCalculi.RhoCalculus.LanguageDefTypingAgreement
