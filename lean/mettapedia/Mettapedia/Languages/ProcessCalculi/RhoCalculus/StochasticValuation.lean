import Mettapedia.Languages.ProcessCalculi.RhoCalculus.Engine
import Mettapedia.OSLF.PathMap.Measure

/-!
# Additive stochastic valuations for rho-calculus communication

The executable rho engine returns a list of `COMM` reducts.  List positions,
rather than reduct values, are the elementary events: two distinct
communications may have the same residual process, and a stochastic semantics
must retain that multiplicity.

This file equips the finite set of indexed communication occurrences with the
existing Knuth--Skilling-style `PathMapValuation`.  Disjoint alternatives add,
independent finite event families multiply, and a constant occurrence rate
turns operational multiplicity into total transition hazard.

The resulting quantities are unnormalised hazards.  Race probabilities, when
needed, are obtained by normalising against the total exit hazard.
-/

namespace Mettapedia.Languages.ProcessCalculi.RhoCalculus.StochasticValuation

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.PathMap.Measure
open Mettapedia.OSLF.PathMap.PLNBridge
open Mettapedia.OSLF.PathMap.SolomonoffBridge
open Finset BigOperators
open scoped ENNReal

/-! ## Communication occurrences -/

/-- An elementary top-level `COMM` event is a position in the engine's
communication frontier.  Indexing preserves multiplicity when distinct
communications happen to produce equal residual processes. -/
abbrev CommOccurrence (elems : List Pattern) :=
  Fin (Engine.findAllComm elems).length

/-- The residual process produced by an indexed communication occurrence. -/
def CommOccurrence.residual {elems : List Pattern}
    (event : CommOccurrence elems) : Pattern :=
  (Engine.findAllComm elems).get event

/-- Occurrences whose residual process is exactly `target`.

This is a set of occurrence indices, not a set of residual values, so equal
residuals from different communications remain distinct events. -/
noncomputable def residualOccurrences (elems : List Pattern) (target : Pattern) :
    Finset (CommOccurrence elems) :=
  Finset.univ.filter fun event => event.residual = target

/-! ## Knuth--Skilling event valuation -/

/-- The additive valuation generated by nonnegative elementary-event rates. -/
@[reducible] noncomputable def eventValuation {Event : Type*} [DecidableEq Event]
    (rate : Event → ℝ≥0∞) : PathMapValuation Event :=
  mkWeightedValuation rate

/-- Total hazard of a finite event family. -/
noncomputable def eventHazard {Event : Type*} [DecidableEq Event]
    (rate : Event → ℝ≥0∞) (events : Finset Event) : ℝ≥0∞ :=
  ∑ event ∈ events, rate event

/-- The explicit finite hazard sum is exactly the weight assigned by the
repository's Knuth--Skilling valuation infrastructure. -/
theorem eventHazard_eq_eventValuation_weight
    {Event : Type*} [DecidableEq Event]
    (rate : Event → ℝ≥0∞) (events : Finset Event) :
    eventHazard rate events = (eventValuation rate).weight events := by
  rfl

/-- The empty event family has zero hazard. -/
theorem eventHazard_empty {Event : Type*} [DecidableEq Event]
    (rate : Event → ℝ≥0∞) :
    eventHazard rate ∅ = 0 := by
  simp [eventHazard]

/-- Knuth--Skilling sum rule for disjoint communication alternatives. -/
theorem eventHazard_union {Event : Type*} [DecidableEq Event]
    (rate : Event → ℝ≥0∞) (left right : Finset Event)
    (hDisjoint : Disjoint left right) :
    eventHazard rate (left ∪ right) =
      eventHazard rate left + eventHazard rate right := by
  exact Finset.sum_union hDisjoint

/-- Adding possible events cannot reduce total hazard. -/
theorem eventHazard_mono {Event : Type*} [DecidableEq Event]
    (rate : Event → ℝ≥0∞) {left right : Finset Event}
    (hSubset : left ⊆ right) :
    eventHazard rate left ≤ eventHazard rate right := by
  rw [eventHazard_eq_eventValuation_weight,
    eventHazard_eq_eventValuation_weight]
  exact pathMapValuation_weight_monotone (eventValuation rate) hSubset

/-- A singleton event has its elementary rate as hazard. -/
theorem eventHazard_singleton {Event : Type*} [DecidableEq Event]
    (rate : Event → ℝ≥0∞) (event : Event) :
    eventHazard rate {event} = rate event := by
  simp [eventHazard]

/-- At constant elementary rate, total hazard is rate times multiplicity. -/
theorem eventHazard_uniform {Event : Type*} [DecidableEq Event]
    (rate : ℝ≥0∞) (events : Finset Event) :
    eventHazard (fun _ => rate) events = events.card • rate := by
  simp [eventHazard]

/-- Independent finite event families obey the product rule.

This is the finite discrete Knuth--Skilling product law: the joint elementary
rate factors, so summing over all joint alternatives factors into the product
of the two marginal total hazards. -/
theorem independent_eventHazard_product
    {Left Right : Type*} [Fintype Left] [Fintype Right]
    [DecidableEq Left] [DecidableEq Right]
    (leftRate : Left → ℝ≥0∞) (rightRate : Right → ℝ≥0∞) :
    eventHazard (fun event : Left × Right =>
        leftRate event.1 * rightRate event.2) Finset.univ =
      eventHazard leftRate Finset.univ *
        eventHazard rightRate Finset.univ := by
  unfold eventHazard
  rw [← univ_product_univ, Finset.sum_product]
  rw [← Fintype.sum_mul_sum]

/-- WM-PLN evidence bridge: an event family's hazard is the total positive and
negative evidence assigned by the existing weighted PathMap construction,
for every query split. -/
theorem eventHazard_eq_weightedEvidence_total
    {Event : Type*} [DecidableEq Event]
    (rate : Event → ℝ≥0∞) (events query : Finset Event) :
    eventHazard rate events =
      (weightedPathEvidence rate events query).pos +
        (weightedPathEvidence rate events query).neg := by
  rw [eventHazard_eq_eventValuation_weight]
  exact weighted_valuation_eq_evidence_total rate events query

/-! ## From hazards to race probabilities -/

/-- Probability of one elementary event after normalising its hazard by the
total exit hazard. -/
noncomputable def raceProbability
    {Event : Type*} [Fintype Event] [DecidableEq Event]
    (rate : Event → ℝ≥0∞) (event : Event) : ℝ≥0∞ :=
  rate event / eventHazard rate Finset.univ

/-- Finite nonzero total hazard normalises the race probabilities to one. -/
theorem raceProbability_normalized
    {Event : Type*} [Fintype Event] [DecidableEq Event]
    (rate : Event → ℝ≥0∞)
    (hPositive : eventHazard rate Finset.univ ≠ 0)
    (hFinite : eventHazard rate Finset.univ ≠ ⊤) :
    ∑ event, raceProbability rate event = 1 := by
  unfold raceProbability
  calc
    (∑ event : Event, rate event / eventHazard rate Finset.univ) =
        (∑ event : Event, rate event) /
          eventHazard rate Finset.univ := by
      simp_rw [div_eq_mul_inv]
      exact (Finset.sum_mul (Finset.univ : Finset Event) rate
        (eventHazard rate Finset.univ)⁻¹).symm
    _ = eventHazard rate Finset.univ /
        eventHazard rate Finset.univ := by rfl
    _ = 1 := ENNReal.div_self hPositive hFinite

/-- Negative boundary: a zero-rate family cannot be normalised into a unit
probability distribution by the race construction. -/
theorem zeroRate_raceProbability_sum_zero
    {Event : Type*} [Fintype Event] [DecidableEq Event] :
    ∑ event : Event, raceProbability (fun _ => 0) event = 0 := by
  simp [raceProbability, eventHazard]

/-! ## Operational rho hazards -/

/-- Total top-level `COMM` exit hazard of a flat parallel bag. -/
noncomputable def commExitHazard (elems : List Pattern)
    (rate : CommOccurrence elems → ℝ≥0∞) : ℝ≥0∞ :=
  eventHazard rate Finset.univ

/-- Aggregate hazard of all `COMM` occurrences producing one residual value. -/
noncomputable def commResidualHazard (elems : List Pattern)
    (rate : CommOccurrence elems → ℝ≥0∞) (target : Pattern) : ℝ≥0∞ :=
  eventHazard rate (residualOccurrences elems target)

/-- A uniform per-occurrence rate converts the engine frontier length exactly
into the total exit hazard. -/
theorem commExitHazard_uniform (elems : List Pattern) (rate : ℝ≥0∞) :
    commExitHazard elems (fun _ => rate) =
      (Engine.findAllComm elems).length • rate := by
  rw [commExitHazard, eventHazard_uniform]
  simp

/-- A residual's aggregate hazard is its operational occurrence multiplicity
times the uniform elementary rate. -/
theorem commResidualHazard_uniform (elems : List Pattern)
    (target : Pattern) (rate : ℝ≥0∞) :
    commResidualHazard elems (fun _ => rate) target =
      (residualOccurrences elems target).card • rate := by
  exact eventHazard_uniform rate (residualOccurrences elems target)

/-! ## Identifiability boundaries -/

/-- Unit-rate hazard identifies event multiplicity exactly. -/
theorem unitRate_hazard_eq_card {Event : Type*} [DecidableEq Event]
    (events : Finset Event) :
    eventHazard (fun _ => 1) events = events.card := by
  simpa using eventHazard_uniform (1 : ℝ≥0∞) events

/-- Consequently, equal unit-rate hazards are equivalent to equal event counts. -/
theorem unitRate_hazard_eq_iff_card_eq
    {Left Right : Type*} [DecidableEq Left] [DecidableEq Right]
    (left : Finset Left) (right : Finset Right) :
    eventHazard (fun _ => 1) left = eventHazard (fun _ => 1) right ↔
      left.card = right.card := by
  rw [unitRate_hazard_eq_card, unitRate_hazard_eq_card]
  exact_mod_cast Iff.rfl

/-- Negative boundary: zero-rate events erase all multiplicity information. -/
theorem zeroRate_hazard_nonidentifiable
    {Left Right : Type*} [DecidableEq Left] [DecidableEq Right]
    (left : Finset Left) (right : Finset Right) :
    eventHazard (fun _ => 0) left = eventHazard (fun _ => 0) right := by
  simp [eventHazard]

/-! ## Operational multiplicity canary -/

/-- A closed quoted name used by the multiplicity canary. -/
def multiplicityCanaryName : Pattern :=
  .apply "NQuote" [.apply "PZero" []]

/-- One output used by the multiplicity canary. -/
def multiplicityCanaryOutput : Pattern :=
  .apply "POutput" [multiplicityCanaryName, .apply "PZero" []]

/-- One input used by the multiplicity canary. -/
def multiplicityCanaryInput : Pattern :=
  .apply "PInput"
    [multiplicityCanaryName, .lambda none (.apply "PZero" [])]

/-- Two indistinguishable outputs race for one input. -/
def duplicateCommunicationCanary : List Pattern :=
  [multiplicityCanaryOutput, multiplicityCanaryOutput,
    multiplicityCanaryInput]

/-- One output racing for the same input. -/
def singleCommunicationCanary : List Pattern :=
  [multiplicityCanaryOutput, multiplicityCanaryInput]

/-- One output racing against `multiplicity` identical matching inputs. -/
def repeatedCommunicationCanary (multiplicity : Nat) : List Pattern :=
  multiplicityCanaryOutput ::
    List.replicate multiplicity multiplicityCanaryInput

private theorem repeatedInput_zipIdx_fst
    {multiplicity start index : Nat} {entry : Pattern}
    (membership :
      (entry, index) ∈
        (List.replicate multiplicity multiplicityCanaryInput).zipIdx start) :
    entry = multiplicityCanaryInput := by
  have indexed := List.mem_zipIdx membership
  simpa using indexed.2.2

private theorem repeatedInput_findInputPartner_length
    (multiplicity : Nat) :
    (Engine.findInputPartner multiplicityCanaryName
      (List.replicate multiplicity multiplicityCanaryInput)).length =
        multiplicity := by
  unfold Engine.findInputPartner
  let indexed :=
    (List.replicate multiplicity multiplicityCanaryInput).zipIdx
  let select : Pattern × Nat → Option (Nat × Pattern) := fun item =>
    match Engine.matchInput item.1 with
    | some (name, body) =>
        if semanticNormalizeName multiplicityCanaryName ==
            semanticNormalizeName name then
          some (item.2, body)
        else none
    | none => none
  let selected : Pattern × Nat → Nat × Pattern := fun item =>
    (item.2, .apply "PZero" [])
  have filterMap_eq : indexed.filterMap select = indexed.map selected := by
    apply List.filterMap_eq_map_iff_forall_eq_some.mpr
    intro item membership
    rcases item with ⟨entry, index⟩
    have entry_eq := repeatedInput_zipIdx_fst membership
    subst entry
    simp [select, selected, multiplicityCanaryInput,
      multiplicityCanaryName, Engine.matchInput,
      semanticNormalizeName, semanticNormalizeProc]
  change (indexed.filterMap select).length = multiplicity
  rw [filterMap_eq]
  simp [indexed]

private def engineContribution (whole : List Pattern)
    (item : Pattern × Nat) : List Pattern :=
  match Engine.matchOutput item.1 with
  | none => []
  | some (name, payload) =>
    let withoutOutput := whole.eraseIdx item.2
    let partners := Engine.findInputPartner name withoutOutput
    partners.map fun partner =>
      let rest := withoutOutput.eraseIdx partner.1
      Pattern.collection .hashBag
        ([semanticCommSubst partner.2 payload] ++ rest) none

private theorem repeatedInput_noOutputContributions
    (whole : List Pattern) (multiplicity start : Nat) :
    (List.map (engineContribution whole)
      ((List.replicate multiplicity multiplicityCanaryInput).zipIdx start)).flatten =
        [] := by
  apply List.flatten_eq_nil_iff.mpr
  intro contribution membership
  rw [List.mem_map] at membership
  obtain ⟨⟨entry, index⟩, entryMembership, rfl⟩ := membership
  have entry_eq := repeatedInput_zipIdx_fst entryMembership
  subst entry
  simp [engineContribution, multiplicityCanaryInput, Engine.matchOutput]

/-- The executable engine exposes one occurrence per matching input, including
when every resulting residual value is identical. -/
theorem repeatedCommunicationCanary_frontier_length (multiplicity : Nat) :
    (Engine.findAllComm (repeatedCommunicationCanary multiplicity)).length =
      multiplicity := by
  unfold repeatedCommunicationCanary Engine.findAllComm
  simp only [List.zipIdx_cons, List.map_cons, Engine.matchOutput,
    multiplicityCanaryOutput, List.flatten_cons, List.length_append,
    List.length_map]
  rw [List.eraseIdx_zero]
  simp only [List.tail_cons]
  rw [repeatedInput_findInputPartner_length]
  simp only [Nat.zero_add]
  have tailEmpty := repeatedInput_noOutputContributions
    (Pattern.apply "POutput"
      [multiplicityCanaryName, Pattern.apply "PZero" []] ::
        List.replicate multiplicity multiplicityCanaryInput)
    multiplicity 1
  change multiplicity +
    (List.map (engineContribution
      (Pattern.apply "POutput"
        [multiplicityCanaryName, Pattern.apply "PZero" []] ::
          List.replicate multiplicity multiplicityCanaryInput))
      ((List.replicate multiplicity multiplicityCanaryInput).zipIdx 1)).flatten.length =
        multiplicity
  rw [tailEmpty]
  simp

/-- The engine retains both operational witnesses even though the two
communications have the same residual value. -/
theorem duplicateCommunicationCanary_frontier :
    Engine.findAllComm duplicateCommunicationCanary =
      [(Pattern.collection .hashBag
          [.apply "PZero" [], multiplicityCanaryOutput] none),
       (Pattern.collection .hashBag
          [.apply "PZero" [], multiplicityCanaryOutput] none)] := by
  rfl

/-- The single-witness control has exactly one communication occurrence. -/
theorem singleCommunicationCanary_frontier :
    Engine.findAllComm singleCommunicationCanary =
      [(Pattern.collection .hashBag [.apply "PZero" []] none)] := by
  rfl

/-- At elementary rate `rate`, the duplicate frontier has hazard
`rate + rate`. -/
theorem duplicateCommunicationCanary_hazard (rate : ℝ≥0∞) :
    commExitHazard duplicateCommunicationCanary (fun _ => rate) =
      rate + rate := by
  rw [commExitHazard_uniform]
  simp [duplicateCommunicationCanary_frontier, two_mul]

/-- The single-witness control has hazard exactly `rate`. -/
theorem singleCommunicationCanary_hazard (rate : ℝ≥0∞) :
    commExitHazard singleCommunicationCanary (fun _ => rate) = rate := by
  rw [commExitHazard_uniform]
  simp [singleCommunicationCanary_frontier]

/-- Positive comparison: at a nonzero finite elementary rate, the duplicate
frontier's total hazard differs from the single frontier's hazard. -/
theorem duplicateCommunicationCanary_detected
    (rate : ℝ≥0∞) (hRate : rate ≠ 0) (hFinite : rate ≠ ⊤) :
    commExitHazard duplicateCommunicationCanary (fun _ => rate) ≠
      commExitHazard singleCommunicationCanary (fun _ => rate) := by
  rw [duplicateCommunicationCanary_hazard,
    singleCommunicationCanary_hazard]
  exact ne_of_gt (ENNReal.lt_add_right hFinite hRate)

/-- Negative control: if elementary events are assigned zero rate, operational
multiplicity cannot be recovered from aggregate hazard. -/
theorem duplicateCommunicationCanary_zeroRate_collapses :
    commExitHazard duplicateCommunicationCanary (fun _ => 0) =
      commExitHazard singleCommunicationCanary (fun _ => 0) := by
  rw [duplicateCommunicationCanary_hazard,
    singleCommunicationCanary_hazard]
  simp

end Mettapedia.Languages.ProcessCalculi.RhoCalculus.StochasticValuation
