import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.EqualityOnTheStep.SetTheory

/-!
# Respect terms generated by type structure

A family of sets is transported along extensional equality only with a respect term
(`Codes.respType`). This module computes respect terms from the structure of a family, as
observational type theory computes coercions, but outside the knowledge: the generated terms are
ordinary terms of the calculus, and the knowledge is not changed.

**The class** (`FamCode`, `WF`). A code builds a family of sets from:

* membership `S a`, at a term `a : U0` of the parameters (`mem`);
* a type that does not depend on the set (`const`);
* functions `F S → G S` (`arrow`), and non-membership `F S → ⊥` as a derived code (`FamCode.neg`);
* pairs `F S × G S` (`prod`);
* `Π (x : A). F S x` and `Σ (x : A). F S x` over a type `A` of the parameters (`pi`, `sigma`), so the
  family may quantify over `U0` and use membership at the bound variable.

The set occurs only as the head of a membership: the code never reads the set's code. A family's
instance at a set is `inst c σ S`, at parameters `σ`; its family term is `famOf c = λS. inst c S`.

**The generator** (`tr`). For each code, a forward transport along `e : setEq S T` from `inst c S` to
`inst c T`, and a backward one: membership uses the two components of the evidence; a function
transports its argument backward and its result forward; pairs and quantifiers transport componentwise.

**The theorems.**

* `tr_typed`: for every well-formed code, at every typed substitution of its parameters, both
  transports are typed, for any sets and evidence.
* `respOf_typed`: the closed respect term `respOf c = λS T e m. tr c S T e m` has type
  `respType (famOf c)`; so it is a respect term in the sense of `Transport`, and the transport firing
  of `Transport.transportBy` is admitted for every family of the class (`transport_by_code`).
* The families of the membership and non-membership codes are the families of `Transport` and
  `SetTheory` (`memberCode_family`, `negCode_family`); subset of a fixed set (`subsetCode`) and
  extensional equality with a fixed set (`eqToCode`) are in the class too.

**The boundary** (`idFamily_outside`). The intensional identity family `λR. Id (U0 → U0) R S` of
`Controls` is not the family of any code over the empty context, not even up to the knowledge's
equality: such a code would give it a respect term, and `Controls.idFamily_no_respect` shows it has
none. The identity type reads the set as a term, while a code uses the set only as the head of a
membership.

Coherence of the generated transports is in `RespectCoherence` (along reflexivity they are the
identity) and `RespectComposition` (along composite evidence they compose).
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting
namespace EqualityOnTheStep.Options.Respect

open _root_.CategoryTheory Interface
open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.UniverseLevel
open Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId
open Presentation TypedEquality TypedEquality.Normalization TypedContextual
open ContextualDependentEta
open Interface.DependentFull Interface.DependentFull.Controls
open ProgrammingOnTheStep.SetExtensionality (small U0 sCode tCode setType swapCode swapType
  swapBackType setType_formed s_typed t_typed swap_typed swapBack_typed)

/-! ## Codes of families -/

/-- **The codes of families of sets**, over `n` parameters. -/
inductive FamCode : Nat → Type
  | mem {n : Nat} (a : Tower.Tm n) : FamCode n
  | const {n : Nat} (B : Tower.Tm n) : FamCode n
  | arrow {n : Nat} (F G : FamCode n) : FamCode n
  | prod {n : Nat} (F G : FamCode n) : FamCode n
  | pi {n : Nat} (A : Tower.Tm n) (F : FamCode (n + 1)) : FamCode n
  | sigma {n : Nat} (A : Tower.Tm n) (F : FamCode (n + 1)) : FamCode n

/-- **Non-membership**: `F S → ⊥`. -/
def FamCode.neg {n : Nat} (F : FamCode n) : FamCode n := .arrow F (.const SetTheory.emptyType)

/-- **A well-formed code** over a context of parameters. -/
def WF : {n : Nat} → Tower.Ctx n → FamCode n → Prop
  | _, Γ, .mem a => Typed Tower.rules Γ a U0
  | _, Γ, .const B => Typed Tower.rules Γ B (.head large)
  | _, Γ, .arrow F G => WF Γ F ∧ WF Γ G
  | _, Γ, .prod F G => WF Γ F ∧ WF Γ G
  | _, Γ, .pi A F => Typed Tower.rules Γ A (.head large) ∧ WF (.snoc Γ A) F
  | _, Γ, .sigma A F => Typed Tower.rules Γ A (.head large) ∧ WF (.snoc Γ A) F

/-- Parameters read one binder further. -/
def wkSub {n m : Nat} (σ : Presentation.Sub Tower.Head n m) : Presentation.Sub Tower.Head n (m + 1) :=
  fun i => Presentation.rename wk (σ i)

/-- **The instance of a family** at the set `S`, with parameters `σ`. -/
def inst : {n m : Nat} → FamCode n → Presentation.Sub Tower.Head n m → Tower.Tm m → Tower.Tm m
  | _, _, .mem a, σ, S => .app S (subst σ a)
  | _, _, .const B, σ, _ => subst σ B
  | _, _, .arrow F G, σ, S => .pi (inst F σ S) (Presentation.rename wk (inst G σ S))
  | _, _, .prod F G, σ, S => .sigma (inst F σ S) (Presentation.rename wk (inst G σ S))
  | _, _, .pi A F, σ, S => .pi (subst σ A) (inst F (liftSub σ) (Presentation.rename wk S))
  | _, _, .sigma A F, σ, S => .sigma (subst σ A) (inst F (liftSub σ) (Presentation.rename wk S))

/-! ## Instances commute with substitution -/

theorem inst_subst {n : Nat} (c : FamCode n) :
    ∀ {m k : Nat} (σ : Presentation.Sub Tower.Head n m) (τ : Presentation.Sub Tower.Head m k) (S : Tower.Tm m),
      subst τ (inst c σ S) = inst c (subComp τ σ) (subst τ S) := by
  induction c with
  | mem a =>
      intro m k σ τ S
      show Presentation.Tm.app (subst τ S) (subst τ (subst σ a)) = .app (subst τ S) (subst (subComp τ σ) a)
      rw [subst_subComp]
  | const B =>
      intro m k σ τ S
      show subst τ (subst σ B) = subst (subComp τ σ) B
      rw [subst_subComp]
  | arrow F G ihF ihG =>
      intro m k σ τ S
      show Presentation.Tm.pi (subst τ (inst F σ S)) (subst (liftSub τ) (Presentation.rename wk (inst G σ S))) =
        .pi (inst F (subComp τ σ) (subst τ S)) (Presentation.rename wk (inst G (subComp τ σ) (subst τ S)))
      rw [subst_liftSub_wk, ihF, ihG]
  | prod F G ihF ihG =>
      intro m k σ τ S
      show Presentation.Tm.sigma (subst τ (inst F σ S)) (subst (liftSub τ) (Presentation.rename wk (inst G σ S))) =
        .sigma (inst F (subComp τ σ) (subst τ S)) (Presentation.rename wk (inst G (subComp τ σ) (subst τ S)))
      rw [subst_liftSub_wk, ihF, ihG]
  | pi A F ihF =>
      intro m k σ τ S
      show Presentation.Tm.pi (subst τ (subst σ A)) (subst (liftSub τ) (inst F (liftSub σ) (Presentation.rename wk S))) =
        .pi (subst (subComp τ σ) A) (inst F (liftSub (subComp τ σ)) (Presentation.rename wk (subst τ S)))
      rw [subst_subComp, ihF, liftSub_subComp, subst_liftSub_wk]
  | sigma A F ihF =>
      intro m k σ τ S
      show Presentation.Tm.sigma (subst τ (subst σ A)) (subst (liftSub τ) (inst F (liftSub σ) (Presentation.rename wk S))) =
        .sigma (subst (subComp τ σ) A) (inst F (liftSub (subComp τ σ)) (Presentation.rename wk (subst τ S)))
      rw [subst_subComp, ihF, liftSub_subComp, subst_liftSub_wk]

theorem inst_rename {n m k : Nat} (c : FamCode n) (σ : Presentation.Sub Tower.Head n m) (ρ : Presentation.Ren m k)
    (S : Tower.Tm m) :
    Presentation.rename ρ (inst c σ S) = inst c (fun i => Presentation.rename ρ (σ i)) (Presentation.rename ρ S) := by
  have same : subComp (renSub ρ) σ = fun i => Presentation.rename ρ (σ i) :=
    funext fun i => subst_renSub ρ (σ i)
  rw [← subst_renSub ρ (inst c σ S), inst_subst, same, subst_renSub]

/-- Opening the instance of a family under one binder at a term. -/
theorem inst0_inst {n m : Nat} (c : FamCode (n + 1)) (σ : Presentation.Sub Tower.Head n m) (u S : Tower.Tm m) :
    inst0 u (inst c (liftSub σ) (Presentation.rename wk S)) = inst c (consSub u σ) S := by
  have same : subComp (subst0 u) (liftSub σ) = consSub u σ := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · rfl
    · exact inst0_rename_wk u (σ j)
  have back : subst (subst0 u) (Presentation.rename wk S) = S := inst0_rename_wk u S
  show subst (subst0 u) (inst c (liftSub σ) (Presentation.rename wk S)) = inst c (consSub u σ) S
  rw [inst_subst, same, back]

/-- Opening a binder at its own variable, after weakening under it. -/
theorem open_weakened {n : Nat} (C : Tower.Tm (n + 1)) :
    inst0 (.var 0) (Presentation.rename (liftRen wk) C) = C := by
  show subst (subst0 (.var 0)) (Presentation.rename (liftRen wk) C) = C
  rw [subst_rename]
  have ident : (fun i => subst0 (.var 0 : Tower.Tm (n + 1)) (liftRen wk i)) = ids := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · rfl
    · rfl
  rw [ident, subst_ids]

theorem setEq_rename {m k : Nat} (ρ : Presentation.Ren m k) (S T : Tower.Tm m) :
    Presentation.rename ρ (setEq S T) = setEq (Presentation.rename ρ S) (Presentation.rename ρ T) := by
  simp only [setEq, Presentation.rename, rename_liftRen_wk]
  rfl

theorem rename_wk_subst {n m : Nat} (σ : Presentation.Sub Tower.Head n m) (t : Tower.Tm n) :
    Presentation.rename wk (subst σ t) = subst (wkSub σ) t :=
  rename_subst wk σ t

theorem rename_wk_eq {n : Nat} (t : Tower.Tm n) : Presentation.rename wk t = subst (wkSub ids) t := by
  rw [← rename_wk_subst, subst_ids]

/-! ## Typed substitutions read further, and formation -/

theorem substMor_wk {n m : Nat} {Γ : Tower.Ctx n} {Δ : Tower.Ctx m} {σ : Presentation.Sub Tower.Head n m}
    (hσ : SubstMor Tower.rules Γ Δ σ) (A : Tower.Tm m) :
    SubstMor Tower.rules Γ (.snoc Δ A) (wkSub σ) := by
  intro i
  have moved : Typed Tower.rules (.snoc Δ A) (Presentation.rename wk (σ i))
      (Presentation.rename wk (subst σ (Ctx.lookup Γ i))) := (hσ i).weaken
  rw [rename_subst] at moved
  exact moved

/-- **Every instance of a well-formed code is a type of `U1`.** -/
theorem inst_formed {n : Nat} (c : FamCode n) :
    ∀ {Γ : Tower.Ctx n}, WF Γ c → ∀ {m : Nat} {Δ : Tower.Ctx m} {σ : Presentation.Sub Tower.Head n m},
      SubstMor Tower.rules Γ Δ σ → ∀ {S : Tower.Tm m}, Typed Tower.rules Δ S setType →
        Typed Tower.rules Δ (inst c σ S) (.head large) := by
  induction c with
  | mem a =>
      intro Γ wf m Δ σ hσ S hS
      have wfa : Typed Tower.rules Γ a U0 := wf
      exact .cumul (Run.app_small hS (wfa.substitute hσ)) small_large
  | const B =>
      intro Γ wf m Δ σ hσ S hS
      have wfB : Typed Tower.rules Γ B (.head large) := wf
      exact wfB.substitute hσ
  | arrow F G ihF ihG =>
      intro Γ wf m Δ σ hσ S hS
      obtain ⟨wfF, wfG⟩ := wf
      exact .cumul (.piForm (ihF wfF hσ hS) (.sort _) (ihG wfG hσ hS).weaken (.sort _) (.sorts _ _))
        large_of_one_one
  | prod F G ihF ihG =>
      intro Γ wf m Δ σ hσ S hS
      obtain ⟨wfF, wfG⟩ := wf
      exact .cumul (.sigmaForm (ihF wfF hσ hS) (.sort _) (ihG wfG hσ hS).weaken (.sort _) (.sorts _ _))
        large_of_one_one
  | pi A F ihF =>
      intro Γ wf m Δ σ hσ S hS
      obtain ⟨wfA, wfF⟩ := wf
      exact .cumul (.piForm (wfA.substitute hσ) (.sort _) (ihF wfF (hσ.lift A) hS.weaken) (.sort _) (.sorts _ _))
        large_of_one_one
  | sigma A F ihF =>
      intro Γ wf m Δ σ hσ S hS
      obtain ⟨wfA, wfF⟩ := wf
      exact .cumul (.sigmaForm (wfA.substitute hσ) (.sort _) (ihF wfF (hσ.lift A) hS.weaken) (.sort _) (.sorts _ _))
        large_of_one_one

/-! ## The generator -/

/-- The component of the evidence a direction uses: the forward map (`true`) or the backward map. -/
def proj {m : Nat} : Bool → Tower.Tm m → Tower.Tm m
  | true, p => .fst p
  | false, p => .snd p

/-- **The transport of a code** along `e : setEq S T`: forward (`true`) from `inst c S` to
`inst c T`, backward (`false`) from `inst c T` to `inst c S`, applied to `x`. -/
def tr : {n m : Nat} → Bool → FamCode n → Presentation.Sub Tower.Head n m → Tower.Tm m → Tower.Tm m →
    Tower.Tm m → Tower.Tm m → Tower.Tm m
  | _, _, d, .mem a, σ, _, _, e, x => .app (proj d (.app e (subst σ a))) x
  | _, _, _, .const _, _, _, _, _, x => x
  | _, _, d, .arrow F G, σ, S, T, e, x =>
      .lam (tr d G (wkSub σ) (Presentation.rename wk S) (Presentation.rename wk T) (Presentation.rename wk e)
        (.app (Presentation.rename wk x)
          (tr (!d) F (wkSub σ) (Presentation.rename wk S) (Presentation.rename wk T) (Presentation.rename wk e) (.var 0))))
  | _, _, d, .prod F G, σ, S, T, e, x => .pair (tr d F σ S T e (.fst x)) (tr d G σ S T e (.snd x))
  | _, _, d, .pi _ F, σ, S, T, e, x =>
      .lam (tr d F (liftSub σ) (Presentation.rename wk S) (Presentation.rename wk T) (Presentation.rename wk e)
        (.app (Presentation.rename wk x) (.var 0)))
  | _, _, d, .sigma _ F, σ, S, T, e, x => .pair (.fst x) (tr d F (consSub (.fst x) σ) S T e (.snd x))

/-! ## Membership, in the universal frame -/

/-- The empty substitution. -/
def noSub {m : Nat} : Presentation.Sub Tower.Head 0 m := fun i => i.elim0

theorem noSub_typed {m : Nat} (Δ : Tower.Ctx m) : SubstMor Tower.rules .nil Δ noSub := fun i => i.elim0

/-- The frame `S T : U0 → U0, e : setEq S T, a : U0`. -/
abbrev memCtx : Tower.Ctx 4 :=
  .snoc (.snoc (.snoc (.snoc .nil setType) setType) (setEq (.var 1) (.var 0))) U0

/-- The substitution of the membership frame by two sets, evidence and a term of `U0`. -/
theorem memSubst {m : Nat} {Δ : Tower.Ctx m} {S T e a : Tower.Tm m} (hS : Typed Tower.rules Δ S setType)
    (hT : Typed Tower.rules Δ T setType) (he : Typed Tower.rules Δ e (setEq S T)) (ha : Typed Tower.rules Δ a U0) :
    SubstMor Tower.rules memCtx Δ (consSub a (consSub e (consSub T (consSub S noSub)))) :=
  ((((noSub_typed Δ).cons setType hS).cons setType hT).cons (setEq (.var 1) (.var 0)) he).cons U0 ha

/-- Forward membership: `fst (e a) x : T a` from `x : S a`. -/
theorem mem_fwd_universal : Typed Tower.rules (.snoc memCtx (.app (.var 3) (.var 0)))
    (.app (.fst (.app (.var 2) (.var 1))) (.var 0)) (.app (.var 3) (.var 1)) := by
  have e : Typed Tower.rules (.snoc memCtx (.app (.var 3) (.var 0))) (.var 2) (setEq (.var 4) (.var 3)) :=
    Derivable.var 2
  have a : Typed Tower.rules (.snoc memCtx (.app (.var 3) (.var 0))) (.var 1) U0 := Derivable.var 1
  have both : Typed Tower.rules (.snoc memCtx (.app (.var 3) (.var 0))) (.app (.var 2) (.var 1))
      (.sigma (.pi (.app (.var 4) (.var 1)) (.app (.var 4) (.var 2)))
        (.pi (.app (.var 4) (.var 2)) (.app (.var 6) (.var 3)))) := Derivable.appElim e a
  have forward : Typed Tower.rules (.snoc memCtx (.app (.var 3) (.var 0))) (.fst (.app (.var 2) (.var 1)))
      (.pi (.app (.var 4) (.var 1)) (.app (.var 4) (.var 2))) := Derivable.fstElim both
  have x : Typed Tower.rules (.snoc memCtx (.app (.var 3) (.var 0))) (.var 0) (.app (.var 4) (.var 1)) :=
    Derivable.var 0
  exact Derivable.appElim forward x

/-- Backward membership: `snd (e a) x : S a` from `x : T a`. -/
theorem mem_bwd_universal : Typed Tower.rules (.snoc memCtx (.app (.var 2) (.var 0)))
    (.app (.snd (.app (.var 2) (.var 1))) (.var 0)) (.app (.var 4) (.var 1)) := by
  have e : Typed Tower.rules (.snoc memCtx (.app (.var 2) (.var 0))) (.var 2) (setEq (.var 4) (.var 3)) :=
    Derivable.var 2
  have a : Typed Tower.rules (.snoc memCtx (.app (.var 2) (.var 0))) (.var 1) U0 := Derivable.var 1
  have both : Typed Tower.rules (.snoc memCtx (.app (.var 2) (.var 0))) (.app (.var 2) (.var 1))
      (.sigma (.pi (.app (.var 4) (.var 1)) (.app (.var 4) (.var 2)))
        (.pi (.app (.var 4) (.var 2)) (.app (.var 6) (.var 3)))) := Derivable.appElim e a
  have backward : Typed Tower.rules (.snoc memCtx (.app (.var 2) (.var 0))) (.snd (.app (.var 2) (.var 1)))
      (.pi (.app (.var 3) (.var 1)) (.app (.var 5) (.var 2))) := Derivable.sndElim both
  have x : Typed Tower.rules (.snoc memCtx (.app (.var 2) (.var 0))) (.var 0) (.app (.var 3) (.var 1)) :=
    Derivable.var 0
  exact Derivable.appElim backward x

/-! ## The generated transports are typed -/

/-- **Both transports of a code are typed** at a substitution, sets and evidence. -/
def Transports {n m : Nat} (c : FamCode n) (Δ : Tower.Ctx m) (σ : Presentation.Sub Tower.Head n m)
    (S T e : Tower.Tm m) : Prop :=
  (∀ {x : Tower.Tm m}, Typed Tower.rules Δ x (inst c σ S) → Typed Tower.rules Δ (tr true c σ S T e x) (inst c σ T)) ∧
    (∀ {x : Tower.Tm m}, Typed Tower.rules Δ x (inst c σ T) → Typed Tower.rules Δ (tr false c σ S T e x) (inst c σ S))

/-- The evidence read one binder further. -/
theorem evidence_weaken {m : Nat} {Δ : Tower.Ctx m} {S T e A : Tower.Tm m}
    (he : Typed Tower.rules Δ e (setEq S T)) :
    Typed Tower.rules (.snoc Δ A) (Presentation.rename wk e)
      (setEq (Presentation.rename wk S) (Presentation.rename wk T)) := by
  have moved : Typed Tower.rules (.snoc Δ A) (Presentation.rename wk e) (Presentation.rename wk (setEq S T)) :=
    he.weaken
  rw [setEq_rename] at moved
  exact moved

/-- **The generator is typed**: for every well-formed code, at every typed substitution of its
parameters, sets `S`, `T` and evidence `e : setEq S T`, the forward transport takes a term of
`inst c S` to one of `inst c T`, and the backward transport the converse. -/
theorem tr_typed {n : Nat} (c : FamCode n) :
    ∀ {Γ : Tower.Ctx n}, WF Γ c → ∀ {m : Nat} {Δ : Tower.Ctx m} {σ : Presentation.Sub Tower.Head n m},
      SubstMor Tower.rules Γ Δ σ → ∀ {S T e : Tower.Tm m}, Typed Tower.rules Δ S setType →
        Typed Tower.rules Δ T setType → Typed Tower.rules Δ e (setEq S T) → Transports c Δ σ S T e := by
  induction c with
  | mem a =>
      intro Γ wf m Δ σ hσ S T e hS hT he
      have wfa : Typed Tower.rules Γ a U0 := wf
      have ha : Typed Tower.rules Δ (subst σ a) U0 := wfa.substitute hσ
      exact ⟨fun hx => mem_fwd_universal.substitute ((memSubst hS hT he ha).cons _ hx),
        fun hx => mem_bwd_universal.substitute ((memSubst hS hT he ha).cons _ hx)⟩
  | const B =>
      intro Γ wf m Δ σ hσ S T e hS hT he
      exact ⟨fun hx => hx, fun hx => hx⟩
  | arrow F G ihF ihG =>
      intro Γ wf m Δ σ hσ S T e hS hT he
      have formedS := inst_formed (.arrow F G) wf hσ hS
      have formedT := inst_formed (.arrow F G) wf hσ hT
      obtain ⟨wfF, wfG⟩ := wf
      refine ⟨fun {x} hx => ?_, fun {x} hx => ?_⟩
      · have hσ' := substMor_wk hσ (inst F σ T)
        have IHF := ihF wfF hσ' hS.weaken hT.weaken (evidence_weaken he)
        have IHG := ihG wfG hσ' hS.weaken hT.weaken (evidence_weaken he)
        have y0 : Typed Tower.rules (.snoc Δ (inst F σ T)) (.var 0) (inst F (wkSub σ) (Presentation.rename wk T)) := by
          have v : Typed Tower.rules (.snoc Δ (inst F σ T)) (.var 0) (Presentation.rename wk (inst F σ T)) :=
            Derivable.var 0
          rw [inst_rename] at v
          exact v
        have xw : Typed Tower.rules (.snoc Δ (inst F σ T)) (Presentation.rename wk x)
            (.pi (inst F (wkSub σ) (Presentation.rename wk S))
              (Presentation.rename wk (inst G (wkSub σ) (Presentation.rename wk S)))) := by
          have w : Typed Tower.rules (.snoc Δ (inst F σ T)) (Presentation.rename wk x)
              (.pi (Presentation.rename wk (inst F σ S))
                (Presentation.rename (liftRen wk) (Presentation.rename wk (inst G σ S)))) := hx.weaken
          rw [rename_liftRen_wk, inst_rename F σ wk S, inst_rename G σ wk S] at w
          exact w
        have applied := Derivable.appElim xw (IHF.2 y0)
        rw [inst0_rename_wk] at applied
        have z := IHG.1 applied
        have z' : Typed Tower.rules (.snoc Δ (inst F σ T))
            (tr true G (wkSub σ) (Presentation.rename wk S) (Presentation.rename wk T) (Presentation.rename wk e)
              (.app (Presentation.rename wk x)
                (tr false F (wkSub σ) (Presentation.rename wk S) (Presentation.rename wk T) (Presentation.rename wk e)
                  (.var 0))))
            (Presentation.rename wk (inst G σ T)) := by
          rw [inst_rename]
          exact z
        exact .lamIntro formedT (.sort _) z'
      · have hσ' := substMor_wk hσ (inst F σ S)
        have IHF := ihF wfF hσ' hS.weaken hT.weaken (evidence_weaken he)
        have IHG := ihG wfG hσ' hS.weaken hT.weaken (evidence_weaken he)
        have y0 : Typed Tower.rules (.snoc Δ (inst F σ S)) (.var 0) (inst F (wkSub σ) (Presentation.rename wk S)) := by
          have v : Typed Tower.rules (.snoc Δ (inst F σ S)) (.var 0) (Presentation.rename wk (inst F σ S)) :=
            Derivable.var 0
          rw [inst_rename] at v
          exact v
        have xw : Typed Tower.rules (.snoc Δ (inst F σ S)) (Presentation.rename wk x)
            (.pi (inst F (wkSub σ) (Presentation.rename wk T))
              (Presentation.rename wk (inst G (wkSub σ) (Presentation.rename wk T)))) := by
          have w : Typed Tower.rules (.snoc Δ (inst F σ S)) (Presentation.rename wk x)
              (.pi (Presentation.rename wk (inst F σ T))
                (Presentation.rename (liftRen wk) (Presentation.rename wk (inst G σ T)))) := hx.weaken
          rw [rename_liftRen_wk, inst_rename F σ wk T, inst_rename G σ wk T] at w
          exact w
        have applied := Derivable.appElim xw (IHF.1 y0)
        rw [inst0_rename_wk] at applied
        have z := IHG.2 applied
        have z' : Typed Tower.rules (.snoc Δ (inst F σ S))
            (tr false G (wkSub σ) (Presentation.rename wk S) (Presentation.rename wk T) (Presentation.rename wk e)
              (.app (Presentation.rename wk x)
                (tr true F (wkSub σ) (Presentation.rename wk S) (Presentation.rename wk T) (Presentation.rename wk e)
                  (.var 0))))
            (Presentation.rename wk (inst G σ S)) := by
          rw [inst_rename]
          exact z
        exact .lamIntro formedS (.sort _) z'
  | prod F G ihF ihG =>
      intro Γ wf m Δ σ hσ S T e hS hT he
      have formedS := inst_formed (.prod F G) wf hσ hS
      have formedT := inst_formed (.prod F G) wf hσ hT
      obtain ⟨wfF, wfG⟩ := wf
      have IHF := ihF wfF hσ hS hT he
      have IHG := ihG wfG hσ hS hT he
      refine ⟨fun {x} hx => ?_, fun {x} hx => ?_⟩
      · have hx' : Typed Tower.rules Δ x (.sigma (inst F σ S) (Presentation.rename wk (inst G σ S))) := hx
        have second := Derivable.sndElim hx'
        rw [inst0_rename_wk] at second
        have moved := IHG.1 second
        have moved' : Typed Tower.rules Δ (tr true G σ S T e (.snd x))
            (inst0 (tr true F σ S T e (.fst x)) (Presentation.rename wk (inst G σ T))) := by
          rw [inst0_rename_wk]
          exact moved
        exact .pairIntro formedT (.sort _) (IHF.1 (Derivable.fstElim hx')) moved'
      · have hx' : Typed Tower.rules Δ x (.sigma (inst F σ T) (Presentation.rename wk (inst G σ T))) := hx
        have second := Derivable.sndElim hx'
        rw [inst0_rename_wk] at second
        have moved := IHG.2 second
        have moved' : Typed Tower.rules Δ (tr false G σ S T e (.snd x))
            (inst0 (tr false F σ S T e (.fst x)) (Presentation.rename wk (inst G σ S))) := by
          rw [inst0_rename_wk]
          exact moved
        exact .pairIntro formedS (.sort _) (IHF.2 (Derivable.fstElim hx')) moved'
  | pi A F ihF =>
      intro Γ wf m Δ σ hσ S T e hS hT he
      have formedS := inst_formed (.pi A F) wf hσ hS
      have formedT := inst_formed (.pi A F) wf hσ hT
      obtain ⟨_, wfF⟩ := wf
      have IHF := ihF wfF (hσ.lift A) hS.weaken hT.weaken (evidence_weaken he)
      refine ⟨fun {x} hx => ?_, fun {x} hx => ?_⟩
      · have w : Typed Tower.rules (.snoc Δ (subst σ A)) (Presentation.rename wk x)
            (.pi (Presentation.rename wk (subst σ A))
              (Presentation.rename (liftRen wk) (inst F (liftSub σ) (Presentation.rename wk S)))) := hx.weaken
        have arg := Derivable.appElim w (Derivable.var 0)
        rw [open_weakened] at arg
        exact .lamIntro formedT (.sort _) (IHF.1 arg)
      · have w : Typed Tower.rules (.snoc Δ (subst σ A)) (Presentation.rename wk x)
            (.pi (Presentation.rename wk (subst σ A))
              (Presentation.rename (liftRen wk) (inst F (liftSub σ) (Presentation.rename wk T)))) := hx.weaken
        have arg := Derivable.appElim w (Derivable.var 0)
        rw [open_weakened] at arg
        exact .lamIntro formedS (.sort _) (IHF.2 arg)
  | sigma A F ihF =>
      intro Γ wf m Δ σ hσ S T e hS hT he
      have formedS := inst_formed (.sigma A F) wf hσ hS
      have formedT := inst_formed (.sigma A F) wf hσ hT
      obtain ⟨_, wfF⟩ := wf
      refine ⟨fun {x} hx => ?_, fun {x} hx => ?_⟩
      · have hx' : Typed Tower.rules Δ x (.sigma (subst σ A) (inst F (liftSub σ) (Presentation.rename wk S))) := hx
        have first : Typed Tower.rules Δ (.fst x) (subst σ A) := Derivable.fstElim hx'
        have IHF := ihF wfF (hσ.cons A first) hS hT he
        have second := Derivable.sndElim hx'
        rw [inst0_inst] at second
        have moved := IHF.1 second
        have moved' : Typed Tower.rules Δ (tr true F (consSub (.fst x) σ) S T e (.snd x))
            (inst0 (.fst x) (inst F (liftSub σ) (Presentation.rename wk T))) := by
          rw [inst0_inst]
          exact moved
        exact .pairIntro formedT (.sort _) first moved'
      · have hx' : Typed Tower.rules Δ x (.sigma (subst σ A) (inst F (liftSub σ) (Presentation.rename wk T))) := hx
        have first : Typed Tower.rules Δ (.fst x) (subst σ A) := Derivable.fstElim hx'
        have IHF := ihF wfF (hσ.cons A first) hS hT he
        have second := Derivable.sndElim hx'
        rw [inst0_inst] at second
        have moved := IHF.2 second
        have moved' : Typed Tower.rules Δ (tr false F (consSub (.fst x) σ) S T e (.snd x))
            (inst0 (.fst x) (inst F (liftSub σ) (Presentation.rename wk S))) := by
          rw [inst0_inst]
          exact moved
        exact .pairIntro formedS (.sort _) first moved'

/-! ## Families and their generated respect terms -/

/-- **The family of a code**: `λS. inst c S`, over the parameters. -/
def famOf {n : Nat} (c : FamCode n) : Tower.Tm n := .lam (inst c (wkSub ids) (.var 0))

theorem famOf_typed {n : Nat} {Γ : Tower.Ctx n} {c : FamCode n} (wf : WF Γ c) :
    Typed Tower.rules Γ (famOf c) famType :=
  .lamIntro (famType_formed Γ) (.sort _)
    (inst_formed c wf (substMor_wk (SubstMor.identity Γ) setType) (Derivable.var 0))

/-- **A substituted family applied to a set is the instance**, in the knowledge. -/
theorem famOf_subst_app {n m : Nat} {Γ : Tower.Ctx n} {Δ : Tower.Ctx m} {c : FamCode n} (wf : WF Γ c)
    {σ : Presentation.Sub Tower.Head n m} (hσ : SubstMor Tower.rules Γ Δ σ) {S : Tower.Tm m}
    (hS : Typed Tower.rules Δ S setType) :
    Equal Tower.rules Δ (.app (subst σ (famOf c)) S) (inst c σ S) (.head large) := by
  have hbody : subst (liftSub σ) (inst c (wkSub ids) (.var 0)) = inst c (wkSub σ) (.var 0) := by
    rw [inst_subst]
    rfl
  have hopen : inst0 S (inst c (wkSub σ) (.var 0)) = inst c σ S := by
    show subst (subst0 S) (inst c (wkSub σ) (.var 0)) = inst c σ S
    rw [inst_subst]
    have same : subComp (subst0 S) (wkSub σ) = σ := funext fun i => inst0_rename_wk S (σ i)
    rw [same]
    rfl
  have body := inst_formed c wf (substMor_wk hσ setType) (Derivable.var 0)
  have beta := Derivable.betaPi (famType_formed Δ) (.sort _) body hS
  rw [hopen] at beta
  show Equal Tower.rules Δ (.app (.lam (subst (liftSub σ) (inst c (wkSub ids) (.var 0)))) S) (inst c σ S)
    (.head large)
  rw [hbody]
  exact beta

/-- Parameters read four binders further. -/
def shift4 {n : Nat} : Presentation.Sub Tower.Head n (n + 4) := wkSub (wkSub (wkSub (wkSub ids)))

/-- **The generated respect term**: `λS T e m. tr c S T e m`. -/
def respOf {n : Nat} (c : FamCode n) : Tower.Tm n :=
  .lam (.lam (.lam (.lam (tr true c shift4 (.var 3) (.var 2) (.var 1) (.var 0)))))

theorem rename_four {n : Nat} (t : Tower.Tm n) :
    Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk t))) =
      subst shift4 t := by
  rw [rename_wk_eq t, rename_wk_subst, rename_wk_subst, rename_wk_subst]
  rfl

/-- **The body of the generated respect term is typed**: over `Γ, S T : U0 → U0, e : setEq S T,
m : P S`, the transport of `m` has type `P T`. -/
theorem respOf_body_typed {n : Nat} {Γ : Tower.Ctx n} {c : FamCode n} (wf : WF Γ c) :
    Typed Tower.rules
      (.snoc (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
        (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))) (.var 2)))
      (tr true c shift4 (.var 3) (.var 2) (.var 1) (.var 0))
      (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))))
        (.var 2)) := by
  have hσ : SubstMor Tower.rules Γ
      (.snoc (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
        (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))) (.var 2)))
      shift4 :=
    substMor_wk (substMor_wk (substMor_wk (substMor_wk (SubstMor.identity Γ) _) _) _) _
  have hS : Typed Tower.rules
      (.snoc (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
        (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))) (.var 2)))
      (.var 3) setType := Derivable.var 3
  have hT : Typed Tower.rules
      (.snoc (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
        (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))) (.var 2)))
      (.var 2) setType := Derivable.var 2
  have he : Typed Tower.rules
      (.snoc (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
        (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))) (.var 2)))
      (.var 1) (setEq (.var 3) (.var 2)) := Derivable.var 1
  have atS : Equal Tower.rules
      (.snoc (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
        (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))) (.var 2)))
      (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))))
        (.var 3))
      (inst c shift4 (.var 3)) (.head large) := by
    rw [rename_four]
    exact famOf_subst_app wf hσ hS
  have atT : Equal Tower.rules
      (.snoc (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
        (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))) (.var 2)))
      (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))))
        (.var 2))
      (inst c shift4 (.var 2)) (.head large) := by
    rw [rename_four]
    exact famOf_subst_app wf hσ hT
  have hm : Typed Tower.rules
      (.snoc (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
        (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (famOf c)))) (.var 2)))
      (.var 0) (inst c shift4 (.var 3)) := .conv (Derivable.var 0) atS (.sort _)
  have moved := (tr_typed c wf hσ hS hT he).1 hm
  exact Derivable.conv moved (.symm atT) (.sort _)

/-- **The generated term is a respect term** for the family of the code. -/
theorem respOf_typed {n : Nat} {Γ : Tower.Ctx n} {c : FamCode n} (wf : WF Γ c) :
    Typed Tower.rules Γ (respOf c) (respType (famOf c)) := by
  have tP := famOf_typed wf
  exact .lamIntro (respType_formed tP) (.sort _) (.lamIntro (respSecond_formed tP) (.sort _)
    (.lamIntro (respThird_formed tP) (.sort _) (.lamIntro (respInner_formed tP) (.sort _) (respOf_body_typed wf))))

/-! ## The boundary: the identity family is outside -/

/-- The respect type of a family respects the knowledge's equality of families. -/
theorem respType_congr {n : Nat} {Γ : Tower.Ctx n} {P P' : Tower.Tm n}
    (same : Equal Tower.rules Γ P P' famType) :
    Equal Tower.rules Γ (respType P) (respType P') (.head large) := by
  have s3 : Equal Tower.rules (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
      (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk P)))
      (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk P'))) famType :=
    same.weaken.weaken.weaken
  have dom : Equal Tower.rules (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
      (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk P))) (.var 2))
      (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk P'))) (.var 2)) (.head large) :=
    .appCong s3 (.refl (Derivable.var 2))
  have s4 : Equal Tower.rules (.snoc (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
        (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk P))) (.var 2)))
      (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk P))))
      (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk P')))) famType :=
    s3.weaken
  have cod : Equal Tower.rules (.snoc (.snoc (.snoc (.snoc Γ setType) setType) (setEq (.var 1) (.var 0)))
        (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk P))) (.var 2)))
      (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk P)))) (.var 2))
      (.app (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk (Presentation.rename wk P')))) (.var 2))
      (.head large) :=
    .appCong s4 (.refl (Derivable.var 2))
  have inner := Derivable.cumulEq (.piCong dom (.sort _) cod (.sort _) (.sorts _ _)) large_of_one_one
  have third := Derivable.cumulEq (.piCong (.refl (setEq_formed (Derivable.var 1) (Derivable.var 0))) (.sort _) inner
    (.sort _) (.sorts _ _)) large_of_one_one
  have second := Derivable.cumulEq (.piCong (.refl (setType_large _)) (.sort _) third (.sort _) (.sorts _ _))
    large_of_one_one
  exact Derivable.cumulEq (.piCong (.refl (setType_large _)) (.sort _) second (.sort _) (.sorts _ _))
    large_of_one_one

/-- **The identity family is outside the class**: no code's family equals it, even in the knowledge,
since that code's respect term would be a respect term of the identity family. -/
theorem idFamily_outside {c : FamCode 0} (wf : WF .nil c) :
    ¬ Equal Tower.rules .nil (famOf c) Controls.idFamily famType := by
  intro same
  exact Controls.idFamily_no_respect (.conv (respOf_typed wf) (respType_congr same) (.sort _))

/-! ## Examples -/

/-- Membership at the variable `X` of `X : U0, x : X, g : Ground`. -/
def memberCode : FamCode 3 := .mem (.var 2)

theorem memberCode_wf : WF triple.raw memberCode := (Derivable.var 2 : Typed Tower.rules triple.raw (.var 2) U0)

/-- **The generator reproduces membership**: its family is `Transport.memberFamily`. -/
theorem memberCode_family : famOf memberCode = Transport.memberFamily (.var 2 : Tower.Tm 3) := rfl

theorem memberCode_respect :
    Typed Tower.rules triple.raw (respOf memberCode) (respType (Transport.memberFamily (.var 2 : Tower.Tm 3))) :=
  respOf_typed memberCode_wf

/-- Non-membership at `X`. -/
def negCode : FamCode 3 := memberCode.neg

theorem negCode_wf : WF triple.raw negCode :=
  ⟨memberCode_wf, (SetTheory.emptyType_formed _ : Typed Tower.rules triple.raw SetTheory.emptyType (.head large))⟩

/-- **The generator reproduces non-membership**: its family is `SetTheory.negFamily`. -/
theorem negCode_family : famOf negCode = SetTheory.negFamily (.var 2 : Tower.Tm 3) := rfl

theorem negCode_respect :
    Typed Tower.rules triple.raw (respOf negCode) (respType (SetTheory.negFamily (.var 2 : Tower.Tm 3))) :=
  respOf_typed negCode_wf

/-- `G X`, the membership of `X` in `G = {X | Ground}`, over `X : U0`. -/
theorem groundMember_typed : Typed Tower.rules (.snoc .nil U0) (.app SetTheory.groundSet (.var 0)) (.head large) :=
  .cumul (Run.app_small (SetTheory.groundSet_typed _) (Derivable.var 0)) small_large

/-- **Subset of `G`**: `Π (X : U0). S X → G X`. -/
def subsetCode : FamCode 0 := .pi U0 (.arrow (.mem (.var 0)) (.const (.app SetTheory.groundSet (.var 0))))

theorem subsetCode_wf : WF .nil subsetCode :=
  ⟨.headType (.sort _), (Derivable.var 0 : Typed Tower.rules (.snoc .nil U0) (.var 0) U0), groundMember_typed⟩

theorem subsetCode_respect : Typed Tower.rules .nil (respOf subsetCode) (respType (famOf subsetCode)) :=
  respOf_typed subsetCode_wf

/-- **Extensional equality with `G`**: `Π (X : U0). (S X → G X) × (G X → S X)`. -/
def eqToCode : FamCode 0 :=
  .pi U0 (.prod (.arrow (.mem (.var 0)) (.const (.app SetTheory.groundSet (.var 0))))
    (.arrow (.const (.app SetTheory.groundSet (.var 0))) (.mem (.var 0))))

theorem eqToCode_wf : WF .nil eqToCode :=
  ⟨.headType (.sort _), ⟨(Derivable.var 0 : Typed Tower.rules (.snoc .nil U0) (.var 0) U0), groundMember_typed⟩,
    groundMember_typed, (Derivable.var 0 : Typed Tower.rules (.snoc .nil U0) (.var 0) U0)⟩

theorem eqToCode_respect : Typed Tower.rules .nil (respOf eqToCode) (respType (famOf eqToCode)) :=
  respOf_typed eqToCode_wf

/-! ## Transport by one firing, for every code -/

/-- **The classifier of a code**: its family, its generated respect term, two sets, evidence and a
member, as a substitution into `Transport.Omega`. -/
def classifier (Γ : Context Tower.rules) (c : FamCode Γ.arity) (wf : WF Γ.raw c) {S T E M : Tower.Tm Γ.arity}
    (hS : Typed Tower.rules Γ.raw S setType) (hT : Typed Tower.rules Γ.raw T setType)
    (hE : Typed Tower.rules Γ.raw E (setEq S T)) (hM : Typed Tower.rules Γ.raw M (.app (famOf c) S)) :
    Γ ⟶ Transport.Omega :=
  pair (pair (pair (pair (pair (pair (toEmpty Γ) ⟨famOf c, famOf_typed wf⟩) ⟨respOf c, respOf_typed wf⟩)
    ⟨S, hS⟩) ⟨T, hT⟩) ⟨E, hE⟩) ⟨M, hM⟩

/-- **Every family of the class transports by one firing**, with its generated respect term: the
firing is admitted, and it makes `respOf c S T E M` at the type `famOf c T`. -/
theorem transport_by_code (Γ : Context Tower.rules) (c : FamCode Γ.arity) (wf : WF Γ.raw c)
    {S T E M : Tower.Tm Γ.arity}
    (hS : Typed Tower.rules Γ.raw S setType) (hT : Typed Tower.rules Γ.raw T setType)
    (hE : Typed Tower.rules Γ.raw E (setEq S T)) (hM : Typed Tower.rules Γ.raw M (.app (famOf c) S)) :
    (step setting.levels Nat).Admits
        (Transport.transportBy (Transport.classified Γ (classifier Γ c wf hS hT hE hM)) 0 1 2
          (classifier Γ c wf hS hT hE hM)) ∧
      (Transport.transportedRow.reindex (classifier Γ c wf hS hT hE hM)).2.code =
        .app (.app (.app (.app (respOf c) S) T) E) M ∧
      (Transport.transportedRow.reindex (classifier Γ c wf hS hT hE hM)).1.code = .app (famOf c) T :=
  ⟨Transport.classified_transport_admitted Γ _, rfl, rfl⟩

