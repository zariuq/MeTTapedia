import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Step.RunRearrangement
import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Step.InterchangeTraceControls

/-!
# Event identity in witnessed native run comparisons

The existing publication-step controls give genuine admitted interchanges.
Two identical firing labels still occupy two positions: exchanging them is
a nonidentity comparison of a run with itself. Forgetting the comparison
retains only the old trace proposition. A separate singleton control requires
similarity and cannot be generated by interchanges alone.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Interface.RunRearrangementControls

open _root_.CategoryTheory
open Transport.RunRearrangement
open InterchangeTraceControls (P T pairRun admitted)

def pairSwap : T.InterchangeWitness (pairRun false true) (pairRun true false) :=
  Transport.InterchangeWitness.here (T := T) (admitted [] false) (admitted [] true)
    (admitted _ true) (admitted _ false) ⟨rfl⟩ (.nil _)

def pairCell : Cell T (pairRun false true) (pairRun true false) := generator T (.inr pairSwap)

def firstEvent (first second : Bool) : Fin (pairRun first second).word.length :=
  ⟨0, by simp [pairRun, Step.Run.word]⟩

def secondEvent (first second : Bool) : Fin (pairRun first second).word.length :=
  ⟨1, by simp [pairRun, Step.Run.word]⟩

theorem swaps_two_positions :
    (events T pairCell (firstEvent false true)).val = 1 ∧
      (events T pairCell (secondEvent false true)).val = 0 := by
  constructor <;> rfl

theorem pair_has_distinct_execution_words :
    (pairRun false true).word ≠ (pairRun true false).word := by decide

def duplicateSwap : T.InterchangeWitness (pairRun false false) (pairRun false false) :=
  Transport.InterchangeWitness.here (T := T) (admitted [] false) (admitted [] false)
    (admitted _ false) (admitted _ false) ⟨rfl⟩ (.nil _)

def duplicateCell : Cell T (pairRun false false) (pairRun false false) :=
  generator T (.inr duplicateSwap)

theorem duplicate_events_are_exchanged :
    (events T duplicateCell (firstEvent false false)).val = 1 ∧
      (events T duplicateCell (secondEvent false false)).val = 0 := by
  constructor <;> rfl

theorem duplicate_cell_is_not_identity : duplicateCell ≠ 𝟙 (object T (pairRun false false)) := by
  intro same
  have observed := congrArg (fun cell : Cell T (pairRun false false) (pairRun false false) =>
    (events T cell (firstEvent false false)).val) same
  have left : (events T duplicateCell (firstEvent false false)).val = 1 := duplicate_events_are_exchanged.1
  rw [left, events_id] at observed
  simp [firstEvent] at observed

theorem inverse_cancels_duplicate_cell :
    duplicateCell ≫ inv duplicateCell = 𝟙 (object T (pairRun false false)) := by simp

theorem similarity_is_needed :
    Nonempty (Cell T (EventTraceControls.run true) (EventTraceControls.run false)) ∧
      ¬ T.InterchangeClosure EventTraceControls.start
        (EventTraceControls.run true) (EventTraceControls.run false) := by
  have old := InterchangeTraceControls.old_trace_has_extra_identifications
  exact ⟨(nonempty_cell_iff _ _).mpr old.1, old.2⟩

end Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Interface.RunRearrangementControls

