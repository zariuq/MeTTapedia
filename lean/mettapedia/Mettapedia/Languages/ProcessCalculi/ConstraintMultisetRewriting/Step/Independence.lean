import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Step.Transport

/-!
# Independence of firings, defined semantically, and dependent traces

Two firings at one state are **independent** (`Transport.Independent`) when both are admitted, each
is still admitted after the other once transported along the other's result (its residual), and
the two composite results are in one state class. This is the diamond; it closes up to
isomorphism, so two firings that each create a fresh helper can commute only up to renaming the
helpers.

* **Swaps** (`SwapStep`): an adjacent pair, a firing then a firing alike to the residual of a second,
  becomes the second then a firing alike to the residual of the first; the rest of the run is
  carried along a similar run. Every swap swaps an independent pair (`swap_independent`), and every
  independent pair swaps in front of every continuation (`Independent.swap`).
* **Trace equivalence of dependent runs** (`TraceEquiv`): generated by swaps and by similarity.
  Equivalent runs end in one state class (`TraceEquiv.same_last`). It is a **congruence**: prefixing
  a run keeps it (`TraceEquiv.append_left`), and so does appending similar continuations at the two
  ends (`TraceEquiv.append_right`); traces are transported along isomorphisms of their start
  (`TraceEquiv.moveRun`, by naturality of residuals). Composition, concatenation after transport
  along the class isomorphism of the ends, is therefore well defined in both arguments
  (`TraceEquiv.comp`): these are the laws of the quotient of the free category of runs by traces.
* **Site accounts** (`TraceEquiv.account_eq`): a site account is a property of traces when its
  grades are invariant under transport, alikeness and residuals, and the grades of independent
  firings commute.
* **Deciding independence.** Where diamonds close whenever both orders are admitted (`Closes`),
  independence is exactly the four admissions (`independent_iff_admits`), so it is decided wherever
  admission is (`decidableIndependent`). Admission asks guards at every solution; at a principal
  answer a stable ask is decided by one evaluation, and equality guards are stable
  (`Frames.Principal.entails_iff`, `Frames.Principal.entails_models_iff`, in `PrincipalAnswers`).
  Elsewhere a **three-valued check** (`Check`) answers independent, dependent or unknown, and never
  answers either of the first two wrongly (`Check.ofTests`). A check from a decision never answers
  unknown (`Check.ofDecidable_ne_unknown`).

No definition here chooses a solution. Knowledge is a store of residual equations; admission asks
over every solution in every later frame; independence compares classes of states. An undecidable
unification problem therefore leaves independence defined, and leaves a check free to answer
unknown.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Interface

universe uO uT uH uOcc uS uF uI

namespace Transport

variable {Obj : Type uO} {Tm : Obj → Type uT} {Hom : Obj → Obj → Type uH}
  {X : Frames Tm Hom} {O : Type uOcc} [DecidableEq O] {State : Type uS} {Firing : State → Type uF}
  {P : Step X O State Firing} (T : Transport P)

/-! ## The diamond -/

/-- **Semantic independence at a state**: both firings are admitted, each is still admitted after
the other once transported along the other's result, and the two composite results are in one
state class. -/
def Independent (s : State) (f g : Firing s) : Prop :=
  ∃ (first : P.Admits f) (second : P.Admits g) (afterFirst : P.Admits (T.residual f first g))
    (afterSecond : P.Admits (T.residual g second f)),
      T.Same (P.result (T.residual f first g) afterFirst) (P.result (T.residual g second f) afterSecond)

/-- **Diamonds close** when both orders are admitted. -/
def Closes : Prop :=
  ∀ {s : State} {f g : Firing s} (first : P.Admits f) (second : P.Admits g)
    (afterFirst : P.Admits (T.residual f first g)) (afterSecond : P.Admits (T.residual g second f)),
      T.Same (P.result (T.residual f first g) afterFirst) (P.result (T.residual g second f) afterSecond)

/-- **One swap of a run**: a firing then a firing alike to the residual of a second becomes the second
then a firing alike to the residual of the first; the rest of the run is carried along a similar run. -/
inductive SwapStep : {s : State} → P.Run s → P.Run s → Prop
  | here {s : State} {f g : Firing s} (first : P.Admits f) (second : P.Admits g)
      {g₁ : Firing (P.result f first)} (residualG : T.Alike (T.residual f first g) g₁)
      (afterFirst : P.Admits g₁)
      {f₁ : Firing (P.result g second)} (residualF : T.Alike (T.residual g second f) f₁)
      (afterSecond : P.Admits f₁) {rest : P.Run (P.result g₁ afterFirst)}
      {rest' : P.Run (P.result f₁ afterSecond)} (similar : T.Similar rest rest') :
      SwapStep (.cons f first (.cons g₁ afterFirst rest)) (.cons g second (.cons f₁ afterSecond rest'))
  | later {s : State} (f : Firing s) (admitted : P.Admits f) {r r' : P.Run (P.result f admitted)} :
      SwapStep r r' → SwapStep (.cons f admitted r) (.cons f admitted r')

/-- **Trace equivalence of dependent runs**: generated by swaps and by similarity. -/
abbrev TraceEquiv (s : State) : P.Run s → P.Run s → Prop :=
  Relation.EqvGen fun r r' : P.Run s => T.SwapStep r r' ∨ T.Similar r r'

variable {T}

theorem Independent.symm {s : State} {f g : Firing s} (independent : T.Independent s f g) :
    T.Independent s g f := by
  obtain ⟨first, second, afterFirst, afterSecond, close⟩ := independent
  exact ⟨second, first, afterSecond, afterFirst, close.symm⟩

/-- **Where diamonds close, independence is the four admissions.** -/
theorem independent_iff_admits (closes : T.Closes) {s : State} {f g : Firing s} :
    T.Independent s f g ↔ ∃ (first : P.Admits f) (second : P.Admits g),
      P.Admits (T.residual f first g) ∧ P.Admits (T.residual g second f) :=
  ⟨fun ⟨first, second, afterFirst, afterSecond, _⟩ => ⟨first, second, afterFirst, afterSecond⟩,
    fun ⟨first, second, afterFirst, afterSecond⟩ =>
      ⟨first, second, afterFirst, afterSecond, closes first second afterFirst afterSecond⟩⟩

/-- **Every swap swaps an independent pair.** -/
theorem swap_independent {s : State} {f g : Firing s} (first : P.Admits f) (second : P.Admits g)
    {g₁ : Firing (P.result f first)} (residualG : T.Alike (T.residual f first g) g₁)
    (afterFirst : P.Admits g₁)
    {f₁ : Firing (P.result g second)} (residualF : T.Alike (T.residual g second f) f₁)
    (afterSecond : P.Admits f₁) {rest : P.Run (P.result g₁ afterFirst)}
    {rest' : P.Run (P.result f₁ afterSecond)} (similar : T.Similar rest rest') :
    T.Independent s f g := by
  obtain ⟨close⟩ := Similar.same_start similar
  exact ⟨first, second, (T.admits_alike residualG).mpr afterFirst,
    (T.admits_alike residualF).mpr afterSecond,
    ⟨T.trans (T.result_alike residualG _ afterFirst)
      (T.trans close (T.symm (T.result_alike residualF _ afterSecond)))⟩⟩

/-- **Every independent pair swaps** in front of every continuation, the continuation carried along
the isomorphism that closes the diamond. -/
theorem Independent.swap {s : State} {f g : Firing s} (independent : T.Independent s f g) :
    ∃ (first : P.Admits f) (second : P.Admits g) (afterFirst : P.Admits (T.residual f first g))
      (afterSecond : P.Admits (T.residual g second f))
      (close : T.Iso (P.result (T.residual f first g) afterFirst)
        (P.result (T.residual g second f) afterSecond)),
      ∀ rest : P.Run (P.result (T.residual f first g) afterFirst),
        T.SwapStep (.cons f first (.cons (T.residual f first g) afterFirst rest))
          (.cons g second (.cons (T.residual g second f) afterSecond (T.moveRun close rest))) := by
  obtain ⟨first, second, afterFirst, afterSecond, ⟨close⟩⟩ := independent
  exact ⟨first, second, afterFirst, afterSecond, close,
    fun rest => .here first second (Alike.refl _) afterFirst (Alike.refl _) afterSecond
      (Similar.moveRun close rest)⟩

/-! ## Trace equivalence is a congruence -/

/-- A swap ends in the same class. -/
theorem SwapStep.same_last {s : State} {r r' : P.Run s} (step : T.SwapStep r r') :
    T.Same r.last r'.last := by
  induction step with
  | here _ _ _ _ _ _ similar =>
      have ends := Similar.same_last similar
      exact ends
  | later _ _ _ ih => exact ih

/-- **Trace-equivalent runs end in one state class.** -/
theorem TraceEquiv.same_last {s : State} {r r' : P.Run s} (equivalent : T.TraceEquiv s r r') :
    T.Same r.last r'.last := by
  induction equivalent with
  | rel _ _ step =>
      rcases step with step | similar
      · exact step.same_last
      · exact Similar.same_last similar
  | refl => exact T.same_refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ first second => exact first.trans second

/-- A swap after a common first firing. -/
theorem TraceEquiv.cons {s : State} {f : Firing s} {admitted : P.Admits f}
    {r r' : P.Run (P.result f admitted)} (equivalent : T.TraceEquiv _ r r') :
    T.TraceEquiv s (.cons f admitted r) (.cons f admitted r') := by
  induction equivalent with
  | rel _ _ step =>
      rcases step with step | similar
      · exact .rel _ _ (.inl (.later f admitted step))
      · exact .rel _ _ (.inr (Similar.cons_self similar))
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

/-- **Prefixing keeps trace equivalence.** -/
theorem TraceEquiv.append_left : ∀ {s : State} (u : P.Run s) {r r' : P.Run u.last},
    T.TraceEquiv _ r r' → T.TraceEquiv s (u.append r) (u.append r')
  | _, .nil _, _, _, equivalent => equivalent
  | _, .cons _ _ rest, _, _, equivalent => (TraceEquiv.append_left rest equivalent).cons

/-- A swap keeps its pattern when similar continuations are appended at its two ends. -/
theorem SwapStep.append {s : State} {r r' : P.Run s} (step : T.SwapStep r r') :
    ∀ {q : P.Run r.last} {q' : P.Run r'.last}, T.Similar q q' → T.SwapStep (r.append q) (r'.append q') := by
  induction step with
  | here first second residualG afterFirst residualF afterSecond similar =>
      intro q q' continued
      exact .here first second residualG afterFirst residualF afterSecond (Similar.append similar continued)
  | later f admitted _ ih =>
      intro q q' continued
      exact .later f admitted (ih continued)

/-- **Appending similar continuations keeps trace equivalence.** -/
theorem TraceEquiv.append_right {s : State} {r r' : P.Run s} (equivalent : T.TraceEquiv s r r') :
    ∀ {q : P.Run r.last} {q' : P.Run r'.last}, T.Similar q q' →
      T.TraceEquiv s (r.append q) (r'.append q') := by
  induction equivalent with
  | rel _ _ step =>
      intro q q' continued
      rcases step with step | similar
      · exact .rel _ _ (.inl (step.append continued))
      · exact .rel _ _ (.inr (Similar.append similar continued))
  | refl r =>
      intro q q' continued
      exact .rel _ _ (.inr (Similar.append (Similar.refl r) continued))
  | symm _ _ _ ih =>
      intro q q' continued
      exact .symm _ _ (ih (Similar.symm continued))
  | trans _ _ _ first _ ih₁ ih₂ =>
      intro q q'' continued
      obtain ⟨i⟩ := TraceEquiv.same_last first
      have moved : T.Similar q (T.moveRun i q) := Similar.moveRun i q
      exact .trans _ _ _ (ih₁ moved) (ih₂ (Similar.trans (Similar.symm moved) continued))

/-- Concatenating a continuation after a run, or its transport after an equivalent run, gives
equivalent runs. -/
theorem TraceEquiv.append_moved {s : State} {r r' : P.Run s} (equivalent : T.TraceEquiv s r r')
    (i : T.Iso r.last r'.last) (q : P.Run r.last) :
    T.TraceEquiv s (r.append q) (r'.append (T.moveRun i q)) :=
  equivalent.append_right (Similar.moveRun i q)

/-- **A swap transported along an isomorphism of its start is a swap**, by naturality of residuals. -/
theorem SwapStep.moveRun {s : State} {r r' : P.Run s} (step : T.SwapStep r r') :
    ∀ {t : State} (i : T.Iso s t), T.SwapStep (T.moveRun i r) (T.moveRun i r') := by
  induction step with
  | @here s f g first second g₁ residualG afterFirst f₁ residualF afterSecond rest rest' similar =>
      intro t i
      exact .here ((T.admits_move i f).mpr first) ((T.admits_move i g).mpr second)
        ((T.move_residual i f first g).symm.trans (T.move_alike _ residualG)) _
        ((T.move_residual i g second f).symm.trans (T.move_alike _ residualF)) _
        (Similar.trans (Similar.symm (Similar.moveRun _ rest))
          (Similar.trans similar (Similar.moveRun _ rest')))
  | later f admitted _ ih =>
      intro t i
      exact .later _ _ (ih (T.result_move i f admitted))

/-- **Traces are transported along isomorphisms of their start.** -/
theorem TraceEquiv.moveRun {s t : State} (i : T.Iso s t) {r r' : P.Run s}
    (equivalent : T.TraceEquiv s r r') : T.TraceEquiv t (T.moveRun i r) (T.moveRun i r') := by
  induction equivalent with
  | rel _ _ step =>
      rcases step with step | similar
      · exact .rel _ _ (.inl (step.moveRun i))
      · exact .rel _ _ (.inr (Similar.trans (Similar.symm (Similar.moveRun i _))
          (Similar.trans similar (Similar.moveRun i _))))
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

/-- **Composition of traces is well defined in both arguments**: equivalent first runs and
equivalent continuations give equivalent composites, the continuation transported along the class
isomorphism of the ends. -/
theorem TraceEquiv.comp {s : State} {r r' : P.Run s} (first : T.TraceEquiv s r r')
    (i : T.Iso r.last r'.last) {q q' : P.Run r.last} (second : T.TraceEquiv _ q q') :
    T.TraceEquiv s (r.append q) (r'.append (T.moveRun i q')) :=
  .trans _ _ _ (TraceEquiv.append_left r second) (first.append_moved i q')

/-! ## Site accounts of traces -/

/-- A swap keeps every site account whose grades are invariant under transport, alikeness and
residuals and commute on independent firings. -/
theorem SwapStep.account_eq {M : Type*} [Monoid M] (grade : (t : State) → Firing t → M)
    (invariant : ∀ {s t : State} (i : T.Iso s t) (f : Firing s), grade t (T.move i f) = grade s f)
    (alike : ∀ {s : State} {f f' : Firing s}, T.Alike f f' → grade s f = grade s f')
    (residual : ∀ {s : State} (g : Firing s) (admitted : P.Admits g) (f : Firing s),
      grade _ (T.residual g admitted f) = grade s f)
    (commute : ∀ {s : State} (f g : Firing s), T.Independent s f g → Commute (grade s f) (grade s g))
    {s : State} {r r' : P.Run s} (step : T.SwapStep r r') : r.account grade = r'.account grade := by
  induction step with
  | @here s f g first second g₁ residualG afterFirst f₁ residualF afterSecond rest rest' similar =>
      have independent := swap_independent first second residualG afterFirst residualF afterSecond similar
      show grade s f * (grade _ g₁ * rest.account grade) =
        grade s g * (grade _ f₁ * rest'.account grade)
      rw [← alike residualG, ← alike residualF, residual, residual,
        Similar.account_eq grade invariant alike similar]
      exact (commute f g independent).left_comm _
  | later f _ _ ih =>
      show grade _ f * _ = grade _ f * _
      rw [ih]

/-- **Site accounts are properties of traces** when their grades are invariant under transport,
alikeness and residuals and commute on independent firings. -/
theorem TraceEquiv.account_eq {M : Type*} [Monoid M] (grade : (t : State) → Firing t → M)
    (invariant : ∀ {s t : State} (i : T.Iso s t) (f : Firing s), grade t (T.move i f) = grade s f)
    (alike : ∀ {s : State} {f f' : Firing s}, T.Alike f f' → grade s f = grade s f')
    (residual : ∀ {s : State} (g : Firing s) (admitted : P.Admits g) (f : Firing s),
      grade _ (T.residual g admitted f) = grade s f)
    (commute : ∀ {s : State} (f g : Firing s), T.Independent s f g → Commute (grade s f) (grade s g))
    {s : State} {r r' : P.Run s} (equivalent : T.TraceEquiv s r r') :
    r.account grade = r'.account grade := by
  induction equivalent with
  | rel _ _ step =>
      rcases step with step | similar
      · exact step.account_eq grade invariant alike residual commute
      · exact Similar.account_eq grade invariant alike similar
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ first second => exact first.trans second

/-- In a commutative monoid, invariance under transport, alikeness and residuals suffices. -/
theorem TraceEquiv.account_eq_comm {M : Type*} [CommMonoid M] (grade : (t : State) → Firing t → M)
    (invariant : ∀ {s t : State} (i : T.Iso s t) (f : Firing s), grade t (T.move i f) = grade s f)
    (alike : ∀ {s : State} {f f' : Firing s}, T.Alike f f' → grade s f = grade s f')
    (residual : ∀ {s : State} (g : Firing s) (admitted : P.Admits g) (f : Firing s),
      grade _ (T.residual g admitted f) = grade s f)
    {s : State} {r r' : P.Run s} (equivalent : T.TraceEquiv s r r') :
    r.account grade = r'.account grade :=
  equivalent.account_eq grade invariant alike residual fun f g _ => Commute.all (grade _ f) (grade _ g)

/-! ## Deciding independence -/

/-- **Independence is decided wherever admission is**, when diamonds close. -/
def decidableIndependent (closes : T.Closes) [∀ (t : State) (f : Firing t), Decidable (P.Admits f)]
    (s : State) (f g : Firing s) : Decidable (T.Independent s f g) :=
  decidable_of_iff _ (independent_iff_admits closes).symm

/-- A verdict of a check of independence. -/
inductive Verdict where
  | independent
  | dependent
  | unknown
  deriving DecidableEq

variable (T)

/-- **A sound three-valued check of independence**: it may answer unknown, and it never answers
independent or dependent wrongly. -/
structure Check (s : State) where
  verdict : Firing s → Firing s → Verdict
  sound_independent : ∀ f g, verdict f g = .independent → T.Independent s f g
  sound_dependent : ∀ f g, verdict f g = .dependent → ¬ T.Independent s f g

/-- **A check from a decidable sufficient condition and a decidable refutation.** -/
def Check.ofTests (s : State) (sufficient refuted : Firing s → Firing s → Prop)
    [∀ f g, Decidable (sufficient f g)] [∀ f g, Decidable (refuted f g)]
    (sufficient_sound : ∀ f g, sufficient f g → T.Independent s f g)
    (refuted_sound : ∀ f g, refuted f g → ¬ T.Independent s f g) : T.Check s where
  verdict f g := if sufficient f g then .independent else if refuted f g then .dependent else .unknown
  sound_independent f g answered := by
    by_cases holds : sufficient f g
    · exact sufficient_sound f g holds
    · by_cases refutes : refuted f g
      · simp [holds, refutes] at answered
      · simp [holds, refutes] at answered
  sound_dependent f g answered := by
    by_cases holds : sufficient f g
    · simp [holds] at answered
    · by_cases refutes : refuted f g
      · exact refuted_sound f g refutes
      · simp [holds, refutes] at answered

/-- The check of a fibre where independence is decided. -/
def Check.ofDecidable (s : State) [∀ f g, Decidable (T.Independent s f g)] : T.Check s :=
  Check.ofTests T s (T.Independent s) (fun f g => ¬ T.Independent s f g)
    (fun _ _ holds => holds) (fun _ _ refutes => refutes)

/-- **A check from a decision never answers unknown.** -/
theorem Check.ofDecidable_ne_unknown (s : State) [∀ f g, Decidable (T.Independent s f g)]
    (f g : Firing s) : (Check.ofDecidable T s).verdict f g ≠ .unknown := by
  by_cases holds : T.Independent s f g <;> simp [Check.ofDecidable, Check.ofTests, holds]

/-- The check that answers only by its sufficient condition; elsewhere it answers unknown. -/
def Check.ofSufficient (s : State) (sufficient : Firing s → Firing s → Prop)
    [∀ f g, Decidable (sufficient f g)] (sufficient_sound : ∀ f g, sufficient f g → T.Independent s f g) :
    T.Check s :=
  Check.ofTests T s sufficient (fun _ _ => False) sufficient_sound (fun _ _ impossible => impossible.elim)

end Transport

