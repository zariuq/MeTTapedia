import Mettapedia.GSLT.LanguageDef.ModuleSource.Commands
import Mettapedia.OSLF.Framework.TypeSynthesis
import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Step.EffectStore

/-!
# The authored transform event interface

This is the event boundary of the transform presentation. `prepared` supplies
the result of a fully specified candidate; `permitted` supplies its permission.
Neither relation is an evaluator or a trusted native primitive. An executable
relation environment needs its own interpretation against `EffectCore`.

The module currently authors this boundary, not the internal syntax of every
frame, solver, or effect payload. Its OSLF is generated by the existing
language-parametric construction.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Presentation

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.Engine
open Mettapedia.OSLF.Framework.TypeSynthesis
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis
open Mettapedia.GSLT.LanguageDef.ModuleSource
open scoped Commands

#module_file "../../../../../../../metta/gslt/module/tcalc.module"
#module_roundtrip Tcalc

def language : LanguageDef :=
  (elaborateTheory Tcalc.library Tcalc.module ["Events"]).toOption.get (by decide +kernel)

theorem elaborates : elaborateTheory Tcalc.library Tcalc.module ["Events"] = .ok language := rfl

def oslf (relations : RelationEnv) := langOSLFUsing relations language "Proc"

theorem equation_free : language.isEquationFree = true := by decide +kernel

theorem two_boundaries :
    language.rewrites.map (fun rule => rule.premises.length) = [2] := by decide +kernel


def request (state firing : Pattern) : Pattern := .apply "Request" [state, firing]
def atState (state : Pattern) : Pattern := .apply "At" [state]

/-- A finite relation fixture keeps preparation and permission independent. -/
def fixture (permit : Bool) : RelationEnv where
  tuples rel _ :=
    if rel = "prepared" then [[.apply "Start" [], .apply "Move" [], .apply "Finish" []]]
    else if rel = "permitted" && permit then [[.apply "Start" [], .apply "Move" []]]
    else []

theorem admitted_fixture :
    rewriteStepWithPremisesUsing (fixture true) language
      (request (.apply "Start" []) (.apply "Move" [])) = [atState (.apply "Finish" [])] := by
  decide +kernel

theorem prepared_without_permission :
    rewriteStepWithPremisesUsing (fixture false) language
      (request (.apply "Start" []) (.apply "Move" [])) = [] := by
  decide +kernel

theorem no_unprepared_firing :
    rewriteStepWithPremisesUsing (fixture true) language
      (request (.apply "Start" []) (.apply "Other" [])) = [] := by
  decide +kernel

theorem no_implicit_execution :
    rewriteStepWithPremisesUsing (fixture true) language (atState (.apply "Start" [])) = [] := by
  decide +kernel

/-- The root executor agrees with the OSLF step for this authored interface. -/
theorem root_iff_semantic (relations : RelationEnv) (source target : Pattern) :
    target ∈ rewriteStepWithPremisesUsing relations language source ↔
      (langGSLTUsing relations language).Step source target := by
  apply mem_rootFrontier_iff_langGSLTUsing_step relations language equation_free
  intro rule member
  have singleton : language.rewrites = [language.rewrites[0]'(by decide +kernel)] := rfl
  have only : rule = language.rewrites[0]'(by decide +kernel) := by
    rw [singleton] at member
    exact List.mem_singleton.mp member
  subst rule
  exact .relationQuery (.relationQuery .nil)

/-- Raw observations are admitted here because this presentation has no equations. -/
def observation (relations : RelationEnv) (predicate : Pattern → Prop) :
    EquationPredicate (langGSLTUsing relations language) :=
  ⟨predicate, equationInvariant_langGSLTUsing_of_equation_free relations equation_free predicate⟩

/-- The generated future modality observes exactly the authored executable successors. -/
theorem diamond_reads (relations : RelationEnv) (predicate : Pattern → Prop) (source : Pattern) :
    langDiamondUsing relations language (observation relations predicate) source ↔
      ∃ target, target ∈ rewriteStepWithPremisesUsing relations language source ∧ predicate target := by
  rw [langDiamondUsing_spec]
  constructor
  · rintro ⟨target, step, observed⟩
    exact ⟨target, (root_iff_semantic relations source target).mpr step, observed⟩
  · rintro ⟨target, step, observed⟩
    exact ⟨target, (root_iff_semantic relations source target).mp step, observed⟩

theorem diamond_admitted :
    langDiamondUsing (fixture true) language
      (observation (fixture true) (· = atState (.apply "Finish" [])))
      (request (.apply "Start" []) (.apply "Move" [])) := by
  rw [diamond_reads, admitted_fixture]
  exact ⟨_, List.mem_singleton_self _, rfl⟩

theorem diamond_refused (predicate : Pattern → Prop) :
    ¬ langDiamondUsing (fixture false) language (observation (fixture false) predicate)
      (request (.apply "Start" []) (.apply "Move" [])) := by
  rw [diamond_reads, prepared_without_permission]
  simp

namespace StoreExample

open Interface
open AdmissionObservationCover.Controls (frame)
open EffectStoreControls (extra tell_prepared)

abbrev effect := EffectCore.tell frame () extra

def permission (permit : Bool) : effect.Admission := fun _ _ => permit = true

/-- This source fixture represents a real effect which adds a nontrivial constraint. -/
theorem event_iff (permit : Bool) :
    Nonempty (effect.Event (permission permit) [] extra) ↔ permit = true := by
  constructor
  · rintro ⟨e⟩
    exact e.permitted
  · intro allowed
    exact ⟨⟨(), tell_prepared, allowed, rfl⟩⟩

/-- Preservation and reflection for the independently defined store-effect example. -/
theorem execution_iff_event (permit : Bool) :
    atState (.apply "Finish" []) ∈ rewriteStepWithPremisesUsing (fixture permit) language
      (request (.apply "Start" []) (.apply "Move" [])) ↔
      Nonempty (effect.Event (permission permit) [] extra) := by
  rw [event_iff]
  cases permit
  · rw [prepared_without_permission]
    simp
  · rw [admitted_fixture]
    simp

/-- The generated modal observation agrees with that same semantic event. -/
theorem diamond_iff_event (permit : Bool) :
    langDiamondUsing (fixture permit) language
      (observation (fixture permit) (· = atState (.apply "Finish" [])))
      (request (.apply "Start" []) (.apply "Move" [])) ↔
      Nonempty (effect.Event (permission permit) [] extra) := by
  rw [diamond_reads]
  simpa using execution_iff_event permit

end StoreExample

end Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Presentation
