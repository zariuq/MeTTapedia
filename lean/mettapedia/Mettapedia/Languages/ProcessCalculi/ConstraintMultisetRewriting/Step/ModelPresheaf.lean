import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Step.ModelGuards

/-!
# Presheaf semantics of knowledge and asks

The solutions of a frame `a` are the morphisms out of it, `Hom a -`: the representable presheaf on
`𝔽^op`. This module reads knowledge, guards and asks as sub-presheaves of it.

* **Cosieves** (`Frames.Cosieve`): sets of solutions closed under later instantiation and determined
  by their action. The solutions of a store form one (`solutions`). Concatenating stores meets their
  cosieves (`solutions_append`); the empty store is the maximal cosieve (`solutions_nil`); stores are
  equivalent exactly when their cosieves are equal (`equivalent_iff_solutions_eq`).
* **The persistent interior** (`interior`): the largest cosieve inside an action-invariant predicate
  (`le_interior_iff`). **A guard denotes a sub-presheaf**, the interior of where it holds
  (`guardCosieve`); a positive guard already is one (`guardCosieve_mem_iff_of_positive`).
* **An ask is an inclusion of sub-presheaves** (`entails_iff_le_interior`, `entails_iff_le_guard`):
  the store's cosieve lies inside the guard's.
* **Yoneda for answers** (`principal_iff_generated`): an answer is principal exactly when the
  cosieve of solutions is generated by it, the image of the representable `Hom m -`.
* **Kripke forcing** (`Forces`): equations are read at the solution; absence, count, negation and
  implication quantify over every later instantiation (Cohen's clause for negation); there are no
  covers. Forcing is invariant under agreement (`forces_congr`) and persistent (`forces_persist`).
  On positive guards it is satisfaction (`forces_iff_of_positive`).
* **Asks are forcing on the flat fragment** (`entails_iff_forces`): for conjunctions of positive
  guards, their negations, absences and counts, which is the shape of the step's checks, the ask of
  a guard at every solution equals forcing it at every solution. Disjunction of non-positive guards
  leaves the fragment; the controls are in `ModelControls`.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Interface

universe uO uT uH uOcc

namespace GuardFormula

variable {T : Type uT} {O : Type uOcc}

/-- **The flat fragment**: conjunctions of positive guards, negated positive guards, absences and
counts. -/
inductive Flat : GuardFormula T O → Prop
  | positive {φ : GuardFormula T O} : φ.Positive → Flat φ
  | absent (pattern : T) (region : Finset O) (label : O → T) : Flat (.absent pattern region label)
  | count (pattern : T) (region : Finset O) (label : O → T) (number : Nat) :
      Flat (.count pattern region label number)
  | not {φ : GuardFormula T O} : φ.Positive → Flat (.not φ)
  | and {φ ψ : GuardFormula T O} : Flat φ → Flat ψ → Flat (.and φ ψ)

end GuardFormula

namespace Frames

variable {Obj : Type uO} {Tm : Obj → Type uT} {Hom : Obj → Obj → Type uH}

/-- **A cosieve of solutions** on `a`: solutions closed under later instantiation and determined by
their action. -/
@[ext]
structure Cosieve (X : Frames Tm Hom) (a : Obj) where
  mem : (b : Obj) → Hom a b → Prop
  comp_mem : ∀ {b c : Obj} {f : Hom a b}, mem b f → ∀ g : Hom b c, mem c (X.comp g f)
  agree_mem : ∀ {b : Obj} {f g : Hom a b}, (∀ t, X.E (X.act f t) (X.act g t)) → mem b f → mem b g

/-- A predicate of solutions determined by their action. -/
def Invariant (X : Frames Tm Hom) {a : Obj} (P : (b : Obj) → Hom a b → Prop) : Prop :=
  ∀ {b : Obj} {f g : Hom a b}, (∀ t, X.E (X.act f t) (X.act g t)) → P b f → P b g

variable {X : Frames Tm Hom} {a : Obj}

/-! ## Agreement lemmas -/

theorem agree_comp_left {b c : Obj} {f g : Hom a b} (same : ∀ t, X.E (X.act f t) (X.act g t))
    (h : Hom b c) : ∀ t, X.E (X.act (X.comp h f) t) (X.act (X.comp h g) t) := fun t => by
  rw [X.act_comp, X.act_comp]
  exact X.preserves h (same t)

theorem agree_comp_assoc {b c d : Obj} (f : Hom a b) (h : Hom b c) (k : Hom c d) :
    ∀ t, X.E (X.act (X.comp (X.comp k h) f) t) (X.act (X.comp k (X.comp h f)) t) := fun t => by
  rw [act_comp_assoc]
  exact (X.equivalence d).refl _

theorem agree_comp_id {b : Obj} (f : Hom a b) :
    ∀ t, X.E (X.act (X.comp (X.id b) f) t) (X.act f t) := fun t => by
  rw [X.act_comp, X.act_id]
  exact (X.equivalence b).refl _

theorem agree_symm {b : Obj} {f g : Hom a b} (same : ∀ t, X.E (X.act f t) (X.act g t)) :
    ∀ t, X.E (X.act g t) (X.act f t) := fun t => (X.equivalence b).symm (same t)

/-- Agreeing solutions solve the same stores. -/
theorem models_agree {b : Obj} {f g : Hom a b} (same : ∀ t, X.E (X.act f t) (X.act g t))
    (store : EquationStore (Tm a)) : X.Models f store ↔ X.Models g store :=
  forall₂_congr fun e _ => kernel_congr same e.1 e.2

/-! ## Cosieves -/

namespace Cosieve

instance : LE (X.Cosieve a) := ⟨fun C D => ∀ b f, C.mem b f → D.mem b f⟩

theorem le_def {C D : X.Cosieve a} : C ≤ D ↔ ∀ b f, C.mem b f → D.mem b f := Iff.rfl

/-- The meet of two cosieves. -/
def inf (C D : X.Cosieve a) : X.Cosieve a where
  mem b f := C.mem b f ∧ D.mem b f
  comp_mem held g := ⟨C.comp_mem held.1 g, D.comp_mem held.2 g⟩
  agree_mem same held := ⟨C.agree_mem same held.1, D.agree_mem same held.2⟩

/-- The maximal cosieve: every solution. -/
def top : X.Cosieve a where
  mem _ _ := True
  comp_mem _ _ := trivial
  agree_mem _ _ := trivial

/-- The empty cosieve. -/
def bot : X.Cosieve a where
  mem _ _ := False
  comp_mem held _ := held
  agree_mem _ held := held

theorem le_inf_iff {C D E : X.Cosieve a} : C ≤ D.inf E ↔ C ≤ D ∧ C ≤ E :=
  ⟨fun le => ⟨fun b f held => (le b f held).1, fun b f held => (le b f held).2⟩,
    fun le b f held => ⟨le.1 b f held, le.2 b f held⟩⟩

end Cosieve

variable (X) in
/-- **The cosieve of solutions of a store.** -/
def solutions (store : EquationStore (Tm a)) : X.Cosieve a where
  mem _ f := X.Models f store
  comp_mem solved g := models_comp solved g
  agree_mem same solved := (models_agree same store).mp solved

theorem mem_solutions {store : EquationStore (Tm a)} {b : Obj} {f : Hom a b} :
    (X.solutions store).mem b f ↔ X.Models f store :=
  Iff.rfl

/-- **Concatenating stores meets their cosieves.** -/
theorem solutions_append (one two : EquationStore (Tm a)) :
    X.solutions (one ++ two) = (X.solutions one).inf (X.solutions two) :=
  Cosieve.ext (funext fun _ => funext fun f => propext (models_append f one two))

/-- **The empty store is the maximal cosieve.** -/
theorem solutions_nil : X.solutions ([] : EquationStore (Tm a)) = Cosieve.top :=
  Cosieve.ext (funext fun _ => funext fun f => propext ⟨fun _ => trivial, fun _ => models_nil f⟩)

/-- Solvability: the cosieve is inhabited. -/
theorem solvable_iff_inhabited (store : EquationStore (Tm a)) :
    X.Solvable store ↔ ∃ (b : Obj) (f : Hom a b), (X.solutions store).mem b f :=
  Iff.rfl

/-- **Equivalent stores are equal cosieves.** -/
theorem equivalent_iff_solutions_eq (one two : EquationStore (Tm a)) :
    X.Equivalent one two ↔ X.solutions one = X.solutions two := by
  constructor
  · intro same
    exact Cosieve.ext (funext fun b => funext fun f => propext (same b f))
  · intro same b f
    rw [← mem_solutions, ← mem_solutions (store := two), same]

/-! ## The persistent interior -/

variable (X) in
/-- **The persistent interior** of an action-invariant predicate: the solutions at which it holds
from then on. -/
def interior (P : (b : Obj) → Hom a b → Prop) (invariant : X.Invariant P) : X.Cosieve a where
  mem b f := ∀ (c : Obj) (g : Hom b c), P c (X.comp g f)
  comp_mem {_ _ f} held h := fun d k => invariant (agree_comp_assoc f h k) (held d (X.comp k h))
  agree_mem same held := fun c g => invariant (agree_comp_left same g) (held c g)

theorem interior_mem {P : (b : Obj) → Hom a b → Prop} {invariant : X.Invariant P} {b : Obj}
    {f : Hom a b} (held : (X.interior P invariant).mem b f) : P b f :=
  invariant (agree_comp_id f) (held b (X.id b))

/-- **The interior is the largest cosieve inside the predicate.** -/
theorem le_interior_iff {P : (b : Obj) → Hom a b → Prop} (invariant : X.Invariant P)
    (C : X.Cosieve a) : C ≤ X.interior P invariant ↔ ∀ b f, C.mem b f → P b f :=
  ⟨fun le b f held => interior_mem (le b f held), fun inside _ _ held c g => inside c _ (C.comp_mem held g)⟩

/-- **An ask is an inclusion of sub-presheaves**: the store's cosieve lies inside the persistent
interior of the observation. -/
theorem entails_iff_le_interior {P : (b : Obj) → Hom a b → Prop} (invariant : X.Invariant P)
    (store : EquationStore (Tm a)) : X.Entails store P ↔ X.solutions store ≤ X.interior P invariant :=
  (le_interior_iff invariant (X.solutions store)).symm

section Guards

variable {O : Type uOcc}

theorem satisfies_invariant (φ : GuardFormula (Tm a) O) : X.Invariant fun _ f => X.Satisfies f φ :=
  fun same held => (satisfies_congr same φ).mp held

variable (X) in
/-- **A guard denotes a sub-presheaf**: the persistent interior of where it holds. -/
def guardCosieve (φ : GuardFormula (Tm a) O) : X.Cosieve a :=
  X.interior (fun _ f => X.Satisfies f φ) (satisfies_invariant φ)

/-- **The ask of a guard is the inclusion of the store's cosieve in the guard's.** -/
theorem entails_iff_le_guard (store : EquationStore (Tm a)) (φ : GuardFormula (Tm a) O) :
    X.Entails store (fun _ f => X.Satisfies f φ) ↔ X.solutions store ≤ X.guardCosieve φ :=
  entails_iff_le_interior (satisfies_invariant φ) store

/-- **A positive guard is already a sub-presheaf.** -/
theorem guardCosieve_mem_iff_of_positive {φ : GuardFormula (Tm a) O} (positive : φ.Positive)
    {b : Obj} (f : Hom a b) : (X.guardCosieve φ).mem b f ↔ X.Satisfies f φ :=
  ⟨interior_mem, fun held _ g => held.persist positive g⟩

end Guards

/-! ## Yoneda for principal answers -/

variable (X) in
/-- **The cosieve generated by one solution**: the solutions that factor through it, up to action.
It is the image of the representable `Hom m -`. -/
def generated {m : Obj} (answer : Hom a m) : X.Cosieve a where
  mem b f := ∃ r : Hom m b, ∀ t, X.E (X.act f t) (X.act (X.comp r answer) t)
  comp_mem {b c f} held g := by
    obtain ⟨r, through⟩ := held
    refine ⟨X.comp g r, fun t => ?_⟩
    have later := agree_comp_left through g t
    rw [← act_comp_assoc] at later
    exact later
  agree_mem same held := by
    obtain ⟨r, through⟩ := held
    exact ⟨r, fun t => (X.equivalence _).trans (agree_symm same t) (through t)⟩

/-- **Yoneda for answers**: an answer is principal exactly when it generates the cosieve of
solutions. -/
theorem principal_iff_generated {m : Obj} (store : EquationStore (Tm a)) (answer : Hom a m) :
    X.Principal store answer ↔ X.solutions store = X.generated answer := by
  constructor
  · intro principal
    exact Cosieve.ext (funext fun b => funext fun f => propext (principal.models_iff f))
  · intro same
    have member : ∀ {b : Obj} (f : Hom a b), X.Models f store ↔ (X.generated answer).mem b f :=
      fun f => by rw [← mem_solutions, same]
    refine ⟨(member answer).mpr ⟨X.id m, agree_symm (agree_comp_id answer)⟩, fun b f solved => ?_⟩
    exact (member f).mp solved

/-! ## Kripke forcing -/

section Forcing

variable {O : Type uOcc}

variable (X) in
/-- **Kripke forcing** of a guard at a solution. Equations are read at the solution; absence, count,
negation and implication quantify over every later instantiation; there are no covers. -/
def Forces : GuardFormula (Tm a) O → (b : Obj) → Hom a b → Prop
  | .top, _, _ => True
  | .bot, _, _ => False
  | .eq s t, _, f => X.kernel f s t
  | .absent p W label, b, f => ∀ (c : Obj) (g : Hom b c), X.Satisfies (X.comp g f) (.absent p W label)
  | .count p W label n, b, f =>
      ∀ (c : Obj) (g : Hom b c), X.Satisfies (X.comp g f) (.count p W label n)
  | .not φ, b, f => ∀ (c : Obj) (g : Hom b c), ¬ Forces φ c (X.comp g f)
  | .and φ ψ, b, f => Forces φ b f ∧ Forces ψ b f
  | .or φ ψ, b, f => Forces φ b f ∨ Forces ψ b f
  | .imp φ ψ, b, f => ∀ (c : Obj) (g : Hom b c), Forces φ c (X.comp g f) → Forces ψ c (X.comp g f)

/-- **Cohen's clause**: a negation is forced when no later instantiation forces what it negates. -/
theorem forces_not_iff (φ : GuardFormula (Tm a) O) {b : Obj} (f : Hom a b) :
    X.Forces (.not φ) b f ↔ ∀ (c : Obj) (g : Hom b c), ¬ X.Forces φ c (X.comp g f) :=
  Iff.rfl

/-- **Forcing is determined by the action.** -/
theorem forces_congr : ∀ (φ : GuardFormula (Tm a) O) {b : Obj} {f g : Hom a b},
    (∀ t, X.E (X.act f t) (X.act g t)) → (X.Forces φ b f ↔ X.Forces φ b g)
  | .top, _, _, _, _ => Iff.rfl
  | .bot, _, _, _, _ => Iff.rfl
  | .eq s t, _, _, _, same => kernel_congr same s t
  | .absent _ _ _, _, _, _, same =>
      forall₂_congr fun _ h => satisfies_congr (agree_comp_left same h) _
  | .count _ _ _ _, _, _, _, same =>
      forall₂_congr fun _ h => satisfies_congr (agree_comp_left same h) _
  | .not φ, _, _, _, same =>
      forall₂_congr fun _ h => not_congr (forces_congr φ (agree_comp_left same h))
  | .and φ ψ, _, _, _, same => and_congr (forces_congr φ same) (forces_congr ψ same)
  | .or φ ψ, _, _, _, same => or_congr (forces_congr φ same) (forces_congr ψ same)
  | .imp φ ψ, _, _, _, same =>
      forall₂_congr fun _ h =>
        imp_congr (forces_congr φ (agree_comp_left same h)) (forces_congr ψ (agree_comp_left same h))

/-- **Forcing persists** along later instantiation. -/
theorem forces_persist : ∀ (φ : GuardFormula (Tm a) O) {b c : Obj} {f : Hom a b},
    X.Forces φ b f → ∀ h : Hom b c, X.Forces φ c (X.comp h f)
  | .top, _, _, _, _, _ => trivial
  | .bot, _, _, _, held, _ => held.elim
  | .eq _ _, _, _, _, held, h => kernel_persist held h
  | .absent _ _ _, _, _, f, held, h => fun d k =>
      (satisfies_congr (agree_comp_assoc f h k) _).mp (held d (X.comp k h))
  | .count _ _ _ _, _, _, f, held, h => fun d k =>
      (satisfies_congr (agree_comp_assoc f h k) _).mp (held d (X.comp k h))
  | .not φ, _, _, f, held, h => fun d k forced =>
      held d (X.comp k h) ((forces_congr φ (agree_comp_assoc f h k)).mpr forced)
  | .and φ ψ, _, _, _, held, h => ⟨forces_persist φ held.1 h, forces_persist ψ held.2 h⟩
  | .or φ ψ, _, _, _, held, h =>
      held.elim (fun one => Or.inl (forces_persist φ one h)) (fun two => Or.inr (forces_persist ψ two h))
  | .imp φ ψ, _, _, f, held, h => fun d k forced =>
      (forces_congr ψ (agree_comp_assoc f h k)).mp
        (held d (X.comp k h) ((forces_congr φ (agree_comp_assoc f h k)).mpr forced))

/-- **On positive guards forcing is satisfaction.** -/
theorem forces_iff_of_positive {φ : GuardFormula (Tm a) O} (positive : φ.Positive) {b : Obj}
    (f : Hom a b) : X.Forces φ b f ↔ X.Satisfies f φ := by
  induction positive with
  | top => exact Iff.rfl
  | bot => exact Iff.rfl
  | eq s t => exact Iff.rfl
  | and _ _ one two => exact and_congr one two
  | or _ _ one two => exact or_congr one two

/-- Over a cosieve, holding at every member is holding at every later instantiation of every
member. -/
theorem forall_mem_iff_later (C : X.Cosieve a) {P : (b : Obj) → Hom a b → Prop}
    (invariant : X.Invariant P) :
    (∀ b f, C.mem b f → P b f) ↔ ∀ b f, C.mem b f → ∀ (c : Obj) (g : Hom b c), P c (X.comp g f) :=
  ⟨fun all _ _ held c g => all c _ (C.comp_mem held g),
    fun all b f held => invariant (agree_comp_id f) (all b f held b (X.id b))⟩

/-- **On the flat fragment, holding over a cosieve is forcing over it.** -/
theorem satisfies_iff_forces_on (C : X.Cosieve a) {φ : GuardFormula (Tm a) O} (flat : φ.Flat) :
    (∀ b f, C.mem b f → X.Satisfies f φ) ↔ ∀ b f, C.mem b f → X.Forces φ b f := by
  induction flat with
  | positive positive =>
      exact forall₂_congr fun b f => imp_congr_right fun _ => (forces_iff_of_positive positive f).symm
  | absent p W label =>
      exact forall_mem_iff_later C (satisfies_invariant (.absent p W label))
  | count p W label n =>
      exact forall_mem_iff_later C (satisfies_invariant (.count p W label n))
  | @not ψ positive =>
      have invariant : X.Invariant fun _ f => ¬ X.Satisfies f ψ :=
        fun same held holds => held ((satisfies_congr same ψ).mpr holds)
      refine (forall_mem_iff_later C invariant).trans ?_
      exact forall₂_congr fun b f => imp_congr_right fun _ => forall₂_congr fun c g =>
        not_congr (forces_iff_of_positive positive _).symm
  | and _ _ one two =>
      constructor
      · intro all b f held
        exact ⟨one.mp (fun b f held => (all b f held).1) b f held,
          two.mp (fun b f held => (all b f held).2) b f held⟩
      · intro all b f held
        exact ⟨one.mpr (fun b f held => (all b f held).1) b f held,
          two.mpr (fun b f held => (all b f held).2) b f held⟩

/-- **Asks are forcing on the flat fragment**: the ask of a flat guard at every solution of a store
is forcing it at every solution. -/
theorem entails_iff_forces (store : EquationStore (Tm a)) {φ : GuardFormula (Tm a) O}
    (flat : φ.Flat) :
    X.Entails store (fun _ f => X.Satisfies f φ) ↔ ∀ b (f : Hom a b), X.Models f store → X.Forces φ b f :=
  satisfies_iff_forces_on (X.solutions store) flat

end Forcing

end Frames

