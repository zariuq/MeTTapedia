import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Step.RunInterchangeWitness
import Mathlib.CategoryTheory.Groupoid.FreeGroupoid
import Mathlib.CategoryTheory.Core
import Mathlib.CategoryTheory.Types.Basic

/-!
# The groupoid generated by witnessed comparisons of actual runs

Objects are runs from one state. Arrows retain the actual similarity and
canonical interchange witnesses, modulo only the free groupoid's inverse
cancellation equations. This is not the thin trace quotient: different event
permutations remain distinguishable. Existence of an arrow is exactly the
existing trace relation.

Interpretations into any groupoid extend uniquely from the generators. In
particular the finite sets of event positions receive a functor, retaining
event multiplicity through composition and inversion. This is a vertical
comparison groupoid; horizontal composition and dependent contextual coherence
require their own constructions.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Interface.Transport.RunRearrangement

open _root_.CategoryTheory

universe uO uT uH uOcc uS uF uI uC uV

variable {Obj : Type uO} {Tm : Obj → Type uT} {Hom : Obj → Obj → Type uH}
  {X : Frames Tm Hom} {O : Type uOcc} [DecidableEq O]
  {State : Type uS} {Firing : State → Type uF}
  {P : Step X O State Firing} (T : Transport.{uO,uT,uH,uOcc,uS,uF,uI} P)

/-- A separate carrier avoids installing a second quiver on runs. -/
def Object (_ : Transport.{uO,uT,uH,uOcc,uS,uF,uI} P) (start : State) := P.Run start

abbrev Generator {start : State} (first second : Object T start) :=
  T.SimilarityWitness first second ⊕ T.InterchangeWitness first second

instance generatorQuiver (start : State) : Quiver (Object T start) where
  Hom := Generator T

abbrev Groupoid (start : State) := Quiver.FreeGroupoid (Object T start)

def object {start : State} (run : P.Run start) : Groupoid T start :=
  (Quiver.FreeGroupoid.of (Object T start)).obj run

abbrev Cell {start : State} (first second : P.Run start) := object T first ⟶ object T second

def generator {start : State} {first second : P.Run start} (witness : Generator T first second) :
    Cell T first second := (Quiver.FreeGroupoid.of (Object T start)).map witness

variable {T}

theorem generator_trace {start : State} {first second : Object T start}
    (witness : Generator T first second) : T.TraceEquiv start first second := by
  cases witness with
  | inl similar => exact .rel _ _ (.inr similar.similar)
  | inr interchange => exact .rel _ _ (.inl interchange.interchange.toSwap)

theorem path_trace {start : State} {first second : Quiver.Symmetrify (Object T start)}
    (path : Quiver.Path first second) : T.TraceEquiv start first second := by
  induction path with
  | nil => exact .refl _
  | cons _ edge ih =>
      cases edge with
      | inl forward => exact .trans _ _ _ ih (generator_trace forward)
      | inr backward => exact .trans _ _ _ ih (.symm _ _ (generator_trace backward))

theorem cell_trace {start : State} {first second : P.Run start}
    (cell : Cell T first second) : T.TraceEquiv start first second := by
  induction cell using Quot.inductionOn with
  | h path => exact path_trace path

theorem nonempty_cell_iff {start : State} (first second : P.Run start) :
    Nonempty (Cell T first second) ↔ T.TraceEquiv start first second := by
  constructor
  · rintro ⟨cell⟩
    exact cell_trace cell
  · intro related
    have presented := T.presentedTrace_iff_traceEquiv.mpr related
    clear related
    induction presented with
    | rel first second elementary =>
        rcases elementary with interchange | similar
        · obtain ⟨witness⟩ := InterchangeWitness.nonempty_iff.mpr interchange
          exact ⟨generator T (.inr witness)⟩
        · obtain ⟨witness⟩ := (SimilarityWitness.nonempty_iff first second).mpr similar
          exact ⟨generator T (.inl witness)⟩
    | refl run => exact ⟨𝟙 (object T run)⟩
    | symm _ _ _ ih =>
        obtain ⟨cell⟩ := ih
        exact ⟨inv cell⟩
    | trans _ _ _ _ _ ih ih' =>
        obtain ⟨one⟩ := ih
        obtain ⟨two⟩ := ih'
        exact ⟨one ≫ two⟩

variable (T)

def interpret {start : State} {C : Type uC} [CategoryTheory.Groupoid.{uV} C]
    (generators : Object T start ⥤q C) : Groupoid T start ⥤ C :=
  Quiver.FreeGroupoid.lift generators

theorem interpretation_exists_unique {start : State} {C : Type uC}
    [CategoryTheory.Groupoid.{uV} C] (generators : Object T start ⥤q C) :
    ∃! interpretation : Groupoid T start ⥤ C,
      Quiver.FreeGroupoid.of (Object T start) ⋙q interpretation.toPrefunctor = generators := by
  refine ⟨interpret T generators, Quiver.FreeGroupoid.lift_spec generators, ?_⟩
  intro other agrees
  exact Quiver.FreeGroupoid.lift_unique generators other agrees

def Generator.events {start : State} {first second : Object T start}
    (witness : Generator T first second) : Fin first.word.length ≃ Fin second.word.length :=
  match witness with
  | .inl similar => similar.events
  | .inr interchange => interchange.events

def eventGenerators (start : State) : Object T start ⥤q Core (Type) where
  obj run := ⟨Fin run.word.length⟩
  map witness := ⟨(Generator.events T witness).toIso⟩

def eventFunctor (start : State) : Groupoid T start ⥤ Core (Type) :=
  interpret T (eventGenerators T start)

/-- The event interpretation preserves all generator maps, including swaps
of two events with equal observable labels. -/
theorem eventFunctor_generators (start : State) :
    Quiver.FreeGroupoid.of (Object T start) ⋙q (eventFunctor T start).toPrefunctor =
      eventGenerators T start := Quiver.FreeGroupoid.lift_spec _

def events {start : State} {first second : P.Run start} (cell : Cell T first second) :
    Fin first.word.length ≃ Fin second.word.length :=
  ((eventFunctor T start).map cell).iso.toEquiv

theorem events_generator {start : State} {first second : P.Run start}
    (witness : Generator T first second) :
    events T (generator T witness) = Generator.events T witness := rfl

theorem events_comp {start : State} {first second third : P.Run start}
    (one : Cell T first second) (two : Cell T second third) :
    events T (one ≫ two) = (events T one).trans (events T two) := by
  unfold events
  rw [Functor.map_comp]
  rfl

theorem events_id {start : State} (run : P.Run start) :
    events T (𝟙 (object T run)) = Equiv.refl (Fin run.word.length) := by
  unfold events
  rw [(eventFunctor T start).map_id]
  rfl

theorem events_inv {start : State} {first second : P.Run start}
    (cell : Cell T first second) : events T (inv cell) = (events T cell).symm := by
  unfold events
  rw [(eventFunctor T start).map_inv]
  rw [← CategoryTheory.Groupoid.inv_eq_inv]
  rfl

end Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Interface.Transport.RunRearrangement

