import Mettapedia.Machines.TIsa.CheckedAdmission
import Mettapedia.GSLT.Core.OperationalReadback

/-!
# Checked machine-cell admission as an operational correspondence

The source transition is acceptance by the existing executable t-ISA
checker. The target is the existing guarded resource theory of its immutable
edge table. The representation records precisely the cells present in the
declared region; values outside that region are unobserved.

Every actual target step from a represented state reads back to one accepted
checker invocation, and every accepted invocation has one target step. The
result is an instance of the existing operational correspondence and therefore
composes with subsequent checked realizations. No native emitter, HOL record
handler or occurrence-sensitive correspondence is asserted by this adapter.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Interface.Bridges.Kernel.CheckedCells

open Mettapedia.GSLT Mettapedia.GSLT.IndexedOperational
open Mettapedia.GSLT.Ultrainfinite
open Mettapedia.Machines.TIsa
open Cells CellEffects Control

universe u

variable {Key : Type u} [DecidableEq Key]

/-- The existing executable checker's accepted transition, quantifying over
the selected table ordinal and the proposed data values. -/
def Accepted (edges : List (Edge Key)) (keys : Finset (Location Key))
    (before after : Location Key → Word) : Prop :=
  ∃ index candidate, CheckedAdmission.step? edges index keys before candidate = some after

def source (edges : List (Edge Key)) (keys : Finset (Location Key)) : GSLT :=
  Mettapedia.OSLF.Framework.GSLTTypeSynthesis.equalityGSLT
    (Location Key → Word) (Accepted edges keys)

abbrev target (edges : List (Edge Key)) : GSLT := (edgeProgram edges).theory

def Represents (keys : Finset (Location Key)) (values : Location Key → Word)
    (cells : Multiset (Cell (Location Key))) : Prop :=
  cells = encode keys values

theorem accepted_sound (edges : List (Edge Key)) (keys : Finset (Location Key))
    {before after : Location Key → Word} (accepted : Accepted edges keys before after) :
    (target edges).Step (encode keys before) (encode keys after) := by
  obtain ⟨index, candidate, checked⟩ := accepted
  exact CheckedAdmission.step_sound edges index keys before candidate after checked

theorem target_step_reflected (edges : List (Edge Key)) (keys : Finset (Location Key))
    {before : Location Key → Word} {cells result : Multiset (Cell (Location Key))}
    (represented : Represents keys before cells) (step : (target edges).Step cells result) :
    ∃ after, Accepted edges keys before after ∧ Represents keys after result := by
  subst cells
  obtain ⟨index, candidate, after, checked, same⟩ :=
    CheckedAdmission.step_complete edges keys before result step
  exact ⟨after, ⟨index, candidate, checked⟩, same⟩

/-- A successful check supplies one actual target transition. -/
def translation (edges : List (Edge Key)) (keys : Finset (Location Key)) :
    OperationalTranslation (source edges keys) (target edges) where
  mapTerm := encode keys
  mapEquiv := by
    intro before after same
    exact congrArg (encode keys) same
  mapStep := accepted_sound edges keys

def realization (edges : List (Edge Key)) (keys : Finset (Location Key)) :
    OperationalRealization (source edges keys) (target edges) :=
  .ofTranslation (translation edges keys)

/-- Reflection inverts a supplied target step; it never assumes that the
step was generated by this adapter. -/
def readback (edges : List (Edge Key)) (keys : Finset (Location Key)) :
    OperationalReadback (source edges keys) (target edges) where
  related := Represents keys
  readStep := by
    intro before cells result represented step
    exact .inr (target_step_reflected edges keys represented step)

def correspondence (edges : List (Edge Key)) (keys : Finset (Location Key)) :
    OperationalCorrespondence (source edges keys) (target edges) where
  toOperationalReadback := readback edges keys
  forward := by
    intro before after cells represented accepted
    subst cells
    exact ⟨encode keys after, ⟨.cons ⟨accepted_sound edges keys accepted⟩ (.refl _)⟩, rfl⟩

/-- The exact selected region, including every control and data cell, is
the observation preserved and reflected by the correspondence. -/
theorem reachable_iff (edges : List (Edge Key)) (keys : Finset (Location Key))
    (post : Multiset (Cell (Location Key)) → Prop) (before : Location Key → Word) :
    (∃ after, (source edges keys).MultiStep before after ∧ post (encode keys after)) ↔
      ∃ result, (target edges).MultiStep (encode keys before) result ∧ post result := by
  exact (correspondence edges keys).reachable_iff
    (fun values => post (encode keys values)) post
    (fun represented => by rw [represented]) (by rfl)

/-- There are no erased checker steps in this realization. -/
theorem realized_length (edges : List (Edge Key)) (keys : Finset (Location Key))
    {before after : Location Key → Word}
    (path : ExecutionPath (source edges keys) before after) :
    ((realization edges keys).mapRoute path).length = path.length := by
  exact (congrArg (fun route => route.length)
    (OperationalRealization.mapRoute_ofTranslation (translation edges keys) path)).trans
    (OperationalTranslation.mapRoute_length (translation edges keys) path)

theorem terminal_iff (edges : List (Edge Key)) (keys : Finset (Location Key))
    (before : Location Key → Word) :
    (¬ ∃ after, Accepted edges keys before after) ↔
      ¬ ∃ result, (target edges).Step (encode keys before) result := by
  constructor
  · rintro stopped ⟨result, step⟩
    obtain ⟨after, accepted, _⟩ := target_step_reflected edges keys (by rfl) step
    exact stopped ⟨after, accepted⟩
  · rintro stopped ⟨after, accepted⟩
    exact stopped ⟨encode keys after, accepted_sound edges keys accepted⟩

/-- A later correspondence transports the same concrete cell observation.
Its relation must identify the intermediate cell state used here. -/
def followedBy (edges : List (Edge Key)) (keys : Finset (Location Key))
    {runtime : GSLT} (later : OperationalCorrespondence (target edges) runtime) :
    OperationalCorrespondence (source edges keys) runtime :=
  (correspondence edges keys).comp later

namespace Controls

def addition : Recipe Nat where
  inputs := [0, 1]
  outputs := [0]
  guard := fun inputs outputs => match inputs, outputs with
    | [left, right], [result] => result == left + right
    | _, _ => false

def edge : Edge Nat := ⟨0, 7, 8, addition⟩
def keys : Finset (Location Nat) := {.inl 0, .inr 0, .inr 1}
def initial : Location Nat → Word := fun _ => 7
def proposal : Nat → Word := fun key => if key = 0 then 14 else 99
def badProposal : Nat → Word := fun key => if key = 0 then 15 else 99

theorem accepted_addition :
    Accepted [edge] keys initial (CheckedAdmission.commit edge initial proposal) :=
  ⟨0, proposal, rfl⟩

theorem actual_resource_step :
    (target [edge]).Step (encode keys initial)
      (encode keys (CheckedAdmission.commit edge initial proposal)) :=
  accepted_sound [edge] keys accepted_addition

theorem wrong_value_refused : CheckedAdmission.step? [edge] 0 keys initial badProposal = none := rfl

theorem missing_operand_refused :
    CheckedAdmission.step? [edge] 0 ({.inl 0, .inr 0} : Finset (Location Nat)) initial proposal = none := rfl

/-- A table ordinal is not supplied by a semantic witness. Malformed
ordinals are refused by the actual list lookup. -/
theorem malformed_record_refused : CheckedAdmission.step? [edge] 1 keys initial proposal = none := rfl

def falsifiedEdge : Edge Nat := { edge with effect := { addition with guard := fun _ _ => true } }

/-- Replacing the actual guard changes the accepted relation; a proof for
one immutable edge table cannot be reused for the other. -/
theorem changed_guard_adds_behavior :
    CheckedAdmission.step? [edge] 0 keys initial badProposal = none ∧
      CheckedAdmission.step? [falsifiedEdge] 0 keys initial badProposal =
        some (CheckedAdmission.commit falsifiedEdge initial badProposal) := ⟨rfl, rfl⟩

theorem control_and_data_observed :
    CheckedAdmission.commit edge initial proposal (.inl 0) = (8#64) ∧
      CheckedAdmission.commit edge initial proposal (.inr 0) = (14#64) ∧
      CheckedAdmission.commit edge initial proposal (.inr 1) = (7#64) := ⟨rfl, rfl, rfl⟩

end Controls

#print axioms target_step_reflected
#print axioms correspondence
#print axioms reachable_iff
#print axioms realized_length
#print axioms terminal_iff
#print axioms Controls.changed_guard_adds_behavior

end Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Interface.Bridges.Kernel.CheckedCells
