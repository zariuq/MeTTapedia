import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Step.SuperpositionCompleteness
import Mathlib.Data.Sym.Sym2

/-!
# Ground Knuth–Bendix completion: items, the inference rules, soundness and redundancy

The inference system of Bachmair, Dershowitz and Plaisted (Baader–Nipkow, ch. 7) over ground terms.

## The order, a parameter with stated properties

`SimplificationOrder` asks a preorder on ground terms whose strict part is compatible with contexts
and contains the strict subterm relation. It **need not be total**: a total order orients every
ground equation between distinct terms, so completion can fail only for a partial order, such as
one that cannot tell `a·b` from `b·a`. Every `GroundSimplification` order of the superposition
modules is one (`ofGroundSimplification`). Well-foundedness is asked separately where it is used.

## Items and steps

* **Items** (`Item`): an equation, an *unordered* pair of ground terms (`Sym2`), or a rule `l → r`.
* **An equational step by an item in a context** (`Item.Rel`): an equation either way, a rule from left to right.
  `EqStep N` is an equational step by some item of `N`, and the **equational theory** of `N` is the equivalence
  it generates (`EqvGen (EqStep N)`), the congruence generated by `E ∪ R` (`theory_ctx`).

## The rules (`Rule`)

Deduce (a ground critical pair of two rules), Orient, Delete, Simplify (an equation), Compose (a
rule's right side) and Collapse (a rule's left side, by a rule strictly encompassed by it). Each
rule names the items it **takes**, **reads** and **makes**, and its **guard**: the match of its
premises and its order condition (`Rule.guard`). `Transition ρ N N'` is the effect of one rule on
the set of items.

* **Soundness** (`Transition.theory_iff`): every transition keeps the equational theory. What a
  rule makes is provable from its premises (`Transition.makes_provable`), and what it takes is
  provable from what remains (`Transition.replace`).
* **Rules stay decreasing** (`Transition.decreasing`).

## Redundancy as smaller proofs

An equational step costs, as in the proof orderings of Bachmair–Dershowitz–Plaisted, the multiset of its two
terms for an equation, and its larger term followed by the rule for a rule (`Item.cost`), compared
by the Dershowitz–Manna extension and then lexicographically (`CostLT`, well founded by
`costLT_wf`). An item is **redundant** in `N` (`Redundant`) when every step by it is provable in
`N` by steps of strictly smaller cost. **Every item a rule takes is redundant in what remains**
(`Transition.taken_redundant`): Orient replaces an equation step by a rule step on the same terms,
Simplify and Collapse by a rule step and a smaller equation, Compose by two smaller rule steps.

## Peaks

`peak_cases`: two redexes in one ground term are nested (one rule's left side inside the other's)
or apart. Apart redexes commute. Only nested ones are critical, which is why fairness need only
consider ground critical pairs.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Completion

open Mettapedia.Logic.LP
open Superposition (Ctx Ctx.fill_comp Rw Joins)
open _root_.Relation (ReflTransGen EqvGen Join)

variable {sig : LPSignature}

/-! ## Simplification orders, not necessarily total -/

/-- **A ground simplification order**: a preorder whose strict part is compatible with contexts and
contains the strict subterm relation. It need not be total. -/
class SimplificationOrder (sig : LPSignature) [Preorder (GroundTerm sig)] : Prop where
  monotone : ∀ (f : sig.functionSymbols) (args : Fin (sig.functionArity f) → GroundTerm sig)
    (i : Fin (sig.functionArity f)) (a : GroundTerm sig), a < args i →
      GroundTerm.app f (Function.update args i a) < GroundTerm.app f args
  subterm : ∀ (f : sig.functionSymbols) (args : Fin (sig.functionArity f) → GroundTerm sig)
    (i : Fin (sig.functionArity f)), args i < GroundTerm.app f args

/-- **The linear orders of ground superposition are simplification orders.** -/
instance ofGroundSimplification [LinearOrder (GroundTerm sig)] [Superposition.GroundSimplification sig] :
    SimplificationOrder sig :=
  ⟨Superposition.GroundSimplification.monotone, Superposition.GroundSimplification.subterm⟩

section Order

variable [Preorder (GroundTerm sig)] [SimplificationOrder sig]

/-- **Compatibility with contexts.** -/
theorem fill_lt_fill (c : Ctx sig) {a b : GroundTerm sig} (lt : a < b) : c.fill a < c.fill b := by
  induction c with
  | hole => exact lt
  | app f args i inner ih =>
      have step := SimplificationOrder.monotone f (Function.update args i (inner.fill b)) i
        (inner.fill a) (by rw [Function.update_self]; exact ih)
      rw [Function.update_idem] at step
      exact step

/-- **The subterm property.** -/
theorem le_fill (c : Ctx sig) (a : GroundTerm sig) : a ≤ c.fill a := by
  induction c with
  | hole => exact le_rfl
  | app f args i inner ih =>
      have step := SimplificationOrder.subterm f (Function.update args i (inner.fill a)) i
      rw [Function.update_self] at step
      exact ih.trans step.le

theorem lt_fill (c : Ctx sig) (proper : c ≠ .hole) (a : GroundTerm sig) : a < c.fill a := by
  cases c with
  | hole => exact absurd rfl proper
  | app f args i inner =>
      have step := SimplificationOrder.subterm f (Function.update args i (inner.fill a)) i
      rw [Function.update_self] at step
      exact (le_fill inner a).trans_lt step

/-- **A decreasing rule set rewrites downward.** -/
theorem rw_lt {R : GroundTerm sig → GroundTerm sig → Prop} (decreasing : ∀ l r, R l r → r < l)
    {u v : GroundTerm sig} (step : Rw R u v) : v < u := by
  obtain ⟨c, l, r, rule, rfl, rfl⟩ := step
  exact fill_lt_fill c (decreasing l r rule)

theorem steps_le {R : GroundTerm sig → GroundTerm sig → Prop} (decreasing : ∀ l r, R l r → r < l)
    {u v : GroundTerm sig} (steps : ReflTransGen (Rw R) u v) : v ≤ u := by
  induction steps with
  | refl => exact le_rfl
  | tail _ step ih => exact (rw_lt decreasing step).le.trans ih

end Order

/-! ## The Dershowitz–Manna order over a preorder -/

section DershowitzManna

variable {α : Type*} [Preorder α]

theorem dm_intro (X Y Z : Multiset α) (nonempty : Z ≠ 0) (dominated : ∀ y ∈ Y, ∃ z ∈ Z, y < z) :
    (X + Y).IsDershowitzMannaLT (X + Z) :=
  ⟨X, Y, Z, by simpa [Multiset.empty_eq_zero] using nonempty, rfl, rfl, dominated⟩

/-- Every element of the smaller side is at most an element of the larger side. -/
theorem dm_le {M N : Multiset α} (lt : M.IsDershowitzMannaLT N) {a : α} (member : a ∈ M) :
    ∃ z ∈ N, a ≤ z := by
  obtain ⟨X, Y, Z, -, rfl, rfl, dominated⟩ := lt
  rcases Multiset.mem_add.mp member with inX | inY
  · exact ⟨a, Multiset.mem_add.mpr (Or.inl inX), le_rfl⟩
  · obtain ⟨z, inZ, below⟩ := dominated a inY
    exact ⟨z, Multiset.mem_add.mpr (Or.inr inZ), below.le⟩

/-- A multiset whose elements all lie below an element of another lies below it. -/
theorem dm_of_all_below (M N : Multiset α) (nonempty : N ≠ 0) (below : ∀ y ∈ M, ∃ z ∈ N, y < z) :
    M.IsDershowitzMannaLT N := by
  have step := dm_intro 0 M N nonempty below
  rwa [zero_add, zero_add] at step

/-- One element is below a pair that contains it. -/
theorem dm_single_pair (a b : α) : ({a} : Multiset α).IsDershowitzMannaLT (a ::ₘ {b}) := by
  have step := dm_intro {a} 0 {b} (Multiset.singleton_ne_zero b)
    (fun y member => absurd member (Multiset.notMem_zero y))
  rwa [add_zero, Multiset.singleton_add] at step

/-- Lowering one element of a pair lowers the pair. -/
theorem dm_pair_lower {a a' : α} (b : α) (lt : a' < a) :
    (a' ::ₘ {b}).IsDershowitzMannaLT (a ::ₘ {b}) := by
  have step := dm_intro {b} {a'} {a} (Multiset.singleton_ne_zero a)
    (fun y member => ⟨a, Multiset.mem_singleton_self a, (Multiset.mem_singleton.mp member) ▸ lt⟩)
  rwa [add_comm, Multiset.singleton_add, add_comm, Multiset.singleton_add] at step

end DershowitzManna

/-! ## Items and steps -/

/-- **A stored item of completion**: an equation, an unordered pair of ground terms, or a rule. -/
inductive Item (sig : LPSignature) where
  | eqn (e : Sym2 (GroundTerm sig))
  | rule (l r : GroundTerm sig)

/-- **An equational step by an item in a context**: an equation either way, a rule from left to right. -/
def Item.Rel : Item sig → Ctx sig → GroundTerm sig → GroundTerm sig → Prop
  | .eqn e, c, a, b => s(a, b) = e.map c.fill
  | .rule l r, c, a, b => a = c.fill l ∧ b = c.fill r

theorem rel_eqn {s t : GroundTerm sig} {c : Ctx sig} {a b : GroundTerm sig} :
    (Item.eqn s(s, t)).Rel c a b ↔ (a = c.fill s ∧ b = c.fill t) ∨ (a = c.fill t ∧ b = c.fill s) := by
  show s(a, b) = s(c.fill s, c.fill t) ↔ _
  exact Sym2.eq_iff

theorem rel_rule {l r : GroundTerm sig} {c : Ctx sig} {a b : GroundTerm sig} :
    (Item.rule l r).Rel c a b ↔ a = c.fill l ∧ b = c.fill r :=
  Iff.rfl

/-- A step in a context is a step in every larger context. -/
theorem Item.Rel.ctx {x : Item sig} {c : Ctx sig} {a b : GroundTerm sig} (rel : x.Rel c a b) (d : Ctx sig) :
    x.Rel (d.comp c) (d.fill a) (d.fill b) := by
  cases x with
  | eqn e =>
      have fills : (d.comp c).fill = d.fill ∘ c.fill := funext (Ctx.fill_comp d c)
      show s(d.fill a, d.fill b) = e.map (d.comp c).fill
      rw [fills, ← Sym2.map_map, ← show s(a, b) = e.map c.fill from rel]
      rfl
  | rule l r =>
      obtain ⟨rfl, rfl⟩ := rel
      exact ⟨(Ctx.fill_comp d c l).symm, (Ctx.fill_comp d c r).symm⟩

/-- **One equational step with the items of `N`.** -/
def EqStep (N : Set (Item sig)) (a b : GroundTerm sig) : Prop := ∃ x ∈ N, ∃ c, x.Rel c a b

theorem EqStep.ctx {N : Set (Item sig)} {a b : GroundTerm sig} (step : EqStep N a b) (d : Ctx sig) :
    EqStep N (d.fill a) (d.fill b) := by
  obtain ⟨x, member, c, rel⟩ := step
  exact ⟨x, member, d.comp c, rel.ctx d⟩

/-- Every relation whose steps are conversions of another is contained in its conversions. -/
theorem eqvGen_flatten {α : Type*} {r s : α → α → Prop} (each : ∀ a b, r a b → EqvGen s a b) {a b : α}
    (conv : EqvGen r a b) : EqvGen s a b := by
  induction conv with
  | rel _ _ step => exact each _ _ step
  | refl => exact EqvGen.refl _
  | symm _ _ _ ih => exact EqvGen.symm _ _ ih
  | trans _ _ _ _ _ ih₁ ih₂ => exact EqvGen.trans _ _ _ ih₁ ih₂

/-- **The equational theory is a congruence.** -/
theorem theory_ctx {N : Set (Item sig)} {a b : GroundTerm sig} (conv : EqvGen (EqStep N) a b) (d : Ctx sig) :
    EqvGen (EqStep N) (d.fill a) (d.fill b) := by
  induction conv with
  | rel _ _ step => exact EqvGen.rel _ _ (step.ctx d)
  | refl => exact EqvGen.refl _
  | symm _ _ _ ih => exact EqvGen.symm _ _ ih
  | trans _ _ _ _ _ ih₁ ih₂ => exact EqvGen.trans _ _ _ ih₁ ih₂

theorem rule_step {N : Set (Item sig)} {l r : GroundTerm sig} (member : Item.rule l r ∈ N) (c : Ctx sig) :
    EqvGen (EqStep N) (c.fill l) (c.fill r) :=
  EqvGen.rel _ _ ⟨_, member, c, rfl, rfl⟩

theorem eqn_step {N : Set (Item sig)} {s t : GroundTerm sig} (member : Item.eqn s(s, t) ∈ N) (c : Ctx sig) :
    EqvGen (EqStep N) (c.fill s) (c.fill t) :=
  EqvGen.rel _ _ ⟨_, member, c, rel_eqn.mpr (Or.inl ⟨rfl, rfl⟩)⟩

/-- The rules among the items. -/
def rules (N : Set (Item sig)) (l r : GroundTerm sig) : Prop := Item.rule l r ∈ N

/-- **The rules of `N` are decreasing.** -/
def Decreasing [Preorder (GroundTerm sig)] (N : Set (Item sig)) : Prop := ∀ l r, Item.rule l r ∈ N → r < l

/-! ## Costs of steps -/

/-- The cost of a step: a multiset of terms, then a rule, or `⊥` for an equation. -/
abbrev Cost (sig : LPSignature) := Multiset (GroundTerm sig) × WithBot (GroundTerm sig ×ₗ GroundTerm sig)

/-- **The cost of a step** (Bachmair–Dershowitz–Plaisted): an equation step costs the multiset of
its two terms, a rule step its larger term and then the rule. -/
def Item.cost (c : Ctx sig) : Item sig → Cost sig
  | .eqn e => ((e.map c.fill).toMultiset, ⊥)
  | .rule l r => ({c.fill l}, ↑(toLex (l, r)))

theorem toMultiset_mk (a b : GroundTerm sig) : (s(a, b) : Sym2 (GroundTerm sig)).toMultiset = a ::ₘ {b} :=
  rfl

theorem cost_eqn (c : Ctx sig) (s t : GroundTerm sig) :
    (Item.eqn s(s, t)).cost c = (c.fill s ::ₘ {c.fill t}, ⊥) :=
  rfl

section Costs

variable [Preorder (GroundTerm sig)]

/-- **The cost order**: the Dershowitz–Manna extension on the terms, then the rule. -/
def CostLT (κ κ' : Cost sig) : Prop :=
  Prod.Lex (fun M N => M.IsDershowitzMannaLT N) (· < ·) κ κ'

theorem costLT_wf [WellFoundedLT (GroundTerm sig)] : WellFounded (CostLT (sig := sig)) :=
  WellFounded.prod_lex Multiset.wellFounded_isDershowitzMannaLT wellFounded_lt

theorem costLT_trans {κ₁ κ₂ κ₃ : Cost sig} (one : CostLT κ₁ κ₂) (two : CostLT κ₂ κ₃) : CostLT κ₁ κ₃ := by
  unfold CostLT at one two ⊢
  rw [Prod.lex_def] at one two ⊢
  rcases one with one | ⟨same, one⟩ <;> rcases two with two | ⟨same', two⟩
  · exact Or.inl (one.trans two)
  · rw [← same']
    exact Or.inl one
  · rw [same]
    exact Or.inl two
  · exact Or.inr ⟨same.trans same', one.trans two⟩

theorem costLT_of_terms {κ κ' : Cost sig} (lt : κ.1.IsDershowitzMannaLT κ'.1) : CostLT κ κ' := by
  unfold CostLT
  rw [Prod.lex_def]
  exact Or.inl lt

theorem costLT_of_rule {κ κ' : Cost sig} (same : κ.1 = κ'.1) (lt : κ.2 < κ'.2) : CostLT κ κ' := by
  unfold CostLT
  rw [Prod.lex_def]
  exact Or.inr ⟨same, lt⟩

theorem rule_lt_rule {l r l' r' : GroundTerm sig} (lt : l < l' ∨ l = l' ∧ r < r') :
    ((↑(toLex (l, r)) : WithBot (GroundTerm sig ×ₗ GroundTerm sig))) < ↑(toLex (l', r')) :=
  WithBot.coe_lt_coe.mpr (Prod.Lex.toLex_lt_toLex.mpr lt)

/-- **Every term of a step lies below `m`.** -/
def Bounded (m : GroundTerm sig) (κ : Cost sig) : Prop := ∀ t ∈ κ.1, t < m

theorem Bounded.of_costLT {m : GroundTerm sig} {κ κ' : Cost sig} (lt : CostLT κ' κ) (bounded : Bounded m κ) :
    Bounded m κ' := by
  unfold CostLT at lt
  rw [Prod.lex_def] at lt
  intro t member
  rcases lt with lt | ⟨same, -⟩
  · obtain ⟨z, inZ, le⟩ := dm_le lt member
    exact le.trans_lt (bounded z inZ)
  · exact bounded t (same ▸ member)

variable [SimplificationOrder sig]

/-- **A step with bounded cost has its terms below the bound.** -/
theorem Item.Rel.lt_of_bounded {x : Item sig} {c : Ctx sig} {a b m : GroundTerm sig}
    (oriented : ∀ l r, x = .rule l r → r < l) (rel : x.Rel c a b) (bounded : Bounded m (x.cost c)) :
    a < m ∧ b < m := by
  cases x with
  | eqn e =>
      have same : e.map c.fill = s(a, b) := (show s(a, b) = e.map c.fill from rel).symm
      have inA : a ∈ (e.map c.fill).toMultiset := by rw [same, toMultiset_mk]; exact Multiset.mem_cons_self _ _
      have inB : b ∈ (e.map c.fill).toMultiset := by
        rw [same, toMultiset_mk]; exact Multiset.mem_cons_of_mem (Multiset.mem_singleton_self _)
      exact ⟨bounded a inA, bounded b inB⟩
  | rule l r =>
      obtain ⟨rfl, rfl⟩ := rel
      have top : c.fill l < m := bounded _ (Multiset.mem_singleton_self _)
      exact ⟨top, (fill_lt_fill c (oriented l r rfl)).trans top⟩

end Costs

/-! ## The inference rules -/

/-- **The rules of ground completion**, with the terms they mention. -/
inductive Rule (sig : LPSignature) where
  /-- Deduce the critical pair `d[r₁] ≈ r₂` of `l₁ → r₁` and `l₂ → r₂` with `d[l₁] = l₂`. -/
  | deduce (l₁ r₁ l₂ r₂ : GroundTerm sig) (d : Ctx sig)
  /-- Orient `s ≈ t` into `s → t`. -/
  | orient (s t : GroundTerm sig)
  /-- Delete a trivial equation `s ≈ t`, `s = t`. -/
  | delete (s t : GroundTerm sig)
  /-- Simplify `s ≈ t` to `c[r] ≈ t` by `l → r`, where `s = c[l]`. -/
  | simplify (s t l r : GroundTerm sig) (c : Ctx sig)
  /-- Compose `s → t` into `s → c[r]` by `l → r`, where `t = c[l]`. -/
  | compose (s t l r : GroundTerm sig) (c : Ctx sig)
  /-- Collapse `s → t` into `c[r] ≈ t` by `l → r`, where `s = c[l]` strictly encompasses `l`. -/
  | collapse (s t l r : GroundTerm sig) (c : Ctx sig)

namespace Rule

/-- The item a rule takes. -/
def takes : Rule sig → List (Item sig)
  | deduce .. => []
  | orient s t => [.eqn s(s, t)]
  | delete s t => [.eqn s(s, t)]
  | simplify s t _ _ _ => [.eqn s(s, t)]
  | compose s t _ _ _ => [.rule s t]
  | collapse s t _ _ _ => [.rule s t]

/-- The items a rule reads. -/
def reads : Rule sig → List (Item sig)
  | deduce l₁ r₁ l₂ r₂ _ => [.rule l₁ r₁, .rule l₂ r₂]
  | orient .. => []
  | delete .. => []
  | simplify _ _ l r _ => [.rule l r]
  | compose _ _ l r _ => [.rule l r]
  | collapse _ _ l r _ => [.rule l r]

/-- The item a rule makes. -/
def makes : Rule sig → List (Item sig)
  | deduce _ r₁ _ r₂ d => [.eqn s(d.fill r₁, r₂)]
  | orient s t => [.rule s t]
  | delete .. => []
  | simplify _ t _ r c => [.eqn s(c.fill r, t)]
  | compose s _ _ r c => [.rule s (c.fill r)]
  | collapse _ t _ r c => [.eqn s(c.fill r, t)]

/-- **The guard of a rule**: the match of its premises and its order condition. Only Orient
(`t < s`) and Collapse (`c ≠ □`: `s` strictly encompasses `l`) have an order condition. -/
def guard [Preorder (GroundTerm sig)] : Rule sig → Prop
  | deduce l₁ _ l₂ _ d => d.fill l₁ = l₂
  | orient s t => t < s
  | delete s t => s = t
  | simplify s _ l _ c => s = c.fill l
  | compose _ t l _ c => t = c.fill l
  | collapse s _ l _ c => s = c.fill l ∧ c ≠ .hole

end Rule

/-- **One rule applied to a set of items**: its premises are present, what it reads and makes is
present after, nothing it does not take is lost, and nothing but what it makes is new. -/
structure Transition [Preorder (GroundTerm sig)] (ρ : Rule sig) (N N' : Set (Item sig)) : Prop where
  guard : ρ.guard
  premises : ∀ x ∈ ρ.takes ++ ρ.reads, x ∈ N
  reads : ∀ x ∈ ρ.reads, x ∈ N'
  makes : ∀ x ∈ ρ.makes, x ∈ N'
  keeps : ∀ x ∈ N, x ∉ ρ.takes → x ∈ N'
  new : ∀ x ∈ N', x ∈ N ∨ x ∈ ρ.makes

section Transitions

variable [Preorder (GroundTerm sig)] {ρ : Rule sig} {N N' : Set (Item sig)}

theorem Transition.premise (t : Transition ρ N N') {x : Item sig} (member : x ∈ ρ.reads) : x ∈ N :=
  t.premises x (List.mem_append_right _ member)

theorem Transition.taken (t : Transition ρ N N') {x : Item sig} (member : x ∈ ρ.takes) : x ∈ N :=
  t.premises x (List.mem_append_left _ member)

/-- **What a rule makes is provable from its premises.** -/
theorem Transition.makes_provable (t : Transition ρ N N') :
    ∀ x ∈ ρ.makes, ∀ c a b, x.Rel c a b → EqvGen (EqStep N) a b := by
  intro x member e a b rel
  cases ρ with
  | deduce l₁ r₁ l₂ r₂ d =>
      rw [List.mem_singleton.mp member] at rel
      have one := rule_step (t.premise (x := .rule l₁ r₁) (by simp [Rule.reads])) (e.comp d)
      have two := rule_step (t.premise (x := .rule l₂ r₂) (by simp [Rule.reads])) e
      have overlap : (e.comp d).fill l₁ = e.fill l₂ := by
        rw [Ctx.fill_comp, show d.fill l₁ = l₂ from t.guard]
      rw [overlap, Ctx.fill_comp] at one
      have chain := EqvGen.trans _ _ _ (EqvGen.symm _ _ one) two
      rcases rel_eqn.mp rel with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact chain
      · exact EqvGen.symm _ _ chain
  | orient s t' =>
      rw [List.mem_singleton.mp member] at rel
      obtain ⟨rfl, rfl⟩ := rel
      exact eqn_step (t.taken (x := .eqn s(s, t')) (by simp [Rule.takes])) e
  | delete s t' => simp [Rule.makes] at member
  | simplify s t' l r c =>
      rw [List.mem_singleton.mp member] at rel
      have one := rule_step (t.premise (x := .rule l r) (by simp [Rule.reads])) (e.comp c)
      have two := eqn_step (t.taken (x := .eqn s(s, t')) (by simp [Rule.takes])) e
      rw [Ctx.fill_comp, Ctx.fill_comp, ← show s = c.fill l from t.guard] at one
      have chain := EqvGen.trans _ _ _ (EqvGen.symm _ _ one) two
      rcases rel_eqn.mp rel with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact chain
      · exact EqvGen.symm _ _ chain
  | compose s t' l r c =>
      rw [List.mem_singleton.mp member] at rel
      obtain ⟨rfl, rfl⟩ := rel
      have one := rule_step (t.taken (x := .rule s t') (by simp [Rule.takes])) e
      have two := rule_step (t.premise (x := .rule l r) (by simp [Rule.reads])) (e.comp c)
      rw [Ctx.fill_comp, Ctx.fill_comp, ← show t' = c.fill l from t.guard] at two
      exact EqvGen.trans _ _ _ one two
  | collapse s t' l r c =>
      rw [List.mem_singleton.mp member] at rel
      have one := rule_step (t.premise (x := .rule l r) (by simp [Rule.reads])) (e.comp c)
      have two := rule_step (t.taken (x := .rule s t') (by simp [Rule.takes])) e
      rw [Ctx.fill_comp, Ctx.fill_comp, ← show s = c.fill l from t.guard.1] at one
      have chain := EqvGen.trans _ _ _ (EqvGen.symm _ _ one) two
      rcases rel_eqn.mp rel with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact chain
      · exact EqvGen.symm _ _ chain

/-- **A replacement step**: a step of `N'`, of cost below `κ` when the rules of `N` decrease. -/
def Smaller (N N' : Set (Item sig)) (κ : Cost sig) (a b : GroundTerm sig) : Prop :=
  ∃ y ∈ N', ∃ c, y.Rel c a b ∧ (Decreasing N → CostLT (y.cost c) κ)

theorem smaller_single {κ : Cost sig} {y : Item sig} (member : y ∈ N') {c : Ctx sig} {a b : GroundTerm sig}
    (rel : y.Rel c a b) (lt : Decreasing N → CostLT (y.cost c) κ) : EqvGen (Smaller N N' κ) a b :=
  EqvGen.rel _ _ ⟨y, member, c, rel, lt⟩

variable [SimplificationOrder sig]

/-- **What a rule takes is provable from what remains, by steps of smaller cost.** -/
theorem Transition.replace (t : Transition ρ N N') :
    ∀ x ∈ ρ.takes, ∀ c a b, x.Rel c a b → EqvGen (Smaller N N' (x.cost c)) a b := by
  intro x member e a b rel
  cases ρ with
  | deduce l₁ r₁ l₂ r₂ d => simp [Rule.takes] at member
  | orient s t' =>
      rw [List.mem_singleton.mp member] at rel ⊢
      have made : Item.rule s t' ∈ N' := t.makes _ (by simp [Rule.makes])
      have lt : Decreasing N → CostLT ((Item.rule s t').cost e) ((Item.eqn s(s, t')).cost e) :=
        fun _ => costLT_of_terms
          (show ({e.fill s} : Multiset _).IsDershowitzMannaLT (e.fill s ::ₘ {e.fill t'}) from dm_single_pair _ _)
      have chain : EqvGen (Smaller N N' ((Item.eqn s(s, t')).cost e)) (e.fill s) (e.fill t') :=
        smaller_single made ⟨rfl, rfl⟩ lt
      rcases rel_eqn.mp rel with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact chain
      · exact EqvGen.symm _ _ chain
  | delete s t' =>
      rw [List.mem_singleton.mp member] at rel
      have same : s = t' := t.guard
      subst same
      rcases rel_eqn.mp rel with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;> exact EqvGen.refl _
  | simplify s t' l r c =>
      rw [List.mem_singleton.mp member] at rel ⊢
      have read : Item.rule l r ∈ N' := t.reads _ (by simp [Rule.reads])
      have made : Item.eqn s(c.fill r, t') ∈ N' := t.makes _ (by simp [Rule.makes])
      have match_ : s = c.fill l := t.guard
      have one : EqvGen (Smaller N N' ((Item.eqn s(s, t')).cost e)) (e.fill s) (e.fill (c.fill r)) := by
        refine smaller_single read (c := e.comp c) ⟨by rw [Ctx.fill_comp, match_], (Ctx.fill_comp e c r).symm⟩
          fun _ => costLT_of_terms ?_
        show ({(e.comp c).fill l} : Multiset _).IsDershowitzMannaLT (e.fill s ::ₘ {e.fill t'})
        rw [Ctx.fill_comp, ← match_]
        exact dm_single_pair _ _
      have two : EqvGen (Smaller N N' ((Item.eqn s(s, t')).cost e)) (e.fill (c.fill r)) (e.fill t') := by
        refine smaller_single made (c := e) (rel_eqn.mpr (Or.inl ⟨rfl, rfl⟩)) fun decreasing => ?_
        refine costLT_of_terms ?_
        show (e.fill (c.fill r) ::ₘ {e.fill t'}).IsDershowitzMannaLT (e.fill s ::ₘ {e.fill t'})
        refine dm_pair_lower _ (fill_lt_fill e ?_)
        rw [match_]
        exact fill_lt_fill c (decreasing l r (t.premise (by simp [Rule.reads])))
      have chain := EqvGen.trans _ _ _ one two
      rcases rel_eqn.mp rel with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact chain
      · exact EqvGen.symm _ _ chain
  | compose s t' l r c =>
      rw [List.mem_singleton.mp member] at rel ⊢
      obtain ⟨rfl, rfl⟩ := rel
      have read : Item.rule l r ∈ N' := t.reads _ (by simp [Rule.reads])
      have made : Item.rule s (c.fill r) ∈ N' := t.makes _ (by simp [Rule.makes])
      have match_ : t' = c.fill l := t.guard
      have one : EqvGen (Smaller N N' ((Item.rule s t').cost e)) (e.fill s) (e.fill (c.fill r)) := by
        refine smaller_single made (c := e) ⟨rfl, rfl⟩ fun decreasing => costLT_of_rule rfl ?_
        refine rule_lt_rule (Or.inr ⟨rfl, ?_⟩)
        rw [match_]
        exact fill_lt_fill c (decreasing l r (t.premise (by simp [Rule.reads])))
      have two : EqvGen (Smaller N N' ((Item.rule s t').cost e)) (e.fill t') (e.fill (c.fill r)) := by
        refine smaller_single read (c := e.comp c) ⟨by rw [Ctx.fill_comp, match_], (Ctx.fill_comp e c r).symm⟩
          fun decreasing => costLT_of_terms ?_
        show ({(e.comp c).fill l} : Multiset _).IsDershowitzMannaLT {e.fill s}
        rw [Ctx.fill_comp, ← match_]
        refine dm_of_all_below _ _ (Multiset.singleton_ne_zero _) fun y inY => ⟨e.fill s,
          Multiset.mem_singleton_self _, ?_⟩
        rw [Multiset.mem_singleton.mp inY]
        exact fill_lt_fill e (decreasing s t' (t.taken (by simp [Rule.takes])))
      exact EqvGen.trans _ _ _ one (EqvGen.symm _ _ two)
  | collapse s t' l r c =>
      rw [List.mem_singleton.mp member] at rel ⊢
      obtain ⟨rfl, rfl⟩ := rel
      have read : Item.rule l r ∈ N' := t.reads _ (by simp [Rule.reads])
      have made : Item.eqn s(c.fill r, t') ∈ N' := t.makes _ (by simp [Rule.makes])
      obtain ⟨match_, proper⟩ : s = c.fill l ∧ c ≠ .hole := t.guard
      have one : EqvGen (Smaller N N' ((Item.rule s t').cost e)) (e.fill s) (e.fill (c.fill r)) := by
        refine smaller_single read (c := e.comp c) ⟨by rw [Ctx.fill_comp, match_], (Ctx.fill_comp e c r).symm⟩
          fun _ => costLT_of_rule ?_ ?_
        · show ({(e.comp c).fill l} : Multiset _) = {e.fill s}
          rw [Ctx.fill_comp, ← match_]
        · refine rule_lt_rule (Or.inl ?_)
          rw [match_]
          exact lt_fill c proper l
      have two : EqvGen (Smaller N N' ((Item.rule s t').cost e)) (e.fill (c.fill r)) (e.fill t') := by
        refine smaller_single made (c := e) (rel_eqn.mpr (Or.inl ⟨rfl, rfl⟩)) fun decreasing => ?_
        refine costLT_of_terms ?_
        show (e.fill (c.fill r) ::ₘ {e.fill t'}).IsDershowitzMannaLT {e.fill s}
        refine dm_of_all_below _ _ (Multiset.singleton_ne_zero _) fun y inY => ⟨e.fill s,
          Multiset.mem_singleton_self _, ?_⟩
        rcases Multiset.mem_cons.mp inY with rfl | inT
        · rw [match_]
          exact fill_lt_fill e (fill_lt_fill c (decreasing l r (t.premise (by simp [Rule.reads]))))
        · rw [Multiset.mem_singleton.mp inT]
          exact fill_lt_fill e (decreasing s t' (t.taken (by simp [Rule.takes])))
      exact EqvGen.trans _ _ _ one two

/-- **Every transition keeps the equational theory**: the equivalence generated by `E ∪ R`. -/
theorem Transition.theory_iff (t : Transition ρ N N') (a b : GroundTerm sig) :
    EqvGen (EqStep N) a b ↔ EqvGen (EqStep N') a b := by
  constructor
  · refine eqvGen_flatten fun u v ⟨x, member, c, rel⟩ => ?_
    by_cases taken : x ∈ ρ.takes
    · exact EqvGen.mono (fun _ _ ⟨y, inY, c', rel', _⟩ => ⟨y, inY, c', rel'⟩) _ _
        (t.replace x taken c u v rel)
    · exact EqvGen.rel _ _ ⟨x, t.keeps x member taken, c, rel⟩
  · refine eqvGen_flatten fun u v ⟨x, member, c, rel⟩ => ?_
    rcases t.new x member with old | made
    · exact EqvGen.rel _ _ ⟨x, old, c, rel⟩
    · exact t.makes_provable x made c u v rel

/-- **Rules stay decreasing.** -/
theorem Transition.decreasing (t : Transition ρ N N') (decreasing : Decreasing N) : Decreasing N' := by
  intro l r member
  rcases t.new _ member with old | made
  · exact decreasing l r old
  · cases ρ with
    | deduce l₁ r₁ l₂ r₂ d => simp [Rule.makes] at made
    | orient s t' =>
        simp only [Rule.makes, List.mem_singleton, Item.rule.injEq] at made
        obtain ⟨hl, hr⟩ := made
        rw [hl, hr]
        exact t.guard
    | delete s t' => simp [Rule.makes] at made
    | simplify s t' l' r' c => simp [Rule.makes] at made
    | compose s t' l' r' c =>
        simp only [Rule.makes, List.mem_singleton, Item.rule.injEq] at made
        obtain ⟨hl, hr⟩ := made
        rw [hl, hr]
        have match_ : t' = c.fill l' := t.guard
        have below : c.fill r' < t' := by
          rw [match_]
          exact fill_lt_fill c (decreasing l' r' (t.premise (by simp [Rule.reads])))
        exact below.trans (decreasing s t' (t.taken (by simp [Rule.takes])))
    | collapse s t' l' r' c => simp [Rule.makes] at made

/-- **A redundant item** (Bachmair–Dershowitz–Plaisted): every step by it is provable in `N` by
steps of strictly smaller cost. -/
def Redundant (N : Set (Item sig)) (x : Item sig) : Prop :=
  ∀ c a b, x.Rel c a b →
    EqvGen (fun a' b' => ∃ y ∈ N, ∃ c', y.Rel c' a' b' ∧ CostLT (y.cost c') (x.cost c)) a b

/-- **Every item a rule takes is redundant in what remains.** -/
theorem Transition.taken_redundant (t : Transition ρ N N') (decreasing : Decreasing N) :
    ∀ x ∈ ρ.takes, Redundant N' x := fun x member c a b rel =>
  EqvGen.mono (fun _ _ ⟨y, inY, c', rel', lt⟩ => ⟨y, inY, c', rel', lt decreasing⟩) _ _
    (t.replace x member c a b rel)

end Transitions

/-! ## Peaks -/

theorem update_congr {α : Type*} {n : ℕ} {args args' : Fin n → α} {i : Fin n}
    (off : ∀ k, k ≠ i → args k = args' k) (v : α) :
    Function.update args i v = Function.update args' i v := by
  funext k
  by_cases hk : k = i
  · subst hk
    rw [Function.update_self, Function.update_self]
  · rw [Function.update_of_ne hk, Function.update_of_ne hk]
    exact off k hk

/-- **Two redexes in one ground term are nested or apart.** Nested: the first left side lies inside
the second at `d`, or the second inside the first. Apart: each rewrite leaves the other's redex in
place, and the two orders meet. -/
theorem peak_cases : ∀ (c₁ c₂ : Ctx sig) {l₁ l₂ : GroundTerm sig}, c₁.fill l₁ = c₂.fill l₂ →
    (∃ d : Ctx sig, d.fill l₁ = l₂ ∧ ∀ t, c₁.fill t = c₂.fill (d.fill t)) ∨
    (∃ d : Ctx sig, d.fill l₂ = l₁ ∧ ∀ t, c₂.fill t = c₁.fill (d.fill t)) ∨
    (∀ r₁ r₂ : GroundTerm sig, ∃ e₁ e₂ : Ctx sig,
      c₁.fill r₁ = e₁.fill l₂ ∧ c₂.fill r₂ = e₂.fill l₁ ∧ e₁.fill r₂ = e₂.fill r₁)
  | .hole, c₂, l₁, l₂, same => Or.inr (Or.inl ⟨c₂, same.symm, fun _ => rfl⟩)
  | .app f args i inner, .hole, l₁, l₂, same => Or.inl ⟨.app f args i inner, same, fun _ => rfl⟩
  | .app f args i inner, .app g args' j inner', l₁, l₂, same => by
      obtain ⟨rfl, hargs⟩ := GroundTerm.app.inj same
      have equal := eq_of_heq hargs
      have off : ∀ k, k ≠ i → k ≠ j → args k = args' k := fun k hi hj => by
        have at_k := congrFun equal k
        rwa [Function.update_of_ne hi, Function.update_of_ne hj] at at_k
      by_cases hij : i = j
      · subst hij
        have at_i := congrFun equal i
        rw [Function.update_self, Function.update_self] at at_i
        have outer : ∀ v, Function.update args i v = Function.update args' i v :=
          update_congr fun k hk => off k hk hk
        rcases peak_cases inner inner' at_i with ⟨d, overlap, fills⟩ | ⟨d, overlap, fills⟩ | apart
        · refine Or.inl ⟨d, overlap, fun t => ?_⟩
          show GroundTerm.app f (Function.update args i (inner.fill t)) =
            GroundTerm.app f (Function.update args' i (inner'.fill (d.fill t)))
          rw [fills, outer]
        · refine Or.inr (Or.inl ⟨d, overlap, fun t => ?_⟩)
          show GroundTerm.app f (Function.update args' i (inner'.fill t)) =
            GroundTerm.app f (Function.update args i (inner.fill (d.fill t)))
          rw [fills, outer]
        · refine Or.inr (Or.inr fun r₁ r₂ => ?_)
          obtain ⟨e₁, e₂, one, two, meet⟩ := apart r₁ r₂
          refine ⟨.app f args i e₁, .app f args' i e₂, ?_, ?_, ?_⟩
          · show GroundTerm.app f (Function.update args i (inner.fill r₁)) =
              GroundTerm.app f (Function.update args i (e₁.fill l₂))
            rw [one]
          · show GroundTerm.app f (Function.update args' i (inner'.fill r₂)) =
              GroundTerm.app f (Function.update args' i (e₂.fill l₁))
            rw [two]
          · show GroundTerm.app f (Function.update args i (e₁.fill r₂)) =
              GroundTerm.app f (Function.update args' i (e₂.fill r₁))
            rw [meet, outer]
      · have at_i := congrFun equal i
        rw [Function.update_self, Function.update_of_ne hij] at at_i
        have at_j := congrFun equal j
        rw [Function.update_of_ne (Ne.symm hij), Function.update_self] at at_j
        refine Or.inr (Or.inr fun r₁ r₂ => ?_)
        refine ⟨.app f (Function.update args i (inner.fill r₁)) j inner',
          .app f (Function.update args' j (inner'.fill r₂)) i inner, ?_, ?_, ?_⟩
        · show GroundTerm.app f (Function.update args i (inner.fill r₁)) =
            GroundTerm.app f (Function.update (Function.update args i (inner.fill r₁)) j (inner'.fill l₂))
          congr 1
          funext k
          by_cases hk : k = j
          · subst hk
            rw [Function.update_self, Function.update_of_ne (Ne.symm hij)]
            exact at_j
          · rw [Function.update_of_ne hk]
        · show GroundTerm.app f (Function.update args' j (inner'.fill r₂)) =
            GroundTerm.app f (Function.update (Function.update args' j (inner'.fill r₂)) i (inner.fill l₁))
          congr 1
          funext k
          by_cases hk : k = i
          · subst hk
            rw [Function.update_self, Function.update_of_ne hij]
            exact at_i.symm
          · rw [Function.update_of_ne hk]
        · show GroundTerm.app f (Function.update (Function.update args i (inner.fill r₁)) j (inner'.fill r₂)) =
            GroundTerm.app f (Function.update (Function.update args' j (inner'.fill r₂)) i (inner.fill r₁))
          congr 1
          funext k
          by_cases hk : k = i
          · subst hk
            rw [Function.update_of_ne hij, Function.update_self, Function.update_self]
          · by_cases hk' : k = j
            · subst hk'
              rw [Function.update_self, Function.update_of_ne hk, Function.update_self]
            · rw [Function.update_of_ne hk', Function.update_of_ne hk, Function.update_of_ne hk,
                Function.update_of_ne hk']
              exact off k hk hk'

