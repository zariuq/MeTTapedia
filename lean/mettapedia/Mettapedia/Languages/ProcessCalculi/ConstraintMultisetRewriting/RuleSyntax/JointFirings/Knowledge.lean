import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.RuleSyntax.JointFirings.OneAfterAnother
import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.RuleSyntax.Examples

/-!
# A bag that no member can begin: one member tells what another's guard asks

Where the two readings of the guards part. Two rows are labelled by two unknowns `x` and `y` that nothing
binds. Two rules both read the two rows:

* `tellFirst` tells that the first row is `5` and guards that the second is `6`;
* `tellSecond` tells that the second row is `6` and guards that the first is `5`.

One match of each, on the two rows:

* **Neither is admitted by the step of the program** (`first_refused`, `second_refused`): the guard of
  each fails at a solution of its own information, where the other row is free.
* **The bag of the two is admitted with the guards at the joint information** (`both_admitted`): the
  joint information binds `x` to `5` and `y` to `6`, and both guards hold at every solution of it.
* **It is refused with the guards at each member's own information** (`both_refused_own`).

So with guards at the joint information the bag step is not generated by the step of the program, without
any absence check: a bag is committed that no order of its members can run, since no member can begin
(`no_order`). The fragment where it is generated is in `OneAfterAnother`: states that mention only fixed
terms (`admitsOwn_of_fixed`); the two rows here mention an unknown each, the one hypothesis that fails.

The result of the bag keeps both rows and knows both tells (`both_result_present`, `both_binds`).
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.RuleSyntax.JointFirings.Knowledge

open Interface (Frames)
open MeTTaCalculus.OccurrenceCommits (Enabled fire)
open Mettapedia.Logic.LP
open OneFrame (Terms frames ext)
open Examples (Tm X E c)
open _root_.Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.RuleSyntax.Controls
  (atoms action)

/-- The unknown `n`. -/
def v (n : ℕ) : Term atoms := .var n

/-- Read two rows; tell that the first is `5`; guard that the second is `6`. -/
def tellFirst : Rule Tm := ⟨PUnit.unit, ⟨[], [v 0, v 1], [(v 0, c 5)], [.equal (v 1) (c 6)], []⟩, []⟩

/-- Read two rows; tell that the second is `6`; guard that the first is `5`. -/
def tellSecond : Rule Tm := ⟨PUnit.unit, ⟨[], [v 0, v 1], [(v 1, c 6)], [.equal (v 0) (c 5)], []⟩, []⟩

/-- **The program.** -/
def program : Program Tm := {tellFirst, tellSecond}

/-- Two rows labelled by the unknowns `x` and `y`, which nothing binds. -/
def start : State Tm ℕ := ⟨PUnit.unit, [], {0, 1}, fun o => v o⟩

/-- The opening that renames each unknown `n` to `n + k`. -/
def shiftBy (k : ℕ) : Subst atoms := fun n => Term.var (n + k)

/-- The match of `tellFirst` on the two rows. -/
def first : OneMember action ℕ program := ⟨tellFirst, Or.inl rfl, shiftBy 2, ⟨[], [0, 1], []⟩, []⟩

/-- The match of `tellSecond` on the two rows. -/
def second : OneMember action ℕ program := ⟨tellSecond, Or.inr rfl, shiftBy 4, ⟨[], [0, 1], []⟩, []⟩

/-- **The bag of the two matches.** -/
def both : Bag ℕ E program PUnit.unit := bagOf action [first, second]

theorem first_information :
    first.firing.information X start = [(v 2, v 0), (v 3, v 1), (v 2, c 5)] := rfl

theorem second_information :
    second.firing.information X start = [(v 4, v 0), (v 5, v 1), (v 5, c 6)] := rfl

theorem both_information : Bag.information X start both =
    [(v 2, v 0), (v 3, v 1), (v 2, c 5), (v 4, v 0), (v 5, v 1), (v 5, c 6)] := rfl

/-! ## Neither match is admitted alone -/

/-- **The first match is refused alone**: at the solution that sends every unknown to `5`, its guard
asks `5 = 6`. -/
theorem first_refused : ¬ first.firing.Admits X start := by
  intro admitted
  have solved : X.Models (a := PUnit.unit) (b := PUnit.unit) (Examples.everywhere 5)
      (first.firing.information X start) := by
    intro e member
    rw [first_information] at member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl | rfl <;> rfl
  have held := (admitted.2.2.2 PUnit.unit (Examples.everywhere 5) solved).1
    (Check.equal (v 3) (c 6)) (List.mem_singleton_self _)
  have five : (Term.const (5 : ℕ) : Term atoms) = Term.const (6 : ℕ) := held
  exact absurd (Term.const.inj five) (by decide)

/-- **The second match is refused alone**: at the solution that sends every unknown to `6`, its guard
asks `6 = 5`. -/
theorem second_refused : ¬ second.firing.Admits X start := by
  intro admitted
  have solved : X.Models (a := PUnit.unit) (b := PUnit.unit) (Examples.everywhere 6)
      (second.firing.information X start) := by
    intro e member
    rw [second_information] at member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl | rfl <;> rfl
  have held := (admitted.2.2.2 PUnit.unit (Examples.everywhere 6) solved).1
    (Check.equal (v 4) (c 5)) (List.mem_singleton_self _)
  have six : (Term.const (6 : ℕ) : Term atoms) = Term.const (5 : ℕ) := held
  exact absurd (Term.const.inj six) (by decide)

/-- **No order of the two matches runs**: neither can begin. -/
theorem no_order : ∀ m ∈ both.members, ¬ m.firing.Admits X start := by
  intro m inside
  have listed : m ∈ [first, second] := inside
  rcases List.mem_cons.mp listed with rfl | rest
  · exact first_refused
  · obtain rfl := List.mem_singleton.mp rest
    exact second_refused

/-! ## The bag is admitted at the joint information -/

theorem both_fresh : Bag.Fresh X start both := by
  intro b g
  refine (realized_cons X first [second] _).mpr fun h₁ => (realized_cons X second [] _).mpr fun h₂ =>
    (realized_nil X _).mpr ⟨fun n => if n = 2 then h₁ 0 else if n = 3 then h₁ 1 else
      if n = 4 then h₂ 0 else if n = 5 then h₂ 1 else g n, ⟨⟨?_, ?_⟩, ?_⟩⟩
  · rintro t (member | member | ⟨o, present, rfl⟩)
    · exact absurd member List.not_mem_nil
    · exact absurd member List.not_mem_nil
    · have cases : o = 0 ∨ o = 1 := by
        have inside : o ∈ ({0, 1} : Finset ℕ) := present
        simpa using inside
      rcases cases with rfl | rfl <;> rfl
  · intro t member
    have listed : t ∈ [v 0, v 1, v 0, c 5, v 1, c 6] := member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at listed
    rcases listed with rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  · intro t member
    have listed : t ∈ [v 0, v 1, v 1, c 6, v 0, c 5] := member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at listed
    rcases listed with rfl | rfl | rfl | rfl | rfl | rfl <;> rfl

theorem both_fits : Bag.Fits X start both := by
  refine ⟨both_fresh, List.nodup_nil, List.nodup_nil, fun m inside => ?_⟩
  have listed : m ∈ [first, second] := inside
  rcases List.mem_cons.mp listed with rfl | rest
  · exact ⟨rfl, rfl, rfl, rfl⟩
  · obtain rfl := List.mem_singleton.mp rest
    exact ⟨rfl, rfl, rfl, rfl⟩

theorem both_enabled :
    Enabled (fun _ : ℕ => ()) start.present (both.selection.commit (T := Unit)) :=
  ⟨by decide, by decide, by decide, by decide, fun q member => by simp [Selection.commit] at member⟩

/-- The solution that sends the even unknowns to `5` and the odd ones to `6`. -/
def solution : Subst atoms := fun n => if n % 2 = 0 then c 5 else c 6

theorem both_solvable : X.Solvable (Bag.information X start both) := by
  refine ⟨PUnit.unit, solution, fun e member => ?_⟩
  rw [both_information] at member
  simp only [List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl | rfl | rfl | rfl | rfl <;> rfl

/-- **Every solution of the joint information sends `x` to `5` and `y` to `6`.** -/
theorem both_binds {σ : Subst atoms}
    (solved : X.Models (a := PUnit.unit) (b := PUnit.unit) σ (Bag.information X start both)) :
    σ 0 = c 5 ∧ σ 1 = c 6 ∧ σ 3 = c 6 ∧ σ 4 = c 5 := by
  rw [both_information] at solved
  have x2 : σ 2 = σ 0 := solved (v 2, v 0) List.mem_cons_self
  have y3 : σ 3 = σ 1 := solved (v 3, v 1) (List.mem_cons_of_mem _ List.mem_cons_self)
  have told5 : σ 2 = c 5 :=
    solved (v 2, c 5) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self))
  have x4 : σ 4 = σ 0 := solved (v 4, v 0)
    (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self)))
  have y5 : σ 5 = σ 1 := solved (v 5, v 1) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
    (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self))))
  have told6 : σ 5 = c 6 := solved (v 5, c 6) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
    (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self)))))
  exact ⟨x2.symm.trans told5, y5.symm.trans told6, y3.trans (y5.symm.trans told6),
    x4.trans (x2.symm.trans told5)⟩

/-- **The bag is admitted with the guards at the joint information.** -/
theorem both_admitted : Bag.Admits X start both := by
  refine ⟨both_fits, both_enabled, both_solvable, fun b σ solved m inside => ?_⟩
  obtain ⟨-, -, second6, first5⟩ := both_binds solved
  have listed : m ∈ [first, second] := inside
  rcases List.mem_cons.mp listed with rfl | rest
  · refine ⟨fun check member => ?_, fun q member => ?_⟩
    · have one : check ∈ [Check.equal (v 3) (c 6)] := member
      rw [List.mem_singleton.mp one]
      exact second6
    · have none : q ∈ ([] : List (Term atoms × Finset ℕ)) := member
      exact absurd none List.not_mem_nil
  · obtain rfl := List.mem_singleton.mp rest
    refine ⟨fun check member => ?_, fun q member => ?_⟩
    · have one : check ∈ [Check.equal (v 4) (c 5)] := member
      rw [List.mem_singleton.mp one]
      exact first5
    · have none : q ∈ ([] : List (Term atoms × Finset ℕ)) := member
      exact absurd none List.not_mem_nil

/-- **It is a step of the bag step**, and not a run of the step of the program. -/
theorem both_fires : (bagStep X ℕ E program).Admits (s := start) both :=
  ⟨List.cons_ne_nil _ _, both_admitted⟩

/-- **It is refused with the guards at each member's own information.** -/
theorem both_refused_own : ¬ Bag.AdmitsOwn X start both := fun own =>
  first_refused (Bag.admits_member X (fun _ _ => ⟨Subst.id atoms⟩) own List.mem_cons_self)

/-- The result keeps both rows. -/
theorem both_result_present : (Bag.result X start both).present = {0, 1} := by decide

/-! ## No firing of the program is admitted at the state -/

/-- **No firing of the program is admitted at the state**, whatever its opening and its selection. A
fresh opening lets every unknown be sent to one constant; then the tell of the rule holds and its guard
fails. -/
theorem no_firing (g : Firing ℕ E program PUnit.unit) : ¬ g.Admits X start := by
  obtain ⟨rule, member, ext, opening, ⟨taken, read, made⟩, seen⟩ := g
  rintro ⟨⟨fresh, -, -, -, readLength, -, -⟩, enabled, -, asks⟩
  rcases member with rfl | rfl
  · obtain ⟨o₁, o₂, rfl⟩ := List.length_eq_two.mp readLength.symm
    obtain ⟨u, state, rules⟩ := fresh PUnit.unit (Examples.everywhere 5) (Examples.everywhere 5)
    have present₁ : o₁ ∈ start.present :=
      enabled.kept_subset (List.mem_toFinset.mpr List.mem_cons_self)
    have present₂ : o₂ ∈ start.present :=
      enabled.kept_subset (List.mem_toFinset.mpr (List.mem_cons_of_mem _ List.mem_cons_self))
    have row₁ : Subst.applyTerm u (v o₁) = c 5 := state (v o₁) (Or.inr (Or.inr ⟨o₁, present₁, rfl⟩))
    have row₂ : Subst.applyTerm u (v o₂) = c 5 := state (v o₂) (Or.inr (Or.inr ⟨o₂, present₂, rfl⟩))
    have terms : ∀ t ∈ [v 0, v 1, v 0, c 5, v 1, c 6],
        Subst.applyTerm u (Subst.applyTerm opening t) = Subst.applyTerm (Examples.everywhere 5) t :=
      rules
    have a5 : Subst.applyTerm u (Subst.applyTerm opening (v 0)) = c 5 := terms (v 0) List.mem_cons_self
    have b5 : Subst.applyTerm u (Subst.applyTerm opening (v 1)) = c 5 :=
      terms (v 1) (List.mem_cons_of_mem _ List.mem_cons_self)
    have five : Subst.applyTerm u (Subst.applyTerm opening (c 5)) = c 5 :=
      terms (c 5) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        List.mem_cons_self)))
    have six : Subst.applyTerm u (Subst.applyTerm opening (c 6)) = c 6 :=
      terms (c 6) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self)))))
    have solved : ∀ e ∈ [(Subst.applyTerm opening (v 0), v o₁), (Subst.applyTerm opening (v 1), v o₂),
        (Subst.applyTerm opening (v 0), Subst.applyTerm opening (c 5))],
        Subst.applyTerm u e.1 = Subst.applyTerm u e.2 := by
      intro e inside
      simp only [List.mem_cons, List.not_mem_nil, or_false] at inside
      rcases inside with rfl | rfl | rfl
      · exact a5.trans row₁.symm
      · exact b5.trans row₂.symm
      · exact a5.trans five.symm
    have held := (asks PUnit.unit u solved).1
      (Check.equal (Subst.applyTerm opening (v 1)) (Subst.applyTerm opening (c 6)))
      (List.mem_singleton_self _)
    have clash : (Term.const (5 : ℕ) : Term atoms) = Term.const (6 : ℕ) :=
      b5.symm.trans ((show Subst.applyTerm u (Subst.applyTerm opening (v 1)) =
        Subst.applyTerm u (Subst.applyTerm opening (c 6)) from held).trans six)
    exact absurd (Term.const.inj clash) (by decide)
  · obtain ⟨o₁, o₂, rfl⟩ := List.length_eq_two.mp readLength.symm
    obtain ⟨u, state, rules⟩ := fresh PUnit.unit (Examples.everywhere 6) (Examples.everywhere 6)
    have present₁ : o₁ ∈ start.present :=
      enabled.kept_subset (List.mem_toFinset.mpr List.mem_cons_self)
    have present₂ : o₂ ∈ start.present :=
      enabled.kept_subset (List.mem_toFinset.mpr (List.mem_cons_of_mem _ List.mem_cons_self))
    have row₁ : Subst.applyTerm u (v o₁) = c 6 := state (v o₁) (Or.inr (Or.inr ⟨o₁, present₁, rfl⟩))
    have row₂ : Subst.applyTerm u (v o₂) = c 6 := state (v o₂) (Or.inr (Or.inr ⟨o₂, present₂, rfl⟩))
    have terms : ∀ t ∈ [v 0, v 1, v 1, c 6, v 0, c 5],
        Subst.applyTerm u (Subst.applyTerm opening t) = Subst.applyTerm (Examples.everywhere 6) t :=
      rules
    have a6 : Subst.applyTerm u (Subst.applyTerm opening (v 0)) = c 6 := terms (v 0) List.mem_cons_self
    have b6 : Subst.applyTerm u (Subst.applyTerm opening (v 1)) = c 6 :=
      terms (v 1) (List.mem_cons_of_mem _ List.mem_cons_self)
    have six : Subst.applyTerm u (Subst.applyTerm opening (c 6)) = c 6 :=
      terms (c 6) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        List.mem_cons_self)))
    have five : Subst.applyTerm u (Subst.applyTerm opening (c 5)) = c 5 :=
      terms (c 5) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self)))))
    have solved : ∀ e ∈ [(Subst.applyTerm opening (v 0), v o₁), (Subst.applyTerm opening (v 1), v o₂),
        (Subst.applyTerm opening (v 1), Subst.applyTerm opening (c 6))],
        Subst.applyTerm u e.1 = Subst.applyTerm u e.2 := by
      intro e inside
      simp only [List.mem_cons, List.not_mem_nil, or_false] at inside
      rcases inside with rfl | rfl | rfl
      · exact a6.trans row₁.symm
      · exact b6.trans row₂.symm
      · exact b6.trans six.symm
    have held := (asks PUnit.unit u solved).1
      (Check.equal (Subst.applyTerm opening (v 0)) (Subst.applyTerm opening (c 5)))
      (List.mem_singleton_self _)
    have clash : (Term.const (6 : ℕ) : Term atoms) = Term.const (5 : ℕ) :=
      a6.symm.trans ((show Subst.applyTerm u (Subst.applyTerm opening (v 0)) =
        Subst.applyTerm u (Subst.applyTerm opening (c 5)) from held).trans five)
    exact absurd (Term.const.inj clash) (by decide)

/-- **The step of the program has stopped at the state, and the bag step with guards at the joint
information has not.** -/
theorem stopped_and_fires :
    (¬ ∃ s', LogicOverTheStep.StepSpan.Succ (step X ℕ E program).toStep start s') ∧
      ∃ s', LogicOverTheStep.StepSpan.Succ (bagStep X ℕ E program).toStep start s' :=
  ⟨fun ⟨_, g, admitted, _⟩ => no_firing g admitted, ⟨_, both, both_fires, rfl⟩⟩

