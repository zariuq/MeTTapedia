import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.RuleSyntax.Presentation.Substitutability

/-!
# The barbed types are generated types, and both sides of substitutability occur

* `storeCode_wellSorted`: a store is a well-sorted object term of the sort `Store` of the presented language;
  so the row barb's singleton is a generated formula, and **every barbed type is a formula the presented
  language generates** (`barbed_generated`, the tree's `GeneratedLogic.GeneratedBy`).
* **Bisimilar stores that are not equal** (`nine_bisimilar`): under `Examples.demo`, one row `9` and two rows
  `9` are inert and show the same barbs, so they agree on every barbed type (`nine_agree`); the generated
  singleton type of the store `{9}` tells them apart (`singleton_separates`), so the whole generated logic is
  finer than bisimilarity, and the barbed fragment is what substitutability is about.
* **Stores that are not bisimilar** (`token_not_bisimilar`): one token `1` and the empty store, told apart by
  the row barb of `1` (`barb_separates`).
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.RuleSyntax.Presentation

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.Engine (RelationEnv)
open Mettapedia.OSLF.NativeTypes.GeneratedLogic
  (Formula Env referenceStructure GeneratedBy LabelOf generatedBy_dual)
open Mettapedia.GSLT.LanguageDef.WellSorted (OpenPatternWellSorted FreeTypeContext HasType)
open NamesOnTheStep (Expr)
open NamesOnTheStep.IssuingControls (ground Conf)
open LogicOverTheStep.ProgramAdequacy (program occSupply)
open LogicOverTheStep.StepSpan (Succ stepSystem)
open OneFrame (bodies)

variable {R : Reading} {rules : List (Rule Rows)} {relEnv : RelationEnv}

/-! ## Barbed types are generated -/

theorem metadata_numeral (k : ℕ) : (Pattern.unary "Zero" "Succ" k).hasCanonicalBinderMetadata = true :=
  Pattern.hasCanonicalBinderMetadata_unary "Zero" "Succ" k

theorem metadata_rowCode : ∀ e : Expr, (rowCode e).hasCanonicalBinderMetadata = true
  | .sym k => by simp [rowCode, Pattern.hasCanonicalBinderMetadata, Pattern.hasCanonicalBinderMetadataList]
  | .app f a => by simp [rowCode, Pattern.hasCanonicalBinderMetadata, Pattern.hasCanonicalBinderMetadataList,
      metadata_rowCode f, metadata_rowCode a]
  | .name n => by simp [rowCode, Pattern.hasCanonicalBinderMetadata, Pattern.hasCanonicalBinderMetadataList]
  | .code e => by simp [rowCode, Pattern.hasCanonicalBinderMetadata, Pattern.hasCanonicalBinderMetadataList,
      metadata_rowCode e]

theorem metadataList_rows : ∀ rows : List Expr, Pattern.hasCanonicalBinderMetadataList (rows.map rowCode) = true
  | [] => rfl
  | e :: rows => by simp only [List.map_cons, Pattern.hasCanonicalBinderMetadataList, metadata_rowCode e,
      metadataList_rows rows, Bool.and_self]

/-- **A store is a well-sorted object term of the sort `Store`.** -/
theorem storeCode_wellSorted (rows : List Expr) :
    OpenPatternWellSorted (presentWith R rules) FreeTypeContext.empty [] (.base "Store") (storeCode rows) :=
  ⟨HasType.collectionConstructor presentWith_store rfl (rows_typed presentWith_formers _ _ rows),
    metadataList_rows rows, (isState_storeCode rows).2, (isState_storeCode rows).1⟩

/-- **A row barb is generated by the presented language.** -/
theorem barb_generated (t : Expr) : GeneratedBy (presentWith R rules) (barb t) :=
  ⟨rfl, ⟨.base "Store", storeCode_wellSorted [t]⟩, trivial⟩

/-- **Every barbed type is a formula the presented language generates.** -/
theorem barbed_generated {φ : Formula 0} (barbed : Barbed φ) : GeneratedBy (presentWith R rules) φ := by
  induction barbed with
  | top => trivial
  | bot => trivial
  | and _ _ left right => exact ⟨left, right⟩
  | or _ _ left right => exact ⟨left, right⟩
  | possibly _ inner => exact ⟨trivial, inner⟩
  | necessarily _ inner => exact ⟨trivial, inner⟩
  | row t => exact barb_generated t
  | noRow t => exact (generatedBy_dual _ (barb t)).mpr (barb_generated t)

#print axioms storeCode_wellSorted
#print axioms barbed_generated

/-! ## Both sides of substitutability -/

namespace Examples

open Presentation.Examples (demo oneToken emptyConf storeOf_oneToken storeOf_emptyConf demo_positive)

/-- One row `9`. -/
def nine : Conf := ⟨[], {(.sym 9, 0)}⟩

/-- Two rows `9`. -/
def nineTwice : Conf := ⟨[], {(.sym 9, 0), (.sym 9, 1)}⟩

theorem mem_bag_nine (t : Expr) : t ∈ bagOf Prod.fst nine ↔ t = .sym 9 := by
  constructor
  · intro inside
    obtain ⟨o, member, rfl⟩ := Multiset.mem_map.mp inside
    rw [Finset.mem_singleton.mp (Finset.mem_val.mp member)]
  · rintro rfl
    exact Multiset.mem_map.mpr ⟨(.sym 9, 0), Finset.mem_val.mpr (Finset.mem_singleton_self _), rfl⟩

theorem mem_bag_nineTwice (t : Expr) : t ∈ bagOf Prod.fst nineTwice ↔ t = .sym 9 := by
  constructor
  · intro inside
    obtain ⟨o, member, rfl⟩ := Multiset.mem_map.mp inside
    rcases Finset.mem_insert.mp (Finset.mem_val.mp member) with rfl | member
    · rfl
    · rw [Finset.mem_singleton.mp member]
  · rintro rfl
    exact Multiset.mem_map.mpr ⟨(.sym 9, 0), Finset.mem_val.mpr (Finset.mem_insert_self _ _), rfl⟩

/-- Every rule of the demo consumes a row other than `9`. -/
theorem demo_consumes : ∀ r ∈ demo, ∃ x ∈ consumes r, x ≠ .sym 9 := by decide

/-- **A store of rows `9` is inert under the demo.** -/
theorem inert {C : Conf} (nines : ∀ x ∈ bagOf Prod.fst C, x = .sym 9) :
    ¬ ∃ C', Succ (program ground Prod.fst (bodies {r | r ∈ demo})) C C' := by
  rintro ⟨C', step⟩
  obtain ⟨r, member, -, rest, before, -, -⟩ := succ_bag Prod.fst step
  obtain ⟨x, inside, other⟩ := demo_consumes r member
  apply other
  apply nines x
  rw [← before]
  exact Multiset.mem_add.mpr (Or.inl (Multiset.mem_coe.mpr inside))

/-- **One row `9` and two rows `9` are bisimilar**, observing row barbs. -/
theorem nine_bisimilar :
    (stepSystem (program ground Prod.fst (bodies {r | r ∈ demo})) (barbs Prod.fst)).Bisimilar nine nineTwice := by
  refine ⟨fun A B => A = nine ∧ B = nineTwice, ⟨?_, ?_, ?_⟩, rfl, rfl⟩
  · rintro _ _ ⟨rfl, rfl⟩ _ next step
    exact absurd ⟨next, step⟩ (inert fun x inside => (mem_bag_nine x).mp inside)
  · rintro _ _ ⟨rfl, rfl⟩ _ next step
    exact absurd ⟨next, step⟩ (inert fun x inside => (mem_bag_nineTwice x).mp inside)
  · rintro _ _ ⟨rfl, rfl⟩ t
    exact (mem_bag_nine t).trans (mem_bag_nineTwice t).symm

/-- **So they have the same barbed types.** -/
theorem nine_agree : ∀ φ : Formula 0, Barbed φ →
    ((referenceStructure relEnv (present demo)).sat Env.closed φ (storeOf Prod.fst nine) ↔
      (referenceStructure relEnv (present demo)).sat Env.closed φ (storeOf Prod.fst nineTwice)) :=
  (substitutability Prod.fst occSupply demo_positive (fun _ member => absurd member List.not_mem_nil)
    (fun _ member => absurd member List.not_mem_nil)).mpr nine_bisimilar

theorem storeOf_nine : storeOf Prod.fst nine = storeCode [.sym 9] := by
  simp [storeOf, nine, Finset.toList_singleton]

/-- **The generated singleton type of `{9}` tells them apart**: the whole generated logic is finer than
bisimilarity. -/
theorem singleton_separates :
    GeneratedBy (present demo) (.is (storeCode [.sym 9]) : Formula 0) ∧
      (referenceStructure relEnv (present demo)).sat Env.closed (.is (storeCode [.sym 9]))
        (storeOf Prod.fst nine) ∧
      ¬ (referenceStructure relEnv (present demo)).sat Env.closed (.is (storeCode [.sym 9]))
        (storeOf Prod.fst nineTwice) := by
  refine ⟨⟨.base "Store", storeCode_wellSorted [.sym 9]⟩, ?_, ?_⟩
  · rw [storeOf_nine]
    exact ⟨(isState_storeCode _).2, Relation.EqvGen.refl _⟩
  · rintro ⟨-, named⟩
    obtain ⟨others, same, perm⟩ := storeCode_of_objectEquivalent named
    obtain rfl : others = [.sym 9] := (storeCode_injective same).symm
    have lengths := perm.length_eq
    rw [List.length_map, Finset.length_toList] at lengths
    have two : ({(Expr.sym 9, 0), (Expr.sym 9, 1)} : Finset (Expr × ℕ)).card = 2 :=
      Finset.card_pair (by decide)
    change ({(Expr.sym 9, 0), (Expr.sym 9, 1)} : Finset (Expr × ℕ)).card = 1 at lengths
    omega

/-- **The row barb of `1` tells one token `1` from the empty store.** -/
theorem barb_separates :
    (referenceStructure relEnv (present demo)).sat Env.closed (barb (.sym 1)) (storeOf Prod.fst oneToken) ∧
      ¬ (referenceStructure relEnv (present demo)).sat Env.closed (barb (.sym 1)) (storeOf Prod.fst emptyConf) := by
  rw [storeOf_oneToken, storeOf_emptyConf, sat_barb_iff, sat_barb_iff]
  exact ⟨List.mem_singleton_self _, List.not_mem_nil⟩

/-- **So one token `1` and the empty store are not bisimilar.** -/
theorem token_not_bisimilar :
    ¬ (stepSystem (program ground Prod.fst (bodies {r | r ∈ demo})) (barbs Prod.fst)).Bisimilar oneToken emptyConf := by
  intro bisimilar
  have agree := (substitutability (relEnv := RelationEnv.empty) Prod.fst occSupply demo_positive
    (C := oneToken) (D := emptyConf) (fun _ member => absurd member List.not_mem_nil)
    (fun _ member => absurd member List.not_mem_nil)).mpr bisimilar
  exact (barb_separates (relEnv := RelationEnv.empty)).2
    ((agree _ (.row (.sym 1))).mp (barb_separates (relEnv := RelationEnv.empty)).1)

#print axioms nine_bisimilar
#print axioms nine_agree
#print axioms singleton_separates
#print axioms barb_separates
#print axioms token_not_bisimilar

end Examples

end Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.RuleSyntax.Presentation
