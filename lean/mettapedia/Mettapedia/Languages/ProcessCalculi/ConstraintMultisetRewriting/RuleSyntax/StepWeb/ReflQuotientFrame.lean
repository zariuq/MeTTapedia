/-! ## The bag laws -/

/-- **The bag laws at the root**, on parallel bags: reordering, flattening a nested bag, dropping `0`, a bag
of one member is that member, and the empty bag is `0`. -/
inductive BagAxiom : Pattern → Pattern → Prop where
  | perm {xs ys : List Pattern} : xs.Perm ys → BagAxiom (pPar xs) (pPar ys)
  | flatten (xs ys zs : List Pattern) : BagAxiom (pPar (xs ++ pPar ys :: zs)) (pPar (xs ++ ys ++ zs))
  | zero (xs zs : List Pattern) : BagAxiom (pPar (xs ++ pZero :: zs)) (pPar (xs ++ zs))
  | single (p : Pattern) : BagAxiom (pPar [p]) p
  | empty : BagAxiom (pPar []) pZero

/-- **One bag law at one position.** Every constructor is a context. -/
inductive BagRewrite : Pattern → Pattern → Prop where
  | root {p q : Pattern} : BagAxiom p q → BagRewrite p q
  | apply (c : String) (pre post : List Pattern) {a b : Pattern} :
      BagRewrite a b → BagRewrite (.apply c (pre ++ a :: post)) (.apply c (pre ++ b :: post))
  | lambda (nm : Option String) {a b : Pattern} : BagRewrite a b → BagRewrite (.lambda nm a) (.lambda nm b)
  | multiLambda (n : Nat) (nms : List String) {a b : Pattern} :
      BagRewrite a b → BagRewrite (.multiLambda n nms a) (.multiLambda n nms b)
  | substBody (repl : Pattern) {a b : Pattern} : BagRewrite a b → BagRewrite (.subst a repl) (.subst b repl)
  | substRepl (body : Pattern) {a b : Pattern} : BagRewrite a b → BagRewrite (.subst body a) (.subst body b)
  | collection (ct : CollType) (pre post : List Pattern) (rest : Option String) {a b : Pattern} :
      BagRewrite a b →
        BagRewrite (.collection ct (pre ++ a :: post) rest) (.collection ct (pre ++ b :: post) rest)

/-- **Equality modulo the bag laws**: the equivalence closure of one law at one position, which is the
congruence the laws generate. -/
abbrev BagLaws : Pattern → Pattern → Prop := Relation.EqvGen BagRewrite

namespace BagLaws

theorem refl (p : Pattern) : BagLaws p p := Relation.EqvGen.refl p

theorem symm {p q : Pattern} (h : BagLaws p q) : BagLaws q p := Relation.EqvGen.symm _ _ h

theorem trans {p q r : Pattern} (h : BagLaws p q) (h' : BagLaws q r) : BagLaws p r :=
  Relation.EqvGen.trans _ _ _ h h'

theorem of_rewrite {p q : Pattern} (h : BagRewrite p q) : BagLaws p q := Relation.EqvGen.rel _ _ h

theorem of_axiom {p q : Pattern} (h : BagAxiom p q) : BagLaws p q := of_rewrite (.root h)

theorem equivalence : Equivalence BagLaws := Relation.EqvGen.is_equivalence _

/-- A context that carries one law carries the relation. -/
theorem map {f : Pattern → Pattern} (step : ∀ {a b : Pattern}, BagRewrite a b → BagRewrite (f a) (f b))
    {p q : Pattern} (h : BagLaws p q) : BagLaws (f p) (f q) := by
  induction h with
  | rel a b r => exact of_rewrite (step r)
  | refl a => exact refl _
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- A context of lists: related members, position by position, give related wholes. -/
theorem list {wrap : List Pattern → Pattern}
    (step : ∀ (pre post : List Pattern) {a b : Pattern}, BagRewrite a b →
      BagRewrite (wrap (pre ++ a :: post)) (wrap (pre ++ b :: post)))
    {xs ys : List Pattern} (h : List.Forall₂ BagLaws xs ys) : BagLaws (wrap xs) (wrap ys) := by
  have general : ∀ pre : List Pattern, BagLaws (wrap (pre ++ xs)) (wrap (pre ++ ys)) := by
    induction h with
    | nil => intro pre; exact refl _
    | @cons a b l₁ l₂ hab _ ih =>
        intro pre
        have first : BagLaws (wrap (pre ++ a :: l₁)) (wrap (pre ++ b :: l₁)) :=
          map (f := fun z => wrap (pre ++ z :: l₁)) (fun r => step pre l₁ r) hab
        have second := ih (pre ++ [b])
        simp only [List.append_assoc, List.singleton_append] at second
        exact first.trans second
  have whole := general []
  simp only [List.nil_append] at whole
  exact whole

end BagLaws

/-- Members related to their images give the image list, position by position. -/
theorem forall₂_of_forall {f : Pattern → Pattern} :
    ∀ {xs : List Pattern}, (∀ q ∈ xs, BagLaws q (f q)) → List.Forall₂ BagLaws xs (xs.map f)
  | [], _ => .nil
  | x :: _, h => .cons (h x List.mem_cons_self)
      (forall₂_of_forall fun q member => h q (List.mem_cons_of_mem _ member))

/-- **Names are compared modulo the bag laws of the processes they quote.** -/
theorem bagLaws_quote {p q : Pattern} (h : BagLaws p q) : BagLaws (nQuote p) (nQuote q) :=
  BagLaws.map (f := nQuote) (fun r => .apply "MQuote" [] [] r) h

/-- The relation is a congruence for every application. -/
theorem bagLaws_apply (c : String) {xs ys : List Pattern} (h : List.Forall₂ BagLaws xs ys) :
    BagLaws (.apply c xs) (.apply c ys) :=
  BagLaws.list (wrap := fun L => .apply c L) (fun pre post _ _ r => .apply c pre post r) h

/-- The relation is a congruence for every collection. -/
theorem bagLaws_collection (ct : CollType) (rest : Option String) {xs ys : List Pattern}
    (h : List.Forall₂ BagLaws xs ys) : BagLaws (.collection ct xs rest) (.collection ct ys rest) :=
  BagLaws.list (wrap := fun L => .collection ct L rest) (fun pre post _ _ r => .collection ct pre post rest r) h

/-- The relation is a congruence for an input: pattern, channel and continuation. -/
theorem bagLaws_pFor {t t' x x' k k' : Pattern} (ht : BagLaws t t') (hx : BagLaws x x') (hk : BagLaws k k') :
    BagLaws (pFor t x k) (pFor t' x' k') :=
  bagLaws_apply "MFor" (.cons ht (.cons hx (.cons hk .nil)))

/-! ## Substitution respects the relation -/

theorem psubst_pPar (σ : PSubst) (xs : List Pattern) : psubst σ (pPar xs) = pPar (xs.map (psubst σ)) := by
  simp only [pPar, psubst, psubstList_eq_map]

/-- Instances of the laws are laws. -/
theorem bagAxiom_psubst (σ : PSubst) {p q : Pattern} (h : BagAxiom p q) :
    BagAxiom (psubst σ p) (psubst σ q) := by
  cases h with
  | perm perm =>
      rw [psubst_pPar, psubst_pPar]
      exact .perm (perm.map _)
  | flatten xs ys zs =>
      rw [psubst_pPar, psubst_pPar]
      simp only [List.map_append, List.map_cons, psubst_pPar]
      exact .flatten _ _ _
  | zero xs zs =>
      rw [psubst_pPar, psubst_pPar]
      simp only [List.map_append, List.map_cons, psubst_pZero]
      exact .zero _ _
  | single p =>
      rw [psubst_pPar]
      exact .single _
  | empty =>
      rw [psubst_pPar]
      exact .empty

/-- Substitution commutes with every context. -/
theorem bagRewrite_psubst (σ : PSubst) {p q : Pattern} (h : BagRewrite p q) :
    BagRewrite (psubst σ p) (psubst σ q) := by
  induction h with
  | root ax => exact .root (bagAxiom_psubst σ ax)
  | apply c pre post _ ih =>
      simp only [psubst, psubstList_eq_map, List.map_append, List.map_cons]
      exact .apply c _ _ ih
  | lambda nm _ ih =>
      simp only [psubst]
      exact .lambda nm ih
  | multiLambda n nms _ ih =>
      simp only [psubst]
      exact .multiLambda n nms ih
  | substBody repl _ ih =>
      simp only [psubst]
      exact .substBody _ ih
  | substRepl body _ ih =>
      simp only [psubst]
      exact .substRepl _ ih
  | collection ct pre post rest _ ih =>
      simp only [psubst, psubstList_eq_map, List.map_append, List.map_cons]
      exact .collection ct _ _ rest ih

/-- **Substitution respects equality modulo the bag laws**, for all terms, unknowns included. -/
theorem bagLaws_psubst (σ : PSubst) {p q : Pattern} (h : BagLaws p q) : BagLaws (psubst σ p) (psubst σ q) :=
  BagLaws.map (fun r => bagRewrite_psubst σ r) h

/-! ## The canonical form -/

/-- The bag of a list: `0` when empty, the member itself when one, the parallel bag otherwise. -/
def bagOf : List Pattern → Pattern
  | [] => pZero
  | [c] => c
  | c :: d :: cs => pPar (c :: d :: cs)

/-- A collection of canonical members: a parallel bag is flattened, cleared of `0`, sorted by the
structural code and unwrapped when it has one member; every other collection keeps its members in order. -/
def bagNode (ct : CollType) (rest : Option String) (cs : List Pattern) : Pattern :=
  if ct = .hashBag ∧ rest = none then bagOf (codeOrder (cs.flatMap components)) else .collection ct cs rest

mutual
/-- **The canonical form modulo the bag laws**, at every depth. -/
def bagCanon : Pattern → Pattern
  | .bvar n => .bvar n
  | .fvar x => .fvar x
  | .apply c args => .apply c (bagCanonList args)
  | .lambda nm body => .lambda nm (bagCanon body)
  | .multiLambda n nms body => .multiLambda n nms (bagCanon body)
  | .subst body repl => .subst (bagCanon body) (bagCanon repl)
  | .collection ct elems rest => bagNode ct rest (bagCanonList elems)
/-- The canonical forms of a list, in order. -/
def bagCanonList : List Pattern → List Pattern
  | [] => []
  | p :: ps => bagCanon p :: bagCanonList ps
end

theorem bagCanonList_eq_map (ps : List Pattern) : bagCanonList ps = ps.map bagCanon := by
  induction ps with
  | nil => rfl
  | cons p ps ih => simp [bagCanonList, ih]

theorem bagCanon_apply (c : String) (args : List Pattern) :
    bagCanon (.apply c args) = .apply c (args.map bagCanon) := by
  simp [bagCanon, bagCanonList_eq_map]

theorem bagCanon_collection (ct : CollType) (elems : List Pattern) (rest : Option String) :
    bagCanon (.collection ct elems rest) = bagNode ct rest (elems.map bagCanon) := by
  simp [bagCanon, bagCanonList_eq_map]

theorem bagCanon_pPar (xs : List Pattern) :
    bagCanon (pPar xs) = bagOf (codeOrder ((xs.map bagCanon).flatMap components)) := by
  rw [pPar, bagCanon_collection]
  exact if_pos ⟨rfl, rfl⟩

theorem bagCanon_pZero : bagCanon pZero = pZero := rfl

/-! ## Components of canonical forms -/

theorem components_apply_of_ne {c : String} {args : List Pattern} (h : ¬ (c = "MZero" ∧ args = [])) :
    components (.apply c args) = [.apply c args] := by
  unfold components
  split <;> simp_all

theorem components_collection_of_ne {ct : CollType} {elems : List Pattern} {rest : Option String}
    (h : ¬ (ct = .hashBag ∧ rest = none)) :
    components (.collection ct elems rest) = [.collection ct elems rest] := by
  rcases ct <;> rcases rest <;> simp_all [components]

theorem components_bagOf {L : List Pattern} (leaves : ∀ c ∈ L, components c = [c]) :
    components (bagOf L) = L := by
  match L, leaves with
  | [], _ => exact components_pZero
  | [c], leaves => exact leaves c List.mem_cons_self
  | c :: d :: cs, leaves => exact components_pPar_leaves _ leaves

theorem leaves_flatMap (qs : List Pattern) : ∀ c ∈ qs.flatMap components, components c = [c] := by
  intro c member
  obtain ⟨q, _, inQ⟩ := List.mem_flatMap.mp member
  exact components_of_mem_components q c inQ

theorem leaves_codeOrder {L : List Pattern} (leaves : ∀ c ∈ L, components c = [c]) :
    ∀ c ∈ codeOrder L, components c = [c] :=
  fun c member => leaves c ((codeOrder_perm L).subset member)

theorem codeOrder_codeOrder (L : List Pattern) : codeOrder (codeOrder L) = codeOrder L :=
  codeOrder_eq_of_perm (codeOrder_perm L)

theorem codeOrder_singleton (c : Pattern) : codeOrder [c] = [c] := rfl

/-- A canonical form is a bag of sorted leaves (possibly `0` or one leaf), or a leaf. -/
theorem bagCanon_shape (p : Pattern) :
    (∃ L : List Pattern, (∀ c ∈ L, components c = [c]) ∧ bagCanon p = bagOf (codeOrder L)) ∨
      components (bagCanon p) = [bagCanon p] := by
  cases p with
  | bvar n => exact .inr (by simp [bagCanon, components])
  | fvar x => exact .inr (by simp [bagCanon, components])
  | apply c args =>
      rw [bagCanon_apply]
      by_cases zero : c = "MZero" ∧ args = []
      · obtain ⟨rfl, rfl⟩ := zero
        exact .inl ⟨[], fun _ member => (List.not_mem_nil member).elim, rfl⟩
      · refine .inr (components_apply_of_ne fun h => zero ⟨h.1, ?_⟩)
        exact List.map_eq_nil_iff.mp h.2
  | lambda nm body => exact .inr (by simp [bagCanon, components])
  | multiLambda n nms body => exact .inr (by simp [bagCanon, components])
  | subst body repl => exact .inr (by simp [bagCanon, components])
  | collection ct elems rest =>
      rw [bagCanon_collection]
      by_cases bag : ct = .hashBag ∧ rest = none
      · refine .inl ⟨(elems.map bagCanon).flatMap components, leaves_flatMap _, ?_⟩
        exact if_pos bag
      · right
        rw [show bagNode ct rest (elems.map bagCanon) = .collection ct (elems.map bagCanon) rest from if_neg bag]
        exact components_collection_of_ne bag

/-- Re-bagging the components of a canonical form gives it back. -/
theorem bagOf_rebag (p : Pattern) : bagOf (codeOrder (components (bagCanon p))) = bagCanon p := by
  rcases bagCanon_shape p with ⟨L, leaves, same⟩ | leaf
  · rw [same, components_bagOf (leaves_codeOrder leaves), codeOrder_codeOrder]
  · rw [leaf, codeOrder_singleton]
    rfl

/-! ## The canonical form decides the relation -/

/-- Each law keeps the canonical form. -/
theorem bagCanon_bagAxiom {p q : Pattern} (h : BagAxiom p q) : bagCanon p = bagCanon q := by
  cases h with
  | perm perm =>
      rw [bagCanon_pPar, bagCanon_pPar]
      exact congrArg bagOf (codeOrder_eq_of_perm ((perm.map bagCanon).flatMap_right components))
  | flatten xs ys zs =>
      rw [bagCanon_pPar, bagCanon_pPar]
      congr 1
      apply codeOrder_eq_of_perm
      simp only [List.map_append, List.map_cons, List.flatMap_append, List.flatMap_cons, bagCanon_pPar,
        List.append_assoc]
      rw [components_bagOf (leaves_codeOrder (leaves_flatMap _))]
      exact ((codeOrder_perm _).append_right _).append_left _
  | zero xs zs =>
      rw [bagCanon_pPar, bagCanon_pPar]
      simp only [List.map_append, List.map_cons, List.flatMap_append, List.flatMap_cons, bagCanon_pZero,
        components_pZero, List.nil_append]
  | single _ =>
      rw [bagCanon_pPar]
      simp only [List.map_cons, List.map_nil, List.flatMap_cons, List.flatMap_nil, List.append_nil]
      exact bagOf_rebag _
  | empty =>
      rw [bagCanon_pPar, bagCanon_pZero]
      rfl

/-- One law at one position keeps the canonical form. -/
theorem bagCanon_bagRewrite {p q : Pattern} (h : BagRewrite p q) : bagCanon p = bagCanon q := by
  induction h with
  | root ax => exact bagCanon_bagAxiom ax
  | apply c pre post _ ih => simp only [bagCanon_apply, List.map_append, List.map_cons, ih]
  | lambda nm _ ih => simp only [bagCanon, ih]
  | multiLambda n nms _ ih => simp only [bagCanon, ih]
  | substBody repl _ ih => simp only [bagCanon, ih]
  | substRepl body _ ih => simp only [bagCanon, ih]
  | collection ct pre post rest _ ih => simp only [bagCanon_collection, List.map_append, List.map_cons, ih]

theorem bagCanon_eq_of_bagLaws {p q : Pattern} (h : BagLaws p q) : bagCanon p = bagCanon q := by
  induction h with
  | rel a b r => exact bagCanon_bagRewrite r
  | refl a => rfl
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- A leaf member is its own components. -/
theorem flatten_leaf {q : Pattern} (leaf : components q = [q]) (pre post : List Pattern) :
    BagLaws (pPar (pre ++ q :: post)) (pPar (pre ++ components q ++ post)) := by
  rw [leaf, List.append_assoc, List.singleton_append]
  exact BagLaws.refl _

/-- Flattening a list of members, given each member flattens. -/
theorem flatten_list (qs : List Pattern)
    (ih : ∀ q ∈ qs, ∀ pre post : List Pattern,
      BagLaws (pPar (pre ++ q :: post)) (pPar (pre ++ components q ++ post))) :
    ∀ pre post : List Pattern,
      BagLaws (pPar (pre ++ qs ++ post)) (pPar (pre ++ qs.flatMap components ++ post)) := by
  induction qs with
  | nil => intro pre post; exact BagLaws.refl _
  | cons q qs ihqs =>
      intro pre post
      have first := ih q List.mem_cons_self pre (qs ++ post)
      have rest := ihqs (fun r member => ih r (List.mem_cons_of_mem _ member)) (pre ++ components q) post
      simp only [List.append_assoc, List.cons_append, List.flatMap_cons] at first rest ⊢
      exact first.trans rest

/-- **Flattening one member into its components follows from the bag laws.** -/
theorem bagLaws_flatten_member (p : Pattern) :
    ∀ pre post : List Pattern, BagLaws (pPar (pre ++ p :: post)) (pPar (pre ++ components p ++ post)) := by
  induction p using Pattern.rec (motive_2 := fun ps => ∀ q ∈ ps, ∀ pre post : List Pattern,
      BagLaws (pPar (pre ++ q :: post)) (pPar (pre ++ components q ++ post))) with
  | bvar n => exact flatten_leaf (by simp [components])
  | fvar x => exact flatten_leaf (by simp [components])
  | apply c args _ =>
      by_cases zero : c = "MZero" ∧ args = []
      · obtain ⟨rfl, rfl⟩ := zero
        intro pre post
        rw [show components (.apply "MZero" []) = [] from components_pZero, List.append_nil]
        exact BagLaws.of_axiom (.zero pre post)
      · exact flatten_leaf (components_apply_of_ne zero)
  | lambda nm body _ => exact flatten_leaf (by simp [components])
  | multiLambda n nms body _ => exact flatten_leaf (by simp [components])
  | subst body repl _ _ => exact flatten_leaf (by simp [components])
  | collection ct elems rest ih =>
      by_cases bag : ct = .hashBag ∧ rest = none
      · obtain ⟨rfl, rfl⟩ := bag
        intro pre post
        have comps : components (.collection .hashBag elems none) = elems.flatMap components := by
          simp only [components, componentsList_eq_flatMap]
        rw [comps]
        exact (BagLaws.of_axiom (.flatten pre elems post)).trans (flatten_list elems ih pre post)
      · exact flatten_leaf (components_collection_of_ne bag)
  | nil => simp_all
  | cons p ps head tail =>
      rename_i q member pre post
      rcases List.mem_cons.mp member with rfl | later
      · exact head pre post
      · exact tail q later pre post

theorem bagLaws_flat (xs : List Pattern) : BagLaws (pPar xs) (pPar (xs.flatMap components)) := by
  have h := flatten_list xs (fun q _ => bagLaws_flatten_member q) [] []
  simp only [List.nil_append, List.append_nil] at h
  exact h

theorem bagLaws_bagOf (L : List Pattern) : BagLaws (pPar L) (bagOf L) := by
  match L with
  | [] => exact BagLaws.of_axiom .empty
  | [c] => exact BagLaws.of_axiom (.single c)
  | c :: d :: cs => exact BagLaws.refl _

/-- **Every term is equal to its canonical form modulo the bag laws.** -/
theorem bagLaws_bagCanon (p : Pattern) : BagLaws p (bagCanon p) := by
  induction p using Pattern.rec (motive_2 := fun ps => ∀ q ∈ ps, BagLaws q (bagCanon q)) with
  | bvar n => exact BagLaws.refl _
  | fvar x => exact BagLaws.refl _
  | apply c args ih =>
      rw [bagCanon_apply]
      exact bagLaws_apply c (forall₂_of_forall ih)
  | lambda nm body ih => exact BagLaws.map (f := .lambda nm) (fun r => .lambda nm r) ih
  | multiLambda n nms body ih => exact BagLaws.map (f := .multiLambda n nms) (fun r => .multiLambda n nms r) ih
  | subst body repl ihb ihr =>
      exact (BagLaws.map (f := fun a => .subst a repl) (fun r => .substBody repl r) ihb).trans
        (BagLaws.map (f := fun a => .subst (bagCanon body) a) (fun r => .substRepl (bagCanon body) r) ihr)
  | collection ct elems rest ih =>
      rw [bagCanon_collection]
      refine (bagLaws_collection ct rest (forall₂_of_forall ih)).trans ?_
      unfold bagNode
      split_ifs with bag
      · obtain ⟨rfl, rfl⟩ := bag
        exact (bagLaws_flat _).trans
          ((BagLaws.of_axiom (.perm (codeOrder_perm _).symm)).trans (bagLaws_bagOf _))
      · exact BagLaws.refl _
  | nil => simp_all
  | cons p ps head tail =>
      rename_i q member
      rcases List.mem_cons.mp member with rfl | later
      · exact head
      · exact tail q later

/-- **The canonical form decides equality modulo the bag laws**, on all terms, unknowns included. -/
theorem bagLaws_iff (p q : Pattern) : BagLaws p q ↔ bagCanon p = bagCanon q := by
  refine ⟨bagCanon_eq_of_bagLaws, fun same => (bagLaws_bagCanon p).trans ?_⟩
  rw [same]
  exact (bagLaws_bagCanon q).symm

instance : DecidableRel BagLaws := fun p q => decidable_of_iff _ (bagLaws_iff p q).symm

/-- **Canonicalizing before or after a substitution agrees.** -/
theorem bagCanon_psubst_bagCanon (σ : PSubst) (p : Pattern) :
    bagCanon (psubst σ (bagCanon p)) = bagCanon (psubst σ p) :=
  bagCanon_eq_of_bagLaws (bagLaws_psubst σ (bagLaws_bagCanon p).symm)

/-- Equality modulo the bag laws contains syntactic equality. -/
theorem bagLaws_of_eq {p q : Pattern} (same : p = q) : BagLaws p q := same ▸ BagLaws.refl p

/-! ## The quotient frame -/

/-- **Structural substitution on patterns, modulo the bag laws.** The same terms, the same substitutions and
the same action as `patternAction`; the equality is `BagLaws`. -/
def bagAction : SubstitutionAction Pattern PSubst where
  E := BagLaws
  equivalence := BagLaws.equivalence
  apply := psubst
  identity := fun _ => none
  compose := pcomp
  apply_identity := psubst_none
  apply_compose outer inner t := (psubst_comp outer inner t).symm
  preserves σ {_ _} same := bagLaws_psubst σ same

/-- **The quotient frame**: the one frame of structural substitution on patterns, compared modulo the bag
laws. -/
abbrev QX : Interface.Frames (OneFrame.Terms Pattern) (fun _ _ : PUnit.{1} => PSubst) :=
  OneFrame.frames bagAction

/-- Firings at the quotient frame move along the identity. -/
abbrev QE : Extensions.{0, 0, 0} (fun _ _ : PUnit.{1} => PSubst) := OneFrame.ext bagAction

/-- **What a solution says at the quotient frame**: an equation holds at `σ` exactly when the canonical
forms of its two sides, read through `σ`, are equal. -/
theorem solves_iff (σ : PSubst) (e : Equation Pattern) :
    bagAction.Solves σ e ↔ bagCanon (psubst σ e.1) = bagCanon (psubst σ e.2) :=
  bagLaws_iff (psubst σ e.1) (psubst σ e.2)

theorem frame_solves_iff (σ : PSubst) (e : Equation Pattern) :
    QX.Solves (a := PUnit.unit) (b := PUnit.unit) σ e ↔ bagCanon (psubst σ e.1) = bagCanon (psubst σ e.2) :=
  bagLaws_iff (psubst σ e.1) (psubst σ e.2)

/-! ## Deep, not shallow: what `BagEq` covers -/

/-- A bag is equal to the bag of its components. -/
theorem bagLaws_components (p : Pattern) : BagLaws p (pPar (components p)) := by
  have h := bagLaws_flatten_member p [] []
  simp only [List.nil_append, List.append_nil] at h
  exact (BagLaws.of_axiom (.single p)).symm.trans h

/-- The top level: permuted components give equal processes. -/
theorem bagLaws_of_perm_components {p q : Pattern} (perm : (components p).Perm (components q)) : BagLaws p q :=
  ((bagLaws_components p).trans (BagLaws.of_axiom (.perm perm))).trans (bagLaws_components q).symm

/-- **On closed forms, `BagEq` is contained in the bag laws.** -/
theorem bagLaws_close_of_bagEq {p q : Pattern} (h : BagEq p q) : BagLaws (close p) (close q) :=
  bagLaws_of_perm_components h

/-- **`BagEq` is shallow**: it relates `a | b` and `b | a`, and not the names that quote them. -/
theorem bagEq_not_closed_under_quote :
    BagEq (par atomA atomB) (par atomB atomA) ∧
      ¬ BagEq (nQuote (par atomA atomB)) (nQuote (par atomB atomA)) := by
  refine ⟨MeTTaCalculus.Corrected.BagEq.par_comm _ _, ?_⟩
  unfold BagEq
  decide +kernel

/-- The quoted pair is related by the bag laws. -/
theorem bagLaws_quoted_pair : BagLaws (nQuote (par atomA atomB)) (nQuote (par atomB atomA)) := by
  decide +kernel

/-- **Alpha-equivalence is in `BagEq` and not in the bag laws.** -/
theorem bagEq_not_bagLaws :
    BagEq (pFor (.fvar "y") demoChan (.fvar "y")) (pFor (.fvar "w") demoChan (.fvar "w")) ∧
      ¬ BagLaws (pFor (.fvar "y") demoChan (.fvar "y")) (pFor (.fvar "w") demoChan (.fvar "w")) := by
  constructor
  · unfold BagEq
    decide +kernel
  · decide +kernel

/-- The substitution of the control below: `z` becomes `y`. -/
def captureZ : PSubst := fun v => if v = "z" then some (.fvar "y") else none

/-- **Closing does not commute with substitution.** `for(y <- @0)z` and `for(w <- @0)z` have one closed form;
reading `z` as `y` captures it under the first binder only. So alpha-equivalence, compared through closed
forms, is not stable under the substitutions of the frame and cannot be part of its equality. -/
theorem close_not_substitution_stable :
    close (pFor (.fvar "y") demoChan (.fvar "z")) = close (pFor (.fvar "w") demoChan (.fvar "z")) ∧
      close (psubst captureZ (pFor (.fvar "y") demoChan (.fvar "z"))) ≠
        close (psubst captureZ (pFor (.fvar "w") demoChan (.fvar "z"))) := by
  constructor <;> decide +kernel

/-! ## Positive and negative examples of the relation -/

theorem bagLaws_par_comm (p q : Pattern) : BagLaws (par p q) (par q p) :=
  BagLaws.of_axiom (.perm (List.Perm.swap q p []))

theorem bagLaws_par_zero (p : Pattern) : BagLaws (par p pZero) p :=
  (BagLaws.of_axiom (.zero [p] [])).trans (BagLaws.of_axiom (.single p))

/-- Multiplicity is kept. -/
theorem not_bagLaws_twice : ¬ BagLaws (par atomA atomA) atomA := by decide +kernel

/-- A name is not the process it quotes. -/
theorem not_bagLaws_quote : ¬ BagLaws (nQuote atomA) atomA := by decide +kernel

/-- Inside an input's pattern, as everywhere. -/
theorem bagLaws_inside_pattern :
    BagLaws (pFor (nQuote (par atomA atomB)) demoChan pZero) (pFor (nQuote (par atomB atomA)) demoChan pZero) :=
  bagLaws_pFor (bagLaws_quote (bagLaws_par_comm _ _)) (BagLaws.refl _) (BagLaws.refl _)

/-- An unknown in a bag: `X | a` and `a | X` are related, and so are all their instances. -/
theorem bagLaws_unknown_in_bag (σ : PSubst) :
    BagLaws (psubst σ (par (.fvar "X") atomA)) (psubst σ (par atomA (.fvar "X"))) :=
  bagLaws_psubst σ (bagLaws_par_comm _ _)

