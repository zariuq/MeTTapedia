import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.LogicOverTheStep.InductiveTypes.Numbers

/-!
# The inductive type is the tree's provenance closure of its constructor schemas

The tree's provenance reading of a protected region (`SchemaPublicationAuthority.AllDerivable`) says
that every protected occurrence is derivable, in the least closure (`TierZeroKernel.Derivable`), from
inferences extracted from actual valid firings of installed schemas (`SchemaPublicationAuthority.Infers`).
Its preservation along runs is proved for systems with a sole kernel writer
(`SchemaPublicationAuthority.System.run_allDerivable`).

* **The closure is the type** (`derivable_iff_generated`): on the ground step, when the installed
  schemas activate exactly the step instances of the declared constructors and the constructors'
  premises and conclusions lie in the protected region, a content is derivable in the provenance
  closure exactly when it is generated by the constructors (`ThatsAll.Generated`).
* **Fact 1 from the tree's own theorem** (`soleSystem_membership`): the owner and the reader form a
  sole-writer system of the tree (`soleSystem`); its preservation theorem gives the provenance reading
  on every run from the empty store, and the bridge turns it into membership.

The tree's preservation theorem needs a sole writer; with two writers through the constructors there
is no such system (`twoWriters_no_system`), while membership holds (`Numbers.twoWriters_membership`).
The schema-level analogue of `Provenance.SystemStep`, with its preservation for every family of
writers whose installed schemas activate constructor instances, is the declaration this needs.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.LogicOverTheStep.InductiveTypes

open WhenTypesApply.ThatsAll
open NamesOnTheStep NamesOnTheStep.IssuingControls
open MeTTaCalculus.OccurrenceCommits (Enabled fire mem_fire labels)
open GuardedMultisetRewriting.TierZeroKernel (Derivable)

namespace ProvenanceBridge

section Generic

variable {R : Type} {X : Type} (activate : R → X → Option (RuleInstance Expr))
  (region : Expr → Prop) [DecidablePred region]

/-- The provenance closure of the installed schemas, on the ground step, with the region's
occurrences protected. -/
abbrev Closure (installed : List R) : Expr → Prop :=
  Derivable (fun _ => False)
    (SchemaPublicationAuthority.Infers ground Prod.fst (fun o : Occ => region o.1) activate installed)

variable {activate region}

/-- A firing of a constructor from the store of its premises, recorded as an inference of the tree. -/
theorem infers_of_ctor {installed : List R} {d : List Expr × Expr} {schema : R}
    (inside : schema ∈ installed) {x : X} (computed : activate schema x = some (ctor d))
    (protectedConclusion : region d.2) :
    ∃ sel : Selection Occ,
      SchemaPublicationAuthority.Infers ground Prod.fst (fun o : Occ => region o.1) activate installed
        (labels (fun o : Occ => ground.apply () o.1)
          (Provenance.premises sel fun o : Occ => region o.1)) d.2 ∧
      ∀ o ∈ sel.taken ++ sel.read, o.1 ∈ d.1 := by
  let sel : Selection Occ := ⟨[], d.1.map fun p => (p, 0), [(d.2, 1)]⟩
  have enabled : Enabled Prod.fst (storeOf d.1).present (sel.commit (T := Expr)) := by
    refine ⟨by simp [Selection.commit, sel], fun o member => member, by simp [Selection.commit, sel],
      Finset.disjoint_left.mpr fun o made present => ?_, fun _ member => by
        simp [Selection.commit] at member⟩
    have isMade : o = (d.2, 1) := by simpa [Selection.commit, sel] using made
    obtain ⟨p, _, same⟩ := List.mem_map.mp (List.mem_toFinset.mp present)
    rw [isMade] at same
    simp at same
  have valid : sel.Valid ground Prod.fst (ctor d) (storeOf d.1) :=
    groundValid List.nodup_nil (List.nodup_singleton _) rfl
      (by simp [ctor, rule, sel, Function.comp_def]) (by simp [ctor, rule, sel]) enabled
      (plain_storeOf d.1) rfl rfl
  refine ⟨sel, ?_, fun o member => ?_⟩
  · unfold SchemaPublicationAuthority.Infers Provenance.Infers
    exact ⟨schema, inside, x, ctor d, computed, ctor d, List.mem_singleton_self _, storeOf d.1, sel,
      (), valid, fun e member => plain_of_valid valid e member, rfl, (d.2, 1),
      List.mem_singleton_self _, protectedConclusion, rfl⟩
  · simp only [sel, List.nil_append, List.mem_map] at member
    obtain ⟨p, inP, rfl⟩ := member
    exact inP

/-- **The provenance closure of the constructor schemas is the inductive type**, on the ground step:
when the installed schemas activate exactly the step instances of the declared constructors, and
every constructor's premises and conclusion lie in the protected region. -/
theorem derivable_iff_generated {installed : List R} {rules : Set (List Expr × Expr)}
    (exact : ∀ schema ∈ installed, ∀ x ρ, activate schema x = some ρ → ∃ d ∈ rules, ρ = ctor d)
    (realized : ∀ d ∈ rules, ∃ schema ∈ installed, ∃ x, activate schema x = some (ctor d))
    (inside : ∀ d ∈ rules, region d.2 ∧ ∀ p ∈ d.1, region p) (e : Expr) :
    Closure activate region installed e ↔ Generated rules ∅ e := by
  constructor
  · intro derivable
    induction derivable with
    | initial impossible => exact impossible.elim
    | @infer hyps concl infers _ ih =>
        obtain ⟨schema, installedSchema, x, ρ, computed, ρ', single, before, sel, σ, valid, -, rfl,
          o, made, -, rfl⟩ := infers
        have same : ρ' = ρ := List.mem_singleton.mp single
        subst same
        obtain ⟨d, declared, rfl⟩ := exact schema installedSchema x ρ' computed
        have label : o.1 = d.2 := List.mem_singleton.mp (made_label valid made)
        show Generated rules ∅ o.1
        rw [label]
        refine Generated.rule declared fun p member => ih p ?_
        obtain ⟨o', selected, same⟩ := selected_of_pattern (reads_match valid) member
        refine Multiset.mem_map.mpr ⟨o', Finset.mem_val.mpr ?_, same⟩
        unfold Provenance.premises
        rw [Finset.mem_filter]
        refine ⟨Finset.mem_union.mpr (Or.inr (List.mem_toFinset.mpr selected)), ?_⟩
        show region o'.1
        rw [same]
        exact (inside d declared).2 p member
  · intro generated
    induction generated with
    | base impossible => exact absurd impossible (Set.notMem_empty _)
    | @rule ps r declared _ ih =>
        obtain ⟨schema, installedSchema, x, computed⟩ := realized (ps, r) declared
        obtain ⟨sel, infers, origin⟩ :=
          infers_of_ctor installedSchema computed (inside (ps, r) declared).1
        refine Derivable.infer infers fun p member => ?_
        obtain ⟨o, chosen, rfl⟩ := Multiset.mem_map.mp member
        have chosen' := Finset.mem_val.mp chosen
        unfold Provenance.premises at chosen'
        rw [Finset.mem_filter] at chosen'
        have gathered := chosen'.1
        have inSel : o ∈ sel.taken ++ sel.read := by
          rcases Finset.mem_union.mp gathered with taken | read
          · exact List.mem_append_left _ (List.mem_toFinset.mp taken)
          · exact List.mem_append_right _ (List.mem_toFinset.mp read)
        exact ih o.1 (origin o inSel)

end Generic

/-! ## The numbers: fact 1 from the tree's sole-writer theorem -/

/-- The number region on contents. -/
abbrev numRegion : Expr → Prop := fun e => place e = .num

theorem owner_exact : ∀ schema ∈ Numbers.owner.schemas, ∀ x ρ, activate schema x = some ρ →
    ∃ d ∈ natRules, ρ = ctor d := by
  intro schema installed x ρ computed
  simp only [Numbers.owner, List.mem_cons, List.not_mem_nil, or_false] at installed
  rcases installed with rfl | rfl
  · rcases x with _ | ⟨a, rest⟩
    · simp only [activate, Option.some.injEq] at computed
      exact ⟨_, Numbers.zero_mem, computed.symm⟩
    · simp [activate] at computed
  · rcases x with _ | ⟨a, _ | ⟨b, rest⟩⟩
    · simp [activate] at computed
    · simp only [activate, Option.some.injEq] at computed
      exact ⟨_, Numbers.succ_mem a, computed.symm⟩
    · simp [activate] at computed

theorem owner_realized : ∀ d ∈ natRules, ∃ schema ∈ Numbers.owner.schemas, ∃ x,
    activate schema x = some (ctor d) :=
  fun d declared => (Numbers.owner_realizes d declared).2

theorem natRules_inside : ∀ d ∈ natRules, numRegion d.2 ∧ ∀ p ∈ d.1, numRegion p := by
  intro d declared
  rcases Numbers.mem_natRules.mp declared with ⟨first, second⟩ | ⟨x, first, second⟩
  · rw [first, second]
    exact ⟨rfl, fun _ member => absurd member List.not_mem_nil⟩
  · rw [first, second]
    refine ⟨rfl, fun p member => ?_⟩
    rw [List.mem_singleton.mp member]
    rfl

/-- **The provenance closure of the owner's schemas is the type of numbers.** -/
theorem numbers_closure_iff (e : Expr) :
    Closure activate numRegion Numbers.owner.schemas e ↔ Generated natRules ∅ e :=
  derivable_iff_generated owner_exact owner_realized natRules_inside e

/-- **The owner and the reader form a sole-writer system of the tree.** -/
def soleSystem :
    SchemaPublicationAuthority.System Schema Handle Bool Occ (fun o => place o.1)
      (fun o => numRegion o.1) where
  process := Numbers.soleOwner
  kernel := true
  soleWriter actor other o isNum := by
    cases actor
    · exact Numbers.reader_noSend o.1 isNum
    · exact absurd rfl other

theorem plain_of_system_run {C C' : Conf} {schedule : List Bool}
    (run : soleSystem.Run activate ground Prod.fst C schedule C') (plain : Plain C) : Plain C' := by
  induction run with
  | nil => exact plain
  | cons moved _ ih =>
      obtain ⟨_, _, _, _, _, sel, valid, _, rfl⟩ := moved
      exact ih (plain_of_valid valid)

/-- **Fact 1 from the tree's own preservation theorem**: on every run of the sole-writer system from
the empty store, every number row present is generated. -/
theorem soleSystem_membership {C : Conf} {schedule : List Bool}
    (run : soleSystem.Run activate ground Prod.fst ProgramAdequacy.emptyStore schedule C)
    {o : Occ} (present : o ∈ C.present) (isNum : numRegion o.1) : Generated natRules ∅ o.1 := by
  have prior : SchemaPublicationAuthority.AllDerivable ground Prod.fst (fun o : Occ => numRegion o.1)
      activate (soleSystem.process soleSystem.kernel).schemas (fun _ => False)
      ProgramAdequacy.emptyStore :=
    fun _ _ o present _ => absurd present (Finset.notMem_empty o)
  have after := soleSystem.run_allDerivable activate ground Prod.fst (fun _ => False) run prior
  have plain := plain_of_system_run run plain_empty
  exact (numbers_closure_iff o.1).mp (after () (fun e member => plain e member) o present isNum)

/-- **With two writers through the constructors there is no sole-writer system** over the number
region: the tree's preservation theorem does not apply, though membership holds
(`Numbers.twoWriters_membership`). -/
theorem twoWriters_no_system
    (system : SchemaPublicationAuthority.System Schema Handle Bool Occ (fun o => place o.1)
      (fun o => numRegion o.1)) (same : system.process = Numbers.twoWriters) : False := by
  have := system.soleWriter (!system.kernel) (by cases system.kernel <;> decide)
    (natRow zeroE, 0) rfl
  rw [same] at this
  simp [Numbers.twoWriters, Numbers.owner, Numbers.writerRights] at this

end ProvenanceBridge

