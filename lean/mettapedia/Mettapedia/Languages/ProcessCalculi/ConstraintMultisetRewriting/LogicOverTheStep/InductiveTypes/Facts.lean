import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.LogicOverTheStep.WhenTypesApply.TwoKinds
import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.SchemaPublicationAuthority

/-!
# An inductive type on the step: three facts, three conditions

A type given by constructors lives on the ground first-order step as a **region**: the contents
located, by `place`, at the type's handles (`inType`). Its **constructors** are declared rules, a list
of premises and a conclusion (`ThatsAll.Generated`); on the step a constructor is the rule instance
that reads its premises and makes its conclusion (`ctor`). Parties are the step's processes with
rights and installed schemas (`SchemaPublicationAuthority.Process`), and a party's move is the step's
own firing, formed under its `send` rights (`processStep`).

**Fact 1, membership** (`membership`): every content of the region, in every state a run reaches
from a state where it held, is generated by the constructors. **Condition**: every party writes the
type only through its constructors (`Writes`): wherever it holds `send` in the type, the rules of its
installed schemas make rows of the type only as conclusions of declared constructors whose premises
they select. Several writers are allowed; the condition is per output, so a party without `send` in
the type satisfies it whatever it installs (`writes_of_noSend`). The step meets the abstract condition
of `ThatsAll` (`throughConstructors_of_writes`).

**Fact 2, induction** (`induction`): a property closed under the constructors holds of every content
of the region in every state reached from the empty store. It is proved twice: as an invariant of
runs (`closedBy_survives`
along `invariant_of_run`), and as fact 1 read through the least fixed point (`generated_induction`,
`induction_of_membership`).

**Fact 3, closure** ("these and no others", an exhaustive list of the rows present, a refutation by
none queries): a statement `ClosedBy L` says every row of the region present is in `L`. Two exact
conditions:

* every closure statement survives every other party's step **exactly when the region is owned**
  (`ThatsAll.closedReadingSurvives_iff_owned`); on the step a sole `send` right in the type owns it
  (`owned_of_soleSender`, `closure_of_soleSender`, and `owned_of_system` for the tree's sole-writer
  systems);
* a given closure statement survives every move of a party that writes through the constructors and
  realizes them **exactly when its list is closed under the constructors** (`survives_iff_ruleClosedIn`).
  Membership is the least such list; a finite list of rows is not one.

**Existence** (`reachable_of_generated`): a party that realizes the constructors reaches, from any
consistent ground state, a state holding any generated row, so the statements above are not vacuous.

The facts are stated for contents, the labels of present occurrences, on the ground action, where a
label is its own meaning. With logic variables a label means its instances in the solutions of the
knowledge; the tree's provenance reading (`Provenance.AllDerivable`) quantifies over them.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.LogicOverTheStep.InductiveTypes

open WhenTypesApply.ThatsAll
open NamesOnTheStep NamesOnTheStep.IssuingControls
open MeTTaCalculus.OccurrenceCommits (Enabled fire mem_fire)
open MeTTaCalculus.InteractionTypes (Rights Facet)

universe uR uX uN uI

/-! ## Contents, constructors, consistency -/

/-- **The contents of a configuration**: the labels of its present occurrences. A type speaks of
contents, never of occurrence identities. -/
def contents (C : Conf) : Set Expr := {e | ∃ o ∈ C.present, o.1 = e}

/-- **The step instance of a declared constructor**: it reads the premises and makes the conclusion. -/
def ctor (d : List Expr × Expr) : RuleInstance Expr := rule [] d.1 [d.2]

/-- **Consistent ground knowledge**: every equation is an identity, so the identity solves it. -/
def Plain (C : Conf) : Prop := ∀ e ∈ C.equations, e.1 = e.2

/-- The empty store is consistent. -/
theorem plain_empty : Plain ProgramAdequacy.emptyStore :=
  fun _ member => absurd member List.not_mem_nil

/-- The empty store holds no content. -/
theorem contents_empty : contents ProgramAdequacy.emptyStore = ∅ :=
  Set.eq_empty_of_forall_notMem fun _ ⟨_, present, _⟩ => Finset.notMem_empty _ present

/-- A pattern list matched by selected occurrences: every pattern is the label of one of them. -/
theorem selected_of_pattern {l : List Expr} {sel : List Occ}
    (matched : List.Forall₂ (fun p (o : Occ) => p = o.1) l sel) {p : Expr} (member : p ∈ l) :
    ∃ o ∈ sel, o.1 = p := by
  induction matched with
  | nil => exact absurd member List.not_mem_nil
  | cons head _ ih =>
      rcases List.mem_cons.mp member with rfl | later
      · exact ⟨_, List.mem_cons_self .., head.symm⟩
      · obtain ⟨o, inside, same⟩ := ih later
        exact ⟨o, List.mem_cons_of_mem _ inside, same⟩

/-- **A valid ground firing leaves consistent knowledge.** -/
theorem plain_of_valid {C : Conf} {ρ : RuleInstance Expr} {sel : Selection Occ}
    (valid : sel.Valid ground Prod.fst ρ C) : Plain (sel.result Prod.fst ρ C) := by
  obtain ⟨u, solved⟩ := valid.consistent
  exact fun e member => solved e member

/-- **Building a valid ground firing** of a rule without tells or checks: its patterns are the labels
of the selected occurrences. -/
theorem groundValid {C : Conf} {ρ : RuleInstance Expr} {sel : Selection Occ}
    (takenDistinct : sel.taken.Nodup) (madeDistinct : sel.made.Nodup)
    (takes : ρ.take = sel.taken.map Prod.fst) (reads : ρ.read = sel.read.map Prod.fst)
    (outputs : sel.made.map Prod.fst = ρ.produce)
    (enabled : Enabled Prod.fst C.present (sel.commit (T := Expr)))
    (plain : Plain C) (noTells : ρ.tell = []) (noChecks : ρ.checks = []) :
    sel.Valid ground Prod.fst ρ C where
  take_distinct := takenDistinct
  output_distinct := madeDistinct
  take_length := by rw [takes, List.length_map]
  read_length := by rw [reads, List.length_map]
  outputs := outputs
  occurrences := enabled
  consistent := by
    refine ⟨(), fun e member => ?_⟩
    simp only [Selection.problem, List.mem_append, noTells, List.not_mem_nil, or_false] at member
    rcases member with (old | taken) | read
    · exact plain e old
    · rw [takes] at taken
      exact equations_self taken
    · rw [reads] at read
      exact equations_self read
  checks := by
    rw [noChecks]
    intro c member
    exact absurd member List.not_mem_nil

/-! ## Parties and their moves -/

section Parties

variable {R : Type uR} {X : Type uX} {N : Type uN} {I : Type uI}
  (activate : R → X → Option (RuleInstance Expr)) (place : Expr → N)

/-- **A party's move**: the step's own firing of a rule of one of its installed schemas, formed under
its `send` rights at the place of every occurrence it makes. -/
abbrev processStep (process : SchemaPublicationAuthority.Process R N) (C C' : Conf) : Prop :=
  process.Step activate ground Prod.fst (fun o : Occ => place o.1) C C'

/-- **A move of some party** of a family. -/
def systemStep (process : I → SchemaPublicationAuthority.Process R N) (C C' : Conf) : Prop :=
  ∃ actor, processStep activate place (process actor) C C'

variable (inType : N → Prop) (rules : Set (List Expr × Expr))

/-- **A party writes the type only through its constructors**: every row of the type that a rule of
its installed schemas makes, at a handle where the party holds `send`, is the conclusion of a declared
constructor whose premises are rows of the type that the rule takes or reads. -/
def Writes (process : SchemaPublicationAuthority.Process R N) : Prop :=
  ∀ schema ∈ process.schemas, ∀ x ρ, activate schema x = some ρ →
    ∀ t ∈ ρ.produce, inType (place t) → process.rights (place t) .send = true →
      ∃ ps, (ps, t) ∈ rules ∧ ∀ p ∈ ps, (p ∈ ρ.take ∨ p ∈ ρ.read) ∧ inType (place p)

/-- **A party realizes the constructors**: for every declared constructor it holds `send` where the
conclusion lives, and one of its installed schemas activates the constructor's step instance. -/
def Realizes (process : SchemaPublicationAuthority.Process R N) : Prop :=
  ∀ d ∈ rules, process.rights (place d.2) .send = true ∧
    ∃ schema ∈ process.schemas, ∃ x, activate schema x = some (ctor d)

variable {activate place inType rules}

/-- **The step's moves of a party that writes through the constructors go through the constructors**
in the sense of `ThatsAll`: every new content of the region is the conclusion of a declared
constructor from contents of the region present before. -/
theorem throughConstructors_of_writes {process : SchemaPublicationAuthority.Process R N}
    (writes : Writes activate place inType rules process) :
    ThroughConstructors contents (fun e => inType (place e)) rules
      (processStep activate place process) := by
  intro C C' moved r inside inRegion old
  obtain ⟨schema, installed, x, ρ, computed, sel, valid, formed, rfl⟩ := moved
  obtain ⟨o, present, rfl⟩ := inside
  rcases mem_fire.mp present with ⟨survived, -⟩ | made
  · exact (old ⟨o, survived, rfl⟩).elim
  · have madeList : o ∈ sel.made := by simpa [Selection.commit] using made
    have produced : o.1 ∈ ρ.produce := made_label valid madeList
    have permitted : process.rights (place o.1) .send = true := formed o madeList
    obtain ⟨ps, declared, premises⟩ :=
      writes schema installed x ρ computed o.1 produced inRegion permitted
    refine ⟨ps, declared, fun p member => ⟨?_, (premises p member).2⟩⟩
    rcases (premises p member).1 with taken | read
    · obtain ⟨o', selected, same⟩ := selected_of_pattern (takes_match valid) taken
      exact ⟨o', taken_present valid selected, same⟩
    · obtain ⟨o', selected, same⟩ := selected_of_pattern (reads_match valid) read
      exact ⟨o', read_present valid selected, same⟩

/-- **Writing through the constructors, rule by rule**: a party writes the type only through its
constructors when every rule its schemas activate either is the step instance of a declared
constructor whose premises lie in the type, or makes nothing in the type. -/
theorem writes_of_each {process : SchemaPublicationAuthority.Process R N}
    (each : ∀ schema ∈ process.schemas, ∀ x ρ, activate schema x = some ρ →
      (∃ d ∈ rules, ρ = ctor d ∧ ∀ p ∈ d.1, inType (place p)) ∨
        ∀ t ∈ ρ.produce, ¬ inType (place t)) :
    Writes activate place inType rules process := by
  intro schema installed x ρ computed t produced inside _
  rcases each schema installed x ρ computed with ⟨d, declared, rfl, premises⟩ | outside
  · have same : t = d.2 := List.mem_singleton.mp produced
    subst same
    exact ⟨d.1, declared, fun p member => ⟨Or.inr member, premises p member⟩⟩
  · exact absurd inside (outside t produced)

/-- **A party without `send` at the place of any row of the type writes it only through its
constructors**, whatever it installs. -/
theorem writes_of_noSend {process : SchemaPublicationAuthority.Process R N}
    (noSend : ∀ e, inType (place e) → process.rights (place e) .send = false) :
    Writes activate place inType rules process := by
  intro _ _ _ _ _ t _ inside permitted
  rw [noSend t inside] at permitted
  cases permitted

/-! ## Closure under the constructors, and the least fixed point -/

variable (rules) in
/-- **Closed under the constructors**: every declared rule whose premises satisfy the property has a
conclusion that satisfies it. -/
def RuleClosed (P : Expr → Prop) : Prop :=
  ∀ ps r, (ps, r) ∈ rules → (∀ p ∈ ps, P p) → P r

variable (rules) in
/-- **Closed under the constructors inside the region**: the condition a closure statement about the
region needs. -/
def RuleClosedIn (region : Expr → Prop) (L : Set Expr) : Prop :=
  ∀ ps r, (ps, r) ∈ rules → region r → (∀ p ∈ ps, p ∈ L ∧ region p) → r ∈ L

theorem ruleClosedIn_of_ruleClosed {region : Expr → Prop} {P : Expr → Prop}
    (closed : RuleClosed rules P) : RuleClosedIn rules region {r | P r} :=
  fun ps r declared _ premises => closed ps r declared fun p member => (premises p member).1

variable (rules) in
/-- Generation is closed under the constructors. -/
theorem generated_ruleClosed (initial : Set Expr) : RuleClosed rules (Generated rules initial) :=
  fun _ _ declared premises => Generated.rule declared premises

/-- **Induction is the least fixed point**: a property closed under the constructors holds of every
generated row. -/
theorem generated_induction {P : Expr → Prop} (closed : RuleClosed rules P) {r : Expr}
    (generated : Generated rules ∅ r) : P r := by
  induction generated with
  | base inside => exact absurd inside (Set.notMem_empty _)
  | rule declared _ ih => exact closed _ _ declared ih

/-- **A closure statement whose list is closed under the constructors survives every move through the
constructors.** `ThatsAll.generated_survives` is the case of the generated rows. -/
theorem closedBy_survives {region : Expr → Prop} {move : Conf → Conf → Prop}
    (through : ThroughConstructors contents region rules move) {L : Set Expr}
    (closed : RuleClosedIn rules region L) {C C' : Conf} (moved : move C C')
    (holds : ClosedBy contents region L C) : ClosedBy contents region L C' := by
  intro r inside inRegion
  by_cases old : r ∈ contents C
  · exact holds r old inRegion
  · obtain ⟨ps, declared, present⟩ := through C C' moved r inside inRegion old
    exact closed ps r declared inRegion fun p member =>
      ⟨holds p (present p member).1 (present p member).2, (present p member).2⟩

/-- Nothing of the region is in the empty store. -/
theorem closedBy_empty (region : Expr → Prop) (L : Set Expr) :
    ClosedBy contents region L ProgramAdequacy.emptyStore :=
  fun r inside _ => absurd inside (by rw [contents_empty]; exact Set.notMem_empty r)

/-- **An invariant of runs**: a closure statement whose list is closed under the constructors holds
in every state a run of parties that write through the constructors reaches. -/
theorem invariant_of_run {process : I → SchemaPublicationAuthority.Process R N}
    (writes : ∀ actor, Writes activate place inType rules (process actor)) {L : Set Expr}
    (closed : RuleClosedIn rules (fun e => inType (place e)) L) {C C' : Conf}
    (run : Relation.ReflTransGen (systemStep activate place process) C C')
    (start : ClosedBy contents (fun e => inType (place e)) L C) :
    ClosedBy contents (fun e => inType (place e)) L C' := by
  induction run with
  | refl => exact start
  | tail _ moved ih =>
      obtain ⟨actor, moved⟩ := moved
      exact closedBy_survives (throughConstructors_of_writes (writes actor)) closed moved ih

/-- **Fact 1, membership**: when every party writes the type only through its constructors, every
content of the region in every reached state is generated, given that it held at the start. -/
theorem membership {process : I → SchemaPublicationAuthority.Process R N}
    (writes : ∀ actor, Writes activate place inType rules (process actor)) {C C' : Conf}
    (run : Relation.ReflTransGen (systemStep activate place process) C C')
    (start : ClosedBy contents (fun e => inType (place e)) {r | Generated rules ∅ r} C) :
    ClosedBy contents (fun e => inType (place e)) {r | Generated rules ∅ r} C' :=
  invariant_of_run writes (ruleClosedIn_of_ruleClosed (generated_ruleClosed rules ∅)) run start

/-- **Fact 2, induction, as an invariant of runs**: a property closed under the constructors holds of
every content of the region in every state reached from the empty store, when every party writes
through the constructors. -/
theorem induction {process : I → SchemaPublicationAuthority.Process R N}
    (writes : ∀ actor, Writes activate place inType rules (process actor)) {P : Expr → Prop}
    (closed : RuleClosed rules P) {C : Conf}
    (run : Relation.ReflTransGen (systemStep activate place process) ProgramAdequacy.emptyStore C)
    {r : Expr} (present : r ∈ contents C) (inRegion : inType (place r)) : P r :=
  invariant_of_run writes (ruleClosedIn_of_ruleClosed closed) run (closedBy_empty _ _)
    r present inRegion

/-- **Fact 2 read through fact 1**: the same conclusion from membership and the least fixed point. -/
theorem induction_of_membership {process : I → SchemaPublicationAuthority.Process R N}
    (writes : ∀ actor, Writes activate place inType rules (process actor)) {P : Expr → Prop}
    (closed : RuleClosed rules P) {C : Conf}
    (run : Relation.ReflTransGen (systemStep activate place process) ProgramAdequacy.emptyStore C)
    {r : Expr} (present : r ∈ contents C) (inRegion : inType (place r)) : P r :=
  generated_induction closed (membership writes run (closedBy_empty _ _) r present inRegion)

/-! ## Fact 3: closure needs ownership -/

/-- **A sole `send` right in the type owns its region**: no move of another party creates a content
of the type. -/
theorem owned_of_soleSender {process : I → SchemaPublicationAuthority.Process R N} {k : I}
    (sole : ∀ actor, actor ≠ k → ∀ e, inType (place e) →
      (process actor).rights (place e) .send = false) :
    Owned (fun actor => processStep activate place (process actor)) contents
      (fun e => inType (place e)) k := by
  intro actor other C C' moved r inside inRegion
  obtain ⟨schema, installed, x, ρ, computed, sel, valid, formed, rfl⟩ := moved
  obtain ⟨o, present, rfl⟩ := inside
  rcases mem_fire.mp present with ⟨survived, -⟩ | made
  · exact ⟨o, survived, rfl⟩
  · have madeList : o ∈ sel.made := by simpa [Selection.commit] using made
    have permitted : (process actor).rights (place o.1) .send = true := formed o madeList
    rw [sole actor other o.1 inRegion] at permitted
    cases permitted

/-- **Every closure statement survives every other party** when the type has a sole `send` right:
the exact condition is ownership (`ThatsAll.closedReadingSurvives_iff_owned`). -/
theorem closure_of_soleSender {process : I → SchemaPublicationAuthority.Process R N} {k : I}
    (sole : ∀ actor, actor ≠ k → ∀ e, inType (place e) →
      (process actor).rights (place e) .send = false) :
    ClosedReadingSurvives (fun actor => processStep activate place (process actor)) contents
      (fun e => inType (place e)) k :=
  (closedReadingSurvives_iff_owned _ _ _ k).mpr (owned_of_soleSender sole)

/-- **The tree's sole-writer systems own the type** whose rows they protect. -/
theorem owned_of_system
    (system : SchemaPublicationAuthority.System R N I Occ (fun o => place o.1)
      (fun o => inType (place o.1))) :
    Owned (fun actor => processStep activate place (system.process actor)) contents
      (fun e => inType (place e)) system.kernel :=
  owned_of_soleSender fun actor other e inside => system.soleWriter actor other (e, 0) inside

/-! ## Existence: every generated row is reached -/

/-- A list of contents present has a list of present occurrences labelled by it. -/
theorem occurrences_of_contents {C : Conf} : ∀ ps : List Expr, (∀ p ∈ ps, p ∈ contents C) →
    ∃ l : List Occ, l.map Prod.fst = ps ∧ ∀ o ∈ l, o ∈ C.present
  | [], _ => ⟨[], rfl, fun _ member => absurd member List.not_mem_nil⟩
  | p :: ps, inside => by
      obtain ⟨o, present, labelled⟩ := inside p (List.mem_cons_self ..)
      obtain ⟨l, labels, rest⟩ :=
        occurrences_of_contents ps fun q member => inside q (List.mem_cons_of_mem _ member)
      refine ⟨o :: l, by simp [labelled, labels], fun o' member => ?_⟩
      rcases List.mem_cons.mp member with rfl | later
      · exact present
      · exact rest o' later

/-- **A constructor fires wherever its premises are present**: a party holding `send` where the
conclusion lives, with a schema activating the constructor, makes the conclusion and keeps every
content. -/
theorem ctor_fires {process : SchemaPublicationAuthority.Process R N} {d : List Expr × Expr}
    (permitted : process.rights (place d.2) .send = true) {schema : R}
    (installed : schema ∈ process.schemas) {x : X} (computed : activate schema x = some (ctor d))
    {C : Conf} (plain : Plain C) (premises : ∀ p ∈ d.1, p ∈ contents C) :
    ∃ C', processStep activate place process C C' ∧ Plain C' ∧
      contents C' = insert d.2 (contents C) := by
  obtain ⟨l, labels, inside⟩ := occurrences_of_contents d.1 premises
  obtain ⟨o, fresh, labelled⟩ := ProgramAdequacy.occSupply C.present d.2
  let sel : Selection Occ := ⟨[], l, [o]⟩
  have enabled : Enabled Prod.fst C.present (sel.commit (T := Expr)) := by
    refine ⟨by simp [Selection.commit, sel], fun o' member => ?_, by simp [Selection.commit, sel],
      by simp [Selection.commit, sel, fresh], fun _ member => by simp [Selection.commit] at member⟩
    exact inside o' (List.mem_toFinset.mp (by simpa [Selection.commit, sel] using member))
  have valid : sel.Valid ground Prod.fst (ctor d) C :=
    groundValid List.nodup_nil (List.nodup_singleton o) rfl
      (by show d.1 = l.map Prod.fst; exact labels.symm)
      (by show [o.1] = [d.2]; rw [labelled]) enabled plain rfl rfl
  have formed : PublicationAuthority.Formed process.rights (fun o : Occ => place o.1) sel := by
    intro o' member
    have same : o' = o := List.mem_singleton.mp member
    rw [same]
    show process.rights (place o.1) .send = true
    rw [labelled]
    exact permitted
  refine ⟨sel.result Prod.fst (ctor d) C,
    ⟨schema, installed, x, ctor d, computed, sel, valid, formed, rfl⟩, plain_of_valid valid, ?_⟩
  ext e
  constructor
  · rintro ⟨o', present, rfl⟩
    rcases mem_fire.mp present with ⟨survived, -⟩ | made
    · exact Or.inr ⟨o', survived, rfl⟩
    · have same : o' = o := by simpa [Selection.commit, sel] using made
      rw [same, labelled]
      exact Or.inl rfl
  · rintro (rfl | ⟨o', present, rfl⟩)
    · exact ⟨o, mem_fire.mpr (Or.inr (by simp [Selection.commit, sel])), labelled⟩
    · exact ⟨o', mem_fire.mpr (Or.inl ⟨present, by simp [Selection.commit, sel]⟩), rfl⟩

/-- A constructor's firing makes its conclusion and keeps every content. -/
theorem ctor_makes {process : SchemaPublicationAuthority.Process R N} {d : List Expr × Expr}
    (permitted : process.rights (place d.2) .send = true) {schema : R}
    (installed : schema ∈ process.schemas) {x : X} (computed : activate schema x = some (ctor d))
    {C : Conf} (plain : Plain C) (premises : ∀ p ∈ d.1, p ∈ contents C) :
    ∃ C', processStep activate place process C C' ∧ Plain C' ∧ d.2 ∈ contents C' ∧
      contents C ⊆ contents C' := by
  obtain ⟨C', moved, plain', exact⟩ := ctor_fires permitted installed computed plain premises
  exact ⟨C', moved, plain', by rw [exact]; exact Set.mem_insert _ _,
    by rw [exact]; exact Set.subset_insert _ _⟩

/-- Reaching every premise of a list, one after another. -/
theorem reach_all {process : SchemaPublicationAuthority.Process R N} : ∀ ps : List Expr,
    (∀ p ∈ ps, ∀ C : Conf, Plain C → ∃ C', Relation.ReflTransGen (processStep activate place process) C C' ∧
      Plain C' ∧ p ∈ contents C' ∧ contents C ⊆ contents C') →
    ∀ C : Conf, Plain C → ∃ C', Relation.ReflTransGen (processStep activate place process) C C' ∧
      Plain C' ∧ (∀ p ∈ ps, p ∈ contents C') ∧ contents C ⊆ contents C'
  | [], _, C, plain => ⟨C, .refl, plain, fun _ member => absurd member List.not_mem_nil, le_rfl⟩
  | p :: ps, each, C, plain => by
      obtain ⟨C₁, run₁, plain₁, here, grown₁⟩ := each p (List.mem_cons_self ..) C plain
      obtain ⟨C₂, run₂, plain₂, rest, grown₂⟩ :=
        reach_all ps (fun q member => each q (List.mem_cons_of_mem _ member)) C₁ plain₁
      refine ⟨C₂, run₁.trans run₂, plain₂, fun q member => ?_, grown₁.trans grown₂⟩
      rcases List.mem_cons.mp member with rfl | later
      · exact grown₂ here
      · exact rest q later

/-- **Existence**: from any consistent ground state, a party that realizes the constructors reaches by
its own moves a consistent state holding any generated row, keeping every content. -/
theorem reachable_of_generated {process : SchemaPublicationAuthority.Process R N}
    (realizes : Realizes activate place rules process) {r : Expr}
    (generated : Generated rules ∅ r) :
    ∀ C : Conf, Plain C → ∃ C', Relation.ReflTransGen (processStep activate place process) C C' ∧
      Plain C' ∧ r ∈ contents C' ∧ contents C ⊆ contents C' := by
  induction generated with
  | base inside => exact absurd inside (Set.notMem_empty _)
  | @rule ps r declared _ ih =>
      intro C plain
      obtain ⟨C₁, run₁, plain₁, premises, grown₁⟩ := reach_all ps ih C plain
      obtain ⟨permitted, schema, installed, x, computed⟩ := realizes (ps, r) declared
      obtain ⟨C₂, moved, plain₂, made, grown₂⟩ :=
        ctor_makes permitted installed computed plain₁ premises
      exact ⟨C₂, run₁.tail moved, plain₂, made, grown₁.trans grown₂⟩

variable (activate place rules) in
/-- **Parties that realize the constructors together**: for every declared constructor some party
holds `send` where the conclusion lives and installs a schema activating its step instance. -/
def RealizeJointly (process : I → SchemaPublicationAuthority.Process R N) : Prop :=
  ∀ d ∈ rules, ∃ actor, (process actor).rights (place d.2) .send = true ∧
    ∃ schema ∈ (process actor).schemas, ∃ x, activate schema x = some (ctor d)

/-- Reaching every premise of a list by the moves of a family, one after another. -/
theorem reach_all_system {process : I → SchemaPublicationAuthority.Process R N} : ∀ ps : List Expr,
    (∀ p ∈ ps, ∀ C : Conf, Plain C → ∃ C',
      Relation.ReflTransGen (systemStep activate place process) C C' ∧
        Plain C' ∧ p ∈ contents C' ∧ contents C ⊆ contents C') →
    ∀ C : Conf, Plain C → ∃ C', Relation.ReflTransGen (systemStep activate place process) C C' ∧
      Plain C' ∧ (∀ p ∈ ps, p ∈ contents C') ∧ contents C ⊆ contents C'
  | [], _, C, plain => ⟨C, .refl, plain, fun _ member => absurd member List.not_mem_nil, le_rfl⟩
  | p :: ps, each, C, plain => by
      obtain ⟨C₁, run₁, plain₁, here, grown₁⟩ := each p (List.mem_cons_self ..) C plain
      obtain ⟨C₂, run₂, plain₂, rest, grown₂⟩ :=
        reach_all_system ps (fun q member => each q (List.mem_cons_of_mem _ member)) C₁ plain₁
      refine ⟨C₂, run₁.trans run₂, plain₂, fun q member => ?_, grown₁.trans grown₂⟩
      rcases List.mem_cons.mp member with rfl | later
      · exact grown₂ here
      · exact rest q later

/-- **Existence for several writers**: parties that realize the constructors together reach, from any
consistent ground state, a consistent state holding any generated row. -/
theorem reachable_of_generated_system {process : I → SchemaPublicationAuthority.Process R N}
    (realize : RealizeJointly activate place rules process) {r : Expr}
    (generated : Generated rules ∅ r) :
    ∀ C : Conf, Plain C → ∃ C', Relation.ReflTransGen (systemStep activate place process) C C' ∧
      Plain C' ∧ r ∈ contents C' ∧ contents C ⊆ contents C' := by
  induction generated with
  | base inside => exact absurd inside (Set.notMem_empty _)
  | @rule ps r declared _ ih =>
      intro C plain
      obtain ⟨C₁, run₁, plain₁, premises, grown₁⟩ := reach_all_system ps ih C plain
      obtain ⟨actor, permitted, schema, installed, x, computed⟩ := realize (ps, r) declared
      obtain ⟨C₂, moved, plain₂, made, grown₂⟩ :=
        ctor_makes permitted installed computed plain₁ premises
      exact ⟨C₂, run₁.tail ⟨actor, moved⟩, plain₂, made, grown₁.trans grown₂⟩

/-- **Two types side by side**: a party that writes each of two types through its constructors writes
their union through the union of the constructors. A type whose constructors read another type's
rows is not of this form: its premises lie outside its own region, so it is a type only together with
the type it reads (`Lists`). -/
theorem writes_union {process : SchemaPublicationAuthority.Process R N} {inA inB : N → Prop}
    {rulesA rulesB : Set (List Expr × Expr)}
    (writesA : Writes activate place inA rulesA process)
    (writesB : Writes activate place inB rulesB process) :
    Writes activate place (fun n => inA n ∨ inB n) (rulesA ∪ rulesB) process := by
  intro schema installed x ρ computed t produced inside permitted
  rcases inside with inside | inside
  · obtain ⟨ps, declared, premises⟩ :=
      writesA schema installed x ρ computed t produced inside permitted
    exact ⟨ps, Or.inl declared, fun p member =>
      ⟨(premises p member).1, Or.inl (premises p member).2⟩⟩
  · obtain ⟨ps, declared, premises⟩ :=
      writesB schema installed x ρ computed t produced inside permitted
    exact ⟨ps, Or.inr declared, fun p member =>
      ⟨(premises p member).1, Or.inr (premises p member).2⟩⟩

/-- A run of one party is a run of the family. -/
theorem system_run_of_run {process : I → SchemaPublicationAuthority.Process R N} {actor : I}
    {C C' : Conf} (run : Relation.ReflTransGen (processStep activate place (process actor)) C C') :
    Relation.ReflTransGen (systemStep activate place process) C C' := by
  induction run with
  | refl => exact .refl
  | tail _ moved ih => exact ih.tail ⟨actor, moved⟩

/-! ## Which closure statements survive a writer through the constructors -/

/-- The store holding exactly the given contents, with consistent empty knowledge. -/
def storeOf (ps : List Expr) : Conf := ⟨[], (ps.map fun p => (p, 0)).toFinset⟩

theorem plain_storeOf (ps : List Expr) : Plain (storeOf ps) :=
  fun _ member => absurd member List.not_mem_nil

theorem contents_storeOf {ps : List Expr} {e : Expr} : e ∈ contents (storeOf ps) ↔ e ∈ ps := by
  constructor
  · rintro ⟨o, present, rfl⟩
    obtain ⟨p, member, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp present)
    exact member
  · intro member
    exact ⟨(e, 0), List.mem_toFinset.mpr (List.mem_map.mpr ⟨e, member, rfl⟩), rfl⟩

/-- **The closure statements that survive a writer through the constructors**: for a party that writes
the type only through its constructors and realizes them, a closure statement survives each of its
moves from every consistent state exactly when its list is closed under the constructors in the
region. -/
theorem survives_iff_ruleClosedIn {process : SchemaPublicationAuthority.Process R N}
    (writes : Writes activate place inType rules process)
    (realizes : Realizes activate place rules process) (L : Set Expr) :
    (∀ C C', Plain C → processStep activate place process C C' →
        ClosedBy contents (fun e => inType (place e)) L C →
          ClosedBy contents (fun e => inType (place e)) L C') ↔
      RuleClosedIn rules (fun e => inType (place e)) L := by
  constructor
  · intro survives ps r declared inRegion premises
    obtain ⟨permitted, schema, installed, x, computed⟩ := realizes (ps, r) declared
    obtain ⟨C', moved, -, made, -⟩ := ctor_makes (d := (ps, r)) permitted installed computed
      (plain_storeOf ps) fun p member => contents_storeOf.mpr member
    exact survives _ _ (plain_storeOf ps) moved
      (fun e inside _ => (premises e (contents_storeOf.mp inside)).1) r made inRegion
  · intro closed C C' _ moved holds
    exact closedBy_survives (throughConstructors_of_writes writes) closed moved holds

/-- **Membership is the least of them**: when every constructor's premises and conclusion lie in the
type, every list closed under the constructors in the region holds every generated row. -/
theorem generated_subset_of_ruleClosedIn
    (inside : ∀ d ∈ rules, inType (place d.2) ∧ ∀ p ∈ d.1, inType (place p)) {L : Set Expr}
    (closed : RuleClosedIn rules (fun e => inType (place e)) L) {r : Expr}
    (generated : Generated rules ∅ r) : r ∈ L := by
  induction generated with
  | base member => exact absurd member (Set.notMem_empty _)
  | @rule ps r declared _ ih =>
      exact closed ps r declared (inside (ps, r) declared).1 fun p member =>
        ⟨ih p member, (inside (ps, r) declared).2 p member⟩

end Parties

