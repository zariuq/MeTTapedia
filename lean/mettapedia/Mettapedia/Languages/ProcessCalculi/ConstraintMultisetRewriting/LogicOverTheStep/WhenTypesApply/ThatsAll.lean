/-!
# "That's all": a closure clause is an absence statement, sound exactly on an owned region

A closure clause ("these constructors and no others", "these equations cover the function") says
that nothing else is there. On the step that is an absence statement about a region of rows: every
row of the region is among the listed ones (`ClosedBy`).

* **Exact theorem** (`closedReadingSurvives_iff_owned`): every such statement true before a step of
  another party stays true after it exactly when the region is **owned**: no step of another party
  creates a row of the region (`Owned`). That is what "owned" must mean, and no less: the theorem is
  an equivalence.
* **What "owned" does not need**: another party may read and remove. On a store where the owner adds
  `0` and the other party removes what it likes, the region is owned, so every closure statement
  survives, and a presence statement ("`0` is present") does not (`removing_owned`,
  `removing_breaks_presence`). A closure clause asks only that nobody else creates.
* **The constructor reading** (`Generated`, `ThroughConstructors`, `generated_survives`): membership
  as generation by declared rules survives every step that creates rows of the region only as
  conclusions of declared rules from present premises. That is weaker than ownership
  (`owned_throughConstructors`), and strictly: another party that adds `0` by the declared nullary
  rule keeps the constructor reading and breaks the closure statement "nothing is there"
  (`sharing_throughConstructors`, `sharing_breaks_closedReading`). On the step this boundary is
  `Provenance.SystemStep`, which the sole-writer policy derives
  (`PublicationAuthority.System.step_has_publication_boundary`), and `Provenance.step_preserves`,
  `PublicationAuthority.System.run_allDerivable` are its preservation along steps and runs.
* **Controls without ownership**: another party that adds `1` overturns "only `0`" and the
  constructor reading (`adding_overturns`, `adding_breaks_generated`). On the step: a later
  equation overturns "these are all its equations" (`Changes.onlyEquations_not_stable`); the
  declaration with only `add 0 b ↦ b` refutes `add 1 0 ≡ 1`, and the declaration completed by the
  successor row, which contains every step of the first, proves it (`later_row_overturns`).
* **On the step, with the sole-writer policy** (`publication_owned`,
  `publication_closedReadingSurvives`): a publication system owns its protected region, so every
  closure statement about protected rows survives every step of another actor.

So **a constructor-defined type is a type whose defining region is owned**: its closure clause is a
absence statement, sound in an open world exactly when nobody else creates rows of its region. Its
inductive reading survives every other creation that goes through its constructors
(`generated_survives`) and fails when another party creates a row that no rule makes
(`adding_breaks_generated`).
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.LogicOverTheStep.WhenTypesApply.ThatsAll

open Set

universe u v w

/-! ## Absence over a region -/

section Abstract

variable {V : Type u} {I : Type v} {Row : Type w}
  (step : I → V → V → Prop) (rows : V → Set Row) (region : Row → Prop)

/-- **"That's all"**: every row of the region in the store is among the listed ones. -/
def ClosedBy (L : Set Row) (s : V) : Prop := ∀ r ∈ rows s, region r → r ∈ L

/-- **Owned by `k`**: no step of another party creates a row of the region. -/
def Owned (k : I) : Prop :=
  ∀ actor, actor ≠ k → ∀ s s', step actor s s' → ∀ r ∈ rows s', region r → r ∈ rows s

/-- **The closed reading survives every other party**: every closure statement true before a step of
another party is true after it. -/
def ClosedReadingSurvives (k : I) : Prop :=
  ∀ actor, actor ≠ k → ∀ (L : Set Row) s s', step actor s s' →
    ClosedBy rows region L s → ClosedBy rows region L s'

/-- **"That's all" survives every other party exactly when the region is owned.** -/
theorem closedReadingSurvives_iff_owned (k : I) :
    ClosedReadingSurvives step rows region k ↔ Owned step rows region k := by
  constructor
  · intro survives actor other s s' moved r inside inRegion
    exact survives actor other (rows s) s s' moved (fun _ member _ => member) r inside inRegion
  · intro owned actor other L s s' moved closed r inside inRegion
    exact closed r (owned actor other s s' moved r inside inRegion) inRegion

/-! ## The constructor reading -/

/-- **Rows generated by declared rules** from initial rows; a rule has finitely many premises. -/
inductive Generated (rules : Set (List Row × Row)) (initial : Set Row) : Row → Prop
  | base {r : Row} : r ∈ initial → Generated rules initial r
  | rule {premises : List Row} {r : Row} : (premises, r) ∈ rules →
      (∀ p ∈ premises, Generated rules initial p) → Generated rules initial r

/-- **A step goes through the constructors**: every row of the region it creates is the conclusion of
a declared rule whose premises are rows of the region present before. -/
def ThroughConstructors (rules : Set (List Row × Row)) (move : V → V → Prop) : Prop :=
  ∀ s s', move s s' → ∀ r ∈ rows s', region r → r ∉ rows s →
    ∃ premises, (premises, r) ∈ rules ∧ ∀ p ∈ premises, p ∈ rows s ∧ region p

variable {step rows region}

/-- **The constructor reading survives every step through the constructors.** -/
theorem generated_survives {rules : Set (List Row × Row)} {initial : Set Row} {move : V → V → Prop}
    (through : ThroughConstructors rows region rules move) {s s' : V} (moved : move s s')
    (closed : ClosedBy rows region {r | Generated rules initial r} s) :
    ClosedBy rows region {r | Generated rules initial r} s' := by
  intro r inside inRegion
  by_cases old : r ∈ rows s
  · exact closed r old inRegion
  · obtain ⟨premises, rule, present⟩ := through s s' moved r inside inRegion old
    exact Generated.rule rule fun p member => closed p (present p member).1 (present p member).2

/-- **Ownership is a special case**: a party that creates no row of an owned region goes through every
set of constructors. -/
theorem owned_throughConstructors {k : I} (owned : Owned step rows region k)
    (rules : Set (List Row × Row)) {actor : I} (other : actor ≠ k) :
    ThroughConstructors rows region rules (step actor) :=
  fun s s' moved r inside inRegion old => absurd (owned actor other s s' moved r inside inRegion) old

end Abstract

/-! ## Controls on a store of numbers -/

section Toy

/-- The rows of a store of numbers. -/
def rowsOf (s : Finset ℕ) : Set ℕ := {r | r ∈ s}

/-- The region holding every row. -/
def everything : ℕ → Prop := fun _ => True

/-- One nullary constructor: `0`. -/
def zeroRule : Set (List ℕ × ℕ) := {([], 0)}

/-- The owner (`true`) adds `0`; the other party removes what it likes. -/
def removing : Bool → Finset ℕ → Finset ℕ → Prop
  | true, s, s' => s' = insert 0 s
  | false, s, s' => s' ⊆ s

/-- The owner adds `0`; the other party adds `1`. -/
def adding : Bool → Finset ℕ → Finset ℕ → Prop
  | true, s, s' => s' = insert 0 s
  | false, s, s' => s' = insert 1 s

/-- Both parties add `0`, the declared constructor. -/
def sharing : Bool → Finset ℕ → Finset ℕ → Prop
  | _, s, s' => s' = insert 0 s

/-- **Removal by another party keeps the region owned.** -/
theorem removing_owned : Owned removing rowsOf everything true := by
  rintro (_ | _) other s s' moved r inside -
  · exact moved inside
  · exact absurd rfl other

/-- **Control: presence is not a closure statement**: the other party removes `0`. -/
theorem removing_breaks_presence :
    removing false {0} ∅ ∧ 0 ∈ ({0} : Finset ℕ) ∧ 0 ∉ (∅ : Finset ℕ) :=
  ⟨Finset.empty_subset _, Finset.mem_singleton_self 0, Finset.notMem_empty 0⟩

/-- **Control without ownership**: "only `0`" holds, the other party adds `1`, and it fails. -/
theorem adding_overturns :
    ClosedBy rowsOf everything {0} ({0} : Finset ℕ) ∧ adding false {0} (insert 1 {0}) ∧
      ¬ ClosedBy rowsOf everything {0} (insert 1 {0}) ∧ ¬ Owned adding rowsOf everything true := by
  refine ⟨fun r inside _ => Finset.mem_singleton.mp inside, rfl, fun closed => ?_, fun owned => ?_⟩
  · have one : (1 : ℕ) ∈ ({0} : Set ℕ) := closed 1 (Finset.mem_insert_self 1 {0}) trivial
    exact absurd (Set.mem_singleton_iff.mp one) (by decide)
  · have one : (1 : ℕ) ∈ ({0} : Finset ℕ) :=
      owned false (by decide) {0} (insert 1 {0}) rfl 1 (Finset.mem_insert_self 1 {0}) trivial
    exact absurd (Finset.mem_singleton.mp one) (by decide)

theorem zero_generated : Generated zeroRule ∅ 0 :=
  Generated.rule (premises := []) rfl fun _ member => absurd member List.not_mem_nil

theorem one_not_generated : ¬ Generated zeroRule ∅ 1 := by
  intro generated
  cases generated with
  | base inside => exact inside
  | rule rule _ =>
      exact absurd (congrArg Prod.snd (Set.mem_singleton_iff.mp rule)) (by simp)

/-- **Control without ownership: the constructor reading fails** when the other party adds a row
that no declared rule makes. -/
theorem adding_breaks_generated :
    ClosedBy rowsOf everything {r | Generated zeroRule ∅ r} ({0} : Finset ℕ) ∧
      adding false {0} (insert 1 {0}) ∧
      ¬ ClosedBy rowsOf everything {r | Generated zeroRule ∅ r} (insert 1 {0}) := by
  refine ⟨fun r inside _ => ?_, rfl, fun closed => one_not_generated
    (closed 1 (Finset.mem_insert_self 1 {0}) trivial)⟩
  have zero : r = 0 := Finset.mem_singleton.mp inside
  subst zero
  exact zero_generated

/-- **Creation through the constructors keeps the constructor reading.** -/
theorem sharing_throughConstructors (actor : Bool) :
    ThroughConstructors rowsOf everything zeroRule (sharing actor) := by
  intro s s' moved r inside _ old
  have zero : r = 0 := by
    rw [moved] at inside
    rcases Finset.mem_insert.mp inside with same | inS
    · exact same
    · exact absurd inS old
  subst zero
  exact ⟨[], rfl, fun _ member => absurd member List.not_mem_nil⟩

/-- **Control: the constructor reading needs less than ownership.** The other party adds `0` by the
declared rule: the region is not owned, the closure statement "nothing is there" fails, and every
row stays generated. -/
theorem sharing_breaks_closedReading :
    ¬ Owned sharing rowsOf everything true ∧
      ClosedBy rowsOf everything ∅ (∅ : Finset ℕ) ∧ sharing false ∅ {0} ∧
      ¬ ClosedBy rowsOf everything ∅ ({0} : Finset ℕ) ∧
      ClosedBy rowsOf everything {r | Generated zeroRule ∅ r} ({0} : Finset ℕ) := by
  refine ⟨fun owned => ?_, fun r inside _ => absurd inside (Finset.notMem_empty r), rfl,
    fun closed => closed 0 (Finset.mem_singleton_self 0) trivial, ?_⟩
  · exact Finset.notMem_empty 0 (owned false (by decide) ∅ {0} rfl 0 (Finset.mem_singleton_self 0)
      trivial)
  · exact generated_survives (sharing_throughConstructors false) (s := ∅) rfl
      (fun r inside _ => absurd inside (Finset.notMem_empty r))

end Toy

/-! ## On the step: the sole-writer policy owns the protected region -/

section Publication

open PublicationAuthority

variable {T : Type*} {S : Type*} {O : Type*} {N : Type*} {I : Type*} [DecidableEq O]
  {location : O → N} {protectedOccurrence : O → Prop}

/-- **A publication system owns its protected region**: an actor other than the kernel creates no
protected occurrence. -/
theorem publication_owned (system : PublicationAuthority.System T N I O location protectedOccurrence)
    (A : SubstitutionAction T S) (label : O → T) :
    Owned (fun actor before after => system.Step A label actor before after)
      (fun C : Configuration T O => {o | o ∈ C.present}) protectedOccurrence system.kernel :=
  fun _ notKernel _ _ moved _ present isProtected =>
    system.nonwriter_creates_no_protected_occurrence A label notKernel moved present isProtected

/-- **Every closure statement about protected rows survives every step of another actor.** -/
theorem publication_closedReadingSurvives
    (system : PublicationAuthority.System T N I O location protectedOccurrence)
    (A : SubstitutionAction T S) (label : O → T) :
    ClosedReadingSurvives (fun actor before after => system.Step A label actor before after)
      (fun C : Configuration T O => {o | o ∈ C.present}) protectedOccurrence system.kernel :=
  (closedReadingSurvives_iff_owned _ _ _ _).mpr (publication_owned system A label)

end Publication

/-! ## A publication system in which the other actor acts -/

section PublicationExample

open PublicationAuthority NamesOnTheStep NamesOnTheStep.IssuingControls ProgramAdequacy
open MeTTaCalculus.OccurrenceCommits (fire)

/-- Rows labelled `T` live at the protected location `true`. -/
def tLocation (o : Occ) : Bool := decide (o.1 = factT)

/-- The rule making one `U`. -/
def makesU : RuleInstance Expr := ⟨[], [], [], [], [factU]⟩

/-- **A publication system**: the kernel (`true`) holds every right and makes `T`; the other actor
holds `send` only outside the protected location and makes `U`. -/
def tSystem : PublicationAuthority.System Expr Bool Bool Occ tLocation (fun o => tLocation o = true) where
  process actor := ⟨fun place _ => actor || !place, cond actor [makes 1] [makesU]⟩
  kernel := true
  soleWriter actor other occurrence isProtected := by
    cases actor
    · show (false || !tLocation occurrence) = false
      rw [isProtected]
      rfl
    · exact absurd rfl other

/-- The other actor's selection: one `U` with identity `0`. -/
def makeU : Selection Occ := ⟨[], [], [(factU, 0)]⟩

theorem makeU_valid : makeU.Valid ground Prod.fst makesU emptyStore where
  take_distinct := List.nodup_nil
  output_distinct := List.nodup_singleton _
  take_length := rfl
  read_length := rfl
  outputs := by simp [makeU, makesU]
  occurrences := ⟨by simp [makeU, Selection.commit], by simp [makeU, Selection.commit],
    by simp [makeU, Selection.commit], by simp [emptyStore],
    fun _ member => by simp [Selection.commit] at member⟩
  consistent := ⟨(), by simp [SubstitutionAction.Models, Selection.problem, Selection.equations,
    makeU, makesU, emptyStore]⟩
  checks := by simp [makesU]

/-- **The other actor acts**: it publishes a `U` at the empty store. -/
theorem tSystem_other_steps :
    ∃ after, tSystem.Step ground Prod.fst false emptyStore after ∧ (factU, 0) ∈ after.present := by
  refine ⟨makeU.result Prod.fst makesU emptyStore,
    ⟨makesU, List.mem_singleton_self _, makeU, makeU_valid, ?_, rfl⟩, ?_⟩
  · intro occurrence made
    simp only [makeU, List.mem_singleton] at made
    subst made
    decide
  · simp [Selection.result, fire, Selection.commit, makeU, emptyStore]

/-- **The sole-writer theorems are not vacuous**: this system owns its protected region, and its
other actor acts. -/
theorem tSystem_owned :
    Owned (fun actor before after => tSystem.Step ground Prod.fst actor before after)
      (fun C : Conf => {o | o ∈ C.present}) (fun o => tLocation o = true) tSystem.kernel :=
  publication_owned tSystem ground Prod.fst

end PublicationExample

/-! ## A later row overturns a refutation -/

section Declarations

open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId
open Presentation TypedEquality TypedEquality.Normalization TypedContextual
open ConversionCoherence
open ProgrammingOnTheStep.VectorPrograms (one)
open NativeTypesOnTheStep.VectorAppend (vrules)
open NativeTypesOnTheStep.Computing.RootDeterminism

/-- **Control: a refutation drawn from "these equations are all of it" does not survive the row that
completes it.** With only `add 0 b ↦ b`, `add 1 0` and `1` are not convertible; with the successor
row added, whose declaration contains every step of the first, they are. -/
theorem later_row_overturns :
    ¬ Conv prules.headEq stuckCall one prules.computation ∧
      Conv vrules.headEq stuckCall one vrules.computation ∧
      ∀ {n : ℕ} {l r : Tower.Tm n}, halfComputation.step l r →
        NativeTypesOnTheStep.VectorAppend.addComputation.step l r :=
  ⟨stuck_not_one, completed_converts, half_sub_complete⟩

end Declarations

