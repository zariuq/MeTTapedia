import Mettapedia.Cybernetics.DistinctionCalculus.ConstructionMiddle

/-!
# The concepts of an observer family

An observer family is a family of readings of a carrier, each into a type of values; a predicate
is a reading into `Prop`. Two instances are **apart** when some reading tells them apart, and
**indistinguishable** when every reading agrees (`Apart`, `Indist`). Apartness is symmetric and
irreflexive and indistinguishability is an equivalence, so apartness is an exclusion relation of
the distinction calculus with transitive non-exclusion. Its concepts by exclusion
(`Exclusion.IsConcept`) are the types the family can see.

* **A type is a class no reading can split** (`isConcept_iff_saturated`): a class is a concept
  exactly when it is closed under indistinguishability. This is the distinction calculus's own
  characterisation of the concepts without a middle (`Exclusion.union_excluded_eq_univ_iff`,
  `Exclusion.union_excluded_eq_univ_iff_saturated`, `Exclusion.isConcept_of_saturated`), applied
  to apartness. The concept generated by a class is its closure under indistinguishability
  (`excluded_excluded_eq`), and the concept of an instance is its indistinguishability class
  (`conceptOf_eq`).
* **Readings are types** (`isConcept_preimage`), and **the types are what the readings generate**
  (`generated_iff_isConcept`): the closure of the fibres of the readings under arbitrary unions,
  intersections and complements (`Generated`).
* **More readings, more types** (`concepts_subset_iff`): every concept of one family is a concept
  of another exactly when the second family's indistinguishability is finer. Adding readings
  refines (`isConcept_of_reindex`); the control `Controls.strict` shows the inclusion strict.
* **An operation belongs to a lens** (`pullback_isConcept_iff`): an operation pulls every concept
  back to a concept exactly when it sends indistinguishable arguments to indistinguishable results
  (`Respects`). For two arguments the family of pairs reads each component (`pairRead`,
  `respects_pair_iff`).
* **Finitely determined types** (`denoted_iff_finitelyDetermined`): for tests closed under truth,
  negation and conjunction (`BooleanTests`), a class is the extension of one test exactly when it
  is a concept of finitely many tests. A concept of the whole family that no finite subfamily
  decides is the extension of no test.

Controls: `Controls.strict` (no readings against the identity reading on `Bool`), and
`Controls.not_respects` (an operation on `Bool` that splits what the empty family identifies).
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.LogicOverTheStep.Distinctions.ObserverConcepts

open Set
open Mettapedia.Cybernetics.DistinctionCalculus.Exclusion

universe u v w u' v' w'

section Family

variable {V : Type u} {ι : Type v} {R : Type w}

/-- **Apart**: some reading tells the two instances apart. -/
def Apart (read : ι → V → R) (x y : V) : Prop := ∃ i, read i x ≠ read i y

/-- **Indistinguishable**: every reading agrees. -/
def Indist (read : ι → V → R) (x y : V) : Prop := ∀ i, read i x = read i y

variable {read : ι → V → R}

theorem not_apart_iff {x y : V} : ¬ Apart read x y ↔ Indist read x y := by
  simp [Apart, Indist]

theorem apart_iff_not_indist {x y : V} : Apart read x y ↔ ¬ Indist read x y := by
  rw [← not_apart_iff, not_not]

theorem apart_symm (x y : V) : Apart read x y → Apart read y x :=
  fun ⟨i, differ⟩ => ⟨i, Ne.symm differ⟩

theorem apart_irrefl (x : V) : ¬ Apart read x x :=
  fun ⟨_, differ⟩ => differ rfl

theorem indist_refl (x : V) : Indist read x x := fun _ => rfl

theorem indist_symm {x y : V} (same : Indist read x y) : Indist read y x :=
  fun i => (same i).symm

theorem indist_trans {x y z : V} (first : Indist read x y) (second : Indist read y z) :
    Indist read x z :=
  fun i => (first i).trans (second i)

/-- Non-apartness is transitive. -/
theorem not_apart_trans (x y z : V) : ¬ Apart read x y → ¬ Apart read y z → ¬ Apart read x z := by
  rw [not_apart_iff, not_apart_iff, not_apart_iff]
  exact indist_trans

theorem saturated_iff (S : Set V) :
    Saturated (Apart read) S ↔ ∀ x ∈ S, ∀ y, Indist read x y → y ∈ S := by
  simp only [Saturated, not_apart_iff]

/-- **A type is a class no reading can split**: a concept of the family is exactly a class closed
under indistinguishability. -/
theorem isConcept_iff_saturated (S : Set V) :
    IsConcept (Apart read) S ↔ ∀ x ∈ S, ∀ y, Indist read x y → y ∈ S := by
  rw [← saturated_iff]
  constructor
  · intro concept
    exact (union_excluded_eq_univ_iff_saturated (excludes := Apart read) apart_symm S).mp
      ((union_excluded_eq_univ_iff (excludes := Apart read) apart_symm).mpr not_apart_trans S
        concept)
  · exact isConcept_of_saturated (excludes := Apart read) apart_symm apart_irrefl

/-- An indistinguishability class is a concept. -/
theorem isConcept_class (x : V) : IsConcept (Apart read) {y | Indist read x y} :=
  (isConcept_iff_saturated _).mpr fun _ same _ next => indist_trans same next

/-- **The concept of an instance is its indistinguishability class.** -/
theorem conceptOf_eq (x : V) : conceptOf (Apart read) x = {y | Indist read x y} := by
  rw [conceptOf_eq_of_transitive (excludes := Apart read) apart_symm apart_irrefl
    not_apart_trans x]
  ext y
  exact not_apart_iff

/-- **The concept generated by a class is its closure under indistinguishability.** -/
theorem excluded_excluded_eq (S : Set V) :
    excluded (Apart read) (excluded (Apart read) S) = {y | ∃ x ∈ S, Indist read x y} := by
  ext z
  rw [mem_excluded]
  constructor
  · intro member
    by_contra noWitness
    have out : z ∈ excluded (Apart read) S := by
      refine mem_excluded.mpr fun x inS => apart_iff_not_indist.mpr fun same => ?_
      exact noWitness ⟨x, inS, indist_symm same⟩
    exact apart_irrefl z (member z out)
  · rintro ⟨x, inS, same⟩ y out
    rw [apart_iff_not_indist]
    intro zy
    exact apart_iff_not_indist.mp (mem_excluded.mp out x inS)
      (indist_symm (indist_trans same zy))

/-! ## Readings are types, and the types are what they generate -/

/-- **Every set of values of a reading pulls back to a concept.** -/
theorem isConcept_preimage (i : ι) (A : Set R) : IsConcept (Apart read) (read i ⁻¹' A) := by
  rw [isConcept_iff_saturated]
  intro x inA y same
  show read i y ∈ A
  rw [← same i]
  exact inA

/-- Every fibre of a reading is a concept. -/
theorem isConcept_fibre (i : ι) (r : R) : IsConcept (Apart read) {x | read i x = r} :=
  isConcept_preimage i {r}

variable (read) in
/-- **The classes the readings generate**: their fibres, closed under arbitrary unions,
intersections and complements. -/
inductive Generated : Set V → Prop
  | fibre (i : ι) (r : R) : Generated {x | read i x = r}
  | sUnion (family : Set (Set V)) : (∀ S ∈ family, Generated S) → Generated (⋃₀ family)
  | sInter (family : Set (Set V)) : (∀ S ∈ family, Generated S) → Generated (⋂₀ family)
  | compl (S : Set V) : Generated S → Generated Sᶜ

theorem isConcept_of_generated {S : Set V} (generated : Generated read S) :
    IsConcept (Apart read) S := by
  induction generated with
  | fibre i r => exact isConcept_fibre i r
  | sUnion family _ inside =>
      rw [isConcept_iff_saturated]
      rintro x ⟨T, member, inT⟩ y same
      exact ⟨T, member, (isConcept_iff_saturated T).mp (inside T member) x inT y same⟩
  | sInter family _ inside =>
      rw [isConcept_iff_saturated]
      intro x all y same T member
      exact (isConcept_iff_saturated T).mp (inside T member) x (all T member) y same
  | compl S _ concept =>
      rw [isConcept_iff_saturated]
      intro x outside y same inS
      exact outside ((isConcept_iff_saturated S).mp concept y inS x (indist_symm same))

/-- An indistinguishability class is the intersection of fibres. -/
theorem generated_class (x : V) : Generated read {y | Indist read x y} := by
  have equal : {y | Indist read x y} = ⋂₀ Set.range fun i => {y | read i y = read i x} := by
    ext y
    simp only [Set.mem_ofPred_eq, Set.sInter_range, Set.mem_iInter, Indist]
    exact ⟨fun same i => (same i).symm, fun same i => (same i).symm⟩
  rw [equal]
  exact Generated.sInter _ (by
    rintro T ⟨i, rfl⟩
    exact Generated.fibre i (read i x))

/-- **The concepts are exactly the classes the readings generate.** -/
theorem generated_iff_isConcept (S : Set V) : Generated read S ↔ IsConcept (Apart read) S := by
  refine ⟨isConcept_of_generated, fun concept => ?_⟩
  have equal : S = ⋃₀ ((fun x => {y | Indist read x y}) '' S) := by
    ext y
    constructor
    · intro inS
      exact ⟨_, ⟨y, inS, rfl⟩, indist_refl y⟩
    · rintro ⟨T, ⟨x, inS, rfl⟩, same⟩
      exact (isConcept_iff_saturated S).mp concept x inS y same
  rw [equal]
  exact Generated.sUnion _ (by
    rintro T ⟨x, _, rfl⟩
    exact generated_class x)

/-! ## More readings, more types -/

section Refinement

variable {ι' : Type v'} {R' : Type w'} {read' : ι' → V → R'}

/-- A concept of a family is a concept of every family with finer indistinguishability. -/
theorem isConcept_of_refines (refines : ∀ x y, Indist read x y → Indist read' x y) {S : Set V}
    (concept : IsConcept (Apart read') S) : IsConcept (Apart read) S := by
  rw [isConcept_iff_saturated] at concept ⊢
  exact fun x inS y same => concept x inS y (refines x y same)

/-- **Every concept of `read'` is a concept of `read` exactly when the indistinguishability of
`read` is finer.** -/
theorem concepts_subset_iff :
    (∀ S, IsConcept (Apart read') S → IsConcept (Apart read) S) ↔
      ∀ x y, Indist read x y → Indist read' x y := by
  constructor
  · intro inclusion x y same
    exact (isConcept_iff_saturated _).mp (inclusion _ (isConcept_class (read := read') x)) x
      (indist_refl x) y same
  · intro refines S
    exact isConcept_of_refines refines

/-- **Adding readings refines**: a family read through a reindexing of another is coarser. -/
theorem indist_reindex (sub : ι' → ι) {x y : V} (same : Indist read x y) :
    Indist (fun j => read (sub j)) x y :=
  fun j => same (sub j)

theorem apart_of_reindex (sub : ι' → ι) {x y : V} (apart : Apart (fun j => read (sub j)) x y) :
    Apart read x y := by
  obtain ⟨j, differ⟩ := apart
  exact ⟨sub j, differ⟩

/-- Every concept of a subfamily is a concept of the family. -/
theorem isConcept_of_reindex (sub : ι' → ι) {S : Set V}
    (concept : IsConcept (Apart fun j => read (sub j)) S) : IsConcept (Apart read) S :=
  isConcept_of_refines (fun _ _ same => indist_reindex sub same) concept

end Refinement

end Family

/-! ## Operations that belong to a lens -/

section Operations

variable {V : Type u} {ι : Type v} {R : Type w} {W : Type u'} {κ : Type v'} {Q : Type w'}

/-- An operation **respects** two lenses when it sends indistinguishable arguments to
indistinguishable results. -/
def Respects (readW : κ → W → Q) (read : ι → V → R) (f : W → V) : Prop :=
  ∀ a b, Indist readW a b → Indist read (f a) (f b)

/-- **An operation belongs to a lens exactly when it respects it**: it pulls every concept back to
a concept exactly when it sends indistinguishable arguments to indistinguishable results. -/
theorem pullback_isConcept_iff (readW : κ → W → Q) (read : ι → V → R) (f : W → V) :
    (∀ S, IsConcept (Apart read) S → IsConcept (Apart readW) (f ⁻¹' S)) ↔ Respects readW read f := by
  constructor
  · intro pulls a b same
    exact (isConcept_iff_saturated _).mp (pulls _ (isConcept_class (f a))) a (indist_refl (f a)) b
      same
  · intro respects S concept
    rw [isConcept_iff_saturated] at concept ⊢
    exact fun a inS b same => concept (f a) inS (f b) (respects a b same)

end Operations

section Pairs

variable {V₁ V₂ ι₁ ι₂ P : Type*}

/-- **The lens of pairs** reads each component. -/
def pairRead (read₁ : ι₁ → V₁ → P) (read₂ : ι₂ → V₂ → P) : ι₁ ⊕ ι₂ → V₁ × V₂ → P
  | .inl i, p => read₁ i p.1
  | .inr j, p => read₂ j p.2

theorem indist_pairRead_iff (read₁ : ι₁ → V₁ → P) (read₂ : ι₂ → V₂ → P) (p q : V₁ × V₂) :
    Indist (pairRead read₁ read₂) p q ↔ Indist read₁ p.1 q.1 ∧ Indist read₂ p.2 q.2 := by
  constructor
  · intro same
    exact ⟨fun i => same (.inl i), fun j => same (.inr j)⟩
  · rintro ⟨first, second⟩ (i | j)
    · exact first i
    · exact second j

/-- **A binary operation belongs to a lens** exactly when indistinguishable arguments give
indistinguishable results. -/
theorem respects_pair_iff {V κ Q : Type*} (read₁ : ι₁ → V₁ → P) (read₂ : ι₂ → V₂ → P)
    (read : κ → V → Q) (f : V₁ × V₂ → V) :
    Respects (pairRead read₁ read₂) read f ↔
      ∀ a a' b b', Indist read₁ a a' → Indist read₂ b b' → Indist read (f (a, b)) (f (a', b')) := by
  constructor
  · intro respects a a' b b' first second
    exact respects (a, b) (a', b') ((indist_pairRead_iff read₁ read₂ _ _).mpr ⟨first, second⟩)
  · rintro respects ⟨a, b⟩ ⟨a', b'⟩ same
    obtain ⟨first, second⟩ := (indist_pairRead_iff read₁ read₂ _ _).mp same
    exact respects a a' b b' first second

end Pairs

/-! ## Finitely determined types -/

/-- **Tests closed under truth, negation and conjunction.** -/
structure BooleanTests (V : Type u) where
  /-- The tests. -/
  Test : Type v
  /-- Where a test holds. -/
  holds : Test → V → Prop
  top : Test
  neg : Test → Test
  conj : Test → Test → Test
  holds_top : ∀ x, holds top x
  holds_neg : ∀ t x, holds (neg t) x ↔ ¬ holds t x
  holds_conj : ∀ s t x, holds (conj s t) x ↔ holds s x ∧ holds t x

namespace BooleanTests

variable {V : Type u} (B : BooleanTests.{u, v} V)

/-- Disjunction. -/
def disj (s t : B.Test) : B.Test := B.neg (B.conj (B.neg s) (B.neg t))

theorem holds_disj (s t : B.Test) (x : V) : B.holds (B.disj s t) x ↔ B.holds s x ∨ B.holds t x := by
  rw [disj, B.holds_neg, B.holds_conj, B.holds_neg, B.holds_neg]
  tauto

/-- Agreement on a list of tests. -/
def AgreeOn (F : List B.Test) (x y : V) : Prop := ∀ t ∈ F, B.holds t x ↔ B.holds t y

/-- The finite subfamily of a list of tests, as readings into `Prop`. -/
def subfamily (F : List B.Test) : {t // t ∈ F} → V → Prop := fun t x => B.holds t.1 x

theorem indist_subfamily_iff (F : List B.Test) (x y : V) :
    Indist (B.subfamily F) x y ↔ B.AgreeOn F x y := by
  constructor
  · intro same t member
    exact Iff.of_eq (same ⟨t, member⟩)
  · intro agree t
    exact propext (agree t.1 t.2)

/-- A class closed under agreement on finitely many tests is the extension of one test. -/
theorem exists_test_of_closed :
    ∀ (F : List B.Test) (S : Set V), (∀ x ∈ S, ∀ y, B.AgreeOn F x y → y ∈ S) →
      ∃ t, ∀ x, B.holds t x ↔ x ∈ S
  | [], S, closed => by
      by_cases inhabited : ∃ x, x ∈ S
      · obtain ⟨x, inS⟩ := inhabited
        exact ⟨B.top, fun y => ⟨fun _ => closed x inS y fun t member => absurd member
          List.not_mem_nil, fun _ => B.holds_top y⟩⟩
      · refine ⟨B.neg B.top, fun y => ⟨fun holds => absurd (B.holds_top y) ((B.holds_neg _ _).mp holds),
          fun inS => absurd ⟨y, inS⟩ inhabited⟩⟩
  | ψ :: F, S, closed => by
      have closedAt : ∀ (polarity : Prop), ∀ x ∈ {x | ∃ y ∈ S, (B.holds ψ y ↔ polarity) ∧ B.AgreeOn F y x},
          ∀ z, B.AgreeOn F x z → z ∈ {x | ∃ y ∈ S, (B.holds ψ y ↔ polarity) ∧ B.AgreeOn F y x} := by
        rintro polarity x ⟨y, inS, sign, agree⟩ z next
        exact ⟨y, inS, sign, fun t member => (agree t member).trans (next t member)⟩
      obtain ⟨plus, plusHolds⟩ := exists_test_of_closed F _ (closedAt True)
      obtain ⟨minus, minusHolds⟩ := exists_test_of_closed F _ (closedAt False)
      refine ⟨B.disj (B.conj ψ plus) (B.conj (B.neg ψ) minus), fun x => ?_⟩
      rw [B.holds_disj, B.holds_conj, B.holds_conj, B.holds_neg, plusHolds, minusHolds]
      constructor
      · rintro (⟨here, y, inS, sign, agree⟩ | ⟨here, y, inS, sign, agree⟩)
        · refine closed y inS x fun t member => ?_
          rcases List.mem_cons.mp member with rfl | later
          · exact ⟨fun _ => here, fun _ => sign.mpr trivial⟩
          · exact agree t later
        · refine closed y inS x fun t member => ?_
          rcases List.mem_cons.mp member with rfl | later
          · exact ⟨fun holds => (sign.mp holds).elim, fun holds => absurd holds here⟩
          · exact agree t later
      · intro inS
        by_cases here : B.holds ψ x
        · exact Or.inl ⟨here, x, inS, iff_true_intro here, fun _ _ => Iff.rfl⟩
        · exact Or.inr ⟨here, x, inS, iff_false_intro here, fun _ _ => Iff.rfl⟩

/-- **The exact boundary**: a class is the extension of one test exactly when finitely many tests
already decide it. -/
theorem denoted_iff_finitelyDetermined (S : Set V) :
    (∃ t, ∀ x, B.holds t x ↔ x ∈ S) ↔ ∃ F : List B.Test, ∀ x ∈ S, ∀ y, B.AgreeOn F x y → y ∈ S := by
  constructor
  · rintro ⟨t, extension⟩
    refine ⟨[t], fun x inS y agree => ?_⟩
    exact (extension y).mp ((agree t (List.mem_singleton_self t)).mp ((extension x).mpr inS))
  · rintro ⟨F, closed⟩
    exact B.exists_test_of_closed F S closed

/-- The same boundary with concepts: a class is the extension of one test exactly when it is a
concept of a finite subfamily. -/
theorem denoted_iff_concept_of_finite (S : Set V) :
    (∃ t, ∀ x, B.holds t x ↔ x ∈ S) ↔ ∃ F : List B.Test, IsConcept (Apart (B.subfamily F)) S := by
  rw [denoted_iff_finitelyDetermined]
  refine exists_congr fun F => ?_
  rw [isConcept_iff_saturated]
  simp only [B.indist_subfamily_iff]

/-- Every test's extension is a concept of the whole family. -/
theorem isConcept_extension (t : B.Test) : IsConcept (Apart B.holds) {x | B.holds t x} :=
  isConcept_preimage (read := B.holds) t {p | p}

end BooleanTests

/-! ## Controls -/

namespace Controls

/-- No readings. -/
def noReadings : Empty → Bool → Bool := fun i => i.elim

/-- The identity reading. -/
def identity : Unit → Bool → Bool := fun _ b => b

/-- **Control: the inclusion of concepts is strict.** The empty family is a subfamily of the
identity reading; `{true}` is a concept of the identity reading and not of the empty family, which
identifies everything. -/
theorem strict :
    (∀ S, IsConcept (Apart noReadings) S → IsConcept (Apart identity) S) ∧
      IsConcept (Apart identity) {true} ∧ ¬ IsConcept (Apart noReadings) {true} := by
  refine ⟨fun S => isConcept_of_refines fun _ _ _ i => i.elim, ?_, ?_⟩
  · exact isConcept_fibre (read := identity) () true
  · intro concept
    have closed := (isConcept_iff_saturated _).mp concept true rfl false fun i => i.elim
    exact Bool.false_ne_true closed

/-- **Control: an operation that belongs to a lens.** Negation on `Bool` respects the identity
reading. -/
theorem not_respects_identity : Respects identity identity not := by
  intro a b same _
  have equal : a = b := same ()
  subst equal
  rfl

/-- **Control: an operation that does not belong to a lens.** Reading `Bool` through no readings,
the identity operation into the identity reading splits what the source identifies. -/
theorem not_respects : ¬ Respects noReadings identity id :=
  fun respects => Bool.false_ne_true ((respects false true fun i => i.elim) ())

end Controls

