import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.LogicOverTheStep.Distinctions.ObserverConcepts
import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.NativeTypesOnTheStep.AgreementCounterexample

/-!
# Typing after the match as a type of the knowledge

The knowledge of the dependent full step compares judged terms by typed βη-equality. On the
substitutions from a frame `Θ` to a frame `Δ` its observers are its own primitive judgements: for
a judged term `t` of `Δ` and a judged term `u` of `Θ`, whether `t` read through the substitution
equals `u` (`knowledge`). Two substitutions are indistinguishable to them exactly when they agree
on every judged term (`indist_knowledge_iff`, `UnificationWithLevels.Agree`). So the types of the
knowledge, on substitutions, are the classes closed under agreement.

* **The comprehension of a store is a type** (`solutionsAt_isConcept`): agreeing substitutions
  solve the same stores.
* **The concept generated by a predicate is its agreement closure** (`saturation_eq_closure`):
  the tree's `saturation` is double exclusion for the knowledge's observers. Hence **typed up to
  agreement is the comprehension inside the concept the raw typing generates**
  (`typedUpToAgreement_iff_closure`), while typed after the match is the comprehension inside the
  raw typing itself (`typedAfterMatch_iff_le`).
* **The typing of a row among the solutions is a type exactly when it is closed under agreement**
  (`closedUnderAgreement_iff_isConcept`). So **typing at every solution is a type**
  (`typedAfterMatch_isConcept`, from `closed_of_typedAfterMatch`): it is the whole comprehension
  (`typedSolutions_eq_of_typedAfterMatch`).
* **The raw shape reading is not a type** (`etaRow_not_isConcept`, from the η control
  `NativeTypesOnTheStep.Eta.etaRow_not_closed`): the identity and the η-expansion of
  `h : Π (x : U₁). U₁` agree, and the row `h : Π (x : U₀). U₁` is typed at the second and not at
  the first. In the same frame the row of the η-expansion is typed after every match, and its
  typing is a type (`etaExpanded_isConcept`).

Where the raw typing is not a type, the two semantic rules part (`NativeTypesOnTheStep.Eta.eta_gap`),
and the settling step's admission depends on the representative it settles along
(`NativeTypesOnTheStep.Eta.representative_dependence`).
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.LogicOverTheStep.Distinctions.TypingConcepts

open _root_.CategoryTheory Opposite Interface
open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
open TypedEquality TypedEquality.Normalization TypedContextual
open ContextualDependentEta
open Interface.DependentFull (Make)
open UnificationWithLevels (Agree)
open NativeTypesOnTheStep
open Mettapedia.Cybernetics.DistinctionCalculus.Exclusion
open ObserverConcepts

variable {Head L : Type} [UniverseLevel.LevelOrder L] {rules : Rules Head}
variable (levels : LevelModel rules L)

/-- **The knowledge's observers on substitutions** from `Θ` to `Δ`: for a judged term `t` of `Δ`
and a judged term `u` of `Θ`, whether `t` read through the substitution equals `u`. -/
def knowledge (Θ Δ : Context rules) : TotalTerm Δ × TotalTerm Θ → (Θ ⟶ Δ) → Prop :=
  fun p τ => (frames levels).E (p.1.reindex τ) p.2

/-- **Indistinguishable to the knowledge is agreement on every judged term.** -/
theorem indist_knowledge_iff {Θ Δ : Context rules} (τ τ' : Θ ⟶ Δ) :
    Indist (knowledge levels Θ Δ) τ τ' ↔ Agree (frames levels) τ τ' := by
  constructor
  · intro same t
    have here : (frames levels).E (t.reindex τ) (t.reindex τ) := ((frames levels).equivalence Θ).refl _
    have there : (frames levels).E (t.reindex τ') (t.reindex τ) :=
      (Iff.of_eq (same (t, t.reindex τ))).mp here
    exact ((frames levels).equivalence Θ).symm there
  · intro agree p
    apply propext
    constructor
    · intro equal
      exact ((frames levels).equivalence Θ).trans (((frames levels).equivalence Θ).symm (agree p.1)) equal
    · intro equal
      exact ((frames levels).equivalence Θ).trans (agree p.1) equal

/-- The types of the knowledge on substitutions are the classes closed under agreement. -/
theorem isConcept_knowledge_iff {Θ Δ : Context rules} (S : Set (Θ ⟶ Δ)) :
    IsConcept (Apart (knowledge levels Θ Δ)) S ↔
      ∀ τ ∈ S, ∀ τ', Agree (frames levels) τ τ' → τ' ∈ S := by
  rw [isConcept_iff_saturated]
  simp only [indist_knowledge_iff]

/-! ## The comprehension, and the concept a predicate generates -/

/-- The solutions at `Θ` of a store at `Δ`. -/
def solutionsAt {Δ : Context rules} (I : EquationStore (TotalTerm Δ)) (Θ : Context rules) :
    Set (Θ ⟶ Δ) :=
  {τ | (frames levels).Models τ I}

/-- **The comprehension of a store is a type of the knowledge.** -/
theorem solutionsAt_isConcept {Δ : Context rules} (I : EquationStore (TotalTerm Δ))
    (Θ : Context rules) : IsConcept (Apart (knowledge levels Θ Δ)) (solutionsAt levels I Θ) :=
  (isConcept_knowledge_iff levels _).mpr fun _ solved _ agree =>
    (UnificationWithLevels.models_of_agree agree I).mp solved

/-- **The agreement closure of a predicate is the concept it generates.** -/
theorem saturation_eq_closure {Δ : Context rules} (P : Subfunctor (yoneda.obj Δ)) (Θ : Context rules) :
    (saturation levels P).obj (op Θ) =
      excluded (Apart (knowledge levels Θ Δ)) (excluded (Apart (knowledge levels Θ Δ)) (P.obj (op Θ))) := by
  rw [excluded_excluded_eq]
  ext τ
  rw [mem_saturation]
  constructor
  · rintro ⟨τ', member, agree⟩
    exact ⟨τ', member, (indist_knowledge_iff levels τ' τ).mpr agree.symm⟩
  · rintro ⟨τ', member, same⟩
    exact ⟨τ', member, ((indist_knowledge_iff levels τ' τ).mp same).symm⟩

/-- **Typed up to agreement is the comprehension inside the concept generated by the raw
typing.** -/
theorem typedUpToAgreement_iff_closure {Δ : Context rules} (I : EquationStore (TotalTerm Δ))
    (m : Make Δ) :
    TypedUpToAgreement levels I m ↔ ∀ Θ : Context rules,
      solutionsAt levels I Θ ⊆ excluded (Apart (knowledge levels Θ Δ))
        (excluded (Apart (knowledge levels Θ Δ)) ((typing m).obj (op Θ))) := by
  constructor
  · intro typed Θ τ solved
    rw [← saturation_eq_closure]
    exact typed (op Θ) solved
  · intro inside U τ solved
    have there := inside U.unop solved
    rwa [← saturation_eq_closure] at there

/-! ## The typing of a row among the solutions -/

/-- **The raw typing among the solutions**: the solutions at `Θ` at which the made row is typed. -/
def typedSolutions {Δ : Context rules} (I : EquationStore (TotalTerm Δ)) (m : Make Δ)
    (Θ : Context rules) : Set (Θ ⟶ Δ) :=
  {τ | (frames levels).Models τ I ∧ τ ∈ (typing m).obj (op Θ)}

/-- **The typing of a row among the solutions is a type of the knowledge exactly when it is closed
under agreement.** -/
theorem closedUnderAgreement_iff_isConcept {Δ : Context rules} (I : EquationStore (TotalTerm Δ))
    (m : Make Δ) :
    ClosedUnderAgreement levels I m ↔
      ∀ Θ : Context rules, IsConcept (Apart (knowledge levels Θ Δ)) (typedSolutions levels I m Θ) := by
  simp only [isConcept_knowledge_iff]
  constructor
  · rintro closed Θ τ ⟨solved, typed⟩ τ' agree
    have solved' := (UnificationWithLevels.models_of_agree agree I).mp solved
    exact ⟨solved', closed Θ τ' τ solved' agree.symm typed⟩
  · intro concept Θ τ τ' solved agree typed'
    have solved' := (UnificationWithLevels.models_of_agree agree I).mp solved
    exact (concept Θ τ' ⟨solved', typed'⟩ τ agree.symm).2

/-- A row typed after the match is typed at every solution: its typing among the solutions is the
comprehension. -/
theorem typedSolutions_eq_of_typedAfterMatch {Δ : Context rules} {I : EquationStore (TotalTerm Δ)}
    {m : Make Δ} (typed : TypedAfterMatch levels I m) (Θ : Context rules) :
    typedSolutions levels I m Θ = solutionsAt levels I Θ := by
  ext τ
  exact ⟨fun inside => inside.1, fun solved => ⟨solved, (typedAfterMatch_iff_le levels I m).mp typed (op Θ) solved⟩⟩

/-- **Typing at every solution is a type of the knowledge.** -/
theorem typedAfterMatch_isConcept {Δ : Context rules} {I : EquationStore (TotalTerm Δ)} {m : Make Δ}
    (typed : TypedAfterMatch levels I m) (Θ : Context rules) :
    IsConcept (Apart (knowledge levels Θ Δ)) (typedSolutions levels I m Θ) :=
  (closedUnderAgreement_iff_isConcept levels I m).mp (closed_of_typedAfterMatch levels typed) Θ

/-! ## The η control -/

section Eta

open Interface.DependentFull.Controls Eta

/-- **The raw shape reading is not a type**: among the solutions of the empty store over
`h : Π (x : U₁). U₁`, the row `h : Π (x : U₀). U₁` is typed at the η-expansion and not at the
identity, which agree. -/
theorem etaRow_not_isConcept :
    ¬ IsConcept (Apart (knowledge setting.levels hFrame hFrame))
      (typedSolutions setting.levels ([] : EquationStore (TotalTerm hFrame)) etaRow hFrame) := by
  intro concept
  have atEta : etaHom ∈ typedSolutions setting.levels ([] : EquationStore (TotalTerm hFrame)) etaRow hFrame :=
    ⟨Frames.models_nil _, (mem_typing_iff_reindex etaRow etaHom).mpr etaRow_typed_at_eta⟩
  have atIdentity := (isConcept_knowledge_iff setting.levels _).mp concept etaHom atEta (𝟙 hFrame)
    etaHom_agree.symm
  apply etaRow_not_wellTyped
  have typed := (mem_typing_iff_reindex etaRow (𝟙 hFrame)).mp atIdentity.2
  rwa [Make.reindex_id'] at typed

/-- **In the same frame, the row of the η-expansion is typed after every match, and its typing is
a type at every frame.** -/
theorem etaExpanded_isConcept (I : EquationStore (TotalTerm hFrame)) (Θ : Context Tower.rules) :
    TypedAfterMatch setting.levels I (etaRow.reindex etaHom) ∧
      IsConcept (Apart (knowledge setting.levels Θ hFrame))
        (typedSolutions setting.levels I (etaRow.reindex etaHom) Θ) :=
  ⟨typedAfterMatch_of_wellTyped setting.levels I etaRow_typed_at_eta,
    typedAfterMatch_isConcept setting.levels
      (typedAfterMatch_of_wellTyped setting.levels I etaRow_typed_at_eta) Θ⟩

end Eta

