import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.NativeTypesOnTheStep.Computing.DirectedAnswers.Basic
import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.NativeTypesOnTheStep.Computing.Vectors.Qualified

/-!
# Answers up to universe heads

Two terms are **equal up to heads** (`UpToHeads rel`) when they have one shape and their universe heads,
position by position, are related by `rel`. With `rel` the equivalence generated by the package's head
equality this is the congruence generated by equality of universe heads (`HeadCongruent`).

**The rows of a constructor system do not look at heads.** A left side is a defined constant applied to
patterns built from variables, undefined constants, applications and reflexivity, with no head. So an
instance of a left side, up to heads, is an instance of the same left side (`match_leftSide`), and every
directed step of a term is matched, up to heads, by a directed step of every term equal to it up to heads
(`simulate`). Hence, in every constructor presentation:

* **A full step is a directed step or a head step** (`step_cases`), and a full reduction is a directed
  reduction followed by head steps (`simulate_stepStar`).
* **Every answer of the full reduction without heads is an answer** (`directedAnswer_of_answer`), so
  when every head is related to itself, the answers of the full reduction (`Answer`) are exactly the
  answers without heads (`answer_iff_headFree`). That equivalence has two hypotheses, a constructor
  presentation and heads related to themselves, and each has its control below.
* **The conversion reading of the answer is unique up to heads.** Every directed normal form
  convertible with a call is head-congruent to the call's answer, which exists
  (`directedAnswer_of_conv`); two directed normal forms that are convertible are head-congruent
  (`headCongruent_of_conv`), and equal when one of them has no head (`eq_of_conv_headFree`).

The Church–Rosser properties used are the confluence of the directed reduction, for uniqueness of the
answer itself (`DirectedAnswer.unique`), and Church–Rosser of the full reduction, for the conversion
reading; both come from the complete development of constructor systems.

**Controls.**

* In the vectors package at every level, the universe `U₀` is its own answer, and the sort whose level is
  `max 0 0` is a second directed normal form convertible with it, head-congruent and not equal
  (`u0_controls`); `U₀` has no answer of the full reduction (`u0_no_answer`), as the relation predicts.
* **The first hypothesis alone fails.** A package whose one row inspects a head (`Inspecting.rules`:
  `f true ⟶ g`, with every two heads equal, so every head related to itself, `Inspecting.reflexive`) has
  an answer of the full reduction without heads that is not an answer (`Inspecting.separates`), so it is
  no constructor presentation (`Inspecting.not_constructorPresentation`). The declaration-time check
  rejects its row, and accepts the row with a variable where the head stood (`Inspecting.row_rejected`,
  `Inspecting.variable_row_accepted`).
* **The second hypothesis alone fails.** The vectors package with its head equality removed
  (`ContextualDependentExecutableJoin.directed`) is a constructor presentation in which no head is
  related to itself. Its answers of the full reduction are the answers of the package
  (`answer_directed_iff`), heads included, and the equivalence fails at `U₀` (`directed_control`).
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting
namespace NativeTypesOnTheStep.Computing.DirectedAnswers

open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId
open Presentation TypedEquality TypedEquality.Normalization
open AlgebraicSchema (variableMultiplicity LeftLinear)
open ConstructorSystem (ConstructorPresentation Pattern LeftSide join subst_congr_occurring)
open ConversionCoherence (StepStar)

variable {Head : Type}

/-! ## Equality up to heads -/

/-- **Equal up to heads**: one shape, and at every position the universe heads of the two terms are
related by `rel`. -/
inductive UpToHeads (rel : Head → Head → Prop) : {n : Nat} → Tm Head n → Tm Head n → Prop where
  | var {n : Nat} (i : Fin n) : UpToHeads rel (.var i) (.var i)
  | const {n : Nat} (c : DeclName) : UpToHeads rel (.const c : Tm Head n) (.const c)
  | head {n : Nat} {h h' : Head} : rel h h' → UpToHeads rel (.head h : Tm Head n) (.head h')
  | pi {n : Nat} {A A' : Tm Head n} {B B' : Tm Head (n + 1)} :
      UpToHeads rel A A' → UpToHeads rel B B' → UpToHeads rel (.pi A B) (.pi A' B')
  | sigma {n : Nat} {A A' : Tm Head n} {B B' : Tm Head (n + 1)} :
      UpToHeads rel A A' → UpToHeads rel B B' → UpToHeads rel (.sigma A B) (.sigma A' B')
  | id {n : Nat} {A A' a a' b b' : Tm Head n} :
      UpToHeads rel A A' → UpToHeads rel a a' → UpToHeads rel b b' →
        UpToHeads rel (.id A a b) (.id A' a' b')
  | lam {n : Nat} {body body' : Tm Head (n + 1)} :
      UpToHeads rel body body' → UpToHeads rel (.lam body) (.lam body')
  | app {n : Nat} {f f' a a' : Tm Head n} :
      UpToHeads rel f f' → UpToHeads rel a a' → UpToHeads rel (.app f a) (.app f' a')
  | pair {n : Nat} {a a' b b' : Tm Head n} :
      UpToHeads rel a a' → UpToHeads rel b b' → UpToHeads rel (.pair a b) (.pair a' b')
  | fst {n : Nat} {p p' : Tm Head n} : UpToHeads rel p p' → UpToHeads rel (.fst p) (.fst p')
  | snd {n : Nat} {p p' : Tm Head n} : UpToHeads rel p p' → UpToHeads rel (.snd p) (.snd p')
  | refl {n : Nat} {a a' : Tm Head n} : UpToHeads rel a a' → UpToHeads rel (.refl a) (.refl a')

/-- **The congruence generated by equality of universe heads.** -/
abbrev HeadCongruent (R : Rules Head) {n : Nat} (t t' : Tm Head n) : Prop :=
  UpToHeads (Relation.EqvGen R.headEq) t t'

namespace UpToHeads

variable {rel : Head → Head → Prop}

/-- Every term is equal to itself up to heads, when every head is related to itself. -/
theorem self (reflexive : ∀ h, rel h h) : ∀ {n : Nat} (t : Tm Head n), UpToHeads rel t t
  | _, .var i => .var i
  | _, .const c => .const c
  | _, .head h => .head (reflexive h)
  | _, .pi A B => .pi (self reflexive A) (self reflexive B)
  | _, .sigma A B => .sigma (self reflexive A) (self reflexive B)
  | _, .id A a b => .id (self reflexive A) (self reflexive a) (self reflexive b)
  | _, .lam body => .lam (self reflexive body)
  | _, .app f a => .app (self reflexive f) (self reflexive a)
  | _, .pair a b => .pair (self reflexive a) (self reflexive b)
  | _, .fst p => .fst (self reflexive p)
  | _, .snd p => .snd (self reflexive p)
  | _, .refl a => .refl (self reflexive a)

theorem symm (flip : ∀ h h', rel h h' → rel h' h) {n : Nat} {t t' : Tm Head n}
    (same : UpToHeads rel t t') : UpToHeads rel t' t := by
  induction same with
  | var i => exact .var i
  | const c => exact .const c
  | head e => exact .head (flip _ _ e)
  | pi _ _ ihA ihB => exact .pi ihA ihB
  | sigma _ _ ihA ihB => exact .sigma ihA ihB
  | id _ _ _ ihA iha ihb => exact .id ihA iha ihb
  | lam _ ih => exact .lam ih
  | app _ _ ihf iha => exact .app ihf iha
  | pair _ _ iha ihb => exact .pair iha ihb
  | fst _ ih => exact .fst ih
  | snd _ ih => exact .snd ih
  | refl _ ih => exact .refl ih

theorem trans (compose : ∀ a b c, rel a b → rel b c → rel a c) {n : Nat} {t u v : Tm Head n}
    (first : UpToHeads rel t u) (second : UpToHeads rel u v) : UpToHeads rel t v := by
  induction first with
  | var i => exact second
  | const c => exact second
  | head e => cases second with | head e' => exact .head (compose _ _ _ e e')
  | pi _ _ ihA ihB => cases second with | pi sA sB => exact .pi (ihA sA) (ihB sB)
  | sigma _ _ ihA ihB => cases second with | sigma sA sB => exact .sigma (ihA sA) (ihB sB)
  | id _ _ _ ihA iha ihb => cases second with | id sA sa sb => exact .id (ihA sA) (iha sa) (ihb sb)
  | lam _ ih => cases second with | lam s => exact .lam (ih s)
  | app _ _ ihf iha => cases second with | app sf sa => exact .app (ihf sf) (iha sa)
  | pair _ _ iha ihb => cases second with | pair sa sb => exact .pair (iha sa) (ihb sb)
  | fst _ ih => cases second with | fst s => exact .fst (ih s)
  | snd _ ih => cases second with | snd s => exact .snd (ih s)
  | refl _ ih => cases second with | refl s => exact .refl (ih s)

theorem mono {rel' : Head → Head → Prop} (imp : ∀ h h', rel h h' → rel' h h') {n : Nat}
    {t t' : Tm Head n} (same : UpToHeads rel t t') : UpToHeads rel' t t' := by
  induction same with
  | var i => exact .var i
  | const c => exact .const c
  | head e => exact .head (imp _ _ e)
  | pi _ _ ihA ihB => exact .pi ihA ihB
  | sigma _ _ ihA ihB => exact .sigma ihA ihB
  | id _ _ _ ihA iha ihb => exact .id ihA iha ihb
  | lam _ ih => exact .lam ih
  | app _ _ ihf iha => exact .app ihf iha
  | pair _ _ iha ihb => exact .pair iha ihb
  | fst _ ih => exact .fst ih
  | snd _ ih => exact .snd ih
  | refl _ ih => exact .refl ih

theorem rename {n m : Nat} {t t' : Tm Head n} (same : UpToHeads rel t t') (ρ : Ren n m) :
    UpToHeads rel (Presentation.rename ρ t) (Presentation.rename ρ t') := by
  induction same generalizing m with
  | var i => exact .var (ρ i)
  | const c => exact .const c
  | head e => exact .head e
  | pi _ _ ihA ihB => exact .pi (ihA ρ) (ihB (liftRen ρ))
  | sigma _ _ ihA ihB => exact .sigma (ihA ρ) (ihB (liftRen ρ))
  | id _ _ _ ihA iha ihb => exact .id (ihA ρ) (iha ρ) (ihb ρ)
  | lam _ ih => exact .lam (ih (liftRen ρ))
  | app _ _ ihf iha => exact .app (ihf ρ) (iha ρ)
  | pair _ _ iha ihb => exact .pair (iha ρ) (ihb ρ)
  | fst _ ih => exact .fst (ih ρ)
  | snd _ ih => exact .snd (ih ρ)
  | refl _ ih => exact .refl (ih ρ)

theorem liftSub_pointwise {n m : Nat} {σ σ' : Sub Head n m}
    (pointwise : ∀ i, UpToHeads rel (σ i) (σ' i)) : ∀ i, UpToHeads rel (liftSub σ i) (liftSub σ' i) := by
  intro i
  refine Fin.cases ?_ (fun j => ?_) i
  · simp only [liftSub, Fin.cases_zero]
    exact .var 0
  · simp only [liftSub, Fin.cases_succ]
    exact (pointwise j).rename wk

/-- **Substitution of related terms into related terms.** -/
theorem subst {n m : Nat} {t t' : Tm Head n} (same : UpToHeads rel t t') {σ σ' : Sub Head n m}
    (pointwise : ∀ i, UpToHeads rel (σ i) (σ' i)) :
    UpToHeads rel (Presentation.subst σ t) (Presentation.subst σ' t') := by
  induction same generalizing m with
  | var i => exact pointwise i
  | const c => exact .const c
  | head e => exact .head e
  | pi _ _ ihA ihB => exact .pi (ihA pointwise) (ihB (liftSub_pointwise pointwise))
  | sigma _ _ ihA ihB => exact .sigma (ihA pointwise) (ihB (liftSub_pointwise pointwise))
  | id _ _ _ ihA iha ihb => exact .id (ihA pointwise) (iha pointwise) (ihb pointwise)
  | lam _ ih => exact .lam (ih (liftSub_pointwise pointwise))
  | app _ _ ihf iha => exact .app (ihf pointwise) (iha pointwise)
  | pair _ _ iha ihb => exact .pair (iha pointwise) (ihb pointwise)
  | fst _ ih => exact .fst (ih pointwise)
  | snd _ ih => exact .snd (ih pointwise)
  | refl _ ih => exact .refl (ih pointwise)

theorem subst0_pointwise {n : Nat} {a a' : Tm Head n} (same : UpToHeads rel a a') :
    ∀ i, UpToHeads rel (subst0 a i) (subst0 a' i) := by
  intro i
  refine Fin.cases ?_ (fun j => ?_) i
  · simpa only [subst0, Fin.cases_zero] using same
  · simp only [subst0, Fin.cases_succ]
    exact .var j

/-- **A term equal up to heads to a term without heads is that term.** -/
theorem eq_of_headFree {n : Nat} {t t' : Tm Head n} (same : UpToHeads rel t t') (free : HeadFree t') :
    t = t' := by
  induction same with
  | var i => rfl
  | const c => rfl
  | head _ => exact free.elim
  | pi _ _ ihA ihB => rw [ihA free.1, ihB free.2]
  | sigma _ _ ihA ihB => rw [ihA free.1, ihB free.2]
  | id _ _ _ ihA iha ihb => rw [ihA free.1, iha free.2.1, ihb free.2.2]
  | lam _ ih => rw [ih free]
  | app _ _ ihf iha => rw [ihf free.1, iha free.2]
  | pair _ _ iha ihb => rw [iha free.1, ihb free.2]
  | fst _ ih => rw [ih free]
  | snd _ ih => rw [ih free]
  | refl _ ih => rw [ih free]

end UpToHeads

/-! ## Left sides are matched up to heads -/

section Matching

variable {rel : Head → Head → Prop}

/-- Two halves of a linear application, matched separately, combined. -/
theorem join_app {m n : Nat} {function argument : Tm Head m} (linear : LeftLinear (.app function argument))
    {σ' first second : Sub Head m n}
    (firstRel : ∀ i, 0 < variableMultiplicity i function → UpToHeads rel (first i) (σ' i))
    (secondRel : ∀ i, 0 < variableMultiplicity i argument → UpToHeads rel (second i) (σ' i))
    (secondRest : ∀ i, variableMultiplicity i argument = 0 → second i = σ' i) :
    Tm.app (Presentation.subst first function) (Presentation.subst second argument) =
        Presentation.subst (join first second function) (.app function argument) ∧
      (∀ i, 0 < variableMultiplicity i (.app function argument) →
        UpToHeads rel (join first second function i) (σ' i)) ∧
      (∀ i, variableMultiplicity i (.app function argument) = 0 → join first second function i = σ' i) := by
  refine ⟨?_, ?_, ?_⟩
  · simp only [Presentation.subst]
    congr 1
    · exact subst_congr_occurring function (fun index occurs => by
        simp only [join, occurs, ite_true])
    · exact subst_congr_occurring argument (fun index occurs => by
        have := linear index
        simp only [variableMultiplicity] at this
        have missing : variableMultiplicity index function = 0 := by omega
        simp only [join, missing, lt_self_iff_false, ite_false])
  · intro index occurs
    simp only [variableMultiplicity] at occurs
    by_cases inFunction : 0 < variableMultiplicity index function
    · simpa only [join, inFunction, ite_true] using firstRel index inFunction
    · have inArgument : 0 < variableMultiplicity index argument := by omega
      simpa only [join, inFunction, ite_false] using secondRel index inArgument
  · intro index missing
    simp only [variableMultiplicity] at missing
    have functionZero : variableMultiplicity index function = 0 := by omega
    have argumentZero : variableMultiplicity index argument = 0 := by omega
    simp only [join, functionZero, lt_self_iff_false, ite_false]
    exact secondRest index argumentZero

/-- **A term equal up to heads to an instance of a pattern is an instance of the pattern**, at a
substitution related pointwise to the given one. -/
theorem match_pattern {defined : DeclName → Prop} {m : Nat} {flag : Bool} {term : Tm Head m}
    (pattern : Pattern defined flag term) (linear : LeftLinear term) {n : Nat} {σ' : Sub Head m n} :
    ∀ {t : Tm Head n}, UpToHeads rel t (Presentation.subst σ' term) →
      ∃ σ : Sub Head m n, t = Presentation.subst σ term ∧
        (∀ i, 0 < variableMultiplicity i term → UpToHeads rel (σ i) (σ' i)) ∧
        (∀ i, variableMultiplicity i term = 0 → σ i = σ' i) := by
  induction pattern with
  | var candidate =>
      intro t same
      simp only [Presentation.subst] at same
      refine ⟨fun index => if index = candidate then t else σ' index, by simp [Presentation.subst], ?_, ?_⟩
      · intro index occurs
        simp only [variableMultiplicity] at occurs
        split at occurs
        · rename_i equal
          subst equal
          simpa only [ite_true] using same
        · omega
      · intro index missing
        simp only [variableMultiplicity] at missing
        split at missing
        · omega
        · rename_i different
          show (if index = candidate then t else σ' index) = σ' index
          rw [if_neg (fun (equal : index = candidate) => different equal.symm)]
  | const constructor =>
      intro t same
      simp only [Presentation.subst] at same
      cases same
      exact ⟨σ', rfl, fun index occurs => by simp only [variableMultiplicity] at occurs; omega,
        fun _ _ => rfl⟩
  | @app _ function argument functionPattern argumentPattern functionIH argumentIH =>
      intro t same
      have functionLinear : LeftLinear function := fun index => by
        have := linear index; simp only [variableMultiplicity] at this; omega
      have argumentLinear : LeftLinear argument := fun index => by
        have := linear index; simp only [variableMultiplicity] at this; omega
      simp only [Presentation.subst] at same
      cases same with
      | app sameF sameA =>
          obtain ⟨first, rfl, firstRel, -⟩ := functionIH functionLinear sameF
          obtain ⟨second, rfl, secondRel, secondRest⟩ := argumentIH argumentLinear sameA
          exact ⟨join first second function, join_app linear firstRel secondRel secondRest⟩
  | @refl inner innerPattern innerIH =>
      intro t same
      have innerLinear : LeftLinear inner := fun index => by
        have := linear index; simp only [variableMultiplicity] at this; omega
      simp only [Presentation.subst] at same
      cases same with
      | refl sameInner =>
          obtain ⟨σ, rfl, related, rest⟩ := innerIH innerLinear sameInner
          exact ⟨σ, rfl, fun index occurs => related index (by simpa only [variableMultiplicity] using occurs),
            fun index missing => rest index (by simpa only [variableMultiplicity] using missing)⟩

/-- **A term equal up to heads to an instance of a left side is an instance of the left side.** -/
theorem match_leftSide {defined : DeclName → Prop} {m : Nat} {term : Tm Head m} {name : DeclName}
    {count : Nat} (side : LeftSide defined term name count) (linear : LeftLinear term) {n : Nat}
    {σ' : Sub Head m n} :
    ∀ {t : Tm Head n}, UpToHeads rel t (Presentation.subst σ' term) →
      ∃ σ : Sub Head m n, t = Presentation.subst σ term ∧
        (∀ i, 0 < variableMultiplicity i term → UpToHeads rel (σ i) (σ' i)) ∧
        (∀ i, variableMultiplicity i term = 0 → σ i = σ' i) := by
  induction side with
  | const _ =>
      intro t same
      simp only [Presentation.subst] at same
      cases same
      exact ⟨σ', rfl, fun index occurs => by simp only [variableMultiplicity] at occurs; omega,
        fun _ _ => rfl⟩
  | @app function argument name count functionSide argumentPattern functionIH =>
      intro t same
      have functionLinear : LeftLinear function := fun index => by
        have := linear index; simp only [variableMultiplicity] at this; omega
      have argumentLinear : LeftLinear argument := fun index => by
        have := linear index; simp only [variableMultiplicity] at this; omega
      simp only [Presentation.subst] at same
      cases same with
      | app sameF sameA =>
          obtain ⟨first, rfl, firstRel, -⟩ := functionIH functionLinear sameF
          obtain ⟨second, rfl, secondRel, secondRest⟩ := match_pattern argumentPattern argumentLinear sameA
          exact ⟨join first second function, join_app linear firstRel secondRel secondRest⟩

end Matching

/-! ## Directed steps are matched up to heads -/

section Simulation

variable {R : Rules Head} {rel : Head → Head → Prop}

/-- **Every directed step of a term is matched, up to heads, by a directed step of every term equal to
it up to heads**, in a constructor presentation: β and the projections look at no head, and neither do
the rows. -/
theorem simulate (equations : ConstructorPresentation R) (reflexive : ∀ h, rel h h) {n : Nat}
    {t' u' : Tm Head n} (step : StrongNormalization.Reduces R t' u') :
    ∀ {t : Tm Head n}, UpToHeads rel t t' →
      ∃ u, StrongNormalization.Reduces R t u ∧ UpToHeads rel u u' := by
  induction step with
  | betaPi body a =>
      intro t same
      cases same with
      | app sameF sameA =>
          cases sameF with
          | lam sameBody => exact ⟨_, .betaPi _ _, sameBody.subst (UpToHeads.subst0_pointwise sameA)⟩
  | betaSigmaFst a b =>
      intro t same
      cases same with
      | fst sameP => cases sameP with | pair sameA _ => exact ⟨_, .betaSigmaFst _ _, sameA⟩
  | betaSigmaSnd a b =>
      intro t same
      cases same with
      | snd sameP => cases sameP with | pair _ sameB => exact ⟨_, .betaSigmaSnd _ _, sameB⟩
  | head impossible => exact impossible.elim
  | root h =>
      intro t same
      obtain ⟨arity, left, right, σ', rule, rfl, rfl⟩ := equations.presentation.cover h
      have rule' := (equations.same left right).mp rule
      obtain ⟨name, -, -, side⟩ := equations.system.left rule'
      obtain ⟨σ, rfl, occurring, missing⟩ := match_leftSide side (equations.system.linear rule') same
      refine ⟨_, .root (equations.presentation.sound rule σ), (UpToHeads.self reflexive right).subst ?_⟩
      intro i
      by_cases occurs : 0 < variableMultiplicity i left
      · exact occurring i occurs
      · rw [missing i (by omega)]
        exact UpToHeads.self reflexive _
  | congPiDom _ ih =>
      intro t same
      cases same with
      | pi sameA sameB =>
          obtain ⟨u, step, related⟩ := ih sameA
          exact ⟨_, .congPiDom step, .pi related sameB⟩
  | congPiCod _ ih =>
      intro t same
      cases same with
      | pi sameA sameB =>
          obtain ⟨u, step, related⟩ := ih sameB
          exact ⟨_, .congPiCod step, .pi sameA related⟩
  | congSigmaDom _ ih =>
      intro t same
      cases same with
      | sigma sameA sameB =>
          obtain ⟨u, step, related⟩ := ih sameA
          exact ⟨_, .congSigmaDom step, .sigma related sameB⟩
  | congSigmaCod _ ih =>
      intro t same
      cases same with
      | sigma sameA sameB =>
          obtain ⟨u, step, related⟩ := ih sameB
          exact ⟨_, .congSigmaCod step, .sigma sameA related⟩
  | congIdTy _ ih =>
      intro t same
      cases same with
      | id sameA sameL sameR =>
          obtain ⟨u, step, related⟩ := ih sameA
          exact ⟨_, .congIdTy step, .id related sameL sameR⟩
  | congIdLeft _ ih =>
      intro t same
      cases same with
      | id sameA sameL sameR =>
          obtain ⟨u, step, related⟩ := ih sameL
          exact ⟨_, .congIdLeft step, .id sameA related sameR⟩
  | congIdRight _ ih =>
      intro t same
      cases same with
      | id sameA sameL sameR =>
          obtain ⟨u, step, related⟩ := ih sameR
          exact ⟨_, .congIdRight step, .id sameA sameL related⟩
  | congLam _ ih =>
      intro t same
      cases same with
      | lam sameBody =>
          obtain ⟨u, step, related⟩ := ih sameBody
          exact ⟨_, .congLam step, .lam related⟩
  | congAppFun _ ih =>
      intro t same
      cases same with
      | app sameF sameA =>
          obtain ⟨u, step, related⟩ := ih sameF
          exact ⟨_, .congAppFun step, .app related sameA⟩
  | congAppArg _ ih =>
      intro t same
      cases same with
      | app sameF sameA =>
          obtain ⟨u, step, related⟩ := ih sameA
          exact ⟨_, .congAppArg step, .app sameF related⟩
  | congPairFst _ ih =>
      intro t same
      cases same with
      | pair sameA sameB =>
          obtain ⟨u, step, related⟩ := ih sameA
          exact ⟨_, .congPairFst step, .pair related sameB⟩
  | congPairSnd _ ih =>
      intro t same
      cases same with
      | pair sameA sameB =>
          obtain ⟨u, step, related⟩ := ih sameB
          exact ⟨_, .congPairSnd step, .pair sameA related⟩
  | congFst _ ih =>
      intro t same
      cases same with
      | fst sameP =>
          obtain ⟨u, step, related⟩ := ih sameP
          exact ⟨_, .congFst step, .fst related⟩
  | congSnd _ ih =>
      intro t same
      cases same with
      | snd sameP =>
          obtain ⟨u, step, related⟩ := ih sameP
          exact ⟨_, .congSnd step, .snd related⟩
  | congRefl _ ih =>
      intro t same
      cases same with
      | refl sameA =>
          obtain ⟨u, step, related⟩ := ih sameA
          exact ⟨_, .congRefl step, .refl related⟩

/-- **Directed normality is kept up to heads.** -/
theorem normal_upToHeads (equations : ConstructorPresentation R) (reflexive : ∀ h, rel h h)
    {n : Nat} {a b : Tm Head n} (normal : ContextualDependentExecutableJoin.Normal R a)
    (same : UpToHeads rel a b) : ContextualDependentExecutableJoin.Normal R b := by
  intro u step
  obtain ⟨_, step', -⟩ := simulate equations reflexive step same
  exact normal _ step'

/-- The heads of a head step: equal, or related by the head equality. -/
abbrev HeadStepRel (R : Rules Head) (h h' : Head) : Prop := h = h' ∨ R.headEq h h'

/-- **A full step is a directed step or a head step.** -/
theorem step_cases {n : Nat} {t u : Tm Head n} (step : StepCore R.computation R.headEq t u) :
    StrongNormalization.Reduces R t u ∨ UpToHeads (HeadStepRel R) t u := by
  have reflexive : ∀ h, HeadStepRel R h h := fun _ => .inl rfl
  induction step with
  | betaPi body a => exact .inl (.betaPi body a)
  | betaSigmaFst a b => exact .inl (.betaSigmaFst a b)
  | betaSigmaSnd a b => exact .inl (.betaSigmaSnd a b)
  | head e => exact .inr (.head (.inr e))
  | root h => exact .inl (.root h)
  | congPiDom _ ih =>
      rcases ih with step | same
      · exact .inl (.congPiDom step)
      · exact .inr (.pi same (UpToHeads.self reflexive _))
  | congPiCod _ ih =>
      rcases ih with step | same
      · exact .inl (.congPiCod step)
      · exact .inr (.pi (UpToHeads.self reflexive _) same)
  | congSigmaDom _ ih =>
      rcases ih with step | same
      · exact .inl (.congSigmaDom step)
      · exact .inr (.sigma same (UpToHeads.self reflexive _))
  | congSigmaCod _ ih =>
      rcases ih with step | same
      · exact .inl (.congSigmaCod step)
      · exact .inr (.sigma (UpToHeads.self reflexive _) same)
  | congIdTy _ ih =>
      rcases ih with step | same
      · exact .inl (.congIdTy step)
      · exact .inr (.id same (UpToHeads.self reflexive _) (UpToHeads.self reflexive _))
  | congIdLeft _ ih =>
      rcases ih with step | same
      · exact .inl (.congIdLeft step)
      · exact .inr (.id (UpToHeads.self reflexive _) same (UpToHeads.self reflexive _))
  | congIdRight _ ih =>
      rcases ih with step | same
      · exact .inl (.congIdRight step)
      · exact .inr (.id (UpToHeads.self reflexive _) (UpToHeads.self reflexive _) same)
  | congLam _ ih =>
      rcases ih with step | same
      · exact .inl (.congLam step)
      · exact .inr (.lam same)
  | congAppFun _ ih =>
      rcases ih with step | same
      · exact .inl (.congAppFun step)
      · exact .inr (.app same (UpToHeads.self reflexive _))
  | congAppArg _ ih =>
      rcases ih with step | same
      · exact .inl (.congAppArg step)
      · exact .inr (.app (UpToHeads.self reflexive _) same)
  | congPairFst _ ih =>
      rcases ih with step | same
      · exact .inl (.congPairFst step)
      · exact .inr (.pair same (UpToHeads.self reflexive _))
  | congPairSnd _ ih =>
      rcases ih with step | same
      · exact .inl (.congPairSnd step)
      · exact .inr (.pair (UpToHeads.self reflexive _) same)
  | congFst _ ih =>
      rcases ih with step | same
      · exact .inl (.congFst step)
      · exact .inr (.fst same)
  | congSnd _ ih =>
      rcases ih with step | same
      · exact .inl (.congSnd step)
      · exact .inr (.snd same)
  | congRefl _ ih =>
      rcases ih with step | same
      · exact .inl (.congRefl step)
      · exact .inr (.refl same)

/-- **A full reduction is a directed reduction followed by head steps**: every full reduct is equal up to
heads to a directed reduct, for every reflexive, transitive relation containing the head equality. -/
theorem simulate_stepStar (equations : ConstructorPresentation R) (reflexive : ∀ h, rel h h)
    (compose : ∀ a b c, rel a b → rel b c → rel a c) (heads : ∀ h h', R.headEq h h' → rel h h')
    {n : Nat} {t c : Tm Head n} (steps : StepStar R t c) :
    ∃ s, StrongNormalization.ReducesStar R t s ∧ UpToHeads rel s c := by
  induction steps with
  | refl => exact ⟨t, .refl, UpToHeads.self reflexive t⟩
  | tail _ step ih =>
      obtain ⟨s, ts, sc⟩ := ih
      rcases step_cases step with directed | same
      · obtain ⟨s', step', related⟩ := simulate equations reflexive directed sc
        exact ⟨s', ts.tail step', related⟩
      · refine ⟨s, ts, sc.trans compose (same.mono ?_)⟩
        intro h h' e
        rcases e with rfl | e
        · exact reflexive h
        · exact heads _ _ e

end Simulation

/-! ## The two notions of answer -/

section Relation

variable {R : Rules Head}

/-- **Every answer of the full reduction without heads is an answer**, in every constructor
presentation. -/
theorem directedAnswer_of_answer (equations : ConstructorPresentation R) {n : Nat} {t v : Tm Head n}
    (answer : Answer R t v) (free : HeadFree v) : DirectedAnswer R t v := by
  obtain ⟨s, ts, sv⟩ := simulate_stepStar (rel := fun _ _ => True) equations (fun _ => trivial)
    (fun _ _ _ _ _ => trivial) (fun _ _ _ => trivial) answer.1
  rw [sv.eq_of_headFree free] at ts
  exact ⟨ts, directedNormal_of_normal answer.2⟩

/-- **The answers of the full reduction are exactly the answers without heads**, in every constructor
presentation whose heads are related to themselves. Both hypotheses are needed: without the first,
`Inspecting.separates`; without the second, `directed_control`. -/
theorem answer_iff_headFree (equations : ConstructorPresentation R) (reflexive : ∀ h, R.headEq h h)
    {n : Nat} {t v : Tm Head n} : Answer R t v ↔ DirectedAnswer R t v ∧ HeadFree v :=
  ⟨fun answer => ⟨directedAnswer_of_answer equations answer (headFree_of_answer reflexive answer),
      headFree_of_answer reflexive answer⟩,
    fun ⟨answer, free⟩ => answer.answer free⟩

/-- From a directed normal form, the full reduction takes only head steps, and keeps directed
normality. -/
theorem headSteps_of_normal (equations : ConstructorPresentation R) {n : Nat} {v w : Tm Head n}
    (normal : ContextualDependentExecutableJoin.Normal R v) (steps : StepStar R v w) :
    ContextualDependentExecutableJoin.Normal R w ∧ HeadCongruent R v w := by
  have reflexive : ∀ h, Relation.EqvGen R.headEq h h := fun h => .refl h
  induction steps with
  | refl => exact ⟨normal, UpToHeads.self reflexive v⟩
  | tail _ step ih =>
      obtain ⟨normalC, related⟩ := ih
      rcases step_cases step with directed | same
      · exact (normalC _ directed).elim
      · have same' : HeadCongruent R _ _ := same.mono fun _ _ e => by
          rcases e with rfl | e
          · exact .refl _
          · exact .rel _ _ e
        exact ⟨normal_upToHeads equations reflexive normalC same',
          related.trans (fun _ _ _ first second => .trans _ _ _ first second) same'⟩

/-- **The conversion reading, up to heads**: every directed normal form convertible with a call is
head-congruent to the call's answer, which exists. -/
theorem directedAnswer_of_conv (equations : ConstructorPresentation R) {n : Nat} {t v : Tm Head n}
    (conversion : Conv R.headEq t v R.computation) (normal : ContextualDependentExecutableJoin.Normal R v) :
    ∃ s, DirectedAnswer R t s ∧ HeadCongruent R s v := by
  have reflexive : ∀ h, Relation.EqvGen R.headEq h h := fun h => .refl h
  have compose : ∀ a b c, Relation.EqvGen R.headEq a b → Relation.EqvGen R.headEq b c →
      Relation.EqvGen R.headEq a c := fun _ _ _ first second => .trans _ _ _ first second
  have flip : ∀ a b, Relation.EqvGen R.headEq a b → Relation.EqvGen R.headEq b a :=
    fun _ _ e => .symm _ _ e
  obtain ⟨w, tw, vw⟩ := equations.churchRosser conversion
  obtain ⟨normalW, vw'⟩ := headSteps_of_normal equations normal vw
  obtain ⟨s, ts, sw⟩ := simulate_stepStar equations reflexive compose (fun _ _ e => .rel _ _ e) tw
  exact ⟨s, ⟨ts, normal_upToHeads equations reflexive normalW (sw.symm flip)⟩,
    sw.trans compose (vw'.symm flip)⟩

/-- **Two convertible directed normal forms are head-congruent.** -/
theorem headCongruent_of_conv (equations : ConstructorPresentation R) {n : Nat} {v v' : Tm Head n}
    (normal : ContextualDependentExecutableJoin.Normal R v)
    (normal' : ContextualDependentExecutableJoin.Normal R v')
    (conversion : Conv R.headEq v v' R.computation) : HeadCongruent R v v' := by
  obtain ⟨s, answer, related⟩ := directedAnswer_of_conv equations conversion normal'
  have same : s = v := ContextualDependentExecutableJoin.Normal.star_eq normal answer.1
  subst same
  exact related

/-- **Literally equal when one of them has no head.** -/
theorem eq_of_conv_headFree (equations : ConstructorPresentation R) {n : Nat} {v v' : Tm Head n}
    (normal : ContextualDependentExecutableJoin.Normal R v)
    (normal' : ContextualDependentExecutableJoin.Normal R v')
    (conversion : Conv R.headEq v v' R.computation) (free : HeadFree v') : v = v' :=
  (headCongruent_of_conv equations normal normal' conversion).eq_of_headFree free

end Relation

/-! ## Controls in the vectors package -/

section Vectors

open TowerVectorsModel (U0)
open TowerNumbersModel (u)

variable (lv : Mettapedia.TypeTheory.UniverseLevel.LevelExpr Nat)

/-- The sort whose level is `max 0 0`. -/
abbrev U0max {n : Nat} : Tm Tower.Head n := .head (.sort (.max (.const 0) (.const 0)))

/-- A head is a directed normal form: no row starts at it and heads take no directed step. -/
theorem head_normal {n : Nat} (h : Tower.Head) :
    ContextualDependentExecutableJoin.Normal (TowerVectorsModel.rules lv) (.head h : Tower.Tm n) := by
  intro target step
  cases step with
  | head impossible => exact impossible
  | root root => exact (Vectors.vectorConstructors lv).no_root_of_spineHead root rfl

/-- Every head of the tower is related to itself. -/
theorem heads_reflexive (h : Tower.Head) : (TowerVectorsModel.rules lv).headEq h h := by
  cases h with
  | legacyGround => trivial
  | sort level => exact fun _ => rfl

/-- **The universe and the sort of level `max 0 0`**: `U₀` is its own answer, typed at `U₁`; the second
sort is a directed normal form convertible with `U₀`, head-congruent to it and not equal, and not an
answer of `U₀`. -/
theorem u0_controls :
    DirectedAnswer (TowerVectorsModel.rules lv) (U0 : Tower.Tm 0) U0 ∧
      Typed (TowerVectorsModel.rules lv) .nil (U0 : Tower.Tm 0) (.head (.sort (.succ (.const 0)))) ∧
      ContextualDependentExecutableJoin.Normal (TowerVectorsModel.rules lv) (U0max : Tower.Tm 0) ∧
      Conv (TowerVectorsModel.rules lv).headEq (U0 : Tower.Tm 0) U0max (TowerVectorsModel.rules lv).computation ∧
      HeadCongruent (TowerVectorsModel.rules lv) (U0 : Tower.Tm 0) U0max ∧
      (U0 : Tower.Tm 0) ≠ U0max ∧ ¬ DirectedAnswer (TowerVectorsModel.rules lv) (U0 : Tower.Tm 0) U0max := by
  have related : (TowerVectorsModel.rules lv).headEq u (.sort (.max (.const 0) (.const 0))) := by
    intro v
    simp [Mettapedia.TypeTheory.UniverseLevel.LevelExpr.eval]
  have answer : DirectedAnswer (TowerVectorsModel.rules lv) (U0 : Tower.Tm 0) U0 := .self (head_normal lv _)
  refine ⟨answer, (TowerVectorsModel.vecDeclared_rules lv).tower.u0_typed, head_normal lv _,
    .rel _ _ (.head related), .head (.rel _ _ related), by decide, fun other => ?_⟩
  have same := DirectedAnswer.unique (Vectors.vectorConstructors lv) answer other
  exact absurd same (by decide)

/-- Head congruence keeps the shape: the universe is not head-congruent to the numbers. -/
theorem u0_not_congruent_num :
    ¬ HeadCongruent (TowerVectorsModel.rules lv) (U0 : Tower.Tm 0) TowerVectorsModel.numC := by
  intro same
  cases same

/-- **`U₀` has no answer of the full reduction**: such an answer would have no head and be an answer,
and the only answer of `U₀` is `U₀`. -/
theorem u0_no_answer : ¬ ∃ v, Answer (TowerVectorsModel.rules lv) (U0 : Tower.Tm 0) v := by
  rintro ⟨v, answer⟩
  have free := headFree_of_answer (heads_reflexive lv) answer
  have same := DirectedAnswer.unique (Vectors.vectorConstructors lv)
    (directedAnswer_of_answer (Vectors.vectorConstructors lv) answer free) (u0_controls lv).1
  subst same
  exact free

/-- **With the head equality removed, the answers of the full reduction are the answers**: the full
reduction of that package is the directed reduction. -/
theorem answer_directed_iff {Head : Type} (R : Rules Head) {n : Nat} {t v : Tm Head n} :
    Answer (ContextualDependentExecutableJoin.directed R) t v ↔ DirectedAnswer R t v :=
  ⟨fun answer => ⟨answer.1, fun _ step => answer.2 step⟩,
    fun answer => ⟨answer.1, fun step => answer.2 _ step⟩⟩

/-- **The heads must be related to themselves**: the vectors package with its head equality removed is
a constructor presentation, no head of it is related to itself, `U₀` is an answer of its full reduction,
and `answer_iff_headFree`'s equivalence fails there. Of the two hypotheses only the second fails. -/
theorem directed_control :
    Nonempty (ConstructorPresentation
      (ContextualDependentExecutableJoin.directed (TowerVectorsModel.rules lv))) ∧
      ¬ (∀ h, (ContextualDependentExecutableJoin.directed (TowerVectorsModel.rules lv)).headEq h h) ∧
      Answer (ContextualDependentExecutableJoin.directed (TowerVectorsModel.rules lv)) (U0 : Tower.Tm 0) U0 ∧
      ¬ (Answer (ContextualDependentExecutableJoin.directed (TowerVectorsModel.rules lv)) (U0 : Tower.Tm 0) U0 ↔
        DirectedAnswer (ContextualDependentExecutableJoin.directed (TowerVectorsModel.rules lv))
            (U0 : Tower.Tm 0) U0 ∧ HeadFree (U0 : Tower.Tm 0)) := by
  have answer : Answer (ContextualDependentExecutableJoin.directed (TowerVectorsModel.rules lv))
      (U0 : Tower.Tm 0) U0 := (answer_directed_iff _).mpr (u0_controls lv).1
  refine ⟨⟨Eventually.directedPresentation (Vectors.vectorConstructors lv)⟩,
    fun reflexive => reflexive (.sort (.const 0)), answer, fun same => ?_⟩
  exact (same.mp answer).2

end Vectors

/-! ## A row that inspects a head -/

namespace Inspecting

/-- The constant inspected. -/
def fName : DeclName := .mkSimple "f"
/-- The constant returned. -/
def gName : DeclName := .mkSimple "g"

/-- One row, `f true ⟶ g`. -/
def row : RootComputation Bool where
  step := fun t u => t = .app (.const fName) (.head true) ∧ u = .const gName
  rename := by
    intro n m ρ left right step
    obtain ⟨rfl, rfl⟩ := step
    exact ⟨rfl, rfl⟩
  substitute := by
    intro n m σ left right step
    obtain ⟨rfl, rfl⟩ := step
    exact ⟨rfl, rfl⟩

/-- **The package**: heads `true` and `false`, every two of them equal, and the row `f true ⟶ g`. -/
def rules : Rules Bool where
  headTyping := fun _ _ => False
  isUniverse := fun _ => False
  join := fun _ _ _ => False
  cumulative := fun _ _ => False
  headEq := fun _ _ => True
  computation := row

/-- The call `f false`. -/
abbrev call : Tm Bool 0 := .app (.const fName) (.head false)

theorem g_normal : ConstructorSystem.Normal rules (.const gName : Tm Bool 0) := by
  intro target step
  cases step with
  | root h => cases h.1

theorem call_directedNormal : ContextualDependentExecutableJoin.Normal rules call := by
  intro target step
  cases step with
  | root h =>
      have := h.1
      simp only [Tm.app.injEq, Tm.head.injEq, true_and] at this
      cases this
  | congAppFun inner =>
      cases inner with
      | root h => cases h.1
  | congAppArg inner =>
      cases inner with
      | head impossible => exact impossible
      | root h => cases h.1

/-- **The row looks at a head, and the two notions separate**: `f false` answers `g` by the full
reduction (a head step, then the row), and `g` has no head; but `f false` is a directed normal form, so
`g` is not its answer. -/
theorem separates :
    Answer rules call (.const gName) ∧ HeadFree (.const gName : Tm Bool 0) ∧
      ¬ DirectedAnswer rules call (.const gName) := by
  refine ⟨⟨.tail (.single (.congAppArg (.head trivial))) (.root ⟨rfl, rfl⟩), g_normal⟩, trivial, ?_⟩
  intro answer
  have same := ContextualDependentExecutableJoin.Normal.star_eq call_directedNormal answer.1
  cases same

/-- **A row that inspects a head is outside the constructor systems.** -/
theorem not_constructorPresentation : ¬ Nonempty (ConstructorPresentation rules) := by
  rintro ⟨equations⟩
  exact separates.2.2 (directedAnswer_of_answer equations separates.1 separates.2.1)

/-- Every head of the package is related to itself: of the two hypotheses of `answer_iff_headFree` it
fails the constructor presentation only. -/
theorem reflexive : ∀ h, rules.headEq h h := fun _ => trivial

/-- **The declaration-time check rejects the row `f true ⟶ g`**: a head is no pattern. -/
theorem row_rejected :
    DeclarationCheck.checkTable (fun name => name == fName) (fun _ => 1)
      [⟨0, (.app (.const fName) (.head true), .const gName)⟩] = false := by
  decide +kernel

/-- **It accepts the row `f x ⟶ g`**, which differs only in the pattern. -/
theorem variable_row_accepted :
    DeclarationCheck.checkTable (fun name => name == fName) (fun _ => 1)
      ([⟨1, (.app (.const fName) (.var 0), .const gName)⟩] : AlgebraicSchema.SchemaTable Bool) = true := by
  decide +kernel

end Inspecting

