import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.NativeTypesOnTheStep.Comprehension
import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.UnificationWithLevels.ExactTransitions
import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.Step.DependentFullQueries

/-!
# The syntactic shadow of the comprehension: settling along a principal answer

The knowledge of the step compares terms by typed βη-equality, so it never tells apart two
solutions that agree on every judged term (`UnificationWithLevels.Agree`). A principal answer
`σ : M ⟶ Δ` of a store factors every solution only up to that agreement.

* **The sieve generated by σ** (`generated`) is the direct image of the whole representable of `M`
  along `y σ`: the substitutions that factor through `σ` on the nose. It is inside a predicate exactly
  when `σ` is (`generated_le_iff`): the adjunction between direct image and pullback of native type
  theory (Proposition 12 of Williams and Stay, `generated_le_iff_pullback`) together with Yoneda.
* **The agreement closure** of a predicate (`saturation`) adds every substitution agreeing with one
  of its members. The comprehension of a store is closed under it (`saturation_solutions`).
* **A principal answer represents the comprehension up to agreement** (`principal_iff`): `σ` is
  principal exactly when the comprehension is the agreement closure of the sieve generated by `σ`.
  An initial answer represents it on agreement classes (`initial_injective`, `Principal` for the
  surjection).
* **Settling decides every predicate up to agreement** (`le_saturation_iff_of_principal`): the
  comprehension lies in the agreement closure of a predicate exactly when the answer does.

For typing a made row this gives the exact relation between the two semantic rules and the settled
one (`typing` is the row's typing predicate, `Make.reindex` the row substituted along `σ`):

* typed at every solution (`TypedAfterMatch`) implies typed at the answer (`settled_complete`), that
  is the settled row is typed in the settled frame (`mem_typing_iff_reindex`);
* typed at the answer implies **typed up to agreement** (`settled_sound`): every solution agrees
  with one at which the row is typed. This is the rule the knowledge can see
  (`TypedUpToAgreement`), and for a principal answer it holds exactly when some representative of the
  answer types the row (`typedUpToAgreement_iff`);
* the two semantic rules coincide whenever the row's typing predicate is closed under agreement
  among solutions (`typedAfterMatch_iff_of_closed`), in particular for every row typed in its frame
  (`closed_of_wellTyped`). Whether raw typing is closed under agreement in general is a metatheorem
  of the package (subject reduction and confluence through normal forms); it is not assumed here.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting
namespace NativeTypesOnTheStep

open _root_.CategoryTheory Opposite Interface
open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
open TypedEquality TypedEquality.Normalization TypedContextual
open ContextualDependentEta
open Interface.DependentFull (Make)
open UnificationWithLevels (Agree InitialSolution)

variable {Head L : Type} [UniverseLevel.LevelOrder L] {rules : Rules Head}
variable (levels : LevelModel rules L)

/-! ## The sieve generated by a substitution -/

section Generated

/-- **The sieve generated by σ**: the direct image of the whole representable of `M` along `y σ`. -/
def generated {M Δ : Context rules} (σ : M ⟶ Δ) : Subfunctor (yoneda.obj Δ) :=
  (⊤ : Subfunctor (yoneda.obj M)).image (yoneda.map σ)

omit [UniverseLevel.LevelOrder L] in
theorem mem_generated {M Δ Θ : Context rules} (σ : M ⟶ Δ) (τ : Θ ⟶ Δ) :
    τ ∈ (generated σ).obj (op Θ) ↔ ∃ g : Θ ⟶ M, g ≫ σ = τ := by
  constructor
  · rintro ⟨g, -, rfl⟩
    exact ⟨g, rfl⟩
  · rintro ⟨g, rfl⟩
    exact Set.mem_image_of_mem _ (show g ∈ (⊤ : Subfunctor (yoneda.obj M)).obj (op Θ) from trivial)

omit [UniverseLevel.LevelOrder L] in
/-- **The generated sieve is inside a predicate exactly when σ is in it.** -/
theorem generated_le_iff {M Δ : Context rules} (σ : M ⟶ Δ) (P : Subfunctor (yoneda.obj Δ)) :
    generated σ ≤ P ↔ σ ∈ P.obj (op M) := by
  rw [generated, Subfunctor.image_le_iff]
  constructor
  · intro le
    have atIdentity := le (op M) (show 𝟙 M ∈ (⊤ : Subfunctor (yoneda.obj M)).obj (op M) from trivial)
    rw [← Category.id_comp σ]
    exact atIdentity
  · intro inside Θ g _
    exact P.map g.op inside

omit [UniverseLevel.LevelOrder L] in
/-- The same statement through the indexed adjunction of native type theory (Proposition 12):
direct image along `y σ` is left adjoint to pullback. -/
theorem generated_le_iff_pullback {M Δ : Context rules} (σ : M ⟶ Δ) (P : Subfunctor (yoneda.obj Δ)) :
    generated σ ≤ P ↔
      ⊤ ≤ (Mettapedia.GSLT.Topos.presheafChangeOfBase (Context rules)).pullback (yoneda.map σ) P :=
  (Mettapedia.OSLF.PresheafNativeType.prop12_indexedAdjoints (Context rules) (yoneda.map σ)).1 ⊤ P

end Generated

/-! ## Agreement closure -/

section Saturation

/-- **The agreement closure of a predicate**: the substitutions that agree, on every judged term,
with one of its members. -/
def saturation {Δ : Context rules} (P : Subfunctor (yoneda.obj Δ)) : Subfunctor (yoneda.obj Δ) where
  obj Θ := {τ | ∃ τ' ∈ P.obj Θ, Agree (frames levels) τ τ'}
  map g _ inside := by
    obtain ⟨τ', member, agree⟩ := inside
    exact Exists.intro (g.unop ≫ τ') ⟨P.map g member, agree.comp_left g.unop⟩

theorem mem_saturation {Δ Θ : Context rules} (P : Subfunctor (yoneda.obj Δ)) (τ : Θ ⟶ Δ) :
    τ ∈ (saturation levels P).obj (op Θ) ↔ ∃ τ' ∈ P.obj (op Θ), Agree (frames levels) τ τ' := Iff.rfl

theorem le_saturation {Δ : Context rules} (P : Subfunctor (yoneda.obj Δ)) : P ≤ saturation levels P :=
  fun _ τ member => Exists.intro τ ⟨member, Agree.refl (X := frames levels) τ⟩

theorem saturation_mono {Δ : Context rules} {P Q : Subfunctor (yoneda.obj Δ)} (le : P ≤ Q) :
    saturation levels P ≤ saturation levels Q := by
  intro Θ τ inside
  obtain ⟨τ', member, agree⟩ := inside
  exact Exists.intro τ' ⟨le Θ member, agree⟩

/-- The agreement closure is idempotent: agreement is transitive. -/
theorem saturation_saturation {Δ : Context rules} (P : Subfunctor (yoneda.obj Δ)) :
    saturation levels (saturation levels P) = saturation levels P := by
  refine le_antisymm ?_ (le_saturation levels _)
  intro Θ τ inside
  obtain ⟨τ', ⟨τ'', member, agree'⟩, agree⟩ := inside
  exact Exists.intro τ'' ⟨member, agree.trans agree'⟩

theorem saturation_le_saturation_iff {Δ : Context rules} (S P : Subfunctor (yoneda.obj Δ)) :
    saturation levels S ≤ saturation levels P ↔ S ≤ saturation levels P := by
  constructor
  · exact fun le => (le_saturation levels S).trans le
  · intro le
    exact (saturation_mono levels le).trans (saturation_saturation levels P).le

/-- **The comprehension of a store is closed under agreement**: agreeing substitutions solve the
same stores. -/
theorem saturation_solutions {Δ : Context rules} (I : EquationStore (TotalTerm Δ)) :
    saturation levels (solutions levels I) = solutions levels I := by
  refine le_antisymm ?_ (le_saturation levels _)
  intro Θ τ inside
  obtain ⟨τ', member, agree⟩ := inside
  exact (UnificationWithLevels.models_of_agree agree I).mpr member

end Saturation

/-! ## Principal answers represent the comprehension up to agreement -/

section Principal

/-- **A principal answer represents the comprehension up to agreement**: σ is principal exactly
when the comprehension of the store is the agreement closure of the sieve generated by σ. -/
theorem principal_iff {M Δ : Context rules} (I : EquationStore (TotalTerm Δ)) (σ : M ⟶ Δ) :
    (frames levels).Principal I σ ↔ solutions levels I = saturation levels (generated σ) := by
  constructor
  · intro principal
    apply le_antisymm
    · intro Θ τ solved
      obtain ⟨g, agree⟩ := principal.factors Θ.unop τ solved
      exact Exists.intro (g ≫ σ) ⟨(mem_generated σ (g ≫ σ)).mpr ⟨g, rfl⟩, agree⟩
    · intro Θ τ inside
      obtain ⟨τ', generatedBy, agree⟩ := inside
      obtain ⟨g, rfl⟩ := (mem_generated σ τ').mp generatedBy
      exact (UnificationWithLevels.models_of_agree agree I).mpr (Frames.models_comp principal.sound g)
  · intro same
    have self : σ ∈ (solutions levels I).obj (op M) := by
      rw [same]
      exact le_saturation levels _ (op M) ((mem_generated σ σ).mpr ⟨𝟙 M, Category.id_comp σ⟩)
    refine ⟨self, fun Θ τ solved => ?_⟩
    have inside : τ ∈ (saturation levels (generated σ)).obj (op Θ) := by
      rw [← same]
      exact solved
    obtain ⟨τ', generatedBy, agree⟩ := inside
    obtain ⟨g, rfl⟩ := (mem_generated σ τ').mp generatedBy
    exact ⟨g, agree⟩

/-- **An initial answer is injective on agreement classes**: two factors whose composites with the
answer agree, agree. With `Principal`, the map `g ↦ g ≫ σ` is a bijection from the agreement classes
of substitutions into `M` onto the agreement classes of solutions: `M` represents the comprehension. -/
theorem initial_injective {M Δ Θ : Context rules} {I : EquationStore (TotalTerm Δ)} {σ : M ⟶ Δ}
    (initial : InitialSolution (frames levels) I σ) (g h : Θ ⟶ M)
    (agree : Agree (frames levels) (g ≫ σ) (h ≫ σ)) : Agree (frames levels) g h :=
  initial.unique Θ (g ≫ σ) g h (Agree.refl _) agree

/-- A substitution agreeing with a principal answer is a principal answer. -/
theorem principal_of_agree {M Δ : Context rules} {I : EquationStore (TotalTerm Δ)} {σ σ' : M ⟶ Δ}
    (principal : (frames levels).Principal I σ) (agree : Agree (frames levels) σ σ') :
    (frames levels).Principal I σ' := by
  refine ⟨(UnificationWithLevels.models_of_agree agree I).mp principal.sound, fun Θ τ solved => ?_⟩
  obtain ⟨g, through⟩ := principal.factors Θ τ solved
  exact ⟨g, Agree.trans (X := frames levels) through (agree.comp_left g)⟩

/-- **Settling decides every predicate up to agreement**: the comprehension lies in the agreement
closure of a predicate exactly when the principal answer does. -/
theorem le_saturation_iff_of_principal {M Δ : Context rules} {I : EquationStore (TotalTerm Δ)}
    {σ : M ⟶ Δ} (principal : (frames levels).Principal I σ) (P : Subfunctor (yoneda.obj Δ)) :
    solutions levels I ≤ saturation levels P ↔ σ ∈ (saturation levels P).obj (op M) := by
  rw [(principal_iff levels I σ).mp principal, saturation_le_saturation_iff, generated_le_iff]

end Principal

/-! ## Typing a made row along the answer -/

section Typing

-- A made row substituted along a morphism of frames is `Interface.DependentFull.Make.reindex`,
-- defined in `Step.DependentFullQueries`; it is reused here, not redeclared.

omit [UniverseLevel.LevelOrder L] in
/-- **Typed at σ is the settled row typed in the settled frame.** -/
theorem mem_typing_iff_reindex {M Δ : Context rules} (m : Make Δ) (σ : M ⟶ Δ) :
    σ ∈ (typing m).obj (op M) ↔ (m.reindex σ).WellTyped := Iff.rfl

omit [UniverseLevel.LevelOrder L] in
/-- **The typing predicate commutes with substitution**: the typing predicate of the settled row is
the pullback of the typing predicate along `y σ`. -/
theorem typing_reindex {M Δ : Context rules} (m : Make Δ) (σ : M ⟶ Δ) :
    typing (m.reindex σ) = (typing m).preimage (yoneda.map σ) := by
  ext Θ g
  show Typed rules Θ.unop.raw (subst g.substitution (subst σ.substitution m.code))
      (subst g.substitution (subst σ.substitution m.type.code)) ↔
    Typed rules Θ.unop.raw (subst (g ≫ σ).substitution m.code) (subst (g ≫ σ).substitution m.type.code)
  rw [subst_subComp, subst_subComp]
  rfl

/-- **Typed after the match, up to agreement**: every solution of the information agrees with one at
which the row is typed. This is the rule the knowledge can see. -/
def TypedUpToAgreement {Δ : Context rules} (I : EquationStore (TotalTerm Δ)) (m : Make Δ) : Prop :=
  solutions levels I ≤ saturation levels (typing m)

/-- The rule of every solution implies the rule up to agreement. -/
theorem TypedAfterMatch.upToAgreement {Δ : Context rules} {I : EquationStore (TotalTerm Δ)}
    {m : Make Δ} (typed : TypedAfterMatch levels I m) : TypedUpToAgreement levels I m :=
  ((typedAfterMatch_iff_le levels I m).mp typed).trans (le_saturation levels _)

/-- **Settling is complete for the rule of every solution**: a row typed at every solution is typed
at the answer. -/
theorem settled_complete {M Δ : Context rules} {I : EquationStore (TotalTerm Δ)} {σ : M ⟶ Δ}
    (solves : (frames levels).Models σ I) {m : Make Δ} (typed : TypedAfterMatch levels I m) :
    (m.reindex σ).WellTyped :=
  (typedAfterMatch_iff_le levels I m).mp typed (op M) solves

/-- **Settling is sound for the rule up to agreement**: a row typed at a principal answer is typed,
at every solution, at an agreeing one; namely its factor through the answer. -/
theorem settled_sound {M Δ : Context rules} {I : EquationStore (TotalTerm Δ)} {σ : M ⟶ Δ}
    (principal : (frames levels).Principal I σ) {m : Make Δ} (typed : (m.reindex σ).WellTyped) :
    TypedUpToAgreement levels I m :=
  (le_saturation_iff_of_principal levels principal (typing m)).mpr
    ((le_saturation levels (typing m)) (op M) typed)

/-- **Up to agreement, the rule is decided at the answer**: for a principal answer, the row is typed
up to agreement exactly when some representative of the answer types it. -/
theorem typedUpToAgreement_iff {M Δ : Context rules} {I : EquationStore (TotalTerm Δ)} {σ : M ⟶ Δ}
    (principal : (frames levels).Principal I σ) (m : Make Δ) :
    TypedUpToAgreement levels I m ↔
      ∃ σ' : M ⟶ Δ, Agree (frames levels) σ σ' ∧ (m.reindex σ').WellTyped := by
  unfold TypedUpToAgreement
  rw [le_saturation_iff_of_principal levels principal]
  constructor
  · rintro ⟨σ', typed, agree⟩
    exact ⟨σ', agree, typed⟩
  · rintro ⟨σ', agree, typed⟩
    exact Exists.intro σ' ⟨typed, agree⟩

/-- The row's typing is **closed under agreement among solutions** when, of two agreeing
solutions, the row typed at one is typed at the other. -/
def ClosedUnderAgreement {Δ : Context rules} (I : EquationStore (TotalTerm Δ)) (m : Make Δ) : Prop :=
  ∀ (Θ : Context rules) (τ τ' : Θ ⟶ Δ), (frames levels).Models τ I → Agree (frames levels) τ τ' →
    τ' ∈ (typing m).obj (op Θ) → τ ∈ (typing m).obj (op Θ)

/-- **Where typing is closed under agreement the two semantic rules coincide.** -/
theorem typedAfterMatch_iff_of_closed {Δ : Context rules} {I : EquationStore (TotalTerm Δ)}
    {m : Make Δ} (closed : ClosedUnderAgreement levels I m) :
    TypedAfterMatch levels I m ↔ TypedUpToAgreement levels I m := by
  refine ⟨TypedAfterMatch.upToAgreement levels, fun typed => ?_⟩
  refine (typedAfterMatch_iff_le levels I m).mpr fun Θ τ solved => ?_
  obtain ⟨τ', typedThere, agree⟩ := typed Θ solved
  exact closed Θ.unop τ τ' solved agree typedThere

/-- **Settling along a principal answer is sound and complete** for a row whose typing is closed
under agreement: typed at the answer exactly when typed at every solution. -/
theorem settled_iff_of_closed {M Δ : Context rules} {I : EquationStore (TotalTerm Δ)} {σ : M ⟶ Δ}
    (principal : (frames levels).Principal I σ) {m : Make Δ} (closed : ClosedUnderAgreement levels I m) :
    (m.reindex σ).WellTyped ↔ TypedAfterMatch levels I m :=
  ⟨fun typed => (typedAfterMatch_iff_of_closed levels closed).mpr (settled_sound levels principal typed),
    settled_complete levels principal.sound⟩

/-- A row typed in its frame is typed along every substitution, so its typing is closed. -/
theorem closed_of_wellTyped {Δ : Context rules} (I : EquationStore (TotalTerm Δ)) {m : Make Δ}
    (typed : m.WellTyped) : ClosedUnderAgreement levels I m :=
  fun _ τ _ _ _ _ => typed.substitute τ.typed

/-- A row typed after the match has closed typing: every solution types it. -/
theorem closed_of_typedAfterMatch {Δ : Context rules} {I : EquationStore (TotalTerm Δ)} {m : Make Δ}
    (typed : TypedAfterMatch levels I m) : ClosedUnderAgreement levels I m :=
  fun Θ _ _ solved _ _ => (typedAfterMatch_iff_le levels I m).mp typed (op Θ) solved

end Typing

