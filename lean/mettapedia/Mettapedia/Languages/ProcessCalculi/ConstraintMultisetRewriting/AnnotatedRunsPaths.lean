import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.AnnotatedRunsRounds
import Mettapedia.GSLT.Causality.OccurrenceRealization

/-!
# Contextual traces of paths are the round equivalence of words

The run category of the candidate step has two presentations of its contextual traces.

* **On paths.** The arrows of `OccurrenceHistory.OccurrenceCat (presentation A label)` are paths
  of occurrences between configuration classes, and the contextual concurrency
  `AnnotatedRuns.concurrency` gives a tile system whose generated congruence is
  `EventConcurrency.TraceEq`. Its quotient is the category `ContextualTraces`.
* **On words.** `AnnotatedRuns.RoundEquiv A label C` is the equivalence on words of firings from
  one configuration generated by swaps of adjacent pairs that form a round where they stand.

The two agree exactly (`traceEq_iff_roundEquiv`): two paths from the class of `C` to one class
are trace equivalent exactly when their words of firings are round equivalent from `C`. Hence the
contextual trace category has, from the class of `C`, one arrow per round-equivalence class of
runs (`trace_eq_iff_roundEquiv`).

## Ingredients

* **A path is determined by its firings** (`path_ext`): the evidence of an occurrence is a
  proposition and its target is the firing's result, so two paths between the same classes with
  the same word of firings are equal.
* **A path is a run** (`target_eq`, `executable_of_path`): a path from the class of `C` ends at the
  class of the configuration its word leaves, and its word runs from `C` when `C` has a solution.
  Every run gives a path (`exists_path`).
* **The round equivalence is a congruence for concatenation** (`RoundEquiv.append_left`,
  `RoundEquiv.append_right`): a prefix moves the configuration at which later swaps are judged,
  a suffix is never judged.
* **The two tiles agree** (`route_sites`, `swapped_sites`): a tile of `concurrency` at a class is
  a round of two at a representative, and its two routes fire the two orders.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.AnnotatedRuns

open Mettapedia.GSLT
open Mettapedia.GSLT.Core.InteractionEvent
open Mettapedia.GSLT.Causality.OccurrenceHistory
open Mettapedia.GSLT.Causality.EventConcurrency (Concurrency)

universe uSite uEvent

variable {theory : GSLT} {P : InteractionPresentation.{uSite, uEvent} theory} (C : Concurrency P)

/-- The route of a tile fires its first event, then the residual of its second. -/
theorem pair_route_sites {s : theory.Term} (pair : C.Pair s) :
    OccurrencePath.sites (pair.route C) = [pair.first.site, pair.second.site] := by
  simp only [Concurrency.Pair.route, OccurrencePath.sites, Concurrency.occ, C.residual_site]

/-- A cast of the target keeps the firings of a path. -/
theorem sites_cast_target {s t t' : theory.Term} (same : t = t') (p : OccurrencePath P s t) :
    OccurrencePath.sites (same ▸ p : OccurrencePath P s t') = OccurrencePath.sites p := by
  subst same
  rfl

/-- The swapped route of a tile fires its second event, then the residual of its first. -/
theorem pair_swapped_sites {s : theory.Term} (pair : C.Pair s) :
    OccurrencePath.sites (pair.swapped C) = [pair.second.site, pair.first.site] := by
  unfold Concurrency.Pair.swapped
  rw [sites_cast_target]
  simp only [OccurrencePath.sites, Concurrency.occ, C.residual_site]

end Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.AnnotatedRuns

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.AnnotatedRuns

open Mettapedia.GSLT.Causality.OccurrenceHistory (Occurrence OccurrencePath)
open Mettapedia.GSLT.Causality.EventConcurrency (TraceEq Trace)
open GuardFreeProcessOrders (SameUpTo)

universe uT uS uO
variable {T : Type uT} {S : Type uS} {O : Type uO} [DecidableEq O]

section Paths

variable (A : SubstitutionAction T S) (label : O → T)

/-- The class of a configuration, as an object of the run category. -/
def classOf (C : Configuration T O) : (theory A label).Term := ConfigurationClass.mk A C

/-- The class a firing leaves, as an object of the run category. -/
theorem resultClass_classOf (f : Firing T S O) (C : Configuration T O) :
    (f.resultClass A label (classOf A label C) : (theory A label).Term) =
      classOf A label (f.result label C) := rfl

/-- **A path of the run category is determined by its firings.** The evidence of each occurrence
is a proposition, and its target is the result of its firing. -/
theorem path_ext {x y : (theory A label).Term}
    (p q : OccurrencePath (presentation A label) x y)
    (same : OccurrencePath.sites p = OccurrencePath.sites q) : p = q := by
  induction p with
  | refl t =>
      cases q with
      | refl => rfl
      | cons o rest => exact absurd same (List.cons_ne_nil _ _).symm
  | cons o rest ih =>
      cases q with
      | refl => exact absurd same (List.cons_ne_nil _ _)
      | cons o' rest' =>
          obtain ⟨f, ⟨⟨_, fTarget⟩⟩⟩ := o
          obtain ⟨g, ⟨⟨_, gTarget⟩⟩⟩ := o'
          obtain ⟨rfl, sameRest⟩ := List.cons.inj same
          subst fTarget
          subst gTarget
          obtain rfl := ih rest' sameRest
          rfl

/-- **A path from the class of `C` ends where its firings leave `C`.** -/
theorem target_eq {x y : (theory A label).Term}
    (p : OccurrencePath (presentation A label) x y) :
    ∀ C : Configuration T O, classOf A label C = x →
      y = classOf A label (follow label C (OccurrencePath.sites p)) := by
  induction p with
  | refl t => exact fun _ source => source.symm
  | cons o rest ih =>
      intro C source
      obtain ⟨f, ⟨⟨_, fTarget⟩⟩⟩ := o
      subst source
      exact ih (f.result label C) fTarget.symm

/-- **A path from the class of `C` is a run from `C`**, when `C` has a solution. -/
theorem executable_of_path {x y : (theory A label).Term}
    (p : OccurrencePath (presentation A label) x y) :
    ∀ C : Configuration T O, classOf A label C = x → A.Consistent C.equations →
      Executable A label C (OccurrencePath.sites p) := by
  induction p with
  | refl t => exact fun _ _ consistent => consistent
  | cons o rest ih =>
      intro C source _
      obtain ⟨f, ⟨⟨fValid, fTarget⟩⟩⟩ := o
      subst source
      have valid : f.Valid A label C := fValid
      exact ⟨valid, ih (f.result label C) fTarget.symm valid.firing.consistent⟩

/-- No firing leaves a configuration without solutions, so its only path is empty. -/
theorem sites_eq_nil_of_inconsistent {x y : (theory A label).Term}
    (p : OccurrencePath (presentation A label) x y) (C : Configuration T O)
    (source : classOf A label C = x) (inconsistent : ¬ A.Consistent C.equations) :
    OccurrencePath.sites p = [] := by
  cases p with
  | refl => rfl
  | cons o _ =>
      obtain ⟨f, ⟨⟨fValid, _⟩⟩⟩ := o
      subst source
      have valid : f.Valid A label C := fValid
      obtain ⟨σ, solved⟩ := valid.firing.consistent
      exact absurd ⟨σ, valid.firing.refines σ solved⟩ inconsistent

/-- **Every run is a path**, to any class equal to the class of the configuration it leaves. -/
theorem exists_path : ∀ (C : Configuration T O) (w : List (Firing T S O)),
    Executable A label C w → ∀ y : (theory A label).Term,
      classOf A label (follow label C w) = y →
        ∃ p : OccurrencePath (presentation A label) (classOf A label C) y,
          OccurrencePath.sites p = w
  | C, [], _, y, target => by
      subst target
      exact ⟨.refl _, rfl⟩
  | C, f :: rest, ⟨valid, later⟩, y, target => by
      obtain ⟨p, sites⟩ := exists_path (f.result label C) rest later y target
      exact ⟨.cons ⟨f, ⟨⟨valid, rfl⟩⟩⟩ p, congrArg (List.cons f) sites⟩

/-- A path splits wherever its word of firings does. -/
theorem split {x y : (theory A label).Term}
    (p : OccurrencePath (presentation A label) x y) :
    ∀ (u z : List (Firing T S O)), OccurrencePath.sites p = u ++ z →
      ∃ (m : (theory A label).Term) (first : OccurrencePath (presentation A label) x m)
        (second : OccurrencePath (presentation A label) m y),
        p = OccurrencePath.append first second ∧ OccurrencePath.sites first = u ∧
          OccurrencePath.sites second = z := by
  induction p with
  | refl t =>
      intro u z same
      cases u with
      | nil => exact ⟨t, .refl t, .refl t, rfl, rfl, same⟩
      | cons f u => exact absurd same (List.cons_ne_nil _ _).symm
  | @cons x m y o rest ih =>
      intro u z same
      cases u with
      | nil => exact ⟨x, .refl x, .cons o rest, rfl, rfl, same⟩
      | cons f u =>
          obtain ⟨head, tail⟩ := List.cons.inj same
          obtain ⟨m', first, second, rfl, firstSites, secondSites⟩ := ih u z tail
          exact ⟨m', .cons o first, second, rfl,
            (congrArg₂ List.cons head firstSites : _), secondSites⟩

end Paths

/-! ## The round equivalence is a congruence for concatenation -/

section Congruence

variable (A : SubstitutionAction T S) (label : O → T)

/-- **A prefix moves the configuration** at which later swaps are judged. -/
theorem RoundEquiv.append_left : ∀ (C : Configuration T O) (u : List (Firing T S O))
    {w w' : List (Firing T S O)},
    RoundEquiv A label (follow label C u) w w' → RoundEquiv A label C (u ++ w) (u ++ w')
  | _, [], _, _, equivalent => equivalent
  | C, f :: u, _, _, equivalent =>
      RoundEquiv.cons A label (RoundEquiv.append_left (f.result label C) u equivalent)

theorem roundSwap_append_right {C : Configuration T O} {w w' : List (Firing T S O)}
    (swapped : RoundSwap A label C w w') (z : List (Firing T S O)) :
    RoundSwap A label C (w ++ z) (w' ++ z) := by
  cases swapped with
  | swap u v f g isRound =>
      simpa [List.append_assoc] using RoundSwap.swap u (v ++ z) f g isRound

/-- **A suffix is never judged**: round equivalence survives appending any word. -/
theorem RoundEquiv.append_right {C : Configuration T O} {w w' : List (Firing T S O)}
    (equivalent : RoundEquiv A label C w w') (z : List (Firing T S O)) :
    RoundEquiv A label C (w ++ z) (w' ++ z) := by
  induction equivalent with
  | rel _ _ swapped => exact .rel _ _ (roundSwap_append_right A label swapped z)
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

end Congruence

/-! ## The tiles of the contextual concurrency -/

section Tiles

variable (A : SubstitutionAction T S) (label : O → T)

/-- The route of a tile fires its first firing, then its second. -/
theorem route_sites {x : (theory A label).Term} (pair : (concurrency A label).Pair x) :
    OccurrencePath.sites ((concurrency A label).tiles.route pair) =
      [pair.first.site, pair.second.site] :=
  pair_route_sites (concurrency A label) pair

/-- The swapped route of a tile fires its second firing, then its first. -/
theorem swapped_sites {x : (theory A label).Term} (pair : (concurrency A label).Pair x) :
    OccurrencePath.sites ((concurrency A label).tiles.swapped pair) =
      [pair.second.site, pair.first.site] :=
  pair_swapped_sites (concurrency A label) pair

/-- The tile of a round of two at a configuration. -/
def roundTile {D : Configuration T O} {f g : Firing T S O} (isRound : Round A label D [f, g]) :
    (concurrency A label).Pair (classOf A label D) where
  first := ⟨f, classOf A label (f.result label D), ⟨⟨(isRound.cons A label).1, rfl⟩⟩⟩
  second := ⟨g, classOf A label (g.result label D),
    ⟨⟨((isRound.perm A label (List.Perm.swap g f [])).cons A label).1, rfl⟩⟩⟩
  independent := isRound

end Tiles

/-! ## Paths and words -/

section Agreement

variable (A : SubstitutionAction T S) (label : O → T)

/-- **Trace-equivalent paths have round-equivalent words**, from every representative of their
source. -/
theorem roundEquiv_of_traceEq {x y : (theory A label).Term}
    {p q : OccurrencePath (presentation A label) x y}
    (related : TraceEq (concurrency A label).tiles p q) :
    ∀ C : Configuration T O, classOf A label C = x →
      RoundEquiv A label C (OccurrencePath.sites p) (OccurrencePath.sites q) := by
  induction related with
  | refl _ => exact fun _ _ => .refl _
  | symm _ ih => exact fun C source => .symm _ _ (ih C source)
  | trans _ _ first second => exact fun C source => .trans _ _ _ (first C source) (second C source)
  | tile pair =>
      intro C source
      subst source
      have swap : RoundEquiv A label C [pair.first.site, pair.second.site]
          [pair.second.site, pair.first.site] :=
        .rel _ _ (RoundSwap.swap [] [] pair.first.site pair.second.site pair.independent)
      exact (route_sites A label pair).symm ▸ (swapped_sites A label pair).symm ▸ swap
  | cong_left pre _ ih =>
      intro C source
      have equivalent := RoundEquiv.append_left A label C _
        (ih _ (target_eq A label pre C source).symm)
      exact (OccurrencePath.sites_append _ _).symm ▸ (OccurrencePath.sites_append _ _).symm ▸
        equivalent
  | cong_right post _ ih =>
      intro C source
      have equivalent := RoundEquiv.append_right A label (ih C source) (OccurrencePath.sites post)
      exact (OccurrencePath.sites_append _ _).symm ▸ (OccurrencePath.sites_append _ _).symm ▸
        equivalent

/-- **Round-equivalent runs are trace-equivalent paths.** Every pair of paths from the class of
`C` to one class whose words are round equivalent, the first a run from `C`, is trace
equivalent. -/
theorem traceEq_of_roundEquiv {C : Configuration T O} {w w' : List (Firing T S O)}
    (equivalent : RoundEquiv A label C w w') :
    Executable A label C w → ∀ {y : (theory A label).Term}
      (p q : OccurrencePath (presentation A label) (classOf A label C) y),
      OccurrencePath.sites p = w → OccurrencePath.sites q = w' →
        TraceEq (concurrency A label).tiles p q := by
  induction equivalent with
  | rel _ _ swapped =>
      cases swapped with
      | swap u v f g isRound =>
          intro _ y p q pSites qSites
          obtain ⟨m, p₁, p₂, rfl, p₁Sites, p₂Sites⟩ := split A label p u _ pSites
          obtain ⟨m', q₁, q₂, rfl, q₁Sites, q₂Sites⟩ := split A label q u _ qSites
          have middle : m = classOf A label (follow label C u) :=
            p₁Sites ▸ target_eq A label p₁ C rfl
          have middle' : m' = classOf A label (follow label C u) :=
            q₁Sites ▸ target_eq A label q₁ C rfl
          subst middle
          subst middle'
          obtain rfl := path_ext A label p₁ q₁ (p₁Sites.trans q₁Sites.symm)
          refine TraceEq.cong_left p₁ ?_
          obtain ⟨m₂, p₃, s, rfl, p₃Sites, sSites⟩ := split A label p₂ [f, g] v p₂Sites
          have after : m₂ = classOf A label (follow label (follow label C u) [f, g]) :=
            p₃Sites ▸ target_eq A label p₃ (follow label C u) rfl
          subst after
          have firstRoute : p₃ = (concurrency A label).tiles.route (roundTile A label isRound) :=
            path_ext A label _ _ (p₃Sites.trans (route_sites A label (roundTile A label isRound)).symm)
          subst firstRoute
          have secondRoute : q₂ = OccurrencePath.append
              ((concurrency A label).tiles.swapped (roundTile A label isRound)) s := by
            refine path_ext A label _ _ (q₂Sites.trans (Eq.trans ?_ (OccurrencePath.sites_append _ _).symm))
            exact (congrArg (fun l => g :: f :: l) sSites.symm).trans
              (congrArg (· ++ OccurrencePath.sites s)
                (swapped_sites A label (roundTile A label isRound)).symm)
          subst secondRoute
          exact TraceEq.cong_right s (.tile (T := (concurrency A label).tiles) (roundTile A label isRound))
  | refl _ =>
      intro _ y p q pSites qSites
      obtain rfl := path_ext A label p q (pSites.trans qSites.symm)
      exact .refl _
  | symm _ _ first ih =>
      intro executable y p q pSites qSites
      exact .symm (ih ((RoundEquiv.executable A label first).1.mpr executable) q p qSites pSites)
  | trans _ middleWord _ first second ih₁ ih₂ =>
      intro executable y p q pSites qSites
      have middleRuns := (RoundEquiv.executable A label first).1.mp executable
      have ends : classOf A label (follow label C middleWord) = y := by
        have atEnd := target_eq A label p C rfl
        rw [pSites] at atEnd
        exact ((Quotient.sound ((RoundEquiv.executable A label first).2 executable)).symm.trans
          atEnd.symm : _)
      obtain ⟨r, rSites⟩ := exists_path A label C middleWord middleRuns y ends
      exact .trans (ih₁ executable p r pSites rSites) (ih₂ middleRuns r q rSites qSites)

/-- **Path-level contextual traces are word-level round equivalence.** Two paths from the class of
`C` to one class are trace equivalent under the contextual concurrency exactly when their words
of firings are round equivalent from `C`. -/
theorem traceEq_iff_roundEquiv {C : Configuration T O} {y : (theory A label).Term}
    (p q : OccurrencePath (presentation A label) (classOf A label C) y) :
    TraceEq (concurrency A label).tiles p q ↔
      RoundEquiv A label C (OccurrencePath.sites p) (OccurrencePath.sites q) := by
  refine ⟨fun related => roundEquiv_of_traceEq A label related C rfl, fun equivalent => ?_⟩
  by_cases consistent : A.Consistent C.equations
  · exact traceEq_of_roundEquiv A label equivalent
      (executable_of_path A label p C rfl consistent) p q rfl rfl
  · have pNil := sites_eq_nil_of_inconsistent A label p C rfl consistent
    have qNil := sites_eq_nil_of_inconsistent A label q C rfl consistent
    obtain rfl := path_ext A label p q (pNil.trans qNil.symm)
    exact .refl _

/-- **The arrows of the contextual trace category from the class of `C` are the round-equivalence
classes of its runs.** -/
theorem trace_eq_iff_roundEquiv {C : Configuration T O} {y : (theory A label).Term}
    (p q : OccurrencePath (presentation A label) (classOf A label C) y) :
    Trace.mk (T := (concurrency A label).tiles) p = Trace.mk q ↔
      RoundEquiv A label C (OccurrencePath.sites p) (OccurrencePath.sites q) :=
  ⟨fun same => (traceEq_iff_roundEquiv A label p q).mp (Quotient.exact same),
    fun equivalent => Quotient.sound ((traceEq_iff_roundEquiv A label p q).mpr equivalent)⟩

end Agreement

/-! ## Controls -/

namespace PathControls

open Mettapedia.Logic.LP
open ConstraintMultisetRewriting.Controls (signature A)
open AnnotatedRuns.Controls (label Run taker reader start)

/-- **Positive control.** The paths of the round of the taker and the reader, in its two orders,
are one contextual trace. -/
theorem round_paths_one_trace :
    ∃ p q : OccurrencePath (presentation A label) (classOf A label start)
      (classOf A label (follow label start [taker, reader])),
      OccurrencePath.sites p = [taker, reader] ∧ OccurrencePath.sites q = [reader, taker] ∧
        TraceEq (concurrency A label).tiles p q := by
  obtain ⟨p, pSites⟩ := exists_path A label start _ AnnotatedRuns.Controls.taker_then_reader _ rfl
  obtain ⟨q, qSites⟩ := exists_path A label start [reader, taker]
    RoundControls.round_both_orders.1 _ (Quotient.sound RoundControls.round_both_orders.2)
  refine ⟨p, q, pSites, qSites, (traceEq_iff_roundEquiv A label p q).mpr ?_⟩
  exact pSites.symm ▸ qSites.symm ▸ (.symm _ _ RoundControls.round_one_trace)

/-- **Negative control.** A writer into the space a predicate query observes, then the query, is no path:
the only path of the two firings has the query first, so no tile can relate two orders
(`AnnotatedRuns.Controls.census_writer_one_order`). -/
theorem query_writer_no_second_path (y : (theory A label).Term) :
    ¬ ∃ q : OccurrencePath (presentation A label) (classOf A label AnnotatedRuns.Controls.empty) y,
      OccurrencePath.sites q = [AnnotatedRuns.Controls.maker, AnnotatedRuns.Controls.observer] := by
  rintro ⟨q, qSites⟩
  have runs := executable_of_path A label q AnnotatedRuns.Controls.empty rfl
    ⟨Subst.id signature, by intro e member; cases member⟩
  rw [qSites] at runs
  exact (AnnotatedRuns.Controls.census_writer_one_order).2.2.2.2 runs

end PathControls

