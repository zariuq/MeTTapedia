import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.AnnotatedRuns
import Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.CheckStability
import Mettapedia.GSLT.Causality.SiteValuationDescent

/-!
# Rounds: parallel firing of the candidate step

A **round** is a list of firings admitted at one configuration. Its members owe each other
three things (`Compatible`): their footprints are independent in the ground layer, the guards
of each ignore the other's writes, and the predicate queries of each have no predicate-read
dependency on the other's writes. The guard and query conditions are judged at the cut of the
pair; they then hold at every later cut (`Compatible.of_refines`). The whole round must have
jointly consistent equations (`Round.joint`): pairwise consistency is not enough
(`Controls.pairwise_consistent_not_joint`).

* **Serializability in every order** (`Round.executable_perm`, `Round.follow_perm`): every
  order of a round runs, and every order reaches the same class. This is the statement of
  Theorem 1 (serializability) of Schrijvers and Sulzmann's transactional CHR (ICLP 2008),
  for the candidate step with equations and predicate queries. The two-member case is the
  guarded diamond with census.
* **Predicate queries restrict the tensor exactly** (`census_after_iff`): a firing keeps its
  census after a writer exactly when the writer writes nothing into the query region at the
  new cut. A writer into the region refuses the query (`census_refused_after_writer`), so a
  query read and a write into its region are a serialization edge. Two firings that query one
  region and write into it form no round in either order: write skew is excluded
  (`Controls.write_skew_excluded`).
* **A round is one trace** (`Round.orders_equivalent`): its orders are equivalent under the
  contextual trace equivalence `RoundEquiv`, generated by swaps of pairs that form a round where
  they stand, and equivalent runs reach the same class (`RoundEquiv.executable`). A round therefore
  denotes one arrow of the contextual trace category, its parallel composition. Every executed
  static swap is such a swap (`static_swap_is_round_swap`), so the static trace equivalence lies
  inside the contextual one (`traceEquiv_roundEquiv`), strictly
  (`RoundControls.contextual_strictly_coarser`), and both keep the bag of firings
  (`RoundEquiv.perm`).
* **The contextual independence is an event concurrency** (`concurrency`): two enabled events
  at one class are independent when they form a round there. Every site valuation into a
  commutative monoid is then a property of its traces, and a site valuation into any monoid is
  one exactly when the two grades of every swap commute (`siteValuation_descends_iff`).

Joint consistency is a property of the configuration, never of the firings: two tells of
`X = 1` and `X = 2` are each admitted and cannot both fire. Hence this independence is not a
Mazurkiewicz independence of letters; the static one is `AnnotatedRuns.StaticIndependent`.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.ConstraintMultisetRewriting.AnnotatedRuns

open MeTTaCalculus.OccurrenceCommits (Commit Enabled fire regionOf regionOf_fire_of_no_write
  mem_regionOf mem_fire)
open GuardFreeProcessOrders (SameUpTo problem_eq result_equations)

universe uT uS uO
variable {T : Type uT} {S : Type uS} {O : Type uO} [DecidableEq O]

/-! ## Write-ignorance at stronger cuts -/

section Refinement

variable (A : SubstitutionAction T S) (label : O → T)

omit [DecidableEq O] in
theorem check_ignoresWrites_of_refines {stronger weaker : EquationStore T}
    (refines : A.Refines stronger weaker) {writer : Selection O} {check : Check T}
    (ignored : Check.IgnoresWrites A weaker label writer check) :
    Check.IgnoresWrites A stronger label writer check := by
  cases check with
  | equal => trivial
  | absent pattern => exact fun o member => A.apart_of_refines refines (ignored o member)
  | count pattern number => exact fun o member => A.apart_of_refines refines (ignored o member)

omit [DecidableEq O] in
theorem query_ignoresWrites_of_refines {stronger weaker : EquationStore T}
    (refines : A.Refines stronger weaker) {writer : Selection O}
    {query : PredicateQueryAdmission.Query T S O}
    (ignored : query.IgnoresWrites A weaker label writer) :
    query.IgnoresWrites A stronger label writer :=
  A.entails_of_refines refines ignored

end Refinement

/-! ## What two members of a round owe each other -/

namespace Firing

/-- The equations a firing adds to the store. -/
def added (label : O → T) (f : Firing T S O) : EquationStore T :=
  GuardFreeProcessOrders.added label f.rule f.selection

omit [DecidableEq O] in
theorem problem_eq' (label : O → T) (f : Firing T S O) (C : Configuration T O) :
    f.selection.problem label f.rule C = C.equations ++ f.added label :=
  problem_eq label f.rule f.selection C

theorem result_equations' (label : O → T) (f : Firing T S O) (C : Configuration T O) :
    (f.result label C).equations = C.equations ++ f.added label :=
  result_equations label f.rule f.selection C

end Firing

section Pairs

variable (A : SubstitutionAction T S) (label : O → T)

/-- The cut of a pair: the store with both firings' equations. -/
def pairCut (C : Configuration T O) (f g : Firing T S O) : EquationStore T :=
  C.equations ++ f.added label ++ g.added label

/-- **What two members of a round owe each other.** Independent footprints, guards that ignore
the other's writes, and query regions that the other does not write, at the cut of the pair. -/
def Compatible (C : Configuration T O) (f g : Firing T S O) : Prop :=
  MeTTaCalculus.OccurrenceCommits.Independent label (f.selection.commit (T := T))
      (g.selection.commit (T := T)) ∧
    (∀ check ∈ f.rule.checks, Check.IgnoresWrites A (pairCut label C f g) label g.selection check) ∧
    (∀ check ∈ g.rule.checks, Check.IgnoresWrites A (pairCut label C f g) label f.selection check) ∧
    (∀ query ∈ f.queries, query.IgnoresWrites A (pairCut label C f g) label g.selection) ∧
    (∀ query ∈ g.queries, query.IgnoresWrites A (pairCut label C f g) label f.selection)

omit [DecidableEq O] in
theorem pairCut_refines_swap (C : Configuration T O) (f g : Firing T S O) :
    A.Refines (pairCut label C g f) (pairCut label C f g) := by
  intro σ solved
  simp only [pairCut, SubstitutionAction.models_append] at solved ⊢
  exact ⟨⟨solved.1.1, solved.2⟩, solved.1.2⟩

theorem Compatible.symm {C : Configuration T O} {f g : Firing T S O}
    (compatible : Compatible A label C f g) : Compatible A label C g f := by
  obtain ⟨commits, fChecks, gChecks, fCensus, gCensus⟩ := compatible
  have refines := pairCut_refines_swap A label C f g
  exact ⟨commits.symm,
    fun check member => check_ignoresWrites_of_refines A label refines (gChecks check member),
    fun check member => check_ignoresWrites_of_refines A label refines (fChecks check member),
    fun query member => query_ignoresWrites_of_refines A label refines (gCensus query member),
    fun query member => query_ignoresWrites_of_refines A label refines (fCensus query member)⟩

/-- Compatibility survives a stronger store at the base. -/
theorem Compatible.of_refines {C D : Configuration T O} {f g : Firing T S O}
    (refines : A.Refines D.equations C.equations) (compatible : Compatible A label C f g) :
    Compatible A label D f g := by
  obtain ⟨commits, fChecks, gChecks, fCensus, gCensus⟩ := compatible
  have cuts : A.Refines (pairCut label D f g) (pairCut label C f g) := by
    intro σ solved
    simp only [pairCut, SubstitutionAction.models_append] at solved ⊢
    exact ⟨⟨refines σ solved.1.1, solved.1.2⟩, solved.2⟩
  exact ⟨commits,
    fun check member => check_ignoresWrites_of_refines A label cuts (fChecks check member),
    fun check member => check_ignoresWrites_of_refines A label cuts (gChecks check member),
    fun query member => query_ignoresWrites_of_refines A label cuts (fCensus query member),
    fun query member => query_ignoresWrites_of_refines A label cuts (gCensus query member)⟩

/-- **The guarded diamond with predicate queries, one side.** A compatible member stays admitted after
another member fires, at the cut of the pair. -/
theorem valid_after_member {C : Configuration T O} {f g : Firing T S O}
    (fValid : f.Valid A label C) (gValid : g.Valid A label C)
    (compatible : Compatible A label C f g) (joint : A.Consistent (pairCut label C f g)) :
    g.Valid A label (f.result label C) := by
  obtain ⟨commits, -, gChecks, -, gCensus⟩ := compatible
  have cut : g.selection.problem label g.rule (f.result label C) = pairCut label C f g := by
    rw [Firing.problem_eq', Firing.result_equations']
    rfl
  have older {σ : S} (solved : A.Models σ (pairCut label C f g)) :
      A.Models σ (g.selection.problem label g.rule C) := by
    rw [Firing.problem_eq']
    simp only [pairCut, SubstitutionAction.models_append] at solved ⊢
    exact ⟨solved.1.1, solved.2⟩
  refine ⟨⟨gValid.firing.take_distinct, gValid.firing.output_distinct, gValid.firing.take_length,
    gValid.firing.read_length, gValid.firing.outputs, ?_, by rw [cut]; exact joint, ?_⟩, ?_⟩
  · exact (MeTTaCalculus.OccurrenceCommits.enabled_fire_iff gValid.firing.occurrences
      fValid.firing.occurrences).mpr ⟨fun clash => commits.1 clash.symm, commits.2.1⟩
  · intro check member σ solved
    rw [cut] at solved
    exact (Check.holds_fire_iff_of_ignored A C.present f.selection check
      (gChecks check member) σ solved).mpr (gValid.firing.checks check member σ (older solved))
  · intro query member σ solved
    rw [cut] at solved
    change regionOf label (fire C.present (f.selection.commit (T := T))) (query.region σ) =
      query.seen
    have noWrite : ∀ o ∈ (f.selection.commit (T := T)).taken ∪ (f.selection.commit (T := T)).made,
        query.region σ (label o) = false := by
      intro o written
      apply gCensus query member σ solved o
      simpa [Selection.commit] using written
    rw [regionOf_fire_of_no_write noWrite]
    exact gValid.observations query member σ (older solved)

end Pairs

/-! ## Rounds -/

section Rounds

variable (A : SubstitutionAction T S) (label : O → T)

/-- The joint problem of a round: the store with every member's equations. -/
def jointProblem (C : Configuration T O) (round : List (Firing T S O)) : EquationStore T :=
  C.equations ++ round.flatMap (Firing.added label)

/-- **A round**: firings admitted at one configuration, pairwise compatible, with jointly
consistent equations. -/
structure Round (C : Configuration T O) (round : List (Firing T S O)) : Prop where
  valid : ∀ f ∈ round, f.Valid A label C
  joint : A.Consistent (jointProblem label C round)
  compatible : round.Pairwise (Compatible A label C)

omit [DecidableEq O] in
theorem models_jointProblem_perm {C : Configuration T O} {round round' : List (Firing T S O)}
    (perm : round.Perm round') (σ : S) :
    A.Models σ (jointProblem label C round) ↔ A.Models σ (jointProblem label C round') := by
  simp only [jointProblem, SubstitutionAction.models_append]
  refine and_congr Iff.rfl ⟨fun solved e member => solved e ?_, fun solved e member => solved e ?_⟩
  · exact ((perm.flatMap_right (Firing.added label)).mem_iff).mpr member
  · exact ((perm.flatMap_right (Firing.added label)).mem_iff).mp member

/-- A round is a property of its members, not of their order. -/
theorem Round.perm {C : Configuration T O} {round round' : List (Firing T S O)}
    (isRound : Round A label C round) (perm : round.Perm round') : Round A label C round' :=
  ⟨fun f member => isRound.valid f (perm.symm.subset member),
    (SubstitutionAction.equivalent_consistent A (models_jointProblem_perm A label perm)).mp
      isRound.joint,
    isRound.compatible.perm perm fun compatible => compatible.symm A label⟩

/-- Firing the first member leaves a round of the rest. -/
theorem Round.cons {C : Configuration T O} {f : Firing T S O} {rest : List (Firing T S O)}
    (isRound : Round A label C (f :: rest)) :
    f.Valid A label C ∧ Round A label (f.result label C) rest := by
  have fValid := isRound.valid f List.mem_cons_self
  have compatible := List.pairwise_cons.mp isRound.compatible
  have refines : A.Refines (f.result label C).equations C.equations := by
    rw [Firing.result_equations']
    exact A.append_refines _ _
  refine ⟨fValid, ⟨?_, ?_, compatible.2.imp fun pair => pair.of_refines A label refines⟩⟩
  · intro g member
    obtain ⟨σ, solved⟩ := isRound.joint
    refine valid_after_member A label fValid (isRound.valid g (List.mem_cons_of_mem f member))
      (compatible.1 g member) ⟨σ, ?_⟩
    simp only [jointProblem, pairCut, SubstitutionAction.models_append, List.flatMap_cons]
      at solved ⊢
    exact ⟨⟨solved.1, solved.2.1⟩,
      fun e inG => solved.2.2 e (List.mem_flatMap.mpr ⟨g, member, inG⟩)⟩
  · have same : jointProblem label (f.result label C) rest = jointProblem label C (f :: rest) := by
      simp [jointProblem, Firing.result_equations', List.flatMap_cons]
    rw [same]
    exact isRound.joint

/-- A round runs in its own order. -/
theorem Round.executable : ∀ {C : Configuration T O} {round : List (Firing T S O)},
    Round A label C round → Executable A label C round
  | C, [], isRound => by
      show A.Consistent C.equations
      simpa [jointProblem] using isRound.joint
  | _, _ :: _, isRound =>
      ⟨(isRound.cons A label).1, Round.executable (isRound.cons A label).2⟩

/-- **Every order of a round runs.** -/
theorem Round.executable_perm {C : Configuration T O} {round order : List (Firing T S O)}
    (isRound : Round A label C round) (perm : order.Perm round) : Executable A label C order :=
  (isRound.perm A label perm.symm).executable A label

theorem follow_equations : ∀ (C : Configuration T O) (w : List (Firing T S O)),
    (follow label C w).equations = C.equations ++ w.flatMap (Firing.added label)
  | C, [] => by simp [follow]
  | C, f :: rest => by
      rw [show follow label C (f :: rest) = follow label (f.result label C) rest from rfl,
        follow_equations, Firing.result_equations', List.flatMap_cons, List.append_assoc]

/-- **Every order of a round reaches the same class.** -/
theorem Round.follow_perm {C : Configuration T O} {round order : List (Firing T S O)}
    (isRound : Round A label C round) (perm : order.Perm round) :
    SameUpTo A (follow label C order) (follow label C round) := by
  refine ⟨fun σ => ?_, ?_⟩
  · rw [follow_equations, follow_equations]
    exact models_jointProblem_perm A label perm σ
  · rw [follow_present, follow_present]
    refine MeTTaCalculus.OccurrenceCommits.fireList_perm ?_ (perm.map _)
    intro c member
    obtain ⟨f, inOrder, rfl⟩ := List.mem_map.mp member
    have enabled := (isRound.valid f (perm.subset inOrder)).firing.occurrences
    exact ⟨enabled.taken_subset, enabled.fresh⟩

/-- Rounds depend only on the class of the configuration. -/
theorem Round.congr {C D : Configuration T O} {round : List (Firing T S O)}
    (same : SameUpTo A C D) : Round A label C round ↔ Round A label D round := by
  have forward : ∀ {C D : Configuration T O}, SameUpTo A C D →
      Round A label C round → Round A label D round := by
    intro C D same isRound
    have refines : A.Refines D.equations C.equations := fun σ solved => (same.1 σ).mpr solved
    refine ⟨fun f member => (Firing.valid_congr A label same).mp (isRound.valid f member), ?_,
      isRound.compatible.imp fun pair => pair.of_refines A label refines⟩
    obtain ⟨σ, solved⟩ := isRound.joint
    refine ⟨σ, ?_⟩
    simp only [jointProblem, SubstitutionAction.models_append] at solved ⊢
    exact ⟨(same.1 σ).mp solved.1, solved.2⟩
  exact ⟨forward same, forward (sameUpTo_symm A same)⟩

end Rounds

/-! ## Predicate queries restrict the tensor exactly -/

section Census

variable (A : SubstitutionAction T S) (label : O → T)

/-- **A writer into a query region refuses the query.** -/
theorem census_refused_after_writer {f g : Firing T S O} {C : Configuration T O}
    (fValid : f.Valid A label C) (gEnabled : Enabled label C.present (g.selection.commit (T := T)))
    {query : PredicateQueryAdmission.Query T S O} (member : query ∈ f.queries) {σ : S}
    (solved : A.Models σ (f.selection.problem label f.rule (g.result label C)))
    {o : O} (written : o ∈ g.selection.taken ∨ o ∈ g.selection.made)
    (inRegion : query.region σ (label o) = true) :
    ¬ f.Valid A label (g.result label C) := by
  intro after
  have older : A.Models σ (f.selection.problem label f.rule C) := by
    rw [Firing.problem_eq'] at solved ⊢
    rw [Firing.result_equations'] at solved
    simp only [SubstitutionAction.models_append] at solved ⊢
    exact ⟨solved.1.1, solved.2⟩
  have before : regionOf label C.present (query.region σ) = query.seen :=
    fValid.observations query member σ older
  have later : regionOf label (fire C.present (g.selection.commit (T := T))) (query.region σ) =
      query.seen := after.observations query member σ solved
  rcases written with taken | made
  · have present : o ∈ C.present := gEnabled.taken_subset (by simpa [Selection.commit] using taken)
    have seen : o ∈ query.seen := before ▸ mem_regionOf.mpr ⟨present, inRegion⟩
    rw [← later] at seen
    exact Finset.disjoint_left.mp (MeTTaCalculus.OccurrenceCommits.disjoint_taken_fire gEnabled)
      (by simpa [Selection.commit] using taken) (mem_regionOf.mp seen).1
  · have fresh : o ∈ fire C.present (g.selection.commit (T := T)) :=
      MeTTaCalculus.OccurrenceCommits.made_subset_fire (by simpa [Selection.commit] using made)
    have seen : o ∈ query.seen := later ▸ mem_regionOf.mpr ⟨fresh, inRegion⟩
    rw [← before] at seen
    exact Finset.disjoint_left.mp gEnabled.fresh (by simpa [Selection.commit] using made)
      (mem_regionOf.mp seen).1

/-- **Predicate queries restrict the tensor exactly.** A firing keeps its census after a writer
exactly when it is still admitted as a plain firing and the writer writes nothing into any of
its query regions at the new cut. -/
theorem census_after_iff {f g : Firing T S O} {C : Configuration T O}
    (fValid : f.Valid A label C) (gEnabled : Enabled label C.present (g.selection.commit (T := T))) :
    f.Valid A label (g.result label C) ↔
      f.selection.Valid A label f.rule (g.result label C) ∧
        ∀ query ∈ f.queries,
          query.IgnoresWrites A (f.selection.problem label f.rule (g.result label C)) label
            g.selection := by
  constructor
  · intro after
    refine ⟨after.firing, fun query member σ solved o written => ?_⟩
    cases inRegion : query.region σ (label o) with
    | false => rfl
    | true =>
        exact absurd after (census_refused_after_writer A label fValid gEnabled member solved
          (by simpa using written) inRegion)
  · rintro ⟨readmitted, ignored⟩
    refine fValid.after readmitted rfl ?_ ignored
    intro σ solved
    rw [Firing.problem_eq'] at solved ⊢
    rw [Firing.result_equations'] at solved
    simp only [SubstitutionAction.models_append] at solved ⊢
    exact ⟨solved.1.1, solved.2⟩

end Census

/-! ## The contextual independence as an event concurrency -/

section Contextual

open Mettapedia.GSLT.Causality.EventConcurrency (Concurrency)

variable (A : SubstitutionAction T S) (label : O → T)

/-- A round at a class: at one, equivalently every, representative. -/
def RoundAt (x : ConfigurationClass A O) (round : List (Firing T S O)) : Prop :=
  Quotient.lift (fun C => Round A label C round)
    (fun _ _ same => propext (Round.congr A label same)) x

theorem RoundAt.symm {x : ConfigurationClass A O} {f g : Firing T S O}
    (isRound : RoundAt A label x [f, g]) : RoundAt A label x [g, f] := by
  obtain ⟨C, rfl⟩ := Quotient.exists_rep x
  exact Round.perm A label isRound (List.Perm.swap g f [])

theorem RoundAt.second_valid {x : ConfigurationClass A O} {f g : Firing T S O}
    (isRound : RoundAt A label x [f, g]) : g.ValidAt A label (f.resultClass A label x) := by
  obtain ⟨C, rfl⟩ := Quotient.exists_rep x
  exact (Round.cons A label isRound).2.valid g List.mem_cons_self

theorem RoundAt.close {x : ConfigurationClass A O} {f g : Firing T S O}
    (isRound : RoundAt A label x [f, g]) :
    g.resultClass A label (f.resultClass A label x) =
      f.resultClass A label (g.resultClass A label x) := by
  obtain ⟨C, rfl⟩ := Quotient.exists_rep x
  exact Quotient.sound (sameUpTo_symm A (Round.follow_perm A label isRound (List.Perm.swap f g [])))

/-- **The contextual independence of the candidate step is an event concurrency.** Two enabled
events at a class are independent when they form a round there; the residual of either is the
same firing after the other. -/
def concurrency : Concurrency (presentation A label) where
  Independent := fun {x} first second => RoundAt A label x [first.site, second.site]
  symm := fun independent => independent.symm A label
  residual := fun {x} {first} {second} independent =>
    ⟨second.site, second.site.resultClass A label first.target,
      ⟨⟨by rw [first.evidence.down.2]; exact independent.second_valid A label, rfl⟩⟩⟩
  residual_site := fun _ => rfl
  close := fun {x} {first} {second} independent => by
    change second.site.resultClass A label first.target =
      first.site.resultClass A label second.target
    rw [first.evidence.down.2, second.evidence.down.2]
    exact independent.close A label

/-- **Commutative site valuations are properties of the contextual traces.** -/
theorem siteValuation_descends {M : Type*} [AddCommMonoid M] (grade : Firing T S O → M) :
    Mettapedia.GSLT.Causality.EventConcurrency.Descends (concurrency A label).tiles
      (Mettapedia.GSLT.Causality.siteValuation (presentation A label) grade) :=
  (concurrency A label).siteValuation_descends grade

/-- **The exact criterion in any monoid**: a site valuation is a property of the contextual
traces exactly when the grades of the two firings of every swap commute. -/
theorem siteValuation_descends_iff {M : Type*} [AddMonoid M] (grade : Firing T S O → M) :
    Mettapedia.GSLT.Causality.EventConcurrency.Descends (concurrency A label).tiles
        (Mettapedia.GSLT.Causality.siteValuation (presentation A label) grade) ↔
      ∀ {x : (theory A label).Term} (pair : (concurrency A label).Pair x),
        AddCommute (grade pair.first.site) (grade pair.second.site) :=
  (concurrency A label).siteValuation_descends_iff grade

end Contextual

/-! ## A round is one trace -/

section RoundTraces

variable (A : SubstitutionAction T S) (label : O → T)

/-- One swap of two adjacent firings that form a round of two where they stand. -/
inductive RoundSwap (C : Configuration T O) : List (Firing T S O) → List (Firing T S O) → Prop
  | swap (u v : List (Firing T S O)) (f g : Firing T S O) :
      Round A label (follow label C u) [f, g] → RoundSwap C (u ++ f :: g :: v) (u ++ g :: f :: v)

/-- **The contextual trace equivalence** of runs from one configuration: the equivalence
generated by swaps of pairs that form a round where they stand. -/
abbrev RoundEquiv (C : Configuration T O) : List (Firing T S O) → List (Firing T S O) → Prop :=
  Relation.EqvGen (RoundSwap A label C)

/-- A round of two members of a round. -/
theorem Round.pair_of_cons {C : Configuration T O} {f g : Firing T S O}
    {rest : List (Firing T S O)} (isRound : Round A label C (f :: rest)) (member : g ∈ rest) :
    Round A label C [f, g] := by
  refine ⟨?_, ?_, List.pairwise_pair.mpr ((List.pairwise_cons.mp isRound.compatible).1 g member)⟩
  · intro x inPair
    rcases List.mem_pair.mp inPair with rfl | rfl
    · exact isRound.valid x List.mem_cons_self
    · exact isRound.valid x (List.mem_cons_of_mem f member)
  · obtain ⟨σ, solved⟩ := isRound.joint
    refine ⟨σ, ?_⟩
    simp only [jointProblem, SubstitutionAction.models_append, List.flatMap_cons,
      List.flatMap_nil, List.append_nil] at solved ⊢
    exact ⟨solved.1, solved.2.1, fun e inG => solved.2.2 e (List.mem_flatMap.mpr ⟨g, member, inG⟩)⟩

theorem swap_round_executable : ∀ (u v : List (Firing T S O)) (f g : Firing T S O)
    (C : Configuration T O), Round A label (follow label C u) [f, g] →
      (Executable A label C (u ++ f :: g :: v) ↔ Executable A label C (u ++ g :: f :: v)) ∧
        SameUpTo A (follow label C (u ++ f :: g :: v)) (follow label C (u ++ g :: f :: v))
  | [], v, f, g, C, isRound => by
      have swapped := isRound.perm A label (List.Perm.swap g f [])
      have fValid := (isRound.cons A label).1
      have gAfter := ((isRound.cons A label).2).valid g List.mem_cons_self
      have gValid := (swapped.cons A label).1
      have fAfter := ((swapped.cons A label).2).valid f List.mem_cons_self
      have same : SameUpTo A (g.result label (f.result label C)) (f.result label (g.result label C)) :=
        sameUpTo_symm A (isRound.follow_perm A label (List.Perm.swap f g []))
      refine ⟨⟨fun executable =>
          ⟨gValid, fAfter, (executable_congr A label v same).mp executable.2.2⟩,
        fun executable => ⟨fValid, gAfter, (executable_congr A label v same).mpr executable.2.2⟩⟩,
        follow_congr A label v same⟩
  | x :: u, v, f, g, C, isRound => by
      obtain ⟨equal, same⟩ := swap_round_executable u v f g (x.result label C) isRound
      exact ⟨and_congr Iff.rfl equal, same⟩

/-- **Contextually trace-equivalent runs reach the same class.** -/
theorem RoundEquiv.executable {C : Configuration T O} {w w' : List (Firing T S O)}
    (equivalent : RoundEquiv A label C w w') :
    (Executable A label C w ↔ Executable A label C w') ∧
      (Executable A label C w → SameUpTo A (follow label C w) (follow label C w')) := by
  induction equivalent with
  | rel _ _ swapped =>
      cases swapped with
      | swap u v f g isRound =>
          obtain ⟨equal, same⟩ := swap_round_executable A label u v f g C isRound
          exact ⟨equal, fun _ => same⟩
  | refl => exact ⟨Iff.rfl, fun _ => SameUpTo.refl A _⟩
  | symm _ _ _ ih =>
      exact ⟨ih.1.symm, fun executable => sameUpTo_symm A (ih.2 (ih.1.mpr executable))⟩
  | trans _ _ _ _ _ first second =>
      exact ⟨first.1.trans second.1,
        fun executable => (first.2 executable).trans A (second.2 (first.1.mp executable))⟩

/-- Equivalence after a firing lifts to the run that begins with it. -/
theorem RoundEquiv.cons {C : Configuration T O} {f : Firing T S O} {w w' : List (Firing T S O)}
    (equivalent : RoundEquiv A label (f.result label C) w w') :
    RoundEquiv A label C (f :: w) (f :: w') := by
  induction equivalent with
  | rel _ _ swapped =>
      cases swapped with
      | swap u v g h isRound => exact .rel _ _ (RoundSwap.swap (f :: u) v g h isRound)
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

/-- A firing of a round moves to the front past the members before it. -/
theorem bubble_front : ∀ (u : List (Firing T S O)) (f : Firing T S O) (v : List (Firing T S O))
    (C : Configuration T O), Round A label C (u ++ f :: v) →
      RoundEquiv A label C (u ++ f :: v) (f :: (u ++ v))
  | [], _, _, _, _ => .refl _
  | x :: u, f, v, C, isRound => by
      have later := bubble_front u f v (x.result label C) (isRound.cons A label).2
      have pair : Round A label C [x, f] :=
        isRound.pair_of_cons A label (List.mem_append_right u List.mem_cons_self)
      have front : RoundEquiv A label C (x :: f :: (u ++ v)) (f :: x :: (u ++ v)) :=
        .rel _ _ (RoundSwap.swap [] (u ++ v) x f pair)
      exact .trans _ _ _ (RoundEquiv.cons A label later) front

/-- **All orders of a round are one trace.** A round denotes one arrow of the contextual trace
category: its parallel composition. -/
theorem Round.orders_equivalent : ∀ {C : Configuration T O} {round order : List (Firing T S O)},
    Round A label C round → order.Perm round → RoundEquiv A label C order round
  | _, [], order, _, perm => by
      rw [List.perm_nil.mp perm]
      exact .refl _
  | C, f :: rest, order, isRound, perm => by
      obtain ⟨u, v, rfl⟩ := List.append_of_mem (perm.symm.subset List.mem_cons_self)
      have restPerm : (u ++ v).Perm rest := (List.perm_middle.symm.trans perm).cons_inv
      have moved := bubble_front A label u f v C (isRound.perm A label perm.symm)
      have tail := Round.orders_equivalent (isRound.cons A label).2 restPerm
      exact .trans _ _ _ moved (RoundEquiv.cons A label tail)

/-- **The static independence sits inside the contextual one**: an executed swap of statically
independent firings is a swap of a round of two. -/
theorem static_swap_is_round_swap {f g : Firing T S O} (independent : StaticIndependent label f g) :
    ∀ (u v : List (Firing T S O)) (C : Configuration T O),
      Executable A label C (u ++ f :: g :: v) →
        RoundSwap A label C (u ++ f :: g :: v) (u ++ g :: f :: v)
  | u, v, C, executable => by
      refine RoundSwap.swap u v f g ?_
      have reached : ∀ (u : List (Firing T S O)) (C : Configuration T O),
          Executable A label C (u ++ f :: g :: v) →
            f.Valid A label (follow label C u) ∧ g.Valid A label (f.result label (follow label C u)) := by
        intro u
        induction u with
        | nil => exact fun _ executable => ⟨executable.1, executable.2.1⟩
        | cons x u ih => exact fun C executable => ih (x.result label C) executable.2
      obtain ⟨fValid, gAfter⟩ := reached u C executable
      have gValid := (swap_valid A label independent fValid gAfter).1
      obtain ⟨fStatic, gStatic, apart⟩ := independent
      refine ⟨?_, ?_, List.pairwise_pair.mpr ⟨?_, ?_, ?_, ?_, ?_⟩⟩
      · intro x member
        rcases List.mem_pair.mp member with rfl | rfl
        · exact fValid
        · exact gValid
      · obtain ⟨σ, solved⟩ := gAfter.firing.consistent
        refine ⟨σ, ?_⟩
        rw [Firing.problem_eq', Firing.result_equations'] at solved
        simpa [jointProblem, List.append_assoc] using solved
      · have trace := apart A.identity
        refine ⟨trace.1.1, ?_, ?_⟩
        · rintro (kept | ⟨read, member, _⟩)
          · exact trace.1.2.1 (Or.inl kept)
          · simp [Selection.commit] at member
        · rintro (kept | ⟨read, member, _⟩)
          · exact trace.1.2.2 (Or.inl kept)
          · simp [Selection.commit] at member
      · intro check member
        rw [fStatic.checks] at member
        cases member
      · intro check member
        rw [gStatic.checks] at member
        cases member
      · intro query member σ _ o written
        exact apart.symm.writesOutside σ query member o (by simpa [Selection.commit] using written)
      · intro query member σ _ o written
        exact apart.writesOutside σ query member o (by simpa [Selection.commit] using written)

/-- **The static trace equivalence is inside the contextual one** on runs that execute. -/
theorem traceEquiv_roundEquiv {w w' : List (Firing T S O)}
    (equivalent : Mettapedia.GSLT.Distinction.CausalGluing.TraceEquiv (StaticIndependent label) w w') :
    ∀ C : Configuration T O, Executable A label C w → RoundEquiv A label C w w' := by
  induction equivalent with
  | rel _ _ swapped =>
      cases swapped with
      | swap u v related =>
          intro C executable
          exact .rel _ _ (static_swap_is_round_swap A label related u v C executable)
  | refl => exact fun _ _ => .refl _
  | symm _ _ first ih =>
      intro C executable
      exact .symm _ _ (ih C ((traceEquiv_executable A label first C).1.mpr executable))
  | trans _ _ _ first _ ih₁ ih₂ =>
      intro C executable
      exact .trans _ _ _ (ih₁ C executable)
        (ih₂ C ((traceEquiv_executable A label first C).1.mp executable))

/-- **The contextual trace equivalence keeps the bag of firings.** -/
theorem RoundEquiv.perm {C : Configuration T O} {w w' : List (Firing T S O)}
    (equivalent : RoundEquiv A label C w w') : w.Perm w' := by
  induction equivalent with
  | rel _ _ swapped =>
      cases swapped with
      | swap u v f g _ => exact List.Perm.append_left u (List.Perm.swap g f v)
  | refl => exact List.Perm.refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ first second => exact first.trans second

end RoundTraces

/-- A run's final store holds every member's equations, so a run needs its joint problem
to be consistent. -/
theorem Executable.joint (A : SubstitutionAction T S) (label : O → T) :
    ∀ {C : Configuration T O} {w : List (Firing T S O)},
      Executable A label C w → A.Consistent (jointProblem label C w)
  | C, [], executable => by
      change A.Consistent C.equations at executable
      simpa [jointProblem] using executable
  | C, f :: rest, executable => by
      have later := Executable.joint A label executable.2
      have same : jointProblem label (f.result label C) rest = jointProblem label C (f :: rest) := by
        simp [jointProblem, Firing.result_equations', List.flatMap_cons]
      rwa [same] at later

/-! ## Controls -/

namespace RoundControls

open Mettapedia.Logic.LP
open ConstraintMultisetRewriting.Controls (signature A)
open AnnotatedRuns.Controls (label Run zeros taker reader start taker_valid)

theorem reader_valid_at_start : reader.Valid A label start := by
  refine ⟨⟨by decide, by decide, rfl, rfl, rfl, by decide, ⟨zeros, ?_⟩, by simp [reader]⟩,
    by simp [reader]⟩
  intro equation member
  have same : equation = (.var 1, label 1) := by
    simpa [Selection.problem, Selection.equations, start, reader] using member
  subst same
  rfl

theorem taker_reader_compatible : Compatible A label start taker reader := by
  refine ⟨?_, by simp [taker], by simp [reader], by simp [taker], by simp [reader]⟩
  unfold MeTTaCalculus.OccurrenceCommits.Independent MeTTaCalculus.OccurrenceCommits.Clash
    MeTTaCalculus.OccurrenceCommits.Spoils MeTTaCalculus.OccurrenceCommits.WritesInto
  decide

theorem taker_reader_round : Round A label start [taker, reader] := by
  refine ⟨?_, ⟨zeros, ?_⟩, List.pairwise_pair.mpr taker_reader_compatible⟩
  · intro f member
    rcases List.mem_pair.mp member with rfl | rfl
    · exact taker_valid
    · exact reader_valid_at_start
  · intro equation member
    have cases : equation = (ConstraintMultisetRewriting.Controls.f (.const 0), label 0) ∨
        equation = (.var 1, label 1) := by
      simpa [jointProblem, Firing.added, GuardFreeProcessOrders.added, Selection.equations,
        start, taker, reader] using member
    rcases cases with rfl | rfl <;> rfl

/-- **Positive control.** The round of the taker and the reader runs in both orders, to one
class. -/
theorem round_both_orders :
    Executable A label start [reader, taker] ∧
      SameUpTo A (follow label start [reader, taker]) (follow label start [taker, reader]) :=
  ⟨taker_reader_round.executable_perm A label (List.Perm.swap taker reader []),
    taker_reader_round.follow_perm A label (List.Perm.swap taker reader [])⟩

/-- **Positive control: the round is one trace.** -/
theorem round_one_trace : RoundEquiv A label start [reader, taker] [taker, reader] :=
  taker_reader_round.orders_equivalent A label (List.Perm.swap taker reader [])

/-! ### The contextual trace equivalence is strictly coarser -/

open AnnotatedRuns.Controls (teller teller_valid)

/-- Guards `Y = Y`, which holds in every solution. -/
def trivialAsker : Run := ⟨⟨[], [], [], [.equal (.var 1) (.var 1)], []⟩, [], ⟨[], [], []⟩⟩

theorem trivialAsker_valid : trivialAsker.Valid A label AnnotatedRuns.Controls.empty := by
  refine ⟨⟨by decide, by decide, rfl, rfl, rfl, by decide,
    ⟨Subst.id signature, by
      simp [Selection.problem, Selection.equations, AnnotatedRuns.Controls.empty, trivialAsker]⟩, ?_⟩,
    by simp [trivialAsker]⟩
  intro check member σ _
  have only : check = .equal (.var 1) (.var 1) := by simpa [trivialAsker] using member
  subst only
  rfl

theorem teller_trivialAsker_round : Round A label AnnotatedRuns.Controls.empty [teller, trivialAsker] := by
  refine ⟨?_, ⟨AnnotatedRuns.Controls.ones, ?_⟩, List.pairwise_pair.mpr ⟨?_, by simp [teller], ?_,
    by simp [teller], by simp [trivialAsker]⟩⟩
  · intro f member
    rcases List.mem_pair.mp member with rfl | rfl
    · exact teller_valid
    · exact trivialAsker_valid
  · intro equation member
    have only : equation = (.var 0, .const 1) := by
      simpa [jointProblem, Firing.added, GuardFreeProcessOrders.added, Selection.equations,
        AnnotatedRuns.Controls.empty, teller, trivialAsker] using member
    subst only
    rfl
  · unfold MeTTaCalculus.OccurrenceCommits.Independent MeTTaCalculus.OccurrenceCommits.Clash
      MeTTaCalculus.OccurrenceCommits.Spoils MeTTaCalculus.OccurrenceCommits.WritesInto
    decide
  · intro check member
    have only : check = .equal (.var 1) (.var 1) := by simpa [trivialAsker] using member
    subst only
    trivial

/-- **Negative control: the contextual equivalence identifies more runs than the static one.**
The guard `Y = Y` ignores the tell, so the pair is a round and its two orders are one
contextual trace; a guard is never in the static fragment, so no static swap moves it. -/
theorem contextual_strictly_coarser :
    RoundEquiv A label AnnotatedRuns.Controls.empty [teller, trivialAsker] [trivialAsker, teller] ∧
      ¬ Mettapedia.GSLT.Distinction.CausalGluing.TraceEquiv (StaticIndependent label)
        [teller, trivialAsker] [trivialAsker, teller] := by
  refine ⟨.rel _ _ (RoundSwap.swap [] [] teller trivialAsker teller_trivialAsker_round), ?_⟩
  intro equivalent
  have kept := Mettapedia.GSLT.Distinction.CausalGluing.TraceEquiv.invariant
    (fun w : List Run => w.map fun f => f.rule.checks.isEmpty)
    (fun u v a b related => by
      simp [related.1.checks, related.2.1.checks]) equivalent
  simp [teller, trivialAsker] at kept

/-! ### Pairwise consistency is not joint consistency -/

def tellSame : Run := ⟨⟨[], [], [(.var 0, .var 1)], [], []⟩, [], ⟨[], [], []⟩⟩
def tellOne : Run := ⟨⟨[], [], [(.var 0, .const 1)], [], []⟩, [], ⟨[], [], []⟩⟩
def tellTwo : Run := ⟨⟨[], [], [(.var 1, .const 2)], [], []⟩, [], ⟨[], [], []⟩⟩

def empty : Configuration (Term signature) Nat := ⟨[], ∅⟩

theorem tells_jointly_inconsistent :
    ¬ A.Consistent (jointProblem label empty [tellSame, tellOne, tellTwo]) := by
  rintro ⟨σ, solved⟩
  have same := solved (.var 0, .var 1) (by
    simp [jointProblem, Firing.added, GuardFreeProcessOrders.added, Selection.equations, empty,
      tellSame, tellOne, tellTwo])
  have one := solved (.var 0, .const 1) (by
    simp [jointProblem, Firing.added, GuardFreeProcessOrders.added, Selection.equations, empty,
      tellSame, tellOne, tellTwo])
  have two := solved (.var 1, .const 2) (by
    simp [jointProblem, Firing.added, GuardFreeProcessOrders.added, Selection.equations, empty,
      tellSame, tellOne, tellTwo])
  change σ 0 = σ 1 at same
  change σ 0 = .const 1 at one
  change σ 1 = .const 2 at two
  rw [same, two] at one
  cases one

/-- Every pair of the three tells is consistent. -/
theorem tells_pairwise_consistent :
    A.Consistent (pairCut label empty tellSame tellOne) ∧
      A.Consistent (pairCut label empty tellSame tellTwo) ∧
        A.Consistent (pairCut label empty tellOne tellTwo) := by
  refine ⟨⟨fun _ => .const 1, ?_⟩, ⟨fun _ => .const 2, ?_⟩,
    ⟨fun n => if n = 0 then .const 1 else .const 2, ?_⟩⟩ <;>
  · intro equation member
    simp only [pairCut, Firing.added, GuardFreeProcessOrders.added, Selection.equations, empty,
      tellSame, tellOne, tellTwo, List.zipWith_nil_left, List.nil_append, List.append_nil,
      List.mem_append, List.mem_singleton] at member
    rcases member with rfl | rfl <;> rfl

/-- **Negative control.** The three tells are pairwise consistent, and no order runs all
three: a round needs joint consistency. -/
theorem pairwise_consistent_not_joint (order : List Run)
    (perm : order.Perm [tellSame, tellOne, tellTwo]) : ¬ Executable A label empty order := by
  intro executable
  exact tells_jointly_inconsistent ((SubstitutionAction.equivalent_consistent A
    (models_jointProblem_perm A label perm)).mp (Executable.joint A label executable))

/-! ### Write skew -/

/-- Two persistent atoms, `9` and `10`. -/
def skewLabel : Nat → Term signature
  | 9 => .const 9
  | 10 => .const 9
  | _ => .const 2

def noPersistent : MeTTaCalculus.OccurrenceCommits.PredicateQuery Nat (Term signature) :=
  ⟨AnnotatedRuns.Controls.persistent, ∅⟩

/-- Queries that no persistent atom is present, and makes the persistent `9`. -/
def skewNine : Run :=
  ⟨⟨[], [], [], [], [.const 9]⟩, [PredicateQueryAdmission.Query.fixed noPersistent], ⟨[], [], [9]⟩⟩

/-- Queries that no persistent atom is present, and makes the persistent `10`. -/
def skewTen : Run :=
  ⟨⟨[], [], [], [], [.const 9]⟩, [PredicateQueryAdmission.Query.fixed noPersistent], ⟨[], [], [10]⟩⟩

theorem skewNine_valid : skewNine.Valid A skewLabel empty := by
  refine (PredicateQueryAdmission.valid_fixed_iff A skewLabel _ [noPersistent] empty _).mpr
    ⟨⟨by decide, by decide, rfl, rfl, rfl, by decide,
      ⟨Subst.id signature, by simp [Selection.problem, Selection.equations, empty, skewNine]⟩,
      by simp [skewNine]⟩, ?_⟩
  intro query member
  obtain rfl := List.mem_singleton.mp member
  decide

theorem skewTen_valid : skewTen.Valid A skewLabel empty := by
  refine (PredicateQueryAdmission.valid_fixed_iff A skewLabel _ [noPersistent] empty _).mpr
    ⟨⟨by decide, by decide, rfl, rfl, rfl, by decide,
      ⟨Subst.id signature, by simp [Selection.problem, Selection.equations, empty, skewTen]⟩,
      by simp [skewTen]⟩, ?_⟩
  intro query member
  obtain rfl := List.mem_singleton.mp member
  decide

theorem skewTen_refused_after_nine : ¬ skewTen.Valid A skewLabel (skewNine.result skewLabel empty) := by
  intro valid
  have holds := valid.observations _ (List.mem_singleton_self _) (Subst.id signature) (by
    simp [Selection.problem, Selection.equations, Selection.result, Firing.result, empty,
      skewNine, skewTen])
  revert holds
  decide

theorem skewNine_refused_after_ten : ¬ skewNine.Valid A skewLabel (skewTen.result skewLabel empty) := by
  intro valid
  have holds := valid.observations _ (List.mem_singleton_self _) (Subst.id signature) (by
    simp [Selection.problem, Selection.equations, Selection.result, Firing.result, empty,
      skewNine, skewTen])
  revert holds
  decide

/-- **Negative control, write skew.** Each firing alone is admitted, their footprints take
nothing and make different identities, and no order runs both: each writes into the other's
query region. A validation that checked both against one shared view would admit an effect
that no order produces. -/
theorem write_skew_excluded :
    skewNine.Valid A skewLabel empty ∧ skewTen.Valid A skewLabel empty ∧
      ¬ Executable A skewLabel empty [skewNine, skewTen] ∧
        ¬ Executable A skewLabel empty [skewTen, skewNine] :=
  ⟨skewNine_valid, skewTen_valid, fun executable => skewTen_refused_after_nine executable.2.1,
    fun executable => skewNine_refused_after_ten executable.2.1⟩

/-- Makes the non-persistent `3`. -/
def outsider : Run := ⟨⟨[], [], [], [], [.const 2]⟩, [], ⟨[], [], [3]⟩⟩

/-- **Positive control.** A writer outside the query region keeps the census. -/
theorem outside_writer_keeps_census : skewNine.Valid A skewLabel (outsider.result skewLabel empty) := by
  refine (census_after_iff A skewLabel skewNine_valid (by decide)).mpr
    ⟨⟨by decide, by decide, rfl, rfl, rfl, by decide,
      ⟨Subst.id signature, by
        simp [Selection.problem, Selection.equations, Selection.result, Firing.result, empty,
          outsider, skewNine]⟩, by simp [skewNine]⟩, ?_⟩
  intro query member σ _ o written
  obtain rfl := List.mem_singleton.mp member
  have only : o = 3 := by simpa [outsider] using written
  subst only
  rfl

end RoundControls


