import Mettapedia.Languages.ProcessCalculi.CCS.Surface
import Mettapedia.GSLT.LanguageDef.RestrictionBlocks.Section

/-!
# The canonical section of CCS

The static equivalence of CCS is generated by the laws of its parallel bag and of its sums, restriction of inaction,
exchange of restrictions, scope extrusion and the empty sum. CCS is a calculus with restriction, so the canonical form
of its restriction blocks is a computable section of that equivalence on closed processes (`ccsCanonicalSection`, the
restriction-block theory's `blockCanonicalSection`).

The section is computed on the private handshake. Its two orders, and the handshake with a nested composition and an
inaction added, all have the action-first handshake as representative. The empty sum is represented by inaction, and a
restriction no component uses is dropped. Two inequivalent processes have different representatives.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.CCS

open Mettapedia.GSLT.LanguageDef
open Mettapedia.GSLT.LanguageDef.WellSorted
open Mettapedia.GSLT.LanguageDef.RestrictionBlocks (canon)
open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.Languages.ProcessCalculi.CCS.Blocks (ccsBlock ccsBlockLanguage)

/-- **The canonical section of CCS**: the canonical form of its restriction blocks. -/
def ccsCanonicalSection : ComputableCanonicalSection ccsIGSLT :=
  blockCanonicalSection (laws := ccsBlockLanguage) ccsIGSLT ccsBlock

/-- The section computes the canonical form of the underlying pattern. -/
theorem ccsCanonicalSection_normalize_val (term : ccsIGSLT.toGSLT.Term) :
    (ccsCanonicalSection.normalize term).1 = canon ccsBlock term.1 :=
  rfl

/-! ## The handshake -/

/-- **The two orders of the handshake have one representative.** -/
theorem handshake_orders_normalize_alike :
    ccsCanonicalSection.normalize handshakeTerm = ccsCanonicalSection.normalize handshakeSwappedTerm :=
  ccsCanonicalSection.complete handshake_swaps

/-- That representative is the action-first handshake. -/
theorem handshake_representative :
    (ccsCanonicalSection.normalize handshakeTerm).1 = privateHandshake ∧
      (ccsCanonicalSection.normalize handshakeSwappedTerm).1 = privateHandshake :=
  ⟨by decide +kernel, by decide +kernel⟩

/-- The handshake with its action nested in a composition beside an inaction: `(νx)({x.0 | 0} | ~x.0)`. -/
def handshakeNested : Pattern :=
  nu (par [par [sum [act (.bvar 0) nil], nil], sum [coact (.bvar 0) nil]])

/-- The nested handshake as a closed process. -/
def handshakeNestedTerm : ccsInteractivePresentation.Term :=
  ClosedTerm.ofCheck handshakeNested (by decide +kernel)

/-- **The nested handshake is the handshake**: splicing the nested composition and dropping the inaction, under the
restriction. The section decides the static equivalence. -/
theorem handshakeNested_equivalent :
    ccsIGSLT.toGSLT.equations.r handshakeNestedTerm handshakeTerm :=
  (ccsCanonicalSection.equivalent_iff_normalize_eq _ _).mpr (Subtype.ext (by decide +kernel))

/-! ## Sums and restrictions -/

/-- The empty sum as a closed process. -/
def emptySumTerm : ccsInteractivePresentation.Term :=
  ClosedTerm.ofCheck (sum []) (by decide +kernel)

/-- Inaction as a closed process. -/
def nilTerm : ccsInteractivePresentation.Term :=
  ClosedTerm.ofCheck nil (by decide +kernel)

/-- **The empty sum is inaction.** -/
theorem emptySum_equivalent : ccsIGSLT.toGSLT.equations.r emptySumTerm nilTerm :=
  (ccsCanonicalSection.equivalent_iff_normalize_eq _ _).mpr (Subtype.ext (by decide +kernel))

/-- `(νx) τ.0` as a closed process. -/
def garbageTerm : ccsInteractivePresentation.Term :=
  ClosedTerm.ofCheck (nu silentOnce) (by decide +kernel)

/-- `τ.0` as a closed process. -/
def silentOnceTerm : ccsInteractivePresentation.Term :=
  ClosedTerm.ofCheck silentOnce (by decide +kernel)

/-- **A restriction no component uses is garbage**: `(νx) τ.0` is `τ.0`. -/
theorem garbage_equivalent : ccsIGSLT.toGSLT.equations.r garbageTerm silentOnceTerm :=
  (ccsCanonicalSection.equivalent_iff_normalize_eq _ _).mpr (Subtype.ext (by decide +kernel))

/-! ## Inequivalent processes are told apart -/

/-- `τ.τ.0` as a closed process. -/
def silentTwiceTerm : ccsInteractivePresentation.Term :=
  ClosedTerm.ofCheck silentTwice (by decide +kernel)

/-- **Inequivalent processes have different representatives**: `τ.0` and `τ.τ.0`. -/
theorem components_normalize_apart :
    ccsCanonicalSection.normalize silentOnceTerm ≠ ccsCanonicalSection.normalize silentTwiceTerm := by
  intro same
  have equivalent : ccsIGSLT.toGSLT.equations.r silentOnceTerm silentTwiceTerm :=
    (ccsCanonicalSection.equivalent_iff_normalize_eq _ _).mpr same
  exact silent_components_differ (equationEquiv_of_presentedEquationSetoid equivalent)

/-- **A summand counts twice, in the section too**: `τ.0 + τ.0` and `τ.0` have different representatives. -/
theorem summands_counted :
    ccsCanonicalSection.normalize (ClosedTerm.ofCheck (sum [tau nil, tau nil]) (by decide +kernel)) ≠
      ccsCanonicalSection.normalize silentOnceTerm := by
  intro same
  have := congrArg Subtype.val same
  revert this
  decide +kernel

end Mettapedia.Languages.ProcessCalculi.CCS
