import Mettapedia.GSLT.Core.ClosureCriteria
import Mettapedia.Languages.ProcessCalculi.MORK.WorkQueueExec

/-!
# MM2 as a graph-structured lambda theory

This module packages MM2 work queues as one indexed family of GSLTs.  Every
member has complete support-valued spaces as terms, including pending `exec`
atoms, and one successful profile step as its rewrite relation.

The construction makes three boundaries explicit:

* scheduler state is already present in the term carrier, so the deterministic
  valid-exec queue has no private semantic control state;
* bounded execution reports completion or expiration and retains the residual
  space in either case;
* the current upstream post-check fuel behavior remains a separate pinned
  implementation observation in `WorkQueueExec.lean`.

The family contains the historical compatible-rule core and the strict
source-aware fragment.  The latter is indexed by an explicit unsupported-exec
policy, keeping the open-world language semantics distinct from the
remove-before-interpret implementation boundary.  The consuming member is
relative to the modeled interpreter; it does not classify unmodeled upstream
factory cases.  Neither profile assigns those cases invented meaning.
-/

namespace Mettapedia.Languages.ProcessCalculi.MORK

open Mettapedia.GSLT
open Mettapedia.GSLT.Core.ClosureCriteria
open Mettapedia.Languages.MeTTa.OSLFCore (Atom)

/-! ## The work-queue GSLT family -/

/-- An MM2 execution profile is its deterministic partial next-state function.

The space is deliberately not a field: every profile in this family has the
same language-visible `Space` carrier.  The index selects the directive
vocabulary and failure boundary, not a different data model. -/
structure ExecutionProfile where
  step : Space → Option Space

namespace ExecutionProfile

/-- The one-step relation generated by an MM2 execution profile. -/
def Step (profile : ExecutionProfile) (source target : Space) : Prop :=
  profile.step source = some target

/-- Every deterministic MM2 execution profile induces a GSLT on spaces. -/
def toGSLT (profile : ExecutionProfile) : GSLT where
  Term := Space
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites := profile.Step
  rewrites_resp_left := by
    intro source source' target equal step
    subst source'
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    intro source target target' step equal
    subst target'
    exact step

@[simp] theorem toGSLT_step_iff (profile : ExecutionProfile)
    (source target : Space) :
    profile.toGSLT.Step source target ↔ profile.step source = some target :=
  Iff.rfl

/-- Every profile GSLT is deterministic because its transition relation is
the graph of a partial function. -/
theorem step_deterministic (profile : ExecutionProfile)
    {source left right : Space}
    (leftStep : profile.toGSLT.Step source left)
    (rightStep : profile.toGSLT.Step source right) :
    left = right := by
  rw [profile.toGSLT_step_iff] at leftStep rightStep
  exact Option.some.inj (leftStep.symm.trans rightStep)

/-- Profile quiescence is exactly absence of a next state. -/
theorem normalForm_iff (profile : ExecutionProfile) (space : Space) :
    profile.toGSLT.IsNormalForm space ↔ profile.step space = none := by
  constructor
  · intro normal
    cases moved : profile.step space with
    | none => rfl
    | some next =>
        exact False.elim
          (normal ⟨next, (profile.toGSLT_step_iff space next).2 moved⟩)
  · intro stopped ⟨next, moved⟩
    rw [profile.toGSLT_step_iff, stopped] at moved
    simp at moved

/-- The canonical driver for every MM2 profile has no private control state.
All pending directives and their scheduling locations remain in the term. -/
noncomputable def driver (profile : ExecutionProfile) :
    HostedDriver profile.toGSLT where
  State := Unit
  step := fun space _ =>
    match profile.step space with
    | none => none
    | some next => some (next, ())
  sound := by
    intro space state next state' moved
    cases state
    cases state'
    cases found : profile.step space with
    | none => simp [found] at moved
    | some actual =>
        simp [found] at moved
        subst next
        exact found

@[simp] theorem driver_step (profile : ExecutionProfile) (space : Space) :
    profile.driver.step space () =
      match profile.step space with
      | none => none
      | some next => some (next, ()) :=
  rfl

end ExecutionProfile

/-! ## The historical compatible-rule member -/

/-- The existing compatible-pattern work queue as a family member. -/
noncomputable def validExecProfile : ExecutionProfile where
  step := workQueueStep

@[simp] theorem validExecProfile_step (space : Space) :
    validExecProfile.step space = workQueueStep space :=
  rfl

/-- One MM2 reduction is one successful deterministic work-queue step. -/
abbrev ValidExecStep := validExecProfile.Step

/-- The support-valued valid-exec MM2 core as a GSLT.

Pending work is represented by ordinary `exec` atoms in `Space`, so no
separate host queue is part of this carrier. -/
noncomputable def validExecGSLT : GSLT := validExecProfile.toGSLT

@[simp] theorem validExecGSLT_step_iff (source target : Space) :
    validExecGSLT.Step source target ↔
      workQueueStep source = some target :=
  Iff.rfl

/-- The valid-exec GSLT is deterministic because PathMap selection chooses one
least pending directive and firing that directive is a function. -/
theorem validExecGSLT_step_deterministic {source left right : Space}
    (leftStep : validExecGSLT.Step source left)
    (rightStep : validExecGSLT.Step source right) :
    left = right :=
  validExecProfile.step_deterministic leftStep rightStep

/-- Quiescence of the GSLT is exactly absence of a valid next queue step. -/
theorem validExecGSLT_normalForm_iff (space : Space) :
    validExecGSLT.IsNormalForm space ↔ workQueueStep space = none :=
  validExecProfile.normalForm_iff space

/-! ## The honest deterministic driver -/

/-- The MM2 driver has only unit private state: all pending work and its
ordering keys are represented in the space term. -/
noncomputable def validExecDriver : HostedDriver validExecGSLT :=
  validExecProfile.driver

/-- Complete driver configurations are equivalent to MM2 spaces themselves. -/
def spaceUnitEquiv : (Space × Unit) ≃ Space where
  toFun := Prod.fst
  invFun := fun space => (space, ())
  left_inv := by
    intro configuration
    rcases configuration with ⟨space, state⟩
    cases state
    rfl
  right_inv := by
    intro space
    rfl

/-- Every MM2 profile is control-reified by the same space/unit equivalence.
The profile may change which directives are understood, but it cannot smuggle
a queue, cursor, or priority decision into private host state. -/
noncomputable def ExecutionProfile.controlReification
    (profile : ExecutionProfile) :
    ControlReification profile.driver profile.toGSLT where
  configuration := spaceUnitEquiv
  step_iff := by
    intro source target
    rcases source with ⟨source, sourceState⟩
    rcases target with ⟨target, targetState⟩
    cases sourceState
    cases targetState
    change Space at source target
    change profile.step source = some target ↔
      (match profile.step source with
       | none => none
       | some next => some (next, ())) = some (target, ())
    cases found : profile.step source with
    | none => simp
    | some actual =>
        change some actual = some target ↔
          some (actual, ()) = some (target, ())
        simp

/-- MM2's valid-exec scheduler is control-reified: the language-visible space
is equivalent to the complete driver configuration, and its GSLT step is
exactly the driver move. -/
noncomputable def validExecControlReification :
    ControlReification validExecDriver validExecGSLT :=
  validExecProfile.controlReification

/-! ## Strict source-aware family members -/

/-- The strict source-aware queue under one explicit unsupported-exec policy. -/
noncomputable def sourceExecProfile
    (policy : UnsupportedExecPolicy) : ExecutionProfile where
  step := sourceWorkQueueStep policy

@[simp] theorem sourceExecProfile_step
    (policy : UnsupportedExecPolicy) (space : Space) :
    (sourceExecProfile policy).step space = sourceWorkQueueStep policy space :=
  rfl

/-- Source-aware MM2 as a GSLT family indexed by its malformed/unsupported
directive boundary. -/
noncomputable def sourceExecGSLT (policy : UnsupportedExecPolicy) : GSLT :=
  (sourceExecProfile policy).toGSLT

@[simp] theorem sourceExecGSLT_step_iff
    (policy : UnsupportedExecPolicy) (source target : Space) :
    (sourceExecGSLT policy).Step source target ↔
      sourceWorkQueueStep policy source = some target :=
  Iff.rfl

theorem sourceExecGSLT_step_deterministic
    (policy : UnsupportedExecPolicy) {source left right : Space}
    (leftStep : (sourceExecGSLT policy).Step source left)
    (rightStep : (sourceExecGSLT policy).Step source right) :
    left = right :=
  (sourceExecProfile policy).step_deterministic leftStep rightStep

theorem sourceExecGSLT_normalForm_iff
    (policy : UnsupportedExecPolicy) (space : Space) :
    (sourceExecGSLT policy).IsNormalForm space ↔
      sourceWorkQueueStep policy space = none :=
  (sourceExecProfile policy).normalForm_iff space

/-! ### Native realization adequacy -/

open WQComputable

/-- Every accepted source-aware step of the duplicate-free native list
realization is a reduction of the corresponding authored MM2 GSLT. -/
theorem cSourceWorkQueueStep_GSLT_adequate
    (policy : UnsupportedExecPolicy) (space next : List Atom)
    (nodup : space.Nodup)
    (supportedKeyInj : KeyInjective (cSupportedSourceExecFacts space))
    (rawKeyInj : KeyInjective (cRawExecFacts space))
    (supportedAlignment : ∀ sourceFact,
      selectNextScheduled (cSupportedSourceExecFacts space) = some sourceFact →
      SourceRowAlignment space sourceFact)
    (rawAlignment : ∀ raw sourceFact,
      selectNextScheduled (cRawExecFacts space) = some raw →
      decodeSupportedSourceExec raw = some sourceFact →
      SourceRowAlignment space sourceFact)
    (nativeStep : cSourceWorkQueueStep policy space = some next) :
    (sourceExecGSLT policy).Step space.toFinset next.toFinset := by
  apply (sourceExecGSLT_step_iff policy _ _).2
  have agreement := cSourceWorkQueueStep_toFinset policy space nodup
    supportedKeyInj rawKeyInj supportedAlignment rawAlignment
  simpa [nativeStep] using agreement.symm

/-- An exact-fuel source-aware semantic run is a finite path in the authored
MM2 GSLT. -/
theorem sourceWorkQueueRunN_multiStep
    (policy : UnsupportedExecPolicy) (fuel : Nat) (space : Space) :
    (sourceExecGSLT policy).MultiStep space
      (sourceWorkQueueRunN policy fuel space).1 := by
  induction fuel generalizing space with
  | zero =>
      simp only [sourceWorkQueueRunN]
      exact @GSLT.MultiStep.refl (sourceExecGSLT policy) space
  | succ fuel induction =>
      cases moved : sourceWorkQueueStep policy space with
      | none =>
          simp only [sourceWorkQueueRunN, moved]
          exact @GSLT.MultiStep.refl (sourceExecGSLT policy) space
      | some next =>
          simp only [sourceWorkQueueRunN, moved]
          exact .step ((sourceExecGSLT_step_iff policy _ _).2 moved)
            (induction next)

/-- Exact-fuel native execution refines finite reachability in the authored
MM2 GSLT whenever the realization invariant is maintained at every residual. -/
theorem cSourceWorkQueueRunN_GSLT_adequate
    (policy : UnsupportedExecPolicy) (fuel : Nat) (space : List Atom)
    (invariant : ∀ residual,
      CSourceReachable policy fuel space residual →
      SourceWorkQueueInvariant residual) :
    (sourceExecGSLT policy).MultiStep space.toFinset
      (cSourceWorkQueueRunN policy fuel space).1.toFinset := by
  have agreement :=
    cSourceWorkQueueRunN_toFinset policy fuel space invariant
  rw [agreement.1]
  exact sourceWorkQueueRunN_multiStep policy fuel space.toFinset

/-- Source-aware pending work is also fully reified in `Space`; changing the
unsupported-exec policy introduces no private host queue. -/
noncomputable def sourceExecControlReification
    (policy : UnsupportedExecPolicy) :
    ControlReification (sourceExecProfile policy).driver
      (sourceExecGSLT policy) :=
  (sourceExecProfile policy).controlReification

/-- A supported directive selected by the raw consuming envelope remains an
ordinary source-aware GSLT step. -/
theorem supported_exec_is_consuming_step
    {space : Space} {raw : RawExecFact} {directive : SourceExecFact}
    (selected : selectNextScheduled (rawExecFactsOfSpace space) = some raw)
    (decoded : decodeSupportedSourceExec raw = some directive) :
    (sourceExecGSLT .consume).Step space
      (fireSourceExecFact space directive) := by
  apply (sourceExecGSLT_step_iff .consume _ _).2
  exact sourceWorkQueueStep_consume_supported selected decoded

/-- On the explicitly shared compatible fragment, the historical GSLT and
the strict source-aware GSLT have the same outgoing edge.  Candidate-set
agreement remains an explicit premise until the byte-order and parser
refinements are proved for the full location grammar. -/
theorem selected_compatible_GSLT_step_iff
    {space target : Space} {sourceFact : SourceExecFact} {execFact : ExecFact}
    (sourceSelected :
      selectNextScheduled (supportedSourceExecFactsOfSpace space) =
        some sourceFact)
    (execSelected : selectNextExec (execFactsOfSpace space) = some execFact)
    (projected : sourceFact.toExecFact? = some execFact) :
    validExecGSLT.Step space target ↔
      (sourceExecGSLT .leaveInert).Step space target := by
  rw [validExecGSLT_step_iff,
    sourceExecGSLT_step_iff .leaveInert space target]
  rw [sourceWorkQueueStep_leaveInert_eq_workQueueStep_of_selected
    sourceSelected execSelected projected]

/-- A genuinely unsupported shell separates the two policies.  If no
supported directive is selectable, the open-world profile is quiescent; if
that raw shell is selected by the upstream-style envelope, the consuming
profile takes a step that erases it. -/
theorem unsupported_exec_separates_source_profiles
    {space : Space} {raw : RawExecFact}
    (noSupported :
      selectNextScheduled (supportedSourceExecFactsOfSpace space) = none)
    (rawSelected : selectNextScheduled (rawExecFactsOfSpace space) = some raw)
    (unsupported : decodeSupportedSourceExec raw = none) :
    (sourceExecGSLT .leaveInert).IsNormalForm space ∧
      (sourceExecGSLT .consume).Step space (space.erase raw.atom) := by
  constructor
  · apply (sourceExecGSLT_normalForm_iff .leaveInert space).2
    exact (sourceWorkQueueStep_leaveInert_none_iff space).2 noSupported
  · apply (sourceExecGSLT_step_iff .consume _ _).2
    exact sourceWorkQueueStep_consume_unsupported rawSelected unsupported

/-! ### Closed policy canary -/

private def supportedCanaryAtom : Atom :=
  .expression
    [.symbol "exec", .symbol "0",
      .expression [.symbol ",", .symbol "seed"],
      .expression [.symbol ",", .symbol "answer"]]

/-- A concrete comma-input/comma-output directive belongs to the strict
source-aware vocabulary. -/
theorem supported_exec_canary_decodes :
    (extractSupportedSourceExecFact supportedCanaryAtom).isSome = true :=
  rfl

private def malformedCanaryAtom : Atom :=
  .expression
    [.symbol "exec", .symbol "0", .symbol "unknown-input",
      .expression [.symbol ","]]

private def malformedCanaryRaw : RawExecFact where
  atom := malformedCanaryAtom
  loc := .symbol "0"
  inputExpr := .symbol "unknown-input"
  templateExpr := .expression [.symbol ","]

/-- A concrete unsupported four-field exec is inert under the open-world
profile and erased in one step under the consuming profile. -/
theorem malformed_exec_canary_separates :
    (sourceExecGSLT .leaveInert).IsNormalForm ({malformedCanaryAtom} : Space) ∧
      (sourceExecGSLT .consume).Step ({malformedCanaryAtom} : Space)
        (∅ : Space) := by
  have unsupportedAtom :
      extractSupportedSourceExecFact malformedCanaryAtom = none := rfl
  apply unsupported_exec_separates_source_profiles
      (raw := malformedCanaryRaw)
  · simp [supportedSourceExecFactsOfSpace, unsupportedAtom,
      selectNextScheduled]
  · simp [rawExecFactsOfSpace, extractRawExecFact, malformedCanaryAtom,
      malformedCanaryRaw, selectNextScheduled]
  · rfl

/-! ## Honest bounded observations for every family member -/

/-- Run any MM2 family member for at most `fuel` transitions, retaining the
residual and distinguishing completion from expiration. -/
noncomputable def ExecutionProfile.runReport
    (profile : ExecutionProfile) (space : Space) (fuel : Nat) :
    BoundedRunReport Space Unit :=
  profile.driver.runReport space () fuel

/-- Completion from any family member certifies profile-relative quiescence. -/
theorem ExecutionProfile.runReport_completed_normalForm
    (profile : ExecutionProfile) {space residual : Space} {fuel : Nat}
    (completed : profile.runReport space fuel = .completed residual ()) :
    profile.toGSLT.IsNormalForm residual := by
  apply (profile.normalForm_iff residual).2
  have stopped := profile.driver.runReport_completed_quiescent completed
  cases found : profile.step residual with
  | none => rfl
  | some next => simp [ExecutionProfile.driver, found] at stopped

/-- Expiration from any family member certifies that the retained residual
still has a profile-relative next step. -/
theorem ExecutionProfile.runReport_expired_has_step
    (profile : ExecutionProfile) {space residual : Space} {fuel : Nat}
    (expired : profile.runReport space fuel = .expired residual ()) :
    ∃ next, profile.toGSLT.Step residual next := by
  obtain ⟨next, state, moved⟩ :=
    profile.driver.runReport_expired_has_next expired
  cases state
  refine ⟨next, (profile.toGSLT_step_iff residual next).2 ?_⟩
  cases found : profile.step residual with
  | none => simp [ExecutionProfile.driver, found] at moved
  | some actual =>
      simp [ExecutionProfile.driver, found] at moved
      subst next
      rfl

/-- Every bounded residual is reachable in the corresponding profile GSLT. -/
theorem ExecutionProfile.runReport_reachable
    (profile : ExecutionProfile) (space : Space) (fuel : Nat) :
    profile.toGSLT.MultiStep space (profile.runReport space fuel).term :=
  profile.driver.runReport_multiStep fuel space ()

/-! ## Honest bounded observations -/

/-- Honest MM2 execution for at most `fuel` valid directives.  A completed
report has an inspected quiescent residual; an expired report has an inspected
live residual.  Both retain the complete space and can therefore be resumed. -/
noncomputable def runReport (space : Space) (fuel : Nat) :
    BoundedRunReport Space Unit :=
  validExecDriver.runReport space () fuel

@[simp] theorem runReport_term (space : Space) (fuel : Nat) :
    (runReport space fuel).term = (workQueueRunN fuel space).1 := by
  induction fuel generalizing space with
  | zero =>
      cases moved : workQueueStep space <;>
        simp [runReport, validExecDriver, HostedDriver.runReport,
          workQueueRunN, moved, BoundedRunReport.term,
          BoundedRunReport.configuration]
  | succ fuel induction =>
      cases moved : workQueueStep space with
      | none =>
          simp [runReport, validExecDriver, HostedDriver.runReport,
            workQueueRunN, moved, BoundedRunReport.term,
            BoundedRunReport.configuration]
      | some next =>
          simpa [runReport, validExecDriver, HostedDriver.runReport,
            workQueueRunN, moved, BoundedRunReport.term,
            BoundedRunReport.configuration] using induction next

/-- Zero fuel never executes an available directive; it returns an expired
report carrying the unchanged live space. -/
theorem runReport_zero_of_step {space next : Space}
    (moved : workQueueStep space = some next) :
    runReport space 0 = .expired space () := by
  unfold runReport
  have driverMoved : validExecDriver.step space () = some (next, ()) := by
    change
      (match workQueueStep space with
       | none => none
       | some next => some (next, ())) = some (next, ())
    rw [moved]
  rw [HostedDriver.runReport, driverMoved]
  rfl

/-- A completed report certifies that its residual MM2 space is quiescent. -/
theorem runReport_completed_normalForm
    {space residual : Space} {fuel : Nat}
    (completed : runReport space fuel = .completed residual ()) :
    validExecGSLT.IsNormalForm residual := by
  rw [validExecGSLT_normalForm_iff]
  have stopped := validExecDriver.runReport_completed_quiescent completed
  cases found : workQueueStep residual with
  | none => rfl
  | some next =>
      simp [validExecDriver, found] at stopped

/-- An expired report certifies that its residual MM2 space still has a valid
next directive.  Expiration therefore cannot be confused with quiescence. -/
theorem runReport_expired_has_step
    {space residual : Space} {fuel : Nat}
    (expired : runReport space fuel = .expired residual ()) :
    ∃ next, validExecGSLT.Step residual next := by
  obtain ⟨next, state, moved⟩ :=
    validExecDriver.runReport_expired_has_next expired
  cases state
  refine ⟨next, ?_⟩
  apply (validExecGSLT_step_iff residual next).2
  cases found : workQueueStep residual with
  | none => simp [validExecDriver, found] at moved
  | some actual =>
      simp [validExecDriver, found] at moved
      have actual_eq : actual = next :=
        congrArg Prod.fst (Option.some.inj moved)
      exact congrArg some actual_eq

/-- Every honest bounded residual is reachable in the MM2 GSLT. -/
theorem runReport_reachable (space : Space) (fuel : Nat) :
    validExecGSLT.MultiStep space (runReport space fuel).term :=
  validExecDriver.runReport_multiStep fuel space ()

/-- Resuming an expired zero-fuel report is exactly a fresh honest run from
the retained space. -/
theorem resume_expired_zero_of_step {space next : Space}
    (moved : workQueueStep space = some next) (fuel : Nat) :
    validExecDriver.resume (runReport space 0) fuel = runReport space fuel := by
  rw [runReport_zero_of_step moved]
  rfl

section AxiomAudit

#print axioms selected_compatible_GSLT_step_iff
#print axioms malformed_exec_canary_separates
#print axioms cSourceWorkQueueStep_GSLT_adequate
#print axioms cSourceWorkQueueRunN_GSLT_adequate

end AxiomAudit

end Mettapedia.Languages.ProcessCalculi.MORK
