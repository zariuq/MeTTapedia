import Mettapedia.Languages.ProcessCalculi.MORK.MM2MaximalTokenExecution
import Mettapedia.Languages.ProcessCalculi.MORK.MM2RuleScopedExecution

/-!
# Generated MM2 syntax through rule-scoped execution

This module closes the authored MM2 language pipeline at the execution seam.
The generated parser and independently executable CST elaboration produce the
canonical atom program.  Duplicate occurrences enter support semantics at one
explicit boundary, after which the rule-scoped work-queue GSLT is the sole
transition authority.

The rule-scoped executor distinguishes input variables, which must be matched,
from output-only variables, which bind locally in an emitted expression.  This
is the same distinction used by the native support-transform implementation.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.MORK.MM2MaximalTokenRuleScopedExecution

open Mettapedia.Languages.MeTTa.OSLFCore
open Mettapedia.Languages.ProcessCalculi.MORK
open Mettapedia.Languages.ProcessCalculi.MORK.MM2MaximalTokenElaborationPlan
open Mettapedia.Languages.ProcessCalculi.MORK.MM2Surface
open Mettapedia.Languages.ProcessCalculi.MORK.MM2MaximalTokenSemantics
open Mettapedia.Languages.ProcessCalculi.MORK.MM2MaximalTokenExecution
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis

/-- The parser pipeline uses the exact target type generated by the
rule-scoped execution GSLT itself. -/
noncomputable abbrev ruleScopedExactTargetNativeType
    (policy : UnsupportedExecPolicy) (target : List Atom) :
    GSLTNativeType (ruleScopedNativeListExecGSLT policy) :=
  ruleScopedNativeListExactTargetNativeType policy target

/-- OSLF inhabitation for the rule-scoped target is exactly the executable
work-queue transition. -/
theorem ruleScoped_execution_native_type_iff
    {input : List Nat} (parsed : ParsedProgram input)
    (policy : UnsupportedExecPolicy) (target : List Atom) :
    (gsltOSLF (ruleScopedNativeListExecGSLT policy)).satisfies
        (initialSupport parsed)
        (ruleScopedExactTargetNativeType policy target).pred ↔
      cRuleScopedSourceWorkQueueStep policy (initialSupport parsed) =
        some target := by
  exact satisfies_ruleScopedNativeListExactTargetNativeType_iff_step
    policy (initialSupport parsed) target

/-- A successfully rendered MM2 atom program traverses the generated parser,
the independently executable elaboration GSLT, and the rule-scoped execution
GSLT without introducing another parsing or transition relation. -/
theorem successful_render_ruleScoped_full_pipeline
    {program : List Atom} {rendered : String}
    (renderedExact : renderProgram? program = some rendered) :
    ∃ parsed : PlannedProgram (stringScalars rendered),
      parsed.atoms = program ∧
      (gsltOSLF MM2MaximalTokenElaborationGSLT.theory).satisfies
          (.request parsed.tree)
          (MM2MaximalTokenElaborationGSLT.exactOutcomeNativeType
            (.program parsed.atoms)).pred ∧
      initialSupport parsed.toParsedProgram = program.eraseDups ∧
      ∀ (policy : UnsupportedExecPolicy) (target : List Atom),
        (gsltOSLF (ruleScopedNativeListExecGSLT policy)).satisfies
            (initialSupport parsed.toParsedProgram)
            (ruleScopedExactTargetNativeType policy target).pred ↔
          cRuleScopedSourceWorkQueueStep policy
            (initialSupport parsed.toParsedProgram) = some target := by
  obtain ⟨parsed, atomsExact⟩ :=
    successful_render_has_planned_parser_square renderedExact
  refine ⟨parsed, atomsExact,
    MM2MaximalTokenElaborationGSLT.parsed_program_inhabits_exact_outcome
      parsed, ?_, ?_⟩
  · simp only [initialSupport, atomsExact]
  · intro policy target
    exact ruleScoped_execution_native_type_iff
      parsed.toParsedProgram policy target

/-- The same source-authenticated boundary carries a proof-relevant bounded
execution path.  The executable step count is exactly the path length, so
quiescence cannot masquerade as unrecorded work. -/
theorem successful_render_ruleScoped_bounded_pipeline
    {program : List Atom} {rendered : String}
    (renderedExact : renderProgram? program = some rendered)
    (policy : UnsupportedExecPolicy) (fuel : Nat) :
    ∃ parsed : PlannedProgram (stringScalars rendered),
      parsed.atoms = program ∧
      (gsltOSLF MM2MaximalTokenElaborationGSLT.theory).satisfies
          (.request parsed.tree)
          (MM2MaximalTokenElaborationGSLT.exactOutcomeNativeType
            (.program parsed.atoms)).pred ∧
      initialSupport parsed.toParsedProgram = program.eraseDups ∧
      ∃ path : (ruleScopedNativeListExecGSLT policy).RewritePath
          (initialSupport parsed.toParsedProgram)
          (cRuleScopedSourceWorkQueueRunN policy fuel
            (initialSupport parsed.toParsedProgram)).1,
        path.length =
          (cRuleScopedSourceWorkQueueRunN policy fuel
            (initialSupport parsed.toParsedProgram)).2 := by
  obtain ⟨parsed, atomsExact, elaborates, supportExact, _⟩ :=
    successful_render_ruleScoped_full_pipeline renderedExact
  refine ⟨parsed, atomsExact, elaborates, supportExact, ?_⟩
  exact ⟨cRuleScopedSourceWorkQueueRunN_rewritePath policy fuel
      (initialSupport parsed.toParsedProgram),
    cRuleScopedSourceWorkQueueRunN_rewritePath_length policy fuel
      (initialSupport parsed.toParsedProgram)⟩

/-- The generated syntax reader and executable elaborator connect to a
bounded rule-scoped run whose every primitive transition is classified by the
OSLF-generated exact native type of its successor. -/
theorem successful_render_ruleScoped_native_type_trace_pipeline
    {program : List Atom} {rendered : String}
    (renderedExact : renderProgram? program = some rendered)
    (policy : UnsupportedExecPolicy) (fuel : Nat) :
    ∃ parsed : PlannedProgram (stringScalars rendered),
      parsed.atoms = program ∧
      (gsltOSLF MM2MaximalTokenElaborationGSLT.theory).satisfies
          (.request parsed.tree)
          (MM2MaximalTokenElaborationGSLT.exactOutcomeNativeType
            (.program parsed.atoms)).pred ∧
      initialSupport parsed.toParsedProgram = program.eraseDups ∧
      Nonempty (RuleScopedNativeTypeTrace policy fuel
        (initialSupport parsed.toParsedProgram)
        (cRuleScopedSourceWorkQueueRunN policy fuel
          (initialSupport parsed.toParsedProgram)).1) := by
  obtain ⟨parsed, atomsExact, elaborates, supportExact, _⟩ :=
    successful_render_ruleScoped_bounded_pipeline renderedExact policy fuel
  exact ⟨parsed, atomsExact, elaborates, supportExact,
    ⟨cRuleScopedSourceWorkQueueRunN_nativeTypeTrace policy fuel
      (initialSupport parsed.toParsedProgram)⟩⟩

#print axioms ruleScoped_execution_native_type_iff
#print axioms successful_render_ruleScoped_full_pipeline
#print axioms successful_render_ruleScoped_bounded_pipeline
#print axioms successful_render_ruleScoped_native_type_trace_pipeline

end Mettapedia.Languages.ProcessCalculi.MORK.MM2MaximalTokenRuleScopedExecution
