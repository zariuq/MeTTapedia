import Mettapedia.Languages.ProcessCalculi.MeTTaCalculus.OccurrenceCommits.StaticFootprints

/-!
# Two matchers that meet the specification: syntactic, and modulo commutativity

Terms are constants and binary nodes (`Tm`); patterns add variables (`Pat`). A theory declares which
node symbols commute (`comm : F → Bool`). Its equational theory `E` is **the congruence generated by**
`f(x, y) = f(y, x)` for the commuting `f` (`Conv`): the least equivalence, closed under the
constructors, that contains these equations.

## The theory

* `ceq` decides it structurally: two nodes are equal when their symbols agree and their children
  agree, straight or, for a commuting symbol, crossed. `conv_iff_ceq` proves that `ceq` is exactly
  the generated congruence. So `E` is decidable.
* With no commuting symbol the theory is equality (`ceq_noComm_iff`): syntactic matching is the
  case `E = ∅` of the same layer.
* `termLayer comm` is the term layer of `SourceMatching`, with all its laws proved.

## The matcher

`rawMatch` matches a pattern against a value from a substitution: a bound variable must be `E`-equal
to the value (so a repeated variable means equality modulo `E`), a free one is bound, and a node
tries its children straight and, for a commuting symbol, crossed. `cmatch` removes answers that are
`E`-equivalent to earlier ones.

* **Sound** (`cmatch_sound`), **complete up to `E`** (`cmatch_complete`) and **minimal**
  (`cmatch_minimal`), for every declaration of commuting symbols.
* Without commuting symbols it gives at most one answer (`cmatch_noComm_unitary`).
* `rawMatch` alone is sound and complete and not minimal: modulo commutativity `f($x, $y)`
  against `f(a, a)` answers twice (`SourceControls`).

## Region keys

A key is everything, a head symbol, or a two-symbol path prefix (`Key`). The head of a value is
invariant under the theory, so **head keys are sound for every declaration** (`headKeys_sound`).
Path prefixes are not: the **naive prefix keys** of a pattern, its head and the head of its left
child, are sound for syntactic matching (`naivePrefixKeys_sound`) and unsound modulo commutativity
(`SourceControls`). **Widened prefix keys** take both children's heads for a commuting symbol, and
are sound for the theory (`prefixKeys_sound`): the closure of the naive region under `E`.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.MeTTaCalculus.OccurrenceCommits.Sources.Commutative

universe uF uV

/-- Values: constants and binary nodes. -/
inductive Tm (F : Type uF) where
  | leaf (a : F)
  | node (f : F) (l r : Tm F)
  deriving DecidableEq, Repr

/-- Patterns: values with variables. -/
inductive Pat (V : Type uV) (F : Type uF) where
  | var (v : V)
  | leaf (a : F)
  | node (f : F) (l r : Pat V F)
  deriving DecidableEq, Repr

variable {F : Type uF} [DecidableEq F] {V : Type uV}

/-- The symbol at the root. -/
def Tm.head : Tm F → F
  | .leaf a => a
  | .node f _ _ => f

/-! ## The theory of commuting symbols -/

section Theory

variable (comm : F → Bool)

/-- **The congruence generated by commutativity** of the declared symbols. -/
inductive Conv : Tm F → Tm F → Prop
  | refl (t : Tm F) : Conv t t
  | symm {s t : Tm F} : Conv s t → Conv t s
  | trans {s t u : Tm F} : Conv s t → Conv t u → Conv s u
  | congr (f : F) {l l' r r' : Tm F} : Conv l l' → Conv r r' → Conv (.node f l r) (.node f l' r')
  | swap (f : F) (l r : Tm F) : comm f = true → Conv (.node f l r) (.node f r l)

/-- Equality modulo commutativity, structurally. -/
def ceq : Tm F → Tm F → Bool
  | .leaf a, .leaf b => decide (a = b)
  | .node f l r, .node g l' r' =>
      decide (f = g) && ((ceq l l' && ceq r r') || (comm f && ceq l r' && ceq r l'))
  | .leaf _, .node _ _ _ => false
  | .node _ _ _, .leaf _ => false

variable {comm}

@[simp] theorem ceq_leaf_leaf {a b : F} : ceq comm (.leaf a) (.leaf b) = true ↔ a = b := by
  simp [ceq]

@[simp] theorem ceq_leaf_node {a f : F} {l r : Tm F} : ceq comm (.leaf a) (.node f l r) = false := rfl

@[simp] theorem ceq_node_leaf {a f : F} {l r : Tm F} : ceq comm (.node f l r) (.leaf a) = false := rfl

theorem ceq_node_node {f g : F} {l r l' r' : Tm F} :
    ceq comm (.node f l r) (.node g l' r') = true ↔
      f = g ∧ ((ceq comm l l' = true ∧ ceq comm r r' = true) ∨
        (comm f = true ∧ ceq comm l r' = true ∧ ceq comm r l' = true)) := by
  simp [ceq, and_assoc]

theorem ceq_refl : ∀ t : Tm F, ceq comm t t = true
  | .leaf a => by simp
  | .node f l r => ceq_node_node.mpr ⟨rfl, Or.inl ⟨ceq_refl l, ceq_refl r⟩⟩

theorem ceq_symm : ∀ {s t : Tm F}, ceq comm s t = true → ceq comm t s = true
  | .leaf a, .leaf b, h => by
      rw [ceq_leaf_leaf] at h ⊢
      exact h.symm
  | .leaf _, .node _ _ _, h => by simp at h
  | .node _ _ _, .leaf _, h => by simp at h
  | .node f l r, .node g l' r', h => by
      obtain ⟨rfl, straight | ⟨commF, cross₁, cross₂⟩⟩ := ceq_node_node.mp h
      · exact ceq_node_node.mpr ⟨rfl, Or.inl ⟨ceq_symm straight.1, ceq_symm straight.2⟩⟩
      · exact ceq_node_node.mpr ⟨rfl, Or.inr ⟨commF, ceq_symm cross₂, ceq_symm cross₁⟩⟩

theorem ceq_trans : ∀ {s t u : Tm F}, ceq comm s t = true → ceq comm t u = true → ceq comm s u = true
  | .leaf a, .leaf b, .leaf c, h, k => by
      rw [ceq_leaf_leaf] at h k ⊢
      exact h.trans k
  | .leaf _, .leaf _, .node _ _ _, _, k => by simp at k
  | .leaf _, .node _ _ _, _, h, _ => by simp at h
  | .node _ _ _, .leaf _, _, h, _ => by simp at h
  | .node _ _ _, .node _ _ _, .leaf _, _, k => by simp at k
  | .node f l r, .node g l' r', .node e l'' r'', h, k => by
      obtain ⟨rfl, hs | ⟨commF, h₁, h₂⟩⟩ := ceq_node_node.mp h <;>
        obtain ⟨rfl, ks | ⟨commF', k₁, k₂⟩⟩ := ceq_node_node.mp k
      · exact ceq_node_node.mpr ⟨rfl, Or.inl ⟨ceq_trans hs.1 ks.1, ceq_trans hs.2 ks.2⟩⟩
      · exact ceq_node_node.mpr ⟨rfl, Or.inr ⟨commF', ceq_trans hs.1 k₁, ceq_trans hs.2 k₂⟩⟩
      · exact ceq_node_node.mpr ⟨rfl, Or.inr ⟨commF, ceq_trans h₁ ks.2, ceq_trans h₂ ks.1⟩⟩
      · exact ceq_node_node.mpr ⟨rfl, Or.inl ⟨ceq_trans h₁ k₂, ceq_trans h₂ k₁⟩⟩

theorem ceq_equivalence : Equivalence fun s t : Tm F => ceq comm s t = true :=
  ⟨ceq_refl, ceq_symm, ceq_trans⟩

/-- **`ceq` decides the congruence generated by commutativity.** -/
theorem conv_iff_ceq {s t : Tm F} : Conv comm s t ↔ ceq comm s t = true := by
  constructor
  · intro conv
    induction conv with
    | refl t => exact ceq_refl t
    | symm _ ih => exact ceq_symm ih
    | trans _ _ ih₁ ih₂ => exact ceq_trans ih₁ ih₂
    | congr f _ _ ih₁ ih₂ => exact ceq_node_node.mpr ⟨rfl, Or.inl ⟨ih₁, ih₂⟩⟩
    | swap f l r commF => exact ceq_node_node.mpr ⟨rfl, Or.inr ⟨commF, ceq_refl l, ceq_refl r⟩⟩
  · intro h
    induction s generalizing t with
    | leaf a =>
        cases t with
        | leaf b =>
            rw [ceq_leaf_leaf] at h
            subst h
            exact Conv.refl _
        | node _ _ _ => simp at h
    | node f l r ihl ihr =>
        cases t with
        | leaf _ => simp at h
        | node g l' r' =>
            obtain ⟨rfl, straight | ⟨commF, cross₁, cross₂⟩⟩ := ceq_node_node.mp h
            · exact Conv.congr f (ihl straight.1) (ihr straight.2)
            · exact Conv.trans (Conv.congr f (ihl cross₁) (ihr cross₂)) (Conv.swap f r' l' commF)

/-- The head symbol is invariant under the theory. -/
theorem head_eq_of_ceq : ∀ {s t : Tm F}, ceq comm s t = true → s.head = t.head
  | .leaf a, .leaf b, h => by simpa [Tm.head] using h
  | .leaf _, .node _ _ _, h => by simp at h
  | .node _ _ _, .leaf _, h => by simp at h
  | .node f _ _, .node g _ _, h => (ceq_node_node.mp h).1

/-- **With no commuting symbol, the theory is equality.** -/
theorem ceq_noComm_iff : ∀ {s t : Tm F}, ceq (fun _ => false) s t = true ↔ s = t
  | .leaf a, .leaf b => by simp
  | .leaf _, .node _ _ _ => by simp
  | .node _ _ _, .leaf _ => by simp
  | .node f l r, .node g l' r' => by
      rw [ceq_node_node, ceq_noComm_iff, ceq_noComm_iff]
      simp only [Bool.false_eq_true, false_and, or_false, Tm.node.injEq]

end Theory

/-! ## Patterns and instantiation -/

section Patterns

variable [DecidableEq V]

/-- The variables of a pattern. -/
def Pat.vars : Pat V F → Finset V
  | .var v => {v}
  | .leaf _ => ∅
  | .node _ p q => p.vars ∪ q.vars

/-- The symbol at the root of a pattern, when it is not a variable. -/
def Pat.head? : Pat V F → Option F
  | .var _ => none
  | .leaf a => some a
  | .node f _ _ => some f

/-- Instantiate a pattern. -/
def Pat.inst (σ : Subst V (Tm F)) : Pat V F → Option (Tm F)
  | .var v => σ v
  | .leaf a => some (.leaf a)
  | .node f p q =>
      match p.inst σ, q.inst σ with
      | some l, some r => some (.node f l r)
      | _, _ => none

omit [DecidableEq F] [DecidableEq V] in
theorem Pat.inst_node_eq_some {σ : Subst V (Tm F)} {f : F} {p q : Pat V F} {u : Tm F} :
    (Pat.node f p q).inst σ = some u ↔ ∃ l r, p.inst σ = some l ∧ q.inst σ = some r ∧ u = .node f l r := by
  simp only [Pat.inst]
  cases hp : p.inst σ <;> cases hq : q.inst σ <;> simp [eq_comm]

omit [DecidableEq F] in
theorem Pat.inst_isSome (σ : Subst V (Tm F)) :
    ∀ p : Pat V F, (p.inst σ).isSome ↔ ∀ v ∈ p.vars, (σ v).isSome
  | .var v => by simp [Pat.inst, Pat.vars]
  | .leaf a => by simp [Pat.inst, Pat.vars]
  | .node f p q => by
      have ihp := Pat.inst_isSome σ p
      have ihq := Pat.inst_isSome σ q
      simp only [Pat.inst, Pat.vars, Finset.mem_union]
      cases hp : p.inst σ <;> cases hq : q.inst σ <;> simp_all <;> grind

omit [DecidableEq F] in
theorem Pat.inst_local (σ τ : Subst V (Tm F)) :
    ∀ p : Pat V F, (∀ v ∈ p.vars, σ v = τ v) → p.inst σ = p.inst τ
  | .var v, same => same v (by simp [Pat.vars])
  | .leaf a, _ => rfl
  | .node f p q, same => by
      simp only [Pat.inst]
      rw [Pat.inst_local σ τ p fun v h => same v (by simp [Pat.vars, h]),
        Pat.inst_local σ τ q fun v h => same v (by simp [Pat.vars, h])]

theorem Pat.inst_congr (comm : F → Bool) (σ τ : Subst V (Tm F)) :
    ∀ p : Pat V F, (∀ v ∈ p.vars, Option.Rel (fun s t => ceq comm s t = true) (σ v) (τ v)) →
      Option.Rel (fun s t => ceq comm s t = true) (p.inst σ) (τ |> p.inst)
  | .var v, same => same v (by simp [Pat.vars])
  | .leaf a, _ => Option.Rel.some (ceq_refl _)
  | .node f p q, same => by
      have relP := Pat.inst_congr comm σ τ p fun v h => same v (by simp [Pat.vars, h])
      have relQ := Pat.inst_congr comm σ τ q fun v h => same v (by simp [Pat.vars, h])
      simp only [Pat.inst]
      rcases optionRel_iff.mp relP with ⟨hp, hp'⟩ | ⟨l, l', hp, hp', rl⟩ <;>
        rcases optionRel_iff.mp relQ with ⟨hq, hq'⟩ | ⟨r, r', hq, hq', rr⟩ <;>
        simp only [hp, hp', hq, hq'] <;> try exact Option.Rel.none
      exact Option.Rel.some (ceq_node_node.mpr ⟨rfl, Or.inl ⟨rl, rr⟩⟩)

/-- **The term layer of a declaration of commuting symbols.** -/
def termLayer (comm : F → Bool) : TermLayer V (Tm F) (Pat V F) where
  E s t := ceq comm s t = true
  equivalence := ceq_equivalence
  vars := Pat.vars
  inst σ p := p.inst σ
  inst_bound σ p := (Pat.inst_isSome σ p).mp
  inst_local σ τ p := Pat.inst_local σ τ p
  inst_congr σ τ p := Pat.inst_congr comm σ τ p

/-- **The syntactic layer**: no symbol commutes, and the theory is equality. -/
theorem syntactic_E_iff {s t : Tm F} : (termLayer (V := V) (fun _ => false)).E s t ↔ s = t :=
  ceq_noComm_iff

omit [DecidableEq F] [DecidableEq V] in
/-- An instantiated pattern with a root symbol has that root symbol. -/
theorem Pat.head_inst {σ : Subst V (Tm F)} : ∀ {p : Pat V F} {u : Tm F} {g : F},
    p.head? = some g → p.inst σ = some u → u.head = g
  | .var _, _, _, h, _ => by simp [Pat.head?] at h
  | .leaf a, u, g, h, k => by
      simp only [Pat.head?, Option.some.injEq] at h
      simp only [Pat.inst, Option.some.injEq] at k
      subst h k
      rfl
  | .node f p q, u, g, h, k => by
      simp only [Pat.head?, Option.some.injEq] at h
      obtain ⟨l, r, -, -, rfl⟩ := Pat.inst_node_eq_some.mp k
      subst h
      rfl

end Patterns

/-! ## The matcher -/

section Matcher

variable [DecidableEq V] (comm : F → Bool)

/-- Matching modulo commutativity, with every answer kept. -/
def rawMatch : Pat V F → Subst V (Tm F) → Tm F → List (Subst V (Tm F))
  | .var v, σ, t =>
      match σ v with
      | some u => if ceq comm u t then [σ] else []
      | none => [Function.update σ v (some t)]
  | .leaf a, σ, t => if t = .leaf a then [σ] else []
  | .node f p q, σ, .node g l r =>
      if f = g then
        ((rawMatch p σ l).flatMap fun τ => rawMatch q τ r) ++
          (if comm f then (rawMatch p σ r).flatMap fun τ => rawMatch q τ l else [])
      else []
  | .node _ _ _, _, .leaf _ => []

/-- Two optional values agree modulo the theory. -/
def optCeq : Option (Tm F) → Option (Tm F) → Bool
  | none, none => true
  | some a, some b => ceq comm a b
  | _, _ => false

/-- Two substitutions agree modulo the theory on a set of variables. -/
def SameOn (X : Finset V) (τ τ' : Subst V (Tm F)) : Prop := ∀ v ∈ X, optCeq comm (τ v) (τ' v) = true

instance (X : Finset V) (τ τ' : Subst V (Tm F)) : Decidable (SameOn comm X τ τ') := by
  unfold SameOn
  infer_instance

/-- **The matcher**: `rawMatch` without answers equivalent to earlier ones. -/
def cmatch : Matcher V (Tm F) (Pat V F) := fun p σ t =>
  (rawMatch comm p σ t).pwFilter fun τ τ' => ¬ SameOn comm p.vars τ τ'

variable {comm}

theorem optCeq_iff {a b : Option (Tm F)} :
    optCeq comm a b = true ↔ Option.Rel (fun s t => ceq comm s t = true) a b := by
  constructor
  · intro h
    cases a with
    | none =>
        cases b with
        | none => exact Option.Rel.none
        | some _ => simp [optCeq] at h
    | some x =>
        cases b with
        | none => simp [optCeq] at h
        | some y => exact Option.Rel.some h
  · intro h
    rcases optionRel_iff.mp h with ⟨rfl, rfl⟩ | ⟨x, y, rfl, rfl, related⟩
    · rfl
    · exact related

omit [DecidableEq V] in
theorem sameOn_trans {X : Finset V} {τ₁ τ₂ τ₃ : Subst V (Tm F)} (first : SameOn comm X τ₁ τ₂)
    (second : SameOn comm X τ₂ τ₃) : SameOn comm X τ₁ τ₃ := by
  intro v member
  have one := optCeq_iff.mp (first v member)
  have two := optCeq_iff.mp (second v member)
  rcases optionRel_iff.mp one with ⟨h1, h2⟩ | ⟨x, y, h1, h2, r1⟩ <;>
    rcases optionRel_iff.mp two with ⟨k1, k2⟩ | ⟨x', y', k1, k2, r2⟩
  · rw [h1, k2]; rfl
  · rw [h2] at k1; cases k1
  · rw [h2] at k1; cases k1
  · rw [h2] at k1
    cases k1
    rw [h1, k2]
    exact ceq_trans r1 r2

omit [DecidableEq V] in
theorem sameOn_refl (X : Finset V) (τ : Subst V (Tm F)) : SameOn comm X τ τ := by
  intro v _
  exact optCeq_iff.mpr (optionRel_refl ceq_equivalence _)

/-- **`rawMatch` is sound.** -/
theorem rawMatch_sound : ∀ {p : Pat V F} {σ τ : Subst V (Tm F)} {t : Tm F},
    τ ∈ rawMatch comm p σ t → (termLayer (V := V) comm).Step σ p t τ
  | .var v, σ, τ, t, member => by
      unfold rawMatch at member
      cases hv : σ v with
      | some u =>
          simp only [hv] at member
          by_cases same : ceq comm u t = true
          · rw [if_pos same, List.mem_singleton] at member
            subst member
            exact ⟨Extends.refl _, fun _ _ => rfl, ⟨u, hv, same⟩⟩
          · rw [if_neg same] at member
            simp at member
      | none =>
          simp only [hv, List.mem_singleton] at member
          subst member
          refine ⟨fun w u bound => ?_, fun w notIn => ?_, ⟨t, ?_, ceq_refl t⟩⟩
          · have : w ≠ v := fun h => by rw [h, hv] at bound; cases bound
            simp [Function.update, this, bound]
          · have : w ≠ v := fun h => notIn (by simp [termLayer, Pat.vars, h])
            simp [Function.update, this]
          · simp [termLayer, Pat.inst, Function.update]
  | .leaf a, σ, τ, t, member => by
      unfold rawMatch at member
      by_cases same : t = .leaf a
      · rw [if_pos same, List.mem_singleton] at member
        subst member same
        exact ⟨Extends.refl _, fun _ _ => rfl, ⟨.leaf a, rfl, ceq_refl _⟩⟩
      · rw [if_neg same] at member
        simp at member
  | .node f p q, σ, τ, .leaf _, member => by simp [rawMatch] at member
  | .node f p q, σ, τ, .node g l r, member => by
      unfold rawMatch at member
      by_cases same : f = g
      · subst same
        rw [if_pos rfl, List.mem_append] at member
        have combine : ∀ {τ₁ : Subst V (Tm F)} {x y : Tm F},
            (termLayer (V := V) comm).Step σ p x τ₁ → (termLayer (V := V) comm).Step τ₁ q y τ →
              (termLayer (V := V) comm).Step σ (.node f p q) (.node f x y) τ ∧
                ∃ u v, p.inst τ = some u ∧ q.inst τ = some v ∧ ceq comm u x = true ∧
                  ceq comm v y = true := by
          intro τ₁ x y first second
          obtain ⟨u, instP, relU⟩ := first.solves
          obtain ⟨v, instQ, relV⟩ := second.solves
          have instP' : p.inst τ = some u := by
            have defined : (p.inst τ₁).isSome := by
              show ((termLayer (V := V) comm).inst τ₁ p).isSome
              rw [show (termLayer (V := V) comm).inst τ₁ p = some u from instP]; rfl
            rw [← show p.inst τ₁ = some u from instP]
            refine (Pat.inst_local τ₁ τ p fun w member => ?_).symm
            obtain ⟨x', hx'⟩ := Option.isSome_iff_exists.mp
              ((Pat.inst_isSome τ₁ p).mp defined w member)
            rw [hx', second.extends_ w x' hx']
          refine ⟨⟨first.extends_.trans second.extends_, fun w notIn => ?_, ?_⟩,
            u, v, instP', instQ, relU, relV⟩
          · have notP : w ∉ p.vars := fun h => notIn (by simp [termLayer, Pat.vars, h])
            have notQ : w ∉ q.vars := fun h => notIn (by simp [termLayer, Pat.vars, h])
            rw [second.only w notQ, first.only w notP]
          · refine ⟨.node f u v, ?_, ceq_node_node.mpr ⟨rfl, Or.inl ⟨relU, relV⟩⟩⟩
            exact Pat.inst_node_eq_some.mpr ⟨u, v, instP', instQ, rfl⟩
        rcases member with straight | crossed
        · obtain ⟨τ₁, in₁, in₂⟩ := List.mem_flatMap.mp straight
          exact (combine (rawMatch_sound in₁) (rawMatch_sound in₂)).1
        · by_cases commF : comm f = true
          · rw [if_pos commF] at crossed
            obtain ⟨τ₁, in₁, in₂⟩ := List.mem_flatMap.mp crossed
            obtain ⟨step, u, v, instP, instQ, relU, relV⟩ :=
              combine (rawMatch_sound in₁) (rawMatch_sound in₂)
            refine ⟨step.extends_, step.only, .node f u v,
              Pat.inst_node_eq_some.mpr ⟨u, v, instP, instQ, rfl⟩,
              ceq_node_node.mpr ⟨rfl, Or.inr ⟨commF, relU, relV⟩⟩⟩
          · rw [if_neg commF] at crossed
            simp at crossed
      · rw [if_neg same] at member
        simp at member

/-- **`rawMatch` is complete up to the theory.** -/
theorem rawMatch_complete : ∀ {p : Pat V F} {σ σ' τ' : Subst V (Tm F)} {t : Tm F},
    SubstEquiv (fun s t => ceq comm s t = true) σ σ' → (termLayer (V := V) comm).Step σ' p t τ' →
      ∃ τ ∈ rawMatch comm p σ t, SubstEquiv (fun s t => ceq comm s t = true) τ τ'
  | .var v, σ, σ', τ', t, same, step => by
      obtain ⟨u', instV, relU'⟩ := step.solves
      have tauV : τ' v = some u' := instV
      unfold rawMatch
      rcases optionRel_iff.mp (same v) with ⟨hv, hv'⟩ | ⟨u, u'', hv, hv', rel⟩
      · simp only [hv]
        refine ⟨_, List.mem_singleton_self _, fun w => ?_⟩
        by_cases eq : w = v
        · subst eq
          rw [tauV]
          simp only [Function.update_self]
          exact Option.Rel.some (ceq_symm relU')
        · simp only [Function.update, eq, dite_false]
          rw [step.only w (by simp [termLayer, Pat.vars, eq])]
          exact same w
      · simp only [hv]
        have : u'' = u' := by
          have := step.extends_ v u'' hv'
          rw [tauV] at this
          exact (Option.some.inj this).symm
        subst this
        rw [if_pos (ceq_trans rel relU')]
        refine ⟨σ, List.mem_singleton_self _, fun w => ?_⟩
        by_cases eq : w = v
        · subst eq
          rw [hv, tauV]
          exact Option.Rel.some rel
        · rw [step.only w (by simp [termLayer, Pat.vars, eq])]
          exact same w
  | .leaf a, σ, σ', τ', t, same, step => by
      obtain ⟨u, instA, relU⟩ := step.solves
      have : u = .leaf a := by
        have h : (Pat.leaf a : Pat V F).inst τ' = some u := instA
        simp only [Pat.inst, Option.some.injEq] at h
        exact h.symm
      subst this
      have relU' : ceq comm (.leaf a) t = true := relU
      have tEq : t = .leaf a := by
        cases t with
        | leaf b => rw [ceq_leaf_leaf] at relU'; rw [relU']
        | node _ _ _ => simp at relU'
      unfold rawMatch
      rw [if_pos tEq]
      refine ⟨σ, List.mem_singleton_self _, fun w => ?_⟩
      rw [step.only w (by simp [termLayer, Pat.vars])]
      exact same w
  | .node f p q, σ, σ', τ', t, same, step => by
      obtain ⟨u, instU, relU⟩ := step.solves
      obtain ⟨x, y, instP, instQ, rfl⟩ := Pat.inst_node_eq_some.mp instU
      have relU' : ceq comm (.node f x y) t = true := relU
      cases t with
      | leaf _ => simp at relU'
      | node g l r =>
          obtain ⟨rfl, straight | ⟨commF, cross₁, cross₂⟩⟩ := ceq_node_node.mp relU'
          · -- left child against `l`, right child against `r`
            let τ₁' : Subst V (Tm F) := (termLayer (V := V) comm).onVars p σ' τ'
            have step₁ : (termLayer (V := V) comm).Step σ' p l τ₁' := by
              refine ⟨fun w v bound => ?_, fun w notIn => ?_, ⟨x, ?_, straight.1⟩⟩
              · unfold τ₁' TermLayer.onVars
                split_ifs
                · exact step.extends_ w v bound
                · exact bound
              · have notIn' : w ∉ p.vars := notIn
                simp [τ₁', TermLayer.onVars, termLayer, notIn']
              · show p.inst τ₁' = some x
                rw [← instP]
                exact Pat.inst_local _ _ p fun w member => by
                  simp [τ₁', TermLayer.onVars, termLayer, member]
            have step₂ : (termLayer (V := V) comm).Step τ₁' q r τ' := by
              refine ⟨fun w v bound => ?_, fun w notIn => ?_, ⟨y, instQ, straight.2⟩⟩
              · unfold τ₁' TermLayer.onVars at bound
                split_ifs at bound
                · exact bound
                · exact step.extends_ w v bound
              · unfold τ₁' TermLayer.onVars
                split_ifs with inP
                · rfl
                · refine step.only w fun h => ?_
                  simp only [termLayer, Pat.vars, Finset.mem_union] at h
                  rcases h with h | h
                  · exact inP h
                  · exact notIn h
            obtain ⟨τ₁, in₁, equiv₁⟩ := rawMatch_complete same step₁
            obtain ⟨τ, in₂, equiv₂⟩ := rawMatch_complete equiv₁ step₂
            refine ⟨τ, ?_, equiv₂⟩
            unfold rawMatch
            rw [if_pos rfl]
            exact List.mem_append_left _ (List.mem_flatMap.mpr ⟨τ₁, in₁, in₂⟩)
          · -- crossed: left child against `r`, right child against `l`
            let τ₁' : Subst V (Tm F) := (termLayer (V := V) comm).onVars p σ' τ'
            have step₁ : (termLayer (V := V) comm).Step σ' p r τ₁' := by
              refine ⟨fun w v bound => ?_, fun w notIn => ?_, ⟨x, ?_, cross₁⟩⟩
              · unfold τ₁' TermLayer.onVars
                split_ifs
                · exact step.extends_ w v bound
                · exact bound
              · have notIn' : w ∉ p.vars := notIn
                simp [τ₁', TermLayer.onVars, termLayer, notIn']
              · show p.inst τ₁' = some x
                rw [← instP]
                exact Pat.inst_local _ _ p fun w member => by
                  simp [τ₁', TermLayer.onVars, termLayer, member]
            have step₂ : (termLayer (V := V) comm).Step τ₁' q l τ' := by
              refine ⟨fun w v bound => ?_, fun w notIn => ?_, ⟨y, instQ, cross₂⟩⟩
              · unfold τ₁' TermLayer.onVars at bound
                split_ifs at bound
                · exact bound
                · exact step.extends_ w v bound
              · unfold τ₁' TermLayer.onVars
                split_ifs with inP
                · rfl
                · refine step.only w fun h => ?_
                  simp only [termLayer, Pat.vars, Finset.mem_union] at h
                  rcases h with h | h
                  · exact inP h
                  · exact notIn h
            obtain ⟨τ₁, in₁, equiv₁⟩ := rawMatch_complete same step₁
            obtain ⟨τ, in₂, equiv₂⟩ := rawMatch_complete equiv₁ step₂
            refine ⟨τ, ?_, equiv₂⟩
            unfold rawMatch
            rw [if_pos rfl, if_pos commF]
            exact List.mem_append_right _ (List.mem_flatMap.mpr ⟨τ₁, in₁, in₂⟩)

/-- **The matcher is sound.** -/
theorem cmatch_sound : Matcher.Sound (termLayer (V := V) comm) (cmatch comm) := fun member =>
  rawMatch_sound (List.pwFilter_subset _ member)

theorem substEquiv_of_sameOn {p : Pat V F} {σ τ τ' : Subst V (Tm F)} {t t' : Tm F}
    (step : (termLayer (V := V) comm).Step σ p t τ) (step' : (termLayer (V := V) comm).Step σ p t' τ')
    (same : SameOn comm p.vars τ τ') : SubstEquiv (fun s t => ceq comm s t = true) τ τ' := by
  intro w
  by_cases member : w ∈ p.vars
  · exact optCeq_iff.mp (same w member)
  · rw [step.only w member, step'.only w member]
    exact optionRel_refl ceq_equivalence _

/-- **The matcher is complete up to the theory.** -/
theorem cmatch_complete : Matcher.Complete (termLayer (V := V) comm) (cmatch comm) := by
  intro p σ σ' t τ' same step
  obtain ⟨τ, inRaw, equiv⟩ := rawMatch_complete same step
  have notAll : ¬ ∀ b ∈ cmatch comm p σ t, ¬ SameOn comm p.vars τ b := by
    intro all
    have := (List.forall_mem_pwFilter (R := fun τ τ' => ¬ SameOn comm p.vars τ τ')
      (fun {x y z} notXZ => by
        by_contra both
        push Not at both
        exact notXZ (sameOn_trans both.1 both.2)) τ _).mp all τ inRaw
    exact this (sameOn_refl _ _)
  push Not at notAll
  obtain ⟨b, inMatch, sameB⟩ := notAll
  have stepB := cmatch_sound inMatch
  refine ⟨b, inMatch, SubstEquiv.trans ceq_equivalence ?_ equiv⟩
  exact SubstEquiv.symm ceq_equivalence (substEquiv_of_sameOn (rawMatch_sound inRaw) stepB sameB)

/-- **The matcher is minimal.** -/
theorem cmatch_minimal : Matcher.Minimal (termLayer (V := V) comm) (cmatch comm) := by
  intro p σ t
  refine (List.pairwise_pwFilter _).imp fun {τ τ'} notSame equiv => notSame fun w _ => ?_
  exact optCeq_iff.mpr (equiv w)

/-- Without commuting symbols, `rawMatch` gives at most one answer. -/
theorem rawMatch_noComm_length : ∀ (p : Pat V F) (σ : Subst V (Tm F)) (t : Tm F),
    (rawMatch (fun _ => false) p σ t).length ≤ 1
  | .var v, σ, t => by
      unfold rawMatch
      split
      · split_ifs <;> simp
      · simp
  | .leaf a, σ, t => by
      unfold rawMatch
      split_ifs <;> simp
  | .node f p q, σ, .leaf _ => by simp [rawMatch]
  | .node f p q, σ, .node g l r => by
      unfold rawMatch
      by_cases same : f = g
      · rw [if_pos same]
        simp only [Bool.false_eq_true, ↓reduceIte, List.append_nil]
        have first := rawMatch_noComm_length p σ l
        cases h : rawMatch (fun _ => false) p σ l with
        | nil => simp
        | cons τ rest =>
            cases rest with
            | nil => simpa using rawMatch_noComm_length q τ r
            | cons _ _ => simp [h] at first
      · rw [if_neg same]
        simp

/-- **The syntactic matcher is unitary.** -/
theorem cmatch_noComm_unitary : Matcher.Unitary (cmatch (V := V) (F := F) (fun _ => false)) :=
  fun p σ t => (List.pwFilter_sublist _).length_le.trans (rawMatch_noComm_length p σ t)

end Matcher

/-! ## Region keys -/

/-- A region key: everything, a head symbol, or a path prefix of two symbols. -/
inductive Key (F : Type uF) where
  | any
  | head (f : F)
  | prefix (f g : F)
  deriving DecidableEq, Repr

/-- What a key covers. -/
def Key.covers : Key F → Tm F → Prop
  | .any, _ => True
  | .head f, t => t.head = f
  | .prefix f g, t => ∃ l r, t = .node f l r ∧ l.head = g

/-- A syntactic test that two keys cover no value in common. -/
def Key.apart : Key F → Key F → Bool
  | .head f, .head g => decide (f ≠ g)
  | .head f, .prefix g _ => decide (f ≠ g)
  | .prefix g _, .head f => decide (f ≠ g)
  | .prefix f g, .prefix f' g' => decide (f ≠ f' ∨ g ≠ g')
  | _, _ => false

theorem Key.apart_sound : ∀ k k' : Key F, k.apart k' = true → ∀ t, k.covers t → k'.covers t → False
  | .any, _, h, _, _, _ => by simp [Key.apart] at h
  | .head _, .any, h, _, _, _ => by simp [Key.apart] at h
  | .prefix _ _, .any, h, _, _, _ => by simp [Key.apart] at h
  | .head f, .head g, h, t, c, c' => by
      simp only [Key.apart, decide_eq_true_eq] at h
      exact h (c.symm.trans c')
  | .head f, .prefix g _, h, t, c, c' => by
      simp only [Key.apart, decide_eq_true_eq] at h
      obtain ⟨l, r, rfl, -⟩ := c'
      exact h c.symm
  | .prefix g _, .head f, h, t, c, c' => by
      simp only [Key.apart, decide_eq_true_eq] at h
      obtain ⟨l, r, rfl, -⟩ := c
      exact h c'.symm
  | .prefix f g, .prefix f' g', h, t, c, c' => by
      simp only [Key.apart, decide_eq_true_eq] at h
      obtain ⟨l, r, rfl, hl⟩ := c
      obtain ⟨l', r', same, hl'⟩ := c'
      simp only [Tm.node.injEq] at same
      obtain ⟨rfl, rfl, rfl⟩ := same
      rcases h with h | h
      · exact h rfl
      · exact h (hl.symm.trans hl')

variable [DecidableEq V]

/-- Region keys over terms, from a choice of the keys of a pattern. -/
def regionKeys (keys : Pat V F → List (Key F)) : RegionKeys (Tm F) (Pat V F) (Key F) where
  covers := Key.covers
  keys := keys
  apart := Key.apart
  apart_sound := Key.apart_sound

/-- **Head keys**: the root symbol of a pattern. -/
def headKeys : Pat V F → List (Key F)
  | .var _ => [.any]
  | .leaf a => [.head a]
  | .node f _ _ => [.head f]

/-- **Naive prefix keys**: the root symbol and the root of the left child. -/
def naivePrefixKeys : Pat V F → List (Key F)
  | .var _ => [.any]
  | .leaf a => [.head a]
  | .node f p _ =>
      match p.head? with
      | some g => [.prefix f g]
      | none => [.head f]

/-- **Prefix keys widened by the theory**: for a commuting symbol, either child may come first. -/
def prefixKeys (comm : F → Bool) : Pat V F → List (Key F)
  | .var _ => [.any]
  | .leaf a => [.head a]
  | .node f p q =>
      if comm f then
        match p.head?, q.head? with
        | some g, some h => [.prefix f g, .prefix f h]
        | _, _ => [.head f]
      else
        match p.head? with
        | some g => [.prefix f g]
        | none => [.head f]

theorem solves_leaf {comm : F → Bool} {σ : Subst V (Tm F)} {a : F} {t : Tm F}
    (solves : (termLayer (V := V) comm).Solves σ (.leaf a) t) : t = .leaf a := by
  obtain ⟨u, inst, rel⟩ := solves
  have : u = .leaf a := by
    have h : (Pat.leaf a : Pat V F).inst σ = some u := inst
    simp only [Pat.inst, Option.some.injEq] at h
    exact h.symm
  subst this
  cases t with
  | leaf b => rw [show (termLayer (V := V) comm).E _ _ ↔ _ from ceq_leaf_leaf] at rel; rw [rel]
  | node _ _ _ => exact absurd rel (by simp [termLayer])

theorem solves_node {comm : F → Bool} {σ : Subst V (Tm F)} {f : F} {p q : Pat V F} {t : Tm F}
    (solves : (termLayer (V := V) comm).Solves σ (.node f p q) t) :
    ∃ u v l r, p.inst σ = some u ∧ q.inst σ = some v ∧ t = .node f l r ∧
      ((ceq comm u l = true ∧ ceq comm v r = true) ∨
        (comm f = true ∧ ceq comm u r = true ∧ ceq comm v l = true)) := by
  obtain ⟨w, inst, rel⟩ := solves
  obtain ⟨u, v, instP, instQ, rfl⟩ := Pat.inst_node_eq_some.mp inst
  cases t with
  | leaf _ => exact absurd rel (by simp [termLayer])
  | node g l r =>
      obtain ⟨rfl, cases⟩ := ceq_node_node.mp rel
      exact ⟨u, v, l, r, instP, instQ, rfl, cases⟩

/-- **Head keys are sound for every declaration**: the head is invariant under the theory. -/
theorem headKeys_sound (comm : F → Bool) :
    (regionKeys (V := V) headKeys).Sound (termLayer (V := V) comm) := by
  intro σ p t solves
  cases p with
  | var v => exact ⟨.any, by simp [regionKeys, headKeys], trivial⟩
  | leaf a =>
      rw [solves_leaf solves]
      exact ⟨.head a, by simp [regionKeys, headKeys], rfl⟩
  | node f p q =>
      obtain ⟨u, v, l, r, -, -, rfl, -⟩ := solves_node solves
      exact ⟨.head f, by simp [regionKeys, headKeys], rfl⟩

/-- **Naive prefix keys are sound for syntactic matching.** -/
theorem naivePrefixKeys_sound :
    (regionKeys (V := V) naivePrefixKeys).Sound (termLayer (V := V) (fun _ : F => false)) := by
  intro σ p t solves
  cases p with
  | var v => exact ⟨.any, by simp [regionKeys, naivePrefixKeys], trivial⟩
  | leaf a =>
      rw [solves_leaf solves]
      exact ⟨.head a, by simp [regionKeys, naivePrefixKeys], rfl⟩
  | node f p q =>
      obtain ⟨u, v, l, r, instP, -, rfl, cases⟩ := solves_node solves
      simp only [Bool.false_eq_true, false_and, or_false] at cases
      cases hp : p.head? with
      | none => exact ⟨.head f, by simp [regionKeys, naivePrefixKeys, hp], rfl⟩
      | some g =>
          refine ⟨.prefix f g, by simp [regionKeys, naivePrefixKeys, hp], l, r, rfl, ?_⟩
          rw [← head_eq_of_ceq cases.1]
          exact Pat.head_inst hp instP

/-- **Widened prefix keys are sound for the theory.** -/
theorem prefixKeys_sound (comm : F → Bool) :
    (regionKeys (V := V) (prefixKeys comm)).Sound (termLayer (V := V) comm) := by
  intro σ p t solves
  cases p with
  | var v => exact ⟨.any, by simp [regionKeys, prefixKeys], trivial⟩
  | leaf a =>
      rw [solves_leaf solves]
      exact ⟨.head a, by simp [regionKeys, prefixKeys], rfl⟩
  | node f p q =>
      obtain ⟨u, v, l, r, instP, instQ, rfl, cases⟩ := solves_node solves
      by_cases commF : comm f = true
      · cases hp : p.head? with
        | none => exact ⟨.head f, by simp [regionKeys, prefixKeys, commF, hp], rfl⟩
        | some g =>
            cases hq : q.head? with
            | none => exact ⟨.head f, by simp [regionKeys, prefixKeys, commF, hp, hq], rfl⟩
            | some h =>
                rcases cases with straight | ⟨-, cross₁, cross₂⟩
                · refine ⟨.prefix f g, by simp [regionKeys, prefixKeys, commF, hp, hq], l, r, rfl, ?_⟩
                  rw [← head_eq_of_ceq straight.1]
                  exact Pat.head_inst hp instP
                · refine ⟨.prefix f h, by simp [regionKeys, prefixKeys, commF, hp, hq], l, r, rfl, ?_⟩
                  rw [← head_eq_of_ceq cross₂]
                  exact Pat.head_inst hq instQ
      · have straight : ceq comm u l = true ∧ ceq comm v r = true := by
          rcases cases with h | ⟨h, -⟩
          · exact h
          · exact absurd h commF
        cases hp : p.head? with
        | none => exact ⟨.head f, by simp [regionKeys, prefixKeys, commF, hp], rfl⟩
        | some g =>
            refine ⟨.prefix f g, by simp [regionKeys, prefixKeys, commF, hp], l, r, rfl, ?_⟩
            rw [← head_eq_of_ceq straight.1]
            exact Pat.head_inst hp instP

end Mettapedia.Languages.ProcessCalculi.MeTTaCalculus.OccurrenceCommits.Sources.Commutative
