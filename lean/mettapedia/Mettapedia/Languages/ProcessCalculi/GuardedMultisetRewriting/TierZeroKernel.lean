import Mettapedia.Languages.ProcessCalculi.GuardedMultisetRewriting.Calculus
import Mettapedia.Languages.ProcessCalculi.GuardedMultisetRewriting.Examples

/-!
# Tier zero is the guarded rewriting calculus itself

An installed guarded rewriting rule is read declaratively as an inference rule: the
theorem-space values it gathers are its premises, and each theorem-space value
it makes is a conclusion. `Derivable` is the least closure of the initial
theorems under those actual rule instances.

There is no proof walker or kernel program here. A proof certificate is a
schedule of calculus steps. The main theorem says that, when only the kernel
process can send to the theorem space, every theorem after any system run is
derivable from the initial theorems by the kernel's installed rules.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.GuardedMultisetRewriting.TierZeroKernel

open Mettapedia.Languages.ProcessCalculi.MeTTaCalculus.OccurrenceCommits.Sources
open Mettapedia.Languages.ProcessCalculi.MeTTaCalculus.InteractionTypes
open Mettapedia.Languages.ProcessCalculi.GuardedMultisetRewriting

universe uI uV uT uP uN

variable {I : Type uI} {V : Type uV} {T : Type uT} {P : Type uP} {N : Type uN}

/-- The independent declarative reading of installed step instances. -/
inductive Derivable (initial : T → Prop) (infers : Multiset T → T → Prop) : T → Prop
  | initial {judgment : T} : initial judgment → Derivable initial infers judgment
  | infer {premises : Multiset T} {conclusion : T} :
      infers premises conclusion →
      (∀ premise ∈ premises, Derivable initial infers premise) →
      Derivable initial infers conclusion

/-- Every value currently at the theorem space has an independent derivation. -/
def AllDerivable (C : Calculus V T P N) (theorems : N) (D : T → Prop)
    (state : Multiset T) : Prop :=
  ∀ judgment ∈ state, C.space judgment = theorems → D judgment

/-- One declarative inference represented by one installed guarded rewriting rule. Its
premises are exactly the theorem-space part of the values gathered by take or
read. Checks retain their ordinary step semantics in the source state. -/
def RuleInstance [DecidableEq N] (C : Calculus V T P N) (contract : Contract) (rule : Rule V T P)
    (theorems : N) (premises : Multiset T) (conclusion : T) : Prop :=
  ∃ (σ : Subst V T) (frame taken kept : Multiset T) (made : List T),
    BindsOnlyGathers (C.readers.layer contract) rule σ ∧
    Matches (C.readers.layer contract) σ rule.take taken ∧
    Reads (C.readers.layer contract) σ rule.read kept ∧
    (∀ check ∈ rule.checks,
      check.holds σ (matchesIn (C.readers.layer contract) σ check.pattern
        (frame + taken + kept))) ∧
    instTemplate (C.readers.layer contract) σ rule.produce = some made ∧
    premises = snapshot C.space theorems (taken + kept) ∧
    conclusion ∈ made ∧ C.space conclusion = theorems

/-- The inference relation generated by the rules installed in one process. -/
def InstalledInfers [DecidableEq N] (C : Calculus V T P N) (theorems : N)
    (rules : List (Contract × Rule V T P)) (premises : Multiset T) (conclusion : T) : Prop :=
  ∃ installed ∈ rules, RuleInstance C installed.1 installed.2 theorems premises conclusion

/-- **One kernel process step preserves theorem-space derivability.** The
declarative rule instance is extracted from the same witnesses as the guarded rewriting
step; no second execution semantics is introduced. -/
theorem Calculus.Process.Step.allDerivable
    [DecidableEq N] {C : Calculus V T P N} {process : C.Process}
    {before after : Multiset T} (step : process.Step before after)
    {theorems : N} {initial : T → Prop}
    (validBefore : AllDerivable C theorems
      (Derivable initial (InstalledInfers C theorems process.rules)) before) :
    AllDerivable C theorems
      (Derivable initial (InstalledInfers C theorems process.rules)) after := by
  obtain ⟨installed, installedMem, σ, frame, taken, kept, made, binds, takes, reads,
    beforeEq, checks, makes, afterEq⟩ := step
  have checksAtFrame := checks
  rw [beforeEq] at checksAtFrame
  intro judgment judgmentAfter atTheorems
  rw [afterEq] at judgmentAfter
  rcases Multiset.mem_add.mp judgmentAfter with survived | produced
  · apply validBefore judgment
    · rw [beforeEq]
      rcases Multiset.mem_add.mp survived with inFrame | inKept
      · exact Multiset.mem_add.mpr (Or.inl (Multiset.mem_add.mpr (Or.inl inFrame)))
      · exact Multiset.mem_add.mpr (Or.inr inKept)
    · exact atTheorems
  · apply Derivable.infer
      (infers := InstalledInfers C theorems process.rules)
      (premises := snapshot C.space theorems (taken + kept))
    · exact ⟨installed, installedMem, σ, frame, taken, kept, made, binds, takes, reads,
        checksAtFrame, makes, rfl, by simpa using produced, atTheorems⟩
    · intro premise premiseMember
      have selected := Multiset.mem_filter.mp premiseMember
      apply validBefore premise
      · rw [beforeEq]
        rcases Multiset.mem_add.mp selected.1 with inTaken | inKept
        · exact Multiset.mem_add.mpr (Or.inl (Multiset.mem_add.mpr (Or.inr inTaken)))
        · exact Multiset.mem_add.mpr (Or.inr inKept)
      · exact selected.2

/-- A system whose distinguished kernel process is the sole holder of `send`
at the theorem space. Every process is already formed by `Calculus.Process`. -/
structure System (C : Calculus V T P N) (I : Type uI) (theorems : N) where
  process : I → C.Process
  kernel : I
  soleWriter : ∀ actor, actor ≠ kernel → (process actor).rights theorems .send = false

namespace System

variable {C : Calculus V T P N} {theorems : N}
variable (system : System C I theorems)

/-- One system action is exactly one guarded rewriting process step. -/
def Step (actor : I) (before after : Multiset T) : Prop :=
  (system.process actor).Step before after

/-- A proof certificate is a schedule of core process steps. -/
inductive Run : Multiset T → List I → Multiset T → Prop
  | nil (state : Multiset T) : Run state [] state
  | cons {before middle after : Multiset T} {actor : I} {schedule : List I} :
      system.Step actor before middle → Run middle schedule after →
      Run before (actor :: schedule) after

/-- One action preserves derivability from the kernel's installed rules. -/
theorem step_allDerivable [DecidableEq N] {actor : I} {before after : Multiset T}
    (step : system.Step actor before after) {initial : T → Prop}
    (validBefore : AllDerivable C theorems
      (Derivable initial
        (InstalledInfers C theorems (system.process system.kernel).rules)) before) :
    AllDerivable C theorems
      (Derivable initial
        (InstalledInfers C theorems (system.process system.kernel).rules)) after := by
  by_cases isKernel : actor = system.kernel
  · subst actor
    exact Calculus.Process.Step.allDerivable step validBefore
  · have noNew := Calculus.Process.Step.no_make_without_send step
      (system.soleWriter actor isKernel)
    intro judgment judgmentAfter atTheorems
    have afterSnapshot : judgment ∈ snapshot C.space theorems after := by
      apply Multiset.mem_filter.mpr
      exact ⟨judgmentAfter, by simp [atTheorems]⟩
    have beforeSnapshot := Multiset.mem_of_le noNew afterSnapshot
    exact validBefore judgment (Multiset.mem_filter.mp beforeSnapshot).1 atTheorems

/-- **The core tier-zero theorem.** After any schedule of guarded rewriting steps, every
theorem-space value is in the least closure of the initial theorems under the
kernel process's installed rule instances. -/
theorem run_allDerivable [DecidableEq N] {before after : Multiset T}
    {schedule : List I} (run : system.Run before schedule after) {initial : T → Prop}
    (validBefore : AllDerivable C theorems
      (Derivable initial
        (InstalledInfers C theorems (system.process system.kernel).rules)) before) :
    AllDerivable C theorems
      (Derivable initial
        (InstalledInfers C theorems (system.process system.kernel).rules)) after := by
  induction run with
  | nil => exact validBefore
  | cons step rest inductionHypothesis =>
      exact inductionHypothesis (system.step_allDerivable step validBefore)

end System

/-! ## Controls on the real guarded rewriting step -/

namespace Controls

open Mettapedia.Languages.ProcessCalculi.GuardedMultisetRewriting.Examples
open Mettapedia.Languages.ProcessCalculi.MeTTaCalculus.OccurrenceCommits.Sources.Controls
open Mettapedia.Languages.ProcessCalculi.MeTTaCalculus.OccurrenceCommits.Sources.Commutative

def core : Calculus Nat (Tm Sig) (Pat Nat Sig) Unit where
  asValues := Ls
  asSyntax := Ls
  finer _ _ relation := relation
  space _ := ()

def allRights : Rights Unit := fun _ _ => true
def noRights : Rights Unit := fun _ _ => false

theorem twoReads_formed : core.Formed allRights .data twoReads := by
  constructor <;> intro pattern member σ term evidence <;> rfl

def kernel : core.Process :=
  ⟨allRights, [(.data, twoReads)], fun installed member => by
    obtain rfl := List.mem_singleton.mp member
    exact twoReads_formed⟩

theorem core_step : kernel.Step {k .tok} {k .tok, k .out} :=
  ⟨(.data, twoReads), by simp [kernel], shared_read_steps⟩

def initial : Tm Sig → Prop := fun judgment => judgment = k .tok

theorem initial_valid :
    AllDerivable core ()
      (Derivable initial (InstalledInfers core () kernel.rules)) {k .tok} := by
  intro judgment member _
  simp only [Multiset.mem_singleton] at member
  subst judgment
  exact .initial rfl

/-- Positive: running the installed step makes `out`, and the independent
closure derives it from the gathered `tok`. -/
theorem made_theorem_is_derivable :
    Derivable initial (InstalledInfers core () kernel.rules) (k .out) := by
  have after := Calculus.Process.Step.allDerivable core_step initial_valid
  exact after (k .out) (by simp) rfl

/-- Negative formation control: a process with no `send` right cannot install
the theorem-producing rule as a formed rule. -/
theorem producer_without_send_is_not_formed :
    ¬core.Formed noRights .data twoReads := by
  intro formed
  have denied := formed.produce (.leaf .out) (by simp [twoReads])
    (empty : Subst Nat (Tm Sig)) (k .out) rfl
  simp [noRights] at denied

end Controls

end Mettapedia.Languages.ProcessCalculi.GuardedMultisetRewriting.TierZeroKernel
