import Mettapedia.Languages.PartrecMachine.UndecidableEquivalence
import Mettapedia.GSLT.LanguageDef.ContinuedCategory

/-!
# No continued structure on the history theory has an effective section

A continued interactive theory carries a section on the fibre selected by an
admitted reflection profile, relative to the equivalence that profile
selects.  This module shows that over the history theory that section is
never effective, whatever the profile and whatever the remaining structure.

Two facts connect the continued section to the equivalence already analysed.

* The history language admits no reflective presentation: such a
  presentation needs a constructor from one sort to another and a constructor
  back, and the signature has no such pair.  So every admitted profile has no
  presentation, its fibre is the ordinary closed fibre, and its equivalence is
  generated by the authored equations alone.
* On that fibre the two histories of a configuration are identified by the
  section exactly when the configuration halts.

The statement is about continued theories whose underlying iGSLT is the
history theory itself.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.PartrecMachine

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.PatternCode
open Mettapedia.OSLF.MeTTaIL.ContextualStep
open Mettapedia.GSLT.LanguageDef
open Mettapedia.GSLT.LanguageDef.WellSorted
open Mettapedia.GSLT.LanguageDef.EquationSemantics
open Mettapedia.GSLT.LanguageDef.ReflectionExtension
open Mettapedia.GSLT.LanguageDef.ReflectiveEquationSemantics

/-! ## The history language admits no reflective presentation -/

/-- The two constructors have the shape a reflective presentation needs: one
plain parameter each, of each other's result sort, the two sorts distinct. -/
def reflectivePair (quote drop : GrammarRule) : Bool :=
  match quote.params, drop.params with
  | [.simple _ (.base processSort)], [.simple _ (.base nameSort)] =>
      quote.category == nameSort && drop.category == processSort &&
        processSort != nameSort
  | _, _ => false

theorem historyTerms_no_reflectivePair :
    historyTerms.all (fun quote =>
      historyTerms.all fun drop => !reflectivePair quote drop) = true := by
  decide +kernel

/-- Every admitted reflection profile of the history language is free of
presentations. -/
theorem historyMachine_presentations_eq_nil (reflection : AdmittedProfile historyMachine) :
    reflection.1.presentations = [] := by
  apply List.eq_nil_iff_forall_not_mem.mpr
  intro presentation membership
  have clean :=
    Mettapedia.OSLF.MeTTaIL.Reflection.presentation_validate_eq_nil_of_validate_eq_nil
      reflection.2 membership
  obtain ⟨witness⟩ :=
    LanguageDef.reflectivePresentationWitness_of_validate_eq_nil historyMachine presentation
      clean
  have quoteMember : witness.quote ∈ historyTerms := by
    have listed : witness.quote ∈ historyMachine.terms.filter
        (fun term => term.label == presentation.quoteConstructor) := by
      rw [witness.quoteUnique]
      exact List.mem_singleton.mpr rfl
    exact (List.mem_filter.mp listed).1
  have dropMember : witness.drop ∈ historyTerms := by
    have listed : witness.drop ∈ historyMachine.terms.filter
        (fun term => term.label == presentation.dropConstructor) := by
      rw [witness.dropUnique]
      exact List.mem_singleton.mpr rfl
    exact (List.mem_filter.mp listed).1
  have excluded := List.all_eq_true.mp
    (List.all_eq_true.mp historyTerms_no_reflectivePair _ quoteMember) _ dropMember
  simp [reflectivePair, witness.quoteParameters, witness.dropParameters,
    witness.quoteCategory, witness.dropCategory, witness.sortsDistinct] at excluded

/-! ## The reflective fibre is the fibre of history terms -/

/-- The closed interacting fibre selected by an admitted profile. -/
abbrev ReflectiveHistory (reflection : AdmittedProfile historyMachine) :=
  ReflectiveWellSorted.OpenTerm reflection.1 historyMachine FreeTypeContext.empty []
    historyPresentation.interactingLangSort

/-- A history term as a member of the reflective fibre. -/
def History.toReflective (reflection : AdmittedProfile historyMachine) (history : History) :
    ReflectiveHistory reflection :=
  ⟨history.1, ⟨history.2.typed.1, history.2.typed.2.2, history.2.typed.2.1,
      history.2.typed.1.isWellScopedAt⟩, by
    intro presentation membership
    rw [historyMachine_presentations_eq_nil reflection] at membership
    cases membership⟩

/-- Every member of the reflective fibre is a history term. -/
theorem ReflectiveHistory.histTerm {reflection : AdmittedProfile historyMachine}
    (term : ReflectiveHistory reflection) : HistTerm term.1 :=
  histTerm_of_typed term.2.1.1 term.2.1.2.2.1

/-- With no presentation, a reflective equation step is an authored one. -/
theorem contextStep_of_reflective {reflection : AdmittedProfile historyMachine}
    {base : BasePremiseEvaluator} {source target : Pattern}
    (step : ReflectiveEquationContextStep reflection.1 base historyMachine source target) :
    EquationContextStep base historyMachine source target := by
  cases step with
  | core authored => exact authored
  | reflectiveInContext context membership _ =>
      have listed := membership
      rw [historyMachine_presentations_eq_nil reflection] at listed
      cases listed

/-- An equivalence through history terms is an equivalence in the reflective
fibre. -/
theorem reflective_of_historyEquivalent (reflection : AdmittedProfile historyMachine)
    {left right : History}
    (equivalent : Relation.EqvGen (historyStep defaultBasePremises) left right) :
    (reflectiveOpenPatternEquationSetoid reflection.1 defaultBasePremises historyMachine
        FreeTypeContext.empty [] (.base historyPresentation.interactingLangSort.1)).r
      (History.toReflective reflection left) (History.toReflective reflection right) := by
  induction equivalent with
  | rel left right step => exact Relation.EqvGen.rel _ _ (.core step)
  | refl history => exact Relation.EqvGen.refl _
  | symm left right _ recurse => exact Relation.EqvGen.symm _ _ recurse
  | trans left middle right _ _ first second => exact Relation.EqvGen.trans _ _ _ first second

/-- Equal members of the reflective fibre make claims of equal truth. -/
theorem holds_iff_of_reflective {reflection : AdmittedProfile historyMachine}
    {left right : ReflectiveHistory reflection}
    (equivalent :
      (reflectiveOpenPatternEquationSetoid reflection.1 defaultBasePremises historyMachine
        FreeTypeContext.empty [] (.base historyPresentation.interactingLangSort.1)).r
        left right) :
    Holds left.1 ↔ Holds right.1 := by
  change Relation.EqvGen
    (reflectiveOpenPatternEquationGenerator reflection.1 defaultBasePremises historyMachine
      FreeTypeContext.empty [] (.base historyPresentation.interactingLangSort.1))
    left right at equivalent
  induction equivalent with
  | rel left right step =>
      exact holds_iff_of_contextStep (ReflectiveHistory.histTerm left)
        (ReflectiveHistory.histTerm right) (contextStep_of_reflective step)
  | refl term => exact Iff.rfl
  | symm left right _ recurse => exact recurse.symm
  | trans left middle right _ _ first second => exact first.trans second

/-- **A continued section identifies the two histories of a configuration
exactly when the configuration halts.** -/
theorem reflective_normalize_eq_iff (reflection : AdmittedProfile historyMachine)
    (canonical : ComputableReflectiveFiberSection historyTheory reflection)
    {configuration : Pattern} (image : InImage configuration) :
    canonical.normalize
        (History.toReflective reflection ⟨now configuration, .ofNow image⟩) =
      canonical.normalize
        (History.toReflective reflection ⟨flag configuration, .ofFlag image⟩) ↔
      Halts configuration := by
  constructor
  · intro same
    have nowEquivalent := canonical.equivalent
      (History.toReflective reflection ⟨now configuration, .ofNow image⟩)
    have flagEquivalent := canonical.equivalent
      (History.toReflective reflection ⟨flag configuration, .ofFlag image⟩)
    rw [same] at nowEquivalent
    have equivalent :=
      (reflectiveOpenPatternEquationSetoid reflection.1 defaultBasePremises historyMachine
        FreeTypeContext.empty [] (.base historyPresentation.interactingLangSort.1)).iseqv.trans
        ((reflectiveOpenPatternEquationSetoid reflection.1 defaultBasePremises historyMachine
          FreeTypeContext.empty []
          (.base historyPresentation.interactingLangSort.1)).iseqv.symm nowEquivalent)
        flagEquivalent
    exact holds_now_iff.mp ((holds_iff_of_reflective equivalent).mpr (Holds.ofFlag _))
  · intro halts
    exact canonical.complete (reflective_of_historyEquivalent reflection
      (now_equivalent_flag_of_halts defaultBasePremises image halts))

/-- No section on the reflective fibre of the history theory is tracked by a
computable function on codes. -/
theorem no_effective_reflective_section (reflection : AdmittedProfile historyMachine)
    (canonical : ComputableReflectiveFiberSection historyTheory reflection) :
    ¬ ∃ track : ℕ → ℕ, Computable track ∧
      ∀ term : ReflectiveHistory reflection,
        patternCode (canonical.normalize term).1 = track (patternCode term.1) := by
  rintro ⟨track, trackComputable, tracks⟩
  apply probe_halts_not_computable
  have decided : ComputablePred fun index : ℕ =>
      track (patternCode (now (probe index))) = track (patternCode (flag (probe index))) :=
    ⟨fun _ => inferInstance,
      (Primrec.eq (α := ℕ)).decide.to_comp.comp
        (trackComputable.comp computable_patternCode_now_probe)
        (trackComputable.comp computable_patternCode_flag_probe)⟩
  refine decided.of_eq fun index => ?_
  rw [← reflective_normalize_eq_iff reflection canonical (probe_inImage index)]
  have nowTracked := tracks
    (History.toReflective reflection ⟨now (probe index), .ofNow (probe_inImage index)⟩)
  have flagTracked := tracks
    (History.toReflective reflection ⟨flag (probe index), .ofFlag (probe_inImage index)⟩)
  constructor
  · intro same
    apply Subtype.ext
    apply patternCode_injective
    exact nowTracked.trans (same.trans flagTracked.symm)
  · intro same
    exact nowTracked.symm.trans
      ((congrArg (fun term : ReflectiveHistory reflection => patternCode term.1) same).trans
        flagTracked)

/-- The same statement for any iGSLT equal to the history theory. -/
theorem no_effective_section_of_theory_eq (theory : IGSLT) (same : theory = historyTheory)
    (reflection : AdmittedProfile theory.presentation.presentation.language)
    (canonical : ComputableReflectiveFiberSection theory reflection) :
    ¬ ∃ track : ℕ → ℕ, Computable track ∧
      ∀ term : ReflectiveWellSorted.OpenTerm reflection.1
          theory.presentation.presentation.language FreeTypeContext.empty []
          theory.presentation.interactingLangSort,
        patternCode (canonical.normalize term).1 = track (patternCode term.1) := by
  subst same
  exact no_effective_reflective_section reflection canonical

/-- **No continued interactive theory over the history theory has an
effective section.**  Whatever cut, reflection profile, section and retyping
a continued theory carries, if its underlying iGSLT is the history theory
then no computable function on codes tracks its canonical section on the
closed interacting fibre. -/
theorem no_effective_continued_section (continued : CIGSLT)
    (underlying : CIGSLT.forget.obj continued = historyTheory) :
    ¬ ∃ track : ℕ → ℕ, Computable track ∧
      ∀ term : continued.CanonicalCarrier,
        patternCode (continued.canonical.normalize term).1 = track (patternCode term.1) :=
  no_effective_section_of_theory_eq continued.theory underlying continued.reflection
    continued.canonical

end Mettapedia.Languages.PartrecMachine
