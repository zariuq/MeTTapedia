import Mathlib.Logic.Relation
import Mettapedia.GSLT.LanguageDef.NIKIndexedOperational

/-!
# An Agda-shaped core nucleus as operational and checking GSLTs

This module isolates the lambda-Pi-universe nucleus shared by ordinary Agda
checking and several other dependent kernels.  It is deliberately not called
a specification of full Agda.  In particular, it does not yet contain named
definitions, inductive families, records and projections, pattern matching,
metavariables and constraints, universe-level expressions, irrelevance,
coverage, termination, positivity, rewriting, or cubical primitives.

There are two distinct operational objects here:

* `reductionGSLT` presents beta reduction on core terms;
* `checkerGSLT` presents replay of the bounded typing checker as a NIK
  authority.

Conversion is the common-reduct relation generated by reduction.  Typing is
an authored hypothetical judgment over contexts.  The results below connect
these layers without identifying them: a reduction step induces conversion,
checker evidence projects to declarative typing, and conversion has witnesses
which are not reduction steps.

The annotated lambda is a checking artifact, not a claim about Agda syntax.  A
future source-faithfulness theorem must relate parsed Agda binders
and elaborated internal terms to this carrier.
-/

namespace Mettapedia.Languages.Agda.CoreGSLT

open Mettapedia.GSLT
open Mettapedia.GSLT.LanguageDef.KernelAuthority
open Mettapedia.GSLT.LanguageDef.CheckerAuthorityFamily
open Mettapedia.GSLT.LanguageDef.NIKGSLT

/-! ## Lambda-Pi-universe syntax and substitution -/

/-- A small, explicitly annotated checking syntax.  De Bruijn indices are
validated by context lookup rather than by the raw carrier. -/
inductive Term where
  | var : Nat -> Term
  | sort : Nat -> Term
  | pi : Term -> Term -> Term
  | lam : Term -> Term -> Term
  | app : Term -> Term -> Term
deriving DecidableEq, Repr

abbrev Context := List Term

/-- Shift free indices at or above `cutoff`. -/
def lift (distance cutoff : Nat) : Term -> Term
  | .var index => .var (if index < cutoff then index else index + distance)
  | .sort level => .sort level
  | .pi domain codomain =>
      .pi (lift distance cutoff domain)
        (lift distance (cutoff + 1) codomain)
  | .lam domain body =>
      .lam (lift distance cutoff domain)
        (lift distance (cutoff + 1) body)
  | .app function argument =>
      .app (lift distance cutoff function) (lift distance cutoff argument)

/-- Capture-avoiding substitution for one de Bruijn index. -/
def subst (index : Nat) (replacement : Term) : Term -> Term
  | .var current =>
      if current = index then
        replacement
      else if index < current then
        .var (current - 1)
      else
        .var current
  | .sort level => .sort level
  | .pi domain codomain =>
      .pi (subst index replacement domain)
        (subst (index + 1) (lift 1 0 replacement) codomain)
  | .lam domain body =>
      .lam (subst index replacement domain)
        (subst (index + 1) (lift 1 0 replacement) body)
  | .app function argument =>
      .app (subst index replacement function) (subst index replacement argument)

/-- Instantiate the innermost binder. -/
def subst0 (argument body : Term) : Term := subst 0 argument body

/-- Kernel-style context lookup.  Crossing a binder shifts older entries. -/
def ctxLookupAux : Nat -> Context -> Nat -> Option Term
  | _, [], _ => none
  | depth, domain :: _, 0 => some (lift (depth + 1) 0 domain)
  | depth, _ :: rest, index + 1 => ctxLookupAux (depth + 1) rest index

def ctxLookup (context : Context) (index : Nat) : Option Term :=
  ctxLookupAux 0 context index

/-! ## Operational reduction and its GSLT -/

/-- One beta-reduction step, closed under the core term constructors. -/
inductive Step : Term -> Term -> Prop where
  | beta (domain body argument : Term) :
      Step (.app (.lam domain body) argument) (subst0 argument body)
  | piDomain {domain domain' codomain : Term} :
      Step domain domain' -> Step (.pi domain codomain) (.pi domain' codomain)
  | piCodomain {domain codomain codomain' : Term} :
      Step codomain codomain' -> Step (.pi domain codomain) (.pi domain codomain')
  | lamDomain {domain domain' body : Term} :
      Step domain domain' -> Step (.lam domain body) (.lam domain' body)
  | lamBody {domain body body' : Term} :
      Step body body' -> Step (.lam domain body) (.lam domain body')
  | appFunction {function function' argument : Term} :
      Step function function' ->
        Step (.app function argument) (.app function' argument)
  | appArgument {function argument argument' : Term} :
      Step argument argument' ->
        Step (.app function argument) (.app function argument')

/-- The computational GSLT of the nucleus.  Equality is intentionally the
only structural equation at this layer. -/
def reductionGSLT : GSLT where
  Term := Term
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites := Step
  rewrites_resp_left := by
    intro source source' target equal step
    cases equal
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    intro source target target' step equal
    cases equal
    exact step

@[simp] theorem reductionGSLT_step_iff {source target : Term} :
    reductionGSLT.Step source target <-> Step source target :=
  Iff.rfl

/-! ## Reduction closure and conversion -/

/-- A proof-oriented compatible, transitive reduction relation. -/
inductive Reduces : Term -> Term -> Prop where
  | refl {term : Term} : Reduces term term
  | beta {domain body argument : Term} :
      Reduces (.app (.lam domain body) argument) (subst0 argument body)
  | app {function function' argument argument' : Term} :
      Reduces function function' ->
      Reduces argument argument' ->
      Reduces (.app function argument) (.app function' argument')
  | pi {domain domain' codomain codomain' : Term} :
      Reduces domain domain' ->
      Reduces codomain codomain' ->
      Reduces (.pi domain codomain) (.pi domain' codomain')
  | lam {domain domain' body body' : Term} :
      Reduces domain domain' ->
      Reduces body body' ->
      Reduces (.lam domain body) (.lam domain' body')
  | trans {first middle last : Term} :
      Reduces first middle -> Reduces middle last -> Reduces first last

/-- Agda-style definitional conversion in the nucleus: both endpoints reduce
to a common term. -/
inductive Conv : Term -> Term -> Prop where
  | common {left right common : Term} :
      Reduces left common -> Reduces right common -> Conv left right

theorem step_to_reduces {source target : Term} (step : Step source target) :
    Reduces source target := by
  induction step with
  | beta => exact .beta
  | piDomain _ ih => exact .pi ih .refl
  | piCodomain _ ih => exact .pi .refl ih
  | lamDomain _ ih => exact .lam ih .refl
  | lamBody _ ih => exact .lam .refl ih
  | appFunction _ ih => exact .app ih .refl
  | appArgument _ ih => exact .app .refl ih

/-- Every computational edge yields definitional conversion. -/
theorem step_to_conv {source target : Term} (step : Step source target) :
    Conv source target :=
  .common (step_to_reduces step) .refl

/-! ## Bounded normalization and checking -/

mutual
  /-- Fuel-bounded beta normalization.  Exhausted fuel returns the current
  term, so acceptance remains sound but completeness is a separate question. -/
  def nf : Nat -> Term -> Term
    | 0, term => term
    | _fuel + 1, .var index => .var index
    | _fuel + 1, .sort level => .sort level
    | fuel + 1, .pi domain codomain =>
        .pi (nf fuel domain) (nf fuel codomain)
    | fuel + 1, .lam domain body =>
        .lam (nf fuel domain) (nf fuel body)
    | fuel + 1, .app function argument =>
        nfApp fuel (nf fuel function) (nf fuel argument)

  /-- One normalized application step. -/
  def nfApp : Nat -> Term -> Term -> Term
    | 0, function, argument => .app function argument
    | fuel + 1, .lam _ body, argument => nf fuel (subst0 argument body)
    | _, function, argument => .app function argument
end

def convBool (fuel : Nat) (left right : Term) : Bool :=
  nf fuel left == nf fuel right

mutual
  /-- Algorithmic type inference for the annotated nucleus. -/
  def infer : Nat -> Context -> Term -> Option Term
    | 0, _, _ => none
    | _fuel + 1, _, .sort level => some (.sort (level + 1))
    | _fuel + 1, context, .var index => ctxLookup context index
    | fuel + 1, context, .pi domain codomain =>
        match infer fuel context domain with
        | some (.sort domainLevel) =>
            match infer fuel (domain :: context) codomain with
            | some (.sort codomainLevel) =>
                some (.sort (max domainLevel codomainLevel))
            | _ => none
        | _ => none
    | fuel + 1, context, .lam domain body =>
        match infer fuel context domain with
        | some (.sort _) =>
            match infer fuel (domain :: context) body with
            | some bodyType => some (.pi domain bodyType)
            | none => none
        | _ => none
    | fuel + 1, context, .app function argument =>
        match infer fuel context function with
        | some (.pi domain codomain) =>
            if check fuel context argument domain then
              some (subst0 argument codomain)
            else
              none
        | _ => none

  /-- Checking is inference followed by bounded definitional conversion. -/
  def check : Nat -> Context -> Term -> Term -> Bool
    | 0, _, _, _ => false
    | fuel + 1, context, term, expected =>
        match infer fuel context term with
        | some inferred => convBool fuel inferred expected
        | none => false
end

/-! ## Declarative hypothetical typing -/

inductive HasType : Context -> Term -> Term -> Prop where
  | sort {context : Context} {level : Nat} :
      HasType context (.sort level) (.sort (level + 1))
  | var {context : Context} {index : Nat} {type : Term} :
      ctxLookup context index = some type ->
      HasType context (.var index) type
  | pi {context : Context} {domain codomain : Term}
      {domainLevel codomainLevel : Nat} :
      HasType context domain (.sort domainLevel) ->
      HasType (domain :: context) codomain (.sort codomainLevel) ->
      HasType context (.pi domain codomain)
        (.sort (max domainLevel codomainLevel))
  | lam {context : Context} {domain body bodyType : Term}
      {domainLevel : Nat} :
      HasType context domain (.sort domainLevel) ->
      HasType (domain :: context) body bodyType ->
      HasType context (.lam domain body) (.pi domain bodyType)
  | app {context : Context} {function argument domain codomain : Term} :
      HasType context function (.pi domain codomain) ->
      HasType context argument domain ->
      HasType context (.app function argument) (subst0 argument codomain)
  | conv {context : Context} {term inferred expected : Term} :
      HasType context term inferred ->
      Conv inferred expected ->
      HasType context term expected

theorem nf_nfApp_sound : forall fuel,
    (forall term, Reduces term (nf fuel term)) /\
    (forall function argument,
      Reduces (.app function argument) (nfApp fuel function argument)) := by
  intro fuel
  induction fuel with
  | zero =>
      constructor
      · intro term
        simp [nf]
        exact .refl
      · intro function argument
        simp [nfApp]
        exact .refl
  | succ fuel ih =>
      constructor
      · intro term
        cases term with
        | var index =>
            simp [nf]
            exact .refl
        | sort level =>
            simp [nf]
            exact .refl
        | pi domain codomain =>
            simp [nf]
            exact .pi (ih.1 domain) (ih.1 codomain)
        | lam domain body =>
            simp [nf]
            exact .lam (ih.1 domain) (ih.1 body)
        | app function argument =>
            simp [nf]
            exact .trans
              (.app (ih.1 function) (ih.1 argument))
              (ih.2 (nf fuel function) (nf fuel argument))
      · intro function argument
        cases function with
        | lam domain body =>
            simp [nfApp]
            exact .trans .beta (ih.1 (subst0 argument body))
        | var index =>
            simp [nfApp]
            exact .refl
        | sort level =>
            simp [nfApp]
            exact .refl
        | pi domain codomain =>
            simp [nfApp]
            exact .refl
        | app nestedFunction nestedArgument =>
            simp [nfApp]
            exact .refl

theorem nf_sound (fuel : Nat) (term : Term) :
    Reduces term (nf fuel term) :=
  (nf_nfApp_sound fuel).1 term

theorem convBool_sound {fuel : Nat} {left right : Term}
    (accepted : convBool fuel left right = true) : Conv left right := by
  unfold convBool at accepted
  by_cases equal : nf fuel left = nf fuel right
  · exact .common (nf_sound fuel left) (equal ▸ nf_sound fuel right)
  · simp [equal] at accepted

theorem infer_check_sound : forall fuel,
    (forall context term type,
      infer fuel context term = some type -> HasType context term type) /\
    (forall context term type,
      check fuel context term type = true -> HasType context term type) := by
  intro fuel
  induction fuel with
  | zero =>
      constructor
      · intro context term type accepted
        simp [infer] at accepted
      · intro context term type accepted
        simp [check] at accepted
  | succ fuel ih =>
      constructor
      · intro context term type accepted
        cases term with
        | sort level =>
            simp [infer] at accepted
            exact accepted ▸ HasType.sort
        | var index =>
            simp [infer] at accepted
            exact HasType.var accepted
        | pi domain codomain =>
            simp [infer] at accepted
            split at accepted <;> try contradiction
            rename_i domainLevel domainAccepted
            split at accepted <;> try contradiction
            rename_i codomainLevel codomainAccepted
            cases accepted
            exact HasType.pi
              (ih.1 context domain (.sort domainLevel) domainAccepted)
              (ih.1 (domain :: context) codomain (.sort codomainLevel)
                codomainAccepted)
        | lam domain body =>
            simp [infer] at accepted
            split at accepted <;> try contradiction
            rename_i domainLevel domainAccepted
            split at accepted <;> try contradiction
            rename_i bodyType bodyAccepted
            cases accepted
            exact HasType.lam
              (ih.1 context domain (.sort domainLevel) domainAccepted)
              (ih.1 (domain :: context) body bodyType bodyAccepted)
        | app function argument =>
            simp [infer] at accepted
            split at accepted <;> try contradiction
            rename_i domain codomain functionAccepted
            split at accepted <;> try contradiction
            rename_i argumentAccepted
            cases accepted
            exact HasType.app
              (ih.1 context function (.pi domain codomain) functionAccepted)
              (ih.2 context argument domain argumentAccepted)
      · intro context term type accepted
        simp [check] at accepted
        split at accepted <;> try contradiction
        rename_i inferred inferredAccepted
        exact HasType.conv
          (ih.1 context term inferred inferredAccepted)
          (convBool_sound accepted)

/-- Acceptance by the bounded checker is sound for the declarative nucleus. -/
theorem check_sound {fuel : Nat} {context : Context} {term type : Term}
    (accepted : check fuel context term type = true) :
    HasType context term type :=
  (infer_check_sound fuel).2 context term type accepted

/-! ## NIK authority -/

structure TypingClaim where
  context : Context
  term : Term
  type : Term
deriving DecidableEq, Repr

/-- Fuel is retained as evidence.  It determines the exact bounded checking
run and is not confused with a declarative derivation article. -/
def typingChecker : Checker TypingClaim Nat where
  check := fun claim fuel =>
    check fuel claim.context claim.term claim.type

/-- The exact scope covered by some finite bounded checking run. -/
def AlgorithmicallyCertified (claim : TypingClaim) : Prop :=
  exists fuel, check fuel claim.context claim.term claim.type = true

/-- The broader authored typing judgment. -/
def Meaning (claim : TypingClaim) : Prop :=
  HasType claim.context claim.term claim.type

theorem typingChecker_authority :
    typingChecker.Authority AlgorithmicallyCertified where
  sound := by
    intro claim fuel accepted
    exact ⟨fuel, accepted⟩
  complete := by
    intro claim certified
    exact certified

theorem typingChecker_projection :
    typingChecker.AuthorityProjection AlgorithmicallyCertified Meaning where
  authority := typingChecker_authority
  project := by
    intro claim certified
    obtain ⟨fuel, accepted⟩ := certified
    exact check_sound accepted

/-- The Agda-shaped nucleus occupies one explicitly named NIK authority
fibre.  This does not make its object logic NIK's ambient logic. -/
abbrev typingFamily : AuthorityFamily Unit :=
  Mettapedia.GSLT.LanguageDef.NIKGSLT.Indexed.InternalJudgment.singletonFamily
    typingChecker AlgorithmicallyCertified Meaning typingChecker_projection

abbrev TypingEvidence (claim : TypingClaim) :=
  Mettapedia.GSLT.LanguageDef.NIKGSLT.Indexed.InternalJudgment.Evidence
    typingFamily () claim

theorem nonempty_typingEvidence_iff_certified (claim : TypingClaim) :
    Nonempty (TypingEvidence claim) <-> AlgorithmicallyCertified claim :=
  Mettapedia.GSLT.LanguageDef.NIKGSLT.Indexed.InternalJudgment.nonempty_evidence_iff_certified
    typingFamily () claim

theorem nonempty_typingEvidence_implies_typing (claim : TypingClaim) :
    Nonempty (TypingEvidence claim) -> Meaning claim :=
  Mettapedia.GSLT.LanguageDef.NIKGSLT.Indexed.InternalJudgment.nonempty_evidence_implies_meaning
    typingFamily () claim

/-- The outer replay machine is a second GSLT, distinct from term reduction. -/
abbrev checkerGSLT : GSLT := Atomic.theory typingChecker

theorem checker_execution_iff
    (claim : TypingClaim) (fuel : Nat) :
    checkerGSLT.MultiStep
        (.submitted claim fuel) (.accepted claim) <->
      check fuel claim.context claim.term claim.type = true := by
  simpa [checkerGSLT, typingChecker] using
    Atomic.submitted_multiStep_accepted_iff typingChecker claim fuel

theorem certified_iff_accepting_execution (claim : TypingClaim) :
    AlgorithmicallyCertified claim <->
      exists fuel,
        checkerGSLT.MultiStep
          (.submitted claim fuel) (.accepted claim) := by
  constructor
  · rintro ⟨fuel, accepted⟩
    exact ⟨fuel, (checker_execution_iff claim fuel).mpr accepted⟩
  · rintro ⟨fuel, execution⟩
    exact ⟨fuel, (checker_execution_iff claim fuel).mp execution⟩

/-! ## Positive and separating witnesses -/

def set0 : Term := .sort 0
def set1 : Term := .sort 1

/-- The polymorphic-looking identity at the first universe fragment. -/
def identity : Term := .lam set1 (.var 0)
def identityType : Term := .pi set1 set1

def identityClaim : TypingClaim :=
  { context := []
    term := identity
    type := identityType }

theorem identity_check :
    check 8 [] identity identityType = true := by
  decide

theorem identity_hasType : HasType [] identity identityType :=
  check_sound identity_check

def identityEvidence : TypingEvidence identityClaim :=
  by
    change { fuel : Nat // check fuel [] identity identityType = true }
    exact ⟨8, identity_check⟩

theorem identity_checker_executes :
    checkerGSLT.MultiStep
      (.submitted identityClaim 8) (.accepted identityClaim) :=
  (checker_execution_iff identityClaim 8).mpr identity_check

/-- The computational layer has a genuine beta edge. -/
theorem identity_beta :
    reductionGSLT.Step (.app identity set0) set0 := by
  exact Step.beta set1 (.var 0) set0

/-- That edge induces conversion but is not definitionally identified with
the conversion judgment. -/
theorem identity_beta_conversion : Conv (.app identity set0) set0 :=
  step_to_conv identity_beta

theorem sort_has_no_step (level : Nat) (target : Term) :
    Not (Step (.sort level) target) := by
  intro step
  cases step

/-- Conversion contains reflexivity, while one-step reduction does not. -/
theorem conversion_is_strictly_not_oneStep :
    Conv set0 set0 /\ Not (Step set0 set0) := by
  exact ⟨.common .refl .refl, sort_has_no_step 0 set0⟩

def freeVariableClaim : TypingClaim :=
  { context := []
    term := .var 0
    type := set0 }

theorem freeVariable_check_rejects (fuel : Nat) :
    check fuel [] (.var 0) set0 = false := by
  cases fuel with
  | zero => rfl
  | succ fuel =>
      cases fuel <;> rfl

theorem freeVariable_not_certified :
    Not (AlgorithmicallyCertified freeVariableClaim) := by
  rintro ⟨fuel, accepted⟩
  change check fuel [] (.var 0) set0 = true at accepted
  have rejected := freeVariable_check_rejects fuel
  rw [rejected] at accepted
  contradiction

/-- A raw term is not made typable merely by placing the checker in NIK. -/
theorem freeVariable_has_no_nikEvidence :
    Not (Nonempty (TypingEvidence freeVariableClaim)) := by
  intro evidence
  exact freeVariable_not_certified
    ((nonempty_typingEvidence_iff_certified freeVariableClaim).mp evidence)

#print axioms step_to_conv
#print axioms check_sound
#print axioms nonempty_typingEvidence_implies_typing
#print axioms identity_beta
#print axioms conversion_is_strictly_not_oneStep
#print axioms freeVariable_has_no_nikEvidence

end Mettapedia.Languages.Agda.CoreGSLT
