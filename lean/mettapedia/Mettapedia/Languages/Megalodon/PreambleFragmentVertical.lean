import Mettapedia.Languages.Megalodon.SetOperationSemanticAuthority
import Mettapedia.Languages.Megalodon.SelectedTheoryProfile

/-!
# The set-operation fragment of the HOTG preamble as a vertical specimen

Four objects, kept apart:

* the **framework**: the membership institution of the fragment, one
  signature, sentences the closed formulas of the fragment, models the
  extensional membership models with empty set, union, and powerset;
* the **object theory**: the closed theory generated by the five preamble
  principles, a node of the theory graph over model-valued institutions; it
  is a fragment of the HOTG preamble and is named as such, not as HOTG;
* a **satisfying model**: Mathlib's ZFC sets, as an object of the fibre of
  satisfying models over that node;
* the **native proof service**: Megalodon's Mathdata kernel at the explicit
  environment declaring the five principles, entering NIK through the native
  proof face and nothing else.

Then the maps and the separations: a derived theorem, subset reflexivity
through powerset introduction, is accepted by the native kernel with a
genuine Megalodon proof object, belongs to the node's theory, and holds in
the ZFC model; the covered native scope is sound for validity and properly
smaller than it; and a sentence refuted by a model is outside the theory and
rejected by the kernel.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.Megalodon.PreambleFragmentVertical

open _root_.CategoryTheory
open Mettapedia.Logic
open Mettapedia.GSLT.LanguageDef
open Mettapedia.GSLT.LanguageDef.NIKMetalogic
open Mettapedia.GSLT.LanguageDef.TheoryGraphModels
open Mettapedia.Languages.Megalodon.MathdataKernel
open Mettapedia.Languages.Megalodon.SetOperationSemanticAuthority

/-! ## The framework: the membership institution of the fragment -/

/-- The membership institution of the fragment: one signature, the closed
formulas as sentences, extensional membership models as models. -/
def institution : Institution.{0, 0, 0, 2, 2} (Discrete Unit) where
  sentence := (Functor.const (Discrete Unit)).obj ClosedFormula
  model := (Functor.const (Discrete Unit)ᵒᵖ).obj (Cat.of (Discrete Model.{1}))
  satisfies _ model formula := formula.Holds model.as (fun index => Fin.elim0 index)
  satisfaction_condition := by
    intro source target translation targetModel sourceSentence
    exact Iff.rfl

/-- The institution as an object of the category of institutions. -/
def institutionObject : InstitutionCategory.Object.{0, 0, 0, 2, 2} where
  Signature := Cat.of (Discrete Unit)
  logic := institution

/-! ## The object theory: the five preamble principles -/

/-- The five selected preamble principles. -/
def principles : Set ClosedFormula :=
  {emptyElimFormula, unionIntroFormula, unionElimFormula, powerIntroFormula, powerElimFormula}

theorem principles_valid : ∀ formula ∈ principles, Valid formula := by
  intro formula membership
  simp only [principles, Set.mem_insert_iff, Set.mem_singleton_iff] at membership
  rcases membership with rfl | rfl | rfl | rfl | rfl
  · exact emptyElim_valid
  · exact unionIntro_valid
  · exact unionElim_valid
  · exact powerIntro_valid
  · exact powerElim_valid

/-- The fragment node: the closed theory generated by the principles. -/
def fragmentNode : Node.{0, 0, 0, 2, 2} :=
  Node.mk' institutionObject
    (PiInstitution.generatedTheory
      (InstitutionConsequence.consequenceProjection institution) ⟨()⟩ principles)

/-- Every valid sentence is a theorem of the fragment node. -/
theorem mem_fragmentNode_of_valid {formula : ClosedFormula} (valid : Valid formula) :
    formula ∈ fragmentNode.theory.theory.1 :=
  fun model _ => valid model.as

/-- A sentence refuted by some model is not a theorem of the fragment node,
because every model satisfies the principles. -/
theorem not_mem_fragmentNode_of_not_valid {formula : ClosedFormula}
    (refuted : ¬ Valid formula) :
    formula ∉ fragmentNode.theory.theory.1 := by
  intro theoremhood
  exact refuted (fun model =>
    theoremhood (Discrete.mk model) (fun premise membership =>
      principles_valid premise membership model))

/-! ## A satisfying model: ZFC sets -/

/-- Mathlib's ZFC sets satisfy the fragment node. -/
theorem zfc_satisfies : Satisfies fragmentNode (Discrete.mk zfcModel) :=
  (satisfies_generated_iff institutionObject ⟨()⟩ principles (Discrete.mk zfcModel)).2
    (fun formula membership => principles_valid formula membership zfcModel)

/-- The ZFC model as an object of the fibre over the fragment node. -/
noncomputable def zfcSatisfyingModel : Model fragmentNode :=
  ⟨Discrete.mk zfcModel, zfc_satisfies⟩

/-- The ZFC model as an object of the total category of satisfying models. -/
noncomputable def zfcObject : SatisfyingModel.{0, 0, 0, 2, 2} :=
  SatisfyingModel.mk' fragmentNode zfcSatisfyingModel

theorem zfcObject_node : toNode.obj zfcObject = fragmentNode :=
  rfl

/-! ## The native proof service -/

/-- Megalodon's Mathdata kernel at the environment declaring the principles,
as a NIK service.  Its target is native theoremhood in that environment. -/
def nativeProofService :
    NIK.Service (SelectedTheoryProfile.profileTarget environment) :=
  SelectedTheoryProfile.nativeService environment

theorem nativeProofService_face : nativeProofService.face = NIK.Face.nativeProof :=
  rfl

/-- The service's target is intrinsic theoremhood, not validity: the two
semantic targets are distinct objects. -/
theorem nativeProofService_target_meaning (claim : SelectedTheoryProfile.ProfileClaim) :
    (SelectedTheoryProfile.profileTarget environment).Meaning claim ↔
      SelectedTheoryProfile.NativeTheoremScope environment claim := by
  constructor
  · rintro ⟨proof, judged⟩
    exact ⟨proof, judged⟩
  · rintro ⟨proof, judged⟩
    exact ⟨⟨proof, judged⟩⟩

/-! ## A derived theorem through the whole vertical -/

/-- Subset reflexivity through powerset introduction: `∀ z, z ∈ 𝒫 z`. -/
def subsetPowerFormula : ClosedFormula :=
  .all (.member (.var 0) (.power (.var 0)))

/-- Valid in every model of the fragment. -/
theorem subsetPower_valid : Valid subsetPowerFormula := by
  intro model value
  exact (model.power_spec value value).2 (fun _ membership => membership)

/-- Holds in the ZFC model. -/
theorem subsetPower_holds_zfc :
    subsetPowerFormula.Holds zfcModel (fun index => Fin.elim0 index) :=
  subsetPower_valid zfcModel

/-- A theorem of the fragment node. -/
theorem subsetPower_mem_fragmentNode : subsetPowerFormula ∈ fragmentNode.theory.theory.1 :=
  mem_fragmentNode_of_valid subsetPower_valid

/-- Megalodon's own proof object: instantiate powerset introduction at `z`
and `z`, and discharge the subset premise by the identity proof. -/
def subsetPowerProof : Pf :=
  .termLam (.base 0)
    (.proofApp
      (.termApp (.termApp (.known AxiomTag.powerIntro.name) (.db 0)) (.db 0))
      (.termLam (.base 0)
        (.proofLam (.app (.app (.named membershipName) (.db 0)) (.db 1)) (.hyp 0))))

/-- A term found by name in a declaration list belongs to it. -/
theorem lookupTermList?_mem {declaration : TermDecl} :
    (declarations : List TermDecl) → (name : Name) →
      lookupTermList? declarations name = some declaration → declaration ∈ declarations
  | [], _, found => by simp [lookupTermList?] at found
  | head :: rest, name, found => by
      simp only [lookupTermList?] at found
      split at found
      · exact (Option.some.inj found) ▸ List.mem_cons_self
      · exact List.mem_cons_of_mem _ (lookupTermList?_mem rest name found)

/-- Every declared term of the environment is a primitive: it has no
definition to expand. -/
theorem environment_primitive (name : Name) (declaration : TermDecl)
    (found : environment.lookupTerm? name = some declaration) :
    declaration.definition = none := by
  have membership := lookupTermList?_mem environment.terms name found
  simp [environment] at membership
  rcases membership with rfl | rfl | rfl | rfl | rfl <;> rfl

/-- In an environment of primitives, delta-normalization is the identity at
every fuel.  The kernel's delta-normalizer is defined by well-founded
recursion, so this is what lets its verdicts be computed symbolically. -/
theorem deltaNormalize_of_primitive (primitives : Environment)
    (primitive : ∀ name declaration,
      primitives.lookupTerm? name = some declaration → declaration.definition = none) :
    ∀ fuel term, deltaNormalize primitives fuel term = some term := by
  intro fuel term
  induction term generalizing fuel with
  | named name =>
      have lookup : ∀ declaration, primitives.lookupTerm? name = some declaration →
          declaration.definition = none :=
        primitive name
      cases fuel with
      | zero =>
          simp only [deltaNormalize]
          split
          · rename_i declaration found
            exact absurd (lookup _ found) (by simp)
          · rfl
      | succ fuel =>
          simp only [deltaNormalize]
          split
          · rename_i declaration found
            exact absurd (lookup _ found) (by simp)
          · rfl
  | app function argument functionIdentity argumentIdentity =>
      cases fuel <;> simp [deltaNormalize, functionIdentity, argumentIdentity]
  | lam type body bodyIdentity => cases fuel <;> simp [deltaNormalize, bodyIdentity]
  | imp domain codomain domainIdentity codomainIdentity =>
      cases fuel <;> simp [deltaNormalize, domainIdentity, codomainIdentity]
  | all type body bodyIdentity => cases fuel <;> simp [deltaNormalize, bodyIdentity]
  | typeApp function type functionIdentity =>
      cases fuel <;> simp [deltaNormalize, functionIdentity]
  | typeLam body bodyIdentity => cases fuel <;> simp [deltaNormalize, bodyIdentity]
  | typeAll body bodyIdentity => cases fuel <;> simp [deltaNormalize, bodyIdentity]
  | db _ => cases fuel <;> simp [deltaNormalize]
  | prim _ => cases fuel <;> simp [deltaNormalize]

/-- The native kernel accepts the proof object for the derived theorem: the
verdict is computed symbolically through the kernel's own evaluator. -/
theorem subsetPower_native_accepted :
    (SelectedTheoryProfile.checker environment).check
      (profileClaim subsetPowerFormula) subsetPowerProof = true := by
  change checkProof environment 32 0 [] [] subsetPowerProof subsetPowerFormula.erase = true
  have delta := deltaNormalize_of_primitive environment environment_primitive
  simp +decide [checkProof, checkNormalizedProof, inferProof, inferTerm,
    Mettapedia.Languages.Megalodon.MathdataKernel.normalize, delta,
    subsetPowerProof, subsetPowerFormula, Formula.erase, SetTerm.erase, AxiomTag.name,
    Tm.normalize, Tm.normalizeOne, Tm.instantiate]

/-- The derived theorem is in the native theorem scope of the environment. -/
theorem subsetPower_native_theorem :
    SelectedTheoryProfile.NativeTheoremScope environment (profileClaim subsetPowerFormula) :=
  (SelectedTheoryProfile.checker_authority environment).sound _ _ subsetPower_native_accepted

/-! ## Separations -/

/-- The covered native scope is sound for validity and properly smaller than
it: kernel acceptance in the selected profile is not model validity. -/
theorem native_scope_proper :
    (∀ formula, Covered formula → Valid formula) ∧
      ∃ formula, Valid formula ∧ ¬ Covered formula :=
  ⟨fun _ => covered_valid, identityFormula, identity_valid, identity_not_covered⟩

/-- A theorem of the node accepted by no certificate of the guarded checker. -/
theorem theorem_not_accepted_by_guarded_checker :
    identityFormula ∈ fragmentNode.theory.theory.1 ∧
      ∀ proof, SetOperationSemanticAuthority.checker.check identityFormula proof = false := by
  refine ⟨mem_fragmentNode_of_valid identity_valid, fun proof => ?_⟩
  by_contra accepted
  exact identity_not_covered
    (SetOperationSemanticAuthority.checker_authority.sound identityFormula proof
      (by simpa using accepted))

/-- Negative control: universal membership is refuted by a model, is outside
the node's theory, and is rejected by the guarded checker with every proof. -/
theorem universalMembership_separated :
    universalMembership ∉ fragmentNode.theory.theory.1 ∧
      ∀ proof, SetOperationSemanticAuthority.checker.check universalMembership proof = false :=
  ⟨not_mem_fragmentNode_of_not_valid universalMembership_not_valid,
    fun proof => Canary.universalMembership_rejected proof⟩

#print axioms zfc_satisfies
#print axioms subsetPower_native_accepted
#print axioms subsetPower_native_theorem
#print axioms subsetPower_mem_fragmentNode
#print axioms native_scope_proper
#print axioms theorem_not_accepted_by_guarded_checker
#print axioms universalMembership_separated

end Mettapedia.Languages.Megalodon.PreambleFragmentVertical
