#assert_parser_kind term "grammar_probe_local" Mettapedia.Languages.Lean.ParserOracle4331.Controls.localAtom
#parser_probe term "grammar_probe_local" 64
end Local

#assert_parser_kind term "grammar_probe_local" ident
#parser_probe term "grammar_probe_local" 64

