import Mettapedia.Languages.Lean.ParserOracle4331

/-!
# Pinned parser-adapter and live-scope controls

The descriptor laws below are kernel proofs. The command probes execute the
pinned Lean parser and emit versioned observations; they are differential
reference data, not a theorem of parser correctness or complete state export.
-/

namespace Mettapedia.Languages.Lean.ParserOracle4331.Controls

open _root_.Lean _root_.Lean.Elab _root_.Lean.Elab.Command
open ParserAdapter4331 ParserDescription

def description : Description :=
  .trailingNode (.str .anonymous "demo") 70 71
    (.sepBy1 (.category (.str .anonymous "term") 72) ","
      (.nonReservedSymbol "," true) true)

theorem descriptor_options_survive : exportDescription (importDescription description) = description :=
  export_import description

theorem numeric_and_string_names_are_distinct :
    exportName (.str .anonymous "1") ≠ exportName (.num .anonymous 1) := by decide

theorem named_alias_is_retained :
    dependencies (.unary (.str .anonymous "withPosition") (.parser (.str .anonymous "custom"))) =
      [.alias (.str .anonymous "withPosition") 1, .parser (.str .anonymous "custom")] := rfl

theorem another_release_is_refused :
    importPacket ⟨{ profile with release := "4.35.0" }, .anonymous, .trailing, description⟩ = none := by
  apply other_profile_refused
  decide

#assert_parser_kind term "grammar_probe_atom" ident
#parser_probe term "grammar_probe_atom" 64

syntax (name := atom) "grammar_probe_atom" : term

/- Export an actual description generated by Lean's syntax command. -/
#eval match packetJson ``Mettapedia.Languages.Lean.ParserOracle4331.Controls.atom .leading
    Mettapedia.Languages.Lean.ParserOracle4331.Controls.atom with
  | .ok packet => IO.println packet.compress
  | .error error => throw (IO.userError error)

#assert_parser_kind term "grammar_probe_atom" Mettapedia.Languages.Lean.ParserOracle4331.Controls.atom
#parser_probe term "grammar_probe_atom" 64

