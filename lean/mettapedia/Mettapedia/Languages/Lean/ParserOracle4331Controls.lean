syntax (name := choiceOne) "grammar_probe_choice" : term
syntax (name := choiceTwo) "grammar_probe_choice" : term

run_cmd do
  match parse (← getEnv) (← getScope) `term "grammar_probe_choice" with
  | .ok tree =>
      unless tree.getKind == Lean.choiceKind && tree.getArgs.size == 2 do
        throwError "equal parser alternatives were not retained as a choice"
  | .error error => throwError error

#parser_probe term "grammar_probe_choice" 64

syntax (name := choiceHigh) (priority := 2000) "grammar_probe_choice" : term
#assert_parser_kind term "grammar_probe_choice" Mettapedia.Languages.Lean.ParserOracle4331.Controls.choiceHigh
#parser_probe term "grammar_probe_choice" 64

/- A local parser update changes effective parsing without changing the
persistent registration log. Log-only grammar replay would miss this. -/
run_cmd do
  let before ← getEnv
  let scope ← getScope
  let token := "grammar_probe_hidden_local"
  let kind := `grammar_probe_hidden_kind
  let withToken := Parser.parserExtension.addLocalEntry before (.token token)
  let parser := Parser.node kind (Parser.symbol token)
  let after := Parser.parserExtension.addLocalEntry withToken (.parser `term kind true parser 1000)
  let log := fun env => (Parser.parserExtension.ext.getState (asyncMode := .local) env).newEntries.map scopedEntryJson
  unless log before == log after do throwError "local entry unexpectedly changed persistent log"
  match parse before scope `term token, parse after scope `term token with
  | .ok (.ident ..), .ok tree =>
      unless tree.getKind == kind do throwError "local parser did not become active"
  | _, _ => throwError "local-entry parse separation failed"
  logInfo "LocalParserLogControl passed: identical declaration log, different effective parse"

end Mettapedia.Languages.Lean.ParserOracle4331.Controls
