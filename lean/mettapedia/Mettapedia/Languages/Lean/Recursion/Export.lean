import Mettapedia.Languages.Lean.Recursion.Derive
import Mettapedia.Languages.Lean.Recursion.FuelDerive
import Mettapedia.Languages.Lean.Recursion.Wrappers
import Mettapedia.Languages.Lean.Declarations.Terms
import Lean.Meta.Sym.SymM

/-!
# Readable recursion facts for the Egal interpretation

The terms use the existing declaration reader's FTerm syntax. Decrease and
unfolding statements are read from the named kernel declarations generated by
Derive; their text is not authored separately. This producer reports a reading
failure instead of omitting a required recipe or proposition.
-/

namespace Mettapedia.Languages.Lean.Recursion.Export

open _root_.Lean Meta
open Mettapedia.Languages.Lean.Declarations

def form (items : List Format) : Format :=
  Format.group (Format.text "(" ++ Format.nest 2 (Format.joinSep items Format.line) ++ Format.text ")")

def word (value : String) : Format := Format.text value
def named (value : Name) : Format := word value.toString

partial def term : FTerm → Format
  | .var name => form [word "var", word (egalVar name)]
  | .num value => form [word "num", word (toString value)]
  | .app name arguments => form [word "app", named name, form (arguments.map term)]
  | .apv function arguments => form [word "apv", term function, form (arguments.map term)]
  | .lam name type body => form [word "lam", word (egalVar name), term type, term body]
  | .arrow domain codomain => form [word "arrow", term domain, term codomain]
  | .pi name domain codomain => form [word "pi", word (egalVar name), term domain, term codomain]
  | .prop => form [word "prop"]
  | .sort level => form [word "sort", word level.atom]
  | .proof => form [word "proof"]

def read (name : Name) (expression : Expr) : MetaM FTerm := do
  let prepared ← Sym.foldProjs expression
  let equality ← mkEq expression prepared
  checkWithKernel (mkApp (.lam `conversion equality (.bvar 0) .default) (← mkEqRefl expression))
  match ← (readTerm {} prepared).run with
  | .ok result => pure result
  | .error reason => throwError "recursion interface {name} cannot be read: {reason}"

def definition (name : Name) : MetaM Format := do
  let .defnInfo info ← getConstInfo name | throwError "recipe component is not a definition: {name}"
  return form [word "LeanRecursionDefinition", named name,
    form [word "Type", term (← read name info.type)],
    form [word "Value", term (← read name info.value)]]

def theoremStatement (name : Name) : MetaM Format := do
  let info ← getConstInfo name
  return form [word "LeanRecursionTheorem", named name, term (← read name info.type),
    form [word "Axioms", form ((← collectAxioms name).toList.map named)]]

def record (entry : Derive.Record) : Format :=
  form [word "LeanWfRecursion", named entry.source,
    form [word "Method", word (match entry.method with
      | .measure => "measure" | .natBrec => "structural-natural" | .generalRelation => "well-founded-relation")],
    form [word "ProofArguments", form (entry.proofArguments.toList.map (word ∘ toString))],
    form [word "Implementation", named entry.implementation],
    form [word "Relation", named entry.relation],
    form [word "Measure", form (entry.measure.toList.map named)],
    form [word "Recipe", named entry.recipe],
    form [word "WellFounded", named entry.wellFounded],
    form [word "Accessible", named entry.accessible],
    form [word "Bridge", named entry.functionBridge],
    form [word "Equations", form (entry.unfoldings.toList.map fun (source, target) =>
      form [named source, named target])],
    form [word "Calls", form (entry.calls.toList.map fun call =>
      form [word "call", form [word "Current", named call.current], form [word "Argument", named call.argument],
        form [word "ConditionsAndDecrease", named call.decrease],
        form [word "Proof", named call.decrease],
        form [word "SourceProofs", form (call.sourceProofs.toList.map named)],
        form [word "SourceCall", form (call.sourceCall.toList.map named)],
        form [word "SourceEquation", form (call.sourceEquation.toList.map named)],
        form [word "ProofUses", form (call.proofUses.toList.map fun use =>
          form [word (toString use.position), form [word "Proposition", named use.proposition],
            form [word "Evidence", form (use.evidence.toList.map named)],
            form [word "ForwardedCondition", form (use.forwarded.toList.map (word ∘ egalVar))]])]])]]

def render (entries : Array Derive.Record) : MetaM String := do
  let mut result := ";; Generated recursion interfaces; statements come from checked Lean declarations.\n"
  let mut sourceProofsEmitted : NameSet := {}
  for entry in entries do
    result := result ++ (record entry).pretty 120 ++ "\n\n"
    let sourceType ← read entry.source (← getConstInfo entry.source).type
    result := result ++ (form [word "LeanRecursionSourceType", named entry.source, term sourceType]).pretty 120 ++ "\n\n"
    for name in entry.measure.toArray ++ #[entry.relation, entry.recipe] do
      result := result ++ (← definition name).pretty 120 ++ "\n\n"
    for name in #[entry.wellFounded, entry.bridge, entry.functionBridge] ++ entry.equations ++
        entry.unfoldings.map Prod.snd do
      result := result ++ (← theoremStatement name).pretty 120 ++ "\n\n"
    for call in entry.calls do
      result := result ++ (← definition call.current).pretty 120 ++ "\n\n"
      result := result ++ (← definition call.argument).pretty 120 ++ "\n\n"
      result := result ++ (← theoremStatement call.decrease).pretty 120 ++ "\n\n"
      if let some sourceCall := call.sourceCall then
        result := result ++ (← definition sourceCall).pretty 120 ++ "\n\n"
        for proof in call.sourceProofs do
          unless sourceProofsEmitted.contains proof do
            result := result ++ (← theoremStatement proof).pretty 120 ++ "\n\n"
            sourceProofsEmitted := sourceProofsEmitted.insert proof
      for use in call.proofUses do
        result := result ++ (← definition use.proposition).pretty 120 ++ "\n\n"
        if let some evidence := use.evidence then
          result := result ++ (← theoremStatement evidence).pretty 120 ++ "\n\n"
  return result

def wrappers (entries : Array Wrappers.Record) : MetaM String := do
  let mut result := ""
  for entry in entries do
    result := result ++ (form [word "LeanRecursionWrapper", named entry.source,
      form [word "Accessible", named entry.accessible], form [word "Bridge", named entry.bridge],
      form [word "Dependencies", form (entry.dependencies.toList.map named)],
      form [word "Equations", form (entry.unfoldings.toList.map fun (source, target) =>
        form [named source, named target])]]).pretty 120 ++ "\n\n"
    result := result ++ (← definition entry.accessible).pretty 120 ++ "\n\n"
    result := result ++ (← theoremStatement entry.bridge).pretty 120 ++ "\n\n"
    for (source, target) in entry.unfoldings do
      result := result ++ (← theoremStatement source).pretty 120 ++ "\n\n"
      result := result ++ (← theoremStatement target).pretty 120 ++ "\n\n"
  return result

/-- Fuel equations and adequacy belong to the same source identity as the
accessible recipe. Consumers must check the bridge as well as evaluate fuel. -/
def fuelReadings (entries : Array FuelDerive.Record) : MetaM String := do
  let mut result := ""
  for entry in entries do
    result := result ++ (form [word "LeanFuelRecursion", named entry.source,
      form [word "Fuel", named entry.fuel],
      form [word "Equations", form [named entry.zeroEquation, named entry.stepEquation]],
      form [word "SourceFuel", named entry.curriedFuel],
      form [word "SourceFuelEquations", form (entry.curriedEquations.toList.map named)],
      form [word "Adequate", named entry.adequate],
      form [word "Budget", named entry.budget],
      form [word "BudgetAdequate", named entry.budgetAdequate],
      form [word "Reading", named entry.reading],
      form [word "Bridge", named entry.bridge]]).pretty 120 ++ "\n\n"
    for name in #[entry.fuel, entry.curriedFuel, entry.budget, entry.reading] do
      result := result ++ (← definition name).pretty 120 ++ "\n\n"
    for name in #[entry.zeroEquation, entry.stepEquation, entry.curriedStepEquation,
        entry.adequate, entry.budgetAdequate, entry.bridge] ++ entry.curriedEquations do
      result := result ++ (← theoremStatement name).pretty 120 ++ "\n\n"
  return result

end Mettapedia.Languages.Lean.Recursion.Export
