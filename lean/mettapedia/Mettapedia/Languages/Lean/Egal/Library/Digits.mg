(** Generated by digits.metta: positional numerals over Egal's ordinals, radix 10.  Do not edit.

    q :: d is 10 times q plus the digit d.  A Lean literal at or above
    100 (the radix squared) is read as its digits over a literal below
    100, the last digit outermost, so the digits read in order.  Egal's literals
    are unary chains, and Megalodon reads no literal beyond a machine
    integer; the digits keep large numbers small.  The laws compute
    successor, addition and multiplication digit by digit, and the tables
    give each literal's digits and each sum of two digits. **)

Theorem nat_radix : nat_p 10.
exact (nat_ordsucc 9 (nat_ordsucc 8 (nat_ordsucc 7 (nat_ordsucc 6 (nat_ordsucc 5 (nat_ordsucc 4 (nat_ordsucc 3 (nat_ordsucc 2 (nat_ordsucc 1 (nat_ordsucc 0 nat_0)))))))))).
Qed.
Definition NumD : set -> set -> set := fun q d => add_nat (mul_nat 10 q) d.
Infix :: 300 left := NumD.

Theorem NumD_p : forall q, nat_p q -> forall d, nat_p d -> nat_p (q :: d).
let q. assume Hq: nat_p q. let d. assume Hd: nat_p d.
exact add_nat_p (mul_nat 10 q) (mul_nat_p 10 nat_radix q Hq) d Hd.
Qed.

Theorem add_nat_swap_mid : forall a, nat_p a -> forall b, nat_p b -> forall c, nat_p c -> forall d, nat_p d ->
  add_nat (add_nat a b) (add_nat c d) = add_nat (add_nat a c) (add_nat b d).
let a. assume Ha: nat_p a. let b. assume Hb: nat_p b. let c. assume Hc: nat_p c. let d. assume Hd: nat_p d.
rewrite add_nat_asso a Ha b Hb (add_nat c d) (add_nat_p c Hc d Hd).
rewrite add_nat_asso a Ha c Hc (add_nat b d) (add_nat_p b Hb d Hd).
rewrite <- add_nat_asso b Hb c Hc d Hd.
rewrite <- add_nat_asso c Hc b Hb d Hd.
rewrite add_nat_com b Hb c Hc.
reflexivity.
Qed.

(** Successor: the last digit grows, or carries. **)
Theorem NumD_S : forall q d, nat_p d -> ordsucc (q :: d) = q :: ordsucc d.
let q d. assume Hd: nat_p d.
prove ordsucc (add_nat (mul_nat 10 q) d) = add_nat (mul_nat 10 q) (ordsucc d).
rewrite add_nat_SR (mul_nat 10 q) d Hd.
reflexivity.
Qed.

Theorem NumD_carry : forall q, nat_p q -> forall d, nat_p d -> q :: add_nat 10 d = ordsucc q :: d.
let q. assume Hq: nat_p q. let d. assume Hd: nat_p d.
prove add_nat (mul_nat 10 q) (add_nat 10 d) = add_nat (mul_nat 10 (ordsucc q)) d.
rewrite mul_nat_SR 10 q Hq.
rewrite <- add_nat_asso (mul_nat 10 q) (mul_nat_p 10 nat_radix q Hq) 10 nat_radix d Hd.
rewrite add_nat_com (mul_nat 10 q) (mul_nat_p 10 nat_radix q Hq) 10 nat_radix.
reflexivity.
Qed.

Theorem NumD_zero : forall d, nat_p d -> 0 :: d = d.
let d. assume Hd: nat_p d.
prove add_nat (mul_nat 10 0) d = d.
rewrite mul_nat_0R 10.
exact add_nat_0L d Hd.
Qed.

(** Addition: digit by digit, and with a carry in. **)
Theorem NumD_add : forall q1, nat_p q1 -> forall q2, nat_p q2 -> forall d1, nat_p d1 -> forall d2, nat_p d2 ->
  add_nat (q1 :: d1) (q2 :: d2) = add_nat q1 q2 :: add_nat d1 d2.
let q1. assume H1: nat_p q1. let q2. assume H2: nat_p q2. let d1. assume H3: nat_p d1. let d2. assume H4: nat_p d2.
prove add_nat (add_nat (mul_nat 10 q1) d1) (add_nat (mul_nat 10 q2) d2) = add_nat (mul_nat 10 (add_nat q1 q2)) (add_nat d1 d2).
rewrite mul_add_nat_distrL 10 nat_radix q1 H1 q2 H2.
exact add_nat_swap_mid (mul_nat 10 q1) (mul_nat_p 10 nat_radix q1 H1) d1 H3 (mul_nat 10 q2) (mul_nat_p 10 nat_radix q2 H2) d2 H4.
Qed.

Theorem NumD_addc : forall q1, nat_p q1 -> forall q2, nat_p q2 -> forall d1, nat_p d1 -> forall d2, nat_p d2 ->
  ordsucc (add_nat (q1 :: d1) (q2 :: d2)) = add_nat q1 q2 :: ordsucc (add_nat d1 d2).
let q1. assume H1: nat_p q1. let q2. assume H2: nat_p q2. let d1. assume H3: nat_p d1. let d2. assume H4: nat_p d2.
rewrite NumD_add q1 H1 q2 H2 d1 H3 d2 H4.
exact NumD_S (add_nat q1 q2) (add_nat d1 d2) (add_nat_p d1 H3 d2 H4).
Qed.

(** One digit of an addition, with the sum of the digits before it known:
    without and with a carry out, and with a carry in. **)
Theorem NumD_add_step : forall qa, nat_p qa -> forall qb, nat_p qb -> forall da, nat_p da -> forall db, nat_p db ->
  forall q s, add_nat qa qb = q -> add_nat da db = s -> add_nat (qa :: da) (qb :: db) = q :: s.
let qa. assume Hqa: nat_p qa. let qb. assume Hqb: nat_p qb. let da. assume Hda: nat_p da. let db. assume Hdb: nat_p db.
let q s. assume Hq: add_nat qa qb = q. assume Hs: add_nat da db = s.
rewrite NumD_add qa Hqa qb Hqb da Hda db Hdb. rewrite Hq. rewrite Hs. reflexivity.
Qed.

Theorem NumD_add_carry : forall qa, nat_p qa -> forall qb, nat_p qb -> forall da, nat_p da -> forall db, nat_p db ->
  forall q s, nat_p s -> ordsucc (add_nat qa qb) = q -> add_nat da db = add_nat 10 s ->
  add_nat (qa :: da) (qb :: db) = q :: s.
let qa. assume Hqa: nat_p qa. let qb. assume Hqb: nat_p qb. let da. assume Hda: nat_p da. let db. assume Hdb: nat_p db.
let q s. assume Hsn: nat_p s. assume Hq: ordsucc (add_nat qa qb) = q. assume Hs: add_nat da db = add_nat 10 s.
rewrite NumD_add qa Hqa qb Hqb da Hda db Hdb. rewrite Hs.
rewrite NumD_carry (add_nat qa qb) (add_nat_p qa Hqa qb Hqb) s Hsn. rewrite Hq. reflexivity.
Qed.

Theorem NumD_addc_step : forall qa, nat_p qa -> forall qb, nat_p qb -> forall da, nat_p da -> forall db, nat_p db ->
  forall q s, add_nat qa qb = q -> ordsucc (add_nat da db) = s -> ordsucc (add_nat (qa :: da) (qb :: db)) = q :: s.
let qa. assume Hqa: nat_p qa. let qb. assume Hqb: nat_p qb. let da. assume Hda: nat_p da. let db. assume Hdb: nat_p db.
let q s. assume Hq: add_nat qa qb = q. assume Hs: ordsucc (add_nat da db) = s.
rewrite NumD_addc qa Hqa qb Hqb da Hda db Hdb. rewrite Hq. rewrite Hs. reflexivity.
Qed.

Theorem NumD_addc_carry : forall qa, nat_p qa -> forall qb, nat_p qb -> forall da, nat_p da -> forall db, nat_p db ->
  forall q s, nat_p s -> ordsucc (add_nat qa qb) = q -> ordsucc (add_nat da db) = add_nat 10 s ->
  ordsucc (add_nat (qa :: da) (qb :: db)) = q :: s.
let qa. assume Hqa: nat_p qa. let qb. assume Hqb: nat_p qb. let da. assume Hda: nat_p da. let db. assume Hdb: nat_p db.
let q s. assume Hsn: nat_p s. assume Hq: ordsucc (add_nat qa qb) = q. assume Hs: ordsucc (add_nat da db) = add_nat 10 s.
rewrite NumD_addc qa Hqa qb Hqb da Hda db Hdb. rewrite Hs.
rewrite NumD_carry (add_nat qa qb) (add_nat_p qa Hqa qb Hqb) s Hsn. rewrite Hq. reflexivity.
Qed.

(** Multiplication: by the radix, and by a numeral's digits. **)
Theorem NumD_mul_radix : forall x, nat_p x -> mul_nat x 10 = x :: 0.
let x. assume Hx: nat_p x.
prove mul_nat x 10 = add_nat (mul_nat 10 x) 0.
rewrite add_nat_0R (mul_nat 10 x).
exact mul_nat_com x Hx 10 nat_radix.
Qed.

Theorem mul_NumD : forall x, nat_p x -> forall q, nat_p q -> forall d, nat_p d ->
  mul_nat x (q :: d) = add_nat (mul_nat x q :: 0) (mul_nat x d).
let x. assume Hx: nat_p x. let q. assume Hq: nat_p q. let d. assume Hd: nat_p d.
prove mul_nat x (add_nat (mul_nat 10 q) d) = add_nat (add_nat (mul_nat 10 (mul_nat x q)) 0) (mul_nat x d).
rewrite add_nat_0R (mul_nat 10 (mul_nat x q)).
rewrite mul_add_nat_distrL x Hx (mul_nat 10 q) (mul_nat_p 10 nat_radix q Hq) d Hd.
rewrite <- mul_nat_asso x Hx 10 nat_radix q Hq.
rewrite mul_nat_com x Hx 10 nat_radix.
rewrite mul_nat_asso 10 nat_radix x Hx q Hq.
reflexivity.
Qed.

(** Congruences, for equations between numerals built as terms. **)
Theorem NumD_cong : forall q q' d d', q = q' -> d = d' -> q :: d = q' :: d'.
let q q' d d'. assume Hq: q = q'. assume Hd: d = d'.
rewrite Hq. rewrite Hd. reflexivity.
Qed.

Theorem add_nat_cong : forall a a' b b', a = a' -> b = b' -> add_nat a b = add_nat a' b'.
let a a' b b'. assume Ha: a = a'. assume Hb: b = b'.
rewrite Ha. rewrite Hb. reflexivity.
Qed.

Theorem mul_nat_cong : forall a a' b b', a = a' -> b = b' -> mul_nat a b = mul_nat a' b'.
let a a' b b'. assume Ha: a = a'. assume Hb: b = b'.
rewrite Ha. rewrite Hb. reflexivity.
Qed.

Theorem ordsucc_cong : forall a a', a = a' -> ordsucc a = ordsucc a'.
let a a'. assume Ha: a = a'.
rewrite Ha. reflexivity.
Qed.

(** Positive and negative examples: the radix is one, then a zero digit, and
    two numerals that differ in a digit differ. **)
Theorem NumD_lit_10 : 10 = 1 :: 0.
prove 10 = add_nat (mul_nat 10 1) 0.
rewrite add_nat_0R (mul_nat 10 1).
rewrite mul_nat_SR 10 0 nat_0.
rewrite mul_nat_0R 10.
rewrite add_nat_0R 10.
reflexivity.
Qed.

Theorem NumD_ex_not : 1 :: 0 <> 1 :: 1.
rewrite <- NumD_lit_10.
rewrite <- NumD_S 1 0 nat_0.
rewrite <- NumD_lit_10.
assume H: 10 = ordsucc 10.
exact In_irref 10 (In_fam_eq (fun X => X) (ordsucc 10) 10 (eq_sym_i 10 (ordsucc 10) H) 10 (ordsuccI2 10)).
Qed.

(** Positivity: a numeral whose leading part is positive is positive. **)
Theorem add_nat_0_In : forall a, 0 :e a -> forall d, nat_p d -> 0 :e add_nat a d.
let a. assume Ha: 0 :e a.
apply nat_ind.
- rewrite add_nat_0R a. exact Ha.
- let d. assume Hd: nat_p d. assume IH: 0 :e add_nat a d.
  rewrite add_nat_SR a d Hd.
  exact ordsuccI1 (add_nat a d) 0 IH.
Qed.

Theorem NumD_pos : forall q, nat_p q -> 0 :e q -> forall d, nat_p d -> 0 :e q :: d.
let q. assume Hq: nat_p q. assume H0: 0 :e q. let d. assume Hd: nat_p d.
claim HM: 0 :e mul_nat 10 q.
{ rewrite mul_nat_com 10 nat_radix q Hq.
  rewrite mul_nat_SR q 9 (nat_p_trans 10 nat_radix 9 (ordsuccI2 9)).
  exact add_nat_0_In q H0 (mul_nat q 9) (mul_nat_p q Hq 9 (nat_p_trans 10 nat_radix 9 (ordsuccI2 9))). }
prove 0 :e add_nat (mul_nat 10 q) d.
exact add_nat_0_In (mul_nat 10 q) HM d Hd.
Qed.

Theorem NumD_pos_ex : 0 :e 1 :: 0.
exact NumD_pos 1 nat_1 In_0_1 0 nat_0.
Qed.

Theorem NumD_pos_ex_not : 0 /:e 0 :: 0.
rewrite NumD_zero 0 nat_0.
exact In_irref 0.
Qed.
