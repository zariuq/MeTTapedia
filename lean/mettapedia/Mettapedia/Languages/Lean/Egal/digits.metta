; Positional numerals for Egal: writes the library of digits for one radix.
;
;   cetta --lang petta digits.metta Library/Digits.mg
;
; q :: d is the radix times q plus the digit d.  The laws (successor,
; addition with and without a carry, multiplication by the radix and by a
; numeral's digits) are fixed text over the radix; the tables are generated:
; every literal from the radix to its square with its digits (NumD_lit_y),
; every sum of two digits (Dadd_a_b), with a carry in (Daddc_a_b), and every
; digit sum above the radix split off it (Dsplit_s).  Each table entry is
; proved from the one before it, in a few steps.

!(import! &self fs)
!(import! &self str)
!(import! &self system)

; The radix: one line to change.
(= (radix) 10)

; Integer quotient and remainder (CeTTa's / of an exact multiple is exact).
(= (idiv $a $b) (/ (- $a (% $a $b)) $b))

(= (range-from $i $n) (if (>= $i $n) () (cons-atom $i (range-from (+ $i 1) $n))))
(= (natproof $n)
   (if (== $n 0) "nat_0" (format-args "(nat_ordsucc {} {})" ((- $n 1) (natproof (- $n 1))))))
(= (with-radix $t)
   (str:join (format-args "{}" ((* (radix) (radix)))) (str:split "BOUND" (str:join (format-args "{}" ((radix))) (str:split "RADIX"
     (str:join (format-args "{}" ((- (radix) 1))) (str:split "RPRED" $t)))))))

(= (laws-template) "(** Generated by digits.metta: positional numerals over Egal's ordinals, radix RADIX.  Do not edit.

    q :: d is RADIX times q plus the digit d.  A Lean literal at or above
    BOUND (the radix squared) is read as its digits over a literal below
    BOUND, the last digit outermost, so the digits read in order.  Egal's literals
    are unary chains, and Megalodon reads no literal beyond a machine
    integer; the digits keep large numbers small.  The laws compute
    successor, addition and multiplication digit by digit, and the tables
    give each literal's digits and each sum of two digits. **)

NATPROOFLINE
Definition NumD : set -> set -> set := fun q d => add_nat (mul_nat RADIX q) d.
Infix :: 300 left := NumD.

Theorem NumD_p : forall q, nat_p q -> forall d, nat_p d -> nat_p (q :: d).
let q. assume Hq: nat_p q. let d. assume Hd: nat_p d.
exact add_nat_p (mul_nat RADIX q) (mul_nat_p RADIX nat_radix q Hq) d Hd.
Qed.

Theorem add_nat_swap_mid : forall a, nat_p a -> forall b, nat_p b -> forall c, nat_p c -> forall d, nat_p d ->
  add_nat (add_nat a b) (add_nat c d) = add_nat (add_nat a c) (add_nat b d).
let a. assume Ha: nat_p a. let b. assume Hb: nat_p b. let c. assume Hc: nat_p c. let d. assume Hd: nat_p d.
rewrite add_nat_asso a Ha b Hb (add_nat c d) (add_nat_p c Hc d Hd).
rewrite add_nat_asso a Ha c Hc (add_nat b d) (add_nat_p b Hb d Hd).
rewrite <- add_nat_asso b Hb c Hc d Hd.
rewrite <- add_nat_asso c Hc b Hb d Hd.
rewrite add_nat_com b Hb c Hc.
reflexivity.
Qed.

(** Successor: the last digit grows, or carries. **)
Theorem NumD_S : forall q d, nat_p d -> ordsucc (q :: d) = q :: ordsucc d.
let q d. assume Hd: nat_p d.
prove ordsucc (add_nat (mul_nat RADIX q) d) = add_nat (mul_nat RADIX q) (ordsucc d).
rewrite add_nat_SR (mul_nat RADIX q) d Hd.
reflexivity.
Qed.

Theorem NumD_carry : forall q, nat_p q -> forall d, nat_p d -> q :: add_nat RADIX d = ordsucc q :: d.
let q. assume Hq: nat_p q. let d. assume Hd: nat_p d.
prove add_nat (mul_nat RADIX q) (add_nat RADIX d) = add_nat (mul_nat RADIX (ordsucc q)) d.
rewrite mul_nat_SR RADIX q Hq.
rewrite <- add_nat_asso (mul_nat RADIX q) (mul_nat_p RADIX nat_radix q Hq) RADIX nat_radix d Hd.
rewrite add_nat_com (mul_nat RADIX q) (mul_nat_p RADIX nat_radix q Hq) RADIX nat_radix.
reflexivity.
Qed.

Theorem NumD_zero : forall d, nat_p d -> 0 :: d = d.
let d. assume Hd: nat_p d.
prove add_nat (mul_nat RADIX 0) d = d.
rewrite mul_nat_0R RADIX.
exact add_nat_0L d Hd.
Qed.

(** Addition: digit by digit, and with a carry in. **)
Theorem NumD_add : forall q1, nat_p q1 -> forall q2, nat_p q2 -> forall d1, nat_p d1 -> forall d2, nat_p d2 ->
  add_nat (q1 :: d1) (q2 :: d2) = add_nat q1 q2 :: add_nat d1 d2.
let q1. assume H1: nat_p q1. let q2. assume H2: nat_p q2. let d1. assume H3: nat_p d1. let d2. assume H4: nat_p d2.
prove add_nat (add_nat (mul_nat RADIX q1) d1) (add_nat (mul_nat RADIX q2) d2) = add_nat (mul_nat RADIX (add_nat q1 q2)) (add_nat d1 d2).
rewrite mul_add_nat_distrL RADIX nat_radix q1 H1 q2 H2.
exact add_nat_swap_mid (mul_nat RADIX q1) (mul_nat_p RADIX nat_radix q1 H1) d1 H3 (mul_nat RADIX q2) (mul_nat_p RADIX nat_radix q2 H2) d2 H4.
Qed.

Theorem NumD_addc : forall q1, nat_p q1 -> forall q2, nat_p q2 -> forall d1, nat_p d1 -> forall d2, nat_p d2 ->
  ordsucc (add_nat (q1 :: d1) (q2 :: d2)) = add_nat q1 q2 :: ordsucc (add_nat d1 d2).
let q1. assume H1: nat_p q1. let q2. assume H2: nat_p q2. let d1. assume H3: nat_p d1. let d2. assume H4: nat_p d2.
rewrite NumD_add q1 H1 q2 H2 d1 H3 d2 H4.
exact NumD_S (add_nat q1 q2) (add_nat d1 d2) (add_nat_p d1 H3 d2 H4).
Qed.

(** One digit of an addition, with the sum of the digits before it known:
    without and with a carry out, and with a carry in. **)
Theorem NumD_add_step : forall qa, nat_p qa -> forall qb, nat_p qb -> forall da, nat_p da -> forall db, nat_p db ->
  forall q s, add_nat qa qb = q -> add_nat da db = s -> add_nat (qa :: da) (qb :: db) = q :: s.
let qa. assume Hqa: nat_p qa. let qb. assume Hqb: nat_p qb. let da. assume Hda: nat_p da. let db. assume Hdb: nat_p db.
let q s. assume Hq: add_nat qa qb = q. assume Hs: add_nat da db = s.
rewrite NumD_add qa Hqa qb Hqb da Hda db Hdb. rewrite Hq. rewrite Hs. reflexivity.
Qed.

Theorem NumD_add_carry : forall qa, nat_p qa -> forall qb, nat_p qb -> forall da, nat_p da -> forall db, nat_p db ->
  forall q s, nat_p s -> ordsucc (add_nat qa qb) = q -> add_nat da db = add_nat RADIX s ->
  add_nat (qa :: da) (qb :: db) = q :: s.
let qa. assume Hqa: nat_p qa. let qb. assume Hqb: nat_p qb. let da. assume Hda: nat_p da. let db. assume Hdb: nat_p db.
let q s. assume Hsn: nat_p s. assume Hq: ordsucc (add_nat qa qb) = q. assume Hs: add_nat da db = add_nat RADIX s.
rewrite NumD_add qa Hqa qb Hqb da Hda db Hdb. rewrite Hs.
rewrite NumD_carry (add_nat qa qb) (add_nat_p qa Hqa qb Hqb) s Hsn. rewrite Hq. reflexivity.
Qed.

Theorem NumD_addc_step : forall qa, nat_p qa -> forall qb, nat_p qb -> forall da, nat_p da -> forall db, nat_p db ->
  forall q s, add_nat qa qb = q -> ordsucc (add_nat da db) = s -> ordsucc (add_nat (qa :: da) (qb :: db)) = q :: s.
let qa. assume Hqa: nat_p qa. let qb. assume Hqb: nat_p qb. let da. assume Hda: nat_p da. let db. assume Hdb: nat_p db.
let q s. assume Hq: add_nat qa qb = q. assume Hs: ordsucc (add_nat da db) = s.
rewrite NumD_addc qa Hqa qb Hqb da Hda db Hdb. rewrite Hq. rewrite Hs. reflexivity.
Qed.

Theorem NumD_addc_carry : forall qa, nat_p qa -> forall qb, nat_p qb -> forall da, nat_p da -> forall db, nat_p db ->
  forall q s, nat_p s -> ordsucc (add_nat qa qb) = q -> ordsucc (add_nat da db) = add_nat RADIX s ->
  ordsucc (add_nat (qa :: da) (qb :: db)) = q :: s.
let qa. assume Hqa: nat_p qa. let qb. assume Hqb: nat_p qb. let da. assume Hda: nat_p da. let db. assume Hdb: nat_p db.
let q s. assume Hsn: nat_p s. assume Hq: ordsucc (add_nat qa qb) = q. assume Hs: ordsucc (add_nat da db) = add_nat RADIX s.
rewrite NumD_addc qa Hqa qb Hqb da Hda db Hdb. rewrite Hs.
rewrite NumD_carry (add_nat qa qb) (add_nat_p qa Hqa qb Hqb) s Hsn. rewrite Hq. reflexivity.
Qed.

(** Multiplication: by the radix, and by a numeral's digits. **)
Theorem NumD_mul_radix : forall x, nat_p x -> mul_nat x RADIX = x :: 0.
let x. assume Hx: nat_p x.
prove mul_nat x RADIX = add_nat (mul_nat RADIX x) 0.
rewrite add_nat_0R (mul_nat RADIX x).
exact mul_nat_com x Hx RADIX nat_radix.
Qed.

Theorem mul_NumD : forall x, nat_p x -> forall q, nat_p q -> forall d, nat_p d ->
  mul_nat x (q :: d) = add_nat (mul_nat x q :: 0) (mul_nat x d).
let x. assume Hx: nat_p x. let q. assume Hq: nat_p q. let d. assume Hd: nat_p d.
prove mul_nat x (add_nat (mul_nat RADIX q) d) = add_nat (add_nat (mul_nat RADIX (mul_nat x q)) 0) (mul_nat x d).
rewrite add_nat_0R (mul_nat RADIX (mul_nat x q)).
rewrite mul_add_nat_distrL x Hx (mul_nat RADIX q) (mul_nat_p RADIX nat_radix q Hq) d Hd.
rewrite <- mul_nat_asso x Hx RADIX nat_radix q Hq.
rewrite mul_nat_com x Hx RADIX nat_radix.
rewrite mul_nat_asso RADIX nat_radix x Hx q Hq.
reflexivity.
Qed.

(** Congruences, for equations between numerals built as terms. **)
Theorem NumD_cong : forall q q' d d', q = q' -> d = d' -> q :: d = q' :: d'.
let q q' d d'. assume Hq: q = q'. assume Hd: d = d'.
rewrite Hq. rewrite Hd. reflexivity.
Qed.

Theorem add_nat_cong : forall a a' b b', a = a' -> b = b' -> add_nat a b = add_nat a' b'.
let a a' b b'. assume Ha: a = a'. assume Hb: b = b'.
rewrite Ha. rewrite Hb. reflexivity.
Qed.

Theorem mul_nat_cong : forall a a' b b', a = a' -> b = b' -> mul_nat a b = mul_nat a' b'.
let a a' b b'. assume Ha: a = a'. assume Hb: b = b'.
rewrite Ha. rewrite Hb. reflexivity.
Qed.

Theorem ordsucc_cong : forall a a', a = a' -> ordsucc a = ordsucc a'.
let a a'. assume Ha: a = a'.
rewrite Ha. reflexivity.
Qed.

(** Positive and negative examples: the radix is one, then a zero digit, and
    two numerals that differ in a digit differ. **)
Theorem NumD_lit_RADIX : RADIX = 1 :: 0.
prove RADIX = add_nat (mul_nat RADIX 1) 0.
rewrite add_nat_0R (mul_nat RADIX 1).
rewrite mul_nat_SR RADIX 0 nat_0.
rewrite mul_nat_0R RADIX.
rewrite add_nat_0R RADIX.
reflexivity.
Qed.

Theorem NumD_ex_not : 1 :: 0 <> 1 :: 1.
rewrite <- NumD_lit_RADIX.
rewrite <- NumD_S 1 0 nat_0.
rewrite <- NumD_lit_RADIX.
assume H: RADIX = ordsucc RADIX.
exact In_irref RADIX (In_fam_eq (fun X => X) (ordsucc RADIX) RADIX (eq_sym_i RADIX (ordsucc RADIX) H) RADIX (ordsuccI2 RADIX)).
Qed.

(** Positivity: a numeral whose leading part is positive is positive. **)
Theorem add_nat_0_In : forall a, 0 :e a -> forall d, nat_p d -> 0 :e add_nat a d.
let a. assume Ha: 0 :e a.
apply nat_ind.
- rewrite add_nat_0R a. exact Ha.
- let d. assume Hd: nat_p d. assume IH: 0 :e add_nat a d.
  rewrite add_nat_SR a d Hd.
  exact ordsuccI1 (add_nat a d) 0 IH.
Qed.

Theorem NumD_pos : forall q, nat_p q -> 0 :e q -> forall d, nat_p d -> 0 :e q :: d.
let q. assume Hq: nat_p q. assume H0: 0 :e q. let d. assume Hd: nat_p d.
claim HM: 0 :e mul_nat RADIX q.
{ rewrite mul_nat_com RADIX nat_radix q Hq.
  rewrite mul_nat_SR q RPRED (nat_p_trans RADIX nat_radix RPRED (ordsuccI2 RPRED)).
  exact add_nat_0_In q H0 (mul_nat q RPRED) (mul_nat_p q Hq RPRED (nat_p_trans RADIX nat_radix RPRED (ordsuccI2 RPRED))). }
prove 0 :e add_nat (mul_nat RADIX q) d.
exact add_nat_0_In (mul_nat RADIX q) HM d Hd.
Qed.

Theorem NumD_pos_ex : 0 :e 1 :: 0.
exact NumD_pos 1 nat_1 In_0_1 0 nat_0.
Qed.

Theorem NumD_pos_ex_not : 0 /:e 0 :: 0.
rewrite NumD_zero 0 nat_0.
exact In_irref 0.
Qed.
")

(= (nat-radix-text)
   (format-args "Theorem nat_radix : nat_p {}.
exact {}.
Qed.
" ((radix) (natproof (radix)))))

; nat_p k for every literal below the bound, from k - 1.
(= (dnat-lemma $k)
   (if (== $k 0) "Theorem Dnat_0 : nat_p 0.
exact nat_0.
Qed.
"
       (format-args "Theorem Dnat_{} : nat_p {}.
exact nat_ordsucc {} Dnat_{}.
Qed.
" ($k $k (- $k 1) (- $k 1)))))

; y = q :: d, from y - 1: the last digit grows, or carries into q.
(= (lit-lemma $y)
   (let* (($R (radix)) ($q (idiv $y $R)) ($d (% $y $R)) ($p (- $y 1)))
     (if (> $d 0)
         (format-args "Theorem NumD_lit_{} : {} = {} :: {}.
rewrite NumD_lit_{}.
exact NumD_S {} {} Dnat_{}.
Qed.
" ($y $y $q $d $p $q (- $d 1) (- $d 1)))
         (format-args "Theorem NumD_lit_{} : {} = {} :: 0.
rewrite NumD_lit_{}.
rewrite NumD_S {} {} Dnat_{}.
prove {} :: {} = {} :: 0.
rewrite <- add_nat_0R {}.
exact NumD_carry {} Dnat_{} 0 nat_0.
Qed.
" ($y $y $q $p (- $q 1) (- $R 1) (- $R 1) (- $q 1) $R $q $R (- $q 1) (- $q 1))))))

; a + b = s for digits, from a + (b - 1).
(= (dadd-lemma $a $b)
   (if (== $b 0)
       (format-args "Theorem Dadd_{}_0 : add_nat {} 0 = {}.
exact add_nat_0R {}.
Qed.
" ($a $a $a $a))
       (format-args "Theorem Dadd_{}_{} : add_nat {} {} = {}.
rewrite add_nat_SR {} {} Dnat_{}.
rewrite Dadd_{}_{}.
reflexivity.
Qed.
" ($a $b $a $b (+ $a $b) $a (- $b 1) (- $b 1) $a (- $b 1)))))
(= (daddc-lemma $a $b)
   (format-args "Theorem Daddc_{}_{} : ordsucc (add_nat {} {}) = {}.
rewrite Dadd_{}_{}.
reflexivity.
Qed.
" ($a $b $a $b (+ (+ $a $b) 1) $a $b)))
; s = radix + k for a digit sum s at or above the radix, from s - 1.
(= (dsplit-lemma $k)
   (let* (($R (radix)) ($s (+ $R $k)))
     (if (== $k 0)
         (format-args "Theorem Dsplit_{} : {} = add_nat {} 0.
rewrite add_nat_0R {}.
reflexivity.
Qed.
" ($s $s $R $R))
         (format-args "Theorem Dsplit_{} : {} = add_nat {} {}.
rewrite add_nat_SR {} {} Dnat_{}.
rewrite <- Dsplit_{}.
reflexivity.
Qed.
" ($s $s $R $k $R (- $k 1) (- $k 1) (- $s 1))))))

(= (digits-text)
   (let* (($R (radix)) ($ds (range-from 0 $R)))
     (str:join "" (append-all
       ((cons-atom (str:join (nat-radix-text) (str:split "NATPROOFLINE\n" (with-radix (laws-template)))) ())
        (map-atom (range-from 0 (* $R $R)) $k (dnat-lemma $k))
        (map-atom (range-from (+ $R 1) (* $R $R)) $y (lit-lemma $y))
        (map-atom (flat-pairs $ds $ds) $p (case $p (((pr $a $b) (dadd-lemma $a $b)))))
        (map-atom (flat-pairs $ds $ds) $p (case $p (((pr $a $b) (daddc-lemma $a $b)))))
        (map-atom $ds $k (dsplit-lemma $k)))))))
(= (flat-pairs $as $bs)
   (if (== $as ()) () (append-lists (map-atom $bs $b (pr (car-atom $as) $b)) (flat-pairs (cdr-atom $as) $bs))))
(= (append-lists $xs $ys) (if (== $xs ()) $ys (cons-atom (car-atom $xs) (append-lists (cdr-atom $xs) $ys))))
(= (append-all $ls) (if (== $ls ()) () (append-lists (car-atom $ls) (append-all (cdr-atom $ls)))))

!(let $out (car-atom (system:args)) (fs:write $out (digits-text)))
