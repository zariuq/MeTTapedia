; Read actual CeTTa observations from the differential runner's JSON report.
; Usage: answers.metta REPORT ANSWERS BINARY with-source|without-source TESTS.tsv
; A crash, extra output, timeout or disagreement stops generation.
!(import! &self fs)
!(import! &self json)
!(import! &self str)
!(import! &self system)

(= (answers-fail $message)
   (let $_printed (system:write stderr (format-args "answers: {}\n" ($message)))
     (system:exit 1)))
(= (answer-line $row $mode)
   (let* (($i (json:get $row "index")) ($status (json:get $row "status"))
          ($answer (json:get $row "answer")) ($expected (json:get $row "expected"))
          ($source (json:get $row "lean_source")) ($code (json:get $row "returncode"))
          ($one (case (json:get $row "stdout_lines")
                  (((JsonArray ($line)) (== $line $answer)) ($_ False)))))
     (if (== $status "agree")
         (if (and (== $code 0) (and $one (== $answer $expected)))
             (format-args "(LeanTest {})\n(CeTTaAnswer {} {})\n{}"
               ($i $i $answer
                (if (== (format-args "{}" ($mode)) "with-source")
                    (case (str:find $source "*")
                      (((TextNotFound $_) (format-args "(LeanSource {} {})\n" ($i (json:stringify $source))))
                       ($_ ""))) "")))
             (answers-fail (format-args "inconsistent successful observation for test {}" ($i))))
         (answers-fail (format-args "test {} returned {}" ($i $status))))))
(= (answer-lines $rows $mode)
   (if (== $rows ()) ""
       (str:concat (answer-line (car-atom $rows) $mode) (answer-lines (cdr-atom $rows) $mode))))
(= (expected-ids $lines)
   (if (== $lines ()) ()
       (if (== (str:trim (car-atom $lines)) "") (expected-ids (cdr-atom $lines))
           (cons-atom (str:string->number (car-atom (str:split "\t" (car-atom $lines))))
             (expected-ids (cdr-atom $lines))))))
(= (observed-ids $rows)
   (if (== $rows ()) ()
       (cons-atom (json:get (car-atom $rows) "index") (observed-ids (cdr-atom $rows)))))
!(let* ((($report $out $binary $mode $tests) (system:args))
        ($document (json:parse (fs:read-text $report))))
   (case (json:get $document "tests")
     (((JsonArray $rows)
       (if (== (observed-ids $rows) (expected-ids (cdr-atom (fs:read-lines $tests))))
       (let* (($text (answer-lines $rows $mode))
              ($_out (fs:write $out $text)))
         (fs:write $binary (json:get (json:get $document "binary") "name")))
       (answers-fail "observed test identities differ from the source inventory")))
      ($_ (answers-fail "report has no test observation array")))))
