{ rewrite mul_nat_SR 1 1 (nat_ordsucc 0 nat_0). rewrite PQ101_1. rewrite add_nat_SR 1 0 nat_0. rewrite add_nat_0R 1. reflexivity. }
claim PQ101_3: mul_nat 1 3 = 3.
{ rewrite mul_nat_SR 1 2 (nat_ordsucc 1 (nat_ordsucc 0 nat_0)). rewrite PQ101_2. rewrite add_nat_SR 1 1 (nat_ordsucc 0 nat_0). rewrite add_nat_SR 1 0 nat_0. rewrite add_nat_0R 1. reflexivity. }
