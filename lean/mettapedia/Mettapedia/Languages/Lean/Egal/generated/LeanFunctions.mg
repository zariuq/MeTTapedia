Theorem Lean_Nat_gcdFuel_method1_1_In : forall y0 :e Lean_Nat, (Lean_Nat_gcdFuel_method1_1 y0) :e (Pi_ r0 :e (Pi_ ux :e Lean_Nat, (Pi_ ux :e Lean_Nat, Lean_Nat)), (Pi_ a1 :e Lean_Nat, (Pi_ a2 :e
    Lean_Nat, Lean_Nat))).
