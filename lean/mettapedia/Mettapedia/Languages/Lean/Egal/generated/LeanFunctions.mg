  rewrite Hg1 a1 H1 y0 Hy0. rewrite Lean_Nat_mod_eq_2 a1 H1 y0 Hy0. reflexivity. }
claim LC: Lean_Nat_rec 0 (fun y0 :e Lean_Nat => (fun r0 :e {z :e 1 | g y0 a1 = Lean_Nat_mod y0 a1} => 0)) a0 :e (fun t:set => {z :e 1 | g t a1 = Lean_Nat_mod t a1}) a0.
{ exact Lean_Nat_rec_type (fun t:set => {z :e 1 | g t a1 = Lean_Nat_mod t a1}) 0 (L0) (fun y0 :e Lean_Nat => (fun r0 :e {z :e 1 | g y0 a1 = Lean_Nat_mod y0 a1} => 0)) (lam_Pi Lean_Nat (fun y0 => (Pi_
    r0 :e {z :e 1 | g y0 a1 = Lean_Nat_mod y0 a1}, {z :e 1 | g (Lean_Nat_succ_node y0) a1 = Lean_Nat_mod (Lean_Nat_succ_node y0) a1})) (fun y0 => (fun r0 :e {z :e 1 | g y0 a1 = Lean_Nat_mod y0 a1} =>
    0)) (fun y0 Hy0 => (lam_Pi {z :e 1 | g y0 a1 = Lean_Nat_mod y0 a1} (fun r0 => {z :e 1 | g (Lean_Nat_succ_node y0) a1 = Lean_Nat_mod (Lean_Nat_succ_node y0) a1}) (fun r0 => 0) (fun r0 Hr0 => (L1
    y0 Hy0 r0 Hr0))))) a0 H0. }
exact SepE2 1 (fun z:set => g a0 a1 = Lean_Nat_mod a0 a1) (Lean_Nat_rec 0 (fun y0 :e Lean_Nat => (fun r0 :e {z :e 1 | g y0 a1 = Lean_Nat_mod y0 a1} => 0)) a0) LC.
