    { exact ap_Pi Lean_Nat (fun v_x => (Pi_ ux :e (Lean_Nat_le_Prop (Lean_Nat_succ_node v_x) (Lean_Nat_sub (LeanNum h) (LeanNum l))), (v_P (Lean_Nat_add (LeanNum l) v_x)))) 0 (LeanNum j) HL
    (LeanNum_In j Hj1). }
