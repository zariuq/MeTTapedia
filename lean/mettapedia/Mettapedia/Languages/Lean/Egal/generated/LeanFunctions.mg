Theorem Lean_Nat_gcdFuel_In : forall a0 :e Lean_Nat, forall a1 :e Lean_Nat, forall a2 :e Lean_Nat, Lean_Nat_gcdFuel a0 a1 a2 :e Lean_Nat.
let a0. assume H0: a0 :e Lean_Nat. let a1. assume H1: a1 :e Lean_Nat. let a2. assume H2: a2 :e Lean_Nat. exact (ap_Pi Lean_Nat (fun _ => Lean_Nat) ((Lean_Nat_rec Lean_Nat_gcdFuel_method0_0
    Lean_Nat_gcdFuel_method1_0 a0) a1) a2 (ap_Pi Lean_Nat (fun _ => (Pi_ ux :e Lean_Nat, Lean_Nat)) (Lean_Nat_rec Lean_Nat_gcdFuel_method0_0 Lean_Nat_gcdFuel_method1_0 a0) a1 (Lean_Nat_gcdFuel_recIn
    a0 H0) H1) H2).
