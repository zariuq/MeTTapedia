Theorem Lean_Nat_gcdFuel_eq_1 : forall v_x :e Lean_Nat, forall v_x1 :e Lean_Nat, (Lean_Nat_gcdFuel Lean_Nat_zero_node v_x v_x1) = v_x1.
let v_x. assume H_v_x: v_x :e Lean_Nat. let v_x1. assume H_v_x1: v_x1 :e Lean_Nat.
