claim L1: forall y0 :e Lean_Nat, forall r0 :e {z :e 1 | g y0 a1 = Lean_Nat_mod y0 a1}, 0 :e {z :e 1 | g (Lean_Nat_succ_node y0) a1 = Lean_Nat_mod (Lean_Nat_succ_node y0) a1}.
{ let y0. assume Hy0: y0 :e Lean_Nat. let r0. assume Hr0: r0 :e {z :e 1 | g y0 a1 = Lean_Nat_mod y0 a1}. apply SepI 1 (fun z:set => g (Lean_Nat_succ_node y0) a1 = Lean_Nat_mod (Lean_Nat_succ_node y0)
    a1) 0 In_0_1.
