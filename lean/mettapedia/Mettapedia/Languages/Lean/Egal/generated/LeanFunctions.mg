    (Lean_Nat_mod a2 a1) a1) (ap_Pi Lean_Nat (fun _ => Lean_Nat) (r0 (Lean_Nat_mod a2 a1)) a1 (ap_Pi Lean_Nat (fun _ => (Pi_ ux :e Lean_Nat, Lean_Nat)) r0 (Lean_Nat_mod a2 a1) Hr0 (Lean_Nat_mod_In a2
    Ha2 a1 Ha1)) Ha1))).
Qed.
Definition Lean_Nat_gcdFuel_method1_2 : set -> set -> set := fun y0 r0 => (fun a1 :e Lean_Nat => (Lean_Nat_gcdFuel_method1_3 y0 r0 a1)).
Theorem Lean_Nat_gcdFuel_method1_2_ap : forall y0 r0, forall a1 :e Lean_Nat, (Lean_Nat_gcdFuel_method1_2 y0 r0) a1 = (Lean_Nat_gcdFuel_method1_3 y0 r0 a1).
