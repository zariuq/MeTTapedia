exact Lean_Nat_rec_type (fun _ => (Pi_ ux :e Lean_Nat, (Pi_ ux :e Lean_Nat, Lean_Nat))) Lean_Nat_gcdFuel_method0_0 (Lean_Nat_gcdFuel_method0_0_In) Lean_Nat_gcdFuel_method1_0
    (Lean_Nat_gcdFuel_method1_0_In) t Ht.
