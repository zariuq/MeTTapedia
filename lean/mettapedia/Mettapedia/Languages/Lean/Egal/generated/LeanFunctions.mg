exact beta Lean_Nat (fun a2 => (Lean_ite Lean_Nat (Lean_Eq_Prop Lean_Nat a1 (LeanNum 0)) (Lean_instDecidableEqNat a1 (LeanNum 0)) a2 (r0 (Lean_Nat_mod a2 a1) a1))) a2 H.
Qed.
Theorem Lean_Nat_gcdFuel_method1_3_In : forall y0 :e Lean_Nat, forall r0 :e (Pi_ ux :e Lean_Nat, (Pi_ ux :e Lean_Nat, Lean_Nat)), forall a1 :e Lean_Nat, (Lean_Nat_gcdFuel_method1_3 y0 r0 a1) :e (Pi_
    a2 :e Lean_Nat, Lean_Nat).
let y0. assume Hy0: y0 :e Lean_Nat. let r0. assume Hr0: r0 :e (Pi_ ux :e Lean_Nat, (Pi_ ux :e Lean_Nat, Lean_Nat)). let a1. assume Ha1: a1 :e Lean_Nat. exact lam_Pi Lean_Nat (fun a2 => Lean_Nat) (fun
    a2 => (Lean_ite Lean_Nat (Lean_Eq_Prop Lean_Nat a1 (LeanNum 0)) (Lean_instDecidableEqNat a1 (LeanNum 0)) a2 (r0 (Lean_Nat_mod a2 a1) a1))) (fun a2 Ha2 => (Lean_ite_In Lean_Nat (Lean_Eq_Prop
