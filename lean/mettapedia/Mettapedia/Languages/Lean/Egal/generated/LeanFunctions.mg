    (Lean_List v_u945) (fun v_x5 :e (Lean_List v_u945) => (Sigma (Lean_List v_u945) (Lean_List_Perm_Prop v_u945 v_x5)))), 0 :e (Lean_Multiset_Nodup v_u945 v_s) -> 0 :e (Lean_Multiset_Nodup v_u945
