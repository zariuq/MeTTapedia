let m. assume Hm: nat_p m. let n. assume Hn: nat_p n. assume H: m c= n.
apply ordinal_In_Or_Subq m n (nat_p_ordinal m Hm) (nat_p_ordinal n Hn).
- assume Hmn: m :e n. exact ordsuccI1 n m Hmn.
- assume Hnm: n c= m.
  rewrite set_ext m n H Hnm.
  exact ordsuccI2 n.
