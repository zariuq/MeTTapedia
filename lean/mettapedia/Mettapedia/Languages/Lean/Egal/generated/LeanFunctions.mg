  assume Hb2: LeanNat_ord (Lean_List_length A (LeanMergeSort_half2 A (Lean_List_cons_node A a (Lean_List_cons_node A b xs)))) :e LeanNat_ord (Lean_List_length A (Lean_List_cons_node A a
