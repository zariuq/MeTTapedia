Theorem Lean_Option_ind : forall P:set -> prop, (P Lean_Option_none_node) -> (forall x0 :e P0, P (Lean_Option_some_node x0)) -> forall t :e Lean_Option, P t.
let P. assume H0. assume H1.
claim M0: 0 :e {z :e 1 | P Lean_Option_none_node}.
{ exact SepI 1 (fun z => P Lean_Option_none_node) 0 In_0_1 (H0). }
claim M1: 0 :e (Pi_ x0 :e P0, {z :e 1 | P (Lean_Option_some_node x0)}).
{ apply Pi_0_In. let x0. assume Hx0: x0 :e P0.
