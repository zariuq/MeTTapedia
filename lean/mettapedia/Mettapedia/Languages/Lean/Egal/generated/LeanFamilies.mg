claim U1: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 1 = x1.
{ rewrite SeqAt_S. { rewrite SeqAt_0. reflexivity. } exact nat_0. }
claim T1: TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)) 1 = x1.
{ rewrite TupArgs_at 2 (SeqCons (x0) (SeqCons (x1) SeqNil)) 1 (ordsuccI2 1). exact U1. }
claim M0: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 0 :e Lean_And_B :\/: Lean_And_All.
{ exact In_eq_ls (SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 0) x0 (Lean_And_B :\/: Lean_And_All) U0 (binunionI1 Lean_And_B Lean_And_All x0 (binunionI1 (P0) (P1) x0 H0)). }
claim M1: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 1 :e Lean_And_B :\/: Lean_And_All.
{ exact In_eq_ls (SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 1) x1 (Lean_And_B :\/: Lean_And_All) U1 (binunionI1 Lean_And_B Lean_And_All x1 (binunionI2 (P0) (P1) x1 H1)). }
claim D0: (Lean_And_R 0 0 -> (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) 0 :e Lean_And_All /\ IndIdx Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B
    ((TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) 0) = Lean_And_Ix 0 0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) /\ (~ Lean_And_R 0 0 -> (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) 0
    :e Lean_And_F 0 0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))).
{ apply andI.
  - assume Hr: Lean_And_R 0 0. apply FalseE. exact Lean_And_nR0_0 Hr.
  - assume Hnr: ~ Lean_And_R 0 0. exact In_eq_ls ((TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) 0) x0 (Lean_And_F 0 0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) T0 (In_eq_rs x0 (Lean_And_F
    0 0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) P0 (Lean_And_F0_0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) H0).
}
claim D1: (Lean_And_R 0 1 -> (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) 1 :e Lean_And_All /\ IndIdx Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B
    ((TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) 1) = Lean_And_Ix 0 1 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) /\ (~ Lean_And_R 0 1 -> (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) 1
    :e Lean_And_F 0 1 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))).
{ apply andI.
  - assume Hr: Lean_And_R 0 1. apply FalseE. exact Lean_And_nR0_1 Hr.
  - assume Hnr: ~ Lean_And_R 0 1. exact In_eq_ls ((TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) 1) x1 (Lean_And_F 0 1 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) T1 (In_eq_rs x1 (Lean_And_F
    0 1 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) P1 (Lean_And_F0_1 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) H1).
}
prove (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) :e {a :e Pi_ j :e SeqAt (SeqCons (2) SeqNil) 0, Lean_And_B :\/: Lean_And_All | IndFits Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F
    Lean_And_Ix Lean_And_O Lean_And_B Lean_And_All 0 a}.
rewrite Lean_And_N0.
apply SepI (Pi_ j :e 2, Lean_And_B :\/: Lean_And_All) (fun a => IndFits Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B Lean_And_All 0 a) (TupArgs 2 (SeqCons
    (x0) (SeqCons (x1) SeqNil))).
- exact lam_Pi 2 (fun j => Lean_And_B :\/: Lean_And_All) (fun j => SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) j) (Below_S 1 (fun j => SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) j :e Lean_And_B :\/:
    Lean_And_All) (Below_S 0 (fun j => SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) j :e Lean_And_B :\/: Lean_And_All) (Below_0 (fun j => SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) j :e Lean_And_B :\/:
    Lean_And_All)) M0) M1).
- prove IndFits Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B Lean_And_All 0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))).
  let j. assume Hj: j :e Lean_And_N 0.
  exact (Below_S 1 (fun j => (Lean_And_R 0 j -> (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) j :e Lean_And_All /\ IndIdx Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix
    Lean_And_O Lean_And_B ((TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) j) = Lean_And_Ix 0 j (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) /\ (~ Lean_And_R 0 j -> (TupArgs 2 (SeqCons (x0)
    (SeqCons (x1) SeqNil))) j :e Lean_And_F 0 j (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))))) (Below_S 0 (fun j => (Lean_And_R 0 j -> (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) j :e
    Lean_And_All /\ IndIdx Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B ((TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) j) = Lean_And_Ix 0 j (TupArgs 2
    (SeqCons (x0) (SeqCons (x1) SeqNil)))) /\ (~ Lean_And_R 0 j -> (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) j :e Lean_And_F 0 j (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))))) (Below_0
    (fun j => (Lean_And_R 0 j -> (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) j :e Lean_And_All /\ IndIdx Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B
    ((TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) j) = Lean_And_Ix 0 j (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) /\ (~ Lean_And_R 0 j -> (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) j
    :e Lean_And_F 0 j (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))))) D0) D1) j (In_eq_r j (Lean_And_N 0) 2 Lean_And_N0 Hj).
Qed.
Theorem Lean_And_intro_typed : forall x0 :e P0, forall x1 :e P1, Lean_And_intro_node x0 x1 :e Lean_And.
let x0. assume H0: x0 :e P0. let x1. assume H1: x1 :e P1.
claim U0: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 0 = x0.
{ rewrite SeqAt_0. reflexivity. }
claim T0: TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)) 0 = x0.
{ rewrite TupArgs_at 2 (SeqCons (x0) (SeqCons (x1) SeqNil)) 0 (ordsuccI1 1 0 (ordsuccI2 0)). exact U0. }
claim U1: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 1 = x1.
{ rewrite SeqAt_S. { rewrite SeqAt_0. reflexivity. } exact nat_0. }
claim T1: TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)) 1 = x1.
{ rewrite TupArgs_at 2 (SeqCons (x0) (SeqCons (x1) SeqNil)) 1 (ordsuccI2 1). exact U1. }
claim L: Lean_And_intro_node x0 x1 :e IndFiber Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B (Lean_And_O 0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))).
{ exact IndNode_Fiber Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B Lean_And_bounded 0 (ordsuccI2 0) Lean_And_ar0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1)
    SeqNil))) (Lean_And_intro_args x0 H0 x1 H1). }
claim Lo: Lean_And_O 0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))) = 0.
{ prove SeqAt (SeqCons (0) SeqNil) 0 = 0. rewrite Lean_And_O0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))). reflexivity. }
exact In_fam_eq (IndFiber Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B) (Lean_And_O 0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil)))) 0 Lo
    (Lean_And_intro_node x0 x1) L.
Qed.
Definition Lean_And_intro : set := (fun x0 :e P0 => (fun x1 :e P1 => Lean_And_intro_node x0 x1)).
Theorem Lean_And_intro_type : Lean_And_intro :e (Pi_ x0 :e P0, (Pi_ x1 :e P1, Lean_And)).
exact (lam_Pi P0 (fun x0 => (Pi_ x1 :e P1, Lean_And)) (fun x0 => (fun x1 :e P1 => Lean_And_intro_node x0 x1)) (fun x0 H0 => (lam_Pi P1 (fun x1 => Lean_And) (fun x1 => Lean_And_intro_node x0 x1) (fun
    x1 H1 => (Lean_And_intro_typed x0 H0 x1 H1))))).
Qed.

Definition Lean_And_rec : set -> set -> set := fun h0 t => IndRec Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B (fun k a r:set => SeqAt (SeqCons ((h0 (a 0)
