    ((TupArgs 1 (SeqCons (x0) SeqNil)) j) = Lean_Sum_Ix 1 j (TupArgs 1 (SeqCons (x0) SeqNil))) /\ (~ Lean_Sum_R 1 j -> (TupArgs 1 (SeqCons (x0) SeqNil)) j :e Lean_Sum_F 1 j (TupArgs 1 (SeqCons (x0)
    SeqNil)))) (Below_0 (fun j => (Lean_Sum_R 1 j -> (TupArgs 1 (SeqCons (x0) SeqNil)) j :e Lean_Sum_All /\ IndIdx Lean_Sum_K Lean_Sum_T Lean_Sum_N Lean_Sum_R Lean_Sum_F Lean_Sum_Ix Lean_Sum_O
    Lean_Sum_B ((TupArgs 1 (SeqCons (x0) SeqNil)) j) = Lean_Sum_Ix 1 j (TupArgs 1 (SeqCons (x0) SeqNil))) /\ (~ Lean_Sum_R 1 j -> (TupArgs 1 (SeqCons (x0) SeqNil)) j :e Lean_Sum_F 1 j (TupArgs 1
    (SeqCons (x0) SeqNil))))) D0) j (In_eq_r j (Lean_Sum_N 1) 1 Lean_Sum_N1 Hj).
