Theorem Lean_Sum_inr_typed : forall x0 :e P1, Lean_Sum_inr_node x0 :e Lean_Sum.
let x0. assume H0: x0 :e P1.
claim U0: SeqAt (SeqCons (x0) SeqNil) 0 = x0.
{ rewrite SeqAt_0. reflexivity. }
claim T0: TupArgs 1 (SeqCons (x0) SeqNil) 0 = x0.
{ rewrite TupArgs_at 1 (SeqCons (x0) SeqNil) 0 (ordsuccI2 0). exact U0. }
claim L: Lean_Sum_inr_node x0 :e IndFiber Lean_Sum_K Lean_Sum_T Lean_Sum_N Lean_Sum_R Lean_Sum_F Lean_Sum_Ix Lean_Sum_O Lean_Sum_B (Lean_Sum_O 1 (TupArgs 1 (SeqCons (x0) SeqNil))).
