Theorem Lean_And_HM0 : forall C:set -> set, forall h0, h0 :e (Pi_ x0 :e P0, (Pi_ x1 :e P1, (C (Lean_And_intro_node x0 x1)))) -> forall a :e IndArgs Lean_And_K Lean_And_T Lean_And_N Lean_And_R
