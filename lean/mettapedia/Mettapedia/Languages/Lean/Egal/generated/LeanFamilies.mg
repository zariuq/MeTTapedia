    (SeqCons (h0) (SeqCons ((h1 (a 0))) SeqNil)) k) k a (IndRes Lean_Option_K Lean_Option_T Lean_Option_N Lean_Option_R Lean_Option_F Lean_Option_Ix Lean_Option_O Lean_Option_B k r) :e C (IndNode
