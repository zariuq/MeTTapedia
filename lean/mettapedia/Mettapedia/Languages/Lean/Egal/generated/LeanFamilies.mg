Let Lean_And_Ix : set -> set -> set -> set := fun k j a => SeqAt (SeqAt (SeqCons ((SeqCons (0) (SeqCons (0) SeqNil))) SeqNil) k) j.
Let Lean_And_O : set -> set -> set := fun k a => SeqAt (SeqCons (0) SeqNil) k.
Let Lean_And_B : set := ((P0) :\/: (P1)).

Definition Lean_And_All : set := IndCarrier Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B.
Definition Lean_And : set := IndFiber Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B 0.

Theorem Lean_And_N0 : SeqAt (SeqCons (2) SeqNil) 0 = 2.
rewrite SeqAt_0. reflexivity.
Qed.
Theorem Lean_And_O0 : forall a, SeqAt (SeqCons (0) SeqNil) 0 = 0.
let a. rewrite SeqAt_0. reflexivity.
Qed.
Theorem Lean_And_nR0_0 : ~ (0 :e SeqAt (SeqAt (SeqCons ((SeqCons (0) (SeqCons (0) SeqNil))) SeqNil) 0) 0).
rewrite SeqAt_0. rewrite SeqAt_0. exact EmptyE 0.
Qed.
Theorem Lean_And_F0_0 : forall a, SeqAt (SeqAt (SeqCons ((SeqCons (P0) (SeqCons (P1) SeqNil))) SeqNil) 0) 0 = P0.
let a. rewrite SeqAt_0. rewrite SeqAt_0. reflexivity.
Qed.
Theorem Lean_And_nR0_1 : ~ (0 :e SeqAt (SeqAt (SeqCons ((SeqCons (0) (SeqCons (0) SeqNil))) SeqNil) 0) 1).
rewrite SeqAt_0. rewrite SeqAt_S. { rewrite SeqAt_0. exact EmptyE 0. } exact nat_0.
Qed.
Theorem Lean_And_F0_1 : forall a, SeqAt (SeqAt (SeqCons ((SeqCons (P0) (SeqCons (P1) SeqNil))) SeqNil) 0) 1 = P1.
let a. rewrite SeqAt_0. rewrite SeqAt_S. { rewrite SeqAt_0. reflexivity. } exact nat_0.
Qed.

Theorem Lean_And_bd0_0 : forall a, ~ Lean_And_R 0 0 -> Lean_And_F 0 0 a c= Lean_And_B.
let a. assume Hnr: ~ Lean_And_R 0 0. let z. assume Hz: z :e Lean_And_F 0 0 a.
exact (binunionI1 (P0) (P1) z (In_eq_r z (Lean_And_F 0 0 a) (P0) (Lean_And_F0_0 a) Hz)).
Qed.
Theorem Lean_And_bd0_1 : forall a, ~ Lean_And_R 0 1 -> Lean_And_F 0 1 a c= Lean_And_B.
let a. assume Hnr: ~ Lean_And_R 0 1. let z. assume Hz: z :e Lean_And_F 0 1 a.
exact (binunionI2 (P0) (P1) z (In_eq_r z (Lean_And_F 0 1 a) (P1) (Lean_And_F0_1 a) Hz)).
Qed.
Theorem Lean_And_bd0 : forall a, forall j :e Lean_And_N 0, ~ Lean_And_R 0 j -> Lean_And_F 0 j a c= Lean_And_B.
let a j. assume Hj: j :e Lean_And_N 0. assume Hnr: ~ Lean_And_R 0 j.
exact (Below_S 1 (fun j => ~ Lean_And_R 0 j -> Lean_And_F 0 j a c= Lean_And_B) (Below_S 0 (fun j => ~ Lean_And_R 0 j -> Lean_And_F 0 j a c= Lean_And_B) (Below_0 (fun j => ~ Lean_And_R 0 j ->
    Lean_And_F 0 j a c= Lean_And_B)) (Lean_And_bd0_0 a)) (Lean_And_bd0_1 a)) j (In_eq_r j (Lean_And_N 0) 2 Lean_And_N0 Hj) Hnr.
Qed.
Theorem Lean_And_bounded : IndBounded Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B.
let k. assume Hk: k :e Lean_And_K.
exact (Below_S 0 (fun k => forall a, forall j :e Lean_And_N k, ~ Lean_And_R k j -> Lean_And_F k j a c= Lean_And_B) (Below_0 (fun k => forall a, forall j :e Lean_And_N k, ~ Lean_And_R k j ->
    Lean_And_F k j a c= Lean_And_B)) Lean_And_bd0) k Hk.
Qed.

Theorem Lean_And_distinct : IndDistinct Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B.
let k. assume Hk: k :e Lean_And_K. let k'. assume Hk': k' :e Lean_And_K. assume H: k = k'. exact H.
Qed.

Theorem Lean_And_ar0 : nat_p (Lean_And_N 0).
prove nat_p (SeqAt (SeqCons (2) SeqNil) 0). rewrite Lean_And_N0. exact (nat_ordsucc 1 (nat_ordsucc 0 nat_0)).
Qed.
Theorem Lean_And_arity : forall k :e Lean_And_K, nat_p (Lean_And_N k).
let k. assume Hk: k :e Lean_And_K.
exact (Below_S 0 (fun k => nat_p (Lean_And_N k)) (Below_0 (fun k => nat_p (Lean_And_N k))) Lean_And_ar0) k Hk.
Qed.

Definition Lean_And_intro_node : set -> set -> set := fun x0 x1 => IndNode Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B 0 (TupArgs 2 (SeqCons (x0) (SeqCons
    (x1) SeqNil))).
Theorem Lean_And_intro_field0 : forall x0 x1, (proj1 (Lean_And_intro_node x0 x1)) 0 = x0.
let x0 x1.
prove (proj1 (IndNode Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B 0 (TupArgs 2 (SeqCons (x0) (SeqCons (x1) SeqNil))))) 0 = x0.
