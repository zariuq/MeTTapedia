    Lean_And_Ix Lean_And_O Lean_And_B 0 a).
let C h0. assume Hh: h0 :e (Pi_ x0 :e P0, (Pi_ x1 :e P1, (C (Lean_And_intro_node x0 x1)))).
let a. assume Ha: a :e IndArgs Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B Lean_And_All 0. let r. assume Hr: forall j :e Lean_And_N 0, Lean_And_R 0 j -> r
    j :e C (a j).
claim Fi: IndFits Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B Lean_And_All 0 a.
{ exact IndArgs_Fits Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B Lean_And_All 0 a Ha. }
claim Pm: a :e Pi_ j :e 2, Lean_And_B :\/: Lean_And_All.
{ exact In_fam_eq (fun X:set => Pi_ j :e X, Lean_And_B :\/: Lean_And_All) (Lean_And_N 0) 2 Lean_And_N0 a (IndArgs_Pi Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O
