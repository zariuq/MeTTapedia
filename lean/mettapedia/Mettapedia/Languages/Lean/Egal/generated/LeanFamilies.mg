Theorem Lean_Sum_ind : forall P:set -> prop, (forall x0 :e P0, P (Lean_Sum_inl_node x0)) -> (forall x0 :e P1, P (Lean_Sum_inr_node x0)) -> forall t :e Lean_Sum, P t.
let P. assume H0. assume H1.
claim M0: 0 :e (Pi_ x0 :e P0, {z :e 1 | P (Lean_Sum_inl_node x0)}).
{ apply Pi_0_In. let x0. assume Hx0: x0 :e P0.
  prove 0 :e {z :e 1 | P (Lean_Sum_inl_node x0)}.
  exact SepI 1 (fun z => P (Lean_Sum_inl_node x0)) 0 In_0_1 (H0 x0 Hx0). }
claim M1: 0 :e (Pi_ x0 :e P1, {z :e 1 | P (Lean_Sum_inr_node x0)}).
{ apply Pi_0_In. let x0. assume Hx0: x0 :e P1.
  prove 0 :e {z :e 1 | P (Lean_Sum_inr_node x0)}.
  exact SepI 1 (fun z => P (Lean_Sum_inr_node x0)) 0 In_0_1 (H1 x0 Hx0). }
let t. assume Ht: t :e Lean_Sum.
exact SepE2 1 (fun z => P t) (Lean_Sum_rec 0 0 t) (Lean_Sum_rec_type (fun t => {z :e 1 | P t}) 0 M0 0 M1 t Ht).
Qed.



