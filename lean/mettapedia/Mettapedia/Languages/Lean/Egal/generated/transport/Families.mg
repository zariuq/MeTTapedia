    Lean_Option_F Lean_Option_Ix Lean_Option_O Lean_Option_B k a)) (Below_S 0 (fun k => forall a :e IndArgs Lean_Option_K Lean_Option_T Lean_Option_N Lean_Option_R Lean_Option_F Lean_Option_Ix
    Lean_Option_O Lean_Option_B Lean_Option_All k, forall r:set -> set, (forall j :e Lean_Option_N k, Lean_Option_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons (h0) (SeqCons ((h1 (a
