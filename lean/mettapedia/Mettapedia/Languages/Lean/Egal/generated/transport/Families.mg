Theorem Lean_Or_rec_type : forall C:set -> set, forall h0 :e (Pi_ x0 :e P0, (C (Lean_Or_inl_node x0))), forall h1 :e (Pi_ x0 :e P1, (C (Lean_Or_inr_node x0))), forall t :e Lean_Or, Lean_Or_rec h0 h1
