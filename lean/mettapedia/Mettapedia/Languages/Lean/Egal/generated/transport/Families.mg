    r:set -> set, (forall j :e Lean_And_N k, Lean_And_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons ((h0 (a 0) (a 1))) SeqNil) k) k a (IndRes Lean_And_K Lean_And_T Lean_And_N
    Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B k r) :e C (IndNode Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B k a)) (Below_0 (fun k => forall
