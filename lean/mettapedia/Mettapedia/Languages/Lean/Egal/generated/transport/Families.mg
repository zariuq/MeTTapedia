    (Below_S 0 (fun k => forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_PProd_N k, V), Lean_PProd_O k a :e LeanUniv u) (Below_0 (fun k => forall V :e LeanUniv u, forall a :e (Pi_ j :e
    Lean_PProd_N k, V), Lean_PProd_O k a :e LeanUniv u)) HO0) k Hk).
