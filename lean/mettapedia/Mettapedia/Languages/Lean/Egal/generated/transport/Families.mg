    r:set => SeqAt (SeqCons (h0) (SeqCons ((h1 (a 0))) SeqNil)) k) C HM t (SepE1 Lean_Option_All (fun x:set => IndIdx Lean_Option_K Lean_Option_T Lean_Option_N Lean_Option_R Lean_Option_F
