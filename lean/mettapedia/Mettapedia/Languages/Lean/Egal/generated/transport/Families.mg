Theorem Lean_Option_rec_In : forall C:set, forall h0 :e C, forall h1 :e (Pi_ x0 :e P0, C), forall t :e Lean_Option, Lean_Option_rec h0 h1 t :e C.
let C.
exact Lean_Option_rec_type (fun _ => C).
Qed.




Theorem Lean_Option_ind : forall P:set -> prop, (P Lean_Option_none_node) -> (forall x0 :e P0, P (Lean_Option_some_node x0)) -> forall t :e Lean_Option, P t.
let P. assume H0. assume H1.
claim M0: 0 :e {z :e 1 | P Lean_Option_none_node}.
{ exact SepI 1 (fun z => P Lean_Option_none_node) 0 In_0_1 (H0). }
claim M1: 0 :e (Pi_ x0 :e P0, {z :e 1 | P (Lean_Option_some_node x0)}).
{ apply Pi_0_In. let x0. assume Hx0: x0 :e P0.
  prove 0 :e {z :e 1 | P (Lean_Option_some_node x0)}.
  exact SepI 1 (fun z => P (Lean_Option_some_node x0)) 0 In_0_1 (H1 x0 Hx0). }
let t. assume Ht: t :e Lean_Option.
exact SepE2 1 (fun z => P t) (Lean_Option_rec 0 0 t) (Lean_Option_rec_type (fun t => {z :e 1 | P t}) 0 M0 0 M1 t Ht).
Qed.


Theorem Lean_Option_rec_proof_ok : forall motive:set -> set,
  0 :e (motive Lean_Option_none_node) ->
  0 :e (Pi_ x0 :e P0, (motive (Lean_Option_some_node x0))) ->
  forall t :e Lean_Option, 0 :e (motive t).
let motive. assume H0. assume H1.
apply Lean_Option_ind.
  - exact H0.
  - let x0. assume Hx0. exact (Pi_0_ap P0 (fun x0 => (motive (Lean_Option_some_node x0))) H1 x0 Hx0).
Qed.



Theorem Lean_Option_noconf0_1 : forall y0, Lean_Option_none_node <> (Lean_Option_some_node y0).
let y0. assume H: Lean_Option_none_node = (Lean_Option_some_node y0).
apply IndNode_inj Lean_Option_K Lean_Option_T Lean_Option_N Lean_Option_R Lean_Option_F Lean_Option_Ix Lean_Option_O Lean_Option_B Lean_Option_distinct 0 (ordsuccI1 1 0 (ordsuccI2 0)) 1 (ordsuccI2 1)
    (TupArgs 0 SeqNil) (TupArgs 1 (SeqCons (y0) SeqNil)) H.
assume H1: 0 = 1. assume H2.
exact In_irref 0 (In_eq_rs 0 0 1 H1 (ordsuccI2 0)).
Qed.

Theorem Lean_Option_some_inj0 : forall x0 y0, (Lean_Option_some_node x0) = (Lean_Option_some_node y0) -> x0 = y0.
let x0 y0. assume H: (Lean_Option_some_node x0) = (Lean_Option_some_node y0).
claim L: SeqAt (SeqCons (x0) SeqNil) 0 = SeqAt (SeqCons (y0) SeqNil) 0.
{ exact IndNode_args_inj Lean_Option_K Lean_Option_T Lean_Option_N Lean_Option_R Lean_Option_F Lean_Option_Ix Lean_Option_O Lean_Option_B Lean_Option_distinct 1 (ordsuccI2 1) 1 (SeqCons (x0) SeqNil)
    (SeqCons (y0) SeqNil) H 0 (ordsuccI2 0). }
claim Lx: SeqAt (SeqCons (x0) SeqNil) 0 = x0.
{ rewrite SeqAt_0. reflexivity. }
claim Ly: SeqAt (SeqCons (y0) SeqNil) 0 = y0.
{ rewrite SeqAt_0. reflexivity. }
rewrite <- Lx. rewrite <- Ly. exact L.
Qed.


Theorem Lean_Option_In : forall u, nat_p u -> P0 :e LeanUniv u -> Lean_Option_All :e LeanUniv u.
let u. assume Hu: nat_p u. assume HP0: P0 :e LeanUniv u.
claim Ht: TransSet (LeanUniv u).
{ exact LeanUniv_TransSet u Hu. }
claim Hz: ZF_closed (LeanUniv u).
{ exact LeanUniv_ZF_closed u Hu. }
