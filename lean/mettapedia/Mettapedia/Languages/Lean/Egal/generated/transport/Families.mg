    (forall j :e Lean_Or_N k, Lean_Or_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons ((h0 (a 0))) (SeqCons ((h1 (a 0))) SeqNil)) k) k a (IndRes Lean_Or_K Lean_Or_T Lean_Or_N Lean_Or_R
