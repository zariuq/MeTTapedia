let t. assume Ht: t :e Lean_Or.
exact SepE2 1 (fun z => P t) (Lean_Or_rec 0 0 t) (Lean_Or_rec_type (fun t => {z :e 1 | P t}) 0 M0 0 M1 t Ht).
Qed.





