    Lean_Or_B Lean_Or_All k, forall r:set -> set, (forall j :e Lean_Or_N k, Lean_Or_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons ((h0 (a 0))) (SeqCons ((h1 (a 0))) SeqNil)) k) k a
    (IndRes Lean_Or_K Lean_Or_T Lean_Or_N Lean_Or_R Lean_Or_F Lean_Or_Ix Lean_Or_O Lean_Or_B k r) :e C (IndNode Lean_Or_K Lean_Or_T Lean_Or_N Lean_Or_R Lean_Or_F Lean_Or_Ix Lean_Or_O Lean_Or_B k a)))
    (Lean_Or_HM0 C h0 h1 Hh0)) (Lean_Or_HM1 C h0 h1 Hh1)) k Hk. }
let t. assume Ht: t :e Lean_Or.
exact IndRec_type Lean_Or_K Lean_Or_T Lean_Or_N Lean_Or_R Lean_Or_F Lean_Or_Ix Lean_Or_O Lean_Or_B Lean_Or_distinct Lean_Or_bounded Lean_Or_arity (fun k a r:set => SeqAt (SeqCons ((h0 (a 0)))
    (SeqCons ((h1 (a 0))) SeqNil)) k) C HM t (SepE1 Lean_Or_All (fun x:set => IndIdx Lean_Or_K Lean_Or_T Lean_Or_N Lean_Or_R Lean_Or_F Lean_Or_Ix Lean_Or_O Lean_Or_B x = 0) t Ht).
Qed.





Theorem Lean_Or_ind : forall P:set -> prop, (forall x0 :e P0, P (Lean_Or_inl_node x0)) -> (forall x0 :e P1, P (Lean_Or_inr_node x0)) -> forall t :e Lean_Or, P t.
let P. assume H0. assume H1.
