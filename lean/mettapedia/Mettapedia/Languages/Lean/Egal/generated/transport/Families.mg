  - let x0. assume H0: x0 :e P0.
    claim Hc: (Lean_Decidable_isTrue_node P0 x0) :e (Lean_Decidable P0).
    { exact (Lean_Decidable_isTrue_typed P0 x0 H0). }
    claim Hb: Lean_PUnit_unit_node :e Lean_Decidable_below P0 motive (Lean_Decidable_isTrue_node P0 x0).
    { prove Lean_PUnit_unit_node :e Lean_Decidable_mrec P0 (fun x0 => Lean_PUnit) (fun x0 => Lean_PUnit) (Lean_Decidable_isTrue_node P0 x0). rewrite Lean_Decidable_miota1 P0 (fun x0 => Lean_PUnit)
    (fun x0 => Lean_PUnit) x0 H0. exact Lean_PUnit_unit_typed. }
    apply andI.
    + exact Pi_0_ap (Lean_Decidable_below P0 motive (Lean_Decidable_isTrue_node P0 x0)) (fun b => motive (Lean_Decidable_isTrue_node P0 x0)) (HFx (Lean_Decidable_isTrue_node P0 x0) Hc)
    Lean_PUnit_unit_node Hb.
    + witness Lean_PUnit_unit_node. exact Hb.
}
exact andEL (0 :e motive t) (exists b, b :e Lean_Decidable_below P0 motive t) (L t Ht).
Qed.

(** PProd.below, read by its recursor as Lean defines it, and PProd.brecOn read as Lean states its type. **)
Definition Lean_PProd_below : set -> set -> (set -> set) -> set -> set :=
  fun P0 P1 motive t => Lean_PProd_mrec P0 P1 (fun x0 x1 => Lean_PUnit) t.
Theorem Lean_PProd_below_iota0 : forall P0, forall P1, forall motive:set -> set, forall x0 :e P0, forall x1 :e P1, Lean_PProd_below P0 P1 motive (Lean_PProd_mk_node P0 P1 x0 x1) = Lean_PUnit.
let P0 P1 motive. let x0. assume H0: x0 :e P0. let x1. assume H1: x1 :e P1.
prove Lean_PProd_mrec P0 P1 (fun x0 x1 => Lean_PUnit) (Lean_PProd_mk_node P0 P1 x0 x1) = Lean_PUnit.
rewrite Lean_PProd_miota0 P0 P1 (fun x0 x1 => Lean_PUnit) x0 H0 x1 H1. reflexivity.
Qed.
Theorem Lean_PProd_brecOn_proof_ok : forall P0, forall P1, forall motive:set -> set, forall t :e (Lean_PProd P0 P1),
  0 :e (Pi_ x :e (Lean_PProd P0 P1), (Pi_ b :e Lean_PProd_below P0 P1 motive x, motive x)) -> 0 :e motive t.
let P0 P1 motive t. assume Ht: t :e (Lean_PProd P0 P1).
assume HF: 0 :e (Pi_ x :e (Lean_PProd P0 P1), (Pi_ b :e Lean_PProd_below P0 P1 motive x, motive x)).
claim HFx: forall x :e (Lean_PProd P0 P1), 0 :e (Pi_ b :e Lean_PProd_below P0 P1 motive x, motive x).
{ exact Pi_0_ap (Lean_PProd P0 P1) (fun x => Pi_ b :e Lean_PProd_below P0 P1 motive x, motive x) HF. }
claim L: forall x :e (Lean_PProd P0 P1), 0 :e motive x /\ (exists b, b :e Lean_PProd_below P0 P1 motive x).
{ apply Lean_PProd_ind P0 P1.
  let x0. assume H0: x0 :e P0. let x1. assume H1: x1 :e P1.
    claim Hc: (Lean_PProd_mk_node P0 P1 x0 x1) :e (Lean_PProd P0 P1).
    { exact (Lean_PProd_mk_typed P0 P1 x0 H0 x1 H1). }
    claim Hb: Lean_PUnit_unit_node :e Lean_PProd_below P0 P1 motive (Lean_PProd_mk_node P0 P1 x0 x1).
    { prove Lean_PUnit_unit_node :e Lean_PProd_mrec P0 P1 (fun x0 x1 => Lean_PUnit) (Lean_PProd_mk_node P0 P1 x0 x1). rewrite Lean_PProd_miota0 P0 P1 (fun x0 x1 => Lean_PUnit) x0 H0 x1 H1. exact
    Lean_PUnit_unit_typed. }
    apply andI.
    + exact Pi_0_ap (Lean_PProd_below P0 P1 motive (Lean_PProd_mk_node P0 P1 x0 x1)) (fun b => motive (Lean_PProd_mk_node P0 P1 x0 x1)) (HFx (Lean_PProd_mk_node P0 P1 x0 x1) Hc) Lean_PUnit_unit_node
    Hb.
    + witness Lean_PUnit_unit_node. exact Hb.
}
exact andEL (0 :e motive t) (exists b, b :e Lean_PProd_below P0 P1 motive t) (L t Ht).
Qed.


