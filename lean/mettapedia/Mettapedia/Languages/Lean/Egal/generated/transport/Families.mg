prove (TupArgs 1 (SeqCons (x0) SeqNil)) :e {a :e Pi_ j :e SeqAt (SeqCons (1) (SeqCons (1) SeqNil)) 1, Lean_Or_B :\/: Lean_Or_All | IndFits Lean_Or_K Lean_Or_T Lean_Or_N Lean_Or_R Lean_Or_F Lean_Or_Ix
