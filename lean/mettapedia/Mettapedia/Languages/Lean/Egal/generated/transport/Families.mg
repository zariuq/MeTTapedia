    Lean_Option_All k, forall r:set -> set, (forall j :e Lean_Option_N k, Lean_Option_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons (h0) (SeqCons ((h1 (a 0))) SeqNil)) k) k a (IndRes
