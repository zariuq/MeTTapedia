{ exact Lean_List_rec_type a0 (fun t:set => {z :e 1 | g a0 a1 a2 t = Lean_List_map a0 a1 a2 t}) 0 (L0) (fun y0 :e a0 => (fun y1 :e (Lean_List a0) => (fun r1 :e {z :e 1 | g a0 a1 a2 y1 = Lean_List_map
    a0 a1 a2 y1} => 0))) (lam_Pi a0 (fun y0 => (Pi_ y1 :e (Lean_List a0), (Pi_ r1 :e {z :e 1 | g a0 a1 a2 y1 = Lean_List_map a0 a1 a2 y1}, {z :e 1 | g a0 a1 a2 (Lean_List_cons_node a0 y0 y1) =
