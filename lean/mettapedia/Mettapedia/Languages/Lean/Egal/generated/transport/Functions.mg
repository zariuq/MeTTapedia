    (Lean_List a0) (fun y1 => (Pi_ r1 :e {z :e 1 | g a0 a1 a2 y1 = Lean_List_map a0 a1 a2 y1}, {z :e 1 | g a0 a1 a2 (Lean_List_cons_node a0 y0 y1) = Lean_List_map a0 a1 a2 (Lean_List_cons_node a0 y0
