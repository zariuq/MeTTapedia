    (Lean_List_cons_node a0 y0 y1) = Lean_List_map a0 a1 a2 (Lean_List_cons_node a0 y0 y1)) 0 In_0_1.
  prove g a0 a1 a2 (Lean_List_cons_node a0 y0 y1) = Lean_List_map a0 a1 a2 (Lean_List_cons_node a0 y0 y1).
  rewrite Hg1 u Hu a0 H0 u Hu a1 H1 a2 H2 y0 Hy0 y1 Hy1. rewrite Lean_List_map_eq_2 u Hu a0 H0 u Hu a1 H1 a2 H2 y0 Hy0 y1 Hy1. rewrite SepE2 1 (fun z:set => g a0 a1 a2 y1 = Lean_List_map a0 a1 a2 y1)
    r1 Hr1. reflexivity. }
claim LC: Lean_List_rec a0 0 (fun y0 :e a0 => (fun y1 :e (Lean_List a0) => (fun r1 :e {z :e 1 | g a0 a1 a2 y1 = Lean_List_map a0 a1 a2 y1} => 0))) a3 :e (fun t:set => {z :e 1 | g a0 a1 a2 t =
