Theorem Lean_Nat_In : forall u, nat_p u -> Lean_Nat_All :e LeanUniv u.
let u. assume Hu: nat_p u.
claim Ht: TransSet (LeanUniv u).
{ exact LeanUniv_TransSet u Hu. }
claim Hz: ZF_closed (LeanUniv u).
{ exact LeanUniv_ZF_closed u Hu. }
claim H0: 0 :e LeanUniv u.
{ exact LeanUniv_0_In u Hu. }
claim HO0: forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_Nat_N 0, V), Lean_Nat_O 0 a :e LeanUniv u.
{ let V. assume HV: V :e LeanUniv u. let a. assume Ha: a :e (Pi_ j :e Lean_Nat_N 0, V).
  claim Ham: a :e Pi_ j :e 0, V.
  { exact In_fam_eq (fun X:set => Pi_ j :e X, V) (Lean_Nat_N 0) 0 Lean_Nat_N0 a Ha. }
  prove SeqAt (SeqCons (0) (SeqCons (0) SeqNil)) 0 :e LeanUniv u. rewrite Lean_Nat_O0 a. exact H0. }
claim HO1: forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_Nat_N 1, V), Lean_Nat_O 1 a :e LeanUniv u.
{ let V. assume HV: V :e LeanUniv u. let a. assume Ha: a :e (Pi_ j :e Lean_Nat_N 1, V).
  claim Ham: a :e Pi_ j :e 1, V.
  { exact In_fam_eq (fun X:set => Pi_ j :e X, V) (Lean_Nat_N 1) 1 Lean_Nat_N1 a Ha. }
  prove SeqAt (SeqCons (0) (SeqCons (0) SeqNil)) 1 :e LeanUniv u. rewrite Lean_Nat_O1 a. exact H0. }
exact IndCarrier_In Lean_Nat_K Lean_Nat_T Lean_Nat_N Lean_Nat_R Lean_Nat_F Lean_Nat_Ix Lean_Nat_O Lean_Nat_B (LeanUniv u) Ht Hz (omega_In_LeanUniv u Hu) (LeanUniv_nat_In u Hu 2 (nat_ordsucc 1
    (nat_ordsucc 0 nat_0))) H0 Lean_Nat_arity (fun k Hk => LeanUniv_nat_In u Hu k (nat_p_trans 2 (nat_ordsucc 1 (nat_ordsucc 0 nat_0)) k Hk)) (fun k Hk => (Below_S 1 (fun k => forall V :e LeanUniv u,
    forall a :e (Pi_ j :e Lean_Nat_N k, V), Lean_Nat_O k a :e LeanUniv u) (Below_S 0 (fun k => forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_Nat_N k, V), Lean_Nat_O k a :e LeanUniv u) (Below_0
    (fun k => forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_Nat_N k, V), Lean_Nat_O k a :e LeanUniv u)) HO0) HO1) k Hk).
Qed.
Theorem Lean_Nat_type_In : forall u, nat_p u -> Lean_Nat :e LeanUniv u.
let u. assume Hu: nat_p u.
exact IndFiber_In Lean_Nat_K Lean_Nat_T Lean_Nat_N Lean_Nat_R Lean_Nat_F Lean_Nat_Ix Lean_Nat_O Lean_Nat_B (LeanUniv u) (LeanUniv_TransSet u Hu) (LeanUniv_ZF_closed u Hu) (Lean_Nat_In u Hu ) 0.
Qed.

End Lean_Nat_Section.

(** Lean's natural number literals: the literal n is the ordinal n carried
    into Lean_Nat by zero and successor.  Families after Nat read their
    closed natural indices this way, as the term reader reads literals. **)

Definition LeanNum : set -> set :=
  fun n => nat_primrec Lean_Nat_zero_node (fun _ r => Lean_Nat_succ_node r) n.

Theorem LeanNum_0 : LeanNum 0 = Lean_Nat_zero_node.
exact nat_primrec_0 Lean_Nat_zero_node (fun _ r => Lean_Nat_succ_node r).
Qed.

Theorem LeanNum_S : forall n, nat_p n -> LeanNum (ordsucc n) = Lean_Nat_succ_node (LeanNum n).
let n. assume Hn: nat_p n.
exact nat_primrec_S Lean_Nat_zero_node (fun _ r => Lean_Nat_succ_node r) n Hn.
Qed.

Theorem LeanNum_In : forall n, nat_p n -> LeanNum n :e Lean_Nat.
apply nat_ind.
- rewrite LeanNum_0. exact Lean_Nat_zero_typed.
- let n. assume Hn: nat_p n. assume IH: LeanNum n :e Lean_Nat.
  rewrite LeanNum_S n Hn. exact Lean_Nat_succ_typed (LeanNum n) IH.
Qed.

Theorem LeanNum_inj : forall m, nat_p m -> forall n, nat_p n -> LeanNum m = LeanNum n -> m = n.
apply nat_ind (fun m => forall n, nat_p n -> LeanNum m = LeanNum n -> m = n).
- let n. assume Hn: nat_p n.
  apply nat_inv n Hn.
  + assume H0: n = 0. assume _. rewrite H0. reflexivity.
  + assume Hex: exists k, nat_p k /\ n = ordsucc k.
    apply Hex. let k. assume Hk: nat_p k /\ n = ordsucc k.
    apply Hk. assume Hk1: nat_p k. assume Hk2: n = ordsucc k.
    rewrite Hk2. rewrite LeanNum_0. rewrite LeanNum_S k Hk1.
    assume H: Lean_Nat_zero_node = Lean_Nat_succ_node (LeanNum k).
    prove False. exact Lean_Nat_noconf0_1 (LeanNum k) H.
- let m. assume Hm: nat_p m.
  assume IH: forall n, nat_p n -> LeanNum m = LeanNum n -> m = n.
  let n. assume Hn: nat_p n.
  apply nat_inv n Hn.
  + assume H0: n = 0. rewrite H0. rewrite LeanNum_0. rewrite LeanNum_S m Hm.
    assume H: Lean_Nat_succ_node (LeanNum m) = Lean_Nat_zero_node.
    prove False. exact Lean_Nat_noconf0_1 (LeanNum m) (eq_sym_i (Lean_Nat_succ_node (LeanNum m)) Lean_Nat_zero_node H).
  + assume Hex: exists k, nat_p k /\ n = ordsucc k.
    apply Hex. let k. assume Hk: nat_p k /\ n = ordsucc k.
    apply Hk. assume Hk1: nat_p k. assume Hk2: n = ordsucc k.
    rewrite Hk2. rewrite LeanNum_S m Hm. rewrite LeanNum_S k Hk1.
    assume H: Lean_Nat_succ_node (LeanNum m) = Lean_Nat_succ_node (LeanNum k).
    rewrite IH k Hk1 (Lean_Nat_succ_inj0 (LeanNum m) (LeanNum k) H).
    reflexivity.
Qed.

(** ---- Eq, generated from its Lean declaration ---- **)

Section Lean_Eq_Section.

Variable P0 : set.
Variable P1 : set.
Let Lean_Eq_K : set := 1.
Let Lean_Eq_T : set -> set := fun k => k.
Let Lean_Eq_N : set -> set := fun k => SeqAt (SeqCons (0) SeqNil) k.
Let Lean_Eq_R : set -> set -> prop := fun k j => 0 :e SeqAt (SeqAt (SeqCons (SeqNil) SeqNil) k) j.
Let Lean_Eq_F : set -> set -> set -> set := fun k j a => SeqAt (SeqAt (SeqCons (SeqNil) SeqNil) k) j.
Let Lean_Eq_Ix : set -> set -> set -> set := fun k j a => SeqAt (SeqAt (SeqCons (SeqNil) SeqNil) k) j.
Let Lean_Eq_O : set -> set -> set := fun k a => SeqAt (SeqCons (P1) SeqNil) k.
Let Lean_Eq_B : set := 0.

Definition Lean_Eq_All : set := IndCarrier Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B.
Definition Lean_Eq : set -> set := IndFiber Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B.

Theorem Lean_Eq_N0 : SeqAt (SeqCons (0) SeqNil) 0 = 0.
rewrite SeqAt_0. reflexivity.
Qed.
Theorem Lean_Eq_O0 : forall a, SeqAt (SeqCons (P1) SeqNil) 0 = P1.
let a. rewrite SeqAt_0. reflexivity.
Qed.

Theorem Lean_Eq_bd0 : forall a, forall j :e Lean_Eq_N 0, ~ Lean_Eq_R 0 j -> Lean_Eq_F 0 j a c= Lean_Eq_B.
let a j. assume Hj: j :e Lean_Eq_N 0. assume Hnr: ~ Lean_Eq_R 0 j.
