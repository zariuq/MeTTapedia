Theorem Lean_mod_zero_witness_positive : forall d, nat_p d -> forall n, nat_p n ->
  Lean_Nat_mod (LeanNum n) (LeanNum (ordsucc d)) = LeanNum 0 ->
  exists q :e Lean_Nat, LeanNum n = Lean_Nat_mul (LeanNum (ordsucc d)) q.
