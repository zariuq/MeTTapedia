Theorem Lean_Eq_unique : forall w :e Lean_Eq_All, w = Lean_Eq_refl_node.
let w. assume Hw: w :e Lean_Eq_All.
apply IndCarrier_inv Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B w Hw.
let k. assume Hk. apply Hk. assume Hk1: k :e Lean_Eq_K.
assume Hk2: exists a :e IndArgs Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B Lean_Eq_All k, w = IndNode Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F
    Lean_Eq_Ix Lean_Eq_O Lean_Eq_B k a.
apply Hk2. let a. assume Ha. apply Ha. assume Ha1: a :e IndArgs Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B Lean_Eq_All k. assume Hwa: w = IndNode Lean_Eq_K
    Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B k a.
claim Lk: k = 0.
{ exact SingE 0 k (Subq_1_Sing0 k Hk1). }
claim Ha0: a :e IndArgs Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B Lean_Eq_All 0.
{ exact In_fam_eq (IndArgs Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B Lean_Eq_All) k 0 Lk a Ha1. }
claim La: a = 0.
{ apply Empty_eq a. let u. assume Hu: u :e a.
  apply PiE 0 (fun j => Lean_Eq_B :\/: Lean_Eq_All) a (In_fam_eq (fun X:set => Pi_ j :e X, Lean_Eq_B :\/: Lean_Eq_All) (Lean_Eq_N 0) 0 Lean_Eq_N0 a (IndArgs_Pi Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R
    Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B Lean_Eq_All 0 a Ha0)).
  assume H1: forall u :e a, pair_p u /\ u 0 :e 0. assume H2.
  apply H1 u Hu. assume Hp. assume Hu0: u 0 :e 0. exact EmptyE (u 0) Hu0. }
claim Lt: TupArgs 0 SeqNil = 0.
{ apply Empty_eq (TupArgs 0 SeqNil). let u. assume Hu: u :e TupArgs 0 SeqNil.
  apply lamE 0 (fun j => SeqAt SeqNil j) u Hu. let j. assume Hj. apply Hj. assume Hj0: j :e 0. assume Hj1. exact EmptyE j Hj0. }
rewrite Hwa. rewrite Lk. rewrite La.
prove IndNode Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B 0 0 = IndNode Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B 0
    (TupArgs 0 SeqNil).
rewrite Lt. reflexivity.
Qed.
Theorem Lean_Eq_piota : forall h0, Lean_Eq_prec h0 P1 0 = h0.
let h0.
claim Hw: Lean_Eq_refl_node :e (Lean_Eq P1).
{ exact Lean_Eq_refl_typed. }
claim Le: Eps_i (fun w:set => w :e (Lean_Eq P1)) = Lean_Eq_refl_node.
{ exact Lean_Eq_unique (Eps_i (fun w:set => w :e (Lean_Eq P1))) (SepE1 Lean_Eq_All (fun x:set => IndIdx Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B x = P1) (Eps_i
    (fun w:set => w :e (Lean_Eq P1))) (Eps_i_ex (fun w:set => w :e (Lean_Eq P1)) (fun p H => H Lean_Eq_refl_node Hw))). }
prove IndRec Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B (fun k a r:set => SeqAt (SeqCons (h0) SeqNil) k) (Eps_i (fun w:set => w :e (Lean_Eq P1))) = h0.
rewrite Le.
prove IndRec Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B (fun k a r:set => SeqAt (SeqCons (h0) SeqNil) k) (IndNode Lean_Eq_K Lean_Eq_T Lean_Eq_N Lean_Eq_R
    Lean_Eq_F Lean_Eq_Ix Lean_Eq_O Lean_Eq_B 0 (TupArgs 0 SeqNil)) = h0.
