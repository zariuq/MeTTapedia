Theorem Lean_List_casesOn_type : forall C:set -> set, forall h0 :e (C Lean_List_nil_node), forall h1 :e (Pi_ x0 :e P0, (Pi_ x1 :e Lean_List, (C (Lean_List_cons_node x0 x1)))), forall t :e Lean_List,
    Lean_List_casesOn h0 h1 t :e C t.
let C. let h0. assume Hh0. let h1. assume Hh1.
claim HM: forall k :e Lean_List_K, forall a :e IndArgs Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B Lean_List_All k, forall r:set -> set, (forall j
    :e Lean_List_N k, Lean_List_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons (h0) (SeqCons ((h1 (a 0) (a 1))) SeqNil)) k) k a (IndRes Lean_List_K Lean_List_T Lean_List_N Lean_List_R
    Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B k r) :e C (IndNode Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B k a).
{ let k. assume Hk: k :e Lean_List_K. exact (Below_S 1 (fun k => forall a :e IndArgs Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B Lean_List_All k,
    forall r:set -> set, (forall j :e Lean_List_N k, Lean_List_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons (h0) (SeqCons ((h1 (a 0) (a 1))) SeqNil)) k) k a (IndRes Lean_List_K
    Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B k r) :e C (IndNode Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O
    Lean_List_B k a)) (Below_S 0 (fun k => forall a :e IndArgs Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B Lean_List_All k, forall r:set -> set,
    (forall j :e Lean_List_N k, Lean_List_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons (h0) (SeqCons ((h1 (a 0) (a 1))) SeqNil)) k) k a (IndRes Lean_List_K Lean_List_T Lean_List_N
    Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B k r) :e C (IndNode Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B k a)) (Below_0
    (fun k => forall a :e IndArgs Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B Lean_List_All k, forall r:set -> set, (forall j :e Lean_List_N k,
    Lean_List_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons (h0) (SeqCons ((h1 (a 0) (a 1))) SeqNil)) k) k a (IndRes Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F
    Lean_List_Ix Lean_List_O Lean_List_B k r) :e C (IndNode Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B k a))) (Lean_List_casesOn_HM0 C h0 h1
    Hh0)) (Lean_List_casesOn_HM1 C h0 h1 Hh1)) k Hk. }
let t. assume Ht: t :e Lean_List.
exact IndRec_type Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B Lean_List_distinct Lean_List_bounded Lean_List_arity (fun k a r:set => SeqAt
    (SeqCons (h0) (SeqCons ((h1 (a 0) (a 1))) SeqNil)) k) C HM t (SepE1 Lean_List_All (fun x:set => IndIdx Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O
    Lean_List_B x = 0) t Ht).
