    (Lean_List_cons_node (a 0) (a 1)) (IndNode Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B 1 a) Ln (h1 (a 0) (a 1)) Lv).
