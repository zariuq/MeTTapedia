{ exact (ap_Pi Lean_List (fun x1 => (C (Lean_List_cons_node (a 0) x1))) (h1 (a 0)) (a 1) (ap_Pi P0 (fun x0 => (Pi_ x1 :e Lean_List, (C (Lean_List_cons_node x0 x1)))) h1 (a 0) Hh G0) G1). }
claim Lm: (fun k a r:set => SeqAt (SeqCons (h0) (SeqCons ((h1 (a 0) (a 1))) SeqNil)) k) 1 a (IndRes Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B 1
    r) = (h1 (a 0) (a 1)).
{ prove SeqAt (SeqCons (h0) (SeqCons ((h1 (a 0) (a 1))) SeqNil)) 1 = (h1 (a 0) (a 1)). rewrite SeqAt_S. { rewrite SeqAt_0. reflexivity. } exact nat_0. }
claim Ln: (Lean_List_cons_node (a 0) (a 1)) = IndNode Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B 1 a.
{ prove IndNode Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B 1 (TupArgs 2 (SeqCons ((a 0)) (SeqCons ((a 1)) SeqNil))) = IndNode Lean_List_K
    Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B 1 a. rewrite Ea. reflexivity. }
exact In_eq_ls ((fun k a r:set => SeqAt (SeqCons (h0) (SeqCons ((h1 (a 0) (a 1))) SeqNil)) k) 1 a (IndRes Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O
