Theorem Lean_List_ind : forall P:set -> prop, (P Lean_List_nil_node) -> (forall x0 :e P0, forall x1 :e Lean_List, P x1 -> P (Lean_List_cons_node x0 x1)) -> forall t :e Lean_List, P t.
let P. assume H0. assume H1.
claim M0: 0 :e {z :e 1 | P Lean_List_nil_node}.
{ exact SepI 1 (fun z => P Lean_List_nil_node) 0 In_0_1 (H0). }
claim M1: 0 :e (Pi_ x0 :e P0, (Pi_ x1 :e Lean_List, (Pi_ y1 :e {z :e 1 | P x1}, {z :e 1 | P (Lean_List_cons_node x0 x1)}))).
{ apply Pi_0_In. let x0. assume Hx0: x0 :e P0.
  prove 0 :e (Pi_ x1 :e Lean_List, (Pi_ y1 :e {z :e 1 | P x1}, {z :e 1 | P (Lean_List_cons_node x0 x1)})).
  apply Pi_0_In. let x1. assume Hx1: x1 :e Lean_List.
  prove 0 :e (Pi_ y1 :e {z :e 1 | P x1}, {z :e 1 | P (Lean_List_cons_node x0 x1)}).
  apply Pi_0_In. let y1. assume Hy1: y1 :e {z :e 1 | P x1}.
  prove 0 :e {z :e 1 | P (Lean_List_cons_node x0 x1)}.
  exact SepI 1 (fun z => P (Lean_List_cons_node x0 x1)) 0 In_0_1 (H1 x0 Hx0 x1 Hx1 (SepE2 1 (fun z => P x1) y1 Hy1)). }
let t. assume Ht: t :e Lean_List.
exact SepE2 1 (fun z => P t) (Lean_List_rec 0 0 t) (Lean_List_rec_type (fun t => {z :e 1 | P t}) 0 M0 0 M1 t Ht).
Qed.



Theorem Lean_List_noconf0_1 : forall y0 y1, Lean_List_nil_node <> (Lean_List_cons_node y0 y1).
let y0 y1. assume H: Lean_List_nil_node = (Lean_List_cons_node y0 y1).
apply IndNode_inj Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B Lean_List_distinct 0 (ordsuccI1 1 0 (ordsuccI2 0)) 1 (ordsuccI2 1) (TupArgs 0
    SeqNil) (TupArgs 2 (SeqCons (y0) (SeqCons (y1) SeqNil))) H.
assume H1: 0 = 1. assume H2.
exact In_irref 0 (In_eq_rs 0 0 1 H1 (ordsuccI2 0)).
Qed.

Theorem Lean_List_cons_inj0 : forall x0 x1 y0 y1, (Lean_List_cons_node x0 x1) = (Lean_List_cons_node y0 y1) -> x0 = y0.
let x0 x1 y0 y1. assume H: (Lean_List_cons_node x0 x1) = (Lean_List_cons_node y0 y1).
claim L: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 0 = SeqAt (SeqCons (y0) (SeqCons (y1) SeqNil)) 0.
{ exact IndNode_args_inj Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B Lean_List_distinct 1 (ordsuccI2 1) 2 (SeqCons (x0) (SeqCons (x1) SeqNil))
    (SeqCons (y0) (SeqCons (y1) SeqNil)) H 0 (ordsuccI1 1 0 (ordsuccI2 0)). }
claim Lx: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 0 = x0.
{ rewrite SeqAt_0. reflexivity. }
claim Ly: SeqAt (SeqCons (y0) (SeqCons (y1) SeqNil)) 0 = y0.
{ rewrite SeqAt_0. reflexivity. }
rewrite <- Lx. rewrite <- Ly. exact L.
Qed.
Theorem Lean_List_cons_inj1 : forall x0 x1 y0 y1, (Lean_List_cons_node x0 x1) = (Lean_List_cons_node y0 y1) -> x1 = y1.
let x0 x1 y0 y1. assume H: (Lean_List_cons_node x0 x1) = (Lean_List_cons_node y0 y1).
claim L: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 1 = SeqAt (SeqCons (y0) (SeqCons (y1) SeqNil)) 1.
{ exact IndNode_args_inj Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B Lean_List_distinct 1 (ordsuccI2 1) 2 (SeqCons (x0) (SeqCons (x1) SeqNil))
    (SeqCons (y0) (SeqCons (y1) SeqNil)) H 1 (ordsuccI2 1). }
claim Lx: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 1 = x1.
{ rewrite SeqAt_S. { rewrite SeqAt_0. reflexivity. } exact nat_0. }
claim Ly: SeqAt (SeqCons (y0) (SeqCons (y1) SeqNil)) 1 = y1.
{ rewrite SeqAt_S. { rewrite SeqAt_0. reflexivity. } exact nat_0. }
rewrite <- Lx. rewrite <- Ly. exact L.
Qed.


Theorem Lean_List_In : forall u, nat_p u -> P0 :e LeanUniv u -> Lean_List_All :e LeanUniv u.
let u. assume Hu: nat_p u. assume HP0: P0 :e LeanUniv u.
claim Ht: TransSet (LeanUniv u).
{ exact LeanUniv_TransSet u Hu. }
claim Hz: ZF_closed (LeanUniv u).
{ exact LeanUniv_ZF_closed u Hu. }
claim H0: 0 :e LeanUniv u.
{ exact LeanUniv_0_In u Hu. }
claim HO0: forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_List_N 0, V), Lean_List_O 0 a :e LeanUniv u.
{ let V. assume HV: V :e LeanUniv u. let a. assume Ha: a :e (Pi_ j :e Lean_List_N 0, V).
  claim Ham: a :e Pi_ j :e 0, V.
  { exact In_fam_eq (fun X:set => Pi_ j :e X, V) (Lean_List_N 0) 0 Lean_List_N0 a Ha. }
  prove SeqAt (SeqCons (0) (SeqCons (0) SeqNil)) 0 :e LeanUniv u. rewrite Lean_List_O0 a. exact H0. }
claim HO1: forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_List_N 1, V), Lean_List_O 1 a :e LeanUniv u.
{ let V. assume HV: V :e LeanUniv u. let a. assume Ha: a :e (Pi_ j :e Lean_List_N 1, V).
  claim Ham: a :e Pi_ j :e 2, V.
  { exact In_fam_eq (fun X:set => Pi_ j :e X, V) (Lean_List_N 1) 2 Lean_List_N1 a Ha. }
  prove SeqAt (SeqCons (0) (SeqCons (0) SeqNil)) 1 :e LeanUniv u. rewrite Lean_List_O1 a. exact H0. }
exact IndCarrier_In Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B (LeanUniv u) Ht Hz (omega_In_LeanUniv u Hu) (LeanUniv_nat_In u Hu 2 (nat_ordsucc 1
    (nat_ordsucc 0 nat_0))) HP0 Lean_List_arity (fun k Hk => LeanUniv_nat_In u Hu k (nat_p_trans 2 (nat_ordsucc 1 (nat_ordsucc 0 nat_0)) k Hk)) (fun k Hk => (Below_S 1 (fun k => forall V :e LeanUniv
    u, forall a :e (Pi_ j :e Lean_List_N k, V), Lean_List_O k a :e LeanUniv u) (Below_S 0 (fun k => forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_List_N k, V), Lean_List_O k a :e LeanUniv u)
    (Below_0 (fun k => forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_List_N k, V), Lean_List_O k a :e LeanUniv u)) HO0) HO1) k Hk).
Qed.
Theorem Lean_List_type_In : forall u, nat_p u -> P0 :e LeanUniv u -> Lean_List :e LeanUniv u.
let u. assume Hu: nat_p u. assume HP0: P0 :e LeanUniv u.
exact IndFiber_In Lean_List_K Lean_List_T Lean_List_N Lean_List_R Lean_List_F Lean_List_Ix Lean_List_O Lean_List_B (LeanUniv u) (LeanUniv_TransSet u Hu) (LeanUniv_ZF_closed u Hu) (Lean_List_In u Hu
    HP0) 0.
Qed.

