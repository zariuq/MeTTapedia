    => SeqAt (SeqCons ((h0 (a 0))) (SeqCons ((h1 (a 0))) (SeqCons ((h2 (a 0) (a 1))) (SeqCons ((h3 (a 0))) SeqNil)))) k) k a (IndRes Lean_Tm_K Lean_Tm_T Lean_Tm_N Lean_Tm_R Lean_Tm_F Lean_Tm_Ix
