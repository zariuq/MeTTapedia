Theorem Lean_Tm_ind : forall P:set -> prop, (forall x0 :e Lean_Nat, P (Lean_Tm_var_node x0)) -> (forall x0 :e Lean_Tm, P x0 -> P (Lean_Tm_lam_node x0)) -> (forall x0 :e Lean_Tm, forall x1 :e Lean_Tm,
    P x0 -> P x1 -> P (Lean_Tm_app_node x0 x1)) -> (forall x0 :e Lean_Nat, P (Lean_Tm_lit_node x0)) -> forall t :e Lean_Tm, P t.
let P. assume H0. assume H1. assume H2. assume H3.
claim M0: 0 :e (Pi_ x0 :e Lean_Nat, {z :e 1 | P (Lean_Tm_var_node x0)}).
{ apply Pi_0_In. let x0. assume Hx0: x0 :e Lean_Nat.
  prove 0 :e {z :e 1 | P (Lean_Tm_var_node x0)}.
  exact SepI 1 (fun z => P (Lean_Tm_var_node x0)) 0 In_0_1 (H0 x0 Hx0). }
claim M1: 0 :e (Pi_ x0 :e Lean_Tm, (Pi_ y0 :e {z :e 1 | P x0}, {z :e 1 | P (Lean_Tm_lam_node x0)})).
{ apply Pi_0_In. let x0. assume Hx0: x0 :e Lean_Tm.
  prove 0 :e (Pi_ y0 :e {z :e 1 | P x0}, {z :e 1 | P (Lean_Tm_lam_node x0)}).
  apply Pi_0_In. let y0. assume Hy0: y0 :e {z :e 1 | P x0}.
  prove 0 :e {z :e 1 | P (Lean_Tm_lam_node x0)}.
  exact SepI 1 (fun z => P (Lean_Tm_lam_node x0)) 0 In_0_1 (H1 x0 Hx0 (SepE2 1 (fun z => P x0) y0 Hy0)). }
claim M2: 0 :e (Pi_ x0 :e Lean_Tm, (Pi_ x1 :e Lean_Tm, (Pi_ y0 :e {z :e 1 | P x0}, (Pi_ y1 :e {z :e 1 | P x1}, {z :e 1 | P (Lean_Tm_app_node x0 x1)})))).
{ apply Pi_0_In. let x0. assume Hx0: x0 :e Lean_Tm.
  prove 0 :e (Pi_ x1 :e Lean_Tm, (Pi_ y0 :e {z :e 1 | P x0}, (Pi_ y1 :e {z :e 1 | P x1}, {z :e 1 | P (Lean_Tm_app_node x0 x1)}))).
  apply Pi_0_In. let x1. assume Hx1: x1 :e Lean_Tm.
  prove 0 :e (Pi_ y0 :e {z :e 1 | P x0}, (Pi_ y1 :e {z :e 1 | P x1}, {z :e 1 | P (Lean_Tm_app_node x0 x1)})).
  apply Pi_0_In. let y0. assume Hy0: y0 :e {z :e 1 | P x0}.
  prove 0 :e (Pi_ y1 :e {z :e 1 | P x1}, {z :e 1 | P (Lean_Tm_app_node x0 x1)}).
  apply Pi_0_In. let y1. assume Hy1: y1 :e {z :e 1 | P x1}.
  prove 0 :e {z :e 1 | P (Lean_Tm_app_node x0 x1)}.
  exact SepI 1 (fun z => P (Lean_Tm_app_node x0 x1)) 0 In_0_1 (H2 x0 Hx0 x1 Hx1 (SepE2 1 (fun z => P x0) y0 Hy0) (SepE2 1 (fun z => P x1) y1 Hy1)). }
claim M3: 0 :e (Pi_ x0 :e Lean_Nat, {z :e 1 | P (Lean_Tm_lit_node x0)}).
{ apply Pi_0_In. let x0. assume Hx0: x0 :e Lean_Nat.
  prove 0 :e {z :e 1 | P (Lean_Tm_lit_node x0)}.
  exact SepI 1 (fun z => P (Lean_Tm_lit_node x0)) 0 In_0_1 (H3 x0 Hx0). }
let t. assume Ht: t :e Lean_Tm.
exact SepE2 1 (fun z => P t) (Lean_Tm_rec 0 0 0 0 t) (Lean_Tm_rec_type (fun t => {z :e 1 | P t}) 0 M0 0 M1 0 M2 0 M3 t Ht).
Qed.



