    a)) (Below_S 2 (fun k => forall a :e IndArgs Lean_Tm_K Lean_Tm_T Lean_Tm_N Lean_Tm_R Lean_Tm_F Lean_Tm_Ix Lean_Tm_O Lean_Tm_B Lean_Tm_All k, forall r:set -> set, (forall j :e Lean_Tm_N k,
    Lean_Tm_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons ((h0 (a 0))) (SeqCons ((h1 (a 0))) (SeqCons ((h2 (a 0) (a 1))) (SeqCons ((h3 (a 0))) SeqNil)))) k) k a (IndRes Lean_Tm_K
    Lean_Tm_T Lean_Tm_N Lean_Tm_R Lean_Tm_F Lean_Tm_Ix Lean_Tm_O Lean_Tm_B k r) :e C (IndNode Lean_Tm_K Lean_Tm_T Lean_Tm_N Lean_Tm_R Lean_Tm_F Lean_Tm_Ix Lean_Tm_O Lean_Tm_B k a)) (Below_S 1 (fun k
    => forall a :e IndArgs Lean_Tm_K Lean_Tm_T Lean_Tm_N Lean_Tm_R Lean_Tm_F Lean_Tm_Ix Lean_Tm_O Lean_Tm_B Lean_Tm_All k, forall r:set -> set, (forall j :e Lean_Tm_N k, Lean_Tm_R k j -> r j :e C (a
    j)) -> (fun k a r:set => SeqAt (SeqCons ((h0 (a 0))) (SeqCons ((h1 (a 0))) (SeqCons ((h2 (a 0) (a 1))) (SeqCons ((h3 (a 0))) SeqNil)))) k) k a (IndRes Lean_Tm_K Lean_Tm_T Lean_Tm_N Lean_Tm_R
