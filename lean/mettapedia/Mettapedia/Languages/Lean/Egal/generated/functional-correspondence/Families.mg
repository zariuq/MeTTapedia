    Lean_Tm_R k j -> r j :e C (a j)) -> (fun k a r:set => SeqAt (SeqCons ((h0 (a 0))) (SeqCons ((h1 (a 0))) (SeqCons ((h2 (a 0) (a 1))) (SeqCons ((h3 (a 0))) SeqNil)))) k) k a (IndRes Lean_Tm_K
    Lean_Tm_T Lean_Tm_N Lean_Tm_R Lean_Tm_F Lean_Tm_Ix Lean_Tm_O Lean_Tm_B k r) :e C (IndNode Lean_Tm_K Lean_Tm_T Lean_Tm_N Lean_Tm_R Lean_Tm_F Lean_Tm_Ix Lean_Tm_O Lean_Tm_B k a).
