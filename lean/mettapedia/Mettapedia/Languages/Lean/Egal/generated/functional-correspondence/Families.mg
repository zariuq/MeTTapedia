    2 (nat_ordsucc 1 (nat_ordsucc 0 nat_0))) HP0 Lean_Option_arity (fun k Hk => LeanUniv_nat_In u Hu k (nat_p_trans 2 (nat_ordsucc 1 (nat_ordsucc 0 nat_0)) k Hk)) (fun k Hk => (Below_S 1 (fun k =>
    forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_Option_N k, V), Lean_Option_O k a :e LeanUniv u) (Below_S 0 (fun k => forall V :e LeanUniv u, forall a :e (Pi_ j :e Lean_Option_N k, V),
