    (Lean_Tm_lit_node (a 0)) (IndNode Lean_Tm_K Lean_Tm_T Lean_Tm_N Lean_Tm_R Lean_Tm_F Lean_Tm_Ix Lean_Tm_O Lean_Tm_B 3 a) Ln (h3 (a 0)) Lv).
