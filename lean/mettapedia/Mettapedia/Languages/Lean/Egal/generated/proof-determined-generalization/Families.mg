Theorem Lean_Bool_N0 : SeqAt (SeqCons (0) (SeqCons (0) SeqNil)) 0 = 0.
rewrite SeqAt_0. reflexivity.
Qed.
Theorem Lean_Bool_O0 : forall a, SeqAt (SeqCons (0) (SeqCons (0) SeqNil)) 0 = 0.
let a. rewrite SeqAt_0. reflexivity.
Qed.
Theorem Lean_Bool_N1 : SeqAt (SeqCons (0) (SeqCons (0) SeqNil)) 1 = 0.
rewrite SeqAt_S. { rewrite SeqAt_0. reflexivity. } exact nat_0.
