Theorem Lean_And_intro_inj0 : forall x0 x1 y0 y1, (Lean_And_intro_node x0 x1) = (Lean_And_intro_node y0 y1) -> x0 = y0.
let x0 x1 y0 y1. assume H: (Lean_And_intro_node x0 x1) = (Lean_And_intro_node y0 y1).
claim L: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 0 = SeqAt (SeqCons (y0) (SeqCons (y1) SeqNil)) 0.
{ exact IndNode_args_inj Lean_And_K Lean_And_T Lean_And_N Lean_And_R Lean_And_F Lean_And_Ix Lean_And_O Lean_And_B Lean_And_distinct 0 (ordsuccI2 0) 2 (SeqCons (x0) (SeqCons (x1) SeqNil)) (SeqCons
    (y0) (SeqCons (y1) SeqNil)) H 0 (ordsuccI1 1 0 (ordsuccI2 0)). }
claim Lx: SeqAt (SeqCons (x0) (SeqCons (x1) SeqNil)) 0 = x0.
{ rewrite SeqAt_0. reflexivity. }
claim Ly: SeqAt (SeqCons (y0) (SeqCons (y1) SeqNil)) 0 = y0.
{ rewrite SeqAt_0. reflexivity. }
rewrite <- Lx. rewrite <- Ly. exact L.
Qed.
