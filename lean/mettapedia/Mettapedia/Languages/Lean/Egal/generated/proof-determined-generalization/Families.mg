Theorem Lean_Bool_O1 : forall a, SeqAt (SeqCons (0) (SeqCons (0) SeqNil)) 1 = 0.
let a. rewrite SeqAt_S. { rewrite SeqAt_0. reflexivity. } exact nat_0.
Qed.

Theorem Lean_Bool_bd0 : forall a, forall j :e Lean_Bool_N 0, ~ Lean_Bool_R 0 j -> Lean_Bool_F 0 j a c= Lean_Bool_B.
let a j. assume Hj: j :e Lean_Bool_N 0. assume Hnr: ~ Lean_Bool_R 0 j.
