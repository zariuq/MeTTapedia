Theorem Lean_Bool_bounded : IndBounded Lean_Bool_K Lean_Bool_T Lean_Bool_N Lean_Bool_R Lean_Bool_F Lean_Bool_Ix Lean_Bool_O Lean_Bool_B.
let k. assume Hk: k :e Lean_Bool_K.
exact (Below_S 1 (fun k => forall a, forall j :e Lean_Bool_N k, ~ Lean_Bool_R k j -> Lean_Bool_F k j a c= Lean_Bool_B) (Below_S 0 (fun k => forall a, forall j :e Lean_Bool_N k, ~ Lean_Bool_R k j ->
    Lean_Bool_F k j a c= Lean_Bool_B) (Below_0 (fun k => forall a, forall j :e Lean_Bool_N k, ~ Lean_Bool_R k j -> Lean_Bool_F k j a c= Lean_Bool_B)) Lean_Bool_bd0) Lean_Bool_bd1) k Hk.
