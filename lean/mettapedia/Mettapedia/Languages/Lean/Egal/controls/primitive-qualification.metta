!(import! &self fs)
!(import! &self str)
!(import! &self system)
(= (field-at $xs $n)
   (if (== $n 0) (car-atom $xs) (field-at (cdr-atom $xs) (- $n 1))))
(= (rows $path)
   (cdr-atom (filter-atom (fs:read-lines $path) $line (not (== $line "")))))
(= (check-row $row $id $status $missing)
   (let $fields (str:split "\t" $row)
     (if (and (== (field-at $fields 0) $id)
              (and (== (field-at $fields 1) $status) (== (field-at $fields 3) $missing)))
         True
         (let $_error (system:write stderr (format-args "primitive qualification control: unexpected row {}\n" ($row)))
           (system:exit 1)))))
!(let ($positive $negative) (system:args)
   (let* (($yes (rows $positive)) ($no (rows $negative)))
     (if (and (== (size-atom $yes) 4) (== (size-atom $no) 4))
       (let* (($_a (check-row (field-at $yes 0) "1" "qualified" ""))
              ($_b (check-row (field-at $yes 1) "2" "qualified" ""))
              ($_c (check-row (field-at $yes 2) "3" "qualified" ""))
              ($_normal (check-row (field-at $yes 3) "4" "qualified" ""))
              ($_d (check-row (field-at $no 0) "1" "unqualified" "Quot.lift"))
              ($_e (check-row (field-at $no 1) "2" "unqualified" "Quot.lift"))
              ($_f (check-row (field-at $no 2) "3" "qualified" ""))
              ($_normalNegative (check-row (field-at $no 3) "4" "qualified" "")))
         (println! "primitive qualification: a missing lift law invalidates exactly the two quotient runs"))
       (let $_error (system:write stderr "primitive qualification control: expected four rows\n") (system:exit 1)))))
