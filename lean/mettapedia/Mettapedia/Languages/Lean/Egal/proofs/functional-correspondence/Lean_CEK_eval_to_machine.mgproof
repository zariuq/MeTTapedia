        (Lean_CEK_St_mk_typed (Lean_CEK_Ctl_ev_node (Lean_Tm_var_node i) r)
          (Lean_CEK_Ctl_ev_typed (Lean_Tm_var_node i) (Lean_Tm_var_typed i Hi) r Hr) k Hk)
