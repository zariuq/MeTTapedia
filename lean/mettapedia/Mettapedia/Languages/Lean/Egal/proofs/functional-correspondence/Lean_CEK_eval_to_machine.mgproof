        (Lean_CEK_St_mk_typed (Lean_CEK_Ctl_ret_node v) (Lean_CEK_Ctl_ret_typed v Hv) k Hk).
      rewrite Lean_CEK_step_eq_1 i Hi r Hr k Hk.
