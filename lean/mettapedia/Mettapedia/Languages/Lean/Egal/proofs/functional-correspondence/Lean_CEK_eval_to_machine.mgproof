    + let m. assume Hm: m :e Lean_Nat. let v. assume Hv: v :e Lean_CEK_Val.
      assume H: Lean_CEK_evalV (Lean_Nat_succ_node n) r (Lean_Tm_lit_node m) = Lean_Option_some_node Lean_CEK_Val v.
