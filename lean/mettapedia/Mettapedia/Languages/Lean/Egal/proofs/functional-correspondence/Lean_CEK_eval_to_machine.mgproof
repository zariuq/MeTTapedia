claim Main: forall n :e Lean_Nat, forall r :e (Lean_List Lean_CEK_Val), forall t :e Lean_Tm, forall v :e Lean_CEK_Val,
  Lean_CEK_evalV n r t = Lean_Option_some_node Lean_CEK_Val v -> forall k :e (Lean_List Lean_CEK_Frame),
