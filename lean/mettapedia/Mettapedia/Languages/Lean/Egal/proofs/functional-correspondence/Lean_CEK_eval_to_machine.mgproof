    + let b. assume Hb: b :e Lean_Tm. assume IHb. let v. assume Hv: v :e Lean_CEK_Val.
      assume H: Lean_CEK_evalV (Lean_Nat_succ_node n) r (Lean_Tm_lam_node b) = Lean_Option_some_node Lean_CEK_Val v.
      let k. assume Hk: k :e (Lean_List Lean_CEK_Frame).
      claim Ev: Lean_CEK_Val_clo_node b r = v.
      { apply Lean_Option_some_inj0 Lean_CEK_Val. rewrite <- Lean_CEK_evalV_eq_4 r Hr n Hn b Hb. exact H. }
      rewrite <- Ev.
      apply Lean_Machine_single Lean_CEK_St Lean_CEK_step
        (Lean_CEK_St_mk_node (Lean_CEK_Ctl_ev_node (Lean_Tm_lam_node b) r) k)
        (Lean_CEK_St_mk_typed (Lean_CEK_Ctl_ev_node (Lean_Tm_lam_node b) r)
          (Lean_CEK_Ctl_ev_typed (Lean_Tm_lam_node b) (Lean_Tm_lam_typed b Hb) r Hr) k Hk)
