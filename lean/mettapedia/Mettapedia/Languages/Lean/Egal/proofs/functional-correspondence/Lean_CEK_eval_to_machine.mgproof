      assume H: Lean_CEK_evalV (Lean_Nat_succ_node n) r (Lean_Tm_app_node f a) = Lean_Option_some_node Lean_CEK_Val v.
      let k. assume Hk: k :e (Lean_List Lean_CEK_Frame).
