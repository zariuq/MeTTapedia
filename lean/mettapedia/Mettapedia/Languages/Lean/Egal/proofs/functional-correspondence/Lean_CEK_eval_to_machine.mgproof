{ apply Lean_Nat_ind.
  - let r. assume Hr: r :e (Lean_List Lean_CEK_Val). let t. assume Ht: t :e Lean_Tm.
    let v. assume Hv: v :e Lean_CEK_Val.
    assume H: Lean_CEK_evalV Lean_Nat_zero_node r t = Lean_Option_some_node Lean_CEK_Val v.
    let k. assume Hk: k :e (Lean_List Lean_CEK_Frame).
    claim E0: Lean_CEK_evalV Lean_Nat_zero_node r t = Lean_Option_none_node Lean_CEK_Val.
    { rewrite <- LeanNum_0. exact Lean_CEK_evalV_eq_1 r Hr t Ht. }
    apply FalseE. apply Lean_Option_noconf0_1 Lean_CEK_Val v.
    rewrite <- H. rewrite E0. reflexivity.
  - let n. assume Hn: n :e Lean_Nat.
    assume IH: forall r :e (Lean_List Lean_CEK_Val), forall t :e Lean_Tm, forall v :e Lean_CEK_Val,
      Lean_CEK_evalV n r t = Lean_Option_some_node Lean_CEK_Val v -> forall k :e (Lean_List Lean_CEK_Frame),
      0 :e Lean_Relation_ReflTransGen_Prop Lean_CEK_St (Lean_StepRel Lean_CEK_St Lean_CEK_step)
