let v_n. assume Hn: v_n :e Lean_Nat.
let v_P. assume HP: v_P :e (Pi_ v_k :e Lean_Nat, (Pi_ ux :e (Lean_Nat_le_Prop (Lean_Nat_succ_node v_k) (Lean_Nat_add v_n (LeanNum 1))), LeanProp)).
