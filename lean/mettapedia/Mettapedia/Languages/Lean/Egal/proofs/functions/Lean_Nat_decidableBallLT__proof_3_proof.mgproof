{ exact ap_Pi (Lean_Nat_le_Prop (Lean_Nat_succ_node v_n) (Lean_Nat_add v_n (LeanNum 1))) (fun _ => (v_P v_n 0)) (0 v_n) 0 A0 Hle. }
claim N0: 0 :e (Pi_ ux :e (v_P v_n 0), Lean_False_Prop).
