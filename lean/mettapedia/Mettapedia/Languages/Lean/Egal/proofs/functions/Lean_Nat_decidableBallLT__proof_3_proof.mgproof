claim Hle: 0 :e Lean_Nat_le_Prop (Lean_Nat_succ_node v_n) (Lean_Nat_add v_n (LeanNum 1)).
{ rewrite LeanNat_add_one v_n Hn. exact Lean_Nat_le_refl_proof_ok (Lean_Nat_succ_node v_n). }
