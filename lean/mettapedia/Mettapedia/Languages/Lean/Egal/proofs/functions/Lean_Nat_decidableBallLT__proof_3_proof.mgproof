assume Hall: 0 :e (Pi_ v_x4 :e Lean_Nat, (Pi_ v_h :e (Lean_Nat_le_Prop (Lean_Nat_succ_node v_x4) (Lean_Nat_add v_n (LeanNum 1))), (v_P v_x4 0))).
