let l_u_1. assume H_l_u_1: nat_p l_u_1. let A. assume H_A: A :e LeanUniv l_u_1. let xs. assume Hxs: xs :e Lean_List A. let ys. assume Hys: ys :e Lean_List A. assume H: 0 :e Lean_List_Perm_Prop A xs ys.
