let l_u_1. assume H_l_u_1: nat_p l_u_1. let A. assume H_A: A :e LeanUniv l_u_1. let p. assume Hp: p :e (Pi_ ux :e A, Lean_Bool). let xs. assume Hxs: xs :e Lean_List A. let ys. assume Hys: ys :e Lean_List A. assume H: 0 :e Lean_List_Perm_Prop A xs ys.
exact LeanListPerm_to_prop A (Lean_List_filter A p xs) (Lean_List_filter A p ys)
  (LeanListPerm_filter A p Hp xs ys (LeanListPerm_from_prop A xs ys H)).
