import Mettapedia.Languages.Lean.Lean4LeanDirectedReduction
import Lean4Lean.Theory.Typing.HeadReduction

/-!
# Comparing generated Lean NTT steps with Lean4Lean weak-head reduction

The directed Lean GSLT and its OSLF/NTT analysis are deliberately independent
of Lean4Lean's unfinished Church--Rosser development.  This module is the
quarantined comparison boundary: under Lean4Lean's explicit `Params` package,
every evaluator-facing core event becomes an actual `WHRed` derivation.

This is a sound inclusion, not an equality claim.  Lean4Lean's full `WHRed`
also contains major-premise reduction and whatever extra pattern rules a
`Params` instance supplies.  Conversely, no concrete `Params` instance is
currently available from the upstream metatheory without unfinished results.
-/

namespace Mettapedia.Languages.Lean.Lean4LeanWHRedComparison

open Lean4Lean
open Lean4Lean.VEnv
open Lean4Lean.VEnv.Params
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis
open Mettapedia.Languages.Lean.Lean4LeanDirectedReduction

/-- Raw beta, delta, and head-application events embed into Lean4Lean's
authored weak-head reduction when its explicit rule package is supplied. -/
def rawEventToWHRed [Lean4Lean.VEnv.Params]
    (context : List VExpr) :
    forall {source target : VExpr},
      CoreRawHeadEvent env univs source target ->
        WHRed context source target
  | _, _, .beta => .beta
  | _, _, .delta member levelsWellFormed levelCount => by
      obtain ⟨pattern, rightHandSide, firstMatch, secondMatch,
          patternRule, patternMatch, checks, targetEquation⟩ :=
        extra_pat member levelsWellFormed levelCount (Γ := context)
      rw [targetEquation]
      exact .extra patternRule patternMatch checks
  | _, _, .app head => .app (rawEventToWHRed context head)

/-- Typed event evidence maps to the same Lean4Lean evaluator step after its
typing payload is erased. -/
def typedEventToWHRed [Lean4Lean.VEnv.Params]
    (context : List VExpr) :
    forall {expectedType source target : VExpr},
      CoreHeadEvent env univs context expectedType source target ->
        WHRed context source target
  | _, _, _, event => rawEventToWHRed context event.toRaw

/-- The raw exact-target native type generated by OSLF is sound for
Lean4Lean's actual `WHRed` relation, conditionally on its rule package. -/
theorem raw_ntt_sound_WHRed [Lean4Lean.VEnv.Params]
    (context : List VExpr) (source target : VExpr)
    (inhabited :
      (gsltOSLF (coreRawHeadGSLT env univs)).satisfies source
        (exactCoreRawHeadTargetType env univs target).pred) :
    WHRed context source target := by
  obtain ⟨event⟩ :=
    (satisfies_exactCoreRawHeadTargetType_iff_event env univs
      source target).mp inhabited
  exact rawEventToWHRed context event

/-- The typed refinement's generated native type is simultaneously sound for
Lean4Lean weak-head reduction and its declarative typed equality. -/
theorem typed_ntt_sound_WHRed_and_defEq [Lean4Lean.VEnv.Params]
    (context : List VExpr) (expectedType source target : VExpr)
    (inhabited :
      (gsltOSLF (coreHeadGSLT env univs context expectedType)).satisfies source
        (exactCoreHeadTargetType env univs context expectedType target).pred) :
    WHRed context source target ∧
      env.IsDefEq univs context source target expectedType := by
  obtain ⟨event⟩ :=
    (satisfies_exactCoreHeadTargetType_iff_event env univs context
      expectedType source target).mp inhabited
  exact ⟨typedEventToWHRed context event, event.defEq⟩

section AxiomAudit

#print axioms rawEventToWHRed
#print axioms typedEventToWHRed
#print axioms raw_ntt_sound_WHRed
#print axioms typed_ntt_sound_WHRed_and_defEq

end AxiomAudit

end Mettapedia.Languages.Lean.Lean4LeanWHRedComparison
