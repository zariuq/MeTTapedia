import Mettapedia.GSLT.Core.IndexedOperational
import Mettapedia.Languages.MeTTa.PrimeCandidates.DeclarationBased.NativeHOLRecursiveProofNIKQualification

/-!
# Proof-qualified operational cospans

A proof-authorized program transformation and an operational observation have
different jobs.  The proof explains why the two source programs may be
compared.  Directed reductions explain what each program actually does.  An
equation-invariant predicate explains which common result is visible to OSLF.

`ProofQualifiedReachabilityCospan` keeps those three witnesses separate while
placing them in one compositional interface.  Its legs are finite reductions
to a common target, so the generated OSLF of the closure observes both source
programs.  It does not identify their execution traces, effects, costs, or
intermediate states.

The map-fusion instance retains the submitted HOL induction proof, its exact
recursive compiler output, both native beta/iota reductions, and the common
Aczel-valued observation.  A distinct accepted HOL proof is an explicit
negative control: the operational observation remains available, but that
proof does not qualify the map-fusion transformation.
-/

open Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId
open Mettapedia.TypeTheory.UniverseLevel

set_option autoImplicit false

open Mettapedia.TypeTheory.Calculi.CumulativePiSigmaId

namespace Mettapedia.Languages.MeTTa.PrimeCandidates.DeclarationBased
namespace NativeHOLProofQualifiedOperationalCospan

open Mettapedia.GSLT
open Mettapedia.GSLT.IndexedOperational
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis

universe uTerm uEvidence uEvidence' u

/-! ## The representation-independent interface -/

/-- Two finite directed executions with a common observed target, together
with retained evidence that qualifies comparison of their source programs.

`Qualifies` is deliberately indexed by both endpoints.  Evidence for one
transformation therefore cannot be reused at another target merely because
the two programs happen to share an observation. -/
structure ProofQualifiedReachabilityCospan
    (system : GSLT.{uTerm}) (Evidence : Type uEvidence)
    (Qualifies : Evidence -> system.Term -> system.Term -> Prop)
    (observation : EquationPredicate system.closure)
    (left right : system.Term) where
  evidence : Evidence
  qualification : Qualifies evidence left right
  apex : system.Term
  leftReaches : system.MultiStep left apex
  rightReaches : system.MultiStep right apex
  apexObserved : observation apex

namespace ProofQualifiedReachabilityCospan

variable {system : GSLT.{uTerm}} {Evidence : Type uEvidence}
  {Qualifies : Evidence -> system.Term -> system.Term -> Prop}
  {observation : EquationPredicate system.closure}
  {left right : system.Term}

@[ext]
theorem ext
    {first second : ProofQualifiedReachabilityCospan system Evidence
      Qualifies observation left right}
    (evidence : first.evidence = second.evidence)
    (apex : first.apex = second.apex) : first = second := by
  cases first
  cases second
  cases evidence
  cases apex
  rfl

/-- A finite left run is one macro-step in the closure GSLT. -/
theorem leftClosureStep
    (cospan : ProofQualifiedReachabilityCospan system Evidence Qualifies
      observation left right) :
    system.closure.Step left cospan.apex :=
  ⟨cospan.apex, cospan.leftReaches, system.equations.iseqv.refl _⟩

/-- A finite right run is one macro-step in the closure GSLT. -/
theorem rightClosureStep
    (cospan : ProofQualifiedReachabilityCospan system Evidence Qualifies
      observation left right) :
    system.closure.Step right cospan.apex :=
  ⟨cospan.apex, cospan.rightReaches, system.equations.iseqv.refl _⟩

/-- The left source satisfies the OSLF possibility generated by the closure
GSLT and the selected equation-invariant observation. -/
theorem left_semanticDiamond
    (cospan : ProofQualifiedReachabilityCospan system Evidence Qualifies
      observation left right) :
    semanticDiamond system.closure observation left := by
  apply (gsltDiamond_spec system.closure observation.1 left).2
  exact ⟨cospan.apex, cospan.leftClosureStep, cospan.apexObserved⟩

/-- The right source satisfies the same generated OSLF possibility. -/
theorem right_semanticDiamond
    (cospan : ProofQualifiedReachabilityCospan system Evidence Qualifies
      observation left right) :
    semanticDiamond system.closure observation right := by
  apply (gsltDiamond_spec system.closure observation.1 right).2
  exact ⟨cospan.apex, cospan.rightClosureStep, cospan.apexObserved⟩

/-- The operational cospan supplies the two sides of the generated modal
observation without turning their separate reductions into equal traces. -/
theorem semanticDiamonds
    (cospan : ProofQualifiedReachabilityCospan system Evidence Qualifies
      observation left right) :
    semanticDiamond system.closure observation left /\
      semanticDiamond system.closure observation right :=
  ⟨cospan.left_semanticDiamond, cospan.right_semanticDiamond⟩

/-- The common observation is already a predicate on equation classes; no
choice of representative is exposed by this projection. -/
theorem quotient_apex_observed
    (cospan : ProofQualifiedReachabilityCospan system Evidence Qualifies
      observation left right) :
    descendPredicate system.closure observation
        (Quotient.mk system.closure.equations cospan.apex) := by
  exact cospan.apexObserved

/-- Weakening the observation preserves the same evidence, apex, and directed
executions. -/
def mapObservation
    (cospan : ProofQualifiedReachabilityCospan system Evidence Qualifies
      observation left right)
    (next : EquationPredicate system.closure)
    (implication : ∀ term, observation term -> next term) :
    ProofQualifiedReachabilityCospan system Evidence Qualifies next left right where
  evidence := cospan.evidence
  qualification := cospan.qualification
  apex := cospan.apex
  leftReaches := cospan.leftReaches
  rightReaches := cospan.rightReaches
  apexObserved := implication cospan.apex cospan.apexObserved

/-- Reindex proof evidence while preserving the endpoint-indexed
qualification relation. -/
def mapEvidence
    {Evidence' : Type uEvidence'}
    {Qualifies' : Evidence' -> system.Term -> system.Term -> Prop}
    (cospan : ProofQualifiedReachabilityCospan system Evidence Qualifies
      observation left right)
    (translate : Evidence -> Evidence')
    (preserves : ∀ evidence first second,
      Qualifies evidence first second ->
        Qualifies' (translate evidence) first second) :
    ProofQualifiedReachabilityCospan system Evidence' Qualifies'
      observation left right where
  evidence := translate cospan.evidence
  qualification := preserves _ _ _ cospan.qualification
  apex := cospan.apex
  leftReaches := cospan.leftReaches
  rightReaches := cospan.rightReaches
  apexObserved := cospan.apexObserved

/-- Reversing the operational cospan also reverses its qualification
relation.  Qualification is not silently assumed symmetric. -/
def reverse
    (cospan : ProofQualifiedReachabilityCospan system Evidence Qualifies
      observation left right) :
    ProofQualifiedReachabilityCospan system Evidence
      (fun evidence first second => Qualifies evidence second first)
      observation right left where
  evidence := cospan.evidence
  qualification := cospan.qualification
  apex := cospan.apex
  leftReaches := cospan.rightReaches
  rightReaches := cospan.leftReaches
  apexObserved := cospan.apexObserved

/-! ## Naturality under operational translations -/

/-- Forward operational translations preserve finite reachability. -/
theorem mapMultiStep {source : GSLT.{uTerm}} {target : GSLT.{uTerm}}
    (translation : OperationalTranslation source target) :
    {first last : source.Term} -> source.MultiStep first last ->
      target.MultiStep (translation.mapTerm first) (translation.mapTerm last)
  | _, _, .refl term => .refl (translation.mapTerm term)
  | _, _, .step step rest =>
      .step (translation.mapStep step) (mapMultiStep translation rest)

@[simp] theorem mapMultiStep_id {source : GSLT.{uTerm}}
    {first last : source.Term} (path : source.MultiStep first last) :
    mapMultiStep (OperationalTranslation.id source) path = path :=
  Subsingleton.elim _ _

theorem mapMultiStep_comp
    {source middle target : GSLT.{uTerm}}
    (earlier : OperationalTranslation source middle)
    (later : OperationalTranslation middle target)
    {first last : source.Term} (path : source.MultiStep first last) :
    mapMultiStep (earlier.comp later) path =
      mapMultiStep later (mapMultiStep earlier path) :=
  Subsingleton.elim _ _

/-- Transport a qualified cospan along a forward operational translation.
The caller supplies the translated qualification and observation laws; neither
is inferred from bare reachability. -/
def mapAlong
    {source : GSLT.{uTerm}} {target : GSLT.{uTerm}}
    {SourceEvidence : Type uEvidence} {TargetEvidence : Type uEvidence'}
    {SourceQualifies : SourceEvidence -> source.Term -> source.Term -> Prop}
    {TargetQualifies : TargetEvidence -> target.Term -> target.Term -> Prop}
    {sourceObservation : EquationPredicate source.closure}
    {sourceLeft sourceRight : source.Term}
    (cospan : ProofQualifiedReachabilityCospan source SourceEvidence
      SourceQualifies sourceObservation sourceLeft sourceRight)
    (translation : OperationalTranslation source target)
    (translateEvidence : SourceEvidence -> TargetEvidence)
    (targetObservation : EquationPredicate target.closure)
    (qualificationNaturality : ∀ evidence first second,
      SourceQualifies evidence first second ->
        TargetQualifies (translateEvidence evidence)
          (translation.mapTerm first) (translation.mapTerm second))
    (observationNaturality : ∀ term,
      sourceObservation term -> targetObservation (translation.mapTerm term)) :
    ProofQualifiedReachabilityCospan target TargetEvidence TargetQualifies
      targetObservation (translation.mapTerm sourceLeft)
        (translation.mapTerm sourceRight) where
  evidence := translateEvidence cospan.evidence
  qualification := qualificationNaturality _ _ _ cospan.qualification
  apex := translation.mapTerm cospan.apex
  leftReaches := mapMultiStep translation cospan.leftReaches
  rightReaches := mapMultiStep translation cospan.rightReaches
  apexObserved := observationNaturality cospan.apex cospan.apexObserved

/-- Identity translation changes none of a qualified cospan's retained data. -/
@[simp] theorem mapAlong_id
    (cospan : ProofQualifiedReachabilityCospan system Evidence Qualifies
      observation left right) :
    cospan.mapAlong (OperationalTranslation.id system)
        (fun evidence => evidence) observation
        (fun _ _ _ qualified => qualified)
        (fun _ observed => observed) = cospan := by
  apply ext <;> rfl

/-- Transporting a qualified cospan in two stages is the same construction as
transporting it along the composite operational translation.  Reachability,
evidence qualification, and observation naturality compose independently. -/
theorem mapAlong_comp
    {source middle target : GSLT.{uTerm}}
    {SourceEvidence : Type uEvidence}
    {MiddleEvidence : Type uEvidence'} {TargetEvidence : Type u}
    {SourceQualifies : SourceEvidence -> source.Term -> source.Term -> Prop}
    {MiddleQualifies : MiddleEvidence -> middle.Term -> middle.Term -> Prop}
    {TargetQualifies : TargetEvidence -> target.Term -> target.Term -> Prop}
    {sourceObservation : EquationPredicate source.closure}
    {sourceLeft sourceRight : source.Term}
    (cospan : ProofQualifiedReachabilityCospan source SourceEvidence
      SourceQualifies sourceObservation sourceLeft sourceRight)
    (earlier : OperationalTranslation source middle)
    (later : OperationalTranslation middle target)
    (toMiddle : SourceEvidence -> MiddleEvidence)
    (toTarget : MiddleEvidence -> TargetEvidence)
    (middleObservation : EquationPredicate middle.closure)
    (targetObservation : EquationPredicate target.closure)
    (firstQualification : ∀ evidence first second,
      SourceQualifies evidence first second ->
        MiddleQualifies (toMiddle evidence)
          (earlier.mapTerm first) (earlier.mapTerm second))
    (secondQualification : ∀ evidence first second,
      MiddleQualifies evidence first second ->
        TargetQualifies (toTarget evidence)
          (later.mapTerm first) (later.mapTerm second))
    (firstObservation : ∀ term,
      sourceObservation term -> middleObservation (earlier.mapTerm term))
    (secondObservation : ∀ term,
      middleObservation term -> targetObservation (later.mapTerm term)) :
    (cospan.mapAlong earlier toMiddle middleObservation
        firstQualification firstObservation).mapAlong
          later toTarget targetObservation
          secondQualification secondObservation =
      cospan.mapAlong (earlier.comp later)
        (fun evidence => toTarget (toMiddle evidence)) targetObservation
        (fun evidence first second qualified =>
          secondQualification _ _ _
            (firstQualification evidence first second qualified))
        (fun term observed =>
          secondObservation _ (firstObservation term observed)) := by
  apply ext <;> rfl

end ProofQualifiedReachabilityCospan

/-! ## Route-sensitive boundary canary -/

namespace RouteLengthBoundary

/-- Two programs can converge through operational routes of different
lengths. -/
inductive State where
  | left
  | right
  | middle
  | done
deriving DecidableEq

inductive RuntimeStep : State -> State -> Prop where
  | finishLeft : RuntimeStep .left .done
  | prepareRight : RuntimeStep .right .middle
  | finishRight : RuntimeStep .middle .done

def system : GSLT where
  Term := State
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites := RuntimeStep
  rewrites_resp_left := by
    intro source source' target equal step
    subst source'
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    intro source target target' step equal
    subst target'
    exact step

/-- A directional license for comparing the two source programs. -/
inductive License where
  | compareBranches
deriving DecidableEq

def Qualifies (_ : License) (first second : State) : Prop :=
  first = .left /\ second = .right

def doneObservation : EquationPredicate system.closure where
  val state := state = State.done
  property := by
    intro first second equivalent
    change first = second at equivalent
    subst second
    exact Iff.rfl

def leftRoute : system.RewritePath State.left State.done :=
  @GSLT.RewritePath.cons system State.left State.done State.done
    RuntimeStep.finishLeft
    (@GSLT.RewritePath.nil system State.done)

def rightRoute : system.RewritePath State.right State.done :=
  @GSLT.RewritePath.cons system State.right State.middle State.done
    RuntimeStep.prepareRight
    (@GSLT.RewritePath.cons system State.middle State.done State.done
      RuntimeStep.finishRight
      (@GSLT.RewritePath.nil system State.done))

theorem routes_have_different_lengths :
    leftRoute.length ≠ rightRoute.length := by
  simp [leftRoute, rightRoute, GSLT.RewritePath.length]

def qualifiedCospan :
    ProofQualifiedReachabilityCospan system License Qualifies
      doneObservation .left .right where
  evidence := .compareBranches
  qualification := ⟨rfl, rfl⟩
  apex := State.done
  leftReaches :=
    @GSLT.MultiStep.step system State.left State.done State.done
      RuntimeStep.finishLeft (@GSLT.MultiStep.refl system State.done)
  rightReaches :=
    @GSLT.MultiStep.step system State.right State.middle State.done
      RuntimeStep.prepareRight
      (@GSLT.MultiStep.step system State.middle State.done State.done
        RuntimeStep.finishRight (@GSLT.MultiStep.refl system State.done))
  apexObserved := rfl

theorem license_does_not_qualify_reverse :
    ¬ Qualifies .compareBranches .right .left := by
  simp [Qualifies]

/-- Sharing a modal endpoint is compatible with distinct route lengths and
does not reverse a directional proof license. -/
theorem common_observation_preserves_route_and_license_distinctions :
    semanticDiamond system.closure doneObservation .left /\
      semanticDiamond system.closure doneObservation .right /\
      leftRoute.length ≠ rightRoute.length /\
      ¬ Qualifies .compareBranches .right .left := by
  exact ⟨qualifiedCospan.left_semanticDiamond,
    qualifiedCospan.right_semanticDiamond,
    routes_have_different_lengths, license_does_not_qualify_reverse⟩

end RouteLengthBoundary

/-! ## Nontrivial equation-class boundary canary -/

namespace EquationClassBoundary

inductive State where
  | left
  | right
  | doneA
  | doneB
deriving DecidableEq

inductive StateClass where
  | left
  | right
  | done
deriving DecidableEq

def classify : State -> StateClass
  | .left => .left
  | .right => .right
  | .doneA => .done
  | .doneB => .done

def classSetoid : Setoid State where
  r first second := classify first = classify second
  iseqv := ⟨fun _ => rfl, Eq.symm, Eq.trans⟩

def CanStart (state : State) : Prop :=
  classify state = .left ∨ classify state = .right

/-- Reduction is stated on semantic classes: either source class may reach
either representative of the terminal class. -/
def system : GSLT where
  Term := State
  equations := classSetoid
  rewrites source target :=
    CanStart source ∧ classify target = .done
  rewrites_resp_left := by
    intro source source' target equivalent step
    change classify source = classify source' at equivalent
    refine ⟨target, ⟨?_, step.2⟩, rfl⟩
    rcases step.1 with sourceLeft | sourceRight
    · exact Or.inl (equivalent.symm.trans sourceLeft)
    · exact Or.inr (equivalent.symm.trans sourceRight)
  rewrites_resp_right := by
    intro source target target' step equivalent
    change classify target = classify target' at equivalent
    exact ⟨step.1, equivalent.symm.trans step.2⟩

inductive License where
  | compareBranches

def Qualifies (_ : License) (first second : State) : Prop :=
  first = .left ∧ second = .right

def doneObservation : EquationPredicate system.closure where
  val state := classify state = .done
  property := by
    intro first second equivalent
    change classify first = classify second at equivalent
    constructor
    · exact fun firstDone => equivalent.symm.trans firstDone
    · exact fun secondDone => equivalent.trans secondDone

theorem left_step : system.Step .left .doneA :=
  ⟨Or.inl rfl, rfl⟩

theorem right_step : system.Step .right .doneA :=
  ⟨Or.inr rfl, rfl⟩

def qualifiedCospan :
    ProofQualifiedReachabilityCospan system License Qualifies
      doneObservation .left .right where
  evidence := .compareBranches
  qualification := ⟨rfl, rfl⟩
  apex := State.doneA
  leftReaches :=
    @GSLT.MultiStep.step system State.left State.doneA State.doneA
      left_step (@GSLT.MultiStep.refl system State.doneA)
  rightReaches :=
    @GSLT.MultiStep.step system State.right State.doneA State.doneA
      right_step (@GSLT.MultiStep.refl system State.doneA)
  apexObserved := rfl

theorem terminal_representatives_are_distinct : State.doneA ≠ State.doneB := by
  decide

theorem terminal_representatives_are_equivalent :
    system.Equiv State.doneA State.doneB :=
  rfl

theorem terminal_quotient_classes_are_equal :
    Quotient.mk system.equations State.doneA =
      Quotient.mk system.equations State.doneB :=
  Quotient.sound terminal_representatives_are_equivalent

theorem alternate_representative_is_observed :
    doneObservation State.doneB :=
  rfl

/-- The modal result lives naturally on the equation class: the two terminal
representatives differ literally but have one quotient identity and one
invariant observation. -/
theorem observation_uses_equation_class_not_literal_identity :
    semanticDiamond system.closure doneObservation .left ∧
      semanticDiamond system.closure doneObservation .right ∧
      State.doneA ≠ State.doneB ∧
      system.Equiv State.doneA State.doneB ∧
      Quotient.mk system.equations State.doneA =
        Quotient.mk system.equations State.doneB ∧
      doneObservation State.doneB := by
  exact ⟨qualifiedCospan.left_semanticDiamond,
    qualifiedCospan.right_semanticDiamond,
    terminal_representatives_are_distinct,
    terminal_representatives_are_equivalent,
    terminal_quotient_classes_are_equal,
    alternate_representative_is_observed⟩

end EquationClassBoundary

/-! ## The retained recursive HOL map-fusion instance -/

open Presentation NativeIndexedFamilies IntrinsicNativeListMapComputation
open NativeHOLRecursiveProofOperationalObservation
open NativeHOLRecursiveProofNIKQualification
open NativeHOLRecursiveProofNIKQualification.Controls
open NativeHOLTraceRecursiveExtensionalCompilerSemantics
open HOLLeibnizNativeQualifiedHOTGIntegration
open FormationSensitiveHOLInterface FormationSensitiveHOLUniformList
open Mettapedia.Logic HOL.UniformListInduction
open Mettapedia.Logic.HOL.Embedding
open ZFSetUniformListTraceTypeInterpretation

/-- The exact pair of native programs to which one instance of the retained
polymorphic map-fusion proof is attached. -/
structure MapFusionPrograms (n : Nat) where
  source : Tower.Tm n
  middle : Tower.Tm n
  target : Tower.Tm n
  first : Tower.Tm n
  second : Tower.Tm n
  inputs : List (Tower.Tm n)

variable {n : Nat}

namespace MapFusionPrograms

def unfused (programs : MapFusionPrograms n) : Tower.Tm n :=
  applyMap programs.middle programs.target programs.first
    (applyMap programs.source programs.middle programs.second
      (encode programs.source programs.inputs))

def fused (programs : MapFusionPrograms n) : Tower.Tm n :=
  applyMap programs.source programs.target
    (compose programs.first programs.second)
      (encode programs.source programs.inputs)

def common (programs : MapFusionPrograms n) : Tower.Tm n :=
  encode programs.target
    (programs.inputs.map
      (fun input => .app programs.first (.app programs.second input)))

end MapFusionPrograms

/-- Qualification retains both NIK acceptance of the submitted source proof
and the exact recursive compiler output, then binds them to a concrete native
map-fusion pair. -/
def RetainedMapFusionQualifies {n : Nat}
    (proof : IntrinsicProof) (left right : Tower.Tm n) : Prop :=
  intrinsicKernel.decide HOLLeibnizMapFusionNative.closedClaim proof = true /\
    HOLLeibnizNativeRecursiveExtensionalCompiler.compile
        proof.source Fin.elim0 Fin.elim0 =
      some HOLLeibnizMapFusionNative.nativeProof /\
    ∃ programs : MapFusionPrograms n,
      left = programs.unfused /\ right = programs.fused

theorem retainedMapFusionProof_qualifies (programs : MapFusionPrograms n) :
    RetainedMapFusionQualifies retainedMapFusionProof
      programs.unfused programs.fused := by
  exact ⟨retained_map_fusion_accepted,
    CompilerAgreement.recursive_compiler_emits_closed_map_fusion,
    programs, rfl, rfl⟩

/-- A distinct accepted HOL proof does not authorize map fusion. -/
theorem identityProof_rejected_for_mapFusion :
    intrinsicKernel.decide HOLLeibnizMapFusionNative.closedClaim
      identityProof = false :=
  rfl

theorem identityProof_not_mapFusionQualified (programs : MapFusionPrograms n) :
    ¬ RetainedMapFusionQualifies identityProof
      programs.unfused programs.fused := by
  intro qualified
  unfold RetainedMapFusionQualifies at qualified
  rw [identityProof_rejected_for_mapFusion] at qualified
  exact Bool.false_ne_true qualified.1

/-- The common-carrier list workload uses the same native element type at all
three polymorphic map slots. -/
def nativeListPrograms {n : Nat} (first second : Tower.Tm n)
    (inputs : List (Tower.Tm n)) : MapFusionPrograms n where
  source := elementCode n
  middle := elementCode n
  target := elementCode n
  first := first
  second := second
  inputs := inputs

/-- The actual retained recursive HOL proof, its native beta/iota runs, and
its Aczel-valued observation assembled as one reusable cospan. -/
noncomputable def recursiveMapFusionCospan
    {n : Nat} {a : ZFSet.{u}}
    {context : NativeTraceLambdaSemantics.Context.{u} n}
    (level : LevelExpr Nat) (first second : Tower.Tm n)
    (firstMeaning secondMeaning : FunctionMeaning a context)
    (firstDenotes : NativeHOLTraceDisplayedTerms.Denotes a context
      first firstMeaning)
    (secondDenotes : NativeHOLTraceDisplayedTerms.Denotes a context
      second secondMeaning)
    (heads : Heads a context)
    (interpreted : ∀ head ∈ heads,
      NativeHOLTraceDisplayedTerms.Denotes a context head.1 head.2)
    (environment : context.Environment) (property : Value a sequence -> Prop)
    (accepted : property
      (ZFSetUniformListTraceProofBridge.beforeSection
        (firstMeaning environment) (secondMeaning environment)
        (ZFSetList.encodeValue (headValues heads environment)) PUnit.unit)) :
    let programs := nativeListPrograms first second (heads.map Prod.fst)
    ProofQualifiedReachabilityCospan (reduction level n) IntrinsicProof
      RetainedMapFusionQualifies
      (semanticObservation level environment property)
      programs.unfused programs.fused := by
  let programs := nativeListPrograms first second (heads.map Prod.fst)
  have paths := fusion_common_output level
    (elementCode n) (elementCode n) (elementCode n)
      first second (heads.map Prod.fst)
  refine
    { evidence := retainedMapFusionProof
      qualification := retainedMapFusionProof_qualifies programs
      apex := programs.common
      leftReaches := ?_
      rightReaches := ?_
      apexObserved := ?_ }
  · simpa [programs, nativeListPrograms, MapFusionPrograms.unfused,
      MapFusionPrograms.common] using paths.1
  · simpa [programs, nativeListPrograms, MapFusionPrograms.fused,
      MapFusionPrograms.common] using paths.2
  · refine ⟨fun currentEnvironment => ZFSetList.encodeValue
        ((headValues heads currentEnvironment).map
          (fun input => app (firstMeaning currentEnvironment)
            (app (secondMeaning currentEnvironment) input))), ?_, ?_⟩
    · simpa [programs, nativeListPrograms, MapFusionPrograms.common] using
        (fusion_output_denotes first second firstMeaning secondMeaning
          firstDenotes secondDenotes heads interpreted)
    · have transported := recursive_fusion_transports_property
        (firstMeaning environment) (secondMeaning environment)
        (ZFSetList.encodeValue (headValues heads environment))
        property accepted
      rw [afterSection_encodeValue] at transported
      exact transported

/-- The existing generated OSLF result is now a projection of the generic
proof-qualified cospan. -/
theorem recursiveMapFusionCospan_semanticDiamonds
    {n : Nat} {a : ZFSet.{u}}
    {context : NativeTraceLambdaSemantics.Context.{u} n}
    (level : LevelExpr Nat) (first second : Tower.Tm n)
    (firstMeaning secondMeaning : FunctionMeaning a context)
    (firstDenotes : NativeHOLTraceDisplayedTerms.Denotes a context
      first firstMeaning)
    (secondDenotes : NativeHOLTraceDisplayedTerms.Denotes a context
      second secondMeaning)
    (heads : Heads a context)
    (interpreted : ∀ head ∈ heads,
      NativeHOLTraceDisplayedTerms.Denotes a context head.1 head.2)
    (environment : context.Environment) (property : Value a sequence -> Prop)
    (accepted : property
      (ZFSetUniformListTraceProofBridge.beforeSection
        (firstMeaning environment) (secondMeaning environment)
        (ZFSetList.encodeValue (headValues heads environment)) PUnit.unit)) :
    let programs := nativeListPrograms first second (heads.map Prod.fst)
    semanticDiamond (reduction level n).closure
        (semanticObservation level environment property) programs.unfused /\
      semanticDiamond (reduction level n).closure
        (semanticObservation level environment property) programs.fused := by
  exact (recursiveMapFusionCospan level first second
    firstMeaning secondMeaning firstDenotes secondDenotes heads interpreted
      environment property accepted).semanticDiamonds

namespace Controls

open NativeHOLRecursiveProofOperationalObservation.Controls

/-- The noncommuting captured-functions workload inhabits the generic cospan
with the exact retained HOL proof. -/
noncomputable def capturedConstantCospan
    (level : LevelExpr Nat) {a : ZFSet.{u}}
    (older newer : Value a element) :
    let programs := nativeListPrograms constantOlder constantNewer [olderHead]
    ProofQualifiedReachabilityCospan (reduction level 2) IntrinsicProof
      RetainedMapFusionQualifies
      (semanticObservation level (twoElementEnvironment older newer)
        (fun output => output = ZFSetList.encodeValue [older]))
      programs.unfused programs.fused := by
  apply recursiveMapFusionCospan level constantOlder constantNewer
    constantOlderMeaning constantNewerMeaning
    (constantOlder_denotes a) (constantNewer_denotes a)
    olderSingletonHeads
  · intro head member
    simp only [olderSingletonHeads, List.mem_singleton] at member
    subst head
    exact olderHead_denotes a
  · rw [beforeSection_encodeValue]
    simp only [olderSingleton_headValues, List.map_cons, List.map_nil,
      constantOlderMeaning, constantNewerMeaning,
      ZFSetUniformListTraceTypeInterpretation.app_lam,
      twoElement_projection_zero, twoElement_projection_one]

/-- Projecting the generic cospan recovers both generated OSLF observations. -/
theorem capturedConstantCospan_observed (level : LevelExpr Nat)
    {a : ZFSet.{u}} (older newer : Value a element) :
    NoncommutingOperationalSquare level older newer := by
  exact (capturedConstantCospan level older newer).semanticDiamonds

/-- Equal operational observations do not authorize an unrelated proof
object.  This is the proof-versus-truth boundary at the cospan interface. -/
theorem observations_do_not_qualify_identityProof (level : LevelExpr Nat)
    {a : ZFSet.{u}} (older newer : Value a element) :
    NoncommutingOperationalSquare level older newer /\
      ¬ RetainedMapFusionQualifies identityProof
        (nativeListPrograms constantOlder constantNewer [olderHead]).unfused
        (nativeListPrograms constantOlder constantNewer [olderHead]).fused := by
  exact ⟨capturedConstantCospan_observed level older newer,
    identityProof_not_mapFusionQualified _⟩

/-- The strongest control reads all three independent components: retained
proof/compiler provenance, noncommuting function orientation, and the common
generated modal observation. -/
theorem capturedConstantCospan_retains_proof_and_orientation
    (level : LevelExpr Nat) {a : ZFSet.{u}}
    (older newer : Value a element) (different : older ≠ newer) :
    (capturedConstantCospan level older newer).evidence =
        retainedMapFusionProof /\
      HOLLeibnizNativeRecursiveExtensionalCompiler.compile
          retainedMapFusionProof.source Fin.elim0 Fin.elim0 =
        some HOLLeibnizMapFusionNative.nativeProof /\
      app (constantOlderMeaning (twoElementEnvironment older newer))
          (app (constantNewerMeaning (twoElementEnvironment older newer)) older) ≠
        app (constantNewerMeaning (twoElementEnvironment older newer))
          (app (constantOlderMeaning (twoElementEnvironment older newer)) older) /\
      NoncommutingOperationalSquare level older newer := by
  exact ⟨rfl, CompilerAgreement.recursive_compiler_emits_closed_map_fusion,
    captured_constants_do_not_commute older newer different,
    capturedConstantCospan_observed level older newer⟩

end Controls

