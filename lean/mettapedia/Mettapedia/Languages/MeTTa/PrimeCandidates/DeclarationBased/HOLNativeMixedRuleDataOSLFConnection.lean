import Mettapedia.Languages.MeTTa.PrimeCandidates.DeclarationBased.HOLNativeMixedRuleDataSoundness
import Mettapedia.OSLF.Framework.TypeSynthesis

/-!
# The mixed native rule presentation and its generated OSLF

The mixed HOL/native computation relation has both an intrinsic presentation
and executable `LanguageDef` rule data.  This module identifies the OSLF
generated from that rule data with the intrinsic computational component.

Universe-head equality remains a separate semantic service.  A finite rewrite
inventory cannot enumerate arbitrary equivalent universe expressions, so the
connection below proves that the generated operational relation is exactly
the computational component and records the head-equality boundary explicitly.
-/

open Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId
open Mettapedia.TypeTheory.UniverseLevel

set_option autoImplicit false

open Mettapedia.TypeTheory.Calculi.CumulativePiSigmaId

namespace Mettapedia.Languages.MeTTa.PrimeCandidates.DeclarationBased
namespace HOLNativeMixedRuleDataOSLFConnection

open Presentation
open Mettapedia.OSLF.MeTTaIL.Syntax
open HOLNativeMixedRuleData
open HOLNativeMixedOperationalDecomposition
open Mettapedia.OSLF.Framework.TypeSynthesis
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis

/-- The operational theory obtained mechanically from the executable mixed
rule presentation. -/
abbrev presentationTheory := langGSLT language

/-- The native type system generated from the same operational theory. -/
abbrev presentationOSLF := gsltOSLF presentationTheory

/-- The mixed rule presentation has no authored or collection-generated
equations.  Its OSLF equality is therefore syntactic equality of encoded
patterns; universe equality is deliberately supplied elsewhere. -/
theorem language_equation_free : language.isEquationFree = true := by
  decide

/-- A generated operational step on canonically encoded native terms is
exactly one intrinsic computational step. -/
theorem presentation_step_iff {n : Nat} (source target : Tower.Tm n) :
    presentationTheory.Step
        (compute (encoded source)) (encoded target) ↔
      ComputationalStep source target := by
  change langSemanticReduces language
      (compute (encoded source)) (encoded target) ↔ _
  rw [langSemanticReduces_iff_langReduces_of_equation_free
    language_equation_free]
  simpa [langReduces, langReducesUsing] using
    (contextualStep_encoded_iff source target)

/-- The exact-target native type generated by OSLF recognizes precisely the
same intrinsic computational step. -/
theorem satisfies_exact_target_iff {n : Nat} (source target : Tower.Tm n) :
    (gsltOSLF (langGSLT language)).satisfies
        (compute (encoded source))
        (exactTargetNativeType (langGSLT language)
          (encoded target)).pred ↔
      ComputationalStep source target := by
  erw [satisfies_exactTargetNativeType_iff_step]
  exact presentation_step_iff source target

/-- Native beta is a concrete positive control for the generated rule-data
OSLF, including substitution through the authored binding service. -/
theorem beta_satisfies_generated_oslf {n : Nat}
    (body : Tower.Tm (n + 1)) (argument : Tower.Tm n) :
    (gsltOSLF (langGSLT language)).satisfies
        (compute (encoded (.app (.lam body) argument)))
        (exactTargetNativeType (langGSLT language)
          (encoded (inst0 argument body))).pred := by
  rw [satisfies_exact_target_iff]
  exact .betaPi body argument

/-- Equivalent but syntactically distinct universe heads are accepted by the
native semantic equality service and rejected by the finite computational
presentation.  This is the intended boundary, not an incompleteness claim
about the rule interpreter. -/
theorem universe_head_equality_outside_presentation {n : Nat} :
    let left : Tower.Tm n := .head (.sort (.max (.param 0) (.param 0)))
    let right : Tower.Tm n := .head (.sort (.param 0))
    FullStep left right ∧
      ¬ presentationTheory.Step
        (compute (encoded left)) (encoded right) := by
  dsimp
  obtain ⟨full, notComputational⟩ :=
    distinct_level_spelling_control (n := n)
  exact ⟨full, fun presented =>
    notComputational ((presentation_step_iff _ _).mp presented)⟩

#print axioms language_equation_free
#print axioms presentation_step_iff
#print axioms satisfies_exact_target_iff
#print axioms beta_satisfies_generated_oslf
#print axioms universe_head_equality_outside_presentation

end HOLNativeMixedRuleDataOSLFConnection
end Mettapedia.Languages.MeTTa.PrimeCandidates.DeclarationBased
