/-- **A constructor applied to elements of its field types** is its constructor element. -/
theorem appSpine_ctorConstI (k : DeclName) (shapes : List FieldShape) {αs : List Ideal}
    (hlen : αs.length = shapes.length)
    (spine : SpineTyped (arrowsI (shapes.map (FieldShape.typeI d.type (dataParams d)))
      (dataTypeI d)) αs) :
    Ideal.appSpine (ctorConstI d k shapes) αs = ctorI (Kind.ctor d.type k shapes) αs := by
  unfold ctorConstI
  rw [Ideal.appSpine_projT _ (churchTele_arrowsI _ _) (by simp only [hlen, List.length_map,
      Std.le_refl]),
    Ideal.projArgs_of_spineTyped spine, instPi_arrowsI _ _ _ (by simp only [hlen, List.length_map]),
    appSpine_curryI (fun pre post => cont_ctorI_at _ pre post) _ _ _ hlen, List.reverse_nil,
    List.nil_append]
  refine Ideal.projT_data_ctorI fun i x hx => ?_
  have hi : i < shapes.length := by
    rw [← hlen]
    rcases Nat.lt_or_ge i αs.length with hlt | hge
    · exact hlt
    · rw [List.getElem?_eq_none hge] at hx; cases hx
  refine ⟨shapes[i], List.getElem?_eq_getElem hi, ?_⟩
  exact spineTyped_arrowsI _ _ _ spine (by simp only [hlen, List.length_map,
      Std.le_refl]) i x _ hx (by simp only [List.length_map, hi, getElem?_pos, List.getElem_map])

