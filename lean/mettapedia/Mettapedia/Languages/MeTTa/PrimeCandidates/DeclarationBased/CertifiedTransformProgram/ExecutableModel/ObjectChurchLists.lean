/-! ## Spine facts at the values of a substitution, and under another reading -/

section Transfer

variable {Head : Type} {R R' : Rules Head}

/-- **Spine facts of a substituted term are spine facts of the term** in the environment of the
values of the substitution. -/
theorem SpineFacts.of_subst {Rd : Reading Head} {P : ChurchRules R} :
    ∀ {n m : Nat} (t : CTm Head n) (σ : CSub Head n m) {τ : Ideal} {ρ : Env m},
      SpineFacts Rd P (t.subst σ) τ ρ → SpineFacts Rd P t τ fun i => cinterp Rd (σ i) ρ
  | _, _, .var _, _, _, _, _ => trivial
  | _, _, .const _, _, _, _, h => h
  | _, _, .head _, _, _, _, _ => trivial
  | _, _, .pi _ _, _, _, _, _ => trivial
  | _, _, .sigma _ _, _, _, _, _ => trivial
  | _, _, .id _ _ _, _, _, _, _ => trivial
  | _, _, .lam _ _, _, _, _, _ => trivial
  | _, _, .pair _ _, _, _, _, _ => trivial
  | _, _, .fst _, _, _, _, _ => trivial
  | _, _, .snd _, _, _, _, _ => trivial
  | _, _, .app f a, σ, _, ρ, h => by
      obtain ⟨T, G, hG, e, ⟨hf, sf⟩, ⟨ha, sa⟩⟩ := spineFacts_app.1 h
      rw [cinterp_subst] at e hf ha
      exact spineFacts_app.2 ⟨T, G, hG, e, ⟨hf, SpineFacts.of_subst f σ sf⟩,
        ⟨ha, SpineFacts.of_subst a σ sa⟩⟩
  | _, _, .refl a, σ, _, ρ, h => by
      obtain ⟨T, e, ha, sa⟩ := spineFacts_refl.1 h
      rw [cinterp_subst] at e ha
      exact spineFacts_refl.2 ⟨T, e, ha, SpineFacts.of_subst a σ sa⟩

/-- **Spine facts carry over to another reading and another package** that agree on the
constants of the term: the readings give them the same values, and each declared type the
second package gives them is one the first gives them, read alike by both readings. -/
theorem SpineFacts.congr {Rd Rd' : Reading Head} {P : ChurchRules R} {P' : ChurchRules R'}
    (heads : Rd.head = Rd'.head) :
    ∀ {n : Nat} (t : CTm Head n), (∀ c ∈ termConsts t, Rd.const c = Rd'.const c) →
      (∀ c ∈ termConsts t, ∀ D, P'.constantType c = some D →
        P.constantType c = some D ∧ cinterp Rd D Env.nil = cinterp Rd' D Env.nil) →
      ∀ {τ : Ideal} {ρ : Env n}, SpineFacts Rd P t τ ρ → SpineFacts Rd' P' t τ ρ
  | _, .var _, _, _, _, _, _ => trivial
  | _, .head _, _, _, _, _, _ => trivial
  | _, .pi _ _, _, _, _, _, _ => trivial
  | _, .sigma _ _, _, _, _, _, _ => trivial
  | _, .id _ _ _, _, _, _, _, _ => trivial
  | _, .lam _ _, _, _, _, _, _ => trivial
  | _, .pair _ _, _, _, _, _, _ => trivial
  | _, .fst _, _, _, _, _, _ => trivial
  | _, .snd _, _, _, _, _, _ => trivial
  | _, .const c, _, decl, _, _, h => fun D hD => by
      obtain ⟨hD', e⟩ := decl c List.mem_cons_self D hD
      rw [h D hD', e]
  | _, .app f a, agree, decl, _, ρ, h => by
      have agreeF : ∀ c ∈ termConsts f, Rd.const c = Rd'.const c :=
        fun c hc => agree c (List.mem_append_left _ hc)
      have agreeA : ∀ c ∈ termConsts a, Rd.const c = Rd'.const c :=
        fun c hc => agree c (List.mem_append_right _ hc)
      obtain ⟨T, G, hG, e, ⟨hf, sf⟩, ⟨ha, sa⟩⟩ := spineFacts_app.1 h
      rw [cinterp_congr heads f agreeF] at hf
      rw [cinterp_congr heads a agreeA] at e ha
      exact spineFacts_app.2 ⟨T, G, hG, e,
        ⟨hf, SpineFacts.congr heads f agreeF
          (fun c hc => decl c (List.mem_append_left _ hc)) sf⟩,
        ⟨ha, SpineFacts.congr heads a agreeA
          (fun c hc => decl c (List.mem_append_right _ hc)) sa⟩⟩
  | _, .refl a, agree, decl, _, ρ, h => by
      obtain ⟨T, e, ha, sa⟩ := spineFacts_refl.1 h
      rw [cinterp_congr heads a agree] at e ha
      exact spineFacts_refl.2 ⟨T, e, ha, SpineFacts.congr heads a agree decl sa⟩

end Transfer

namespace CodeModel


/-! ## Lists with one entry changed -/

theorem getElem?_append_cons_self {α : Type} (pre post : List α) (x : α) :
    (pre ++ x :: post)[pre.length]? = some x := by
  simp only [List.length_append, List.length_cons, Nat.lt_add_right_iff_pos, Nat.lt_add_one_iff,
      zero_le, getElem?_pos, Std.le_refl, List.getElem_append_right, tsub_self,
      List.getElem_cons_zero]

theorem getElem?_append_cons_ne {α : Type} (pre post : List α) (x y : α) {i : Nat}
    (h : i ≠ pre.length) : (pre ++ x :: post)[i]? = (pre ++ y :: post)[i]? := by
  rcases Nat.lt_or_gt_of_ne h with h | h
  · rw [List.getElem?_append_left h, List.getElem?_append_left h]
  · rw [List.getElem?_append_right h.le, List.getElem?_append_right h.le]
    obtain ⟨j, hj⟩ : ∃ j, i - pre.length = j + 1 := ⟨i - pre.length - 1, by omega⟩
    rw [hj]
    rfl

/-- An entry of a list with one entry varying is continuous in it. -/
theorem cont_getD_at (pre post : List Ideal) (j : Nat) :
    Ideal.Cont fun x => (pre ++ x :: post).getD j Ideal.bot := by
  by_cases h : j = pre.length
  · subst h
    simp only [List.getD_eq_getElem?_getD, getElem?_append_cons_self, Option.getD_some]
    exact Ideal.Cont.id
  · have e : ∀ x,
        (pre ++ x :: post).getD j Ideal.bot = (pre ++ Ideal.bot :: post).getD j Ideal.bot :=
      fun x => by
        simp only [List.getD_eq_getElem?_getD]
        rw [getElem?_append_cons_ne pre post x Ideal.bot h]
    simp only [e]
    exact Ideal.Cont.const _

/-! ## Constructor elements are continuous in each field -/

/-- **The constructor element is continuous in each field.** -/
theorem cont_ctorI_at (k : Kind) (pre post : List Ideal) :
    Ideal.Cont fun x => ctorI k (pre ++ x :: post) := by
  unfold Ideal.ctorI
  exact Ideal.Cont.of_closure
    (P := fun x t => t = .tag k ∨
      ∃ i f s, (pre ++ x :: post)[i]? = some f ∧ f.Mem s ∧ t = .arg k i [] s)
    (fun {x x'} h t ht => by
      rcases ht with rfl | ⟨i, f, s, hf, hs, rfl⟩
      · exact .inl rfl
      · by_cases hi : i = pre.length
        · subst hi
          rw [getElem?_append_cons_self] at hf
          cases hf
          exact .inr ⟨pre.length, x', s, getElem?_append_cons_self pre post x', h s hs, rfl⟩
        · exact .inr ⟨i, f, s, by rw [getElem?_append_cons_ne pre post x' x hi]; exact hf, hs,
            rfl⟩)
    fun {x t} ht => by
      rcases ht with rfl | ⟨i, f, s, hf, hs, rfl⟩
      · exact ⟨[], fun _ h => absurd h List.not_mem_nil, .inl rfl⟩
      · by_cases hi : i = pre.length
        · subst hi
          rw [getElem?_append_cons_self] at hf
          cases hf
          exact ⟨[s], fun r hr => by rw [List.mem_singleton.1 hr]; exact hs,
            .inr ⟨pre.length, principal [s], s, getElem?_append_cons_self pre post _,
              ent_of_mem List.mem_cons_self, rfl⟩⟩
        · exact ⟨[], fun _ h => absurd h List.not_mem_nil,
            .inr ⟨i, f, s, by rw [getElem?_append_cons_ne pre post _ x hi]; exact hf, hs, rfl⟩⟩

/-! ## Curried functions of finitely many arguments -/

/-- **A function of `n` more arguments**, after the arguments `acc` (the latest first): at all
of them it is `H` of the arguments in order. -/
def curryI (H : List Ideal → Ideal) : Nat → List Ideal → Ideal
  | 0, acc => H acc.reverse
  | n + 1, acc => Ideal.lam fun X => curryI H n (principal X :: acc)

/-- A map of lists continuous in each entry. -/
def ContEach (H : List Ideal → Ideal) : Prop :=
  ∀ pre post : List Ideal, Ideal.Cont fun x => H (pre ++ x :: post)

theorem ContList.contEach {H : List Ideal → Ideal} (hH : Ideal.ContList H) : ContEach H := by
  intro pre post
  have h := hH.comp_list (Fs := pre.map (fun p _ => p) ++ (fun x => x) :: post.map (fun p _ => p))
    (fun F hF => by
      rcases List.mem_append.1 hF with hF | hF
      · obtain ⟨p, -, rfl⟩ := List.mem_map.1 hF
        exact Ideal.Cont.const p
      · rcases List.mem_cons.1 hF with rfl | hF
        · exact Ideal.Cont.id
        · obtain ⟨p, -, rfl⟩ := List.mem_map.1 hF
          exact Ideal.Cont.const p)
  simpa only [List.map_append, List.map_map, Function.comp_def, List.map_id_fun', id_eq,
      List.map_cons] using h

theorem cont_curryI {H : List Ideal → Ideal} (hH : ContEach H) :
    ∀ (n : Nat) (acc₁ acc₂ : List Ideal), Ideal.Cont fun x => curryI H n (acc₁ ++ x :: acc₂)
  | 0, acc₁, acc₂ => by
      have e : ∀ x : Ideal, (acc₁ ++ x :: acc₂).reverse = acc₂.reverse ++ x :: acc₁.reverse :=
        fun x => by simp only [List.reverse_append, List.reverse_cons, List.append_assoc,
            List.cons_append, List.nil_append]
      simp only [curryI, e]
      exact hH _ _
  | n + 1, acc₁, acc₂ =>
      Ideal.cont_lam_param fun X => cont_curryI hH n (principal X :: acc₁) acc₂

/-- **A curried function applied to all its arguments** is `H` of them. -/
theorem appSpine_curryI {H : List Ideal → Ideal} (hH : ContEach H) :
    ∀ (n : Nat) (acc args : List Ideal), args.length = n →
      Ideal.appSpine (curryI H n acc) args = H (acc.reverse ++ args)
  | 0, acc, [], _ => by simp only [Ideal.appSpine, curryI, List.append_nil]
  | n + 1, acc, a :: args, hlen => by
      show Ideal.appSpine
          (Ideal.app (Ideal.lam fun X => curryI H n (principal X :: acc)) a) args = _
      rw [Ideal.app_lam_principal (H := fun x => curryI H n (x :: acc)) (cont_curryI hH n [] acc) a,
        appSpine_curryI hH n (a :: acc) args (by simpa only [List.length_cons,
            Nat.add_right_cancel_iff] using hlen)]
      simp only [List.reverse_cons, List.append_assoc, List.cons_append, List.nil_append]

/-! ## Spines of arguments, continuous in a list -/

theorem contList_appSpine {F : List Ideal → Ideal} (hF : Ideal.ContList F) :
    ∀ (gs : List (List Ideal → Ideal)), (∀ g ∈ gs, Ideal.ContList g) →
      Ideal.ContList fun zs => Ideal.appSpine (F zs) (gs.map (· zs))
  | [], _ => hF
  | g :: gs, hg =>
      contList_appSpine (Ideal.ContList.comp₂ Ideal.cont₂_app hF (hg g List.mem_cons_self)) gs
        fun g' h => hg g' (List.mem_cons_of_mem _ h)

theorem cont_appSpine {F : Ideal → Ideal} (hF : Ideal.Cont F) :
    ∀ (gs : List (Ideal → Ideal)), (∀ g ∈ gs, Ideal.Cont g) →
      Ideal.Cont fun w => Ideal.appSpine (F w) (gs.map (· w))
  | [], _ => hF
  | g :: gs, hg =>
      cont_appSpine (Ideal.cont₂_app.comp hF (hg g List.mem_cons_self)) gs
        fun g' h => hg g' (List.mem_cons_of_mem _ h)

/-! ## The value of a method -/

/-- The hypotheses of the recursive fields `xs` at their recursive values `rs`, over the motive
`π`: each value read at the motive at its field. -/
def hypsI (π : Ideal) : List Ideal → List Ideal → List Ideal
  | x :: xs, r :: rs => projT (Ideal.app π x) r :: hypsI π xs rs
  | _, _ => []

theorem hypsI_map (π : Ideal) (r : Ideal → Ideal) :
    ∀ xs : List Ideal, hypsI π xs (xs.map r) = xs.map fun x => projT (Ideal.app π x) (r x)
  | [] => rfl
  | x :: xs => by rw [List.map_cons, hypsI, hypsI_map π r xs, List.map_cons]

/-- The hypotheses of a method as functions of the motive and of the fields followed by the
recursive values: for each recursive flag, the field at position `p` and its value at `q`. -/
def hypFns : List Bool → Nat → Nat → List (Ideal → List Ideal → Ideal)
  | [], _, _ => []
  | true :: bs, p, q =>
      (fun π zs => projT (Ideal.app π (zs.getD p Ideal.bot)) (zs.getD q Ideal.bot)) ::
        hypFns bs (p + 1) (q + 1)
  | false :: bs, p, q => hypFns bs (p + 1) q

/-- **The arguments of a method** of a constructor with the recursive flags `bs`, as functions
of the motive and of the fields followed by the recursive values: the fields, then the
hypotheses of the recursive fields. -/
def caseFns (bs : List Bool) : List (Ideal → List Ideal → Ideal) :=
  (List.range bs.length).map (fun i _ zs => zs.getD i Ideal.bot) ++ hypFns bs 0 bs.length

/-- **The value of a method** `μ` over the motive `π`, at the fields followed by the recursive
values: `μ` applied to the fields and to the hypotheses. -/
def caseValue (π μ : Ideal) (bs : List Bool) (zs : List Ideal) : Ideal :=
  Ideal.appSpine μ ((caseFns bs).map fun g => g π zs)

theorem hypFns_cases {g : Ideal → List Ideal → Ideal} (bs : List Bool) :
    ∀ {p q : Nat}, g ∈ hypFns bs p q →
      ∃ p' q', g = fun π zs =>
        projT (Ideal.app π (zs.getD p' Ideal.bot)) (zs.getD q' Ideal.bot) := by
  induction bs with
  | nil => intro _ _ h; exact absurd h List.not_mem_nil
  | cons b bs ih =>
      intro p q h
      cases b with
      | true =>
          rcases List.mem_cons.1 h with rfl | h
          · exact ⟨_, _, rfl⟩
          · exact ih h
      | false => exact ih h

theorem caseFns_cases {bs : List Bool} {g : Ideal → List Ideal → Ideal} (h : g ∈ caseFns bs) :
    (∃ i, g = fun _ zs => zs.getD i Ideal.bot) ∨
      ∃ p q, g = fun π zs => projT (Ideal.app π (zs.getD p Ideal.bot)) (zs.getD q Ideal.bot) := by
  rcases List.mem_append.1 h with h | h
  · obtain ⟨i, -, rfl⟩ := List.mem_map.1 h
    exact .inl ⟨i, rfl⟩
  · exact .inr (hypFns_cases bs h)

theorem contList_caseValue (π μ : Ideal) (bs : List Bool) : Ideal.ContList (caseValue π μ bs) := by
  have h := contList_appSpine (Ideal.ContList.const μ) ((caseFns bs).map fun g zs => g π zs)
    fun g' hg' => by
      obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hg'
      rcases caseFns_cases hg with ⟨i, rfl⟩ | ⟨p, q, rfl⟩
      · exact Ideal.ContList.getD i
      · exact Ideal.ContList.comp₂ Ideal.cont₂_projT
          (Ideal.ContList.comp (Ideal.cont₂_app.right π) (Ideal.ContList.getD p))
          (Ideal.ContList.getD q)
  simp only [List.map_map, Function.comp_def] at h
  exact h

theorem cont_caseValue_motive (μ : Ideal) (bs : List Bool) (zs : List Ideal) :
    Ideal.Cont fun π => caseValue π μ bs zs := by
  have h := cont_appSpine (Ideal.Cont.const μ) ((caseFns bs).map fun g π => g π zs)
    fun g' hg' => by
      obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hg'
      rcases caseFns_cases hg with ⟨i, rfl⟩ | ⟨p, q, rfl⟩
      · exact Ideal.Cont.const _
      · exact (Ideal.cont₂_projT.left _).comp (Ideal.cont₂_app.left _)
  simp only [List.map_map, Function.comp_def] at h
  exact h

theorem cont_caseValue_method (π : Ideal) (bs : List Bool) (zs : List Ideal) :
    Ideal.Cont fun μ => caseValue π μ bs zs := by
  have h := cont_appSpine Ideal.Cont.id (((caseFns bs).map fun g => g π zs).map fun a _ => a)
    fun g' hg' => by
      obtain ⟨a, -, rfl⟩ := List.mem_map.1 hg'
      exact Ideal.Cont.const a
  simp only [List.map_map, Function.comp_def] at h
  exact h

/-- The hypotheses at a list whose entries from `p` are the fields and from `q` the recursive
values. -/
theorem hypFns_eval (π : Ideal) (zs : List Ideal) :
    ∀ (bs : List Bool) (p q : Nat) (xs rs : List Ideal), xs.length = bs.length →
      rs.length = (Ideal.recFields bs xs).length →
      (∀ i, i < bs.length → zs.getD (p + i) Ideal.bot = xs.getD i Ideal.bot) →
      (∀ j, j < rs.length → zs.getD (q + j) Ideal.bot = rs.getD j Ideal.bot) →
      (hypFns bs p q).map (fun g => g π zs) = hypsI π (Ideal.recFields bs xs) rs
  | [], _, _, _, _, _, _, _, _ => by simp only [hypFns, List.map_nil, Ideal.recFields, hypsI]
  | true :: bs, p, q, x :: xs, rs, hx, hr, hxs, hrs => by
      obtain ⟨r, rs, rfl⟩ : ∃ r rs', rs = r :: rs' := by
        cases rs with
        | nil =>
            simp only [List.length_nil, Ideal.recFields, List.length_cons] at hr
            exact absurd hr (by omega)
        | cons r rs => exact ⟨r, rs, rfl⟩
      have h0 := hxs 0 (by simp only [List.length_cons, Nat.lt_add_one_iff, zero_le])
      have h0' := hrs 0 (by simp only [List.length_cons, Nat.lt_add_one_iff, zero_le])
      simp only [Nat.add_zero, List.getD_cons_zero] at h0 h0'
      simp only [hypFns, List.map_cons, Ideal.recFields, hypsI, h0, h0']
      congr 1
      exact hypFns_eval π zs bs (p + 1) (q + 1) xs rs (by simpa only [List.length_cons,
          Nat.add_right_cancel_iff] using hx)
        (by simpa only [List.length_cons, Ideal.recFields, Nat.add_right_cancel_iff] using hr)
        (fun i hi => by
          have := hxs (i + 1) (by simpa only [List.length_cons, Nat.lt_add_one_iff,
              Nat.add_one_le_iff] using hi)
          rwa [show p + (i + 1) = p + 1 + i by omega, List.getD_cons_succ] at this)
        (fun j hj => by
          have := hrs (j + 1) (by simpa only [List.length_cons, Nat.lt_add_one_iff,
              Nat.add_one_le_iff] using hj)
          rwa [show q + (j + 1) = q + 1 + j by omega, List.getD_cons_succ] at this)
  | false :: bs, p, q, x :: xs, rs, hx, hr, hxs, hrs => by
      simp only [hypFns, Ideal.recFields]
      exact hypFns_eval π zs bs (p + 1) q xs rs (by simpa only [List.length_cons,
          Nat.add_right_cancel_iff] using hx) (by simpa only [Ideal.recFields] using hr)
        (fun i hi => by
          have := hxs (i + 1) (by simpa only [List.length_cons, Nat.lt_add_one_iff,
              Nat.add_one_le_iff] using hi)
          rwa [show p + (i + 1) = p + 1 + i by omega, List.getD_cons_succ] at this)
        hrs
  | _ :: _, _, _, [], _, hx, _, _, _ => by
      simp only [List.length_nil, List.length_cons] at hx
      exact absurd hx (by omega)

/-- **The value of a method at the fields and the recursive values** is the method applied to
the fields and to the recursive values, each read at the motive at its field. -/
theorem caseValue_eval (π μ : Ideal) (bs : List Bool) {xs : List Ideal}
    (hx : xs.length = bs.length) (r : Ideal → Ideal) :
    caseValue π μ bs (xs ++ (Ideal.recFields bs xs).map r) =
      Ideal.appSpine μ
        (xs ++ (Ideal.recFields bs xs).map fun x => projT (Ideal.app π x) (r x)) := by
  unfold caseValue caseFns
  rw [List.map_append, List.map_map]
  congr 1
  congr 1
  · apply List.ext_getElem (by simp only [List.getD_eq_getElem?_getD, List.length_map,
      List.length_range, hx])
    intro i h₁ h₂
    simp only [List.getElem_map, List.getElem_range, Function.comp_apply]
    rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by omega),
      List.getElem?_eq_getElem h₂, Option.getD_some]
  · rw [hypFns_eval π _ bs 0 bs.length xs ((Ideal.recFields bs xs).map r) hx
      (by simp only [List.length_map])
      (fun i hi => by
        rw [Nat.zero_add, List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
          List.getElem?_append_left (by omega)])
      (fun j hj => by
        rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, ← hx,
          List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]),
      hypsI_map]

/-! ## The methods of a recursion -/

/-- **The methods of a recursion** over the constructors `cs`, with the motive `π` and one
method for each constructor: at a constructor, the value of its method. -/
def methodsAt (π : Ideal) : List (Kind × List Bool) → List Ideal → Ideal.Methods Kind
  | [], _ => fun _ _ => Ideal.bot
  | c :: cs, μs => fun k zs =>
      if k = c.1 then caseValue π (μs.headD Ideal.bot) c.2 zs else methodsAt π cs μs.tail k zs

theorem contList_methodsAt (π : Ideal) :
    ∀ (cs : List (Kind × List Bool)) (μs : List Ideal) (k : Kind),
      Ideal.ContList (methodsAt π cs μs k)
  | [], _, _ => Ideal.ContList.const _
  | c :: cs, μs, k => by
      by_cases h : k = c.1
      · simp only [methodsAt, if_pos h]
        exact contList_caseValue _ _ _
      · simp only [methodsAt, if_neg h]
        exact contList_methodsAt π cs μs.tail k

theorem cont_methodsAt_motive :
    ∀ (cs : List (Kind × List Bool)) (μs : List Ideal) (k : Kind) (zs : List Ideal),
      Ideal.Cont fun π => methodsAt π cs μs k zs
  | [], _, _, _ => Ideal.Cont.const _
  | c :: cs, μs, k, zs => by
      by_cases h : k = c.1
      · simp only [methodsAt, if_pos h]
        exact cont_caseValue_motive _ _ _
      · simp only [methodsAt, if_neg h]
        exact cont_methodsAt_motive cs μs.tail k zs

theorem cont_methodsAt_method (π : Ideal) :
    ∀ (cs : List (Kind × List Bool)) (pre post : List Ideal) (k : Kind) (zs : List Ideal),
      Ideal.Cont fun x => methodsAt π cs (pre ++ x :: post) k zs
  | [], _, _, _, _ => Ideal.Cont.const _
  | c :: cs, pre, post, k, zs => by
      by_cases h : k = c.1
      · simp only [methodsAt, if_pos h]
        cases pre with
        | nil => exact cont_caseValue_method π c.2 zs
        | cons p pre =>
            simp only [List.cons_append, List.headD_cons]
            exact Ideal.Cont.const _
      · simp only [methodsAt, if_neg h]
        cases pre with
        | nil =>
            simp only [List.nil_append, List.tail_cons]
            exact Ideal.Cont.const _
        | cons p pre =>
            simp only [List.cons_append, List.tail_cons]
            exact cont_methodsAt_method π cs pre post k zs

/-- **At a listed constructor the methods are its method.** -/
theorem methodsAt_getElem (π : Ideal) :
    ∀ {cs : List (Kind × List Bool)} (μs : List Ideal) {i : Nat} {k : Kind} {bs : List Bool},
      (cs.map Prod.fst).Nodup → cs[i]? = some (k, bs) →
        methodsAt π cs μs k = caseValue π (μs.getD i Ideal.bot) bs
  | [], _, _, _, _, _, h => nomatch h
  | c :: cs, μs, 0, k, bs, _, h => by
      cases h
      funext zs
      simp only [methodsAt]
      cases μs <;> rfl
  | c :: cs, μs, i + 1, k, bs, nodup, h => by
      rw [List.map_cons, List.nodup_cons] at nodup
      have hk : k ≠ c.1 := fun e => nodup.1 (e ▸ List.mem_map.2 ⟨(k, bs), List.mem_of_getElem? h,
          rfl⟩)
      funext zs
      simp only [methodsAt, if_neg hk]
      rw [methodsAt_getElem π μs.tail nodup.2 h]
      cases μs <;> rfl

/-! ## The recursion as a function of its arguments -/

/-- **Recursion over the constructors `cs`, as a function of its arguments**: the motive, a
method for each constructor, and the element. -/
def recH (cs : List (Kind × List Bool)) (args : List Ideal) : Ideal :=
  recI cs (methodsAt (args.headD Ideal.bot) cs args.tail) (args.getD (cs.length + 1) Ideal.bot)

theorem contEach_recH (cs : List (Kind × List Bool)) : ContEach (recH cs) := by
  intro pre post
  have hM : ∀ w k, Ideal.ContList (methodsAt ((pre ++ w :: post).headD Ideal.bot) cs
      (pre ++ w :: post).tail k) := fun w k => contList_methodsAt _ cs _ k
  have hMw : ∀ k zs, Ideal.Cont fun w => methodsAt ((pre ++ w :: post).headD Ideal.bot) cs
      (pre ++ w :: post).tail k zs := by
    intro k zs
    cases pre with
    | nil => exact cont_methodsAt_motive cs post k zs
    | cons p pre => exact cont_methodsAt_method p cs pre post k zs
  have h₂ : Ideal.Cont₂ fun w ν => recI cs (methodsAt ((pre ++ w :: post).headD Ideal.bot) cs
      (pre ++ w :: post).tail) ν :=
    ⟨fun ν => Ideal.cont_recI_param hM hMw ν, fun w => Ideal.cont_recI (hM w)⟩
  exact h₂.comp Ideal.Cont.id (cont_getD_at pre post _)

/-! ## Nondependent function types in the domain -/

/-- **Nondependent function types** `A₁ → ⋯ → Aₙ → B`. -/
def arrowsI : List Ideal → Ideal → Ideal
  | [], B => B
  | A :: As, B => cpi A fun _ => arrowsI As B

theorem churchTele_arrowsI (B : Ideal) :
    ∀ As : List Ideal, Ideal.ChurchTele As.length (arrowsI As B)
  | [] => trivial
  | A :: As => ⟨A, fun _ => arrowsI As B, Ideal.Cont.const _, rfl, fun _ => churchTele_arrowsI B As⟩

theorem arrowsI_append (A B : Ideal) :
    ∀ As : List Ideal, arrowsI (As ++ [A]) B = arrowsI As (cpi A fun _ => B)
  | [] => rfl
  | A' :: As => by
      show (cpi A' fun _ => arrowsI (As ++ [A]) B) = cpi A' fun _ => arrowsI As (cpi A fun _ => B)
      rw [arrowsI_append A B As]

/-- At as many arguments as arrows, the instantiated type is the result type. -/
theorem instPi_arrowsI (B : Ideal) :
    ∀ (As args : List Ideal), args.length = As.length → instPi (arrowsI As B) args = B
  | [], [], _ => rfl
  | A :: As, a :: args, h => by
      show instPi (Ideal.fam .pi (cpi A fun _ => arrowsI As B)
        (projT (Ideal.dom .pi (cpi A fun _ => arrowsI As B)) a)) args = B
      rw [Ideal.dom_cpi, Ideal.fam_cpi (Ideal.Cont.const _)]
      exact instPi_arrowsI B As args (by simpa only [List.length_cons,
          Nat.add_right_cancel_iff] using h)
  | [], _ :: _, h => by simp only [List.length_cons, List.length_nil, Nat.add_eq_zero_iff,
      List.length_eq_zero_iff, one_ne_zero, and_false] at h
  | _ :: _, [], h => by
      simp only [List.length_nil, List.length_cons] at h
      exact absurd h (by omega)

/-- Spine facts at nondependent function types: each argument is an element of its arrow. -/
theorem spineTyped_arrowsI (B : Ideal) :
    ∀ (As args : List Ideal), SpineTyped (arrowsI As B) args → args.length ≤ As.length →
      ∀ (i : Nat) (a A : Ideal), args[i]? = some a → As[i]? = some A → projT A a = a
  | [], [], _, _, _, _, _, h, _ => nomatch h
  | [], _ :: _, _, hl, _, _, _, _, _ => by simp only [List.length_cons, List.length_nil,
      nonpos_iff_eq_zero, Nat.add_eq_zero_iff, List.length_eq_zero_iff, one_ne_zero,
      and_false] at hl
  | _ :: _, [], _, _, _, _, _, h, _ => nomatch h
  | A :: As, a :: args, ⟨ha, hs⟩, hl, i, x, X, hx, hX => by
      change projT (Ideal.dom .pi (cpi A fun _ => arrowsI As B)) a = a at ha
      change SpineTyped (Ideal.fam .pi (cpi A fun _ => arrowsI As B)
        (projT (Ideal.dom .pi (cpi A fun _ => arrowsI As B)) a)) args at hs
      rw [Ideal.dom_cpi] at ha hs
      rw [Ideal.fam_cpi (Ideal.Cont.const _)] at hs
      cases i with
      | zero =>
          cases hx
          cases hX
          exact ha
      | succ i => exact spineTyped_arrowsI B As args hs (by simpa only [List.length_cons,
          Nat.add_le_add_iff_right] using hl) i x X hx hX

/-! ## Telescopes of declared types -/

theorem liftTm_closeType : ∀ {k : Nat} (Θ : Ctx Tower.Head k) (C : Tm Tower.Head k),
    liftTm (TelescopeAbstraction.closeType Θ C) = pisCtx (liftCtx Θ) (liftTm C)
  | _, .nil, _ => rfl
  | _, .snoc Θ A, C => liftTm_closeType Θ (.pi A C)

/-- **A telescope of closed entries denotes nondependent function types.** -/
theorem cinterp_closeType_closed (Rd : Reading Tower.Head) (F : Nat → Tm Tower.Head 0) :
    ∀ (N : Nat) (C : Tm Tower.Head N) (K : Ideal), (∀ ρ, cinterp Rd (liftTm C) ρ = K) →
      cinterp Rd (liftTm (TelescopeAbstraction.closeType
          (ofEntries (fun j => Presentation.liftClosed (F j)) N) C)) Env.nil =
        arrowsI ((List.range N).map fun j => cinterp Rd (liftTm (F j)) Env.nil) K
  | 0, C, K, hC => hC Env.nil
  | N + 1, C, K, hC => by
      rw [closeType_ofEntries_succ]
      rw [cinterp_closeType_closed Rd F N (.pi (Presentation.liftClosed (F N)) C)
        (cpi (cinterp Rd (liftTm (F N)) Env.nil) fun _ => K) fun ρ => by
          show cpi (cinterp Rd (liftTm (Presentation.liftClosed (F N))) ρ)
            (fun y => cinterp Rd (liftTm C) (Env.cons y ρ)) = _
          rw [liftTm_liftClosed, cinterp_liftClosed]
          simp only [hC]]
      rw [List.range_succ, List.map_append, List.map_singleton, arrowsI_append]

/-- The projected arguments of a telescope given by its entries: each argument projected onto
its entry, read at the projected arguments before it. -/
theorem projArgs_cinterp_ofEntries (Rd : Reading Tower.Head) (e : (j : Nat) → Tm Tower.Head j) :
    ∀ (N : Nat) (C : Tm Tower.Head N) (args : List Ideal), args.length = N →
      ∀ j, j < N →
        (projArgs (cinterp Rd (liftTm (TelescopeAbstraction.closeType (ofEntries e N) C)) Env.nil)
            args)[j]? =
          some (projT (cinterp Rd (liftTm (e j)) (Env.ofArgs j
            ((projArgs (cinterp Rd (liftTm (TelescopeAbstraction.closeType (ofEntries e N) C))
              Env.nil) args).take j))) (args.getD j Ideal.bot))
  | 0, _, _, _, _, hj => absurd hj (Nat.not_lt_zero _)
  | N + 1, C, args, hlen, j, hj => by
      rcases List.eq_nil_or_concat args with rfl | ⟨xs, a, rfl⟩
      · exact absurd hlen (by simp only [List.length_nil]; omega)
      rw [List.concat_eq_append] at hlen ⊢
      have hxs : xs.length = N := by simpa only [List.length_append, List.length_cons,
          List.length_nil, zero_add, Nat.add_right_cancel_iff] using hlen
      rw [closeType_ofEntries_succ]
      have hT := liftTm_closeType (ofEntries e N) (.pi (e N) C)
      have inst := instPi_cinterp_pisCtx Rd (liftCtx (ofEntries e N)) (liftTm (.pi (e N) C)) xs hxs
      rw [← hT] at inst
      rw [projArgs_append, inst]
      have hlenP : (projArgs (cinterp Rd (liftTm (TelescopeAbstraction.closeType (ofEntries e N)
          (.pi (e N) C))) Env.nil) xs).length = N := by rw [length_projArgs, hxs]
      rcases Nat.lt_or_ge j N with hjN | hjN
      · rw [List.getElem?_append_left (by omega),
          projArgs_cinterp_ofEntries Rd e N (.pi (e N) C) xs hxs j hjN,
          List.take_append_of_le_length (by omega)]
        congr 2
        rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
          List.getElem?_append_left (by omega)]
      · obtain rfl : j = N := by omega
        rw [List.getElem?_append_right (by omega), hlenP, Nat.sub_self,
          List.take_append_of_le_length (by omega), List.take_of_length_le (by omega)]
        show some (projT (Ideal.dom .pi (cinterp Rd (.pi (liftTm (e j)) (liftTm C))
          (Env.ofArgs j _))) a) = _
        rw [dom_cinterp_pi, List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega),
          hxs, Nat.sub_self]
        rfl

/-- **A spine with spine facts at a telescope given by its entries**: each argument is an
element of its entry, read at the arguments before it. -/
theorem spineTyped_ofEntries (Rd : Reading Tower.Head) (e : (j : Nat) → Tm Tower.Head j)
    (N : Nat) (C : Tm Tower.Head N) {args : List Ideal} (hlen : args.length = N)
    (spine : SpineTyped (cinterp Rd (liftTm (TelescopeAbstraction.closeType (ofEntries e N) C))
      Env.nil) args) (j : Nat) (hj : j < N) :
    projT (cinterp Rd (liftTm (e j)) (Env.ofArgs j (args.take j))) (args.getD j Ideal.bot) =
      args.getD j Ideal.bot := by
  have h := projArgs_cinterp_ofEntries Rd e N C args hlen j hj
  rw [Ideal.projArgs_of_spineTyped spine] at h
  rw [List.getD_eq_getElem?_getD] at h ⊢
  rw [List.getElem?_eq_getElem (by omega)] at h ⊢
  exact (Option.some.inj h).symm

/-- The instantiated type of a telescope given by its entries at all of its arguments. -/
theorem instPi_cinterp_ofEntries (Rd : Reading Tower.Head) (e : (j : Nat) → Tm Tower.Head j)
    (N : Nat) (C : Tm Tower.Head N) (args : List Ideal) (hlen : args.length = N) :
    instPi (cinterp Rd (liftTm (TelescopeAbstraction.closeType (ofEntries e N) C)) Env.nil) args =
      cinterp Rd (liftTm C) (Env.ofArgs N
        (projArgs (cinterp Rd (liftTm (TelescopeAbstraction.closeType (ofEntries e N) C))
          Env.nil) args)) := by
  have h := instPi_cinterp_pisCtx Rd (liftCtx (ofEntries e N)) (liftTm C) args hlen
  rw [← liftTm_closeType] at h
  exact h

theorem piArity_closeType (e : (j : Nat) → Tm Tower.Head j) (N : Nat) (C : Tm Tower.Head N) :
    N ≤ piArity (liftTm (TelescopeAbstraction.closeType (ofEntries e N) C)) := by
  rw [liftTm_closeType, piArity_pisCtx]
  exact Nat.le_add_right _ _

/-! ## The fields of a declared datatype in the domain -/

/-- Whether a field is recursive. -/
def fieldFlag : CtorField → Bool
  | .recursive => true
  | .closed _ => false

/-- The closed field types of a constructor, in order. -/
def closedTypes : List (CtorField) → List (Tm Tower.Head 0)
  | [] => []
  | .recursive :: fs => closedTypes fs
  | .closed F :: fs => F :: closedTypes fs

/-- **The shapes of a constructor's fields**, its closed fields numbered from `j`: the datatype
itself for a recursive field, the next parameter for a closed one. -/
def fieldShapes : Nat → List (CtorField) → List FieldShape
  | _, [] => []
  | j, .recursive :: fs => .self :: fieldShapes j fs
  | j, .closed _ :: fs => .param j :: fieldShapes (j + 1) fs

/-- **The parameters of a declared datatype**: the closed field types of its constructors, in
order. -/
def paramTypes (cs : List (DeclName × List (CtorField))) : List (Tm Tower.Head 0) :=
  cs.flatMap fun c => closedTypes c.2

/-- The shapes of the constructors' fields, the parameters numbered from `j`. -/
def ctorShapes : Nat → List (DeclName × List (CtorField)) →
    List (DeclName × List FieldShape)
  | _, [] => []
  | j, c :: cs => (c.1, fieldShapes j c.2) :: ctorShapes (j + (closedTypes c.2).length) cs

/-- The shapes of the fields of the constructor `k`, if it is listed. -/
def shapesOf : Nat → List (DeclName × List (CtorField)) → DeclName →
    Option (List FieldShape)
  | _, [], _ => none
  | j, c :: cs, k =>
      if k = c.1 then some (fieldShapes j c.2) else shapesOf (j + (closedTypes c.2).length) cs k

theorem fieldShapes_length : ∀ (j : Nat) (fs : List (CtorField)),
    (fieldShapes j fs).length = fs.length
  | _, [] => rfl
  | j, .recursive :: fs => by simp only [fieldShapes, List.length_cons, fieldShapes_length j fs]
  | j, .closed _ :: fs => by simp only [fieldShapes, List.length_cons,
      fieldShapes_length (j + 1) fs]

theorem fieldShapes_flags : ∀ (j : Nat) (fs : List (CtorField)),
    (fieldShapes j fs).map FieldShape.isSelf = fs.map fieldFlag
  | _, [] => rfl
  | j, .recursive :: fs => by
      simp only [fieldShapes, List.map_cons, fieldShapes_flags j fs]
      rfl
  | j, .closed _ :: fs => by
      simp only [fieldShapes, List.map_cons, fieldShapes_flags (j + 1) fs]
      rfl

/-- **The type of each field shape is the field's type**, when the parameters from `j` are the
constructor's closed field types. -/
theorem fieldShapes_typeI (T : DeclName) (ps : List Ideal) (read : Tm Tower.Head 0 → Ideal) :
    ∀ (j : Nat) (fs : List (CtorField)),
      (∀ q F, (closedTypes fs)[q]? = some F → ps[j + q]? = some (read F)) →
      (fieldShapes j fs).map (FieldShape.typeI T ps) =
        fs.map fun f => match f with
          | .recursive => ctorI (Kind.data T) ps
          | .closed F => read F
  | _, [], _ => rfl
  | j, .recursive :: fs, h => by
      simp only [fieldShapes, List.map_cons]
      rw [fieldShapes_typeI T ps read j fs h]
      rfl
  | j, .closed F :: fs, h => by
      simp only [fieldShapes, List.map_cons]
      have h0 := h 0 F rfl
      rw [Nat.add_zero] at h0
      rw [fieldShapes_typeI T ps read (j + 1) fs fun q F' hq => by
        have := h (q + 1) F' (by simpa only [closedTypes, List.getElem?_cons_succ] using hq)
        rwa [show j + (q + 1) = j + 1 + q by omega] at this]
      show (ps[j]?.getD Ideal.bot) :: _ = _
      rw [h0]
      rfl

theorem ctorShapes_names : ∀ (j : Nat) (cs : List (DeclName × List (CtorField))),
    (ctorShapes j cs).map Prod.fst = cs.map Prod.fst
  | _, [] => rfl
  | j, c :: cs => by simp only [ctorShapes, List.map_cons, ctorShapes_names _ cs]

theorem ctorShapes_getElem? :
    ∀ (j : Nat) {cs : List (DeclName × List (CtorField))} {i : Nat} {k : DeclName}
      {fs : List (CtorField)}, cs[i]? = some (k, fs) →
        (ctorShapes j cs)[i]? = some (k, fieldShapes (j + (paramTypes (cs.take i)).length) fs)
  | _, [], _, _, _, h => nomatch h
  | j, c :: cs, 0, k, fs, h => by
      cases h
      simp only [ctorShapes, List.length_cons, Nat.lt_add_one_iff, zero_le, getElem?_pos,
          List.getElem_cons_zero, paramTypes, List.take_zero, List.flatMap_nil, List.length_nil,
          add_zero]
  | j, c :: cs, i + 1, k, fs, h => by
      have h' : cs[i]? = some (k, fs) := by simpa only [List.getElem?_cons_succ] using h
      simp only [ctorShapes, List.getElem?_cons_succ]
      rw [ctorShapes_getElem? _ h']
      simp only [List.take_succ_cons, paramTypes, List.flatMap_cons, List.length_append,
        Nat.add_assoc]

theorem shapesOf_getElem? :
    ∀ (j : Nat) {cs : List (DeclName × List (CtorField))} {i : Nat} {k : DeclName}
      {fs : List (CtorField)}, (cs.map Prod.fst).Nodup → cs[i]? = some (k, fs) →
        shapesOf j cs k = some (fieldShapes (j + (paramTypes (cs.take i)).length) fs)
  | _, [], _, _, _, _, h => nomatch h
  | j, c :: cs, 0, k, fs, _, h => by
      cases h
      simp only [shapesOf, ↓reduceIte, paramTypes, List.take_zero, List.flatMap_nil,
          List.length_nil, add_zero]
  | j, c :: cs, i + 1, k, fs, nodup, h => by
      rw [List.map_cons, List.nodup_cons] at nodup
      have hk : k ≠ c.1 := fun e =>
        nodup.1 (e ▸ List.mem_map.2 ⟨(k, fs), List.mem_of_getElem? h, rfl⟩)
      have h' : cs[i]? = some (k, fs) := by simpa only [List.getElem?_cons_succ] using h
      rw [shapesOf, if_neg hk, shapesOf_getElem? _ nodup.2 h']
      simp only [List.take_succ_cons, paramTypes, List.flatMap_cons, List.length_append,
        Nat.add_assoc]

theorem shapesOf_none : ∀ (j : Nat) {cs : List (DeclName × List (CtorField))} {k : DeclName},
    k ∉ cs.map Prod.fst → shapesOf j cs k = none
  | _, [], _, _ => rfl
  | j, c :: cs, k, h => by
      rw [List.map_cons, List.mem_cons, not_or] at h
      rw [shapesOf, if_neg h.1, shapesOf_none _ h.2]

/-- The parameters of the constructors around the constructor at `i`. -/
theorem paramTypes_split {cs : List (DeclName × List (CtorField))} {i : Nat} {k : DeclName}
    {fs : List (CtorField)} (h : cs[i]? = some (k, fs)) :
    paramTypes cs = paramTypes (cs.take i) ++ closedTypes fs ++ paramTypes (cs.drop (i + 1)) := by
  have hi : i < cs.length := by
    rcases Nat.lt_or_ge i cs.length with hi | hi
    · exact hi
    · rw [List.getElem?_eq_none hi] at h; cases h
  conv_lhs => rw [← List.take_append_drop i cs]
  rw [List.drop_eq_getElem_cons hi]
  have e : cs[i] = (k, fs) := by rw [List.getElem?_eq_getElem hi] at h; exact Option.some.inj h
  simp only [paramTypes, e, List.flatMap_append, List.flatMap_cons, List.append_assoc]

/-! ## A declared datatype in the domain -/

variable (d : Datatype Tower.Head)

/-- The parameters of the datatype in the domain: its closed field types, read by the object
reading. -/
def dataParams : List Ideal :=
  (paramTypes d.ctors).map fun F => cinterp objectChurchReading (liftTm F) Env.nil

/-- **The type of a declared datatype**: the type former of the datatype at its parameters. -/
def dataTypeI : Ideal := ctorI (Kind.data d.type) (dataParams d)

/-- The constructors of the datatype as recursion reads them. -/
def dataCs : List (Kind × List Bool) := Ideal.dataCtors d.type (ctorShapes 0 d.ctors)

/-- The type of a field: the datatype for a recursive field, the closed type read by the object
reading for a closed one. -/
def fieldTypeI : CtorField → Ideal
  | .recursive => dataTypeI d
  | .closed F => cinterp objectChurchReading (liftTm F) Env.nil

/-- **A constructor**: the constructor element of its arguments, curried and projected onto the
nondependent function type of its field shapes. -/
def ctorConstI (k : DeclName) (shapes : List FieldShape) : Ideal :=
  projT (arrowsI (shapes.map (FieldShape.typeI d.type (dataParams d))) (dataTypeI d))
    (curryI (ctorI (Kind.ctor d.type k shapes)) shapes.length [])

/-- The object reading with the type and the constructors of the datatype. -/
def dataStage : Reading Tower.Head where
  head := objectChurchReading.head
  const c := if c = d.type then dataTypeI d else
    match shapesOf 0 d.ctors c with
    | some shapes => ctorConstI d c shapes
    | none => objectChurchReading.const c

/-- **The recursor**: recursion over the datatype, curried over the motive, the methods and the
element, projected onto the denotation of its declared type. -/
def recConstI : Ideal :=
  projT (cinterp (dataStage d) (liftTm (recType d.type d.motiveUniverse d.ctors)) Env.nil)
    (curryI (recH (dataCs d)) (d.ctors.length + 2) [])

/-- **The reading of the object package with a declared datatype**: the object reading, the
datatype at its parameters, its constructors and its recursor. -/
def dataReading : Reading Tower.Head where
  head := objectChurchReading.head
  const c := if c = d.recursor then recConstI d else (dataStage d).const c

/-- The kinds of the constructors are distinct when their names are. -/
theorem dataCs_nodup (h : (d.ctors.map Prod.fst).Nodup) : ((dataCs d).map Prod.fst).Nodup :=
  Ideal.dataCtors_nodup d.type (by rw [ctorShapes_names]; exact h)

theorem ctorShapes_length : ∀ (j : Nat) (cs : List (DeclName × List CtorField)),
    (ctorShapes j cs).length = cs.length
  | _, [] => rfl
  | j, _ :: cs => by simp only [ctorShapes, List.length_cons, ctorShapes_length _ cs]

theorem dataCs_length : (dataCs d).length = d.ctors.length := by
  simp only [dataCs, Ideal.dataCtors, List.length_map, ctorShapes_length]

/-! ## Constants a term avoids -/

/-- The constants of a lifted term avoid `f` when the term does. -/
theorem termConsts_liftTm_ne {f : DeclName} :
    ∀ {n : Nat} (t : Tm Tower.Head n), lamFree t = true → ConstFree f t →
      ∀ c ∈ termConsts (liftTm t), c ≠ f
  | _, .var _, _, _, c, h => absurd h List.not_mem_nil
  | _, .const _, _, free, c, h => by
      rw [List.mem_singleton.1 h]
      exact free
  | _, .head _, _, _, c, h => absurd h List.not_mem_nil
  | _, .pi A B, lf, free, c, h => by
      simp only [lamFree, Bool.and_eq_true] at lf
      rcases List.mem_append.1 h with h | h
      · exact termConsts_liftTm_ne A lf.1 free.1 c h
      · exact termConsts_liftTm_ne B lf.2 free.2 c h
  | _, .sigma A B, lf, free, c, h => by
      simp only [lamFree, Bool.and_eq_true] at lf
      rcases List.mem_append.1 h with h | h
      · exact termConsts_liftTm_ne A lf.1 free.1 c h
      · exact termConsts_liftTm_ne B lf.2 free.2 c h
  | _, .id A a b, lf, free, c, h => by
      simp only [lamFree, Bool.and_eq_true] at lf
      rcases List.mem_append.1 h with h | h
      · exact termConsts_liftTm_ne A lf.1.1 free.1 c h
      · rcases List.mem_append.1 h with h | h
        · exact termConsts_liftTm_ne a lf.1.2 free.2.1 c h
        · exact termConsts_liftTm_ne b lf.2 free.2.2 c h
  | _, .lam _, lf, _, _, _ => nomatch lf
  | _, .app g a, lf, free, c, h => by
      simp only [lamFree, Bool.and_eq_true] at lf
      rcases List.mem_append.1 h with h | h
      · exact termConsts_liftTm_ne g lf.1 free.1 c h
      · exact termConsts_liftTm_ne a lf.2 free.2 c h
  | _, .pair a b, lf, free, c, h => by
      simp only [lamFree, Bool.and_eq_true] at lf
      rcases List.mem_append.1 h with h | h
      · exact termConsts_liftTm_ne a lf.1 free.1 c h
      · exact termConsts_liftTm_ne b lf.2 free.2 c h
  | _, .fst p, lf, free, c, h => termConsts_liftTm_ne p lf free c h
  | _, .snd p, lf, free, c, h => termConsts_liftTm_ne p lf free c h
  | _, .refl a, lf, free, c, h => termConsts_liftTm_ne a lf free c h

/-- A term avoids `f` when the constants of its lift do. -/
theorem constFree_of_termConsts {f : DeclName} :
    ∀ {n : Nat} (t : Tm Tower.Head n), (∀ c ∈ termConsts (liftTm t), c ≠ f) → ConstFree f t
  | _, .var _, _ => trivial
  | _, .const _, h => h _ List.mem_cons_self
  | _, .head _, _ => trivial
  | _, .pi A B, h => ⟨constFree_of_termConsts A fun c hc => h c (List.mem_append_left _ hc),
      constFree_of_termConsts B fun c hc => h c (List.mem_append_right _ hc)⟩
  | _, .sigma A B, h => ⟨constFree_of_termConsts A fun c hc => h c (List.mem_append_left _ hc),
      constFree_of_termConsts B fun c hc => h c (List.mem_append_right _ hc)⟩
  | _, .id A a b, h => ⟨constFree_of_termConsts A fun c hc => h c (List.mem_append_left _ hc),
      constFree_of_termConsts a fun c hc =>
        h c (List.mem_append_right _ (List.mem_append_left _ hc)),
      constFree_of_termConsts b fun c hc =>
        h c (List.mem_append_right _ (List.mem_append_right _ hc))⟩
  | _, .lam b, h => constFree_of_termConsts b fun c hc => h c (List.mem_append_right _ hc)
  | _, .app g a, h => ⟨constFree_of_termConsts g fun c hc => h c (List.mem_append_left _ hc),
      constFree_of_termConsts a fun c hc => h c (List.mem_append_right _ hc)⟩
  | _, .pair a b, h => ⟨constFree_of_termConsts a fun c hc => h c (List.mem_append_left _ hc),
      constFree_of_termConsts b fun c hc => h c (List.mem_append_right _ hc)⟩
  | _, .fst p, h => constFree_of_termConsts p h
  | _, .snd p, h => constFree_of_termConsts p h
  | _, .refl a, h => constFree_of_termConsts a h

theorem constFree_caseHyps_length {f : DeclName} :
    ∀ (k : Nat) {n : Nat} (rs : List (Tm Tower.Head n)), rs.length = k →
      ∀ (p target : Tm Tower.Head n), ConstFree f p → ConstFree f target →
        (∀ r ∈ rs, ConstFree f r) → ConstFree f (caseHyps p rs target)
  | _, _, [], _, p, target, hp, ht, _ => by
      rw [caseHyps_nil]
      exact ⟨hp, ht⟩
  | k + 1, _, r :: rs, hk, p, target, hp, ht, hr => by
      rw [caseHyps_cons]
      exact ⟨⟨hp, hr r List.mem_cons_self⟩, constFree_caseHyps_length k
        (rs.map (Presentation.rename wk)) (by rw [List.length_map]; exact Nat.succ.inj hk)
        _ _ (hp.rename wk) (ht.rename wk) fun r' hr' => by
          obtain ⟨r₀, h₀, rfl⟩ := List.mem_map.1 hr'
          exact (hr r₀ (List.mem_cons_of_mem _ h₀)).rename wk⟩
  | 0, _, _ :: _, hk, _, _, _, _, _ => absurd hk (Nat.succ_ne_zero _)

theorem constFree_caseHyps {f : DeclName} {n : Nat} (rs : List (Tm Tower.Head n))
    (p target : Tm Tower.Head n) (hp : ConstFree f p) (ht : ConstFree f target)
    (hr : ∀ r ∈ rs, ConstFree f r) : ConstFree f (caseHyps p rs target) :=
  constFree_caseHyps_length rs.length rs rfl p target hp ht hr

theorem constFree_caseFields {f T k : DeclName} (hT : T ≠ f) (hk : k ≠ f) :
    ∀ (fs : List CtorField) {n : Nat} (p : Tm Tower.Head n) (xs recs : List (Tm Tower.Head n)),
      (∀ F, Field.closed F ∈ fs → ConstFree f F) → ConstFree f p →
      (∀ x ∈ xs, ConstFree f x) → (∀ r ∈ recs, ConstFree f r) →
      ConstFree f (caseFields T k fs p xs recs)
  | [], _, p, xs, recs, _, hp, hxs, hrecs =>
      constFree_caseHyps recs p _ hp (ConstFree.appSpine (constFree_const.mpr hk) hxs) hrecs
  | .recursive :: fs, _, p, xs, recs, hF, hp, hxs, hrecs => by
      refine ⟨constFree_const.mpr hT, constFree_caseFields hT hk fs _ _ _
        (fun F h => hF F (List.mem_cons_of_mem _ h)) (hp.rename wk) ?_ ?_⟩
      · intro x hx
        rcases List.mem_append.1 hx with hx | hx
        · obtain ⟨x₀, h₀, rfl⟩ := List.mem_map.1 hx
          exact (hxs x₀ h₀).rename wk
        · rw [List.mem_singleton.1 hx]; trivial
      · intro r hr
        rcases List.mem_append.1 hr with hr | hr
        · obtain ⟨r₀, h₀, rfl⟩ := List.mem_map.1 hr
          exact (hrecs r₀ h₀).rename wk
        · rw [List.mem_singleton.1 hr]; trivial
  | .closed F :: fs, _, p, xs, recs, hF, hp, hxs, hrecs => by
      refine ⟨(hF F List.mem_cons_self).liftClosed, constFree_caseFields hT hk fs _ _ _
        (fun F h => hF F (List.mem_cons_of_mem _ h)) (hp.rename wk) ?_ ?_⟩
      · intro x hx
        rcases List.mem_append.1 hx with hx | hx
        · obtain ⟨x₀, h₀, rfl⟩ := List.mem_map.1 hx
          exact (hxs x₀ h₀).rename wk
        · rw [List.mem_singleton.1 hx]; trivial
      · intro r hr
        obtain ⟨r₀, h₀, rfl⟩ := List.mem_map.1 hr
        exact (hrecs r₀ h₀).rename wk

theorem constFree_closeType {f : DeclName} (e : (j : Nat) → Tm Tower.Head j)
    (he : ∀ j, ConstFree f (e j)) :
    ∀ (N : Nat) (C : Tm Tower.Head N), ConstFree f C →
      ConstFree f (TelescopeAbstraction.closeType (ofEntries e N) C)
  | 0, _, hC => hC
  | N + 1, C, hC => by
      rw [closeType_ofEntries_succ]
      exact constFree_closeType e he N _ ⟨he N, hC⟩

/-- **The recursor's declared type avoids every constant other than the datatype, its
constructors and the constants of its closed field types.** -/
theorem constFree_recType {f T : DeclName} (v : Tower.Head) {cs : List (DeclName × List CtorField)}
    (hT : T ≠ f) (hk : ∀ c ∈ cs, c.1 ≠ f)
    (hF : ∀ c ∈ cs, ∀ F, Field.closed F ∈ c.2 → ConstFree f F) :
    ConstFree f (recType T v cs) := by
  refine constFree_closeType _ (fun j => ?_) _ _ ⟨trivial, trivial⟩
  cases j with
  | zero => exact ⟨constFree_const.mpr hT, trivial⟩
  | succ j =>
      cases entry : cs[j]? with
      | none =>
          rw [show recEntry T v cs (j + 1) = .const T by simp only [recEntry, entry]]
          exact constFree_const.mpr hT
      | some c =>
          obtain ⟨k, fs⟩ := c
          rw [recEntry_method T v cs entry]
          exact constFree_caseFields hT (hk _ (List.mem_of_getElem? entry)) fs _ [] []
            (hF _ (List.mem_of_getElem? entry)) trivial (fun _ h => nomatch h)
            (fun _ h => nomatch h)


/-! ## Raw spines lifted -/

theorem liftTm_appSpine {n : Nat} : ∀ (xs : List (Tm Tower.Head n)) (f : Tm Tower.Head n),
    liftTm (appSpine f xs) = CTm.appSpine (liftTm f) (xs.map liftTm)
  | [], _ => rfl
  | x :: xs, f => liftTm_appSpine xs (.app f x)

theorem recArgs_eq_recFields {n : Nat} : ∀ (fs : List CtorField) (xs : List (Tm Tower.Head n)),
    recArgs fs xs = Ideal.recFields (fs.map fieldFlag) xs
  | .recursive :: fs, x :: xs => by
      rw [recArgs, recArgs_eq_recFields fs xs]
      rfl
  | .closed _ :: fs, _ :: xs => by
      rw [recArgs, recArgs_eq_recFields fs xs]
      rfl
  | [], _ => by simp only [recArgs, List.map_nil, Ideal.recFields]
  | .recursive :: _, [] => by simp only [recArgs, List.map_cons, List.cons.injEq, List.nil_eq,
      reduceCtorEq, imp_self, implies_true, Ideal.recFields]
  | .closed _ :: _, [] => by simp only [recArgs, List.map_cons, List.cons.injEq, List.nil_eq,
      reduceCtorEq, imp_self, implies_true, Ideal.recFields]

theorem methodsAt_append (π : Ideal) :
    ∀ (cs : List (Kind × List Bool)) (μs extra : List Ideal), μs.length = cs.length →
      methodsAt π cs (μs ++ extra) = methodsAt π cs μs
  | [], _, _, _ => rfl
  | c :: cs, μ :: μs, extra, h => by
      funext k zs
      simp only [methodsAt, List.cons_append, List.headD_cons, List.tail_cons]
      rw [methodsAt_append π cs μs extra (by simpa only [List.length_cons,
          Nat.add_right_cancel_iff] using h)]
  | _ :: _, [], _, h => by
      simp only [List.length_nil, List.length_cons] at h
      exact absurd h (by omega)

/-! ## The package with a declared datatype and its reading -/

/-- **The object package with a declared datatype.** -/
abbrev dataChurch (d : Datatype Tower.Head) : ChurchRules (rulesWith objectRules [.datatype d]) :=
  withDeclarations objectChurch [.datatype d]

/-- The declared type of the recursor, read. -/
abbrev recTypeI (d : Datatype Tower.Head) : Ideal :=
  cinterp (dataReading d) (liftTm (recType d.type d.motiveUniverse d.ctors)) Env.nil

theorem dataReading_recursor : (dataReading d).const d.recursor = recConstI d := if_pos rfl

section Admissible

variable {d : Datatype Tower.Head} (hd : d.Admissible objectChurch)
include hd

theorem dataReading_type : (dataReading d).const d.type = dataTypeI d := by
  simp only [dataReading, dataStage, if_neg (Ne.symm hd.distinct.recNotType), if_true]

theorem dataReading_ctor {i : Nat} {k : DeclName} {fs : List CtorField}
    (h : d.ctors[i]? = some (k, fs)) :
    (dataReading d).const k =
      ctorConstI d k (fieldShapes (paramTypes (d.ctors.take i)).length fs) := by
  have mem : k ∈ d.ctors.map Prod.fst := List.mem_map.2 ⟨(k, fs), List.mem_of_getElem? h, rfl⟩
  have h₁ : k ≠ d.recursor := fun e => hd.distinct.recNotCtor (e ▸ mem)
  have h₂ : k ≠ d.type := fun e => hd.distinct.typeNotCtor (e ▸ mem)
  simp only [dataReading, dataStage, if_neg h₁, if_neg h₂,
    shapesOf_getElem? 0 hd.distinct.ctorsNodup h, Nat.zero_add]

/-- **The reading agrees with the object reading** on every constant the object package
declares. -/
theorem dataReading_object {c : DeclName} (h : objectChurch.constantType c ≠ none) :
    (dataReading d).const c = objectChurchReading.const c := by
  have ne : ∀ {n : DeclName}, objectChurch.constantType n = none → c ≠ n := fun hn e => h (e ▸ hn)
  have notCtor : c ∉ d.ctors.map Prod.fst := fun hc => by
    obtain ⟨e, he, rfl⟩ := List.mem_map.1 hc
    exact h (hd.new.ctorsNew e he)
  simp only [dataReading, dataStage, if_neg (ne hd.new.recNew), if_neg (ne hd.new.typeNew),
    shapesOf_none 0 notCtor]

/-- A closed field type is read as the object reading reads it. -/
theorem dataReading_closedField {entry : DeclName × List CtorField} (hmem : entry ∈ d.ctors)
    {F : Tm Tower.Head 0} (hF : Field.closed F ∈ entry.2) :
    cinterp (dataReading d) (liftTm F) Env.nil = cinterp objectChurchReading (liftTm F) Env.nil :=
  congrFun (cinterp_congr (Rd := dataReading d) (Rd' := objectChurchReading) rfl (liftTm F)
    fun c hc => dataReading_object hd
      (TowerInterpretation.CDerivable.consts_declared (hd.fields entry hmem F hF) c hc)) Env.nil

/-- The type of a field, read. -/
theorem dataReading_fieldType {entry : DeclName × List CtorField} (hmem : entry ∈ d.ctors)
    {f : CtorField} (hf : f ∈ entry.2) :
    cinterp (dataReading d) (liftTm (f.type d.type)) Env.nil = fieldTypeI d f := by
  cases f with
  | recursive => exact dataReading_type hd
  | closed F => exact dataReading_closedField hd hmem hf

/-- **The declared type of a constructor denotes the nondependent function type of its
fields.** -/
theorem cinterp_ctorType {entry : DeclName × List CtorField} (hmem : entry ∈ d.ctors) :
    cinterp (dataReading d) (liftTm (ctorType d.type entry.2)) Env.nil =
      arrowsI (entry.2.map (fieldTypeI d)) (dataTypeI d) := by
  show cinterp (dataReading d) (liftTm (TelescopeAbstraction.closeType
    (ofEntries (fun j => Presentation.liftClosed ((entry.2.getD j .recursive).type d.type))
      entry.2.length) (.const d.type))) Env.nil = _
  rw [cinterp_closeType_closed (dataReading d) (fun j => (entry.2.getD j .recursive).type d.type)
    entry.2.length (.const d.type) (dataTypeI d) (fun _ => dataReading_type hd)]
  congr 1
  apply List.ext_getElem (by simp only [List.getD_eq_getElem?_getD, List.length_map,
      List.length_range])
  intro j h₁ h₂
  simp only [List.getElem_map, List.getElem_range]
  rw [List.getD_eq_getElem?_getD,
      List.getElem?_eq_getElem (by simpa only [List.getD_eq_getElem?_getD, List.length_map,
      List.length_range] using h₁), Option.getD_some]
  exact dataReading_fieldType hd hmem (List.getElem_mem _)

