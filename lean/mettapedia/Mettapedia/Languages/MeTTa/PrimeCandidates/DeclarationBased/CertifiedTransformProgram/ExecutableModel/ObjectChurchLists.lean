/-- The projected arguments of nondependent function types. -/
theorem projArgs_arrowsI (B : Ideal) :
    ∀ (As args : List Ideal), args.length ≤ As.length →
      projArgs (arrowsI As B) args = List.zipWith projT As args
  | _, [], _ => by rw [List.zipWith_nil_right]; rfl
  | A :: As, a :: args, h => by
      show projT (Ideal.dom .pi (cpi A fun _ => arrowsI As B)) a ::
        projArgs (Ideal.fam .pi (cpi A fun _ => arrowsI As B)
          (projT (Ideal.dom .pi (cpi A fun _ => arrowsI As B)) a)) args = _
      rw [Ideal.dom_cpi, Ideal.fam_cpi (Ideal.Cont.const _),
        projArgs_arrowsI B As args (by simpa only [List.length_cons,
            Nat.add_le_add_iff_right] using h)]
      rfl
  | [], _ :: _, h => by simp only [List.length_cons, List.length_nil, nonpos_iff_eq_zero,
      Nat.add_eq_zero_iff, List.length_eq_zero_iff, one_ne_zero, and_false] at h

omit hd in
/-- **A constructor applied to as many arguments as it has fields** is its constructor element of
the arguments, each projected onto its field's type. -/
theorem appSpine_ctorConstI_proj (k : DeclName) (shapes : List FieldShape) {αs : List Ideal}
    (hlen : αs.length = shapes.length) :
    Ideal.appSpine (ctorConstI d k shapes) αs = ctorI (Kind.ctor d.type k shapes)
      (List.zipWith projT (shapes.map (FieldShape.typeI d.type (dataParams d))) αs) := by
  unfold ctorConstI
  rw [Ideal.appSpine_projT _ (churchTele_arrowsI _ _) (by simp only [hlen, List.length_map,
      Std.le_refl]),
    projArgs_arrowsI _ _ _ (by simp only [hlen, List.length_map,
        Std.le_refl]), instPi_arrowsI _ _ _ (by simp only [hlen, List.length_map]),
    appSpine_curryI (fun pre post => cont_ctorI_at _ pre post) _ _ _
      (by simp only [List.length_zipWith, List.length_map, hlen, min_self]),
    List.reverse_nil, List.nil_append]
  refine Ideal.projT_data_ctorI fun i x hx => ?_
  obtain ⟨hi, hx'⟩ := List.getElem?_eq_some_iff.1 hx
  rw [List.getElem_zipWith] at hx'
  have hi' : i < shapes.length := by
    simp only [List.length_zipWith, List.length_map, lt_inf_iff] at hi
    omega
  refine ⟨shapes[i], List.getElem?_eq_getElem hi', ?_⟩
  rw [← hx']
  simp only [List.getElem_map]
  exact Ideal.projT_projT _ _

/-- The recursor's declared type mentions no recursor. -/
theorem recType_termConsts : ∀ c ∈ termConsts (liftTm (recType d.type d.motiveUniverse d.ctors)),
    c ≠ d.recursor :=
  termConsts_liftTm_ne _ (lamFree_recType _ _ hd.lamFree)
    (constFree_recType _ (Ne.symm hd.distinct.recNotType)
      (fun c hc e => hd.distinct.recNotCtor (e ▸ List.mem_map.2 ⟨c, hc, rfl⟩))
      fun entry hmem F hF => constFree_of_termConsts F fun c hc e =>
        TowerInterpretation.CDerivable.consts_declared (hd.fields entry hmem F hF) c hc
          (e ▸ hd.new.recNew))

/-- **The recursor denotes recursion over the datatype**, curried and projected onto its declared
type. -/
theorem dataReading_recursor_eq :
    (dataReading d).const d.recursor =
      projT (recTypeI d) (curryI (recH (dataCs d)) (d.ctors.length + 2) []) := by
  rw [dataReading_recursor, recConstI]
  congr 1
  exact congrFun (cinterp_congr (Rd := dataStage d) (Rd' := dataReading d) rfl _
    fun c hc => (if_neg (recType_termConsts hd c hc)).symm) Env.nil

omit hd in
/-- **The recursor's declared type after its motive and methods** is the function type from
the datatype to the motive. -/
theorem recTypeI_prefix {pre : List Ideal} (hpre : pre.length = d.ctors.length + 1)
    (spine : SpineTyped (recTypeI d) pre) :
    instPi (recTypeI d) pre = cpi ((dataReading d).const d.type) (fun y =>
      Ideal.app (pre.getD 0 Ideal.bot) y) := by
  have e : recType d.type d.motiveUniverse d.ctors = TelescopeAbstraction.closeType
      (ofEntries (recEntry d.type d.motiveUniverse d.ctors) (d.ctors.length + 1))
      (.pi (recEntry d.type d.motiveUniverse d.ctors (d.ctors.length + 1))
        (recBody d.ctors.length)) :=
    closeType_ofEntries_succ _ _ _
  have spine' := spine
  unfold recTypeI at spine' ⊢
  rw [e] at spine' ⊢
  rw [instPi_cinterp_ofEntries _ _ _ _ pre hpre, Ideal.projArgs_of_spineTyped spine',
    recEntry_scrutinee]
  show cpi ((dataReading d).const d.type)
    (fun y => cinterp (dataReading d) (liftTm (recBody d.ctors.length))
      (Env.cons y (Env.ofArgs (d.ctors.length + 1) pre))) = _
  congr 1
  funext y
  show Ideal.app (Env.cons y (Env.ofArgs (d.ctors.length + 1) pre) (Fin.last (d.ctors.length + 1)))
    y = _
  congr 1
  show Env.ofArgs (d.ctors.length + 1) pre (Fin.last d.ctors.length) = _
  simp only [Env.ofArgs, Nat.add_sub_cancel, Fin.val_last, tsub_self, List.getD_eq_getElem?_getD]

end Admissible


/-! ## The recursor at a constructor -/

theorem mem_recFields {α : Type} {x : α} :
    ∀ {bs : List Bool} {xs : List α}, x ∈ Ideal.recFields bs xs →
      ∃ p : Nat, xs[p]? = some x ∧ bs[p]? = some true
  | true :: bs, y :: xs, h => by
      rcases List.mem_cons.1 h with rfl | h
      · exact ⟨0, rfl, rfl⟩
      · obtain ⟨p, hp, hb⟩ := mem_recFields h
        exact ⟨p + 1, hp, hb⟩
  | false :: bs, _ :: xs, h => by
      obtain ⟨p, hp, hb⟩ := mem_recFields (bs := bs) (xs := xs) h
      exact ⟨p + 1, hp, hb⟩
  | [], _, h => by simp only [Ideal.recFields, List.not_mem_nil] at h
  | true :: _, [], h => by simp only [Ideal.recFields, List.not_mem_nil] at h
  | false :: _, [], h => by simp only [Ideal.recFields, List.not_mem_nil] at h

section Recursion

variable {d : Datatype Tower.Head} (hd : d.Admissible objectChurch)
include hd

omit hd in
/-- A recursive field of an element of the fields' types is an element of the datatype. -/
theorem recField_typed {fs : List CtorField} {αs : List Ideal} (hα : αs.length = fs.length)
    (spine : SpineTyped (arrowsI (fs.map (fieldTypeI d)) (dataTypeI d)) αs) {α : Ideal}
    (mem : α ∈ Ideal.recFields (fs.map fieldFlag) αs) : projT (dataTypeI d) α = α := by
  obtain ⟨p, hp, hb⟩ := mem_recFields mem
  have hpl : p < fs.length := by
    rw [← hα]
    rcases Nat.lt_or_ge p αs.length with hlt | hge
    · exact hlt
    · rw [List.getElem?_eq_none hge] at hp; cases hp
  rw [List.getElem?_map, List.getElem?_eq_getElem hpl] at hb
  have hrec : fs[p] = .recursive := by
    cases e : fs[p] with
    | recursive => rfl
    | closed F => rw [e] at hb; cases hb
  exact spineTyped_arrowsI _ _ _ spine (by simp only [hα, List.length_map, Std.le_refl]) p α _ hp
    (by rw [List.getElem?_map, List.getElem?_eq_getElem hpl, hrec]; rfl)

/-- **The recursor applied to its motive and methods, at an element of the datatype**:
recursion at it, read at the motive there. -/
theorem appSpine_recursor {pre : List Ideal} (hpre : pre.length = d.ctors.length + 1)
    (spine : SpineTyped (recTypeI d) pre) {α : Ideal} (hα : projT (dataTypeI d) α = α) :
    Ideal.appSpine ((dataReading d).const d.recursor) (pre ++ [α]) =
      projT (Ideal.app (pre.getD 0 Ideal.bot) α)
        (recI (dataCs d) (methodsAt (pre.headD Ideal.bot) (dataCs d) pre.tail) α) := by
  have inst := recTypeI_prefix (d := d) hpre spine
  rw [dataReading_type hd] at inst
  have hlen : (pre ++ [α]).length ≤ piArity (liftTm (recType d.type d.motiveUniverse d.ctors)) :=
    le_trans (by simp only [List.length_append, hpre, List.length_cons, List.length_nil, zero_add,
        Std.le_refl]) (piArity_closeType _ _ _)
  rw [dataReading_recursor_eq hd, Ideal.appSpine_projT _ (churchTele_cinterp _ _ _) hlen,
    projArgs_append, Ideal.projArgs_of_spineTyped spine, Ideal.instPi_append, inst,
    projArgs_singleton,
    Ideal.dom_cpi, hα]
  have hfam : Ideal.instPi (cpi (dataTypeI d) fun y => Ideal.app (pre.getD 0 Ideal.bot) y) [α] =
      Ideal.app (pre.getD 0 Ideal.bot) α := by
    show Ideal.fam .pi (cpi (dataTypeI d) _) (projT (Ideal.dom .pi (cpi (dataTypeI d) _)) α) = _
    rw [Ideal.dom_cpi, hα, Ideal.fam_cpi (Ideal.cont₂_app.right _), hα]
  rw [hfam, appSpine_curryI (contEach_recH _) _ _ _ (by simp only [List.length_append, hpre,
      List.length_cons, List.length_nil, zero_add]), List.reverse_nil,
    List.nil_append]
  obtain ⟨π, rest, rfl⟩ : ∃ π rest, pre = π :: rest := by
    cases pre with
    | nil => simp only [List.length_nil] at hpre; exact absurd hpre (by omega)
    | cons π rest => exact ⟨π, rest, rfl⟩
  have hrest : rest.length = (dataCs d).length := by
    rw [dataCs_length]; simpa only [List.length_cons, Nat.add_right_cancel_iff] using hpre
  simp only [recH, List.cons_append, List.headD_cons, List.tail_cons, List.getD_cons_zero]
  rw [methodsAt_append _ _ _ _ hrest]
  congr 1
  rw [List.getD_cons_succ, List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega), hrest,
    Nat.sub_self]
  rfl

/-- **The recursor at a constructor computes by its method**: the recursion's function, at the
motive, the methods and a constructor applied to elements of its field types, is the
constructor's method applied to the fields and to the recursor at each recursive field. -/
theorem recursor_at_ctor {i : Nat} {k : DeclName} {fs : List CtorField}
    (h : d.ctors[i]? = some (k, fs)) {pre αs : List Ideal}
    (hpre : pre.length = d.ctors.length + 1) (hα : αs.length = fs.length)
    (spinePre : SpineTyped (recTypeI d) pre)
    (spineα : SpineTyped (arrowsI (fs.map (fieldTypeI d)) (dataTypeI d)) αs) :
    Ideal.appSpine (curryI (recH (dataCs d)) (d.ctors.length + 2) [])
        (pre ++ [Ideal.appSpine ((dataReading d).const k) αs]) =
      Ideal.appSpine (pre.getD (1 + i) Ideal.bot) (αs ++ (Ideal.recFields (fs.map fieldFlag) αs).map
        fun α => Ideal.appSpine ((dataReading d).const d.recursor) (pre ++ [α])) := by
  have hshapes := dataShapes_typeI h
  have hk : Ideal.appSpine ((dataReading d).const k) αs =
      ctorI (Kind.ctor d.type k (fieldShapes (paramTypes (d.ctors.take i)).length fs)) αs := by
    rw [dataReading_ctor hd h]
    exact appSpine_ctorConstI k _ (by rw [fieldShapes_length]; exact hα)
      (by rw [hshapes]; exact spineα)
  have hdcs : (dataCs d)[i]? = some
      (Kind.ctor d.type k (fieldShapes (paramTypes (d.ctors.take i)).length fs),
          fs.map fieldFlag) := by
    unfold dataCs Ideal.dataCtors
    rw [List.getElem?_map, ctorShapes_getElem? 0 h, Nat.zero_add]
    simp only [Option.map_some, fieldShapes_flags]
  have nodup := dataCs_nodup d hd.distinct.ctorsNodup
  obtain ⟨π, rest, rfl⟩ : ∃ π rest, pre = π :: rest := by
    cases pre with
    | nil => simp only [List.length_nil] at hpre; exact absurd hpre (by omega)
    | cons π rest => exact ⟨π, rest, rfl⟩
  have hrest : rest.length = (dataCs d).length := by
    rw [dataCs_length]; simpa only [List.length_cons, Nat.add_right_cancel_iff] using hpre
  rw [appSpine_curryI (contEach_recH _) _ _ _
    (by simp only [List.length_append, List.length_cons, List.length_nil] at hpre ⊢; omega),
    List.reverse_nil, List.nil_append]
  simp only [recH, List.cons_append, List.headD_cons, List.tail_cons]
  rw [methodsAt_append _ _ _ _ hrest]
  have hscr :
      ((Ideal.appSpine ((dataReading d).const k) αs) :: ([] : List Ideal)).getD 0 Ideal.bot =
      Ideal.appSpine ((dataReading d).const k) αs := rfl
  rw [List.getD_cons_succ, List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega), hrest,
    Nat.sub_self]
  simp only [List.getElem?_cons_zero, Option.getD_some]
  rw [hk, Ideal.recI_ctorI (contList_methodsAt _ _ _) (List.mem_of_getElem? hdcs) nodup
      (by simp only [hα, List.length_map]),
    methodsAt_getElem _ _ nodup hdcs, caseValue_eval _ _ _ (by simp only [hα, List.length_map])]
  congr 1
  · rw [Nat.add_comm, List.getD_cons_succ]
  · congr 1
    apply List.map_congr_left
    intro α mem
    rw [show π :: (rest ++ [α]) = (π :: rest) ++ [α] from rfl,
      appSpine_recursor hd hpre spinePre (recField_typed hα spineα mem)]
    rfl

end Recursion


/-! ## Validity -/

theorem closed_mem_of_closedTypes {F : Tm Tower.Head 0} :
    ∀ {fs : List CtorField}, F ∈ closedTypes fs → Field.closed F ∈ fs
  | [], h => absurd h (by simp only [closedTypes, List.not_mem_nil, not_false_eq_true])
  | .recursive :: _, h => List.mem_cons_of_mem _ (closed_mem_of_closedTypes h)
  | .closed _ :: _, h => by
      rcases List.mem_cons.1 h with rfl | h
      · exact List.mem_cons_self
      · exact List.mem_cons_of_mem _ (closed_mem_of_closedTypes h)

section Validity

variable {d : Datatype Tower.Head} (hd : d.Admissible objectChurch)
include hd

/-- A declared type of the object package is read alike by both readings. -/
theorem dataReading_objectDecl {c : DeclName} {D : CTm Tower.Head 0}
    (declared : objectChurch.constantType c = some D) :
    cinterp (dataReading d) D Env.nil = cinterp objectChurchReading D Env.nil := by
  refine congrFun (cinterp_congr (Rd := dataReading d) (Rd' := objectChurchReading) rfl D
    fun c' hc' => dataReading_object hd (objectChurch_constantType_ne_none ?_)) Env.nil
  rw [declType_of_declared declared] at hc'
  exact closedTerm_iff.1 (ObjConst.declType_closed _) c' hc'

/-- **The type of a declared datatype is a type**: its parameters, the closed field types, are
types of the object package. -/
theorem typeGenerated_dataTypeI : TypeGenerated (dataTypeI d) := by
  refine Ideal.typeGenerated_data d.type fun p hp => ?_
  obtain ⟨F, hF, rfl⟩ := List.mem_map.1 hp
  obtain ⟨entry, hmem, hFe⟩ := List.mem_flatMap.1 hF
  have hcl : Field.closed F ∈ entry.2 := closed_mem_of_closedTypes hFe
  have typed := objectChurchReading_valid.soundnessFacts.typing (hd.fields entry hmem F hcl)
    Env.nil trivial
  have hu : cinterp objectChurchReading (.head d.typeUniverse : CTm Tower.Head 0) Env.nil =
      univIdeal := by
    show principal (objectChurchReading.head d.typeUniverse) = _
    rw [objectChurchReading_valid.universes hd.typeUniverse]
    rfl
  rw [hu] at typed
  exact Ideal.projT_univ_eq_self_iff.1 typed.2

/-- **Every constant of the package denotes an element of its declared type.** -/
theorem dataReading_constants {c : DeclName} {D : CTm Tower.Head 0}
    (declared : (dataChurch d).constantType c = some D) :
    projT (cinterp (dataReading d) D Env.nil) ((dataReading d).const c) =
      (dataReading d).const c := by
  have declared' : sumDecls objectChurch.constantType
      (inductiveChurch objectRules d.type d.typeUniverse d.ctors d.recursor
        d.motiveUniverse).constantType c = some D := declared
  cases hobj : objectChurch.constantType c with
  | some D₀ =>
    obtain rfl : D = D₀ := Option.some.inj (declared'.symm.trans (sumDecls_left hobj))
    rw [dataReading_objectDecl hd hobj, dataReading_object hd (by rw [hobj]; exact nofun)]
    exact objectChurchReading_constants hobj
  | none =>
    rw [sumDecls_right hobj] at declared'
    rcases inductiveChurch_constantType objectRules hd.lamFree declared' with
      ⟨rfl, rfl⟩ | ⟨i, fields, entry, rfl⟩ | ⟨rfl, rfl⟩
    · show projT (principal (objectChurchReading.head d.typeUniverse))
        ((dataReading d).const d.type) = _
      rw [objectChurchReading_valid.universes hd.typeUniverse, dataReading_type hd]
      exact Ideal.projT_univ_eq_self_iff.2 (typeGenerated_dataTypeI hd)
    · rw [cinterp_ctorType hd (entry := (c, fields)) (List.mem_of_getElem? entry),
        dataReading_ctor hd entry, ctorConstI, dataShapes_typeI entry]
      exact Ideal.projT_projT _ _
    · rw [dataReading_recursor_eq hd]
      exact Ideal.projT_projT _ _

/-- **A root step of the object package is valid in the reading**: its schema mentions only the
object package's constants, so its spine facts carry over to the object reading at the values of
its metavariables, where the schema is valid. -/
theorem dataReading_objectRoot {n : Nat} {l r : CTm Tower.Head n} {τ : Ideal} {ρ : Env n}
    (step : objectChurch.computation.step l r)
    (facts : SpineFacts (dataReading d) (dataChurch d) l τ ρ)
    (right : projT τ (cinterp (dataReading d) r ρ) = cinterp (dataReading d) r ρ) :
    cinterp (dataReading d) l ρ = cinterp (dataReading d) r ρ := by
  cases step with
  | instantiate rule σ =>
    obtain ⟨L, R', hS, rfl, rfl⟩ := rule
    have closed := objectSchemas_closed hS
    have agreeL : ∀ c ∈ termConsts (elabLeft objectDecls L),
        (dataReading d).const c = objectChurchReading.const c :=
      fun c hc => dataReading_object hd (objectChurch_constantType_ne_none
        (closedTerm_iff.1 closed.left c hc))
    have agreeR : ∀ c ∈ termConsts (elabRight objectDecls L R'),
        (dataReading d).const c = objectChurchReading.const c :=
      fun c hc => dataReading_object hd (objectChurch_constantType_ne_none
        (closedTerm_iff.1 closed.right c hc))
    have eL : cinterp (dataReading d) ((elabLeft objectDecls L).subst σ) ρ =
        cinterp objectChurchReading (elabLeft objectDecls L)
          fun i => cinterp (dataReading d) (σ i) ρ := by
      rw [cinterp_subst, cinterp_congr (Rd := dataReading d) (Rd' := objectChurchReading) rfl _
        agreeL]
    have eR : cinterp (dataReading d) ((elabRight objectDecls L R').subst σ) ρ =
        cinterp objectChurchReading (elabRight objectDecls L R')
          fun i => cinterp (dataReading d) (σ i) ρ := by
      rw [cinterp_subst, cinterp_congr (Rd := dataReading d) (Rd' := objectChurchReading) rfl _
        agreeR]
    have facts' : SpineFacts objectChurchReading objectChurch
        ((elabLeft objectDecls L).subst CTm.ids) τ
          (fun i => cinterp (dataReading d) (σ i) ρ) := by
      rw [CTm.subst_ids]
      exact SpineFacts.congr (Rd := dataReading d) (Rd' := objectChurchReading)
        (P := dataChurch d) (P' := objectChurch) rfl _ agreeL
        (fun _ _ _ hD => ⟨sumDecls_left hD, dataReading_objectDecl hd hD⟩)
        (SpineFacts.of_subst _ σ facts)
    have right' : projT τ (cinterp objectChurchReading ((elabRight objectDecls L R').subst CTm.ids)
        fun i => cinterp (dataReading d) (σ i) ρ) =
          cinterp objectChurchReading ((elabRight objectDecls L R').subst CTm.ids)
            fun i => cinterp (dataReading d) (σ i) ρ := by
      rw [CTm.subst_ids, ← eR]
      exact right
    have v := objectSchemas_valid hS CTm.ids facts' right'
    rw [CTm.subst_ids, CTm.subst_ids] at v
    rw [eL, eR, v]

end Validity


/-! ## The computation rules of the recursor are valid -/

/-- The left side of a computation rule of the recursor, substituted. -/
theorem iotaLeft_subst (rec k : DeclName) (c a : Nat) {n : Nat}
    (σ : CSub Tower.Head (1 + c + a) n) :
    (liftTm (iotaLeft rec k c a)).subst σ =
      CTm.appSpine (.const rec)
        (((metaVars (1 + c + a)).map fun t => (liftTm t).subst σ).take (1 + c) ++
          [CTm.appSpine (.const k)
            (((metaVars (1 + c + a)).map fun t => (liftTm t).subst σ).drop (1 + c))]) := by
  simp only [iotaLeft, recApp, liftTm_appSpine, csubst_appSpine, List.map_append, List.map_take,
    List.map_drop, List.map_map, List.map_cons, List.map_nil, Function.comp_def]
  rfl

/-- The right side of the computation rule of the constructor at `i`, substituted. -/
theorem iotaRight_subst (rec : DeclName) (c i : Nat) (fs : List CtorField) {n : Nat}
    (σ : CSub Tower.Head (1 + c + fs.length) n) :
    (liftTm (iotaRight rec c i fs)).subst σ =
      CTm.appSpine ((liftTm (((metaVars (1 + c + fs.length)).take (1 + c)).getD (1 + i)
          defaultTm)).subst σ)
        (((metaVars (1 + c + fs.length)).map fun t => (liftTm t).subst σ).drop (1 + c) ++
          (Ideal.recFields (fs.map fieldFlag)
            (((metaVars (1 + c + fs.length)).map fun t => (liftTm t).subst σ).drop (1 + c))).map
            fun t => CTm.appSpine (.const rec)
              (((metaVars (1 + c + fs.length)).map fun t => (liftTm t).subst σ).take (1 + c) ++
                [t])) := by
  simp only [iotaRight, recApp, liftTm_appSpine, csubst_appSpine, List.map_append, List.map_take,
    List.map_drop, List.map_map, List.map_cons, List.map_nil, Function.comp_def,
    recArgs_eq_recFields]
  simp only [← List.map_drop, Ideal.recFields_map, List.map_map, Function.comp_def]
  rfl

section Iota

variable {d : Datatype Tower.Head} (hd : d.Admissible objectChurch)
include hd

/-- **The computation rule of the recursor at a constructor is valid in the reading.** -/
theorem dataReading_iota {i : Nat} {k : DeclName} {fs : List CtorField}
    (entry : d.ctors[i]? = some (k, fs)) {n : Nat}
    (σ : CSub Tower.Head (1 + d.ctors.length + fs.length) n) {τ : Ideal} {ρ : Env n}
    (facts : SpineFacts (dataReading d) (dataChurch d)
      ((liftTm (iotaLeft d.recursor k d.ctors.length fs.length)).subst σ) τ ρ)
    (right : projT τ (cinterp (dataReading d)
        ((liftTm (iotaRight d.recursor d.ctors.length i fs)).subst σ) ρ) =
      cinterp (dataReading d) ((liftTm (iotaRight d.recursor d.ctors.length i fs)).subst σ) ρ) :
    cinterp (dataReading d) ((liftTm (iotaLeft d.recursor k d.ctors.length fs.length)).subst σ) ρ =
      cinterp (dataReading d) ((liftTm (iotaRight d.recursor d.ctors.length i fs)).subst σ) ρ := by
  have hi : i < d.ctors.length := by
    rcases Nat.lt_or_ge i d.ctors.length with hlt | hge
    · exact hlt
    · rw [List.getElem?_eq_none hge] at entry; cases entry
  -- the head of the right side is the method of the constructor
  have hhead : cinterp (dataReading d) ((liftTm (((metaVars (1 + d.ctors.length + fs.length)).take
        (1 + d.ctors.length)).getD (1 + i) defaultTm)).subst σ) ρ =
      ((((metaVars (1 + d.ctors.length + fs.length)).map fun t => (liftTm t).subst σ).map
        (cinterp (dataReading d) · ρ)).take (1 + d.ctors.length)).getD (1 + i) Ideal.bot := by
    have hlen : 1 + i < ((metaVars (Head := Tower.Head) (1 + d.ctors.length + fs.length)).take
        (1 + d.ctors.length)).length := by
      simp only [List.length_take, length_metaVars, Nat.le_add_right, Nat.min_eq_left,
        add_lt_add_iff_left]
      omega
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlen, Option.getD_some,
      List.getD_eq_getElem?_getD, ← List.map_take, ← List.map_take, List.getElem?_map,
      List.getElem?_map, List.getElem?_eq_getElem hlen]
    rfl
  rw [iotaLeft_subst] at facts ⊢
  rw [iotaRight_subst] at right ⊢
  generalize hts : ((metaVars (1 + d.ctors.length + fs.length)).map
    fun t => (liftTm t).subst σ) = ts at facts right hhead ⊢
  have htsl : ts.length = 1 + d.ctors.length + fs.length := by
    rw [← hts, List.length_map, length_metaVars]
  rw [cinterp_appSpine] at right
  rw [cinterp_appSpine, cinterp_appSpine]
  rw [hhead] at right ⊢
  -- spine facts of the recursor's spine and of its constructor argument
  obtain ⟨⟨hτ, spine⟩, argFacts⟩ :=
    SpineFacts.constSpine (sum_rec_declared objectChurch hd.distinct hd.lamFree hd.new) facts
  have ctorFacts := argFacts (ts.take (1 + d.ctors.length)) _ [] rfl
  have eL : (ts.take (1 + d.ctors.length) ++
        [CTm.appSpine (.const k) (ts.drop (1 + d.ctors.length))]).map
        (cinterp (dataReading d) · ρ) =
      (ts.take (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ) ++
        [Ideal.appSpine ((dataReading d).const k)
          ((ts.drop (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ))] := by
    simp only [List.map_append, List.map_take, List.map_cons, cinterp_appSpine, cinterp_const,
        List.map_drop, List.map_nil]
  have eR : (ts.drop (1 + d.ctors.length) ++
        (Ideal.recFields (fs.map fieldFlag) (ts.drop (1 + d.ctors.length))).map
          (fun t => CTm.appSpine (.const d.recursor) (ts.take (1 + d.ctors.length) ++ [t]))).map
        (cinterp (dataReading d) · ρ) =
      (ts.drop (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ) ++
        (Ideal.recFields (fs.map fieldFlag)
          ((ts.drop (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ))).map
          (fun α => Ideal.appSpine ((dataReading d).const d.recursor)
            ((ts.take (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ) ++ [α])) := by
    rw [List.map_append, List.map_map, Ideal.recFields_map, List.map_map]
    congr 1
    apply List.map_congr_left
    intro t _
    simp only [Function.comp_apply, cinterp_appSpine, cinterp_const, List.map_append, List.map_take,
        List.map_cons, List.map_nil]
  have eH : (ts.map (cinterp (dataReading d) · ρ)).take (1 + d.ctors.length) =
      (ts.take (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ) := by
    rw [List.map_take]
  rw [eL] at spine hτ
  rw [cinterp_const, eL, eR, eH]
  rw [eR, eH] at right
  have hpre : ((ts.take (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ)).length =
      d.ctors.length + 1 := by
    simp only [List.map_take, List.length_take, List.length_map, htsl, Nat.le_add_right,
      Nat.min_eq_left]
    omega
  have hα : ((ts.drop (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ)).length =
      fs.length := by simp only [List.map_drop, List.length_drop, List.length_map, htsl,
          Nat.add_sub_cancel_left]
  have spinePre : SpineTyped (recTypeI d)
      ((ts.take (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ)) :=
    (Ideal.spineTyped_append.1 spine).1
  rw [recTypeI_prefix hpre spinePre, Ideal.dom_cpi, dataReading_type hd] at ctorFacts
  obtain ⟨⟨-, spineα⟩, -⟩ := SpineFacts.constSpine
    (sum_ctor_declared objectChurch hd.distinct hd.lamFree hd.new entry) ctorFacts
  rw [cinterp_ctorType hd (entry := (k, fs)) (List.mem_of_getElem? entry)] at spineα
  generalize (ts.take (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ) = pre
    at spine hτ right hpre spinePre ⊢
  generalize (ts.drop (1 + d.ctors.length)).map (cinterp (dataReading d) · ρ) = αs
    at spine hτ right hα spineα ⊢
  have hlen : (pre ++ [Ideal.appSpine ((dataReading d).const k) αs]).length ≤
      piArity (liftTm (recType d.type d.motiveUniverse d.ctors)) :=
    le_trans (by simp only [List.length_append, hpre, List.length_cons, List.length_nil, zero_add,
        Std.le_refl])
      (piArity_closeType (recEntry d.type d.motiveUniverse d.ctors) (d.ctors.length + 2)
        (recBody d.ctors.length))
  conv_lhs => rw [dataReading_recursor_eq hd]
  rw [← hτ] at right
  exact Ideal.churchConst_root (churchTele_cinterp _ _ _) hlen spine
    (recursor_at_ctor hd entry hpre hα spinePre spineα) right

end Iota


/-! ## The reading is valid -/

section Valid

variable {d : Datatype Tower.Head} (hd : d.Admissible objectChurch)
include hd

/-- **The root steps of the package are valid in the reading**: the object package's by its
schemas, the recursor's by its computation at a constructor. -/
theorem dataReading_roots {n : Nat} {l r : CTm Tower.Head n} {τ : Ideal} {ρ : Env n}
    (step : (dataChurch d).computation.step l r)
    (facts : SpineFacts (dataReading d) (dataChurch d) l τ ρ)
    (right : projT τ (cinterp (dataReading d) r ρ) = cinterp (dataReading d) r ρ) :
    cinterp (dataReading d) l ρ = cinterp (dataReading d) r ρ := by
  rcases step with step | step
  · exact dataReading_objectRoot hd step facts right
  · cases step with
    | instantiate rule σ =>
      obtain ⟨L, R', hS, rfl, rfl⟩ := rule
      obtain ⟨i, k, fields, entry, e⟩ := hS
      cases e
      have eL := elabLeft_firstOrder (elabDeclarations (inductiveRules (rulesWith objectRules [])
        d.type d.typeUniverse d.ctors d.recursor d.motiveUniverse).constantType)
        (firstOrder_iotaLeft d.recursor k d.ctors.length fields.length)
      have eR : elabRight (elabDeclarations (inductiveRules (rulesWith objectRules []) d.type
          d.typeUniverse d.ctors d.recursor d.motiveUniverse).constantType)
          (iotaLeft d.recursor k d.ctors.length fields.length)
          (iotaRight d.recursor d.ctors.length i fields) =
          liftTm (iotaRight d.recursor d.ctors.length i fields) :=
        elab_lamFree _ (lamFree_iotaRight _ _ i fields) _ _ _
      rw [eL] at facts ⊢
      rw [eR] at right ⊢
      exact dataReading_iota hd entry σ facts right

/-- **The reading validates the object package with an admissible declared datatype.** -/
theorem dataReading_valid : ReadingValid (dataReading d) (dataChurch d) :=
  ReadingValid.ofLevels (levelsWith ConvRules.objectLevels [.datatype d])
    (fun hu => objectChurchReading_valid.universes hu)
    (fun h => by
      cases h with
      | sort _ => exact Elem.ty_univ_univ
      | legacyGround => exact Elem.ty_tag (k := .ground) trivial Elem.isUniv_univ)
    (fun same => objectChurchReading_valid.headEq same)
    (fun declared _ => dataReading_constants hd declared)
    (fun step _ _ facts right _ => dataReading_roots hd step facts right)

/-- **A valid reading of the object package with an admissible declared datatype**, agreeing
with the object reading on the heads and on every constant of the object package. -/
theorem objectChurch_data_reading :
    ∃ Rd : Reading Tower.Head, Rd.head = objectChurchReading.head ∧
      (∀ c, (objectChurch.constantType c).isSome → Rd.const c = objectChurchReading.const c) ∧
      ReadingValid Rd (withDeclarations objectChurch [.datatype d]) :=
  ⟨dataReading d, rfl, fun _ h => dataReading_object hd (Option.isSome_iff_ne_none.1 h),
    dataReading_valid hd⟩

end Valid


/-! ## The lists of numbers -/

section Lists

/-- The empty list's kind. -/
abbrev nilK : Kind := .ctor listN nilN []

/-- The kind of a number before a list. -/
abbrev consK : Kind := .ctor listN consN [.param 0, .self]

theorem dataParams_listDecl : dataParams listDecl = [natI] := by
  show [cinterp objectChurchReading (.const numN : CTm Tower.Head 0) Env.nil] = [natI]
  rw [cinterp_const, objectChurchReading_num]

/-- The lists of numbers are the declared datatype `list` at the numbers. -/
theorem dataTypeI_listDecl : dataTypeI listDecl = ctorI (Kind.data listN) [natI] := by
  rw [dataTypeI, dataParams_listDecl]
  rfl

/-- **Positive**: the length of the one-element list of the numeral one denotes one. -/
theorem lengthOf_one_value :
    cinterp (dataReading listDecl) (lengthOf (ccons (csuc czero) cnil)) Env.nil = succI zeroI := by
  rw [CEqual.sound (dataReading_valid listDecl_admissible)
    (lengthOf_one : CEqual (dataChurch listDecl) _ _ _ _) (ρ := Env.nil) trivial]
  change Ideal.app ((dataReading listDecl).const sucN) ((dataReading listDecl).const zeroN) = _
  rw [dataReading_object listDecl_admissible (c := sucN)
      (objectChurch_constantType_ne_none (by decide)),
    dataReading_object listDecl_admissible (c := zeroN)
      (objectChurch_constantType_ne_none (by decide)),
    objectChurchReading_suc, objectChurchReading_zero,
    app_sucConst objectChurchReading numNames objectChurchReading_num, Ideal.projT_natI_zeroI]

/-- **Recursion over the lists at the empty list is its value there**: the recursor at a motive
into the numbers, zero at the empty list, any step and the empty list denotes zero, the step
being read only through its projection. -/
theorem listRec_nil_zero (s : Ideal) :
    Ideal.appSpine ((dataReading listDecl).const listRecN)
      [clam (dataTypeI listDecl) (fun _ => natI), zeroI, s, ctorI nilK []] = zeroI := by
  have hπ : projT (cpi (dataTypeI listDecl) fun _ => univIdeal)
      (clam (dataTypeI listDecl) fun _ => natI) = clam (dataTypeI listDecl) fun _ => natI :=
    Ideal.semTyped_clam (Ideal.Cont.const _) (Ideal.Cont.const _) fun _ _ =>
      Ideal.projT_univ_eq_self_iff.2 Ideal.typeGenerated_natI
  have happ : ∀ y, Ideal.app (clam (dataTypeI listDecl) fun _ => natI) y = natI :=
    Ideal.app_clam (Ideal.Cont.const _)
  have hnilT : projT (dataTypeI listDecl) (ctorI nilK []) = ctorI nilK [] :=
    Ideal.projT_data_ctorI fun _ _ h => by simp only [List.length_nil, not_lt_zero,
        not_false_eq_true, getElem?_neg, reduceCtorEq] at h
  have hnil : (dataReading listDecl).const nilN = ctorI nilK [] := by
    rw [dataReading_ctor listDecl_admissible (i := 0) rfl]
    exact appSpine_ctorConstI_proj (d := listDecl) nilN [] (αs := []) rfl
  have hlen : [clam (dataTypeI listDecl) (fun _ => natI), zeroI, s, ctorI nilK []].length ≤
      piArity (liftTm (recType listDecl.type listDecl.motiveUniverse listDecl.ctors)) :=
    piArity_closeType (recEntry listDecl.type listDecl.motiveUniverse listDecl.ctors) 4
      (recBody 2)
  have hT : (dataReading listDecl).const listN = dataTypeI listDecl :=
    dataReading_type listDecl_admissible
  show Ideal.appSpine ((dataReading listDecl).const listDecl.recursor) _ = _
  rw [dataReading_recursor_eq listDecl_admissible, Ideal.appSpine_projT _ (churchTele_cinterp _ _ _)
    hlen]
  have pa := projArgs_cinterp_ofEntries (dataReading listDecl)
    (recEntry listDecl.type listDecl.motiveUniverse listDecl.ctors) 4 (recBody 2)
    [clam (dataTypeI listDecl) (fun _ => natI), zeroI, s, ctorI nilK []] rfl
  have inst := instPi_cinterp_ofEntries (dataReading listDecl)
    (recEntry listDecl.type listDecl.motiveUniverse listDecl.ctors) 4 (recBody 2)
    [clam (dataTypeI listDecl) (fun _ => natI), zeroI, s, ctorI nilK []] rfl
  have hRT : cinterp (dataReading listDecl) (liftTm (TelescopeAbstraction.closeType
      (ofEntries (recEntry listDecl.type listDecl.motiveUniverse listDecl.ctors) 4) (recBody 2)))
      Env.nil = recTypeI listDecl := rfl
  rw [hRT] at pa inst
  change projT (instPi (recTypeI listDecl) _) (Ideal.appSpine _ (projArgs (recTypeI listDecl) _)) =
    zeroI
  have hlenP : (projArgs (recTypeI listDecl)
      [clam (dataTypeI listDecl) (fun _ => natI), zeroI, s, ctorI nilK []]).length = 4 := by
    rw [length_projArgs]; rfl
  obtain ⟨x₀, x₁, x₂, x₃, hx⟩ : ∃ x₀ x₁ x₂ x₃, projArgs (recTypeI listDecl)
      [clam (dataTypeI listDecl) (fun _ => natI), zeroI, s, ctorI nilK []] = [x₀, x₁, x₂, x₃] := by
    generalize projArgs (recTypeI listDecl) _ = l at hlenP
    match l, hlenP with
    | [x₀, x₁, x₂, x₃], _ => exact ⟨x₀, x₁, x₂, x₃, rfl⟩
  rw [hx] at pa inst ⊢
  have p₀ := pa 0 (by decide)
  have p₁ := pa 1 (by decide)
  have p₃ := pa 3 (by decide)
  simp only [List.getElem?_cons_zero, List.getElem?_cons_succ, List.take_zero, List.take_succ_cons,
    List.getD_cons_zero, List.getD_cons_succ, Option.some.injEq] at p₀ p₁ p₃
  have hu : objectChurchReading.head listMotives = Elem.univ :=
    objectChurchReading_valid.universes (LevelTower.IsUniverse.sort _)
  have hx₀ : x₀ = clam (dataTypeI listDecl) fun _ => natI := by
    rw [p₀]
    show projT (cpi ((dataReading listDecl).const listN)
      fun _ => principal (objectChurchReading.head listMotives)) _ = _
    rw [hu, hT]
    exact hπ
  have hx₃ : x₃ = ctorI nilK [] := by
    rw [p₃]
    show projT ((dataReading listDecl).const listN) _ = _
    rw [hT]
    exact hnilT
  have hx₁ : x₁ = zeroI := by
    rw [p₁]
    show projT (Ideal.app (Env.ofArgs 1 [x₀] 0) ((dataReading listDecl).const nilN)) zeroI = _
    rw [show Env.ofArgs 1 [x₀] 0 = x₀ from rfl, hx₀, happ]
    exact Ideal.projT_natI_zeroI
  subst hx₀ hx₁ hx₃
  have hcs : (dataCs listDecl)[0]? = some (nilK, []) := rfl
  rw [appSpine_curryI (contEach_recH _) (listDecl.ctors.length + 2) [] _ rfl, List.reverse_nil,
    List.nil_append]
  show projT (instPi (recTypeI listDecl) _) (recI (dataCs listDecl)
    (methodsAt _ (dataCs listDecl) [zeroI, x₂, ctorI nilK []]) (ctorI nilK [])) = zeroI
  rw [Ideal.recI_ctorI (contList_methodsAt _ _ _) (List.mem_of_getElem? hcs)
      (dataCs_nodup listDecl listDecl_admissible.distinct.ctorsNodup) (xs := []) rfl,
    methodsAt_getElem _ _ (dataCs_nodup listDecl listDecl_admissible.distinct.ctorsNodup) hcs, inst]
  show projT (Ideal.app (clam (dataTypeI listDecl) fun _ => natI) (ctorI nilK []))
    (caseValue _ zeroI [] []) = zeroI
  rw [happ]
  exact Ideal.projT_natI_zeroI

/-- `cons` read as the constant function to the empty list, projected onto its declared type. -/
def badConsConst : Ideal :=
  projT (arrowsI [natI, dataTypeI listDecl] (dataTypeI listDecl))
    (Ideal.lam fun _ => Ideal.lam fun _ => ctorI nilK [])

/-- The reading with that `cons`. -/
def badConsReading : Reading Tower.Head where
  head := objectChurchReading.head
  const c := if c = consN then badConsConst else (dataReading listDecl).const c

theorem badConsReading_of_ne {c : DeclName} (h : c ≠ consN) :
    badConsReading.const c = (dataReading listDecl).const c :=
  if_neg h

/-- That `cons` is an element of its declared type, and sends every number and list to the
empty list. -/
theorem app_badCons (a l : Ideal) : Ideal.app (Ideal.app badConsConst a) l = ctorI nilK [] := by
  unfold badConsConst
  simp only [arrowsI]
  rw [Ideal.app_projT_cpi (Ideal.Cont.const _), Ideal.app_projT_cpi (Ideal.Cont.const _),
    Ideal.app_lam_const, Ideal.app_lam_const]
  exact Ideal.projT_data_ctorI fun _ _ h => by simp only [List.length_nil, not_lt_zero,
      not_false_eq_true, getElem?_neg, reduceCtorEq] at h

theorem badCons_typed :
    projT (arrowsI [natI, dataTypeI listDecl] (dataTypeI listDecl)) badConsConst = badConsConst :=
  Ideal.projT_projT _ _

/-- **Negative: reading `cons` as the constant function to the empty list is not valid.** The
length of the one-element list of one is then the length of the empty list, zero, while the
recursor's rule at `cons` makes it one. -/
theorem badCons_not_valid : ¬ ReadingValid badConsReading (dataChurch listDecl) := by
  intro valid
  have e := CEqual.sound valid (lengthOf_one : CEqual (dataChurch listDecl) _ _ _ _)
    (ρ := Env.nil) trivial
  have hlist : badConsReading.const listN = dataTypeI listDecl := by
    rw [badConsReading_of_ne (by decide)]
    exact dataReading_type listDecl_admissible
  have hnum : badConsReading.const numN = natI := by
    rw [badConsReading_of_ne (by decide), dataReading_object listDecl_admissible
      (objectChurch_constantType_ne_none (c := numN) (by decide)), objectChurchReading_num]
  have hzero : badConsReading.const zeroN = zeroI := by
    rw [badConsReading_of_ne (by decide), dataReading_object listDecl_admissible
      (objectChurch_constantType_ne_none (c := zeroN) (by decide)), objectChurchReading_zero]
  have hsuc : badConsReading.const sucN = sucConst objectChurchReading numNames := by
    rw [badConsReading_of_ne (by decide), dataReading_object listDecl_admissible
      (objectChurch_constantType_ne_none (c := sucN) (by decide)), objectChurchReading_suc]
  change Ideal.app (Ideal.app (Ideal.app (Ideal.app (badConsReading.const listRecN)
      (clam (badConsReading.const listN) fun _ => badConsReading.const numN))
      (badConsReading.const zeroN)) (cinterp badConsReading lenStep Env.nil))
      (Ideal.app (Ideal.app (badConsReading.const consN)
        (Ideal.app (badConsReading.const sucN) (badConsReading.const zeroN)))
        (badConsReading.const nilN)) =
    Ideal.app (badConsReading.const sucN) (badConsReading.const zeroN) at e
  have hcons : badConsReading.const consN = badConsConst := by
    simp only [badConsReading, if_true]
  rw [hcons, app_badCons, hlist, hnum, hzero, hsuc,
    app_sucConst objectChurchReading numNames objectChurchReading_num,
    Ideal.projT_natI_zeroI, badConsReading_of_ne (by decide)] at e
  have h := listRec_nil_zero (cinterp badConsReading lenStep Env.nil)
  change Ideal.app (Ideal.app (Ideal.app (Ideal.app ((dataReading listDecl).const listRecN) _) _) _)
    _ = _ at h
  rw [h] at e
  exact Ideal.succI_not_mem_tag (by decide) zeroI (e ▸ Ideal.zeroI_mem_zero)

end Lists

