/-- **The types of a constructor's field shapes are the types of its fields.** -/
theorem dataShapes_typeI {i : Nat} {k : DeclName} {fs : List CtorField}
    (h : d.ctors[i]? = some (k, fs)) :
    (fieldShapes (paramTypes (d.ctors.take i)).length fs).map
        (FieldShape.typeI d.type (dataParams d)) = fs.map (fieldTypeI d) := by
  rw [fieldShapes_typeI d.type (dataParams d)
    (fun F => cinterp objectChurchReading (liftTm F) Env.nil) _ fs fun q F hq => ?_]
  · congr 1
  · have hq' : q < (closedTypes fs).length := by
      rcases Nat.lt_or_ge q (closedTypes fs).length with hlt | hge
      · exact hlt
      · rw [List.getElem?_eq_none hge] at hq; cases hq
    rw [dataParams, paramTypes_split h, List.map_append, List.map_append, List.append_assoc,
      List.getElem?_append_right (by simp only [List.length_map,
          Nat.le_add_right]), List.length_map, Nat.add_sub_cancel_left,
      List.getElem?_append_left (by simpa only [List.length_map] using hq'), List.getElem?_map, hq]
    rfl

