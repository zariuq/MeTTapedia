/-- Machine-readable remaining choices. This computes the recorded selection
state; it is not a theorem that mathematics can never settle those choices. -/
def unselected : List Decision :=
  decisions.filter (fun decision => (study decision).selection.isNone)

def investigations : List (Decision × Investigation) :=
  decisions.flatMap (fun decision => (study decision).remaining.map (decision, ·))

/-- A real partial assembly already proved in the library: one query-first
model supplies the language relation environment and the same answer bag,
decorated by value-level causal receipts under a supplied revision encoding.
This does not prove injectivity of that encoding, occurrence identity of
equal receipts, native revision validation, or a full candidate assembly. -/
def queryFirstAssemblyEvidence : CheckedClaim :=
  checked "ASM-001" "query-first request/rewrite bag compatibility on one model"
    LanguageDefAdequacy.need_rewrite_bag_adequate

/-- Two semantic predicates hold on one independently authored native
handler/world pair at every target scope. This is a scoped computation
assembly, not yet a joint interpretation of J, a host and a demand machine. -/
def scopedComputationEvidence : CheckedClaim :=
  checked "ASM-SCOPED-001" "inhabited shared native realization/admission requirements"
    ImplementationStudy.Native.qualified

/-- Stable navigation keys remain separate from statements and proof terms.
The requirement links above are normative provenance, not extra hypotheses
silently supplied to these proofs. -/
def claims : List CheckedClaim :=
  decisions.flatMap (fun decision => (study decision).constraints) ++
    [queryFirstAssemblyEvidence, scopedComputationEvidence, contextualDescentEvidence,
      specializedChartEvidence, revisionViewsEvidence, matchedTransportEvidence,
      uniformHostServiceEvidence, cognitiveWorkloadEvidence, sharedJudgmentEvidence,
      operationalServiceEvidence, nativeHOLMeaningEvidence, nativeMatchingMeaningEvidence,
      nestedServiceEvidence, retainedSemanticEvidence]

def findClaim? (id : String) : Option CheckedClaim :=
  claims.find? (fun claim => claim.id == id)

theorem claim_ids_unique : (claims.map CheckedClaim.id).Nodup := by
  decide +kernel

theorem requirement_ids_unique :
    (requirementReferences.map RequirementReference.id).Nodup := by decide

/-- Registry integrity only: resolving a normative reference does not prove
that a scoped theorem entails that requirement or chooses an architecture. -/
theorem requirement_references_resolve :
    ∀ decision ∈ decisions, ∀ id ∈ (study decision).requirementIds,
      id ∈ requirementReferences.map RequirementReference.id := by decide

/-- Source-ID resolution for the collected native semantic interface only;
the referenced desiderata are not silently promoted to necessity proofs. -/
theorem shared_semantic_references_resolve :
    ∀ requirement ∈ SharedJudgmentSemanticRequirements.requirements,
      ∀ id ∈ SharedJudgmentSemanticRequirements.Requirement.references requirement,
        id ∈ requirementReferences.map RequirementReference.id := by decide

theorem shared_declaration_references_resolve :
    ∀ requirement ∈ SharedJudgmentSemanticRequirements.declarationRequirements,
      ∀ id ∈ SharedJudgmentSemanticRequirements.DeclarationRequirement.references requirement,
        id ∈ requirementReferences.map RequirementReference.id := by decide

theorem retained_semantic_references_resolve :
    ∀ requirement ∈ SharedJudgmentRetainedSemanticRequirements.requirements,
      ∀ id ∈ SharedJudgmentRetainedSemanticRequirements.Requirement.references requirement,
        id ∈ requirementReferences.map RequirementReference.id := by decide

/-- The scoped identity direction has been selected for development; the
other five families have no selection record. This checks recorded policy,
not the missing qualification obligations listed by that record. -/
theorem identity_direction_selected :
    (study .identity).selection.isSome = true := by decide

theorem unselected_families :
    unselected = [.observation, .admission, .evaluation, .mathematicalHost, .reasoning] := by
  decide

