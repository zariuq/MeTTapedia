inductive Decision where
  | observation
  | identity
  | admission
  | evaluation
  | mathematicalHost
  | reasoning
  deriving DecidableEq, Repr

def decisions : List Decision :=
  [.observation, .identity, .admission, .evaluation, .mathematicalHost, .reasoning]

/-- A normative reference identifies a requirement or an unresolved question,
not a theorem. Its version prevents a later use from silently changing the
meaning of a historical identifier. The public document and section/entry
identifiers locate the maintained source; the statement is only a summary.
Neither provenance, identifier resolution nor a summary establishes semantic
coverage, ratification or satisfaction of the requirement. -/
structure RequirementReference where
  id : String
  version : String
  statement : String
  document : String
  locus : String
  deriving Repr

