/-- The statement is stored with its proof, not represented by a theorem-name
string. The label is only a navigation aid. This packages existing results;
it is not another proof of their mathematical content. -/
structure CheckedClaim where
  id : String
  label : String
  statement : Prop
  proof : statement

def checked {statement : Prop} (id label : String) (proof : statement) : CheckedClaim :=
  ⟨id, label, statement, proof⟩

inductive InvestigationKind where
  | semanticRequirement
  | compatibilityProof
  | comparison
  | experiment
  deriving DecidableEq, Repr

structure Investigation where
  kind : InvestigationKind
  question : String
  discriminator : String
  deriving Repr

/-- A selection records a development direction, not semantic qualification
or a final language adoption. Its versioned target and remaining proof
obligations are explicit; a folder or an implementation never selects it. -/
structure Selection where
  assembly : String
  rationale : String
  decisionRecord : String
  scope : String
  pendingQualification : List String
  reconsiderWhen : List String
  deriving Repr

structure Study where
  requirementIds : List String
  requirement : String
  scope : String
  alternatives : List String
  constraints : List CheckedClaim
  selection : Option Selection
  remaining : List Investigation

/-- Actual object substitution and admitted raw/refined families share one
declared code view. The arity-changing J control shows the substitution
premises are inhabited; the retained-level control excludes universal descent.
This records the scoped view contract, not an identity-theory selection. -/
def contextualDescentEvidence : CheckedClaim :=
  checked "VIEW-003" "actual substitution and admitted contextual J descent"
    (And.intro (@substitution_admitted_descent_and_refinedJ)
      (And.intro weakened_refined_identity_control selectedLevel_refuses_code_view))

/-- The eligible class is the independently stated registered atom/unary-spine
grammar, not all first-order or propositional formulas. Generic recognition
and HOL reconstruction accompany concrete certificate-node counts and the
unchanged induction dependency. These counts make no runtime speed claim. -/
def specializedChartEvidence : CheckedClaim :=
  checked "VIEW-005" "qualified equational chart with retained uniform HOL proof"
    (And.intro (@GroundUnaryEquationalChart.eligible_complete.{0, 0})
      (And.intro (@GroundUnaryEquationalChart.accepts_reconstruct.{0, 0})
        (And.intro (UniformListInductionChart.mapLength_via_chart [])
          (And.intro (UniformListInductionChart.base_certificate_nodes [])
            (And.intro (UniformListInductionChart.step_certificate_nodes [])
              UniformListInductionChart.chart_leaves_do_not_replace_induction)))))

/-- Actual HOL contexts and revisioned premise tables distinguish all four
view contracts. The erasure countermodel is closed-context; the cons-step
and live-source contracts retain their ambient context. No physical cache or
candidate-native proof admission follows from this qualification. -/
def revisionViewsEvidence : CheckedClaim :=
  checked "VIEW-006" "four view contracts on revision-bound HOL induction"
    (And.intro (@UniformListInductionRevisionViews.Induction.four_view_contracts)
      (@UniformListInductionRevisionViews.Induction.stale_retained_source_is_not_live))

/-- Actual completed matched-index replies are consumed and reconstructed as
native J terms under the common Data/List/J/relator rules. The native motive
depends on the selected endpoint; neither a native Fin implementation nor an
identity proof made by casting a receipt is asserted. -/
def matchedTransportEvidence : CheckedClaim :=
  checked "ASM-002" "executed selected-match evidence reconstructs admitted dependent transport"
    (And.intro (@Mettapedia.Languages.MeTTa.PrimeCandidates.DeclarationBased.MatchedIndexDependentTransport.observed_transport)
      (And.intro (@Mettapedia.Languages.MeTTa.PrimeCandidates.DeclarationBased.MatchedIndexDependentTransport.reconstruct_qualified)
