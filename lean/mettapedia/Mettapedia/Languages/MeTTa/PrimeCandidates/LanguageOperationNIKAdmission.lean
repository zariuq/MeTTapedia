import Mettapedia.Languages.MeTTa.PrimeCandidates.LanguageOperationFactorization
import Mettapedia.GSLT.LanguageDef.NIKRepresentedRouteObservation

/-!
# candidate language operations as observed NIK refinements

The selected candidate language-operation syntax already has one exact decoded
free path, an operational GSLT-IL route, and an executable Data action.  This
module connects that typed route to NIK admission at the semantic execution
level.

Every decoded program induces an operational refinement between the
equation-quotiented endpoint theories.  The generic target meaning is the
direct image of a chosen source meaning, while the concrete Zero-to-candidate
request route also preserves an independently stated target predicate.  The
declared observation records the exact target endpoint of each complete
execution path.

Admissions are revision-indexed and compose through the common-current law.
The negative observation control shows why endpoint typing alone cannot mint
an observed refinement square.
-/

namespace Mettapedia.Languages.MeTTa.PrimeCandidates.LanguageOperationNIKAdmission

open Mettapedia.GSLT
open Mettapedia.GSLT.Ultrainfinite
open Mettapedia.GSLT.IndexedOperational
open Mettapedia.GSLT.Dynamics.ExecutionPathObservation
open Mettapedia.GSLT.LanguageDef.NIKRouteAdmission
open Mettapedia.GSLT.LanguageDef.NIKObservedRefinement
open Mettapedia.GSLT.LanguageDef.NIKRevisionAlignedComposition
open Mettapedia.Languages.MeTTa.PrimeCandidates.IndexedLanguageChange
open Mettapedia.Languages.MeTTa.PrimeCandidates.LanguageOperationSyntax
open Mettapedia.Languages.MeTTa.PrimeCandidates.LanguageOperationFactorization

abbrev CandidateModel :=
  Mettapedia.Languages.MeTTa.PrimeCandidates.Language.QueryFirstModel

/-! ## Generic typed-route refinement -/

abbrev StateAt (model : CandidateModel) (language : Language) :=
  SemanticTerm ((diagram model).obj (operationStage language)).theory

abbrev SemanticTheoryAt (model : CandidateModel) (language : Language) :=
  semanticTheory ((diagram model).obj (operationStage language)).theory

/-- The exact semantic-state action of one typed language-operation program. -/
def programTranslation (model : CandidateModel)
    {source target : Language} (program : Program source target) :
    OperationalTranslation (SemanticTheoryAt model source)
      (SemanticTheoryAt model target) :=
  ((diagram model).map (gsltInterpretation.map program)).onSemanticTheories

@[simp] theorem programTranslation_mapTerm (model : CandidateModel)
    {source target : Language} (program : Program source target) :
    (programTranslation model program).mapTerm =
      transportTerm (diagram model) (gsltInterpretation.map program) :=
  rfl

/-- The target meaning generated by pushing a selected source meaning through
one typed route.  The source witness remains proof-relevant. -/
def ImageMeaning (model : CandidateModel)
    {source target : Language} (program : Program source target)
    (sourceMeaning : StateAt model source → Prop)
    (targetState : StateAt model target) : Prop :=
  (programTranslation model program).ImageMeaning sourceMeaning targetState

def sourceObject (model : CandidateModel) (source : Language)
    (meaning : StateAt model source → Prop) : OperationalObject :=
  OperationalObject.ofMeaning (SemanticTheoryAt model source) meaning

def targetImageObject (model : CandidateModel)
    {source target : Language} (program : Program source target)
    (sourceMeaning : StateAt model source → Prop) : OperationalObject :=
  (programTranslation model program).targetImageObject sourceMeaning

/-- Every typed route preserves the direct image of an arbitrary selected
source meaning. -/
def programRefinement (model : CandidateModel)
    {source target : Language} (program : Program source target)
    (sourceMeaning : StateAt model source → Prop) :
    Refinement (sourceObject model source sourceMeaning)
      (targetImageObject model program sourceMeaning) :=
  (programTranslation model program).imageRefinement sourceMeaning

/-- Observe a source execution by the exact target endpoint produced by the
typed route. -/
def sourceObserved (model : CandidateModel)
    {source target : Language} (program : Program source target)
    (sourceMeaning : StateAt model source → Prop) :
    ObservedOperationalObject (StateAt model target) where
  operational := sourceObject model source sourceMeaning
  observe := fun {_ last} _ =>
    some (transportTerm (diagram model) (gsltInterpretation.map program) last)

/-- At the target, observe the exact endpoint directly. -/
def targetImageObserved (model : CandidateModel)
    {source target : Language} (program : Program source target)
    (sourceMeaning : StateAt model source → Prop) :
    ObservedOperationalObject (StateAt model target) where
  operational := targetImageObject model program sourceMeaning
  observe := fun {_ last} _ => some last

/-- The typed route forms a compiler-correctness square for exact final-state
observation. -/
def programObservedRefinement (model : CandidateModel)
    {source target : Language} (program : Program source target)
    (sourceMeaning : StateAt model source → Prop) :
    ObservedRefinement (sourceObserved model program sourceMeaning)
      (targetImageObserved model program sourceMeaning) where
  refinement := programRefinement model program sourceMeaning
  commutes := by
    intro first last path
    rfl

/-- Store the full typed-route refinement square at any dependency revision. -/
def admitProgram (dependencies : DependencySystem)
    (revision : dependencies.Revision) (model : CandidateModel)
    {source target : Language} (program : Program source target)
    (sourceMeaning : StateAt model source → Prop) :
    ObservedAdmittedAt dependencies revision
      (sourceObserved model program sourceMeaning)
      (targetImageObserved model program sourceMeaning) :=
  ⟨programObservedRefinement model program sourceMeaning⟩

/-- The NIK refinement uses the same operational route retained by the
factorized compiled action. -/
theorem decoded_refinement_uses_compiled_route (model : CandidateModel)
    (decoded : currentOperationSignature.DecodedProgram)
    (sourceMeaning : StateAt model decoded.source → Prop) :
    (programRefinement model decoded.program sourceMeaning).realization.mapTerm =
      transportTerm (diagram model)
        (CurrentExecution.actionOfDecoded decoded).operationalRoute :=
  rfl

/-! ## Independent request-predicate refinement -/

def requestSourceObject (model : CandidateModel) : OperationalObject where
  theory := SemanticTheoryAt model .zero
  Meaning := IsZeroEvaluationRequest model

def requestTargetObject (model : CandidateModel) : OperationalObject where
  theory := SemanticTheoryAt model .prime
  Meaning := IsCandidateBaseRequest model

/-- The selected promotion preserves an independently authored request class,
not only a target predicate defined as its direct image. -/
def requestPromotionRefinement (model : CandidateModel) :
    Refinement (requestSourceObject model) (requestTargetObject model) where
  realization := OperationalRealization.ofTranslation
    (programTranslation model promoteProgram)
  preservesMeaning := by
    intro state request
    exact (requestPromotionAdmission model).preserves state request

def requestSourceObserved (model : CandidateModel) :
    ObservedOperationalObject (StateAt model .prime) where
  operational := requestSourceObject model
  observe := fun {_ last} _ =>
    some (transportTerm (diagram model) promote last)

def requestTargetObserved (model : CandidateModel) :
    ObservedOperationalObject (StateAt model .prime) where
  operational := requestTargetObject model
  observe := fun {_ last} _ => some last

def requestPromotionObservedRefinement (model : CandidateModel) :
    ObservedRefinement (requestSourceObserved model)
      (requestTargetObserved model) where
  refinement := requestPromotionRefinement model
  commutes := by
    intro first last path
    rfl

def admitRequestPromotion (dependencies : DependencySystem)
    (revision : dependencies.Revision) (model : CandidateModel) :
    ObservedAdmittedAt dependencies revision
      (requestSourceObserved model) (requestTargetObserved model) :=
  ⟨requestPromotionObservedRefinement model⟩

/-- The independently stated request predicate survives the exact same direct
map used by the GSLT-IL command. -/
theorem admitted_request_is_prime_request (model : CandidateModel)
    (space : model.Space) (subject : Mettapedia.OSLF.MeTTaIL.Syntax.Pattern) :
    (requestTargetObject model).Meaning
      ((requestPromotionRefinement model).realization.mapTerm
        (quoteZero model (zeroEvaluationRequest model space subject))) :=
  concrete_request_is_admitted_after_promotion model space subject

/-! ## Revision composition and observation negatives -/

namespace Canary

def dependencies : DependencySystem where
  Revision := Bool × Bool
  Dependency := Unit
  Value := Bool
  read revision _ := revision.1

theorem irrelevant_change :
    dependencies.SameDependencies (false, false) (false, true) := by
  intro dependency
  cases dependency
  rfl

theorem alignment : CommonCurrent dependencies (false, false) (false, true)
    (false, true) :=
  ⟨irrelevant_change, dependencies.sameDependencies_refl (false, true)⟩

def requestAdmission (model : CandidateModel) :=
  admitRequestPromotion dependencies (false, false) model

def targetIdentityAdmission (model : CandidateModel) :
    ObservedAdmittedAt dependencies (false, true)
      (requestTargetObserved model) (requestTargetObserved model) :=
  ObservedAdmittedAt.id dependencies (false, true)
    (requestTargetObserved model)

theorem activePromotionThenIdentity (model : CandidateModel) :
    (ObservedAdmission.compAtCommonCurrent
      (requestAdmission model) (targetIdentityAdmission model) alignment).Active
        (false, true) :=
  ObservedAdmission.activateComposite (requestAdmission model)
    (targetIdentityAdmission model) alignment

/-- A typed language operation admitted at one revision composes with a
separately admitted native stage at an irrelevant later revision. -/
theorem aligned_request_route_runs_directly (model : CandidateModel)
    (state : StateAt model .zero) :
    (activePromotionThenIdentity model).run state =
      transportTerm (diagram model) promote state :=
  rfl

def wrongSourceObservation (model : CandidateModel) :
    ObservedOperationalObject Bool where
  operational := requestSourceObject model
  observe := fun _ => some false

def wrongTargetObservation (model : CandidateModel) :
    ObservedOperationalObject Bool where
  operational := requestTargetObject model
  observe := fun _ => some true

/-- Even a well-typed endpoint map cannot become an observed NIK refinement
for an incompatible declared observation. -/
theorem no_wrong_observation_square (model : CandidateModel)
    (state : StateAt model .zero) :
    ¬ Nonempty
        (ObservedRefinement (wrongSourceObservation model)
          (wrongTargetObservation model)) := by
  rintro ⟨refinement⟩
  have impossible := refinement.commutes
    (.refl state : ExecutionPath (SemanticTheoryAt model .zero) state state)
  simp [wrongSourceObservation, wrongTargetObservation] at impossible

theorem relevant_change_has_no_alignment :
    ¬ ∃ currentRevision,
      CommonCurrent dependencies (false, false) (true, false)
        currentRevision := by
  intro alignment
  have same := (CommonCurrent.exists_iff_sameDependencies (dependencies := dependencies)
    (earlierRevision := (false, false)) (laterRevision := (true, false))).mp alignment
  have changed := same ()
  simp [dependencies] at changed

end Canary

