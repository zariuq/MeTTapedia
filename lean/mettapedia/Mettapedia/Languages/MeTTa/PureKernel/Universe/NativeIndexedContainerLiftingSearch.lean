import Mettapedia.TypeTheory.IndexedContainer
import Mettapedia.Languages.MeTTa.PureKernel.Universe.IntrinsicMILNativeLiftingSearch

/-!
# Native relation lifting and search generated by indexed containers

An indexed-container description determines more than an induction principle.
It generates a proof-relevant relation lifting: related values have the same
structural shape and one element-relation witness at every parameter position.
This lifting preserves identity and relational composition exactly, so it is a
native higher-order-programming capability rather than a datatype-specific
checker case.

Every container also preserves functional representations.  Exact finite
search requires the separate `Finitary` capability.  The List and Vector
containers possess it; the positive natural-number reader does not.  Thus NIK
can select the strongest construction justified by a checked family
description without treating absence of finitarity as rejection.

This module starts from a semantic indexed-container description.  Proving
that an authored strictly-positive declaration elaborates to such a
description is a separate source-adequacy theorem.
-/

namespace Mettapedia.Languages.MeTTa.PureKernel.Universe
namespace NativeIndexedContainerLiftingSearch

open Mettapedia.TypeTheory
open Mettapedia.GSLT.LooseRelationEquipment
open RelationalInternalLanguage.Semantic
open RelationalEvidence
open IntrinsicMILNativeSearch
open IntrinsicMILNativeLiftingSearch
open NativeRelationLifting

universe u

variable {Output : Type u}

abbrev ProofRel := RelationalInternalLanguage.Semantic.Rel

/-! ## The generated proof-relevant relator -/

/-- Proof-relevant relation lifting generated by an indexed container.  The
constructor retains the common shape and every position witness. -/
inductive LiftEvidence
    (container : IndexedContainer.{u, u, u} Output)
    {Source Target : Type u} (relation : Source → Target → Type u)
    {output : Output} :
    container.Extension Source output →
      container.Extension Target output → Type u where
  | same {shape : container.Shape output}
      {source : container.Position shape → Source}
      {target : container.Position shape → Target}
      (pointwise : ∀ position, relation (source position) (target position)) :
      LiftEvidence container relation ⟨shape, source⟩ ⟨shape, target⟩

instance instSubsingletonLiftEvidence
    (container : IndexedContainer.{u, u, u} Output)
    {Source Target : Type u} {relation : Source → Target → Type u}
    [fibres : ∀ source target, Subsingleton (relation source target)]
    {output : Output} {source : container.Extension Source output}
    {target : container.Extension Target output} :
    Subsingleton (LiftEvidence container relation source target) where
  allEq first second := by
    cases first with
    | same firstPointwise =>
        cases second with
        | same secondPointwise =>
            congr 1
            funext position
            exact Subsingleton.elim _ _

/-- Lift a Prime semantic relation through an indexed container at one output
index. -/
def liftRelation
    (container : IndexedContainer.{u, u, u} Output) (output : Output)
    {Source Target : Type u} (relation : ProofRel Source Target) :
    ProofRel (container.Extension Source output)
      (container.Extension Target output) where
  evidence := LiftEvidence container relation.evidence

/-- Pointwise equivalences induce an exact equivalence between the generated
container proof fibres. -/
def liftEvidenceEquiv
    (container : IndexedContainer.{u, u, u} Output)
    {Source Target : Type u} {first second : Source → Target → Type u}
    (equivalence : ∀ source target, first source target ≃ second source target)
    {output : Output} (source : container.Extension Source output)
    (target : container.Extension Target output) :
    LiftEvidence container first source target ≃
      LiftEvidence container second source target where
  toFun evidence := by
    cases evidence with
    | same pointwise =>
        exact .same (fun position =>
          equivalence _ _ (pointwise position))
  invFun evidence := by
    cases evidence with
    | same pointwise =>
        exact .same (fun position =>
          (equivalence _ _).symm (pointwise position))
  left_inv := by
    intro evidence
    cases evidence with
    | same pointwise =>
        simp only
        congr 1
        funext position
        exact (equivalence _ _).symm_apply_apply (pointwise position)
  right_inv := by
    intro evidence
    cases evidence with
    | same pointwise =>
        simp only
        congr 1
        funext position
        exact (equivalence _ _).apply_symm_apply (pointwise position)

/-! ## Identity and composition -/

/-- The lifted identity fibre is exactly equality of whole container values. -/
def identityEquiv
    (container : IndexedContainer.{u, u, u} Output) (output : Output)
    (Object : Type u) (source target : container.Extension Object output) :
    (liftRelation container output (Rel.graph id)).evidence source target ≃
      (Rel.graph id).evidence source target where
  toFun evidence := by
    cases evidence with
    | same pointwise =>
        exact ⟨⟨Sigma.ext rfl (heq_of_eq (funext fun position =>
          (pointwise position).down.down))⟩⟩
  invFun equal := by
    cases equal.down.down
    rcases source with ⟨shape, values⟩
    exact .same (fun _ => ⟨⟨rfl⟩⟩)
  left_inv := by
    intro evidence
    letI : ∀ (left right : Object),
        Subsingleton ((Rel.graph id).evidence left right) :=
      fun _ _ => instSubsingletonEqWitness _ _
    exact @Subsingleton.elim
      (LiftEvidence container (Rel.graph id).evidence source target)
      (instSubsingletonLiftEvidence container) _ evidence
  right_inv := fun equal => (instSubsingletonEqWitness _ _).allEq _ equal

/-- Split pointwise composite evidence into one complete intermediate
container and the two lifted derivations. -/
def splitChain
    (container : IndexedContainer.{u, u, u} Output) {output : Output}
    {First Middle Last : Type u}
    (earlier : ProofRel First Middle) (later : ProofRel Middle Last)
    {source : container.Extension First output}
    {target : container.Extension Last output} :
    LiftEvidence container (Rel.Chain earlier later).evidence source target →
      (Sigma fun middle : container.Extension Middle output =>
        LiftEvidence container earlier.evidence source middle ×
          LiftEvidence container later.evidence middle target)
  | .same pointwise =>
      ⟨⟨_, fun position => (pointwise position).1⟩,
        .same (fun position => (pointwise position).2.1),
        .same (fun position => (pointwise position).2.2)⟩

/-- Fuse two lifted derivations through their exact shared intermediate
container into pointwise composite evidence. -/
def mergeChain
    (container : IndexedContainer.{u, u, u} Output) {output : Output}
    {First Middle Last : Type u}
    (earlier : ProofRel First Middle) (later : ProofRel Middle Last)
    {source : container.Extension First output}
    {target : container.Extension Last output}
    (evidence : (Sigma fun middle : container.Extension Middle output =>
      LiftEvidence container earlier.evidence source middle ×
        LiftEvidence container later.evidence middle target)) :
      LiftEvidence container (Rel.Chain earlier later).evidence source target := by
  rcases evidence with ⟨middle, first, second⟩
  cases first with
  | same first =>
      cases second with
      | same second =>
          exact .same (fun position =>
            ⟨_, first position, second position⟩)

theorem mergeChain_splitChain
    (container : IndexedContainer.{u, u, u} Output) {output : Output}
    {First Middle Last : Type u}
    (earlier : ProofRel First Middle) (later : ProofRel Middle Last)
    {source : container.Extension First output}
    {target : container.Extension Last output}
    (evidence : LiftEvidence container
      (Rel.Chain earlier later).evidence source target) :
    mergeChain container earlier later
      (splitChain container earlier later evidence) = evidence := by
  cases evidence with
  | same pointwise =>
      congr 1

theorem splitChain_mergeChain
    (container : IndexedContainer.{u, u, u} Output) {output : Output}
    {First Middle Last : Type u}
    (earlier : ProofRel First Middle) (later : ProofRel Middle Last)
    {source : container.Extension First output}
    {target : container.Extension Last output}
    (evidence : Sigma fun middle : container.Extension Middle output =>
      LiftEvidence container earlier.evidence source middle ×
        LiftEvidence container later.evidence middle target) :
    splitChain container earlier later
      (mergeChain container earlier later evidence) = evidence := by
  rcases evidence with ⟨middle, first, second⟩
  cases first
  cases second
  rfl

/-- Indexed containers generate compositional proof-relevant relation
liftings. -/
def compositionalLiftingAt
    (container : IndexedContainer.{u, u, u} Output) (output : Output) :
    CompositionalLifting (fun Object : Type u =>
      container.Extension Object output) where
  lift := liftRelation container output
  identity := identityEquiv container output
  chain := by
    intro First Middle Last earlier later source target
    exact
      { toFun := splitChain container earlier later
        invFun := mergeChain container earlier later
        left_inv := mergeChain_splitChain container earlier later
        right_inv := splitChain_mergeChain container earlier later }

/-! ## Functional representations -/

/-- Pointwise graphs lift to the graph of the container map. -/
def graphEquiv
    (container : IndexedContainer.{u, u, u} Output) (output : Output)
    {Source Target : Type u} (function : Source → Target)
    (source : container.Extension Source output)
    (target : container.Extension Target output) :
    (liftRelation container output (Rel.graph function)).evidence source target ≃
      (Rel.graph (container.map function)).evidence source target where
  toFun evidence := by
    cases evidence with
    | same pointwise =>
        exact ⟨⟨Sigma.ext rfl (heq_of_eq (funext fun position =>
          (pointwise position).down.down))⟩⟩
  invFun equal := by
    rcases source with ⟨shape, values⟩
    cases equal.down.down
    exact .same (fun _ => ⟨⟨rfl⟩⟩)
  left_inv := by
    intro evidence
    letI : ∀ (left : Source) (right : Target),
        Subsingleton ((Rel.graph function).evidence left right) :=
      fun _ _ => instSubsingletonEqWitness _ _
    exact @Subsingleton.elim
      (LiftEvidence container (Rel.graph function).evidence source target)
      (instSubsingletonLiftEvidence container) _ evidence
  right_inv := fun equal => (instSubsingletonEqWitness _ _).allEq _ equal

/-- Every indexed container preserves an exact functional representation. -/
noncomputable def representationLiftingAt
    (container : IndexedContainer.{u, u, u} Output) (output : Output) :
    RepresentationLifting
      (fun Object : Type u => container.Extension Object output)
      (compositionalLiftingAt container output) where
  represent := fun _relation representation =>
    { map := container.map representation.map
      exact := fun source target =>
        (liftEvidenceEquiv container representation.exact source target).trans
          (graphEquiv container output representation.map source target) }

/-! ## Finitary descriptions generate exact finite search -/

/-- Pointwise occurrences are exactly occurrences of the lifted relation at a
fixed source container. -/
def occurrenceEquiv
    (container : IndexedContainer.{u, u, u} Output) {output : Output}
    {Source Target : Type u} (relation : ProofRel Source Target)
    (source : container.Extension Source output) :
    ((position : container.Position source.1) →
      AnswerOccurrence relation (source.2 position)) ≃
      AnswerOccurrence (liftRelation container output relation) source where
  toFun occurrences :=
    ⟨⟨source.1, fun position => (occurrences position).target⟩,
      .same (fun position => (occurrences position).derivation)⟩
  invFun occurrence := by
    rcases occurrence with ⟨target, evidence⟩
    cases evidence with
    | same pointwise =>
        exact fun position => ⟨_, pointwise position⟩
  left_inv := by
    intro occurrences
    funext position
    rfl
  right_inv := by
    rintro ⟨target, evidence⟩
    cases evidence
    rfl

/-- A finitary indexed container maps every exact finite element provider to
an exact finite provider for its generated proof-relevant lifting. -/
noncomputable def finiteProvider
    (container : IndexedContainer.{u, u, u} Output)
    (finitary : container.Finitary) {output : Output}
    {Source Target : Type u} (relation : ProofRel Source Target)
    (provider : FiniteEvidenceProvider relation) :
    FiniteEvidenceProvider (liftRelation container output relation) where
  fibre := fun source => by
    classical
    letI : Fintype (container.Position source.1) :=
      finitary.positionFintype source.1
    let Index := (position : container.Position source.1) →
      (provider.fibre (source.2 position)).Index
    letI : ∀ position : container.Position source.1,
        Fintype (provider.fibre (source.2 position)).Index :=
      fun position => (provider.fibre (source.2 position)).indexFintype
    exact
      { Index := Index
        indexFintype := inferInstance
        occurrenceEquiv :=
          (Equiv.piCongrRight fun position =>
            (provider.fibre (source.2 position)).occurrenceEquiv).trans
            (occurrenceEquiv container relation source) }

/-- Finitarity is precisely the additional capability needed to generate
finite native search from the container relator. -/
noncomputable def finiteSearchLiftingAt
    (container : IndexedContainer.{u, u, u} Output)
    (finitary : container.Finitary) (output : Output) :
    FiniteSearchLifting
      (fun Object : Type u => container.Extension Object output)
      (compositionalLiftingAt container output) where
  provide := fun relation provider =>
    finiteProvider container finitary relation provider

/-! ## Positive and negative controls -/

namespace Canary

def listLifting : CompositionalLifting
    (fun Object : Type =>
      IndexedContainer.Examples.list.Extension Object ()) :=
  compositionalLiftingAt IndexedContainer.Examples.list ()

noncomputable def listFiniteSearch : FiniteSearchLifting
    (fun Object : Type =>
      IndexedContainer.Examples.list.Extension Object ()) listLifting :=
  finiteSearchLiftingAt IndexedContainer.Examples.list
    IndexedContainer.Examples.listFinitary ()

def singletonUnit : IndexedContainer.Examples.list.Extension Unit () :=
  ⟨show Nat from 1, fun _ => ()⟩

noncomputable def liftedChoiceProvider : FiniteEvidenceProvider
    (listLifting.lift IntrinsicMILNativeSearch.Canary.choice) :=
  listFiniteSearch.provide IntrinsicMILNativeSearch.Canary.choice
    IntrinsicMILNativeSearch.Canary.choiceProvider

/-- The description-generated List provider retains both semantic answer
occurrences; it is not an endpoint-set approximation. -/
theorem list_choice_retains_two_occurrences :
    (liftedChoiceProvider.answers singletonUnit).card = 2 := by
  rw [FiniteEvidenceProvider.answers_card]
  change Fintype.card (Fin 1 → Bool) = 2
  decide

noncomputable def listRepresentation : RepresentationLifting
    (fun Object : Type =>
      IndexedContainer.Examples.list.Extension Object ()) listLifting :=
  representationLiftingAt IndexedContainer.Examples.list ()

noncomputable def toggleRepresentation :
    Rel.Representation
      (listLifting.lift (Rel.graph Bool.not)) :=
  listRepresentation.represent (Rel.graph Bool.not)
    (Rel.graphRepresentation Bool.not)

@[simp] theorem toggleRepresentation_map :
    toggleRepresentation.map =
      IndexedContainer.Examples.list.map Bool.not :=
  rfl

/-- The positive reader earns compositional lifting and direct mapping even
though it cannot earn exact finite enumeration of independent binary choices. -/
def readerLifting : CompositionalLifting
    (fun Object : Type =>
      IndexedContainer.Examples.reader.Extension Object ()) :=
  compositionalLiftingAt IndexedContainer.Examples.reader ()

noncomputable def readerRepresentation : RepresentationLifting
    (fun Object : Type =>
      IndexedContainer.Examples.reader.Extension Object ()) readerLifting :=
  representationLiftingAt IndexedContainer.Examples.reader ()

def readerSource : IndexedContainer.Examples.reader.Extension Unit () :=
  ⟨(), fun _ => ()⟩

def spike (index position : Nat) : Bool := decide (position = index)

theorem spike_injective : Function.Injective spike := by
  intro first second equal
  by_contra distinct
  have atFirst := congrFun equal first
  simp [spike, distinct] at atFirst

def spikeOccurrence (index : Nat) :
    AnswerOccurrence
      (readerLifting.lift IntrinsicMILNativeSearch.Canary.choice)
      readerSource :=
  by
    refine ⟨⟨(), spike index⟩, ?_⟩
    change LiftEvidence IndexedContainer.Examples.reader
      IntrinsicMILNativeSearch.Canary.choice.evidence readerSource
        ⟨(), spike index⟩
    exact .same (fun _ => ())

theorem spikeOccurrence_injective : Function.Injective spikeOccurrence := by
  intro first second equal
  apply spike_injective
  exact congrArg (fun occurrence =>
    IndexedContainer.Examples.readerExtensionEquiv Bool occurrence.target) equal

/-- The reader family is strictly positive and supports native relation
lifting, but its binary-choice fibre is infinite.  A selector must therefore
withhold only finite enumeration, never the relation itself. -/
theorem reader_choice_has_no_finite_provider :
    ¬ Nonempty
      (FiniteEvidenceProvider
        (readerLifting.lift IntrinsicMILNativeSearch.Canary.choice)) := by
  rintro ⟨provider⟩
  let fibre := provider.fibre readerSource
  letI : Fintype
      (AnswerOccurrence
        (readerLifting.lift IntrinsicMILNativeSearch.Canary.choice)
        readerSource) :=
    Fintype.ofEquiv fibre.Index fibre.occurrenceEquiv
  letI : Fintype Nat :=
    Fintype.ofInjective spikeOccurrence spikeOccurrence_injective
  exact not_finite Nat

/-- Consequently, compositional lifting and direct mapping cannot justify a
finite-search kernel for every positive family. -/
theorem reader_has_no_finite_search_lifting :
    ¬ Nonempty
      (FiniteSearchLifting
        (fun Object : Type =>
          IndexedContainer.Examples.reader.Extension Object ())
        readerLifting) := by
  rintro ⟨finiteSearch⟩
  exact reader_choice_has_no_finite_provider
    ⟨finiteSearch.provide IntrinsicMILNativeSearch.Canary.choice
      IntrinsicMILNativeSearch.Canary.choiceProvider⟩

end Canary

#print axioms compositionalLiftingAt
#print axioms representationLiftingAt
#print axioms finiteSearchLiftingAt
#print axioms Canary.list_choice_retains_two_occurrences
#print axioms Canary.reader_choice_has_no_finite_provider
#print axioms Canary.reader_has_no_finite_search_lifting

end NativeIndexedContainerLiftingSearch
end Mettapedia.Languages.MeTTa.PureKernel.Universe
