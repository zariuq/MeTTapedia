import Mettapedia.Languages.MeTTa.PureKernel.Universe.AuthoredIndexedFamilyPresentation
import Mettapedia.TypeTheory.FreeConversion

/-!
# Typed conversion generated by an authored indexed-family presentation

An authored family presentation and a native family candidate already agree
fibrewise on raw equation occurrences.  That agreement is not yet a typed
computation: a raw equation may contain parameters that have no type in the
hosted declaration world.

This module adds exactly the missing judgment index.  An authored occurrence
enters native computation only together with both endpoint typings, producing
two related conversions:

* a proof-relevant native conversion that retains the exact native receipt;
* the established declared conversion whose step is the logical support of
  that receipt.

When uniform declaration preservation is available, source typing suffices to
construct the target typing.  No checker is inserted into native computation,
and no proposition-valued support is used as a receipt format.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.MeTTa.PureKernel.Universe
namespace AuthoredIndexedFamilyTypedConversion

open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.JudgmentalEquality
open AuthoredDeclarationSignature
open AuthoredIndexedFamilyPresentation
open Presentation
open Presentation.Declaration
open Presentation.Declaration.ComputationAuthority

/-! ## The native judgment-indexed computation -/

/-- The common intrinsically typed state family used by authored equations
and their native realizations. -/
abbrev NativeIndexedState (presented : PresentedCandidate)
    (index : TypingIndex Tower.Head) :=
  Sigma fun term : Tower.Tm index.arity =>
    DataHasType Tower.rules presented.candidate.signature
      index.context term index.type

/-- Native proof-relevant computation evidence inside one complete typing
fibre. -/
abbrev NativeIndexedStep (presented : PresentedCandidate)
    {index : TypingIndex Tower.Head}
    (source target : NativeIndexedState presented index) :=
  presented.candidate.computation.Evidence source.1 target.1

/-- Terms typed in the candidate's declaration world, with native candidate
evidence as the loose step inside each complete typing fibre. -/
def nativeIndexedComputation (presented : PresentedCandidate) :
    JudgmentalComputation (TypingIndex Tower.Head) :=
  FreeConversion.computation
    (NativeIndexedState presented)
    (NativeIndexedStep presented)

/-- An authored equation occurrence promoted into one complete typing fibre.
The source occurrence, both endpoint derivations, and the native receipt all
remain recoverable. -/
structure TypedOccurrence (presented : PresentedCandidate) {n : Nat}
    (context : Tower.Ctx n) (left right type : Tower.Tm n) : Type where
  authored :
    EquationOccurrence (equationSchemas (elaborate presented.source))
      left right
  sourceTyping :
    HasType (extendRules Tower.rules presented.candidate.signature)
      context left type
  targetTyping :
    HasType (extendRules Tower.rules presented.candidate.signature)
      context right type

namespace TypedOccurrence

variable {n : Nat} {presented : PresentedCandidate}
    {context : Tower.Ctx n} {left right type : Tower.Tm n}

/-- The exact native receipt corresponding to the retained authored
occurrence. -/
def nativeEvidence
    (occurrence : TypedOccurrence presented context left right type) :
    presented.candidate.computation.Evidence left right :=
  presented.receiptEquiv occurrence.authored

/-- The complete proof-relevant declaration receipt. -/
def toProofRelevantReceipt
    (occurrence : TypedOccurrence presented context left right type) :
    ProofRelevantStepReceipt Tower.rules presented.candidate.signature
      presented.candidate.computation context left right type where
  sourceTyping := occurrence.sourceTyping
  targetTyping := occurrence.targetTyping
  evidence := occurrence.nativeEvidence

/-- Complete judgment index of the typed occurrence. -/
def index
    (_occurrence : TypedOccurrence presented context left right type) :
    TypingIndex Tower.Head :=
  ⟨n, context, type⟩

/-- Typed source state in the native computation. -/
def sourceState
    (occurrence : TypedOccurrence presented context left right type) :
    (nativeIndexedComputation presented).State occurrence.index :=
  ⟨left, ⟨occurrence.sourceTyping⟩⟩

/-- Typed target state in the same native computation fibre. -/
def targetState
    (occurrence : TypedOccurrence presented context left right type) :
    (nativeIndexedComputation presented).State occurrence.index :=
  ⟨right, ⟨occurrence.targetTyping⟩⟩

/-- A typed authored occurrence is directly one native computation step. -/
def toNativeStep
    (occurrence : TypedOccurrence presented context left right type) :
    (nativeIndexedComputation presented).Step
      occurrence.sourceState occurrence.targetState :=
  occurrence.nativeEvidence

/-- Native computation constructs conversion without an interior checker. -/
def toNativeConversion
    (occurrence : TypedOccurrence presented context left right type) :
    ConversionEvidence (nativeIndexedComputation presented)
      occurrence.sourceState occurrence.targetState :=
  .step occurrence.toNativeStep

/-- Explicitly forget the native receipt to the proposition-supported
declaration step. -/
def toDeclaredReceipt
    (occurrence : TypedOccurrence presented context left right type) :
    DeclaredStepReceipt Tower.rules presented.candidate.signature
      context left right type :=
  occurrence.toProofRelevantReceipt.toDeclaredReceipt
    presented.candidate.computationSupport

/-- The existing declared judgment-indexed conversion is the support
projection of the same typed occurrence. -/
def toDeclaredConversion
    (occurrence : TypedOccurrence presented context left right type) :
    ConversionEvidence
      (indexedDeclaredComputation Tower.rules presented.candidate.signature)
      occurrence.toDeclaredReceipt.sourceState
      occurrence.toDeclaredReceipt.targetState :=
  occurrence.toDeclaredReceipt.toConversionEvidence

/-- Native evidence recovers the exact authored occurrence. -/
@[simp] theorem authored_of_nativeEvidence
    (occurrence : TypedOccurrence presented context left right type) :
    presented.receiptEquiv.symm occurrence.nativeEvidence =
      occurrence.authored := by
  exact presented.receiptEquiv.symm_apply_apply occurrence.authored

@[simp] theorem sourceState_term
    (occurrence : TypedOccurrence presented context left right type) :
    occurrence.sourceState.1 = left :=
  rfl

@[simp] theorem targetState_term
    (occurrence : TypedOccurrence presented context left right type) :
    occurrence.targetState.1 = right :=
  rfl

end TypedOccurrence

/-! ## Uniform preservation as constructional authority -/

/-- A presented family whose declared equations uniformly preserve typing.
This is a mathematical capability of the declaration world, not a checker or
runtime token. -/
structure PreservingPresentedCandidate where
  presented : PresentedCandidate
  preserves :
    presented.candidate.signature.DeclaredPreserves Tower.rules

namespace PreservingPresentedCandidate

/-- Every authored occurrence has logical support in the candidate
signature, obtained from its exact native receipt. -/
def declaredSupport (authorized : PreservingPresentedCandidate)
    {n : Nat} {left right : Tower.Tm n}
    (occurrence : EquationOccurrence
      (equationSchemas (elaborate authorized.presented.source)) left right) :
    authorized.presented.candidate.signature.computation.step left right := by
  rw [authorized.presented.candidate.computationSupport]
  exact ⟨authorized.presented.receiptEquiv occurrence⟩

/-- With uniform preservation, an authored occurrence and typed source
construct the complete typed occurrence.  Target typing is derived once from
the declaration law, not rechecked operationally. -/
def typedOccurrence (authorized : PreservingPresentedCandidate)
    {n : Nat} {context : Tower.Ctx n} {left right type : Tower.Tm n}
    (occurrence : EquationOccurrence
      (equationSchemas (elaborate authorized.presented.source)) left right)
    (sourceTyping :
      HasType
        (extendRules Tower.rules authorized.presented.candidate.signature)
        context left type) :
    TypedOccurrence authorized.presented context left right type where
  authored := occurrence
  sourceTyping := sourceTyping
  targetTyping := authorized.preserves
    (authorized.declaredSupport occurrence) sourceTyping

end PreservingPresentedCandidate

/-! ## Axiom audit -/

#print axioms TypedOccurrence.toNativeConversion
#print axioms TypedOccurrence.toDeclaredConversion
#print axioms TypedOccurrence.authored_of_nativeEvidence
#print axioms PreservingPresentedCandidate.declaredSupport
#print axioms PreservingPresentedCandidate.typedOccurrence

end AuthoredIndexedFamilyTypedConversion
end Mettapedia.Languages.MeTTa.PureKernel.Universe
