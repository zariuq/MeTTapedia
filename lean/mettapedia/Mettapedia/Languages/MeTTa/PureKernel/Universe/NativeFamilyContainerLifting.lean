import Mettapedia.TypeTheory.NativeFamilyCapabilitySeparation
import Mettapedia.Languages.MeTTa.PureKernel.Universe.NativeIndexedContainerLiftingSearch

/-!
# Transporting native family capabilities across exact representations

A checked unary family may have an exact parameter-container representation
without using that representation as its authored identity.  This module
transports the native capabilities generated by the container back to the
authored family:

* compositional proof-relevant relation lifting needs only the exact
  representation;
* preservation of functional representations needs no finiteness assumption;
* exact finite search additionally requires `IndexedContainer.Finitary`.

The construction is generic in an objectwise equivalence.  It therefore does
not privilege List, and it does not infer a capability from strict positivity
alone.  Construction and elimination of recursive families remain a distinct
native judgment supplied by their indexed-polynomial declarations.
-/

namespace Mettapedia.Languages.MeTTa.PureKernel.Universe
namespace NativeFamilyContainerLifting

open Mettapedia.GSLT.LooseRelationEquipment
open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.NativeFamilyCapabilitySeparation
open RelationalInternalLanguage.Semantic
open RelationalEvidence
open IntrinsicMILNativeSearch
open NativeRelationLifting
open IntrinsicMILNativeLiftingSearch
open NativeIndexedContainerLiftingSearch

universe u

/-! ## Exact objectwise transport -/

/-- Equality witnesses transport exactly along an equivalence. -/
def eqWitnessEquiv
    {Source Target : Type u} (equivalence : Source ≃ Target)
    (left right : Source) :
    EqWitness (equivalence left) (equivalence right) ≃
      EqWitness left right where
  toFun witness := ⟨⟨equivalence.injective witness.down.down⟩⟩
  invFun witness := ⟨⟨congrArg equivalence witness.down.down⟩⟩
  left_inv first := Subsingleton.elim _ first
  right_inv first := Subsingleton.elim _ first

/-- Reindex the middle object of a proof-relevant composite without erasing
either component derivation. -/
noncomputable def sigmaPullbackEquiv
    {Source Target : Type u} (equivalence : Source ≃ Target)
    (fibre : Target → Type u) :
    (Sigma fibre) ≃ (Sigma fun source => fibre (equivalence source)) :=
  Equiv.sigmaCongr equivalence.symm (fun target =>
    Equiv.cast
      (congrArg fibre (equivalence.apply_symm_apply target).symm))

/-- A compositional proof-relevant lifting transports across an exact
objectwise representation.  The chain law reindexes the complete middle
object, so multiplicity and both derivations remain visible. -/
noncomputable def transportCompositionalLifting
    {Original Represented : Type u → Type u}
    (exact : ∀ Object : Type u, Original Object ≃ Represented Object)
    (lifting : CompositionalLifting Represented) :
    CompositionalLifting Original where
  lift := fun relation =>
    reindex (exact _) (exact _) (lifting.lift relation)
  identity := by
    intro Object source target
    exact
      (lifting.identity Object (exact Object source) (exact Object target)).trans
        (eqWitnessEquiv (exact Object) source target)
  chain := by
    intro First Middle Last earlier later source target
    exact
      (lifting.chain earlier later (exact First source) (exact Last target)).trans
        (sigmaPullbackEquiv (exact Middle) (fun middle =>
          (lifting.lift earlier).evidence (exact First source) middle ×
            (lifting.lift later).evidence middle (exact Last target)))

/-! ## Capabilities earned by a unary container representation -/

/-- The proof-relevant relator generated by the represented container,
transported back to the authored family. -/
noncomputable def UnaryContainerRepresentation.compositionalLifting
    {Family : Type → Type}
    (representation : UnaryContainerRepresentation Family) :
    CompositionalLifting Family :=
  transportCompositionalLifting representation.exact
    (compositionalLiftingAt representation.container ())

/-- Exact functional realization transports through every unary container
representation; no finite-enumeration premise is needed. -/
noncomputable def UnaryContainerRepresentation.representationLifting
    {Family : Type → Type}
    (representation : UnaryContainerRepresentation Family) :
    RepresentationLifting Family (compositionalLifting representation) where
  represent := fun relation relationRepresentation =>
    reindexRepresentation (representation.exact _)
      (representation.exact _)
      ((representationLiftingAt representation.container ()).represent
        relation relationRepresentation)

/-- The direct realization generated by a family representation is exactly
the graph of the transported family map. -/
@[simp] theorem UnaryContainerRepresentation.representationLifting_map
    {Family : Type → Type}
    (representation : UnaryContainerRepresentation Family)
    {Source Target : Type} (function : Source → Target) :
    ((representationLifting representation).represent (Rel.graph function)
      (Rel.graphRepresentation function)).map =
        representation.map function :=
  rfl

/-- Graph agreement is retained as an equivalence of proof fibres, not merely
as equality of Boolean support. -/
noncomputable def UnaryContainerRepresentation.mapGraphEquiv
    {Family : Type → Type}
    (representation : UnaryContainerRepresentation Family)
    {Source Target : Type} (function : Source → Target)
    (source : Family Source) (target : Family Target) :
    ((compositionalLifting representation).lift
      (Rel.graph function)).evidence source target ≃
        (Rel.graph (representation.map function)).evidence source target :=
  ((representationLifting representation).represent (Rel.graph function)
    (Rel.graphRepresentation function)).exact source target

/-- Exact finite search is transported only when the represented container
has finite parameter-position fibres. -/
noncomputable def UnaryContainerRepresentation.finiteSearchLifting
    {Family : Type → Type}
    (representation : UnaryContainerRepresentation Family)
    (finitary : representation.container.Finitary) :
    FiniteSearchLifting Family (compositionalLifting representation) where
  provide := fun relation provider =>
    reindexProvider (representation.exact _) (representation.exact _)
      ((finiteSearchLiftingAt representation.container finitary ()).provide
        relation provider)

/-! ## Reflection across the exact representation -/

/-- Pointwise equivalence of relation evidence induces exact equivalence of
target/derivation occurrences. -/
noncomputable def answerOccurrenceEquiv
    {Source Target : Type u}
    {first second : RelationalInternalLanguage.Semantic.Rel Source Target}
    (evidence : ∀ source target,
      first.evidence source target ≃ second.evidence source target)
    (source : Source) :
    AnswerOccurrence first source ≃ AnswerOccurrence second source where
  toFun occurrence :=
    ⟨occurrence.target,
      evidence source occurrence.target occurrence.derivation⟩
  invFun occurrence :=
    ⟨occurrence.target,
      (evidence source occurrence.target).symm occurrence.derivation⟩
  left_inv occurrence := by
    cases occurrence with
    | mk target derivation =>
        simp
  right_inv occurrence := by
    cases occurrence with
    | mk target derivation =>
        simp

/-- Exact finite providers transport along pointwise equivalence of all proof
fibres without changing their finite occurrence indices. -/
noncomputable def transportFiniteEvidenceProvider
    {Source Target : Type u}
    {first second : RelationalInternalLanguage.Semantic.Rel Source Target}
    (evidence : ∀ source target,
      first.evidence source target ≃ second.evidence source target)
    (provider : FiniteEvidenceProvider first) :
    FiniteEvidenceProvider second where
  fibre source :=
    { Index := (provider.fibre source).Index
      indexFintype := (provider.fibre source).indexFintype
      occurrenceEquiv := (provider.fibre source).occurrenceEquiv.trans
        (answerOccurrenceEquiv evidence source) }

/-- Reindexing a relation through an equivalence and immediately back changes
no proof fibre. -/
noncomputable def reindexRoundtripEvidenceEquiv
    {Source Target ReindexedSource ReindexedTarget : Type u}
    (source : ReindexedSource ≃ Source)
    (target : ReindexedTarget ≃ Target)
    (relation : RelationalInternalLanguage.Semantic.Rel Source Target)
    (left : Source) (right : Target) :
    (reindex source.symm target.symm
      (reindex source target relation)).evidence left right ≃
        relation.evidence left right :=
  Equiv.cast (by
    simp [reindex])

/-- Finite-search preservation reflects across an exact objectwise
representation.  Combined with `transportCompositionalLifting`, exact
representation is therefore incapable of manufacturing or hiding this
capability. -/
noncomputable def reflectFiniteSearchLifting
    {Original Represented : Type u → Type u}
    (exact : ∀ Object : Type u, Original Object ≃ Represented Object)
    (lifting : CompositionalLifting Represented)
    (transported : FiniteSearchLifting Original
      (transportCompositionalLifting exact lifting)) :
    FiniteSearchLifting Represented lifting where
  provide := fun relation provider =>
    transportFiniteEvidenceProvider
      (fun source target =>
        reindexRoundtripEvidenceEquiv (exact _) (exact _)
          (lifting.lift relation) source target)
      (reindexProvider (exact _).symm (exact _).symm
        (transported.provide relation provider))

/-! ## Finitarity is exactly the generated finite-search capability -/

/-- One parameter position selects a distinct Boolean target occurrence in
the lifted two-way choice relation. -/
noncomputable def containerChoiceOccurrence
    (container : IndexedContainer Unit)
    {shape : container.Shape ()} (position : container.Position shape) :
    AnswerOccurrence
      ((compositionalLiftingAt container ()).lift
        IntrinsicMILNativeSearch.Canary.choice)
      (⟨shape, fun _ => ()⟩ : container.Extension Unit ()) := by
  classical
  exact
    ⟨⟨shape, fun current => decide (current = position)⟩,
      .same (fun _ => ())⟩

theorem containerChoiceOccurrence_injective
    (container : IndexedContainer Unit)
    {shape : container.Shape ()} :
    Function.Injective
      (containerChoiceOccurrence container (shape := shape)) := by
  classical
  intro first second equal
  by_contra distinct
  have targetEqual := congrArg AnswerOccurrence.target equal
  change
    (⟨shape, fun current => decide (current = first)⟩ :
      container.Extension Bool ()) =
    ⟨shape, fun current => decide (current = second)⟩ at targetEqual
  have valuesEqual :
      (fun current : container.Position shape => decide (current = first)) =
        (fun current : container.Position shape =>
          decide (current = second)) :=
    eq_of_heq (Sigma.mk.inj_iff.mp targetEqual).2
  have atFirst := congrFun valuesEqual first
  simp [distinct] at atFirst

/-- If the generated lifting preserves every exact finite element fibre, then
every container position fibre is finite.  The binary-choice relation is the
separating probe: each position yields a distinct target occurrence. -/
noncomputable def finitaryOfFiniteSearchLifting
    (container : IndexedContainer Unit)
    (finiteSearch : FiniteSearchLifting
      (fun Object : Type => container.Extension Object ())
      (compositionalLiftingAt container ())) :
    container.Finitary where
  positionFintype := fun {output} shape => by
    cases output
    let source : container.Extension Unit () := ⟨shape, fun _ => ()⟩
    let provider := finiteSearch.provide
      IntrinsicMILNativeSearch.Canary.choice
      IntrinsicMILNativeSearch.Canary.choiceProvider
    let fibre := provider.fibre source
    letI : Fintype
        (AnswerOccurrence
          ((compositionalLiftingAt container ()).lift
            IntrinsicMILNativeSearch.Canary.choice)
          source) :=
      Fintype.ofEquiv fibre.Index fibre.occurrenceEquiv
    exact Fintype.ofInjective
      (containerChoiceOccurrence container (shape := shape))
      (containerChoiceOccurrence_injective container (shape := shape))

/-- For a small unary indexed container, finitary positions are equivalent to
preservation of exact finite search by its generated relator. -/
theorem containerFinitary_iff_finiteSearchLifting
    (container : IndexedContainer Unit) :
    Nonempty container.Finitary ↔
      Nonempty
        (FiniteSearchLifting
          (fun Object : Type => container.Extension Object ())
          (compositionalLiftingAt container ())) := by
  constructor
  · rintro ⟨finitary⟩
    exact ⟨finiteSearchLiftingAt container finitary ()⟩
  · rintro ⟨finiteSearch⟩
    exact ⟨finitaryOfFiniteSearchLifting container finiteSearch⟩

/-- Exact family/container representation reflects the finite-search
capability in both directions.  This is the strongest true reflection law:
the equivalence transports evidence, while the Boolean-choice probe recovers
finitarity from any alleged general finite-search lifting. -/
theorem UnaryContainerRepresentation.finitary_iff_finiteSearchLifting
    {Family : Type → Type}
    (representation : UnaryContainerRepresentation Family) :
    Nonempty representation.container.Finitary ↔
      Nonempty
        (FiniteSearchLifting Family
          (compositionalLifting representation)) := by
  constructor
  · rintro ⟨finitary⟩
    exact ⟨finiteSearchLifting representation finitary⟩
  · rintro ⟨familyFiniteSearch⟩
    let containerFiniteSearch :=
      reflectFiniteSearchLifting representation.exact
        (compositionalLiftingAt representation.container ())
        familyFiniteSearch
    exact
      (containerFinitary_iff_finiteSearchLifting
        representation.container).mpr ⟨containerFiniteSearch⟩

