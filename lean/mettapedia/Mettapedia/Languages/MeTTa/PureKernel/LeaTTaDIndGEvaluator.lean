    (a := sigAtom sig) (b := termAtom rawL) (c := sigAtom sig) (d := termAtom rawR) (by
      simpa [nfQuery, mExpr, mSym] using hEq)
  exact termAtom_beq_injective_on_nf_eq_fragment_nameFree hL hR hPayload.2

