private theorem queryOp_kernelDefControlEnv_nf_srt_eq
    (st : St) (sig : DIndGArtifactSig) (sort : DIndGArtifactSort)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = []) :
    queryOp kernelDefControlEnv st [] (nfQuery sig (.srt sort)) [] =
      ( [evalResult [] (termAtom (.srt sort))
          ((renameBindings (counterSuffix (st.counter + 1))
            (nfSrtRuleBindings sig sort)).reverse)]
      , { counter := st.counter + 8, world := st.world }) := by
  let target := nfQuery sig (.srt sort)
  let rootBnd :=
    (renameBindings (counterSuffix (st.counter + 1))
      (nfSrtRuleBindings sig sort)).reverse
  have hNotVarHead : isVariableHeaded target = false := by
    simp [target, nfQuery, isVariableHeaded, mExpr, mSym]
  have hCand :
      kernelDefControlEnv.candidates target =
        [nfVarRulePair] ++ nfSrtRulePair ::
          [nfConRulePair, (nfPiRuleLhs, nfPiRuleRhs), nfLamRulePair,
            nfBadRulePair, nfIndGZeroIotaRulePair, nfDefRulePair] := by
    have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
      simp [MinEnv.candidates, kernelDefControlEnv]
    have hcand := kernelEnv_nf_srt_candidates sig sort
    have hstaticInit := candidatesW_init_eq_candidates kernelEnv target
    rw [hstaticInit] at hcand
    rw [hcandidateEq]
    simpa [target] using hcand
  have hVar :
      Metta.Minimal.queryOpItemsOfRule [] target [] st.counter nfVarRulePair = [] := by
    simpa [target] using queryOpItems_nf_var_on_srt_eq_nil st.counter sig sort
  have hSrt :
      Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1) nfSrtRulePair =
        [evalResult [] (termAtom (.srt sort)) rootBnd] := by
    simpa [target, rootBnd] using queryOpItems_nf_srt_eq (st.counter + 1) sig sort
  have hCon :
      Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1) nfConRulePair = [] := by
    simpa [target, Nat.add_assoc] using queryOpItems_nf_con_on_srt_eq_nil (st.counter + 2) sig sort
  have hPi :
      Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1 + 1) (nfPiRuleLhs, nfPiRuleRhs) = [] := by
    simpa [target, Nat.add_assoc] using queryOpItems_nf_pi_on_srt_eq_nil (st.counter + 3) sig sort
  have hLam :
      Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1 + 1 + 1) nfLamRulePair = [] := by
    simpa [target, Nat.add_assoc] using queryOpItems_nf_lam_on_srt_eq_nil (st.counter + 4) sig sort
  have hBad :
      Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1 + 1 + 1 + 1) nfBadRulePair = [] := by
    simpa [target, Nat.add_assoc] using queryOpItems_nf_bad_on_srt_eq_nil (st.counter + 5) sig sort
  have hIota :
      Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1 + 1 + 1 + 1 + 1)
          nfIndGZeroIotaRulePair = [] := by
    exact queryOpItems_nf_indG_zero_iota_eq_nil_of_term_match_nil
      (st.counter + 6) sig (.srt sort)
      (by
        cases sort <;>
          simp [cicStage3IndGZeroRawRuntime, termAtom, argsAtom, casesAtom,
            sortAtom, declNameAtom, mExpr, mSym, Metta.matchAtoms,
            Metta.matchAtomsWith, Metta.matchAll])
  have hDef :
      Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1 + 1 + 1 + 1 + 1 + 1)
          nfDefRulePair = [] := by
    simpa [target, Nat.add_assoc] using
      queryOpItems_nf_def_on_srt_eq_nil (st.counter + 7) sig sort
  unfold queryOp
  rw [hNotVarHead]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [candidatesW_eq_candidates_of_no_selfRules
    kernelDefControlEnv st.world target hStatic hImports]
  rw [hCand]
  rw [List.foldl_append]
  simp only [List.foldl_cons, List.foldl_nil,
    Metta.Minimal.queryOpFoldStep, freshenRuleAvoiding_counter]
  let items : List Item :=
    (((((((Metta.Minimal.queryOpItemsOfRule [] target [] st.counter nfVarRulePair ++
        Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1) nfSrtRulePair) ++
        Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1) nfConRulePair) ++
        Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1 + 1) (nfPiRuleLhs, nfPiRuleRhs)) ++
        Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1 + 1 + 1) nfLamRulePair) ++
        Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1 + 1 + 1 + 1) nfBadRulePair) ++
        Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1 + 1 + 1 + 1 + 1)
          nfIndGZeroIotaRulePair) ++
        Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1 + 1 + 1 + 1 + 1 + 1 + 1)
          nfDefRulePair)
  let stOut : St :=
    { counter := st.counter + 1 + 1 + 1 + 1 + 1 + 1 + 1 + 1, world := st.world }
  change
    (if items.isEmpty = true then
        ([finItem [] notReducibleA []], stOut)
      else
        (items, stOut)) =
      ( [evalResult [] (termAtom (.srt sort))
          ((renameBindings (counterSuffix (st.counter + 1))
            (nfSrtRuleBindings sig sort)).reverse)]
      , { counter := st.counter + 8, world := st.world })
  have hItems :
      items =
        [evalResult [] (termAtom (.srt sort)) rootBnd] := by
    simp [items, hVar, hSrt, hCon, hPi, hLam, hBad, hIota, hDef]
  rw [hItems]
  simp [rootBnd, stOut, Nat.add_assoc]

/-- Exact `nf Srt` query readout under one closed public binding.  All seven
non-selected candidates are shown empty under the repaired capture-avoiding
freshener, so the recursive evaluator sees a unique item and a determined
state. -/
private theorem queryOp_kernelDefControlEnv_nf_srt_eq_singleton_closed
    (st : St) (sig : DIndGArtifactSig) (sort : DIndGArtifactSort)
    (binder : String) (value : Metta.Atom)
