/-- Expected-aware evaluation casts an inert grounded Boolean against `Bool` without changing its
binding or state.  This is the concrete typed-result frontier used by `is-bad`, `==`, and `conv`;
it deliberately makes no claim about arbitrary non-expression atoms that may reduce further. -/
theorem mettaEvalExpected_kernelEnv_mBool_bool_eq_state
    (fuel : Nat) (st : St) (b : Bool) (hExtra : st.world.selfExtra = [])
    (hImports : st.world.selfImports = []) :
    mettaEvalExpected kernelEnv (fuel + 1) st [] (mBool b) (mSym "Bool") =
      ([(mBool b, [])], st) := by
  apply mettaEvalExpected_bool_of_notReducible
  · rfl
  · simp [mettaTypeCast, mettaTypeCastAvoiding, typeCastInferenceAvoid, typeInferenceAvoid,
      freshenArgumentTypes, freshenTypeCandidate, renameAllVars, typePrep,
      subTokens, wrapStates, matchExpectedType, getTypes, matchType, matchReduced,
      Metta.matchAtoms, Metta.matchAtomsWith, Metta.Bindings.merge, mBool, mSym]
  · simpa [evalItemNil, mBool, mSym] using
      interpretFuel_kernelEnv_eval_mBool_notReducible_eq_state fuel st b hExtra hImports

/-- Exact full-runtime executable lift for embedded `unify` fallback with a
Boolean `false` else branch.

This is the exact-state counterpart of
`mettaEval_kernelEnv_embedded_unify_fallback_of_quoted_args`: the quoted root
expression evaluates along the explicit else branch, and the recursive
evaluation of that branch is just the inert Boolean payload. -/
theorem mettaEval_kernelEnv_embedded_unify_fallback_false_eq
    (fuel : Nat) (st : St)
    (atom pattern template : Metta.Atom)
    (hTypes : KernelEnvTypeWorld st.world)
    (hExtra : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hNoErr :
      (([atom, pattern, template, mBool false].zip
          [atom, pattern, template, mBool false]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hmatch : Metta.matchAtoms atom pattern = [])
    (hRootNotSelf :
      (mBool false == mExpr "unify" [atom, pattern, template, mBool false]) = false) :
    mettaEval kernelEnv (fuel + 2) st [] (mExpr "unify" [atom, pattern, template, mBool false]) =
      ([(mBool false, [])], st) := by
  rw [show fuel + 2 = (fuel + 1) + 1 by omega]
  change mettaEval kernelEnv ((fuel + 1) + 1) st []
      (.expr [.sym "unify", atom, pattern, template, mBool false]) =
    ([(mBool false, [])], st)
  rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
    kernelEnv (fuel + 1) st "unify" [atom, pattern, template, mBool false]
    [false, false, false, false] false
    (kernelEnv_unify_recursionNeutralPolicy st atom pattern template (mBool false)
      hTypes.unify) (by simp [Metta.Atom.isError])]
  simp only [evaluateSelectedApplication, firstChangedArgumentStop,
    List.zip_cons_cons, List.zip_nil_right, List.foldl_cons, List.foldl_nil]
  have hAtomNotChanged : ¬ (((atom == emptyA) = true ∨ atom.isError = true) ∧ (atom != atom) = true) :=
    argument_not_changed_terminal_of_mem_zip
      (result := atom) (original := atom) hNoErr (by simp)
  have hPatternNotChanged :
      ¬ (((pattern == emptyA) = true ∨ pattern.isError = true) ∧ (pattern != pattern) = true) :=
    argument_not_changed_terminal_of_mem_zip
      (result := pattern) (original := pattern) hNoErr (by simp)
  have hTemplateNotChanged :
      ¬ (((template == emptyA) = true ∨ template.isError = true) ∧ (template != template) = true) :=
    argument_not_changed_terminal_of_mem_zip
      (result := template) (original := template) hNoErr (by simp)
  have hElseNotChanged :
      ¬ ((((mBool false) == emptyA) = true ∨ (mBool false).isError = true) ∧ (mBool false != mBool false) = true) :=
    argument_not_changed_terminal_of_mem_zip
      (result := mBool false) (original := mBool false) hNoErr (by simp)
  simp [Metta.instantiate_nil, hNoErr, hAtomNotChanged, hPatternNotChanged,
    hTemplateNotChanged, hElseNotChanged]
  have hroot :
      interpretFuel kernelEnv (fuel + 2) st
          [evalItemNil (mExpr "unify" [atom, pattern, template, mBool false])] [] =
        ([(mBool false, [])], st) := by
    simpa using
      (interpretFuel_eval_embedded_unify_fallback_eq_of_gt
        kernelEnv fuel st atom pattern template (mBool false) (by rfl) hmatch
          (mBool_ne_empty false))
  have hrootDirect :
      interpretFuel kernelEnv (fuel + 2) st
          [{ stack := atomToStack
              (Atom.expr [Atom.sym "eval",
                Atom.expr [Atom.sym "unify", atom, pattern, template,
                  mBool false]]) [],
             bnd := [] }] [] =
        ([(mBool false, [])], st) := by
    simpa [evalItemNil, mExpr, mSym, Metta.instantiate_nil] using hroot
  rw [hrootDirect]
  have hBndEmpty :
      restrictBnd (atom.vars ++ (pattern.vars ++ (template.vars ++ (mBool false).vars)))
          ((Bindings.merge [] ([] : Bindings)).head?.getD []) = [] := by
    simpa using
      restrictBnd_empty_merge_empty
        (atom.vars ++ (pattern.vars ++ (template.vars ++ (mBool false).vars)))
  simp [List.foldl]
  rw [hBndEmpty]
  rw [mettaEval_kernelEnv_mBool_eq_state fuel st false hExtra hImports]
  have hRootNotNotReducible :
      (Metta.Atom.gnd (Ground.bool false) == Metta.Atom.sym "NotReducible") = false := by
    rfl
  have hRootNotSelf' :
      (Metta.Atom.gnd (Ground.bool false) ==
        Metta.Atom.expr [Metta.Atom.sym "unify", atom, pattern, template,
          Metta.Atom.gnd (Ground.bool false)]) = false := by
    simpa [mBool, mExpr, mSym] using hRootNotSelf
  simp [notReducibleA, mBool, Metta.instantiate_nil, restrictBnd_empty_merge_empty,
    hRootNotNotReducible, hRootNotSelf']

/-- Expected-`Bool` sibling of the embedded-unify fallback theorem.  `unify` has no declared
function type, so the expected-aware selector takes tuple fallback: its four arguments remain
ordinary (`%Undefined%`) evaluations and only the emitted Boolean is checked against `Bool`. -/
theorem mettaEvalExpected_kernelEnv_embedded_unify_fallback_false_eq
    (fuel : Nat) (st : St)
    (atom pattern template : Metta.Atom)
    (hTypes : KernelEnvTypeWorld st.world)
    (hExtra : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hNoErr :
      (([atom, pattern, template, mBool false].zip
          [atom, pattern, template, mBool false]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hmatch : Metta.matchAtoms atom pattern = [])
    (hRootNotSelf :
      (mBool false == mExpr "unify" [atom, pattern, template, mBool false]) = false) :
    mettaEvalExpected kernelEnv (fuel + 2) st []
        (mExpr "unify" [atom, pattern, template, mBool false]) (mSym "Bool") =
      ([(mBool false, [])], st) := by
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->"
        [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom", mSym "%Undefined%"]
      argumentTypes := [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]
      returnType := mSym "%Undefined%"
      typeBindings := [] }
  have hCheck : typeCheckArgsOutcome kernelEnv st.world
      [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"] 0 []
      [atom, pattern, template, mBool false] = .success [] := by
    simpa [mSym] using
      typeCheckArgsOutcome_four_atoms kernelEnv st.world
        atom pattern template (mBool false)
  have hExpectedDetailed : typeCheckArgsDetailedOutcomeScoped kernelEnv st.world
      [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"]
      (applicationTypeInferenceScope (.sym "Bool")
        [atom, pattern, template, mBool false]) 0 []
      [atom, pattern, template, mBool false] = .success [] [] := by
    apply typeCheckArgsDetailedOutcomeScoped_all_atom
    intro j hj
    simp at hj
    have : j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 := by omega
    rcases this with rfl | rfl | rfl | rfl <;> rfl
  have hTypesEq : getTypes kernelEnv (typePrep st.world (.sym "unify")) =
      [.expr (.sym "->" ::
        [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"] ++
          [.sym "%Undefined%"]) ] := by
    simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.unify
  have hOrdinary :
      selectFunctionType kernelEnv st.world (.sym "unify")
          [atom, pattern, template, mBool false] = .selected selected := by
    simpa [selected, mExpr, mSym] using
      (selectFunctionType_singleton_arrow_selected_of_outcome
        kernelEnv st.world "unify" [atom, pattern, template, mBool false]
        [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"]
        (.sym "%Undefined%") [] hTypesEq (by simp) hCheck)
  have hExpected :
      selectFunctionTypeForExpected kernelEnv st.world (.sym "unify")
          [atom, pattern, template, mBool false] (mSym "Bool") =
        .selected selected := by
    simpa [selected, mExpr, mSym] using
      (selectFunctionTypeForExpected_singleton_arrow_selected_of_detailed
        kernelEnv st.world "unify" [atom, pattern, template, mBool false]
        [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"]
        (.sym "%Undefined%") (.sym "Bool") [] []
        hTypesEq
        (by
          simpa [mExpr, mSym] using
            (freshenFunctionTypeCandidates_map_sym kernelEnv
              (mExpr "unify" [atom, pattern, template, mBool false])
              [atom, pattern, template, mBool false] (mSym "Bool")
              ["->", "Atom", "Atom", "Atom", "Atom", "%Undefined%"]))
        (by simp) hExpectedDetailed
        (matchType_undefined_right [] (.sym "Bool")))
  rw [show fuel + 2 = (fuel + 1) + 1 by omega]
  change mettaEvalExpected kernelEnv ((fuel + 1) + 1) st []
      (.expr [.sym "unify", atom, pattern, template, mBool false]) (mSym "Bool") =
    ([(mBool false, [])], st)
  have hHead :
      mettaTypeCastAvoiding
          (expectedApplicationVisibleScope
            (mExpr "unify" [atom, pattern, template, mBool false]) (mSym "Bool"))
          kernelEnv st.world selected.typeBindings (.sym "unify")
          selected.functionType = .inr [] := by
    simpa [selected, mExpr, mSym] using
      (mettaTypeCastAvoiding_symbolic_arrow
        (expectedApplicationVisibleScope
          (mExpr "unify" [atom, pattern, template, mBool false]) (mSym "Bool"))
        kernelEnv st.world "unify"
        ["Atom", "Atom", "Atom", "Atom", "%Undefined%"] (by
          simpa [mExpr, mSym] using hTypesEq))
  have hOrdinaryPlan : ApplicationPlanCorresponds []
      (.selected selected hOrdinary) := by
    simpa [selected, mExpr, mSym] using
      (applicationPlanCorresponds_atom_args_symbolic_return_selected
        kernelEnv st.world "unify" "%Undefined%"
        [atom, pattern, template, mBool false] hTypesEq hOrdinary)
  rw [mettaEvalExpected_eq_mettaEval_of_same_selected
    kernelEnv (fuel + 1) st "unify" [atom, pattern, template, mBool false]
      (mSym "Bool") (by rfl) (by rfl) (by simp [Metta.Atom.isError])
      selected hOrdinary hOrdinaryPlan hExpected [] hHead (by simp)]
  exact mettaEval_kernelEnv_embedded_unify_fallback_false_eq
    fuel st atom pattern template hTypes hExtra hImports hNoErr hmatch hRootNotSelf

/-- Full-runtime executable `is-bad` lift to the explicit `false` branch.

The theorem is intentionally exact-state and keeps LeaTTa's freshened matcher
variable in the intermediate `unify` root.  It is the finite-control fact that
the later `convReadout` proof needs: once the `is-bad` root query misses the
`Bad` pattern, the full executable evaluator returns `false` and preserves the
local-rule slice. -/
theorem mettaEval_kernelEnv_is_bad_false_eq
    (fuel : Nat) (st : St) (a : Metta.Atom)
    (hTypes : KernelEnvTypeWorld st.world)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hClosed : a.vars = [])
    (hErr : a.isError = false)
    (_hEq : (a == a) = true)
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w)
    (hmatch : Metta.matchAtoms a
      (mExpr "Bad" [mVar (counterSuffix st.counter "e")]) = []) :
    mettaEval kernelEnv (fuel + 3) st [] (mExpr "is-bad" [a]) =
      ([(mBool false, [])], { counter := st.counter + 1, world := st.world }) := by
  let root :=
    mExpr "unify"
      [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false]
  let m : Metta.Bindings :=
    (renameBindings (counterSuffix st.counter)
      [Metta.BindingRel.val "x" a]).reverse
  let st' : St := { counter := st.counter + 1, world := st.world }
  rw [show fuel + 3 = (fuel + 2) + 1 by omega]
  change mettaEval kernelEnv ((fuel + 2) + 1) st [] (.expr [.sym "is-bad", a]) =
    ([(mBool false, [])], { counter := st.counter + 1, world := st.world })
  let hPolicy := kernelEnv_is_bad_exactPolicy st a hTypes.isBad
  have hIsBadTypes : getTypes kernelEnv
      (typePrep st.world (.sym "is-bad")) =
        [.expr [.sym "->", .sym "Atom", .sym "Bool"]] := by
    simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.isBad
  have hPlan : ApplicationPlanCorresponds []
      (.selected hPolicy.decision.selectedType hPolicy.selected_eq) := by
    exact hPolicy.applicationPlanCorresponds hIsBadTypes
  have hArgumentPolicies :
      argumentEvaluationPolicies hPolicy.decision.selectedType 1 =
        [(false, .sym "Atom")] := by
    exact hPolicy.argumentPolicies_eq
  rw [mettaEval_eq_evaluateExpectedApplication_of_selected
    kernelEnv (fuel + 2) st "is-bad" [a]
      hPolicy.decision.selectedType (by simp [Metta.Atom.isError])
      hPolicy.selected_eq hPlan]
  have hNoErrIf :
      (if (((a == emptyA) = true ∨ a.isError = true) ∧ (a != a) = true)
        then some (a, a) else none) = none := by
    have hnone :=
      firstChangedArgumentStop_self_eq_none_of_forall_not_error [a]
        (by simpa using hErr)
    simpa [firstChangedArgumentStop] using hnone
  simp only [evaluateExpectedApplication, evaluateExpectedApplicationFrom,
    hArgumentPolicies,
    List.length_cons, List.length_nil, Nat.reduceAdd,
    List.zip_cons_cons, List.zip_nil_right, List.foldl_cons, List.foldl_nil]
  simp [Metta.instantiate_nil]
  rw [hNoErrIf]
  have hroot :
      interpretFuel kernelEnv (fuel + 3) st [evalItemNil (mExpr "is-bad" [a])] [] =
        ([(root, m)], st') := by
    simpa [root, m, st', Nat.add_assoc] using
      (interpretFuel_kernelEnv_is_bad_root_eq
        (fuel := fuel + 2) st a hStatic hImports hClosed hNonVar)
  have hrootDirect :
      interpretFuel kernelEnv (fuel + 3) st
          [{ stack := atomToStack
              (Atom.expr [Atom.sym "eval",
                Atom.expr [Atom.sym "is-bad", a]]) [],
             bnd := [] }] [] =
        ([(root, m)], st') := by
    simpa [evalItemNil, mExpr, mSym, Metta.instantiate_nil, root, m, st'] using hroot
  rw [hrootDirect]
  have hExtra' : st'.world.selfExtra = [] := by
    simpa [st'] using hStatic
  have hImports' : st'.world.selfImports = [] := by
    simpa [st'] using hImports
  have hRootNoErr :
      (([a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false].zip
          [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none := by
    have hPatternErr :
        (mExpr "Bad" [mVar (counterSuffix st.counter "e")]).isError = false := by
      change Metta.Atom.isError
          (Atom.expr [Atom.sym "Bad", Atom.var (counterSuffix st.counter "e")]) = false
      rfl
    simp [List.find?, hErr, mExpr, mSym, mVar, mBool]
    simp [Metta.Atom.isError]
  have hRootNotSelf :
      (mBool false == root) = false := by
    change Metta.Atom.beq (mBool false) root = false
    simp [root, mExpr, mSym, mVar, mBool, Metta.Atom.beq]
  have hrootEval :
      mettaEvalExpected kernelEnv (fuel + 2) st' [] root (.sym "Bool") =
        ([(mBool false, [])], st') := by
    simpa [root, st', mSym] using
      (mettaEvalExpected_kernelEnv_embedded_unify_fallback_false_eq
        (fuel := fuel) (st := st')
        (atom := a)
        (pattern := mExpr "Bad" [mVar (counterSuffix st.counter "e")])
        (template := mBool true)
        (by simpa [st'] using hTypes)
        hExtra' hImports' hRootNoErr hmatch hRootNotSelf)
  simp [hPolicy.returnsAtom_selectedType_eq,
    hPolicy.resultExpected_eq, expectedApplicationRetentionScope,
    hClosed, restrictBnd_nil_vars]
  rw [congrArg Prod.fst hrootEval, congrArg Prod.snd hrootEval]
  have hRootNotReducible :
      (root == notReducibleA) = false := by
    change Metta.Atom.beq
        (Atom.expr
          [Atom.sym "unify", a, Atom.expr [Atom.sym "Bad", Atom.var (counterSuffix st.counter "e")],
            Atom.gnd (Ground.bool true), Atom.gnd (Ground.bool false)])
        notReducibleA = false
    rfl
  have hRootNotIsBad :
      (root == Atom.expr [Atom.sym "is-bad", a]) = false := by
    change Metta.Atom.beq
        (Atom.expr
          [Atom.sym "unify", a, Atom.expr [Atom.sym "Bad", Atom.var (counterSuffix st.counter "e")],
            Atom.gnd (Ground.bool true), Atom.gnd (Ground.bool false)])
        (Atom.expr [Atom.sym "is-bad", a]) = false
    rfl
  rw [hRootNotReducible, hRootNotIsBad]
  simp [st']

/-- The root evaluator reports `NotReducible` for bare variables in the initial core kernel
space. -/
theorem interpretFuel_eval_mVar_notReducible_eq (fuel : Nat) (v : String) :
    interpretFuel kernelCoreEnv (fuel + 1) St.init [evalItemNil (mVar v)] [] =
      ([(notReducibleA, [])], St.init) := by
  simpa [evalItemNil, atomToStack, varsCopy, mVar, Metta.instantiate_nil] using
    (interpretFuel_eval_var_notReducible_eq
