def nfPiReadout (sig : DIndGArtifactSig)
    (rawDomain rawBody : DIndGArtifactTerm) : Metta.Atom :=
  mExpr "Pi"
    [ mExpr "nf" [sigAtom sig, termAtom rawDomain]
    , mExpr "nf" [sigAtom sig, termAtom rawBody] ]

def nfLamReadout (sig : DIndGArtifactSig)
    (rawDomain rawBody : DIndGArtifactTerm) : Metta.Atom :=
  mExpr "Lam"
    [ mExpr "nf" [sigAtom sig, termAtom rawDomain]
    , mExpr "nf" [sigAtom sig, termAtom rawBody] ]

/-- Runtime root readout shape for the name-free recursive `nf` fragment. -/
def nfRootReadoutNameFree (sig : DIndGArtifactSig) : DIndGArtifactTerm → Metta.Atom
  | .pi rawDomain rawBody => nfPiReadout sig rawDomain rawBody
  | .lam rawDomain rawBody => nfLamReadout sig rawDomain rawBody
  | raw => termAtom raw

private def nfPiRuleLhs : Metta.Atom :=
  mExpr "nf" [mVar "sig", mExpr "Pi" [mVar "A", mVar "B"]]

private def nfPiRuleRhs : Metta.Atom :=
  mExpr "Pi"
    [ mExpr "nf" [mVar "sig", mVar "A"]
    , mExpr "nf" [mVar "sig", mVar "B"] ]

private def nfPiRuleBindings
    (sig : DIndGArtifactSig) (rawDomain rawBody : DIndGArtifactTerm) :
    Metta.Bindings :=
  [ Metta.BindingRel.val "A" (termAtom rawDomain)
  , Metta.BindingRel.val "B" (termAtom rawBody)
  , Metta.BindingRel.val "sig" (sigAtom sig) ]

private def nfLamRuleLhs : Metta.Atom :=
  mExpr "nf" [mVar "sig", mExpr "Lam" [mVar "A", mVar "b"]]

private def nfLamRuleRhs : Metta.Atom :=
  mExpr "Lam"
    [ mExpr "nf" [mVar "sig", mVar "A"]
    , mExpr "nf" [mVar "sig", mVar "b"] ]

private def nfLamRuleBindings
    (sig : DIndGArtifactSig) (rawDomain rawBody : DIndGArtifactTerm) :
    Metta.Bindings :=
  [ Metta.BindingRel.val "A" (termAtom rawDomain)
  , Metta.BindingRel.val "b" (termAtom rawBody)
  , Metta.BindingRel.val "sig" (sigAtom sig) ]

private def nfVarRuleBindings (sig : DIndGArtifactSig) (k : Nat) :
    Metta.Bindings :=
  [ Metta.BindingRel.val "k" (mNat k)
  , Metta.BindingRel.val "sig" (sigAtom sig) ]

private def nfSrtRuleBindings (sig : DIndGArtifactSig) (sort : DIndGArtifactSort) :
    Metta.Bindings :=
