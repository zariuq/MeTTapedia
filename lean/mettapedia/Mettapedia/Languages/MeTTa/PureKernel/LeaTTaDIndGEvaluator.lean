      [mExpr "->" [mSym "Atom", mSym "Bool"]]) :
    QuotedBoolApplicationPolicy kernelEnv st.world "is-bad" [a] := by
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->" [mSym "Atom", mSym "Bool"]
      argumentTypes := [mSym "Atom"]
      returnType := mSym "Bool"
      typeBindings := [] }
