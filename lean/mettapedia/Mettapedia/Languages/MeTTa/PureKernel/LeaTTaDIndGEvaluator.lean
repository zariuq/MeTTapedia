/-- Name-free runtime `nf` root readouts are closed atoms. -/
theorem nfRootReadoutNameFree_vars_nil
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    (hName : NfEqFragmentTermNameFree raw) :
    (nfRootReadoutNameFree sig raw).vars = [] := by
  induction hName with
  | var k =>
      simpa [nfRootReadoutNameFree] using termAtom_vars_nil (.var k)
  | srt sort =>
      simpa [nfRootReadoutNameFree] using termAtom_vars_nil (.srt sort)
  | bad reason =>
      simpa [nfRootReadoutNameFree] using termAtom_vars_nil (.bad reason)
  | @pi rawDomain rawBody hDomain hBody ihDomain ihBody =>
      simp [nfRootReadoutNameFree, nfPiReadout, sigAtom_vars_nil sig,
        termAtom_vars_nil rawDomain, termAtom_vars_nil rawBody, mExpr, mSym, Metta.Atom.vars]
  | @lam rawDomain rawBody hDomain hBody ihDomain ihBody =>
      simp [nfRootReadoutNameFree, nfLamReadout, sigAtom_vars_nil sig,
        termAtom_vars_nil rawDomain, termAtom_vars_nil rawBody, mExpr, mSym, Metta.Atom.vars]

/-- Name-free runtime `nf` root readouts are object-language atoms, never LeaTTa matcher variables. -/
theorem nfRootReadoutNameFree_not_var
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    (hName : NfEqFragmentTermNameFree raw) :
    ∀ v, nfRootReadoutNameFree sig raw ≠ Metta.Atom.var v := by
  intro v
  cases hName <;>
    simp [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
      termAtom, mExpr, mSym]

/-- Name-free runtime `nf` root readouts are never `function` control results. -/
theorem nfRootReadoutNameFree_not_function
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    (hName : NfEqFragmentTermNameFree raw) :
    ∀ tail, nfRootReadoutNameFree sig raw ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail) := by
  intro tail
  cases hName <;>
    simp [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
      termAtom, mExpr, mSym]

/-- Non-`Bad` name-free runtime `nf` root readouts do not match the `is-bad`
witness pattern. -/
theorem nfRootReadoutNameFree_not_match_bad_pattern
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    (badVar : String)
    (hName : NfEqFragmentTermNameFree raw)
    (hNotBad : ∀ reason, raw ≠ .bad reason) :
    Metta.matchAtoms (nfRootReadoutNameFree sig raw) (mExpr "Bad" [mVar badVar]) = [] := by
  induction hName with
  | var k =>
      simp [nfRootReadoutNameFree, termAtom, mExpr, mSym, mVar, mNat,
        Metta.matchAtoms, Metta.matchAtomsWith, Metta.matchAll]
  | srt sort =>
      cases sort <;>
        simp [nfRootReadoutNameFree, termAtom, sortAtom, mExpr, mSym, mVar,
          Metta.matchAtoms, Metta.matchAtomsWith, Metta.matchAll]
  | bad reason =>
      exact False.elim (hNotBad reason rfl)
  | pi hDomain hBody ihDomain ihBody =>
      simp [nfRootReadoutNameFree, nfPiReadout, mExpr, mSym, mVar,
        Metta.matchAtoms, Metta.matchAtomsWith, Metta.matchAll]
  | lam hDomain hBody ihDomain ihBody =>
      simp [nfRootReadoutNameFree, nfLamReadout, mExpr, mSym, mVar,
        Metta.matchAtoms, Metta.matchAtomsWith, Metta.matchAll]

/-- The stdlib-extended kernel runtime declares `conv : Atom -> Atom -> Atom -> Bool`. -/
theorem kernelEnv_conv_sigs :
    kernelEnv.sigs.get? "conv" =
      some [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Bool"] := by
  simp only [kernelEnv]
  unfold kernelControlSigs
  repeat rw [Std.HashMap.get?_insert]
  simp [mSym]

/-- Every executable-kernel `conv` query passes LeaTTa's runtime argument type check. -/
theorem kernelEnv_conv_typeMismatch
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    typeMismatch kernelEnv St.init.world "conv"
      [sigAtom sig, termAtom rawLeft, termAtom rawRight] = none := by
  rw [typeMismatch, kernelEnv_conv_sigs]
  exact typeCheckArgs_three_atom kernelEnv St.init.world
    (sigAtom sig) (termAtom rawLeft) (termAtom rawRight)

/-- The executable kernel `conv` declaration quotes all three arguments as atoms. -/
theorem kernelEnv_conv_argMask :
    argMask kernelEnv "conv" 3 = [false, false, false] := by
  rw [argMask, kernelEnv_conv_sigs]
  rfl

/-- An executable-kernel `conv` query is Boolean-returning, so `mettaEval` recurses into its body. -/
theorem kernelEnv_conv_returnsAtom
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    returnsAtom kernelEnv (convQuery sig rawLeft rawRight) = false := by
  simp only [returnsAtom, convQuery, sigAtom, mExpr, mSym, headKey]
  rw [kernelEnv_conv_sigs]
  rfl

/-- Rule-extension form of the premise-free `nf`/`ConvDecl` package.

The executable readout is still the actual `kernelCoreEnv` readout.  The new
content is the certified relation side: the root and contextual kernel chains
lift through any rule-list extension.  This is the environment-composition
surface needed by later helper slices whose rules strictly extend the core. -/
theorem nf_eq_fragment_mettaEval_decl_conv_append_left_of_fragment
    {extra : List Metta.Atom}
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {term : PureTm 0}
    (hfrag : NfEqFragmentTerm raw)
    (htr :
      DIndGArtifactTermTranslates sig.nameTranslates 0 raw term) :
    ∃ rootOut rootCertified,
      rootOut ∈ (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig raw)).1.map (·.1) ∧
        Relation.ReflTransGen (Metta.KernelStep (kernelCoreRules ++ extra) stdGroundings)
          (nfQuery sig raw) rootCertified ∧
        Metta.AlphaEq rootOut rootCertified ∧
        Relation.ReflTransGen (ExprCtxKernelStep (kernelCoreRules ++ extra) stdGroundings)
          rootCertified (termAtom raw) ∧
        RedStarDecl (envOfSpecs sig.translatedSpecs) term term ∧
        ConvDecl (envOfSpecs sig.translatedSpecs) term term := by
  rcases nf_eq_fragment_mettaEval_decl_conv_of_fragment hfrag htr with
    ⟨rootOut, rootCertified, hrun, hroot, halpha, hctx, hred, hconv⟩
  exact ⟨rootOut, rootCertified, hrun,
    kernelChain_append_left (extra := extra) hroot,
    halpha,
    exprCtxKernelChain_append_left (extra := extra) hctx,
    hred, hconv⟩

