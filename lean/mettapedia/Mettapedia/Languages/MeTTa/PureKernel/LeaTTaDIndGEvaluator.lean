theorem mettaEval_kernelDefControlEnv_def_body_of_nonWitness_body_eq_state
    (fuel : Nat) (st : St)
    (hWorld : st.world = St.init.world) :
    mettaEval kernelDefControlEnv (fuel + 6) st []
        (defBodyOfQueryAtom
          (sigAtom leattaDefControlNonWitnessSig)
          (declNameAtom leattaDefControlNonWitnessName)) =
      ([(termAtom leattaDefControlNonWitnessBody, [])],
        { counter := st.counter + 3, world := st.world }) := by
  let rest := cicStage3RawArtifactSigWithPropToType0Witness
  let name := leattaDefControlNonWitnessName
  let ty := leattaDefControlNonWitnessType
  let body := leattaDefControlNonWitnessBody
  let fullSig := sigWithHeadDecl (.ddef name ty body) rest
  let query :=
    defBodyOfQueryAtom (sigAtom fullSig) (declNameAtom name)
  let root :=
    defBodyOfDDefReadout rest name ty body name
  let rootBnd :=
    (renameBindings (counterSuffix st.counter)
      (defBodyOfDDefRuleBindings rest name ty body name)).reverse
  let stRoot : St := { counter := st.counter + 1, world := st.world }
  have hStatic : st.world.selfExtra = [] := by
    simpa [hWorld] using (show St.init.world.selfExtra = [] by rfl)
  have hImports : st.world.selfImports = [] := by
    simpa [hWorld] using (show St.init.world.selfImports = [] by rfl)
  have hOuterRoot :
      interpretFuel kernelDefControlEnv (fuel + 5 + 1) st
          [evalItemNil query] [] =
        ([(root, rootBnd)], stRoot) := by
    simpa [query, fullSig, root, rootBnd, rest, name, ty, body, stRoot,
      leattaDefControlNonWitnessSig, leattaDefControlNonWitnessName,
      leattaDefControlNonWitnessType, leattaDefControlNonWitnessBody,
      sigWithHeadDecl] using
      (interpretFuel_kernelDefControlEnv_def_body_of_ddef_root_eq
        (fuel := fuel + 5) (st := st)
        rest name ty body name hStatic hImports)
  let thenA := termAtom body
  let elseA := defBodyOfQueryAtom (sigAtom rest) (declNameAtom name)
  let cond := mExpr "==" [declNameAtom name, declNameAtom name]
  let ifRoot := mExpr "if" [cond, thenA, elseA]
  let ifRootBnd :=
    (renameBindings (counterSuffix stRoot.counter)
      [Metta.BindingRel.val "e" elseA,
       Metta.BindingRel.val "t" thenA]).reverse
  let stIfRoot : St := { counter := stRoot.counter + 2, world := stRoot.world }
  have hCond :
      mettaEval kernelDefControlEnv (fuel + 4) stRoot [] cond =
        ([(mBool true, [])], stRoot) := by
    simpa [cond, stRoot, hWorld, Nat.add_assoc] using
      mettaEval_kernelDefControlEnv_declName_eq_self_true_eq
        (fuel + 2) stRoot name (by simp [stRoot, hWorld])
  have hCondExpected :
      mettaEvalExpected kernelDefControlEnv (fuel + 4) stRoot [] cond
          (mSym "Bool") =
        ([(mBool true, [])], stRoot) := by
    simpa [cond] using
      mettaEvalExpected_kernelDefControlEnv_eq_of_bool_eval
        (fuel + 4) stRoot stRoot (declNameAtom name) (declNameAtom name) true
        (by simpa [stRoot, hWorld] using kernelDefControlEnvTypeWorld_init) hCond
  have hIfRoot :
      interpretFuel kernelDefControlEnv (fuel + 4 + 1) stRoot
          [evalItemNil (mExpr "if" [mBool true, thenA, elseA])] [] =
        ([(thenA, ifRootBnd)], stIfRoot) := by
    have hThenClosed : thenA.vars = [] := by
      simpa [thenA] using termAtom_vars_nil body
    have hElseClosed : elseA.vars = [] := by
      simp [elseA, defBodyOfQueryAtom, sigAtom_vars_nil, declNameAtom_vars_nil,
        mExpr, mSym, Metta.Atom.vars]
    have hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w := by
      intro w
      simpa [thenA] using termAtom_not_var body w
    have hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w := by
      intro w
      simp [elseA, defBodyOfQueryAtom, mExpr, mSym]
    have hThenNotFunction :
        ∀ tail, thenA ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail) := by
      intro tail
      simpa [thenA] using termAtom_not_function_head body tail
    have hStaticRoot : stRoot.world.selfExtra = [] := by
      simpa [stRoot, hWorld] using (show St.init.world.selfExtra = [] by rfl)
    have hImportsRoot : stRoot.world.selfImports = [] := by
      simpa [stRoot, hWorld] using (show St.init.world.selfImports = [] by rfl)
    simpa [thenA, elseA, ifRootBnd, stIfRoot, stRoot, Nat.add_assoc] using
      interpretFuel_kernelDefControlEnv_if_true_root_eq
        (fuel := fuel + 4) (st := stRoot) thenA elseA
        hStaticRoot hImportsRoot
        hThenClosed hElseClosed hThenNonVar hElseNonVar hThenNotFunction
        (by simpa [thenA] using termAtom_ne_empty body)
  have hIfExact :
      mettaEval kernelDefControlEnv (fuel + 5) stRoot [] ifRoot =
        ([(termAtom body, [])], stIfRoot) := by
    have hPolicy :
        EvalQuotedQuotedApplicationPolicy kernelDefControlEnv stRoot.world "if"
          [cond, thenA, elseA] (mSym "Bool") := by
      simpa [cond, stRoot, hWorld] using
        kernelDefControlEnv_if_exactPolicy_declName_eq_self_init name thenA elseA
    have hPlan : ApplicationPlanCorresponds []
        (.selected hPolicy.raw.decision.selectedType hPolicy.selected_eq) :=
      kernelDefControlEnv_if_declName_eq_self_applicationPlanCorresponds_of_world_eq
        name cond thenA elseA rfl (by simp [stRoot, hWorld]) hPolicy
    have hNoErr :
        (([mBool true, thenA, elseA].zip [cond, thenA, elseA]).find?
          (fun ho : Metta.Atom × Metta.Atom => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none := by
      have hThenErr : thenA.isError = false := by
        simpa [thenA] using termAtom_isError_false body
      have hElseErr : elseA.isError = false := by
        simp [elseA, defBodyOfQueryAtom, mExpr, mSym, Metta.Atom.isError]
      simp [Metta.Atom.isError] at hThenErr hElseErr
      simp [hThenErr, hElseErr, cond, mBool, mExpr, mSym, Metta.Atom.isError]
    have hRootNotNR : (thenA == notReducibleA) = false := by
      simpa [thenA] using termAtom_beq_notReducible_false body
    have hRootNotSelf :
        (thenA == mExpr "if" [mBool true, thenA, elseA]) = false := by
      simpa [thenA] using termAtom_beq_if_true_self_else_false body elseA
    have hThenEval :
        mettaEval kernelDefControlEnv (fuel + 4) stIfRoot [] thenA =
          ([(termAtom body, [])], stIfRoot) := by
      have hStaticIf : stIfRoot.world.selfExtra = [] := by
        simpa [stIfRoot, stRoot, hWorld] using
          (show St.init.world.selfExtra = [] by rfl)
      have hImportsIf : stIfRoot.world.selfImports = [] := by
        simpa [stIfRoot, stRoot, hWorld] using
          (show St.init.world.selfImports = [] by rfl)
      rw [show thenA = termAtom (.srt .type) by
        simp [thenA, body, leattaDefControlNonWitnessBody]]
      rw [show termAtom body = termAtom (.srt .type) by
        simp [body, leattaDefControlNonWitnessBody]]
      simpa [Nat.add_assoc] using
        mettaEval_kernelDefControlEnv_termAtom_srt_eq_state
          (fuel + 2) stIfRoot .type hStaticIf hImportsIf
          (by simpa [stIfRoot, stRoot, hWorld] using kernelDefControlEnvTypeWorld_init)
    have hExact :=
      mettaEval_ternary_expr_eq_of_eval_quoted_quoted_and_root_eval_eq
        (env := kernelDefControlEnv) (fuel := fuel + 4)
        (st := stRoot) (stCond := stRoot) (stRoot := stIfRoot)
        (stOut := stIfRoot)
        (op := "if") (hOpNotError := by decide)
        (cond := cond) (thenA := thenA) (elseA := elseA)
        (cond' := mBool true) (root := thenA) (final := termAtom body)
        (rootBnd := ifRootBnd)
        hCondExpected hPolicy hPlan hNoErr hIfRoot hRootNotNR hRootNotSelf
        (by
          simpa [thenA, body, restrictBnd_nil_vars, termAtom_vars_nil,
            defBodyOfQueryAtom, sigAtom_vars_nil, declNameAtom_vars_nil,
            cond, elseA, Metta.Atom.vars, mExpr, mSym] using hThenEval)
    simpa [ifRoot, cond, thenA, elseA, body, restrictBnd_nil_vars,
      termAtom_vars_nil, defBodyOfQueryAtom, sigAtom_vars_nil, declNameAtom_vars_nil,
      Metta.Atom.vars, mExpr, mSym] using hExact
  have hTypes : KernelDefControlEnvTypeWorld st.world := by
    simpa [hWorld] using kernelDefControlEnvTypeWorld_init
  have hOuterPolicy :
      RecursionNeutralApplicationPolicy kernelDefControlEnv st.world "def-body-of"
        [sigAtom fullSig, declNameAtom name] [false, false] false :=
    kernelDefControlEnv_def_body_of_recursionNeutralPolicy st
      (sigAtom fullSig) (declNameAtom name) hTypes.defBodyOf
  have hOuterNoErr :
      (([sigAtom fullSig, declNameAtom name].zip
          [sigAtom fullSig, declNameAtom name]).find?
        (fun ho : Metta.Atom × Metta.Atom => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none := by
    simp [sigAtom_isError_false, declNameAtom_isError_false]
  have hOuterRootNotNR : (root == notReducibleA) = false := by
    rfl
  have hOuterRootNotSelf :
      (root == Metta.Atom.expr
          [Metta.Atom.sym "def-body-of", sigAtom fullSig, declNameAtom name]) = false := by
    rfl
  have hExact :=
    mettaEval_binary_expr_eq_of_quoted_args_and_root_eval_eq
      (env := kernelDefControlEnv) (fuel := fuel + 5)
      (st := st) (stRoot := stRoot) (stOut := stIfRoot)
      (op := "def-body-of") (x := sigAtom fullSig) (y := declNameAtom name)
      (root := root) (final := termAtom body)
      (rootBnd := rootBnd)
      hOuterPolicy (by simp [Metta.Atom.isError]) hOuterNoErr
      (by simpa [query, fullSig, defBodyOfQueryAtom, mExpr, mSym] using hOuterRoot)
      hOuterRootNotNR hOuterRootNotSelf
      (by
        simpa [root, ifRoot, cond, thenA, elseA, body,
          defBodyOfDDefReadout, defBodyOfQueryAtom, restrictBnd_nil_vars,
          sigAtom_vars_nil, declNameAtom_vars_nil, termAtom_vars_nil,
          Metta.Atom.vars, mExpr, mSym] using hIfExact)
  simpa [query, fullSig, name, body, rest, ty,
    leattaDefControlNonWitnessSig, leattaDefControlNonWitnessName,
    leattaDefControlNonWitnessType, leattaDefControlNonWitnessBody,
    sigWithHeadDecl, stRoot, stIfRoot, restrictBnd_nil_vars,
    sigAtom_vars_nil, declNameAtom_vars_nil, defBodyOfQueryAtom, mExpr, mSym,
    Metta.Atom.vars, Nat.add_assoc] using hExact

