theorem interpretFuel_kernelDefControlEnv_if_true_root_contains_fuel
    {fuel : Nat} {st : St} (thenA elseA : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hThenNotFunction : ∀ tail,
      thenA ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail))
    (hThenNotEmpty : (thenA != emptyA) = true) :
    (thenA,
        (renameBindings (counterSuffix st.counter)
          [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]).reverse) ∈
      (interpretFuel kernelDefControlEnv (fuel + 1) st
        [evalItemNil (mExpr "if" [mBool true, thenA, elseA])] []).1 := by
  let target := mExpr "if" [mBool true, thenA, elseA]
  let coreB : Metta.Bindings :=
    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix st.counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, mBool, hThenClosed, hElseClosed, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hElseClosed
      (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, bindingValueKeys]
  have hinst :
      Metta.instantiate [] target =
        Metta.Atom.expr (Metta.Atom.sym "if" :: [mBool true, thenA, elseA]) := by
    simp [target, mExpr, mSym, Metta.instantiate_nil]
  have hsplit :
      kernelDefControlEnv.candidates target = [] ++ ifTrueRulePair :: [ifFalseRulePair] := by
    have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
      simp [MinEnv.candidates, kernelDefControlEnv]
    rw [hcandidateEq]
    simpa [target] using kernelEnv_if_candidates true thenA elseA
  have hmatchCore : coreB ∈ Metta.matchAtoms ifTrueRulePair.1 target := by
    simpa [coreB, target] using
      (by
        rw [if_true_rule_match thenA elseA
          (by simp [hThenClosed]) (by simp [hElseClosed])
          hThenNonVar hElseNonVar
          (by simp [hThenClosed]) (by simp [hElseClosed])]
        simp :
        [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA] ∈
          Metta.matchAtoms ifTrueRulePair.1 (mExpr "if" [mBool true, thenA, elseA]))
  have hresult :
      Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
        thenA := by
    have hf : Function.Injective f := by
      simpa [f] using counterSuffix_injective st.counter
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename hclosedB
    have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
      rw [bindingValueKeys_renameBindings]
      exact List.Nodup.map hf hnodup
    have hreverse :
        Metta.instantiate (renameBindings f coreB).reverse
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 :=
      instantiate_reverse_closed_nodup hclosedRen hnodupRen _
    have hbound :
        ∀ v ∈ ifTrueRulePair.2.vars, ∃ t, Metta.Bindings.lookupVal coreB v = some t := by
      intro v hv
      have hv' : v = "t" := by
        simpa [ifTrueRulePair, mVar, Metta.Atom.vars] using hv
      subst v
      exact ⟨thenA, by simp [coreB, Metta.Bindings.lookupVal]⟩
    have hfresh :
        Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate coreB ifTrueRulePair.2 := by
      simpa [f] using
        instantiate_freshenRule_rhs_of_renamed_bindings
          st.counter ifTrueRulePair.1 ifTrueRulePair.2 coreB
          hclosedB.toValueBindings hclosedB.valueKeysFreshForValues
          (hclosedB.renamedValueKeysFreshForValues _) hbound
    have hcore : Metta.instantiate coreB ifTrueRulePair.2 = thenA :=
      by simpa [coreB] using
        if_true_instantiate_bindings thenA elseA hThenClosed hElseClosed
    calc
      Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 := by
            simpa [m] using hreverse
      _ = Metta.instantiate coreB ifTrueRulePair.2 := hfresh
      _ = thenA := hcore
  have hnotFunction :
      isFunctionResult
        (Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2) =
        false := by
    rw [hresult]
    cases thenA with
    | expr xs =>
        cases xs with
        | nil => rfl
        | cons h rest =>
            cases h with
            | sym op =>
                by_cases hop : op = "function"
                · subst hop
                  exfalso
                  exact hThenNotFunction rest rfl
                · simp [isFunctionResult]
            | var _ => simp [isFunctionResult]
            | gnd _ => simp [isFunctionResult]
            | expr _ => simp [isFunctionResult]
    | sym _ => rfl
    | var _ => rfl
    | gnd _ => rfl
  have hnotEmpty :
      (Metta.instantiate m
        (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 != emptyA) = true := by
    rw [hresult]
    exact hThenNotEmpty
  have hmem :
      (Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2, m) ∈
        (interpretFuel kernelDefControlEnv (fuel + 1) st [evalItemNil target] []).1 := by
    simpa [m, f, coreB, ifTrueRulePair] using
      (interpretFuel_selected_rule_contains_of_env
        (env := kernelDefControlEnv)
        (fuel := fuel) (st := st) (target := target)
        (lhs := ifTrueRulePair.1) (rhs := ifTrueRulePair.2)
        (coreB := coreB) (op := "if")
        (args := [mBool true, thenA, elseA])
        (pre := []) (post := [ifFalseRulePair])
        hStatic hclosedTarget hclosedB hnodup hinst
        (kernelDefControlEnv_callGrounded_if
          ([mBool true, thenA, elseA].map
            (fun a => resolveStates st.world (subTokens st.world a))))
        (by rfl) hsplit hmatchCore hnotEmpty hnotFunction)
  have hmem' :
      (thenA, m) ∈
        (interpretFuel kernelDefControlEnv (fuel + 1) st [evalItemNil target] []).1 := by
    simpa [hresult] using hmem
  simpa [target, m, f, coreB] using hmem'

theorem interpretFuel_kernelDefControlEnv_if_false_root_contains_fuel
    {fuel : Nat} {st : St} (thenA elseA : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hElseNotFunction : ∀ tail,
      elseA ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail))
    (hElseNotEmpty : (elseA != emptyA) = true) :
    (elseA,
        (renameBindings (counterSuffix (st.counter + 1))
          [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]).reverse) ∈
      (interpretFuel kernelDefControlEnv (fuel + 1) st
        [evalItemNil (mExpr "if" [mBool false, thenA, elseA])] []).1 := by
  let target := mExpr "if" [mBool false, thenA, elseA]
  let coreB : Metta.Bindings :=
    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix (st.counter + 1)
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, mBool, hThenClosed, hElseClosed, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hElseClosed
      (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, bindingValueKeys]
  have hinst :
      Metta.instantiate [] target =
        Metta.Atom.expr (Metta.Atom.sym "if" :: [mBool false, thenA, elseA]) := by
    simp [target, mExpr, mSym, Metta.instantiate_nil]
  have hsplit :
      kernelDefControlEnv.candidates target =
        [ifTrueRulePair] ++ ifFalseRulePair :: [] := by
    have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
      simp [MinEnv.candidates, kernelDefControlEnv]
    rw [hcandidateEq]
    simpa [target] using kernelEnv_if_candidates false thenA elseA
  have hmatchCore : coreB ∈ Metta.matchAtoms ifFalseRulePair.1 target := by
    simpa [coreB, target] using
      (by
        rw [if_false_rule_match thenA elseA
          (by simp [hThenClosed]) (by simp [hElseClosed])
          hThenNonVar hElseNonVar
          (by simp [hThenClosed]) (by simp [hElseClosed])]
        simp :
        [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA] ∈
          Metta.matchAtoms ifFalseRulePair.1 (mExpr "if" [mBool false, thenA, elseA]))
  have hresult :
      Metta.instantiate m (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
        elseA := by
    have hf : Function.Injective f := by
      simpa [f] using counterSuffix_injective (st.counter + 1)
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename hclosedB
    have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
      rw [bindingValueKeys_renameBindings]
      exact List.Nodup.map hf hnodup
    have hreverse :
        Metta.instantiate (renameBindings f coreB).reverse
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 :=
      instantiate_reverse_closed_nodup hclosedRen hnodupRen _
    have hbound :
        ∀ v ∈ ifFalseRulePair.2.vars, ∃ t, Metta.Bindings.lookupVal coreB v = some t := by
      intro v hv
      have hv' : v = "e" := by
        simpa [ifFalseRulePair, mVar, Metta.Atom.vars] using hv
      subst v
      exact ⟨elseA, by simp [coreB, Metta.Bindings.lookupVal]⟩
    have hfresh :
        Metta.instantiate (renameBindings f coreB)
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
          Metta.instantiate coreB ifFalseRulePair.2 := by
      simpa [f] using
        instantiate_freshenRule_rhs_of_renamed_bindings
          (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2 coreB
          hclosedB.toValueBindings hclosedB.valueKeysFreshForValues
          (hclosedB.renamedValueKeysFreshForValues _) hbound
    have hcore : Metta.instantiate coreB ifFalseRulePair.2 = elseA :=
      by simpa [coreB] using
        if_false_instantiate_bindings thenA elseA hThenClosed hElseClosed
    calc
      Metta.instantiate m (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 := by
            simpa [m] using hreverse
      _ = Metta.instantiate coreB ifFalseRulePair.2 := hfresh
      _ = elseA := hcore
  have hnotFunction :
      isFunctionResult
        (Metta.instantiate m (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2) =
        false := by
    rw [hresult]
    cases elseA with
    | expr xs =>
        cases xs with
        | nil => rfl
        | cons h rest =>
            cases h with
            | sym op =>
                by_cases hop : op = "function"
                · subst hop
                  exfalso
                  exact hElseNotFunction rest rfl
                · simp [isFunctionResult]
            | var _ => simp [isFunctionResult]
            | gnd _ => simp [isFunctionResult]
            | expr _ => simp [isFunctionResult]
    | sym _ => rfl
    | var _ => rfl
    | gnd _ => rfl
  have hnotEmpty :
      (Metta.instantiate m
        (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 !=
        emptyA) = true := by
    rw [hresult]
    exact hElseNotEmpty
  have hmem :
      (Metta.instantiate m (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2, m) ∈
        (interpretFuel kernelDefControlEnv (fuel + 1) st [evalItemNil target] []).1 := by
    simpa [m, f, coreB, ifFalseRulePair] using
      interpretFuel_selected_rule_contains_of_env
        (env := kernelDefControlEnv)
        (fuel := fuel) (st := st) (target := target)
        (lhs := ifFalseRulePair.1) (rhs := ifFalseRulePair.2)
        (coreB := coreB) (op := "if")
        (args := [mBool false, thenA, elseA])
        (pre := [ifTrueRulePair]) (post := [])
        hStatic hclosedTarget hclosedB hnodup hinst
        (kernelDefControlEnv_callGrounded_if
          ([mBool false, thenA, elseA].map
            (fun a => resolveStates st.world (subTokens st.world a))))
      (by rfl) hsplit hmatchCore hnotEmpty hnotFunction
  simpa [target, m, f, coreB, hresult] using hmem

theorem mettaEval_ternary_expr_mem_of_eval_quoted_quoted_and_root_eval_member_state_pred
    (env : MinEnv) (fuel : Nat) (st stCond : St)
    (op : String) (hOpNotError : op ≠ "Error")
    (cond thenA elseA cond' root final : Metta.Atom) (rootBnd : Metta.Bindings)
    (P : St → Prop)
    (hCond : mettaEvalExpected env fuel st [] cond (mSym "Bool") =
      ([(cond', [])], stCond))
    (hPolicy : EvalQuotedQuotedApplicationPolicy env st.world op
      [cond, thenA, elseA] (mSym "Bool"))
    (hPlan : ApplicationPlanCorresponds []
      (.selected hPolicy.raw.decision.selectedType hPolicy.selected_eq))
    (hNoErr :
      (([cond', thenA, elseA].zip [cond, thenA, elseA]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hinit : P stCond)
    (hrootState :
      ∀ acc : List (Metta.Atom × Metta.Bindings) × St,
        P acc.2 →
          P (interpretFuel env (fuel + 1) acc.2
            [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, cond', thenA, elseA])] []).2)
    (hrecState :
      ∀ (acc : List (Metta.Atom × Metta.Bindings) × St)
        (p : Metta.Atom × Metta.Bindings),
        P acc.2 →
          P (mettaEval env fuel acc.2
            (restrictBnd (([cond, thenA, elseA]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] p.2).head?.getD p.2)) p.1).2)
    (hRoot : (root, rootBnd) ∈
      (interpretFuel env (fuel + 1) stCond
        [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, cond', thenA, elseA])] []).1)
    (hRootNotNotReducible : (root == notReducibleA) = false)
    (hRootNotSelf :
      (root == Metta.Atom.expr [Metta.Atom.sym op, cond', thenA, elseA]) = false)
    (hFinal : ∀ st0,
      P st0 →
        (final, []) ∈
          (mettaEval env fuel st0
            (restrictBnd (([cond, thenA, elseA]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) root).1)
    (hFinalNotError : final.isError = false) :
    (final,
        restrictBnd (([cond, thenA, elseA]).flatMap Metta.Atom.vars)
          (((restrictBnd (([cond, thenA, elseA]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)).merge
              ([] : Metta.Bindings)).head?.getD [])) ∈
      (mettaEval env (fuel + 1) st [] (Metta.Atom.expr [Metta.Atom.sym op, cond, thenA, elseA])).1 := by
  let qvars := ([cond, thenA, elseA]).flatMap Metta.Atom.vars
  rw [mettaEval_eq_evaluateExpectedApplication_of_selected
    env fuel st op [cond, thenA, elseA] hPolicy.raw.decision.selectedType
      (by simp [Metta.Atom.isError, hOpNotError]) hPolicy.selected_eq hPlan]
  apply mem_prioritizeSemanticResults_of_mem_of_not_error
    (hError := hFinalNotError)
  rw [evaluateExpectedApplication_eval_quoted_quoted_eq_mettaEvalExprPartFoldStep
    env fuel st stCond op cond thenA elseA cond' hPolicy hCond hNoErr]
  let rootItem : Item :=
    { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
        Metta.Atom.expr [Metta.Atom.sym op, cond', thenA, elseA]]) [],
      bnd := [] }
  cases hpairs : interpretFuel env (fuel + 1) stCond [rootItem] [] with
  | mk pairs stRoot =>
      have hpairsExact :
          interpretFuel env (fuel + 1) stCond
              [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
                  Metta.Atom.expr [Metta.Atom.sym op, cond', thenA, elseA]]) [],
                 bnd := [] }] [] =
            (pairs, stRoot) := by
        simpa [rootItem] using hpairs
      have hrootItem :
          [rootItem] =
            [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, cond', thenA, elseA])] := by
        simp [rootItem, evalItemNil]
      have hRootPairs : (root, rootBnd) ∈ pairs := by
        rw [hrootItem] at hpairs
        rw [hpairs] at hRoot
        exact hRoot
      have hRootState : P stRoot := by
        have hstate := hrootState ([], stCond) hinit
        rw [hrootItem] at hpairs
        rw [hpairs] at hstate
        exact hstate
      have hfold :=
        mettaEval_expr_root_evals_selected_readout_state_pred
          env fuel qvars (Metta.Atom.expr [Metta.Atom.sym op, cond', thenA, elseA]) [] false
          P (root, rootBnd) pairs stRoot final
          hRootPairs hRootNotNotReducible hRootNotSelf rfl hRootState
          (by
            intro acc p hP
            simpa [qvars] using hrecState acc p hP)
          (by
            intro st0 hP
            simpa [qvars] using hFinal st0 hP)
      unfold mettaEvalExprPartFoldStep
      rw [hNoErr]
      simp only [List.nil_append]
      rw [hpairsExact]
      simpa [qvars] using hfold

theorem mettaEval_ternary_expr_mem_of_quoted_eval_quoted_and_root_eval_member_state_pred
    (env : MinEnv) (fuel : Nat) (st stAtom : St)
    (op : String)
