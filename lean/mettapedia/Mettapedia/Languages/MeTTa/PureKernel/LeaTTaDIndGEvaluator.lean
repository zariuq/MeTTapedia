    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_unary_expr_var "Con" "x" (declNameAtom name) (declNameAtom_not_var name)]
