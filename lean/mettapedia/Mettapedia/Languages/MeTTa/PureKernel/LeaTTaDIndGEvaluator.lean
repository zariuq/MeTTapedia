/-- Runtime-root bridge for the smallest infer-family recursive helper.

The actual LeaTTa minimal evaluator emits the helper RHS, while the same source
rule gives a certified MOPS step to the unfreshened `nf` query.  The recursive
normalization that follows is supplied by `nf_eq_fragment_*_of_fragment`.
-/
theorem infer_apply_args_nil_evalAtomMin_bridge_alpha_mops
    (sig : DIndGArtifactSig) (rawType : DIndGArtifactTerm) :
    Metta.instantiate
        (renameBindings (counterSuffix St.init.counter)
          (inferApplyArgsNilRuleBindings sig rawType)).reverse
        (freshenRule St.init.counter inferApplyArgsNilRulePair.1
          inferApplyArgsNilRulePair.2).2 ∈
        evalAtomMin kernelInferApplyArgsNilEnv 1 (inferApplyArgsNilQuery sig rawType) ∧
      Relation.ReflTransGen (Metta.MopsStep kernelInferApplyArgsNilRules)
        (inferApplyArgsNilQuery sig rawType) (nfQuery sig rawType) ∧
      Metta.AlphaEq
        (Metta.instantiate
          (renameBindings (counterSuffix St.init.counter)
            (inferApplyArgsNilRuleBindings sig rawType)).reverse
          (freshenRule St.init.counter inferApplyArgsNilRulePair.1
            inferApplyArgsNilRulePair.2).2)
        (nfQuery sig rawType) := by
  let coreB : Metta.Bindings := inferApplyArgsNilRuleBindings sig rawType
