    simpa [firstChangedArgumentStop] using hnone
  rw [hNoErrIf]
  have hroot :
      interpretFuel kernelDefControlEnv (fuel + 3) st [evalItemNil (mExpr "is-bad" [a])] [] =
        ([(root, m)], st') := by
    simpa [root, m, st', Nat.add_assoc] using
      (interpretFuel_kernelDefControlEnv_is_bad_root_eq
        (fuel := fuel + 2) st a hStatic hImports hClosed hNonVar)
  have hrootDirect :
      interpretFuel kernelDefControlEnv (fuel + 3) st
          [{ stack := atomToStack
              (Atom.expr [Atom.sym "eval",
                Atom.expr [Atom.sym "is-bad", a]]) [],
             bnd := [] }] [] =
        ([(root, m)], st') := by
    simpa [evalItemNil, mExpr, mSym, root, m, st'] using hroot
  rw [hrootDirect]
  have hExtra' : st'.world.selfExtra = [] := by
    simpa [st'] using hStatic
  have hImports' : st'.world.selfImports = [] := by
    simpa [st'] using hImports
  have hTypes' : KernelDefControlEnvTypeWorld st'.world := by
    simpa [st'] using hTypes
  have hRootNoErr :
      (([a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false].zip
          [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none := by
    have hPatternErr :
        (mExpr "Bad" [mVar (counterSuffix st.counter "e")]).isError = false := by
      change Metta.Atom.isError
          (Atom.expr [Atom.sym "Bad", Atom.var (counterSuffix st.counter "e")]) = false
      rfl
    simp [List.find?, hErr, mExpr, mSym, mVar, mBool]
    simp [Metta.Atom.isError]
  have hRootNotSelf :
      (mBool false == root) = false := by
    change Metta.Atom.beq (mBool false) root = false
    simp [root, mExpr, mSym, mVar, mBool, Metta.Atom.beq]
  have hrootEval :
      mettaEvalExpected kernelDefControlEnv (fuel + 2) st' [] root (.sym "Bool") =
        ([(mBool false, [])], st') := by
    simpa [root, st', mSym] using
      (mettaEvalExpected_kernelDefControlEnv_embedded_unify_fallback_false_eq
        (fuel := fuel) (st := st')
        (atom := a)
        (pattern := mExpr "Bad" [mVar (counterSuffix st.counter "e")])
        (template := mBool true)
        hExtra' hImports' hTypes' hRootNoErr hmatch hRootNotSelf)
  simp [hPolicy.returnsAtom_selectedType_eq,
    hPolicy.resultExpected_eq,
    expectedApplicationRetentionScope, hClosed, restrictBnd_nil_vars]
  rw [congrArg Prod.fst hrootEval, congrArg Prod.snd hrootEval]
  have hRootNotReducible :
      (root == notReducibleA) = false := by
    change Metta.Atom.beq
        (Atom.expr
          [Atom.sym "unify", a, Atom.expr [Atom.sym "Bad", Atom.var (counterSuffix st.counter "e")],
            Atom.gnd (Ground.bool true), Atom.gnd (Ground.bool false)])
        notReducibleA = false
    rfl
  have hRootNotIsBad :
      (root == Atom.expr [Atom.sym "is-bad", a]) = false := by
    change Metta.Atom.beq
        (Atom.expr
          [Atom.sym "unify", a, Atom.expr [Atom.sym "Bad", Atom.var (counterSuffix st.counter "e")],
            Atom.gnd (Ground.bool true), Atom.gnd (Ground.bool false)])
        (Atom.expr [Atom.sym "is-bad", a]) = false
    rfl
  rw [hRootNotReducible, hRootNotIsBad]
  simp [st']

/-- A completed binary argument row with no changed error supplies the two
node-local guards needed by the early-stop scheduler. -/
private theorem binaryArgumentRow_no_changed_errors
    (xResult xSource yResult ySource : Metta.Atom)
    (hNoErr :
      (([xResult, yResult].zip [xSource, ySource]).find?
        (fun pair => (pair.1 == emptyA || pair.1.isError) && pair.1 != pair.2)) = none) :
    ¬ (((xResult == emptyA) = true ∨ xResult.isError = true) ∧ (xResult != xSource) = true) ∧
      ¬ (((yResult == emptyA) = true ∨ yResult.isError = true) ∧ (yResult != ySource) = true) := by
  constructor
  · exact argument_not_changed_terminal_of_mem_zip hNoErr (by simp)
  · exact argument_not_changed_terminal_of_mem_zip hNoErr (by simp)

/-- Ternary companion of `binaryArgumentRow_no_changed_errors`.  This keeps
the chronology proof at the completed-row boundary while exposing exactly the
three guards consumed by the sequential worker. -/
private theorem ternaryArgumentRow_no_changed_errors
    (xResult xSource yResult ySource zResult zSource : Metta.Atom)
    (hNoErr :
      (([xResult, yResult, zResult].zip [xSource, ySource, zSource]).find?
        (fun pair => (pair.1 == emptyA || pair.1.isError) && pair.1 != pair.2)) = none) :
    ¬ (((xResult == emptyA) = true ∨ xResult.isError = true) ∧ (xResult != xSource) = true) ∧
      ¬ (((yResult == emptyA) = true ∨ yResult.isError = true) ∧ (yResult != ySource) = true) ∧
        ¬ (((zResult == emptyA) = true ∨ zResult.isError = true) ∧ (zResult != zSource) = true) := by
  refine ⟨argument_not_changed_terminal_of_mem_zip hNoErr (by simp), ?_⟩
  exact ⟨argument_not_changed_terminal_of_mem_zip hNoErr (by simp),
    argument_not_changed_terminal_of_mem_zip hNoErr (by simp)⟩

/-- Quaternary companion of `binaryArgumentRow_no_changed_errors`. -/
private theorem quaternaryArgumentRow_no_changed_errors
    (wResult wSource xResult xSource yResult ySource zResult zSource :
      Metta.Atom)
    (hNoErr :
      (([wResult, xResult, yResult, zResult].zip
          [wSource, xSource, ySource, zSource]).find?
        (fun pair => (pair.1 == emptyA || pair.1.isError) && pair.1 != pair.2)) = none) :
    ¬ (((wResult == emptyA) = true ∨ wResult.isError = true) ∧ (wResult != wSource) = true) ∧
      ¬ (((xResult == emptyA) = true ∨ xResult.isError = true) ∧ (xResult != xSource) = true) ∧
        ¬ (((yResult == emptyA) = true ∨ yResult.isError = true) ∧ (yResult != ySource) = true) ∧
          ¬ (((zResult == emptyA) = true ∨ zResult.isError = true) ∧ (zResult != zSource) = true) := by
  refine ⟨argument_not_changed_terminal_of_mem_zip hNoErr (by simp), ?_⟩
  refine ⟨argument_not_changed_terminal_of_mem_zip hNoErr (by simp), ?_⟩
  exact ⟨argument_not_changed_terminal_of_mem_zip hNoErr (by simp),
    argument_not_changed_terminal_of_mem_zip hNoErr (by simp)⟩

/-- Promote an already-selected one-step `nf` root item through the outer
`mettaEval` loop of `kernelEnv`.

This factors out the common post-processing half of the executable `nf` bridge:
once a concrete root item has been harvested from the real one-step fuel driver,
the Atom-returning `mettaEval` fold keeps that same readout and strips the
closed query bindings back to `[]`.  Later state-aware `nf` lemmas can focus on
obtaining the root item in `interpretFuel` without redoing this fold proof. -/
theorem nf_interpretFuel_root_pair_mem_mettaEval_kernelEnv_state_fuel
    {fuel : Nat} {st : St} {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {rootOut : Metta.Atom} {rootBnd : Metta.Bindings}
    (hTypes : KernelEnvTypeWorld st.world)
    (hroot :
      (rootOut, rootBnd) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", nfQuery sig raw]) []
             bnd := [] }] []).1)
    (_hembed : isEmbeddedOp rootOut = false)
    (hnotNR : (rootOut == notReducibleA) = false)
    (hnotSelf : (rootOut == nfQuery sig raw) = false)
    (hNotError : rootOut.isError = false) :
    (rootOut, []) ∈
      (mettaEval kernelEnv (fuel + 1) st [] (nfQuery sig raw)).1 := by
  simp only [nfQuery, mExpr, mSym] at hnotSelf ⊢
  rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
    kernelEnv fuel st "nf" [sigAtom sig, termAtom raw] [false, false] true
    (kernelEnv_nf_recursionNeutralPolicy st (sigAtom sig) (termAtom raw) hTypes.nf)
    (by simp [Metta.Atom.isError])]
  simp only [evaluateSelectedApplication, List.zip_cons_cons, List.zip_nil_right,
    List.foldl_cons, List.foldl_nil]
  have hnoerr :
      List.find?
          (fun ho : Metta.Atom × Metta.Atom => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)
          [(sigAtom sig, sigAtom sig), (termAtom raw, termAtom raw)] = none := by
    simp [sigAtom_isError_false, termAtom_isError_false]
  rcases binaryArgumentRow_no_changed_errors
      (sigAtom sig) (sigAtom sig) (termAtom raw) (termAtom raw)
      (by simpa using hnoerr) with ⟨hSigNotChanged, hTermNotChanged⟩
  simp [Metta.instantiate_nil, hSigNotChanged, hTermNotChanged]
  cases hpairs : interpretFuel kernelEnv (fuel + 1) st
      [{ stack := atomToStack
          (Metta.Atom.expr [Metta.Atom.sym "eval",
            Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]]) []
         bnd := [] }] [] with
  | mk pairs st' =>
      have hrootExpanded :
          (rootOut, rootBnd) ∈
            (interpretFuel kernelEnv (fuel + 1) st
              [{ stack := atomToStack
                  (Metta.Atom.expr [Metta.Atom.sym "eval",
                    Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]]) []
                 bnd := [] }] []).1 := by
        simpa [nfQuery, mExpr, mSym] using hroot
      have hrootPairs : (rootOut, rootBnd) ∈ pairs := by
        rw [hpairs] at hrootExpanded
        simpa using hrootExpanded
      have hkeep :
          (rootOut,
              restrictBnd ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelEnv fuel
                ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [] true)
              ([], st')).1 :=
        mettaEval_expr_root_keeps_of_returnsAtom_readout
          kernelEnv fuel ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
          (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [] true
          (rootOut, rootBnd) pairs st'
          hrootPairs rfl
          hnotNR hnotSelf
      have hkeep' :
          (rootOut, []) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelEnv fuel []
                (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [] true)
              ([], st')).1 := by
        simpa [restrictBnd_nil_vars, List.flatMap, sigAtom_vars_nil sig, termAtom_vars_nil raw]
          using hkeep
      have hkeep'' :
          (rootOut, []) ∈
            (List.foldl
              (fun (a2 : List (Metta.Atom × Metta.Bindings) × St)
                  (p : Metta.Atom × Metta.Bindings) =>
                if (p.1 == notReducibleA) = true ∨
                    (p.1 == Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) = true then
                  (a2.1 ++
                      [(Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw],
                        ([] : Metta.Bindings))],
                    a2.2)
                else
                  if true = true then
                    (a2.1 ++ [(p.1, ([] : Metta.Bindings))], a2.2)
                  else
                    (a2.1 ++ List.map (fun m => (m.1, ([] : Metta.Bindings)))
                        (mettaEval kernelEnv fuel a2.2 [] p.1).1,
                      (mettaEval kernelEnv fuel a2.2 [] p.1).2))
              ([], st') pairs).1 := by
        unfold mettaEvalExprRootFoldStep at hkeep'
        simpa [restrictBnd_nil_vars] using hkeep'
      rw [sigAtom_vars_nil sig, termAtom_vars_nil raw]
      simp only [List.append_nil, restrictBnd_nil_vars]
      apply mem_prioritizeSemanticResults_of_mem_of_not_error _ hNotError
      simpa [hnoerr, hSigNotChanged, hTermNotChanged,
        termAtom_isError_false] using hkeep''

theorem mettaEval_binary_expr_eq_of_quoted_args_and_root_eval_eq
    (env : MinEnv) (fuel : Nat) (st stRoot stOut : St)
    (op : String)
    (x y root final : Metta.Atom) (rootBnd : Metta.Bindings)
    (hPolicy : RecursionNeutralApplicationPolicy env st.world op [x, y]
      [false, false] false)
    (hApplicationNotError :
      (Metta.Atom.expr [Metta.Atom.sym op, x, y]).isError = false)
    (hNoErr :
      (([x, y].zip [x, y]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hRoot : interpretFuel env (fuel + 1) st
        [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y])] [] =
      ([(root, rootBnd)], stRoot))
    (hRootNotNotReducible : (root == notReducibleA) = false)
    (hRootNotSelf : (root == Metta.Atom.expr [Metta.Atom.sym op, x, y]) = false)
    (hFinal :
      mettaEval env fuel stRoot
          (restrictBnd (([x, y]).flatMap Metta.Atom.vars)
            ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) root =
        ([(final, [])], stOut)) :
    mettaEval env (fuel + 1) st []
        (Metta.Atom.expr [Metta.Atom.sym op, x, y]) =
      ([(final,
        restrictBnd (([x, y]).flatMap Metta.Atom.vars)
          (((restrictBnd (([x, y]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)).merge
              ([] : Metta.Bindings)).head?.getD []))],
        stOut) := by
  rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
    env fuel st op [x, y] [false, false] false hPolicy hApplicationNotError]
  simp only [evaluateSelectedApplication, firstChangedArgumentStop,
    List.length_cons, List.length_nil, Nat.reduceAdd,
    List.zip_cons_cons, List.zip_nil_right, List.foldl_cons, List.foldl_nil]
  rcases binaryArgumentRow_no_changed_errors x x y y hNoErr with
    ⟨hXNotChanged, hYNotChanged⟩
  simp [Metta.instantiate_nil, hXNotChanged, hYNotChanged]
  have hRoot' :
      interpretFuel env (fuel + 1) st
        [{ stack := atomToStack
            (Metta.Atom.expr [Metta.Atom.sym "eval",
              Metta.Atom.expr [Metta.Atom.sym op, x, y]]) [] }] [] =
      ([(root, rootBnd)], stRoot) := by
    simpa [evalItemNil] using hRoot
  rw [hRoot']
  simp [hRootNotNotReducible, hRootNotSelf]
  have hFinal' :
      mettaEval env fuel stRoot
          (restrictBnd (x.vars ++ y.vars)
            ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) root =
        ([(final, [])], stOut) := by
    simpa [List.flatMap] using hFinal
  rw [hFinal']
  simp

