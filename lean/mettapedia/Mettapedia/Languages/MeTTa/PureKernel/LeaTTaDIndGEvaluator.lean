private def convFreshReadoutAt (counter : Nat)
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.Atom :=
  Metta.instantiate
    ((renameBindings (counterSuffix counter)
      (convRuleBindings sig rawLeft rawRight)).reverse)
    (freshenRule counter convRuleLhs convRuleRhs).2

private theorem queryOpItems_conv_eq
    (counter : Nat) (sig : DIndGArtifactSig)
    (rawLeft rawRight : DIndGArtifactTerm) :
    let target := convQuery sig rawLeft rawRight
    let coreB := convRuleBindings sig rawLeft rawRight
    let m := (renameBindings (counterSuffix counter) coreB).reverse
    queryOpItemsOfRule [] target [] counter (convRuleLhs, convRuleRhs) =
      [evalResult [] (convFreshReadoutAt counter sig rawLeft rawRight) m] := by
  dsimp
  let target := convQuery sig rawLeft rawRight
  let coreB := convRuleBindings sig rawLeft rawRight
  let f := counterSuffix counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (termAtom_vars_nil rawRight)
      (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))
  have hclosedM : ClosedValueBindings m := by
    simpa [m, coreB, f] using
      ClosedValueBindings.reverse
        (ClosedValueBindings.rename (f := f) hclosedB)
  have hsigx : f "sig" ≠ f "x" := by
    intro h
    exact (by decide : "sig" ≠ "x") ((counterSuffix_injective counter) h)
  have hxsig : f "x" ≠ f "sig" := fun h => hsigx h.symm
  have hsigy : f "sig" ≠ f "y" := by
    intro h
    exact (by decide : "sig" ≠ "y") ((counterSuffix_injective counter) h)
  have hysig : f "y" ≠ f "sig" := fun h => hsigy h.symm
  have hxy : f "x" ≠ f "y" := by
    intro h
    exact (by decide : "x" ≠ "y") ((counterSuffix_injective counter) h)
  have hyx : f "y" ≠ f "x" := fun h => hxy h.symm
  have hmatch :
      Metta.matchAtoms (freshenRule counter convRuleLhs convRuleRhs).1 target =
        [renameBindings f coreB] := by
    rw [freshenRule_eq_renBy]
    simp only [target, coreB, convRuleBindings, convRuleLhs, convQuery,
      renameBindings, f,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
      mExpr, mSym, mVar]
    simp only [List.map_cons, List.map_nil,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
    change
      Metta.matchAtoms
        (mExpr "conv" [mVar (f "sig"), mVar (f "x"), mVar (f "y")])
        (convQuery sig rawLeft rawRight) =
      [[ Metta.BindingRel.val (f "y") (termAtom rawRight)
       , Metta.BindingRel.val (f "x") (termAtom rawLeft)
       , Metta.BindingRel.val (f "sig") (sigAtom sig) ]]
    simp only [Metta.matchAtoms, Metta.matchAtomsWith, convQuery, mExpr, mSym, mVar]
    unfold Metta.matchAll
    simp [Metta.matchAtomsWith, Metta.Bindings.merge]
    unfold Metta.matchAll
    rw [match_var_nonvar_atom (f "sig") (sigAtom sig) (sigAtom_not_var sig)]
    simp [Metta.Bindings.merge, Metta.Bindings.mergeOne,
      Metta.Bindings.addVarBinding, Metta.Bindings.addValRaw,
      Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
    unfold Metta.matchAll
    rw [match_var_nonvar_atom (f "x") (termAtom rawLeft) (termAtom_not_var rawLeft)]
    simp [Metta.Bindings.merge, Metta.Bindings.mergeOne,
      Metta.Bindings.addVarBinding, Metta.Bindings.addValRaw,
      Metta.Bindings.removeVal, Metta.Bindings.lookupVal, hxsig]
    unfold Metta.matchAll
    rw [match_var_nonvar_atom (f "y") (termAtom rawRight) (termAtom_not_var rawRight)]
    simp [Metta.Bindings.merge, Metta.Bindings.mergeOne,
      Metta.Bindings.addVarBinding, Metta.Bindings.addValRaw,
      Metta.Bindings.removeVal, Metta.Bindings.lookupVal, hyx]
    unfold Metta.matchAll
    rfl
  have hmerge : Metta.Bindings.merge [] (renameBindings f coreB) = [m] := by
    simp [m, coreB, convRuleBindings, renameBindings, f,
      Metta.Bindings.merge, Metta.Bindings.mergeOne,
      Metta.Bindings.addVarBinding, Metta.Bindings.addValRaw,
      Metta.Bindings.removeVal, Metta.Bindings.lookupVal,
      hsigx, hxsig, hsigy, hysig, hxy, hyx]
  have hloop : Metta.Bindings.hasLoop m = false := by
    simpa [m] using ClosedValueBindings.hasLoop_false hclosedM
  have hresult :
      Metta.instantiate m (freshenRule counter convRuleLhs convRuleRhs).2 =
        convFreshReadoutAt counter sig rawLeft rawRight := by
    simp [convFreshReadoutAt, m, coreB, f]
  unfold queryOpItemsOfRule
  rcases hfresh : freshenRule counter convRuleLhs convRuleRhs with ⟨lhs', rhs'⟩
  have hmatch' : Metta.matchAtoms lhs' target = [renameBindings f coreB] := by
    simpa [hfresh] using hmatch
  have hresult' :
      Metta.instantiate m rhs' =
        convFreshReadoutAt counter sig rawLeft rawRight := by
    simpa [m, hfresh] using hresult
  change
    List.flatMap
        (fun mb =>
          List.filterMap
            (fun m' =>
              if Metta.Bindings.hasLoop m' = true then none
              else some (evalResult [] (Metta.instantiate m' rhs') m'))
            (Metta.Bindings.merge [] mb))
        (Metta.matchAtoms lhs' target) =
      [evalResult [] (convFreshReadoutAt counter sig rawLeft rawRight) m]
  rw [hmatch']
  simp only [List.flatMap_cons, List.flatMap_nil]
  rw [hmerge]
  simp [hloop, hresult']

private theorem queryOp_kernelDefControlEnv_conv_eq
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    let target := convQuery sig rawLeft rawRight
    let rootBnd :=
      (renameBindings (counterSuffix St.init.counter)
        (convRuleBindings sig rawLeft rawRight)).reverse
    queryOp kernelDefControlEnv St.init [] target [] =
      ([evalResult [] (convFreshReadoutAt St.init.counter sig rawLeft rawRight) rootBnd],
        { counter := St.init.counter + 1, world := St.init.world }) := by
  dsimp
  let target := convQuery sig rawLeft rawRight
  let rootBnd :=
    (renameBindings (counterSuffix St.init.counter)
      (convRuleBindings sig rawLeft rawRight)).reverse
  have hNotVarHead : isVariableHeaded target = false := by
    simp [target, convQuery, isVariableHeaded, mExpr, mSym]
  have hCand :
      kernelDefControlEnv.candidates target =
        [] ++ (convRuleLhs, convRuleRhs) :: [] := by
    have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
      simp [MinEnv.candidates, kernelDefControlEnv]
    rw [hcandidateEq]
    simp [MinEnv.candidates, kernelEnv, target, convQuery, sigAtom,
      convRuleLhs, convRuleRhs, mExpr, mSym, mVar, headKey,
      Metta.ruleIndex_getD, Metta.ofAtomsGT_varRules,
      kernelControlSignatureDecls, kernelControlRules, kernelNfDefBodyRootRules,
      kernelCoreRules, runtimeDecls, ruleIsBad, ruleNfVar, ruleNfSrt,
      ruleNfCon, ruleNfBad, ruleNfPi, ruleNfLam, ruleInferSrtType,
      ruleInferSrtKind, ruleInferBad, ruleConv, ruleNfDef,
      ruleDefBodyOfDDef, nfDefRuleLhs, nfDefRuleRhs,
      defBodyOfDDefRuleLhs, defBodyOfDDefRuleRhs, defBodyOfQueryAtom,
      ruleIfTrue, ruleIfFalse, ruleLet, ifTrueRulePair, ifFalseRulePair,
      letRulePair, mTypeDecl, mBool, extractRules]
  have hitems :
      queryOpItemsOfRule [] target [] St.init.counter (convRuleLhs, convRuleRhs) =
        [evalResult []
          (convFreshReadoutAt St.init.counter sig rawLeft rawRight) rootBnd] := by
    simpa [target, rootBnd] using
      queryOpItems_conv_eq St.init.counter sig rawLeft rawRight
  unfold queryOp
  rw [hNotVarHead]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [candidatesW_eq_candidates_of_no_selfExtra
    kernelDefControlEnv St.init.world target (by rfl)]
  rw [hCand]
  change
    (if (([] ++ queryOpItemsOfRule [] target [] St.init.counter
              (convRuleLhs, convRuleRhs)).isEmpty = true) then
        ([finItem [] notReducibleA []],
          ({ counter := St.init.counter + 1, world := St.init.world } : St))
      else
        ([] ++ queryOpItemsOfRule [] target [] St.init.counter
            (convRuleLhs, convRuleRhs),
          ({ counter := St.init.counter + 1, world := St.init.world } : St))) =
      ([evalResult [] (convFreshReadoutAt St.init.counter sig rawLeft rawRight) rootBnd],
        ({ counter := St.init.counter + 1, world := St.init.world } : St))
  rw [hitems]
  simp

theorem interpretFuel_kernelDefControlEnv_conv_root_eq
    (fuel : Nat) (sig : DIndGArtifactSig)
    (rawLeft rawRight : DIndGArtifactTerm) :
    let rootBnd :=
      (renameBindings (counterSuffix St.init.counter)
        (convRuleBindings sig rawLeft rawRight)).reverse
    interpretFuel kernelDefControlEnv (fuel + 1) St.init
        [evalItemNil (convQuery sig rawLeft rawRight)] [] =
      ([(convFreshReadoutAt St.init.counter sig rawLeft rawRight, rootBnd)],
        { counter := St.init.counter + 1, world := St.init.world }) := by
  dsimp
  let target := convQuery sig rawLeft rawRight
  let coreB := convRuleBindings sig rawLeft rawRight
  let f := counterSuffix St.init.counter
  let rootBnd : Metta.Bindings := (renameBindings f coreB).reverse
  let root := convFreshReadoutAt St.init.counter sig rawLeft rawRight
  let st' : St := { counter := St.init.counter + 1, world := St.init.world }
  have hstep :
      interpretStack1 kernelDefControlEnv fuel St.init (evalItemNil target) =
        ([evalResult [] root rootBnd], st') := by
    change interpretStack1 kernelDefControlEnv fuel St.init
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := [] } =
      ([evalResult [] root rootBnd], st')
    rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelDefControlEnv fuel St.init [] target [] "conv"
        [sigAtom sig, termAtom rawLeft, termAtom rawRight]]
    · simpa [target, convQuery, root, rootBnd, coreB, f, st', mExpr, mSym] using
        queryOp_kernelDefControlEnv_conv_eq sig rawLeft rawRight
    · simp [target, convQuery, mExpr, mSym, Metta.instantiate_nil]
    · exact callGrounded_conv_of_stdGroundings kernelDefControlEnv sig rawLeft rawRight (by rfl)
    · simp [isEmbeddedOp]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (termAtom_vars_nil rawRight)
      (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))
  have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
    ClosedValueBindings.rename hclosedB
  have hclosedRootBnd : ClosedValueBindings rootBnd := by
    simpa [rootBnd] using ClosedValueBindings.reverse hclosedRen
  have hrootStable : Metta.instantiate rootBnd root = root := by
    simpa [root, convFreshReadoutAt, rootBnd, coreB, f] using
      instantiate_closed_value_bindings_idempotent hclosedRootBnd
      (freshenRule St.init.counter convRuleLhs convRuleRhs).2
  have heval : evalResult [] root rootBnd = finItem [] root rootBnd := by
    have hnot : isFunctionResult root = false := by
      simpa [root, convFreshReadoutAt, rootBnd, coreB, f] using
        conv_freshened_rhs_notFunction sig rawLeft rawRight
    exact evalResult_nil_eq_finItem_of_not_function
      (a := root) (b := rootBnd) hnot
  have hfinal : isFinal (evalResult [] root rootBnd) = true := by
    simp [heval, finItem, isFinal]
  have hpair : finalPair (evalResult [] root rootBnd) = (root, rootBnd) := by
    rw [heval]
    change (Metta.instantiate rootBnd root, rootBnd) = (root, rootBnd)
    simp [hrootStable]
  rw [interpretFuel, hstep]
  simp [interpretFuel, hfinal, hpair, root, rootBnd, coreB, f, st']

