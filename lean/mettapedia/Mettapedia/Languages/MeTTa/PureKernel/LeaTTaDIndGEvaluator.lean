  have hRightTargetEq : rightTarget = target :=
    cicStage3_resolved_nf_decl_target_unique
      hRightResolved hRightTarget' hRightTarget
  subst leftTarget
  subst rightTarget
  exact convDecl_of_common_reduct hLeftRed hRightRed

