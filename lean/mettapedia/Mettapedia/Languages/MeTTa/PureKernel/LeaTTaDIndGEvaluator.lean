The helper rule `(infer-apply-args sig ctx T ArgsNil) = (nf sig T)` is the
smallest source-aligned infer-family rule that invokes recursive normalization.
This theorem ties its actual `mettaEval` root readout to the certified MOPS step
that exposes the `nf` query. -/
theorem infer_apply_args_nil_mettaEval_bridge_alpha_mops
    (sig : DIndGArtifactSig) (rawType : DIndGArtifactTerm) :
    ∃ rootOut rootCertified,
      rootOut ∈
          (mettaEval kernelInferApplyArgsNilEnv 1 St.init []
            (inferApplyArgsNilQuery sig rawType)).1.map (·.1) ∧
        Relation.ReflTransGen (Metta.MopsStep kernelInferApplyArgsNilRules)
          (inferApplyArgsNilQuery sig rawType) rootCertified ∧
        Metta.AlphaEq rootOut rootCertified := by
  rcases infer_apply_args_nil_evalAtomMin_bridge_alpha_mops sig rawType with
    ⟨hmem, hroot, halpha⟩
  have hclosedRuntime : ClosedValueBindings
      (renameBindings (counterSuffix St.init.counter)
        (inferApplyArgsNilRuleBindings sig rawType)).reverse :=
    ClosedValueBindings.reverse (ClosedValueBindings.rename
      (ClosedValueBindings.val (termAtom_vars_nil rawType)
        (ClosedValueBindings.val (by simp [ctxNilAtom, mSym, Metta.Atom.vars])
          (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))))
  have hrun :
      Metta.instantiate
          (renameBindings (counterSuffix St.init.counter)
            (inferApplyArgsNilRuleBindings sig rawType)).reverse
          (freshenRule St.init.counter inferApplyArgsNilRulePair.1
            inferApplyArgsNilRulePair.2).2 ∈
        (mettaEval kernelInferApplyArgsNilEnv 1 St.init []
          (inferApplyArgsNilQuery sig rawType)).1.map (·.1) := by
    exact infer_apply_args_nil_evalAtomMin_readout_mem_mettaEval
      (sig := sig) (rawType := rawType) hmem
      (by
        rw [freshenRule_eq_renBy]
        rw [hclosedRuntime.instantiate_eq_subst_apply]
        simp [inferApplyArgsNilRulePair, inferApplyArgsNilRuleBindings,
          St.init, renameBindings, counterSuffix, Metta.instantiate, Metta.bindingsToSubst,
          Metta.Subst.apply, Metta.Subst.lookup,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
          isEmbeddedOp, mExpr, mSym, mVar])
      (by
        rw [freshenRule_eq_renBy]
        rw [hclosedRuntime.instantiate_eq_subst_apply]
        simp [notReducibleA, inferApplyArgsNilRulePair, inferApplyArgsNilRuleBindings,
          St.init, renameBindings, counterSuffix, Metta.instantiate, Metta.bindingsToSubst,
          Metta.Subst.apply, Metta.Subst.lookup,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
          mExpr, mSym, mVar]
        rfl)
      (by
        rw [freshenRule_eq_renBy]
        rw [hclosedRuntime.instantiate_eq_subst_apply]
        simpa [inferApplyArgsNilRulePair, inferApplyArgsNilRuleBindings,
          inferApplyArgsNilQuery,
          St.init, renameBindings, counterSuffix, Metta.instantiate, Metta.bindingsToSubst,
          Metta.Subst.apply, Metta.Subst.lookup,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
          nfQuery, mExpr, mSym, mVar] using
          nfQuery_beq_inferApplyArgsNilQuery_false sig rawType)
      (by
        rw [freshenRule_eq_renBy]
        rw [hclosedRuntime.instantiate_eq_subst_apply]
        simp [inferApplyArgsNilRulePair, inferApplyArgsNilRuleBindings,
          St.init, renameBindings, counterSuffix, Metta.instantiate, Metta.bindingsToSubst,
          Metta.Subst.apply, Metta.Subst.lookup,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
          Metta.Atom.isError, mExpr, mSym, mVar])
  exact ⟨_, nfQuery sig rawType, hrun, hroot, halpha⟩

/-- Premise-free package for the smallest recursive infer-family helper.

The helper rule exposes an `nf` query, and the recursive normalization spine is
then supplied by the already-discharged closed/static `nf` bridge. This is the
D3 composition point: the runtime readout of the infer-family helper is tied to
LeaTTa's certified step relation, and the sub-`nf` work is not assumed as a
premise. -/
theorem infer_apply_args_nil_mettaEval_bridge_alpha_kernel_of_fragment
    {sig : DIndGArtifactSig} {rawType : DIndGArtifactTerm}
    (hfrag : NfEqFragmentTerm rawType) :
    ∃ out helperOut helperCertified nfRootOut nfCertified,
      helperOut ∈
          (mettaEval kernelInferApplyArgsNilEnv 1 St.init []
            (inferApplyArgsNilQuery sig rawType)).1.map (·.1) ∧
        Relation.ReflTransGen
          (Metta.KernelStep kernelInferApplyArgsNilRules stdGroundings)
          (inferApplyArgsNilQuery sig rawType) helperCertified ∧
        Metta.AlphaEq helperOut helperCertified ∧
        helperCertified = nfQuery sig rawType ∧
        nfRootOut ∈
          (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig rawType)).1.map (·.1) ∧
        Relation.ReflTransGen
          (Metta.KernelStep kernelCoreRules stdGroundings)
          (nfQuery sig rawType) nfCertified ∧
        Metta.AlphaEq nfRootOut nfCertified ∧
        Relation.ReflTransGen (ExprCtxKernelStep kernelCoreRules stdGroundings)
          nfCertified out := by
  rcases infer_apply_args_nil_evalAtomMin_bridge_alpha_mops sig rawType with
    ⟨hmem, hrootMops, hhelperAlpha⟩
  have hclosedRuntime : ClosedValueBindings
      (renameBindings (counterSuffix St.init.counter)
        (inferApplyArgsNilRuleBindings sig rawType)).reverse :=
    ClosedValueBindings.reverse (ClosedValueBindings.rename
      (ClosedValueBindings.val (termAtom_vars_nil rawType)
        (ClosedValueBindings.val (by simp [ctxNilAtom, mSym, Metta.Atom.vars])
          (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))))
  have hhelperRun :
      Metta.instantiate
          (renameBindings (counterSuffix St.init.counter)
            (inferApplyArgsNilRuleBindings sig rawType)).reverse
          (freshenRule St.init.counter inferApplyArgsNilRulePair.1
            inferApplyArgsNilRulePair.2).2 ∈
        (mettaEval kernelInferApplyArgsNilEnv 1 St.init []
          (inferApplyArgsNilQuery sig rawType)).1.map (·.1) := by
    exact infer_apply_args_nil_evalAtomMin_readout_mem_mettaEval
      (sig := sig) (rawType := rawType) hmem
      (by
        rw [freshenRule_eq_renBy]
        rw [hclosedRuntime.instantiate_eq_subst_apply]
        simp [inferApplyArgsNilRulePair, inferApplyArgsNilRuleBindings,
          St.init, renameBindings, counterSuffix, Metta.instantiate, Metta.bindingsToSubst,
          Metta.Subst.apply, Metta.Subst.lookup,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
          isEmbeddedOp, mExpr, mSym, mVar])
      (by
        rw [freshenRule_eq_renBy]
        rw [hclosedRuntime.instantiate_eq_subst_apply]
        simp [notReducibleA, inferApplyArgsNilRulePair, inferApplyArgsNilRuleBindings,
          St.init, renameBindings, counterSuffix, Metta.instantiate, Metta.bindingsToSubst,
          Metta.Subst.apply, Metta.Subst.lookup,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
          mExpr, mSym, mVar]
        rfl)
      (by
        rw [freshenRule_eq_renBy]
        rw [hclosedRuntime.instantiate_eq_subst_apply]
        simpa [inferApplyArgsNilRulePair, inferApplyArgsNilRuleBindings,
          inferApplyArgsNilQuery,
          St.init, renameBindings, counterSuffix, Metta.instantiate, Metta.bindingsToSubst,
          Metta.Subst.apply, Metta.Subst.lookup,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
          nfQuery, mExpr, mSym, mVar] using
          nfQuery_beq_inferApplyArgsNilQuery_false sig rawType)
      (by
        rw [freshenRule_eq_renBy]
        rw [hclosedRuntime.instantiate_eq_subst_apply]
        simp [inferApplyArgsNilRulePair, inferApplyArgsNilRuleBindings,
          St.init, renameBindings, counterSuffix, Metta.instantiate, Metta.bindingsToSubst,
          Metta.Subst.apply, Metta.Subst.lookup,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
          Metta.Atom.isError, mExpr, mSym, mVar])
  rcases nf_eq_fragment_mettaEval_root_bridge_alpha_kernel_of_fragment
      (sig := sig) hfrag with
    ⟨out, nfRootOut, nfCertified, hnfRun, hnfRoot, hnfAlpha, hnfCtx⟩
  let helperOut : Metta.Atom :=
    Metta.instantiate
      (renameBindings (counterSuffix St.init.counter)
        (inferApplyArgsNilRuleBindings sig rawType)).reverse
      (freshenRule St.init.counter inferApplyArgsNilRulePair.1
        inferApplyArgsNilRulePair.2).2
  refine ⟨out, helperOut, nfQuery sig rawType, nfRootOut, nfCertified, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact hhelperRun
  · exact
      (Metta.reflTransGen_kernelStep_iff_mops kernelInferApplyArgsNilRules stdGroundings
        (inferApplyArgsNilQuery sig rawType) (nfQuery sig rawType)).2 hrootMops
  · exact hhelperAlpha
  · rfl
  · exact hnfRun
  · exact hnfRoot
  · exact hnfAlpha
  · exact hnfCtx

private theorem mem_equalityRules_append_left
    {atoms extra : List Metta.Atom} {p : Metta.Atom × Metta.Atom}
    (h : p ∈ (Metta.Space.mk atoms).equalityRules) :
    p ∈ (Metta.Space.mk (atoms ++ extra)).equalityRules := by
  unfold Metta.Space.equalityRules at h ⊢
  rw [List.filterMap_append]
  exact List.mem_append_left _ h

private theorem mem_equalityReductions_append_left
    {atoms extra : List Metta.Atom} {a out : Metta.Atom}
    (h : out ∈ Metta.equalityReductions (Metta.Space.mk atoms) a) :
    out ∈ Metta.equalityReductions (Metta.Space.mk (atoms ++ extra)) a := by
  rw [Metta.mem_equalityReductions] at h ⊢
  rcases h with ⟨p, hp, b, hb, hout⟩
  exact ⟨p, mem_equalityRules_append_left (extra := extra) hp, b, hb, hout⟩

private theorem mopsStep_append_left
    {atoms extra : List Metta.Atom} {a out : Metta.Atom}
    (h : Metta.MopsStep atoms a out) :
    Metta.MopsStep (atoms ++ extra) a out := by
  rcases h with ⟨hhead, hred⟩
  exact ⟨hhead, mem_equalityReductions_append_left (extra := extra) hred⟩

private theorem mopsChain_append_left
    {atoms extra : List Metta.Atom} {a out : Metta.Atom}
    (h : Relation.ReflTransGen (Metta.MopsStep atoms) a out) :
    Relation.ReflTransGen (Metta.MopsStep (atoms ++ extra)) a out := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hstep ih =>
      exact Relation.ReflTransGen.tail ih
        (mopsStep_append_left (extra := extra) hstep)

private theorem kernelChain_append_left
    {atoms extra : List Metta.Atom} {gt : GroundingTable} {a out : Metta.Atom}
    (h : Relation.ReflTransGen (Metta.KernelStep atoms gt) a out) :
    Relation.ReflTransGen (Metta.KernelStep (atoms ++ extra) gt) a out := by
  exact
    (Metta.reflTransGen_kernelStep_iff_mops (atoms ++ extra) gt a out).2
      (mopsChain_append_left (extra := extra)
        ((Metta.reflTransGen_kernelStep_iff_mops atoms gt a out).1 h))

mutual

private theorem exprCtxMopsStep_append_left
    {atoms extra : List Metta.Atom} {a out : Metta.Atom}
    (h : ExprCtxMopsStep atoms a out) :
    ExprCtxMopsStep (atoms ++ extra) a out := by
  cases h with
  | root hroot =>
      exact ExprCtxMopsStep.root (mopsStep_append_left (extra := extra) hroot)
  | expr hlist =>
      exact ExprCtxMopsStep.expr (exprListCtxMopsStep_append_left hlist)

private theorem exprListCtxMopsStep_append_left
    {atoms extra : List Metta.Atom} {xs ys : List Metta.Atom}
    (h : ExprListCtxMopsStep atoms xs ys) :
    ExprListCtxMopsStep (atoms ++ extra) xs ys := by
  cases h with
  | head hhead =>
      exact ExprListCtxMopsStep.head (exprCtxMopsStep_append_left hhead)
  | tail htail =>
      exact ExprListCtxMopsStep.tail (exprListCtxMopsStep_append_left htail)

end

private theorem exprCtxKernelStep_append_left
    {atoms extra : List Metta.Atom} {gt : GroundingTable} {a out : Metta.Atom}
    (h : ExprCtxKernelStep atoms gt a out) :
    ExprCtxKernelStep (atoms ++ extra) gt a out := by
  exact exprCtxMopsStep_to_kernel
    (gt := gt)
    (exprCtxMopsStep_append_left (extra := extra)
      (exprCtxKernelStep_to_mops h))

private theorem exprCtxKernelChain_append_left
    {atoms extra : List Metta.Atom} {gt : GroundingTable} {a out : Metta.Atom}
    (h : Relation.ReflTransGen (ExprCtxKernelStep atoms gt) a out) :
    Relation.ReflTransGen (ExprCtxKernelStep (atoms ++ extra) gt) a out := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hstep ih =>
      exact Relation.ReflTransGen.tail ih
        (exprCtxKernelStep_append_left (extra := extra) hstep)

/-- Extracted equality rules commute with appending an atom list. -/
private theorem extractRules_append
    (atoms extra : List Metta.Atom) :
    extractRules (atoms ++ extra) = extractRules atoms ++ extractRules extra := by
  simp [extractRules, List.filterMap_append]

/-- Candidate preservation for a statically indexed query when appended rules
cannot fire for that query's head.

This is the first environment-monotonicity invariant needed by the SR return
path: helper slices may append rules, but if those rules have neither the
query's head key nor a headless LHS, they do not change the static candidate
list for that query. The runtime `World` is `St.init.world`, so dynamic
`selfExtra` rules are absent. -/
theorem candidatesW_append_nonfiring_for_head
    {atoms extra : List Metta.Atom} {gt : GroundingTable}
    {toEval : Metta.Atom} {k : String}
    (hhead : headKey toEval = some k)
    (hidx : (extractRules extra).filter (fun r => headKey r.1 == some k) = [])
    (hvar : (extractRules extra).filter (fun r => (headKey r.1).isNone) = []) :
    candidatesW (MinEnv.ofAtomsGT (atoms ++ extra) gt) St.init.world toEval =
      candidatesW (MinEnv.ofAtomsGT atoms gt) St.init.world toEval := by
  have hrules := extractRules_append atoms extra
  simp [candidatesW, MinEnv.candidates, hhead, St.init, World.empty,
    Metta.ruleIndex_getD, Metta.ofAtomsGT_varRules, hrules, List.filter_append,
    hidx, hvar]

/-- Executable query monotonicity for helper slices that cannot fire on the queried head.

This is the runtime-facing form of `candidatesW_append_nonfiring_for_head`: once the appended
rules are absent from both the static head index and the headless-variable-rule bucket for the
query, the actual `queryOp` readout is unchanged. -/
theorem queryOp_append_nonfiring_for_head
    {atoms extra : List Metta.Atom} {gt : GroundingTable}
    {toEval : Metta.Atom} {k : String} {prev : Stack} {b : Bindings}
    (hhead : headKey toEval = some k)
    (hidx : (extractRules extra).filter (fun r => headKey r.1 == some k) = [])
    (hvar : (extractRules extra).filter (fun r => (headKey r.1).isNone) = []) :
    queryOp (MinEnv.ofAtomsGT (atoms ++ extra) gt) St.init prev toEval b =
      queryOp (MinEnv.ofAtomsGT atoms gt) St.init prev toEval b := by
  exact queryOp_eq_of_candidatesW_eq
    (candidatesW_append_nonfiring_for_head
      (atoms := atoms) (extra := extra) (gt := gt) (toEval := toEval) (k := k)
      hhead hidx hvar)

/-- Generic candidate monotonicity for kernel helper slices.

Any helper extension of `kernelCoreRules` that contributes neither a rule for
the queried head nor a headless equality rule preserves the static candidate
set.  This is the PureKernel-facing consolidation point: helper-specific
facts should instantiate this theorem instead of redoing candidate bookkeeping.
-/
theorem kernelCoreRules_candidates_eq_core_of_append_nonfiring
    {extra : List Metta.Atom} {toEval : Metta.Atom} {k : String}
    (hhead : headKey toEval = some k)
    (hidx : (extractRules extra).filter (fun r => headKey r.1 == some k) = [])
    (hvar : (extractRules extra).filter (fun r => (headKey r.1).isNone) = []) :
    candidatesW (MinEnv.ofAtomsGT (kernelCoreRules ++ extra) stdGroundings)
        St.init.world toEval =
      candidatesW kernelCoreEnv St.init.world toEval := by
  exact candidatesW_append_nonfiring_for_head
    (atoms := kernelCoreRules) (extra := extra) (gt := stdGroundings)
    (toEval := toEval) (k := k) hhead hidx hvar

/-- Generic query-readout monotonicity for kernel helper slices.

This is the executable `queryOp` form of
`kernelCoreRules_candidates_eq_core_of_append_nonfiring`: once the helper slice
cannot be selected for the queried head, adding it to `kernelCoreRules` leaves
the actual equality-query readout unchanged. -/
theorem kernelCoreRules_queryOp_eq_core_of_append_nonfiring
    {extra : List Metta.Atom} {toEval : Metta.Atom} {k : String}
    (prev : Stack) (b : Bindings)
    (hhead : headKey toEval = some k)
    (hidx : (extractRules extra).filter (fun r => headKey r.1 == some k) = [])
    (hvar : (extractRules extra).filter (fun r => (headKey r.1).isNone) = []) :
    queryOp (MinEnv.ofAtomsGT (kernelCoreRules ++ extra) stdGroundings)
        St.init prev toEval b =
      queryOp kernelCoreEnv St.init prev toEval b := by
  exact queryOp_append_nonfiring_for_head
    (atoms := kernelCoreRules) (extra := extra) (gt := stdGroundings)
    (toEval := toEval) (k := k) (prev := prev) (b := b)
    hhead hidx hvar

/-- Generic `nf` candidate monotonicity for kernel helper slices.

This is the candidate-level form of the SR env-monotonicity invariant: a helper
