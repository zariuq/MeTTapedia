    simpa [hOuterScope] using heIncoming
  have hInnerProjection : restrictBnd [e] outerRetained = [] :=
    restrictBnd_singleton_fresh_of_closed outerRetained e
      hOuterRetainedClosed heOuterRetained
  have hAOuter : Metta.instantiate incoming a = a :=
    instantiate_eq_self_of_vars_nil incoming hClosed
  have hAInner : Metta.instantiate outerRetained a = a :=
