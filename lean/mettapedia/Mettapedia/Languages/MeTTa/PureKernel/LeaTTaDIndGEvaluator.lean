private theorem queryOpItems_kernelEnv_is_bad_eq
    (counter : Nat) (a : Metta.Atom)
    (_hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    queryOpItemsOfRule [] (mExpr "is-bad" [a]) [] counter isBadRulePair =
      [evalResult []
        (mExpr "unify"
          [a, mExpr "Bad" [mVar (counterSuffix counter "e")], mBool true, mBool false])
        ((renameBindings (counterSuffix counter)
          [Metta.BindingRel.val "x" a]).reverse)] := by
  have hfresh :
      freshenRule counter isBadRulePair.1 isBadRulePair.2 =
        ( mExpr "is-bad" [mVar (counterSuffix counter "x")]
        , mExpr "unify"
            [ mVar (counterSuffix counter "x")
            , mExpr "Bad" [mVar (counterSuffix counter "e")]
            , mBool true
            , mBool false ] ) := by
    rw [freshenRule_eq_renBy]
    simp [isBadRulePair, mExpr, mSym, mVar, mBool,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms
          (mExpr "is-bad" [mVar (counterSuffix counter "x")])
          (mExpr "is-bad" [a]) =
        [[Metta.BindingRel.val (counterSuffix counter "x") a]] := by
    simpa [hfresh] using fresh_is_bad_rule_match counter a hNonVar
  have hmerge :
      Metta.Bindings.merge [] [Metta.BindingRel.val (counterSuffix counter "x") a] =
        [[Metta.BindingRel.val (counterSuffix counter "x") a]] := by
    simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
      Metta.Bindings.lookupVal, Metta.Bindings.addValRaw, Metta.Bindings.removeVal]
  let x := counterSuffix counter "x"
  let e := counterSuffix counter "e"
  have hclosedB : ClosedValueBindings [Metta.BindingRel.val x a] := by
    exact ClosedValueBindings.val _hClosed ClosedValueBindings.nil
  have hloop : Metta.Bindings.hasLoop [Metta.BindingRel.val x a] = false := by
    simpa [x] using ClosedValueBindings.hasLoop_false hclosedB
  have hxe : x ≠ e := by
    intro h
    have hx : "x" = "e" := (counterSuffix_injective counter) h
    contradiction
  have hex : e ≠ x := by
    intro h
    exact hxe h.symm
  have hexx : (e == x) = false := by
    exact beq_eq_false_iff_ne.mpr hex
  have hinst :
      Metta.instantiate [Metta.BindingRel.val x a]
          (mExpr "unify" [mVar x, mExpr "Bad" [mVar e], mBool true, mBool false]) =
        mExpr "unify" [a, mExpr "Bad" [mVar e], mBool true, mBool false] := by
    simp [x, e, mExpr, mSym, mVar, mBool, Metta.instantiate, Metta.bindingsToSubst,
      Metta.Subst.apply, Metta.Subst.lookup, hexx]
  unfold queryOpItemsOfRule
  simp only [hfresh]
  rw [hmatch]
  simp [hmerge, hloop, hinst, x, e, renameBindings, evalResult]

