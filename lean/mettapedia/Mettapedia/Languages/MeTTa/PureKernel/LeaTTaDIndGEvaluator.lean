/-- Lift an actual root minimal-evaluator `nf` readout through the outer `mettaEval` loop.

This is intentionally a *root* theorem: because the kernel declares
`nf : Atom -> Atom -> Atom`, LeaTTa's `mettaEval` returns the Atom-valued root
readout inert instead of recursively evaluating the `nf` calls that may occur
inside a `Pi`/`Lam` readout. The recursive certified spine is therefore carried
separately by `nf_eq_fragment_evalAtomMin_root_bridge_alpha_mops`. -/
theorem nf_evalAtomMin_readout_mem_mettaEval
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {rootOut : Metta.Atom}
    (hmem : rootOut ∈ evalAtomMin kernelCoreEnv 1 (nfQuery sig raw))
    (hembed : isEmbeddedOp rootOut = false)
    (hnotNR : (rootOut == notReducibleA) = false)
    (hnotSelf : (rootOut == nfQuery sig raw) = false) :
    rootOut ∈
      (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig raw)).1.map (·.1) := by
  have hpair :
      ∃ rootBnd,
        (rootOut, rootBnd) ∈
          (interpretFuel kernelCoreEnv 1 St.init
            [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", nfQuery sig raw]) []
               bnd := [] }] []).1 := by
    unfold evalAtomMin interpretAtom at hmem
    rcases List.mem_map.mp hmem with ⟨p, hp, hpout⟩
    cases p with
    | mk out bnd =>
        cases hpout
        exact ⟨bnd, hp⟩
  rcases hpair with ⟨rootBnd, hrootBnd⟩
  unfold mettaEval
  rw [Metta.instantiate_nil]
  simp only [nfQuery, mExpr, mSym] at hrootBnd hnotSelf ⊢
  rw [show typeMismatch kernelCoreEnv St.init.world "nf" [sigAtom sig, termAtom raw] = none by
    exact kernelCoreEnv_nf_typeMismatch sig raw]
  simp [kernelCoreEnv_nf_argMask, Metta.instantiate_nil]
  cases hpairs : interpretFuel kernelCoreEnv 1 St.init
      [{ stack := atomToStack
          (Metta.Atom.expr [Metta.Atom.sym "eval",
            Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]]) []
         bnd := [] }] [] with
  | mk pairs st' =>
      have hrootPairs : (rootOut, rootBnd) ∈ pairs := by
        rw [hpairs] at hrootBnd
        simpa using hrootBnd
      have hkeep :
          (rootOut,
              restrictBnd ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelCoreEnv 0
                ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [] ) ([], st')).1 :=
        mettaEval_expr_root_keeps_of_returnsAtom_readout
          kernelCoreEnv 0 ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
          (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) []
          (rootOut, rootBnd) pairs st'
          hrootPairs (by simpa [nfQuery, mExpr, mSym] using kernelCoreEnv_nf_returnsAtom sig raw)
          hembed hnotNR hnotSelf
      have hnoerr :
          List.find?
              (fun ho : Metta.Atom × Metta.Atom => ho.1.isError && ho.1 != ho.2)
              [(sigAtom sig, sigAtom sig), (termAtom raw, termAtom raw)] = none := by
        simp [sigAtom_isError_false, termAtom_isError_false]
      rw [hnoerr]
      change ∃ x,
        (rootOut, x) ∈
        (pairs.foldl
          (mettaEvalExprRootFoldStep kernelCoreEnv 0
            ((sigAtom sig).vars ++ (termAtom raw).vars)
            (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [])
          ([], st')).1
      exact ⟨_, by simpa [List.flatMap] using hkeep⟩

section
set_option linter.unusedSimpArgs false

/-- Runtime-root package for the equality-rule-only recursive `nf` fragment.

The actual outer `mettaEval` readout is the root Atom-valued reduct.  Because the kernel declares
`nf : Atom -> Atom -> Atom`, LeaTTa returns that root Atom inert; the recursive `Pi`/`Lam` spine is
therefore carried by the certified contextual MOPS relation rather than by the outer evaluator loop.
This is the D2 bridge shape: the readout comes from the runtime, the certified root comes from
MOPS, and the two are tied by α-equivalence. -/
theorem nf_eq_fragment_mettaEval_root_bridge_alpha_mops
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : NfEqFragmentReadout sig raw out) :
    ∃ rootOut rootCertified,
      rootOut ∈ (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig raw)).1.map (·.1) ∧
        Relation.ReflTransGen (Metta.MopsStep kernelCoreRules)
          (nfQuery sig raw) rootCertified ∧
        Metta.AlphaEq rootOut rootCertified ∧
        Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules) rootCertified out := by
  cases h with
  | var k =>
      rcases nf_var_evalAtomMin_bridge_alpha_mops sig k with ⟨hmem, hroot, halpha⟩
      have hrun := nf_evalAtomMin_readout_mem_mettaEval hmem
        (by
          rw [freshenRule_eq_renBy]
          simp [nfVarRulePair, nfVarRuleBindings, St.init, renameBindings, counterSuffix,
            Metta.instantiate, Metta.bindingsToSubst, Metta.Subst.apply, Metta.Subst.lookup,
            Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy, isEmbeddedOp, mExpr,
            mSym, mVar])
        (by
          rw [freshenRule_eq_renBy]
          simp [notReducibleA, nfVarRulePair, nfVarRuleBindings, St.init, renameBindings,
            counterSuffix, Metta.instantiate, Metta.bindingsToSubst, Metta.Subst.apply,
