/-- The selected function-type witness shared by every three-argument core `infer` call. -/
def kernelCoreEnvInferSelected : SelectedFunctionType :=
  { functionType := mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]
    argumentTypes := [mSym "Atom", mSym "Atom", mSym "Atom"]
    returnType := mSym "Atom"
    typeBindings := [] }

theorem kernelCoreEnv_infer_selected
    (st : St) (a b c : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelCoreEnv st.world "infer"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]]) :
    selectFunctionType kernelCoreEnv st.world (.sym "infer") [a, b, c] =
      .selected kernelCoreEnvInferSelected := by
  have hCheck : typeCheckArgsOutcome kernelCoreEnv st.world
      [.sym "Atom", .sym "Atom", .sym "Atom"] 0 [] [a, b, c] = .success [] := by
    simpa [mSym] using typeCheckArgsOutcome_three_atoms kernelCoreEnv st.world a b c
  simpa [kernelCoreEnvInferSelected, mExpr, mSym] using
    (selectFunctionType_singleton_arrow_selected_of_outcome
      kernelCoreEnv st.world "infer" [a, b, c]
      [.sym "Atom", .sym "Atom", .sym "Atom"] (.sym "Atom") []
      hPinned (by simp) hCheck)

/-- Exact repaired-runtime policy for a core `infer` call. -/
def kernelCoreEnv_infer_exactPolicy
    (st : St) (a b c : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelCoreEnv st.world "infer"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]]) :
    ApplicationPolicyProjection kernelCoreEnv st.world "infer" [a, b, c]
      [false, false, false] true := by
  have hSelected := kernelCoreEnv_infer_selected st a b c hPinned
  have hMask : argMask kernelCoreEnvInferSelected 3 = [false, false, false] := by
    simp only [kernelCoreEnvInferSelected, argMask, Metta.instantiate_nil, mSym]
    decide
  have hReturns : returnsAtom kernelCoreEnvInferSelected = true := by
    simp only [kernelCoreEnvInferSelected, returnsAtom, Metta.instantiate_nil, mSym]
    decide
  have hPolicy := ApplicationPolicyProjection.selected kernelCoreEnvInferSelected hSelected
  simpa [hMask, hReturns] using hPolicy

def kernelCoreEnv_infer_recursionNeutralPolicy
    (st : St) (a b c : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelCoreEnv st.world "infer"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]]) :
    RecursionNeutralApplicationPolicy kernelCoreEnv st.world "infer" [a, b, c]
      [false, false, false] true := by
  apply (kernelCoreEnv_infer_exactPolicy st a b c hPinned).withRecursionNeutralOfAllArgumentsQuoted
  · apply ExactApplicationPolicy.applicationPlanCorresponds_atom_args_symbolic_return
    simpa [OperatorTypesPinned, mExpr, mSym] using hPinned
  · rfl
  · left
    rfl

theorem KernelCoreEnvTypeWorld.infer
    {world : World} (h : KernelCoreEnvTypeWorld world) :
    OperatorTypesPinned kernelCoreEnv world "infer"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]] := by
  have hp := h "infer" (by simp [kernelCoreEnvOperatorInventory])
  simpa [OperatorTypesPinned, kernelCoreEnv_infer_types] using hp

theorem kernelCoreEnv_infer_typeMismatch_any (a b c : Metta.Atom) :
    typeMismatch kernelCoreEnv St.init.world "infer" [a, b, c] = none := by
  unfold typeMismatch
  rw [kernelCoreEnv_infer_selected St.init a b c kernelCoreEnvTypeWorld_init.infer]

/-- The concrete SRT query passes LeaTTa's runtime argument type check. -/
theorem kernelCoreEnv_infer_typeMismatch :
    typeMismatch kernelCoreEnv St.init.world "infer"
      [sigAtom cicStage3RawArtifactSig, ctxNilAtom, termAtom (.srt .type)] = none := by
