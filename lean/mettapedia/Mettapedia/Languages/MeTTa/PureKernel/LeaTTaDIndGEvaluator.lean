          env fuel qvars (Metta.Atom.expr [Metta.Atom.sym op, pattern, atom', template]) [] false
          P (root, rootBnd) pairs stRoot final
          hRootPairs hRootNotNotReducible hRootNotSelf rfl hRootState
          (by
            intro acc p hP
            simpa [qvars] using hrecState acc p hP)
          (by
            intro st0 hP
            simpa [qvars] using hFinal st0 hP)
      unfold mettaEvalExprPartFoldStep
      rw [hNoErr]
      simp only [List.nil_append]
      rw [hpairsExact]
      simpa [qvars] using hfold

theorem mettaEval_kernelDefControlEnv_if_declName_eq_self_then_member
    (fuel : Nat) {st : St}
    (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName)
    (thenA elseA final : Metta.Atom)
    (hWorld : st.world = St.init.world)
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hThenNotFunction : ∀ tail,
      thenA ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail))
    (hThenNotEmpty : (thenA != emptyA) = true)
    (hNoErr :
      (([mBool true, thenA, elseA].zip
          [mExpr "==" [declNameAtom name, declNameAtom name], thenA, elseA]).find?
        (fun ho : Metta.Atom × Metta.Atom => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hRootNotNotReducible : (thenA == notReducibleA) = false)
    (hRootNotSelf :
      (thenA == mExpr "if" [mBool true, thenA, elseA]) = false)
    (hFinal : ∀ st0,
      (final, []) ∈
        (mettaEval kernelDefControlEnv (fuel + 2) st0 [] thenA).1)
    (hFinalNotError : final.isError = false) :
    (final, []) ∈
      (mettaEval kernelDefControlEnv (fuel + 3) st []
        (mExpr "if"
          [mExpr "==" [declNameAtom name, declNameAtom name], thenA, elseA])).1 := by
  let cond := mExpr "==" [declNameAtom name, declNameAtom name]
  have hCond :
      mettaEval kernelDefControlEnv (fuel + 2) st [] cond =
        ([(mBool true, [])], st) := by
    simpa [cond] using
      mettaEval_kernelDefControlEnv_declName_eq_self_true_eq fuel st name hWorld
  have hTypes : KernelDefControlEnvTypeWorld st.world := by
    simpa [hWorld] using kernelDefControlEnvTypeWorld_init
  have hCondExpected :
      mettaEvalExpected kernelDefControlEnv (fuel + 2) st [] cond
          (mSym "Bool") =
        ([(mBool true, [])], st) := by
    simpa [cond] using
      mettaEvalExpected_kernelDefControlEnv_eq_of_bool_eval
        (fuel + 2) st st (declNameAtom name) (declNameAtom name) true hTypes hCond
