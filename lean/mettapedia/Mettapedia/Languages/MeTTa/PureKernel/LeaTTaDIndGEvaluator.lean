      (mExpr "if" [mBool false, mBool false, else₁]) = false
    simp [else₁, cond₂, eqA, mExpr, mSym, mBool,
      Metta.Atom.beq, Metta.Atom.beqList]
  rcases
      mettaEval_if_is_bad_false_pair_mem_implies_else_pair_from_closed_keyed
        (fuel := fuel + 1) (st := st) (incoming := ambient)
        (binder := binder) (a := nx) (elseA := else₁)
        (final := mBool true) (outBnd := outBnd)
        hWorld hAmbientClosed hAmbientKeys hFreshET
        hNxVars hNxNoErr hNxNotVar hNxNotBad hElse₁Closed hElse₁NoErr
        (by simp [else₁]) hElse₁NonVar hElse₁NotFunction hElse₁NotNR
        hElse₁NotSelf
        (by simpa [else₁, cond₂, eqA, convReadoutAfterNxNy,
          Nat.add_assoc, mExpr, mSym] using hmem) with
    ⟨midIncoming, midBnd, hMidClosed, hMidKeys, hMid⟩
  have hWorldRoot₁ : stRoot₁.world = St.init.world := by
    simpa [stRoot₁] using hWorld
  have hFreshInner :
      ∀ {v : String}, v = "e" ∨ v = "t" →
        counterSuffix (stRoot₁.counter + 2) v ≠ binder := by
    intro v hv
    simpa [stRoot₁, Nat.add_assoc] using hFreshETInner (v := v) hv
  have hEqClosed : eqA.vars = [] := by
    simp [eqA, hNxVars, hNyVars, mExpr, mSym, Metta.Atom.vars]
  have hEqNoErr : eqA.isError = false := by
    simp [eqA, mExpr, mSym, Metta.Atom.isError]
  have hEqNonVar : ∀ w, eqA ≠ Metta.Atom.var w := by
    intro w
    simp [eqA, mExpr, mSym]
  have hEqNotFunction : isFunctionResult eqA = false := by
    simp [eqA, isFunctionResult, mExpr, mSym]
  have hEqNotNR : (eqA == notReducibleA) = false := by
    change Metta.Atom.beq eqA notReducibleA = false
    simp [eqA, notReducibleA, mExpr, mSym, Metta.Atom.beq]
  have hEqNotSelf :
      (eqA == mExpr "if" [mBool false, mBool false, eqA]) = false := by
    change Metta.Atom.beq eqA
      (mExpr "if" [mBool false, mBool false, eqA]) = false
    simp [eqA, mExpr, mSym, mBool, Metta.Atom.beq,
      Metta.Atom.beqList]
  rcases
      mettaEval_if_is_bad_false_pair_mem_implies_else_pair_from_closed_keyed
        (fuel := fuel) (st := stRoot₁) (incoming := midIncoming)
        (binder := binder) (a := ny) (elseA := eqA)
        (final := mBool true) (outBnd := midBnd)
        hWorldRoot₁ hMidClosed hMidKeys hFreshInner
        hNyVars hNyNoErr hNyNotVar hNyNotBad hEqClosed hEqNoErr
        (by simp [eqA]) hEqNonVar hEqNotFunction hEqNotNR hEqNotSelf
        (by simpa [else₁, cond₂, eqA, Nat.add_assoc, mExpr, mSym] using hMid) with
    ⟨eqIncoming, finalBnd, hEqIncomingClosed, _hEqIncomingKeys, hEqMem⟩
  exact ⟨eqIncoming, finalBnd, hEqIncomingClosed, by
    simpa [stRoot₁, stRoot₂, Nat.add_assoc] using hEqMem⟩

theorem mettaEval_kernelDefControlEnv_conv_tail_true_canonical_beq_true_keyed_ambient
    (fuel : Nat) {rawLeft rawRight : DIndGArtifactTerm}
    {left right : PureTm 0}
    {nx ny : Metta.Atom} {tailStBefore : St}
    {tailValueEnv : Metta.Bindings}
    (hFuel : 4 ≤ fuel)
    (hWorldTailBefore : tailStBefore.world = St.init.world)
    (hLeft :
      DIndGArtifactTermTranslates
        cicStage3RawArtifactSigWithPropToType0Witness.nameTranslates 0
        rawLeft left)
    (hRight :
      DIndGArtifactTermTranslates
        cicStage3RawArtifactSigWithPropToType0Witness.nameTranslates 0
        rawRight right)
    (hLeftCanon : CicStage3CanonicalNfRuntimeReadout rawLeft nx)
    (hRightCanon : CicStage3CanonicalNfRuntimeReadout rawRight ny)
    (hTailValue :
