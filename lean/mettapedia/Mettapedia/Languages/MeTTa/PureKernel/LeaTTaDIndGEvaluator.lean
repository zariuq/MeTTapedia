/-- The full App helper slice preserves executable `nf` queries. -/
theorem kernelAppRules_nf_queryOp_eq_core
    (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm)
    (prev : Stack) (b : Bindings) :
    queryOp (MinEnv.ofAtomsGT kernelAppRules stdGroundings)
        St.init prev (nfQuery sig raw) b =
      queryOp kernelCoreEnv St.init prev (nfQuery sig raw) b := by
  exact queryOp_eq_of_candidatesW_eq
    (kernelAppRules_nf_candidates_eq_core sig raw)

/-- If an environment has the standard grounding table and the same `nf` equality-query readout as
`kernelCoreEnv`, then its top-level `evalOp` readout for the same `nf` query is also the same.

This lifts environment monotonicity from the equality-rule query layer to the immediate evaluator
dispatch boundary without unfolding the fuel scheduler. -/
theorem evalOp_nf_eq_core_of_queryOp_eq
    {env : MinEnv} (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm)
    (prev : Stack)
    (hgt : env.gt = stdGroundings)
    (hquery : queryOp env St.init prev (nfQuery sig raw) [] =
      queryOp kernelCoreEnv St.init prev (nfQuery sig raw) []) :
    evalOp env St.init prev (nfQuery sig raw) [] =
      evalOp kernelCoreEnv St.init prev (nfQuery sig raw) [] := by
  have hinst : Metta.instantiate [] (nfQuery sig raw) =
      Metta.Atom.expr (Metta.Atom.sym "nf" :: [sigAtom sig, termAtom raw]) := by
    simpa [nfQuery, mExpr, mSym] using (Metta.instantiate_nil (nfQuery sig raw))
  have hcall : callGrounded env.gt "nf"
        ([sigAtom sig, termAtom raw].map
          (fun a => resolveStates St.init.world (subTokens St.init.world a))) =
      ReduceResult.noReduce := by
    rw [hgt]
    simpa [kernelCoreEnv, MinEnv.ofAtomsGT] using kernelCoreEnv_callGrounded_nf sig raw
  have hembed :
      isEmbeddedOp (Metta.Atom.expr
        (Metta.Atom.sym "nf" :: [sigAtom sig, termAtom raw])) = false := by
    rfl
  have hleft := evalOp_queryOp_of_instantiated_noReduce
      (env := env) (st := St.init) (prev := prev)
      (x := nfQuery sig raw) (b := [])
      (op := "nf") (args := [sigAtom sig, termAtom raw]) hinst hcall hembed
  have hright := evalOp_queryOp_of_instantiated_noReduce
      (env := kernelCoreEnv) (st := St.init) (prev := prev)
      (x := nfQuery sig raw) (b := [])
      (op := "nf") (args := [sigAtom sig, termAtom raw]) hinst
      (kernelCoreEnv_callGrounded_nf sig raw) hembed
  rw [hleft, hright]
  exact hquery

/-- Generic `nf` query monotonicity for kernel helper slices.

Any rule extension of `kernelCoreRules` that contributes neither an `nf`-headed
rule nor a headless equality rule leaves the executable `nf` query unchanged.
This is the consolidation point for helper environments: prove the two
non-firing side conditions for the helper list, then transport through this
theorem instead of creating a new bespoke environment bridge. -/
theorem kernelCoreRules_nf_queryOp_eq_core_of_append_nonfiring
    {extra : List Metta.Atom} (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm)
    (prev : Stack) (b : Bindings)
    (hidx : (extractRules extra).filter (fun r => headKey r.1 == some "nf") = [])
    (hvar : (extractRules extra).filter (fun r => (headKey r.1).isNone) = []) :
    queryOp (MinEnv.ofAtomsGT (kernelCoreRules ++ extra) stdGroundings)
        St.init prev (nfQuery sig raw) b =
      queryOp kernelCoreEnv St.init prev (nfQuery sig raw) b := by
  exact kernelCoreRules_queryOp_eq_core_of_append_nonfiring
    (extra := extra) (toEval := nfQuery sig raw) (k := "nf") prev b
    (by cases raw <;> simp [nfQuery, termAtom, mExpr, mSym, headKey])
    hidx hvar

/-- Generic immediate-evaluator monotonicity for kernel helper slices.

After grounded dispatch falls through on both environments, a helper extension
that cannot fire on the instantiated head leaves the immediate `evalOp` readout
unchanged.  Head-specific lemmas such as the `nf` transport below are just
instances of this theorem. -/
theorem kernelCoreRules_evalOp_eq_core_of_append_nonfiring
    {extra : List Metta.Atom} {x : Metta.Atom} {k : String}
    {prev : Stack} {b : Bindings} {op : String} {args : List Metta.Atom}
    (hhead : headKey (Metta.Atom.expr (Metta.Atom.sym op :: args)) = some k)
    (hidx : (extractRules extra).filter (fun r => headKey r.1 == some k) = [])
    (hvar : (extractRules extra).filter (fun r => (headKey r.1).isNone) = [])
    (hinst : instantiate b x = Metta.Atom.expr (Metta.Atom.sym op :: args))
    (hcallExt : callGrounded
        (MinEnv.ofAtomsGT (kernelCoreRules ++ extra) stdGroundings).gt op
        (args.map (fun a => resolveStates St.init.world (subTokens St.init.world a))) =
      ReduceResult.noReduce)
    (hcallCore : callGrounded kernelCoreEnv.gt op
        (args.map (fun a => resolveStates St.init.world (subTokens St.init.world a))) =
      ReduceResult.noReduce)
    (hembed : isEmbeddedOp (Metta.Atom.expr (Metta.Atom.sym op :: args)) = false) :
    evalOp (MinEnv.ofAtomsGT (kernelCoreRules ++ extra) stdGroundings)
        St.init prev x b =
      evalOp kernelCoreEnv St.init prev x b := by
  exact evalOp_append_nonfiring_for_head
    (atoms := kernelCoreRules) (extra := extra) (gt := stdGroundings)
    (x := x) (k := k) (prev := prev) (b := b) (op := op) (args := args)
    hhead hidx hvar hinst hcallExt hcallCore hembed

/-- Immediate evaluator form of `kernelCoreRules_nf_queryOp_eq_core_of_append_nonfiring`.

This banks the environment-monotonicity invariant needed by SR helper rules at
the actual `evalOp` boundary, while keeping the proof parametric in the helper
rule list. -/
theorem kernelCoreRules_nf_evalOp_eq_core_of_append_nonfiring
    {extra : List Metta.Atom} (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm)
    (prev : Stack)
    (hidx : (extractRules extra).filter (fun r => headKey r.1 == some "nf") = [])
    (hvar : (extractRules extra).filter (fun r => (headKey r.1).isNone) = []) :
    evalOp (MinEnv.ofAtomsGT (kernelCoreRules ++ extra) stdGroundings)
        St.init prev (nfQuery sig raw) [] =
      evalOp kernelCoreEnv St.init prev (nfQuery sig raw) [] := by
  exact kernelCoreRules_evalOp_eq_core_of_append_nonfiring
    (extra := extra) (x := nfQuery sig raw) (k := "nf") (prev := prev) (b := [])
    (op := "nf") (args := [sigAtom sig, termAtom raw])
    (by cases raw <;> simp [headKey])
    hidx hvar
    (by simpa [nfQuery, mExpr, mSym] using (Metta.instantiate_nil (nfQuery sig raw)))
    (callGrounded_nf_of_stdGroundings
      (MinEnv.ofAtomsGT (kernelCoreRules ++ extra) stdGroundings) sig raw (by rfl))
    (kernelCoreEnv_callGrounded_nf sig raw)
    (by rfl)

