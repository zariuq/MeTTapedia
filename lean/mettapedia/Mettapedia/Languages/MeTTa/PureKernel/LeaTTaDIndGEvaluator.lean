          [Metta.Atom.sym "nf", sigAtom leattaDefControlNonWitnessSig,
           termAtom leattaDefControlNonWitnessBody])
        (Metta.Atom.expr
          [Metta.Atom.sym "if", Metta.Atom.gnd (Metta.Ground.bool false),
           Metta.Atom.expr [Metta.Atom.sym "Bad", Metta.Atom.sym "unknown-definition"],
           Metta.Atom.expr
