/-- Relation-level recursive soundness for the equality-rule-only `nf` fragment.

This is the D2 induction spine: the first step is supplied by the discharged
LeaTTa bridge (or the leaf MOPS rule), and recursive subcalls are composed by
contextual closure under `Pi`/`Lam`. -/
theorem nf_eq_fragment_reaches_mops_context
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : NfEqFragmentReadout sig raw out) :
    Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules)
      (nfQuery sig raw) out := by
  induction h with
  | var k =>
      exact mopsChain_to_exprCtxMopsChain
        (Relation.ReflTransGen.single (nf_var_mops_step sig k))
  | srt sort =>
      exact mopsChain_to_exprCtxMopsChain
        (Relation.ReflTransGen.single (nf_srt_mops_step sig sort))
  | con name =>
      exact mopsChain_to_exprCtxMopsChain
        (Relation.ReflTransGen.single (nf_con_mops_step sig name))
  | bad reason =>
      exact mopsChain_to_exprCtxMopsChain
        (Relation.ReflTransGen.single (nf_bad_mops_step sig reason))
  | pi hDomain hBody ihDomain ihBody =>
      rename_i rawDomain rawBody domainOut bodyOut
      rcases nf_pi_evalAtomMin_bridge_alpha_mops sig rawDomain rawBody with ⟨_, hroot, _⟩
      have hrootCtx :
          Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules)
            (nfQuery sig (.pi rawDomain rawBody)) (nfPiReadout sig rawDomain rawBody) :=
        mopsChain_to_exprCtxMopsChain hroot
      have hDomainCtx :
          Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules)
            (nfPiReadout sig rawDomain rawBody)
            (mExpr "Pi" [domainOut, nfQuery sig rawBody]) := by
        simpa [nfPiReadout, nfQuery, mExpr, mSym] using
          exprCtxMopsChain_at (rules := kernelCoreRules)
            [mSym "Pi"] [nfQuery sig rawBody] ihDomain
      have hBodyCtx :
          Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules)
            (mExpr "Pi" [domainOut, nfQuery sig rawBody])
            (mExpr "Pi" [domainOut, bodyOut]) := by
        simpa [nfQuery, mExpr, mSym] using
          exprCtxMopsChain_at (rules := kernelCoreRules)
            [mSym "Pi", domainOut] ([] : List Metta.Atom) ihBody
      exact hrootCtx.trans (hDomainCtx.trans hBodyCtx)
  | lam hDomain hBody ihDomain ihBody =>
      rename_i rawDomain rawBody domainOut bodyOut
      rcases nf_lam_evalAtomMin_bridge_alpha_mops sig rawDomain rawBody with ⟨_, hroot, _⟩
      have hrootCtx :
          Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules)
            (nfQuery sig (.lam rawDomain rawBody)) (nfLamReadout sig rawDomain rawBody) :=
