private theorem legacyFresheningCompatible_of_closed_keyed_ambient
    (target : Metta.Atom) (ambient : Metta.Bindings) (binder : String)
    (counter : Nat) (lhs rhs : Metta.Atom)
    (hTargetClosed : target.vars = [])
    (hAmbientClosed : ClosedValueBindings ambient)
    (hAmbientKeys :
      ∀ x, x ∈ bindingValueKeys ambient → x = binder)
    (hRuleVars :
      ∀ x,
        x ∈ (freshenRule counter lhs rhs).1.vars ++
            (freshenRule counter lhs rhs).2.vars →
          x = counterSuffix counter "e" ∨
            x = counterSuffix counter "t")
    (hFreshET :
      ∀ {v : String}, v = "e" ∨ v = "t" →
        counterSuffix counter v ≠ binder) :
    LegacyFresheningCompatible [] target ambient counter lhs rhs := by
  apply legacyFresheningCompatible_of_no_collision
  rintro ⟨x, hxRule, hxAvoid⟩
  have hxAmbient : x ∈ Metta.Bindings.vars ambient := by
    simpa [Metta.Minimal.queryOpAvoid, Metta.Minimal.liveStackVars,
      hTargetClosed] using hxAvoid
  have hxBinder : x = binder :=
    hAmbientKeys x (hAmbientClosed.key_mem_of_vars_mem hxAmbient)
  rcases hRuleVars x hxRule with hx | hx
  · rw [hx] at hxBinder
    exact hFreshET (Or.inl rfl) hxBinder
  · rw [hx] at hxBinder
    exact hFreshET (Or.inr rfl) hxBinder

