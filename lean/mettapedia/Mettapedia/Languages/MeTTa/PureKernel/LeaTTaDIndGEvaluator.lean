    simpa [root, rootBnd, stAtom, stRoot, Nat.add_assoc] using
      interpretFuel_kernelDefControlEnv_let_root_eq
        (fuel := fuelBase + 1) (st := stAtom)
        binder bodyAtom template hStaticAtom hBodyNonVar
