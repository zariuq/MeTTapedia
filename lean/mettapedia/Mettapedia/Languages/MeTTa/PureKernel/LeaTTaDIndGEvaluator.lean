  have hTypes : KernelDefControlEnvTypeWorld st.world :=
    kernelDefControlEnvTypeWorld_of_world_eq_init hWorld
  let bodyAtom :=
    defBodyOfQueryAtom
      (sigAtom cicStage3RawArtifactSig)
