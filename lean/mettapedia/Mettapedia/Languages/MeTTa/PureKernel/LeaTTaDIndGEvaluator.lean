      (termAtom_vars_absent rawFn) (termAtom_vars_absent rawArg)
      (sigAtom_not_var sig) (by intro w; simp [ctxNilAtom, mSym])
      (termAtom_not_var rawFn) (termAtom_not_var rawArg)
