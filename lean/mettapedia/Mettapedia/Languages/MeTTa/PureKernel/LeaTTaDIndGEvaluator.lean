      · rcases hDomainResolved with ⟨domainNf, hDomainOut, hDomainRun⟩
        rcases ihBody with hBodyResolved | hBodyFrontier
        · rcases hBodyResolved with ⟨bodyNf, hBodyOut, hBodyRun⟩
