    kernelDefControlEnv 0 st "Var" [mNat k] [true] false
    (kernelDefControlEnv_Var_recursionNeutralPolicy st k hTypes.var)
    (by simp [Metta.Atom.isError])] at hOut
  simp [evaluateSelectedApplication, termAtom, mExpr, mSym, mNat, mettaEval,
    Metta.instantiate_nil, hGuard] at hOut
  split at hOut
  case h_1 x error snd heq =>
    have hData :
        ((Metta.Atom.expr [Metta.Atom.sym "Error",
              Metta.Atom.gnd (Ground.int (Int.ofNat k)),
              Metta.Atom.sym "StackOverflow"]).isError = true ∧
            (Metta.Atom.expr [Metta.Atom.sym "Error",
                Metta.Atom.gnd (Ground.int (Int.ofNat k)),
                Metta.Atom.sym "StackOverflow"] !=
              Metta.Atom.gnd (Ground.int (Int.ofNat k))) = true) ∧
          Metta.Atom.expr [Metta.Atom.sym "Error",
              Metta.Atom.gnd (Ground.int (Int.ofNat k)),
              Metta.Atom.sym "StackOverflow"] = error ∧
            Metta.Atom.gnd (Ground.int (Int.ofNat k)) = snd := by
      simpa using heq
    have herror :
        Metta.Atom.expr [Metta.Atom.sym "Error",
            Metta.Atom.gnd (Ground.int (Int.ofNat k)),
            Metta.Atom.sym "StackOverflow"] = error :=
      hData.2.1
    have hOutRaw := mem_of_mem_prioritizeSemanticResults hOut
    simp only [List.mem_singleton] at hOutRaw
    have hout : out = error := congrArg Prod.fst hOutRaw
    rw [hout, ← herror]
    rfl
  case h_2 x heq =>
    exfalso
    change
      (if
          (Metta.Atom.expr [Metta.Atom.sym "Error",
              Metta.Atom.gnd (Ground.int (Int.ofNat k)),
              Metta.Atom.sym "StackOverflow"]).isError = true ∧
            (Metta.Atom.expr [Metta.Atom.sym "Error",
                Metta.Atom.gnd (Ground.int (Int.ofNat k)),
                Metta.Atom.sym "StackOverflow"] !=
              Metta.Atom.gnd (Ground.int (Int.ofNat k))) = true then
        some
          (Metta.Atom.expr [Metta.Atom.sym "Error",
              Metta.Atom.gnd (Ground.int (Int.ofNat k)),
              Metta.Atom.sym "StackOverflow"],
            Metta.Atom.gnd (Ground.int (Int.ofNat k)))
        else none) = none at heq
    have hGuard' :
        (Metta.Atom.expr [Metta.Atom.sym "Error",
            Metta.Atom.gnd (Ground.int (Int.ofNat k)),
            Metta.Atom.sym "StackOverflow"]).isError = true ∧
          (Metta.Atom.expr [Metta.Atom.sym "Error",
              Metta.Atom.gnd (Ground.int (Int.ofNat k)),
              Metta.Atom.sym "StackOverflow"] !=
            Metta.Atom.gnd (Ground.int (Int.ofNat k))) = true := by
      constructor <;> rfl
    rw [if_pos hGuard'] at heq
    cases heq

