      (Metta.instantiate m (freshenRule (st.counter + 1) lhs rhs).2 !=
        emptyA) = true := by
    rw [hresult]
    simpa using termAtom_ne_empty (.srt sort)
  have hnotFunction :
      isFunctionResult
        (Metta.instantiate m (freshenRule (st.counter + 1) lhs rhs).2) = false := by
    rw [hresult]
