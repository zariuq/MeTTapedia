    (hR : NfEqFragmentTermNameFree rawR)
    (hEq :
      callGrounded stdGroundings "==" [nfRootReadoutNameFree sig rawL, nfRootReadoutNameFree sig rawR] =
        ReduceResult.ok [mBool true]) :
