private theorem interpretFuel_kernelDefControlEnv_if_false_bool_root_eq_with_keyed_ambient
    {fuel : Nat} {st : St}
    (binder : String) (elseA : Metta.Atom) (ambient : Metta.Bindings)
    (hStatic : st.world.selfExtra = [])
    (hElseClosed : elseA.vars = [])
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hElseNotFunction : isFunctionResult elseA = false)
    (hAmbientClosed : ClosedValueBindings ambient)
    (hAmbientKeys :
      ∀ x, x ∈ bindingValueKeys ambient → x = binder)
    (hFreshET :
      ∀ {v : String}, v = "e" ∨ v = "t" →
        counterSuffix (st.counter + 1) v ≠ binder) :
    let thenA := mBool false
    let target := mExpr "if" [mBool false, thenA, elseA]
    let rootItem : Item :=
      { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", target]) [],
        bnd := ambient }
    let rootBnd : Metta.Bindings :=
      (renameBindings (counterSuffix (st.counter + 1))
        [Metta.BindingRel.val "e" elseA,
         Metta.BindingRel.val "t" thenA]).reverse ++ ambient
    interpretFuel kernelDefControlEnv (fuel + 1) st [rootItem] [] =
      ([(elseA, rootBnd)], { counter := st.counter + 2, world := st.world }) := by
  dsimp
  let thenA := mBool false
  let target := mExpr "if" [mBool false, thenA, elseA]
  let coreB : Metta.Bindings :=
    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix (st.counter + 1)
  let m : Metta.Bindings := (renameBindings f coreB).reverse ++ ambient
  let rootItem : Item :=
    { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", target]) [],
      bnd := ambient }
  let st' : St := { counter := st.counter + 2, world := st.world }
  have hclosedTarget : target.vars = [] := by
    simp [target, thenA, hElseClosed, mExpr, mSym, mBool, Metta.Atom.vars]
  have hThenClosed : thenA.vars = [] := by
    simp [thenA, mBool, Metta.Atom.vars]
  have hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w := by
    intro w
    simp [thenA, mBool]
  have hinst :
      Metta.instantiate ambient target =
        Metta.Atom.expr (Metta.Atom.sym "if" :: [mBool false, thenA, elseA]) := by
    have htarget := instantiate_eq_self_of_vars_nil ambient hclosedTarget
    simpa [target, mExpr, mSym] using htarget
  have hquery :
      queryOp kernelDefControlEnv st [] target ambient =
        ([evalResult [] elseA m], st') := by
    have hNotVarHead : isVariableHeaded target = false := by
      simp [target, isVariableHeaded, mExpr, mSym]
    have hCand : kernelDefControlEnv.candidates target = [ifTrueRulePair, ifFalseRulePair] := by
      have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
        simp [MinEnv.candidates, kernelDefControlEnv]
      rw [hcandidateEq]
      simpa [target] using kernelEnv_if_candidates false thenA elseA
    have hitemsTrue :
        queryOpItemsOfRule [] target ambient st.counter ifTrueRulePair = [] := by
      let ft := counterSuffix st.counter
      have hfresh :
          freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2 =
            (mExpr "if" [mBool true, mVar (ft "t"), mVar (ft "e")],
              mVar (ft "t")) := by
        rw [freshenRule_eq_renBy]
        simp [ft, ifTrueRulePair, mExpr, mSym, mVar, mBool,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
      have hmatch :
          Metta.matchAtoms (mExpr "if" [mBool true, mVar (ft "t"), mVar (ft "e")])
              target = [] := by
        simp only [Metta.matchAtoms, Metta.matchAtomsWith, target, mExpr, mSym, mVar, mBool]
        unfold Metta.matchAll
        simp [Metta.matchAtomsWith, Metta.Bindings.merge]
        unfold Metta.matchAll
        rfl
      unfold queryOpItemsOfRule
      rw [hfresh]
      change
        List.flatMap
            (fun mb =>
              List.filterMap
                (fun mm =>
                  if Metta.Bindings.hasLoop mm = true then none
                  else some (evalResult [] (Metta.instantiate mm (mVar (ft "t"))) mm))
                (Metta.Bindings.merge ambient mb))
            (Metta.matchAtoms (mExpr "if" [mBool true, mVar (ft "t"), mVar (ft "e")])
              target) =
          []
      rw [hmatch]
      simp
    have hitemsFalse :
        queryOpItemsOfRule [] target ambient (st.counter + 1) ifFalseRulePair =
          [evalResult [] elseA m] := by
      have hclosedB : ClosedValueBindings coreB := by
        exact ClosedValueBindings.val hElseClosed
          (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
      have hvalB : ValueBindings coreB := by
        exact ValueBindings.val (ValueBindings.val ValueBindings.nil)
      have hnodup : (bindingValueKeys coreB).Nodup := by
        simp [coreB, bindingValueKeys]
      have hfresh :
          freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2 =
            (mExpr "if" [mBool false, mVar (f "t"), mVar (f "e")],
              mVar (f "e")) := by
        rw [freshenRule_eq_renBy]
        simp [f, ifFalseRulePair, mExpr, mSym, mVar, mBool,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
      have hmatch :
          Metta.matchAtoms (mExpr "if" [mBool false, mVar (f "t"), mVar (f "e")])
              target =
            [[Metta.BindingRel.val (f "e") elseA, Metta.BindingRel.val (f "t") thenA]] := by
        simp only [Metta.matchAtoms, Metta.matchAtomsWith, target, mExpr, mSym, mVar, mBool]
        unfold Metta.matchAll
        simp [Metta.matchAtomsWith, Metta.Bindings.merge]
        unfold Metta.matchAll
        simp [Metta.matchAtomsWith]
        unfold Metta.matchAll
        change
          Metta.matchAll none [[]] [mVar (f "t"), mVar (f "e")] [thenA, elseA] =
            [[Metta.BindingRel.val (f "e") elseA, Metta.BindingRel.val (f "t") thenA]]
        unfold Metta.matchAll
        simp only [mVar]
        rw [match_var_nonvar_atom (f "t") thenA hThenNonVar]
        simp [Metta.Bindings.merge, Metta.Bindings.mergeOne,
          Metta.Bindings.addVarBinding, Metta.Bindings.addValRaw,
          Metta.Bindings.removeVal]
        unfold Metta.matchAll
        rw [match_var_nonvar_atom (f "e") elseA hElseNonVar]
        simp [Metta.Bindings.merge, Metta.Bindings.mergeOne,
          Metta.Bindings.addVarBinding, Metta.Bindings.addValRaw,
          Metta.Bindings.removeVal]
        unfold Metta.matchAll
        rfl
      have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
        rw [bindingValueKeys_renameBindings]
        exact List.Nodup.map (counterSuffix_injective (st.counter + 1)) hnodup
      have hdisj :
          ∀ x ∈ bindingValueKeys (renameBindings f coreB),
            x ∉ bindingValueKeys ambient := by
        intro x hx hxAmbient
        have hx' : x = f "e" ∨ x = f "t" := by
          simpa [coreB, bindingValueKeys, renameBindings, f] using hx
        have hxAmbient' : x = binder := hAmbientKeys x hxAmbient
        rcases hx' with rfl | rfl
        · exact hFreshET (Or.inl rfl) hxAmbient'
        · exact hFreshET (Or.inr rfl) hxAmbient'
      have hmergeEq :
          Metta.Bindings.merge ambient (renameBindings f coreB) = [m] := by
        simpa [m] using
          (merge_value_noConflict_eq
            (b := renameBindings f coreB) (acc := ambient)
            (ValueBindings.rename hvalB) hnodupRen hdisj)
      have hmergeRaw :
          Metta.Bindings.merge ambient
              [Metta.BindingRel.val (f "e") elseA, Metta.BindingRel.val (f "t") thenA] =
            [m] := by
        simpa [coreB, renameBindings] using hmergeEq
      have hclosedAmbient : ClosedValueBindings ambient := hAmbientClosed
      have hclosedM : ClosedValueBindings m := by
        exact ClosedValueBindings.append
          (ClosedValueBindings.reverse (ClosedValueBindings.rename hclosedB))
          hclosedAmbient
      have hloop : Metta.Bindings.hasLoop m = false := by
        simpa [m] using ClosedValueBindings.hasLoop_false hclosedM
      have hresult : Metta.instantiate m (mVar (f "e")) = elseA := by
        have het : f "e" ≠ f "t" := by
          intro h
          have ht : "e" = "t" := (counterSuffix_injective (st.counter + 1)) h
          contradiction
        simp [m, f, coreB, mVar, renameBindings, Metta.instantiate,
          Metta.bindingsToSubst, Metta.Subst.apply, Metta.Subst.lookup, het]
      unfold queryOpItemsOfRule
      rw [hfresh]
      change
        List.flatMap
            (fun mb =>
              List.filterMap
                (fun mm =>
                  if Metta.Bindings.hasLoop mm = true then none
                  else some (evalResult [] (Metta.instantiate mm (mVar (f "e"))) mm))
                (Metta.Bindings.merge ambient mb))
            (Metta.matchAtoms (mExpr "if" [mBool false, mVar (f "t"), mVar (f "e")])
              target) =
          [evalResult [] elseA m]
      rw [hmatch]
      simp only [List.flatMap_cons, List.flatMap_nil]
      rw [hmergeRaw]
      simp [hloop, hresult]
    unfold queryOp
    rw [hNotVarHead]
    simp only [Bool.false_eq_true, ↓reduceIte]
