/-- Declaration-side half of successful `conv` over the name-free `nf` fragment.

If both sides of a `conv` control-flow run have `nf` readouts with the same
encoded atom, then the translated Pure terms are declaration-convertible.  This
is the piece consumed after the final `==` has been inverted to equality of the
two normalized readouts.  The runtime inversion from `mBool true` to this
same-readout premise remains the remaining control-flow bridge. -/
theorem nf_eq_fragment_same_nameFree_readout_decl_conv
    {sig : DIndGArtifactSig} {rawLeft rawRight : DIndGArtifactTerm}
    {out : Metta.Atom} {left right : PureTm 0}
    (hNameLeft : NfEqFragmentTermNameFree rawLeft)
    (hNameRight : NfEqFragmentTermNameFree rawRight)
    (hReadLeft : NfEqFragmentReadout sig rawLeft out)
    (hReadRight : NfEqFragmentReadout sig rawRight out)
    (hLeft :
      DIndGArtifactTermTranslates sig.nameTranslates 0 rawLeft left)
    (hRight :
      DIndGArtifactTermTranslates sig.nameTranslates 0 rawRight right) :
    ConvDecl (envOfSpecs sig.translatedSpecs) left right := by
  have hLeftOut := nf_eq_fragment_readout_eq_termAtom hReadLeft
  have hRightOut := nf_eq_fragment_readout_eq_termAtom hReadRight
  have hRaw : rawLeft = rawRight :=
    termAtom_injective_on_nf_eq_fragment_nameFree hNameLeft hNameRight
      (hLeftOut.symm.trans hRightOut)
  subst rawRight
  have hTerm : left = right :=
    dindg_translate_unique_on_nf_eq_fragment_nameFree
      (raw := rawLeft) hNameLeft hLeft hRight
  subst right
  exact Relation.EqvGen.refl left

/-- Declaration-side half of successful `conv` over the name-free `nf`
fragment, with the final grounded `==` still visible.

This is the producer-side composition point for the control-flow bridge: once a
runtime trace has supplied the two `nf` readouts and the final grounded equality
has returned true, this theorem turns those facts into the declaration-level
`ConvDecl`.  It deliberately does not assert that an arbitrary `conv` runtime
trace decomposes into these premises; that runtime inversion is the remaining
control-flow theorem. -/
theorem nf_eq_fragment_grounded_eq_true_nameFree_raw_eq
    {sig : DIndGArtifactSig} {rawLeft rawRight : DIndGArtifactTerm}
    {outLeft outRight : Metta.Atom}
    (hNameLeft : NfEqFragmentTermNameFree rawLeft)
    (hNameRight : NfEqFragmentTermNameFree rawRight)
    (hReadLeft : NfEqFragmentReadout sig rawLeft outLeft)
    (hReadRight : NfEqFragmentReadout sig rawRight outRight)
    (hEqTrue :
      Metta.callGrounded Metta.Minimal.stdGroundings "==" [outLeft, outRight] =
        Metta.ReduceResult.ok [mBool true]) :
    rawLeft = rawRight := by
  have hLeftOut := nf_eq_fragment_readout_eq_termAtom hReadLeft
  have hRightOut := nf_eq_fragment_readout_eq_termAtom hReadRight
  have hBeqOut : (outLeft == outRight) = true :=
    callGrounded_eq_true_implies_beq_true outLeft outRight
      (by simpa [hLeftOut] using termAtom_floatFree rawLeft)
      (by simpa [hRightOut] using termAtom_floatFree rawRight)
      (by simp [hLeftOut, termAtom_isError_false rawLeft])
      (by simp [hRightOut, termAtom_isError_false rawRight])
      hEqTrue
  have hBeqRaw : (termAtom rawLeft == termAtom rawRight) = true := by
    simpa [hLeftOut, hRightOut] using hBeqOut
  exact termAtom_beq_injective_on_nf_eq_fragment_nameFree
    hNameLeft hNameRight hBeqRaw

