/-- The fixed `IndG` iota candidate contributes no item under any live
incoming binding whenever its closed second pattern does not match.  Both
freshening branches rename only the signature variable, so the second-pattern
mismatch is stable without a legacy-freshening premise. -/
private theorem queryOpItems_nf_indG_zero_iota_eq_nil_of_term_match_nil_from
    (counter : Nat) (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm)
    (incoming : Metta.Bindings)
    (hTerm :
      Metta.matchAtoms (termAtom cicStage3IndGZeroRawRuntime) (termAtom raw) = []) :
    Metta.Minimal.queryOpItemsOfRule [] (nfQuery sig raw) incoming counter
        nfIndGZeroIotaRulePair = [] := by
  let target := nfQuery sig raw
  let avoid := Metta.Minimal.queryOpAvoid [] target incoming
  by_cases hcollision :
      ∃ v ∈
          (freshenRule counter nfIndGZeroIotaRulePair.1
            nfIndGZeroIotaRulePair.2).1.vars ++
          (freshenRule counter nfIndGZeroIotaRulePair.1
            nfIndGZeroIotaRulePair.2).2.vars,
        v ∈ avoid
  · have hmatch :
        Metta.matchAtoms
            (mExpr "nf"
              [mVar (captureAvoidingName avoid counter "sig"),
                termAtom cicStage3IndGZeroRawRuntime])
            target = [] := by
      simpa [target, nfQuery] using
        fresh_nf_second_match_nil
          (captureAvoidingName avoid counter) sig
          (termAtom cicStage3IndGZeroRawRuntime) (termAtom raw) hTerm
    unfold Metta.Minimal.queryOpItemsOfRule
    rw [show
      freshenRuleAvoiding counter avoid nfIndGZeroIotaRulePair.1
          nfIndGZeroIotaRulePair.2 =
        ((renameAllVars (captureAvoidingName avoid counter)
            nfIndGZeroIotaRulePair.1,
          renameAllVars (captureAvoidingName avoid counter)
            nfIndGZeroIotaRulePair.2),
          counter + 1) by
        rw [freshenRuleAvoiding, if_pos hcollision]]
    change
      (Metta.matchAtoms
          (renameAllVars (captureAvoidingName avoid counter)
            nfIndGZeroIotaRulePair.1) target).flatMap _ = []
    rw [show renameAllVars (captureAvoidingName avoid counter)
          nfIndGZeroIotaRulePair.1 =
        mExpr "nf"
          [mVar (captureAvoidingName avoid counter "sig"),
            termAtom cicStage3IndGZeroRawRuntime] by
      simp [nfIndGZeroIotaRulePair, nfIndGZeroIotaRuleLhs,
        cicStage3IndGZeroRawRuntime, renameAllVars, termAtom, argsAtom,
        casesAtom, sortAtom, declNameAtom, mExpr, mSym, mVar]]
    rw [hmatch]
    rfl
  · have hmatch :
        Metta.matchAtoms
            (mExpr "nf"
              [mVar (counterSuffix counter "sig"),
                termAtom cicStage3IndGZeroRawRuntime])
            target = [] := by
      simpa [target, nfQuery] using
        fresh_nf_second_match_nil (counterSuffix counter) sig
          (termAtom cicStage3IndGZeroRawRuntime) (termAtom raw) hTerm
    unfold Metta.Minimal.queryOpItemsOfRule
    rw [freshenRuleAvoiding_eq_legacy counter avoid
      nfIndGZeroIotaRulePair.1 nfIndGZeroIotaRulePair.2 hcollision]
    rw [freshenRule_eq_renBy]
    change
      (Metta.matchAtoms
          (Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy
            (counterSuffix counter) nfIndGZeroIotaRulePair.1) target).flatMap _ = []
    rw [show Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy
          (counterSuffix counter) nfIndGZeroIotaRulePair.1 =
        mExpr "nf"
          [mVar (counterSuffix counter "sig"),
            termAtom cicStage3IndGZeroRawRuntime] by
      simp [nfIndGZeroIotaRulePair, nfIndGZeroIotaRuleLhs,
        cicStage3IndGZeroRawRuntime,
        Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
        renameAllVars, termAtom, argsAtom, casesAtom, sortAtom, declNameAtom,
        mExpr, mSym, mVar]]
    rw [hmatch]
    rfl

