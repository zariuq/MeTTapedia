              ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)).merge
              ([] : Metta.Bindings)).head?.getD [])) ∈
      (mettaEval env (fuel + 1) st []
        (Metta.Atom.expr [Metta.Atom.sym op, pattern, atom, template])).1 := by
  let qvars := ([pattern, atom, template]).flatMap Metta.Atom.vars
  rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
    env fuel st op [pattern, atom, template] [false, true, false] false hPolicy
      hApplicationNotError]
  apply mem_prioritizeSemanticResults_of_mem_of_not_error
    (hError := hFinalNotError)
  rw [evaluateSelectedApplication_eq_factored]
  rw [evaluateSelectedApplicationFactored_quoted_eval_quoted_singleton_eq_partFoldStep
    env fuel st stAtom op pattern atom template atom' hAtom hNoErr]
  let rootItem : Item :=
    { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
        Metta.Atom.expr [Metta.Atom.sym op, pattern, atom', template]]) [],
