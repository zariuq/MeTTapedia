private theorem queryOpItems_if_true_eq
    (counter : Nat) (thenA elseA : Metta.Atom)
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w) :
    Metta.Minimal.queryOpItemsOfRule [] (mExpr "if" [mBool true, thenA, elseA]) []
        counter ifTrueRulePair =
      [evalResult [] thenA
        [ Metta.BindingRel.val (counterSuffix counter "t") thenA
        , Metta.BindingRel.val (counterSuffix counter "e") elseA ]] := by
  let f := counterSuffix counter
  have hfresh :
      freshenRule counter ifTrueRulePair.1 ifTrueRulePair.2 =
        (mExpr "if" [mBool true, mVar (f "t"), mVar (f "e")], mVar (f "t")) := by
    rw [freshenRule_eq_renBy]
    simp [f, ifTrueRulePair, mExpr, mSym, mVar, mBool,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms (mExpr "if" [mBool true, mVar (f "t"), mVar (f "e")])
          (mExpr "if" [mBool true, thenA, elseA]) =
        [[Metta.BindingRel.val (f "e") elseA, Metta.BindingRel.val (f "t") thenA]] := by
    simpa [f, hfresh] using fresh_if_true_rule_match counter thenA elseA
      (by simp [hThenClosed]) (by simp [hElseClosed]) hThenNonVar hElseNonVar
      (by simp [hThenClosed]) (by simp [hElseClosed])
  have hte : f "t" ≠ f "e" := by
    intro h
    have ht : "t" = "e" := (counterSuffix_injective counter) h
    contradiction
  have het : f "e" ≠ f "t" := by
    intro h
    exact hte h.symm
  have hmerge :
      Metta.Bindings.merge [] [Metta.BindingRel.val (f "e") elseA,
          Metta.BindingRel.val (f "t") thenA] =
        [[Metta.BindingRel.val (f "t") thenA,
          Metta.BindingRel.val (f "e") elseA]] := by
    apply merge_closed_noConflict_eq
    · exact ClosedValueBindings.val hElseClosed
        (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
    · simp [bindingValueKeys, het]
    · exact ClosedValueBindings.nil
    · intro x hx hmem
      cases hmem
  have hclosedM :
      ClosedValueBindings
        [ Metta.BindingRel.val (f "t") thenA
        , Metta.BindingRel.val (f "e") elseA ] := by
    exact ClosedValueBindings.val hThenClosed
      (ClosedValueBindings.val hElseClosed ClosedValueBindings.nil)
  have hloop :
      Metta.Bindings.hasLoop
        [ Metta.BindingRel.val (f "t") thenA
        , Metta.BindingRel.val (f "e") elseA ] = false := by
    exact ClosedValueBindings.hasLoop_false hclosedM
  have hinst :
      Metta.instantiate
          [ Metta.BindingRel.val (f "t") thenA
          , Metta.BindingRel.val (f "e") elseA ]
          (mVar (f "t")) =
        thenA := by
    rw [hclosedM.instantiate_eq_subst_apply]
    simp [mVar, Metta.bindingsToSubst, Metta.Subst.apply, Metta.Subst.lookup]
  rw [queryOpItemsOfRule_eq_legacy_of_target_vars_nil counter
    (mExpr "if" [mBool true, thenA, elseA]) ifTrueRulePair
    (by simp [mExpr, mSym, mBool, Metta.Atom.vars,
      hThenClosed, hElseClosed])]
  rw [hfresh]
  change
    List.flatMap
        (fun mb =>
          List.filterMap
            (fun m =>
              if Metta.Bindings.hasLoop m = true then none
              else some (evalResult [] (Metta.instantiate m (mVar (f "t"))) m))
            (Metta.Bindings.merge [] mb))
        (Metta.matchAtoms (mExpr "if" [mBool true, mVar (f "t"), mVar (f "e")])
          (mExpr "if" [mBool true, thenA, elseA])) =
      [evalResult [] thenA
        [ Metta.BindingRel.val (counterSuffix counter "t") thenA
        , Metta.BindingRel.val (counterSuffix counter "e") elseA ]]
  rw [hmatch]
  simp [hmerge, hloop, hinst, f]

private theorem queryOpItems_if_false_on_true_eq_nil
    (counter : Nat) (thenA elseA : Metta.Atom)
    (ambient : Metta.Bindings := []) :
    Metta.Minimal.queryOpItemsOfRule [] (mExpr "if" [mBool true, thenA, elseA]) ambient
        counter ifFalseRulePair = [] := by
  let avoid := Metta.Minimal.queryOpAvoid []
    (mExpr "if" [mBool true, thenA, elseA]) ambient
  have hshape : ∃ t e rhs,
      (freshenRuleAvoiding counter avoid ifFalseRulePair.1 ifFalseRulePair.2).1 =
        (mExpr "if" [mBool false, mVar t, mVar e], rhs) := by
    by_cases hcollision : ∃ v ∈
        (freshenRule counter ifFalseRulePair.1 ifFalseRulePair.2).1.vars ++
          (freshenRule counter ifFalseRulePair.1 ifFalseRulePair.2).2.vars,
        v ∈ avoid
    · rw [freshenRuleAvoiding, if_pos hcollision]
      refine ⟨captureAvoidingName avoid counter "t",
        captureAvoidingName avoid counter "e",
        mVar (captureAvoidingName avoid counter "e"), ?_⟩
      simp [ifFalseRulePair, renameAllVars, mExpr, mSym, mVar, mBool]
    · rw [freshenRuleAvoiding, if_neg hcollision]
      refine ⟨counterSuffix counter "t", counterSuffix counter "e",
        mVar (counterSuffix counter "e"), ?_⟩
      rw [freshenRule_eq_renBy]
      simp [ifFalseRulePair, mExpr, mSym, mVar, mBool,
        Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  rcases hshape with ⟨t, e, rhs, hshape⟩
  unfold Metta.Minimal.queryOpItemsOfRule
  change
    (let (lhs', rhs') :=
        (freshenRuleAvoiding counter avoid ifFalseRulePair.1 ifFalseRulePair.2).1;
      (Metta.matchAtoms lhs' (mExpr "if" [mBool true, thenA, elseA])).flatMap
        fun mb => (Metta.Bindings.merge ambient mb).filterMap fun m =>
          if Metta.Bindings.hasLoop m then none
          else some (evalResult [] (Metta.instantiate m rhs') m)) = []
  rw [hshape]
  have hBoolMismatch :
      Metta.matchAtomsWith none (Metta.Atom.gnd (Metta.Ground.bool false))
        (Metta.Atom.gnd (Metta.Ground.bool true)) = [] := by
    decide
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, mExpr, mSym, mVar, mBool]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge, hBoolMismatch]
  unfold Metta.matchAll
  simp [hBoolMismatch, Metta.matchAll]

private theorem queryOpItems_if_true_on_false_eq_nil
    (counter : Nat) (thenA elseA : Metta.Atom)
    (ambient : Metta.Bindings := []) :
    Metta.Minimal.queryOpItemsOfRule [] (mExpr "if" [mBool false, thenA, elseA]) ambient
        counter ifTrueRulePair = [] := by
  let avoid := Metta.Minimal.queryOpAvoid []
    (mExpr "if" [mBool false, thenA, elseA]) ambient
  have hshape : ∃ t e rhs,
      (freshenRuleAvoiding counter avoid ifTrueRulePair.1 ifTrueRulePair.2).1 =
        (mExpr "if" [mBool true, mVar t, mVar e], rhs) := by
    by_cases hcollision : ∃ v ∈
        (freshenRule counter ifTrueRulePair.1 ifTrueRulePair.2).1.vars ++
          (freshenRule counter ifTrueRulePair.1 ifTrueRulePair.2).2.vars,
        v ∈ avoid
    · rw [freshenRuleAvoiding, if_pos hcollision]
      refine ⟨captureAvoidingName avoid counter "t",
        captureAvoidingName avoid counter "e",
        mVar (captureAvoidingName avoid counter "t"), ?_⟩
      simp [ifTrueRulePair, renameAllVars, mExpr, mSym, mVar, mBool]
    · rw [freshenRuleAvoiding, if_neg hcollision]
      refine ⟨counterSuffix counter "t", counterSuffix counter "e",
        mVar (counterSuffix counter "t"), ?_⟩
      rw [freshenRule_eq_renBy]
      simp [ifTrueRulePair, mExpr, mSym, mVar, mBool,
        Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  rcases hshape with ⟨t, e, rhs, hshape⟩
  unfold Metta.Minimal.queryOpItemsOfRule
  change
    (let (lhs', rhs') :=
        (freshenRuleAvoiding counter avoid ifTrueRulePair.1 ifTrueRulePair.2).1;
      (Metta.matchAtoms lhs' (mExpr "if" [mBool false, thenA, elseA])).flatMap
        fun mb => (Metta.Bindings.merge ambient mb).filterMap fun m =>
          if Metta.Bindings.hasLoop m then none
          else some (evalResult [] (Metta.instantiate m rhs') m)) = []
  rw [hshape]
  have hBoolMismatch :
      Metta.matchAtomsWith none (Metta.Atom.gnd (Metta.Ground.bool true))
        (Metta.Atom.gnd (Metta.Ground.bool false)) = [] := by
    decide
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, mExpr, mSym, mVar, mBool]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge, hBoolMismatch]
  unfold Metta.matchAll
  simp [hBoolMismatch, Metta.matchAll]

private theorem queryOpItems_if_false_eq
    (counter : Nat) (thenA elseA : Metta.Atom)
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w) :
    Metta.Minimal.queryOpItemsOfRule [] (mExpr "if" [mBool false, thenA, elseA]) []
        counter ifFalseRulePair =
      [evalResult [] elseA
        [ Metta.BindingRel.val (counterSuffix counter "t") thenA
        , Metta.BindingRel.val (counterSuffix counter "e") elseA ]] := by
  let f := counterSuffix counter
  have hfresh :
      freshenRule counter ifFalseRulePair.1 ifFalseRulePair.2 =
        (mExpr "if" [mBool false, mVar (f "t"), mVar (f "e")], mVar (f "e")) := by
    rw [freshenRule_eq_renBy]
    simp [f, ifFalseRulePair, mExpr, mSym, mVar, mBool,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms (mExpr "if" [mBool false, mVar (f "t"), mVar (f "e")])
          (mExpr "if" [mBool false, thenA, elseA]) =
        [[Metta.BindingRel.val (f "e") elseA, Metta.BindingRel.val (f "t") thenA]] := by
    simpa [f, hfresh] using fresh_if_false_rule_match counter thenA elseA
      (by simp [hThenClosed]) (by simp [hElseClosed]) hThenNonVar hElseNonVar
      (by simp [hThenClosed]) (by simp [hElseClosed])
  have hte : f "t" ≠ f "e" := by
    intro h
    have ht : "t" = "e" := (counterSuffix_injective counter) h
    contradiction
  have het : f "e" ≠ f "t" := by
    intro h
    exact hte h.symm
  have hmerge :
      Metta.Bindings.merge [] [Metta.BindingRel.val (f "e") elseA,
          Metta.BindingRel.val (f "t") thenA] =
        [[Metta.BindingRel.val (f "t") thenA,
          Metta.BindingRel.val (f "e") elseA]] := by
    apply merge_closed_noConflict_eq
    · exact ClosedValueBindings.val hElseClosed
        (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
    · simp [bindingValueKeys, het]
    · exact ClosedValueBindings.nil
    · intro x hx hmem
      cases hmem
  have hclosedM :
      ClosedValueBindings
        [ Metta.BindingRel.val (f "t") thenA
        , Metta.BindingRel.val (f "e") elseA ] := by
    exact ClosedValueBindings.val hThenClosed
      (ClosedValueBindings.val hElseClosed ClosedValueBindings.nil)
  have hloop :
      Metta.Bindings.hasLoop
        [ Metta.BindingRel.val (f "t") thenA
        , Metta.BindingRel.val (f "e") elseA ] = false := by
    exact ClosedValueBindings.hasLoop_false hclosedM
  have hinst :
      Metta.instantiate
          [ Metta.BindingRel.val (f "t") thenA
          , Metta.BindingRel.val (f "e") elseA ]
          (mVar (f "e")) =
        elseA := by
    rw [hclosedM.instantiate_eq_subst_apply]
    simp [mVar, Metta.bindingsToSubst, Metta.Subst.apply,
      Metta.Subst.lookup, het]
  rw [queryOpItemsOfRule_eq_legacy_of_target_vars_nil counter
    (mExpr "if" [mBool false, thenA, elseA]) ifFalseRulePair
    (by simp [mExpr, mSym, mBool, Metta.Atom.vars,
      hThenClosed, hElseClosed])]
  rw [hfresh]
  change
    List.flatMap
        (fun mb =>
          List.filterMap
            (fun m =>
              if Metta.Bindings.hasLoop m = true then none
              else some (evalResult [] (Metta.instantiate m (mVar (f "e"))) m))
            (Metta.Bindings.merge [] mb))
        (Metta.matchAtoms (mExpr "if" [mBool false, mVar (f "t"), mVar (f "e")])
          (mExpr "if" [mBool false, thenA, elseA])) =
      [evalResult [] elseA
        [ Metta.BindingRel.val (counterSuffix counter "t") thenA
        , Metta.BindingRel.val (counterSuffix counter "e") elseA ]]
  rw [hmatch]
  simp [hmerge, hloop, hinst, f]

private theorem queryOp_kernelDefControlEnv_if_true_eq
    (st : St) (thenA elseA : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w) :
    queryOp kernelDefControlEnv st [] (mExpr "if" [mBool true, thenA, elseA]) [] =
      ( [evalResult [] thenA
          ((renameBindings (counterSuffix st.counter)
            [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]).reverse)]
      , { counter := st.counter + 2, world := st.world }) := by
  let target := mExpr "if" [mBool true, thenA, elseA]
  let coreB : Metta.Bindings :=
    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix st.counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  have hNotVarHead : isVariableHeaded target = false := by
    simp [target, isVariableHeaded, mExpr, mSym]
  have hCand : kernelDefControlEnv.candidates target = [ifTrueRulePair, ifFalseRulePair] := by
    have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
      simp [MinEnv.candidates, kernelDefControlEnv]
    rw [hcandidateEq]
    simpa [target] using kernelEnv_if_candidates true thenA elseA
  have hitemsTrue :
      Metta.Minimal.queryOpItemsOfRule [] target [] st.counter ifTrueRulePair =
        [evalResult [] thenA m] := by
    simpa [target, m, f, coreB, renameBindings] using
      queryOpItems_if_true_eq st.counter thenA elseA
        hThenClosed hElseClosed hThenNonVar hElseNonVar
  have hitemsFalse :
      Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1) ifFalseRulePair = [] := by
    simpa [target] using
      queryOpItems_if_false_on_true_eq_nil (st.counter + 1) thenA elseA
  unfold queryOp
  rw [hNotVarHead]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [candidatesW_eq_candidates_of_no_selfRules
    kernelDefControlEnv st.world target hStatic hImports]
  rw [hCand]
  simp only [List.foldl_cons, List.foldl_nil,
    Metta.Minimal.queryOpFoldStep, freshenRuleAvoiding_counter]
  change
    (if ((([] ++ Metta.Minimal.queryOpItemsOfRule [] target [] st.counter ifTrueRulePair) ++
              Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1) ifFalseRulePair).isEmpty =
            true) then
        ([finItem [] notReducibleA []],
          ({ counter := st.counter + 1 + 1, world := st.world } : St))
      else
        ((([] ++ Metta.Minimal.queryOpItemsOfRule [] target [] st.counter ifTrueRulePair) ++
              Metta.Minimal.queryOpItemsOfRule [] target [] (st.counter + 1) ifFalseRulePair),
          ({ counter := st.counter + 1 + 1, world := st.world } : St))) =
      ( [evalResult [] thenA
          ((renameBindings (counterSuffix st.counter)
            [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]).reverse)]
      , ({ counter := st.counter + 2, world := st.world } : St))
  rw [hitemsTrue, hitemsFalse]
  simp [m, f, coreB, renameBindings]

