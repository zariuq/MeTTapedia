          (fun ho : Metta.Atom × Metta.Atom =>
            ho.1.isError && ho.1 != ho.2)) = none)
    (hErr : nx.isError = true) :
    False := by
  have hBeqFalse : (nx == nfQuery sig rawLeft) = false := by
    cases hBeq : (nx == nfQuery sig rawLeft) <;> simp
    have hNxNoErr :=
