    mopsStep_append_left
      (extra := [ruleIfTrue, ruleIfFalse, ruleLet]) hMops
  exact
    (Metta.kernelStep_iff_mopsStep (atoms := kernelControlRules)
      (gt := stdGroundings)).2
      (by simpa [kernelControlRules] using hControl)

