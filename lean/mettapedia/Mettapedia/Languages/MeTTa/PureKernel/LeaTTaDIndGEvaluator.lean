theorem kernelCoreRules_queryOp_eq_core_of_append_nonfiring
    {extra : List Metta.Atom} {toEval : Metta.Atom} {k : String}
    (prev : Stack) (b : Bindings)
    (hhead : headKey toEval = some k)
