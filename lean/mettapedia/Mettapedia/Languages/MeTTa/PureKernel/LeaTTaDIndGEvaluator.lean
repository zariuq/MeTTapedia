      (mBool true, outBnd) ∈
        (mettaEval kernelDefControlEnv (fuel + 1) st bnd
          (mExpr "let" [pattern, bodyQuery, template])).1) :
    ∃ seed branchState argPairs stArg,
      mettaEval kernelDefControlEnv fuel branchState seed bodyQuery =
          (argPairs, stArg) ∧
      let sourceArgs := [pattern, bodyQuery, template]
      let patternOut := Metta.instantiate seed pattern
      let queryVars := expectedApplicationRetentionScope seed sourceArgs
      let rows := argPairs.map (fun out : Metta.Atom × Metta.Bindings =>
        ([patternOut, out.1],
          restrictBnd queryVars
            ((Metta.Bindings.merge seed out.2).head?.getD out.2)))
      let parts := rows.map (completeQuotedTailArgument sourceArgs template)
      (mBool true, outBnd) ∈
        (parts.foldl
          (mettaEvalExprPartFoldStep kernelDefControlEnv fuel queryVars
            "let" sourceArgs seed false)
          ([], stArg)).1 := by
  rcases
      kernelDefControlEnv_let_live_executionPlan_exists
        fuel st bnd hTypes pattern bodyQuery template outBnd hinst hmem with
    ⟨plan, hSelected⟩
  have hPolicies :
      argumentEvaluationPolicies plan.selected 3 =
        [(false, .sym "Atom"), (true, .sym "%Undefined%"),
          (false, .sym "Atom")] := by
    rw [hSelected]
    have hAtom := instantiate_of_closed bnd (.sym "Atom")
      (by simp [Metta.Atom.vars])
    have hUndefined := instantiate_of_closed bnd (.sym "%Undefined%")
      (by simp [Metta.Atom.vars])
    change
      [ ((Metta.instantiate bnd (.sym "Atom") != .sym "Atom") &&
            (Metta.instantiate bnd (.sym "Atom") != .sym "Variable") &&
            (Metta.instantiate bnd (.sym "Atom") != .sym "Expression"),
          Metta.instantiate bnd (.sym "Atom"))
      , ((Metta.instantiate bnd (.sym "%Undefined%") != .sym "Atom") &&
            (Metta.instantiate bnd (.sym "%Undefined%") != .sym "Variable") &&
            (Metta.instantiate bnd (.sym "%Undefined%") != .sym "Expression"),
          Metta.instantiate bnd (.sym "%Undefined%"))
      , ((Metta.instantiate bnd (.sym "Atom") != .sym "Atom") &&
            (Metta.instantiate bnd (.sym "Atom") != .sym "Variable") &&
            (Metta.instantiate bnd (.sym "Atom") != .sym "Expression"),
          Metta.instantiate bnd (.sym "Atom")) ] =
        [(false, .sym "Atom"), (true, .sym "%Undefined%"),
          (false, .sym "Atom")]
    rw [hAtom, hUndefined]
    rfl
  have hReturn : returnsAtom plan.selected = false := by
    rw [hSelected]
    have hUndefined := instantiate_of_closed bnd (.sym "%Undefined%")
      (by simp [Metta.Atom.vars])
    change (Metta.instantiate bnd (.sym "%Undefined%") == .sym "Atom") = false
    rw [hUndefined]
    rfl
  have hExpected : selectedResultExpected plan.selected = .sym "%Undefined%" := by
    rw [hSelected]
    have hUndefined := instantiate_of_closed bnd (.sym "%Undefined%")
      (by simp [Metta.Atom.vars])
    change
      (if Metta.instantiate bnd (.sym "%Undefined%") == .sym "Expression"
