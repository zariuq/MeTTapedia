theorem mettaEvalExpected_kernelDefControlEnv_eq_of_bool_eval
    (fuel : Nat) (st stOut : St) (a b : Metta.Atom) (value : Bool)
    (hTypes : KernelDefControlEnvTypeWorld st.world)
