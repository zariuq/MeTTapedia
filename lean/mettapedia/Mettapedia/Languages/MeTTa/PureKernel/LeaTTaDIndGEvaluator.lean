/-- A live selected `nf Lam` application preserves one closed public binding
provided the exposed recursive readout does so.  This is the single
state-threaded assembly theorem used by both nested `Lam` links in the
`PropToType` witnesses. -/
theorem mettaEval_kernelDefControlEnv_nf_lam_body_eq_state_singleton_closed_of_readout
    (fuel : Nat) (st stOut : St) (sig : DIndGArtifactSig)
    (rawDomain rawBody : DIndGArtifactTerm)
    (binder : String) (value final : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hTypes : KernelDefControlEnvTypeWorld st.world)
    (hValueClosed : value.vars = [])
    (hValueNonVar : ∀ name, value ≠ Metta.Atom.var name)
    (hValueUnify : Metta.Bindings.unifyValues [value, value] = some [])
    (hFresh :
      ∀ {v : String}, v = "sig" ∨ v = "A" ∨ v = "b" →
        counterSuffix (st.counter + 4) v ≠ binder)
    (hReadout :
      mettaEval kernelDefControlEnv (fuel + 2)
          { counter := st.counter + 8, world := st.world }
          [Metta.BindingRel.val binder value]
          (nfLamReadout sig rawDomain rawBody) =
        ([(final, [Metta.BindingRel.val binder value])], stOut)) :
    mettaEval kernelDefControlEnv (fuel + 3) st
        [Metta.BindingRel.val binder value]
        (nfQuery sig (.lam rawDomain rawBody)) =
      ([(final, [Metta.BindingRel.val binder value])], stOut) := by
  let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
  let args : List Metta.Atom :=
