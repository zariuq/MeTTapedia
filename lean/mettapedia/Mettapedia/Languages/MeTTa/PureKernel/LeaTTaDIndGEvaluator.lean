private theorem cicStage3RawArtifactSig_primary_nf_defn_fresh_root_world_of_one_le_five
    {fuel : Nat} {st : St} {name : DeclName} {binder : String}
    (hFuel : 1 ≤ fuel)
    (hLeFive : fuel ≤ 5)
    (hWorld : st.world = St.init.world)
    (hFreshLet :
