          (convReadoutAfterNxNy bodyAtom bodyAtom)).1 := by
  dsimp
  let bodyAtom := termAtom cicStage3RawIdentityWitness
  let cond₂ := mExpr "is-bad" [bodyAtom]
  let eqA := mExpr "==" [bodyAtom, bodyAtom]
