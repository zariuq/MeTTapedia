private theorem queryOpItemsOfRule_eq_nil_of_fresh_match_nil
    (counter : Nat) (target lhs rhs : Metta.Atom)
    (rule : Metta.Atom × Metta.Atom)
    (hTargetClosed : target.vars = [])
    (hFresh :
      freshenRule counter rule.1 rule.2 = (lhs, rhs))
