  let stRoot₂ : St := { counter := st.counter + 6, world := st.world }
  have hElse₁Closed : else₁.vars = [] := by
    simp [else₁, cond₂, eqA, hNxVars, hNyVars, mExpr, mSym,
      mBool, Metta.Atom.vars]
