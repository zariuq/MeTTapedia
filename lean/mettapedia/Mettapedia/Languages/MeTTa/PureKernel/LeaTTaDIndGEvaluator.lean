/-- Exact repaired-runtime policy for an executable-kernel `nf` call. -/
def kernelEnv_nf_exactPolicy
    (st : St) (a b : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelEnv st.world "nf"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom"]]) :
    ApplicationPolicyProjection kernelEnv st.world "nf" [a, b] [false, false] true := by
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom"]
      argumentTypes := [mSym "Atom", mSym "Atom"]
      returnType := mSym "Atom"
      typeBindings := [] }
  have hSelected :
      selectFunctionType kernelEnv st.world (.sym "nf") [a, b] = .selected selected := by
    have hCheck : typeCheckArgsOutcome kernelEnv st.world
        [.sym "Atom", .sym "Atom"] 0 [] [a, b] = .success [] := by
      simpa [mSym] using typeCheckArgsOutcome_two_atoms kernelEnv st.world a b
    simpa [selected, mExpr, mSym] using
      (selectFunctionType_singleton_arrow_selected_of_outcome
        kernelEnv st.world "nf" [a, b] [.sym "Atom", .sym "Atom"]
        (.sym "Atom") [] hPinned (by simp) hCheck)
  have hMask : argMask selected 2 = [false, false] := by
    simp only [selected, argMask, Metta.instantiate_nil, mSym]
    decide
  have hReturns : returnsAtom selected = true := by
    simp only [selected, returnsAtom, Metta.instantiate_nil, mSym]
    decide
  exact ⟨.selected selected hSelected, hMask, hReturns⟩

def kernelEnv_nf_recursionNeutralPolicy
    (st : St) (a b : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelEnv st.world "nf"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom"]]) :
    RecursionNeutralApplicationPolicy kernelEnv st.world "nf"
      [a, b] [false, false] true := by
  apply (kernelEnv_nf_exactPolicy st a b hPinned).withRecursionNeutralOfAllArgumentsQuoted
  · apply ExactApplicationPolicy.applicationPlanCorresponds_atom_args_symbolic_return
    simpa [OperatorTypesPinned, mExpr, mSym] using hPinned
  · rfl
  · left
    rfl

