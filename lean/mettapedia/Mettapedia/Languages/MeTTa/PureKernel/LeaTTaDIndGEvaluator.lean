      (mExpr "Bad" [mVar (counterSuffix st.counter "e")]) = []) :
    mettaEval kernelDefControlEnv (fuel + 3) st [] (mExpr "is-bad" [a]) =
      ([(mBool false, [])], { counter := st.counter + 1, world := st.world }) := by
