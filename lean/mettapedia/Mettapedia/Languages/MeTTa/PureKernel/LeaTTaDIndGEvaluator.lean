/-- The full control-flow kernel environment preserves equality-rule `conv`
queries at the query layer. -/
theorem kernelEnv_conv_queryOp_eq_core
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm)
    (prev : Stack) (b : Bindings) :
    queryOp kernelEnv St.init prev (convQuery sig rawLeft rawRight) b =
      queryOp kernelCoreEnv St.init prev (convQuery sig rawLeft rawRight) b := by
  have hcontrol :
      candidatesW kernelEnv St.init.world (convQuery sig rawLeft rawRight) =
        candidatesW
          (MinEnv.ofAtomsGT
            (kernelControlSignatureDecls ++
              (kernelNfDefBodyRootRules ++ [ruleIfTrue, ruleIfFalse, ruleLet]))
            stdGroundings)
          St.init.world (convQuery sig rawLeft rawRight) := by
    simp [candidatesW, MinEnv.candidates, kernelEnv, kernelControlRules]
  have hprepend :
      candidatesW
          (MinEnv.ofAtomsGT
            (kernelControlSignatureDecls ++
              (kernelNfDefBodyRootRules ++ [ruleIfTrue, ruleIfFalse, ruleLet]))
            stdGroundings)
          St.init.world (convQuery sig rawLeft rawRight) =
        candidatesW
          (MinEnv.ofAtomsGT (kernelNfDefBodyRootRules ++ [ruleIfTrue, ruleIfFalse, ruleLet])
            stdGroundings)
          St.init.world (convQuery sig rawLeft rawRight) := by
    exact candidatesW_prepend_nonfiring_for_head
      (pre := kernelControlSignatureDecls)
      (atoms := kernelNfDefBodyRootRules ++ [ruleIfTrue, ruleIfFalse, ruleLet])
      (gt := stdGroundings)
      (toEval := convQuery sig rawLeft rawRight) (k := "conv")
      (by simp [convQuery, mExpr, mSym, headKey])
      kernelControlSignatureDecls_conv_nonfiring_idx
      kernelControlSignatureDecls_conv_nonfiring_var
  have happend :
      candidatesW
          (MinEnv.ofAtomsGT (kernelNfDefBodyRootRules ++ [ruleIfTrue, ruleIfFalse, ruleLet])
            stdGroundings)
          St.init.world (convQuery sig rawLeft rawRight) =
        candidatesW kernelCoreEnv St.init.world (convQuery sig rawLeft rawRight) := by
    simpa [kernelNfDefBodyRootRules, List.append_assoc] using
      (kernelCoreRules_candidates_eq_core_of_append_nonfiring
        (extra := [ruleNfIndGZeroIota, ruleNfDef, ruleDefBodyOfDDef,
          ruleIfTrue, ruleIfFalse, ruleLet])
        (toEval := convQuery sig rawLeft rawRight) (k := "conv")
        (by simp [convQuery, mExpr, mSym, headKey])
        kernelControlTail_conv_nonfiring_idx
        kernelControlTail_conv_nonfiring_var)
  exact queryOp_eq_of_candidatesW_eq (hcontrol.trans (hprepend.trans happend))

/-- If an environment has the standard grounding table and the same `conv`
equality-query readout as `kernelCoreEnv`, then its top-level `evalOp` readout
for the same `conv` query is also the same. -/
theorem evalOp_conv_eq_core_of_queryOp_eq
    {env : MinEnv} (sig : DIndGArtifactSig)
    (rawLeft rawRight : DIndGArtifactTerm) (prev : Stack)
    (hgt : env.gt = stdGroundings)
    (hquery : queryOp env St.init prev (convQuery sig rawLeft rawRight) [] =
      queryOp kernelCoreEnv St.init prev (convQuery sig rawLeft rawRight) []) :
    evalOp env St.init prev (convQuery sig rawLeft rawRight) [] =
      evalOp kernelCoreEnv St.init prev (convQuery sig rawLeft rawRight) [] := by
  have hinst : Metta.instantiate [] (convQuery sig rawLeft rawRight) =
      Metta.Atom.expr
        (Metta.Atom.sym "conv" :: [sigAtom sig, termAtom rawLeft, termAtom rawRight]) := by
    simpa [convQuery, mExpr, mSym] using
      (Metta.instantiate_nil (convQuery sig rawLeft rawRight))
  have hcall : callGrounded env.gt "conv"
        ([sigAtom sig, termAtom rawLeft, termAtom rawRight].map
          (fun a => resolveStates St.init.world (subTokens St.init.world a))) =
      ReduceResult.noReduce := by
    rw [hgt]
    simpa [kernelCoreEnv, MinEnv.ofAtomsGT] using
      kernelCoreEnv_callGrounded_conv sig rawLeft rawRight
  have hembed :
      isEmbeddedOp
        (Metta.Atom.expr
          (Metta.Atom.sym "conv" :: [sigAtom sig, termAtom rawLeft, termAtom rawRight])) = false := by
    rfl
  have hleft := evalOp_queryOp_of_instantiated_noReduce
      (env := env) (st := St.init) (prev := prev)
      (x := convQuery sig rawLeft rawRight) (b := [])
      (op := "conv") (args := [sigAtom sig, termAtom rawLeft, termAtom rawRight])
      hinst hcall hembed
  have hright := evalOp_queryOp_of_instantiated_noReduce
      (env := kernelCoreEnv) (st := St.init) (prev := prev)
      (x := convQuery sig rawLeft rawRight) (b := [])
      (op := "conv") (args := [sigAtom sig, termAtom rawLeft, termAtom rawRight])
      hinst (kernelCoreEnv_callGrounded_conv sig rawLeft rawRight) hembed
  rw [hleft, hright]
  exact hquery

/-- Immediate evaluator form of `kernelEnv_conv_queryOp_eq_core`.

At the actual `(eval (conv ...))` dispatch boundary, the control signatures and
the `let`/`if` helper rules still do not interfere with `conv`; grounded
dispatch falls through on both environments, and the resulting `evalOp`
readouts agree. -/
theorem kernelEnv_conv_evalOp_eq_core
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) (prev : Stack) :
    evalOp kernelEnv St.init prev (convQuery sig rawLeft rawRight) [] =
      evalOp kernelCoreEnv St.init prev (convQuery sig rawLeft rawRight) [] := by
  exact evalOp_conv_eq_core_of_queryOp_eq sig rawLeft rawRight prev
    (by rfl)
    (kernelEnv_conv_queryOp_eq_core sig rawLeft rawRight prev [])

