/-- Def-control `let` has a singleton signature with raw `%Undefined%` return, so an outer
expected `Bool` does not change which complete application policy is selected. -/
theorem mettaEvalExpected_kernelDefControlEnv_let_bool_eq_mettaEval
    (fuel : Nat) (st : St) (pattern atom template : Metta.Atom)
    (hTypes : KernelDefControlEnvTypeWorld st.world) :
    mettaEvalExpected kernelDefControlEnv fuel st []
        (mExpr "let" [pattern, atom, template]) (mSym "Bool") =
      mettaEval kernelDefControlEnv fuel st []
        (mExpr "let" [pattern, atom, template]) := by
  cases fuel with
  | zero =>
      have hExpected : (mSym "Bool" == mSym "%Undefined%") = false := by rfl
      simp [mettaEvalExpected, Metta.Minimal.mettaEval.eq_1, mExpr, mSym,
        Metta.Atom.isError, Metta.instantiate_nil, hExpected]
      all_goals
        simp [Metta.Atom.metaType, Metta.Atom.atomType,
          Metta.Atom.typeAtomOfMetaType, Metta.Atom.beq]
      all_goals decide
  | succ fuel =>
      apply mettaEvalExpected_eq_mettaEval_of_singleton_undefined_return
        kernelDefControlEnv fuel st "let" [pattern, atom, template]
          [.sym "Atom", .sym "%Undefined%", .sym "Atom"] [] [] (mSym "Bool")
          (ordinaryHeadBindings := []) (headBindings := [])
      · rfl
      · rfl
      · simp [Metta.Atom.isError]
      · simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.letOp
      · simpa [mExpr, mSym] using
          (freshenFunctionTypeCandidates_map_sym kernelDefControlEnv
            (mExpr "let" [pattern, atom, template]) [pattern, atom, template]
            (mSym "Bool")
            ["->", "Atom", "%Undefined%", "Atom", "%Undefined%"])
      · simp
      · simpa [mSym] using typeCheckArgsOutcome_atom_undefined_atom
          kernelDefControlEnv st.world pattern atom template
      · simpa [mExpr, mSym] using
          (Metta.selectFunctionTypeForExpectedFrom_let_policy_selected
            kernelDefControlEnv st.world "let" pattern atom template (by
              simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.letOp))
      · simpa [mExpr, mSym] using
          (mettaTypeCastAvoiding_symbolic_arrow
            (expectedApplicationVisibleScope
              (mExpr "let" [pattern, atom, template]) (mSym "%Undefined%"))
            kernelDefControlEnv st.world "let"
            ["Atom", "%Undefined%", "Atom", "%Undefined%"] (by
              simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.letOp))
      · simp
      · apply typeCheckArgsDetailedOutcomeScoped_all_gradual
        intro j hj
        simp at hj
        have : j = 0 ∨ j = 1 ∨ j = 2 := by omega
        rcases this with rfl | rfl | rfl <;> simp
      · simpa [mExpr, mSym] using
          (mettaTypeCastAvoiding_symbolic_arrow
            (expectedApplicationVisibleScope
              (mExpr "let" [pattern, atom, template]) (mSym "Bool"))
            kernelDefControlEnv st.world "let"
            ["Atom", "%Undefined%", "Atom", "%Undefined%"] (by
              simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.letOp))
      · simp

