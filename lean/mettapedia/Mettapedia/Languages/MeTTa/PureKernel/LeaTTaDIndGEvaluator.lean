        ([Metta.Minimal.finItem prev
          (Metta.instantiate [Metta.BindingRel.val binder atom] template)
          [Metta.BindingRel.val binder atom]], st))

theorem is_bad_control_mops_step
    (a : Metta.Atom) (hA : ∀ w, a ≠ Metta.Atom.var w) :
    Metta.MopsStep kernelControlRules
      (mExpr "is-bad" [a])
      (mExpr "unify" [a, mExpr "Bad" [mVar "e"], mBool true, mBool false]) := by
  constructor
  · refine ⟨"is-bad", ?_⟩
    simp [Metta.Minimal.headKey, mExpr, mSym]
  · rw [Metta.mem_equalityReductions]
    refine ⟨isBadRulePair, ?_, ?_⟩
    · simp [Metta.Space.equalityRules, kernelControlRules, kernelNfDefBodyRootRules,
        ruleNfDef, ruleDefBodyOfDDef, ruleIfTrue,
        ifTrueRulePair, ruleIfFalse, ifFalseRulePair, ruleLet, letRulePair,
        kernelCoreRules, runtimeDecls, ruleIsBad, isBadRulePair, ruleNfVar,
        ruleNfSrt, ruleNfCon, ruleNfPi, ruleNfLam, ruleNfBad,
        ruleInferSrtType, ruleInferSrtKind, ruleInferBad, ruleConv, mExpr,
        mSym, mVar, mTypeDecl, mBool]
    · refine ⟨[Metta.BindingRel.val "x" a], ?_, ?_⟩
      · rw [is_bad_rule_match a hA]
        simp
      · exact (is_bad_instantiate_bindings a).symm

