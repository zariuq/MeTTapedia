        Metta.Subst.apply [(counterSuffix st.counter "x", a)] a = a := by
      exact Metta.Subst.apply_of_closed _ _ hClosed
    simpa [root, m, renameBindings, counterSuffix,
      Metta.instantiate, Metta.bindingsToSubst,
      Metta.Subst.apply, Metta.Subst.lookup, hsubstA, hxe,
      mExpr, mSym, mVar, mBool]
  have hpair : finalPair (evalResult [] root m) = (root, m) := by
    rw [heval]
