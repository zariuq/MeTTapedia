  have hright := evalOp_queryOp_of_instantiated_noReduce
      (env := kernelCoreEnv) (st := St.init) (prev := prev)
      (x := convQuery sig rawLeft rawRight) (b := [])
      (op := "conv") (args := [sigAtom sig, termAtom rawLeft, termAtom rawRight])
