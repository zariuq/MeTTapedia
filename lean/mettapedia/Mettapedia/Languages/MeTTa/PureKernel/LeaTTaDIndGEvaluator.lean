/-- The kernel `if` applicability scan succeeds from the empty evaluator theory
whenever the condition's first presented type is `Bool`.  The remaining type
presentations stay in the latent diagnostic ledger rather than being erased. -/
theorem kernelDefControlEnv_if_detailed_init_of_bool_cons
    (cond thenBranch elseBranch : Metta.Atom) (condTail : List Metta.Atom)
    (hCondTypes :
      getTypes kernelDefControlEnv (typePrep St.init.world cond) =
        mSym "Bool" :: condTail) :
    ∃ latentErrors,
      typeCheckArgsDetailedOutcomeScoped kernelDefControlEnv St.init.world
          [mSym "Bool", mSym "Atom", mSym "Atom"]
          (applicationTypeInferenceScopeFrom (mSym "%Undefined%")
            [cond, thenBranch, elseBranch] [])
          0 [] [cond, thenBranch, elseBranch] =
        .success [] latentErrors := by
  obtain ⟨thenType, thenTail, hThenTypes⟩ := List.exists_cons_of_ne_nil
    (getTypes_ne_nil kernelDefControlEnv (typePrep St.init.world thenBranch))
  obtain ⟨elseType, elseTail, hElseTypes⟩ := List.exists_cons_of_ne_nil
    (getTypes_ne_nil kernelDefControlEnv (typePrep St.init.world elseBranch))
  have hMatchBool :
      matchType ([] : Metta.Bindings) (Metta.Atom.sym "Bool")
          (Metta.Atom.sym "Bool") = some [] := by
    simp [matchType, matchReduced, Metta.matchAtoms, Metta.matchAtomsWith,
      Metta.Bindings.merge]
  simp [typeCheckArgsDetailedOutcomeScoped, hCondTypes, hThenTypes, hElseTypes,
    scanActualTypes, freshenTypeCandidate, renameAllVars, hMatchBool,
    matchType_atom_left, mSym]

/-- The kernel `if` applicability scan is binding-preserving for an arbitrary
incoming theory when the condition's first presented type is the ground
`Bool` type.  This is the live-seed counterpart of
`kernelDefControlEnv_if_detailed_init_of_bool_cons`: it retains the incoming
theory in both the scan input and the successful output rather than comparing
the result with the raw empty-seed selector. -/
theorem kernelDefControlEnv_if_detailed_of_bool_cons
    (incoming : Metta.Bindings)
    (cond thenBranch elseBranch : Metta.Atom) (condTail : List Metta.Atom)
    (hloop : Metta.Bindings.hasLoop incoming = false)
    (hCondTypes :
      getTypes kernelDefControlEnv (typePrep St.init.world cond) =
        mSym "Bool" :: condTail) :
    ∃ latentErrors,
      typeCheckArgsDetailedOutcomeScoped kernelDefControlEnv St.init.world
          [mSym "Bool", mSym "Atom", mSym "Atom"]
          (applicationTypeInferenceScopeFrom (mSym "%Undefined%")
            [cond, thenBranch, elseBranch] incoming)
          0 incoming [cond, thenBranch, elseBranch] =
        .success incoming latentErrors := by
  obtain ⟨thenType, thenTail, hThenTypes⟩ := List.exists_cons_of_ne_nil
    (getTypes_ne_nil kernelDefControlEnv (typePrep St.init.world thenBranch))
  obtain ⟨elseType, elseTail, hElseTypes⟩ := List.exists_cons_of_ne_nil
    (getTypes_ne_nil kernelDefControlEnv (typePrep St.init.world elseBranch))
  have hMatchBool :
      matchType incoming (Metta.Atom.sym "Bool")
          (Metta.Atom.sym "Bool") = some incoming := by
    simp [matchType, matchReduced, Metta.matchAtoms, Metta.matchAtomsWith,
      Metta.Bindings.merge]
    intro _ _ _
    exact hloop
  simp [typeCheckArgsDetailedOutcomeScoped, hCondTypes, hThenTypes, hElseTypes,
    scanActualTypes, freshenTypeCandidate, renameAllVars, hMatchBool,
    matchType_atom_left, mSym]

/-- Data-bearing form of the live detailed `if` scan.  The latent ledger is
read from the concrete computable outcome; the existential theorem is used
only to rule out the impossible failure constructor and identify the output
bindings.  Thus no choice or Prop-to-Type extraction enters the plan. -/
def kernelDefControlEnv_if_detailedPackage_of_bool_cons
    (incoming : Metta.Bindings)
    (cond thenBranch elseBranch : Metta.Atom) (condTail : List Metta.Atom)
    (hloop : Metta.Bindings.hasLoop incoming = false)
    (hCondTypes :
      getTypes kernelDefControlEnv (typePrep St.init.world cond) =
        mSym "Bool" :: condTail) :
    { latentErrors : List TypeCheckArgsError //
      typeCheckArgsDetailedOutcomeScoped kernelDefControlEnv St.init.world
          [mSym "Bool", mSym "Atom", mSym "Atom"]
          (applicationTypeInferenceScopeFrom (mSym "%Undefined%")
            [cond, thenBranch, elseBranch] incoming)
          0 incoming [cond, thenBranch, elseBranch] =
        .success incoming latentErrors } := by
  let outcome :=
    typeCheckArgsDetailedOutcomeScoped kernelDefControlEnv St.init.world
      [mSym "Bool", mSym "Atom", mSym "Atom"]
      (applicationTypeInferenceScopeFrom (mSym "%Undefined%")
        [cond, thenBranch, elseBranch] incoming)
      0 incoming [cond, thenBranch, elseBranch]
  have hExists := kernelDefControlEnv_if_detailed_of_bool_cons incoming cond
    thenBranch elseBranch condTail hloop hCondTypes
  cases hOutcome : outcome with
  | success output latentErrors =>
      have hOutput : output = incoming := by
        rcases hExists with ⟨otherLatent, hSuccess⟩
        change outcome = .success incoming otherLatent at hSuccess
        rw [hOutcome] at hSuccess
        exact (TypeCheckArgsDetailedOutcome.success.inj hSuccess).1
      subst output
      exact ⟨latentErrors, by simpa [outcome] using hOutcome⟩
  | failure firstError moreErrors =>
      have hFalse : False := by
        rcases hExists with ⟨latentErrors, hSuccess⟩
        change outcome = .success incoming latentErrors at hSuccess
        rw [hOutcome] at hSuccess
        cases hSuccess
      exact False.elim hFalse

/-- Construct the exact live selected plan for a closed kernel `if`
application.  Applicability is checked from `incoming`, and singleton seeding
is derived only from the explicit absence of public application variables;
neither fact is inferred from the legacy raw selector. -/
def evalQuotedQuotedApplicationExecutionPlan_kernelDefControlEnv_if_of_bool_cons
    (incoming : Metta.Bindings)
    (cond thenBranch elseBranch : Metta.Atom) (condTail : List Metta.Atom)
    (hloop : Metta.Bindings.hasLoop incoming = false)
    (hClosed :
      ([cond, thenBranch, elseBranch].flatMap Metta.Atom.vars) = [])
    (hCondTypes :
      getTypes kernelDefControlEnv (typePrep St.init.world cond) =
        mSym "Bool" :: condTail) :
    EvalQuotedQuotedApplicationExecutionPlan kernelDefControlEnv
      St.init.world incoming "if" [cond, thenBranch, elseBranch]
      (mSym "Bool") := by
  let detailed := kernelDefControlEnv_if_detailedPackage_of_bool_cons incoming
    cond thenBranch elseBranch condTail hloop hCondTypes
  let latentErrors := detailed.1
  have hDetailed :
      typeCheckArgsDetailedOutcomeScoped kernelDefControlEnv St.init.world
          [mSym "Bool", mSym "Atom", mSym "Atom"]
          (applicationTypeInferenceScopeFrom (mSym "%Undefined%")
            [cond, thenBranch, elseBranch] incoming)
          0 incoming [cond, thenBranch, elseBranch] =
        .success incoming latentErrors := detailed.2
  have hTypes :
      getTypes kernelDefControlEnv
          (typePrep St.init.world (Metta.Atom.sym "if")) =
        [Metta.Atom.expr
          [Metta.Atom.sym "->", Metta.Atom.sym "Bool", Metta.Atom.sym "Atom",
            Metta.Atom.sym "Atom", Metta.Atom.sym "%Undefined%"]] := by
    rw [typePrep_init_world_eq_self]
    simpa [mExpr, mSym] using kernelDefControlEnv_if_types
  let plan := selectedApplicationExecutionPlan_symbolic_arrow_from_detailed
    kernelDefControlEnv St.init.world "if" [cond, thenBranch, elseBranch]
      ["Bool", "Atom", "Atom"] "%Undefined%" incoming incoming latentErrors
      hTypes (by simp) hDetailed hloop
  have hSeed : plan.seeds = [incoming] := by
    change Metta.Bindings.merge incoming
      (restrictBnd
        (expectedApplicationVisibleScope
          (Metta.Atom.expr
            [Metta.Atom.sym "if", cond, thenBranch, elseBranch])
          (Metta.Atom.sym "%Undefined%")) incoming) = [incoming]
    have hScope :
        expectedApplicationVisibleScope
            (Metta.Atom.expr
              [Metta.Atom.sym "if", cond, thenBranch, elseBranch])
            (Metta.Atom.sym "%Undefined%") = [] := by
      have hArgsVars :
          cond.vars ++ (thenBranch.vars ++ elseBranch.vars) = [] := by
        simpa [List.flatMap] using hClosed
      simp [expectedApplicationVisibleScope, Metta.Atom.vars, hArgsVars]
    rw [hScope, restrictBnd_nil_vars]
    rfl
  exact evalQuotedQuotedApplicationExecutionPlan_symbolic_from_detailed
    kernelDefControlEnv St.init.world incoming "if" cond thenBranch elseBranch
      incoming latentErrors hTypes hDetailed hloop (by simpa [plan] using hSeed)

/-- The live detailed applicability scan for the kernel `if` signature keeps
the empty incoming theory when its condition is an `is-bad` application.
The existential ledger is deliberate: latent failures from later actual-type
alternatives remain observable even though the first `Bool` presentation
commits the candidate. -/
theorem kernelDefControlEnv_if_is_bad_detailed_init
    (a thenBranch elseBranch : Metta.Atom) :
    ∃ latentErrors,
      typeCheckArgsDetailedOutcomeScoped kernelDefControlEnv St.init.world
          [mSym "Bool", mSym "Atom", mSym "Atom"]
          (applicationTypeInferenceScopeFrom (mSym "%Undefined%")
            [mExpr "is-bad" [a], thenBranch, elseBranch] [])
          0 [] [mExpr "is-bad" [a], thenBranch, elseBranch] =
        .success [] latentErrors := by
  obtain ⟨condTail, hCondTypes⟩ :=
    kernelDefControlEnv_getTypes_is_bad_bool_cons_init a
  have hCondTypes' :
      getTypes kernelDefControlEnv
          (typePrep St.init.world
            (Metta.Atom.expr [Metta.Atom.sym "is-bad", a])) =
        Metta.Atom.sym "Bool" :: condTail := by
    simpa [mExpr, mSym] using hCondTypes
  exact kernelDefControlEnv_if_detailed_init_of_bool_cons
    (mExpr "is-bad" [a]) thenBranch elseBranch condTail hCondTypes'

