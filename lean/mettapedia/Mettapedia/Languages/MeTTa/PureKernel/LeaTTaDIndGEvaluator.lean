  unfold Metta.matchAll
  rw [match_var_occurs_free_nonvar_atom var₂ target₂ h₂ hNonVar₂]
  rw [filter_singleton_binding_of_hasLoop_false _
    (hasLoop_singleton_val_not_false var₂ target₂ h₂)]
