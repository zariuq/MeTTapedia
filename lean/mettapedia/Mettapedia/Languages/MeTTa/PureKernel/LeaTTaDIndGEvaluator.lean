/-- Once the third component of an `infer` rule cannot match, the two leading
variable bindings cannot contribute a result.  This keeps the negative query
proofs independent of freshening and loop-filter implementation details. -/
private theorem infer_match_none_of_tail
    (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm)
    (counter : Nat) (tail : Metta.Atom)
    (hTail : Metta.matchAtomsWith none tail (termAtom raw) = []) :
    Metta.matchAtoms
        (mExpr "infer"
          [mVar ("sig#" ++ Nat.repr counter),
            mVar ("ctx#" ++ Nat.repr counter), tail])
        (inferQuery sig raw) = [] := by
  change Metta.matchAtoms
      (mExpr "infer"
        [mVar ("sig#" ++ Nat.repr counter),
          mVar ("ctx#" ++ Nat.repr counter), tail])
      (mExpr "infer" [sigAtom sig, ctxNilAtom, termAtom raw]) = []
  rw [match_ternary_two_vars_tail_filtered
    "infer" ("sig#" ++ Nat.repr counter) ("ctx#" ++ Nat.repr counter)
    (sigAtom sig) ctxNilAtom tail (termAtom raw)
    (by intro h; simpa using h) (by simp [sigAtom_vars_absent])
    ctxNilAtom_vars_absent (sigAtom_not_var sig) ctxNilAtom_not_var]
  rw [hTail]
  rfl

private theorem infer_srt_type_on_other_match_none
    (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm)
    (hOther : raw ≠ .srt .type) :
    Metta.matchAtoms
        (mExpr "infer"
          [mVar ("sig#" ++ Nat.repr 0), mVar ("ctx#" ++ Nat.repr 0),
            mExpr "Srt" [mSym "type"]])
        (inferQuery sig raw) = [] := by
  apply infer_match_none_of_tail sig raw 0 (mExpr "Srt" [mSym "type"])
  cases raw with
  | var index => simp [termAtom, mExpr, mSym, mNat, Metta.matchAtomsWith, Metta.matchAll]
  | srt sort =>
      cases sort with
      | type => exact False.elim (hOther rfl)
      | kind =>
          simp [termAtom, sortAtom, mExpr, mSym, Metta.matchAtomsWith,
            Metta.matchAll, Metta.Bindings.merge]
  | con name =>
      simp [termAtom, declNameAtom, mExpr, mSym, Metta.matchAtomsWith, Metta.matchAll]
  | defn name =>
      simp [termAtom, declNameAtom, mExpr, mSym, Metta.matchAtomsWith, Metta.matchAll]
  | pi domain body => simp [termAtom, mExpr, mSym, Metta.matchAtomsWith, Metta.matchAll]
  | lam domain body => simp [termAtom, mExpr, mSym, Metta.matchAtomsWith, Metta.matchAll]
  | app fn arg => simp [termAtom, mExpr, mSym, Metta.matchAtomsWith, Metta.matchAll]
  | indG familyName params motive cases indices scrutinee =>
      simp [termAtom, mExpr, mSym, Metta.matchAtomsWith, Metta.matchAll]
  | bad reason => simp [termAtom, mExpr, mSym, Metta.matchAtomsWith, Metta.matchAll]

