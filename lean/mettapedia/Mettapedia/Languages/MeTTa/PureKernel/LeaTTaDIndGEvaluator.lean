theorem nf_eq_fragment_mettaEval_decl_conv_in_inferApplyArgsNilRules_of_fragment
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {term : PureTm 0}
    (hfrag : NfEqFragmentTerm raw)
    (htr :
      DIndGArtifactTermTranslates sig.nameTranslates 0 raw term) :
    ∃ rootOut rootCertified,
      rootOut ∈ (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig raw)).1.map (·.1) ∧
        Relation.ReflTransGen (Metta.KernelStep kernelInferApplyArgsNilRules stdGroundings)
          (nfQuery sig raw) rootCertified ∧
        Metta.AlphaEq rootOut rootCertified ∧
        Relation.ReflTransGen (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
          rootCertified (termAtom raw) ∧
        RedStarDecl (envOfSpecs sig.translatedSpecs) term term ∧
        ConvDecl (envOfSpecs sig.translatedSpecs) term term := by
  simpa [kernelInferApplyArgsNilRules] using
    (nf_eq_fragment_mettaEval_decl_conv_append_left_of_fragment
      (extra := [ruleInferApplyArgsDecl, ruleInferApplyArgsNil])
      (sig := sig) (raw := raw) (term := term) hfrag htr)

/-- `nf`/`ConvDecl` package lifted to the `infer-indg-params ArgsNil` helper slice. -/
theorem nf_eq_fragment_mettaEval_decl_conv_in_inferIndgParamsArgsNilRules_of_fragment
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {term : PureTm 0}
    (hfrag : NfEqFragmentTerm raw)
    (htr :
      DIndGArtifactTermTranslates sig.nameTranslates 0 raw term) :
    ∃ rootOut rootCertified,
      rootOut ∈ (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig raw)).1.map (·.1) ∧
        Relation.ReflTransGen
          (Metta.KernelStep kernelInferIndgParamsArgsNilRules stdGroundings)
          (nfQuery sig raw) rootCertified ∧
        Metta.AlphaEq rootOut rootCertified ∧
        Relation.ReflTransGen
          (ExprCtxKernelStep kernelInferIndgParamsArgsNilRules stdGroundings)
          rootCertified (termAtom raw) ∧
        RedStarDecl (envOfSpecs sig.translatedSpecs) term term ∧
        ConvDecl (envOfSpecs sig.translatedSpecs) term term := by
  simpa [kernelInferIndgParamsArgsNilRules, kernelInferApplyArgsNilRules, List.append_assoc] using
    (nf_eq_fragment_mettaEval_decl_conv_append_left_of_fragment
      (extra :=
        [ruleInferApplyArgsDecl, ruleInferApplyArgsNil,
          ruleInferIndgParamsDecl, ruleInferIndgParamsArgsNil])
      (sig := sig) (raw := raw) (term := term) hfrag htr)

/-- Single-chain form of the D3 helper bridge.

This packages the helper root step and the reused `nf` fragment bridge into one
certified contextual kernel chain under the helper rule slice. The actual
runtime readouts remain explicit and tied to the certified roots by alpha. -/
theorem infer_apply_args_nil_mettaEval_contextual_kernel_of_fragment
    {sig : DIndGArtifactSig} {rawType : DIndGArtifactTerm}
    (hfrag : NfEqFragmentTerm rawType) :
    ∃ out helperOut helperCertified nfRootOut nfCertified,
      helperOut ∈
          (mettaEval kernelInferApplyArgsNilEnv 1 St.init []
            (inferApplyArgsNilQuery sig rawType)).1.map (·.1) ∧
        Metta.AlphaEq helperOut helperCertified ∧
        helperCertified = nfQuery sig rawType ∧
        nfRootOut ∈
          (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig rawType)).1.map (·.1) ∧
        Metta.AlphaEq nfRootOut nfCertified ∧
        Relation.ReflTransGen
          (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
          (inferApplyArgsNilQuery sig rawType) out := by
  rcases infer_apply_args_nil_mettaEval_bridge_alpha_kernel_of_fragment
      (sig := sig) hfrag with
    ⟨out, helperOut, helperCertified, nfRootOut, nfCertified,
      hhelperRun, hhelperRoot, hhelperAlpha, hhelperEq,
      hnfRun, hnfRoot, hnfAlpha, hnfCtx⟩
  have hhelperCtx :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
        (inferApplyArgsNilQuery sig rawType) helperCertified :=
    kernelChain_to_exprCtxKernelChain hhelperRoot
  have hnfRootCtxCore :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelCoreRules stdGroundings)
        (nfQuery sig rawType) nfCertified :=
    kernelChain_to_exprCtxKernelChain hnfRoot
  have hnfRootCtx :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
        (nfQuery sig rawType) nfCertified := by
    simpa [kernelInferApplyArgsNilRules] using
      (exprCtxKernelChain_append_left
        (atoms := kernelCoreRules)
        (extra := [ruleInferApplyArgsDecl, ruleInferApplyArgsNil])
        (gt := stdGroundings) hnfRootCtxCore)
  have hnfCtxLift :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
        nfCertified out := by
    simpa [kernelInferApplyArgsNilRules] using
      (exprCtxKernelChain_append_left
        (atoms := kernelCoreRules)
        (extra := [ruleInferApplyArgsDecl, ruleInferApplyArgsNil])
        (gt := stdGroundings) hnfCtx)
  have hchain :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
        (inferApplyArgsNilQuery sig rawType) out := by
    subst helperCertified
    exact hhelperCtx.trans (hnfRootCtx.trans hnfCtxLift)
  exact ⟨out, helperOut, helperCertified, nfRootOut, nfCertified,
    hhelperRun, hhelperAlpha, hhelperEq, hnfRun, hnfAlpha, hchain⟩

/-- Closed Stage-3 instance of the D3 helper bridge.

This is the no-hypothesis smoke test for the smallest recursive infer-family
rule: the real helper readout for `infer-apply-args ... ArgsNil` exposes an
`nf` query, and the composed contextual kernel chain reaches the closed/static
`nf` result without assuming a readout witness. -/
theorem infer_apply_args_nil_srt_type_contextual_kernel :
    ∃ out helperOut helperCertified nfRootOut nfCertified,
      helperOut ∈
          (mettaEval kernelInferApplyArgsNilEnv 1 St.init []
            (inferApplyArgsNilQuery cicStage3RawArtifactSig (.srt .type))).1.map (·.1) ∧
        Metta.AlphaEq helperOut helperCertified ∧
        helperCertified = nfQuery cicStage3RawArtifactSig (.srt .type) ∧
        nfRootOut ∈
          (mettaEval kernelCoreEnv 1 St.init []
            (nfQuery cicStage3RawArtifactSig (.srt .type))).1.map (·.1) ∧
        Metta.AlphaEq nfRootOut nfCertified ∧
        Relation.ReflTransGen
          (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
          (inferApplyArgsNilQuery cicStage3RawArtifactSig (.srt .type)) out := by
  exact infer_apply_args_nil_mettaEval_contextual_kernel_of_fragment
    (sig := cicStage3RawArtifactSig)
    (rawType := .srt .type)
    (NfEqFragmentTerm.srt .type)

/-! ## D4a: consume the `ArgsNil` helper inside the next IndG helper -/

private def inferIndgParamsArgsNilRuleBindings
    (sig : DIndGArtifactSig) (name : DeclName)
    (motive : DIndGArtifactTerm)
    (cases : List (DeclName × DIndGArtifactTerm))
    (indices : DIndGArtifactArgs) (scrut : DIndGArtifactTerm)
    (ctors : List DIndGArtifactCtor) (rawT0 : DIndGArtifactTerm) :
    Metta.Bindings :=
  [ BindingRel.val "T0" (termAtom rawT0)
  , BindingRel.val "ctors" (ctorsAtom ctors)
  , BindingRel.val "scrut" (termAtom scrut)
  , BindingRel.val "indices" (argsAtom indices)
  , BindingRel.val "cases" (casesAtom cases)
  , BindingRel.val "motive" (termAtom motive)
  , BindingRel.val "name" (declNameAtom name)
  , BindingRel.val "ctx" ctxNilAtom
  , BindingRel.val "sig" (sigAtom sig) ]

theorem infer_indg_params_args_nil_rule_match
    (sig : DIndGArtifactSig) (name : DeclName)
    (motive : DIndGArtifactTerm)
    (cases : List (DeclName × DIndGArtifactTerm))
    (indices : DIndGArtifactArgs) (scrut : DIndGArtifactTerm)
    (ctors : List DIndGArtifactCtor) (rawT0 : DIndGArtifactTerm) :
    Metta.matchAtoms inferIndgParamsArgsNilRulePair.1
        (inferIndgParamsArgsNilQuery sig name motive cases indices scrut ctors rawT0) =
      [inferIndgParamsArgsNilRuleBindings sig name motive cases indices scrut ctors rawT0] := by
  simp only [inferIndgParamsArgsNilRulePair, inferIndgParamsArgsNilQuery, mExpr, mSym, mVar,
    Metta.matchAtoms, Metta.matchAtomsWith]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "sig" (sigAtom sig) (sigAtom_not_var sig)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "ctx" ctxNilAtom ctxNilAtom_not_var]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "name" (declNameAtom name) (declNameAtom_not_var name)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  simp [argsAtom, mSym, Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "motive" (termAtom motive) (termAtom_not_var motive)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "cases" (casesAtom cases) (casesAtom_not_var cases)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "indices" (argsAtom indices) (argsAtom_not_var indices)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "scrut" (termAtom scrut) (termAtom_not_var scrut)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "ctors" (ctorsAtom ctors) (ctorsAtom_not_var ctors)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "T0" (termAtom rawT0) (termAtom_not_var rawT0)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal,
    inferIndgParamsArgsNilRuleBindings]
  unfold Metta.matchAll
  simp

theorem infer_indg_params_args_nil_instantiate_bindings
    (sig : DIndGArtifactSig) (name : DeclName)
    (motive : DIndGArtifactTerm)
    (cases : List (DeclName × DIndGArtifactTerm))
    (indices : DIndGArtifactArgs) (scrut : DIndGArtifactTerm)
    (ctors : List DIndGArtifactCtor) (rawT0 : DIndGArtifactTerm) :
    Metta.instantiate
        (inferIndgParamsArgsNilRuleBindings sig name motive cases indices scrut ctors rawT0)
        inferIndgParamsArgsNilRulePair.2 =
      inferIndgParamsArgsNilReadout sig motive cases indices scrut ctors rawT0 := by
  simp [inferIndgParamsArgsNilRuleBindings, inferIndgParamsArgsNilRulePair,
    inferIndgParamsArgsNilReadout, inferIndgParamsArgsNilAfterApplyArgs,
    inferIndgMotiveQuery, inferApplyArgsNilQuery, argsAtom, mExpr, mSym, mVar,
    ctxNilAtom, Metta.instantiate, Metta.bindingsToSubst,
    Metta.Subst.apply, Metta.Subst.lookup]

theorem infer_indg_params_args_nil_root_mops
    (sig : DIndGArtifactSig) (name : DeclName)
    (motive : DIndGArtifactTerm)
    (cases : List (DeclName × DIndGArtifactTerm))
    (indices : DIndGArtifactArgs) (scrut : DIndGArtifactTerm)
    (ctors : List DIndGArtifactCtor) (rawT0 : DIndGArtifactTerm) :
    Relation.ReflTransGen (Metta.MopsStep kernelInferIndgParamsArgsNilRules)
      (inferIndgParamsArgsNilQuery sig name motive cases indices scrut ctors rawT0)
      (inferIndgParamsArgsNilReadout sig motive cases indices scrut ctors rawT0) := by
  have hstep : Metta.MopsStep kernelInferIndgParamsArgsNilRules
      (inferIndgParamsArgsNilQuery sig name motive cases indices scrut ctors rawT0)
      (inferIndgParamsArgsNilReadout sig motive cases indices scrut ctors rawT0) := by
    constructor
    · exact ⟨"infer-indg-params", by
        simp [inferIndgParamsArgsNilQuery, mExpr, mSym, headKey]⟩
    · rw [Metta.mem_equalityReductions]
      refine ⟨inferIndgParamsArgsNilRulePair, ?_, ?_⟩
      · simp [Metta.Space.equalityRules, kernelInferIndgParamsArgsNilRules,
          kernelInferApplyArgsNilRules, inferIndgParamsArgsNilRulePair,
          ruleInferIndgParamsArgsNil, ruleInferIndgParamsDecl, ruleInferApplyArgsDecl,
          ruleInferApplyArgsNil, inferApplyArgsNilRulePair, kernelCoreRules, runtimeDecls,
          ruleIsBad, ruleNfVar, ruleNfSrt, ruleNfCon, ruleNfPi, ruleNfLam, ruleNfBad,
          ruleInferSrtType, ruleInferSrtKind, ruleInferBad, ruleConv, mExpr, mSym, mVar,
          mTypeDecl, mBool]
      · refine ⟨inferIndgParamsArgsNilRuleBindings sig name motive cases indices scrut ctors rawT0,
          ?_, ?_⟩
        · rw [infer_indg_params_args_nil_rule_match]
          simp
        · exact (infer_indg_params_args_nil_instantiate_bindings sig name motive cases indices
            scrut ctors rawT0).symm
  exact Relation.ReflTransGen.tail Relation.ReflTransGen.refl hstep

/-- D4a bridge: the next source helper after `infer-apply-args ArgsNil`
exposes that helper as a real subquery, and the already-discharged D3 bridge is
lifted into the `let` binding position.

This theorem deliberately stops before claiming the surrounding `let`/`if`
control-flow is certified by the equality-rule relation.  It certifies the
source-aligned root helper step and the recursive `infer-apply-args ArgsNil`
substep, which is the reusable composition skeleton needed before the full App
body. -/
theorem infer_indg_params_args_nil_consumes_apply_args_nil_contextual_kernel
    {sig : DIndGArtifactSig} {name : DeclName}
    {motive : DIndGArtifactTerm}
    {cases : List (DeclName × DIndGArtifactTerm)}
    {indices : DIndGArtifactArgs} {scrut : DIndGArtifactTerm}
    {ctors : List DIndGArtifactCtor} {rawT0 : DIndGArtifactTerm}
    (hfrag : NfEqFragmentTerm rawT0) :
    ∃ out helperOut helperCertified nfRootOut nfCertified,
      helperOut ∈
          (mettaEval kernelInferApplyArgsNilEnv 1 St.init []
            (inferApplyArgsNilQuery sig rawT0)).1.map (·.1) ∧
        Metta.AlphaEq helperOut helperCertified ∧
        helperCertified = nfQuery sig rawT0 ∧
        nfRootOut ∈
          (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig rawT0)).1.map (·.1) ∧
        Metta.AlphaEq nfRootOut nfCertified ∧
        Relation.ReflTransGen
          (ExprCtxKernelStep kernelInferIndgParamsArgsNilRules stdGroundings)
          (inferIndgParamsArgsNilQuery sig name motive cases indices scrut ctors rawT0)
          (inferIndgParamsArgsNilAfterApplyArgs sig motive cases indices scrut ctors out) := by
  rcases infer_apply_args_nil_mettaEval_contextual_kernel_of_fragment
      (sig := sig) (rawType := rawT0) hfrag with
    ⟨out, helperOut, helperCertified, nfRootOut, nfCertified,
      hhelperRun, hhelperAlpha, hhelperEq, hnfRun, hnfAlpha, hsubCore⟩
  have hrootMops :=
    infer_indg_params_args_nil_root_mops sig name motive cases indices scrut ctors rawT0
  have hrootKernel :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferIndgParamsArgsNilRules stdGroundings)
        (inferIndgParamsArgsNilQuery sig name motive cases indices scrut ctors rawT0)
        (inferIndgParamsArgsNilReadout sig motive cases indices scrut ctors rawT0) :=
    exprCtxMopsChain_to_kernel (gt := stdGroundings)
      (mopsChain_to_exprCtxMopsChain hrootMops)
  have hsubLift :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferIndgParamsArgsNilRules stdGroundings)
        (inferApplyArgsNilQuery sig rawT0) out := by
    simpa [kernelInferIndgParamsArgsNilRules] using
      (exprCtxKernelChain_append_left
        (atoms := kernelInferApplyArgsNilRules)
        (extra := [ruleInferIndgParamsDecl, ruleInferIndgParamsArgsNil])
        (gt := stdGroundings) hsubCore)
  have hinside :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferIndgParamsArgsNilRules stdGroundings)
        (inferIndgParamsArgsNilReadout sig motive cases indices scrut ctors rawT0)
        (inferIndgParamsArgsNilAfterApplyArgs sig motive cases indices scrut ctors out) := by
    simpa [inferIndgParamsArgsNilReadout, inferIndgParamsArgsNilAfterApplyArgs, mExpr] using
      (exprCtxKernelChain_at
        (rules := kernelInferIndgParamsArgsNilRules) (gt := stdGroundings)
        (pre := [mSym "let", mVar "T1"])
        (post :=
          [mExpr "if"
            [ mExpr "is-bad" [mVar "T1"]
            , mVar "T1"
            , inferIndgMotiveQuery sig motive cases indices scrut ctors (mVar "T1") ]])
        hsubLift)
  exact ⟨out, helperOut, helperCertified, nfRootOut, nfCertified,
    hhelperRun, hhelperAlpha, hhelperEq, hnfRun, hnfAlpha,
    hrootKernel.trans hinside⟩

