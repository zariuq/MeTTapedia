  let outBindings := restrictBnd outerScope
    ((Metta.Bindings.merge outerRetained innerOut).head?.getD innerOut)
  have hRootBndClosed : ClosedValueBindings rootBnd := by
    exact ClosedValueBindings.val hClosed hIncoming
  have hMergedRootClosed : ClosedValueBindings mergedRoot := by
    exact hIncoming.mergeHeadGetD hRootBndClosed
  have hOuterRetainedClosed : ClosedValueBindings outerRetained := by
    exact closedValueBindings_restrictBnd hMergedRootClosed
  have hOuterScope : outerScope = incoming.vars := by
    exact expectedApplicationRetentionScope_singleton_closed
