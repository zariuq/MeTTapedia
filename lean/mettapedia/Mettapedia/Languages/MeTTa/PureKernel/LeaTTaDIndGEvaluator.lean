private theorem mettaEval_zero_world
    (env : MinEnv) (st : St) (bnd0 : Metta.Bindings) (expr : Metta.Atom) :
    (mettaEval env 0 st bnd0 expr).2.world = st.world := by
  rw [Metta.Minimal.mettaEval.eq_1]

private theorem mettaEvalExpected_zero_world
    (env : MinEnv) (st : St) (bnd : Metta.Bindings)
    (a expected : Metta.Atom) :
    (mettaEvalExpected env 0 st bnd a expected).2.world = st.world := by
  have hOrdinary : (mettaEval env 0 st bnd a).2.world = st.world := by
    exact mettaEval_zero_world env st bnd a
  unfold mettaEvalExpected
  split
  · exact hOrdinary
  · dsimp only
    split
    · rfl
    · split
      · rfl
      · rw [prioritizeSemanticResults_snd]
        have hProjection
            (decision : Sum (List Metta.Atom) Metta.Bindings)
            (onRejected : List Metta.Atom → List (Metta.Atom × Metta.Bindings))
            (onAccepted : Metta.Bindings → List (Metta.Atom × Metta.Bindings)) :
            (match decision with
              | .inl rejected => (onRejected rejected, st)
              | .inr typedBindings => (onAccepted typedBindings, st)).2.world =
              st.world := by
          cases decision <;> rfl
        exact hProjection _ _ _

private theorem mettaEval_expr_arg_fold_zero_world
    (env : MinEnv) (st : St) (args : List Metta.Atom) (mask : List Bool) :
    (List.foldl
        (fun (acc : List (List Metta.Atom × Metta.Bindings) × St)
            (ae : Metta.Atom × Bool) =>
          List.foldl
            (fun (acc2 : List (List Metta.Atom × Metta.Bindings) × St)
                (part : List Metta.Atom × Metta.Bindings) =>
              if ae.2 = true then
                match mettaEval env 0 acc2.2 part.2 ae.1 with
                | (ps, st') =>
                    (acc2.1 ++
                        ps.map
                          (fun p =>
                            (part.1 ++ [p.1],
                              restrictBnd (args.flatMap Metta.Atom.vars)
                                ((Metta.Bindings.merge part.2 p.2).head?.getD p.2))),
                      st')
              else
                (acc2.1 ++
                    [(part.1 ++ [Metta.instantiate part.2 ae.1], part.2)],
                  acc2.2))
            ([], acc.2) acc.1)
        ([([], [])], st) (args.zip mask)).2.world =
      st.world := by
  apply foldl_state_world_eq
  intro acc ae
  apply foldl_state_world_eq
  intro acc2 part
  by_cases hArgEval : ae.2 = true
  · simp [hArgEval, mettaEval_zero_world]
  · simp [hArgEval]

private theorem mettaEval_expr_part_fold_zero_world
    (env : MinEnv) (queryVars : List String)
    (op : String) (args : List Metta.Atom) (bnd : Metta.Bindings) (returnAtom : Bool)
    (parts : List (List Metta.Atom × Metta.Bindings))
    (acc : List (Metta.Atom × Metta.Bindings) × St) :
    (parts.foldl (mettaEvalExprPartFoldStep env 0 queryVars op args bnd returnAtom) acc).2.world =
      acc.2.world := by
  apply foldl_state_world_eq
  intro acc0 part
  let P : St → Prop := fun st' => st'.world = acc0.2.world
  have hroot :
      ∀ (acc1 : List (Metta.Atom × Metta.Bindings) × St)
        (part1 : List Metta.Atom × Metta.Bindings),
        P acc1.2 →
          P (interpretFuel env (0 + 1) acc1.2
            [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
                Metta.Atom.expr (Metta.Atom.sym op :: part1.1)]) [], bnd := bnd }] []).2 := by
    intro acc1 part1 hP
    exact
      (interpretFuel_one_eval_world env acc1.2
        (Metta.Atom.expr (Metta.Atom.sym op :: part1.1)) bnd).trans hP
  have hrec :
      ∀ (partBnd : Metta.Bindings)
        (acc1 : List (Metta.Atom × Metta.Bindings) × St)
        (p : Metta.Atom × Metta.Bindings),
        P acc1.2 →
          P (mettaEval env 0 acc1.2
            (restrictBnd queryVars
              ((Metta.Bindings.merge partBnd p.2).head?.getD p.2))
            p.1).2 := by
    intro partBnd acc1 p hP
    exact
      (mettaEval_zero_world env acc1.2
        (restrictBnd queryVars
          ((Metta.Bindings.merge partBnd p.2).head?.getD p.2))
        p.1).trans hP
  exact
    mettaEvalExprPartFoldStep_preserves_state_pred_of_root_local
      env 0 queryVars op args bnd returnAtom P hroot hrec acc0 part rfl

private theorem mettaEval_bare_root_fold_zero_world
    (env : MinEnv) (w : Metta.Atom) (bnd0 : Metta.Bindings)
    (returnAtom : Bool)
    (pairs : List (Metta.Atom × Metta.Bindings))
    (acc : List (Metta.Atom × Metta.Bindings) × St) :
    (pairs.foldl
        (fun (a2 : List (Metta.Atom × Metta.Bindings) × St)
            (p : Metta.Atom × Metta.Bindings) =>
          if (p.1 == notReducibleA || p.1 == w) = true then
            (a2.1 ++ [(w, bnd0)], a2.2)
          else if returnAtom then
            (a2.1 ++ [p], a2.2)
          else
            match mettaEval env 0 a2.2 p.2 p.1 with
            | (more, st3) => (a2.1 ++ more, st3))
        acc).2.world = acc.2.world := by
  apply foldl_state_world_eq
  intro a2 p
  by_cases hFirst : (p.1 == notReducibleA || p.1 == w) = true
  · simp [hFirst]
  ·
    by_cases hReturns : returnAtom = true
    · simp [hFirst, hReturns]
    · simp [hFirst, hReturns, mettaEval_zero_world]

private theorem mettaEval_tuple_fold_zero_world
    (env : MinEnv) (whole : Metta.Atom)
    (pairs : List (Metta.Atom × Metta.Bindings))
    (acc : List (Metta.Atom × Metta.Bindings) × St) :
    (pairs.foldl
        (fun (a2 : List (Metta.Atom × Metta.Bindings) × St)
            (p : Metta.Atom × Metta.Bindings) =>
          if (p.1 == whole) = true then
            (a2.1 ++ [p], a2.2)
          else
            match mettaEval env 0 a2.2 p.2 p.1 with
            | (more, st') => (a2.1 ++ more, st'))
        acc).2.world = acc.2.world := by
  apply foldl_state_world_eq
  intro a2 p
  by_cases hSelf : (p.1 == whole) = true
  · simp [hSelf]
  · simp [hSelf, mettaEval_zero_world]

private theorem mettaEval_recursive_fold_zero_world
    (env : MinEnv) (pairs : List (Metta.Atom × Metta.Bindings))
    (acc : List (Metta.Atom × Metta.Bindings) × St) :
    (pairs.foldl
        (fun (a2 : List (Metta.Atom × Metta.Bindings) × St)
            (p : Metta.Atom × Metta.Bindings) =>
          match mettaEval env 0 a2.2 p.2 p.1 with
          | (more, st') => (a2.1 ++ more, st'))
        acc).2.world = acc.2.world := by
  apply foldl_state_world_eq
  intro a2 p
  simp [mettaEval_zero_world]

private theorem evaluateSelectedApplication_zero_world
    (env : MinEnv) (st : St) (bnd : Metta.Bindings)
    (op : String) (args : List Metta.Atom)
    (mask : List Bool) (returnAtom : Bool) :
    (evaluateSelectedApplication
        (fun nextSt nextBindings nextAtom =>
          mettaEval env 0 nextSt nextBindings nextAtom)
        (fun nextSt application =>
          interpretFuel env 1 nextSt
            [{ stack := atomToStack
                (Metta.Atom.expr [Metta.Atom.sym "eval", application]) [],
               bnd := bnd }] [])
        st op args mask returnAtom).2.world = st.world := by
  let queryVars := args.flatMap Metta.Atom.vars
  let argFold : List (List Metta.Atom × Metta.Bindings) × St :=
    List.foldl
      (fun (acc : List (List Metta.Atom × Metta.Bindings) × St)
          (ae : Metta.Atom × Bool) =>
        List.foldl
          (fun (acc2 : List (List Metta.Atom × Metta.Bindings) × St)
              (part : List Metta.Atom × Metta.Bindings) =>
            match firstChangedArgumentStop part.1 args with
            | some _ => (acc2.1 ++ [part], acc2.2)
            | none =>
                if ae.2 = true then
                  match mettaEval env 0 acc2.2 part.2 ae.1 with
                  | (ps, st') =>
                      (acc2.1 ++
                          ps.map
                            (fun p =>
                              (part.1 ++ [p.1],
                                restrictBnd queryVars
                                  ((Metta.Bindings.merge part.2 p.2).head?.getD p.2))),
                        st')
                else
                  (acc2.1 ++
                      [(part.1 ++ [Metta.instantiate part.2 ae.1], part.2)],
                    acc2.2))
          ([], acc.2) acc.1)
      ([([], [])], st) (args.zip mask)
  have hArgWorld : argFold.2.world = st.world := by
    apply foldl_state_world_eq
    intro acc ae
    apply foldl_state_world_eq
    intro acc2 part
    split
    · simp
    · by_cases hArgEval : ae.2 = true
      · simp [hArgEval, mettaEval_zero_world]
      · simp [hArgEval]
  simp only [evaluateSelectedApplication]
  change (List.foldl _ ([], argFold.2) argFold.1).2.world = st.world
  trans argFold.2.world
  · apply foldl_state_world_eq
    intro acc part
    split
    · simp
    · rename_i hNoError
      let application := Metta.Atom.expr (Metta.Atom.sym op :: part.1)
      cases hRoot :
          interpretFuel env 1 acc.2
            [{ stack := atomToStack
                (Metta.Atom.expr [Metta.Atom.sym "eval", application]) [],
               bnd := bnd }] [] with
      | mk pairs stRoot =>
          have hRootWorld : stRoot.world = acc.2.world := by
            have h := interpretFuel_one_eval_world env acc.2 application bnd
            rw [hRoot] at h
            exact h
          have hFoldWorld :
              (pairs.foldl
                (fun (inner : List (Metta.Atom × Metta.Bindings) × St) result =>
                  let retained := restrictBnd queryVars
                    ((Metta.Bindings.merge part.2 result.2).head?.getD result.2)
                  if result.1 == notReducibleA || result.1 == application then
                    (inner.1 ++ [(application, part.2)], inner.2)
                  else if returnAtom then
                    (inner.1 ++ [(result.1, retained)], inner.2)
                  else
                    let (more, st3) := mettaEval env 0 inner.2 retained result.1
                    (inner.1 ++ more.map (fun next =>
                      (next.1, restrictBnd queryVars
                        ((Metta.Bindings.merge retained next.2).head?.getD next.2))), st3))
                ([], stRoot)).2.world = stRoot.world := by
            apply foldl_state_world_eq
            intro inner result
            by_cases hKeep :
                (result.1 == notReducibleA || result.1 == application) = true
            · simp [hKeep]
            · by_cases hReturn : returnAtom = true
              · simp [hKeep, hReturn]
              · simp [hKeep, hReturn, mettaEval_zero_world]
          simpa [application, queryVars, hRoot] using
            hFoldWorld.trans hRootWorld
  · exact hArgWorld

private theorem evaluateExpectedApplication_zero_world
    (env : MinEnv) (st : St) (bnd : Metta.Bindings)
    (op : String) (args : List Metta.Atom)
    (selected : SelectedFunctionType) :
    (evaluateExpectedApplicationFrom
        (fun nextSt nextBindings nextAtom nextExpected =>
          mettaEvalExpected env 0 nextSt nextBindings nextAtom nextExpected)
        (fun nextSt application =>
          interpretFuel env 1 nextSt
            [{ stack := atomToStack
                (Metta.Atom.expr [Metta.Atom.sym "eval", application]) [],
               bnd := bnd }] [])
        bnd st op args selected).2.world = st.world := by
  let queryVars := expectedApplicationRetentionScope bnd args
  let policies := argumentEvaluationPolicies selected args.length
  let argFold : List (List Metta.Atom × Metta.Bindings) × St :=
    List.foldl
      (fun (acc : List (List Metta.Atom × Metta.Bindings) × St)
          (ae : Metta.Atom × (Bool × Metta.Atom)) =>
        List.foldl
          (fun (acc2 : List (List Metta.Atom × Metta.Bindings) × St)
              (part : List Metta.Atom × Metta.Bindings) =>
            match firstChangedArgumentStop part.1 args with
            | some _ => (acc2.1 ++ [part], acc2.2)
            | none =>
                if ae.2.1 = true then
                  match mettaEvalExpected env 0 acc2.2 part.2 ae.1 ae.2.2 with
                  | (ps, st') =>
                      (acc2.1 ++
                          ps.map
                            (fun p =>
                              (part.1 ++ [p.1],
                                restrictBnd queryVars
                                  ((Metta.Bindings.merge part.2 p.2).head?.getD p.2))),
                        st')
                else
                  (acc2.1 ++
                      [(part.1 ++ [Metta.instantiate part.2 ae.1], part.2)],
                    acc2.2))
          ([], acc.2) acc.1)
      ([([], bnd)], st) (args.zip policies)
  have hArgWorld : argFold.2.world = st.world := by
    apply foldl_state_world_eq
    intro acc ae
    apply foldl_state_world_eq
    intro acc2 part
    split
    · simp
    · by_cases hArgEval : ae.2.1 = true
      · simp [hArgEval, mettaEvalExpected_zero_world]
      · simp [hArgEval]
  simp only [evaluateExpectedApplicationFrom]
  change (List.foldl _ ([], argFold.2) argFold.1).2.world = st.world
  trans argFold.2.world
  · apply foldl_state_world_eq
    intro acc part
    split
    · simp
    · rename_i hNoError
      let application := Metta.Atom.expr (Metta.Atom.sym op :: part.1)
      cases hRoot :
          interpretFuel env 1 acc.2
            [{ stack := atomToStack
                (Metta.Atom.expr [Metta.Atom.sym "eval", application]) [],
               bnd := bnd }] [] with
      | mk pairs stRoot =>
          have hRootWorld : stRoot.world = acc.2.world := by
            have h := interpretFuel_one_eval_world env acc.2 application bnd
            rw [hRoot] at h
            exact h
          have hFoldWorld :
              (pairs.foldl
                (fun (inner : List (Metta.Atom × Metta.Bindings) × St) result =>
                  let retained := restrictBnd queryVars
                    ((Metta.Bindings.merge part.2 result.2).head?.getD result.2)
                  if result.1 == notReducibleA || result.1 == application then
                    (inner.1 ++ [(application, part.2)], inner.2)
                  else if returnsAtom selected then
                    (inner.1 ++ [(result.1, retained)], inner.2)
                  else
                    let (more, st3) :=
                      mettaEvalExpected env 0 inner.2 retained result.1
                        (selectedResultExpected selected)
                    (inner.1 ++ more.map (fun next =>
                      (next.1, restrictBnd queryVars
                        ((Metta.Bindings.merge retained next.2).head?.getD next.2))), st3))
                ([], stRoot)).2.world = stRoot.world := by
            apply foldl_state_world_eq
            intro inner result
            by_cases hKeep :
                (result.1 == notReducibleA || result.1 == application) = true
            · simp [hKeep]
            · by_cases hReturn : returnsAtom selected = true
              · simp [hKeep, hReturn]
              · simp [hKeep, hReturn, mettaEvalExpected_zero_world]
          simpa [application, queryVars, hRoot] using
            hFoldWorld.trans hRootWorld
  · exact hArgWorld

/-- A finite family of live applicability seeds preserves the world at fuel
zero.  The fold threads the counter/state order exactly; only the world
projection is invariant. -/
private theorem evaluateExpectedApplicationSeeds_zero_world
    (env : MinEnv) (st : St) (incoming : List Metta.Bindings)
    (op : String) (args : List Metta.Atom)
    (selected : SelectedFunctionType) :
    (evaluateExpectedApplicationSeeds
        (fun nextSt nextBindings nextAtom nextExpected =>
          mettaEvalExpected env 0 nextSt nextBindings nextAtom nextExpected)
        (fun bindings nextSt application =>
          interpretFuel env 1 nextSt
            [{ stack := atomToStack
                (Metta.Atom.expr [Metta.Atom.sym "eval", application]) [],
               bnd := bindings }] [])
        incoming st op args selected).2.world = st.world := by
  unfold evaluateExpectedApplicationSeeds
  apply foldl_state_world_eq
  intro acc bindings
  exact
    evaluateExpectedApplication_zero_world
      env acc.2 bindings op args selected

private theorem executeSelectedApplicationPlan_zero_world
    (env : MinEnv) (incoming : Metta.Bindings) (st : St)
    (op : String) (args : List Metta.Atom) (expected : Metta.Atom)
    (selected : SelectedFunctionType) :
    (executeSelectedApplicationPlan
        (fun nextSt nextBindings nextAtom nextExpected =>
          mettaEvalExpected env 0 nextSt nextBindings nextAtom nextExpected)
        (fun bindings nextSt application =>
          interpretFuel env 1 nextSt
            [{ stack := atomToStack
                (Metta.Atom.expr [Metta.Atom.sym "eval", application]) [],
               bnd := bindings }] [])
        env incoming st op args expected selected).2.world = st.world := by
  unfold executeSelectedApplicationPlan
  dsimp only
  split
  · rfl
  · exact
      evaluateExpectedApplicationSeeds_zero_world env st _ op args selected

private theorem executeApplicationPlan_zero_world
    (env : MinEnv) (incoming : Metta.Bindings) (st : St)
    (op : String) (args : List Metta.Atom) (expected : Metta.Atom) :
    (executeApplicationPlan
        (fun nextSt nextBindings nextAtom nextExpected =>
          mettaEvalExpected env 0 nextSt nextBindings nextAtom nextExpected)
        (fun bindings nextSt application =>
          interpretFuel env 1 nextSt
            [{ stack := atomToStack
                (Metta.Atom.expr [Metta.Atom.sym "eval", application]) [],
               bnd := bindings }] [])
        env incoming st op args expected).2.world = st.world := by
  unfold executeApplicationPlan
  dsimp only
  split
  · exact executeSelectedApplicationPlan_zero_world
      env incoming st op args expected _
  · split
    · exact evaluateExpectedApplication_zero_world
        env st incoming op args _
    · rfl

private theorem mettaEval_fuel_one_world
    (env : MinEnv) (st : St) (bnd0 : Metta.Bindings) (expr : Metta.Atom) :
    (mettaEval env 1 st bnd0 expr).2.world = st.world := by
  rw [Metta.Minimal.mettaEval.eq_2]
  split
  · rfl
  · rw [prioritizeSemanticResults_snd]
    split
    · rename_i _ op args _
      cases hSelect : selectFunctionType env st.world (Metta.Atom.sym op) args with
      | selected selected =>
          exact executeApplicationPlan_zero_world
            env bnd0 st op args (mSym "%Undefined%")
      | exhausted errors tupleEligible =>
          exact executeApplicationPlan_zero_world
            env bnd0 st op args (mSym "%Undefined%")
    · rename_i _ f args _ _
      let whole := Metta.Atom.expr (f :: args)
      cases hRoot :
          interpretFuel env 1 st
            [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", whole]) [],
               bnd := bnd0 }] [] with
      | mk ruleRes st1 =>
          have hRootWorld : st1.world = st.world := by
            have h := interpretFuel_one_eval_world env st whole bnd0
            rw [hRoot] at h
            exact h
          let reduced :=
            ruleRes.filter (fun p => p.1 != whole && p.1 != notReducibleA)
          by_cases hEmpty : reduced.isEmpty = true
          · cases hTuple :
              interpretFuel env 1 st1
                [{ stack :=
                    atomToStack
                      (Metta.Atom.expr
                        [Metta.Atom.sym "eval",
                          Metta.Atom.expr
                            [Metta.Atom.sym "interpret-tuple", whole, Metta.Atom.sym "&self"]])
                      [],
                   bnd := bnd0 }] [] with
            | mk tupleRes st2 =>
                have hTupleWorld : st2.world = st1.world := by
                  have h := interpretFuel_one_eval_world env st1
                    (Metta.Atom.expr
                      [Metta.Atom.sym "interpret-tuple", whole, Metta.Atom.sym "&self"])
                    bnd0
                  rw [hTuple] at h
                  exact h
                have hFoldWorld :
                    (tupleRes.foldl
                      (fun (a2 : List (Metta.Atom × Metta.Bindings) × St)
                          (p : Metta.Atom × Metta.Bindings) =>
                        if (p.1 == whole) = true then
                          (a2.1 ++ [p], a2.2)
                        else
                          match mettaEval env 0 a2.2 p.2 p.1 with
                          | (more, st') => (a2.1 ++ more, st'))
                      ([], st2)).2.world = st2.world :=
                  mettaEval_tuple_fold_zero_world env whole tupleRes ([], st2)
                simpa [whole, hRoot, reduced, hEmpty, hTuple] using
                  (hFoldWorld.trans (hTupleWorld.trans hRootWorld))
          · have hFoldWorld :
                (reduced.foldl
                  (fun (a2 : List (Metta.Atom × Metta.Bindings) × St)
                      (p : Metta.Atom × Metta.Bindings) =>
                    match mettaEval env 0 a2.2 p.2 p.1 with
                    | (more, st') => (a2.1 ++ more, st'))
                  ([], st1)).2.world = st1.world :=
              mettaEval_recursive_fold_zero_world env reduced ([], st1)
            simpa [whole, hRoot, reduced, hEmpty] using
              (hFoldWorld.trans hRootWorld)
    · rfl

private theorem mettaEval_zero_true_pair_false
    {env : MinEnv} {st : St} {bnd0 : Metta.Bindings}
    {expr : Metta.Atom} {outBnd : Metta.Bindings}
    (h : (mBool true, outBnd) ∈ (mettaEval env 0 st bnd0 expr).1) :
    False := by
  rw [Metta.Minimal.mettaEval.eq_1] at h
  simp [mBool] at h

private theorem mettaEval_zero_output_isError
    {env : MinEnv} {st : St} {bnd0 : Metta.Bindings}
    {expr out : Metta.Atom}
    (h : out ∈ (mettaEval env 0 st bnd0 expr).1.map (·.1)) :
    out.isError = true := by
  rw [Metta.Minimal.mettaEval.eq_1] at h
  simp only [List.map_cons, List.map_nil, List.mem_singleton] at h
  subst out
  rfl

private theorem mettaEvalExprRootFold_bnd_nil_of_queryVars_nil
    (env : MinEnv) (fuel : Nat) (w : Metta.Atom)
    (returnAtom : Bool)
    (pairs : List (Metta.Atom × Metta.Bindings))
    (acc : List (Metta.Atom × Metta.Bindings) × St)
    {out : Metta.Atom} {outBnd : Metta.Bindings}
    (hAcc : ∀ p ∈ acc.1, p.2 = [])
    (hmem :
      (out, outBnd) ∈
        (pairs.foldl
          (fun a2 p =>
            if (p.1 == notReducibleA) = true ∨ (p.1 == w) = true then
              (a2.1 ++ [(w, [])], a2.2)
            else if returnAtom then
              (a2.1 ++ [(p.1, [])], a2.2)
            else
              (a2.1 ++
                  (mettaEval env fuel a2.2 [] p.1).1.map
                    (fun m => (m.1, ([] : Metta.Bindings))),
                (mettaEval env fuel a2.2 [] p.1).2))
          acc).1) :
    outBnd = [] := by
  induction pairs generalizing acc with
  | nil =>
      exact hAcc (out, outBnd) hmem
  | cons p ps ih =>
      exact
        ih
          (acc :=
            if (p.1 == notReducibleA) = true ∨ (p.1 == w) = true then
              (acc.1 ++ [(w, [])], acc.2)
            else if returnAtom then
              (acc.1 ++ [(p.1, [])], acc.2)
            else
              (acc.1 ++
                  (mettaEval env fuel acc.2 [] p.1).1.map
                    (fun m => (m.1, ([] : Metta.Bindings))),
                (mettaEval env fuel acc.2 [] p.1).2))
          (by
            intro q hq
            by_cases hfirst :
                (p.1 == notReducibleA) = true ∨ (p.1 == w) = true
            · simp [hfirst] at hq
              rcases hq with hq | hq
              · exact hAcc q hq
              · rcases hq with rfl
                rfl
            · simp [hfirst] at hq
              by_cases hret : returnAtom = true
              · simp [hret] at hq
                rcases hq with hq | hq
                · exact hAcc q hq
                · rcases hq with rfl
                  rfl
              · simp [hret] at hq
                rcases hq with hq | hq
                · exact hAcc q hq
                · rcases hq with ⟨m, _hm, hqEq⟩
                  cases hqEq
                  rfl)
          hmem

private theorem mettaEval_kernelDefControlEnv_nfQuery_pair_bnd_nil
    (fuel : Nat) (st : St) (sig : DIndGArtifactSig)
    (raw : DIndGArtifactTerm) (hTypes : KernelDefControlEnvTypeWorld st.world)
    {out : Metta.Atom}
    {outBnd : Metta.Bindings}
    (hmem :
      (out, outBnd) ∈
        (mettaEval kernelDefControlEnv fuel st []
          (nfQuery sig raw)).1) :
    outBnd = [] := by
  cases fuel with
  | zero =>
      rw [Metta.Minimal.mettaEval.eq_1] at hmem
      simp at hmem
      exact hmem.2
  | succ fuel =>
      let w := nfQuery sig raw
      let qvars := ([sigAtom sig, termAtom raw]).flatMap Metta.Atom.vars
      change
        (out, outBnd) ∈
          (mettaEval kernelDefControlEnv (fuel + 1) st []
            (Metta.Atom.expr
              [Metta.Atom.sym "nf", sigAtom sig, termAtom raw])).1 at hmem
      rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
        kernelDefControlEnv fuel st "nf" [sigAtom sig, termAtom raw]
        [false, false] false
        (kernelDefControlEnv_nf_recursionNeutralPolicy st (sigAtom sig) (termAtom raw) hTypes.nf)
        (by simp [Metta.Atom.isError])] at hmem
      have hmem := mem_of_mem_prioritizeSemanticResults hmem
      simp [evaluateSelectedApplication, Metta.instantiate_nil,
        sigAtom_isError_false, termAtom_isError_false] at hmem
      let rootItem : Item :=
        { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", w]) []
          bnd := [] }
      cases hpairs : interpretFuel kernelDefControlEnv (fuel + 1) st [rootItem] [] with
      | mk pairs stRoot =>
          have hpairsLit :
              interpretFuel kernelDefControlEnv (fuel + 1) st
                  [{ stack := atomToStack
                      (Metta.Atom.expr
                        [ Metta.Atom.sym "eval"
                        , Metta.Atom.expr
                            [Metta.Atom.sym "nf", sigAtom sig, termAtom raw] ]) []
                     bnd := [] }] [] =
                (pairs, stRoot) := by
            simpa [rootItem, w, nfQuery, mExpr, mSym] using hpairs
          rw [hpairsLit] at hmem
          have hqvars :
              (sigAtom sig).vars ++ (termAtom raw).vars = [] := by
            simp [sigAtom_vars_nil sig, termAtom_vars_nil raw]
          rw [hqvars] at hmem
          simp [restrictBnd_nil_vars] at hmem
          exact
            mettaEvalExprRootFold_bnd_nil_of_queryVars_nil
              kernelDefControlEnv fuel w false pairs ([], stRoot)
              (by intro p hp; cases hp)
              (by simpa [w, nfQuery, mExpr, mSym] using hmem)

private theorem mettaEval_kernelDefControlEnv_nfQuery_fuel_one_output_isError_or_self
    (st : St) (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm)
    (hTypes : KernelDefControlEnvTypeWorld st.world)
    {out : Metta.Atom} {outBnd : Metta.Bindings}
    (hmem :
      (out, outBnd) ∈
        (mettaEval kernelDefControlEnv 1 st [] (nfQuery sig raw)).1) :
    out.isError = true ∨ out = nfQuery sig raw := by
  let w := nfQuery sig raw
  let qvars := ([sigAtom sig, termAtom raw]).flatMap Metta.Atom.vars
  change
    (out, outBnd) ∈
      (mettaEval kernelDefControlEnv 1 st []
        (Metta.Atom.expr
          [Metta.Atom.sym "nf", sigAtom sig, termAtom raw])).1 at hmem
  rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
    kernelDefControlEnv 0 st "nf" [sigAtom sig, termAtom raw]
    [false, false] false
    (kernelDefControlEnv_nf_recursionNeutralPolicy st (sigAtom sig) (termAtom raw) hTypes.nf)
    (by simp [Metta.Atom.isError])] at hmem
  have hmem := mem_of_mem_prioritizeSemanticResults hmem
  simp [evaluateSelectedApplication, Metta.instantiate_nil,
    sigAtom_isError_false, termAtom_isError_false] at hmem
  let rootItem : Item :=
    { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", w]) []
      bnd := [] }
  cases hpairs : interpretFuel kernelDefControlEnv 1 st [rootItem] [] with
  | mk pairs stRoot =>
      have hfold :
          (out, outBnd) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelDefControlEnv 0 qvars w [] false)
              ([], stRoot)).1 := by
        have hpairsLit :
            interpretFuel kernelDefControlEnv 1 st
                [{ stack := atomToStack
                    (Metta.Atom.expr
                      [ Metta.Atom.sym "eval"
                      , Metta.Atom.expr
                          [Metta.Atom.sym "nf", sigAtom sig, termAtom raw] ]) []
                   bnd := [] }] [] =
              (pairs, stRoot) := by
          simpa [rootItem, w, nfQuery, mExpr, mSym] using hpairs
        rw [hpairsLit] at hmem
        have hrootEq :
            mettaEvalExprRootFoldStep kernelDefControlEnv 0 qvars w [] false =
              (fun a2 p =>
                if (p.1 == notReducibleA) = true ∨
                    (p.1 == w) = true then
                  (a2.1 ++ [(w, [])], a2.2)
                else if
                    false = true then
                  (a2.1 ++
                    [(p.1,
                      restrictBnd qvars
                        ((Metta.Bindings.merge [] p.2).head?.getD p.2))],
                    a2.2)
                else
