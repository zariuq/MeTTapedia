  rw [candidatesW_eq_candidates_of_no_selfExtra
    kernelDefControlEnv st.world target hStatic]
  rw [hCand]
  simp only [List.foldl_cons, List.foldl_nil]
  change
    (if ((([] ++ queryOpItemsOfRule [] target [] st.counter ifTrueRulePair) ++
