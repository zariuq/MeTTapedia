/-- Declaration-calculus App case. Once the runtime readout has been absorbed
into the declarative `MettaCall` relation, the recursive `infer` hypotheses for
the function and argument are consumed here. -/
theorem infer_sound_app_decl_case
    {sig : DIndGArtifactSig}
    {fn arg argType : PureTm 0} {bodyType : PureTm 1}
    (hFnSound :
      HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil fn (.pi argType bodyType))
    (hArgSound :
      HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil arg argType) :
    HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil (.app fn arg) (inst0 arg bodyType) := by
  exact HasTypeDecl.app_elim hFnSound hArgSound

/-- App-case IH combiner. After the future runtime-readout absorption theorem
turns sub-`infer` calls into soundness hypotheses for the function and argument,
this lemma consumes the translated raw App and produces the declaration typing
witness for the translated application. -/
theorem infer_sound_app_decl_case_of_translation
    {sig : DIndGArtifactSig}
    {rawFn rawArg : DIndGArtifactTerm} {term : PureTm 0}
    {argType : PureTm 0} {bodyType : PureTm 1}
    (hAppTr :
      DIndGArtifactTermTranslates sig.nameTranslates 0 (.app rawFn rawArg) term)
    (hFnSound :
      ∀ {fn : PureTm 0},
        DIndGArtifactTermTranslates sig.nameTranslates 0 rawFn fn →
          HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil fn (.pi argType bodyType))
    (hArgSound :
      ∀ {arg : PureTm 0},
        DIndGArtifactTermTranslates sig.nameTranslates 0 rawArg arg →
          HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil arg argType) :
    ∃ fn arg : PureTm 0,
      term = .app fn arg ∧
        HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil term (inst0 arg bodyType) := by
  rcases DIndGArtifactTermTranslates.app_inv hAppTr with
    ⟨fn, arg, rfl, hFnTr, hArgTr⟩
  exact ⟨fn, arg, rfl,
    infer_sound_app_decl_case (sig := sig) (hFnSound hFnTr) (hArgSound hArgTr)⟩

/-- A first closed kernel soundness fact for SR-2b: LeaTTa/MOPS fires the
kernel's `infer (Srt type)` rule on the real Stage-3 artifact signature, and
the resulting readout is consumed by the declaration-calculus derivation
`Srt type : Srt kind`. -/
theorem infer_srt_type_mops_sound :
    Metta.MopsStep kernelCoreRules
      (inferQuery cicStage3RawArtifactSig (.srt .type))
      (termAtom (.srt .kind)) ∧
    HasTypeDecl (envOfSpecs cicStage3RawArtifactSig.translatedSpecs) .nil .u0 .u1 := by
  exact ⟨infer_srt_type_mops_step, infer_srt_type_decl_sound⟩

/-- Corollary of `infer_sound_srt` for the concrete runtime readout. -/
theorem infer_srt_type_core_eval_sound :
    termAtom (.srt .kind) ∈
        (mettaEval kernelCoreEnv 1 St.init []
          (inferQuery cicStage3RawArtifactSig (.srt .type))).1.map (·.1) ∧
      HasTypeDecl (envOfSpecs cicStage3RawArtifactSig.translatedSpecs) .nil .u0 .u1 := by
  constructor
  · rw [infer_srt_type_core_mettaEval_readout]
