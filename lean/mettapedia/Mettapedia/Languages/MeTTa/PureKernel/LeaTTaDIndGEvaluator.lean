  have hmem :=
    interpretFuel_selected_rule_contains_from_of_env kernelDefControlEnv
      (fuel := fuel) (st := st) (target := nfQuery sig (.srt sort))
      (lhs := lhs) (rhs := rhs) (coreB := coreB) (incoming := incoming)
      (op := "nf") (args := [sigAtom sig, termAtom (.srt sort)])
      (pre := [nfVarRulePair])
