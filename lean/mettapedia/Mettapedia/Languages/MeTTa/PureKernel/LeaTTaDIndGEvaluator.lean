private theorem queryOpItems_nf_def_eq
    (counter : Nat) (sig : DIndGArtifactSig)
    (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
    Metta.Minimal.queryOpItemsOfRule [] (nfQuery sig (.defn name)) [] counter nfDefRulePair =
      [evalResult []
        (Metta.instantiate
          (renameBindings (counterSuffix counter)
            (nfDefRuleBindings sig name)).reverse
          (freshenRule counter nfDefRuleLhs nfDefRuleRhs).2)
        ((renameBindings (counterSuffix counter)
          (nfDefRuleBindings sig name)).reverse)] := by
  let coreB : Metta.Bindings := nfDefRuleBindings sig name
  let f := counterSuffix counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  let root : Metta.Atom := Metta.instantiate m
    (freshenRule counter nfDefRuleLhs nfDefRuleRhs).2
  have hf : Function.Injective f := by
    simpa [f] using counterSuffix_injective counter
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (declNameAtom_vars_nil name)
      (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    dsimp [coreB, nfDefRuleBindings, bindingValueKeys]
    decide
  have hmatch :
      Metta.matchAtoms
          (freshenRule counter nfDefRuleLhs nfDefRuleRhs).1
          (nfQuery sig (.defn name)) =
        [renameBindings f coreB] := by
    simpa [f, coreB] using fresh_nf_def_rule_match counter sig name
  have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
    ClosedValueBindings.rename hclosedB
  have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
    rw [bindingValueKeys_renameBindings]
    exact List.Nodup.map hf hnodup
  have hmerge : Metta.Bindings.merge [] (renameBindings f coreB) = [m] := by
    simpa [m] using
      (merge_closed_noConflict_eq hclosedRen hnodupRen ClosedValueBindings.nil
        (by intro x hx hmem; cases hmem))
  have hclosedM : ClosedValueBindings m := by
    simpa [m] using ClosedValueBindings.reverse hclosedRen
  have hloop : Metta.Bindings.hasLoop m = false := by
    simpa [m] using ClosedValueBindings.hasLoop_false hclosedM
  rw [queryOpItemsOfRule_eq_legacy_of_target_vars_nil counter
    (nfQuery sig (.defn name)) nfDefRulePair (nfQuery_vars_nil sig (.defn name))]
  simp [nfDefRulePair, hmatch, hmerge, hloop, m, f, coreB]

private theorem fresh_nf_ctor_mismatch_match_nil
    (f : String → String) (sig : DIndGArtifactSig)
    (ctor : String) (args : List Metta.Atom)
    (targetCtor : String) (targetArgs : List Metta.Atom)
    (hctor : ctor ≠ targetCtor) :
    Metta.matchAtoms
        (mExpr "nf" [mVar (f "sig"), mExpr ctor args])
        (mExpr "nf" [sigAtom sig, mExpr targetCtor targetArgs]) = [] := by
  have hmatchAllNil : ∀ xs ys,
      Metta.matchAll none [] xs ys = ([] : List Metta.Bindings) := by
    intro xs
    induction xs with
    | nil => intro ys; cases ys <;> rfl
    | cons x xs ih =>
        intro ys
        cases ys with
        | nil => rfl
        | cons y ys => simpa [Metta.matchAll] using ih ys
  have hctorMismatch :
      Metta.matchAtomsWith none (mExpr ctor args)
        (mExpr targetCtor targetArgs) = [] := by
    simp [mExpr, mSym, Metta.matchAll, Metta.matchAtomsWith,
      Metta.Bindings.merge, hctor]
    exact hmatchAllNil args targetArgs
  have hflat : ∀ xs : List Metta.Bindings,
      xs.flatMap (fun _ => ([] : List Metta.Bindings)) = [] := by
    intro xs
    induction xs <;> simp_all
  unfold Metta.matchAtoms
  have hraw :
      Metta.matchAtomsWith none
          (mExpr "nf" [mVar (f "sig"), mExpr ctor args])
          (mExpr "nf" [sigAtom sig, mExpr targetCtor targetArgs]) = [] := by
    simp only [Metta.matchAtomsWith, mExpr, mSym, mVar]
    unfold Metta.matchAll
    simp [Metta.matchAtomsWith, Metta.Bindings.merge]
    unfold Metta.matchAll
    change Metta.matchAll none _
      [mExpr ctor args] [mExpr targetCtor targetArgs] = []
    unfold Metta.matchAll
    rw [hctorMismatch]
    simp only [List.flatMap_nil]
    change List.flatMap (fun _ : Metta.Bindings => []) _ = []
    apply hflat
  rw [hraw]
  rfl

/-- Exact one-candidate query readout under a live incoming theory.

This is the data-preserving counterpart of the mismatch lemmas below: once
freshening, matching, and merging have been characterized by equations, the
runtime query item is determined literally, including the retained incoming
bindings.  Keeping this assembly independent of any particular `nf`
constructor prevents each leaf proof from unfolding the executable again. -/
private theorem queryOpItemsOfRule_eq_singleton_from
    (counter : Nat) (target : Metta.Atom) (incoming : Metta.Bindings)
    (rule : Metta.Atom × Metta.Atom) (lhs rhs : Metta.Atom)
    (matched merged : Metta.Bindings) (out : Metta.Atom)
    (hcompat :
      LegacyFresheningCompatible [] target incoming counter rule.1 rule.2)
    (hfresh : freshenRule counter rule.1 rule.2 = (lhs, rhs))
    (hmatch : Metta.matchAtoms lhs target = [matched])
    (hmerge : Metta.Bindings.merge incoming matched = [merged])
    (hloop : Metta.Bindings.hasLoop merged = false)
    (hinst : Metta.instantiate merged rhs = out) :
    Metta.Minimal.queryOpItemsOfRule [] target incoming counter rule =
      [evalResult [] out merged] := by
  have hFreshAvoiding :
      (freshenRuleAvoiding counter
        (Metta.Minimal.queryOpAvoid [] target incoming) rule.1 rule.2).1 =
        (lhs, rhs) := by
    rw [hcompat]
    exact hfresh
  unfold Metta.Minimal.queryOpItemsOfRule
  simp only [hFreshAvoiding]
  rw [hmatch]
  simp [hmerge, hloop, hinst]

/-- Constructor-mismatched `nf` candidates contribute no query item under any
live incoming binding.  The proof covers both executable freshening branches
directly, so it does not assume that the legacy counter suffix avoids the
incoming theory. -/
private theorem queryOpItems_nf_ctor_mismatch_eq_nil_from
    (counter : Nat) (sig : DIndGArtifactSig)
    (targetCtor : String) (targetArgs : List Metta.Atom)
    (incoming : Metta.Bindings)
    (ctor : String) (ctorArgs : List Metta.Atom) (rhs : Metta.Atom)
    (hctor : ctor ≠ targetCtor) :
    Metta.Minimal.queryOpItemsOfRule []
        (mExpr "nf" [sigAtom sig, mExpr targetCtor targetArgs]) incoming counter
        (mExpr "nf" [mVar "sig", mExpr ctor ctorArgs], rhs) = [] := by
  let target := mExpr "nf" [sigAtom sig, mExpr targetCtor targetArgs]
  let avoid := Metta.Minimal.queryOpAvoid [] target incoming
  by_cases hcollision :
      ∃ v ∈
          (freshenRule counter
            (mExpr "nf" [mVar "sig", mExpr ctor ctorArgs]) rhs).1.vars ++
          (freshenRule counter
            (mExpr "nf" [mVar "sig", mExpr ctor ctorArgs]) rhs).2.vars,
        v ∈ avoid
  · have hmatch :
        Metta.matchAtoms
            (mExpr "nf"
              [mVar (captureAvoidingName avoid counter "sig"),
                mExpr ctor
                  (ctorArgs.map
                    (renameAllVars (captureAvoidingName avoid counter)))])
            target = [] := by
      simpa [target] using
        fresh_nf_ctor_mismatch_match_nil
          (captureAvoidingName avoid counter) sig ctor
          (ctorArgs.map (renameAllVars (captureAvoidingName avoid counter)))
          targetCtor targetArgs hctor
    unfold Metta.Minimal.queryOpItemsOfRule
    rw [show
      freshenRuleAvoiding counter avoid
          (mExpr "nf" [mVar "sig", mExpr ctor ctorArgs]) rhs =
        ((renameAllVars (captureAvoidingName avoid counter)
            (mExpr "nf" [mVar "sig", mExpr ctor ctorArgs]),
          renameAllVars (captureAvoidingName avoid counter) rhs),
          counter + 1) by
        rw [freshenRuleAvoiding, if_pos hcollision]]
    change
      (Metta.matchAtoms
          (renameAllVars (captureAvoidingName avoid counter)
            (mExpr "nf" [mVar "sig", mExpr ctor ctorArgs])) target).flatMap _ = []
    rw [show renameAllVars (captureAvoidingName avoid counter)
          (mExpr "nf" [mVar "sig", mExpr ctor ctorArgs]) =
        mExpr "nf"
          [mVar (captureAvoidingName avoid counter "sig"),
            mExpr ctor
              (ctorArgs.map
                (renameAllVars (captureAvoidingName avoid counter)))] by
      simp [renameAllVars, mExpr, mSym, mVar]]
    rw [hmatch]
    rfl
  · have hmatch :
        Metta.matchAtoms
            (mExpr "nf"
              [mVar (counterSuffix counter "sig"),
                mExpr ctor
                  (ctorArgs.map
                    (Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy
                      (counterSuffix counter)))])
            target = [] := by
      simpa [target] using
        fresh_nf_ctor_mismatch_match_nil
          (counterSuffix counter) sig ctor
          (ctorArgs.map
            (Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy
              (counterSuffix counter)))
          targetCtor targetArgs hctor
    unfold Metta.Minimal.queryOpItemsOfRule
    rw [freshenRuleAvoiding_eq_legacy counter avoid
      (mExpr "nf" [mVar "sig", mExpr ctor ctorArgs]) rhs hcollision]
    rw [freshenRule_eq_renBy]
    change
      (Metta.matchAtoms
          (Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy
            (counterSuffix counter)
            (mExpr "nf" [mVar "sig", mExpr ctor ctorArgs])) target).flatMap _ = []
    rw [show Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy
          (counterSuffix counter)
          (mExpr "nf" [mVar "sig", mExpr ctor ctorArgs]) =
        mExpr "nf"
          [mVar (counterSuffix counter "sig"),
            mExpr ctor
              (ctorArgs.map
                (Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy
                  (counterSuffix counter)))] by
      simp [Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
        mExpr, mSym, mVar]]
    rw [hmatch]
    rfl

/-- `Srt` specialization retained for the exact `nf Srt` scan. -/
private theorem queryOpItems_nf_ctor_on_srt_eq_nil_from
