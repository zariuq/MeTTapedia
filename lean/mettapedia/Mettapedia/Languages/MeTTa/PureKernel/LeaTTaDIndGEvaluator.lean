  | srt sort =>
      cases sort <;> cases hL <;> cases hR <;> rfl
  | witnessDefn =>
      rcases cicStage3RawDefnTranslatesWithPropToType0Witness_raw_cases
          hL with
        ⟨leanLeft, hTermLeft, hNameLeft, _hCasesLeft⟩
      rcases cicStage3RawDefnTranslatesWithPropToType0Witness_raw_cases
          hR with
