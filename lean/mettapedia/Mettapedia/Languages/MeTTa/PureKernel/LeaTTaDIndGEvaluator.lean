        Metta.BindingRel.val "a" (termAtom rawArg),
        Metta.BindingRel.val "s" (termAtom replacement),
        Metta.BindingRel.val "j" (mNat index)], ?_, ?_⟩
    · rw [subst_app_dispatch_rule_match]
