/-- The published whole-row no-error premise supplies every prefix guard used
by the repaired left-to-right quoted-argument worker. -/
private theorem embeddedUnifyQuoted_arguments_not_changed
    (binder : String) (atom template : Metta.Atom)
    (hNoErr :
      (([atom, mVar binder, template, mSym "Empty"].zip
          [atom, mVar binder, template, mSym "Empty"]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none) :
    (¬ (((atom == emptyA) = true ∨ atom.isError = true) ∧ (atom != atom) = true)) ∧
    (¬ ((((mVar binder) == emptyA) = true ∨ (mVar binder).isError = true) ∧ (mVar binder != mVar binder) = true)) ∧
    (¬ (((template == emptyA) = true ∨ template.isError = true) ∧ (template != template) = true)) ∧
    (¬ ((((Atom.sym "Empty") == emptyA) = true ∨
        (Atom.sym "Empty").isError = true) ∧
      (Atom.sym "Empty" != Atom.sym "Empty") = true)) := by
  refine ⟨argument_not_changed_terminal_of_mem_zip
      (result := atom) (original := atom) hNoErr (by simp), ?_⟩
  refine ⟨argument_not_changed_terminal_of_mem_zip
      (result := mVar binder) (original := mVar binder) hNoErr (by simp), ?_⟩
  refine ⟨argument_not_changed_terminal_of_mem_zip
      (result := template) (original := template) hNoErr (by simp), ?_⟩
  exact argument_not_changed_terminal_of_mem_zip
    (result := Atom.sym "Empty") (original := Atom.sym "Empty") hNoErr (by simp [mSym])

