/-- Def-control-runtime lift for embedded `unify` success with the local signature facts
discharged.

The remaining hypotheses are the semantic obligations for the caller: the
quoted arguments did not create an error, the matched atom is a non-looping
variable success case, and the instantiated template recursively evaluates to
the requested final atom. -/
theorem mettaEval_kernelDefControlEnv_embedded_unify_var_success_of_quoted_args
    (fuel : Nat) (st : St)
    (binder : String) (atom template final : Metta.Atom)
    (hNoErr :
      (([atom, mVar binder, template, mSym "Empty"].zip
          [atom, mVar binder, template, mSym "Empty"]).find?
        (fun ho => ho.1.isError && ho.1 != ho.2)) = none)
    (hAtomNonVar : ∀ w, atom ≠ Metta.Atom.var w)
    (hNoLoop : binder ∉ atom.vars)
    (hRootNotNotReducible :
      (Metta.instantiate [Metta.BindingRel.val binder atom]
        (Metta.instantiate [Metta.BindingRel.val binder atom] template) == notReducibleA) = false)
    (hRootNotSelf :
