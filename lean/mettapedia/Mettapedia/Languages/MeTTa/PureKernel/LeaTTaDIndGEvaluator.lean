theorem mettaEval_kernelDefControlEnv_embedded_unify_fallback_false_eq
    (fuel : Nat) (st : St)
    (atom pattern template : Metta.Atom)
    (hExtra : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hTypes : KernelDefControlEnvTypeWorld st.world)
    (hNoErr :
      (([atom, pattern, template, mBool false].zip
          [atom, pattern, template, mBool false]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hmatch : Metta.matchAtoms atom pattern = [])
    (hRootNotSelf :
      (mBool false == mExpr "unify" [atom, pattern, template, mBool false]) = false) :
    mettaEval kernelDefControlEnv (fuel + 2) st [] (mExpr "unify" [atom, pattern, template, mBool false]) =
      ([(mBool false, [])], st) := by
  change mettaEval kernelDefControlEnv (fuel + 2) st []
      (Metta.Atom.expr [Metta.Atom.sym "unify", atom, pattern, template, mBool false]) =
    ([(mBool false, [])], st)
  rw [show fuel + 2 = (fuel + 1) + 1 by omega]
  rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
    kernelDefControlEnv (fuel + 1) st "unify"
    [atom, pattern, template, mBool false] [false, false, false, false] false
    (kernelDefControlEnv_unify_recursionNeutralPolicy st atom pattern template (mBool false)
      hTypes.unify) (by simp [Metta.Atom.isError])]
  simp only [evaluateSelectedApplication, firstChangedArgumentStop,
    List.zip_cons_cons, List.zip_nil_right,
    List.foldl_cons, List.foldl_nil]
  have hAtomNotChanged : ¬ (((atom == emptyA) = true ∨ atom.isError = true) ∧ (atom != atom) = true) :=
    argument_not_changed_terminal_of_mem_zip
      (result := atom) (original := atom) hNoErr (by simp)
  have hPatternNotChanged :
      ¬ (((pattern == emptyA) = true ∨ pattern.isError = true) ∧ (pattern != pattern) = true) :=
    argument_not_changed_terminal_of_mem_zip
      (result := pattern) (original := pattern) hNoErr (by simp)
  have hTemplateNotChanged :
      ¬ (((template == emptyA) = true ∨ template.isError = true) ∧ (template != template) = true) :=
    argument_not_changed_terminal_of_mem_zip
      (result := template) (original := template) hNoErr (by simp)
  have hElseNotChanged :
      ¬ ((((mBool false) == emptyA) = true ∨ (mBool false).isError = true) ∧ (mBool false != mBool false) = true) :=
    argument_not_changed_terminal_of_mem_zip
      (result := mBool false) (original := mBool false) hNoErr (by simp)
  simp [Metta.instantiate_nil, hAtomNotChanged, hPatternNotChanged,
    hTemplateNotChanged, hElseNotChanged]
  have hroot :
      interpretFuel kernelDefControlEnv (fuel + 2) st
          [evalItemNil (mExpr "unify" [atom, pattern, template, mBool false])] [] =
        ([(mBool false, [])], st) := by
    simpa using
      (interpretFuel_eval_embedded_unify_fallback_eq_of_gt
        kernelDefControlEnv fuel st atom pattern template (mBool false) (by rfl) hmatch
          (mBool_ne_empty false))
  have hrootDirect :
      interpretFuel kernelDefControlEnv (fuel + 2) st
          [{ stack := atomToStack
              (Atom.expr [Atom.sym "eval",
                Atom.expr [Atom.sym "unify", atom, pattern, template, mBool false]]) [],
             bnd := [] }] [] =
        ([(mBool false, [])], st) := by
    simpa [evalItemNil, mExpr, mSym] using hroot
  rw [hrootDirect]
  have hBndEmpty :
      restrictBnd (atom.vars ++ (pattern.vars ++ (template.vars ++ (mBool false).vars)))
          ((Bindings.merge [] ([] : Bindings)).head?.getD []) = [] := by
    simpa using
      restrictBnd_empty_merge_empty
        (atom.vars ++ (pattern.vars ++ (template.vars ++ (mBool false).vars)))
  simp [List.foldl]
  rw [hBndEmpty]
  rw [mettaEval_kernelDefControlEnv_mBool_eq_state fuel st false hExtra hImports]
  have hRootNotNotReducible :
      (Metta.Atom.gnd (Ground.bool false) == Metta.Atom.sym "NotReducible") = false := by
    rfl
  have hRootNotSelf' :
      (Metta.Atom.gnd (Ground.bool false) ==
        Metta.Atom.expr [Metta.Atom.sym "unify", atom, pattern, template,
          Metta.Atom.gnd (Ground.bool false)]) = false := by
    simpa [mBool, mExpr, mSym] using hRootNotSelf
  simp [notReducibleA, mBool, restrictBnd_empty_merge_empty,
    hRootNotNotReducible, hRootNotSelf']

/-- Def-control `unify` has a wildcard return type, so its ordinary and expected-`Bool`
application scans select the same complete policy. -/
theorem mettaEvalExpected_kernelDefControlEnv_unify_bool_eq_mettaEval
    (fuel : Nat) (st : St)
    (atom pattern template elseAtom : Metta.Atom)
    (hTypes : KernelDefControlEnvTypeWorld st.world) :
    mettaEvalExpected kernelDefControlEnv (fuel + 1) st []
        (mExpr "unify" [atom, pattern, template, elseAtom]) (mSym "Bool") =
      mettaEval kernelDefControlEnv (fuel + 1) st []
        (mExpr "unify" [atom, pattern, template, elseAtom]) := by
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->"
        [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom", mSym "%Undefined%"]
      argumentTypes := [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]
      returnType := mSym "%Undefined%"
      typeBindings := [] }
  have hCheck : typeCheckArgsOutcome kernelDefControlEnv st.world
      [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"] 0 []
      [atom, pattern, template, elseAtom] = .success [] := by
    simpa [mSym] using
      typeCheckArgsOutcome_four_atoms kernelDefControlEnv st.world
        atom pattern template elseAtom
  have hExpectedDetailed : typeCheckArgsDetailedOutcomeScoped
      kernelDefControlEnv st.world
      [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"]
      (applicationTypeInferenceScope (.sym "Bool")
        [atom, pattern, template, elseAtom]) 0 []
      [atom, pattern, template, elseAtom] = .success [] [] := by
    apply typeCheckArgsDetailedOutcomeScoped_all_atom
    intro j hj
    simp at hj
    have : j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 := by omega
    rcases this with rfl | rfl | rfl | rfl <;> rfl
  have hTypesEq : getTypes kernelDefControlEnv (typePrep st.world (.sym "unify")) =
      [.expr (.sym "->" ::
        [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"] ++
          [.sym "%Undefined%"]) ] := by
    simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.unify
  have hOrdinary :
      selectFunctionType kernelDefControlEnv st.world (.sym "unify")
          [atom, pattern, template, elseAtom] = .selected selected := by
    simpa [selected, mExpr, mSym] using
      (selectFunctionType_singleton_arrow_selected_of_outcome
        kernelDefControlEnv st.world "unify" [atom, pattern, template, elseAtom]
        [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"]
        (.sym "%Undefined%") [] hTypesEq (by simp) hCheck)
  have hExpected :
      selectFunctionTypeForExpected kernelDefControlEnv st.world (.sym "unify")
          [atom, pattern, template, elseAtom] (mSym "Bool") =
        .selected selected := by
    simpa [selected, mExpr, mSym] using
      (selectFunctionTypeForExpected_singleton_arrow_selected_of_detailed
        kernelDefControlEnv st.world "unify" [atom, pattern, template, elseAtom]
        [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"]
        (.sym "%Undefined%") (.sym "Bool") [] []
        hTypesEq
        (by
          simpa [mExpr, mSym] using
            (freshenFunctionTypeCandidates_map_sym kernelDefControlEnv
              (mExpr "unify" [atom, pattern, template, elseAtom])
              [atom, pattern, template, elseAtom] (mSym "Bool")
              ["->", "Atom", "Atom", "Atom", "Atom", "%Undefined%"]))
        (by simp) hExpectedDetailed
        (matchType_undefined_right [] (.sym "Bool")))
  have hHead :
      mettaTypeCastAvoiding
          (expectedApplicationVisibleScope
            (mExpr "unify" [atom, pattern, template, elseAtom]) (mSym "Bool"))
          kernelDefControlEnv st.world selected.typeBindings
          (.sym "unify") selected.functionType = .inr [] := by
    simpa [selected, mExpr, mSym] using
      (mettaTypeCastAvoiding_symbolic_arrow
        (expectedApplicationVisibleScope
          (mExpr "unify" [atom, pattern, template, elseAtom]) (mSym "Bool"))
        kernelDefControlEnv st.world "unify"
        ["Atom", "Atom", "Atom", "Atom", "%Undefined%"] (by
          simpa [mExpr, mSym] using hTypesEq))
  have hOrdinaryPlan : ApplicationPlanCorresponds []
      (.selected selected hOrdinary) := by
    simpa [selected, mExpr, mSym] using
      (applicationPlanCorresponds_atom_args_symbolic_return_selected
        kernelDefControlEnv st.world "unify" "%Undefined%"
        [atom, pattern, template, elseAtom] hTypesEq hOrdinary)
  exact
    mettaEvalExpected_eq_mettaEval_of_same_selected
      kernelDefControlEnv fuel st "unify" [atom, pattern, template, elseAtom]
      (mSym "Bool") (by rfl) (by rfl) (by simp [Metta.Atom.isError])
      selected hOrdinary hOrdinaryPlan hExpected [] hHead (by simp)

