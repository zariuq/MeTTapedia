      mettaEval_quoted_eval_quoted_mem_implies_live_partFold_mem_after_instantiate
        kernelDefControlEnv fuel st bnd
        (mExpr "let" [pattern, bodyQuery, template]) "let"
        pattern bodyQuery template plan (mBool true, outBnd)
        (by simpa [mExpr, mSym] using hinst)
        (by simp [Metta.Atom.isError]) hPolicies hReturn hExpected
        (by simp [mBool, Metta.Atom.isError]) (by simp [mBool, emptyA]) hmem with
    ⟨seed, _hSeed, branchState, argPairs, stArg, hArg, hFold⟩
  exact ⟨seed, branchState, argPairs, stArg, hArg, hFold⟩

