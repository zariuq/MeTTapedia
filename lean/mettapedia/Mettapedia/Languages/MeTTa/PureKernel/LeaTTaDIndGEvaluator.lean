private theorem queryOp_kernelDefControlEnv_nf_lam_eq
    (st : St) (sig : DIndGArtifactSig)
    (rawDomain rawBody : DIndGArtifactTerm)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = []) :
    queryOp kernelDefControlEnv st [] (nfQuery sig (.lam rawDomain rawBody)) [] =
      ( [evalResult [] (nfLamReadout sig rawDomain rawBody)
          ((renameBindings (counterSuffix (st.counter + nfLamCandidatePre.length))
            (nfLamRuleBindings sig rawDomain rawBody)).reverse)]
      , { counter := st.counter + nfLamCandidatePre.length + 4, world := st.world }) := by
  let target := nfQuery sig (.lam rawDomain rawBody)
  let coreB : Metta.Bindings := nfLamRuleBindings sig rawDomain rawBody
  let counter := st.counter + nfLamCandidatePre.length
  let root := nfLamReadout sig rawDomain rawBody
  let rootBnd : Metta.Bindings := (renameBindings (counterSuffix counter) coreB).reverse
  have hNotVarHead : isVariableHeaded target = false := by
    simp [target, nfQuery, termAtom, isVariableHeaded, mExpr, mSym]
  have hCand :
      kernelDefControlEnv.candidates target =
        nfLamCandidatePre ++ nfLamRulePair ::
          (nfLamCandidatePost ++ [nfIndGZeroIotaRulePair, nfDefRulePair]) := by
    have hcandidateEq :
        kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
      simp [MinEnv.candidates, kernelDefControlEnv]
    have hcand := kernelEnv_nf_lam_candidates sig rawDomain rawBody
    have hstaticInit := candidatesW_init_eq_candidates kernelEnv target
    rw [hstaticInit] at hcand
    rw [hcandidateEq]
    simpa [target, nfLamRulePair] using hcand
  have hpre :
      List.foldl (Metta.Minimal.queryOpFoldStep [] target []) ([], st) nfLamCandidatePre =
        (([] : List Item), { counter := counter, world := st.world }) := by
    simpa [target, counter] using
      queryOpFold_nf_lam_pre_eq st sig rawDomain rawBody
  have hLam :
      Metta.Minimal.queryOpItemsOfRule [] target [] counter nfLamRulePair =
        [evalResult [] root rootBnd] := by
    simpa [target, counter, root, rootBnd, coreB] using
      queryOpItems_nf_lam_eq counter sig rawDomain rawBody
  have hBad :
      Metta.Minimal.queryOpItemsOfRule [] target [] (counter + 1) nfBadRulePair = [] := by
    simpa [target, counter] using
      queryOpItems_nf_bad_on_lam_eq_nil (counter + 1) sig rawDomain rawBody
  have hDef :
      Metta.Minimal.queryOpItemsOfRule [] target [] (counter + 1 + 1 + 1) nfDefRulePair = [] := by
    simpa [target, counter, Nat.add_assoc] using
      queryOpItems_nf_def_on_lam_eq_nil (counter + 3) sig rawDomain rawBody
  have hIota :
      Metta.Minimal.queryOpItemsOfRule [] target [] (counter + 1 + 1)
          nfIndGZeroIotaRulePair = [] := by
    exact queryOpItems_nf_indG_zero_iota_eq_nil_of_term_match_nil
      (counter + 2) sig (.lam rawDomain rawBody)
      (by
        simp [cicStage3IndGZeroRawRuntime, termAtom, argsAtom, casesAtom,
          sortAtom, declNameAtom, mExpr, mSym, Metta.matchAtoms,
          Metta.matchAtomsWith, Metta.matchAll])
  unfold queryOp
  rw [hNotVarHead]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [candidatesW_eq_candidates_of_no_selfRules
    kernelDefControlEnv st.world target hStatic hImports]
  rw [hCand]
  rw [List.foldl_append]
  change
    (if (List.foldl (Metta.Minimal.queryOpFoldStep [] target [])
          (List.foldl (Metta.Minimal.queryOpFoldStep [] target []) ([], st) nfLamCandidatePre)
          (nfLamRulePair :: nfLamCandidatePost ++
            [nfIndGZeroIotaRulePair, nfDefRulePair])).1.isEmpty = true then
        ([finItem [] notReducibleA []],
          (List.foldl (Metta.Minimal.queryOpFoldStep [] target [])
            (List.foldl (Metta.Minimal.queryOpFoldStep [] target []) ([], st) nfLamCandidatePre)
            (nfLamRulePair :: nfLamCandidatePost ++
              [nfIndGZeroIotaRulePair, nfDefRulePair])).2)
      else
        List.foldl (Metta.Minimal.queryOpFoldStep [] target [])
          (List.foldl (Metta.Minimal.queryOpFoldStep [] target []) ([], st) nfLamCandidatePre)
          (nfLamRulePair :: nfLamCandidatePost ++
            [nfIndGZeroIotaRulePair, nfDefRulePair])) =
      ( [evalResult [] root rootBnd]
      , { counter := st.counter + nfLamCandidatePre.length + 4, world := st.world })
  rw [hpre]
  simp only [nfLamCandidatePost]
  rw [show ([nfLamRulePair, nfBadRulePair] ++
      [nfIndGZeroIotaRulePair, nfDefRulePair]) =
      [nfLamRulePair, nfBadRulePair, nfIndGZeroIotaRulePair, nfDefRulePair] by rfl]
  simp only [List.foldl_cons, List.foldl_nil, Metta.Minimal.queryOpFoldStep]
  rw [hLam, Metta.Minimal.freshenRuleAvoiding_counter,
    hBad, Metta.Minimal.freshenRuleAvoiding_counter,
    hIota, Metta.Minimal.freshenRuleAvoiding_counter, hDef]
  simp [root, rootBnd, counter, coreB,
    Metta.Minimal.freshenRuleAvoiding_counter, Nat.add_assoc]

/-- Exact `nf Lam` query readout under one closed public binding. -/
private theorem queryOp_kernelDefControlEnv_nf_lam_eq_singleton_closed
    (st : St) (sig : DIndGArtifactSig)
    (rawDomain rawBody : DIndGArtifactTerm)
    (binder : String) (value : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hclosedValue : value.vars = [])
    (hFresh :
      ∀ {v : String}, v = "sig" ∨ v = "A" ∨ v = "b" →
        counterSuffix (st.counter + 4) v ≠ binder) :
    let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
    let rootBnd : Metta.Bindings :=
      (renameBindings (counterSuffix (st.counter + 4))
        (nfLamRuleBindings sig rawDomain rawBody)).reverse ++ incoming
    queryOp kernelDefControlEnv st []
        (nfQuery sig (.lam rawDomain rawBody)) incoming =
      ([evalResult [] (nfLamReadout sig rawDomain rawBody) rootBnd],
        { counter := st.counter + 8, world := st.world }) := by
  dsimp only
  let target := nfQuery sig (.lam rawDomain rawBody)
  let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
  let root := nfLamReadout sig rawDomain rawBody
  let rootBnd :=
    (renameBindings (counterSuffix (st.counter + 4))
      (nfLamRuleBindings sig rawDomain rawBody)).reverse ++ incoming
  have hNotVarHead : isVariableHeaded target = false := by
    simp [target, nfQuery, termAtom, isVariableHeaded, mExpr, mSym]
  have hCand :
      kernelDefControlEnv.candidates target =
        [] ++ nfVarRulePair ::
          [nfSrtRulePair, nfConRulePair, (nfPiRuleLhs, nfPiRuleRhs),
            nfLamRulePair, nfBadRulePair, nfIndGZeroIotaRulePair,
            nfDefRulePair] := by
    have hcandidateEq :
        kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
      simp [MinEnv.candidates, kernelDefControlEnv]
    have hcand := kernelEnv_nf_lam_candidates sig rawDomain rawBody
    have hstaticInit := candidatesW_init_eq_candidates kernelEnv target
    rw [hstaticInit] at hcand
    rw [hcandidateEq]
    simpa [target, nfLamCandidatePre, nfPiCandidatePre,
      nfLamCandidatePost, nfLamRulePair] using hcand
  have hVar :
      Metta.Minimal.queryOpItemsOfRule [] target incoming st.counter
          nfVarRulePair = [] := by
    simpa [target, nfQuery, termAtom, nfVarRulePair, mExpr, mSym] using
      queryOpItems_nf_ctor_mismatch_eq_nil_from st.counter sig "Lam"
        [termAtom rawDomain, termAtom rawBody] incoming "Var" [mVar "k"]
        (mExpr "Var" [mVar "k"]) (by decide)
  have hSrt :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 1)
          nfSrtRulePair = [] := by
    simpa [target, nfQuery, termAtom, nfSrtRulePair, mExpr, mSym] using
      queryOpItems_nf_ctor_mismatch_eq_nil_from (st.counter + 1) sig "Lam"
        [termAtom rawDomain, termAtom rawBody] incoming "Srt" [mVar "s"]
        (mExpr "Srt" [mVar "s"]) (by decide)
  have hCon :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 2)
          nfConRulePair = [] := by
    simpa [target, nfQuery, termAtom, nfConRulePair, mExpr, mSym] using
      queryOpItems_nf_ctor_mismatch_eq_nil_from (st.counter + 2) sig "Lam"
        [termAtom rawDomain, termAtom rawBody] incoming "Con" [mVar "x"]
        (mExpr "Con" [mVar "x"]) (by decide)
  have hPi :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 3)
          (nfPiRuleLhs, nfPiRuleRhs) = [] := by
    simpa [target, nfQuery, termAtom, nfPiRuleLhs, mExpr, mSym] using
      queryOpItems_nf_ctor_mismatch_eq_nil_from (st.counter + 3) sig "Lam"
        [termAtom rawDomain, termAtom rawBody] incoming "Pi"
        [mVar "A", mVar "B"] nfPiRuleRhs (by decide)
  have hLam :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 4)
          nfLamRulePair =
        [evalResult [] root rootBnd] := by
    simpa [target, incoming, root, rootBnd] using
      queryOpItems_nf_lam_eq_singleton_closed (st.counter + 4) sig
        rawDomain rawBody binder value hclosedValue hFresh
  have hBad :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 5)
          nfBadRulePair = [] := by
    simpa [target, nfQuery, termAtom, nfBadRulePair, mExpr, mSym] using
      queryOpItems_nf_ctor_mismatch_eq_nil_from (st.counter + 5) sig "Lam"
        [termAtom rawDomain, termAtom rawBody] incoming "Bad" [mVar "e"]
        (mExpr "Bad" [mVar "e"]) (by decide)
  have hIota :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 6)
          nfIndGZeroIotaRulePair = [] := by
    exact queryOpItems_nf_indG_zero_iota_eq_nil_of_term_match_nil_from
      (st.counter + 6) sig (.lam rawDomain rawBody) incoming
      (by
        simp [cicStage3IndGZeroRawRuntime, termAtom, argsAtom, casesAtom,
          sortAtom, declNameAtom, mExpr, mSym, Metta.matchAtoms,
          Metta.matchAtomsWith, Metta.matchAll])
  have hDef :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 7)
          nfDefRulePair = [] := by
    simpa [target, nfQuery, termAtom, nfDefRulePair, nfDefRuleLhs,
      mExpr, mSym] using
      queryOpItems_nf_ctor_mismatch_eq_nil_from (st.counter + 7) sig "Lam"
        [termAtom rawDomain, termAtom rawBody] incoming "Def" [mVar "x"]
        nfDefRuleRhs (by decide)
  unfold queryOp
  rw [hNotVarHead]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [candidatesW_eq_candidates_of_no_selfRules
    kernelDefControlEnv st.world target hStatic hImports]
  rw [hCand]
  rw [List.foldl_append]
  simp only [List.foldl_cons, List.foldl_nil,
    Metta.Minimal.queryOpFoldStep, freshenRuleAvoiding_counter]
  let items : List Item :=
    (((((((Metta.Minimal.queryOpItemsOfRule [] target incoming st.counter
          nfVarRulePair ++
        Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 1)
          nfSrtRulePair) ++
        Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 2)
          nfConRulePair) ++
        Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 3)
          (nfPiRuleLhs, nfPiRuleRhs)) ++
        Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 4)
          nfLamRulePair) ++
        Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 5)
          nfBadRulePair) ++
        Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 6)
          nfIndGZeroIotaRulePair) ++
        Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 7)
          nfDefRulePair)
  let stOut : St := { counter := st.counter + 8, world := st.world }
  change
    (if items.isEmpty = true then
        ([finItem [] notReducibleA incoming], stOut)
      else
        (items, stOut)) =
      ([evalResult [] root rootBnd],
        { counter := st.counter + 8, world := st.world })
  have hItems : items = [evalResult [] root rootBnd] := by
    simp [items, hVar, hSrt, hCon, hPi, hLam, hBad, hIota, hDef]
  rw [hItems]
  simp [root, rootBnd, stOut]

theorem interpretFuel_kernelDefControlEnv_nf_lam_root_eq
    {fuel : Nat} {st : St} (sig : DIndGArtifactSig)
    (rawDomain rawBody : DIndGArtifactTerm)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = []) :
    interpretFuel kernelDefControlEnv (fuel + 1) st
        [evalItemNil (nfQuery sig (.lam rawDomain rawBody))] [] =
      ( [ (nfLamReadout sig rawDomain rawBody,
            (renameBindings (counterSuffix (st.counter + nfLamCandidatePre.length))
