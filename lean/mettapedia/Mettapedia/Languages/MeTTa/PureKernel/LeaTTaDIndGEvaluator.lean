def bindSubstVarReadout (index : Nat)
    (replacement : DIndGArtifactTerm) (k : Nat) : Metta.Atom :=
  mExpr "if"
    [ mExpr "==" [mNat k, mNat index]
    , termAtom replacement
    , mExpr "if"
        [ mExpr ">" [mNat k, mNat index]
        , mExpr "Var" [mExpr "-" [mNat k, mNat 1]]
        , mExpr "Var" [mNat k] ] ]

