  have hRaw : rawLeft = rawRight :=
    termAtom_grounded_eq_true_resolved_raw_eq
      hLeftResolved hRightResolved hEqTrue
  subst rawRight
  have hTerm : left = right :=
    dindg_translate_unique_on_cicStage3_resolved
      (raw := rawLeft) hLeftResolved hLeft hRight
  subst right
  exact Relation.EqvGen.refl left

/-- Exposed final-branch package for name-free `conv`.

This is the clean composition point after the still-missing control-flow
inversion has exposed the two `nf` readouts and the final grounded equality
result.  It gives both faces needed downstream: the executable scheduler
harvests `True` for the final comparison frame, and the declaration calculus has
`ConvDecl`. -/
theorem conv_final_eq_branch_nameFree_runtime_decl_conv
    {sig : DIndGArtifactSig} {rawLeft rawRight : DIndGArtifactTerm}
    {outLeft outRight : Metta.Atom} {left right : PureTm 0}
    (fuel : Nat)
    (hNameLeft : NfEqFragmentTermNameFree rawLeft)
    (hNameRight : NfEqFragmentTermNameFree rawRight)
    (hReadLeft : NfEqFragmentReadout sig rawLeft outLeft)
    (hReadRight : NfEqFragmentReadout sig rawRight outRight)
    (hEqTrue :
      Metta.callGrounded Metta.Minimal.stdGroundings "==" [outLeft, outRight] =
        Metta.ReduceResult.ok [mBool true])
    (hLeft :
      DIndGArtifactTermTranslates sig.nameTranslates 0 rawLeft left)
    (hRight :
      DIndGArtifactTermTranslates sig.nameTranslates 0 rawRight right) :
    (mBool true, []) ∈
        (interpretFuel kernelCoreEnv (fuel + 1) St.init
          [evalItemNil (mExpr "==" [outLeft, outRight])] []).1 ∧
      ConvDecl (envOfSpecs sig.translatedSpecs) left right := by
  exact ⟨
    interpretFuel_eval_nf_readouts_eq_true_contains fuel hReadLeft hReadRight hEqTrue,
    nf_eq_fragment_grounded_eq_true_nameFree_decl_conv
      hNameLeft hNameRight hReadLeft hReadRight hEqTrue hLeft hRight⟩

