          root (selectedResultExpected outerPlan.selected) =
        ([(mBool false, innerOut)], stRoot) := by
    rw [hOuterExpected]
    exact hInnerFinal
  have hAssembled :=
    mettaEval_expr_eq_of_instantiated_all_quoted_and_root_expected_eq_bnd
      kernelDefControlEnv (fuel + 2) st stRoot stRoot incoming
      (mExpr "is-bad" outerArgs) "is-bad" outerArgs root (mBool false)
      rootBnd innerOut outerPlan hOuterStable
      (by simp [outerArgs, Metta.Atom.isError]) hOuterSeed hOuterMask
      hOuterReturn hOuterNoErr hRoot (by rfl) (by rfl) hFinal
  have hInnerRetainedClosed : ClosedValueBindings innerRetained := by
    exact closedValueBindings_restrictBnd
      (hOuterRetainedClosed.mergeHeadGetD hOuterRetainedClosed)
  have hInnerOutClosed : ClosedValueBindings innerOut := by
    exact closedValueBindings_restrictBnd
      (hInnerRetainedClosed.mergeHeadGetD hInnerRetainedClosed)
  have hOutBindingsClosed : ClosedValueBindings outBindings := by
    exact closedValueBindings_restrictBnd
      (hOuterRetainedClosed.mergeHeadGetD hInnerOutClosed)
  refine ⟨hOutBindingsClosed, ?_⟩
  simpa [outerArgs, outerScope, rootArgs, root, rootBnd, stRoot,
    mergedRoot, outerRetained, innerScope, innerRetained, innerOut,
    outBindings, outerPlan] using hAssembled

/-- A closed value at the public key resolves through one preceding private
copy of the same value.  Self-stability is explicit because `BEq Atom` is not
lawful on all grounded atoms. -/
private theorem resolveAtom_two_closed_vals_right
    (privateKey binder : Metta.VarName) (value : Metta.Atom)
    (hclosed : value.vars = []) :
    resolveAtom
        [Metta.BindingRel.val privateKey value,
          Metta.BindingRel.val binder value]
        3 (Metta.Atom.var binder) = value := by
  let bindings : Metta.Bindings :=
    [Metta.BindingRel.val privateKey value,
      Metta.BindingRel.val binder value]
  have hbindingsClosed : ClosedValueBindings bindings := by
    exact ClosedValueBindings.val hclosed
      (ClosedValueBindings.val hclosed ClosedValueBindings.nil)
  have hlookup : Metta.Bindings.lookupVal bindings binder = some value := by
    simp [bindings, Metta.Bindings.lookupVal]
  have hinstVar :
      Metta.instantiate bindings (Metta.Atom.var binder) = value := by
    rw [hbindingsClosed.instantiate_eq_subst_apply]
    simp [Metta.Subst.apply, lookup_bindingsToSubst, hlookup]
  have hinstValue : Metta.instantiate bindings value = value :=
    instantiate_eq_self_of_vars_nil bindings hclosed
  have hchanges : (value == Metta.Atom.var binder) = false := by
    cases value with
    | var name => simp [Metta.Atom.vars] at hclosed
    | sym _ | gnd _ | expr _ => rfl
  unfold resolveAtom
  rw [hinstVar]
  simp only [hchanges, Bool.false_eq_true, ↓reduceIte]
  change resolveAtom bindings 2 value = value
  exact resolveAtom_of_vars_nil bindings 2 value hclosed

/-- Retaining one public key from a private/public pair with the same resolved
closed value yields the canonical singleton relation. -/
private theorem restrictBnd_singleton_two_vals_right
    (privateKey binder : Metta.VarName) (value : Metta.Atom)
    (hresolve :
      resolveAtom
          [Metta.BindingRel.val privateKey value,
            Metta.BindingRel.val binder value]
          3 (Metta.Atom.var binder) = value)
    (hnotvar : ∀ name, value ≠ Metta.Atom.var name) :
    restrictBnd [binder]
        [Metta.BindingRel.val privateKey value,
          Metta.BindingRel.val binder value] =
      [Metta.BindingRel.val binder value] := by
  let relation := Metta.BindingRel.val binder value
  have hraw :
      restrictBndRaw [binder]
          [Metta.BindingRel.val privateKey value, relation] = [relation] := by
    unfold restrictBndRaw
    simp only [List.filterMap_cons, List.filterMap_nil, List.length_cons,
      List.length_nil, Nat.reduceAdd]
    rw [hresolve]
    cases value <;> simp_all [relation]
  have hfresh : Metta.Bindings.mergeOne [[]] relation = [[relation]] := by
    unfold Metta.Bindings.mergeOne
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    change Metta.Bindings.addVarBinding [] binder value = [[relation]]
    rw [Metta.Bindings.addVarBinding_fresh (by simp) hnotvar]
    simp [Metta.Bindings.addValRaw, Metta.Bindings.removeVal, relation]
  unfold restrictBnd
  rw [hraw]
  change (Metta.Bindings.mergeOne [[]] relation).head?.getD [relation] =
    [relation]
  rw [hfresh]
  rfl

/-- Replaying one closed public value through the canonical projection keeps
the singleton relation. -/
private theorem restrictBnd_singleton_closed_val
    (binder : Metta.VarName) (value : Metta.Atom)
    (hclosed : value.vars = [])
    (hnotvar : ∀ name, value ≠ Metta.Atom.var name) :
    restrictBnd [binder] [Metta.BindingRel.val binder value] =
      [Metta.BindingRel.val binder value] := by
  let relation := Metta.BindingRel.val binder value
  have hresolve :
      resolveAtom [relation] 2 (Metta.Atom.var binder) = value := by
    simpa [relation] using resolveAtom_singleton_closed_val binder value hclosed 1
  have hraw : restrictBndRaw [binder] [relation] = [relation] := by
    unfold restrictBndRaw
    simp only [List.filterMap_cons, List.filterMap_nil, List.length_cons,
      List.length_nil, Nat.reduceAdd]
    rw [hresolve]
    cases value <;> simp_all [relation]
  have hfresh : Metta.Bindings.mergeOne [[]] relation = [[relation]] := by
    unfold Metta.Bindings.mergeOne
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    change Metta.Bindings.addVarBinding [] binder value = [[relation]]
    rw [Metta.Bindings.addVarBinding_fresh (by simp) hnotvar]
    simp [Metta.Bindings.addValRaw, Metta.Bindings.removeVal, relation]
  unfold restrictBnd
  rw [hraw]
  change (Metta.Bindings.mergeOne [[]] relation).head?.getD [relation] =
    [relation]
  rw [hfresh]
  rfl

/-- A closed value found at one public key determines that key's canonical
singleton restriction, independently of any additional private value
bindings.  Non-variable-ness remains explicit because a variable result would
produce an equality relation instead. -/
private theorem restrictBnd_singleton_of_closed_lookup
    (bindings : Metta.Bindings) (binder : Metta.VarName) (value : Metta.Atom)
    (hbindings : ClosedValueBindings bindings)
    (hlookup : Metta.Bindings.lookupVal bindings binder = some value)
    (hclosed : value.vars = [])
    (hnotvar : ∀ name, value ≠ Metta.Atom.var name) :
    restrictBnd [binder] bindings =
      [Metta.BindingRel.val binder value] := by
  let relation := Metta.BindingRel.val binder value
  have hinst :
      Metta.instantiate bindings (Metta.Atom.var binder) = value := by
    rw [hbindings.instantiate_eq_subst_apply]
    simp [Metta.Subst.apply, lookup_bindingsToSubst, hlookup]
  have hneq : (value == Metta.Atom.var binder) = false := by
    cases value with
    | var name => exact False.elim (hnotvar name rfl)
    | sym _ | gnd _ | expr _ => rfl
  have hresolve :
      resolveAtom bindings (bindings.length + 1) (Metta.Atom.var binder) =
        value := by
    unfold resolveAtom
    rw [hinst]
    simp [hneq, resolveAtom_of_vars_nil bindings bindings.length value hclosed]
  have hraw : restrictBndRaw [binder] bindings = [relation] := by
    have heqs :
        bindings.filter
            (fun r =>
              match r with
              | Metta.BindingRel.eq x y =>
                  [binder].contains x && [binder].contains y
              | _ => false) = [] :=
      closedValueBindings_filter_eq_only_empty
        (fun x y => [binder].contains x && [binder].contains y) hbindings
    let solved := [binder].filterMap fun x =>
      let v := resolveAtom bindings (bindings.length + 1) (Metta.Atom.var x)
      match v with
      | Metta.Atom.var y =>
          if y == x then none else some (Metta.BindingRel.eq x y)
      | _ => some (Metta.BindingRel.val x v)
    change solved ++
        bindings.filter
          (fun r =>
            match r with
            | Metta.BindingRel.eq x y =>
                [binder].contains x && [binder].contains y
            | _ => false) = [relation]
    calc
      _ = solved ++ [] := congrArg (fun tail => solved ++ tail) heqs
      _ = [relation] := by
        simp only [List.append_nil]
        dsimp [solved]
        simp only [List.filterMap_cons, List.filterMap_nil]
        rw [hresolve]
        cases value <;> simp_all [relation]
  have hfresh : Metta.Bindings.mergeOne [[]] relation = [[relation]] := by
    unfold Metta.Bindings.mergeOne
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    change Metta.Bindings.addVarBinding [] binder value = [[relation]]
    rw [Metta.Bindings.addVarBinding_fresh (by simp) hnotvar]
    simp [Metta.Bindings.addValRaw, Metta.Bindings.removeVal, relation]
  unfold restrictBnd
  rw [hraw]
  change (Metta.Bindings.mergeOne [[]] relation).head?.getD [relation] =
    [relation]
  rw [hfresh]
  rfl

/-- Adding one unresolved private scope name before a closed public singleton
does not alter the canonical public relation. -/
private theorem restrictBnd_fresh_cons_singleton_closed_val
    (fresh binder : Metta.VarName) (value : Metta.Atom)
    (hfresh : fresh ≠ binder) (hclosed : value.vars = [])
    (hnotvar : ∀ name, value ≠ Metta.Atom.var name) :
    restrictBnd [fresh, binder] [Metta.BindingRel.val binder value] =
      [Metta.BindingRel.val binder value] := by
  let relation := Metta.BindingRel.val binder value
  have hinstFresh :
      Metta.instantiate [relation] (Metta.Atom.var fresh) =
        Metta.Atom.var fresh := by
    have hrelationClosed : ClosedValueBindings [relation] :=
      ClosedValueBindings.val hclosed ClosedValueBindings.nil
    have hlookup : Metta.Bindings.lookupVal [relation] fresh = none := by
      change (if fresh == binder then some value else none) = none
      simp [hfresh]
    rw [hrelationClosed.instantiate_eq_subst_apply]
    simp [Metta.Subst.apply, lookup_bindingsToSubst, hlookup]
  have hresolveFresh :
      resolveAtom [relation] 2 (Metta.Atom.var fresh) =
        Metta.Atom.var fresh :=
    resolveAtom_var_of_instantiate_eq_self [relation] fresh hinstFresh 2
  have hresolveBinder :
      resolveAtom [relation] 2 (Metta.Atom.var binder) = value := by
    simpa [relation] using resolveAtom_singleton_closed_val binder value hclosed 1
  have hraw : restrictBndRaw [fresh, binder] [relation] = [relation] := by
    unfold restrictBndRaw
    simp only [List.filterMap_cons, List.filterMap_nil, List.length_cons,
      List.length_nil, Nat.reduceAdd]
    rw [hresolveFresh, hresolveBinder]
    cases value <;> simp_all [relation]
  have hmerge : Metta.Bindings.mergeOne [[]] relation = [[relation]] := by
    unfold Metta.Bindings.mergeOne
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    change Metta.Bindings.addVarBinding [] binder value = [[relation]]
    rw [Metta.Bindings.addVarBinding_fresh (by simp) hnotvar]
    simp [Metta.Bindings.addValRaw, Metta.Bindings.removeVal, relation]
  unfold restrictBnd
  rw [hraw]
  change (Metta.Bindings.mergeOne [[]] relation).head?.getD [relation] =
    [relation]
  rw [hmerge]
  rfl

/-- Repeating one unresolved private scope name before a closed public
singleton still contributes no canonical relation. -/
private theorem restrictBnd_fresh_triple_singleton_closed_val
    (fresh binder : Metta.VarName) (value : Metta.Atom)
    (hfresh : fresh ≠ binder) (hclosed : value.vars = [])
    (hnotvar : ∀ name, value ≠ Metta.Atom.var name) :
    restrictBnd [fresh, fresh, fresh, binder]
        [Metta.BindingRel.val binder value] =
      [Metta.BindingRel.val binder value] := by
  let relation := Metta.BindingRel.val binder value
  have hinstFresh :
      Metta.instantiate [relation] (Metta.Atom.var fresh) =
        Metta.Atom.var fresh := by
    have hrelationClosed : ClosedValueBindings [relation] :=
      ClosedValueBindings.val hclosed ClosedValueBindings.nil
    have hlookup : Metta.Bindings.lookupVal [relation] fresh = none := by
      change (if fresh == binder then some value else none) = none
      simp [hfresh]
    rw [hrelationClosed.instantiate_eq_subst_apply]
    simp [Metta.Subst.apply, lookup_bindingsToSubst, hlookup]
  have hresolveFresh :
      resolveAtom [relation] 2 (Metta.Atom.var fresh) =
        Metta.Atom.var fresh :=
    resolveAtom_var_of_instantiate_eq_self [relation] fresh hinstFresh 2
  have hresolveBinder :
      resolveAtom [relation] 2 (Metta.Atom.var binder) = value := by
    simpa [relation] using resolveAtom_singleton_closed_val binder value hclosed 1
  have hraw :
      restrictBndRaw [fresh, fresh, fresh, binder] [relation] = [relation] := by
    unfold restrictBndRaw
    simp only [List.filterMap_cons, List.filterMap_nil, List.length_cons,
      List.length_nil, Nat.reduceAdd]
    rw [hresolveFresh, hresolveBinder]
    cases value <;> simp_all [relation, hfresh]
  have hmerge : Metta.Bindings.mergeOne [[]] relation = [[relation]] := by
    unfold Metta.Bindings.mergeOne
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    change Metta.Bindings.addVarBinding [] binder value = [[relation]]
    rw [Metta.Bindings.addVarBinding_fresh (by simp) hnotvar]
    simp [Metta.Bindings.addValRaw, Metta.Bindings.removeVal, relation]
  unfold restrictBnd
  rw [hraw]
  change (Metta.Bindings.mergeOne [[]] relation).head?.getD [relation] =
    [relation]
  rw [hmerge]
  rfl

/-- Re-merging one closed value binding is inert when reconciliation proves
the two value occurrences consistent. -/
private theorem merge_singleton_closed_self_eq
    (binder : Metta.VarName) (value : Metta.Atom)
    (hnotvar : ∀ name, value ≠ Metta.Atom.var name)
    (hunify : Metta.Bindings.unifyValues [value, value] = some []) :
    Metta.Bindings.merge [Metta.BindingRel.val binder value]
        [Metta.BindingRel.val binder value] =
      [[Metta.BindingRel.val binder value]] := by
  let relation := Metta.BindingRel.val binder value
  have hsame :
      Metta.Bindings.addVarBinding [relation] binder value = [[relation]] := by
    apply Metta.Bindings.addVarBinding_nochange (values := [value])
    · exact hnotvar
    · exact Metta.Bindings.classValues_singleton_val_self binder value
    · simp
    · simpa using hunify
  change Metta.Bindings.mergeOne [[relation]] relation = [[relation]]
  simpa [Metta.Bindings.mergeOne, relation] using hsame

/-- Re-merging a closed private value presentation followed by the caller's
own closed public singleton preserves that singleton at the public projection
boundary.  The private list may have any length; its key order and
multiplicity remain part of the runtime root binding, while the projection
forgets all keys outside the declared public scope. -/
private theorem restrict_merge_private_closed_public_singleton
    (privateBnd : Metta.Bindings) (binder : Metta.VarName) (value : Metta.Atom)
    (hPrivateClosed : ClosedValueBindings privateBnd)
    (hPrivateNodup : (bindingValueKeys privateBnd).Nodup)
    (hPrivateBinder : binder ∉ bindingValueKeys privateBnd)
    (hValueClosed : value.vars = [])
    (hValueNonVar : ∀ name, value ≠ Metta.Atom.var name)
    (hValueUnify : Metta.Bindings.unifyValues [value, value] = some []) :
    let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
    let rootBnd : Metta.Bindings := privateBnd ++ incoming
    restrictBnd [binder]
        ((Metta.Bindings.merge incoming rootBnd).head?.getD rootBnd) =
      incoming := by
  dsimp only
  let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
  let merged : Metta.Bindings := privateBnd.reverse ++ incoming
  have hIncomingClosed : ClosedValueBindings incoming :=
    ClosedValueBindings.val hValueClosed ClosedValueBindings.nil
  have hDisjoint :
      ∀ x ∈ bindingValueKeys privateBnd, x ∉ bindingValueKeys incoming := by
    intro x hxPrivate hxIncoming
    have hxb : x = binder := by
      simpa [incoming, bindingValueKeys] using hxIncoming
    subst x
    exact hPrivateBinder hxPrivate
  have hPrivateMerge : Metta.Bindings.merge incoming privateBnd = [merged] := by
    simpa [merged] using
      merge_closed_noConflict_eq hPrivateClosed hPrivateNodup
        hIncomingClosed hDisjoint
  have hMergedClosed : ClosedValueBindings merged :=
    ClosedValueBindings.append (ClosedValueBindings.reverse hPrivateClosed)
      hIncomingClosed
  have hPrivateLookupNone :
      Metta.Bindings.lookupVal privateBnd.reverse binder = none := by
    rw [lookupVal_reverse_closed_nodup hPrivateClosed hPrivateNodup]
    exact lookupVal_none_of_not_mem_keys hPrivateBinder
  have hMergedLookup : Metta.Bindings.lookupVal merged binder = some value := by
    rw [show merged = privateBnd.reverse ++ incoming by rfl, lookupVal_append,
      hPrivateLookupNone]
    simp [incoming, Metta.Bindings.lookupVal]
  have hValues : Metta.Bindings.classValues merged binder = [value] := by
    rw [Metta.Bindings.classValues_eq_lookupVal_toList_of_eqVarsInOrder_nil
      (ValueBindings.eqVarsInOrder_nil hMergedClosed.toValueBindings)]
    rw [hMergedLookup]
    rfl
  have hPublicAdd :
      Metta.Bindings.addVarBinding merged binder value = [merged] := by
    apply Metta.Bindings.addVarBinding_nochange (values := [value])
    · exact hValueNonVar
    · exact hValues
    · simp
    · simpa using hValueUnify
  have hPublicMerge :
      Metta.Bindings.mergeOne [merged]
          (Metta.BindingRel.val binder value) = [merged] := by
    simpa [Metta.Bindings.mergeOne] using hPublicAdd
  have hMerge :
      Metta.Bindings.merge incoming (privateBnd ++ incoming) = [merged] := by
    unfold Metta.Bindings.merge
    rw [List.foldl_append]
    change
      List.foldl Metta.Bindings.mergeOne
          (Metta.Bindings.merge incoming privateBnd) incoming = [merged]
    rw [hPrivateMerge]
    simpa [incoming] using hPublicMerge
  have hRestrict : restrictBnd [binder] merged = incoming := by
    simpa [incoming] using
      restrictBnd_singleton_of_closed_lookup merged binder value
        hMergedClosed hMergedLookup hValueClosed hValueNonVar
  rw [hMerge]
  simp only [List.head?_cons, Option.getD_some]
  exact hRestrict

/-- Merging two fresh private values and then the caller's own closed public
singleton preserves that singleton at the public projection boundary.

The private values may be arbitrary closed atoms.  Reconciliation is required
only for the duplicated public value, since `BEq Atom` is not globally lawful. -/
private theorem restrict_merge_private_pair_public_singleton
    (private₁ private₂ binder : Metta.VarName)
    (value₁ value₂ value : Metta.Atom)
    (hValue₁Closed : value₁.vars = [])
    (hValue₂Closed : value₂.vars = [])
    (hValueClosed : value.vars = [])
    (hPrivate₁Binder : private₁ ≠ binder)
    (hPrivate₂Binder : private₂ ≠ binder)
    (hPrivate₂Private₁ : private₂ ≠ private₁)
    (hValueNonVar : ∀ name, value ≠ Metta.Atom.var name)
    (hValueUnify : Metta.Bindings.unifyValues [value, value] = some []) :
    let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
    let rootBnd : Metta.Bindings :=
      [ Metta.BindingRel.val private₁ value₁
      , Metta.BindingRel.val private₂ value₂
      , Metta.BindingRel.val binder value ]
    restrictBnd [binder]
        ((Metta.Bindings.merge incoming rootBnd).head?.getD rootBnd) =
      incoming := by
  dsimp only
  let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
  let merged : Metta.Bindings :=
    [ Metta.BindingRel.val private₂ value₂
    , Metta.BindingRel.val private₁ value₁
    , Metta.BindingRel.val binder value ]
  have hIncomingClosed : ClosedValueBindings incoming :=
    ClosedValueBindings.val hValueClosed ClosedValueBindings.nil
  have hFirst :
      Metta.Bindings.mergeOne [incoming]
          (Metta.BindingRel.val private₁ value₁) =
        [[Metta.BindingRel.val private₁ value₁] ++ incoming] := by
    apply mergeOne_singleton_val_of_not_mem hIncomingClosed hValue₁Closed
    simpa [incoming, bindingValueKeys] using hPrivate₁Binder
  have hSecond :
      Metta.Bindings.mergeOne
          [[Metta.BindingRel.val private₁ value₁] ++ incoming]
          (Metta.BindingRel.val private₂ value₂) =
        [[Metta.BindingRel.val private₂ value₂,
          Metta.BindingRel.val private₁ value₁] ++ incoming] := by
    apply mergeOne_singleton_val_of_not_mem
      (ClosedValueBindings.val hValue₁Closed hIncomingClosed) hValue₂Closed
    simp [incoming, bindingValueKeys, hPrivate₂Private₁, hPrivate₂Binder]
  have hValues : Metta.Bindings.classValues merged binder = [value] := by
    rw [Metta.Bindings.classValues_eq_lookupVal_toList_of_eqVarsInOrder_nil]
    · simp [merged, Metta.Bindings.lookupVal, Ne.symm hPrivate₁Binder,
        Ne.symm hPrivate₂Binder]
    · rfl
  have hThirdAdd :
      Metta.Bindings.addVarBinding merged binder value = [merged] := by
    apply Metta.Bindings.addVarBinding_nochange (values := [value])
    · exact hValueNonVar
    · exact hValues
    · simp
    · simpa using hValueUnify
  have hThird :
      Metta.Bindings.mergeOne [merged]
          (Metta.BindingRel.val binder value) = [merged] := by
    simpa [Metta.Bindings.mergeOne] using hThirdAdd
  have hMerge :
      Metta.Bindings.merge incoming
          [ Metta.BindingRel.val private₁ value₁
          , Metta.BindingRel.val private₂ value₂
          , Metta.BindingRel.val binder value ] =
        [merged] := by
    unfold Metta.Bindings.merge
    simp only [List.foldl_cons, List.foldl_nil]
    rw [hFirst, hSecond]
    simpa [merged, incoming] using hThird
  have hMergedClosed : ClosedValueBindings merged :=
    ClosedValueBindings.val hValue₂Closed
      (ClosedValueBindings.val hValue₁Closed hIncomingClosed)
  have hMergedLookup : Metta.Bindings.lookupVal merged binder = some value := by
    simp [merged, Metta.Bindings.lookupVal, Ne.symm hPrivate₁Binder,
      Ne.symm hPrivate₂Binder]
  have hRestrict : restrictBnd [binder] merged = incoming := by
    simpa [incoming] using
      restrictBnd_singleton_of_closed_lookup merged binder value
        hMergedClosed hMergedLookup hValueClosed hValueNonVar
  rw [hMerge]
  simp only [List.head?_cons, Option.getD_some]
  simpa [incoming] using hRestrict

/-- A binary untyped-tuple application whose two closed arguments each
preserve the same closed public singleton also preserves that singleton.

The theorem packages the live left-to-right argument fold once.  It does not
assume binding neutrality: both recursive results and both projection steps
are proved to retain the caller's concrete relation. -/
private theorem mettaEval_binary_expr_eq_of_singleton_closed_arg_evals_and_notReducible
    (env : MinEnv) (fuel : Nat) (st stFirst stSecond : St)
    (binder : String) (value : Metta.Atom)
    (op : String) (hOpNotError : op ≠ "Error")
    (first second firstOut secondOut : Metta.Atom)
    (hValueClosed : value.vars = [])
    (hValueNonVar : ∀ name, value ≠ Metta.Atom.var name)
    (hValueUnify : Metta.Bindings.unifyValues [value, value] = some [])
    (hFirstClosed : first.vars = [])
    (hSecondClosed : second.vars = [])
    (hScan :
      selectFunctionType env st.world (.sym op) [first, second] =
        .exhausted [] true)
    (hPlan : ApplicationPlanCorresponds
      [Metta.BindingRel.val binder value] (.untypedTuple hScan))
    (hFirst :
      mettaEval env fuel st [Metta.BindingRel.val binder value] first =
        ([(firstOut, [Metta.BindingRel.val binder value])], stFirst))
    (hSecond :
      mettaEval env fuel stFirst [Metta.BindingRel.val binder value] second =
        ([(secondOut, [Metta.BindingRel.val binder value])], stSecond))
    (hNoError :
      (([firstOut, secondOut].zip [first, second]).find?
        (fun pair =>
          (pair.1 == emptyA || pair.1.isError) && pair.1 != pair.2)) = none)
    (hRoot :
      interpretFuel env (fuel + 1) stSecond
          [evalItemBnd [Metta.BindingRel.val binder value]
            (Metta.Atom.expr [Metta.Atom.sym op, firstOut, secondOut])] [] =
