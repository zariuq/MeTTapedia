        typeCheckArgsOutcome kernelEnv st.world [.sym "Atom"] 0 [] [a] = .success [] := by
      simpa [mSym] using typeCheckArgsOutcome_one_atom kernelEnv st.world a
    obtain ⟨latentErrors, hDetailed⟩ :=
