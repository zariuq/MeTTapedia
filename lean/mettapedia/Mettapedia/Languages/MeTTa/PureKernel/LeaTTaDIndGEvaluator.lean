/-- Reflexive corollary of the `conv` body bridge.

This is the smallest closed recursive-kernel probe: for any translated raw term, the executable
`conv raw raw` dispatch is connected to the certified MOPS body readout, and the declaration-side
conversion conclusion is closed by reflexivity. -/
theorem conv_evalAtomMin_reflexive_body_bridge_decl
    (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm) {term : PureTm 0}
    (hTerm :
      DIndGArtifactTermTranslates sig.nameTranslates 0 raw term) :
    Metta.instantiate
        (renameBindings (counterSuffix St.init.counter)
          (convRuleBindings sig raw raw)).reverse
        (freshenRule St.init.counter convRuleLhs convRuleRhs).2 ∈
        evalAtomMin kernelCoreEnv 1 (convQuery sig raw raw) ∧
      Relation.ReflTransGen (Metta.MopsStep kernelCoreRules)
        (convQuery sig raw raw)
        (convReadout sig raw raw) ∧
      Metta.AlphaEq
        (Metta.instantiate
          (renameBindings (counterSuffix St.init.counter)
            (convRuleBindings sig raw raw)).reverse
          (freshenRule St.init.counter convRuleLhs convRuleRhs).2)
        (convReadout sig raw raw) ∧
      DIndGArtifactTermTranslates sig.nameTranslates 0 raw term ∧
      ConvDecl (envOfSpecs sig.translatedSpecs) term term := by
  rcases conv_evalAtomMin_body_bridge_of_decl
    (sig := sig) (rawLeft := raw) (rawRight := raw)
    (left := term) (right := term) hTerm hTerm (Relation.EqvGen.refl term) with
    ⟨hmem, hreach, halpha, hLeft, _hRight, hconv⟩
  exact ⟨hmem, hreach, halpha, hLeft, hconv⟩

/-- Closed Stage-3 instance of the reflexive `conv` body bridge.

This is the smallest concrete recursive-kernel probe: the runtime dispatch for
`conv (Srt type) (Srt type)` reaches the certified recursive body, and the
declaration-side conversion fact is closed by reflexivity. -/
theorem conv_srt_type_reflexive_body_bridge_decl :
    Metta.instantiate
        (renameBindings (counterSuffix St.init.counter)
          (convRuleBindings cicStage3RawArtifactSig (.srt .type) (.srt .type))).reverse
        (freshenRule St.init.counter convRuleLhs convRuleRhs).2 ∈
        evalAtomMin kernelCoreEnv 1
          (convQuery cicStage3RawArtifactSig (.srt .type) (.srt .type)) ∧
      Relation.ReflTransGen (Metta.MopsStep kernelCoreRules)
        (convQuery cicStage3RawArtifactSig (.srt .type) (.srt .type))
        (convReadout cicStage3RawArtifactSig (.srt .type) (.srt .type)) ∧
      Metta.AlphaEq
        (Metta.instantiate
          (renameBindings (counterSuffix St.init.counter)
            (convRuleBindings cicStage3RawArtifactSig (.srt .type) (.srt .type))).reverse
          (freshenRule St.init.counter convRuleLhs convRuleRhs).2)
        (convReadout cicStage3RawArtifactSig (.srt .type) (.srt .type)) ∧
      DIndGArtifactTermTranslates cicStage3RawArtifactSig.nameTranslates 0
        (.srt .type) ((.u0 : PureTm 0)) ∧
      ConvDecl (envOfSpecs cicStage3RawArtifactSig.translatedSpecs)
        ((.u0 : PureTm 0)) ((.u0 : PureTm 0)) := by
  simpa using
    (conv_evalAtomMin_reflexive_body_bridge_decl
      (sig := cicStage3RawArtifactSig) (raw := .srt .type)
      DIndGArtifactTermTranslates.srt_type)

