/-- Full-runtime root package for the equality-rule-only `nf` fragment.

This is the `kernelEnv` analogue of
`nf_eq_fragment_mettaEval_root_bridge_alpha_mops`: the executable readout is
now harvested from the real control-flow-complete runtime, while the certified
root/contextual MOPS witnesses remain the already-banked kernel-core ones.
This is the exact runtime-facing package later `conv` control-flow lemmas
should consume instead of rebuilding the per-fragment `nf` cases by hand. -/
theorem nf_eq_fragment_mettaEval_root_bridge_alpha_mops_kernelEnv
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : NfEqFragmentReadout sig raw out) :
    ∃ rootOut rootCertified,
      rootOut ∈ (mettaEval kernelEnv 1 St.init [] (nfQuery sig raw)).1.map (·.1) ∧
        Relation.ReflTransGen (Metta.MopsStep kernelCoreRules)
          (nfQuery sig raw) rootCertified ∧
        Metta.AlphaEq rootOut rootCertified ∧
        Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules) rootCertified out := by
  cases h with
  | var k =>
      rcases nf_var_evalAtomMin_bridge_alpha_mops sig k with ⟨_hmem, hroot, halpha⟩
      let coreB : Metta.Bindings := nfVarRuleBindings sig k
      let lhs : Metta.Atom := nfVarRulePair.1
      let rhs : Metta.Atom := nfVarRulePair.2
      have hclosedB : ClosedValueBindings coreB := by
        exact ClosedValueBindings.val (by simp [mNat, Metta.Atom.vars])
          (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
      have hnodup : (bindingValueKeys coreB).Nodup := by
        dsimp [coreB, nfVarRuleBindings, bindingValueKeys]
        decide
      have hsplit :
          kernelEnv.candidates (nfQuery sig (.var k)) =
            [] ++ (lhs, rhs) ::
              [nfSrtRulePair, nfConRulePair, (nfPiRuleLhs, nfPiRuleRhs),
                nfLamRulePair, nfBadRulePair, nfIndGZeroIotaRulePair,
                nfDefRulePair] := by
        have hcand := kernelEnv_nf_var_candidates sig k
        have hstaticInit := candidatesW_init_eq_candidates kernelEnv (nfQuery sig (.var k))
        rw [hstaticInit] at hcand
        simpa [lhs, rhs, nfVarRulePair] using hcand
      have hmatchCore : coreB ∈ Metta.matchAtoms lhs (nfQuery sig (.var k)) := by
        simpa [coreB, lhs, nfVarRulePair] using
          (by
            rw [nf_var_rule_match]
            simp [nfVarRuleBindings] :
              nfVarRuleBindings sig k ∈
                Metta.matchAtoms (mExpr "nf" [mVar "sig", mExpr "Var" [mVar "k"]])
                  (nfQuery sig (.var k)))
      have hnotEmpty :
          (Metta.instantiate
            (renameBindings (counterSuffix St.init.counter) coreB).reverse
            (freshenRule St.init.counter lhs rhs).2 != emptyA) = true := by
        simpa [coreB, lhs, rhs] using
          nfVarRule_instantiated_rhs_ne_empty St.init.counter sig k
      have hreadout :
          Metta.instantiate
              (renameBindings (counterSuffix St.init.counter) coreB).reverse
              (freshenRule St.init.counter lhs rhs).2 =
            termAtom (.var k) := by
        simpa [coreB, lhs, rhs] using
          nfVarRule_instantiated_rhs_eq St.init.counter sig k
      have hnotFunction :
          isFunctionResult
            (Metta.instantiate
              (renameBindings (counterSuffix St.init.counter) coreB).reverse
              (freshenRule St.init.counter lhs rhs).2) = false := by
        rw [hreadout]
        simp [termAtom, mExpr, mSym, isFunctionResult]
      have hrun := nf_selected_rule_readout_mem_mettaEval_kernelEnv_state
        (st := St.init) (sig := sig) (raw := (.var k))
        (lhs := lhs) (rhs := rhs) (coreB := coreB)
        (pre := []) (post :=
          [nfSrtRulePair, nfConRulePair, (nfPiRuleLhs, nfPiRuleRhs),
            nfLamRulePair, nfBadRulePair, nfIndGZeroIotaRulePair, nfDefRulePair])
        kernelEnvTypeWorld_init rfl hclosedB hnodup hsplit hmatchCore hnotEmpty hnotFunction
        (by
          simp only [List.length_nil, Nat.add_zero]
          rw [hreadout]
          simp [termAtom, isEmbeddedOp, mExpr, mSym])
        (by
          simp only [List.length_nil, Nat.add_zero]
          rw [hreadout]
          exact termAtom_beq_notReducible_false (.var k))
        (by
          simp only [List.length_nil, Nat.add_zero]
          rw [hreadout]
          simp [nfQuery, termAtom, mExpr, mSym]
          rfl)
        (by
          simp only [List.length_nil, Nat.add_zero]
          rw [hreadout]
          exact termAtom_isError_false (.var k))
      exact ⟨_, termAtom (.var k), hrun, hroot, halpha, Relation.ReflTransGen.refl⟩
  | srt sort =>
      rcases nf_srt_evalAtomMin_bridge_alpha_mops sig sort with ⟨_hmem, hroot, halpha⟩
      let coreB : Metta.Bindings := nfSrtRuleBindings sig sort
      let lhs : Metta.Atom := nfSrtRulePair.1
      let rhs : Metta.Atom := nfSrtRulePair.2
      have hclosedB : ClosedValueBindings coreB := by
        exact ClosedValueBindings.val
          (by cases sort <;> unfold Metta.Atom.vars <;> rfl)
          (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
      have hnodup : (bindingValueKeys coreB).Nodup := by
        dsimp [coreB, nfSrtRuleBindings, bindingValueKeys]
        decide
      have hsplit :
          kernelEnv.candidates (nfQuery sig (.srt sort)) =
            [nfVarRulePair] ++ (lhs, rhs) ::
              [nfConRulePair, (nfPiRuleLhs, nfPiRuleRhs), nfLamRulePair,
                nfBadRulePair, nfIndGZeroIotaRulePair, nfDefRulePair] := by
        have hcand := kernelEnv_nf_srt_candidates sig sort
        have hstaticInit := candidatesW_init_eq_candidates kernelEnv (nfQuery sig (.srt sort))
        rw [hstaticInit] at hcand
        simpa [lhs, rhs, nfSrtRulePair] using hcand
      have hmatchCore : coreB ∈ Metta.matchAtoms lhs (nfQuery sig (.srt sort)) := by
        simpa [coreB, lhs, nfSrtRulePair] using
          (by
            rw [nf_srt_rule_match]
            simp [nfSrtRuleBindings] :
              nfSrtRuleBindings sig sort ∈
                Metta.matchAtoms (mExpr "nf" [mVar "sig", mExpr "Srt" [mVar "s"]])
                  (nfQuery sig (.srt sort)))
      have hnotEmpty :
          (Metta.instantiate
            (renameBindings
              (counterSuffix (St.init.counter + [nfVarRulePair].length)) coreB).reverse
            (freshenRule (St.init.counter + [nfVarRulePair].length) lhs rhs).2 !=
              emptyA) = true := by
        simpa [coreB, lhs, rhs] using
          nfSrtRule_instantiated_rhs_ne_empty
            (St.init.counter + [nfVarRulePair].length) sig sort
      have hreadout :
          Metta.instantiate
              (renameBindings
                (counterSuffix (St.init.counter + [nfVarRulePair].length)) coreB).reverse
              (freshenRule (St.init.counter + [nfVarRulePair].length) lhs rhs).2 =
            termAtom (.srt sort) := by
        simpa [coreB, lhs, rhs] using
          nfSrtRule_instantiated_rhs_eq
            (St.init.counter + [nfVarRulePair].length) sig sort
      have hnotFunction :
          isFunctionResult
            (Metta.instantiate
              (renameBindings (counterSuffix (St.init.counter + [nfVarRulePair].length)) coreB).reverse
              (freshenRule (St.init.counter + [nfVarRulePair].length) lhs rhs).2) = false := by
        rw [hreadout]
        simp [termAtom, sortAtom, mExpr, mSym, isFunctionResult]
      have hrun := nf_selected_rule_readout_mem_mettaEval_kernelEnv_state
        (st := St.init) (sig := sig) (raw := (.srt sort))
        (lhs := lhs) (rhs := rhs) (coreB := coreB)
        (pre := [nfVarRulePair]) (post :=
          [nfConRulePair, (nfPiRuleLhs, nfPiRuleRhs), nfLamRulePair,
            nfBadRulePair, nfIndGZeroIotaRulePair, nfDefRulePair])
        kernelEnvTypeWorld_init rfl hclosedB hnodup hsplit hmatchCore hnotEmpty hnotFunction
        (by
          rw [hreadout]
          simp [termAtom, sortAtom, isEmbeddedOp, mExpr, mSym])
        (by
          rw [hreadout]
          exact termAtom_beq_notReducible_false (.srt sort))
        (by
          rw [hreadout]
          simp [nfQuery, termAtom, sortAtom, mExpr, mSym]
          rfl)
        (by
          rw [hreadout]
          exact termAtom_isError_false (.srt sort))
      exact ⟨_, termAtom (.srt sort), hrun, hroot, halpha, Relation.ReflTransGen.refl⟩
  | con name =>
      rcases nf_con_evalAtomMin_bridge_alpha_mops sig name with ⟨_hmem, hroot, halpha⟩
      let coreB : Metta.Bindings := nfConRuleBindings sig name
      let lhs : Metta.Atom := nfConRulePair.1
      let rhs : Metta.Atom := nfConRulePair.2
      have hclosedB : ClosedValueBindings coreB := by
        exact ClosedValueBindings.val
          (by unfold Metta.Atom.vars; rfl)
          (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
      have hnodup : (bindingValueKeys coreB).Nodup := by
        dsimp [coreB, nfConRuleBindings, bindingValueKeys]
        decide
      have hsplit :
          kernelEnv.candidates (nfQuery sig (.con name)) =
            [nfVarRulePair, nfSrtRulePair] ++ (lhs, rhs) ::
              [(nfPiRuleLhs, nfPiRuleRhs), nfLamRulePair, nfBadRulePair,
                nfIndGZeroIotaRulePair, nfDefRulePair] := by
        have hcand := kernelEnv_nf_con_candidates sig name
        have hstaticInit := candidatesW_init_eq_candidates kernelEnv (nfQuery sig (.con name))
        rw [hstaticInit] at hcand
        simpa [lhs, rhs, nfConRulePair] using hcand
      have hmatchCore : coreB ∈ Metta.matchAtoms lhs (nfQuery sig (.con name)) := by
        simpa [coreB, lhs, nfConRulePair] using
          (by
            rw [nf_con_rule_match]
            simp [nfConRuleBindings] :
              nfConRuleBindings sig name ∈
                Metta.matchAtoms (mExpr "nf" [mVar "sig", mExpr "Con" [mVar "x"]])
                  (nfQuery sig (.con name)))
      have hnotEmpty :
          (Metta.instantiate
            (renameBindings (counterSuffix (St.init.counter + 2)) coreB).reverse
            (freshenRule (St.init.counter + 2) lhs rhs).2 != emptyA) = true := by
        simpa [coreB, lhs, rhs] using
          nfConRule_instantiated_rhs_ne_empty (St.init.counter + 2) sig name
      have hreadout :
          Metta.instantiate
              (renameBindings (counterSuffix (St.init.counter + 2)) coreB).reverse
              (freshenRule (St.init.counter + 2) lhs rhs).2 =
            termAtom (.con name) := by
        simpa [coreB, lhs, rhs] using
          nfConRule_instantiated_rhs_eq (St.init.counter + 2) sig name
      have hnotFunction :
          isFunctionResult
            (Metta.instantiate
              (renameBindings (counterSuffix (St.init.counter + 2)) coreB).reverse
              (freshenRule (St.init.counter + 2) lhs rhs).2) = false := by
        rw [hreadout]
        simp [termAtom, declNameAtom, mExpr, mSym, isFunctionResult]
      have hrun := nf_selected_rule_readout_mem_mettaEval_kernelEnv_state
        (st := St.init) (sig := sig) (raw := (.con name))
        (lhs := lhs) (rhs := rhs) (coreB := coreB)
        (pre := [nfVarRulePair, nfSrtRulePair])
        (post := [(nfPiRuleLhs, nfPiRuleRhs), nfLamRulePair, nfBadRulePair,
          nfIndGZeroIotaRulePair, nfDefRulePair])
        kernelEnvTypeWorld_init rfl hclosedB hnodup hsplit hmatchCore hnotEmpty hnotFunction
        (by
          simp only [List.length_cons, List.length_nil]
          rw [hreadout]
          simp [termAtom, declNameAtom, isEmbeddedOp, mExpr, mSym])
        (by
          simp only [List.length_cons, List.length_nil]
          rw [hreadout]
          exact termAtom_beq_notReducible_false (.con name))
        (by
          simp only [List.length_cons, List.length_nil]
          rw [hreadout]
          simp [nfQuery, termAtom, declNameAtom, mExpr, mSym]
          rfl)
        (by
          simp only [List.length_cons, List.length_nil]
          rw [hreadout]
          exact termAtom_isError_false (.con name))
      exact ⟨_, termAtom (.con name), hrun, hroot, halpha, Relation.ReflTransGen.refl⟩
  | bad reason =>
      rcases nf_bad_evalAtomMin_bridge_alpha_mops sig reason with ⟨_hmem, hroot, halpha⟩
      let coreB : Metta.Bindings := nfBadRuleBindings sig reason
      let lhs : Metta.Atom := nfBadRulePair.1
      let rhs : Metta.Atom := nfBadRulePair.2
      let pre : List (Metta.Atom × Metta.Atom) := nfLamCandidatePre ++ [nfLamRulePair]
