private theorem list_map_eq_self_of_forall {α : Type} {f : α → α} :
    ∀ {xs : List α}, (∀ x ∈ xs, f x = x) → xs.map f = xs
  | [], _ => rfl
  | x :: xs, h => by
      simp [h x (by simp), list_map_eq_self_of_forall (xs := xs) (by
        intro y hy
        exact h y (by simp [hy]))]

/-- The initial empty world has no state cells, so wrapping state handles is identity. -/
theorem wrapStates_init_world_eq_self (a : Metta.Atom) :
    wrapStates St.init.world a = a := by
  fun_induction wrapStates St.init.world a
  case case1 id v h =>
    simp [St.init, World.empty] at h
  case case2 id h =>
    rfl
  case case3 xs h ih =>
    exact congrArg Atom.expr (list_map_eq_self_of_forall (xs := xs) ih)
  case case4 a h1 h2 =>
    rfl

/-- In the initial empty world, type-preparation does not change atoms. -/
theorem typePrep_init_world_eq_self (a : Metta.Atom) :
    typePrep St.init.world a = a := by
  rw [typePrep, subTokens_init_world_eq_self, wrapStates_init_world_eq_self]

/-- Runtime type-checking succeeds for one argument declared as `Atom`. -/
theorem typeCheckArgs_one_atom
    (env : MinEnv) (w : World) (a : Metta.Atom) :
    typeCheckArgs env w [Metta.Atom.sym "Atom"] 0 [] [a] = none := by
  simp only [typeCheckArgs]
  obtain ⟨ta, tla, ha⟩ :=
    List.exists_cons_of_ne_nil (getTypes_ne_nil env (typePrep w a))
  rw [ha]
  simp [instantiate_nil, matchType_atom_left]

private theorem instantiate_mSym_atom (tb : Metta.Bindings) :
    Metta.instantiate tb (mSym "Atom") = mSym "Atom" := by
  unfold Metta.instantiate Metta.Subst.apply
  rfl

private theorem instantiate_mSym (tb : Metta.Bindings) (s : String) :
    Metta.instantiate tb (mSym s) = mSym s := by
  unfold Metta.instantiate Metta.Subst.apply
  rfl

private theorem matchType_instantiated_atom_left
    (tb : Metta.Bindings) (actual : Metta.Atom) :
    matchType tb (Metta.instantiate tb (mSym "Atom")) actual = some tb := by
  rw [instantiate_mSym_atom]
  exact matchType_atom_left tb actual

private theorem findSome?_some_of_mem_some
    {α β : Type} {f : α → Option β} {xs : List α} {x : α} {y : β}
    (hx : x ∈ xs) (hf : f x = some y) :
    ∃ z, xs.findSome? f = some z := by
  induction xs with
  | nil => cases hx
  | cons a as ih =>
      cases hx with
      | head => exact ⟨y, by simp [List.findSome?, hf]⟩
      | tail _ hxas =>
          by_cases ha : ∃ z, f a = some z
          · rcases ha with ⟨z, hz⟩
            exact ⟨z, by simp [List.findSome?, hz]⟩
          · have hnone : f a = none := by
              cases hfa : f a with
              | none => rfl
              | some z => exact False.elim (ha ⟨z, hfa⟩)
            rcases ih hxas with ⟨z, hz⟩
            exact ⟨z, by simp [List.findSome?, hnone, hz]⟩

private theorem findSome?_head_some
    {α β : Type} (f : α → Option β) (x : α) (xs : List α) (y : β)
    (hf : f x = some y) :
    (x :: xs).findSome? f = some y := by
  simp [List.findSome?, hf]

private theorem typeCheckArgs_bool_atom_atom_of_bool_mem
    (env : MinEnv) (w : World) (cond thenA elseA : Metta.Atom)
    (hBool : mSym "Bool" ∈ getTypes env (typePrep w cond)) :
    typeCheckArgs env w [mSym "Bool", mSym "Atom", mSym "Atom"] 0 []
      [cond, thenA, elseA] = none := by
  have hmatchBool : matchType ([] : Metta.Bindings) (mSym "Bool") (mSym "Bool") = some [] := by
    simp [matchType, matchReduced, Metta.matchAtoms, Metta.matchAtomsWith, mSym,
      Metta.Bindings.merge]
  rcases findSome?_some_of_mem_some (xs := getTypes env (typePrep w cond))
      (x := mSym "Bool") (y := (mSym "Bool", ([] : Metta.Bindings)))
      (f := fun act =>
        (matchType ([] : Metta.Bindings) (mSym "Bool") act).map (Prod.mk act))
      hBool (by simp [hmatchBool]) with ⟨first, hfirst⟩
  simp only [typeCheckArgs]
  simp only [List.getElem?_cons_zero, List.getElem?_cons_succ,
    Nat.reduceAdd, Metta.instantiate_nil]
  rw [hfirst]
  cases first with
  | mk actualCond tb1 =>
      simp
      obtain ⟨tt, tlt, ht⟩ :=
        List.exists_cons_of_ne_nil (getTypes_ne_nil env (typePrep w thenA))
      rw [ht]
      have hThenHead :
          (fun act => Option.map (Prod.mk act)
            (matchType tb1 (Metta.instantiate tb1 (mSym "Atom")) act)) tt =
            some (tt, tb1) := by
        simp [matchType_instantiated_atom_left]
      rw [findSome?_head_some _ tt tlt (tt, tb1) hThenHead]
      simp
      obtain ⟨te, tle, he⟩ :=
        List.exists_cons_of_ne_nil (getTypes_ne_nil env (typePrep w elseA))
      rw [he]
      have hElseHead :
          (fun act => Option.map (Prod.mk act)
            (matchType tb1 (Metta.instantiate tb1 (mSym "Atom")) act)) te =
            some (te, tb1) := by
        simp [matchType_instantiated_atom_left]
      rw [findSome?_head_some _ te tle (te, tb1) hElseHead]

private theorem typeCheckArgs_atom_undefined_atom
    (env : MinEnv) (w : World) (pattern atom template : Metta.Atom) :
    typeCheckArgs env w [mSym "Atom", mSym "%Undefined%", mSym "Atom"] 0 []
      [pattern, atom, template] = none := by
  simp only [typeCheckArgs, List.getElem?_cons_zero, List.getElem?_cons_succ,
    Nat.reduceAdd, Metta.instantiate_nil]
  obtain ⟨tp, tlp, hp⟩ :=
    List.exists_cons_of_ne_nil (getTypes_ne_nil env (typePrep w pattern))
  rw [hp]
  have hPatHead :
      (fun act => Option.map (Prod.mk act)
        (matchType ([] : Metta.Bindings) (mSym "Atom") act)) tp =
        some (tp, ([] : Metta.Bindings)) := by
    simpa [mSym] using
      (matchType_atom_left ([] : Metta.Bindings) tp)
  rw [findSome?_head_some _ tp tlp (tp, ([] : Metta.Bindings)) hPatHead]
  simp
  obtain ⟨ta, tla, ha⟩ :=
    List.exists_cons_of_ne_nil (getTypes_ne_nil env (typePrep w atom))
  rw [ha]
  have hAtomHead :
      (fun act => Option.map (Prod.mk act)
        (matchType ([] : Metta.Bindings)
          (Metta.instantiate ([] : Metta.Bindings) (mSym "%Undefined%")) act)) ta =
        some (ta, ([] : Metta.Bindings)) := by
    simpa [mSym, Metta.instantiate, Metta.Subst.apply] using
      (matchType_undefined_left ([] : Metta.Bindings) ta)
  rw [findSome?_head_some _ ta tla (ta, ([] : Metta.Bindings)) hAtomHead]
  simp
  obtain ⟨tt, tlt, ht⟩ :=
    List.exists_cons_of_ne_nil (getTypes_ne_nil env (typePrep w template))
  rw [ht]
  have hTemplHead :
      (fun act => Option.map (Prod.mk act)
        (matchType ([] : Metta.Bindings)
          (Metta.instantiate ([] : Metta.Bindings) (mSym "Atom")) act)) tt =
        some (tt, ([] : Metta.Bindings)) := by
    simpa [mSym, Metta.instantiate, Metta.Subst.apply] using
      (matchType_atom_left ([] : Metta.Bindings) tt)
  rw [findSome?_head_some _ tt tlt (tt, ([] : Metta.Bindings)) hTemplHead]

