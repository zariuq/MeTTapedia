        (evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom]))).1 =
        [embedded] := by
    simpa [embedded] using congrArg Prod.fst
      (interpretStack1_eval_embedded_unify_open_of_gt
        env (fuel + 1) st atom pattern template elseAtom hgt)
  have hfirstNonfinal : isFinal embedded = false := by
    simp [embedded, isFinal, atomToStack, mExpr, mSym]
  have hdriver :
      interpretFuel env (fuel + 2) st
        [evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom])] [] =
      interpretFuel env (fuel + 1)
        (interpretStack1 env (fuel + 1) st
          (evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom]))).2
        [embedded] [] := by
    simpa [Nat.add_assoc] using
      interpretFuel_single_of_interpretStack1_results_single_nonfinal
        env (fuel + 1) st
        (evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom]))
        embedded hfirstResults hfirstNonfinal
  have hstate :
      (interpretStack1 env (fuel + 1) st
        (evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom]))).2 = st := by
    simpa using congrArg Prod.snd
      (interpretStack1_eval_embedded_unify_open_of_gt
        env (fuel + 1) st atom pattern template elseAtom hgt)
  have hstack :
      interpretStack1 env fuel st embedded =
        ([finItem [] elseAtom []], st) := by
    simpa [embedded, atomToStack, mExpr, mSym] using
      interpretStack1_unify_fallback_eq_of_matchAtoms_nil
        env fuel st [] atom pattern template elseAtom [] hmatch
  rw [hdriver, hstate]
  simp [interpretFuel, hstack, finItem, isFinal, finalPair, Metta.instantiate_nil, hnotEmpty]

/-- Exact fuel-driver lift for embedded `unify` when the local matcher has no results.

This is the exact-state form of `interpretFuel_eval_embedded_unify_fallback_contains`: the
embedded `unify` frame opens, takes its explicit else branch, is harvested as a final item, and
preserves the threaded state. -/
theorem interpretFuel_eval_embedded_unify_fallback_eq
    (fuel : Nat) (st : St)
    (atom pattern template elseAtom : Metta.Atom)
    (hmatch : Metta.matchAtoms atom pattern = [])
    (hnotEmpty : (elseAtom != emptyA) = true) :
    interpretFuel kernelCoreEnv (fuel + 2) st
        [evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom])] [] =
      ([(elseAtom, [])], st) := by
  let embedded : Item :=
    { stack := atomToStack
        (mExpr "unify" [atom, pattern, template, elseAtom]) [],
      bnd := [] }
  have hfirstResults :
      (interpretStack1 kernelCoreEnv (fuel + 1) st
        (evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom]))).1 =
        [embedded] := by
    simpa [embedded] using congrArg Prod.fst
      (interpretStack1_eval_embedded_unify_open
        (fuel + 1) st atom pattern template elseAtom)
  have hfirstNonfinal : isFinal embedded = false := by
    simp [embedded, isFinal, atomToStack, mExpr, mSym]
  have hdriver :
      interpretFuel kernelCoreEnv (fuel + 2) st
        [evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom])] [] =
      interpretFuel kernelCoreEnv (fuel + 1)
        (interpretStack1 kernelCoreEnv (fuel + 1) st
          (evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom]))).2
        [embedded] [] := by
    simpa [Nat.add_assoc] using
      interpretFuel_single_of_interpretStack1_results_single_nonfinal
        kernelCoreEnv (fuel + 1) st
        (evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom]))
        embedded hfirstResults hfirstNonfinal
  have hstate :
      (interpretStack1 kernelCoreEnv (fuel + 1) st
        (evalItemNil (mExpr "unify" [atom, pattern, template, elseAtom]))).2 = st := by
    simpa using congrArg Prod.snd
      (interpretStack1_eval_embedded_unify_open
        (fuel + 1) st atom pattern template elseAtom)
  have hstack :
      interpretStack1 kernelCoreEnv fuel st embedded =
        ([finItem [] elseAtom []], st) := by
    simpa [embedded, atomToStack, mExpr, mSym] using
      interpretStack1_unify_fallback_eq_of_matchAtoms_nil
        kernelCoreEnv fuel st [] atom pattern template elseAtom [] hmatch
  rw [hdriver, hstate]
  simp [interpretFuel, hstack, finItem, isFinal, finalPair, Metta.instantiate_nil, hnotEmpty]

/-- Environment-generic, binding-threaded exact fuel-driver lift for embedded
`unify` fallback.  The grounding-table hypothesis is the only environment
dependency; rule storage is irrelevant after embedded dispatch. -/
theorem interpretFuel_eval_embedded_unify_fallback_eq_of_gt_instantiate
    (env : MinEnv) (fuel : Nat) (st : St) (b : Metta.Bindings)
    (atom pattern template elseAtom : Metta.Atom)
    (hgt : env.gt = stdGroundings)
    (hinst : Metta.instantiate b
        (mExpr "unify" [atom, pattern, template, elseAtom]) =
      mExpr "unify" [atom, pattern, template, elseAtom])
    (hmatch : Metta.matchAtoms atom pattern = [])
    (hnotEmpty : (Metta.instantiate b elseAtom != emptyA) = true) :
    interpretFuel env (fuel + 2) st
        [evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom])] [] =
      ([(Metta.instantiate b elseAtom, b)], st) := by
  have hfirstResults :
      (interpretStack1 env (fuel + 1) st
        (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))).1 =
        [embeddedUnifyItem b atom pattern template elseAtom] := by
    simpa using congrArg Prod.fst
      (interpretStack1_eval_embedded_unify_open_of_gt_instantiate
        env (fuel + 1) st b atom pattern template elseAtom hgt hinst)
  have hfirstNonfinal :
      isFinal (embeddedUnifyItem b atom pattern template elseAtom) = false := by
    simp [embeddedUnifyItem, isFinal, atomToStack, mExpr, mSym]
  have hdriver :
      interpretFuel env (fuel + 2) st
          [evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom])] [] =
        interpretFuel env (fuel + 1)
          (interpretStack1 env (fuel + 1) st
            (evalItemBnd b
              (mExpr "unify" [atom, pattern, template, elseAtom]))).2
          [embeddedUnifyItem b atom pattern template elseAtom] [] := by
    simpa [Nat.add_assoc] using
      interpretFuel_single_of_interpretStack1_results_single_nonfinal
        env (fuel + 1) st
        (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))
        (embeddedUnifyItem b atom pattern template elseAtom)
        hfirstResults hfirstNonfinal
  have hstate :
      (interpretStack1 env (fuel + 1) st
        (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))).2 = st := by
    simpa using congrArg Prod.snd
      (interpretStack1_eval_embedded_unify_open_of_gt_instantiate
        env (fuel + 1) st b atom pattern template elseAtom hgt hinst)
  have hstack :
      interpretStack1 env fuel st
          (embeddedUnifyItem b atom pattern template elseAtom) =
        ([finItem [] elseAtom b], st) := by
    simpa [embeddedUnifyItem, atomToStack, mExpr, mSym] using
      interpretStack1_unify_fallback_eq_of_matchAtoms_nil
        env fuel st [] atom pattern template elseAtom b hmatch
  rw [hdriver, hstate]
  simp [interpretFuel, hstack, finItem, isFinal, finalPair, hnotEmpty]

/-- Binding-threaded exact fuel-driver lift for embedded `unify` fallback.

The result keeps the current bindings, and `finalPair` applies them once to the explicit else atom.
For Boolean else branches this final instantiation is definitionally inert. -/
theorem interpretFuel_eval_embedded_unify_fallback_eq_of_instantiate
    (fuel : Nat) (st : St) (b : Metta.Bindings)
    (atom pattern template elseAtom : Metta.Atom)
    (hinst : Metta.instantiate b (mExpr "unify" [atom, pattern, template, elseAtom]) =
      mExpr "unify" [atom, pattern, template, elseAtom])
    (hmatch : Metta.matchAtoms atom pattern = [])
    (hnotEmpty : (Metta.instantiate b elseAtom != emptyA) = true) :
    interpretFuel kernelCoreEnv (fuel + 2) st
        [evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom])] [] =
      ([(Metta.instantiate b elseAtom, b)], st) := by
  have hfirstResults :
      (interpretStack1 kernelCoreEnv (fuel + 1) st
        (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))).1 =
        [embeddedUnifyItem b atom pattern template elseAtom] := by
    simpa using congrArg Prod.fst
      (interpretStack1_eval_embedded_unify_open_of_instantiate
        (fuel + 1) st b atom pattern template elseAtom hinst)
  have hfirstNonfinal :
      isFinal (embeddedUnifyItem b atom pattern template elseAtom) = false := by
    simp [embeddedUnifyItem, isFinal, atomToStack, mExpr, mSym]
  have hdriver :
      interpretFuel kernelCoreEnv (fuel + 2) st
        [evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom])] [] =
      interpretFuel kernelCoreEnv (fuel + 1)
        (interpretStack1 kernelCoreEnv (fuel + 1) st
          (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))).2
        [embeddedUnifyItem b atom pattern template elseAtom] [] := by
    simpa [Nat.add_assoc] using
      interpretFuel_single_of_interpretStack1_results_single_nonfinal
        kernelCoreEnv (fuel + 1) st
        (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))
        (embeddedUnifyItem b atom pattern template elseAtom) hfirstResults hfirstNonfinal
  have hstate :
      (interpretStack1 kernelCoreEnv (fuel + 1) st
        (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))).2 = st := by
    simpa using congrArg Prod.snd
      (interpretStack1_eval_embedded_unify_open_of_instantiate
        (fuel + 1) st b atom pattern template elseAtom hinst)
  have hstack :
      interpretStack1 kernelCoreEnv fuel st
          (embeddedUnifyItem b atom pattern template elseAtom) =
        ([finItem [] elseAtom b], st) := by
    simpa [embeddedUnifyItem, atomToStack, mExpr, mSym] using
      interpretStack1_unify_fallback_eq_of_matchAtoms_nil
        kernelCoreEnv fuel st [] atom pattern template elseAtom b hmatch
  rw [hdriver, hstate]
  simp [interpretFuel, hstack, finItem, isFinal, finalPair, hnotEmpty]

/-- Full `mettaEval` lift for embedded `unify` fallback.

This is the open-pattern version needed by `is-bad`: the pattern argument may contain a matcher
variable such as `(Bad $e)`, but if all four arguments evaluate to singleton empty-binding readouts
and the embedded matcher has no results, the whole executable call evaluates along the explicit
else branch. -/
theorem mettaEval_embedded_unify_fallback_of_arg_singletons
    (fuel : Nat) (st st₁ st₂ st₃ st₄ : St)
    (atom pattern template elseAtom atom' pattern' template' elseAtom' final : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelCoreEnv st.world "unify"
      [.sym "%Undefined%"])
    (hAtom : mettaEval kernelCoreEnv (fuel + 1) st [] atom = ([(atom', [])], st₁))
    (hPattern :
      mettaEval kernelCoreEnv (fuel + 1) st₁ [] pattern = ([(pattern', [])], st₂))
    (hTemplate :
      mettaEval kernelCoreEnv (fuel + 1) st₂ [] template = ([(template', [])], st₃))
    (hElse :
      mettaEval kernelCoreEnv (fuel + 1) st₃ [] elseAtom = ([(elseAtom', [])], st₄))
    (hNoErr :
      (([atom', pattern', template', elseAtom'].zip [atom, pattern, template, elseAtom]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hmatch : Metta.matchAtoms atom' pattern' = [])
    (hnotEmpty : (elseAtom' != emptyA) = true)
    (hRootNotNotReducible : (elseAtom' == notReducibleA) = false)
    (hRootNotSelf : (elseAtom' == mExpr "unify" [atom', pattern', template', elseAtom']) = false)
    (hFinal : ∀ st0, (final, []) ∈ (mettaEval kernelCoreEnv (fuel + 1) st0 [] elseAtom').1)
    (hFinalNotError : final.isError = false) :
    (final, []) ∈
      (mettaEval kernelCoreEnv (fuel + 2) st []
        (mExpr "unify" [atom, pattern, template, elseAtom])).1 := by
  exact
    mettaEval_quaternary_expr_mem_of_arg_singletons_and_empty_root_eval_member_of_exactPolicy
      (env := kernelCoreEnv) (fuel := fuel + 1) (st := st) (st₁ := st₁) (st₂ := st₂)
      (st₃ := st₃) (st₄ := st₄) (op := "unify")
      (w := atom) (x := pattern) (y := template) (z := elseAtom)
      (w' := atom') (x' := pattern') (y' := template') (z' := elseAtom')
      (root := elseAtom') (final := final)
      (mask := [true, true, true, true]) (returnAtom := false)
      (by decide) hAtom hPattern hTemplate hElse
      (kernelCoreEnv_unify_recursionNeutralPolicy st atom pattern template elseAtom hPinned)
      rfl hNoErr
      (interpretFuel_eval_embedded_unify_fallback_contains
        (fuel := fuel) (st := st₄) atom' pattern' template' elseAtom' hmatch hnotEmpty)
      hRootNotNotReducible hRootNotSelf
      rfl
      hFinal hFinalNotError

/-- Core-slice `mettaEval` lift for embedded `unify` success against a binder variable.

This is the success-branch sibling of
`mettaEval_embedded_unify_fallback_of_arg_singletons`.  It factors out the
outer scheduler work for `(unify atom $binder template Empty)`: the four
arguments are evaluated, the embedded `unify` frame succeeds, and the root
readout is recursively evaluated under the binding that LeaTTa actually
threads.  The theorem intentionally exposes that binding instead of replacing
it by an empty-binding shortcut; later `let`/`conv` lemmas are responsible for
showing that the local binder is consumed hygienically.

This theorem is intentionally about `kernelCoreEnv`, where embedded `unify` has
no control signature and all four arguments are evaluated.  Full executable
`conv` runs over `kernelEnv`, whose explicit control slice declares
`unify : Atom -> Atom -> Atom -> Atom -> %Undefined%`; that signature quotes the
arguments and must be handled by a separate `kernelEnv` control-flow lift. -/
theorem mettaEval_embedded_unify_var_success_of_arg_singletons
    (fuel : Nat) (st st₁ st₂ st₃ st₄ : St)
    (binder : String)
    (atom template atom' pattern' template' elseAtom' final : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelCoreEnv st.world "unify"
      [.sym "%Undefined%"])
    (hAtom : mettaEval kernelCoreEnv (fuel + 1) st [] atom = ([(atom', [])], st₁))
    (hPattern :
      mettaEval kernelCoreEnv (fuel + 1) st₁ [] (mVar binder) = ([(pattern', [])], st₂))
    (hPatternEq : pattern' = mVar binder)
    (hTemplate :
      mettaEval kernelCoreEnv (fuel + 1) st₂ [] template = ([(template', [])], st₃))
    (hElse :
      mettaEval kernelCoreEnv (fuel + 1) st₃ [] (mSym "Empty") = ([(elseAtom', [])], st₄))
    (hElseEq : elseAtom' = mSym "Empty")
    (hNoErr :
      (([atom', pattern', template', elseAtom'].zip
          [atom, mVar binder, template, mSym "Empty"]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hAtomNonVar : ∀ w, atom' ≠ Metta.Atom.var w)
    (hNoLoop : binder ∉ atom'.vars)
    (hnotEmpty :
      (Metta.instantiate [Metta.BindingRel.val binder atom']
        (Metta.instantiate [Metta.BindingRel.val binder atom'] template') != emptyA) = true)
    (hRootNotNotReducible :
      (Metta.instantiate [Metta.BindingRel.val binder atom']
        (Metta.instantiate [Metta.BindingRel.val binder atom'] template') == notReducibleA) =
        false)
    (hRootNotSelf :
      (Metta.instantiate [Metta.BindingRel.val binder atom']
        (Metta.instantiate [Metta.BindingRel.val binder atom'] template') ==
          mExpr "unify" [atom', mVar binder, template', elseAtom']) = false)
    (hFinal : ∀ st0,
      (final, []) ∈
        (mettaEval kernelCoreEnv (fuel + 1) st0
          (restrictBnd (([atom, mVar binder, template, mSym "Empty"]).flatMap Metta.Atom.vars)
            ((Metta.Bindings.merge [] [Metta.BindingRel.val binder atom']).head?.getD
              [Metta.BindingRel.val binder atom']))
          (Metta.instantiate [Metta.BindingRel.val binder atom']
            (Metta.instantiate [Metta.BindingRel.val binder atom'] template'))).1)
    (hFinalNotError : final.isError = false) :
    (final,
      restrictBnd (([atom, mVar binder, template, mSym "Empty"]).flatMap Metta.Atom.vars)
        (((restrictBnd (([atom, mVar binder, template, mSym "Empty"]).flatMap Metta.Atom.vars)
            ((Metta.Bindings.merge [] [Metta.BindingRel.val binder atom']).head?.getD
              [Metta.BindingRel.val binder atom'])).merge ([] : Metta.Bindings)).head?.getD [])) ∈
      (mettaEval kernelCoreEnv (fuel + 2) st []
        (mExpr "unify" [atom, mVar binder, template, mSym "Empty"])).1 := by
  subst hPatternEq
  subst hElseEq
  exact
    mettaEval_quaternary_expr_mem_of_arg_singletons_and_open_root_eval_member_of_exactPolicy
      (env := kernelCoreEnv) (fuel := fuel + 1) (st := st) (st₁ := st₁) (st₂ := st₂)
      (st₃ := st₃) (st₄ := st₄) (op := "unify")
      (w := atom) (x := mVar binder) (y := template) (z := mSym "Empty")
      (w' := atom') (x' := mVar binder) (y' := template') (z' := mSym "Empty")
      (root := Metta.instantiate [Metta.BindingRel.val binder atom']
        (Metta.instantiate [Metta.BindingRel.val binder atom'] template'))
      (final := final) (rootBnd := [Metta.BindingRel.val binder atom'])
      (mask := [true, true, true, true]) (returnAtom := false)
      (by decide) hAtom hPattern hTemplate hElse
      (kernelCoreEnv_unify_recursionNeutralPolicy st atom (mVar binder) template
        (mSym "Empty") hPinned)
      rfl hNoErr
      (by
        simpa [Nat.add_assoc, mExpr, mSym] using
          (interpretFuel_eval_embedded_unify_var_success_contains
            (fuel := fuel) (st := st₄) binder atom' template' hAtomNonVar hNoLoop hnotEmpty))
      hRootNotNotReducible hRootNotSelf
      rfl
      hFinal hFinalNotError

def evaluator : DIndGArtifactEvaluator where
  nf sig rawTerm rawNf :=
    ∃ fuel,
      ((mettaEval kernelDefControlEnv (fuel + 1) St.init []
          (nfQuery sig rawTerm)).1.map (·.1)).any
        (fun a => a == termAtom rawNf) = true
  infer sig rawTerm rawType :=
    termAtom rawType ∈
      (mettaEval kernelCoreEnv 1 St.init [] (inferQuery sig rawTerm)).1.map (·.1)
  conv sig rawLeft rawRight :=
    ∃ fuel,
      ((mettaEval kernelDefControlEnv (fuel + 1) St.init []
          (convQuery sig rawLeft rawRight)).1.map (·.1)).any
        (fun a => a == mBool true) = true

/-- Any runtime environment with LeaTTa's standard grounding table leaves `conv` calls to the
equality-rule query path. -/
theorem callGrounded_conv_of_stdGroundings
    (env : MinEnv) (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm)
    (hgt : env.gt = stdGroundings) :
    callGrounded env.gt "conv"
        ([sigAtom sig, termAtom rawLeft, termAtom rawRight].map
          (fun a => resolveStates St.init.world (subTokens St.init.world a))) =
      ReduceResult.noReduce := by
  rw [hgt]
  simp [callGrounded, GroundingTable.lookup, stdGroundings, Metta.Builtins.table,
    Metta.Builtins.mathTable]

/-- The kernel runtime leaves `conv` calls to the equality-rule query path. -/
theorem kernelCoreEnv_callGrounded_conv
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    callGrounded kernelCoreEnv.gt "conv"
        ([sigAtom sig, termAtom rawLeft, termAtom rawRight].map
          (fun a => resolveStates St.init.world (subTokens St.init.world a))) =
      ReduceResult.noReduce := by
  exact callGrounded_conv_of_stdGroundings kernelCoreEnv sig rawLeft rawRight (by rfl)

/-- The stdlib-extended kernel runtime also leaves `conv` calls to the equality-rule query path.

This is the root-dispatch fact needed if full `conv` evaluation is run over `kernelEnv`
(`preludeAtoms ++ kernelCoreRules`) so the stdlib `let`/`if` rules are available after the
kernel's own `conv` rule fires. -/
theorem kernelEnv_callGrounded_conv
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    callGrounded kernelEnv.gt "conv"
        ([sigAtom sig, termAtom rawLeft, termAtom rawRight].map
          (fun a => resolveStates St.init.world (subTokens St.init.world a))) =
      ReduceResult.noReduce := by
  exact callGrounded_conv_of_stdGroundings kernelEnv sig rawLeft rawRight (by rfl)

