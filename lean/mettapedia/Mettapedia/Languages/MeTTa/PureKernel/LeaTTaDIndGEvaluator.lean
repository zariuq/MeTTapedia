  rw [mettaEval_eq_evaluateExpectedApplication_of_selected_after_instantiate
    env fuel st bnd
      (Metta.Atom.expr [Metta.Atom.sym op, cond, thenA, elseA])
      op [cond', thenA', elseA'] hInst (by simp [Metta.Atom.isError, hOpNotError])
      hPlan.plan hPlan.seedSingleton] at hmem
  have hmemRaw := mem_of_mem_prioritizeSemanticResults hmem
  rw [evaluateExpectedApplicationFrom_eq_factored] at hmemRaw
  rw [evaluateExpectedApplicationFromFactored_eq_selectedResultFold_of_argumentFold
    (fun nextSt nextBindings nextAtom nextExpected =>
      mettaEvalExpected env fuel nextSt nextBindings nextAtom nextExpected)
    (fun nextSt nextBindings nextAtom =>
      mettaEval env fuel nextSt nextBindings nextAtom)
    (fun nextSt application =>
      interpretFuel env (fuel + 1) nextSt
        [{ stack := atomToStack
            (Metta.Atom.expr [Metta.Atom.sym "eval", application]) [],
           bnd := bnd }] [])
    bnd st stCond op [cond', thenA', elseA'] hPlan.plan.selected
    [([condEval, thenA', elseA'], partBnd)] hArguments
    (by intro _; exact hPlan.resultExpected_eq)
    (mettaEvalExpected_undefined env fuel)] at hmemRaw
  rw [hPlan.returnIsAtom_eq] at hmemRaw
  simp only [List.foldl_cons, List.foldl_nil] at hmemRaw
  rw [selectedResultFoldStep_eq_mettaEvalExprPartFoldStep] at hmemRaw
  unfold mettaEvalExprPartFoldStep at hmemRaw
  rw [hNoErr] at hmemRaw
  simp only [List.nil_append] at hmemRaw
  rw [hRoot] at hmemRaw
  simp [mettaEvalExprRootFoldStep, hRootNotNotReducible, hRootNotSelf] at hmemRaw
  rcases hmemRaw with ⟨finalBnd, hFinal, _⟩
  exact ⟨finalBnd, hFinal⟩

/-- One live merge/projection preserves closed-value shape, and its public
keys are drawn only from the declared retention scope.  This is the reusable
state invariant needed when nested selected applications retain an ambient
theory without assuming a canonical list presentation. -/
private theorem retainedMerge_closed_keyed
    (scope : List Metta.VarName) (left right : Metta.Bindings)
    (binder : Metta.VarName)
    (hLeft : ClosedValueBindings left)
    (hRight : ClosedValueBindings right)
    (hScope : ∀ x, x ∈ scope → x = binder) :
    let retained :=
      restrictBnd scope
        ((Metta.Bindings.merge left right).head?.getD right)
    ClosedValueBindings retained ∧
      ∀ x, x ∈ bindingValueKeys retained → x = binder := by
  dsimp only
  let merged := (Metta.Bindings.merge left right).head?.getD right
  have hMerged : ClosedValueBindings merged := hLeft.mergeHeadGetD hRight
  have hRaw : ClosedValueBindings (restrictBndRaw scope merged) :=
    closedValueBindings_restrictBndRaw hMerged
  constructor
  · exact closedValueBindings_restrictBnd hMerged
  · intro x hx
    exact hScope x
      (bindingValueKeys_restrictBnd_subset scope merged hRaw x hx)

private theorem mettaEval_ternary_expr_mem_of_quoted_args_and_root_eval_eq_bnd
    (env : MinEnv) (fuel : Nat) (st stRoot : St)
    (op : String) (hOpNotError : op ≠ "Error")
    (x y z root final : Metta.Atom)
    (rootBnd finalBnd : Metta.Bindings)
    (hPolicy : QuotedBoolApplicationPolicy env st.world op [x, y, z])
    (hPlan : ApplicationPlanCorresponds []
      (.selected hPolicy.decision.selectedType hPolicy.selected_eq))
    (hNoErr :
      (([x, y, z].zip [x, y, z]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hRoot : interpretFuel env (fuel + 1) st
        [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y, z])] [] =
      ([(root, rootBnd)], stRoot))
    (hRootNotNotReducible : (root == notReducibleA) = false)
    (hRootNotSelf :
      (root == Metta.Atom.expr [Metta.Atom.sym op, x, y, z]) = false)
    (hFinal :
      (final, finalBnd) ∈
        (mettaEvalExpected env fuel stRoot
          (restrictBnd (([x, y, z]).flatMap Metta.Atom.vars)
            ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) root
          (mSym "Bool")).1)
    (hFinalNotError : final.isError = false) :
    (final,
        restrictBnd (([x, y, z]).flatMap Metta.Atom.vars)
          ((Metta.Bindings.merge
            (restrictBnd (([x, y, z]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd))
            finalBnd).head?.getD finalBnd)) ∈
      (mettaEval env (fuel + 1) st []
        (Metta.Atom.expr [Metta.Atom.sym op, x, y, z])).1 := by
  have hArgumentPolicies :
      argumentEvaluationPolicies hPolicy.decision.selectedType 3 =
        [(false, .sym "Atom"), (false, .sym "Atom"), (false, .sym "Atom")] := by
    simpa using hPolicy.argumentPolicies_eq
  rw [mettaEval_eq_evaluateExpectedApplication_of_selected
    env fuel st op [x, y, z] hPolicy.decision.selectedType
      (by simp [Metta.Atom.isError, hOpNotError]) hPolicy.selected_eq hPlan]
  simp only [evaluateExpectedApplication, evaluateExpectedApplicationFrom,
    hArgumentPolicies,
    List.length_cons, List.length_nil, Nat.reduceAdd,
    List.zip_cons_cons, List.zip_nil_right, Bool.false_eq_true, if_false,
    List.foldl_cons, List.foldl_nil]
  rcases ternaryArgumentRow_no_changed_errors x x y y z z hNoErr with
    ⟨hXNotChanged, hYNotChanged, hZNotChanged⟩
  simp [Metta.instantiate_nil, hXNotChanged, hYNotChanged, hZNotChanged]
  have hRoot' :
      interpretFuel env (fuel + 1) st
        [{ stack := atomToStack
            (Metta.Atom.expr [Metta.Atom.sym "eval",
              Metta.Atom.expr [Metta.Atom.sym op, x, y, z]]) [],
           bnd := [] }] [] =
      ([(root, rootBnd)], stRoot) := by
    simpa [evalItemNil] using hRoot
  rw [hRoot']
  simp [hRootNotNotReducible, hRootNotSelf,
    hPolicy.returnsAtom_selectedType_eq,
    hPolicy.resultExpected_eq]
  have hFinal' :
      (final, finalBnd) ∈
      (mettaEvalExpected env fuel stRoot
          (restrictBnd (x.vars ++ (y.vars ++ z.vars))
            ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) root
          (mSym "Bool")).1 := by
    simpa [mSym, List.flatMap] using hFinal
  apply mem_prioritizeSemanticResults_of_mem_of_not_error (hError := hFinalNotError)
  exact List.mem_map.mpr ⟨(final, finalBnd), hFinal', rfl⟩

private theorem mettaEval_ternary_expr_pair_mem_implies_root_eval_mem_of_quoted_args_and_root_eval_eq_bnd
    (env : MinEnv) (fuel : Nat) (st stRoot : St)
    (op : String) (hOpNotError : op ≠ "Error")
    (x y z root final : Metta.Atom)
    (rootBnd outBnd : Metta.Bindings)
    (hPolicy : QuotedBoolApplicationPolicy env st.world op [x, y, z])
    (hPlan : ApplicationPlanCorresponds []
      (.selected hPolicy.decision.selectedType hPolicy.selected_eq))
    (hNoErr :
      (([x, y, z].zip [x, y, z]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hRoot : interpretFuel env (fuel + 1) st
        [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y, z])] [] =
      ([(root, rootBnd)], stRoot))
    (hRootNotNotReducible : (root == notReducibleA) = false)
    (hRootNotSelf :
      (root == Metta.Atom.expr [Metta.Atom.sym op, x, y, z]) = false)
    (hmem :
      (final, outBnd) ∈
        (mettaEval env (fuel + 1) st []
          (Metta.Atom.expr [Metta.Atom.sym op, x, y, z])).1) :
    ∃ finalBnd,
      (final, finalBnd) ∈
        (mettaEvalExpected env fuel stRoot
          (restrictBnd (([x, y, z]).flatMap Metta.Atom.vars)
            ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) root
          (mSym "Bool")).1 := by
  have hArgumentPolicies :
      argumentEvaluationPolicies hPolicy.decision.selectedType 3 =
        [(false, .sym "Atom"), (false, .sym "Atom"), (false, .sym "Atom")] := by
    simpa using hPolicy.argumentPolicies_eq
  rw [mettaEval_eq_evaluateExpectedApplication_of_selected
    env fuel st op [x, y, z] hPolicy.decision.selectedType
      (by simp [Metta.Atom.isError, hOpNotError]) hPolicy.selected_eq hPlan] at hmem
  simp only [evaluateExpectedApplication, evaluateExpectedApplicationFrom,
    hArgumentPolicies,
    List.length_cons, List.length_nil, Nat.reduceAdd,
    List.zip_cons_cons, List.zip_nil_right, Bool.false_eq_true, if_false,
    List.foldl_cons, List.foldl_nil] at hmem
  rcases ternaryArgumentRow_no_changed_errors x x y y z z hNoErr with
    ⟨hXNotChanged, hYNotChanged, hZNotChanged⟩
  simp [Metta.instantiate_nil, hXNotChanged, hYNotChanged, hZNotChanged] at hmem
  have hRoot' :
      interpretFuel env (fuel + 1) st
        [{ stack := atomToStack
            (Metta.Atom.expr [Metta.Atom.sym "eval",
              Metta.Atom.expr [Metta.Atom.sym op, x, y, z]]) [],
           bnd := [] }] [] =
      ([(root, rootBnd)], stRoot) := by
    simpa [evalItemNil] using hRoot
  rw [hRoot'] at hmem
  simp [hRootNotNotReducible, hRootNotSelf,
    hPolicy.returnsAtom_selectedType_eq,
    hPolicy.resultExpected_eq] at hmem
  have hmemRaw := mem_of_mem_prioritizeSemanticResults hmem
  rcases List.mem_map.mp hmemRaw with
    ⟨⟨finalOut, finalBnd⟩, hFinal, hOut⟩
  have hFinalOut : finalOut = final := congrArg Prod.fst hOut
  subst finalOut
  exact ⟨finalBnd, by simpa [mSym, List.flatMap] using hFinal⟩

private theorem mettaEval_kernelDefControlEnv_convReadoutAfterNxNy_true_pair_implies_eq_pair_of_false_branches
    (fuel : Nat) (st stCond₁ stRoot₁ stCond₂ stRoot₂ : St)
    (nx ny : Metta.Atom)
    (rootBnd₁ rootBnd₂ outBnd : Metta.Bindings)
    (hWorld : st.world = St.init.world)
    (hWorldRoot₁ : stRoot₁.world = St.init.world)
    (hNxClosed : nx.vars = [])
    (hNyClosed : ny.vars = [])
    (hCond₁ :
      mettaEval kernelDefControlEnv (fuel + 1) st []
          (mExpr "is-bad" [nx]) =
        ([(mBool false, [])], stCond₁))
    (hRoot₁ :
      interpretFuel kernelDefControlEnv (fuel + 1 + 1) stCond₁
          [evalItemNil
            (mExpr "if"
              [ mBool false
              , mBool false
              , mExpr "if"
                  [ mExpr "is-bad" [ny]
                  , mBool false
                  , mExpr "==" [nx, ny] ] ])] [] =
        ([(mExpr "if"
            [ mExpr "is-bad" [ny]
            , mBool false
            , mExpr "==" [nx, ny] ], rootBnd₁)], stRoot₁))
    (hCond₂ :
      mettaEval kernelDefControlEnv fuel stRoot₁ []
          (mExpr "is-bad" [ny]) =
        ([(mBool false, [])], stCond₂))
    (hRoot₂ :
      interpretFuel kernelDefControlEnv (fuel + 1) stCond₂
          [evalItemNil
            (mExpr "if" [mBool false, mBool false, mExpr "==" [nx, ny]])] [] =
        ([(mExpr "==" [nx, ny], rootBnd₂)], stRoot₂))
    (hmem :
      (mBool true, outBnd) ∈
        (mettaEval kernelDefControlEnv (fuel + 2) st []
          (convReadoutAfterNxNy nx ny)).1) :
    ∃ finalBnd,
      (mBool true, finalBnd) ∈
        (mettaEval kernelDefControlEnv fuel stRoot₂ []
          (mExpr "==" [nx, ny])).1 := by
  let cond₁ := mExpr "is-bad" [nx]
  let eqA := mExpr "==" [nx, ny]
  let cond₂ := mExpr "is-bad" [ny]
  let else₁ := mExpr "if" [cond₂, mBool false, eqA]
  have hTypes₁ : KernelDefControlEnvTypeWorld st.world :=
    kernelDefControlEnvTypeWorld_init.transport hWorld
  have hCondExpected₁ :
      mettaEvalExpected kernelDefControlEnv (fuel + 1) st [] cond₁
          (mSym "Bool") =
        ([(mBool false, [])], stCond₁) := by
    simpa [cond₁] using
      mettaEvalExpected_kernelDefControlEnv_is_bad_of_bool_eval
        (fuel + 1) st stCond₁ nx false hTypes₁ hCond₁
  let hPolicy₁Init :
      EvalQuotedQuotedApplicationPolicy kernelDefControlEnv St.init.world "if"
        [cond₁, mBool false, else₁] (mSym "Bool") := by
    simpa [cond₁] using
      kernelDefControlEnv_if_exactPolicy_is_bad_init nx (mBool false) else₁
  have hPlan₁Init : ApplicationPlanCorresponds []
      (.selected hPolicy₁Init.raw.decision.selectedType
        hPolicy₁Init.selected_eq) := by
    simpa [hPolicy₁Init, cond₁] using
      kernelDefControlEnv_if_is_bad_applicationPlanCorresponds_init
        nx (mBool false) else₁
  let hPackage₁Init :
      { policy : EvalQuotedQuotedApplicationPolicy kernelDefControlEnv
          St.init.world "if" [cond₁, mBool false, else₁] (mSym "Bool") //
        ApplicationPlanCorresponds []
          (.selected policy.raw.decision.selectedType policy.selected_eq) } :=
    ⟨hPolicy₁Init, hPlan₁Init⟩
  let hPackage₁ :
      { policy : EvalQuotedQuotedApplicationPolicy kernelDefControlEnv
          st.world "if" [cond₁, mBool false, else₁] (mSym "Bool") //
        ApplicationPlanCorresponds []
          (.selected policy.raw.decision.selectedType policy.selected_eq) } :=
    hWorld.symm ▸ hPackage₁Init
  let hPolicy₁ := hPackage₁.1
  have hPlan₁ : ApplicationPlanCorresponds []
      (.selected hPolicy₁.raw.decision.selectedType hPolicy₁.selected_eq) := by
    exact hPackage₁.2
  have hNoErr₁ :
      (([mBool false, mBool false, else₁].zip
          [cond₁, mBool false, else₁]).find?
        (fun ho : Metta.Atom × Metta.Atom => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none := by
    simp [cond₁, cond₂, else₁, eqA, mExpr, mSym, mBool,
      Metta.Atom.isError, Metta.Atom.beq]
  have hRootNotNR₁ : (else₁ == notReducibleA) = false := by
    change Metta.Atom.beq else₁ notReducibleA = false
    simp [else₁, cond₂, eqA, notReducibleA, mExpr, mSym, mBool,
      Metta.Atom.beq]
  have hRootNotSelf₁ :
      (else₁ == mExpr "if" [mBool false, mBool false, else₁]) = false := by
    change Metta.Atom.beq else₁ (mExpr "if" [mBool false, mBool false, else₁]) = false
    simp [else₁, cond₂, eqA, mExpr, mSym, mBool,
      Metta.Atom.beq, Metta.Atom.beqList]
  have hRoot₁' :
      interpretFuel kernelDefControlEnv ((fuel + 1) + 1) stCond₁
          [evalItemNil
            (Metta.Atom.expr
              [Metta.Atom.sym "if", mBool false, mBool false, else₁])] [] =
        ([(else₁, rootBnd₁)], stRoot₁) := by
    simpa [cond₁, cond₂, else₁, eqA, mExpr, mSym, Nat.add_assoc] using hRoot₁
  rcases
      mettaEval_ternary_expr_pair_mem_implies_root_eval_mem_of_eval_quoted_quoted_and_root_eval_eq_bnd
        (env := kernelDefControlEnv) (fuel := fuel + 1)
        (st := st) (stCond := stCond₁) (stRoot := stRoot₁)
        (op := "if") (hOpNotError := by decide)
        (cond := cond₁) (thenA := mBool false)
        (elseA := else₁) (cond' := mBool false) (root := else₁)
        (final := mBool true) (rootBnd := rootBnd₁) (outBnd := outBnd)
        hCondExpected₁ hPolicy₁ hPlan₁ hNoErr₁ hRoot₁'
        hRootNotNR₁ hRootNotSelf₁
        (by simpa [convReadoutAfterNxNy, cond₁, cond₂, else₁, eqA,
          mExpr, mSym, Nat.add_assoc] using hmem) with
    ⟨midBnd, hMid⟩
  have hQvars₁ :
      (([cond₁, mBool false, else₁]).flatMap Metta.Atom.vars) = [] := by
    simp [cond₁, cond₂, else₁, eqA, hNxClosed, hNyClosed,
      mExpr, mSym, mBool, Metta.Atom.vars]
  have hRestrict₁ :
      restrictBnd (([cond₁, mBool false, else₁]).flatMap Metta.Atom.vars)
          ((Metta.Bindings.merge [] rootBnd₁).head?.getD rootBnd₁) = [] := by
    simpa [hQvars₁] using
      restrictBnd_nil_vars ((Metta.Bindings.merge [] rootBnd₁).head?.getD rootBnd₁)
  have hMidNil :
      (mBool true, midBnd) ∈
        (mettaEval kernelDefControlEnv (fuel + 1) stRoot₁ [] else₁).1 := by
    rw [hRestrict₁] at hMid
    exact hMid
  let hPolicy₂Init :
      EvalQuotedQuotedApplicationPolicy kernelDefControlEnv St.init.world "if"
        [cond₂, mBool false, eqA] (mSym "Bool") := by
    simpa [cond₂] using
      kernelDefControlEnv_if_exactPolicy_is_bad_init ny (mBool false) eqA
  have hPlan₂Init : ApplicationPlanCorresponds []
      (.selected hPolicy₂Init.raw.decision.selectedType
        hPolicy₂Init.selected_eq) := by
    simpa [hPolicy₂Init, cond₂] using
      kernelDefControlEnv_if_is_bad_applicationPlanCorresponds_init
        ny (mBool false) eqA
  let hPackage₂Init :
      { policy : EvalQuotedQuotedApplicationPolicy kernelDefControlEnv
          St.init.world "if" [cond₂, mBool false, eqA] (mSym "Bool") //
        ApplicationPlanCorresponds []
          (.selected policy.raw.decision.selectedType policy.selected_eq) } :=
    ⟨hPolicy₂Init, hPlan₂Init⟩
  let hPackage₂ :
      { policy : EvalQuotedQuotedApplicationPolicy kernelDefControlEnv
          stRoot₁.world "if" [cond₂, mBool false, eqA] (mSym "Bool") //
        ApplicationPlanCorresponds []
          (.selected policy.raw.decision.selectedType policy.selected_eq) } :=
    hWorldRoot₁.symm ▸ hPackage₂Init
  let hPolicy₂ := hPackage₂.1
  have hPlan₂ : ApplicationPlanCorresponds []
      (.selected hPolicy₂.raw.decision.selectedType hPolicy₂.selected_eq) := by
    exact hPackage₂.2
  have hTypes₂ : KernelDefControlEnvTypeWorld stRoot₁.world :=
    kernelDefControlEnvTypeWorld_init.transport hWorldRoot₁
  have hCondExpected₂ :
      mettaEvalExpected kernelDefControlEnv fuel stRoot₁ [] cond₂
          (mSym "Bool") =
        ([(mBool false, [])], stCond₂) := by
    simpa [cond₂] using
      mettaEvalExpected_kernelDefControlEnv_is_bad_of_bool_eval
        fuel stRoot₁ stCond₂ ny false hTypes₂ hCond₂
  have hNoErr₂ :
      (([mBool false, mBool false, eqA].zip
          [cond₂, mBool false, eqA]).find?
        (fun ho : Metta.Atom × Metta.Atom => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none := by
    simp [cond₂, eqA, mExpr, mSym, mBool,
      Metta.Atom.isError, Metta.Atom.beq]
  have hRootNotNR₂ : (eqA == notReducibleA) = false := by
    change Metta.Atom.beq eqA notReducibleA = false
    simp [eqA, notReducibleA, mExpr, mSym, Metta.Atom.beq]
  have hRootNotSelf₂ :
      (eqA == mExpr "if" [mBool false, mBool false, eqA]) = false := by
    change Metta.Atom.beq eqA (mExpr "if" [mBool false, mBool false, eqA]) = false
    simp [eqA, mExpr, mSym, mBool, Metta.Atom.beq, Metta.Atom.beqList]
  have hRoot₂' :
      interpretFuel kernelDefControlEnv (fuel + 1) stCond₂
          [evalItemNil
            (Metta.Atom.expr
              [Metta.Atom.sym "if", mBool false, mBool false, eqA])] [] =
        ([(eqA, rootBnd₂)], stRoot₂) := by
    simpa [cond₂, eqA, mExpr, mSym] using hRoot₂
  rcases
      mettaEval_ternary_expr_pair_mem_implies_root_eval_mem_of_eval_quoted_quoted_and_root_eval_eq_bnd
        (env := kernelDefControlEnv) (fuel := fuel)
        (st := stRoot₁) (stCond := stCond₂) (stRoot := stRoot₂)
        (op := "if") (hOpNotError := by decide)
        (cond := cond₂) (thenA := mBool false)
        (elseA := eqA) (cond' := mBool false) (root := eqA)
        (final := mBool true) (rootBnd := rootBnd₂) (outBnd := midBnd)
        hCondExpected₂ hPolicy₂ hPlan₂ hNoErr₂ hRoot₂'
        hRootNotNR₂ hRootNotSelf₂
        (by simpa [else₁, cond₂, eqA, mExpr, mSym] using hMidNil) with
    ⟨finalBnd, hEq⟩
  have hQvars₂ :
      (([cond₂, mBool false, eqA]).flatMap Metta.Atom.vars) = [] := by
    simp [cond₂, eqA, hNxClosed, hNyClosed, mExpr, mSym, mBool,
      Metta.Atom.vars]
  have hRestrict₂ :
      restrictBnd (([cond₂, mBool false, eqA]).flatMap Metta.Atom.vars)
          ((Metta.Bindings.merge [] rootBnd₂).head?.getD rootBnd₂) = [] := by
    simpa [hQvars₂] using
      restrictBnd_nil_vars ((Metta.Bindings.merge [] rootBnd₂).head?.getD rootBnd₂)
  exact ⟨finalBnd, by
    rw [hRestrict₂] at hEq
    exact hEq⟩

private theorem mettaEvalExprRootFoldStep_preserves_any_mem_local
    (env : MinEnv) (fuel : Nat) (queryVars : List String)
    (w : Metta.Atom) (partBnd : Metta.Bindings)
    (returnAtom : Bool)
    (p : Metta.Atom × Metta.Bindings)
    (acc : List (Metta.Atom × Metta.Bindings) × St)
    {target : Metta.Atom × Metta.Bindings}
    (hmem : target ∈ acc.1) :
    target ∈
      (mettaEvalExprRootFoldStep env fuel queryVars w partBnd returnAtom acc p).1 := by
  unfold mettaEvalExprRootFoldStep
  split
  · exact List.mem_append.mpr (Or.inl hmem)
  · split
    · exact List.mem_append.mpr (Or.inl hmem)
    · exact List.mem_append.mpr (Or.inl hmem)

private theorem mettaEvalExprRootFold_preserves_any_mem_local
    (env : MinEnv) (fuel : Nat) (queryVars : List String)
    (w : Metta.Atom) (partBnd : Metta.Bindings)
    (returnAtom : Bool)
    (pairs : List (Metta.Atom × Metta.Bindings))
    (acc : List (Metta.Atom × Metta.Bindings) × St)
    {target : Metta.Atom × Metta.Bindings}
    (hmem : target ∈ acc.1) :
    target ∈
      (pairs.foldl (mettaEvalExprRootFoldStep env fuel queryVars w partBnd returnAtom) acc).1 := by
  induction pairs generalizing acc with
  | nil =>
      simpa using hmem
  | cons p ps ih =>
      exact ih _
        (mettaEvalExprRootFoldStep_preserves_any_mem_local
          env fuel queryVars w partBnd returnAtom p acc hmem)

private theorem mettaEvalExprRootFoldStep_hits_recursive_eval_bnd_local
    (env : MinEnv) (fuel : Nat) (queryVars : List String)
    (w : Metta.Atom) (partBnd : Metta.Bindings)
    (returnAtom : Bool)
    (acc : List (Metta.Atom × Metta.Bindings) × St)
    (p : Metta.Atom × Metta.Bindings)
