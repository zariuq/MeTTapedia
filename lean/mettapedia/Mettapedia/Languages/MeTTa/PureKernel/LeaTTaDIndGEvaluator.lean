            (c := nfQuery sig rawDomainR) (d := nfQuery sig rawBodyR) (by
              simpa [nfRootReadoutNameFree, nfLamReadout, nfQuery, mExpr, mSym] using hEq)
          have hdeq := nfQuery_beq_injective_on_nf_eq_fragment_nameFree hDomain hDomainR hp.1
          have hbeq := nfQuery_beq_injective_on_nf_eq_fragment_nameFree hBody hBodyR hp.2
          cases hdeq
          cases hbeq
          rfl
      | var k =>
          exact False.elim (atom_beq_expr_head_false (tagL := "Lam") (tagR := "Var")
            (by decide) (by
              simpa [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
                termAtom, mExpr, mSym, mNat] using hEq))
      | srt sort =>
          cases sort <;>
            exact False.elim (atom_beq_expr_head_false (tagL := "Lam") (tagR := "Srt")
              (by decide) (by
                simpa [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
                  termAtom, sortAtom, mExpr, mSym] using hEq))
      | bad reason =>
          exact False.elim (atom_beq_expr_head_false (tagL := "Lam") (tagR := "Bad")
            (by decide) (by
              simpa [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
                termAtom, mExpr, mSym] using hEq))
      | pi _ _ =>
          exact False.elim (atom_beq_expr_head_false (tagL := "Lam") (tagR := "Pi")
            (by decide) (by
              simpa [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
                termAtom, mExpr, mSym] using hEq))

/-- Runtime root readouts on the name-free fragment are never error atoms. -/
theorem nfRootReadoutNameFree_isError_false
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    (h : NfEqFragmentTermNameFree raw) :
    (nfRootReadoutNameFree sig raw).isError = false := by
  cases h <;>
    simp [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
      termAtom, sortAtom, mExpr, mSym, Metta.Atom.isError]

/-- Successful grounded equality on name-free runtime `nf` root readouts forces
the raw terms to coincide.

This is the exact limitation of the current name-free `conv` route: at the
runtime root level, equality gives reflexivity, not a genuinely non-reflexive
conversion witness. -/
theorem nfRootReadoutNameFree_grounded_eq_true_implies_raw_eq
    {sig : DIndGArtifactSig}
    {rawL rawR : DIndGArtifactTerm}
    (hL : NfEqFragmentTermNameFree rawL)
    (hR : NfEqFragmentTermNameFree rawR)
    (hEq :
      callGrounded stdGroundings "==" [nfRootReadoutNameFree sig rawL, nfRootReadoutNameFree sig rawR] =
        ReduceResult.ok [mBool true]) :
    rawL = rawR := by
  have hbeq :=
    callGrounded_eq_true_implies_beq_true
      (nfRootReadoutNameFree sig rawL) (nfRootReadoutNameFree sig rawR)
      (nfRootReadoutNameFree_isError_false hL)
      (nfRootReadoutNameFree_isError_false hR)
      hEq
  exact nfRootReadoutNameFree_beq_injective_on_nf_eq_fragment_nameFree hL hR hbeq

/-- The current name-free `conv` route cannot witness a genuinely
non-reflexive conversion at the final grounded-equality branch. -/
theorem nfRootReadoutNameFree_grounded_eq_true_forbids_distinct_raw
    {sig : DIndGArtifactSig}
    {rawLeft rawRight : DIndGArtifactTerm}
    (hNameLeft : NfEqFragmentTermNameFree rawLeft)
    (hNameRight : NfEqFragmentTermNameFree rawRight)
    (hNe : rawLeft ≠ rawRight) :
    callGrounded stdGroundings "==" [nfRootReadoutNameFree sig rawLeft, nfRootReadoutNameFree sig rawRight] ≠
      ReduceResult.ok [mBool true] := by
  intro hEq
  exact hNe (nfRootReadoutNameFree_grounded_eq_true_implies_raw_eq hNameLeft hNameRight hEq)

/-- Translation of name-free `nf` fragment terms is functional.

No hypothesis about the declaration-name relation is needed because this
fragment excludes name-bearing artifact constructors. -/
theorem dindg_translate_unique_on_nf_eq_fragment_nameFree
    {nameTranslates : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName →
      Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName → Prop}
    {n : Nat} {raw : DIndGArtifactTerm} {left right : PureTm n}
    (hfrag : NfEqFragmentTermNameFree raw)
    (hL : DIndGArtifactTermTranslates nameTranslates n raw left)
    (hR : DIndGArtifactTermTranslates nameTranslates n raw right) :
    left = right := by
  induction hfrag generalizing n left right with
  | var k =>
      cases hL
      case var hLeft =>
        cases hR
        case var hRight =>
          simp
  | srt sort =>
      cases sort <;> cases hL <;> cases hR <;> rfl
  | bad reason =>
      cases hL
  | pi hDomain hBody ihDomain ihBody =>
      cases hL
      case pi hDomainL hBodyL =>
        cases hR
        case pi hDomainR hBodyR =>
          have hDomainEq := ihDomain hDomainL hDomainR
          have hBodyEq := ihBody hBodyL hBodyR
          simp [hDomainEq, hBodyEq]
  | lam hDomain hBody ihDomain ihBody =>
      cases hL
      case lam hDomainL hBodyL =>
        cases hR
        case lam hDomainR hBodyR =>
          have hBodyEq := ihBody hBodyL hBodyR
          exact congrArg PureTm.lam hBodyEq

/-- Translation of the no-`Con` Stage-3 witness fragment is functional.

The only name-bearing constructor in this fragment is the concrete witness
`Def`, so the proof pins both translations through the witness-specific name
relation instead of requiring general declaration-name encoder injectivity. -/
