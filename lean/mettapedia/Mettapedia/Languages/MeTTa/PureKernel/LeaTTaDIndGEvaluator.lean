  simp only [mExpr, mSym, mBool, headKey]
  rw [Metta.ruleIndex_getD, Metta.ofAtomsGT_varRules]
  simp [kernelControlSignatureDecls, kernelControlRules, kernelNfDefBodyRootRules,
    kernelCoreRules, runtimeDecls, ruleIfTrue, ruleIfFalse, ruleLet,
    ifTrueRulePair, ifFalseRulePair, letRulePair, ruleIsBad, ruleNfVar,
    ruleNfSrt, ruleNfCon, ruleNfPi, ruleNfLam, ruleNfBad, ruleNfDef,
    ruleDefBodyOfDDef, nfDefRuleLhs, nfDefRuleRhs, defBodyOfDDefRuleLhs,
    defBodyOfDDefRuleRhs, defBodyOfQueryAtom, ruleInferSrtType,
    ruleInferSrtKind, ruleInferBad, ruleConv, mTypeDecl, mExpr, mSym, mVar,
    mBool, headKey, extractRules]

private theorem kernelEnv_let_candidates
    (binder : String) (atom template : Metta.Atom) :
    kernelEnv.candidates (mExpr "let" [mVar binder, atom, template]) =
      [letRulePair] := by
  rw [MinEnv.candidates]
  simp only [kernelEnv]
  simp only [mExpr, mSym, mVar, headKey]
  rw [Metta.ruleIndex_getD, Metta.ofAtomsGT_varRules]
  simp [kernelControlSignatureDecls, kernelControlRules, kernelNfDefBodyRootRules,
    kernelCoreRules, runtimeDecls, ruleIfTrue, ruleIfFalse, ruleLet,
    ifTrueRulePair, ifFalseRulePair, letRulePair, ruleIsBad, ruleNfVar,
    ruleNfSrt, ruleNfCon, ruleNfPi, ruleNfLam, ruleNfBad, ruleNfDef,
    ruleDefBodyOfDDef, nfDefRuleLhs, nfDefRuleRhs, defBodyOfDDefRuleLhs,
    defBodyOfDDefRuleRhs, defBodyOfQueryAtom, ruleInferSrtType,
    ruleInferSrtKind, ruleInferBad, ruleConv, mTypeDecl, mExpr, mSym, mVar,
    mBool, headKey, extractRules]

/-- Root fuel-driver readout for the finite-control `let` rule over a
quoted binder/template and an already-evaluated non-variable bound atom.

This is the executable root step needed by the `convReadout` control-flow
threading: once the bound atom has been evaluated, the real `interpretFuel`
driver harvests the corresponding embedded `unify` root item using the stdlib
`let` rule inside `kernelEnv`.  The theorem is intentionally parameterized by a
freshness invariant for the quoted payloads; later `conv` lemmas discharge that
invariant for the concrete `nx`/`ny` templates instead of baking another ad hoc
root trace into the file. -/
theorem interpretFuel_kernelEnv_let_root_contains
    (fuel : Nat) (st : St)
    (binder : String) (atom template : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hAtomNonVar : ∀ w, atom ≠ Metta.Atom.var w)
    (hTemplateNonVar : ∀ w, template ≠ Metta.Atom.var w)
    (hFresh :
      RenamedValueKeysFreshForValues (counterSuffix st.counter)
        (letRuleBindings binder atom template)) :
    (mExpr "unify" [atom, mVar binder, template, mSym "Empty"],
      (renameBindings (counterSuffix st.counter)
        (letRuleBindings binder atom template)).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "let" [mVar binder, atom, template])] []).1 := by
  let target := mExpr "let" [mVar binder, atom, template]
  let coreB := letRuleBindings binder atom template
  let f := counterSuffix st.counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  let root := mExpr "unify" [atom, mVar binder, template, mSym "Empty"]
  have hf : Function.Injective f := by
    simpa [f] using counterSuffix_injective st.counter
  have hvalB : ValueBindings coreB := by
    exact ValueBindings.val (ValueBindings.val (ValueBindings.val ValueBindings.nil))
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, letRuleBindings, bindingValueKeys]
  have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
    rw [bindingValueKeys_renameBindings]
    exact List.Nodup.map hf hnodup
  have hPatternFresh : f "pattern" ≠ binder := by
    have hnotin :
        f "pattern" ∉ (mVar binder).vars := by
      exact renamedValueKeysFreshForValues_self hFresh "pattern" (mVar binder)
        (by simp [letRuleBindings])
    simpa [mVar, Metta.Atom.vars] using hnotin
  have hmatchFresh : renameBindings f coreB ∈
      Metta.matchAtoms (freshenRule st.counter letRulePair.1 letRulePair.2).1 target := by
    rw [fresh_let_rule_match st.counter binder atom template hAtomNonVar hTemplateNonVar hPatternFresh]
    simp [coreB, letRuleBindings, f, renameBindings]
  have hmerge : m ∈ Metta.Bindings.merge [] (renameBindings f coreB) := by
    simpa [m, coreB, letRuleBindings, f] using
      (merge_empty_renamed_value_nodup_mem (f := f) hf hvalB hnodup)
  have hloop : Metta.Bindings.hasLoop m = false := by
    simpa [m, coreB, letRuleBindings, f] using
      (ValueBindings.rename_reverse_hasLoop_false_of_not_mem_vars
        (f := f) hvalB (renamedValueKeysFreshForValues_self hFresh))
  have hboundRhs :
      ∀ v ∈ letRulePair.2.vars, ∃ t, Metta.Bindings.lookupVal coreB v = some t := by
    intro v hv
    have hv' : v = "atom" ∨ v = "pattern" ∨ v = "template" := by
      simpa [letRulePair, mExpr, mSym, mVar, Metta.Atom.vars] using hv
    rcases hv' with rfl | rfl | rfl
    · exact ⟨atom, by simp [coreB, letRuleBindings, Metta.Bindings.lookupVal]⟩
    · exact ⟨mVar binder, by simp [coreB, letRuleBindings, Metta.Bindings.lookupVal]⟩
    · exact ⟨template, by simp [coreB, letRuleBindings, Metta.Bindings.lookupVal]⟩
  have hresult :
      Metta.instantiate m (freshenRule st.counter letRulePair.1 letRulePair.2).2 = root := by
    have hvalRen : ValueBindings (renameBindings f coreB) := ValueBindings.rename hvalB
    calc
      Metta.instantiate m (freshenRule st.counter letRulePair.1 letRulePair.2).2
          = Metta.instantiate (renameBindings f coreB)
              (freshenRule st.counter letRulePair.1 letRulePair.2).2 := by
              simpa [m] using
                (instantiate_reverse_value_nodup hvalRen hnodupRen
                  ((freshenRule st.counter letRulePair.1 letRulePair.2).2))
      _ = Metta.instantiate coreB letRulePair.2 := by
            simpa [coreB, letRuleBindings, f] using
              (instantiate_freshenRule_rhs_of_renamed_bindings
                st.counter letRulePair.1 letRulePair.2 coreB hboundRhs)
      _ = root := by
            simp [root, coreB, letRuleBindings, let_instantiate_bindings]
  have hrootStable : Metta.instantiate m root = root := by
    simpa [m, root, coreB, letRuleBindings, let_instantiate_bindings] using
      (instantiate_renamed_reverse_stable_after_value_subst
        (f := f) hf hvalB hnodup hFresh letRulePair.2 hboundRhs)
  have hquery :
      evalResult [] (Metta.instantiate m
          (freshenRule st.counter letRulePair.1 letRulePair.2).2) m ∈
        (queryOp kernelEnv st [] target []).1 := by
    simpa [target] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := kernelEnv) (st := st) (prev := []) (toEval := target) (b := [])
        (pre := []) (post := []) (p := letRulePair)
        (mb := renameBindings f coreB) (m := m)
        hStatic (by simp [target, isVariableHeaded, mExpr, mSym])
        (by simpa [target] using kernelEnv_let_candidates binder atom template)
        hmatchFresh hmerge hloop
  have hstack :
      evalResult [] root m ∈
        (interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }).1 := by
    have hqueryRoot :
        evalResult [] root m ∈ (queryOp kernelEnv st [] target []).1 := by
      simpa [hresult] using hquery
    exact (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "let" [mVar binder, atom, template]
      (evalResult [] root m)
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_let [mVar binder, atom, template])
      (by simp [isEmbeddedOp])).2 hqueryRoot
  have heval : evalResult [] root m = finItem [] root m := by
    simp [root, evalResult, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root m) = true := by
    simp [heval, finItem, isFinal]
  have hmemFuel :
      finalPair (evalResult [] root m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelEnv fuel st { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }
      (evalResult [] root m) [] [] hstack hfinal
  have hmemPair :
      (root, m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 := by
    simpa [heval, finItem, finalPair, hrootStable] using hmemFuel
  simpa [target, evalItemNil, atomToStack_eval, root, m,
    f, coreB, letRuleBindings, hrootStable, mExpr, mSym] using hmemPair

/-- Every executable RHS item emitted by the `let` equation rule is final under
an empty continuation: the rule's RHS is headed by embedded `unify`, never by
`function`. -/
private theorem isFinal_evalResult_nil_instantiate_freshen_let
    (counter : Nat) (b : Metta.Bindings) :
    isFinal
      (evalResult []
        (Metta.instantiate b (freshenRule counter letRulePair.1 letRulePair.2).2) b) =
      true := by
  simp [letRulePair, freshenRule, Metta.instantiate,
    Metta.bindingsToSubst, Metta.Subst.apply, Metta.Subst.lookup,
    Metta.Atom.vars, evalResult, finItem, isFinal, mExpr, mSym, mVar]

/-- The `let` root scheduler step preserves the absence of local `&self`
rules.

This is the state half paired with
`interpretFuel_kernelEnv_let_root_contains`; it is the scheduler-invariant
fact needed when the later `convReadout` proof follows the outer `let`
through LeaTTa's real `mettaEval` loop. -/
theorem interpretFuel_kernelEnv_let_root_selfExtra
    (fuel : Nat) (st : St)
    (binder : String) (atom template : Metta.Atom)
    (hStatic : st.world.selfExtra = []) :
    ((interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "let" [mVar binder, atom, template])] []).2).world.selfExtra = [] := by
  let target := mExpr "let" [mVar binder, atom, template]
  have hstep :
      interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] } =
        queryOp kernelEnv st [] target [] := by
    change interpretStack1 kernelEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := [] } =
      queryOp kernelEnv st [] target []
    exact interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "let" [mVar binder, atom, template]
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_let [mVar binder, atom, template])
      (by simp [isEmbeddedOp])
  have hqueryWorld : (queryOp kernelEnv st [] target []).2.world.selfExtra = [] := by
    have hw := queryOp_world kernelEnv st [] target []
    rw [hw]
    exact hStatic
  have hnonfinals :
      (queryOp kernelEnv st [] target []).1.filter (fun r => !isFinal r) = [] := by
    apply List.filter_eq_nil_iff.mpr
    intro item hmem
    have hfin : isFinal item = true := by
      unfold queryOp at hmem
      rw [candidatesW_eq_candidates_of_no_selfExtra kernelEnv st.world target hStatic] at hmem
      rw [kernelEnv_let_candidates binder atom template] at hmem
      simp only [List.foldl_cons, List.foldl_nil] at hmem
      simp [target, mExpr, mSym, isVariableHeaded] at hmem
      by_cases hall :
          ∀ mb ∈ Metta.matchAtoms
                (freshenRule st.counter letRulePair.1 letRulePair.2).1
                (Metta.Atom.expr [Metta.Atom.sym "let", Metta.Atom.var binder, atom, template]),
            ∀ m ∈ Metta.Bindings.merge [] mb, Metta.Bindings.hasLoop m = true
      · have hall' :
            ∀ mb ∈ Metta.matchAtoms
                  (freshenRule st.counter letRulePair.1 letRulePair.2).1
                  (Metta.Atom.expr [Metta.Atom.sym "let", mVar binder, atom, template]),
              ∀ m ∈ Metta.Bindings.merge [] mb, Metta.Bindings.hasLoop m = true := by
          simpa [mVar] using hall
        rw [if_pos hall'] at hmem
        have hitem : item = finItem [] notReducibleA [] := by
          simpa [finItem] using hmem
        rw [hitem]
        simp [finItem, isFinal]
      · have hall' :
            ¬∀ mb ∈ Metta.matchAtoms
                  (freshenRule st.counter letRulePair.1 letRulePair.2).1
                  (Metta.Atom.expr [Metta.Atom.sym "let", mVar binder, atom, template]),
              ∀ m ∈ Metta.Bindings.merge [] mb, Metta.Bindings.hasLoop m = true := by
          simpa [mVar] using hall
        rw [if_neg hall'] at hmem
        have hmem' :
            ∃ mb ∈ Metta.matchAtoms
                  (freshenRule st.counter letRulePair.1 letRulePair.2).1
                  (Metta.Atom.expr [Metta.Atom.sym "let", mVar binder, atom, template]),
              ∃ m ∈ Metta.Bindings.merge [] mb,
                Metta.Bindings.hasLoop m = false ∧
                  evalResult []
                      (Metta.instantiate m (freshenRule st.counter letRulePair.1 letRulePair.2).2) m =
                    item := by
          simpa using hmem
        rcases hmem' with ⟨mb, _hmb, m, _hm, _hloopFalse, heq⟩
        simpa [← heq] using
          isFinal_evalResult_nil_instantiate_freshen_let st.counter m
    simp [hfin]
  have hstepExpanded :
      interpretStack1 kernelEnv fuel st
          { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval",
              mExpr "let" [mVar binder, atom, template]] } :: [],
            bnd := [] } =
        queryOp kernelEnv st [] (mExpr "let" [mVar binder, atom, template]) [] := by
    simpa [target, mExpr, mSym] using hstep
  have hnonfinalsExpanded :
      (queryOp kernelEnv st [] (mExpr "let" [mVar binder, atom, template]) []).1.filter
          (fun r => !isFinal r) = [] := by
    simpa [target] using hnonfinals
  have hqueryWorldExpanded :
      (queryOp kernelEnv st [] (mExpr "let" [mVar binder, atom, template]) []).2.world.selfExtra = [] := by
    simpa [target] using hqueryWorld
  rw [interpretFuel_cons_step_eq]
  simp only [evalItemNil, atomToStack_eval, List.append_nil]
  rw [hstepExpanded, hnonfinalsExpanded]
  simpa [interpretFuel] using hqueryWorldExpanded

/-- Root fuel-driver readout for the finite-control `if true` rule over closed branches.

This is the `kernelEnv`-direct executable root step needed by the full `convReadout` scheduler
lift: the root is harvested from the real `interpretFuel` driver, while the selected branch remains
available for the surrounding `mettaEval` recursion. -/
theorem interpretFuel_kernelEnv_if_true_root_contains
    (fuel : Nat) (st : St) (thenA elseA : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hThenNotFunction : ∀ tail, thenA ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail)) :
    (thenA,
        (renameBindings (counterSuffix st.counter)
          [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "if" [mBool true, thenA, elseA])] []).1 := by
  let target := mExpr "if" [mBool true, thenA, elseA]
  let coreB : Metta.Bindings :=
    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix st.counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, mBool, hThenClosed, hElseClosed, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hElseClosed
      (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, bindingValueKeys]
  have hmatchCore : coreB ∈ Metta.matchAtoms ifTrueRulePair.1 target := by
    simpa [coreB, target] using
      (by
        rw [if_true_rule_match thenA elseA hThenNonVar hElseNonVar]
        simp :
        [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA] ∈
          Metta.matchAtoms ifTrueRulePair.1 (mExpr "if" [mBool true, thenA, elseA]))
  have hmatchFresh : renameBindings f coreB ∈
      Metta.matchAtoms (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).1 target := by
    simpa [f] using
      matchAtoms_freshenRule_lhs_closed_target_mem st.counter hclosedTarget hmatchCore
  have hmerge : m ∈ Metta.Bindings.merge [] (renameBindings f coreB) := by
    simpa [m, f] using
      (merge_empty_renamed_closed_nodup_mem (counterSuffix_injective st.counter)
        hclosedB hnodup)
  have hloop : Metta.Bindings.hasLoop m = false := by
    have hclosedRen : ClosedValueBindings (renameBindings (counterSuffix st.counter) coreB) :=
      ClosedValueBindings.rename hclosedB
    simpa [m, f] using
      (ClosedValueBindings.hasLoop_false (ClosedValueBindings.reverse hclosedRen))
  have hquery :
      evalResult [] (Metta.instantiate m
          (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2) m ∈
        (queryOp kernelEnv st [] target []).1 := by
    simpa [target] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := kernelEnv) (st := st) (prev := []) (toEval := target) (b := [])
        (pre := []) (post := [ifFalseRulePair]) (p := ifTrueRulePair)
        (mb := renameBindings f coreB) (m := m)
        hStatic (by simp [target, isVariableHeaded, mExpr, mSym])
        (by simpa [target] using kernelEnv_if_candidates true thenA elseA)
        hmatchFresh hmerge hloop
  have hresult :
      Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
        thenA := by
    have hf : Function.Injective f := by
      simpa [f] using counterSuffix_injective st.counter
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename hclosedB
    have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
      rw [bindingValueKeys_renameBindings]
      exact List.Nodup.map hf hnodup
    have hreverse :
        Metta.instantiate (renameBindings f coreB).reverse
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 :=
      instantiate_reverse_closed_nodup hclosedRen hnodupRen _
    have hbound :
        ∀ v ∈ ifTrueRulePair.2.vars, ∃ t, Metta.Bindings.lookupVal coreB v = some t := by
      intro v hv
      have hv' : v = "t" := by
        simpa [ifTrueRulePair, mVar, Metta.Atom.vars] using hv
      subst v
      exact ⟨thenA, by simp [coreB, Metta.Bindings.lookupVal]⟩
    have hfresh :
        Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate coreB ifTrueRulePair.2 := by
      simpa [f] using
        instantiate_freshenRule_rhs_of_renamed_bindings
          st.counter ifTrueRulePair.1 ifTrueRulePair.2 coreB hbound
    have hcore : Metta.instantiate coreB ifTrueRulePair.2 = thenA :=
      if_true_instantiate_bindings thenA elseA
    calc
      Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 := by
            simpa [m] using hreverse
      _ = Metta.instantiate coreB ifTrueRulePair.2 := hfresh
      _ = thenA := hcore
  have hstack :
      evalResult [] thenA m ∈
        (interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }).1 := by
    have hqueryThen :
        evalResult [] thenA m ∈ (queryOp kernelEnv st [] target []).1 := by
      simpa [hresult] using hquery
    exact (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "if" [mBool true, thenA, elseA]
      (evalResult [] thenA m)
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_if [mBool true, thenA, elseA])
      (by simp [isEmbeddedOp])).2 hqueryThen
  have heval : evalResult [] thenA m = finItem [] thenA m := by
    cases thenA with
    | expr xs =>
        cases xs with
        | nil => rfl
        | cons h rest =>
            cases h with
            | sym op =>
                by_cases hop : op = "function"
                · subst hop
                  exfalso
                  exact hThenNotFunction rest rfl
                · simp [evalResult]
            | var _ => simp [evalResult]
            | gnd _ => simp [evalResult]
            | expr _ => simp [evalResult]
    | sym _ => rfl
    | var _ => rfl
    | gnd _ => rfl
  have hfinal : isFinal (evalResult [] thenA m) = true := by
    simp [heval, finItem, isFinal]
  have hmemFuel :
      finalPair (evalResult [] thenA m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelEnv fuel st { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }
      (evalResult [] thenA m) [] [] hstack hfinal
  simpa [target, evalItemNil, atomToStack_eval, heval, finItem, finalPair, m, f, coreB,
    mExpr, mSym,
    instantiate_eq_self_of_vars_nil _ hThenClosed] using hmemFuel

/-- Root fuel-driver readout for the finite-control `if false` rule over closed branches.

The false rule is the second static `if` candidate, so its runtime freshening uses
`st.counter + 1`. This is the scheduler-facing mirror of
`interpretFuel_kernelEnv_if_true_root_contains`. -/
theorem interpretFuel_kernelEnv_if_false_root_contains
    (fuel : Nat) (st : St) (thenA elseA : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hElseNotFunction : ∀ tail, elseA ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail)) :
    (elseA,
        (renameBindings (counterSuffix (st.counter + 1))
          [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "if" [mBool false, thenA, elseA])] []).1 := by
  let target := mExpr "if" [mBool false, thenA, elseA]
  let coreB : Metta.Bindings :=
    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix (st.counter + 1)
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, mBool, hThenClosed, hElseClosed, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hElseClosed
      (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, bindingValueKeys]
  have hmatchCore : coreB ∈ Metta.matchAtoms ifFalseRulePair.1 target := by
    simpa [coreB, target] using
      (by
        rw [if_false_rule_match thenA elseA hThenNonVar hElseNonVar]
        simp :
        [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA] ∈
          Metta.matchAtoms ifFalseRulePair.1 (mExpr "if" [mBool false, thenA, elseA]))
  have hmatchFresh : renameBindings f coreB ∈
      Metta.matchAtoms (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).1
        target := by
    simpa [f] using
      matchAtoms_freshenRule_lhs_closed_target_mem (st.counter + 1) hclosedTarget hmatchCore
  have hmerge : m ∈ Metta.Bindings.merge [] (renameBindings f coreB) := by
    simpa [m, f] using
      (merge_empty_renamed_closed_nodup_mem (counterSuffix_injective (st.counter + 1))
        hclosedB hnodup)
  have hloop : Metta.Bindings.hasLoop m = false := by
    have hclosedRen : ClosedValueBindings (renameBindings (counterSuffix (st.counter + 1)) coreB) :=
      ClosedValueBindings.rename hclosedB
    simpa [m, f] using
      (ClosedValueBindings.hasLoop_false (ClosedValueBindings.reverse hclosedRen))
  have hquery :
      evalResult [] (Metta.instantiate m
          (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2) m ∈
        (queryOp kernelEnv st [] target []).1 := by
    simpa [target] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := kernelEnv) (st := st) (prev := []) (toEval := target) (b := [])
        (pre := [ifTrueRulePair]) (post := []) (p := ifFalseRulePair)
        (mb := renameBindings f coreB) (m := m)
        hStatic (by simp [target, isVariableHeaded, mExpr, mSym])
        (by simpa [target] using kernelEnv_if_candidates false thenA elseA)
        hmatchFresh hmerge hloop
  have hresult :
      Metta.instantiate m (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
        elseA := by
    have hf : Function.Injective f := by
      simpa [f] using counterSuffix_injective (st.counter + 1)
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename hclosedB
    have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
      rw [bindingValueKeys_renameBindings]
      exact List.Nodup.map hf hnodup
    have hreverse :
        Metta.instantiate (renameBindings f coreB).reverse
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 :=
      instantiate_reverse_closed_nodup hclosedRen hnodupRen _
    have hbound :
        ∀ v ∈ ifFalseRulePair.2.vars, ∃ t, Metta.Bindings.lookupVal coreB v = some t := by
      intro v hv
      have hv' : v = "e" := by
        simpa [ifFalseRulePair, mVar, Metta.Atom.vars] using hv
      subst v
      exact ⟨elseA, by simp [coreB, Metta.Bindings.lookupVal]⟩
    have hfresh :
        Metta.instantiate (renameBindings f coreB)
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
          Metta.instantiate coreB ifFalseRulePair.2 := by
      simpa [f] using
        instantiate_freshenRule_rhs_of_renamed_bindings
          (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2 coreB hbound
    have hcore : Metta.instantiate coreB ifFalseRulePair.2 = elseA :=
      if_false_instantiate_bindings thenA elseA
    calc
      Metta.instantiate m (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 := by
            simpa [m] using hreverse
      _ = Metta.instantiate coreB ifFalseRulePair.2 := hfresh
      _ = elseA := hcore
  have hstack :
      evalResult [] elseA m ∈
        (interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }).1 := by
    have hqueryElse :
        evalResult [] elseA m ∈ (queryOp kernelEnv st [] target []).1 := by
      simpa [hresult] using hquery
    exact (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "if" [mBool false, thenA, elseA]
      (evalResult [] elseA m)
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_if [mBool false, thenA, elseA])
      (by simp [isEmbeddedOp])).2 hqueryElse
  have heval : evalResult [] elseA m = finItem [] elseA m := by
    cases elseA with
    | expr xs =>
        cases xs with
        | nil => rfl
        | cons h rest =>
            cases h with
            | sym op =>
                by_cases hop : op = "function"
                · subst hop
                  exfalso
                  exact hElseNotFunction rest rfl
                · simp [evalResult]
            | var _ => simp [evalResult]
            | gnd _ => simp [evalResult]
            | expr _ => simp [evalResult]
    | sym _ => rfl
    | var _ => rfl
    | gnd _ => rfl
  have hfinal : isFinal (evalResult [] elseA m) = true := by
    simp [heval, finItem, isFinal]
  have hmemFuel :
      finalPair (evalResult [] elseA m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelEnv fuel st { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }
      (evalResult [] elseA m) [] [] hstack hfinal
  simpa [target, evalItemNil, atomToStack_eval, heval, finItem, finalPair, m, f, coreB,
    mExpr, mSym,
    instantiate_eq_self_of_vars_nil _ hElseClosed] using hmemFuel

/-- Root fuel-driver readout for the finite-control `is-bad` rule over a closed non-variable atom.

The emitted `unify` pattern contains the rule's escaping `e` variable freshened at the runtime
candidate counter. This theorem keeps that open variable explicit; the following `unify` fallback
lift consumes it when the normalized readout is not a `Bad` constructor. -/
theorem interpretFuel_kernelEnv_is_bad_root_contains
    (fuel : Nat) (st : St) (a : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    (mExpr "unify"
        [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false],
      (renameBindings (counterSuffix st.counter)
        [Metta.BindingRel.val "x" a]).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "is-bad" [a])] []).1 := by
  let target := mExpr "is-bad" [a]
  let coreB : Metta.Bindings := [Metta.BindingRel.val "x" a]
  let f := counterSuffix st.counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  let root :=
    mExpr "unify" [a, mExpr "Bad" [mVar (f "e")], mBool true, mBool false]
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, hClosed, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hClosed ClosedValueBindings.nil
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, bindingValueKeys]
  have hmatchCore : coreB ∈ Metta.matchAtoms isBadRulePair.1 target := by
    simpa [coreB, target] using
      (by
        rw [is_bad_rule_match a hNonVar]
        simp :
        [Metta.BindingRel.val "x" a] ∈
          Metta.matchAtoms isBadRulePair.1 (mExpr "is-bad" [a]))
  have hmatchFresh : renameBindings f coreB ∈
      Metta.matchAtoms (freshenRule st.counter isBadRulePair.1 isBadRulePair.2).1 target := by
    simpa [f] using
      matchAtoms_freshenRule_lhs_closed_target_mem st.counter hclosedTarget hmatchCore
  have hmerge : m ∈ Metta.Bindings.merge [] (renameBindings f coreB) := by
    simpa [m, f] using
      (merge_empty_renamed_closed_nodup_mem (counterSuffix_injective st.counter)
        hclosedB hnodup)
  have hloop : Metta.Bindings.hasLoop m = false := by
    have hclosedRen : ClosedValueBindings (renameBindings (counterSuffix st.counter) coreB) :=
      ClosedValueBindings.rename hclosedB
    simpa [m, f] using
      (ClosedValueBindings.hasLoop_false (ClosedValueBindings.reverse hclosedRen))
  have hquery :
      evalResult [] (Metta.instantiate m
          (freshenRule st.counter isBadRulePair.1 isBadRulePair.2).2) m ∈
        (queryOp kernelEnv st [] target []).1 := by
    simpa [target] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := kernelEnv) (st := st) (prev := []) (toEval := target) (b := [])
        (pre := []) (post := []) (p := isBadRulePair)
        (mb := renameBindings f coreB) (m := m)
        hStatic (by simp [target, isVariableHeaded, mExpr, mSym])
        (by simpa [target] using kernelEnv_is_bad_candidates a)
        hmatchFresh hmerge hloop
  have hxe : f "e" ≠ f "x" := by
    intro h
    have hx : "e" = "x" := (counterSuffix_injective st.counter) h
    contradiction
  have hxeRaw : "e#" ++ st.counter.repr ≠ "x#" ++ st.counter.repr := by
    simp [f, counterSuffix] at hxe ⊢
  have hsubstA :
      Metta.Subst.apply [(f "x", a)] a = a := by
    exact Metta.Subst.apply_of_closed _ _ hClosed
  have hsubstARaw :
      Metta.Subst.apply [("x#" ++ st.counter.repr, a)] a = a := by
    simpa [f, counterSuffix] using hsubstA
  have hresult :
      Metta.instantiate m (freshenRule st.counter isBadRulePair.1 isBadRulePair.2).2 =
        root := by
    rw [freshenRule_eq_renBy]
    simp [root, m, f, coreB, isBadRulePair, renameBindings, counterSuffix,
      Metta.instantiate, Metta.bindingsToSubst,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
      Metta.Subst.apply, Metta.Subst.lookup, hxeRaw,
      mExpr, mSym, mVar, mBool]
  have hrootStable : Metta.instantiate m root = root := by
    simp [root, m, f, coreB, renameBindings, counterSuffix,
      Metta.instantiate, Metta.bindingsToSubst, Metta.Subst.apply,
      Metta.Subst.lookup, hsubstARaw, hxeRaw,
      mExpr, mSym, mVar, mBool]
  have hstack :
      evalResult [] root m ∈
        (interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }).1 := by
    have hqueryRoot :
        evalResult [] root m ∈ (queryOp kernelEnv st [] target []).1 := by
      simpa [hresult] using hquery
    exact (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "is-bad" [a]
      (evalResult [] root m)
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_isBad a)
      (by simp [isEmbeddedOp])).2 hqueryRoot
  have heval : evalResult [] root m = finItem [] root m := by
    simp [root, evalResult, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root m) = true := by
    simp [heval, finItem, isFinal]
  have hmemFuel :
      finalPair (evalResult [] root m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelEnv fuel st { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }
      (evalResult [] root m) [] [] hstack hfinal
  have hmemPair :
      (root, m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 := by
    simpa [heval, finItem, finalPair, hrootStable] using hmemFuel
  simpa [target, evalItemNil, atomToStack_eval, root, m,
    f, coreB, hrootStable, mExpr, mSym] using hmemPair

/-- Every executable RHS item emitted by the `is-bad` equation rule is final under an empty
continuation: the rule's RHS is headed by embedded `unify`, never by `function`. -/
private theorem isFinal_evalResult_nil_instantiate_freshen_isBad
    (counter : Nat) (b : Metta.Bindings) :
    isFinal
      (evalResult []
        (Metta.instantiate b (freshenRule counter isBadRulePair.1 isBadRulePair.2).2) b) =
  true := by
  simp [isBadRulePair, freshenRule, Metta.instantiate,
    Metta.bindingsToSubst, Metta.Subst.apply, Metta.Subst.lookup,
    Metta.Atom.vars, evalResult, finItem, isFinal, mExpr, mSym, mVar, mBool]

/-- The `is-bad` root scheduler step preserves the absence of local `&self` rules.

This is the state half paired with `interpretFuel_kernelEnv_is_bad_root_contains`; it is needed by
the invariant-aware unary metta-evaluator fold, because the recursive `unify` readout ultimately
evaluates a grounded Boolean only under states whose local rule slice is still empty. -/
theorem interpretFuel_kernelEnv_is_bad_root_selfExtra
    (fuel : Nat) (st : St) (a : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (_hClosed : a.vars = [])
    (_hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    ((interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "is-bad" [a])] []).2).world.selfExtra = [] := by
  let target := mExpr "is-bad" [a]
  have hstep :
      interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] } =
        queryOp kernelEnv st [] target [] := by
    change interpretStack1 kernelEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := [] } =
      queryOp kernelEnv st [] target []
    exact interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "is-bad" [a]
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_isBad a)
      (by simp [isEmbeddedOp])
  have hqueryWorld : (queryOp kernelEnv st [] target []).2.world.selfExtra = [] := by
    have hw := queryOp_world kernelEnv st [] target []
    rw [hw]
    exact hStatic
  have hnonfinals :
      (queryOp kernelEnv st [] target []).1.filter (fun r => !isFinal r) = [] := by
    apply List.filter_eq_nil_iff.mpr
    intro item hmem
    have hfin : isFinal item = true := by
      unfold queryOp at hmem
      rw [candidatesW_eq_candidates_of_no_selfExtra kernelEnv st.world target hStatic] at hmem
      rw [kernelEnv_is_bad_candidates a] at hmem
      simp only [List.foldl_cons, List.foldl_nil] at hmem
      simp [target, mExpr, mSym, isVariableHeaded] at hmem
      by_cases hall :
          ∀ mb ∈ Metta.matchAtoms
                (freshenRule st.counter isBadRulePair.1 isBadRulePair.2).1
                (Metta.Atom.expr [Metta.Atom.sym "is-bad", a]),
            ∀ m ∈ Metta.Bindings.merge [] mb, Metta.Bindings.hasLoop m = true
      · rw [if_pos hall] at hmem
        have hitem : item = finItem [] notReducibleA [] := by
          simpa [finItem] using hmem
        rw [hitem]
        simp [finItem, isFinal]
      · simp [hall] at hmem
        rcases hmem with ⟨mb, _hmb, m, _hm, _hloopFalse, heq⟩
        simpa [← heq] using
          isFinal_evalResult_nil_instantiate_freshen_isBad st.counter m
    simp [hfin]
  have hstepExpanded :
      interpretStack1 kernelEnv fuel st
          { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", mExpr "is-bad" [a]] } :: [],
            bnd := [] } =
        queryOp kernelEnv st [] (mExpr "is-bad" [a]) [] := by
    simpa [target, mExpr, mSym] using hstep
  have hnonfinalsExpanded :
      (queryOp kernelEnv st [] (mExpr "is-bad" [a]) []).1.filter (fun r => !isFinal r) =
        [] := by
    simpa [target] using hnonfinals
  have hqueryWorldExpanded :
      (queryOp kernelEnv st [] (mExpr "is-bad" [a]) []).2.world.selfExtra = [] := by
    simpa [target] using hqueryWorld
  rw [interpretFuel_cons_step_eq]
  simp only [evalItemNil, atomToStack_eval, List.append_nil]
  rw [hstepExpanded, hnonfinalsExpanded]
  simpa [interpretFuel] using hqueryWorldExpanded

/-- Exact `queryOp` readout for the finite-control `is-bad` root in states with
no local rules. -/
private theorem queryOp_kernelEnv_is_bad_eq
    (st : St) (a : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    queryOp kernelEnv st [] (mExpr "is-bad" [a]) [] =
      ( [evalResult []
            (mExpr "unify"
              [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false])
            ((renameBindings (counterSuffix st.counter)
              [Metta.BindingRel.val "x" a]).reverse)]
      , { counter := st.counter + 1, world := st.world }) := by
  unfold queryOp
  have hNotVarHead : isVariableHeaded (mExpr "is-bad" [a]) = false := by
    simp [isVariableHeaded, mExpr, mSym]
  rw [hNotVarHead]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [candidatesW_eq_candidates_of_no_selfExtra kernelEnv st.world (mExpr "is-bad" [a]) hStatic]
  rw [kernelEnv_is_bad_candidates a]
  have hitems :
      queryOpItemsOfRule [] (mExpr "is-bad" [a]) [] st.counter isBadRulePair =
        [evalResult []
          (mExpr "unify"
            [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false])
          ((renameBindings (counterSuffix st.counter)
            [Metta.BindingRel.val "x" a]).reverse)] :=
    queryOpItems_kernelEnv_is_bad_eq st.counter a hClosed hNonVar
  simp only [List.foldl_cons, List.foldl_nil]
  have hresults :
      [] ++
          List.flatMap
            (fun mb =>
              List.filterMap
                (fun x =>
                  if x.hasLoop = true then none
                  else
                    some (evalResult [] (instantiate x (freshenRule st.counter isBadRulePair.1 isBadRulePair.2).2) x))
                (Bindings.merge [] mb))
            (matchAtoms (freshenRule st.counter isBadRulePair.1 isBadRulePair.2).1
              (mExpr "is-bad" [a])) =
        [evalResult []
          (mExpr "unify"
            [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false])
          ((renameBindings (counterSuffix st.counter)
            [Metta.BindingRel.val "x" a]).reverse)] := by
    simpa [queryOpItemsOfRule] using hitems
  rw [hresults]
  simp

/-- Exact root fuel-driver readout for the finite-control `is-bad` rule over a
closed non-variable atom.

This is the exact-state counterpart of
`interpretFuel_kernelEnv_is_bad_root_contains`: the executable scheduler runs
the single `is-bad` candidate, harvests its final `unify` root item, increments
the gensym counter once, and preserves the local-rule slice.  The explicit
freshened RHS variable (`e#counter`) is kept in the root atom on purpose; the
next theorem consumes it through the `unify` miss branch. -/
theorem interpretFuel_kernelEnv_is_bad_root_eq
    (fuel : Nat) (st : St) (a : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "is-bad" [a])] [] =
      ( [ (mExpr "unify"
            [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false],
            (renameBindings (counterSuffix st.counter)
              [Metta.BindingRel.val "x" a]).reverse) ]
      , { counter := st.counter + 1, world := st.world }) := by
  let target := mExpr "is-bad" [a]
  let root :=
    mExpr "unify" [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false]
  let m : Metta.Bindings :=
    (renameBindings (counterSuffix st.counter)
      [Metta.BindingRel.val "x" a]).reverse
  have hstep :
      interpretStack1 kernelEnv fuel st (evalItemNil target) =
        ([evalResult [] root m], { counter := st.counter + 1, world := st.world }) := by
    change interpretStack1 kernelEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := [] } =
      ([evalResult [] root m], { counter := st.counter + 1, world := st.world })
    rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "is-bad" [a]]
    · simpa [target, root, m, evalResult, mExpr, mSym] using
        queryOp_kernelEnv_is_bad_eq st a hStatic hClosed hNonVar
    · simp [target, mExpr, mSym, Metta.instantiate_nil]
    · exact kernelEnv_callGrounded_isBad a
    · simp [isEmbeddedOp]
  have hrootStable : Metta.instantiate m root = root := by
    have hxe :
        counterSuffix st.counter "e" ≠ counterSuffix st.counter "x" := by
      intro h
      have hx : "e" = "x" := (counterSuffix_injective st.counter) h
      contradiction
    have hsubstA :
        Metta.Subst.apply [(counterSuffix st.counter "x", a)] a = a := by
      exact Metta.Subst.apply_of_closed _ _ hClosed
    simpa [root, m, renameBindings, counterSuffix,
      Metta.instantiate, Metta.bindingsToSubst,
      Metta.Subst.apply, Metta.Subst.lookup, hsubstA, hxe,
      mExpr, mSym, mVar, mBool]
  have heval : evalResult [] root m = finItem [] root m := by
    simp [root, evalResult, finItem, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root m) = true := by
    simp [root, evalResult, finItem, isFinal, mExpr, mSym]
  have hpair :
      finalPair (evalResult [] root m) = (root, m) := by
    rw [heval]
    change (Metta.instantiate m root, m) = (root, m)
    simp [hrootStable]
  rw [interpretFuel, hstep]
  simp [interpretFuel, hfinal, hpair, root, m]

/-- The full executable kernel environment exposes the stdlib structural equality signature locally. -/
theorem kernelEnv_eq_sigs :
    kernelEnv.sigs.get? "==" =
      some [mSym "Atom", mSym "Atom", mSym "Bool"] := by
  simp only [kernelEnv]
  unfold kernelControlSigs
  repeat rw [Std.HashMap.get?_insert]
  simp [mSym]

private theorem kernelEnv_eq_types_getD :
    kernelEnv.types.getD "==" [] =
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Bool"]] := by
  simp only [kernelEnv]
  unfold kernelControlTypes
  repeat rw [Std.HashMap.getD_insert]
  simp [mExpr, mSym]

/-- Equality is Boolean-returning, so the outer evaluator recurses through the
grounded result. -/
theorem kernelEnv_eq_returnsAtom
    (a b : Metta.Atom) :
    returnsAtom kernelEnv (mExpr "==" [a, b]) = false := by
  simp only [returnsAtom, mExpr, mSym, headKey]
  rw [kernelEnv_eq_sigs]
  rfl

theorem kernelEnv_eq_argMask :
    argMask kernelEnv "==" 2 = [false, false] := by
  rw [argMask, kernelEnv_eq_sigs]
  rfl

/-- The static candidate slice for the core `is-bad` runtime query contains the single
`is-bad` rule. -/
theorem kernelCoreEnv_is_bad_candidates (a : Metta.Atom) :
    candidatesW kernelCoreEnv St.init.world (mExpr "is-bad" [a]) =
      [] ++ isBadRulePair :: [] := by
  simp [candidatesW, MinEnv.candidates, kernelCoreEnv, mExpr, mSym, mVar,
    headKey, St.init, World.empty, Metta.ruleIndex_getD, Metta.ofAtomsGT_varRules,
    kernelCoreRules, runtimeDecls, ruleIsBad, isBadRulePair, ruleNfVar, ruleNfSrt,
    ruleNfCon, ruleNfPi, ruleNfLam, ruleNfBad, ruleInferSrtType, ruleInferSrtKind,
