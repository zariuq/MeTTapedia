/-- Expected-`Bool` and ordinary evaluation take the same path for a singleton operator whose
arguments are all quoted `Atom`s and whose result is `Bool`.  The equality is selected-policy
agreement, not a post-hoc cast/filter argument. -/
theorem mettaEvalExpected_eq_mettaEval_of_atom_args_bool
    (env : MinEnv) (fuel : Nat) (st : St) (op : String) (args : List Metta.Atom)
    (hTypes : getTypes env (typePrep st.world (.sym op)) =
      [.expr (.sym "->" ::
        List.replicate args.length (.sym "Atom") ++ [.sym "Bool"])]) :
    mettaEvalExpected env (fuel + 1) st [] (.expr (.sym op :: args)) (.sym "Bool") =
      mettaEval env (fuel + 1) st [] (.expr (.sym op :: args)) := by
  let selected : SelectedFunctionType :=
    { functionType := .expr (.sym "->" ::
        List.replicate args.length (.sym "Atom") ++ [.sym "Bool"])
      argumentTypes := List.replicate args.length (.sym "Atom")
      returnType := .sym "Bool"
      typeBindings := [] }
  by_cases hNotError : (Metta.Atom.expr (Metta.Atom.sym op :: args)).isError = false
  · have hOrdinary :
        selectFunctionType env st.world (.sym op) args = .selected selected := by
      simpa [selected] using
        Metta.selectFunctionType_atom_args_bool_selected env st.world op args hTypes
    have hExpectedSelected :
        selectFunctionTypeForExpected env st.world (.sym op) args (.sym "Bool") =
          .selected selected := by
      simpa [selected] using
        Metta.selectFunctionTypeForExpected_atom_args_bool_selected
          env st.world op args hTypes
    have hTypesArrow :
        getTypes env (typePrep st.world (.sym op)) =
          [.expr (("->" ::
            (List.replicate args.length "Atom" ++ ["Bool"])).map Atom.sym)] := by
      simpa using hTypes
    have hHead :
        mettaTypeCastAvoiding
            (expectedApplicationVisibleScope (.expr (.sym op :: args)) (.sym "Bool"))
            env st.world selected.typeBindings (.sym op)
            selected.functionType = .inr [] := by
      simpa [selected] using
        (mettaTypeCastAvoiding_symbolic_arrow
          (expectedApplicationVisibleScope (.expr (.sym op :: args)) (.sym "Bool"))
          env st.world op
          (List.replicate args.length "Atom" ++ ["Bool"]) hTypesArrow)
    have hOrdinaryPlan : ApplicationPlanCorresponds []
        (.selected selected hOrdinary) := by
      simpa [selected] using
        (applicationPlanCorresponds_atom_args_symbolic_return_selected
          env st.world op "Bool" args hTypes hOrdinary)
    exact mettaEvalExpected_eq_mettaEval_of_same_selected
      env fuel st op args (.sym "Bool") (by rfl) (by rfl) hNotError selected
        hOrdinary hOrdinaryPlan hExpectedSelected [] hHead (by simp)
  · have hError : (Metta.Atom.expr (Metta.Atom.sym op :: args)).isError = true := by
      cases hValue : (Metta.Atom.expr (Metta.Atom.sym op :: args)).isError <;> simp_all
    simp [mettaEvalExpected, mettaEval, Metta.instantiate_nil, hError]

/-- Transport a concrete ordinary-evaluation equation across the exact all-`Atom`/`Bool`
selection boundary.  The positive-fuel shape is intentional: it is precisely the recursive
application frontier at which both scans select the same complete policy. -/
theorem mettaEvalExpected_eq_of_atom_args_bool_eval
    (env : MinEnv) (fuel : Nat) (st : St) (op : String) (args : List Metta.Atom)
    (hTypes : getTypes env (typePrep st.world (.sym op)) =
      [.expr (.sym "->" ::
        List.replicate args.length (.sym "Atom") ++ [.sym "Bool"])])
    {result : List (Metta.Atom × Metta.Bindings) × St}
    (hEval : mettaEval env (fuel + 1) st [] (.expr (.sym op :: args)) = result) :
    mettaEvalExpected env (fuel + 1) st [] (.expr (.sym op :: args)) (.sym "Bool") =
      result := by
  rw [mettaEvalExpected_eq_mettaEval_of_atom_args_bool env fuel st op args hTypes]
  exact hEval

private theorem typeCheckArgsOutcome_bool_atom_atom_of_bool_mem
    (env : MinEnv) (w : World) (cond thenA elseA : Metta.Atom)
    (hBool : mSym "Bool" ∈ getTypes env (typePrep w cond)) :
    ∃ tb, typeCheckArgsOutcome env w [mSym "Bool", mSym "Atom", mSym "Atom"] 0 []
      [cond, thenA, elseA] = .success tb := by
  let condAvoid :=
    applicationTypeInferenceScope (.sym "%Undefined%")
        [cond, thenA, elseA] ++
      typeInferenceAvoid env (Metta.Atom.expr [cond, thenA, elseA])
      ([mSym "Bool", mSym "Atom", mSym "Atom"] ++
        getTypes env (typePrep w cond)) ++ Metta.Bindings.vars []
  let condActuals :=
    (getTypes env (typePrep w cond)).map
      (freshenTypeCandidate condAvoid 0)
  have hBoolActual : mSym "Bool" ∈ condActuals := by
    apply List.mem_map.mpr
    refine ⟨mSym "Bool", hBool, ?_⟩
    simp [freshenTypeCandidate, renameAllVars, mSym]
  have hmatchBool : matchType ([] : Metta.Bindings) (mSym "Bool") (mSym "Bool") = some [] := by
    simp [matchType, matchReduced, Metta.matchAtoms, Metta.matchAtomsWith, mSym,
      Metta.Bindings.merge]
  have hSelected : ∃ output,
      (scanActualTypes ([] : Metta.Bindings) (mSym "Bool") condActuals).selected =
        some output :=
    scanActualTypes_selected_some_of_mem_match [] (mSym "Bool") condActuals
      (mSym "Bool") [] hBoolActual hmatchBool
  apply typeCheckArgsOutcome_cons_selected_gradual_tail env w
    [mSym "Bool", mSym "Atom", mSym "Atom"] 0 [] cond [thenA, elseA]
    (mSym "Bool")
  · simp [mSym]
  · simpa [condActuals, condAvoid] using hSelected
  · intro j hj
    simp at hj
    have hj' : j = 0 ∨ j = 1 := by omega
    rcases hj' with rfl | rfl <;> simp [mSym]

private theorem typeCheckArgs_bool_atom_atom_of_bool_mem
    (env : MinEnv) (w : World) (cond thenA elseA : Metta.Atom)
    (hBool : mSym "Bool" ∈ getTypes env (typePrep w cond)) :
    typeCheckArgs env w [mSym "Bool", mSym "Atom", mSym "Atom"] 0 []
      [cond, thenA, elseA] = none := by
  rcases typeCheckArgsOutcome_bool_atom_atom_of_bool_mem env w cond thenA elseA hBool with
    ⟨tb, htb⟩
  simp [typeCheckArgs, htb]

private theorem typeCheckArgsOutcome_atom_undefined_atom
    (env : MinEnv) (w : World) (pattern atom template : Metta.Atom) :
