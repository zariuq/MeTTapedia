theorem unifyOp_var_success_eq
    (prev : Metta.Minimal.Stack)
    (binder : String) (atom template : Metta.Atom)
    (hAtom : ∀ w, atom ≠ Metta.Atom.var w)
    (hNoLoop : binder ∉ atom.vars) :
    Metta.Minimal.unifyOp prev atom (mVar binder) template (mSym "Empty") [] =
      [Metta.Minimal.finItem prev
        (Metta.instantiate [Metta.BindingRel.val binder atom] template)
        [Metta.BindingRel.val binder atom]] := by
  have hmatch := matchAtoms_nonvar_var_eq binder atom hAtom
  have hmerge :
      Metta.Bindings.merge [] [Metta.BindingRel.val binder atom] =
        [[Metta.BindingRel.val binder atom]] := by
    simp [Metta.Bindings.merge, Metta.Bindings.mergeOne,
      Metta.Bindings.addVarBinding, Metta.Bindings.lookupVal,
      Metta.Bindings.addValRaw, Metta.Bindings.removeVal]
  have hloop :
      Metta.Bindings.hasLoop [Metta.BindingRel.val binder atom] = false :=
    hasLoop_singleton_val_not_false binder atom hNoLoop
  unfold Metta.Minimal.unifyOp
  rw [hmatch]
  simp [hmerge, hloop]

theorem unifyOp_success_eq_of_match_merge_noLoop
    (prev : Metta.Minimal.Stack)
    (atom pattern template elseAtom : Metta.Atom)
    (b mb rootBnd : Metta.Bindings)
    (hmatch : Metta.matchAtoms atom pattern = [mb])
    (hmerge : Metta.Bindings.merge b mb = [rootBnd])
    (hloop : Metta.Bindings.hasLoop rootBnd = false) :
    Metta.Minimal.unifyOp prev atom pattern template elseAtom b =
      [Metta.Minimal.finItem prev (Metta.instantiate rootBnd template) rootBnd] := by
  unfold Metta.Minimal.unifyOp
  rw [hmatch]
  simp [hmerge, hloop]

theorem interpretStack1_unify_var_success
    (env : Metta.Minimal.MinEnv) (fuel : Nat) (st : Metta.Minimal.St)
    (prev : Metta.Minimal.Stack)
    (binder : String) (atom template : Metta.Atom)
    (hAtom : ∀ w, atom ≠ Metta.Atom.var w)
    (hNoLoop : binder ∉ atom.vars) :
    Metta.Minimal.finItem prev
        (Metta.instantiate [Metta.BindingRel.val binder atom] template)
        [Metta.BindingRel.val binder atom] ∈
      (Metta.Minimal.interpretStack1 env fuel st
        { stack :=
            { atom := mExpr "unify" [atom, mVar binder, template, mSym "Empty"] } :: prev,
          bnd := [] }).1 := by
  have hmatch :
      [Metta.BindingRel.val binder atom] ∈
        Metta.matchAtoms atom (mVar binder) :=
    matchAtoms_nonvar_var_singleton binder atom hAtom
  have hmerge :
      [Metta.BindingRel.val binder atom] ∈
        Metta.Bindings.merge [] [Metta.BindingRel.val binder atom] :=
    singleton_val_mem_merge_empty_left binder atom
  have hloop :
      Metta.Bindings.hasLoop [Metta.BindingRel.val binder atom] = false :=
    hasLoop_singleton_val_not_false binder atom hNoLoop
  have hunify :
      Metta.Minimal.finItem prev
          (Metta.instantiate [Metta.BindingRel.val binder atom] template)
          [Metta.BindingRel.val binder atom] ∈
        Metta.Minimal.unifyOp prev atom (mVar binder) template (mSym "Empty") [] :=
    mem_unifyOp_success_of_match_merge_noLoop
      (prev := prev) (a := atom) (p := mVar binder) (t := template)
      (e := mSym "Empty") (b := [])
      (mb := [Metta.BindingRel.val binder atom])
      (m := [Metta.BindingRel.val binder atom])
      hmatch hmerge hloop
  exact
    (mem_interpretStack1_unify_iff env fuel st prev atom (mVar binder)
      template (mSym "Empty") []
      (Metta.Minimal.finItem prev
        (Metta.instantiate [Metta.BindingRel.val binder atom] template)
        [Metta.BindingRel.val binder atom])).2 hunify

theorem interpretStack1_unify_var_success_eq
    (env : Metta.Minimal.MinEnv) (fuel : Nat) (st : Metta.Minimal.St)
    (prev : Metta.Minimal.Stack)
    (binder : String) (atom template : Metta.Atom)
    (hAtom : ∀ w, atom ≠ Metta.Atom.var w)
    (hNoLoop : binder ∉ atom.vars) :
    Metta.Minimal.interpretStack1 env fuel st
        { stack :=
            { atom := mExpr "unify" [atom, mVar binder, template, mSym "Empty"] } :: prev,
          bnd := [] } =
      ([Metta.Minimal.finItem prev
        (Metta.instantiate [Metta.BindingRel.val binder atom] template)
        [Metta.BindingRel.val binder atom]], st) := by
  simpa [mExpr, mSym] using
    (by
      rw [interpretStack1_unify_eq]
      rw [unifyOp_var_success_eq prev binder atom template hAtom hNoLoop] :
      Metta.Minimal.interpretStack1 env fuel st
          { stack :=
              { atom :=
                  Metta.Atom.expr
                    [Metta.Atom.sym "unify", atom, mVar binder, template, mSym "Empty"] } ::
