  rcases interpretFuel_kernelDefControlEnv_is_bad_root_eq_from_closed
      (fuel + 2) st a incoming hStatic hImports hClosed hNonVar hIncoming with
    ⟨x, e, hxe, hxIncoming, heIncoming, hRootStep⟩
