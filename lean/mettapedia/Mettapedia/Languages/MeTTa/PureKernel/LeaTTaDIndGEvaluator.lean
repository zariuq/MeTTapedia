    simp [root, evalResult, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root m) = true := by
    simp [heval, finItem, isFinal]
  have hpair : finalPair (evalResult [] root m) = (root, m) := by
    rw [heval]
    change (Metta.instantiate m root, m) = (root, m)
