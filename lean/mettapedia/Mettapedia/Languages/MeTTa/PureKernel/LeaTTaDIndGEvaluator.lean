      [Metta.BindingRel.val leattaDefControlNonWitnessNfDefFreshBinder bodyAtom]
    let rootItem : Item :=
      { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", target]) [],
        bnd := ambient }
