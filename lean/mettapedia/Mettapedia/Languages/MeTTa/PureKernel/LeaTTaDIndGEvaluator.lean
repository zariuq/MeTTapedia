/-- In the full executable kernel, an `is-bad` call is known to have Boolean type.

This is the type-table fact needed for stdlib `if`: unlike the `Atom`-quoted branch arguments,
the condition position is checked against `Bool`. -/
theorem kernelEnv_getTypes_is_bad_bool_init (a : Metta.Atom) :
    mSym "Bool" ∈ getTypes kernelEnv (typePrep St.init.world (mExpr "is-bad" [a])) := by
  rw [typePrep_init_world_eq_self]
  rw [getTypes.eq_def]
  simp [mExpr, mSym, kernelEnv_exprTypes_no_is_bad_expr]
  rw [show getTypes kernelEnv (Metta.Atom.sym "is-bad") =
      [Metta.Atom.expr [Metta.Atom.sym "->", Metta.Atom.sym "Atom", Metta.Atom.sym "Bool"]] by
    simpa [mExpr, mSym] using kernelEnv_getTypes_is_bad_sym]
  obtain ⟨ta, tla, ha⟩ := List.exists_cons_of_ne_nil (getTypes_ne_nil kernelEnv a)
  rw [ha]
  simp [cartesian, freshenArgumentTypes, freshenTypeCandidate, renameAllVars,
    matchApplicationTypeArguments, matchType_atom_left, instantiate_sym]

end

/-- Exact selected policy for `if` when the condition has a Boolean runtime type. -/
def kernelEnv_if_exactPolicy_of_bool_mem
    (st : St) (cond thenA elseA : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelEnv st.world "if"
      [mExpr "->" [mSym "Bool", mSym "Atom", mSym "Atom", mSym "%Undefined%"]])
    (hBool : mSym "Bool" ∈ getTypes kernelEnv (typePrep st.world cond)) :
    EvalQuotedQuotedApplicationPolicy kernelEnv st.world "if"
      [cond, thenA, elseA] (mSym "Bool") := by
  let outcome := typeCheckArgsOutcome kernelEnv st.world
    [mSym "Bool", mSym "Atom", mSym "Atom"] 0 [] [cond, thenA, elseA]
  let tb := match outcome with
    | .success output => output
    | .failure _ _ _ => []
  have hOutcome : outcome = .success tb := by
    rcases typeCheckArgsOutcome_bool_atom_atom_of_bool_mem
        kernelEnv st.world cond thenA elseA hBool with ⟨output, hOutput⟩
    have hOutput' : outcome = .success output := by
      simpa [outcome] using hOutput
    simp [tb, hOutput']
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->"
        [mSym "Bool", mSym "Atom", mSym "Atom", mSym "%Undefined%"]
      argumentTypes := [mSym "Bool", mSym "Atom", mSym "Atom"]
      returnType := mSym "%Undefined%"
      typeBindings := tb }
  have hSelected :
      selectFunctionType kernelEnv st.world (.sym "if") [cond, thenA, elseA] =
        .selected selected := by
    unfold selectFunctionType
    rw [hPinned]
    simp [scanFunctionTypeCandidates, selected, mExpr, mSym]
    have hCheck' :
        typeCheckArgsOutcome kernelEnv st.world
            [.sym "Bool", .sym "Atom", .sym "Atom"] 0 [] [cond, thenA, elseA] =
          .success tb := by
      simpa [outcome, mSym] using hOutcome
    obtain ⟨latentErrors, hDetailed⟩ :=
      (typeCheckArgsOutcome_eq_success_iff _ _ _ _ _ _ _).mp hCheck'
    rw [hDetailed]
  have hMask : argMask selected 3 = [true, false, false] := by
    change
      [ (Metta.instantiate tb (mSym "Bool") != .sym "Atom") &&
          (Metta.instantiate tb (mSym "Bool") != .sym "Variable") &&
          (Metta.instantiate tb (mSym "Bool") != .sym "Expression")
      , (Metta.instantiate tb (mSym "Atom") != .sym "Atom") &&
          (Metta.instantiate tb (mSym "Atom") != .sym "Variable") &&
          (Metta.instantiate tb (mSym "Atom") != .sym "Expression")
      , (Metta.instantiate tb (mSym "Atom") != .sym "Atom") &&
          (Metta.instantiate tb (mSym "Atom") != .sym "Variable") &&
          (Metta.instantiate tb (mSym "Atom") != .sym "Expression") ] =
        [true, false, false]
    simp only [instantiate_mSym]
    rfl
  have hReturns : returnsAtom selected = false := by
    change (Metta.instantiate tb (mSym "%Undefined%") == .sym "Atom") = false
    rw [instantiate_mSym]
    decide
  let raw : ApplicationPolicyProjection kernelEnv st.world "if" [cond, thenA, elseA]
      [true, false, false] false :=
    ⟨.selected selected hSelected, hMask, hReturns⟩
  refine
    { raw := raw
      selected_eq := ?_
      argumentPolicies_eq := ?_
      resultExpected_eq := ?_ }
  · simpa [raw, ExactApplicationPolicy.selectedType] using hSelected
  · change
      [ ((Metta.instantiate tb (mSym "Bool") != .sym "Atom") &&
            (Metta.instantiate tb (mSym "Bool") != .sym "Variable") &&
            (Metta.instantiate tb (mSym "Bool") != .sym "Expression"),
          Metta.instantiate tb (mSym "Bool"))
      , ((Metta.instantiate tb (mSym "Atom") != .sym "Atom") &&
            (Metta.instantiate tb (mSym "Atom") != .sym "Variable") &&
            (Metta.instantiate tb (mSym "Atom") != .sym "Expression"),
          Metta.instantiate tb (mSym "Atom"))
      , ((Metta.instantiate tb (mSym "Atom") != .sym "Atom") &&
            (Metta.instantiate tb (mSym "Atom") != .sym "Variable") &&
            (Metta.instantiate tb (mSym "Atom") != .sym "Expression"),
          Metta.instantiate tb (mSym "Atom")) ] =
        [(true, mSym "Bool"), (false, .sym "Atom"), (false, .sym "Atom")]
    simp only [instantiate_mSym]
    rfl
  · change selectedResultExpected selected = .sym "%Undefined%"
    change (if Metta.instantiate tb (mSym "%Undefined%") == .sym "Expression"
      then .sym "%Undefined%" else Metta.instantiate tb (mSym "%Undefined%")) =
        .sym "%Undefined%"
    rw [instantiate_mSym]
    rfl

