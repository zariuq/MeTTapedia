private theorem queryOpItems_def_body_of_ddef_eq
    (counter : Nat)
    (rest : DIndGArtifactSig)
    (defName : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName)
    (type body : DIndGArtifactTerm)
    (queryName : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
    Metta.Minimal.queryOpItemsOfRule []
        (defBodyOfQueryAtom
          (sigAtom (sigWithHeadDecl (.ddef defName type body) rest))
          (declNameAtom queryName))
        [] counter defBodyOfDDefRulePair =
      [evalResult []
        (defBodyOfDDefReadout rest defName type body queryName)
        ((renameBindings (counterSuffix counter)
          (defBodyOfDDefRuleBindings rest defName type body queryName)).reverse)] := by
  let f := counterSuffix counter
  let target :=
    defBodyOfQueryAtom
      (sigAtom (sigWithHeadDecl (.ddef defName type body) rest))
      (declNameAtom queryName)
  let coreB : Metta.Bindings :=
    defBodyOfDDefRuleBindings rest defName type body queryName
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  let root := defBodyOfDDefReadout rest defName type body queryName
  have hf : Function.Injective f := by
    simpa [f] using counterSuffix_injective counter
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (declNameAtom_vars_nil queryName)
      (ClosedValueBindings.val (termAtom_vars_nil body)
        (ClosedValueBindings.val (termAtom_vars_nil type)
          (ClosedValueBindings.val (declNameAtom_vars_nil defName)
            (ClosedValueBindings.val (sigAtom_vars_nil rest) ClosedValueBindings.nil))))
  have hnodup : (bindingValueKeys coreB).Nodup := by
    dsimp [coreB, defBodyOfDDefRuleBindings, bindingValueKeys]
    decide
  have hmatch :
      Metta.matchAtoms
          (freshenRule counter defBodyOfDDefRuleLhs defBodyOfDDefRuleRhs).1
          target =
        [renameBindings f coreB] := by
    simpa [target, coreB, f] using
      fresh_def_body_of_ddef_rule_match
        counter rest defName type body queryName
  have hmerge :
      Metta.Bindings.merge [] (renameBindings f coreB) = [m] := by
    simpa [m, f, coreB] using
      merge_empty_renamed_value_nodup_eq (f := f) hf hclosedB hnodup
  have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
    ClosedValueBindings.rename hclosedB
  have hclosedM : ClosedValueBindings m := by
    simpa [m] using ClosedValueBindings.reverse hclosedRen
  have hloop : Metta.Bindings.hasLoop m = false := by
    simpa [m] using ClosedValueBindings.hasLoop_false hclosedM
  have hboundRhs :
      ∀ v ∈ defBodyOfDDefRuleRhs.vars,
        ∃ t, Metta.Bindings.lookupVal coreB v = some t := by
    intro v hv
    have hvRaw : v = "x" ∨ v = "c" ∨ v = "body" ∨ v = "rest" ∨ v = "x" := by
      simpa [defBodyOfDDefRuleRhs, defBodyOfQueryAtom, mExpr, mSym, mVar,
        Metta.Atom.vars] using hv
    have hv' : v = "x" ∨ v = "c" ∨ v = "body" ∨ v = "rest" := by
      rcases hvRaw with h | h | h | h | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (Or.inl h))
      · exact Or.inr (Or.inr (Or.inr h))
      · exact Or.inl h
    rcases hv' with rfl | rfl | rfl | rfl
    · exact ⟨declNameAtom queryName,
        by simp [coreB, defBodyOfDDefRuleBindings, Metta.Bindings.lookupVal]⟩
    · exact ⟨declNameAtom defName,
        by simp [coreB, defBodyOfDDefRuleBindings, Metta.Bindings.lookupVal]⟩
    · exact ⟨termAtom body,
        by simp [coreB, defBodyOfDDefRuleBindings, Metta.Bindings.lookupVal]⟩
    · exact ⟨sigAtom rest,
        by simp [coreB, defBodyOfDDefRuleBindings, Metta.Bindings.lookupVal]⟩
  have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
    rw [bindingValueKeys_renameBindings]
    exact List.Nodup.map hf hnodup
  have hresult :
      Metta.instantiate m
          (freshenRule counter defBodyOfDDefRuleLhs defBodyOfDDefRuleRhs).2 =
        root := by
    have hreverse :
        Metta.instantiate (renameBindings f coreB).reverse
            (freshenRule counter defBodyOfDDefRuleLhs defBodyOfDDefRuleRhs).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule counter defBodyOfDDefRuleLhs defBodyOfDDefRuleRhs).2 :=
      instantiate_reverse_closed_nodup hclosedRen hnodupRen _
    have hfresh :
        Metta.instantiate (renameBindings f coreB)
            (freshenRule counter defBodyOfDDefRuleLhs defBodyOfDDefRuleRhs).2 =
          Metta.instantiate coreB defBodyOfDDefRuleRhs := by
      simpa [f] using
        instantiate_freshenRule_rhs_of_renamed_bindings
          counter defBodyOfDDefRuleLhs defBodyOfDDefRuleRhs coreB
          hclosedB.toValueBindings hclosedB.valueKeysFreshForValues
          (hclosedB.renamedValueKeysFreshForValues _) hboundRhs
    calc
      Metta.instantiate m
          (freshenRule counter defBodyOfDDefRuleLhs defBodyOfDDefRuleRhs).2 =
        Metta.instantiate (renameBindings f coreB)
          (freshenRule counter defBodyOfDDefRuleLhs defBodyOfDDefRuleRhs).2 := by
          simpa [m] using hreverse
      _ = Metta.instantiate coreB defBodyOfDDefRuleRhs := hfresh
      _ = root := by
          simp [root, coreB, def_body_of_ddef_instantiate_bindings]
  rw [queryOpItemsOfRule_eq_legacy_of_target_vars_nil counter target
    defBodyOfDDefRulePair (by
      simp [target, defBodyOfQueryAtom, sigAtom_vars_nil,
        declNameAtom_vars_nil, mExpr, mSym, Metta.Atom.vars])]
  change
    List.flatMap
        (fun mb =>
          List.filterMap
            (fun m' =>
              if Metta.Bindings.hasLoop m' = true then none
              else
                some (evalResult []
                  (Metta.instantiate m'
                    (freshenRule counter defBodyOfDDefRulePair.1
                      defBodyOfDDefRulePair.2).2) m'))
            (Metta.Bindings.merge [] mb))
        (Metta.matchAtoms
          (freshenRule counter defBodyOfDDefRulePair.1
            defBodyOfDDefRulePair.2).1 target) =
      [evalResult [] root m]
  simp [defBodyOfDDefRulePair, hmatch, hmerge, hloop, hresult, root, m]

