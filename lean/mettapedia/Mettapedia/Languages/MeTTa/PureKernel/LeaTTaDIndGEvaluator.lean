private theorem mExpr_beq_head_mismatch_false
    {tagLeft tagRight : String}
    {leftArgs rightArgs : List Metta.Atom}
    (hEq : (mExpr tagLeft leftArgs == mExpr tagRight rightArgs) = true)
    (hNe : tagLeft ≠ tagRight) :
