/-- The `(eval a)` work item with an explicit binding environment. -/
private def evalItemBnd (b : Metta.Bindings) (a : Metta.Atom) : Item :=
  { stack := atomToStack (Atom.expr [Atom.sym "eval", a]) [], bnd := b }

/-- The stack frame for evaluating one atom. -/
private def evalFrame (a : Metta.Atom) : Frame :=
  { atom := Atom.expr [Atom.sym "eval", a] }

/-- The embedded `unify` work item with an explicit binding environment. -/
private def embeddedUnifyItem
    (b : Metta.Bindings) (atom pattern template elseAtom : Metta.Atom) : Item :=
  { stack := atomToStack (mExpr "unify" [atom, pattern, template, elseAtom]) [], bnd := b }

/-- Binding-threaded version of `interpretStack1_eval_embedded_unify_open`.

The caller supplies the stability fact saying the current bindings do not rewrite the embedded
`unify` expression. This is the form needed after an equality-rule root readout has threaded
rule-local bindings into the outer `mettaEval` loop. -/
theorem interpretStack1_eval_embedded_unify_open_of_instantiate
    (fuel : Nat) (st : St) (b : Metta.Bindings)
    (atom pattern template elseAtom : Metta.Atom)
    (hinst : Metta.instantiate b (mExpr "unify" [atom, pattern, template, elseAtom]) =
      mExpr "unify" [atom, pattern, template, elseAtom]) :
    interpretStack1 kernelCoreEnv fuel st
        (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom])) =
      ([embeddedUnifyItem b atom pattern template elseAtom], st) := by
  unfold evalItemBnd
  rw [show
      atomToStack (Atom.expr [Atom.sym "eval",
        mExpr "unify" [atom, pattern, template, elseAtom]]) [] =
        [evalFrame (mExpr "unify" [atom, pattern, template, elseAtom])] by
    simp [evalFrame, atomToStack_eval]]
  unfold evalFrame
  rw [interpretStack1_eval_eq]
  unfold evalOp
  rw [hinst]
  change
    ((match callGrounded kernelCoreEnv.gt "unify"
      ([atom, pattern, template, elseAtom].map
        (fun a => resolveStates st.world (subTokens st.world a))) with
    | ReduceResult.ok results =>
        (results.map (fun r => evalResult [] r b), st)
    | ReduceResult.runtimeError msg =>
        ([finItem [] (errAtom (mExpr "unify" [atom, pattern, template, elseAtom]) msg) b], st)
    | ReduceResult.incorrectArgument _ =>
        ([finItem [] notReducibleA b], st)
    | ReduceResult.noReduce =>
        if isEmbeddedOp (mExpr "unify" [atom, pattern, template, elseAtom]) then
          ([embeddedUnifyItem b atom pattern template elseAtom], st)
        else
          queryOp kernelCoreEnv st [] (mExpr "unify" [atom, pattern, template, elseAtom]) b) =
    ([embeddedUnifyItem b atom pattern template elseAtom], st))
  rw [kernelCoreEnv_callGrounded_unify
    ([atom, pattern, template, elseAtom].map
      (fun a => resolveStates st.world (subTokens st.world a)))]
  simp [embeddedUnifyItem, isEmbeddedOp, mExpr, mSym]

