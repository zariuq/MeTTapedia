      , mSym "ArgsNil"
      , mVar "motive"
      , mVar "cases"
      , mVar "indices"
      , mVar "scrut"
      , mVar "ctors"
      , mVar "T0" ]
  , mExpr "let"
      [ mVar "T1"
      , mExpr "infer-apply-args" [mVar "sig", mVar "ctx", mVar "T0", mSym "ArgsNil"]
      , mExpr "if"
          [ mExpr "is-bad" [mVar "T1"]
          , mVar "T1"
          , mExpr "infer-indg-motive"
              [ mVar "sig"
              , mVar "ctx"
              , mVar "motive"
              , mVar "cases"
