/-- Runtime type-checking succeeds for two arguments declared as `Atom`. -/
theorem typeCheckArgs_two_atom
    (env : MinEnv) (w : World) (a b : Metta.Atom) :
    typeCheckArgs env w [Metta.Atom.sym "Atom", Metta.Atom.sym "Atom"]
      0 [] [a, b] = none := by
  simp only [typeCheckArgs]
  obtain ⟨ta, tla, ha⟩ :=
    List.exists_cons_of_ne_nil (getTypes_ne_nil env (typePrep w a))
  rw [ha]
  simp [instantiate_nil, matchType_atom_left]
  obtain ⟨tb, tlb, hb⟩ :=
    List.exists_cons_of_ne_nil (getTypes_ne_nil env (typePrep w b))
  rw [hb]
  rfl

