      rw [hCand] at hmem
      simp only [List.foldl_cons, List.foldl_nil,
        Metta.Minimal.queryOpFoldStep] at hmem
      simp [target, mExpr, mSym, isVariableHeaded] at hmem
      by_cases hitems :
          Metta.Minimal.queryOpItemsOfRule []
              (Metta.Atom.expr
                [Metta.Atom.sym "let", mVar binder, atom, template]) []
              st.counter letRulePair = []
      · rw [if_pos hitems] at hmem
        have hitem : item = finItem [] notReducibleA [] := by
          simpa [finItem] using hmem
        rw [hitem]
        simp [finItem, isFinal]
      · rw [if_neg hitems] at hmem
        have hmemItems :
            item ∈ Metta.Minimal.queryOpItemsOfRule []
              (Metta.Atom.expr
                [Metta.Atom.sym "let", mVar binder, atom, template]) []
              st.counter letRulePair := by
          exact hmem
        rw [Mettapedia.Languages.MeTTa.LeaTTa.EvaluatorCorrectness.QueryOpBridge.mem_queryOpItemsOfRule_iff]
          at hmemItems
        rcases hmemItems with
          ⟨mb, _hmb, m, _hm, _hloopFalse, hitem⟩
        rw [hitem]
        exact isFinal_evalResult_nil_instantiate_freshenAvoiding_let
          st.counter (Metta.Minimal.queryOpAvoid [] target []) m
    simp [hfin]
  have hstepExpanded :
      interpretStack1 kernelDefControlEnv fuel st
          { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval",
              mExpr "let" [mVar binder, atom, template]] } :: [],
            bnd := [] } =
        queryOp kernelDefControlEnv st [] (mExpr "let" [mVar binder, atom, template]) [] := by
    simpa [target, mExpr, mSym] using hstep
  have hnonfinalsExpanded :
      (queryOp kernelDefControlEnv st [] (mExpr "let" [mVar binder, atom, template]) []).1.filter
          (fun r => !isFinal r) = [] := by
    simpa [target] using hnonfinals
  have hqueryWorldExpanded :
      (queryOp kernelDefControlEnv st []
          (mExpr "let" [mVar binder, atom, template]) []).2.world.selfExtra = [] ∧
        (queryOp kernelDefControlEnv st []
          (mExpr "let" [mVar binder, atom, template]) []).2.world.selfImports = [] ∧
        (queryOp kernelDefControlEnv st []
          (mExpr "let" [mVar binder, atom, template]) []).2.world = st.world := by
    simpa [target] using hqueryWorld
  rw [interpretFuel_cons_step_eq]
  simp only [evalItemNil, atomToStack_eval, List.append_nil]
  rw [hstepExpanded, hnonfinalsExpanded]
  simpa [interpretFuel] using hqueryWorldExpanded

private theorem interpretFuel_kernelDefControlEnv_let_root_eq_with_keyed_ambient
    {fuel : Nat} {st : St}
    (binder : String) (atom template : Metta.Atom)
    (ambient : Metta.Bindings)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hAtomNonVar : ∀ w, atom ≠ Metta.Atom.var w)
    (hTemplateNonVar : ∀ w, template ≠ Metta.Atom.var w)
    (hAtomFresh : counterSuffix st.counter "atom" ∉ atom.vars)
    (hTemplateFresh : counterSuffix st.counter "template" ∉ template.vars)
    (hPatternAtom : counterSuffix st.counter "pattern" ∉ atom.vars)
    (hTemplateAtom : counterSuffix st.counter "template" ∉ atom.vars)
    (hPatternTemplate : counterSuffix st.counter "pattern" ∉ template.vars)
    (hAtomTemplate : counterSuffix st.counter "atom" ∉ template.vars)
    (hPatternFresh : counterSuffix st.counter "pattern" ≠ binder)
    (hAtomBinder : counterSuffix st.counter "atom" ≠ binder)
    (hTemplateBinder : counterSuffix st.counter "template" ≠ binder)
    (hMerge :
      Metta.Bindings.merge ambient
          (renameBindings (counterSuffix st.counter)
            (letRuleBindings binder atom template)) =
        [(renameBindings (counterSuffix st.counter)
            (letRuleBindings binder atom template)).reverse ++ ambient])
    (hTargetInst :
      Metta.instantiate ambient (mExpr "let" [mVar binder, atom, template]) =
        mExpr "let" [mVar binder, atom, template])
    (hCompat :
      LegacyFresheningCompatible []
        (mExpr "let" [mVar binder, atom, template]) ambient st.counter
        letRulePair.1 letRulePair.2)
    (hResult :
      Metta.instantiate
          ((renameBindings (counterSuffix st.counter)
              (letRuleBindings binder atom template)).reverse ++ ambient)
          (freshenRule st.counter letRulePair.1 letRulePair.2).2 =
        mExpr "unify" [atom, mVar binder, template, mSym "Empty"])
    (hRootStable :
      Metta.instantiate
          ((renameBindings (counterSuffix st.counter)
              (letRuleBindings binder atom template)).reverse ++ ambient)
          (mExpr "unify" [atom, mVar binder, template, mSym "Empty"]) =
        mExpr "unify" [atom, mVar binder, template, mSym "Empty"])
    (hLoop :
      Metta.Bindings.hasLoop
          ((renameBindings (counterSuffix st.counter)
              (letRuleBindings binder atom template)).reverse ++ ambient) =
        false) :
    let target := mExpr "let" [mVar binder, atom, template]
    let root := mExpr "unify" [atom, mVar binder, template, mSym "Empty"]
    let rootBnd :=
      (renameBindings (counterSuffix st.counter)
        (letRuleBindings binder atom template)).reverse ++ ambient
    let rootItem : Item :=
      { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", target]) [],
        bnd := ambient }
    interpretFuel kernelDefControlEnv (fuel + 1) st [rootItem] [] =
      ([(root, rootBnd)], { counter := st.counter + 1, world := st.world }) := by
  dsimp
  let target := mExpr "let" [mVar binder, atom, template]
  let coreB := letRuleBindings binder atom template
  let f := counterSuffix st.counter
  let root := mExpr "unify" [atom, mVar binder, template, mSym "Empty"]
  let rootBnd : Metta.Bindings := (renameBindings f coreB).reverse ++ ambient
  let rootItem : Item :=
    { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", target]) [],
      bnd := ambient }
  let st' : St := { counter := st.counter + 1, world := st.world }
  have hmatch :
      Metta.matchAtoms (freshenRule st.counter letRulePair.1 letRulePair.2).1 target =
        [renameBindings f coreB] := by
    rw [fresh_let_rule_match st.counter binder atom template
      hAtomFresh hTemplateFresh hAtomNonVar hTemplateNonVar
      hAtomBinder hTemplateBinder
      hPatternAtom hTemplateAtom hPatternTemplate hAtomTemplate
      hPatternFresh]
    simp [coreB, letRuleBindings, f, renameBindings]
  have hmerge :
      Metta.Bindings.merge ambient (renameBindings f coreB) = [rootBnd] := by
    simpa [rootBnd, coreB, f] using hMerge
  have hitems :
      Metta.Minimal.queryOpItemsOfRule [] target ambient st.counter letRulePair =
        [evalResult [] root rootBnd] := by
    unfold Metta.Minimal.queryOpItemsOfRule
    rw [hCompat]
    rcases hfresh : freshenRule st.counter letRulePair.1 letRulePair.2 with
      ⟨lhs', rhs'⟩
    have hmatch' : Metta.matchAtoms lhs' target = [renameBindings f coreB] := by
      simpa [hfresh] using hmatch
    have hResult' : Metta.instantiate rootBnd rhs' = root := by
      simpa [root, rootBnd, coreB, f, hfresh] using hResult
    have hLoop' : Metta.Bindings.hasLoop rootBnd = false := by
      simpa [rootBnd, coreB, f] using hLoop
    change
      List.flatMap
          (fun mb =>
            List.filterMap
              (fun m =>
                if Metta.Bindings.hasLoop m = true then none
                else some (evalResult [] (Metta.instantiate m rhs') m))
              (Metta.Bindings.merge ambient mb))
          (Metta.matchAtoms lhs' target) =
        [evalResult [] root rootBnd]
    rw [hmatch']
    simp only [List.flatMap_cons, List.flatMap_nil]
    rw [hmerge]
    simp [hLoop', hResult']
  have hquery :
      queryOp kernelDefControlEnv st [] target ambient =
        ([evalResult [] root rootBnd], st') := by
    have hNotVarHead : isVariableHeaded target = false := by
      simp [target, isVariableHeaded, mExpr, mSym]
    have hCand : kernelDefControlEnv.candidates target = [letRulePair] := by
      have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
        simp [MinEnv.candidates, kernelDefControlEnv]
      rw [hcandidateEq]
      simpa [target] using kernelEnv_let_candidates binder atom template
    unfold queryOp
    rw [hNotVarHead]
    simp only [Bool.false_eq_true, ↓reduceIte]
    rw [candidatesW_eq_candidates_of_no_selfRules
      kernelDefControlEnv st.world target hStatic hImports]
    rw [hCand]
    simp only [List.foldl_cons, List.foldl_nil, Metta.Minimal.queryOpFoldStep]
    rw [hitems]
    rw [Metta.Minimal.freshenRuleAvoiding_counter]
    simp [st']
  have hstep :
      interpretStack1 kernelDefControlEnv fuel st rootItem =
        ([evalResult [] root rootBnd], st') := by
    change interpretStack1 kernelDefControlEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := ambient } =
      ([evalResult [] root rootBnd], st')
    rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelDefControlEnv fuel st [] target ambient "let" [mVar binder, atom, template]]
    · exact hquery
    · exact hTargetInst
    · exact kernelDefControlEnv_callGrounded_let
        ([mVar binder, atom, template].map
          (fun a => resolveStates st.world (subTokens st.world a)))
    · simp [isEmbeddedOp]
  have heval : evalResult [] root rootBnd = finItem [] root rootBnd := by
    simp [root, evalResult, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root rootBnd) = true := by
    simp [heval, finItem, isFinal]
  have hpair : finalPair (evalResult [] root rootBnd) = (root, rootBnd) := by
    rw [heval]
    change (Metta.instantiate rootBnd root, rootBnd) = (root, rootBnd)
    simpa [rootBnd, root, coreB, f] using congrArg (fun a => (a, rootBnd)) hRootStable
  have hnotEmpty : (root != emptyA) = true := by
    simp [root, mExpr, mSym]
  rw [interpretFuel, hstep]
  simp [interpretFuel, hfinal, hpair, hnotEmpty, root, rootBnd, coreB, f, st']

private theorem renamedValueKeysFreshForValues_letRuleBindings_convReadoutAfterNxNamed
    (st : St) (nxBinder nyBinder : String)
    (sig : DIndGArtifactSig) (rawRight : DIndGArtifactTerm)
    (nx : Metta.Atom)
    (hNxClosed : nx.vars = [])
    (hFreshNx :
      ∀ {v : String}, v = "template" ∨ v = "atom" ∨ v = "pattern" →
        counterSuffix st.counter v ≠ nxBinder)
