/-- Exact repaired-runtime policy for recursive Def-control `conv`. -/
def kernelDefControlEnv_conv_exactPolicy
    (st : St) (a b c : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelDefControlEnv st.world "conv"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Bool"]]) :
    QuotedBoolApplicationPolicy kernelDefControlEnv st.world "conv" [a, b, c] := by
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->"
        [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Bool"]
      argumentTypes := [mSym "Atom", mSym "Atom", mSym "Atom"]
      returnType := mSym "Bool"
      typeBindings := [] }
  have hSelected :
      selectFunctionType kernelDefControlEnv st.world (.sym "conv") [a, b, c] =
        .selected selected := by
    have hCheck : typeCheckArgsOutcome kernelDefControlEnv st.world
        [.sym "Atom", .sym "Atom", .sym "Atom"] 0 [] [a, b, c] = .success [] := by
      simpa [mSym] using typeCheckArgsOutcome_three_atoms kernelDefControlEnv st.world a b c
    simpa [selected, mExpr, mSym] using
      (selectFunctionType_singleton_arrow_selected_of_outcome
        kernelDefControlEnv st.world "conv" [a, b, c]
        [.sym "Atom", .sym "Atom", .sym "Atom"] (.sym "Bool") []
        hPinned (by simp) hCheck)
  have hMask : argMask selected 3 = [false, false, false] := by
    simp only [selected, argMask, Metta.instantiate_nil, mSym]
    decide
  have hReturns : returnsAtom selected = false := by
    simp only [selected, returnsAtom, Metta.instantiate_nil, mSym]
    decide
  refine
    { decision := .selected selected hSelected
      selected_eq := ?_
      argumentPolicies_eq := ?_
      returnIsAtom_eq := ?_
      resultExpected_eq := ?_ }
  · exact hSelected
  · change argumentEvaluationPolicies selected 3 =
      [(false, .sym "Atom"), (false, .sym "Atom"), (false, .sym "Atom")]
    simp [selected, argumentEvaluationPolicies, Metta.instantiate_nil, mSym]
    rfl
  · exact hReturns
  · change selectedResultExpected selected = .sym "Bool"
    simp [selected, selectedResultExpected, Metta.instantiate_nil, mSym]
    rfl

theorem KernelDefControlEnvTypeWorld.conv
    {world : World} (h : KernelDefControlEnvTypeWorld world) :
    OperatorTypesPinned kernelDefControlEnv world "conv"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Bool"]] := by
  have hp := h "conv" (by simp [kernelDefControlEnvOperatorInventory])
  simpa [OperatorTypesPinned, kernelDefControlEnv_conv_types] using hp

private def convFreshReadoutAt (counter : Nat)
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.Atom :=
  Metta.instantiate
    ((renameBindings (counterSuffix counter)
      (convRuleBindings sig rawLeft rawRight)).reverse)
    (freshenRule counter convRuleLhs convRuleRhs).2

private theorem queryOpItems_conv_eq
    (counter : Nat) (sig : DIndGArtifactSig)
    (rawLeft rawRight : DIndGArtifactTerm) :
    let target := convQuery sig rawLeft rawRight
    let coreB := convRuleBindings sig rawLeft rawRight
    let m := (renameBindings (counterSuffix counter) coreB).reverse
    Metta.Minimal.queryOpItemsOfRule [] target [] counter (convRuleLhs, convRuleRhs) =
      [evalResult [] (convFreshReadoutAt counter sig rawLeft rawRight) m] := by
  dsimp
  let target := convQuery sig rawLeft rawRight
  let coreB := convRuleBindings sig rawLeft rawRight
  let f := counterSuffix counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (termAtom_vars_nil rawRight)
      (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))
  have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
    ClosedValueBindings.rename hclosedB
  have hclosedM : ClosedValueBindings m := by
    simpa [m] using ClosedValueBindings.reverse hclosedRen
  have hnodupCore : (bindingValueKeys coreB).Nodup := by
    dsimp [coreB, convRuleBindings, bindingValueKeys]
    decide
  have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
    rw [bindingValueKeys_renameBindings]
    exact List.Nodup.map (counterSuffix_injective counter) hnodupCore
  have hsigx : f "sig" ≠ f "x" := by
    intro h
    exact (by decide : "sig" ≠ "x") ((counterSuffix_injective counter) h)
  have hxsig : f "x" ≠ f "sig" := fun h => hsigx h.symm
  have hsigy : f "sig" ≠ f "y" := by
    intro h
    exact (by decide : "sig" ≠ "y") ((counterSuffix_injective counter) h)
  have hysig : f "y" ≠ f "sig" := fun h => hsigy h.symm
  have hxy : f "x" ≠ f "y" := by
    intro h
    exact (by decide : "x" ≠ "y") ((counterSuffix_injective counter) h)
  have hyx : f "y" ≠ f "x" := fun h => hxy h.symm
  have hmergeSig :
      Metta.Bindings.merge [] [Metta.BindingRel.val (f "sig") (sigAtom sig)] =
        [[Metta.BindingRel.val (f "sig") (sigAtom sig)]] := by
    simpa [bindingValueKeys] using
      (merge_closed_noConflict_eq
        (b := [Metta.BindingRel.val (f "sig") (sigAtom sig)]) (acc := [])
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
        (by simp [bindingValueKeys]) ClosedValueBindings.nil
        (by intro x hx hmem; cases hmem))
  have hmergeX :
      Metta.Bindings.merge [Metta.BindingRel.val (f "sig") (sigAtom sig)]
          [Metta.BindingRel.val (f "x") (termAtom rawLeft)] =
        [[Metta.BindingRel.val (f "x") (termAtom rawLeft),
          Metta.BindingRel.val (f "sig") (sigAtom sig)]] := by
    simpa [bindingValueKeys] using
      (merge_closed_noConflict_eq
        (b := [Metta.BindingRel.val (f "x") (termAtom rawLeft)])
        (acc := [Metta.BindingRel.val (f "sig") (sigAtom sig)])
        (ClosedValueBindings.val (termAtom_vars_nil rawLeft) ClosedValueBindings.nil)
        (by simp [bindingValueKeys])
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
        (by simp [bindingValueKeys, hxsig]))
  have hmergeY :
      Metta.Bindings.merge
          [Metta.BindingRel.val (f "x") (termAtom rawLeft),
            Metta.BindingRel.val (f "sig") (sigAtom sig)]
          [Metta.BindingRel.val (f "y") (termAtom rawRight)] =
        [[Metta.BindingRel.val (f "y") (termAtom rawRight),
          Metta.BindingRel.val (f "x") (termAtom rawLeft),
          Metta.BindingRel.val (f "sig") (sigAtom sig)]] := by
    simpa [bindingValueKeys] using
      (merge_closed_noConflict_eq
        (b := [Metta.BindingRel.val (f "y") (termAtom rawRight)])
        (acc := [Metta.BindingRel.val (f "x") (termAtom rawLeft),
          Metta.BindingRel.val (f "sig") (sigAtom sig)])
        (ClosedValueBindings.val (termAtom_vars_nil rawRight) ClosedValueBindings.nil)
        (by simp [bindingValueKeys])
        (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
          (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))
        (by simp [bindingValueKeys, hyx, hysig]))
  have hloopSig :
      Metta.Bindings.hasLoop [Metta.BindingRel.val (f "sig") (sigAtom sig)] = false :=
    ClosedValueBindings.hasLoop_false
      (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
  have hloopX :
      Metta.Bindings.hasLoop [Metta.BindingRel.val (f "x") (termAtom rawLeft)] = false :=
    ClosedValueBindings.hasLoop_false
      (ClosedValueBindings.val (termAtom_vars_nil rawLeft) ClosedValueBindings.nil)
  have hloopY :
      Metta.Bindings.hasLoop [Metta.BindingRel.val (f "y") (termAtom rawRight)] = false :=
    ClosedValueBindings.hasLoop_false
      (ClosedValueBindings.val (termAtom_vars_nil rawRight) ClosedValueBindings.nil)
  have hloopResult :
      Metta.Bindings.hasLoop
        [Metta.BindingRel.val (f "y") (termAtom rawRight),
          Metta.BindingRel.val (f "x") (termAtom rawLeft),
          Metta.BindingRel.val (f "sig") (sigAtom sig)] = false :=
    ClosedValueBindings.hasLoop_false
      (ClosedValueBindings.val (termAtom_vars_nil rawRight)
        (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
          (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)))
  have hmatch :
      Metta.matchAtoms (freshenRule counter convRuleLhs convRuleRhs).1 target =
        [renameBindings f coreB] := by
    rw [freshenRule_eq_renBy]
    simp only [target, coreB, convRuleBindings, convRuleLhs, convQuery,
      renameBindings, f,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
      mExpr, mSym, mVar]
    simp only [List.map_cons, List.map_nil,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
    change
      Metta.matchAtoms
        (mExpr "conv" [mVar (f "sig"), mVar (f "x"), mVar (f "y")])
        (convQuery sig rawLeft rawRight) =
      [[ Metta.BindingRel.val (f "y") (termAtom rawRight)
       , Metta.BindingRel.val (f "x") (termAtom rawLeft)
       , Metta.BindingRel.val (f "sig") (sigAtom sig) ]]
    simp only [Metta.matchAtoms, Metta.matchAtomsWith, convQuery, mExpr, mSym, mVar]
    unfold Metta.matchAll
    simp [Metta.matchAtomsWith, Metta.Bindings.merge]
    unfold Metta.matchAll
    rw [match_var_occurs_free_nonvar_atom (f "sig") (sigAtom sig)
      (sigAtom_vars_absent sig) (sigAtom_not_var sig)]
    simp [hloopSig, hmergeSig]
    unfold Metta.matchAll
    rw [match_var_occurs_free_nonvar_atom (f "x") (termAtom rawLeft)
      (termAtom_vars_absent rawLeft) (termAtom_not_var rawLeft)]
    simp [hloopX, hmergeX]
    unfold Metta.matchAll
    rw [match_var_occurs_free_nonvar_atom (f "y") (termAtom rawRight)
      (termAtom_vars_absent rawRight) (termAtom_not_var rawRight)]
    simp [hloopY, hmergeY, hloopResult]
    unfold Metta.matchAll
    change List.filter (fun bindings => !Metta.Bindings.hasLoop bindings)
      [[Metta.BindingRel.val (f "y") (termAtom rawRight),
        Metta.BindingRel.val (f "x") (termAtom rawLeft),
        Metta.BindingRel.val (f "sig") (sigAtom sig)]] = _
    simp [hloopResult]
  have hmerge : Metta.Bindings.merge [] (renameBindings f coreB) = [m] := by
    simpa [m] using
      (merge_closed_noConflict_eq hclosedRen hnodupRen ClosedValueBindings.nil
        (by intro x hx hmem; cases hmem))
  have hloop : Metta.Bindings.hasLoop m = false := by
    simpa [m] using ClosedValueBindings.hasLoop_false hclosedM
  have hresult :
      Metta.instantiate m (freshenRule counter convRuleLhs convRuleRhs).2 =
        convFreshReadoutAt counter sig rawLeft rawRight := by
    simp [convFreshReadoutAt, m, coreB, f]
  have hclosedTarget : target.vars = [] := by
    simp [target, convQuery, sigAtom_vars_nil sig, termAtom_vars_nil rawLeft,
      termAtom_vars_nil rawRight, mExpr, mSym, Metta.Atom.vars]
  have hcompat := legacyFresheningCompatible_empty_of_target_vars_nil
    counter target convRuleLhs convRuleRhs hclosedTarget
  unfold Metta.Minimal.queryOpItemsOfRule
  rw [hcompat]
  rcases hfresh : freshenRule counter convRuleLhs convRuleRhs with ⟨lhs', rhs'⟩
  have hmatch' : Metta.matchAtoms lhs' target = [renameBindings f coreB] := by
    simpa [hfresh] using hmatch
  have hresult' :
      Metta.instantiate m rhs' =
        convFreshReadoutAt counter sig rawLeft rawRight := by
    simpa [m, hfresh] using hresult
  change
    List.flatMap
        (fun mb =>
          List.filterMap
            (fun m' =>
              if Metta.Bindings.hasLoop m' = true then none
              else some (evalResult [] (Metta.instantiate m' rhs') m'))
            (Metta.Bindings.merge [] mb))
        (Metta.matchAtoms lhs' target) =
      [evalResult [] (convFreshReadoutAt counter sig rawLeft rawRight) m]
  rw [hmatch']
  simp only [List.flatMap_cons, List.flatMap_nil]
  rw [hmerge]
  simp [hloop, hresult']

private theorem queryOp_kernelDefControlEnv_conv_eq
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    let target := convQuery sig rawLeft rawRight
    let rootBnd :=
      (renameBindings (counterSuffix St.init.counter)
        (convRuleBindings sig rawLeft rawRight)).reverse
    queryOp kernelDefControlEnv St.init [] target [] =
      ([evalResult [] (convFreshReadoutAt St.init.counter sig rawLeft rawRight) rootBnd],
        { counter := St.init.counter + 1, world := St.init.world }) := by
  dsimp
  let target := convQuery sig rawLeft rawRight
  let rootBnd :=
    (renameBindings (counterSuffix St.init.counter)
      (convRuleBindings sig rawLeft rawRight)).reverse
  have hNotVarHead : isVariableHeaded target = false := by
    simp [target, convQuery, isVariableHeaded, mExpr, mSym]
  have hCand :
      kernelDefControlEnv.candidates target =
        [] ++ (convRuleLhs, convRuleRhs) :: [] := by
    have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
      simp [MinEnv.candidates, kernelDefControlEnv]
    rw [hcandidateEq]
    simp [MinEnv.candidates, kernelEnv, target, convQuery, sigAtom,
      convRuleLhs, convRuleRhs, mExpr, mSym, mVar, headKey,
      Metta.ruleIndex_getD, Metta.ofAtomsGT_varRules,
      kernelControlSignatureDecls, kernelControlRules, kernelNfDefBodyRootRules,
      kernelCoreRules, runtimeDecls, ruleIsBad, ruleNfVar, ruleNfSrt,
      ruleNfCon, ruleNfBad, ruleNfPi, ruleNfLam, ruleInferSrtType,
      ruleInferSrtKind, ruleInferBad, ruleConv, ruleNfDef,
      ruleDefBodyOfDDef, nfDefRuleLhs, nfDefRuleRhs,
      defBodyOfDDefRuleLhs, defBodyOfDDefRuleRhs, defBodyOfQueryAtom,
      ruleIfTrue, ruleIfFalse, ruleLet, ifTrueRulePair, ifFalseRulePair,
      letRulePair, mTypeDecl, mBool, extractRules]
  have hitems :
      Metta.Minimal.queryOpItemsOfRule [] target [] St.init.counter (convRuleLhs, convRuleRhs) =
        [evalResult []
          (convFreshReadoutAt St.init.counter sig rawLeft rawRight) rootBnd] := by
    simpa [target, rootBnd] using
      queryOpItems_conv_eq St.init.counter sig rawLeft rawRight
  have hcounter := Metta.Minimal.freshenRuleAvoiding_counter St.init.counter
    (Metta.Minimal.queryOpAvoid [] target []) convRuleLhs convRuleRhs
  have hstep :
      Metta.Minimal.queryOpFoldStep [] target [] ([], St.init)
          (convRuleLhs, convRuleRhs) =
        (Metta.Minimal.queryOpItemsOfRule [] target [] St.init.counter
            (convRuleLhs, convRuleRhs),
          { St.init with counter :=
              (freshenRuleAvoiding St.init.counter
                (Metta.Minimal.queryOpAvoid [] target [])
                convRuleLhs convRuleRhs).2 }) := by
    rfl
  unfold queryOp
  rw [hNotVarHead]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [candidatesW_eq_candidates_of_no_selfRules
    kernelDefControlEnv St.init.world target (by rfl) (by rfl)]
  rw [hCand]
  simp only [List.nil_append, List.foldl_cons, List.foldl_nil]
  rw [hstep, hitems, hcounter]
  simp [rootBnd]

theorem interpretFuel_kernelDefControlEnv_conv_root_eq
    (fuel : Nat) (sig : DIndGArtifactSig)
    (rawLeft rawRight : DIndGArtifactTerm) :
    let rootBnd :=
      (renameBindings (counterSuffix St.init.counter)
        (convRuleBindings sig rawLeft rawRight)).reverse
    interpretFuel kernelDefControlEnv (fuel + 1) St.init
        [evalItemNil (convQuery sig rawLeft rawRight)] [] =
      ([(convFreshReadoutAt St.init.counter sig rawLeft rawRight, rootBnd)],
        { counter := St.init.counter + 1, world := St.init.world }) := by
  dsimp
  let target := convQuery sig rawLeft rawRight
  let coreB := convRuleBindings sig rawLeft rawRight
  let f := counterSuffix St.init.counter
  let rootBnd : Metta.Bindings := (renameBindings f coreB).reverse
  let root := convFreshReadoutAt St.init.counter sig rawLeft rawRight
  let st' : St := { counter := St.init.counter + 1, world := St.init.world }
  have hstep :
      interpretStack1 kernelDefControlEnv fuel St.init (evalItemNil target) =
        ([evalResult [] root rootBnd], st') := by
    change interpretStack1 kernelDefControlEnv fuel St.init
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := [] } =
      ([evalResult [] root rootBnd], st')
    rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelDefControlEnv fuel St.init [] target [] "conv"
        [sigAtom sig, termAtom rawLeft, termAtom rawRight]]
    · simpa [target, convQuery, root, rootBnd, coreB, f, st', mExpr, mSym] using
        queryOp_kernelDefControlEnv_conv_eq sig rawLeft rawRight
    · simp [target, convQuery, mExpr, mSym, Metta.instantiate_nil]
    · exact callGrounded_conv_of_stdGroundings kernelDefControlEnv sig rawLeft rawRight (by rfl)
    · simp [isEmbeddedOp]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (termAtom_vars_nil rawRight)
      (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))
  have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
    ClosedValueBindings.rename hclosedB
  have hclosedRootBnd : ClosedValueBindings rootBnd := by
    simpa [rootBnd] using ClosedValueBindings.reverse hclosedRen
  have hrootStable : Metta.instantiate rootBnd root = root := by
    simpa [root, convFreshReadoutAt, rootBnd, coreB, f] using
      instantiate_closed_value_bindings_idempotent hclosedRootBnd
      (freshenRule St.init.counter convRuleLhs convRuleRhs).2
  have heval : evalResult [] root rootBnd = finItem [] root rootBnd := by
    have hnot : isFunctionResult root = false := by
      simpa [root, convFreshReadoutAt, rootBnd, coreB, f] using
        conv_freshened_rhs_notFunction sig rawLeft rawRight
    exact evalResult_nil_eq_finItem_of_not_function
      (a := root) (b := rootBnd) hnot
  have hfinal : isFinal (evalResult [] root rootBnd) = true := by
    simp [heval, finItem, isFinal]
  have hpair : finalPair (evalResult [] root rootBnd) = (root, rootBnd) := by
    rw [heval]
    change (Metta.instantiate rootBnd root, rootBnd) = (root, rootBnd)
    simp [hrootStable]
  have hnotEmpty : (root != emptyA) = true := by
    simpa [root, convFreshReadoutAt, rootBnd, coreB, f] using
      conv_freshened_rhs_notEmpty sig rawLeft rawRight
  rw [interpretFuel, hstep]
  simp [interpretFuel, hfinal, hpair, hnotEmpty, root, rootBnd, coreB, f, st']

private theorem convFreshBindings_closed
    (counter : Nat) (sig : DIndGArtifactSig)
    (rawLeft rawRight : DIndGArtifactTerm) :
    ClosedValueBindings
      ((renameBindings (counterSuffix counter)
        (convRuleBindings sig rawLeft rawRight)).reverse) :=
  ClosedValueBindings.reverse (ClosedValueBindings.rename
    (ClosedValueBindings.val (termAtom_vars_nil rawRight)
      (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))))

private theorem convFreshReadoutAt_beq_notReducible_false
    (counter : Nat) (sig : DIndGArtifactSig)
    (rawLeft rawRight : DIndGArtifactTerm) :
    (convFreshReadoutAt counter sig rawLeft rawRight == notReducibleA) = false := by
  unfold convFreshReadoutAt
  rw [(convFreshBindings_closed counter sig rawLeft rawRight).instantiate_eq_subst_apply]
  simp [convRuleBindings, convRuleRhs,
    renameBindings, counterSuffix, freshenRule_eq_renBy,
    Metta.instantiate, Metta.bindingsToSubst, Metta.Subst.apply,
    Metta.Subst.lookup, notReducibleA, mExpr, mSym, mVar, mBool,
    Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  rfl

private theorem convFreshReadoutAt_beq_convQuery_false
    (counter : Nat) (sig : DIndGArtifactSig)
    (rawLeft rawRight : DIndGArtifactTerm) :
    (convFreshReadoutAt counter sig rawLeft rawRight ==
      convQuery sig rawLeft rawRight) = false := by
  unfold convFreshReadoutAt
  rw [(convFreshBindings_closed counter sig rawLeft rawRight).instantiate_eq_subst_apply]
  simp [convRuleBindings, convRuleRhs, convQuery,
    renameBindings, counterSuffix, freshenRule_eq_renBy,
    Metta.instantiate, Metta.bindingsToSubst, Metta.Subst.apply,
    Metta.Subst.lookup, mExpr, mSym, mVar, mBool,
    Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  rfl

private theorem convFreshReadoutAt_eq_named
    (counter : Nat) (sig : DIndGArtifactSig)
    (rawLeft rawRight : DIndGArtifactTerm) :
    convFreshReadoutAt counter sig rawLeft rawRight =
      convReadoutNamed
        (counterSuffix counter "nx")
        (counterSuffix counter "ny")
        sig rawLeft rawRight := by
  unfold convFreshReadoutAt
  rw [(convFreshBindings_closed counter sig rawLeft rawRight).instantiate_eq_subst_apply]
  simp [convReadoutNamed, convReadoutAfterNxNamed,
    convRuleBindings, convRuleLhs, convRuleRhs, renameBindings,
    freshenRule_eq_renBy, counterSuffix, Metta.instantiate,
    Metta.bindingsToSubst, Metta.Subst.apply, Metta.Subst.lookup,
    Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
    mExpr, mSym, mVar, mBool]

theorem kernelDefControlEnv_is_bad_types :
    getTypes kernelDefControlEnv (.sym "is-bad") =
      [mExpr "->" [mSym "Atom", mSym "Bool"]] := by
  rw [getTypes.eq_def]
  simp [kernelDefControlEnv, kernelEnv, MinEnv.ofAtomsGT, kernelControlSignatureDecls,
    kernelControlRules, kernelNfDefBodyRootRules, kernelCoreRules, runtimeDecls,
    mTypeDecl, mExpr, mSym, mVar, ruleIsBad, ruleNfVar, ruleNfSrt, ruleNfCon,
    ruleNfPi, ruleNfLam, ruleNfBad, ruleNfDef, ruleDefBodyOfDDef, nfDefRuleLhs,
    nfDefRuleRhs, defBodyOfDDefRuleLhs, defBodyOfDDefRuleRhs,
    defBodyOfQueryAtom, ruleInferSrtType, ruleInferSrtKind, ruleInferBad,
    ruleConv, ruleIfTrue, ruleIfFalse, ruleLet, ifTrueRulePair,
    ifFalseRulePair, letRulePair, Std.HashMap.getD_insert]

def kernelDefControlEnv_is_bad_exactPolicy
    (st : St) (a : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelDefControlEnv st.world "is-bad"
      [mExpr "->" [mSym "Atom", mSym "Bool"]]) :
    QuotedBoolApplicationPolicy kernelDefControlEnv st.world "is-bad" [a] := by
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->" [mSym "Atom", mSym "Bool"]
      argumentTypes := [mSym "Atom"]
      returnType := mSym "Bool"
      typeBindings := [] }
  have hSelected :
      selectFunctionType kernelDefControlEnv st.world (.sym "is-bad") [a] =
        .selected selected := by
    have hCheck : typeCheckArgsOutcome kernelDefControlEnv st.world
        [.sym "Atom"] 0 [] [a] = .success [] := by
      simpa using typeCheckArgsOutcome_one_atom kernelDefControlEnv st.world a
    simpa [selected, mExpr, mSym] using
      (selectFunctionType_singleton_arrow_selected_of_outcome
        kernelDefControlEnv st.world "is-bad" [a] [.sym "Atom"] (.sym "Bool") []
        hPinned (by simp) hCheck)
  have hMask : argMask selected 1 = [false] := by
    simp only [selected, argMask, Metta.instantiate_nil, mSym]
    decide
  have hReturns : returnsAtom selected = false := by
