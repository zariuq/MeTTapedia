/-- Lift an actual root minimal-evaluator `nf` readout through the outer `mettaEval` loop.

This is intentionally a *root* theorem: because the kernel declares
`nf : Atom -> Atom -> Atom`, LeaTTa's `mettaEval` returns the Atom-valued root
readout inert instead of recursively evaluating the `nf` calls that may occur
inside a `Pi`/`Lam` readout. The recursive certified spine is therefore carried
separately by `nf_eq_fragment_evalAtomMin_root_bridge_alpha_mops`. -/
theorem nf_evalAtomMin_readout_mem_mettaEval
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {rootOut : Metta.Atom}
    (hmem : rootOut ∈ evalAtomMin kernelCoreEnv 1 (nfQuery sig raw))
    (_hembed : isEmbeddedOp rootOut = false)
    (hnotNR : (rootOut == notReducibleA) = false)
    (hnotSelf : (rootOut == nfQuery sig raw) = false)
    (hNotError : rootOut.isError = false) :
    rootOut ∈
      (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig raw)).1.map (·.1) := by
  have hpair :
      ∃ rootBnd,
        (rootOut, rootBnd) ∈
          (interpretFuel kernelCoreEnv 1 St.init
            [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", nfQuery sig raw]) []
               bnd := [] }] []).1 := by
    unfold evalAtomMin interpretAtom at hmem
    rcases List.mem_map.mp hmem with ⟨p, hp, hpout⟩
    cases p with
    | mk out bnd =>
        cases hpout
        exact ⟨bnd, hp⟩
  rcases hpair with ⟨rootBnd, hrootBnd⟩
  simp only [nfQuery, mExpr, mSym] at hrootBnd hnotSelf ⊢
  rw [show 1 = 0 + 1 by rfl]
  rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
    kernelCoreEnv 0 St.init "nf" [sigAtom sig, termAtom raw]
    [false, false] true
    (kernelCoreEnv_nf_recursionNeutralPolicy St.init (sigAtom sig) (termAtom raw)
      kernelCoreEnvTypeWorld_init.nf) (by simp [Metta.Atom.isError])]
  simp [evaluateSelectedApplication, Metta.instantiate_nil,
    sigAtom_isError_false, termAtom_isError_false]
  cases hpairs : interpretFuel kernelCoreEnv 1 St.init
      [{ stack := atomToStack
          (Metta.Atom.expr [Metta.Atom.sym "eval",
            Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]]) []
         bnd := [] }] [] with
  | mk pairs st' =>
      have hrootPairs : (rootOut, rootBnd) ∈ pairs := by
        rw [hpairs] at hrootBnd
        simpa using hrootBnd
      have hkeep :
          (rootOut,
              restrictBnd ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelCoreEnv 0
                ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [] true)
              ([], st')).1 :=
        mettaEval_expr_root_keeps_of_returnsAtom_readout
          kernelCoreEnv 0 ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
          (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [] true
          (rootOut, rootBnd) pairs st'
          hrootPairs rfl hnotNR hnotSelf
      refine ⟨restrictBnd ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
          ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd),
        mem_prioritizeSemanticResults_of_mem_of_not_error ?_ hNotError⟩
      unfold mettaEvalExprRootFoldStep at hkeep
      simpa [List.flatMap] using hkeep

