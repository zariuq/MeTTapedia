/-- Exact facts about the recursive `unify` root emitted by the live nested
`let` application in a named conversion readout.

The pattern is an atom rather than a binder name because the selected
application instantiates quoted arguments under its actual seed.  The matcher
result and selected execution plan are retained as data, so consumers never
recover a variable-only root by assuming the live seed is empty. -/
def ConvReadoutNamedTailRootLiveFacts
    (stBefore : St) (recursiveEnv rootBnd : Metta.Bindings)
    (nx ny pattern template root : Metta.Atom) : Prop :=
  KernelDefControlEnvTypeWorld stBefore.world ∧
  root = mExpr "unify" [ny, pattern, template, mSym "Empty"] ∧
  Metta.instantiate recursiveEnv
      (mExpr "unify" [ny, pattern, template, mSym "Empty"]) =
    mExpr "unify" [ny, pattern, template, mSym "Empty"] ∧
  ∃ matchBindings : Metta.Bindings,
    Metta.matchAtoms ny pattern = [matchBindings] ∧
    Metta.Bindings.merge recursiveEnv matchBindings = [rootBnd] ∧
    Metta.Bindings.hasLoop rootBnd = false ∧
    ∃ live : RecursionNeutralApplicationExecutionPlan kernelDefControlEnv
        stBefore.world recursiveEnv "unify"
          [ny, pattern, template, mSym "Empty"]
          [false, false, false, false] false,
      [ny, pattern, template, mSym "Empty"].map
          (Metta.instantiate recursiveEnv) =
        [ny, pattern, template, mSym "Empty"] ∧
      expectedApplicationRetentionScope recursiveEnv
          [ny, pattern, template, mSym "Empty"] =
        ([ny, pattern, template, mSym "Empty"]).flatMap Metta.Atom.vars ∧
      (([ny, pattern, template, mSym "Empty"].zip
          [ny, pattern, template, mSym "Empty"]).find?
        (fun pair : Metta.Atom × Metta.Atom =>
          (pair.1 == emptyA || pair.1.isError) && pair.1 != pair.2)) = none ∧
      Metta.instantiate rootBnd (Metta.instantiate rootBnd template) =
        convReadoutAfterNxNy nx ny

