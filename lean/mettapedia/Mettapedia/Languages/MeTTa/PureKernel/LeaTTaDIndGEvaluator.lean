/-- The recursive `infer-app` rule matches any encoded artifact function and
argument. This is the matcher half of the App body rewrite. -/
theorem infer_app_body_rule_match
    (sig : DIndGArtifactSig) (rawFn rawArg : DIndGArtifactTerm) :
