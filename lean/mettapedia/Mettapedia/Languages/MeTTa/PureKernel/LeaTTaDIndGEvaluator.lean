/-- Empty-seed plan correspondence for the kernel lazy-ternary signature,
parameterized by the condition's ordered `Bool` presentation.  The live plan
is compared with the raw policy only at `[]`; callers with nonempty incoming
theories must retain `EvalQuotedQuotedApplicationExecutionPlan` instead. -/
theorem EvalQuotedQuotedApplicationPolicy.applicationPlanCorresponds_init_of_bool_cons
    (cond thenBranch elseBranch : Metta.Atom) (condTail : List Metta.Atom)
    (hCondTypes :
      getTypes kernelDefControlEnv (typePrep St.init.world cond) =
        mSym "Bool" :: condTail)
    (policy : EvalQuotedQuotedApplicationPolicy kernelDefControlEnv
      St.init.world "if" [cond, thenBranch, elseBranch] (mSym "Bool")) :
    ApplicationPlanCorresponds []
      (.selected policy.raw.decision.selectedType policy.selected_eq) := by
  obtain ⟨latentErrors, hDetailed⟩ :=
    kernelDefControlEnv_if_detailed_init_of_bool_cons
      cond thenBranch elseBranch condTail hCondTypes
  have hTypes :
      getTypes kernelDefControlEnv
          (typePrep St.init.world (Metta.Atom.sym "if")) =
        [Metta.Atom.expr
          [Metta.Atom.sym "->", Metta.Atom.sym "Bool", Metta.Atom.sym "Atom",
            Metta.Atom.sym "Atom", Metta.Atom.sym "%Undefined%"]] := by
    rw [typePrep_init_world_eq_self]
    simpa [mExpr, mSym] using kernelDefControlEnv_if_types
  let plan := selectedApplicationExecutionPlan_symbolic_arrow_from_detailed
    kernelDefControlEnv St.init.world "if" [cond, thenBranch, elseBranch]
      ["Bool", "Atom", "Atom"] "%Undefined%" [] [] latentErrors
      hTypes (by simp) hDetailed (by rfl)
  have hOutcome :
      typeCheckArgsOutcome kernelDefControlEnv St.init.world
          [mSym "Bool", mSym "Atom", mSym "Atom"] 0 []
          [cond, thenBranch, elseBranch] = .success [] := by
    have hDetailed' :
        typeCheckArgsDetailedOutcome kernelDefControlEnv St.init.world
            [mSym "Bool", mSym "Atom", mSym "Atom"] 0 []
            [cond, thenBranch, elseBranch] =
          .success [] latentErrors := by
      simpa [typeCheckArgsDetailedOutcome, applicationTypeInferenceScopeFrom,
        Metta.Bindings.vars, mSym] using hDetailed
    simp [typeCheckArgsOutcome, hDetailed']
  have hRaw :
      selectFunctionType kernelDefControlEnv St.init.world (.sym "if")
          [cond, thenBranch, elseBranch] = .selected plan.selected := by
    simpa [plan, selectedApplicationExecutionPlan_symbolic_arrow_from_detailed,
      mExpr, mSym] using
      (selectFunctionType_singleton_arrow_selected_of_outcome
        kernelDefControlEnv St.init.world "if"
        [cond, thenBranch, elseBranch]
        [.sym "Bool", .sym "Atom", .sym "Atom"] (.sym "%Undefined%") []
        hTypes (by simp) hOutcome)
  have hSeed : plan.seeds = [[]] := by
    change Metta.Bindings.merge []
      (restrictBnd
        (expectedApplicationVisibleScope
          (Metta.Atom.expr
            [Metta.Atom.sym "if", cond, thenBranch, elseBranch])
          (Metta.Atom.sym "%Undefined%")) []) = [[]]
    rw [restrictBnd_nil_bindings]
    rfl
  have hSelectedEq : policy.raw.decision.selectedType = plan.selected := by
    have h := policy.selected_eq
    rw [hRaw] at h
    exact (FunctionTypeScanOutcome.selected.inj h).symm
  simpa [hSelectedEq] using
    plan.toApplicationPlanCorresponds hRaw hSeed

/-- Empty-seed shared-plan evidence for the concrete kernel `if`/`is-bad`
supplier.  The proof compares the raw scan with the exact live detailed scan
only at `[]`; nonempty evaluator theories use
`EvalQuotedQuotedApplicationExecutionPlan` instead. -/
theorem kernelDefControlEnv_if_is_bad_applicationPlanCorresponds_init
    (a thenBranch elseBranch : Metta.Atom) :
    let policy := kernelDefControlEnv_if_exactPolicy_is_bad_init
      a thenBranch elseBranch
    ApplicationPlanCorresponds []
