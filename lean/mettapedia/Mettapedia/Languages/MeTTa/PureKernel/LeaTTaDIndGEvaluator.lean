/-- Binding-threaded fuel-driver lift for a successful embedded `unify` match.

This is the retained-binding sibling of the fallback lemma below: callers expose
the actual matcher witness, ambient merge result, loop check, and any later
stability facts needed for the recursive final program. -/
theorem interpretFuel_eval_embedded_unify_success_contains_of_gt_instantiate
    (env : MinEnv) (fuel : Nat) (st : St) (b mb rootBnd : Metta.Bindings)
    (atom pattern template elseAtom : Metta.Atom)
    (hgt : env.gt = stdGroundings)
    (hinst : Metta.instantiate b (mExpr "unify" [atom, pattern, template, elseAtom]) =
      mExpr "unify" [atom, pattern, template, elseAtom])
    (hmatch : mb ∈ Metta.matchAtoms atom pattern)
    (hmerge : rootBnd ∈ Metta.Bindings.merge b mb)
    (hloop : Metta.Bindings.hasLoop rootBnd = false)
    (hnotEmpty :
      (Metta.instantiate rootBnd (Metta.instantiate rootBnd template) != emptyA) = true) :
    (Metta.instantiate rootBnd (Metta.instantiate rootBnd template), rootBnd) ∈
      (interpretFuel env (fuel + 2) st
        [evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom])] []).1 := by
  have hfirstResults :
      (interpretStack1 env (fuel + 1) st
        (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))).1 =
        [embeddedUnifyItem b atom pattern template elseAtom] := by
    simpa using congrArg Prod.fst
      (interpretStack1_eval_embedded_unify_open_of_gt_instantiate
        env (fuel + 1) st b atom pattern template elseAtom hgt hinst)
  have hfirstNonfinal :
      isFinal (embeddedUnifyItem b atom pattern template elseAtom) = false := by
    simp [embeddedUnifyItem, isFinal, atomToStack, mExpr, mSym]
  have hdriver :
      interpretFuel env (fuel + 2) st
        [evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom])] [] =
      interpretFuel env (fuel + 1)
        (interpretStack1 env (fuel + 1) st
          (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))).2
        [embeddedUnifyItem b atom pattern template elseAtom] [] := by
    simpa [Nat.add_assoc] using
      interpretFuel_single_of_interpretStack1_results_single_nonfinal
        env (fuel + 1) st
        (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))
        (embeddedUnifyItem b atom pattern template elseAtom) hfirstResults hfirstNonfinal
  have hstate :
      (interpretStack1 env (fuel + 1) st
        (evalItemBnd b (mExpr "unify" [atom, pattern, template, elseAtom]))).2 = st := by
    simpa using congrArg Prod.snd
      (interpretStack1_eval_embedded_unify_open_of_gt_instantiate
