/-- On a closed query with empty bindings and continuation, the repaired freshener takes the
legacy-compatible branch.  This is the reusable boundary for concrete kernel rules: their old
counter-suffix calculations remain valid precisely because no live spelling is available to
capture. -/
private theorem queryOpItemsOfRule_eq_legacy_of_target_vars_nil
    (counter : Nat) (target : Metta.Atom) (p : Metta.Atom × Metta.Atom)
    (htarget : target.vars = []) :
    Metta.Minimal.queryOpItemsOfRule [] target [] counter p =
      let (lhs', rhs') := freshenRule counter p.1 p.2
      (Metta.matchAtoms lhs' target).flatMap fun mb =>
        (Metta.Bindings.merge [] mb).filterMap fun m =>
          if Metta.Bindings.hasLoop m then none
          else some (evalResult [] (Metta.instantiate m rhs') m) := by
  unfold Metta.Minimal.queryOpItemsOfRule
  rw [legacyFresheningCompatible_empty_of_target_vars_nil
    counter target p.1 p.2 htarget]

/-- One capture-avoiding `is-bad` query step over a closed incoming value
environment.  The private rule spellings are existential because the
executable may choose either its legacy suffix or its collision fallback;
the emitted atom and threaded incoming bindings are otherwise exact. -/
private theorem queryOpItems_is_bad_eq_from_closed
    (counter : Nat) (a : Metta.Atom) (incoming : Metta.Bindings)
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w)
    (hIncoming : ClosedValueBindings incoming) :
    ∃ x e,
      x ≠ e ∧ x ∉ incoming.vars ∧ e ∉ incoming.vars ∧
      Metta.Minimal.queryOpItemsOfRule [] (mExpr "is-bad" [a])
          incoming counter isBadRulePair =
        [evalResult []
          (mExpr "unify"
            [a, mExpr "Bad" [mVar e], mBool true, mBool false])
          (Metta.BindingRel.val x a :: incoming)] := by
  let avoid := Metta.Minimal.queryOpAvoid [] (mExpr "is-bad" [a]) incoming
  rcases freshenRuleAvoiding_is_bad_shape counter avoid with
    ⟨x, e, hshape, hxe, hxAvoid, heAvoid⟩
  have hxIncoming : x ∉ incoming.vars := by
    intro hx
    exact hxAvoid (by simp [avoid, Metta.Minimal.queryOpAvoid, hx])
  have heIncoming : e ∉ incoming.vars := by
    intro he
    exact heAvoid (by simp [avoid, Metta.Minimal.queryOpAvoid, he])
  have hxA : x ∉ a.vars := by
    rw [hClosed]
    simp
  have hmatch :
      Metta.matchAtoms (mExpr "is-bad" [mVar x]) (mExpr "is-bad" [a]) =
        [[Metta.BindingRel.val x a]] :=
    is_bad_lhs_match_of_fresh_name x a hxA hNonVar
  have hxNotKey : x ∉ bindingValueKeys incoming := by
    intro hx
    exact hxIncoming (bindingValueKey_mem_vars hx)
  have heNotKey : e ∉ bindingValueKeys incoming := by
    intro he
    exact heIncoming (bindingValueKey_mem_vars he)
  have hmerge :
      Metta.Bindings.merge incoming [Metta.BindingRel.val x a] =
        [[Metta.BindingRel.val x a] ++ incoming] :=
    hIncoming.toValueBindings.merge_singleton_val_eq_of_not_key hNonVar hxNotKey
  have hMergedClosed :
      ClosedValueBindings (Metta.BindingRel.val x a :: incoming) :=
    ClosedValueBindings.val hClosed hIncoming
  have hloop :
      Metta.Bindings.hasLoop (Metta.BindingRel.val x a :: incoming) = false :=
    ClosedValueBindings.hasLoop_false hMergedClosed
  have hlookE : Metta.Bindings.lookupVal incoming e = none :=
    hIncoming.toValueBindings.lookup_none_of_not_key heNotKey
  have hinst :
      Metta.instantiate (Metta.BindingRel.val x a :: incoming)
          (mExpr "unify"
            [mVar x, mExpr "Bad" [mVar e], mBool true, mBool false]) =
        mExpr "unify"
          [a, mExpr "Bad" [mVar e], mBool true, mBool false] := by
    rw [hMergedClosed.instantiate_eq_subst_apply]
    simp [mExpr, mSym, mVar, mBool, Metta.Subst.apply,
      lookup_bindingsToSubst, Metta.Bindings.lookupVal, hlookE, hxe.symm]
  refine ⟨x, e, hxe, hxIncoming, heIncoming, ?_⟩
  unfold Metta.Minimal.queryOpItemsOfRule
  rw [show Metta.Minimal.queryOpAvoid [] (mExpr "is-bad" [a]) incoming = avoid by rfl,
    hshape]
  simp only
  rw [hmatch]
  simp [hmerge, hloop, hinst, evalResult]

private theorem queryOpItems_kernelEnv_is_bad_eq
    (counter : Nat) (a : Metta.Atom)
    (_hClosed : a.vars = [])
    (_hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    Metta.Minimal.queryOpItemsOfRule [] (mExpr "is-bad" [a]) [] counter isBadRulePair =
      [evalResult []
        (mExpr "unify"
          [a, mExpr "Bad" [mVar (counterSuffix counter "e")], mBool true, mBool false])
        ((renameBindings (counterSuffix counter)
          [Metta.BindingRel.val "x" a]).reverse)] := by
  have hfresh :
      freshenRule counter isBadRulePair.1 isBadRulePair.2 =
        ( mExpr "is-bad" [mVar (counterSuffix counter "x")]
        , mExpr "unify"
            [ mVar (counterSuffix counter "x")
            , mExpr "Bad" [mVar (counterSuffix counter "e")]
            , mBool true
            , mBool false ] ) := by
    rw [freshenRule_eq_renBy]
    simp [isBadRulePair, mExpr, mSym, mVar, mBool,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms
          (mExpr "is-bad" [mVar (counterSuffix counter "x")])
          (mExpr "is-bad" [a]) =
        [[Metta.BindingRel.val (counterSuffix counter "x") a]] := by
    simpa [hfresh] using fresh_is_bad_rule_match counter a (by
      rw [_hClosed]
      simp) _hNonVar
  have hmerge :
      Metta.Bindings.merge [] [Metta.BindingRel.val (counterSuffix counter "x") a] =
        [[Metta.BindingRel.val (counterSuffix counter "x") a]] := by
    exact singleton_val_merge_empty_eq (counterSuffix counter "x") a _hNonVar
  let x := counterSuffix counter "x"
  let e := counterSuffix counter "e"
  have hclosedB : ClosedValueBindings [Metta.BindingRel.val x a] := by
    exact ClosedValueBindings.val _hClosed ClosedValueBindings.nil
  have hloop : Metta.Bindings.hasLoop [Metta.BindingRel.val x a] = false := by
    simpa [x] using ClosedValueBindings.hasLoop_false hclosedB
  have hxe : x ≠ e := by
    intro h
    have hx : "x" = "e" := (counterSuffix_injective counter) h
    contradiction
  have hex : e ≠ x := by
    intro h
    exact hxe h.symm
  have hexx : (e == x) = false := by
    exact beq_eq_false_iff_ne.mpr hex
  have hinst :
      Metta.instantiate [Metta.BindingRel.val x a]
          (mExpr "unify" [mVar x, mExpr "Bad" [mVar e], mBool true, mBool false]) =
        mExpr "unify" [a, mExpr "Bad" [mVar e], mBool true, mBool false] := by
    rw [hclosedB.instantiate_eq_subst_apply]
    simp [x, e, mExpr, mSym, mVar, mBool, Metta.instantiate, Metta.bindingsToSubst,
      Metta.Subst.apply, Metta.Subst.lookup, hexx]
  have hcompat := legacyFresheningCompatible_empty_of_target_vars_nil
    counter (mExpr "is-bad" [a]) isBadRulePair.1 isBadRulePair.2 (by
      simp [mExpr, mSym, _hClosed, Metta.Atom.vars])
  unfold Metta.Minimal.queryOpItemsOfRule
  rw [hcompat, hfresh]
  simp only [Prod.fst]
  rw [hmatch]
  simp [hmerge, hloop, hinst, x, e, renameBindings, evalResult]

private theorem kernelEnv_if_candidates
    (b : Bool) (thenA elseA : Metta.Atom) :
    kernelEnv.candidates (mExpr "if" [mBool b, thenA, elseA]) =
      [ifTrueRulePair, ifFalseRulePair] := by
  rw [MinEnv.candidates]
  simp only [kernelEnv]
  simp only [mExpr, mSym, mBool, headKey]
  rw [Metta.ruleIndex_getD, Metta.ofAtomsGT_varRules]
  simp [kernelControlSignatureDecls, kernelControlRules, kernelNfDefBodyRootRules,
    kernelCoreRules, runtimeDecls, ruleIfTrue, ruleIfFalse, ruleLet,
    ifTrueRulePair, ifFalseRulePair, letRulePair, ruleIsBad, ruleNfVar,
    ruleNfSrt, ruleNfCon, ruleNfPi, ruleNfLam, ruleNfBad, ruleNfDef,
    ruleDefBodyOfDDef, nfDefRuleLhs, nfDefRuleRhs, defBodyOfDDefRuleLhs,
    defBodyOfDDefRuleRhs, defBodyOfQueryAtom, ruleInferSrtType,
    ruleInferSrtKind, ruleInferBad, ruleConv, mTypeDecl, mExpr, mSym, mVar,
    mBool, headKey, extractRules]

private theorem kernelEnv_let_candidates
    (binder : String) (atom template : Metta.Atom) :
    kernelEnv.candidates (mExpr "let" [mVar binder, atom, template]) =
      [letRulePair] := by
  rw [MinEnv.candidates]
  simp only [kernelEnv]
  simp only [mExpr, mSym, mVar, headKey]
  rw [Metta.ruleIndex_getD, Metta.ofAtomsGT_varRules]
  simp [kernelControlSignatureDecls, kernelControlRules, kernelNfDefBodyRootRules,
    kernelCoreRules, runtimeDecls, ruleIfTrue, ruleIfFalse, ruleLet,
    ifTrueRulePair, ifFalseRulePair, letRulePair, ruleIsBad, ruleNfVar,
    ruleNfSrt, ruleNfCon, ruleNfPi, ruleNfLam, ruleNfBad, ruleNfDef,
    ruleDefBodyOfDDef, nfDefRuleLhs, nfDefRuleRhs, defBodyOfDDefRuleLhs,
    defBodyOfDDefRuleRhs, defBodyOfQueryAtom, ruleInferSrtType,
    ruleInferSrtKind, ruleInferBad, ruleConv, mTypeDecl, mExpr, mSym, mVar,
    mBool, headKey, extractRules]

/-- Root fuel-driver readout for the finite-control `let` rule over a
quoted binder/template and an already-evaluated non-variable bound atom.

This is the executable root step needed by the `convReadout` control-flow
threading: once the bound atom has been evaluated, the real `interpretFuel`
driver harvests the corresponding embedded `unify` root item using the stdlib
`let` rule inside `kernelEnv`.  The theorem is intentionally parameterized by a
freshness invariant for the quoted payloads; later `conv` lemmas discharge that
invariant for the concrete `nx`/`ny` templates instead of baking another ad hoc
root trace into the file. -/
theorem interpretFuel_kernelEnv_let_root_contains
    (fuel : Nat) (st : St)
    (binder : String) (atom template : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hAtomNonVar : ∀ w, atom ≠ Metta.Atom.var w)
    (hTemplateNonVar : ∀ w, template ≠ Metta.Atom.var w)
    (hFresh :
      RenamedBindingKeysFreshForPayloads (counterSuffix st.counter)
        (letRuleBindings binder atom template)) :
    (mExpr "unify" [atom, mVar binder, template, mSym "Empty"],
      (renameBindings (counterSuffix st.counter)
        (letRuleBindings binder atom template)).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "let" [mVar binder, atom, template])] []).1 := by
  let target := mExpr "let" [mVar binder, atom, template]
  let coreB := letRuleBindings binder atom template
  let f := counterSuffix st.counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  let root := mExpr "unify" [atom, mVar binder, template, mSym "Empty"]
  have hf : Function.Injective f := by
    simpa [f] using counterSuffix_injective st.counter
  have hPatternKey : "pattern" ∈ bindingRuleKeys coreB := by
    simp [coreB, letRuleBindings, bindingRuleKeys]
  have hAtomKey : "atom" ∈ bindingRuleKeys coreB := by
    simp [coreB, letRuleBindings, bindingRuleKeys]
  have hTemplateKey : "template" ∈ bindingRuleKeys coreB := by
    simp [coreB, letRuleBindings, bindingRuleKeys]
  have hAtomMem : Metta.BindingRel.val "atom" atom ∈ coreB := by
    simp [coreB, letRuleBindings]
  have hTemplateMem : Metta.BindingRel.val "template" template ∈ coreB := by
    simp [coreB, letRuleBindings]
  have hEqMem : Metta.BindingRel.eq "pattern" binder ∈ coreB := by
    simp [coreB, letRuleBindings]
  have hPatternFresh : f "pattern" ≠ binder :=
    renamedBindingKey_ne_eqTarget hFresh hPatternKey hEqMem
  have hAtomBinder : f "atom" ≠ binder :=
    renamedBindingKey_ne_eqTarget hFresh hAtomKey hEqMem
  have hTemplateBinder : f "template" ≠ binder :=
    renamedBindingKey_ne_eqTarget hFresh hTemplateKey hEqMem
  have hPatternAtom : f "pattern" ∉ atom.vars :=
    renamedBindingKey_fresh_for_value hFresh hPatternKey hAtomMem
  have hAtomAtom : f "atom" ∉ atom.vars :=
    renamedBindingKey_fresh_for_value hFresh hAtomKey hAtomMem
  have hTemplateAtom : f "template" ∉ atom.vars :=
    renamedBindingKey_fresh_for_value hFresh hTemplateKey hAtomMem
  have hPatternTemplate : f "pattern" ∉ template.vars :=
    renamedBindingKey_fresh_for_value hFresh hPatternKey hTemplateMem
  have hAtomTemplate : f "atom" ∉ template.vars :=
    renamedBindingKey_fresh_for_value hFresh hAtomKey hTemplateMem
  have hTemplateTemplate : f "template" ∉ template.vars :=
    renamedBindingKey_fresh_for_value hFresh hTemplateKey hTemplateMem
  have hcompat :
      LegacyFresheningCompatible [] target [] st.counter
        letRulePair.1 letRulePair.2 := by
    apply legacyFresheningCompatible_of_no_collision
    simp [freshenRule_eq_renBy, letRulePair, target, mExpr, mSym, mVar, f,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
      Metta.Atom.vars, Metta.Minimal.queryOpAvoid, Metta.Bindings.vars,
      Metta.Minimal.liveStackVars, hPatternFresh, hAtomBinder, hTemplateBinder,
      hPatternAtom, hAtomAtom, hTemplateAtom, hPatternTemplate,
      hAtomTemplate, hTemplateTemplate]
  have hmatchFresh : renameBindings f coreB ∈
      Metta.matchAtoms (freshenRule st.counter letRulePair.1 letRulePair.2).1 target := by
    rw [fresh_let_rule_match st.counter binder atom template
      hAtomAtom hTemplateTemplate hAtomNonVar hTemplateNonVar
      hAtomBinder hTemplateBinder
      hPatternAtom hTemplateAtom hPatternTemplate hAtomTemplate
      hPatternFresh]
    simp [coreB, letRuleBindings, f, renameBindings]
  have hmerge : m ∈ Metta.Bindings.merge [] (renameBindings f coreB) := by
    rw [merge_empty_renamed_letRuleBindings_eq f hf binder atom template
      hAtomNonVar hTemplateNonVar hPatternFresh hAtomBinder hTemplateBinder]
    simp [m, coreB]
  have hruntime :
      Metta.Bindings.hasLoop m = false ∧
        Metta.Bindings.resolve m (f "atom") = some atom ∧
        Metta.Bindings.resolve m (f "template") = some template ∧
        Metta.Bindings.resolve m (f "pattern") = some (mVar binder) ∧
        (∀ x, x ≠ f "pattern" → x ≠ f "atom" → x ≠ f "template" →
          (Metta.Bindings.resolve m x).getD (mVar x) = mVar x) := by
    simpa [m, coreB, letRuleBindings, renameBindings] using
      (renamed_let_binding_runtime_facts f hf binder atom template
        hAtomNonVar hTemplateNonVar hPatternFresh hAtomBinder hTemplateBinder
        hPatternAtom hAtomAtom hTemplateAtom
        hPatternTemplate hAtomTemplate hTemplateTemplate)
  rcases hruntime with ⟨hloop, hresolveAtom, hresolveTemplate,
    hresolvePattern, hambient⟩
  have hresult :
      Metta.instantiate m (freshenRule st.counter letRulePair.1 letRulePair.2).2 = root := by
    rw [freshenRule_eq_renBy]
    simp [letRulePair,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
      Metta.instantiate, Metta.Bindings.resolveAtom,
      hresolveAtom, hresolveTemplate, hresolvePattern,
      root, f, mExpr, mSym, mVar]
  have hrootStable : Metta.instantiate m root = root := by
    calc
      Metta.instantiate m root = Metta.instantiate [] root := by
        apply instantiate_eq_of_resolve_readout_on_vars
        intro v hv
        have hv' : v ∈ atom.vars ∨ v = binder ∨ v ∈ template.vars := by
          simpa [root, mExpr, mSym, mVar, Metta.Atom.vars] using hv
        have hread : (Metta.Bindings.resolve m v).getD (mVar v) = mVar v := by
          rcases hv' with hvAtom | rfl | hvTemplate
          · exact hambient v
              (fun h => hPatternAtom (h ▸ hvAtom))
              (fun h => hAtomAtom (h ▸ hvAtom))
              (fun h => hTemplateAtom (h ▸ hvAtom))
          · exact hambient v (Ne.symm hPatternFresh)
              (Ne.symm hAtomBinder) (Ne.symm hTemplateBinder)
          · exact hambient v
              (fun h => hPatternTemplate (h ▸ hvTemplate))
              (fun h => hAtomTemplate (h ▸ hvTemplate))
              (fun h => hTemplateTemplate (h ▸ hvTemplate))
        simpa [mVar] using hread
      _ = root := Metta.instantiate_nil root
  have hquery :
      evalResult [] (Metta.instantiate m
          (freshenRule st.counter letRulePair.1 letRulePair.2).2) m ∈
        (queryOp kernelEnv st [] target []).1 := by
    have hmatchAvoid :
        renameBindings f coreB ∈
          Metta.matchAtoms
            (freshenRuleAvoiding st.counter (Metta.Minimal.queryOpAvoid [] target [])
              letRulePair.1 letRulePair.2).1.1 target := by
      rw [hcompat]
      exact hmatchFresh
    simpa [target, hcompat] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := kernelEnv) (st := st) (prev := []) (toEval := target) (b := [])
        (pre := []) (post := []) (p := letRulePair)
        (mb := renameBindings f coreB) (m := m)
        hStatic (by simp [target, isVariableHeaded, mExpr, mSym])
        (by simpa [target] using kernelEnv_let_candidates binder atom template)
        hmatchAvoid hmerge hloop
  have hstack :
      evalResult [] root m ∈
        (interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }).1 := by
    have hqueryRoot :
        evalResult [] root m ∈ (queryOp kernelEnv st [] target []).1 := by
      simpa [hresult] using hquery
    exact (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "let" [mVar binder, atom, template]
      (evalResult [] root m)
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_let [mVar binder, atom, template])
      (by simp [isEmbeddedOp])).2 hqueryRoot
  have heval : evalResult [] root m = finItem [] root m := by
    simp [root, evalResult, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root m) = true := by
    simp [heval, finItem, isFinal]
  have hmemFuel :
      finalPair (evalResult [] root m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelEnv fuel st { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }
      (evalResult [] root m) [] [] hstack hfinal (by
        rw [heval]
        simpa [finItem, finalPair, hrootStable, root] using
          mExpr_ne_empty "unify" [atom, mVar binder, template, mSym "Empty"])
  have hmemPair :
      (root, m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 := by
    simpa [heval, finItem, finalPair, hrootStable] using hmemFuel
  simpa [target, evalItemNil, atomToStack_eval, root, m,
    f, coreB, letRuleBindings, hrootStable, mExpr, mSym] using hmemPair

/-- Every executable RHS item emitted by the `let` equation rule is final under
an empty continuation: the rule's RHS is headed by embedded `unify`, never by
`function`. -/
private theorem isFinal_evalResult_nil_instantiate_freshen_let
    (counter : Nat) (b : Metta.Bindings) :
    isFinal
      (evalResult []
        (Metta.instantiate b (freshenRule counter letRulePair.1 letRulePair.2).2) b) =
      true := by
  simp [letRulePair, freshenRule, Metta.instantiate,
    Metta.Subst.apply, Metta.Subst.lookup, Metta.Bindings.resolveAtom, Metta.Atom.vars,
    evalResult, finItem, isFinal, mExpr, mSym, mVar]

private theorem isFinal_evalResult_nil_instantiate_freshenAvoiding_let
    (counter : Nat) (avoid : List Metta.VarName) (b : Metta.Bindings) :
    isFinal
      (evalResult []
        (Metta.instantiate b
          (freshenRuleAvoiding counter avoid letRulePair.1 letRulePair.2).1.2) b) =
      true := by
  by_cases h : ∃ v ∈ (freshenRule counter letRulePair.1 letRulePair.2).1.vars ++
      (freshenRule counter letRulePair.1 letRulePair.2).2.vars, v ∈ avoid
  · rw [freshenRuleAvoiding, if_pos h]
    simp [letRulePair, freshenRule, renameAllVars, Metta.instantiate,
      Metta.Subst.apply, Metta.Subst.lookup, Metta.Bindings.resolveAtom,
      Metta.Atom.vars, evalResult, finItem, isFinal, mExpr, mSym, mVar]
  · rw [freshenRuleAvoiding, if_neg h]
    exact isFinal_evalResult_nil_instantiate_freshen_let counter b

/-- The `let` root scheduler step preserves the absence of local `&self`
rules.

This is the state half paired with
`interpretFuel_kernelEnv_let_root_contains`; it is the scheduler-invariant
fact needed when the later `convReadout` proof follows the outer `let`
through LeaTTa's real `mettaEval` loop. -/
theorem interpretFuel_kernelEnv_let_root_selfExtra
    (fuel : Nat) (st : St)
    (binder : String) (atom template : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = []) :
    ((interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "let" [mVar binder, atom, template])] []).2).world.selfExtra = [] := by
  let target := mExpr "let" [mVar binder, atom, template]
  have hstep :
      interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] } =
        queryOp kernelEnv st [] target [] := by
    change interpretStack1 kernelEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := [] } =
      queryOp kernelEnv st [] target []
    exact interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "let" [mVar binder, atom, template]
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_let [mVar binder, atom, template])
      (by simp [isEmbeddedOp])
  have hqueryWorld : (queryOp kernelEnv st [] target []).2.world.selfExtra = [] := by
    have hw := queryOp_world kernelEnv st [] target []
    rw [hw]
    exact hStatic
  have hnonfinals :
      (queryOp kernelEnv st [] target []).1.filter (fun r => !isFinal r) = [] := by
    apply List.filter_eq_nil_iff.mpr
    intro item hmem
    have hfin : isFinal item = true := by
      unfold queryOp at hmem
      rw [candidatesW_eq_candidates_of_no_selfRules
        kernelEnv st.world target hStatic hImports] at hmem
      rw [kernelEnv_let_candidates binder atom template] at hmem
      simp only [List.foldl_cons, List.foldl_nil] at hmem
      simp [target, mExpr, mSym, isVariableHeaded] at hmem
      by_cases hnone :
          (Minimal.queryOpFoldStep []
            (Metta.Atom.expr [Metta.Atom.sym "let", mVar binder, atom, template])
            [] ([], st) letRulePair).1 = []
      · rw [if_pos hnone] at hmem
        simp at hmem
        subst item
        rfl
      have hmemStep :
          item ∈ (Minimal.queryOpFoldStep []
            (Metta.Atom.expr [Metta.Atom.sym "let", mVar binder, atom, template])
            [] ([], st) letRulePair).1 := by
        rw [if_neg hnone] at hmem
        exact hmem
      have hmemRule :
          item ∈ Mettapedia.Languages.MeTTa.LeaTTa.EvaluatorCorrectness.QueryOpBridge.queryOpItemsOfRule
            [] target [] st.counter letRulePair := by
        simpa [target, mExpr, mSym, Minimal.queryOpFoldStep] using hmemStep
      have hmem' :=
        (Mettapedia.Languages.MeTTa.LeaTTa.EvaluatorCorrectness.QueryOpBridge.mem_queryOpItemsOfRule_iff
          [] target [] st.counter letRulePair item).1 hmemRule
      rcases hmem' with ⟨mb, _hmb, m, _hm, _hloopFalse, rfl⟩
      exact isFinal_evalResult_nil_instantiate_freshenAvoiding_let
        st.counter (Metta.Minimal.queryOpAvoid [] target []) m
    simp [hfin]
  have hstepExpanded :
      interpretStack1 kernelEnv fuel st
          { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval",
              mExpr "let" [mVar binder, atom, template]] } :: [],
            bnd := [] } =
        queryOp kernelEnv st [] (mExpr "let" [mVar binder, atom, template]) [] := by
    simpa [target, mExpr, mSym] using hstep
  have hnonfinalsExpanded :
      (queryOp kernelEnv st [] (mExpr "let" [mVar binder, atom, template]) []).1.filter
          (fun r => !isFinal r) = [] := by
    simpa [target] using hnonfinals
  have hqueryWorldExpanded :
      (queryOp kernelEnv st [] (mExpr "let" [mVar binder, atom, template]) []).2.world.selfExtra = [] := by
    simpa [target] using hqueryWorld
  rw [interpretFuel_cons_step_eq]
  simp only [evalItemNil, atomToStack_eval, List.append_nil]
  rw [hstepExpanded, hnonfinalsExpanded]
  simpa [interpretFuel] using hqueryWorldExpanded

/-- Root fuel-driver readout for the finite-control `if true` rule over closed branches.

This is the `kernelEnv`-direct executable root step needed by the full `convReadout` scheduler
lift: the root is harvested from the real `interpretFuel` driver, while the selected branch remains
available for the surrounding `mettaEval` recursion. -/
theorem interpretFuel_kernelEnv_if_true_root_contains
    (fuel : Nat) (st : St) (thenA elseA : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (_hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (_hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hThenNotFunction : ∀ tail, thenA ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail))
    (hThenNotEmpty : (thenA != emptyA) = true) :
    (thenA,
        (renameBindings (counterSuffix st.counter)
          [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "if" [mBool true, thenA, elseA])] []).1 := by
  let target := mExpr "if" [mBool true, thenA, elseA]
  let coreB : Metta.Bindings :=
    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix st.counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, mBool, hThenClosed, hElseClosed, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hElseClosed
      (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, bindingValueKeys]
  have hmatchCore : coreB ∈ Metta.matchAtoms ifTrueRulePair.1 target := by
    simpa [coreB, target] using
      (by
        rw [if_true_rule_match thenA elseA (by simp [hThenClosed]) (by
          simp [hElseClosed]) _hThenNonVar _hElseNonVar
          (by simp [hThenClosed]) (by simp [hElseClosed])]
        simp :
        [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA] ∈
          Metta.matchAtoms ifTrueRulePair.1 (mExpr "if" [mBool true, thenA, elseA]))
  have hmatchFresh : renameBindings f coreB ∈
      Metta.matchAtoms (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).1 target := by
    simpa [f] using
      matchAtoms_freshenRule_lhs_closed_target_mem st.counter hclosedTarget hmatchCore
  have hcompat := legacyFresheningCompatible_empty_of_target_vars_nil
    st.counter target ifTrueRulePair.1 ifTrueRulePair.2 hclosedTarget
  have hmerge : m ∈ Metta.Bindings.merge [] (renameBindings f coreB) := by
    simpa [m, f] using
      (merge_empty_renamed_closed_nodup_mem (counterSuffix_injective st.counter)
        hclosedB hnodup)
  have hloop : Metta.Bindings.hasLoop m = false := by
    have hclosedRen : ClosedValueBindings (renameBindings (counterSuffix st.counter) coreB) :=
      ClosedValueBindings.rename hclosedB
    simpa [m, f] using
      (ClosedValueBindings.hasLoop_false (ClosedValueBindings.reverse hclosedRen))
  have hquery :
      evalResult [] (Metta.instantiate m
          (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2) m ∈
        (queryOp kernelEnv st [] target []).1 := by
    have hmatchAvoid :
        renameBindings f coreB ∈
          Metta.matchAtoms
            (freshenRuleAvoiding st.counter (Metta.Minimal.queryOpAvoid [] target [])
              ifTrueRulePair.1 ifTrueRulePair.2).1.1 target := by
      rw [hcompat]
      exact hmatchFresh
    simpa [target, hcompat] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := kernelEnv) (st := st) (prev := []) (toEval := target) (b := [])
        (pre := []) (post := [ifFalseRulePair]) (p := ifTrueRulePair)
        (mb := renameBindings f coreB) (m := m)
        hStatic (by simp [target, isVariableHeaded, mExpr, mSym])
        (by simpa [target] using kernelEnv_if_candidates true thenA elseA)
        hmatchAvoid hmerge hloop
  have hresult :
      Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
        thenA := by
    have hf : Function.Injective f := by
      simpa [f] using counterSuffix_injective st.counter
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename hclosedB
    have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
      rw [bindingValueKeys_renameBindings]
      exact List.Nodup.map hf hnodup
    have hreverse :
        Metta.instantiate (renameBindings f coreB).reverse
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 :=
      instantiate_reverse_closed_nodup hclosedRen hnodupRen _
    have hbound :
        ∀ v ∈ ifTrueRulePair.2.vars, ∃ t, Metta.Bindings.lookupVal coreB v = some t := by
      intro v hv
      have hv' : v = "t" := by
        simpa [ifTrueRulePair, mVar, Metta.Atom.vars] using hv
      subst v
      exact ⟨thenA, by simp [coreB, Metta.Bindings.lookupVal]⟩
    have hfresh :
        Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate coreB ifTrueRulePair.2 := by
      simpa [f] using
        instantiate_freshenRule_rhs_of_renamed_bindings
          st.counter ifTrueRulePair.1 ifTrueRulePair.2 coreB
          hclosedB.toValueBindings hclosedB.valueKeysFreshForValues
          (hclosedB.renamedValueKeysFreshForValues _) hbound
    have hcore : Metta.instantiate coreB ifTrueRulePair.2 = thenA :=
      if_true_instantiate_bindings thenA elseA hThenClosed hElseClosed
    calc
      Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 := by
            simpa [m] using hreverse
      _ = Metta.instantiate coreB ifTrueRulePair.2 := hfresh
      _ = thenA := hcore
  have hstack :
      evalResult [] thenA m ∈
        (interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }).1 := by
    have hqueryThen :
        evalResult [] thenA m ∈ (queryOp kernelEnv st [] target []).1 := by
      simpa [hresult] using hquery
    exact (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "if" [mBool true, thenA, elseA]
      (evalResult [] thenA m)
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_if [mBool true, thenA, elseA])
      (by simp [isEmbeddedOp])).2 hqueryThen
  have heval : evalResult [] thenA m = finItem [] thenA m := by
    cases thenA with
    | expr xs =>
        cases xs with
        | nil => rfl
        | cons h rest =>
            cases h with
            | sym op =>
                by_cases hop : op = "function"
                · subst hop
                  exfalso
                  exact hThenNotFunction rest rfl
                · simp [evalResult]
            | var _ => simp [evalResult]
            | gnd _ => simp [evalResult]
            | expr _ => simp [evalResult]
    | sym _ => rfl
    | var _ => rfl
    | gnd _ => rfl
  have hfinal : isFinal (evalResult [] thenA m) = true := by
    simp [heval, finItem, isFinal]
  have hmemFuel :
      finalPair (evalResult [] thenA m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelEnv fuel st { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }
      (evalResult [] thenA m) [] [] hstack hfinal (by
        simpa [heval, finItem, finalPair,
          instantiate_eq_self_of_vars_nil m hThenClosed] using hThenNotEmpty)
  simpa [target, evalItemNil, atomToStack_eval, heval, finItem, finalPair, m, f, coreB,
    mExpr, mSym,
    instantiate_eq_self_of_vars_nil _ hThenClosed] using hmemFuel

/-- Root fuel-driver readout for the finite-control `if false` rule over closed branches.

The false rule is the second static `if` candidate, so its runtime freshening uses
`st.counter + 1`. This is the scheduler-facing mirror of
`interpretFuel_kernelEnv_if_true_root_contains`. -/
theorem interpretFuel_kernelEnv_if_false_root_contains
    (fuel : Nat) (st : St) (thenA elseA : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (_hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (_hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hElseNotFunction : ∀ tail, elseA ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail))
    (hElseNotEmpty : (elseA != emptyA) = true) :
    (elseA,
        (renameBindings (counterSuffix (st.counter + 1))
          [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "if" [mBool false, thenA, elseA])] []).1 := by
  let target := mExpr "if" [mBool false, thenA, elseA]
  let coreB : Metta.Bindings :=
    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix (st.counter + 1)
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, mBool, hThenClosed, hElseClosed, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hElseClosed
      (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, bindingValueKeys]
  have hmatchCore : coreB ∈ Metta.matchAtoms ifFalseRulePair.1 target := by
    simpa [coreB, target] using
      (by
        rw [if_false_rule_match thenA elseA (by simp [hThenClosed]) (by
          simp [hElseClosed]) _hThenNonVar _hElseNonVar
          (by simp [hThenClosed]) (by simp [hElseClosed])]
        simp :
        [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA] ∈
          Metta.matchAtoms ifFalseRulePair.1 (mExpr "if" [mBool false, thenA, elseA]))
  have hmatchFresh : renameBindings f coreB ∈
      Metta.matchAtoms (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).1
        target := by
    simpa [f] using
      matchAtoms_freshenRule_lhs_closed_target_mem (st.counter + 1) hclosedTarget hmatchCore
  have hcompat := legacyFresheningCompatible_empty_of_target_vars_nil
    (st.counter + 1) target ifFalseRulePair.1 ifFalseRulePair.2 hclosedTarget
  have hmerge : m ∈ Metta.Bindings.merge [] (renameBindings f coreB) := by
    simpa [m, f] using
      (merge_empty_renamed_closed_nodup_mem (counterSuffix_injective (st.counter + 1))
        hclosedB hnodup)
  have hloop : Metta.Bindings.hasLoop m = false := by
    have hclosedRen : ClosedValueBindings (renameBindings (counterSuffix (st.counter + 1)) coreB) :=
      ClosedValueBindings.rename hclosedB
    simpa [m, f] using
      (ClosedValueBindings.hasLoop_false (ClosedValueBindings.reverse hclosedRen))
  have hquery :
      evalResult [] (Metta.instantiate m
          (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2) m ∈
        (queryOp kernelEnv st [] target []).1 := by
    have hmatchAvoid :
        renameBindings f coreB ∈
          Metta.matchAtoms
            (freshenRuleAvoiding (st.counter + 1) (Metta.Minimal.queryOpAvoid [] target [])
              ifFalseRulePair.1 ifFalseRulePair.2).1.1 target := by
      rw [hcompat]
      exact hmatchFresh
    simpa [target, hcompat] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := kernelEnv) (st := st) (prev := []) (toEval := target) (b := [])
        (pre := [ifTrueRulePair]) (post := []) (p := ifFalseRulePair)
        (mb := renameBindings f coreB) (m := m)
        hStatic (by simp [target, isVariableHeaded, mExpr, mSym])
        (by simpa [target] using kernelEnv_if_candidates false thenA elseA)
        hmatchAvoid hmerge hloop
  have hresult :
      Metta.instantiate m (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
        elseA := by
    have hf : Function.Injective f := by
      simpa [f] using counterSuffix_injective (st.counter + 1)
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename hclosedB
    have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
      rw [bindingValueKeys_renameBindings]
      exact List.Nodup.map hf hnodup
    have hreverse :
        Metta.instantiate (renameBindings f coreB).reverse
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 :=
      instantiate_reverse_closed_nodup hclosedRen hnodupRen _
    have hbound :
        ∀ v ∈ ifFalseRulePair.2.vars, ∃ t, Metta.Bindings.lookupVal coreB v = some t := by
      intro v hv
      have hv' : v = "e" := by
        simpa [ifFalseRulePair, mVar, Metta.Atom.vars] using hv
      subst v
      exact ⟨elseA, by simp [coreB, Metta.Bindings.lookupVal]⟩
    have hfresh :
        Metta.instantiate (renameBindings f coreB)
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
          Metta.instantiate coreB ifFalseRulePair.2 := by
      simpa [f] using
        instantiate_freshenRule_rhs_of_renamed_bindings
          (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2 coreB
          hclosedB.toValueBindings hclosedB.valueKeysFreshForValues
          (hclosedB.renamedValueKeysFreshForValues _) hbound
    have hcore : Metta.instantiate coreB ifFalseRulePair.2 = elseA :=
      if_false_instantiate_bindings thenA elseA hThenClosed hElseClosed
    calc
      Metta.instantiate m (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2).2 := by
            simpa [m] using hreverse
      _ = Metta.instantiate coreB ifFalseRulePair.2 := hfresh
      _ = elseA := hcore
  have hstack :
      evalResult [] elseA m ∈
        (interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }).1 := by
    have hqueryElse :
        evalResult [] elseA m ∈ (queryOp kernelEnv st [] target []).1 := by
      simpa [hresult] using hquery
    exact (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "if" [mBool false, thenA, elseA]
      (evalResult [] elseA m)
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_if [mBool false, thenA, elseA])
      (by simp [isEmbeddedOp])).2 hqueryElse
  have heval : evalResult [] elseA m = finItem [] elseA m := by
    cases elseA with
    | expr xs =>
        cases xs with
        | nil => rfl
        | cons h rest =>
            cases h with
            | sym op =>
                by_cases hop : op = "function"
                · subst hop
                  exfalso
                  exact hElseNotFunction rest rfl
                · simp [evalResult]
            | var _ => simp [evalResult]
            | gnd _ => simp [evalResult]
            | expr _ => simp [evalResult]
    | sym _ => rfl
    | var _ => rfl
    | gnd _ => rfl
  have hfinal : isFinal (evalResult [] elseA m) = true := by
    simp [heval, finItem, isFinal]
  have hmemFuel :
      finalPair (evalResult [] elseA m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelEnv fuel st { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }
      (evalResult [] elseA m) [] [] hstack hfinal (by
        simpa [heval, finItem, finalPair,
          instantiate_eq_self_of_vars_nil m hElseClosed] using hElseNotEmpty)
  simpa [target, evalItemNil, atomToStack_eval, heval, finItem, finalPair, m, f, coreB,
    mExpr, mSym,
    instantiate_eq_self_of_vars_nil _ hElseClosed] using hmemFuel

/-- Root fuel-driver readout for the finite-control `is-bad` rule over a closed non-variable atom.

The emitted `unify` pattern contains the rule's escaping `e` variable freshened at the runtime
candidate counter. This theorem keeps that open variable explicit; the following `unify` fallback
lift consumes it when the normalized readout is not a `Bad` constructor. -/
theorem interpretFuel_kernelEnv_is_bad_root_contains
    (fuel : Nat) (st : St) (a : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    (mExpr "unify"
        [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false],
      (renameBindings (counterSuffix st.counter)
        [Metta.BindingRel.val "x" a]).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "is-bad" [a])] []).1 := by
  let target := mExpr "is-bad" [a]
  let coreB : Metta.Bindings := [Metta.BindingRel.val "x" a]
  let f := counterSuffix st.counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  let root :=
    mExpr "unify" [a, mExpr "Bad" [mVar (f "e")], mBool true, mBool false]
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, hClosed, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hClosed ClosedValueBindings.nil
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, bindingValueKeys]
  have hmatchCore : coreB ∈ Metta.matchAtoms isBadRulePair.1 target := by
    simpa [coreB, target] using
      (by
        rw [is_bad_rule_match a (by simp [hClosed]) hNonVar]
        simp :
        [Metta.BindingRel.val "x" a] ∈
          Metta.matchAtoms isBadRulePair.1 (mExpr "is-bad" [a]))
  have hmatchFresh : renameBindings f coreB ∈
      Metta.matchAtoms (freshenRule st.counter isBadRulePair.1 isBadRulePair.2).1 target := by
    simpa [f] using
      matchAtoms_freshenRule_lhs_closed_target_mem st.counter hclosedTarget hmatchCore
  have hcompat := legacyFresheningCompatible_empty_of_target_vars_nil
    st.counter target isBadRulePair.1 isBadRulePair.2 hclosedTarget
  have hmerge : m ∈ Metta.Bindings.merge [] (renameBindings f coreB) := by
    simpa [m, f] using
      (merge_empty_renamed_closed_nodup_mem (counterSuffix_injective st.counter)
        hclosedB hnodup)
  have hloop : Metta.Bindings.hasLoop m = false := by
    have hclosedRen : ClosedValueBindings (renameBindings (counterSuffix st.counter) coreB) :=
      ClosedValueBindings.rename hclosedB
    simpa [m, f] using
      (ClosedValueBindings.hasLoop_false (ClosedValueBindings.reverse hclosedRen))
  have hclosedM : ClosedValueBindings m := by
    simpa [m, f] using
      (ClosedValueBindings.reverse (ClosedValueBindings.rename hclosedB))
  have hquery :
      evalResult [] (Metta.instantiate m
          (freshenRule st.counter isBadRulePair.1 isBadRulePair.2).2) m ∈
        (queryOp kernelEnv st [] target []).1 := by
    have hmatchAvoid :
        renameBindings f coreB ∈
          Metta.matchAtoms
            (freshenRuleAvoiding st.counter (Metta.Minimal.queryOpAvoid [] target [])
              isBadRulePair.1 isBadRulePair.2).1.1 target := by
      rw [hcompat]
      exact hmatchFresh
    simpa [target, hcompat] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := kernelEnv) (st := st) (prev := []) (toEval := target) (b := [])
        (pre := []) (post := []) (p := isBadRulePair)
        (mb := renameBindings f coreB) (m := m)
        hStatic (by simp [target, isVariableHeaded, mExpr, mSym])
        (by simpa [target] using kernelEnv_is_bad_candidates a)
        hmatchAvoid hmerge hloop
  have hxe : f "e" ≠ f "x" := by
    intro h
    have hx : "e" = "x" := (counterSuffix_injective st.counter) h
    contradiction
  have hxeRaw : "e#" ++ st.counter.repr ≠ "x#" ++ st.counter.repr := by
    simp [f, counterSuffix] at hxe ⊢
  have hsubstA :
      Metta.Subst.apply [(f "x", a)] a = a := by
    exact Metta.Subst.apply_of_closed _ _ hClosed
  have hsubstARaw :
      Metta.Subst.apply [("x#" ++ st.counter.repr, a)] a = a := by
    simpa [f, counterSuffix] using hsubstA
  have hresult :
      Metta.instantiate m (freshenRule st.counter isBadRulePair.1 isBadRulePair.2).2 =
        root := by
    rw [freshenRule_eq_renBy]
    rw [hclosedM.instantiate_eq_subst_apply]
    simp [root, m, f, coreB, isBadRulePair, renameBindings, counterSuffix,
      Metta.bindingsToSubst,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
      Metta.Subst.apply, Metta.Subst.lookup, hxeRaw,
      mExpr, mSym, mVar, mBool]
  have hrootStable : Metta.instantiate m root = root := by
    rw [hclosedM.instantiate_eq_subst_apply]
    simp [root, m, f, coreB, renameBindings, counterSuffix,
      Metta.bindingsToSubst, Metta.Subst.apply,
      Metta.Subst.lookup, hsubstARaw, hxeRaw,
      mExpr, mSym, mVar, mBool]
  have hstack :
      evalResult [] root m ∈
        (interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }).1 := by
    have hqueryRoot :
        evalResult [] root m ∈ (queryOp kernelEnv st [] target []).1 := by
      simpa [hresult] using hquery
    exact (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "is-bad" [a]
      (evalResult [] root m)
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_isBad a)
      (by simp [isEmbeddedOp])).2 hqueryRoot
  have heval : evalResult [] root m = finItem [] root m := by
    simp [root, evalResult, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root m) = true := by
    simp [heval, finItem, isFinal]
  have hmemFuel :
      finalPair (evalResult [] root m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelEnv fuel st { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] }
      (evalResult [] root m) [] [] hstack hfinal (by
        rw [heval]
        simpa [finItem, finalPair, hrootStable, root] using
          mExpr_ne_empty "unify"
            [a, mExpr "Bad" [mVar (f "e")], mBool true, mBool false])
  have hmemPair :
      (root, m) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := [{ atom := mExpr "eval" [target] }], bnd := [] }] []).1 := by
    simpa [heval, finItem, finalPair, hrootStable] using hmemFuel
  simpa [target, evalItemNil, atomToStack_eval, root, m,
    f, coreB, hrootStable, mExpr, mSym] using hmemPair

/-- Every executable RHS item emitted by the `is-bad` equation rule is final under an empty
continuation: the rule's RHS is headed by embedded `unify`, never by `function`. -/
private theorem isFinal_evalResult_nil_instantiate_freshen_isBad
    (counter : Nat) (b : Metta.Bindings) :
    isFinal
      (evalResult []
        (Metta.instantiate b (freshenRule counter isBadRulePair.1 isBadRulePair.2).2) b) =
  true := by
  simp [isBadRulePair, freshenRule, Metta.instantiate,
    Metta.Subst.apply, Metta.Subst.lookup, Metta.Bindings.resolveAtom,
    Metta.Atom.vars, evalResult, finItem, isFinal, mExpr, mSym, mVar, mBool]

private theorem isFinal_evalResult_nil_instantiate_freshenAvoiding_isBad
    (counter : Nat) (avoid : List Metta.VarName) (b : Metta.Bindings) :
    isFinal
      (evalResult []
        (Metta.instantiate b
          (freshenRuleAvoiding counter avoid isBadRulePair.1 isBadRulePair.2).1.2) b) =
      true := by
  by_cases h : ∃ v ∈ (freshenRule counter isBadRulePair.1 isBadRulePair.2).1.vars ++
      (freshenRule counter isBadRulePair.1 isBadRulePair.2).2.vars, v ∈ avoid
  · rw [freshenRuleAvoiding, if_pos h]
    simp [isBadRulePair, freshenRule, renameAllVars, Metta.instantiate,
      Metta.Subst.apply, Metta.Subst.lookup, Metta.Bindings.resolveAtom,
      Metta.Atom.vars, evalResult, finItem, isFinal, mExpr, mSym, mVar, mBool]
  · rw [freshenRuleAvoiding, if_neg h]
    exact isFinal_evalResult_nil_instantiate_freshen_isBad counter b

/-- The `is-bad` root scheduler step preserves the absence of local `&self` rules.

This is the state half paired with `interpretFuel_kernelEnv_is_bad_root_contains`; it is needed by
the invariant-aware unary metta-evaluator fold, because the recursive `unify` readout ultimately
evaluates a grounded Boolean only under states whose local rule slice is still empty. -/
theorem interpretFuel_kernelEnv_is_bad_root_selfExtra
    (fuel : Nat) (st : St) (a : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (_hClosed : a.vars = [])
    (_hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    ((interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "is-bad" [a])] []).2).world.selfExtra = [] := by
  let target := mExpr "is-bad" [a]
  have hstep :
      interpretStack1 kernelEnv fuel st
          { stack := { atom := mExpr "eval" [target] } :: [], bnd := [] } =
        queryOp kernelEnv st [] target [] := by
    change interpretStack1 kernelEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := [] } =
      queryOp kernelEnv st [] target []
    exact interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "is-bad" [a]
      (by simp [target, mExpr, mSym, Metta.instantiate_nil])
      (kernelEnv_callGrounded_isBad a)
      (by simp [isEmbeddedOp])
  have hqueryWorld : (queryOp kernelEnv st [] target []).2.world.selfExtra = [] := by
    have hw := queryOp_world kernelEnv st [] target []
    rw [hw]
    exact hStatic
  have hnonfinals :
      (queryOp kernelEnv st [] target []).1.filter (fun r => !isFinal r) = [] := by
    apply List.filter_eq_nil_iff.mpr
    intro item hmem
    have hfin : isFinal item = true := by
      unfold queryOp at hmem
      rw [candidatesW_eq_candidates_of_no_selfRules
        kernelEnv st.world target hStatic hImports] at hmem
      rw [kernelEnv_is_bad_candidates a] at hmem
      simp only [List.foldl_cons, List.foldl_nil] at hmem
      simp [target, mExpr, mSym, isVariableHeaded] at hmem
      by_cases hnone :
          (Minimal.queryOpFoldStep []
            (Metta.Atom.expr [Metta.Atom.sym "is-bad", a])
            [] ([], st) isBadRulePair).1 = []
      · rw [if_pos hnone] at hmem
        simp at hmem
        subst item
        rfl
      have hmemStep :
          item ∈ (Minimal.queryOpFoldStep []
            (Metta.Atom.expr [Metta.Atom.sym "is-bad", a])
            [] ([], st) isBadRulePair).1 := by
        rw [if_neg hnone] at hmem
        exact hmem
      have hmemRule :
          item ∈ Mettapedia.Languages.MeTTa.LeaTTa.EvaluatorCorrectness.QueryOpBridge.queryOpItemsOfRule
            [] target [] st.counter isBadRulePair := by
        simpa [target, mExpr, mSym, Minimal.queryOpFoldStep] using hmemStep
      have hmem' :=
        (Mettapedia.Languages.MeTTa.LeaTTa.EvaluatorCorrectness.QueryOpBridge.mem_queryOpItemsOfRule_iff
          [] target [] st.counter isBadRulePair item).1 hmemRule
      rcases hmem' with ⟨mb, _hmb, m, _hm, _hloopFalse, rfl⟩
      exact isFinal_evalResult_nil_instantiate_freshenAvoiding_isBad
        st.counter (Metta.Minimal.queryOpAvoid [] target []) m
    simp [hfin]
  have hstepExpanded :
      interpretStack1 kernelEnv fuel st
          { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", mExpr "is-bad" [a]] } :: [],
            bnd := [] } =
        queryOp kernelEnv st [] (mExpr "is-bad" [a]) [] := by
    simpa [target, mExpr, mSym] using hstep
  have hnonfinalsExpanded :
      (queryOp kernelEnv st [] (mExpr "is-bad" [a]) []).1.filter (fun r => !isFinal r) =
        [] := by
    simpa [target] using hnonfinals
  have hqueryWorldExpanded :
      (queryOp kernelEnv st [] (mExpr "is-bad" [a]) []).2.world.selfExtra = [] := by
    simpa [target] using hqueryWorld
  rw [interpretFuel_cons_step_eq]
  simp only [evalItemNil, atomToStack_eval, List.append_nil]
  rw [hstepExpanded, hnonfinalsExpanded]
  simpa [interpretFuel] using hqueryWorldExpanded

/-- Exact `queryOp` readout for the finite-control `is-bad` root in states with
no local rules. -/
private theorem queryOp_kernelEnv_is_bad_eq
    (st : St) (a : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    queryOp kernelEnv st [] (mExpr "is-bad" [a]) [] =
      ( [evalResult []
            (mExpr "unify"
              [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false])
            ((renameBindings (counterSuffix st.counter)
              [Metta.BindingRel.val "x" a]).reverse)]
      , { counter := st.counter + 1, world := st.world }) := by
  unfold queryOp
  have hNotVarHead : isVariableHeaded (mExpr "is-bad" [a]) = false := by
    simp [isVariableHeaded, mExpr, mSym]
  rw [hNotVarHead]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [candidatesW_eq_candidates_of_no_selfRules
    kernelEnv st.world (mExpr "is-bad" [a]) hStatic hImports]
  rw [kernelEnv_is_bad_candidates a]
  have hitems :
      Metta.Minimal.queryOpItemsOfRule [] (mExpr "is-bad" [a]) [] st.counter isBadRulePair =
        [evalResult []
          (mExpr "unify"
            [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false])
          ((renameBindings (counterSuffix st.counter)
            [Metta.BindingRel.val "x" a]).reverse)] :=
    queryOpItems_kernelEnv_is_bad_eq st.counter a hClosed hNonVar
  have hcounter := Metta.Minimal.freshenRuleAvoiding_counter st.counter
    (Metta.Minimal.queryOpAvoid [] (mExpr "is-bad" [a]) [])
    isBadRulePair.1 isBadRulePair.2
  have hstep :
      Metta.Minimal.queryOpFoldStep [] (mExpr "is-bad" [a]) [] ([], st) isBadRulePair =
        (Metta.Minimal.queryOpItemsOfRule [] (mExpr "is-bad" [a]) [] st.counter
            isBadRulePair,
          { st with counter :=
              (freshenRuleAvoiding st.counter
                (Metta.Minimal.queryOpAvoid [] (mExpr "is-bad" [a]) [])
                isBadRulePair.1 isBadRulePair.2).2 }) := by
    rfl
  simp only [List.foldl_cons, List.foldl_nil]
  rw [hstep, hitems, hcounter]
  simp

/-- Exact `queryOp` readout for `is-bad` with a closed incoming value
environment.  The private freshened names remain existential, while the
incoming bindings and counter transition are literal. -/
private theorem queryOp_kernelEnv_is_bad_eq_from_closed
    (st : St) (a : Metta.Atom) (incoming : Metta.Bindings)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w)
    (hIncoming : ClosedValueBindings incoming) :
    ∃ x e,
      x ≠ e ∧ x ∉ incoming.vars ∧ e ∉ incoming.vars ∧
      queryOp kernelEnv st [] (mExpr "is-bad" [a]) incoming =
        ( [evalResult []
              (mExpr "unify"
                [a, mExpr "Bad" [mVar e], mBool true, mBool false])
              (Metta.BindingRel.val x a :: incoming)]
        , { counter := st.counter + 1, world := st.world }) := by
  rcases queryOpItems_is_bad_eq_from_closed st.counter a incoming
      hClosed hNonVar hIncoming with
    ⟨x, e, hxe, hxIncoming, heIncoming, hitems⟩
  refine ⟨x, e, hxe, hxIncoming, heIncoming, ?_⟩
  unfold queryOp
  have hNotVarHead : isVariableHeaded (mExpr "is-bad" [a]) = false := by
    simp [isVariableHeaded, mExpr, mSym]
  rw [hNotVarHead]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [candidatesW_eq_candidates_of_no_selfRules
    kernelEnv st.world (mExpr "is-bad" [a]) hStatic hImports]
  rw [kernelEnv_is_bad_candidates a]
  have hcounter := Metta.Minimal.freshenRuleAvoiding_counter st.counter
    (Metta.Minimal.queryOpAvoid [] (mExpr "is-bad" [a]) incoming)
    isBadRulePair.1 isBadRulePair.2
  have hstep :
      Metta.Minimal.queryOpFoldStep [] (mExpr "is-bad" [a]) incoming
          ([], st) isBadRulePair =
        (Metta.Minimal.queryOpItemsOfRule [] (mExpr "is-bad" [a]) incoming
            st.counter isBadRulePair,
          { st with counter :=
              (freshenRuleAvoiding st.counter
                (Metta.Minimal.queryOpAvoid [] (mExpr "is-bad" [a]) incoming)
                isBadRulePair.1 isBadRulePair.2).2 }) := by
    rfl
  simp only [List.foldl_cons, List.foldl_nil]
  rw [hstep, hitems, hcounter]
  simp

/-- A private variable outside a closed value environment contributes no
public singleton projection. -/
private theorem restrictBnd_singleton_fresh_of_closed
    (bindings : Metta.Bindings) (name : Metta.VarName)
    (hclosed : ClosedValueBindings bindings)
    (hfresh : name ∉ bindings.vars) :
    restrictBnd [name] bindings = [] := by
  have hnotKey : name ∉ bindingValueKeys bindings := by
    intro hkey
    exact hfresh (bindingValueKey_mem_vars hkey)
  have hlook : Metta.Bindings.lookupVal bindings name = none :=
    hclosed.toValueBindings.lookup_none_of_not_key hnotKey
  have hinst :
      Metta.instantiate bindings (Metta.Atom.var name) =
        Metta.Atom.var name := by
    rw [hclosed.instantiate_eq_subst_apply]
    simp [Metta.Subst.apply, lookup_bindingsToSubst, hlook]
  apply restrictBnd_eq_nil_of_resolves_self_and_no_public_eqs
  · intro candidate hcandidate
    simp only [List.mem_singleton] at hcandidate
    subst candidate
    exact resolveAtom_var_of_instantiate_eq_self bindings name hinst _
  · exact valueBindings_filter_eq_only_empty _ hclosed.toValueBindings

/-- A private `Bad` pattern is stable under a closed value environment that
does not bind its private name. -/
private theorem instantiate_bad_var_eq_self_of_closed_fresh
    (bindings : Metta.Bindings) (name : Metta.VarName)
    (hclosed : ClosedValueBindings bindings)
    (hfresh : name ∉ bindings.vars) :
    Metta.instantiate bindings (mExpr "Bad" [mVar name]) =
      mExpr "Bad" [mVar name] := by
  have hnotKey : name ∉ bindingValueKeys bindings := by
    intro hkey
    exact hfresh (bindingValueKey_mem_vars hkey)
  have hlook : Metta.Bindings.lookupVal bindings name = none :=
    hclosed.toValueBindings.lookup_none_of_not_key hnotKey
  rw [hclosed.instantiate_eq_subst_apply]
  simp [mExpr, mSym, mVar, Metta.Subst.apply,
    lookup_bindingsToSubst, hlook]

/-- The `is-bad` rule's emitted root is already stable under the merged
private match binding and any closed incoming value environment. -/
private theorem is_bad_root_instantiate_stable_from_closed
    (a : Metta.Atom) (incoming : Metta.Bindings) (x e : String)
    (hClosed : a.vars = [])
    (hIncoming : ClosedValueBindings incoming)
    (hxe : x ≠ e)
    (heIncoming : e ∉ incoming.vars) :
    Metta.instantiate (Metta.BindingRel.val x a :: incoming)
        (mExpr "unify"
          [a, mExpr "Bad" [mVar e], mBool true, mBool false]) =
      mExpr "unify"
        [a, mExpr "Bad" [mVar e], mBool true, mBool false] := by
  have hMergedClosed :
      ClosedValueBindings (Metta.BindingRel.val x a :: incoming) :=
    ClosedValueBindings.val hClosed hIncoming
  have heNotKey : e ∉ bindingValueKeys incoming := by
    intro he
    exact heIncoming (bindingValueKey_mem_vars he)
  have hlookE : Metta.Bindings.lookupVal incoming e = none :=
    hIncoming.toValueBindings.lookup_none_of_not_key heNotKey
  rw [hMergedClosed.instantiate_eq_subst_apply]
  simp [mExpr, mSym, mVar, mBool, Metta.Subst.apply,
    lookup_bindingsToSubst, Metta.Bindings.lookupVal, hlookE, hxe.symm,
    Metta.Subst.apply_of_closed _ _ hClosed]

/-- One exact `is-bad` scheduler step with closed incoming value bindings.
The existential names are the executable's private freshenings; they are
proven distinct and disjoint from the incoming public interface. -/
theorem interpretFuel_kernelEnv_is_bad_root_eq_from_closed
    (fuel : Nat) (st : St) (a : Metta.Atom) (incoming : Metta.Bindings)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w)
    (hIncoming : ClosedValueBindings incoming) :
    ∃ x e,
      x ≠ e ∧ x ∉ incoming.vars ∧ e ∉ incoming.vars ∧
      interpretFuel kernelEnv (fuel + 1) st
          [evalItemBnd incoming (mExpr "is-bad" [a])] [] =
        ( [ (mExpr "unify"
              [a, mExpr "Bad" [mVar e], mBool true, mBool false],
              Metta.BindingRel.val x a :: incoming) ]
        , { counter := st.counter + 1, world := st.world }) := by
  rcases queryOp_kernelEnv_is_bad_eq_from_closed st a incoming
      hStatic hImports hClosed hNonVar hIncoming with
    ⟨x, e, hxe, hxIncoming, heIncoming, hquery⟩
  let target := mExpr "is-bad" [a]
  let root :=
    mExpr "unify" [a, mExpr "Bad" [mVar e], mBool true, mBool false]
  let merged : Metta.Bindings := Metta.BindingRel.val x a :: incoming
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, hClosed, Metta.Atom.vars]
  have hstep :
      interpretStack1 kernelEnv fuel st (evalItemBnd incoming target) =
        ([evalResult [] root merged],
          { counter := st.counter + 1, world := st.world }) := by
    unfold evalItemBnd
    change interpretStack1 kernelEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: []
          bnd := incoming } =
      ([evalResult [] root merged],
        { counter := st.counter + 1, world := st.world })
    rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelEnv fuel st [] target incoming "is-bad" [a]]
    · simpa [target, root, merged, mExpr, mSym] using hquery
    · exact instantiate_eq_self_of_vars_nil incoming hclosedTarget
    · exact kernelEnv_callGrounded_isBad a
    · simp [isEmbeddedOp]
  have hrootStable : Metta.instantiate merged root = root := by
    simpa [root, merged] using
      is_bad_root_instantiate_stable_from_closed
        a incoming x e hClosed hIncoming hxe heIncoming
  have heval : evalResult [] root merged = finItem [] root merged := by
    simp [root, evalResult, finItem, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root merged) = true := by
    simp [heval, finItem, isFinal]
  have hpair : finalPair (evalResult [] root merged) = (root, merged) := by
    rw [heval]
    change (Metta.instantiate merged root, merged) = (root, merged)
    simp [hrootStable]
  refine ⟨x, e, hxe, hxIncoming, heIncoming, ?_⟩
  rw [interpretFuel, hstep]
  simp [interpretFuel, hfinal, hpair, root, merged]

/-- Exact root fuel-driver readout for the finite-control `is-bad` rule over a
closed non-variable atom.

This is the exact-state counterpart of
`interpretFuel_kernelEnv_is_bad_root_contains`: the executable scheduler runs
the single `is-bad` candidate, harvests its final `unify` root item, increments
the gensym counter once, and preserves the local-rule slice.  The explicit
freshened RHS variable (`e#counter`) is kept in the root atom on purpose; the
next theorem consumes it through the `unify` miss branch. -/
theorem interpretFuel_kernelEnv_is_bad_root_eq
    (fuel : Nat) (st : St) (a : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    interpretFuel kernelEnv (fuel + 1) st
        [evalItemNil (mExpr "is-bad" [a])] [] =
      ( [ (mExpr "unify"
            [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false],
            (renameBindings (counterSuffix st.counter)
              [Metta.BindingRel.val "x" a]).reverse) ]
      , { counter := st.counter + 1, world := st.world }) := by
  let target := mExpr "is-bad" [a]
  let root :=
    mExpr "unify" [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false]
  let m : Metta.Bindings :=
    (renameBindings (counterSuffix st.counter)
      [Metta.BindingRel.val "x" a]).reverse
  have hstep :
      interpretStack1 kernelEnv fuel st (evalItemNil target) =
        ([evalResult [] root m], { counter := st.counter + 1, world := st.world }) := by
    change interpretStack1 kernelEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := [] } =
      ([evalResult [] root m], { counter := st.counter + 1, world := st.world })
    rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelEnv fuel st [] target [] "is-bad" [a]]
    · simpa [target, root, m, evalResult, mExpr, mSym] using
        queryOp_kernelEnv_is_bad_eq st a hStatic hImports hClosed hNonVar
    · simp [target, mExpr, mSym, Metta.instantiate_nil]
    · exact kernelEnv_callGrounded_isBad a
    · simp [isEmbeddedOp]
  have hrootStable : Metta.instantiate m root = root := by
    have hclosedM : ClosedValueBindings m := by
      simpa [m] using
        ClosedValueBindings.reverse
          (ClosedValueBindings.rename
            (ClosedValueBindings.val hClosed ClosedValueBindings.nil))
    rw [hclosedM.instantiate_eq_subst_apply]
    have hxe :
        counterSuffix st.counter "e" ≠ counterSuffix st.counter "x" := by
      intro h
      have hx : "e" = "x" := (counterSuffix_injective st.counter) h
      contradiction
    have hsubstA :
        Metta.Subst.apply [(counterSuffix st.counter "x", a)] a = a := by
      exact Metta.Subst.apply_of_closed _ _ hClosed
    simpa [root, m, renameBindings, counterSuffix,
      Metta.instantiate, Metta.bindingsToSubst,
      Metta.Subst.apply, Metta.Subst.lookup, hsubstA, hxe,
      mExpr, mSym, mVar, mBool]
  have heval : evalResult [] root m = finItem [] root m := by
    simp [root, evalResult, finItem, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root m) = true := by
    simp [root, evalResult, finItem, isFinal, mExpr, mSym]
  have hpair :
      finalPair (evalResult [] root m) = (root, m) := by
    rw [heval]
    change (Metta.instantiate m root, m) = (root, m)
    simp [hrootStable]
  rw [interpretFuel, hstep]
  simp [interpretFuel, hfinal, hpair, root, m]

/-- Ordered type-service output for the full runtime's structural equality declaration. -/
theorem kernelEnv_eq_types :
    getTypes kernelEnv (.sym "==") =
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Bool"]] := by
  rw [getTypes.eq_def]
  simp [kernelEnv, MinEnv.ofAtomsGT, kernelControlSignatureDecls, kernelControlRules,
    kernelNfDefBodyRootRules, kernelCoreRules, runtimeDecls, mTypeDecl, mExpr,
    mSym, mVar, ruleIsBad, ruleNfVar, ruleNfSrt, ruleNfCon, ruleNfPi,
    ruleNfLam, ruleNfBad, ruleNfDef, ruleDefBodyOfDDef, nfDefRuleLhs,
    nfDefRuleRhs, defBodyOfDDefRuleLhs, defBodyOfDDefRuleRhs,
    defBodyOfQueryAtom, ruleInferSrtType, ruleInferSrtKind, ruleInferBad,
    ruleConv, ruleIfTrue, ruleIfFalse, ruleLet, ifTrueRulePair,
    ifFalseRulePair, letRulePair, Std.HashMap.getD_insert]

/-- Exact repaired-runtime policy selected for structural equality. -/
def kernelEnv_eq_exactPolicy
    (st : St) (a b : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelEnv st.world "=="
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Bool"]]) :
    ApplicationPolicyProjection kernelEnv st.world "==" [a, b] [false, false] false := by
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->" [mSym "Atom", mSym "Atom", mSym "Bool"]
      argumentTypes := [mSym "Atom", mSym "Atom"]
      returnType := mSym "Bool"
      typeBindings := [] }
  have hSelected :
      selectFunctionType kernelEnv st.world (.sym "==") [a, b] =
        .selected selected := by
    unfold selectFunctionType
    rw [hPinned]
    simp [scanFunctionTypeCandidates, selected, mExpr, mSym]
    have hCheck :
        typeCheckArgsOutcome kernelEnv st.world [.sym "Atom", .sym "Atom"]
          0 [] [a, b] = .success [] := by
      simpa [mSym] using typeCheckArgsOutcome_two_atoms kernelEnv st.world a b
    obtain ⟨latentErrors, hDetailed⟩ :=
      (typeCheckArgsOutcome_eq_success_iff _ _ _ _ _ _ _).mp hCheck
    rw [hDetailed]
  have hMask : argMask selected 2 = [false, false] := by
    simp only [selected, argMask, Metta.instantiate_nil, mSym]
    decide
  have hReturns : returnsAtom selected = false := by
    simp only [selected, returnsAtom, Metta.instantiate_nil, mSym]
    decide
  exact ⟨.selected selected hSelected, hMask, hReturns⟩

theorem KernelEnvTypeWorld.eqOp
    {world : World} (h : KernelEnvTypeWorld world) :
    OperatorTypesPinned kernelEnv world "=="
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Bool"]] := by
  have hp := h "==" (by simp [kernelEnvOperatorInventory])
  simpa [OperatorTypesPinned, kernelEnv_eq_types] using hp

/-- The static candidate slice for the core `is-bad` runtime query contains the single
`is-bad` rule. -/
theorem kernelCoreEnv_is_bad_candidates (a : Metta.Atom) :
    candidatesW kernelCoreEnv St.init.world (mExpr "is-bad" [a]) =
      [] ++ isBadRulePair :: [] := by
  simp [candidatesW, MinEnv.candidates, kernelCoreEnv, mExpr, mSym, mVar,
    headKey, St.init, World.empty, Metta.ruleIndex_getD, Metta.ofAtomsGT_varRules,
    kernelCoreRules, runtimeDecls, ruleIsBad, isBadRulePair, ruleNfVar, ruleNfSrt,
    ruleNfCon, ruleNfPi, ruleNfLam, ruleNfBad, ruleInferSrtType, ruleInferSrtKind,
    ruleInferBad, ruleConv, mTypeDecl, mBool, extractRules]

/-- Grounded Booleans have no equality-rule candidates in the initial core kernel space. -/
theorem kernelCoreEnv_mBool_candidates (b : Bool) :
    candidatesW kernelCoreEnv St.init.world (mBool b) = [] := by
  simp [candidatesW, MinEnv.candidates, kernelCoreEnv, mBool, mExpr, mSym, mVar,
    headKey, St.init, World.empty, Metta.ofAtomsGT_varRules,
    kernelCoreRules, runtimeDecls, ruleIsBad, ruleNfVar, ruleNfSrt,
    ruleNfCon, ruleNfPi, ruleNfLam, ruleNfBad, ruleInferSrtType, ruleInferSrtKind,
    ruleInferBad, ruleConv, mTypeDecl, extractRules]

/-- The root evaluator reports `NotReducible` for grounded Booleans in the initial core kernel
space. -/
theorem interpretFuel_eval_mBool_notReducible_eq (fuel : Nat) (b : Bool) :
    interpretFuel kernelCoreEnv (fuel + 1) St.init [evalItemNil (mBool b)] [] =
