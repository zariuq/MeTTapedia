/-- Exact repaired-runtime policy selected for the full runtime's embedded `unify`. -/
def kernelEnv_unify_exactPolicy
    (st : St) (atom pattern template elseAtom : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelEnv st.world "unify"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom",
        mSym "%Undefined%"]]) :
    ApplicationPolicyProjection kernelEnv st.world "unify"
      [atom, pattern, template, elseAtom] [false, false, false, false] false := by
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->"
        [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom", mSym "%Undefined%"]
      argumentTypes := [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]
      returnType := mSym "%Undefined%"
      typeBindings := [] }
  have hSelected :
      selectFunctionType kernelEnv st.world (.sym "unify")
          [atom, pattern, template, elseAtom] = .selected selected := by
    unfold selectFunctionType
    rw [hPinned]
    simp [scanFunctionTypeCandidates, selected, mExpr, mSym]
    have hCheck :
        typeCheckArgsOutcome kernelEnv st.world
            [.sym "Atom", .sym "Atom", .sym "Atom", .sym "Atom"] 0 []
            [atom, pattern, template, elseAtom] = .success [] := by
      simpa [mSym] using
        typeCheckArgsOutcome_four_atoms kernelEnv st.world atom pattern template elseAtom
    obtain ⟨latentErrors, hDetailed⟩ :=
      (typeCheckArgsOutcome_eq_success_iff _ _ _ _ _ _ _).mp hCheck
    rw [hDetailed]
  have hMask : argMask selected 4 = [false, false, false, false] := by
    simp only [selected, argMask, Metta.instantiate_nil, mSym]
    decide
  have hReturns : returnsAtom selected = false := by
    simp only [selected, returnsAtom, Metta.instantiate_nil, mSym]
    decide
  exact ⟨.selected selected hSelected, hMask, hReturns⟩

/-- Recursion-neutral view of the quoted, `%Undefined%`-returning full-runtime `unify` decision. -/
def kernelEnv_unify_recursionNeutralPolicy
    (st : St) (atom pattern template elseAtom : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelEnv st.world "unify"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom",
        mSym "%Undefined%"]]) :
    RecursionNeutralApplicationPolicy kernelEnv st.world "unify"
      [atom, pattern, template, elseAtom] [false, false, false, false] false := by
  apply (kernelEnv_unify_exactPolicy st atom pattern template elseAtom hPinned).withRecursionNeutralOfAllArgumentsQuoted
  · apply ExactApplicationPolicy.applicationPlanCorresponds_atom_args_symbolic_return
    simpa [OperatorTypesPinned, mExpr, mSym] using hPinned
  · rfl
  · right
    simp [kernelEnv_unify_exactPolicy, ExactApplicationPolicy.selectedType,
      selectedResultExpected, Metta.instantiate_nil, mSym]

/-- Full-runtime `kernelEnv` lift for embedded `unify` success with the stdlib signature facts
discharged.

The remaining premises are semantic rather than environment-bookkeeping: no argument error was
created while quoting, the matched atom is not a variable, the local binder does not loop, and the
selected root readout is stable under the final recursive evaluation step. -/
theorem mettaEval_kernelEnv_embedded_unify_var_success_of_quoted_args
    (fuel : Nat) (st : St)
    (binder : String) (atom template final : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelEnv st.world "unify"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom",
        mSym "%Undefined%"]])
    (hNoErr :
      (([atom, mVar binder, template, mSym "Empty"].zip
          [atom, mVar binder, template, mSym "Empty"]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hAtomNonVar : ∀ w, atom ≠ Metta.Atom.var w)
    (hNoLoop : binder ∉ atom.vars)
    (hnotEmpty :
      (Metta.instantiate [Metta.BindingRel.val binder atom]
        (Metta.instantiate [Metta.BindingRel.val binder atom] template) != emptyA) = true)
    (hRootNotNotReducible :
      (Metta.instantiate [Metta.BindingRel.val binder atom]
        (Metta.instantiate [Metta.BindingRel.val binder atom] template) == notReducibleA) = false)
    (hRootNotSelf :
      (Metta.instantiate [Metta.BindingRel.val binder atom]
        (Metta.instantiate [Metta.BindingRel.val binder atom] template) ==
          mExpr "unify" [atom, mVar binder, template, mSym "Empty"]) = false)
    (hFinal : ∀ st0,
      (final, []) ∈
        (mettaEval kernelEnv (fuel + 1) st0
          (restrictBnd (([atom, mVar binder, template, mSym "Empty"]).flatMap Atom.vars)
            ((Bindings.merge [] [Metta.BindingRel.val binder atom]).head?.getD
              [Metta.BindingRel.val binder atom]))
          (Metta.instantiate [Metta.BindingRel.val binder atom]
            (Metta.instantiate [Metta.BindingRel.val binder atom] template))).1)
    (hFinalNotError : final.isError = false) :
    (final,
        restrictBnd (([atom, mVar binder, template, mSym "Empty"]).flatMap Atom.vars)
          (((restrictBnd (([atom, mVar binder, template, mSym "Empty"]).flatMap Atom.vars)
              ((Bindings.merge [] [Metta.BindingRel.val binder atom]).head?.getD
                [Metta.BindingRel.val binder atom])).merge
              ([] : Bindings)).head?.getD [])) ∈
      (mettaEval kernelEnv (fuel + 2) st []
        (mExpr "unify" [atom, mVar binder, template, mSym "Empty"])).1 := by
  exact
    mettaEval_embedded_unify_var_success_of_quoted_args
      (env := kernelEnv) (fuel := fuel) (st := st) (binder := binder)
      (atom := atom) (template := template) (final := final) (by rfl)
      (kernelEnv_unify_recursionNeutralPolicy st atom (mVar binder) template
        (mSym "Empty") hPinned)
      hNoErr hAtomNonVar hNoLoop hnotEmpty hRootNotNotReducible hRootNotSelf hFinal
      hFinalNotError

/-- Full-runtime `kernelEnv` lift for embedded `unify` fallback with the stdlib signature facts
discharged.

This is the miss-branch sibling of
`mettaEval_kernelEnv_embedded_unify_var_success_of_quoted_args`, and is the
root executable fact behind `is-bad` on non-`Bad` normalized readouts. -/
theorem mettaEval_kernelEnv_embedded_unify_fallback_of_quoted_args
    (fuel : Nat) (st : St)
    (atom pattern template elseAtom final : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelEnv st.world "unify"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom",
        mSym "%Undefined%"]])
    (hNoErr :
      (([atom, pattern, template, elseAtom].zip
          [atom, pattern, template, elseAtom]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hmatch : Metta.matchAtoms atom pattern = [])
    (hnotEmpty : (elseAtom != emptyA) = true)
    (hRootNotNotReducible : (elseAtom == notReducibleA) = false)
    (hRootNotSelf :
      (elseAtom == mExpr "unify" [atom, pattern, template, elseAtom]) = false)
    (hFinal : ∀ st0,
      (final, []) ∈ (mettaEval kernelEnv (fuel + 1) st0 [] elseAtom).1)
    (hFinalNotError : final.isError = false) :
    (final, []) ∈
      (mettaEval kernelEnv (fuel + 2) st []
        (mExpr "unify" [atom, pattern, template, elseAtom])).1 := by
  have hbase :=
    mettaEval_quaternary_expr_mem_of_quoted_args_and_open_root_eval_member_of_exactPolicy
      (env := kernelEnv) (fuel := fuel + 1) (st := st) (op := "unify")
      (w := atom) (x := pattern) (y := template) (z := elseAtom)
      (root := elseAtom) (final := final) (rootBnd := [])
      (mask := [false, false, false, false]) (returnAtom := false)
      (by decide)
      (kernelEnv_unify_recursionNeutralPolicy st atom pattern template elseAtom hPinned)
      rfl hNoErr
      (interpretFuel_eval_embedded_unify_fallback_contains_of_gt
        (env := kernelEnv) (fuel := fuel) (st := st)
        (atom := atom) (pattern := pattern) (template := template)
        (elseAtom := elseAtom) (by rfl) hmatch hnotEmpty)
      hRootNotNotReducible hRootNotSelf rfl
      (by
        intro st0
        have hbind :
            restrictBnd (atom.vars ++ (pattern.vars ++ (template.vars ++ elseAtom.vars)))
                ((Metta.Bindings.merge [] ([] : Metta.Bindings)).head?.getD []) = [] :=
          restrictBnd_empty_merge_empty _
        simpa [hbind] using hFinal st0)
      hFinalNotError
  simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm, mExpr, mSym,
    restrictBnd_nil_bindings, restrictBnd_empty_merge_empty, Metta.Bindings.merge]
    using hbase

