def kernelDefControlEnv_eq_exactPolicy
    (st : St) (a b : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelDefControlEnv st.world "=="
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Bool"]]) :
    QuotedBoolApplicationPolicy kernelDefControlEnv st.world "==" [a, b] := by
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->" [mSym "Atom", mSym "Atom", mSym "Bool"]
      argumentTypes := [mSym "Atom", mSym "Atom"]
      returnType := mSym "Bool"
      typeBindings := [] }
  have hSelected :
      selectFunctionType kernelDefControlEnv st.world (.sym "==") [a, b] =
        .selected selected := by
    have hCheck : typeCheckArgsOutcome kernelDefControlEnv st.world
        [.sym "Atom", .sym "Atom"] 0 [] [a, b] = .success [] := by
      simpa [mSym] using typeCheckArgsOutcome_two_atoms kernelDefControlEnv st.world a b
    simpa [selected, mExpr, mSym] using
      (selectFunctionType_singleton_arrow_selected_of_outcome
        kernelDefControlEnv st.world "==" [a, b] [.sym "Atom", .sym "Atom"]
        (.sym "Bool") [] hPinned (by simp) hCheck)
  have hMask : argMask selected 2 = [false, false] := by
    simp only [selected, argMask, Metta.instantiate_nil, mSym]
    decide
  have hReturns : returnsAtom selected = false := by
    simp only [selected, returnsAtom, Metta.instantiate_nil, mSym]
    decide
  refine
    { decision := .selected selected hSelected
      selected_eq := ?_
      argumentPolicies_eq := ?_
      returnIsAtom_eq := ?_
      resultExpected_eq := ?_ }
  · exact hSelected
  · change argumentEvaluationPolicies selected 2 =
      [(false, .sym "Atom"), (false, .sym "Atom")]
    simp [selected, argumentEvaluationPolicies, Metta.instantiate_nil, mSym]
    rfl
  · exact hReturns
  · change selectedResultExpected selected = .sym "Bool"
    simp [selected, selectedResultExpected, Metta.instantiate_nil, mSym]
    rfl

