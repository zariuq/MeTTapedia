def mSym (s : String) : Metta.Atom :=
  Metta.Atom.sym s

def mVar (s : String) : Metta.Atom :=
  Metta.Atom.var s

/-- Bare MeTTa variables compare equal to themselves under LeaTTa's structural `BEq`.
This stays on the variable fragment and does not assume global lawful equality for all atoms. -/
theorem atom_var_beq_self_true (v : String) :
    (Metta.Atom.var v == Metta.Atom.var v) = true := by
  change Metta.Atom.beq (Metta.Atom.var v) (Metta.Atom.var v) = true
  simp [Metta.Atom.beq]

theorem bindingValueKeys_append (a b : Metta.Bindings) :
    bindingValueKeys (a ++ b) = bindingValueKeys a ++ bindingValueKeys b := by
  induction a with
  | nil =>
      simp [bindingValueKeys]
  | cons r rest ih =>
      cases r <;> simp [bindingValueKeys, ih]

theorem mem_bindingValueKeys_iff_exists_val :
    ∀ {b : Metta.Bindings} {x : Metta.VarName},
      x ∈ bindingValueKeys b ↔ ∃ a, Metta.BindingRel.val x a ∈ b := by
  intro b
  induction b with
  | nil =>
      intro x
      simp [bindingValueKeys]
  | cons r rest ih =>
      intro x
      cases r with
      | val y a =>
          constructor
          · intro hx
            simp [bindingValueKeys] at hx
            rcases hx with hxy | hxrest
            · subst x
              exact ⟨a, by simp⟩
            · rcases (ih.mp hxrest) with ⟨a0, ha0⟩
              exact ⟨a0, by simp [ha0]⟩
          · intro h
            rcases h with ⟨a0, ha0⟩
            simp [bindingValueKeys] at ha0 ⊢
            rcases ha0 with ha0 | ha0
            · exact Or.inl ha0.1
            · exact Or.inr (ih.mpr ⟨a0, ha0⟩)
      | eq y z =>
          constructor
          · intro hx
            simp [bindingValueKeys] at hx
            rcases (ih.mp hx) with ⟨a0, ha0⟩
            exact ⟨a0, by simp [ha0]⟩
          · intro h
            rcases h with ⟨a0, ha0⟩
            simp [bindingValueKeys] at ha0 ⊢
            exact ih.mpr ⟨a0, ha0⟩

private theorem bindingValueKeys_filter_eq_only_empty
    (p : Metta.VarName → Metta.VarName → Bool) :
    ∀ b : Metta.Bindings,
      bindingValueKeys
        (b.filter
          (fun r =>
            match r with
            | Metta.BindingRel.eq x y => p x y
            | _ => false)) = [] := by
  intro b
  apply List.eq_nil_iff_forall_not_mem.mpr
  intro x hx
  rcases (mem_bindingValueKeys_iff_exists_val.mp hx) with ⟨a, ha⟩
  rw [List.mem_filter] at ha
  rcases ha with ⟨_hval, hp⟩
  simp at hp

private theorem bindingValueKeys_filterMap_restrict_subset
    (vars : List Metta.VarName) (b : Metta.Bindings) :
    ∀ x,
      x ∈
        bindingValueKeys
          (vars.filterMap
            (fun v =>
              have val :=
                resolveAtom b (b.length + 1) (Metta.Atom.var v)
              if (val == Metta.Atom.var v) = true then
                none
              else
                some (Metta.BindingRel.val v val))) →
        x ∈ vars := by
  intro x hx
  rcases (mem_bindingValueKeys_iff_exists_val.mp hx) with ⟨a, ha⟩
  rw [List.mem_filterMap] at ha
  rcases ha with ⟨v, hv, hsome⟩
  by_cases hsame :
      (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
        Metta.Atom.var v) = true
  · simp [hsame] at hsome
  · simp [hsame] at hsome
    have hxv : x = v := hsome.1.symm
    subst x
    exact hv

theorem bindingValueKeys_restrictBnd_subset
    (vars : List Metta.VarName) (b : Metta.Bindings) :
    ∀ x, x ∈ bindingValueKeys (restrictBnd vars b) → x ∈ vars := by
  intro x hx
  unfold restrictBnd at hx
  rw [bindingValueKeys_append] at hx
  rcases List.mem_append.mp hx with hsolved | heqs
  · exact bindingValueKeys_filterMap_restrict_subset vars b x hsolved
  · have heq :
        bindingValueKeys
            (List.filter
              (fun r =>
                match r with
                | Metta.BindingRel.eq x y =>
                    vars.contains x && vars.contains y
                | _ => false)
              b) = [] := by
      exact
        bindingValueKeys_filter_eq_only_empty
          (fun x y => vars.contains x && vars.contains y) b
    have hnot :
        x ∉
          bindingValueKeys
            (List.filter
              (fun r =>
                match r with
                | Metta.BindingRel.eq x y =>
                    vars.contains x && vars.contains y
                | _ => false)
              b) := by
      rw [heq]
      simp
    exact False.elim (hnot heqs)

theorem bindingValueKeys_tail_unify_restrictBnd_keys
    (binder : String) (ny template : Metta.Atom) (b : Metta.Bindings)
    (hNy : ny.vars = []) (hTemplate : template.vars = []) :
    ∀ x,
      x ∈
        bindingValueKeys
          (restrictBnd
            (([ny, mVar binder, template, mSym "Empty"]).flatMap
              Metta.Atom.vars) b) →
        x = binder := by
  intro x hx
  have hxVars :
      x ∈
        (([ny, mVar binder, template, mSym "Empty"]).flatMap
        Metta.Atom.vars) :=
    bindingValueKeys_restrictBnd_subset _ _ x hx
  simpa [hNy, hTemplate, mVar, mSym, Metta.Atom.vars] using hxVars

theorem bindingValueKeys_tail_unify_restrictBnd_keys_of_template_vars
    (binder : String) (ny template : Metta.Atom) (b : Metta.Bindings)
    (hNy : ny.vars = [])
    (hTemplate : ∀ x, x ∈ template.vars → x = binder) :
    ∀ x,
      x ∈
        bindingValueKeys
          (restrictBnd
            (([ny, mVar binder, template, mSym "Empty"]).flatMap
              Metta.Atom.vars) b) →
        x = binder := by
  intro x hx
  have hxVars :
      x ∈
        (([ny, mVar binder, template, mSym "Empty"]).flatMap
          Metta.Atom.vars) :=
    bindingValueKeys_restrictBnd_subset _ _ x hx
  simp [hNy, mVar, mSym, Metta.Atom.vars] at hxVars
  rcases hxVars with hBinder | hTemplateMem
  · exact hBinder
  · exact hTemplate x hTemplateMem

theorem resolveAtom_of_vars_nil (b : Metta.Bindings) :
    ∀ (n : Nat) (a : Metta.Atom),
      a.vars = [] → resolveAtom b n a = a := by
  intro n
  induction n with
  | zero =>
      intro a _hvars
      rfl
  | succ n ih =>
      intro a hvars
      have hinst : Metta.instantiate b a = a :=
        instantiate_eq_self_of_vars_nil b hvars
      unfold resolveAtom
      rw [hinst]
      by_cases hbeq : (a == a) = true
      · simp [hbeq]
      · simp [hbeq, ih a hvars]

theorem instantiate_var_vars_nil_of_beq_false
    {b : Metta.Bindings} (hclosed : ClosedValueBindings b)
    (x : Metta.VarName)
    (hbeq :
      (Metta.instantiate b (Metta.Atom.var x) == Metta.Atom.var x) =
        false) :
    (Metta.instantiate b (Metta.Atom.var x)).vars = [] := by
  cases hlook : Metta.Bindings.lookupVal b x with
  | none =>
      have hinst :
          Metta.instantiate b (Metta.Atom.var x) = Metta.Atom.var x := by
        simp [Metta.instantiate, Metta.Subst.apply,
          lookup_bindingsToSubst, hlook]
      rw [hinst] at hbeq
      rw [atom_var_beq_self_true x] at hbeq
      cases hbeq
  | some value =>
      have hvalueClosed : value.vars = [] :=
        lookupVal_closed_value hclosed hlook
      simpa [Metta.instantiate, Metta.Subst.apply,
        lookup_bindingsToSubst, hlook] using hvalueClosed

theorem resolveAtom_var_vars_nil_of_beq_false
    {b : Metta.Bindings} (hclosed : ClosedValueBindings b)
    (n : Nat) (x : Metta.VarName)
    (hbeq :
      (resolveAtom b n (Metta.Atom.var x) == Metta.Atom.var x) =
        false) :
    (resolveAtom b n (Metta.Atom.var x)).vars = [] := by
  cases n with
  | zero =>
      simp [resolveAtom] at hbeq
      rw [atom_var_beq_self_true x] at hbeq
      cases hbeq
  | succ n =>
      unfold resolveAtom at hbeq ⊢
      by_cases hinstBeq :
          (Metta.instantiate b (Metta.Atom.var x) ==
            Metta.Atom.var x) = true
      · simp [hinstBeq] at hbeq ⊢
        rw [atom_var_beq_self_true x] at hbeq
        cases hbeq
      · have hinstFalse :
            (Metta.instantiate b (Metta.Atom.var x) ==
              Metta.Atom.var x) = false := by
          cases h :
              (Metta.instantiate b (Metta.Atom.var x) ==
                Metta.Atom.var x) <;> simp [h] at hinstBeq ⊢
        simp [hinstFalse] at hbeq ⊢
        have hinstClosed :
            (Metta.instantiate b (Metta.Atom.var x)).vars = [] :=
          instantiate_var_vars_nil_of_beq_false hclosed x hinstFalse
        rw [
          resolveAtom_of_vars_nil b n
            (Metta.instantiate b (Metta.Atom.var x)) hinstClosed]
        exact hinstClosed

private theorem closedValueBindings_filterMap_restrict_of_resolve_closed
    (vars : List Metta.VarName) (b : Metta.Bindings)
    (hclosedResolved :
      ∀ v, v ∈ vars →
        (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
          Metta.Atom.var v) = false →
        (resolveAtom b (b.length + 1) (Metta.Atom.var v)).vars = []) :
    ClosedValueBindings
      (vars.filterMap
        (fun v =>
          have val := resolveAtom b (b.length + 1) (Metta.Atom.var v)
          if (val == Metta.Atom.var v) = true then
            none
          else
            some (Metta.BindingRel.val v val))) := by
  induction vars with
  | nil =>
      simp
      exact ClosedValueBindings.nil
  | cons v vs ih =>
      simp only [List.filterMap_cons]
      by_cases hbeq :
          (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
            Metta.Atom.var v) = true
      · simp [hbeq]
        exact ih (by
          intro w hw
          exact hclosedResolved w (by simp [hw]))
      · have hfalse :
            (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
              Metta.Atom.var v) = false := by
          cases h :
              (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
                Metta.Atom.var v) <;> simp [h] at hbeq ⊢
        simp [hfalse]
        exact
          ClosedValueBindings.val
            (hclosedResolved v (by simp) hfalse)
            (ih (by
              intro w hw
              exact hclosedResolved w (by simp [hw])))

theorem closedValueBindings_restrictBnd_of_resolve_closed
    {vars : List Metta.VarName} {b : Metta.Bindings}
    (hEqFilter :
      List.filter
          (fun r =>
            match r with
            | Metta.BindingRel.eq x y =>
                vars.contains x && vars.contains y
            | _ => false)
          b = [])
    (hclosedResolved :
      ∀ v, v ∈ vars →
        (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
          Metta.Atom.var v) = false →
        (resolveAtom b (b.length + 1) (Metta.Atom.var v)).vars = []) :
    ClosedValueBindings (restrictBnd vars b) := by
  unfold restrictBnd
  change
    ClosedValueBindings
      (List.filterMap
          (fun x =>
            have v := resolveAtom b (List.length b + 1) (Metta.Atom.var x)
            if (v == Metta.Atom.var x) = true then
              none
            else
              some (Metta.BindingRel.val x v))
          vars ++
        List.filter
          (fun r =>
            match r with
            | Metta.BindingRel.eq x y =>
                vars.contains x && vars.contains y
            | _ => false)
          b)
  have hsolved :=
    closedValueBindings_filterMap_restrict_of_resolve_closed
      vars b hclosedResolved
  rw [hEqFilter]
  exact ClosedValueBindings.append hsolved ClosedValueBindings.nil

theorem closedValueBindings_tail_unify_restrictBnd_of_resolve_binder_closed
    (binder : String) (ny template : Metta.Atom) (b : Metta.Bindings)
    (hEqFilter :
      List.filter
          (fun r =>
            match r with
            | Metta.BindingRel.eq x y =>
                ((([ny, mVar binder, template, mSym "Empty"]).flatMap
                      Metta.Atom.vars).contains x) &&
                  ((([ny, mVar binder, template, mSym "Empty"]).flatMap
                      Metta.Atom.vars).contains y)
            | _ => false)
          b = [])
    (hNy : ny.vars = [])
    (hTemplate : ∀ x, x ∈ template.vars → x = binder)
    (hResolveBinder :
      (resolveAtom b (b.length + 1) (Metta.Atom.var binder) ==
        Metta.Atom.var binder) = false →
      (resolveAtom b (b.length + 1) (Metta.Atom.var binder)).vars = []) :
    ClosedValueBindings
      (restrictBnd
        (([ny, mVar binder, template, mSym "Empty"]).flatMap
          Metta.Atom.vars) b) := by
  apply closedValueBindings_restrictBnd_of_resolve_closed hEqFilter
  intro x hx hneq
  have hxEq : x = binder := by
    simp [hNy, mVar, mSym, Metta.Atom.vars] at hx
    rcases hx with hBinder | hTemplateMem
    · exact hBinder
    · exact hTemplate x hTemplateMem
  subst x
  exact hResolveBinder hneq

private theorem closedValueBindings_filterMap_restrict
    (vars : List Metta.VarName) {b : Metta.Bindings}
    (hclosed : ClosedValueBindings b) :
    ClosedValueBindings
      (vars.filterMap
        (fun v =>
          have val := resolveAtom b (b.length + 1) (Metta.Atom.var v)
          if (val == Metta.Atom.var v) = true then
            none
          else
            some (Metta.BindingRel.val v val))) := by
  induction vars with
  | nil =>
      simp
      exact ClosedValueBindings.nil
  | cons v vs ih =>
      simp only [List.filterMap_cons]
      by_cases hbeq :
          (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
            Metta.Atom.var v) = true
      · simp [hbeq]
        exact ih
      · have hfalse :
            (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
              Metta.Atom.var v) = false := by
          cases h :
              (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
                Metta.Atom.var v) <;> simp [h] at hbeq ⊢
        simp [hfalse]
        exact
          ClosedValueBindings.val
            (resolveAtom_var_vars_nil_of_beq_false hclosed
              (b.length + 1) v hfalse)
            ih

private theorem closedValueBindings_filter_eq_only_empty
    (p : Metta.VarName → Metta.VarName → Bool) :
    ∀ {b : Metta.Bindings}, ClosedValueBindings b →
      b.filter
        (fun r =>
          match r with
          | Metta.BindingRel.eq x y => p x y
          | _ => false) = []
  | [], ClosedValueBindings.nil => by
      simp
  | Metta.BindingRel.val _x _a :: rest,
      ClosedValueBindings.val _ha hrest => by
      simpa using closedValueBindings_filter_eq_only_empty p hrest

private theorem valueBindings_filter_eq_only_empty
    (p : Metta.VarName → Metta.VarName → Bool) :
    ∀ {b : Metta.Bindings}, ValueBindings b →
      b.filter
        (fun r =>
          match r with
          | Metta.BindingRel.eq x y => p x y
          | _ => false) = []
  | [], ValueBindings.nil => by
      simp
  | Metta.BindingRel.val _x _a :: rest,
      ValueBindings.val hrest => by
      simpa using valueBindings_filter_eq_only_empty p hrest

theorem valueBindings_append :
    ∀ {a b : Metta.Bindings}, ValueBindings a → ValueBindings b →
      ValueBindings (a ++ b)
  | [], b, ValueBindings.nil, hb => by
      simpa using hb
  | Metta.BindingRel.val _x _atom :: rest, b,
      ValueBindings.val hrest, hb => by
      exact ValueBindings.val (valueBindings_append hrest hb)

theorem valueBindings_reverse :
    ∀ {b : Metta.Bindings}, ValueBindings b → ValueBindings b.reverse
  | [], ValueBindings.nil => by
      exact ValueBindings.nil
  | Metta.BindingRel.val _x _atom :: rest, ValueBindings.val hrest => by
      simpa using
        valueBindings_append (valueBindings_reverse hrest)
          (ValueBindings.val ValueBindings.nil)

private theorem valueBindings_filterMap_restrict
    (vars : List Metta.VarName) (b : Metta.Bindings) :
    ValueBindings
      (vars.filterMap
        (fun v =>
          have val := resolveAtom b (b.length + 1) (Metta.Atom.var v)
          if (val == Metta.Atom.var v) = true then
            none
          else
            some (Metta.BindingRel.val v val))) := by
  induction vars with
  | nil =>
      simp
      exact ValueBindings.nil
  | cons v vs ih =>
      simp only [List.filterMap_cons]
      by_cases hbeq :
          (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
            Metta.Atom.var v) = true
      · simp [hbeq]
        exact ih
      · have hfalse :
            (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
              Metta.Atom.var v) = false := by
          cases h :
              (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
                Metta.Atom.var v) <;> simp [h] at hbeq ⊢
        simp [hfalse]
        exact ValueBindings.val ih

theorem valueBindings_restrictBnd
    {vars : List Metta.VarName} {b : Metta.Bindings}
    (hvalue : ValueBindings b) :
    ValueBindings (restrictBnd vars b) := by
  unfold restrictBnd
  change
    ValueBindings
      (List.filterMap
          (fun x =>
            have v := resolveAtom b (List.length b + 1) (Metta.Atom.var x)
            if (v == Metta.Atom.var x) = true then
              none
            else
              some (Metta.BindingRel.val x v))
          vars ++
        List.filter
          (fun r =>
            match r with
            | Metta.BindingRel.eq x y =>
                vars.contains x && vars.contains y
            | _ => false)
          b)
  have hsolved := valueBindings_filterMap_restrict vars b
  have heqs :
      List.filter
          (fun r =>
            match r with
            | Metta.BindingRel.eq x y =>
                vars.contains x && vars.contains y
            | _ => false)
          b = [] :=
    valueBindings_filter_eq_only_empty
      (fun x y => vars.contains x && vars.contains y) hvalue
  rw [heqs, List.append_nil]
  exact hsolved

theorem closedValueBindings_restrictBnd
    {vars : List Metta.VarName} {b : Metta.Bindings}
    (hclosed : ClosedValueBindings b) :
    ClosedValueBindings (restrictBnd vars b) := by
  unfold restrictBnd
  change
    ClosedValueBindings
      (List.filterMap
          (fun x =>
            have v := resolveAtom b (List.length b + 1) (Metta.Atom.var x)
            if (v == Metta.Atom.var x) = true then
              none
            else
              some (Metta.BindingRel.val x v))
          vars ++
        List.filter
          (fun r =>
            match r with
            | Metta.BindingRel.eq x y =>
                vars.contains x && vars.contains y
            | _ => false)
          b)
  have hsolved := closedValueBindings_filterMap_restrict vars hclosed
  have heqs :
      List.filter
          (fun r =>
            match r with
            | Metta.BindingRel.eq x y =>
                vars.contains x && vars.contains y
            | _ => false)
          b = [] :=
    closedValueBindings_filter_eq_only_empty
      (fun x y => vars.contains x && vars.contains y) hclosed
  rw [heqs, List.append_nil]
  exact hsolved

theorem closedValueBindings_restrictBnd_of_value_resolve_closed
    {vars : List Metta.VarName} {b : Metta.Bindings}
    (hvalue : ValueBindings b)
    (hclosedResolved :
      ∀ v, v ∈ vars →
        (resolveAtom b (b.length + 1) (Metta.Atom.var v) ==
          Metta.Atom.var v) = false →
        (resolveAtom b (b.length + 1) (Metta.Atom.var v)).vars = []) :
    ClosedValueBindings (restrictBnd vars b) := by
  apply closedValueBindings_restrictBnd_of_resolve_closed
  · exact
      valueBindings_filter_eq_only_empty
        (fun x y => vars.contains x && vars.contains y) hvalue
  · exact hclosedResolved

theorem closedValueBindings_tail_unify_restrictBnd_of_value_resolve_binder_closed
    (binder : String) (ny template : Metta.Atom) (b : Metta.Bindings)
    (hvalue : ValueBindings b)
    (hNy : ny.vars = [])
    (hTemplate : ∀ x, x ∈ template.vars → x = binder)
    (hResolveBinder :
      (resolveAtom b (b.length + 1) (Metta.Atom.var binder) ==
        Metta.Atom.var binder) = false →
      (resolveAtom b (b.length + 1) (Metta.Atom.var binder)).vars = []) :
    ClosedValueBindings
      (restrictBnd
        (([ny, mVar binder, template, mSym "Empty"]).flatMap
          Metta.Atom.vars) b) := by
  apply closedValueBindings_tail_unify_restrictBnd_of_resolve_binder_closed
  · exact
      valueBindings_filter_eq_only_empty
        (fun x y =>
          ((([ny, mVar binder, template, mSym "Empty"]).flatMap
                Metta.Atom.vars).contains x) &&
            ((([ny, mVar binder, template, mSym "Empty"]).flatMap
                Metta.Atom.vars).contains y))
        hvalue
  · exact hNy
  · exact hTemplate
  · exact hResolveBinder

theorem valueBindings_merge_empty_head_getD_of_value
    {b : Metta.Bindings} (hvalue : ValueBindings b) :
    ValueBindings ((Metta.Bindings.merge [] b).head?.getD b) := by
  cases hmerge : Metta.Bindings.merge [] b with
  | nil =>
      simpa [hmerge] using hvalue
  | cons out outs =>
      have hout : out ∈ Metta.Bindings.merge [] b := by
        rw [hmerge]
        simp
      have houtValue : ValueBindings out :=
        merge_value_value_mem ValueBindings.nil hvalue hout
      simpa [hmerge] using houtValue

theorem valueBindings_of_merge_singleton_val_eq
    {b rootBnd : Metta.Bindings} {binder : String} {value : Metta.Atom}
    (hvalue : ValueBindings b)
    (hmerge :
      Metta.Bindings.merge b [Metta.BindingRel.val binder value] =
        [rootBnd]) :
    ValueBindings rootBnd := by
  have hmem :
      rootBnd ∈
        Metta.Bindings.merge b [Metta.BindingRel.val binder value] := by
    rw [hmerge]
    simp
  exact
    merge_value_value_mem hvalue
      (ValueBindings.val ValueBindings.nil) hmem

theorem closedValueBindings_of_merge_singleton_val_eq
    {b rootBnd : Metta.Bindings} {binder : String} {value : Metta.Atom}
    (hclosed : ClosedValueBindings b)
    (hValueClosed : value.vars = [])
    (hmerge :
      Metta.Bindings.merge b [Metta.BindingRel.val binder value] =
        [rootBnd]) :
    ClosedValueBindings rootBnd := by
  have hmem :
      rootBnd ∈
        Metta.Bindings.merge b [Metta.BindingRel.val binder value] := by
    rw [hmerge]
    simp
  exact
    merge_closed_closed_mem hclosed
      (ClosedValueBindings.val hValueClosed ClosedValueBindings.nil) hmem

theorem closedValueBindings_merge_empty_head_getD_of_closed
    {b : Metta.Bindings} (hclosed : ClosedValueBindings b) :
    ClosedValueBindings ((Metta.Bindings.merge [] b).head?.getD b) := by
  cases hmerge : Metta.Bindings.merge [] b with
  | nil =>
      simpa [hmerge] using hclosed
  | cons out outs =>
      have hout : out ∈ Metta.Bindings.merge [] b := by
        rw [hmerge]
        simp
      have houtClosed : ClosedValueBindings out :=
        merge_closed_closed_mem ClosedValueBindings.nil hclosed hout
      simpa [hmerge] using houtClosed

theorem tail_unify_restrictBnd_keyed_ambient_of_closed_merge_empty
    (binder : String) (ny template : Metta.Atom) (b : Metta.Bindings)
    (st : St)
    (hclosed : ClosedValueBindings b)
    (hNy : ny.vars = [])
    (hTemplate : ∀ x, x ∈ template.vars → x = binder)
    (hFresh :
      ∀ {v : String}, v = "e" ∨ v = "t" →
        counterSuffix (st.counter + 2) v ≠ binder) :
    ∃ binder',
      ClosedValueBindings
        (restrictBnd
          (([ny, mVar binder, template, mSym "Empty"]).flatMap
            Metta.Atom.vars)
          ((Metta.Bindings.merge [] b).head?.getD b)) ∧
      (∀ x,
        x ∈
          bindingValueKeys
            (restrictBnd
              (([ny, mVar binder, template, mSym "Empty"]).flatMap
                Metta.Atom.vars)
              ((Metta.Bindings.merge [] b).head?.getD b)) →
        x = binder') ∧
      (∀ {v : String}, v = "e" ∨ v = "t" →
        counterSuffix (st.counter + 2) v ≠ binder') := by
  refine ⟨binder, ?_, ?_, ?_⟩
  · exact
      closedValueBindings_restrictBnd
        (closedValueBindings_merge_empty_head_getD_of_closed hclosed)
  · exact
      bindingValueKeys_tail_unify_restrictBnd_keys_of_template_vars
        binder ny template ((Metta.Bindings.merge [] b).head?.getD b)
        hNy hTemplate
  · exact hFresh

theorem tail_unify_restrictBnd_keyed_ambient_of_value_merge_empty
    (binder : String) (ny template : Metta.Atom) (b : Metta.Bindings)
    (st : St)
    (hvalue : ValueBindings b)
    (hNy : ny.vars = [])
    (hTemplate : ∀ x, x ∈ template.vars → x = binder)
    (hResolveBinder :
      (resolveAtom ((Metta.Bindings.merge [] b).head?.getD b)
          (((Metta.Bindings.merge [] b).head?.getD b).length + 1)
          (Metta.Atom.var binder) ==
        Metta.Atom.var binder) = false →
        (resolveAtom ((Metta.Bindings.merge [] b).head?.getD b)
          (((Metta.Bindings.merge [] b).head?.getD b).length + 1)
          (Metta.Atom.var binder)).vars = [])
    (hFresh :
      ∀ {v : String}, v = "e" ∨ v = "t" →
        counterSuffix (st.counter + 2) v ≠ binder) :
    ∃ binder',
      ClosedValueBindings
        (restrictBnd
          (([ny, mVar binder, template, mSym "Empty"]).flatMap
            Metta.Atom.vars)
          ((Metta.Bindings.merge [] b).head?.getD b)) ∧
      (∀ x,
        x ∈
          bindingValueKeys
            (restrictBnd
              (([ny, mVar binder, template, mSym "Empty"]).flatMap
                Metta.Atom.vars)
              ((Metta.Bindings.merge [] b).head?.getD b)) →
        x = binder') ∧
      (∀ {v : String}, v = "e" ∨ v = "t" →
        counterSuffix (st.counter + 2) v ≠ binder') := by
  refine ⟨binder, ?_, ?_, ?_⟩
  · exact
      closedValueBindings_tail_unify_restrictBnd_of_value_resolve_binder_closed
        binder ny template ((Metta.Bindings.merge [] b).head?.getD b)
        (valueBindings_merge_empty_head_getD_of_value hvalue)
        hNy hTemplate hResolveBinder
  · exact
      bindingValueKeys_tail_unify_restrictBnd_keys_of_template_vars
        binder ny template ((Metta.Bindings.merge [] b).head?.getD b)
        hNy hTemplate
  · exact hFresh

def mExpr (head : String) (args : List Metta.Atom) : Metta.Atom :=
  Metta.Atom.expr (mSym head :: args)

def mTypeDecl (name : String) (argsAndResult : List Metta.Atom) : Metta.Atom :=
  Metta.Atom.expr [mSym ":", mSym name, Metta.Atom.expr (mSym "->" :: argsAndResult)]

def mBool (b : Bool) : Metta.Atom :=
  Metta.Atom.gnd (Metta.Ground.bool b)

def mNat (n : Nat) : Metta.Atom :=
  Metta.Atom.gnd (Metta.Ground.int (Int.ofNat n))

def declNameAtom
    (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
    Metta.Atom :=
  mSym (Lean.Name.toString (show Lean.Name from name) false)

def sortAtom : DIndGArtifactSort → Metta.Atom
  | .type => mSym "type"
  | .kind => mSym "kind"

mutual
  def termAtom : DIndGArtifactTerm → Metta.Atom
    | .var index => mExpr "Var" [mNat index]
    | .srt sort => mExpr "Srt" [sortAtom sort]
    | .con name => mExpr "Con" [declNameAtom name]
    | .defn name => mExpr "Def" [declNameAtom name]
    | .pi domain body => mExpr "Pi" [termAtom domain, termAtom body]
    | .lam domain body => mExpr "Lam" [termAtom domain, termAtom body]
    | .app fn arg => mExpr "App" [termAtom fn, termAtom arg]
    | .indG familyName params motive cases indices scrutinee =>
        mExpr "IndG"
          [ declNameAtom familyName
          , argsAtom params
          , termAtom motive
          , casesAtom cases
          , argsAtom indices
          , termAtom scrutinee ]
    | .bad reason => mExpr "Bad" [mSym reason]
  termination_by term => sizeOf term

  def telAtom : DIndGArtifactTel → Metta.Atom
    | [] => mSym "TNil"
    | ty :: rest => mExpr "TCons" [termAtom ty, telAtom rest]
  termination_by tel => sizeOf tel

  def argsAtom : DIndGArtifactArgs → Metta.Atom
    | [] => mSym "ArgsNil"
    | arg :: rest => mExpr "ArgsCons" [termAtom arg, argsAtom rest]
  termination_by args => sizeOf args

  def caseAtom :
      Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName ×
        DIndGArtifactTerm → Metta.Atom
    | (name, body) => mExpr "Case" [declNameAtom name, termAtom body]
  termination_by c => sizeOf c

  def casesAtom :
      List (Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName ×
        DIndGArtifactTerm) → Metta.Atom
    | [] => mSym "CasesNil"
    | c :: rest => mExpr "Cases" [caseAtom c, casesAtom rest]
  termination_by cases => sizeOf cases

  def ctorAtom (ctor : DIndGArtifactCtor) : Metta.Atom :=
    mExpr "GCtor" [declNameAtom ctor.name, telAtom ctor.argTel, argsAtom ctor.resultIdx]

  def ctorsAtom : List DIndGArtifactCtor → Metta.Atom
    | [] => mSym "GCNil"
    | ctor :: rest => mExpr "GCtors" [ctorAtom ctor, ctorsAtom rest]
  termination_by ctors => sizeOf ctors
decreasing_by
  all_goals
    simp_wf
    try omega
end

def declAtom : DIndGArtifactDecl → Metta.Atom
  | .dconst name ty => mExpr "DConst" [declNameAtom name, termAtom ty]
  | .ddef name ty body => mExpr "DDef" [declNameAtom name, termAtom ty, termAtom body]
  | .daxiom name ty => mExpr "DAxiom" [declNameAtom name, termAtom ty]
  | .dindg familyName paramTel indexTel ctors =>
      mExpr "DIndG"
        [declNameAtom familyName, telAtom paramTel, telAtom indexTel, ctorsAtom ctors]

def sigAtom (sig : DIndGArtifactSig) : Metta.Atom :=
  sig.decls.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest]) (mSym "SNil")

/- Encoded artifact terms contain no MeTTa query variables. -/
mutual
  theorem termAtom_vars_nil : ∀ raw : DIndGArtifactTerm, (termAtom raw).vars = []
    | .var index => by simp [termAtom, mExpr, mSym, mNat, Metta.Atom.vars]
    | .srt sort => by cases sort <;> simp [termAtom, sortAtom, mExpr, mSym, Metta.Atom.vars]
    | .con name => by simp [termAtom, declNameAtom, mExpr, mSym, Metta.Atom.vars]
    | .defn name => by simp [termAtom, declNameAtom, mExpr, mSym, Metta.Atom.vars]
    | .pi domain body => by
        simp [termAtom, mExpr, mSym, Metta.Atom.vars,
          termAtom_vars_nil domain, termAtom_vars_nil body]
    | .lam domain body => by
        simp [termAtom, mExpr, mSym, Metta.Atom.vars,
          termAtom_vars_nil domain, termAtom_vars_nil body]
    | .app fn arg => by
        simp [termAtom, mExpr, mSym, Metta.Atom.vars,
          termAtom_vars_nil fn, termAtom_vars_nil arg]
    | .indG familyName params motive cases indices scrutinee => by
        simp [termAtom, mExpr, mSym, declNameAtom, Metta.Atom.vars,
          argsAtom_vars_nil params, termAtom_vars_nil motive, casesAtom_vars_nil cases,
          argsAtom_vars_nil indices, termAtom_vars_nil scrutinee]
    | .bad reason => by simp [termAtom, mExpr, mSym, Metta.Atom.vars]

  theorem argsAtom_vars_nil : ∀ args : List DIndGArtifactTerm, (argsAtom args).vars = []
    | [] => by simp [argsAtom, mSym, Metta.Atom.vars]
    | arg :: rest => by
        simp [argsAtom, mExpr, mSym, Metta.Atom.vars,
          termAtom_vars_nil arg, argsAtom_vars_nil rest]

  theorem caseAtom_vars_nil :
      ∀ c : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName × DIndGArtifactTerm,
        (caseAtom c).vars = []
    | (name, body) => by
        simp [caseAtom, declNameAtom, mExpr, mSym, Metta.Atom.vars, termAtom_vars_nil body]

  theorem casesAtom_vars_nil :
      ∀ cs : List (Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName × DIndGArtifactTerm),
        (casesAtom cs).vars = []
    | [] => by simp [casesAtom, mSym, Metta.Atom.vars]
    | c :: rest => by
        simp [casesAtom, mExpr, mSym, Metta.Atom.vars,
          caseAtom_vars_nil c, casesAtom_vars_nil rest]
end

/-- Encoded artifact telescopes contain no MeTTa query variables. -/
theorem telAtom_vars_nil : ∀ tel : DIndGArtifactTel, (telAtom tel).vars = []
  | [] => by simp [telAtom, mSym, Metta.Atom.vars]
  | ty :: rest => by
      simp [telAtom, mExpr, mSym, Metta.Atom.vars, termAtom_vars_nil ty, telAtom_vars_nil rest]

/-- Encoded artifact constructors contain no MeTTa query variables. -/
theorem ctorAtom_vars_nil (ctor : DIndGArtifactCtor) : (ctorAtom ctor).vars = [] := by
  cases ctor
  simp [ctorAtom, declNameAtom, mExpr, mSym, Metta.Atom.vars,
    telAtom_vars_nil, argsAtom_vars_nil]

/-- Encoded constructor lists contain no MeTTa query variables. -/
theorem ctorsAtom_vars_nil : ∀ ctors : List DIndGArtifactCtor, (ctorsAtom ctors).vars = []
  | [] => by simp [ctorsAtom, mSym, Metta.Atom.vars]
  | ctor :: rest => by
      simp [ctorsAtom, mExpr, mSym, Metta.Atom.vars,
        ctorAtom_vars_nil ctor, ctorsAtom_vars_nil rest]

/-- Encoded artifact declarations contain no MeTTa query variables. -/
theorem declAtom_vars_nil : ∀ decl : DIndGArtifactDecl, (declAtom decl).vars = []
  | .dconst name ty => by
      simp [declAtom, declNameAtom, mExpr, mSym, Metta.Atom.vars, termAtom_vars_nil ty]
  | .ddef name ty body => by
      simp [declAtom, declNameAtom, mExpr, mSym, Metta.Atom.vars,
        termAtom_vars_nil ty, termAtom_vars_nil body]
  | .daxiom name ty => by
      simp [declAtom, declNameAtom, mExpr, mSym, Metta.Atom.vars, termAtom_vars_nil ty]
  | .dindg familyName paramTel indexTel ctors => by
      simp [declAtom, declNameAtom, mExpr, mSym, Metta.Atom.vars,
        telAtom_vars_nil paramTel, telAtom_vars_nil indexTel, ctorsAtom_vars_nil ctors]

/-- Encoded signature declaration lists contain no MeTTa query variables. -/
theorem declAtoms_vars_nil : ∀ decls : List DIndGArtifactDecl,
    (decls.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest]) (mSym "SNil")).vars = []
  | [] => by simp [mSym, Metta.Atom.vars]
  | decl :: rest => by
      simp only [List.foldr_cons]
      change (Metta.Atom.expr [Metta.Atom.sym "SCons", declAtom decl,
        rest.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest]) (mSym "SNil")]).vars = []
      simp [Metta.Atom.vars, declAtom_vars_nil decl, declAtoms_vars_nil rest]

/-- Encoded artifact signatures contain no MeTTa query variables. -/
theorem sigAtom_vars_nil (sig : DIndGArtifactSig) : (sigAtom sig).vars = [] := by
  rcases sig with ⟨decls, _, _, _⟩
  simpa [sigAtom] using declAtoms_vars_nil decls

/-- Encoded artifact signatures are data, not LeaTTa runtime error atoms. -/
theorem sigAtom_isError_false (sig : DIndGArtifactSig) : (sigAtom sig).isError = false := by
  rcases sig with ⟨decls, _, _, _⟩
  induction decls with
  | nil => simp [sigAtom, mSym, Metta.Atom.isError]
  | cons decl decls ih => simp [sigAtom, mExpr, mSym, Metta.Atom.isError]

/-- Encoded artifact terms are data, not LeaTTa runtime error atoms. -/
theorem termAtom_isError_false (raw : DIndGArtifactTerm) : (termAtom raw).isError = false := by
  cases raw <;> simp [termAtom, mExpr, mSym, Metta.Atom.isError]

/- Encoded artifact terms are inert under state dereferencing in the initial empty world. -/
mutual
  theorem termAtom_resolveStates_init_world : ∀ raw : DIndGArtifactTerm,
      resolveStates St.init.world (termAtom raw) = termAtom raw
    | .var index => by simp [termAtom, mExpr, mSym, mNat, resolveStates]
    | .srt sort => by cases sort <;> simp [termAtom, sortAtom, mExpr, mSym, resolveStates]
    | .con name => by simp [termAtom, declNameAtom, mExpr, mSym, resolveStates]
    | .defn name => by simp [termAtom, declNameAtom, mExpr, mSym, resolveStates]
    | .pi domain body => by
        simp [termAtom, mExpr, mSym, resolveStates]
        constructor
        · simpa [St.init, World.empty] using termAtom_resolveStates_init_world domain
        · simpa [St.init, World.empty] using termAtom_resolveStates_init_world body
    | .lam domain body => by
        simp [termAtom, mExpr, mSym, resolveStates]
        constructor
        · simpa [St.init, World.empty] using termAtom_resolveStates_init_world domain
        · simpa [St.init, World.empty] using termAtom_resolveStates_init_world body
    | .app fn arg => by
        simp [termAtom, mExpr, mSym, resolveStates]
        constructor
        · simpa [St.init, World.empty] using termAtom_resolveStates_init_world fn
        · simpa [St.init, World.empty] using termAtom_resolveStates_init_world arg
    | .indG familyName params motive cases indices scrutinee => by
        simp [termAtom, mExpr, mSym, declNameAtom, resolveStates]
        exact ⟨by simpa [St.init, World.empty] using argsAtom_resolveStates_init_world params,
          by simpa [St.init, World.empty] using termAtom_resolveStates_init_world motive,
          by simpa [St.init, World.empty] using casesAtom_resolveStates_init_world cases,
          by simpa [St.init, World.empty] using argsAtom_resolveStates_init_world indices,
          by simpa [St.init, World.empty] using termAtom_resolveStates_init_world scrutinee⟩
    | .bad reason => by simp [termAtom, mExpr, mSym, resolveStates]

  theorem argsAtom_resolveStates_init_world : ∀ args : List DIndGArtifactTerm,
      resolveStates St.init.world (argsAtom args) = argsAtom args
    | [] => by simp [argsAtom, mSym, resolveStates]
    | arg :: rest => by
        simp [argsAtom, mExpr, mSym, resolveStates]
        constructor
        · simpa [St.init, World.empty] using termAtom_resolveStates_init_world arg
        · simpa [St.init, World.empty] using argsAtom_resolveStates_init_world rest

  theorem caseAtom_resolveStates_init_world :
      ∀ c : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName × DIndGArtifactTerm,
        resolveStates St.init.world (caseAtom c) = caseAtom c
    | (name, body) => by
        simp [caseAtom, declNameAtom, mExpr, mSym, resolveStates]
        simpa [St.init, World.empty] using termAtom_resolveStates_init_world body

  theorem casesAtom_resolveStates_init_world :
      ∀ cs : List (Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName × DIndGArtifactTerm),
        resolveStates St.init.world (casesAtom cs) = casesAtom cs
    | [] => by simp [casesAtom, mSym, resolveStates]
    | c :: rest => by
        simp [casesAtom, mExpr, mSym, resolveStates]
        constructor
        · simpa [St.init, World.empty] using caseAtom_resolveStates_init_world c
        · simpa [St.init, World.empty] using casesAtom_resolveStates_init_world rest
end

/-- Kernel declaration names are encoded as symbols, never runtime error atoms. -/
theorem declNameAtom_isError_false
    (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
    (declNameAtom name).isError = false := by
  simp [declNameAtom, mSym, Metta.Atom.isError]

/-- Encoded declaration names are closed atoms. -/
theorem declNameAtom_vars_nil
    (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
    (declNameAtom name).vars = [] := by
  simp [declNameAtom, mSym, Metta.Atom.vars]

theorem declNameAtom_resolveStates_init_world
    (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
    resolveStates St.init.world (declNameAtom name) = declNameAtom name := by
  simp [declNameAtom, mSym, resolveStates]

/-- Encoded declaration names compare equal to themselves under LeaTTa's grounded `==`. -/
theorem declNameAtom_beq_self_true
    (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
    (declNameAtom name == declNameAtom name) = true := by
  change Metta.Atom.beq (Metta.Atom.sym (Lean.Name.toString name false))
    (Metta.Atom.sym (Lean.Name.toString name false)) = true
  simp [Metta.Atom.beq]

/- Encoded artifact terms compare equal to themselves under LeaTTa's structural `BEq`.
The proof stays on the integer/symbol fragment of grounded payloads; it does not assume lawful
equality for all host-grounded atoms such as floats. -/
mutual
  theorem termAtom_beq_self_true : ∀ raw : DIndGArtifactTerm,
      (termAtom raw == termAtom raw) = true
    | .var index => by
        change Metta.Atom.beq (termAtom (.var index)) (termAtom (.var index)) = true
        simp [termAtom, mExpr, mSym, mNat, Metta.Atom.beq, Metta.Atom.beqList]
        change Metta.instBEqGround.beq (Metta.Ground.int (Int.ofNat index))
          (Metta.Ground.int (Int.ofNat index)) = true
        unfold Metta.instBEqGround.beq
        simp
    | .srt sort => by
        cases sort <;>
          change Metta.Atom.beq (termAtom (.srt _)) (termAtom (.srt _)) = true <;>
          simp [termAtom, sortAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList]
    | .con name => by
        change Metta.Atom.beq (termAtom (.con name)) (termAtom (.con name)) = true
        simp [termAtom, declNameAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList]
    | .defn name => by
        change Metta.Atom.beq (termAtom (.defn name)) (termAtom (.defn name)) = true
        simp [termAtom, declNameAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList]
    | .pi domain body => by
        have hd := termAtom_beq_self_true domain
        have hb := termAtom_beq_self_true body
        change Metta.Atom.beq (termAtom (.pi domain body)) (termAtom (.pi domain body)) = true
        change Metta.Atom.beq (termAtom domain) (termAtom domain) = true at hd
        change Metta.Atom.beq (termAtom body) (termAtom body) = true at hb
        simp [termAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList, hd, hb]
    | .lam domain body => by
        have hd := termAtom_beq_self_true domain
        have hb := termAtom_beq_self_true body
        change Metta.Atom.beq (termAtom (.lam domain body)) (termAtom (.lam domain body)) = true
        change Metta.Atom.beq (termAtom domain) (termAtom domain) = true at hd
        change Metta.Atom.beq (termAtom body) (termAtom body) = true at hb
        simp [termAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList, hd, hb]
    | .app fn arg => by
        have hf := termAtom_beq_self_true fn
        have ha := termAtom_beq_self_true arg
        change Metta.Atom.beq (termAtom (.app fn arg)) (termAtom (.app fn arg)) = true
        change Metta.Atom.beq (termAtom fn) (termAtom fn) = true at hf
        change Metta.Atom.beq (termAtom arg) (termAtom arg) = true at ha
        simp [termAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList, hf, ha]
    | .indG familyName params motive cases indices scrutinee => by
        have hp := argsAtom_beq_self_true params
        have hm := termAtom_beq_self_true motive
        have hc := casesAtom_beq_self_true cases
        have hi := argsAtom_beq_self_true indices
        have hs := termAtom_beq_self_true scrutinee
        change Metta.Atom.beq
          (termAtom (.indG familyName params motive cases indices scrutinee))
          (termAtom (.indG familyName params motive cases indices scrutinee)) = true
        change Metta.Atom.beq (argsAtom params) (argsAtom params) = true at hp
        change Metta.Atom.beq (termAtom motive) (termAtom motive) = true at hm
        change Metta.Atom.beq (casesAtom cases) (casesAtom cases) = true at hc
        change Metta.Atom.beq (argsAtom indices) (argsAtom indices) = true at hi
        change Metta.Atom.beq (termAtom scrutinee) (termAtom scrutinee) = true at hs
        simp [termAtom, mExpr, mSym, declNameAtom, Metta.Atom.beq, Metta.Atom.beqList,
          hp, hm, hc, hi, hs]
    | .bad reason => by
        change Metta.Atom.beq (termAtom (.bad reason)) (termAtom (.bad reason)) = true
        simp [termAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList]

  theorem argsAtom_beq_self_true : ∀ args : List DIndGArtifactTerm,
      (argsAtom args == argsAtom args) = true
    | [] => by
        change Metta.Atom.beq (argsAtom []) (argsAtom []) = true
        simp [argsAtom, mSym, Metta.Atom.beq]
    | arg :: rest => by
        have ha := termAtom_beq_self_true arg
        have hr := argsAtom_beq_self_true rest
        change Metta.Atom.beq (argsAtom (arg :: rest)) (argsAtom (arg :: rest)) = true
        change Metta.Atom.beq (termAtom arg) (termAtom arg) = true at ha
        change Metta.Atom.beq (argsAtom rest) (argsAtom rest) = true at hr
        simp [argsAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList, ha, hr]

  theorem caseAtom_beq_self_true :
      ∀ c : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName × DIndGArtifactTerm,
        (caseAtom c == caseAtom c) = true
    | (name, body) => by
        have hb := termAtom_beq_self_true body
        change Metta.Atom.beq (caseAtom (name, body)) (caseAtom (name, body)) = true
        change Metta.Atom.beq (termAtom body) (termAtom body) = true at hb
        simp [caseAtom, declNameAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList, hb]

  theorem casesAtom_beq_self_true :
      ∀ cs : List (Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName × DIndGArtifactTerm),
        (casesAtom cs == casesAtom cs) = true
    | [] => by
        change Metta.Atom.beq (casesAtom []) (casesAtom []) = true
        simp [casesAtom, mSym, Metta.Atom.beq]
    | c :: rest => by
        have hc := caseAtom_beq_self_true c
        have hr := casesAtom_beq_self_true rest
        change Metta.Atom.beq (casesAtom (c :: rest)) (casesAtom (c :: rest)) = true
        change Metta.Atom.beq (caseAtom c) (caseAtom c) = true at hc
        change Metta.Atom.beq (casesAtom rest) (casesAtom rest) = true at hr
        simp [casesAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList, hc, hr]
end

theorem telAtom_beq_self_true : ∀ tel : DIndGArtifactTel,
    (telAtom tel == telAtom tel) = true
  | [] => by
      change Metta.Atom.beq (telAtom []) (telAtom []) = true
      simp [telAtom, mSym, Metta.Atom.beq]
  | ty :: rest => by
      have hTy := termAtom_beq_self_true ty
      have hRest := telAtom_beq_self_true rest
      change Metta.Atom.beq (telAtom (ty :: rest)) (telAtom (ty :: rest)) = true
      change Metta.Atom.beq (termAtom ty) (termAtom ty) = true at hTy
      change Metta.Atom.beq (telAtom rest) (telAtom rest) = true at hRest
      simp [telAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
        hTy, hRest]

theorem ctorAtom_beq_self_true (ctor : DIndGArtifactCtor) :
    (ctorAtom ctor == ctorAtom ctor) = true := by
  cases ctor with
  | mk name argTel resultIdx =>
      have hName := declNameAtom_beq_self_true name
      have hArg := telAtom_beq_self_true argTel
      have hIdx := argsAtom_beq_self_true resultIdx
      change Metta.Atom.beq
        (ctorAtom { name := name, argTel := argTel, resultIdx := resultIdx })
        (ctorAtom { name := name, argTel := argTel, resultIdx := resultIdx }) = true
      change Metta.Atom.beq (declNameAtom name) (declNameAtom name) = true at hName
      change Metta.Atom.beq (telAtom argTel) (telAtom argTel) = true at hArg
      change Metta.Atom.beq (argsAtom resultIdx) (argsAtom resultIdx) = true at hIdx
      simp [ctorAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
        hName, hArg, hIdx]

theorem ctorsAtom_beq_self_true : ∀ ctors : List DIndGArtifactCtor,
    (ctorsAtom ctors == ctorsAtom ctors) = true
  | [] => by
      change Metta.Atom.beq (ctorsAtom []) (ctorsAtom []) = true
      simp [ctorsAtom, mSym, Metta.Atom.beq]
  | ctor :: rest => by
      have hCtor := ctorAtom_beq_self_true ctor
      have hRest := ctorsAtom_beq_self_true rest
      change Metta.Atom.beq (ctorsAtom (ctor :: rest))
        (ctorsAtom (ctor :: rest)) = true
      change Metta.Atom.beq (ctorAtom ctor) (ctorAtom ctor) = true at hCtor
      change Metta.Atom.beq (ctorsAtom rest) (ctorsAtom rest) = true at hRest
      simp [ctorsAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
        hCtor, hRest]

theorem declAtom_beq_self_true : ∀ decl : DIndGArtifactDecl,
    (declAtom decl == declAtom decl) = true
  | .dconst name ty => by
      have hName := declNameAtom_beq_self_true name
      have hTy := termAtom_beq_self_true ty
      change Metta.Atom.beq (declAtom (.dconst name ty))
        (declAtom (.dconst name ty)) = true
      change Metta.Atom.beq (declNameAtom name) (declNameAtom name) = true at hName
      change Metta.Atom.beq (termAtom ty) (termAtom ty) = true at hTy
      simp [declAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
        hName, hTy]
  | .ddef name ty body => by
      have hName := declNameAtom_beq_self_true name
      have hTy := termAtom_beq_self_true ty
      have hBody := termAtom_beq_self_true body
      change Metta.Atom.beq (declAtom (.ddef name ty body))
        (declAtom (.ddef name ty body)) = true
      change Metta.Atom.beq (declNameAtom name) (declNameAtom name) = true at hName
      change Metta.Atom.beq (termAtom ty) (termAtom ty) = true at hTy
      change Metta.Atom.beq (termAtom body) (termAtom body) = true at hBody
      simp [declAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
        hName, hTy, hBody]
  | .daxiom name ty => by
      have hName := declNameAtom_beq_self_true name
      have hTy := termAtom_beq_self_true ty
      change Metta.Atom.beq (declAtom (.daxiom name ty))
        (declAtom (.daxiom name ty)) = true
      change Metta.Atom.beq (declNameAtom name) (declNameAtom name) = true at hName
      change Metta.Atom.beq (termAtom ty) (termAtom ty) = true at hTy
      simp [declAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
        hName, hTy]
  | .dindg familyName paramTel indexTel ctors => by
      have hFamily := declNameAtom_beq_self_true familyName
      have hParam := telAtom_beq_self_true paramTel
      have hIndex := telAtom_beq_self_true indexTel
      have hCtors := ctorsAtom_beq_self_true ctors
      change Metta.Atom.beq
        (declAtom (.dindg familyName paramTel indexTel ctors))
        (declAtom (.dindg familyName paramTel indexTel ctors)) = true
      change Metta.Atom.beq (declNameAtom familyName)
        (declNameAtom familyName) = true at hFamily
      change Metta.Atom.beq (telAtom paramTel) (telAtom paramTel) = true at hParam
      change Metta.Atom.beq (telAtom indexTel) (telAtom indexTel) = true at hIndex
      change Metta.Atom.beq (ctorsAtom ctors) (ctorsAtom ctors) = true at hCtors
      simp [declAtom, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
        hFamily, hParam, hIndex, hCtors]

theorem declAtoms_beq_self_true : ∀ decls : List DIndGArtifactDecl,
    (decls.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest])
      (mSym "SNil") ==
      decls.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest])
        (mSym "SNil")) = true
  | [] => by
      change Metta.Atom.beq (mSym "SNil") (mSym "SNil") = true
      simp [mSym, Metta.Atom.beq]
  | decl :: rest => by
      have hDecl := declAtom_beq_self_true decl
      have hRest := declAtoms_beq_self_true rest
      change Metta.Atom.beq
        (mExpr "SCons"
          [declAtom decl,
            rest.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest])
              (mSym "SNil")])
        (mExpr "SCons"
          [declAtom decl,
            rest.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest])
              (mSym "SNil")]) = true
      change Metta.Atom.beq (declAtom decl) (declAtom decl) = true at hDecl
      change Metta.Atom.beq
        (rest.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest])
          (mSym "SNil"))
        (rest.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest])
          (mSym "SNil")) = true at hRest
      simpa [mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList, hDecl]
        using hRest

theorem sigAtom_beq_self_true (sig : DIndGArtifactSig) :
    (sigAtom sig == sigAtom sig) = true := by
  rcases sig with ⟨decls, _, _, _⟩
  simpa [sigAtom] using declAtoms_beq_self_true decls

theorem telAtom_resolveStates_init_world : ∀ tel : DIndGArtifactTel,
    resolveStates St.init.world (telAtom tel) = telAtom tel
  | [] => by simp [telAtom, mSym, resolveStates]
  | ty :: rest => by
      simp [telAtom, mExpr, mSym, resolveStates]
      constructor
      · simpa [St.init, World.empty] using termAtom_resolveStates_init_world ty
      · simpa [St.init, World.empty] using telAtom_resolveStates_init_world rest

theorem ctorAtom_resolveStates_init_world (ctor : DIndGArtifactCtor) :
    resolveStates St.init.world (ctorAtom ctor) = ctorAtom ctor := by
  cases ctor with
  | mk name argTel resultIdx =>
      simp [ctorAtom, declNameAtom, mExpr, mSym, resolveStates]
      exact ⟨by simpa [St.init, World.empty] using telAtom_resolveStates_init_world argTel,
        by simpa [St.init, World.empty] using argsAtom_resolveStates_init_world resultIdx⟩

theorem ctorsAtom_resolveStates_init_world : ∀ ctors : List DIndGArtifactCtor,
    resolveStates St.init.world (ctorsAtom ctors) = ctorsAtom ctors
  | [] => by simp [ctorsAtom, mSym, resolveStates]
  | ctor :: rest => by
      simp [ctorsAtom, mExpr, mSym, resolveStates]
      constructor
      · simpa [St.init, World.empty] using ctorAtom_resolveStates_init_world ctor
      · simpa [St.init, World.empty] using ctorsAtom_resolveStates_init_world rest

theorem declAtom_resolveStates_init_world : ∀ decl : DIndGArtifactDecl,
    resolveStates St.init.world (declAtom decl) = declAtom decl
  | .dconst name ty => by
      simp [declAtom, declNameAtom, mExpr, mSym, resolveStates]
      simpa [St.init, World.empty] using termAtom_resolveStates_init_world ty
  | .ddef name ty body => by
      simp [declAtom, declNameAtom, mExpr, mSym, resolveStates]
      exact ⟨by simpa [St.init, World.empty] using termAtom_resolveStates_init_world ty,
        by simpa [St.init, World.empty] using termAtom_resolveStates_init_world body⟩
  | .daxiom name ty => by
      simp [declAtom, declNameAtom, mExpr, mSym, resolveStates]
      simpa [St.init, World.empty] using termAtom_resolveStates_init_world ty
  | .dindg familyName paramTel indexTel ctors => by
      simp [declAtom, declNameAtom, mExpr, mSym, resolveStates]
      exact ⟨by simpa [St.init, World.empty] using telAtom_resolveStates_init_world paramTel,
        by simpa [St.init, World.empty] using telAtom_resolveStates_init_world indexTel,
        by simpa [St.init, World.empty] using ctorsAtom_resolveStates_init_world ctors⟩

theorem declAtoms_resolveStates_init_world : ∀ decls : List DIndGArtifactDecl,
    resolveStates St.init.world
      (decls.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest])
        (mSym "SNil")) =
      decls.foldr (fun decl rest => mExpr "SCons" [declAtom decl, rest])
        (mSym "SNil")
  | [] => by simp [mSym, resolveStates]
  | decl :: rest => by
      simp [mExpr, mSym, resolveStates]
      constructor
      · simpa [St.init, World.empty] using declAtom_resolveStates_init_world decl
      · simpa [St.init, World.empty, mExpr, mSym]
          using declAtoms_resolveStates_init_world rest

theorem sigAtom_resolveStates_init_world (sig : DIndGArtifactSig) :
    resolveStates St.init.world (sigAtom sig) = sigAtom sig := by
  rcases sig with ⟨decls, _, _, _⟩
  simpa [sigAtom] using declAtoms_resolveStates_init_world decls

/-- LeaTTa's grounded equality returns `True` when asked to compare a non-error atom with
itself and that atom's structural `BEq` is true.

The explicit `BEq` premise matters: LeaTTa intentionally does not assume lawful equality for every
grounded payload (notably host floats), while all encoded kernel data used below satisfies it by
separate structural lemmas. -/
theorem callGrounded_eq_self_true_of_not_error
    (a : Metta.Atom) (hErr : a.isError = false) (hEq : (a == a) = true) :
    Metta.callGrounded Metta.Minimal.stdGroundings "==" [a, a] =
      Metta.ReduceResult.ok [mBool true] := by
  simp [Metta.Minimal.stdGroundings, Metta.Builtins.table, Metta.Builtins.mathTable,
    Metta.Builtins.eqAtom, Metta.callGrounded, Metta.GroundingTable.lookup, mBool,
    hErr, hEq]

/-- The concrete `==` control-flow fact used by successful `def-body-of` lookups. -/
theorem callGrounded_eq_declName_self_true
    (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
    Metta.callGrounded Metta.Minimal.stdGroundings "=="
      [declNameAtom name, declNameAtom name] =
      Metta.ReduceResult.ok [mBool true] :=
  callGrounded_eq_self_true_of_not_error
    (declNameAtom name) (declNameAtom_isError_false name)
    (declNameAtom_beq_self_true name)

private theorem cicStage3RawIdentityWitness_termAtom_match_self :
    Metta.matchAtoms
      (termAtom cicStage3RawIdentityWitness)
      (termAtom cicStage3RawIdentityWitness) = ([[]] : List Metta.Bindings) := by
  have hZero :
      (Metta.Atom.gnd (Metta.Ground.int 0) ==
        Metta.Atom.gnd (Metta.Ground.int 0)) = true := by
    change Metta.instBEqGround.beq (Metta.Ground.int 0) (Metta.Ground.int 0) = true
    unfold Metta.instBEqGround.beq
    simp
  simp [Metta.matchAtoms, Metta.matchAtomsWith, Metta.matchAll,
    cicStage3RawIdentityWitness, termAtom, sortAtom, mExpr, mSym, mNat,
    Metta.Bindings.merge, hZero]

/-- Grounded integer equality on natural-number encodings is faithful.

The kernel encodes de Bruijn indices as `Ground.int (Int.ofNat k)`.  This small
inversion is the integer payload case needed when a successful runtime `==`
comparison is reflected back into the declaration-side raw term. -/
theorem ground_int_ofNat_beq_true {k l : Nat}
    (hEq : (Metta.Ground.int (Int.ofNat k) ==
      Metta.Ground.int (Int.ofNat l)) = true) :
    k = l := by
  change Metta.instBEqGround.beq (Metta.Ground.int (Int.ofNat k))
    (Metta.Ground.int (Int.ofNat l)) = true at hEq
  unfold Metta.instBEqGround.beq at hEq
  simp at hEq
  exact_mod_cast hEq

/-- If two expression atoms with symbolic heads compare equal, their heads are equal.

This is a producer-side inversion for LeaTTa's grounded `==`: after `eqAtom`
reports success, the structural `Atom.beq` proof can be decomposed at the
expression head before the declaration-level conversion proof consumes it. -/
theorem atom_beq_expr_head_true
    {tagL tagR : String} {xs ys : List Metta.Atom}
    (h : Metta.Atom.beq (Metta.Atom.expr (Metta.Atom.sym tagL :: xs))
      (Metta.Atom.expr (Metta.Atom.sym tagR :: ys)) = true) :
    tagL = tagR := by
  unfold Metta.Atom.beq at h
  unfold Metta.Atom.beqList at h
  have hhead : Metta.Atom.beq (Metta.Atom.sym tagL)
      (Metta.Atom.sym tagR) = true :=
    (Bool.and_eq_true_iff.mp h).1
  change Metta.Atom.beq (Metta.Atom.sym tagL)
    (Metta.Atom.sym tagR) = true at hhead
  simp [Metta.Atom.beq] at hhead
  exact hhead

/-- Contradict a successful structural comparison by contradictory expression heads. -/
theorem atom_beq_expr_head_false
    {tagL tagR : String} {xs ys : List Metta.Atom}
    (hneq : tagL ≠ tagR)
    (h : Metta.Atom.beq (Metta.Atom.expr (Metta.Atom.sym tagL :: xs))
      (Metta.Atom.expr (Metta.Atom.sym tagR :: ys)) = true) : False := by
  exact hneq (atom_beq_expr_head_true h)

/-- Payload inversion for unary tagged expression atoms. -/
theorem atom_beq_expr_unary_payload_true
    {tag : String} {a b : Metta.Atom}
    (h : Metta.Atom.beq (Metta.Atom.expr [Metta.Atom.sym tag, a])
      (Metta.Atom.expr [Metta.Atom.sym tag, b]) = true) :
    Metta.Atom.beq a b = true := by
  unfold Metta.Atom.beq at h
  unfold Metta.Atom.beqList at h
  have htail : Metta.Atom.beqList [a] [b] = true :=
    (Bool.and_eq_true_iff.mp h).2
  unfold Metta.Atom.beqList at htail
  exact (Bool.and_eq_true_iff.mp htail).1

/-- Payload inversion for binary tagged expression atoms. -/
theorem atom_beq_expr_binary_payload_true
    {tag : String} {a b c d : Metta.Atom}
    (h : Metta.Atom.beq (Metta.Atom.expr [Metta.Atom.sym tag, a, b])
      (Metta.Atom.expr [Metta.Atom.sym tag, c, d]) = true) :
    Metta.Atom.beq a c = true ∧ Metta.Atom.beq b d = true := by
  unfold Metta.Atom.beq at h
  unfold Metta.Atom.beqList at h
  have htail : Metta.Atom.beqList [a, b] [c, d] = true :=
    (Bool.and_eq_true_iff.mp h).2
  unfold Metta.Atom.beqList at htail
  have ha : Metta.Atom.beq a c = true :=
    (Bool.and_eq_true_iff.mp htail).1
  have htail2 : Metta.Atom.beqList [b] [d] = true :=
    (Bool.and_eq_true_iff.mp htail).2
  unfold Metta.Atom.beqList at htail2
  have hb : Metta.Atom.beq b d = true :=
    (Bool.and_eq_true_iff.mp htail2).1
  exact ⟨ha, hb⟩

/-- Payload inversion for encoded `Var` atoms. -/
theorem termAtom_var_beq_true {k l : Nat}
    (hEq : Metta.Atom.beq (termAtom (.var k)) (termAtom (.var l)) = true) :
    k = l := by
  have hPayload := atom_beq_expr_unary_payload_true (tag := "Var")
    (a := mNat k) (b := mNat l) (by
      simpa [termAtom, mExpr, mSym, mNat] using hEq)
  change Metta.Atom.beq (Metta.Atom.gnd (Metta.Ground.int (Int.ofNat k)))
    (Metta.Atom.gnd (Metta.Ground.int (Int.ofNat l))) = true at hPayload
  unfold Metta.Atom.beq at hPayload
  exact ground_int_ofNat_beq_true hPayload

/-- Payload inversion for encoded `Srt` atoms. -/
theorem termAtom_srt_beq_true {sort sortR : DIndGArtifactSort}
    (hEq : Metta.Atom.beq (termAtom (.srt sort)) (termAtom (.srt sortR)) = true) :
    sort = sortR := by
  cases sort <;> cases sortR
  · rfl
  · have hp := atom_beq_expr_unary_payload_true (tag := "Srt")
      (a := mSym "type") (b := mSym "kind") (by
        simpa [termAtom, sortAtom, mExpr, mSym] using hEq)
    change Metta.Atom.beq (Metta.Atom.sym "type")
      (Metta.Atom.sym "kind") = true at hp
    simp [Metta.Atom.beq] at hp
  · have hp := atom_beq_expr_unary_payload_true (tag := "Srt")
      (a := mSym "kind") (b := mSym "type") (by
        simpa [termAtom, sortAtom, mExpr, mSym] using hEq)
    change Metta.Atom.beq (Metta.Atom.sym "kind")
      (Metta.Atom.sym "type") = true at hp
    simp [Metta.Atom.beq] at hp
  · rfl

/-- Payload inversion for encoded `Bad` atoms. -/
theorem termAtom_bad_beq_true {reason reasonR : String}
    (hEq : Metta.Atom.beq (termAtom (.bad reason)) (termAtom (.bad reasonR)) = true) :
    reason = reasonR := by
  have hp := atom_beq_expr_unary_payload_true (tag := "Bad")
    (a := mSym reason) (b := mSym reasonR) (by
      simpa [termAtom, mExpr, mSym] using hEq)
  change Metta.Atom.beq (Metta.Atom.sym reason)
    (Metta.Atom.sym reasonR) = true at hp
  simp [Metta.Atom.beq] at hp
  exact hp

/-- Local shorthand for contradictory encoded term heads. -/
theorem termAtom_head_contra
    {tagL tagR : String} {xs ys : List Metta.Atom}
    (hneq : tagL ≠ tagR)
    (h : Metta.Atom.beq (Metta.Atom.expr (Metta.Atom.sym tagL :: xs))
      (Metta.Atom.expr (Metta.Atom.sym tagR :: ys)) = true) : False :=
  atom_beq_expr_head_false hneq h

/-- Invert a successful grounded equality result into LeaTTa's structural `BEq`.

The non-error premises expose the exact boundary of `Builtins.eqAtom`: if either
argument is an error, `==` propagates that error instead of returning a Boolean.
For normalized kernel readouts (`termAtom` outputs) the non-error premises are
provided by `termAtom_isError_false`. -/
theorem callGrounded_eq_true_implies_beq_true
    (a b : Metta.Atom)
    (hA : a.isError = false) (hB : b.isError = false)
    (h : Metta.callGrounded Metta.Minimal.stdGroundings "==" [a, b] =
      Metta.ReduceResult.ok [mBool true]) :
    (a == b) = true := by
  simp [Metta.Minimal.stdGroundings, Metta.Builtins.table,
    Metta.Builtins.mathTable, Metta.Builtins.eqAtom, Metta.callGrounded,
    Metta.GroundingTable.lookup, mBool, hA, hB] at h
  exact h

theorem callGrounded_eq_true_implies_no_errors
    (a b : Metta.Atom)
    (h : Metta.callGrounded Metta.Minimal.stdGroundings "==" [a, b] =
      Metta.ReduceResult.ok [mBool true]) :
    a.isError = false ∧ b.isError = false := by
  cases ha : a.isError <;> cases hb : b.isError <;>
    simp [Metta.Minimal.stdGroundings, Metta.Builtins.table,
      Metta.Builtins.mathTable, Metta.Builtins.eqAtom, Metta.callGrounded,
      Metta.GroundingTable.lookup, mBool, ha, hb] at h ⊢
  case false.true =>
    rw [h] at hb
    contradiction
  case true.false =>
    rw [h] at ha
    contradiction
  case true.true =>
    rw [h] at ha
    contradiction

theorem callGrounded_eq_false_of_beq_false
    (a b : Metta.Atom)
    (hA : a.isError = false) (hB : b.isError = false)
    (h : (a == b) = false) :
    Metta.callGrounded Metta.Minimal.stdGroundings "==" [a, b] =
      Metta.ReduceResult.ok [mBool false] := by
  simp [Metta.Minimal.stdGroundings, Metta.Builtins.table,
    Metta.Builtins.mathTable, Metta.Builtins.eqAtom, Metta.callGrounded,
    Metta.GroundingTable.lookup, mBool, hA, hB, h]

