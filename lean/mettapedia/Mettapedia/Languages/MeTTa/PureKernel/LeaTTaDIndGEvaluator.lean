  simp [bindSubstQuery, Metta.instantiate, Metta.bindingsToSubst,
    Metta.Subst.apply, Metta.Subst.lookup, termAtom, mExpr, mSym, mVar, mNat]
  exact ClosedValueBindings.val (mNat_vars_nil k)
    (ClosedValueBindings.val (termAtom_vars_nil replacement)
      (ClosedValueBindings.val (mNat_vars_nil index) ClosedValueBindings.nil))

/-- MOPS fires the public `subst` variable dispatcher in the App rule slice. -/
theorem subst_var_dispatch_appRules_mops_readout
    (index : Nat) (replacement : DIndGArtifactTerm) (k : Nat) :
    bindSubstQuery index replacement (.var k) ∈
      Metta.equalityReductions ⟨kernelAppRules⟩
        (substQuery index replacement (.var k)) := by
  rw [Metta.mem_equalityReductions]
  refine ⟨(mExpr "subst" [mVar "j", mVar "s", mExpr "Var" [mVar "k"]],
      mExpr "bind-subst" [mVar "j", mVar "s", mExpr "Var" [mVar "k"]]), ?_, ?_⟩
  · simp [Metta.Space.equalityRules, kernelAppRules, kernelSubstRules,
      kernelSubstPublicRules, kernelSubstCoreRules, ruleSubstVar, ruleInferAppBody,
      inferAppBodyRhs, ruleInferAppDispatch, kernelCoreRules, runtimeDecls,
      ruleIsBad, ruleNfVar, ruleNfSrt, ruleNfCon, ruleNfBad, ruleInferSrtType,
      ruleInferSrtKind, ruleInferBad, ruleConv, mExpr, mSym, mVar, mTypeDecl,
      mBool, mNat]
  · refine ⟨[Metta.BindingRel.val "k" (mNat k),
        Metta.BindingRel.val "s" (termAtom replacement),
        Metta.BindingRel.val "j" (mNat index)], ?_, ?_⟩
    · rw [subst_var_dispatch_rule_match]
      simp
    · simp [subst_var_dispatch_instantiate_bindings]

/-- The public `subst` variable dispatcher as a MOPS step. -/
theorem subst_var_dispatch_appRules_mops_step
    (index : Nat) (replacement : DIndGArtifactTerm) (k : Nat) :
    Metta.MopsStep kernelAppRules
      (substQuery index replacement (.var k))
      (bindSubstQuery index replacement (.var k)) := by
  constructor
  · refine ⟨"subst", ?_⟩
    simp [Metta.Minimal.headKey, substQuery, termAtom, mExpr, mSym]
  · exact subst_var_dispatch_appRules_mops_readout index replacement k

/-- The public `subst` variable dispatch transported through LeaTTa's executable
kernel/MOPS correspondence. -/
theorem subst_var_dispatch_appRules_kernel_step
    (index : Nat) (replacement : DIndGArtifactTerm) (k : Nat) :
    Metta.KernelStep kernelAppRules stdGroundings
      (substQuery index replacement (.var k))
      (bindSubstQuery index replacement (.var k)) := by
  exact (Metta.kernelStep_iff_mopsStep (atoms := kernelAppRules) (gt := stdGroundings)).2
    (subst_var_dispatch_appRules_mops_step index replacement k)

/-- The binding-waist `bind-subst` variable rule matches encoded artifact
variables. This is the rule that implements the three de Bruijn cases:
