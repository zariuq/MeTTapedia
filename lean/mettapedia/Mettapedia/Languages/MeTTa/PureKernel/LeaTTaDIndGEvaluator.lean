  rcases hRule with ⟨obligation, _hObMem, hGenerated⟩
  by_cases hUnit : obligation = unitRecCtorIotaObligation
  · subst obligation
    rw [generateClosedIotaRule_unit] at hGenerated
    cases hGenerated
