/-- Capture-avoiding freshening of the concrete `is-bad` rule preserves its
arrow shape while choosing two distinct private names outside the supplied
avoid set.  The statement deliberately hides which executable freshening
branch supplied those spellings. -/
private theorem freshenRuleAvoiding_is_bad_shape
    (counter : Nat) (avoid : List String) :
    ∃ x e,
      (freshenRuleAvoiding counter avoid isBadRulePair.1 isBadRulePair.2).1 =
        ( mExpr "is-bad" [mVar x]
        , mExpr "unify"
            [mVar x, mExpr "Bad" [mVar e], mBool true, mBool false] ) ∧
      x ≠ e ∧ x ∉ avoid ∧ e ∉ avoid := by
  have hshape :
      ∃ x e,
        (freshenRuleAvoiding counter avoid isBadRulePair.1 isBadRulePair.2).1 =
          ( mExpr "is-bad" [mVar x]
          , mExpr "unify"
              [mVar x, mExpr "Bad" [mVar e], mBool true, mBool false] ) ∧
        x ≠ e := by
    by_cases hcollision :
        ∃ v ∈ (freshenRule counter isBadRulePair.1 isBadRulePair.2).1.vars ++
            (freshenRule counter isBadRulePair.1 isBadRulePair.2).2.vars,
          v ∈ avoid
    · refine ⟨captureAvoidingName avoid counter "x",
        captureAvoidingName avoid counter "e", ?_, ?_⟩
      · rw [freshenRuleAvoiding, if_pos hcollision]
        simp [isBadRulePair, mExpr, mSym, mVar, mBool, renameAllVars]
      · exact fun h => by
          have := (captureAvoidingName_injective avoid counter) h
          contradiction
    · refine ⟨counterSuffix counter "x", counterSuffix counter "e", ?_, ?_⟩
      · rw [freshenRuleAvoiding_eq_legacy counter avoid _ _ hcollision,
          freshenRule_eq_renBy]
        simp [isBadRulePair, mExpr, mSym, mVar, mBool,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
      · exact fun h => by
          have := (counterSuffix_injective counter) h
          contradiction
  rcases hshape with ⟨x, e, hshape, hxe⟩
  have hfresh := freshenRuleAvoiding_vars_fresh
    counter avoid isBadRulePair.1 isBadRulePair.2
  have hx : x ∉ avoid := by
    apply hfresh x
    rw [hshape]
    simp [mExpr, mSym, mVar, mBool, Metta.Atom.vars]
  have he : e ∉ avoid := by
    apply hfresh e
    rw [hshape]
    simp [mExpr, mSym, mVar, mBool, Metta.Atom.vars]
  exact ⟨x, e, hshape, hxe, hx, he⟩

