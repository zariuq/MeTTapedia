private theorem queryOpItems_nf_lam_eq
    (counter : Nat) (sig : DIndGArtifactSig)
    (rawDomain rawBody : DIndGArtifactTerm) :
    Metta.Minimal.queryOpItemsOfRule [] (nfQuery sig (.lam rawDomain rawBody)) [] counter
        nfLamRulePair =
      [evalResult [] (nfLamReadout sig rawDomain rawBody)
        ((renameBindings (counterSuffix counter)
          (nfLamRuleBindings sig rawDomain rawBody)).reverse)] := by
  let f := counterSuffix counter
  let coreB : Metta.Bindings := nfLamRuleBindings sig rawDomain rawBody
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  let root : Metta.Atom := nfLamReadout sig rawDomain rawBody
  have hfresh :
      freshenRule counter nfLamRulePair.1 nfLamRulePair.2 =
        (mExpr "nf" [mVar (f "sig"),
            mExpr "Lam" [mVar (f "A"), mVar (f "b")]],
          mExpr "Lam"
            [mExpr "nf" [mVar (f "sig"), mVar (f "A")],
             mExpr "nf" [mVar (f "sig"), mVar (f "b")]]) := by
    rw [freshenRule_eq_renBy]
    simp [f, nfLamRulePair, nfLamRuleLhs, nfLamRuleRhs, mExpr, mSym, mVar,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms
          (mExpr "nf" [mVar (f "sig"),
            mExpr "Lam" [mVar (f "A"), mVar (f "b")]])
          (nfQuery sig (.lam rawDomain rawBody)) =
        [renameBindings f coreB] := by
    have hFreshLhs :
        (freshenRule counter nfLamRuleLhs nfLamRuleRhs).1 =
          mExpr "nf" [mVar (f "sig"),
            mExpr "Lam" [mVar (f "A"), mVar (f "b")]] := by
      simpa [nfLamRulePair] using congrArg Prod.fst hfresh
    rw [← hFreshLhs]
    simpa [f, coreB, nfLamRulePair, nfLamRuleLhs, nfLamRuleRhs] using
      fresh_nf_lam_rule_match counter sig rawDomain rawBody
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (termAtom_vars_nil rawDomain)
      (ClosedValueBindings.val (termAtom_vars_nil rawBody)
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))
  have hnodup : (bindingValueKeys coreB).Nodup := by
    dsimp [coreB, nfLamRuleBindings, bindingValueKeys]
    decide
  have hmerge :
      Metta.Bindings.merge [] (renameBindings f coreB) = [m] := by
    simpa [m, f, coreB] using
      merge_empty_renamed_value_nodup_eq
        (f := f) (counterSuffix_injective counter) hclosedB hnodup
  have hclosedM : ClosedValueBindings m := by
    simpa [m, coreB, f] using
      ClosedValueBindings.reverse (ClosedValueBindings.rename hclosedB)
  have hloop : Metta.Bindings.hasLoop m = false := by
    exact ClosedValueBindings.hasLoop_false hclosedM
  have hresult :
      Metta.instantiate m
          (mExpr "Lam"
            [mExpr "nf" [mVar (f "sig"), mVar (f "A")],
             mExpr "nf" [mVar (f "sig"), mVar (f "b")]]) =
        root := by
    have hASig : f "A" ≠ f "sig" := by
      intro h
      have h' : "A" = "sig" := (counterSuffix_injective counter) h
      contradiction
    have hAB : f "A" ≠ f "b" := by
      intro h
      have h' : "A" = "b" := (counterSuffix_injective counter) h
      contradiction
    have hbSig : f "b" ≠ f "sig" := by
      intro h
      have h' : "b" = "sig" := (counterSuffix_injective counter) h
      contradiction
    rw [hclosedM.instantiate_eq_subst_apply]
    simp [root, m, coreB, nfLamRuleBindings, nfLamReadout, renameBindings, f,
      Metta.bindingsToSubst, Metta.Subst.apply,
      Metta.Subst.lookup, mExpr, mSym, mVar, hASig, hAB, hbSig]
  rw [queryOpItemsOfRule_nfQuery_eq_legacy]
  rw [hfresh]
  change
    List.flatMap
        (fun mb =>
          List.filterMap
            (fun m' =>
              if Metta.Bindings.hasLoop m' = true then none
              else some (evalResult []
                (Metta.instantiate m'
                  (mExpr "Lam"
                    [mExpr "nf" [mVar (f "sig"), mVar (f "A")],
                     mExpr "nf" [mVar (f "sig"), mVar (f "b")]])) m'))
            (Metta.Bindings.merge [] mb))
        (Metta.matchAtoms
          (mExpr "nf" [mVar (f "sig"),
            mExpr "Lam" [mVar (f "A"), mVar (f "b")]])
          (nfQuery sig (.lam rawDomain rawBody))) =
      [evalResult [] (nfLamReadout sig rawDomain rawBody)
        ((renameBindings (counterSuffix counter)
          (nfLamRuleBindings sig rawDomain rawBody)).reverse)]
  rw [hmatch]
  simp [hmerge, hloop, hresult, root, m, coreB, f]

/-- Exact live-binding readout of the recursive `nf`/`Lam` candidate under
one closed public binding. -/
private theorem queryOpItems_nf_lam_eq_singleton_closed
    (counter : Nat) (sig : DIndGArtifactSig)
    (rawDomain rawBody : DIndGArtifactTerm)
    (binder : String) (value : Metta.Atom)
    (hclosedValue : value.vars = [])
    (hFresh :
      ∀ {v : String}, v = "sig" ∨ v = "A" ∨ v = "b" →
        counterSuffix counter v ≠ binder) :
    let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
    let rootBnd : Metta.Bindings :=
      (renameBindings (counterSuffix counter)
        (nfLamRuleBindings sig rawDomain rawBody)).reverse ++ incoming
    Metta.Minimal.queryOpItemsOfRule []
        (nfQuery sig (.lam rawDomain rawBody)) incoming counter nfLamRulePair =
      [evalResult [] (nfLamReadout sig rawDomain rawBody) rootBnd] := by
  dsimp only
  let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
  let f := counterSuffix counter
  let coreB : Metta.Bindings := nfLamRuleBindings sig rawDomain rawBody
  let matched : Metta.Bindings := renameBindings f coreB
  let merged : Metta.Bindings := matched.reverse ++ incoming
  let lhs := mExpr "nf" [mVar (f "sig"),
    mExpr "Lam" [mVar (f "A"), mVar (f "b")]]
  let rhs := mExpr "Lam"
    [mExpr "nf" [mVar (f "sig"), mVar (f "A")],
      mExpr "nf" [mVar (f "sig"), mVar (f "b")]]
  let root := nfLamReadout sig rawDomain rawBody
  have hclosedTarget : (nfQuery sig (.lam rawDomain rawBody)).vars = [] := by
    simp [nfQuery, sigAtom_vars_nil sig,
      termAtom_vars_nil (.lam rawDomain rawBody), mExpr, mSym,
      Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (termAtom_vars_nil rawDomain)
      (ClosedValueBindings.val (termAtom_vars_nil rawBody)
        (ClosedValueBindings.val (sigAtom_vars_nil sig)
          ClosedValueBindings.nil))
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, nfLamRuleBindings, bindingValueKeys]
  have hclosedIncoming : ClosedValueBindings incoming := by
    exact ClosedValueBindings.val hclosedValue ClosedValueBindings.nil
  have hcompat :
      LegacyFresheningCompatible [] (nfQuery sig (.lam rawDomain rawBody))
        incoming counter nfLamRulePair.1 nfLamRulePair.2 := by
    apply legacyFresheningCompatible_of_no_collision
    rintro ⟨name, hRule, hAvoid⟩
    have hRule' :
        name = f "sig" ∨ name = f "A" ∨ name = f "b" := by
      simp [nfLamRulePair, nfLamRuleLhs, nfLamRuleRhs,
        freshenRule_eq_renBy, f, mExpr, mSym, mVar,
        Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
        Metta.Atom.vars] at hRule
      aesop
    have hAvoid' : name = binder := by
      simpa [Metta.Minimal.queryOpAvoid, Metta.Minimal.liveStackVars,
        hclosedTarget, incoming, Metta.Bindings.vars, hclosedValue] using hAvoid
    rcases hRule' with rfl | rfl | rfl
    · exact hFresh (Or.inl rfl) hAvoid'
    · exact hFresh (Or.inr (Or.inl rfl)) hAvoid'
    · exact hFresh (Or.inr (Or.inr rfl)) hAvoid'
  have hfresh : freshenRule counter nfLamRulePair.1 nfLamRulePair.2 =
      (lhs, rhs) := by
    rw [freshenRule_eq_renBy]
    simp [lhs, rhs, f, nfLamRulePair, nfLamRuleLhs, nfLamRuleRhs,
      mExpr, mSym, mVar,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms lhs (nfQuery sig (.lam rawDomain rawBody)) =
        [matched] := by
    have hFreshLhs : (freshenRule counter nfLamRuleLhs nfLamRuleRhs).1 =
        lhs := by
      simpa [nfLamRulePair] using congrArg Prod.fst hfresh
    rw [← hFreshLhs]
    simpa [matched, coreB, f] using
      fresh_nf_lam_rule_match counter sig rawDomain rawBody
  have hnodupMatched : (bindingValueKeys matched).Nodup := by
    rw [show matched = renameBindings f coreB by rfl,
      bindingValueKeys_renameBindings]
    exact List.Nodup.map (counterSuffix_injective counter) hnodup
  have hdisj :
      ∀ x ∈ bindingValueKeys matched, x ∉ bindingValueKeys incoming := by
    intro x hx hxIncoming
    have hx' : x = f "A" ∨ x = f "b" ∨ x = f "sig" := by
      simpa [matched, coreB, nfLamRuleBindings, bindingValueKeys,
        renameBindings, f] using hx
    have hxIncoming' : x = binder := by
      simpa [incoming, bindingValueKeys] using hxIncoming
    rcases hx' with rfl | rfl | rfl
    · exact hFresh (Or.inr (Or.inl rfl)) hxIncoming'
    · exact hFresh (Or.inr (Or.inr rfl)) hxIncoming'
    · exact hFresh (Or.inl rfl) hxIncoming'
  have hmerge : Metta.Bindings.merge incoming matched = [merged] := by
    simpa [merged] using
      (merge_closed_noConflict_eq
        (ClosedValueBindings.rename hclosedB) hnodupMatched
        hclosedIncoming hdisj)
  have hclosedMerged : ClosedValueBindings merged := by
    exact ClosedValueBindings.append
      (ClosedValueBindings.reverse (by
        simpa [matched] using ClosedValueBindings.rename (f := f) hclosedB))
      hclosedIncoming
  have hloop : Metta.Bindings.hasLoop merged = false :=
    ClosedValueBindings.hasLoop_false hclosedMerged
  have hinst : Metta.instantiate merged rhs = root := by
    have hASig : f "A" ≠ f "sig" := by
      intro h
      exact (by decide : "A" ≠ "sig")
        ((counterSuffix_injective counter) h)
    have hAB : f "A" ≠ f "b" := by
      intro h
      exact (by decide : "A" ≠ "b")
        ((counterSuffix_injective counter) h)
    have hbSig : f "b" ≠ f "sig" := by
      intro h
      exact (by decide : "b" ≠ "sig")
        ((counterSuffix_injective counter) h)
    rw [hclosedMerged.instantiate_eq_subst_apply]
    simp [merged, matched, incoming, coreB, nfLamRuleBindings, rhs, root,
      nfLamReadout, renameBindings, f, Metta.bindingsToSubst,
      Metta.Subst.apply, Metta.Subst.lookup, mExpr, mSym, mVar,
      hASig, hAB, hbSig]
  simpa [incoming, merged, matched, f, coreB, root] using
    queryOpItemsOfRule_eq_singleton_from counter
      (nfQuery sig (.lam rawDomain rawBody)) incoming nfLamRulePair lhs rhs
      matched merged root hcompat hfresh hmatch hmerge hloop hinst

private theorem queryOpItems_nf_bad_on_lam_eq_nil
    (counter : Nat) (sig : DIndGArtifactSig)
    (rawDomain rawBody : DIndGArtifactTerm) :
    Metta.Minimal.queryOpItemsOfRule [] (nfQuery sig (.lam rawDomain rawBody)) [] counter
        nfBadRulePair = [] := by
  let f := counterSuffix counter
  have hfresh :
      freshenRule counter nfBadRulePair.1 nfBadRulePair.2 =
        (mExpr "nf" [mVar (f "sig"), mExpr "Bad" [mVar (f "e")]],
          mExpr "Bad" [mVar (f "e")]) := by
    rw [freshenRule_eq_renBy]
    simp [f, nfBadRulePair, mExpr, mSym, mVar,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms
          (mExpr "nf" [mVar (f "sig"), mExpr "Bad" [mVar (f "e")]])
          (nfQuery sig (.lam rawDomain rawBody)) = [] := by
    simpa [nfQuery, termAtom] using
