    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix st.counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  let st' : St := { counter := st.counter + 2, world := st.world }
  have hstep :
      interpretStack1 kernelDefControlEnv fuel st (evalItemNil target) =
        ([evalResult [] thenA m], st') := by
    change interpretStack1 kernelDefControlEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := [] } =
      ([evalResult [] thenA m], st')
    rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelDefControlEnv fuel st [] target [] "if" [mBool true, thenA, elseA]]
    · simpa [target, m, f, coreB, st', mExpr, mSym] using
        queryOp_kernelDefControlEnv_if_true_eq
          st thenA elseA hStatic hThenClosed hElseClosed hThenNonVar hElseNonVar
    · simp [target, mExpr, mSym, Metta.instantiate_nil]
    · exact kernelDefControlEnv_callGrounded_if [mBool true, thenA, elseA]
    · simp [isEmbeddedOp]
  have hnotFunction : isFunctionResult thenA = false := by
    cases thenA with
    | expr xs =>
        cases xs with
        | nil => rfl
        | cons h rest =>
            cases h with
            | sym op =>
                by_cases hop : op = "function"
                · subst hop
                  exfalso
                  exact hThenNotFunction rest rfl
                · simp [isFunctionResult]
            | var _ => simp [isFunctionResult]
            | gnd _ => simp [isFunctionResult]
            | expr _ => simp [isFunctionResult]
    | sym _ => rfl
    | var _ => rfl
    | gnd _ => rfl
