/-- The quoted `nf` query wrapper is injective on the name-free fragment. -/
theorem nfQuery_injective_on_nf_eq_fragment_nameFree
    {sig : DIndGArtifactSig}
    {rawL rawR : DIndGArtifactTerm}
    (hL : NfEqFragmentTermNameFree rawL)
    (hR : NfEqFragmentTermNameFree rawR)
    (hEq : nfQuery sig rawL = nfQuery sig rawR) : rawL = rawR := by
  have hList :
      [mSym "nf", sigAtom sig, termAtom rawL] =
        [mSym "nf", sigAtom sig, termAtom rawR] := by
    simpa [nfQuery, mExpr, mSym] using hEq
  have hTail := List.cons.inj hList
  have hPayload := List.cons.inj hTail.2
  have hTerm : termAtom rawL = termAtom rawR := by
    simpa using (List.cons.inj hPayload.2).1
  exact termAtom_injective_on_nf_eq_fragment_nameFree hL hR hTerm

