    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    interpretFuel kernelDefControlEnv (fuel + 1) st
        [evalItemNil (mExpr "is-bad" [a])] [] =
      ( [ (mExpr "unify"
            [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false],
            (renameBindings (counterSuffix st.counter)
              [Metta.BindingRel.val "x" a]).reverse) ]
      , { counter := st.counter + 1, world := st.world }) := by
  let target := mExpr "is-bad" [a]
  let root :=
    mExpr "unify" [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false]
  let m : Metta.Bindings :=
    (renameBindings (counterSuffix st.counter)
      [Metta.BindingRel.val "x" a]).reverse
  have hstep :
      interpretStack1 kernelDefControlEnv fuel st (evalItemNil target) =
        ([evalResult [] root m], { counter := st.counter + 1, world := st.world }) := by
    calc
      interpretStack1 kernelDefControlEnv fuel st (evalItemNil target)
          = interpretStack1 kernelEnv fuel st (evalItemNil target) := by
              simpa [target, evalItemNil, atomToStack_eval, mExpr, mSym] using
                kernelDefControlEnv_is_bad_interpretStack1_eval_eq_kernelEnv
                  fuel st [] a
      _ = ([evalResult [] root m], { counter := st.counter + 1, world := st.world }) := by
              change interpretStack1 kernelEnv fuel st
                  { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
                    bnd := [] } =
                ([evalResult [] root m], { counter := st.counter + 1, world := st.world })
              rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
                kernelEnv fuel st [] target [] "is-bad" [a]]
              · simpa [target, root, m, evalResult, mExpr, mSym] using
                  queryOp_kernelEnv_is_bad_eq st a hStatic hClosed hNonVar
              · simp [target, mExpr, mSym, Metta.instantiate_nil]
              · exact kernelEnv_callGrounded_isBad a
              · simp [isEmbeddedOp]
  have heval : evalResult [] root m = finItem [] root m := by
    simp [root, evalResult, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root m) = true := by
    simp [heval, finItem, isFinal]
  have hrootStable : Metta.instantiate m root = root := by
    have hxe :
        counterSuffix st.counter "e" ≠ counterSuffix st.counter "x" := by
      intro h
      have hx : "e" = "x" := (counterSuffix_injective st.counter) h
      contradiction
    have hsubstA :
        Metta.Subst.apply [(counterSuffix st.counter "x", a)] a = a := by
      exact Metta.Subst.apply_of_closed _ _ hClosed
    simpa [root, m, renameBindings, counterSuffix,
      Metta.instantiate, Metta.bindingsToSubst,
      Metta.Subst.apply, Metta.Subst.lookup, hsubstA, hxe,
      mExpr, mSym, mVar, mBool]
  have hpair : finalPair (evalResult [] root m) = (root, m) := by
    rw [heval]
    change (Metta.instantiate m root, m) = (root, m)
    simp [hrootStable]
  rw [interpretFuel, hstep]
  simp [interpretFuel, hfinal, hpair, root, m]

theorem mettaEval_kernelDefControlEnv_is_bad_false_eq
    (fuel : Nat) (st : St) (a : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hClosed : a.vars = [])
    (hErr : a.isError = false)
    (_hEq : (a == a) = true)
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w)
    (hmatch : Metta.matchAtoms a
      (mExpr "Bad" [mVar (counterSuffix st.counter "e")]) = []) :
    mettaEval kernelDefControlEnv (fuel + 3) st [] (mExpr "is-bad" [a]) =
      ([(mBool false, [])], { counter := st.counter + 1, world := st.world }) := by
  let root :=
    mExpr "unify"
      [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false]
  let m : Metta.Bindings :=
    (renameBindings (counterSuffix st.counter)
      [Metta.BindingRel.val "x" a]).reverse
  let st' : St := { counter := st.counter + 1, world := st.world }
  unfold mettaEval
  rw [instantiate_nil (mExpr "is-bad" [a])]
  have hNoErrIf :
      (if a.isError = true ∧ (a != a) = true then some (a, a) else none) = none := by
    cases ha : a.isError <;> simp [ha] at hErr ⊢
  simp [kernelDefControlEnv_is_bad_typeMismatch st a, kernelDefControlEnv_is_bad_argMask,
    mExpr, mSym]
  have hNoErrIfInst :
      (if (Metta.instantiate [] a).isError = true ∧ (Metta.instantiate [] a != a) = true then
          some (Metta.instantiate [] a, a)
        else none) = none := by
    simpa [Metta.instantiate_nil] using hNoErrIf
  rw [hNoErrIfInst]
  have hroot :
      interpretFuel kernelDefControlEnv (fuel + 3) st [evalItemNil (mExpr "is-bad" [a])] [] =
        ([(root, m)], st') := by
    simpa [root, m, st', Nat.add_assoc] using
      (interpretFuel_kernelDefControlEnv_is_bad_root_eq
        (fuel := fuel + 2) st a hStatic hClosed hNonVar)
  have hrootDirect :
      interpretFuel kernelDefControlEnv (fuel + 3) st
          [{ stack := atomToStack
              (Atom.expr [Atom.sym "eval",
                Atom.expr [Atom.sym "is-bad", Metta.instantiate [] a]]) [],
             bnd := [] }] [] =
        ([(root, m)], st') := by
    simpa [evalItemNil, mExpr, mSym, Metta.instantiate_nil, root, m, st'] using hroot
  rw [hrootDirect]
  have hExtra' : st'.world.selfExtra = [] := by
    simpa [st'] using hStatic
  have hRootNoErr :
      (([a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false].zip
          [a, mExpr "Bad" [mVar (counterSuffix st.counter "e")], mBool true, mBool false]).find?
        (fun ho => ho.1.isError && ho.1 != ho.2)) = none := by
    have hPatternErr :
        (mExpr "Bad" [mVar (counterSuffix st.counter "e")]).isError = false := by
      change Metta.Atom.isError
          (Atom.expr [Atom.sym "Bad", Atom.var (counterSuffix st.counter "e")]) = false
      rfl
    simp [List.find?, hErr, mExpr, mSym, mVar, mBool]
    simp [Metta.Atom.isError]
  have hRootNotSelf :
      (mBool false == root) = false := by
    change Metta.Atom.beq (mBool false) root = false
    simp [root, mExpr, mSym, mVar, mBool, Metta.Atom.beq]
  have hrootEval :
      mettaEval kernelDefControlEnv (fuel + 2) st' [] root =
        ([(mBool false, [])], st') := by
    simpa [root, st'] using
      (mettaEval_kernelDefControlEnv_embedded_unify_fallback_false_eq
        (fuel := fuel) (st := st')
        (atom := a)
        (pattern := mExpr "Bad" [mVar (counterSuffix st.counter "e")])
        (template := mBool true)
        hExtra' hRootNoErr hmatch hRootNotSelf)
  simp [hClosed, restrictBnd_nil_vars]
  rw [hrootEval]
  have hRootNotReducible :
      (root == notReducibleA) = false := by
    change Metta.Atom.beq
        (Atom.expr
          [Atom.sym "unify", a, Atom.expr [Atom.sym "Bad", Atom.var (counterSuffix st.counter "e")],
            Atom.gnd (Ground.bool true), Atom.gnd (Ground.bool false)])
        notReducibleA = false
    rfl
  have hRootNotIsBad :
      (root == Atom.expr [Atom.sym "is-bad", Metta.instantiate [] a]) = false := by
    rw [Metta.instantiate_nil]
    change Metta.Atom.beq
        (Atom.expr
          [Atom.sym "unify", a, Atom.expr [Atom.sym "Bad", Atom.var (counterSuffix st.counter "e")],
            Atom.gnd (Ground.bool true), Atom.gnd (Ground.bool false)])
        (Atom.expr [Atom.sym "is-bad", a]) = false
    rfl
  have hReturnsFalse :
      returnsAtom kernelDefControlEnv (Atom.expr [Atom.sym "is-bad", Metta.instantiate [] a]) = false := by
    simpa [mExpr, mSym] using kernelDefControlEnv_is_bad_returnsAtom (Metta.instantiate [] a)
  rw [hRootNotReducible, hRootNotIsBad, hReturnsFalse]
  simp [st']

/-- Promote an already-selected one-step `nf` root item through the outer
`mettaEval` loop of `kernelEnv`.

This factors out the common post-processing half of the executable `nf` bridge:
once a concrete root item has been harvested from the real one-step fuel driver,
the Atom-returning `mettaEval` fold keeps that same readout and strips the
closed query bindings back to `[]`.  Later state-aware `nf` lemmas can focus on
obtaining the root item in `interpretFuel` without redoing this fold proof. -/
theorem nf_interpretFuel_root_pair_mem_mettaEval_kernelEnv_state_fuel
    {fuel : Nat} {st : St} {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {rootOut : Metta.Atom} {rootBnd : Metta.Bindings}
    (hroot :
      (rootOut, rootBnd) ∈
        (interpretFuel kernelEnv (fuel + 1) st
          [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", nfQuery sig raw]) []
             bnd := [] }] []).1)
    (hembed : isEmbeddedOp rootOut = false)
    (hnotNR : (rootOut == notReducibleA) = false)
    (hnotSelf : (rootOut == nfQuery sig raw) = false) :
    (rootOut, []) ∈
      (mettaEval kernelEnv (fuel + 1) st [] (nfQuery sig raw)).1 := by
  unfold mettaEval
  rw [Metta.instantiate_nil]
  simp only [nfQuery, mExpr, mSym] at hnotSelf ⊢
  rw [show typeMismatch kernelEnv st.world "nf" [sigAtom sig, termAtom raw] = none by
    exact kernelEnv_nf_typeMismatch_state st sig raw]
  simp [kernelEnv_nf_argMask, Metta.instantiate_nil]
  cases hpairs : interpretFuel kernelEnv (fuel + 1) st
      [{ stack := atomToStack
          (Metta.Atom.expr [Metta.Atom.sym "eval",
            Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]]) []
         bnd := [] }] [] with
  | mk pairs st' =>
      have hrootExpanded :
          (rootOut, rootBnd) ∈
            (interpretFuel kernelEnv (fuel + 1) st
              [{ stack := atomToStack
                  (Metta.Atom.expr [Metta.Atom.sym "eval",
                    Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]]) []
                 bnd := [] }] []).1 := by
        simpa [nfQuery, mExpr, mSym] using hroot
      have hrootPairs : (rootOut, rootBnd) ∈ pairs := by
        rw [hpairs] at hrootExpanded
        simpa using hrootExpanded
      have hkeep :
          (rootOut,
              restrictBnd ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelEnv fuel
                ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [])
              ([], st')).1 :=
        mettaEval_expr_root_keeps_of_returnsAtom_readout
          kernelEnv fuel ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
          (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) []
          (rootOut, rootBnd) pairs st'
          hrootPairs (by simpa [nfQuery, mExpr, mSym] using kernelEnv_nf_returnsAtom sig raw)
          hembed hnotNR hnotSelf
      have hkeep' :
          (rootOut, []) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelEnv fuel []
                (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [])
              ([], st')).1 := by
        simpa [restrictBnd_nil_vars, List.flatMap, sigAtom_vars_nil sig, termAtom_vars_nil raw]
          using hkeep
      have hkeep'' :
          (rootOut, []) ∈
            (List.foldl
              (fun (a2 : List (Metta.Atom × Metta.Bindings) × St)
                  (p : Metta.Atom × Metta.Bindings) =>
                if (p.1 == notReducibleA) = true ∨
                    (p.1 == Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) = true then
                  (a2.1 ++
                      [(Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw],
                        ([] : Metta.Bindings))],
                    a2.2)
                else
                  if returnsAtom kernelEnv (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) = true ∧
                      isEmbeddedOp p.1 = false then
                    (a2.1 ++ [(p.1, ([] : Metta.Bindings))], a2.2)
                  else
                    (a2.1 ++ List.map (fun m => (m.1, ([] : Metta.Bindings)))
                        (mettaEval kernelEnv fuel a2.2 [] p.1).1,
                      (mettaEval kernelEnv fuel a2.2 [] p.1).2))
              ([], st') pairs).1 := by
        unfold mettaEvalExprRootFoldStep at hkeep'
        simpa [kernelEnv_nf_returnsAtom sig raw, restrictBnd_nil_vars] using hkeep'
      have hnoerr :
          List.find?
              (fun ho : Metta.Atom × Metta.Atom => ho.1.isError && ho.1 != ho.2)
              [(sigAtom sig, sigAtom sig), (termAtom raw, termAtom raw)] = none := by
        simp [sigAtom_isError_false, termAtom_isError_false]
      rw [hnoerr]
      rw [sigAtom_vars_nil sig, termAtom_vars_nil raw]
      simp only [List.append_nil, restrictBnd_nil_vars]
      exact hkeep''

theorem mettaEval_binary_expr_eq_of_quoted_args_and_root_eval_eq
    (env : MinEnv) (fuel : Nat) (st stRoot stOut : St)
    (op : String)
