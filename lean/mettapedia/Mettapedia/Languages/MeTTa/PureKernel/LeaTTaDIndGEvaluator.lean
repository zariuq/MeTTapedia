/-- Declaration-calculus App case. Once the runtime readout has been absorbed
into the declarative `MettaCall` relation, the recursive `infer` hypotheses for
the function and argument are consumed here. -/
theorem infer_sound_app_decl_case
    {sig : DIndGArtifactSig}
    {fn arg argType : PureTm 0} {bodyType : PureTm 1}
    (hFnSound :
      HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil fn (.pi argType bodyType))
    (hArgSound :
      HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil arg argType) :
    HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil (.app fn arg) (inst0 arg bodyType) := by
  exact HasTypeDecl.app_elim hFnSound hArgSound

/-- App-case IH combiner. After the future runtime-readout absorption theorem
turns sub-`infer` calls into soundness hypotheses for the function and argument,
this lemma consumes the translated raw App and produces the declaration typing
witness for the translated application. -/
theorem infer_sound_app_decl_case_of_translation
    {sig : DIndGArtifactSig}
    {rawFn rawArg : DIndGArtifactTerm} {term : PureTm 0}
    {argType : PureTm 0} {bodyType : PureTm 1}
    (hAppTr :
      DIndGArtifactTermTranslates sig.nameTranslates 0 (.app rawFn rawArg) term)
    (hFnSound :
      ∀ {fn : PureTm 0},
        DIndGArtifactTermTranslates sig.nameTranslates 0 rawFn fn →
          HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil fn (.pi argType bodyType))
    (hArgSound :
      ∀ {arg : PureTm 0},
        DIndGArtifactTermTranslates sig.nameTranslates 0 rawArg arg →
          HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil arg argType) :
    ∃ fn arg : PureTm 0,
      term = .app fn arg ∧
        HasTypeDecl (envOfSpecs sig.translatedSpecs) .nil term (inst0 arg bodyType) := by
  rcases DIndGArtifactTermTranslates.app_inv hAppTr with
    ⟨fn, arg, rfl, hFnTr, hArgTr⟩
  exact ⟨fn, arg, rfl,
    infer_sound_app_decl_case (sig := sig) (hFnSound hFnTr) (hArgSound hArgTr)⟩

/-- A first closed kernel soundness fact for SR-2b: LeaTTa/MOPS fires the
kernel's `infer (Srt type)` rule on the real Stage-3 artifact signature, and
the resulting readout is consumed by the declaration-calculus derivation
`Srt type : Srt kind`. -/
theorem infer_srt_type_mops_sound :
    Metta.MopsStep kernelCoreRules
      (inferQuery cicStage3RawArtifactSig (.srt .type))
      (termAtom (.srt .kind)) ∧
    HasTypeDecl (envOfSpecs cicStage3RawArtifactSig.translatedSpecs) .nil .u0 .u1 := by
  exact ⟨infer_srt_type_mops_step, infer_srt_type_decl_sound⟩

/-- Corollary of `infer_sound_srt` for the concrete runtime readout. -/
theorem infer_srt_type_core_eval_sound :
    termAtom (.srt .kind) ∈
        (mettaEval kernelCoreEnv 1 St.init []
          (inferQuery cicStage3RawArtifactSig (.srt .type))).1.map (·.1) ∧
      HasTypeDecl (envOfSpecs cicStage3RawArtifactSig.translatedSpecs) .nil .u0 .u1 := by
  constructor
  · rw [infer_srt_type_core_mettaEval_readout]
    simp
  · have hinfer :
        evaluator.infer cicStage3RawArtifactSig (.srt .type) (.srt .kind) := by
      change termAtom (.srt .kind) ∈
        (mettaEval kernelCoreEnv 1 St.init []
          (inferQuery cicStage3RawArtifactSig (.srt .type))).1.map (·.1)
      rw [infer_srt_type_core_mettaEval_readout]
      simp
    exact infer_sound_srt hinfer
      DIndGArtifactTermTranslates.srt_type
      DIndGArtifactTermTranslates.srt_kind

private theorem cicStage3RawArtifactSig_primary_nf_defn_output_mem_implies_fresh_root_output_mem
    {fuel : Nat} {st : St} {name : DeclName} {out : Metta.Atom}
    (hWorld : st.world = St.init.world)
    (hOut :
      out ∈
        (mettaEval kernelDefControlEnv (fuel + 1) st []
          (nfQuery cicStage3RawArtifactSig (.defn name))).1.map (·.1)) :
    let counter := st.counter + nfDefCandidatePreWithIndGZeroIota.length
    let binder := counterSuffix counter "body"
    let stRoot : St :=
      { counter := st.counter + nfDefCandidatePreWithIndGZeroIota.length + 1,
        world := st.world }
    ∃ outBnd,
      (out, outBnd) ∈
        (mettaEval kernelDefControlEnv fuel stRoot []
          (leattaDefControlPrimaryNfDefFreshRootNamed name binder)).1 := by
  dsimp
  let counter := st.counter + nfDefCandidatePreWithIndGZeroIota.length
  let binder := counterSuffix counter "body"
  let rootBnd : Metta.Bindings :=
    (renameBindings (counterSuffix counter)
      (nfDefRuleBindings cicStage3RawArtifactSig name)).reverse
  let root : Metta.Atom :=
    Metta.instantiate rootBnd
      (freshenRule counter nfDefRuleLhs nfDefRuleRhs).2
  let stRoot : St :=
    { counter := st.counter + nfDefCandidatePreWithIndGZeroIota.length + 1,
      world := st.world }
  have hStatic : st.world.selfExtra = [] := by
    rw [hWorld]
    rfl
  have hRootEq :
      root = leattaDefControlPrimaryNfDefFreshRootNamed name binder := by
    simpa [root, rootBnd, binder, counter] using
      leattaDefControlPrimary_nfDefFreshRoot_named_eq counter name
  have hRoot :
      interpretFuel kernelDefControlEnv (fuel + 1) st
          [evalItemNil (nfQuery cicStage3RawArtifactSig (.defn name))] [] =
        ([(root, rootBnd)], stRoot) := by
    simpa [root, rootBnd, stRoot, counter] using
      interpretFuel_kernelDefControlEnv_nf_def_root_eq
        (fuel := fuel) (st := st)
        cicStage3RawArtifactSig name hStatic
  have hNoErr :
      (([sigAtom cicStage3RawArtifactSig,
          termAtom (.defn name)].zip
        [sigAtom cicStage3RawArtifactSig,
          termAtom (.defn name)]).find?
        (fun ho : Metta.Atom × Metta.Atom => ho.1.isError && ho.1 != ho.2)) = none := by
    simp [sigAtom_isError_false, termAtom_isError_false]
  have hRootNotNR : (root == notReducibleA) = false := by
    rw [hRootEq]
    rfl
  have hRootNotSelf :
      (root == nfQuery cicStage3RawArtifactSig (.defn name)) = false := by
    rw [hRootEq]
    rfl
  rcases List.mem_map.mp hOut with ⟨⟨actual, outBnd⟩, hPair, hActual⟩
  dsimp at hActual
  subst actual
  rcases
      mettaEval_binary_expr_pair_mem_implies_root_eval_mem_of_quoted_args_and_root_eval_eq_bnd
        (env := kernelDefControlEnv) (fuel := fuel) (st := st)
        (stRoot := stRoot) (op := "nf")
        (x := sigAtom cicStage3RawArtifactSig)
        (y := termAtom (.defn name))
        (root := root) (final := out) (rootBnd := rootBnd)
        (outBnd := outBnd)
        (hType := kernelDefControlEnv_nf_typeMismatch st
          cicStage3RawArtifactSig (.defn name))
        (hMask := kernelDefControlEnv_nf_argMask)
        (hNoErr := hNoErr)
        (hRoot := by simpa [nfQuery, mExpr, mSym] using hRoot)
        (hRootNotNotReducible := hRootNotNR)
        (hRootNotSelf := by simpa [nfQuery, mExpr, mSym] using hRootNotSelf)
