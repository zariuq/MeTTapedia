          (mettaEval env fuel st [] x).1.map
            (fun p =>
              ([p.1],
                restrictBnd ([] : List String)
                  ((Metta.Bindings.merge [] p.2).head?.getD p.2))) →
          P acc0.2 →
            P (mettaEval env fuel acc0.2 part.2 y).2)
    (hRoot :
      ∀ (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (xOut yOut : Metta.Atom),
        P acc0.2 →
          interpretFuel env (fuel + 1) acc0.2
            [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, xOut, yOut])]
            [] =
          ([(notReducibleA, [])], acc0.2)) :
    P (mettaEval env (fuel + 1) st []
      (Metta.Atom.expr [Metta.Atom.sym op, x, y])).2 := by
  let firstParts : List (List Metta.Atom × Metta.Bindings) :=
    (mettaEval env fuel st [] x).1.map
      (fun p =>
        ([p.1],
          restrictBnd ([] : List String)
            ((Metta.Bindings.merge [] p.2).head?.getD p.2)))
  let firstState : St := (mettaEval env fuel st [] x).2
  let secondFold : List (List Metta.Atom × Metta.Bindings) × St :=
    firstParts.foldl
      (evaluatedArgumentPartFoldStep (mettaEval env fuel)
        ([] : List String) [x, y] y)
      (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
  have hQvars : List.flatMap Metta.Atom.vars [x, y] = [] := by
    simp [List.flatMap, hxClosed, hyClosed]
  have hFirstState' : P firstState := by
    simpa [firstState] using hFirstState
  have hSecondState' :
      ∀ (acc0 : List (List Metta.Atom × Metta.Bindings) × St)
        (part : List Metta.Atom × Metta.Bindings),
        part ∈ firstParts →
          P acc0.2 →
            P (mettaEval env fuel acc0.2 part.2 y).2 := by
    intro acc0 part hpart hP
    exact hSecondState acc0 part (by simpa [firstParts] using hpart) hP
  have hSecondFoldP : P secondFold.2 := by
    simpa [secondFold] using
      evaluatedArgumentPartFold_preserves_state_pred
        (mettaEval env fuel) ([] : List String) [x, y] y firstParts
        (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
        P hFirstState' (by
          intro acc0 part hpart _hclean hP
          exact hSecondState' acc0 part hpart hP)
  have hFirstPartsLength :
      ∀ part ∈ firstParts, part.1.length = 1 := by
    intro part hpart
    rcases
        mettaEval_binary_first_arg_parts_mem
          env fuel ([] : List String) st x part
          (by simpa [firstParts] using hpart) with
      ⟨xOut, _xBnd, _hxMem, hPartEq⟩
    rw [hPartEq]
    rfl
  have hPartFoldP :
      P
        (secondFold.1.foldl
          (mettaEvalExprPartFoldStep env fuel ([] : List String) op [x, y] [] false)
          (([] : List (Metta.Atom × Metta.Bindings)), secondFold.2)).2 := by
    refine
      mettaEvalExprPartFold_preserves_state_pred_of_notReducible_root
        env fuel ([] : List String) op [x, y] [] false P secondFold.1
        (([] : List (Metta.Atom × Metta.Bindings)), secondFold.2)
        hSecondFoldP ?_
    intro acc0 part hpart hclean hP
    have hPartLen : part.1.length = 2 := by
      simpa using
        evaluatedArgumentPartFold_clean_mem_length
          (mettaEval env fuel) ([] : List String) [x, y] y firstParts
          firstState 1 hFirstPartsLength part
          (by simpa [secondFold] using hpart) hclean
    rcases part with ⟨args, partBnd⟩
    cases args with
    | nil =>
        simp at hPartLen
    | cons xOut rest =>
        cases rest with
        | nil =>
            simp at hPartLen
        | cons yOut rest2 =>
            cases rest2 with
            | nil =>
                simpa [evalItemNil, mExpr, mSym] using
                  hRoot acc0 xOut yOut hP
            | cons z zs =>
                simp at hPartLen
  have hFirstStep :
      selectedArgumentFoldStep (mettaEval env fuel) ([] : List String) [x, y]
          ([([], [])], st) (x, true) =
        (firstParts, firstState) := by
    simp [selectedArgumentFoldStep, firstParts, firstState]
  have hPartials :
      ([x, y].zip [true, true]).foldl
          (selectedArgumentFoldStep (mettaEval env fuel)
            ([] : List String) [x, y])
          ([([], [])], st) =
        secondFold := by
    simp only [List.zip_cons_cons, List.zip_nil_left,
      List.foldl_cons, List.foldl_nil]
    rw [hFirstStep]
    rw [selectedArgumentFoldStep_true_eq_evaluatedArgumentPartFold]
  rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
    env fuel st op [x, y] [true, true] false hPolicy hApplicationNotError]
  rw [prioritizeSemanticResults_snd]
  rw [evaluateSelectedApplication_eq_factored]
  dsimp only [evaluateSelectedApplicationFactored]
  rw [hQvars, hPartials]
  rw [selectedResultFoldStep_eq_mettaEvalExprPartFoldStep]
  exact hPartFoldP

private theorem mettaEval_binary_eval_args_part_fold_pair_nonterminal_state_pred_before
    (env : MinEnv) (fuel : Nat) (qvars : List String)
    (op : String) (args : List Metta.Atom) (bnd : Metta.Bindings)
    (returnAtom : Bool)
    (y : Metta.Atom)
    (firstParts : List (List Metta.Atom × Metta.Bindings))
    (firstState : St)
    (out : Metta.Atom) (outBnd : Metta.Bindings)
    (P : St → Prop)
    (hOutNoErr : (out == emptyA || out.isError) = false)
    (hFirstState : P firstState)
    (hSecondState :
      ∀ (acc0 : List (List Metta.Atom × Metta.Bindings) × St)
        (part : List Metta.Atom × Metta.Bindings),
        part ∈ firstParts →
          P acc0.2 →
            P (mettaEval env fuel acc0.2 part.2 y).2)
    (hRootState :
      ∀ (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (part : List Metta.Atom × Metta.Bindings),
        part ∈
          ((firstParts.foldl
            (evaluatedArgumentPartFoldStep (mettaEval env fuel)
              qvars args y)
            (([] : List (List Metta.Atom × Metta.Bindings)), firstState)).1) →
          P acc0.2 →
            P (interpretFuel env (fuel + 1) acc0.2
              [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
                  Metta.Atom.expr (Metta.Atom.sym op :: part.1)]) [],
                 bnd := bnd }] []).2)
    (hRecState :
      ∀ (partBnd : Metta.Bindings)
        (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (p : Metta.Atom × Metta.Bindings),
        P acc0.2 →
          P (mettaEval env fuel acc0.2
            (restrictBnd qvars
              ((Metta.Bindings.merge partBnd p.2).head?.getD p.2))
            p.1).2)
    (hReturns : returnAtom = false)
    (hmem :
      (out, outBnd) ∈
        (((firstParts.foldl
          (evaluatedArgumentPartFoldStep (mettaEval env fuel)
            qvars args y)
          (([] : List (List Metta.Atom × Metta.Bindings)), firstState)).1).foldl
            (mettaEvalExprPartFoldStep env fuel qvars op args bnd returnAtom)
            (([] : List (Metta.Atom × Metta.Bindings)),
              (firstParts.foldl
                (evaluatedArgumentPartFoldStep (mettaEval env fuel)
                  qvars args y)
                (([] : List (List Metta.Atom × Metta.Bindings)),
                  firstState)).2)).1) :
    ∃ firstPart ∈ firstParts,
      ∃ stBeforeY yOut yBnd selectedBnd stPart pairs stRoot,
        P stBeforeY ∧
        (yOut, yBnd) ∈
          (mettaEval env fuel stBeforeY firstPart.2 y).1 ∧
        selectedBnd =
          restrictBnd qvars
            ((Metta.Bindings.merge firstPart.2 yBnd).head?.getD yBnd) ∧
        ((firstPart.1 ++ [yOut]).zip args).find?
            (fun ho : Metta.Atom × Metta.Atom =>
              (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2) = none ∧
        P stPart ∧
        interpretFuel env (fuel + 1) stPart
            [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
                Metta.Atom.expr (Metta.Atom.sym op ::
                  (firstPart.1 ++ [yOut]))]) [],
               bnd := bnd }] [] =
          (pairs, stRoot) ∧
        (out =
            Metta.Atom.expr (Metta.Atom.sym op :: (firstPart.1 ++ [yOut])) ∨
          ∃ root rootBnd stBefore recBnd,
            P stBefore ∧
            (root, rootBnd) ∈ pairs ∧
            (root == notReducibleA) = false ∧
            (root ==
              Metta.Atom.expr (Metta.Atom.sym op ::
                (firstPart.1 ++ [yOut]))) = false ∧
            (out, recBnd) ∈
              (mettaEval env fuel stBefore
                (restrictBnd qvars
                  ((Metta.Bindings.merge selectedBnd rootBnd).head?.getD
                    rootBnd))
                root).1) := by
  let secondFold : List (List Metta.Atom × Metta.Bindings) × St :=
    firstParts.foldl
      (evaluatedArgumentPartFoldStep (mettaEval env fuel) qvars args y)
      (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
  have hSecondFoldP : P secondFold.2 := by
    simpa [secondFold] using
      evaluatedArgumentPartFold_preserves_state_pred
        (mettaEval env fuel) qvars args y firstParts
        (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
        P hFirstState (by
          intro acc0 part hpart _hclean hP
          exact hSecondState acc0 part hpart hP)
  have hPartStepState :
      ∀ (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (part : List Metta.Atom × Metta.Bindings),
        part ∈ secondFold.1 →
          P acc0.2 →
            P (mettaEvalExprPartFoldStep env fuel qvars op args bnd
              returnAtom acc0 part).2 := by
    intro acc0 part hpart hP
    exact
      mettaEvalExprPartFoldStep_preserves_state_pred_of_root_point
        env fuel qvars op args bnd returnAtom P part
        (fun acc1 hP1 => by
          simpa [secondFold] using hRootState acc1 part hpart hP1)
        hRecState acc0 hP
  have hPartInv :=
    mettaEvalExprPartFold_pair_nonterminal_state_pred_before
      env fuel qvars op args bnd returnAtom secondFold.1
      (([] : List (Metta.Atom × Metta.Bindings)), secondFold.2)
      out outBnd P hOutNoErr hSecondFoldP hPartStepState
      (by
        intro acc0 part hpart hP
        simpa [secondFold] using hRootState acc0 part hpart hP)
      hRecState hReturns
      (by simpa [secondFold] using hmem)
  rcases hPartInv with hnil | hpart
  · cases hnil
  · rcases hpart with
      ⟨selectedPart, hSelectedMem, stPart, pairs, stRoot,
        hNoErr, hPPart, hRootEq, hcase⟩
    rcases selectedPart with ⟨selectedArgs, selectedBnd0⟩
    have hSelectedInv :=
      mettaEval_binary_second_arg_fold_pair_state_pred_before
        env fuel qvars args y firstParts
        (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
        selectedArgs selectedBnd0 P hFirstState hSecondState
        (by simpa [secondFold] using hSelectedMem) hNoErr
    rcases hSelectedInv with hnilSelected | hselected
    · cases hnilSelected
    · rcases hselected with
        ⟨firstPart, hFirstPart, stBeforeY, yOut, yBnd,
          hPY, hY, hSelectedEq⟩
      cases hSelectedEq
      exact
        ⟨firstPart, hFirstPart, stBeforeY, yOut, yBnd,
          restrictBnd qvars
            ((Metta.Bindings.merge firstPart.2 yBnd).head?.getD yBnd),
          stPart, pairs, stRoot,
          hPY, hY, rfl, hNoErr, hPPart, hRootEq, hcase⟩

private theorem mettaEval_binary_eval_args_pair_nonterminal_state_pred_before_closed
    (env : MinEnv) (fuel : Nat) (st : St)
    (op : String) (x y : Metta.Atom)
    (out : Metta.Atom) (outBnd : Metta.Bindings)
    (P : St → Prop)
    (hxClosed : x.vars = []) (hyClosed : y.vars = [])
    (hPolicy : RecursionNeutralApplicationPolicy env st.world op [x, y]
      [true, true] false)
    (hApplicationNotError :
      (Metta.Atom.expr [Metta.Atom.sym op, x, y]).isError = false)
    (hOutNoErr : (out == emptyA || out.isError) = false)
    (hFirstState : P (mettaEval env fuel st [] x).2)
    (hSecondState :
      ∀ (acc0 : List (List Metta.Atom × Metta.Bindings) × St)
        (xOut : Metta.Atom) (xBnd : Metta.Bindings),
        (xOut, xBnd) ∈ (mettaEval env fuel st [] x).1 →
          P acc0.2 →
            P (mettaEval env fuel acc0.2 [] y).2)
    (hRootState :
      ∀ (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (argsOut : List Metta.Atom),
        P acc0.2 →
          P (interpretFuel env (fuel + 1) acc0.2
            [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
                Metta.Atom.expr (Metta.Atom.sym op :: argsOut)]) [],
               bnd := [] }] []).2)
    (hRecState :
      ∀ (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (p : Metta.Atom × Metta.Bindings),
        P acc0.2 →
          P (mettaEval env fuel acc0.2 [] p.1).2)
    (hmem :
      (out, outBnd) ∈
        (mettaEval env (fuel + 1) st []
          (Metta.Atom.expr [Metta.Atom.sym op, x, y])).1) :
    ∃ xOut xBnd,
      (xOut, xBnd) ∈ (mettaEval env fuel st [] x).1 ∧
      ∃ stBeforeY yOut yBnd stPart pairs stRoot,
        P stBeforeY ∧
        (yOut, yBnd) ∈ (mettaEval env fuel stBeforeY [] y).1 ∧
        (([xOut, yOut].zip [x, y]).find?
          (fun ho : Metta.Atom × Metta.Atom =>
            (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none ∧
        P stPart ∧
        interpretFuel env (fuel + 1) stPart
            [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
                Metta.Atom.expr [Metta.Atom.sym op, xOut, yOut]]) [],
               bnd := [] }] [] =
          (pairs, stRoot) ∧
        (out = Metta.Atom.expr [Metta.Atom.sym op, xOut, yOut] ∨
          ∃ root rootBnd stBefore recBnd,
            P stBefore ∧
            (root, rootBnd) ∈ pairs ∧
            (root == notReducibleA) = false ∧
            (root ==
              Metta.Atom.expr [Metta.Atom.sym op, xOut, yOut]) = false ∧
            (out, recBnd) ∈
              (mettaEval env fuel stBefore [] root).1) := by
  let firstParts : List (List Metta.Atom × Metta.Bindings) :=
    (mettaEval env fuel st [] x).1.map
      (fun p => ([p.1], ([] : Metta.Bindings)))
  let firstState : St := (mettaEval env fuel st [] x).2
  let secondFold : List (List Metta.Atom × Metta.Bindings) × St :=
    firstParts.foldl
      (evaluatedArgumentPartFoldStep (mettaEval env fuel)
        ([] : List String) [x, y] y)
      (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
  have hQvars : List.flatMap Metta.Atom.vars [x, y] = [] := by
    simp [List.flatMap, hxClosed, hyClosed]
  have hSecondState' :
      ∀ (acc0 : List (List Metta.Atom × Metta.Bindings) × St)
        (part : List Metta.Atom × Metta.Bindings),
        part ∈ firstParts →
          P acc0.2 →
            P (mettaEval env fuel acc0.2 part.2 y).2 := by
    intro acc0 part hpart hP
    have hpartRaw :
        part ∈
          (mettaEval env fuel st [] x).1.map
            (fun p =>
              ([p.1],
                restrictBnd ([] : List String)
                  ((Metta.Bindings.merge [] p.2).head?.getD p.2))) := by
      simpa [firstParts, restrictBnd_nil_vars] using hpart
    rcases
        mettaEval_binary_first_arg_parts_mem
          env fuel ([] : List String) st x part hpartRaw with
      ⟨xOut, xBnd, hxMem, hpartEq⟩
    cases hpartEq
    simpa [restrictBnd_nil_vars] using
      hSecondState acc0 xOut xBnd hxMem hP
  have hRootState' :
      ∀ (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (part : List Metta.Atom × Metta.Bindings),
        part ∈ secondFold.1 →
          P acc0.2 →
            P (interpretFuel env (fuel + 1) acc0.2
              [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
                  Metta.Atom.expr (Metta.Atom.sym op :: part.1)]) [],
                 bnd := [] }] []).2 := by
    intro acc0 part _hpart hP
    exact hRootState acc0 part.1 hP
  have hRecState' :
      ∀ (partBnd : Metta.Bindings)
        (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (p : Metta.Atom × Metta.Bindings),
        P acc0.2 →
          P (mettaEval env fuel acc0.2
            (restrictBnd ([] : List String)
              ((Metta.Bindings.merge partBnd p.2).head?.getD p.2))
            p.1).2 := by
    intro partBnd acc0 p hP
    simpa [restrictBnd_nil_vars] using hRecState acc0 p hP
  have hReturns' : false = false := rfl
  have hmemPart :
      (out, outBnd) ∈
        (secondFold.1.foldl
            (mettaEvalExprPartFoldStep env fuel ([] : List String) op [x, y] [] false)
            (([] : List (Metta.Atom × Metta.Bindings)), secondFold.2)).1 := by
    rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
      env fuel st op [x, y] [true, true] false hPolicy hApplicationNotError] at hmem
    have hmemRaw := mem_of_mem_prioritizeSemanticResults hmem
    rw [evaluateSelectedApplication_eq_factored] at hmemRaw
    dsimp only [evaluateSelectedApplicationFactored] at hmemRaw
    rw [hQvars] at hmemRaw
    have hFirstStep :
        selectedArgumentFoldStep (mettaEval env fuel) ([] : List String) [x, y]
            ([([], [])], st) (x, true) =
          (firstParts, firstState) := by
      simp [selectedArgumentFoldStep, firstParts, firstState,
        restrictBnd_nil_vars]
    have hPartials :
        ([x, y].zip [true, true]).foldl
            (selectedArgumentFoldStep (mettaEval env fuel)
              ([] : List String) [x, y])
            ([([], [])], st) =
          secondFold := by
      simp only [List.zip_cons_cons, List.zip_nil_left,
        List.foldl_cons, List.foldl_nil]
      rw [hFirstStep]
      rw [selectedArgumentFoldStep_true_eq_evaluatedArgumentPartFold]
    rw [hPartials] at hmemRaw
    rw [selectedResultFoldStep_eq_mettaEvalExprPartFoldStep] at hmemRaw
    exact hmemRaw
  rcases
      mettaEval_binary_eval_args_part_fold_pair_nonterminal_state_pred_before
        env fuel ([] : List String) op [x, y] [] false y firstParts firstState
        out outBnd P hOutNoErr hFirstState hSecondState'
        hRootState' hRecState' hReturns' hmemPart with
    ⟨firstPart, hFirstPart, stBeforeY, yOut, yBnd, selectedBnd,
      stPart, pairs, stRoot, hPY, hY, hSelectedBnd, hNoErr,
      hPPart, hRootEq, hcase⟩
  have hfirstRaw :
      firstPart ∈
        (mettaEval env fuel st [] x).1.map
          (fun p =>
            ([p.1],
              restrictBnd ([] : List String)
                ((Metta.Bindings.merge [] p.2).head?.getD p.2))) := by
    simpa [firstParts, restrictBnd_nil_vars] using hFirstPart
  rcases
      mettaEval_binary_first_arg_parts_mem
        env fuel ([] : List String) st x firstPart hfirstRaw with
    ⟨xOut, xBnd, hxMem, hFirstEq⟩
  cases hFirstEq
  have hSelectedNil : selectedBnd = [] := by
    simpa [restrictBnd_nil_vars] using hSelectedBnd
  subst selectedBnd
  refine ⟨xOut, xBnd, hxMem, stBeforeY, yOut, yBnd,
    stPart, pairs, stRoot, hPY, ?_, ?_, hPPart, ?_, ?_⟩
  · simpa [restrictBnd_nil_vars] using hY
  · simpa using hNoErr
  · simpa [mExpr, mSym] using hRootEq
  · simpa [mExpr, mSym, restrictBnd_nil_vars] using hcase

private theorem mettaEval_binary_eval_args_pair_nonterminal_notReducible_state_pred_before_closed
    (env : MinEnv) (fuel : Nat) (st : St)
    (op : String) (x y : Metta.Atom)
    (out : Metta.Atom) (outBnd : Metta.Bindings)
    (P : St → Prop)
    (hxClosed : x.vars = []) (hyClosed : y.vars = [])
    (hPolicy : RecursionNeutralApplicationPolicy env st.world op [x, y]
      [true, true] false)
    (hApplicationNotError :
      (Metta.Atom.expr [Metta.Atom.sym op, x, y]).isError = false)
    (hOutNoErr : (out == emptyA || out.isError) = false)
    (hFirstState : P (mettaEval env fuel st [] x).2)
    (hSecondState :
      ∀ (acc0 : List (List Metta.Atom × Metta.Bindings) × St)
        (xOut : Metta.Atom) (xBnd : Metta.Bindings),
        (xOut, xBnd) ∈ (mettaEval env fuel st [] x).1 →
          P acc0.2 →
            P (mettaEval env fuel acc0.2 [] y).2)
    (hRoot :
      ∀ (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (xOut yOut : Metta.Atom),
        P acc0.2 →
          interpretFuel env (fuel + 1) acc0.2
            [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, xOut, yOut])]
            [] =
          ([(notReducibleA, [])], acc0.2))
    (hmem :
      (out, outBnd) ∈
        (mettaEval env (fuel + 1) st []
          (Metta.Atom.expr [Metta.Atom.sym op, x, y])).1) :
    ∃ xOut xBnd,
      (xOut, xBnd) ∈ (mettaEval env fuel st [] x).1 ∧
      ∃ stBeforeY yOut yBnd,
        P stBeforeY ∧
        (yOut, yBnd) ∈ (mettaEval env fuel stBeforeY [] y).1 ∧
        (([xOut, yOut].zip [x, y]).find?
          (fun ho : Metta.Atom × Metta.Atom =>
            (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none ∧
        out = Metta.Atom.expr [Metta.Atom.sym op, xOut, yOut] := by
  let firstParts : List (List Metta.Atom × Metta.Bindings) :=
    (mettaEval env fuel st [] x).1.map
      (fun p => ([p.1], ([] : Metta.Bindings)))
  let firstState : St := (mettaEval env fuel st [] x).2
  let secondFold : List (List Metta.Atom × Metta.Bindings) × St :=
    firstParts.foldl
      (evaluatedArgumentPartFoldStep (mettaEval env fuel)
        ([] : List String) [x, y] y)
      (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
  have hQvars : List.flatMap Metta.Atom.vars [x, y] = [] := by
    simp [List.flatMap, hxClosed, hyClosed]
  have hSecondState' :
      ∀ (acc0 : List (List Metta.Atom × Metta.Bindings) × St)
        (part : List Metta.Atom × Metta.Bindings),
        part ∈ firstParts →
          P acc0.2 →
            P (mettaEval env fuel acc0.2 part.2 y).2 := by
    intro acc0 part hpart hP
    have hpartRaw :
        part ∈
          (mettaEval env fuel st [] x).1.map
            (fun p =>
              ([p.1],
                restrictBnd ([] : List String)
                  ((Metta.Bindings.merge [] p.2).head?.getD p.2))) := by
      simpa [firstParts, restrictBnd_nil_vars] using hpart
    rcases
        mettaEval_binary_first_arg_parts_mem
          env fuel ([] : List String) st x part hpartRaw with
      ⟨xOut, xBnd, hxMem, hpartEq⟩
    cases hpartEq
    simpa [restrictBnd_nil_vars] using
      hSecondState acc0 xOut xBnd hxMem hP
  have hSecondFoldP : P secondFold.2 := by
    simpa [secondFold] using
      evaluatedArgumentPartFold_preserves_state_pred
        (mettaEval env fuel) ([] : List String) [x, y] y firstParts
        (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
        P hFirstState (by
          intro acc0 part hpart _hclean hP
          exact hSecondState' acc0 part hpart hP)
  have hRootParts :
      ∀ (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (part : List Metta.Atom × Metta.Bindings),
        part ∈ secondFold.1 →
          ((part.1.zip [x, y]).find?
            (fun pair => (pair.1 == emptyA || pair.1.isError) && pair.1 != pair.2)) = none →
          P acc0.2 →
            interpretFuel env (fuel + 1) acc0.2
              [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
                  Metta.Atom.expr (Metta.Atom.sym op :: part.1)]) [],
                 bnd := [] }] [] =
              ([(notReducibleA, [])], acc0.2) := by
    intro acc0 part hpart hclean hP
    have hSelectedInv :=
      mettaEval_binary_second_arg_fold_pair_state_pred_before
        env fuel ([] : List String) [x, y] y firstParts
        (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
        part.1 part.2 P hFirstState hSecondState'
        (by simpa [secondFold] using hpart) hclean
    rcases hSelectedInv with hnil | hselected
    · cases hnil
    · rcases hselected with
        ⟨firstPart, hFirstPart, _stBeforeY, yOut, yBnd,
          _hPY, _hY, hPartEq⟩
      have hfirstRaw :
          firstPart ∈
            (mettaEval env fuel st [] x).1.map
              (fun p =>
                ([p.1],
                  restrictBnd ([] : List String)
                    ((Metta.Bindings.merge [] p.2).head?.getD p.2))) := by
        simpa [firstParts, restrictBnd_nil_vars] using hFirstPart
      rcases
          mettaEval_binary_first_arg_parts_mem
            env fuel ([] : List String) st x firstPart hfirstRaw with
        ⟨xOut, xBnd, _hxMem, hFirstEq⟩
      cases hFirstEq
      have hPartArgs : part.1 = [xOut, yOut] := by
        have hFst := congrArg Prod.fst hPartEq
        simpa [restrictBnd_nil_vars] using hFst
      rw [hPartArgs]
      simpa [evalItemNil, mExpr, mSym] using hRoot acc0 xOut yOut hP
  have hmemPart :
      (out, outBnd) ∈
        (secondFold.1.foldl
          (mettaEvalExprPartFoldStep env fuel ([] : List String) op [x, y] [] false)
          (([] : List (Metta.Atom × Metta.Bindings)), secondFold.2)).1 := by
    rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
      env fuel st op [x, y] [true, true] false hPolicy hApplicationNotError] at hmem
    have hmemRaw := mem_of_mem_prioritizeSemanticResults hmem
    rw [evaluateSelectedApplication_eq_factored] at hmemRaw
    dsimp only [evaluateSelectedApplicationFactored] at hmemRaw
    rw [hQvars] at hmemRaw
    have hFirstStep :
        selectedArgumentFoldStep (mettaEval env fuel) ([] : List String) [x, y]
            ([([], [])], st) (x, true) =
          (firstParts, firstState) := by
      simp [selectedArgumentFoldStep, firstParts, firstState,
        restrictBnd_nil_vars]
    have hPartials :
        ([x, y].zip [true, true]).foldl
            (selectedArgumentFoldStep (mettaEval env fuel)
              ([] : List String) [x, y])
            ([([], [])], st) =
          secondFold := by
      simp only [List.zip_cons_cons, List.zip_nil_left,
        List.foldl_cons, List.foldl_nil]
      rw [hFirstStep]
      rw [selectedArgumentFoldStep_true_eq_evaluatedArgumentPartFold]
    rw [hPartials] at hmemRaw
    rw [selectedResultFoldStep_eq_mettaEvalExprPartFoldStep] at hmemRaw
    exact hmemRaw
  rcases
      mettaEvalExprPartFold_pair_nonterminal_notReducible_state_pred_before
        env fuel ([] : List String) op [x, y] [] false secondFold.1
        (([] : List (Metta.Atom × Metta.Bindings)), secondFold.2)
        out outBnd P hOutNoErr hSecondFoldP hRootParts hmemPart with
    hnil | hpart
  · cases hnil
  · rcases hpart with
      ⟨selectedPart, hSelectedMem, stBeforeRoot, _hPRoot, hFind,
        hOutEq, _hBndEq⟩
    rcases selectedPart with ⟨selectedArgs, selectedBnd0⟩
    have hSelectedInv :=
      mettaEval_binary_second_arg_fold_pair_state_pred_before
        env fuel ([] : List String) [x, y] y firstParts
        (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
        selectedArgs selectedBnd0 P hFirstState hSecondState'
        (by simpa [secondFold] using hSelectedMem) hFind
    rcases hSelectedInv with hnilSelected | hselected
    · cases hnilSelected
    · rcases hselected with
        ⟨firstPart, hFirstPart, stBeforeY, yOut, yBnd,
          hPY, hY, hSelectedEq⟩
      have hfirstRaw :
          firstPart ∈
            (mettaEval env fuel st [] x).1.map
              (fun p =>
                ([p.1],
                  restrictBnd ([] : List String)
                    ((Metta.Bindings.merge [] p.2).head?.getD p.2))) := by
        simpa [firstParts, restrictBnd_nil_vars] using hFirstPart
      rcases
          mettaEval_binary_first_arg_parts_mem
            env fuel ([] : List String) st x firstPart hfirstRaw with
        ⟨xOut, xBnd, hxMem, hFirstEq⟩
      cases hFirstEq
      have hSelectedArgs : selectedArgs = [xOut, yOut] := by
        have hFst := congrArg Prod.fst hSelectedEq
        simpa [restrictBnd_nil_vars] using hFst
      rw [hSelectedArgs] at hFind hOutEq
      refine ⟨xOut, xBnd, hxMem, stBeforeY, yOut, yBnd, hPY, ?_, ?_, ?_⟩
      · simpa [restrictBnd_nil_vars] using hY
      · simpa using hFind
      · simpa [mExpr, mSym] using hOutEq

theorem mettaEval_binary_expr_mem_of_quoted_args_and_open_root_eval_member_state_pred
    (env : MinEnv) (fuel : Nat) (st : St)
    (op : String)
    (x y root final : Metta.Atom) (rootBnd : Metta.Bindings)
    (P : St → Prop)
    (hPolicy : RecursionNeutralApplicationPolicy env st.world op [x, y]
      [false, false] false)
    (hApplicationNotError :
      (Metta.Atom.expr [Metta.Atom.sym op, x, y]).isError = false)
    (hNoErr :
      (([x, y].zip [x, y]).find?
        (fun ho => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none)
    (hinit : P st)
    (hrootState :
      ∀ acc : List (Metta.Atom × Metta.Bindings) × St,
        P acc.2 →
          P (interpretFuel env (fuel + 1) acc.2
            [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y])] []).2)
    (hrecState :
      ∀ (acc : List (Metta.Atom × Metta.Bindings) × St)
        (p : Metta.Atom × Metta.Bindings),
        P acc.2 →
          P (mettaEval env fuel acc.2
            (restrictBnd (([x, y]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] p.2).head?.getD p.2)) p.1).2)
    (hRoot : (root, rootBnd) ∈
      (interpretFuel env (fuel + 1) st
        [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y])] []).1)
    (hRootNotNotReducible : (root == notReducibleA) = false)
    (hRootNotSelf : (root == Metta.Atom.expr [Metta.Atom.sym op, x, y]) = false)
    (hFinal : ∀ st0,
      P st0 →
        (final, []) ∈
          (mettaEval env fuel st0
            (restrictBnd (([x, y]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) root).1)
    (hFinalNotError : final.isError = false) :
    (final,
        restrictBnd (([x, y]).flatMap Metta.Atom.vars)
          (((restrictBnd (([x, y]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)).merge
              ([] : Metta.Bindings)).head?.getD [])) ∈
      (mettaEval env (fuel + 1) st []
        (Metta.Atom.expr [Metta.Atom.sym op, x, y])).1 := by
  let qvars := ([x, y]).flatMap Metta.Atom.vars
  rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
    env fuel st op [x, y] [false, false] false hPolicy hApplicationNotError]
  apply mem_prioritizeSemanticResults_of_mem_of_not_error
    (hError := hFinalNotError)
  rw [evaluateSelectedApplication_eq_factored]
  have hMask :
      [false, false] = List.replicate ([x, y]).length false := by
    rfl
  rw [hMask]
  rw [evaluateSelectedApplicationFactored_all_quoted_eq_mettaEvalExprPartFoldStep
    env fuel st [] op [x, y] false hNoErr]
  let rootItem : Item :=
    { stack := atomToStack
        (Metta.Atom.expr
          [Metta.Atom.sym "eval", Metta.Atom.expr [Metta.Atom.sym op, x, y]]) []
      bnd := [] }
  cases hpairs : interpretFuel env (fuel + 1) st [rootItem] [] with
  | mk pairs stRoot =>
      have hpairsExact :
          interpretFuel env (fuel + 1) st
              [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
                  Metta.Atom.expr [Metta.Atom.sym op, x, y]]) [],
                 bnd := [] }] [] =
            (pairs, stRoot) := by
        simpa [rootItem] using hpairs
      have hRootPairs : (root, rootBnd) ∈ pairs := by
        have hrootItem :
            [rootItem] = [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y])] := by
          simp [rootItem, evalItemNil]
        rw [hrootItem] at hpairs
        rw [hpairs] at hRoot
        exact hRoot
      have hRootState : P stRoot := by
        have hrootItem :
            [rootItem] = [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y])] := by
          simp [rootItem, evalItemNil]
        have hstate := hrootState ([], st) hinit
        rw [hrootItem] at hpairs
        rw [hpairs] at hstate
        exact hstate
      have hfold :=
        mettaEval_expr_root_evals_selected_readout_state_pred
          env fuel qvars (Metta.Atom.expr [Metta.Atom.sym op, x, y]) [] false
          P (root, rootBnd) pairs stRoot final
          hRootPairs hRootNotNotReducible hRootNotSelf rfl hRootState
          (by
            intro acc p hP
            simpa [qvars] using hrecState acc p hP)
          (by
            intro st0 hP
            simpa [qvars] using hFinal st0 hP)
      unfold mettaEvalExprPartFoldStep
      rw [hNoErr]
      simp only [List.nil_append]
      rw [hpairsExact]
      simpa [qvars] using hfold

theorem nf_interpretFuel_root_pair_mem_mettaEval_kernelEnv_state
    {st : St} {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {rootOut : Metta.Atom} {rootBnd : Metta.Bindings}
    (hTypes : KernelEnvTypeWorld st.world)
    (hroot :
      (rootOut, rootBnd) ∈
        (interpretFuel kernelEnv 1 st
          [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", nfQuery sig raw]) []
             bnd := [] }] []).1)
    (_hembed : isEmbeddedOp rootOut = false)
    (hnotNR : (rootOut == notReducibleA) = false)
    (hnotSelf : (rootOut == nfQuery sig raw) = false)
    (hRootNotError : rootOut.isError = false) :
    (rootOut, []) ∈
      (mettaEval kernelEnv 1 st [] (nfQuery sig raw)).1 := by
  change (rootOut, []) ∈
    (mettaEval kernelEnv 1 st []
      (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw])).1
  rw [mettaEval_eq_evaluateSelectedApplication_of_exactPolicy
    kernelEnv 0 st "nf" [sigAtom sig, termAtom raw] [false, false] true
    (kernelEnv_nf_recursionNeutralPolicy st (sigAtom sig) (termAtom raw) hTypes.nf)
    (by simp [Metta.Atom.isError])]
  apply mem_prioritizeSemanticResults_of_mem_of_not_error
    (hError := hRootNotError)
  rw [evaluateSelectedApplication_eq_factored]
  have hMask :
      [false, false] =
        List.replicate ([sigAtom sig, termAtom raw]).length false := by
    rfl
  rw [hMask]
  have hnoerr :
      (([sigAtom sig, termAtom raw].zip [sigAtom sig, termAtom raw]).find?
        (fun ho : Metta.Atom × Metta.Atom =>
          (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none := by
    simp [sigAtom_isError_false, termAtom_isError_false]
  rw [evaluateSelectedApplicationFactored_all_quoted_eq_mettaEvalExprPartFoldStep
    kernelEnv 0 st [] "nf" [sigAtom sig, termAtom raw] true hnoerr]
  have hnotSelf' :
      (rootOut == Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) = false := by
    simpa [nfQuery, mExpr, mSym] using hnotSelf
  cases hpairs : interpretFuel kernelEnv 1 st
      [{ stack := atomToStack
          (Metta.Atom.expr [Metta.Atom.sym "eval",
            Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]]) []
         bnd := [] }] [] with
  | mk pairs st' =>
      have hrootExpanded :
          (rootOut, rootBnd) ∈
            (interpretFuel kernelEnv 1 st
              [{ stack := atomToStack
                  (Metta.Atom.expr [Metta.Atom.sym "eval",
                    Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]]) []
                 bnd := [] }] []).1 := by
        simpa [nfQuery, mExpr, mSym] using hroot
      have hrootPairs : (rootOut, rootBnd) ∈ pairs := by
        rw [hpairs] at hrootExpanded
        simpa using hrootExpanded
      have hkeep :
          (rootOut,
              restrictBnd ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                ((Bindings.merge [] rootBnd).head?.getD rootBnd)) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelEnv 0
                ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [] true)
              ([], st')).1 :=
        mettaEval_expr_root_keeps_of_returnsAtom_readout
          kernelEnv 0 ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
          (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [] true
          (rootOut, rootBnd) pairs st'
          hrootPairs rfl
          hnotNR hnotSelf'
      have hkeep' :
          (rootOut, []) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelEnv 0 []
                (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [] true)
              ([], st')).1 := by
        simpa [restrictBnd_nil_vars, List.flatMap, sigAtom_vars_nil sig, termAtom_vars_nil raw]
          using hkeep
      unfold mettaEvalExprPartFoldStep
      rw [hnoerr]
      simp only [List.nil_append]
      rw [hpairs]
      have hqvars :
          [sigAtom sig, termAtom raw].flatMap Metta.Atom.vars = [] := by
        simp [sigAtom_vars_nil sig, termAtom_vars_nil raw]
      rw [hqvars]
      simpa using hkeep'

/-- Select one concrete `nf` equality rule from the public executable kernel.

The public kernel has one additional `nf Def` candidate, so global equality
with `kernelCoreEnv` is no longer true.  For the old non-`Def` root rules we
instead select the intended candidate directly from `kernelEnv`; because the
new candidate is appended after the original root rules, the selected rule's
freshening counter is unchanged. -/
theorem interpretFuel_kernelEnv_nf_selected_rule_contains
    {fuel : Nat} {st : St} {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {lhs rhs : Metta.Atom} {coreB : Metta.Bindings}
    {pre post : List (Metta.Atom × Metta.Atom)}
    (hstatic : st.world.selfExtra = [])
    (hclosedB : ClosedValueBindings coreB)
    (hnodup : (bindingValueKeys coreB).Nodup)
    (hsplit : kernelEnv.candidates (nfQuery sig raw) = pre ++ (lhs, rhs) :: post)
    (hmatchCore : coreB ∈ Metta.matchAtoms lhs (nfQuery sig raw))
    (hnotEmpty :
      (Metta.instantiate
        (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse
        (freshenRule (st.counter + pre.length) lhs rhs).2 != emptyA) = true)
    (hnotFunction :
      isFunctionResult
        (Metta.instantiate
          (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse
          (freshenRule (st.counter + pre.length) lhs rhs).2) = false) :
    (Metta.instantiate
        (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse
        (freshenRule (st.counter + pre.length) lhs rhs).2,
      (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st [evalItemNil (nfQuery sig raw)] []).1 := by
  let mb : Metta.Bindings :=
    renameBindings (counterSuffix (st.counter + pre.length)) coreB
  let m : Metta.Bindings := mb.reverse
  let out : Metta.Atom :=
    Metta.instantiate m (freshenRule (st.counter + pre.length) lhs rhs).2
  have hclosedTarget : (nfQuery sig raw).vars = [] := by
    simp [nfQuery, sigAtom_vars_nil sig, termAtom_vars_nil raw, mExpr, mSym,
      Metta.Atom.vars]
  have hmatchFresh : mb ∈
      Metta.matchAtoms (freshenRule (st.counter + pre.length) lhs rhs).1
        (nfQuery sig raw) := by
    simpa [mb] using
      matchAtoms_freshenRule_lhs_closed_target_mem
        (st.counter + pre.length) hclosedTarget hmatchCore
  have hcompat : LegacyFresheningCompatible [] (nfQuery sig raw) []
      (st.counter + pre.length) lhs rhs :=
    legacyFresheningCompatible_empty_of_target_vars_nil
      (st.counter + pre.length) (nfQuery sig raw) lhs rhs hclosedTarget
  have hmatchFreshAvoiding : mb ∈
      Metta.matchAtoms
        (freshenRuleAvoiding (st.counter + pre.length)
          (Metta.Minimal.queryOpAvoid [] (nfQuery sig raw) []) lhs rhs).1.1
        (nfQuery sig raw) := by
    rw [hcompat]
    exact hmatchFresh
  have hmerge : m ∈ Metta.Bindings.merge [] mb := by
    simpa [m, mb] using
      (merge_empty_renamed_closed_nodup_mem
        (counterSuffix_injective (st.counter + pre.length)) hclosedB hnodup)
  have hclosedMb : ClosedValueBindings mb := by
    simpa [mb] using
      (ClosedValueBindings.rename
        (f := counterSuffix (st.counter + pre.length)) hclosedB)
  have hclosedM : ClosedValueBindings m := by
    simpa [m] using ClosedValueBindings.reverse hclosedMb
  have hloop : Metta.Bindings.hasLoop m = false := by
    simpa [m] using ClosedValueBindings.hasLoop_false hclosedM
  have hquery :
      evalResult [] out m ∈
        (queryOp kernelEnv st [] (nfQuery sig raw) []).1 := by
    simpa [out, m, mb, hcompat] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := kernelEnv) (st := st) (prev := []) (toEval := nfQuery sig raw)
        (b := []) (pre := pre) (post := post) (p := (lhs, rhs))
        (mb := mb) (m := m)
        hstatic
        (by cases raw <;> simp [nfQuery, termAtom, isVariableHeaded, mExpr, mSym])
        hsplit hmatchFreshAvoiding hmerge hloop
  have hstack :
      evalResult [] out m ∈
        (interpretStack1 kernelEnv fuel st (evalItemNil (nfQuery sig raw))).1 := by
    exact
      (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
        kernelEnv fuel st [] (nfQuery sig raw) [] "nf" [sigAtom sig, termAtom raw]
        (evalResult [] out m)
        (by simpa [nfQuery, mExpr, mSym] using
          (Metta.instantiate_nil (nfQuery sig raw)))
        (callGrounded_nf_of_stdGroundings kernelEnv sig raw (by rfl))
        (by rfl)).2 hquery
  have hevalEq : evalResult [] out m = finItem [] out m := by
    have hnot : isFunctionResult out = false := by
      simpa [out, m, mb] using hnotFunction
    simpa [out] using
      (evalResult_nil_eq_finItem_of_not_function (a := out) (b := m) hnot)
  have hfin : isFinal (evalResult [] out m) = true := by
    simp [hevalEq, finItem, isFinal]
  have hstable : Metta.instantiate m out = out := by
    simpa [out] using instantiate_closed_value_bindings_idempotent hclosedM
      (freshenRule (st.counter + pre.length) lhs rhs).2
  have hmem :
      finalPair (evalResult [] out m) ∈
        (interpretFuel kernelEnv (fuel + 1) st [evalItemNil (nfQuery sig raw)] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelEnv fuel st (evalItemNil (nfQuery sig raw)) (evalResult [] out m)
      [] [] hstack hfin (by
        simpa [hevalEq, finItem, finalPair, hstable, out, m, mb] using hnotEmpty)
  simpa [out, m, mb, finalPair, finItem, hevalEq, hstable] using hmem

theorem interpretFuel_kernelEnv_nf_def_root_contains
    {fuel : Nat} {st : St} {sig : DIndGArtifactSig}
    {name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName}
    (hstatic : st.world.selfExtra = []) :
    (Metta.instantiate
        (renameBindings (counterSuffix (st.counter + nfDefCandidatePreWithIndGZeroIota.length))
          (nfDefRuleBindings sig name)).reverse
        (freshenRule (st.counter + nfDefCandidatePreWithIndGZeroIota.length) nfDefRuleLhs nfDefRuleRhs).2,
      (renameBindings (counterSuffix (st.counter + nfDefCandidatePreWithIndGZeroIota.length))
        (nfDefRuleBindings sig name)).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st [evalItemNil (nfQuery sig (.defn name))] []).1 := by
  let coreB : Metta.Bindings := nfDefRuleBindings sig name
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val
      (by unfold Metta.Atom.vars; rfl)
      (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    dsimp [coreB, nfDefRuleBindings, bindingValueKeys]
    decide
  have hsplit :
      kernelEnv.candidates (nfQuery sig (.defn name)) =
        nfDefCandidatePreWithIndGZeroIota ++ nfDefRulePair :: [] := by
    have hcand := kernelEnv_nf_def_candidates sig name
    have hstaticInit := candidatesW_init_eq_candidates kernelEnv (nfQuery sig (.defn name))
    rw [hstaticInit] at hcand
    simpa [nfDefRulePair] using hcand
  have hmatchCore : coreB ∈ Metta.matchAtoms nfDefRuleLhs (nfQuery sig (.defn name)) := by
    simpa [coreB] using
      (by
        rw [nf_def_rule_match sig name]
        simp [nfDefRuleBindings] :
          nfDefRuleBindings sig name ∈
            Metta.matchAtoms nfDefRuleLhs (nfQuery sig (.defn name)))
  have hnotFunction :
      isFunctionResult
        (Metta.instantiate
          (renameBindings
            (counterSuffix (st.counter + nfDefCandidatePreWithIndGZeroIota.length))
            coreB).reverse
          (freshenRule (st.counter + nfDefCandidatePreWithIndGZeroIota.length) nfDefRuleLhs nfDefRuleRhs).2) =
        false := by
    rw [freshenRule_eq_renBy]
    rw [(ClosedValueBindings.reverse
      (ClosedValueBindings.rename hclosedB)).instantiate_eq_subst_apply]
    simp [coreB, nfDefRuleBindings, nfDefRuleRhs, nfDefCandidatePre,
      nfDefCandidatePreWithIndGZeroIota,
      nfLamCandidatePre, nfPiCandidatePre, renameBindings, counterSuffix,
