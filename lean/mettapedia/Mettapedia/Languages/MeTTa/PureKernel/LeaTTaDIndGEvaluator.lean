/-- Runtime root readout for `is-bad`, preserving LeaTTa's rule-variable freshening.

The actual executable readout contains the freshened RHS variable (`e#counter`) and the freshened
binding for `x`; the relation-side reduct is only alpha-equivalent to this atom. This theorem is
therefore intentionally stated at the actual runtime shape. -/
theorem interpretFuel_eval_is_bad_alpha_root
    (fuel : Nat) (a : Metta.Atom)
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    (Metta.instantiate
        (renameBindings (counterSuffix (St.init.counter + ([] : List (Metta.Atom × Metta.Atom)).length))
          [Metta.BindingRel.val "x" a]).reverse
        (freshenRule (St.init.counter + ([] : List (Metta.Atom × Metta.Atom)).length)
          isBadRulePair.1 isBadRulePair.2).2,
      (renameBindings (counterSuffix (St.init.counter + ([] : List (Metta.Atom × Metta.Atom)).length))
          [Metta.BindingRel.val "x" a]).reverse) ∈
        (interpretFuel kernelCoreEnv (fuel + 1) St.init
          [evalItemNil (mExpr "is-bad" [a])] []).1 := by
  let coreB : Metta.Bindings := [Metta.BindingRel.val "x" a]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hClosed ClosedValueBindings.nil
  have hnodup : (bindingValueKeys coreB).Nodup := by
    dsimp [coreB, bindingValueKeys]
    decide
  have hsplit :
      (MinEnv.ofAtomsGT kernelCoreRules stdGroundings).candidates (mExpr "is-bad" [a]) =
        ([] : List (Metta.Atom × Metta.Atom)) ++ isBadRulePair :: [] := by
    have hcand := kernelCoreEnv_is_bad_candidates a
    have hstatic := candidatesW_init_eq_candidates kernelCoreEnv (mExpr "is-bad" [a])
    rw [hstatic] at hcand
    simpa [kernelCoreEnv] using hcand
  have hclosedTarget : (mExpr "is-bad" [a]).vars = [] := by
    simp [mExpr, mSym, hClosed, Metta.Atom.vars]
  have hmatchCore : coreB ∈ Metta.matchAtoms isBadRulePair.1 (mExpr "is-bad" [a]) := by
    simpa [coreB] using
      (by
        rw [is_bad_rule_match a hNonVar]
        simp :
        [Metta.BindingRel.val "x" a] ∈
          Metta.matchAtoms isBadRulePair.1 (mExpr "is-bad" [a]))
  have hnotFunction :
      isFunctionResult
        (Metta.instantiate
          (renameBindings (counterSuffix (St.init.counter + ([] : List (Metta.Atom × Metta.Atom)).length)) coreB).reverse
          (freshenRule (St.init.counter + ([] : List (Metta.Atom × Metta.Atom)).length)
            isBadRulePair.1 isBadRulePair.2).2) = false := by
    rw [freshenRule_eq_renBy]
    simp [coreB, isBadRulePair, St.init, renameBindings, counterSuffix,
      Metta.instantiate, Metta.bindingsToSubst, Metta.Subst.apply,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
      mExpr, mSym, mVar, mBool, isFunctionResult]
  have hbridge :=
    interpretFuel_eval_renamed_closed_coreBinding_reverse_alpha_final_mops_of_match
      (atoms := kernelCoreRules) (gt := stdGroundings) (st := St.init) (fuel := fuel)
      (x := mExpr "is-bad" [a]) (lhs := isBadRulePair.1) (rhs := isBadRulePair.2)
      (coreB := coreB) (op := "is-bad") (args := [a])
      (pre := ([] : List (Metta.Atom × Metta.Atom))) (post := [])
      hclosedTarget hclosedB hnodup rfl
      (by simp [Metta.instantiate_nil, mExpr, mSym])
      (kernelCoreEnv_callGrounded_isBad a) (by simp [isEmbeddedOp])
      hsplit hmatchCore hnotFunction
  simpa [kernelCoreEnv, coreB, evalItemNil, atomToStack_eval, mExpr, mSym] using hbridge.1


/-- Runtime `evalOp` bridge for successful grounded equality on a state/token-stable atom.

The stability premise is intentional: LeaTTa's grounded dispatch compares arguments after token
substitution and state dereferencing, so this theorem is not valid for arbitrary runtime atoms
without exposing that preprocessing boundary. -/
theorem evalOp_eq_self_true_of_not_error_of_stdGroundings
    (env : MinEnv) (prev : Stack) (a : Metta.Atom)
    (hgt : env.gt = stdGroundings)
    (hErr : a.isError = false) (hEq : (a == a) = true)
    (hstate : resolveStates St.init.world a = a) :
    evalOp env St.init prev (mExpr "==" [a, a]) [] =
      ([evalResult prev (mBool true) []], St.init) := by
  rw [evalOp_grounded_ok_eq
    (env := env) (st := St.init) (prev := prev)
    (x := mExpr "==" [a, a]) (b := []) (op := "==")
    (args := [a, a]) (results := [mBool true])]
  · rfl
  · simp [mExpr, mSym, Metta.instantiate, Metta.bindingsToSubst,
      Metta.Subst.apply_nil]
  · rw [hgt]
    simpa [subTokens_init_world_eq_self a, hstate] using
      callGrounded_eq_self_true_of_not_error a hErr hEq

theorem evalOp_eq_self_true_of_not_error
    (prev : Stack) (a : Metta.Atom)
    (hErr : a.isError = false) (hEq : (a == a) = true)
    (hstate : resolveStates St.init.world a = a) :
    evalOp kernelCoreEnv St.init prev (mExpr "==" [a, a]) [] =
      ([evalResult prev (mBool true) []], St.init) := by
  exact evalOp_eq_self_true_of_not_error_of_stdGroundings
    kernelCoreEnv prev a (by rfl) hErr hEq hstate

/-- Runtime `evalOp` bridge for a successful grounded equality comparison.

This is the non-reflexive form needed by `conv`: after the two `nf` subcalls
produce normalized readouts, the final `(== nx ny)` branch should not be
restricted to syntactic self-equality.  The state-stability premises expose the
same preprocessing boundary as the reflexive lemma above. -/
theorem evalOp_eq_true_of_callGrounded_of_stdGroundings
    (env : MinEnv) (prev : Stack) (a b : Metta.Atom)
    (hgt : env.gt = stdGroundings)
    (hstateA : resolveStates St.init.world a = a)
    (hstateB : resolveStates St.init.world b = b)
    (hcall :
      callGrounded stdGroundings "==" [a, b] =
        ReduceResult.ok [mBool true]) :
    evalOp env St.init prev (mExpr "==" [a, b]) [] =
      ([evalResult prev (mBool true) []], St.init) := by
  rw [evalOp_grounded_ok_eq
    (env := env) (st := St.init) (prev := prev)
    (x := mExpr "==" [a, b]) (b := []) (op := "==")
    (args := [a, b]) (results := [mBool true])]
  · rfl
  · simp [mExpr, mSym, Metta.instantiate, Metta.bindingsToSubst,
      Metta.Subst.apply_nil]
  · rw [hgt]
    simpa [subTokens_init_world_eq_self a, subTokens_init_world_eq_self b,
      hstateA, hstateB] using hcall

/-- Core-kernel specialization of
`evalOp_eq_true_of_callGrounded_of_stdGroundings`. -/
theorem evalOp_eq_true_of_callGrounded
    (prev : Stack) (a b : Metta.Atom)
    (hstateA : resolveStates St.init.world a = a)
    (hstateB : resolveStates St.init.world b = b)
    (hcall :
      callGrounded stdGroundings "==" [a, b] =
        ReduceResult.ok [mBool true]) :
    evalOp kernelCoreEnv St.init prev (mExpr "==" [a, b]) [] =
      ([evalResult prev (mBool true) []], St.init) := by
  exact evalOp_eq_true_of_callGrounded_of_stdGroundings
    kernelCoreEnv prev a b (by rfl) hstateA hstateB hcall

/-- Runtime `evalOp` bridge for successful grounded equality in any state whose
world is still the initial empty world.

This is the scheduler-facing variant needed after finite-control steps such as
`let`/`if`: the counter may have advanced, but the world is unchanged, so the
grounded `==` result is the same as at `St.init`. -/
theorem evalOp_eq_true_of_callGrounded_world_eq_init
    (env : MinEnv) (st : St) (prev : Stack) (a b : Metta.Atom)
    (hgt : env.gt = stdGroundings)
    (hWorld : st.world = St.init.world)
    (hstateA : resolveStates st.world a = a)
    (hstateB : resolveStates st.world b = b)
    (hcall :
      callGrounded stdGroundings "==" [a, b] =
        ReduceResult.ok [mBool true]) :
    evalOp env st prev (mExpr "==" [a, b]) [] =
      ([evalResult prev (mBool true) []], st) := by
  rw [evalOp_grounded_ok_eq
    (env := env) (st := st) (prev := prev)
    (x := mExpr "==" [a, b]) (b := []) (op := "==")
    (args := [a, b]) (results := [mBool true])]
