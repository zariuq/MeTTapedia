private theorem queryOpItems_if_true_eq
    (counter : Nat) (thenA elseA : Metta.Atom)
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w) :
    queryOpItemsOfRule [] (mExpr "if" [mBool true, thenA, elseA]) []
        counter ifTrueRulePair =
      [evalResult [] thenA
        [ Metta.BindingRel.val (counterSuffix counter "t") thenA
        , Metta.BindingRel.val (counterSuffix counter "e") elseA ]] := by
  let f := counterSuffix counter
  have hfresh :
      freshenRule counter ifTrueRulePair.1 ifTrueRulePair.2 =
        (mExpr "if" [mBool true, mVar (f "t"), mVar (f "e")], mVar (f "t")) := by
    rw [freshenRule_eq_renBy]
    simp [f, ifTrueRulePair, mExpr, mSym, mVar, mBool,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms (mExpr "if" [mBool true, mVar (f "t"), mVar (f "e")])
          (mExpr "if" [mBool true, thenA, elseA]) =
        [[Metta.BindingRel.val (f "e") elseA, Metta.BindingRel.val (f "t") thenA]] := by
    simpa [f, hfresh] using fresh_if_true_rule_match counter thenA elseA hThenNonVar hElseNonVar
  have hte : f "t" ≠ f "e" := by
    intro h
    have ht : "t" = "e" := (counterSuffix_injective counter) h
    contradiction
  have het : f "e" ≠ f "t" := by
    intro h
    exact hte h.symm
  have hteBeq : (f "t" == f "e") = false := beq_eq_false_iff_ne.mpr hte
  have hetBeq : (f "e" == f "t") = false := beq_eq_false_iff_ne.mpr het
  have hmerge :
      Metta.Bindings.merge [] [Metta.BindingRel.val (f "e") elseA,
          Metta.BindingRel.val (f "t") thenA] =
        [[Metta.BindingRel.val (f "t") thenA,
          Metta.BindingRel.val (f "e") elseA]] := by
    simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
      Metta.Bindings.lookupVal, Metta.Bindings.addValRaw, Metta.Bindings.removeVal,
      het, hteBeq]
  have hclosedM :
      ClosedValueBindings
        [ Metta.BindingRel.val (f "t") thenA
        , Metta.BindingRel.val (f "e") elseA ] := by
    exact ClosedValueBindings.val hThenClosed
      (ClosedValueBindings.val hElseClosed ClosedValueBindings.nil)
  have hloop :
      Metta.Bindings.hasLoop
        [ Metta.BindingRel.val (f "t") thenA
        , Metta.BindingRel.val (f "e") elseA ] = false := by
    exact ClosedValueBindings.hasLoop_false hclosedM
  have hinst :
      Metta.instantiate
          [ Metta.BindingRel.val (f "t") thenA
          , Metta.BindingRel.val (f "e") elseA ]
          (mVar (f "t")) =
        thenA := by
    simp [mVar, Metta.instantiate, Metta.bindingsToSubst, Metta.Subst.apply,
      Metta.Subst.lookup]
  unfold queryOpItemsOfRule
  rw [hfresh]
  change
    List.flatMap
        (fun mb =>
          List.filterMap
            (fun m =>
              if Metta.Bindings.hasLoop m = true then none
              else some (evalResult [] (Metta.instantiate m (mVar (f "t"))) m))
            (Metta.Bindings.merge [] mb))
        (Metta.matchAtoms (mExpr "if" [mBool true, mVar (f "t"), mVar (f "e")])
          (mExpr "if" [mBool true, thenA, elseA])) =
      [evalResult [] thenA
        [ Metta.BindingRel.val (counterSuffix counter "t") thenA
        , Metta.BindingRel.val (counterSuffix counter "e") elseA ]]
  rw [hmatch]
  simp [hmerge, hloop, hinst, f]

