      simpa [bodyAtom] using
        termAtom_not_match_bad_pattern_nameFree
          (counterSuffix st.counter "e") hName hNotBad
    simpa [cond, bodyAtom, stCond] using
      mettaEval_kernelDefControlEnv_is_bad_false_eq
        (fuel := fuel) (st := st) (a := bodyAtom)
        hStatic
        (by simpa [bodyAtom] using
          termAtom_vars_nil leattaDefControlNonWitnessBody)
        (by simpa [bodyAtom] using
          termAtom_isError_false leattaDefControlNonWitnessBody)
        (by simpa [bodyAtom] using
          termAtom_beq_self_true leattaDefControlNonWitnessBody)
        (by
          intro w
          simpa [bodyAtom] using
            termAtom_not_var leattaDefControlNonWitnessBody w)
        hmatch
  have hType :
      typeMismatch kernelDefControlEnv st.world "if" [cond, thenA, elseA] = none := by
    simpa [cond, bodyAtom, hWorld] using
      kernelDefControlEnv_if_typeMismatch_is_bad_init bodyAtom thenA elseA
  have hNoErr :
      (([mBool false, thenA, elseA].zip [cond, thenA, elseA]).find?
        (fun ho : Metta.Atom × Metta.Atom => ho.1.isError && ho.1 != ho.2)) = none := by
    simp [cond, thenA, elseA, bodyAtom, nfQuery, mBool, mExpr, mSym,
