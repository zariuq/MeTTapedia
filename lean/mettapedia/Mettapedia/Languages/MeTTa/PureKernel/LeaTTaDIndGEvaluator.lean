theorem interpretFuel_selected_rule_contains_of_env
    (env : MinEnv)
    {fuel : Nat} {st : St}
    {target lhs rhs : Metta.Atom} {coreB : Metta.Bindings}
    {op : String} {args : List Metta.Atom}
    {pre post : List (Metta.Atom × Metta.Atom)}
    (hstatic : st.world.selfExtra = [])
    (hclosedTarget : target.vars = [])
    (hclosedB : ClosedValueBindings coreB)
    (hnodup : (bindingValueKeys coreB).Nodup)
    (hinst : Metta.instantiate [] target = Metta.Atom.expr (Metta.Atom.sym op :: args))
    (hcall : callGrounded env.gt op
        (args.map (fun a => resolveStates st.world (subTokens st.world a))) =
      ReduceResult.noReduce)
    (hembed : isEmbeddedOp (Metta.Atom.expr (Metta.Atom.sym op :: args)) = false)
    (hsplit : env.candidates target = pre ++ (lhs, rhs) :: post)
    (hmatchCore : coreB ∈ Metta.matchAtoms lhs target)
    (hnotEmpty :
      (Metta.instantiate
        (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse
        (freshenRule (st.counter + pre.length) lhs rhs).2 != emptyA) = true)
    (hnotFunction :
      isFunctionResult
        (Metta.instantiate
          (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse
          (freshenRule (st.counter + pre.length) lhs rhs).2) = false) :
    (Metta.instantiate
        (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse
        (freshenRule (st.counter + pre.length) lhs rhs).2,
      (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse) ∈
      (interpretFuel env (fuel + 1) st [evalItemNil target] []).1 := by
  let mb : Metta.Bindings :=
    renameBindings (counterSuffix (st.counter + pre.length)) coreB
  let m : Metta.Bindings := mb.reverse
  let out : Metta.Atom :=
    Metta.instantiate m (freshenRule (st.counter + pre.length) lhs rhs).2
  have htarget : target = Metta.Atom.expr (Metta.Atom.sym op :: args) := by
    simpa [Metta.instantiate_nil] using hinst
  have hmatchFresh : mb ∈
      Metta.matchAtoms (freshenRule (st.counter + pre.length) lhs rhs).1
        target := by
    simpa [mb] using
      matchAtoms_freshenRule_lhs_closed_target_mem
        (st.counter + pre.length) hclosedTarget hmatchCore
  have hcompat : LegacyFresheningCompatible [] target []
      (st.counter + pre.length) lhs rhs :=
    legacyFresheningCompatible_empty_of_target_vars_nil
      (st.counter + pre.length) target lhs rhs hclosedTarget
  have hmatchFreshAvoiding : mb ∈
      Metta.matchAtoms
        (freshenRuleAvoiding (st.counter + pre.length)
          (Metta.Minimal.queryOpAvoid [] target []) lhs rhs).1.1 target := by
    rw [hcompat]
    exact hmatchFresh
  have hmerge : m ∈ Metta.Bindings.merge [] mb := by
    simpa [m, mb] using
      (merge_empty_renamed_closed_nodup_mem
        (counterSuffix_injective (st.counter + pre.length)) hclosedB hnodup)
  have hclosedMb : ClosedValueBindings mb := by
    simpa [mb] using
      (ClosedValueBindings.rename
        (f := counterSuffix (st.counter + pre.length)) hclosedB)
  have hclosedM : ClosedValueBindings m := by
    simpa [m] using ClosedValueBindings.reverse hclosedMb
  have hloop : Metta.Bindings.hasLoop m = false := by
    simpa [m] using ClosedValueBindings.hasLoop_false hclosedM
  have hquery :
      evalResult [] out m ∈
        (queryOp env st [] target []).1 := by
    simpa [out, m, mb, hcompat] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := env) (st := st) (prev := []) (toEval := target)
        (b := []) (pre := pre) (post := post) (p := (lhs, rhs))
        (mb := mb) (m := m)
        hstatic
        (by simp [htarget, isVariableHeaded])
        hsplit hmatchFreshAvoiding hmerge hloop
  have hstack :
      evalResult [] out m ∈
        (interpretStack1 env fuel st (evalItemNil target)).1 := by
    have hqueryExpr :
        evalResult [] out m ∈
          (queryOp env st []
            (Metta.Atom.expr (Metta.Atom.sym op :: args)) []).1 := by
      simpa [← htarget] using hquery
    exact
      (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
        env fuel st [] target [] op args
        (evalResult [] out m)
        hinst hcall hembed).2 hqueryExpr
  have hevalEq : evalResult [] out m = finItem [] out m := by
    have hnot : isFunctionResult out = false := by
      simpa [out, m, mb] using hnotFunction
    simpa [out] using
      (evalResult_nil_eq_finItem_of_not_function (a := out) (b := m) hnot)
  have hfin : isFinal (evalResult [] out m) = true := by
    simp [hevalEq, finItem, isFinal]
  have hstable : Metta.instantiate m out = out := by
    simpa [out] using instantiate_closed_value_bindings_idempotent hclosedM
      (freshenRule (st.counter + pre.length) lhs rhs).2
  have hmem :
      finalPair (evalResult [] out m) ∈
        (interpretFuel env (fuel + 1) st [evalItemNil target] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      env fuel st (evalItemNil target) (evalResult [] out m)
      [] [] hstack hfin (by
        simpa [hevalEq, finItem, finalPair, hstable, out, m, mb] using hnotEmpty)
  simpa [out, m, mb, finalPair, finItem, hevalEq, hstable] using hmem

/-- Live-binding form of the selected static-rule membership bridge.

The rule freshening is required to stay on the legacy spelling only for this
concrete step; the premise is normally discharged from the runtime avoid set.
The renamed rule bindings must be disjoint from the closed incoming value
environment, so their merge has the literal private-prefix/public-suffix
shape used by the evaluator.  No claim is made for arbitrary colliding or
non-value incoming bindings. -/
theorem interpretFuel_selected_rule_contains_from_of_env
    (env : MinEnv)
    {fuel : Nat} {st : St}
    {target lhs rhs : Metta.Atom} {coreB incoming : Metta.Bindings}
    {op : String} {args : List Metta.Atom}
    {pre post : List (Metta.Atom × Metta.Atom)}
    (hstatic : st.world.selfExtra = [])
    (hclosedTarget : target.vars = [])
    (hclosedB : ClosedValueBindings coreB)
    (hnodup : (bindingValueKeys coreB).Nodup)
    (hclosedIncoming : ClosedValueBindings incoming)
    (hinst : Metta.instantiate incoming target =
      Metta.Atom.expr (Metta.Atom.sym op :: args))
    (hcall : callGrounded env.gt op
        (args.map (fun a => resolveStates st.world (subTokens st.world a))) =
      ReduceResult.noReduce)
    (hembed : isEmbeddedOp (Metta.Atom.expr (Metta.Atom.sym op :: args)) = false)
    (hsplit : env.candidates target = pre ++ (lhs, rhs) :: post)
    (hmatchCore : coreB ∈ Metta.matchAtoms lhs target)
    (hcompat : LegacyFresheningCompatible [] target incoming
      (st.counter + pre.length) lhs rhs)
    (hdisj :
      ∀ x ∈ bindingValueKeys
          (renameBindings (counterSuffix (st.counter + pre.length)) coreB),
        x ∉ bindingValueKeys incoming)
    (hnotEmpty :
      (Metta.instantiate
        ((renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse ++
          incoming)
        (freshenRule (st.counter + pre.length) lhs rhs).2 != emptyA) = true)
    (hnotFunction :
      isFunctionResult
        (Metta.instantiate
          ((renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse ++
            incoming)
          (freshenRule (st.counter + pre.length) lhs rhs).2) = false) :
    (Metta.instantiate
        ((renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse ++
          incoming)
        (freshenRule (st.counter + pre.length) lhs rhs).2,
      (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse ++
        incoming) ∈
      (interpretFuel env (fuel + 1) st [evalItemBnd incoming target] []).1 := by
  let f := counterSuffix (st.counter + pre.length)
  let mb : Metta.Bindings := renameBindings f coreB
  let m : Metta.Bindings := mb.reverse ++ incoming
  let out : Metta.Atom :=
    Metta.instantiate m (freshenRule (st.counter + pre.length) lhs rhs).2
  have htarget : target = Metta.Atom.expr (Metta.Atom.sym op :: args) := by
    rw [instantiate_eq_self_of_vars_nil incoming hclosedTarget] at hinst
    exact hinst
  have hmatchFresh : mb ∈
      Metta.matchAtoms (freshenRule (st.counter + pre.length) lhs rhs).1 target := by
    simpa [mb, f] using
      matchAtoms_freshenRule_lhs_closed_target_mem
        (st.counter + pre.length) hclosedTarget hmatchCore
  have hmatchFreshAvoiding : mb ∈
      Metta.matchAtoms
        (freshenRuleAvoiding (st.counter + pre.length)
          (Metta.Minimal.queryOpAvoid [] target incoming) lhs rhs).1.1 target := by
    rw [hcompat]
    exact hmatchFresh
  have hclosedMb : ClosedValueBindings mb := by
    simpa [mb, f] using ClosedValueBindings.rename
      (f := counterSuffix (st.counter + pre.length)) hclosedB
  have hnodupMb : (bindingValueKeys mb).Nodup := by
    rw [show mb = renameBindings f coreB by rfl, bindingValueKeys_renameBindings]
    exact List.Nodup.map (counterSuffix_injective (st.counter + pre.length)) hnodup
  have hmergeEq : Metta.Bindings.merge incoming mb = [m] := by
    simpa [m, mb, f] using
      (merge_closed_noConflict_eq hclosedMb hnodupMb hclosedIncoming
        (by simpa [mb, f] using hdisj))
  have hmerge : m ∈ Metta.Bindings.merge incoming mb := by
    rw [hmergeEq]
    simp
  have hclosedM : ClosedValueBindings m := by
    exact ClosedValueBindings.append (ClosedValueBindings.reverse hclosedMb)
      hclosedIncoming
  have hloop : Metta.Bindings.hasLoop m = false := by
    exact ClosedValueBindings.hasLoop_false hclosedM
  have hquery :
      evalResult [] out m ∈ (queryOp env st [] target incoming).1 := by
    have hqueryAvoid :=
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := env) (st := st) (prev := []) (toEval := target)
        (b := incoming) (pre := pre) (post := post) (p := (lhs, rhs))
        (mb := mb) (m := m) hstatic
        (by simp [htarget, isVariableHeaded]) hsplit
        hmatchFreshAvoiding hmerge hloop
    simpa [out, hcompat] using hqueryAvoid
  have hstack :
      evalResult [] out m ∈
        (interpretStack1 env fuel st (evalItemBnd incoming target)).1 := by
    unfold evalItemBnd
    exact
      (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
        env fuel st [] target incoming op args (evalResult [] out m)
        hinst hcall hembed).2 (by simpa [← htarget] using hquery)
  have hevalEq : evalResult [] out m = finItem [] out m := by
    simpa [out] using
      (evalResult_nil_eq_finItem_of_not_function (a := out) (b := m)
        (by simpa [out, m, mb, f] using hnotFunction))
  have hfin : isFinal (evalResult [] out m) = true := by
    simp [hevalEq, finItem, isFinal]
  have hstable : Metta.instantiate m out = out := by
    simpa [out] using instantiate_closed_value_bindings_idempotent hclosedM
      (freshenRule (st.counter + pre.length) lhs rhs).2
  have hmem :
      finalPair (evalResult [] out m) ∈
        (interpretFuel env (fuel + 1) st [evalItemBnd incoming target] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      env fuel st (evalItemBnd incoming target) (evalResult [] out m)
      [] [] hstack hfin (by
        simpa [hevalEq, finItem, finalPair, hstable, out, m, mb, f] using hnotEmpty)
  simpa [out, m, mb, f, finalPair, finItem, hevalEq, hstable] using hmem

