    · simp [subst_app_dispatch_instantiate_bindings]

/-- The public binding-waist `subst` dispatcher as a MOPS step. -/
theorem subst_app_dispatch_appRules_mops_step
    (index : Nat) (replacement rawFn rawArg : DIndGArtifactTerm) :
