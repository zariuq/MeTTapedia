private theorem list_map_eq_self_of_forall {α : Type} {f : α → α} :
    ∀ {xs : List α}, (∀ x ∈ xs, f x = x) → xs.map f = xs
  | [], _ => rfl
  | x :: xs, h => by
      simp [h x (by simp), list_map_eq_self_of_forall (xs := xs) (by
        intro y hy
        exact h y (by simp [hy]))]

/-- The initial empty world has no state cells, so wrapping state handles is identity. -/
theorem wrapStates_init_world_eq_self (a : Metta.Atom) :
    wrapStates St.init.world a = a := by
  fun_induction wrapStates St.init.world a
  case case1 id v h =>
    simp [St.init, World.empty] at h
  case case2 id h =>
    rfl
  case case3 xs h ih =>
    exact congrArg Atom.expr (list_map_eq_self_of_forall (xs := xs) ih)
  case case4 a h1 h2 =>
    rfl

/-- In the initial empty world, type-preparation does not change atoms. -/
theorem typePrep_init_world_eq_self (a : Metta.Atom) :
    typePrep St.init.world a = a := by
  rw [typePrep, subTokens_init_world_eq_self, wrapStates_init_world_eq_self]

/-- Detailed runtime type-checking succeeds without changing the private theory for one
argument declared as `Atom`. -/
theorem typeCheckArgsOutcome_one_atom
    (env : MinEnv) (w : World) (a : Metta.Atom) :
    typeCheckArgsOutcome env w [Metta.Atom.sym "Atom"] 0 [] [a] =
      .success [] := by
  simpa using typeCheckArgsOutcome_replicate_atom env w [a]

