/-- Proof-facing cache of the control signatures used by full `conv` execution.

These declarations duplicate the corresponding stdlib signatures for `let`, `unify`, `if`,
and `==` without importing the full parsed prelude into the proof-facing environment.  The
finite slice keeps the control-flow table reducible while preserving exactly the executable
behavior that `convReadout` needs after the root kernel rule fires. -/
def kernelControlSignatureDecls : List Metta.Atom :=
  [ mTypeDecl "let" [mSym "Atom", mSym "%Undefined%", mSym "Atom", mSym "%Undefined%"]
  , mTypeDecl "unify" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom", mSym "%Undefined%"]
  , mTypeDecl "if" [mSym "Bool", mSym "Atom", mSym "Atom", mSym "%Undefined%"]
  , mTypeDecl "==" [mSym "Atom", mSym "Atom", mSym "Bool"]
  , mTypeDecl "def-body-of" [mSym "Atom", mSym "Atom", mSym "%Undefined%"] ]

def kernelControlSigs : Std.HashMap String (List Metta.Atom) :=
  (((((((((Std.HashMap.emptyWithCapacity.insert "let"
    [mSym "Atom", mSym "%Undefined%", mSym "Atom", mSym "%Undefined%"]).insert
    "unify" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom", mSym "%Undefined%"]).insert
    "if" [mSym "Bool", mSym "Atom", mSym "Atom", mSym "%Undefined%"]).insert
    "==" [mSym "Atom", mSym "Atom", mSym "Bool"]).insert
    "def-body-of" [mSym "Atom", mSym "Atom", mSym "%Undefined%"]).insert
    "is-bad" [mSym "Atom", mSym "Bool"]).insert
    "nf" [mSym "Atom", mSym "Atom", mSym "Atom"]).insert
    "infer" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]).insert
    "conv" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Bool"])

def kernelControlTypes : Std.HashMap String (List Metta.Atom) :=
  (((((((((Std.HashMap.emptyWithCapacity.insert "let"
    [mExpr "->" [mSym "Atom", mSym "%Undefined%", mSym "Atom", mSym "%Undefined%"]]).insert
    "unify" [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom", mSym "%Undefined%"]]).insert
    "if" [mExpr "->" [mSym "Bool", mSym "Atom", mSym "Atom", mSym "%Undefined%"]]).insert
    "==" [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Bool"]]).insert
    "def-body-of" [mExpr "->" [mSym "Atom", mSym "Atom", mSym "%Undefined%"]]).insert
    "is-bad" [mExpr "->" [mSym "Atom", mSym "Bool"]]).insert
    "nf" [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom"]]).insert
    "infer" [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]]).insert
    "conv" [mExpr "->" [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Bool"]])

/-- The control-flow-complete executable kernel environment for `conv`.

`kernelCoreEnv` is the small proof-facing equality-rule slice used for root
dispatch facts such as `nf`, `infer`, and the first `conv` step.  Full
`conv` execution is different: after the root kernel rule fires, the readout
contains control constructs (`let`, `if`, embedded `unify`, and grounded `==`),
so the running evaluator needs those control rules as well as the kernel rules.
-/
def kernelEnv : MinEnv :=
  MinEnv.ofAtomsGT (kernelControlSignatureDecls ++ kernelControlRules) stdGroundings

/-- Full control-flow kernel environment for recursive `nf` execution.

`kernelEnv` keeps `nf : Atom -> Atom -> Atom`, which is useful for root-readout
proofs but makes the outer evaluator return the root `nf` reduct inert.  This
environment keeps both `nf` arguments quoted while changing only the return type
to `%Undefined%`, so the same source rules still fire through `queryOp`, while
`mettaEval` recursively evaluates the `let`/`if`/`def-body-of` program emitted
by the `Def` rule. -/
def kernelDefControlEnv : MinEnv :=
  { kernelEnv with
    types := kernelEnv.types.insert "nf"
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "%Undefined%"]] }

/-- The MIK kernel rules loaded directly into LeaTTa's executable environment.
This is the proof-facing runtime for small per-rule soundness facts: it runs the
actual `mettaEval` interpreter over the kernel rules, without unrelated prelude
rules that would require a separate no-interference proof.  It is not a
control-flow-complete environment for the full body of `conv`; use `kernelEnv`
for that executable face. -/
def kernelCoreEnv : MinEnv :=
  MinEnv.ofAtomsGT kernelCoreRules stdGroundings

/-- Exact observable type-service fact for one operator in one world.  The ordered type list is
the runtime selection input, so it remains explicit rather than being collapsed to a cache lookup. -/
def OperatorTypesPinned (env : MinEnv) (world : World) (op : String)
    (types : List Metta.Atom) : Prop :=
  getTypes env (typePrep world (.sym op)) = types

/-- Initial evaluation observes the static environment's own ordered type list. -/
private theorem operatorTypesPinned_init (env : MinEnv) (op : String) :
    OperatorTypesPinned env St.init.world op (getTypes env (.sym op)) := by
  simp [OperatorTypesPinned, typePrep, St.init, World.empty,
    subTokens.eq_1, wrapStates.eq_3]

/-- A finite runtime operator inventory shares one exact world-indexed type-service contract.  The observed
lists remain computed from the environment, so the bundle cannot drift from declaration order. -/
def OperatorInventoryPinned (env : MinEnv) (world : World) (operators : List String) : Prop :=
  ∀ op ∈ operators, OperatorTypesPinned env world op (getTypes env (.sym op))

private theorem operatorInventoryPinned_init
    (env : MinEnv) (operators : List String) :
    OperatorInventoryPinned env St.init.world operators := by
  intro op _hop
  exact operatorTypesPinned_init env op

/-- Operator heads consumed by the full control-flow kernel environment. -/
def kernelEnvOperatorInventory : List String :=
  ["is-bad", "let", "unify", "if", "==", "nf", "infer", "conv", "def-body-of"]

/-- Operator heads consumed by the small root-dispatch kernel environment. -/
def kernelCoreEnvOperatorInventory : List String :=
  ["is-bad", "unify", "Bad", "nf", "infer", "conv"]

/-- Operator heads consumed by recursive definition normalization. -/
def kernelDefControlEnvOperatorInventory : List String :=
  ["is-bad", "let", "unify", "if", "==", "nf", "conv", "def-body-of",
    "Srt", "Var", "Con", "Pi", "Lam"]

abbrev KernelEnvTypeWorld (world : World) : Prop :=
  OperatorInventoryPinned kernelEnv world kernelEnvOperatorInventory

abbrev KernelCoreEnvTypeWorld (world : World) : Prop :=
  OperatorInventoryPinned kernelCoreEnv world kernelCoreEnvOperatorInventory

abbrev KernelDefControlEnvTypeWorld (world : World) : Prop :=
  OperatorInventoryPinned kernelDefControlEnv world kernelDefControlEnvOperatorInventory

theorem kernelEnvTypeWorld_init : KernelEnvTypeWorld St.init.world :=
  operatorInventoryPinned_init kernelEnv kernelEnvOperatorInventory

theorem kernelCoreEnvTypeWorld_init : KernelCoreEnvTypeWorld St.init.world :=
  operatorInventoryPinned_init kernelCoreEnv kernelCoreEnvOperatorInventory

theorem kernelDefControlEnvTypeWorld_init : KernelDefControlEnvTypeWorld St.init.world :=
  operatorInventoryPinned_init kernelDefControlEnv kernelDefControlEnvOperatorInventory

theorem OperatorInventoryPinned.transport
    {env : MinEnv} {world nextWorld : World} {operators : List String}
    (h : OperatorInventoryPinned env world operators) (hWorld : nextWorld = world) :
    OperatorInventoryPinned env nextWorld operators := by
  subst hWorld
  exact h

theorem kernelDefControlEnvTypeWorld_of_world_eq_init
    {world : World} (hWorld : world = St.init.world) :
    KernelDefControlEnvTypeWorld world :=
  kernelDefControlEnvTypeWorld_init.transport hWorld

/-- LeaTTa's standard groundings do not define the embedded minimal `unify` operator.

This keeps `unify` on the interpreter-control path rather than the grounded-call path. -/
theorem callGrounded_unify_of_stdGroundings
    (env : MinEnv) (args : List Metta.Atom)
    (hgt : env.gt = stdGroundings) :
    callGrounded env.gt "unify" args = ReduceResult.noReduce := by
  rw [hgt]
  simp [callGrounded, GroundingTable.lookup, stdGroundings,
    Metta.Builtins.table, Metta.Builtins.mathTable]

/-- The kernel runtime leaves `unify` to the embedded minimal interpreter. -/
theorem kernelCoreEnv_callGrounded_unify
    (args : List Metta.Atom) :
    callGrounded kernelCoreEnv.gt "unify" args = ReduceResult.noReduce := by
  exact callGrounded_unify_of_stdGroundings kernelCoreEnv args (by rfl)

/-- The core kernel has no arrow declaration for embedded `unify`; its exact type-service result is
the gradual `%Undefined%` candidate. -/
theorem kernelCoreEnv_unify_types :
    getTypes kernelCoreEnv (.sym "unify") = [.sym "%Undefined%"] := by
  have hnone : kernelCoreEnv.types.getD "unify" [] = [] := by
    simp [kernelCoreEnv, MinEnv.ofAtomsGT, kernelCoreRules, runtimeDecls, mTypeDecl,
      mExpr, mSym, ruleIsBad, ruleNfVar, ruleNfSrt, ruleNfCon, ruleNfPi,
      ruleNfLam, ruleNfBad, ruleInferSrtType, ruleInferSrtKind, ruleInferBad, ruleConv,
      Std.HashMap.getD_insert]
  rw [getTypes.eq_def]
  simp [hnone]

/-- Exact repaired-runtime policy for the undeclared embedded `unify`: tuple fallback evaluates all
four arguments and recursively evaluates the root readout. -/
def kernelCoreEnv_unify_exactPolicy
    (st : St) (atom pattern template elseAtom : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelCoreEnv st.world "unify"
      [.sym "%Undefined%"]) :
    ApplicationPolicyProjection kernelCoreEnv st.world "unify"
      [atom, pattern, template, elseAtom] [true, true, true, true] false := by
  apply ApplicationPolicyProjection.untypedTuple
  unfold selectFunctionType
  rw [hPinned]
  rfl

/-- Recursion-neutral view of the same undeclared-`unify` tuple decision. -/
def kernelCoreEnv_unify_recursionNeutralPolicy
    (st : St) (atom pattern template elseAtom : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelCoreEnv st.world "unify"
      [.sym "%Undefined%"]) :
    RecursionNeutralApplicationPolicy kernelCoreEnv st.world "unify"
      [atom, pattern, template, elseAtom] [true, true, true, true] false := by
  apply (kernelCoreEnv_unify_exactPolicy st atom pattern template elseAtom
    hPinned).withRecursionNeutral
  · change ApplicationPlanCorresponds [] (.untypedTuple _)
    apply ApplicationPlanCorresponds.ofUntypedTuple
    exact selectFunctionTypeForExpectedFrom_undefined_exhausted
      kernelCoreEnv st.world "unify" [atom, pattern, template, elseAtom] hPinned
  · exact selectedApplicationRecursionNeutral_untypedTuple 4

/-- In any LeaTTa environment using the standard groundings, evaluating an embedded
`unify` application opens the minimal `unify` stack frame.

The fact is independent of the environment's signature table: it is a
single-step property of the minimal interpreter after the outer `mettaEval`
loop has already decided which arguments to quote/evaluate. -/
theorem interpretStack1_eval_embedded_unify_var_success_of_gt
    (env : MinEnv) (fuel : Nat) (st : St)
    (binder : String) (atom template : Metta.Atom)
    (hgt : env.gt = stdGroundings) :
    interpretStack1 env fuel st
        (evalItemNil (mExpr "unify" [atom, mVar binder, template, mSym "Empty"])) =
      ([{ stack := atomToStack
            (mExpr "unify" [atom, mVar binder, template, mSym "Empty"]) [],
          bnd := [] }], st) := by
  let embedded : Item :=
    { stack := atomToStack
        (mExpr "unify" [atom, mVar binder, template, mSym "Empty"]) [],
      bnd := [] }
  rw [show evalItemNil (mExpr "unify" [atom, mVar binder, template, mSym "Empty"]) =
      { stack :=
          { atom := Metta.Atom.expr
              [Metta.Atom.sym "eval",
                mExpr "unify" [atom, mVar binder, template, mSym "Empty"]] } :: [],
        bnd := [] } by
    simp [evalItemNil, atomToStack_eval, mExpr, mSym]]
  rw [interpretStack1_eval_eq]
  unfold evalOp
  rw [show Metta.instantiate [] (mExpr "unify" [atom, mVar binder, template, mSym "Empty"]) =
      mExpr "unify" [atom, mVar binder, template, mSym "Empty"] by
    simpa using Metta.instantiate_nil
      (mExpr "unify" [atom, mVar binder, template, mSym "Empty"])]
  change
    ((match callGrounded env.gt "unify"
      ([atom, mVar binder, template, mSym "Empty"].map
        (fun a => resolveStates st.world (subTokens st.world a))) with
    | ReduceResult.ok results =>
        (results.map (fun r => evalResult [] r []), st)
    | ReduceResult.runtimeError msg =>
        ([finItem []
          (errAtom (mExpr "unify" [atom, mVar binder, template, mSym "Empty"]) msg) []], st)
    | ReduceResult.incorrectArgument _ =>
        ([finItem [] notReducibleA []], st)
    | ReduceResult.noReduce =>
        if isEmbeddedOp (mExpr "unify" [atom, mVar binder, template, mSym "Empty"]) then
          ([embedded], st)
        else
          queryOp env st []
            (mExpr "unify" [atom, mVar binder, template, mSym "Empty"]) []) =
    ([embedded], st))
  rw [callGrounded_unify_of_stdGroundings env
    ([atom, mVar binder, template, mSym "Empty"].map
      (fun a => resolveStates st.world (subTokens st.world a))) hgt]
  simp [embedded, isEmbeddedOp, mExpr, mSym]

