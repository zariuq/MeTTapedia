theorem infer_indg_params_args_nil_instantiate_bindings
    (sig : DIndGArtifactSig) (name : DeclName)
    (motive : DIndGArtifactTerm)
    (cases : List (DeclName × DIndGArtifactTerm))
    (indices : DIndGArtifactArgs) (scrut : DIndGArtifactTerm)
    (ctors : List DIndGArtifactCtor) (rawT0 : DIndGArtifactTerm) :
    Metta.instantiate
        (inferIndgParamsArgsNilRuleBindings sig name motive cases indices scrut ctors rawT0)
        inferIndgParamsArgsNilRulePair.2 =
      inferIndgParamsArgsNilReadout sig motive cases indices scrut ctors rawT0 := by
  rw [ClosedValueBindings.instantiate_eq_subst_apply]
  simp [inferIndgParamsArgsNilRuleBindings, inferIndgParamsArgsNilRulePair,
    inferIndgParamsArgsNilReadout, inferIndgParamsArgsNilAfterApplyArgs,
    inferIndgMotiveQuery, inferApplyArgsNilQuery, argsAtom, mExpr, mSym, mVar,
    ctxNilAtom, Metta.bindingsToSubst,
    Metta.Subst.apply, Metta.Subst.lookup]
  exact ClosedValueBindings.val (termAtom_vars_nil rawT0)
    (ClosedValueBindings.val (ctorsAtom_vars_nil ctors)
      (ClosedValueBindings.val (termAtom_vars_nil scrut)
        (ClosedValueBindings.val (argsAtom_vars_nil indices)
          (ClosedValueBindings.val (casesAtom_vars_nil cases)
            (ClosedValueBindings.val (termAtom_vars_nil motive)
              (ClosedValueBindings.val (declNameAtom_vars_nil name)
                (ClosedValueBindings.val
                  (by simp [ctxNilAtom, mSym, Metta.Atom.vars])
                  (ClosedValueBindings.val (sigAtom_vars_nil sig)
                    ClosedValueBindings.nil))))))))

theorem infer_indg_params_args_nil_root_mops
    (sig : DIndGArtifactSig) (name : DeclName)
    (motive : DIndGArtifactTerm)
    (cases : List (DeclName × DIndGArtifactTerm))
    (indices : DIndGArtifactArgs) (scrut : DIndGArtifactTerm)
    (ctors : List DIndGArtifactCtor) (rawT0 : DIndGArtifactTerm) :
    Relation.ReflTransGen (Metta.MopsStep kernelInferIndgParamsArgsNilRules)
      (inferIndgParamsArgsNilQuery sig name motive cases indices scrut ctors rawT0)
      (inferIndgParamsArgsNilReadout sig motive cases indices scrut ctors rawT0) := by
  have hstep : Metta.MopsStep kernelInferIndgParamsArgsNilRules
      (inferIndgParamsArgsNilQuery sig name motive cases indices scrut ctors rawT0)
      (inferIndgParamsArgsNilReadout sig motive cases indices scrut ctors rawT0) := by
    constructor
    · exact ⟨"infer-indg-params", by
        simp [inferIndgParamsArgsNilQuery, mExpr, mSym, headKey]⟩
    · rw [Metta.mem_equalityReductions]
      refine ⟨inferIndgParamsArgsNilRulePair, ?_, ?_⟩
      · simp [Metta.Space.equalityRules, kernelInferIndgParamsArgsNilRules,
          kernelInferApplyArgsNilRules, inferIndgParamsArgsNilRulePair,
          ruleInferIndgParamsArgsNil, ruleInferIndgParamsDecl, ruleInferApplyArgsDecl,
          ruleInferApplyArgsNil, inferApplyArgsNilRulePair, kernelCoreRules, runtimeDecls,
          ruleIsBad, ruleNfVar, ruleNfSrt, ruleNfCon, ruleNfPi, ruleNfLam, ruleNfBad,
          ruleInferSrtType, ruleInferSrtKind, ruleInferBad, ruleConv, mExpr, mSym, mVar,
          mTypeDecl, mBool]
      · refine ⟨inferIndgParamsArgsNilRuleBindings sig name motive cases indices scrut ctors rawT0,
          ?_, ?_⟩
        · rw [infer_indg_params_args_nil_rule_match]
          simp
        · exact (infer_indg_params_args_nil_instantiate_bindings sig name motive cases indices
            scrut ctors rawT0).symm
  exact Relation.ReflTransGen.tail Relation.ReflTransGen.refl hstep

/-- D4a bridge: the next source helper after `infer-apply-args ArgsNil`
exposes that helper as a real subquery, and the already-discharged D3 bridge is
lifted into the `let` binding position.

This theorem deliberately stops before claiming the surrounding `let`/`if`
control-flow is certified by the equality-rule relation.  It certifies the
source-aligned root helper step and the recursive `infer-apply-args ArgsNil`
substep, which is the reusable composition skeleton needed before the full App
body. -/
theorem infer_indg_params_args_nil_consumes_apply_args_nil_contextual_kernel
    {sig : DIndGArtifactSig} {name : DeclName}
    {motive : DIndGArtifactTerm}
    {cases : List (DeclName × DIndGArtifactTerm)}
    {indices : DIndGArtifactArgs} {scrut : DIndGArtifactTerm}
    {ctors : List DIndGArtifactCtor} {rawT0 : DIndGArtifactTerm}
    (hfrag : NfEqFragmentTerm rawT0) :
    ∃ out helperOut helperCertified nfRootOut nfCertified,
      helperOut ∈
          (mettaEval kernelInferApplyArgsNilEnv 1 St.init []
            (inferApplyArgsNilQuery sig rawT0)).1.map (·.1) ∧
        Metta.AlphaEq helperOut helperCertified ∧
        helperCertified = nfQuery sig rawT0 ∧
        nfRootOut ∈
          (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig rawT0)).1.map (·.1) ∧
        Metta.AlphaEq nfRootOut nfCertified ∧
        Relation.ReflTransGen
          (ExprCtxKernelStep kernelInferIndgParamsArgsNilRules stdGroundings)
          (inferIndgParamsArgsNilQuery sig name motive cases indices scrut ctors rawT0)
          (inferIndgParamsArgsNilAfterApplyArgs sig motive cases indices scrut ctors out) := by
  rcases infer_apply_args_nil_mettaEval_contextual_kernel_of_fragment
      (sig := sig) (rawType := rawT0) hfrag with
    ⟨out, helperOut, helperCertified, nfRootOut, nfCertified,
      hhelperRun, hhelperAlpha, hhelperEq, hnfRun, hnfAlpha, hsubCore⟩
  have hrootMops :=
    infer_indg_params_args_nil_root_mops sig name motive cases indices scrut ctors rawT0
  have hrootKernel :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferIndgParamsArgsNilRules stdGroundings)
        (inferIndgParamsArgsNilQuery sig name motive cases indices scrut ctors rawT0)
        (inferIndgParamsArgsNilReadout sig motive cases indices scrut ctors rawT0) :=
    exprCtxMopsChain_to_kernel (gt := stdGroundings)
      (mopsChain_to_exprCtxMopsChain hrootMops)
  have hsubLift :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferIndgParamsArgsNilRules stdGroundings)
        (inferApplyArgsNilQuery sig rawT0) out := by
    simpa [kernelInferIndgParamsArgsNilRules] using
      (exprCtxKernelChain_append_left
        (atoms := kernelInferApplyArgsNilRules)
        (extra := [ruleInferIndgParamsDecl, ruleInferIndgParamsArgsNil])
        (gt := stdGroundings) hsubCore)
  have hinside :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferIndgParamsArgsNilRules stdGroundings)
        (inferIndgParamsArgsNilReadout sig motive cases indices scrut ctors rawT0)
        (inferIndgParamsArgsNilAfterApplyArgs sig motive cases indices scrut ctors out) := by
    simpa [inferIndgParamsArgsNilReadout, inferIndgParamsArgsNilAfterApplyArgs, mExpr] using
      (exprCtxKernelChain_at
        (rules := kernelInferIndgParamsArgsNilRules) (gt := stdGroundings)
        (pre := [mSym "let", mVar "T1"])
        (post :=
          [mExpr "if"
            [ mExpr "is-bad" [mVar "T1"]
            , mVar "T1"
            , inferIndgMotiveQuery sig motive cases indices scrut ctors (mVar "T1") ]])
        hsubLift)
  exact ⟨out, helperOut, helperCertified, nfRootOut, nfCertified,
    hhelperRun, hhelperAlpha, hhelperEq, hnfRun, hnfAlpha,
    hrootKernel.trans hinside⟩

/-- Ordered type-service output for the core runtime's `infer` declaration. -/
