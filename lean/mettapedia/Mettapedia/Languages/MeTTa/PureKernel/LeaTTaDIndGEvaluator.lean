/-- A successful `true` readout of closed grounded equality determines
structural equality independently of the closed incoming value theory.  The
binding list is deliberately not normalized: only the Boolean result is
observed. -/
theorem mettaEval_kernelDefControlEnv_eq_true_beq_true_from
    (fuel : Nat) (st : St) (incoming : Metta.Bindings)
    (a b : Metta.Atom) {outBnd : Metta.Bindings}
    (hWorld : st.world = St.init.world)
    (hClosedA : a.vars = [])
    (hClosedB : b.vars = [])
    (hStateA : resolveStates st.world a = a)
    (hStateB : resolveStates st.world b = b)
    (hFloatA : AtomFloatFree a)
    (hFloatB : AtomFloatFree b)
    (hAErr : a.isError = false)
    (hBErr : b.isError = false)
    (hIncoming : ClosedValueBindings incoming)
    (hmem :
      (mBool true, outBnd) ∈
