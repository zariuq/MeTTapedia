        (mExpr "==" [termAtom raw, termAtom raw]) =
      ([(mBool true, [])], st) := by
  unfold mettaEval
  rw [Metta.instantiate_nil (mExpr "==" [termAtom raw, termAtom raw])]
  simp [kernelDefControlEnv_eq_typeMismatch st (termAtom raw) (termAtom raw),
    kernelDefControlEnv_eq_argMask, mExpr, mSym]
  have hNoErr :
      List.find? (fun ho : Metta.Atom × Metta.Atom => ho.1.isError && ho.1 != ho.2)
        [(termAtom raw, termAtom raw), (termAtom raw, termAtom raw)] = none := by
    simp [termAtom_isError_false]
  have hNoErrInst :
      List.find? (fun ho : Metta.Atom × Metta.Atom => ho.1.isError && ho.1 != ho.2)
        [(Metta.instantiate [] (termAtom raw), termAtom raw),
          (Metta.instantiate [] (termAtom raw), termAtom raw)] = none := by
    simpa [Metta.instantiate_nil] using hNoErr
  rw [hNoErrInst]
  have hroot :
      interpretFuel kernelDefControlEnv (fuel + 2) st
          [evalItemNil (mExpr "==" [termAtom raw, termAtom raw])] [] =
        ([(mBool true, [])], st) := by
    simpa [Nat.add_assoc] using
      interpretFuel_kernelDefControlEnv_termAtom_eq_self_true_eq
        (fuel + 1) st raw hWorld
  have hrootDirect :
      interpretFuel kernelDefControlEnv (fuel + 1 + 1) st
          [{ stack := atomToStack
              (Metta.Atom.expr [Metta.Atom.sym "eval",
                Metta.Atom.expr
                  [Metta.Atom.sym "==",
                    Metta.instantiate [] (termAtom raw),
                    Metta.instantiate [] (termAtom raw)]]) [],
             bnd := [] }] [] =
        ([(mBool true, [])], st) := by
    simpa [evalItemNil, mExpr, mSym, Metta.instantiate_nil, Nat.add_assoc] using hroot
  rw [hrootDirect]
  have hExtra : st.world.selfExtra = [] := by
    simpa [hWorld] using (show St.init.world.selfExtra = [] by rfl)
  have hnotNR' :
      (Metta.Atom.gnd (Metta.Ground.bool true) == Metta.Atom.sym "NotReducible") = false := by
    rfl
  have hnotSelf' :
      (Metta.Atom.gnd (Metta.Ground.bool true) ==
          Metta.Atom.expr [Metta.Atom.sym "==", termAtom raw, termAtom raw]) =
        false := by
    rfl
  have hreturns' :
      returnsAtom kernelDefControlEnv
        (Metta.Atom.expr [Metta.Atom.sym "==", termAtom raw, termAtom raw]) = false := by
    simpa [mExpr, mSym] using
      kernelDefControlEnv_eq_returnsAtom (termAtom raw) (termAtom raw)
  simp [mBool, notReducibleA,
    termAtom_vars_nil, restrictBnd_nil_vars, Metta.instantiate_nil,
    hnotNR', hnotSelf', hreturns']
  rw [show Metta.Atom.gnd (Metta.Ground.bool true) = mBool true by rfl]
  rw [mettaEval_kernelDefControlEnv_mBool_eq_state fuel st true hExtra]
  simp [mBool]

