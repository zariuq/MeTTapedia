private theorem atom_isError_false_of_beq_nfQuery_true
    (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm) (a : Metta.Atom)
    (hBeq : (a == nfQuery sig raw) = true) :
    a.isError = false := by
  change Metta.Atom.beq a (nfQuery sig raw) = true at hBeq
  cases a with
  | sym s =>
      simp [nfQuery, mExpr, mSym, Metta.Atom.beq] at hBeq
  | var v =>
      simp [nfQuery, mExpr, mSym, Metta.Atom.beq] at hBeq
  | gnd g =>
      cases g <;> simp [nfQuery, mExpr, mSym, Metta.Atom.beq] at hBeq ⊢
  | expr xs =>
      cases xs with
      | nil =>
          simp [nfQuery, mExpr, mSym, Metta.Atom.beq,
            Metta.Atom.beqList] at hBeq
      | cons head tail =>
          cases head with
          | sym s =>
              simp [nfQuery, mExpr, mSym, Metta.Atom.beq,
                Metta.Atom.beqList] at hBeq
              rcases hBeq with ⟨hs, _htail⟩
              simp [Metta.Atom.isError, hs]
          | var v =>
              simp [nfQuery, mExpr, mSym, Metta.Atom.beq,
                Metta.Atom.beqList] at hBeq
          | gnd g =>
              cases g <;> simp [nfQuery, mExpr, mSym, Metta.Atom.beq,
                Metta.Atom.beqList] at hBeq
          | expr ys =>
              simp [nfQuery, mExpr, mSym, Metta.Atom.beq,
                Metta.Atom.beqList] at hBeq

/-- The evaluated `nfQuery` position of a successful `let` row is neither
`Empty` nor an error.  This is the exact positive information retained by the
changed-terminal guard; no lawful equality assumption on arbitrary atoms is
used. -/
private theorem nfQuery_middle_nonterminal_of_find_none
    (patternOut patternSource suffixOut suffixSource : Metta.Atom)
    (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm)
    (out : Metta.Atom)
    (hNoStop :
      (([patternOut, out, suffixOut].zip
          [patternSource, nfQuery sig raw, suffixSource]).find?
        (fun pair : Metta.Atom × Metta.Atom =>
          (pair.1 == emptyA || pair.1.isError) && pair.1 != pair.2)) = none) :
    (out == emptyA || out.isError) = false := by
  have hMem :
      (out, nfQuery sig raw) ∈
        [patternOut, out, suffixOut].zip
          [patternSource, nfQuery sig raw, suffixSource] := by
    simp
  by_cases hTerminal : (out == emptyA || out.isError) = true
  · have hChanged : (out != nfQuery sig raw) = true := by
      rcases Bool.or_eq_true_iff.mp hTerminal with hEmpty | hError
      · have hEq : out = emptyA := (beq_empty_eq_true_iff out).mp hEmpty
        subst out
        rfl
      · have hBeqFalse : (out == nfQuery sig raw) = false := by
          cases hBeq : (out == nfQuery sig raw) <;> simp
          have hNoError :=
            atom_isError_false_of_beq_nfQuery_true sig raw out hBeq
          rw [hNoError] at hError
          cases hError
        simp [bne, hBeqFalse]
    exact False.elim
      ((argument_not_changed_terminal_of_mem_zip hNoStop hMem)
        ⟨Bool.or_eq_true_iff.mp hTerminal, hChanged⟩)
  · cases hValue : (out == emptyA || out.isError) <;>
      simp [hValue] at hTerminal ⊢

