private theorem mettaEvalExprRootFoldStep_hits_recursive_eval_bnd_local
    (env : MinEnv) (fuel : Nat) (queryVars : List String)
    (w : Metta.Atom) (partBnd : Metta.Bindings)
    (acc : List (Metta.Atom × Metta.Bindings) × St)
    (p : Metta.Atom × Metta.Bindings)
    (final : Metta.Atom) (finalBnd : Metta.Bindings)
    (hnotNR : (p.1 == notReducibleA) = false)
    (hnotSelf : (p.1 == w) = false)
    (hReturns : returnsAtom env w = false)
    (hFinal :
      (final, finalBnd) ∈
        (mettaEval env fuel acc.2
          (restrictBnd queryVars ((Metta.Bindings.merge partBnd p.2).head?.getD p.2))
          p.1).1) :
    (final,
        restrictBnd queryVars
          ((Metta.Bindings.merge
            (restrictBnd queryVars ((Metta.Bindings.merge partBnd p.2).head?.getD p.2))
            finalBnd).head?.getD finalBnd)) ∈
      (mettaEvalExprRootFoldStep env fuel queryVars w partBnd acc p).1 := by
  unfold mettaEvalExprRootFoldStep
  have hfirst : ¬ ((p.1 == notReducibleA) = true ∨ (p.1 == w) = true) := by
    intro h
    cases h with
    | inl hnr =>
        rw [hnotNR] at hnr
        cases hnr
    | inr hself =>
        rw [hnotSelf] at hself
        cases hself
  split
  · rename_i hbranch
    exact False.elim (hfirst hbranch)
  · split
    · rename_i hbranch
      have hret : returnsAtom env w = true := hbranch.1
      rw [hReturns] at hret
      cases hret
    · exact List.mem_append.mpr
        (Or.inr (List.mem_map.mpr ⟨(final, finalBnd), hFinal, by simp⟩))

