private theorem mettaEval_kernelDefControlEnv_eq_bool_of_root
    (fuel : Nat) (st : St) (a b : Metta.Atom) (value : Bool)
    (hWorld : st.world = St.init.world)
    (hAErr : a.isError = false) (hBErr : b.isError = false)
    (hRoot :
      interpretFuel kernelDefControlEnv (fuel + 2) st
          [evalItemNil (mExpr "==" [a, b])] [] =
        ([(mBool value, [])], st)) :
    mettaEval kernelDefControlEnv (fuel + 2) st [] (mExpr "==" [a, b]) =
      ([(mBool value, [])], st) := by
  have hTypes : KernelDefControlEnvTypeWorld st.world :=
    kernelDefControlEnvTypeWorld_init.transport hWorld
  change mettaEval kernelDefControlEnv (fuel + 2) st []
      (Metta.Atom.expr [Metta.Atom.sym "==", a, b]) =
    ([(mBool value, [])], st)
  rw [show fuel + 2 = (fuel + 1) + 1 by omega]
  let hPolicy := kernelDefControlEnv_eq_exactPolicy st a b hTypes.eqOp
  have hEqTypes : getTypes kernelDefControlEnv
      (typePrep st.world (.sym "==")) =
        [.expr [.sym "->", .sym "Atom", .sym "Atom", .sym "Bool"]] := by
    simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.eqOp
  have hPlan : ApplicationPlanCorresponds []
      (.selected hPolicy.decision.selectedType hPolicy.selected_eq) :=
    hPolicy.applicationPlanCorresponds hEqTypes
  have hArgumentPolicies :
      argumentEvaluationPolicies hPolicy.decision.selectedType 2 =
        [(false, .sym "Atom"), (false, .sym "Atom")] := by
    simpa using hPolicy.argumentPolicies_eq
  rw [mettaEval_eq_evaluateExpectedApplication_of_selected
    kernelDefControlEnv (fuel + 1) st "==" [a, b]
      hPolicy.decision.selectedType (by simp [Metta.Atom.isError])
      hPolicy.selected_eq hPlan]
  have hRootDirect :
      interpretFuel kernelDefControlEnv (fuel + 1 + 1) st
          [{ stack := atomToStack
              (Metta.Atom.expr [Metta.Atom.sym "eval",
                Metta.Atom.expr [Metta.Atom.sym "==", a, b]]) [], bnd := [] }] [] =
        ([(mBool value, [])], st) := by
    simpa [evalItemNil, mExpr, mSym, Nat.add_assoc] using hRoot
  have hExtra : st.world.selfExtra = [] := by
    simpa [hWorld] using (show St.init.world.selfExtra = [] by rfl)
  have hImports : st.world.selfImports = [] := by
    simpa [hWorld] using (show St.init.world.selfImports = [] by rfl)
  have hRecBnd :
      restrictBnd (expectedApplicationRetentionScope [] [a, b])
          ((Metta.Bindings.merge [] ([] : Metta.Bindings)).head?.getD []) = [] := by
    simpa using
      restrictBnd_empty_merge_empty
        (expectedApplicationRetentionScope [] [a, b])
  simp only [evaluateExpectedApplication, evaluateExpectedApplicationFrom,
    hArgumentPolicies,
    List.length_cons, List.length_nil, Nat.reduceAdd,
    List.zip_cons_cons, List.zip_nil_right, List.foldl_cons, List.foldl_nil]
  simp [Metta.instantiate_nil, hAErr, hBErr]
  rw [hRootDirect]
  have hNotNR :
      (Metta.Atom.gnd (Metta.Ground.bool value) == Metta.Atom.sym "NotReducible") =
        false := by
    cases value <;> rfl
  have hNotSelf :
      (Metta.Atom.gnd (Metta.Ground.bool value) ==
        Metta.Atom.expr [Metta.Atom.sym "==", a, b]) = false := by
    cases value <;> rfl
  have hFinal :
      mettaEvalExpected kernelDefControlEnv (fuel + 1) st []
          (mBool value) (.sym "Bool") =
        ([(mBool value, [])], st) := by
    simpa [mBool, mSym, hPolicy.resultExpected_eq] using
      mettaEvalExpected_kernelDefControlEnv_mBool_bool_eq_state
        fuel st value hExtra hImports
  have hFinalLit :
      mettaEvalExpected kernelDefControlEnv (fuel + 1) st []
          (.gnd (.bool value)) (.sym "Bool") =
        ([(.gnd (.bool value), [])], st) := by
    simpa [mBool] using hFinal
  have hNotNR' :
      (Metta.Atom.gnd (Metta.Ground.bool value) == notReducibleA) = false := by
    simpa [notReducibleA] using hNotNR
  simp [mBool, mSym, hPolicy.returnsAtom_selectedType_eq,
    hPolicy.resultExpected_eq, hRecBnd]
  rw [hNotNR', hNotSelf]
  simp only [Bool.false_eq_true, if_false]
  have hRecBnd' :
      restrictBnd (a.vars ++ b.vars)
          ((Metta.Bindings.merge [] ([] : Metta.Bindings)).head?.getD []) = [] := by
    simpa using hRecBnd
  rw [hRecBnd', hFinalLit]
  simp [restrictBnd_empty_merge_empty]

