/-- Runtime-root package for the equality-rule-only `nf` fragment.

For every declarative fragment readout, the actual minimal evaluator has a root
readout for the same `nf` query; LeaTTa's certified MOPS relation reaches the
unfreshened root reduct; the runtime-freshened root readout is α-equivalent to
that certified reduct; and the existing recursive fragment spine continues from
the certified root reduct to the final fragment readout. This is the evaluator
boundary D2 needs before lifting through the full outer `mettaEval` constructor
loop. -/
theorem nf_eq_fragment_evalAtomMin_root_bridge_alpha_mops
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : NfEqFragmentReadout sig raw out) :
    ∃ rootOut rootCertified,
      rootOut ∈ evalAtomMin kernelCoreEnv 1 (nfQuery sig raw) ∧
        Relation.ReflTransGen (Metta.MopsStep kernelCoreRules)
          (nfQuery sig raw) rootCertified ∧
        Metta.AlphaEq rootOut rootCertified ∧
        Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules) rootCertified out := by
  cases h with
  | var k =>
      rcases nf_var_evalAtomMin_bridge_alpha_mops sig k with ⟨hmem, hroot, halpha⟩
      exact ⟨_, termAtom (.var k), hmem, hroot, halpha, Relation.ReflTransGen.refl⟩
  | srt sort =>
      rcases nf_srt_evalAtomMin_bridge_alpha_mops sig sort with ⟨hmem, hroot, halpha⟩
      exact ⟨_, termAtom (.srt sort), hmem, hroot, halpha, Relation.ReflTransGen.refl⟩
  | con name =>
      rcases nf_con_evalAtomMin_bridge_alpha_mops sig name with ⟨hmem, hroot, halpha⟩
      exact ⟨_, termAtom (.con name), hmem, hroot, halpha, Relation.ReflTransGen.refl⟩
  | bad reason =>
      rcases nf_bad_evalAtomMin_bridge_alpha_mops sig reason with ⟨hmem, hroot, halpha⟩
      exact ⟨_, termAtom (.bad reason), hmem, hroot, halpha, Relation.ReflTransGen.refl⟩
  | pi hDomain hBody =>
      rename_i rawDomain rawBody domainOut bodyOut
      rcases nf_pi_evalAtomMin_bridge_alpha_mops sig rawDomain rawBody with
        ⟨hmem, hroot, halpha⟩
      have hDomainCtx :
          Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules)
            (nfPiReadout sig rawDomain rawBody)
            (mExpr "Pi" [domainOut, nfQuery sig rawBody]) := by
        simpa [nfPiReadout, nfQuery, mExpr, mSym] using
          exprCtxMopsChain_at (rules := kernelCoreRules)
            [mSym "Pi"] [nfQuery sig rawBody]
            (nf_eq_fragment_reaches_mops_context hDomain)
      have hBodyCtx :
          Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules)
            (mExpr "Pi" [domainOut, nfQuery sig rawBody])
            (mExpr "Pi" [domainOut, bodyOut]) := by
        simpa [nfQuery, mExpr, mSym] using
          exprCtxMopsChain_at (rules := kernelCoreRules)
            [mSym "Pi", domainOut] ([] : List Metta.Atom)
            (nf_eq_fragment_reaches_mops_context hBody)
      exact ⟨_, nfPiReadout sig rawDomain rawBody, hmem, hroot, halpha,
        hDomainCtx.trans hBodyCtx⟩
  | lam hDomain hBody =>
      rename_i rawDomain rawBody domainOut bodyOut
      rcases nf_lam_evalAtomMin_bridge_alpha_mops sig rawDomain rawBody with
        ⟨hmem, hroot, halpha⟩
      have hDomainCtx :
          Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules)
            (nfLamReadout sig rawDomain rawBody)
            (mExpr "Lam" [domainOut, nfQuery sig rawBody]) := by
        simpa [nfLamReadout, nfQuery, mExpr, mSym] using
          exprCtxMopsChain_at (rules := kernelCoreRules)
            [mSym "Lam"] [nfQuery sig rawBody]
            (nf_eq_fragment_reaches_mops_context hDomain)
      have hBodyCtx :
          Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules)
            (mExpr "Lam" [domainOut, nfQuery sig rawBody])
            (mExpr "Lam" [domainOut, bodyOut]) := by
        simpa [nfQuery, mExpr, mSym] using
          exprCtxMopsChain_at (rules := kernelCoreRules)
            [mSym "Lam", domainOut] ([] : List Metta.Atom)
            (nf_eq_fragment_reaches_mops_context hBody)
      exact ⟨_, nfLamReadout sig rawDomain rawBody, hmem, hroot, halpha,
        hDomainCtx.trans hBodyCtx⟩

/-- Executing the core `conv` query for one scheduler step emits a freshened
readout that is alpha-equivalent to the certified `KernelStep` readout.

Unlike the `nf`/`Pi` and `nf`/`Lam` probes above, full `conv` also has
interpreter control-flow (`let`/`if`/`==`) after its `nf` subcalls. This theorem
keeps only the equality-rule firing boundary explicit. -/
theorem conv_interpretStack1_bridge_alpha
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    evalResult []
          (Metta.instantiate
            (renameBindings (counterSuffix St.init.counter)
              (convRuleBindings sig rawLeft rawRight)).reverse
            (freshenRule St.init.counter convRuleLhs convRuleRhs).2)
          (renameBindings (counterSuffix St.init.counter)
            (convRuleBindings sig rawLeft rawRight)).reverse ∈
        (interpretStack1 kernelCoreEnv 0 St.init
          { stack := [{ atom := Metta.Atom.expr [Metta.Atom.sym "eval",
              convQuery sig rawLeft rawRight] }]
          , bnd := [] }).1 ∧
      Metta.KernelStep kernelCoreRules stdGroundings
        (convQuery sig rawLeft rawRight)
        (Metta.instantiate (convRuleBindings sig rawLeft rawRight) convRuleRhs) ∧
      Metta.AlphaEq
        (Metta.instantiate
          (renameBindings (counterSuffix St.init.counter)
            (convRuleBindings sig rawLeft rawRight)).reverse
          (freshenRule St.init.counter convRuleLhs convRuleRhs).2)
        (Metta.instantiate (convRuleBindings sig rawLeft rawRight) convRuleRhs) := by
  let coreB : Metta.Bindings := convRuleBindings sig rawLeft rawRight
  let lhs : Metta.Atom := convRuleLhs
  let rhs : Metta.Atom := convRuleRhs
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (termAtom_vars_nil rawRight)
      (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))
  have hnodup : (bindingValueKeys coreB).Nodup := by
    dsimp [coreB, convRuleBindings, bindingValueKeys]
    decide
  have hsplit :
      (MinEnv.ofAtomsGT kernelCoreRules stdGroundings).candidates
          (convQuery sig rawLeft rawRight) =
        [] ++ (lhs, rhs) :: [] := by
    have hcand := kernelCoreEnv_conv_candidates sig rawLeft rawRight
    have hstatic :=
      candidatesW_init_eq_candidates kernelCoreEnv (convQuery sig rawLeft rawRight)
    rw [hstatic] at hcand
    simpa [kernelCoreEnv, lhs, rhs] using hcand
  have hclosedTarget : (convQuery sig rawLeft rawRight).vars = [] := by
    simp [convQuery, sigAtom_vars_nil sig, termAtom_vars_nil rawLeft,
      termAtom_vars_nil rawRight, mExpr, mSym, Metta.Atom.vars]
  have hmatchCore : coreB ∈ Metta.matchAtoms lhs (convQuery sig rawLeft rawRight) := by
    simpa [coreB, lhs, convRuleBindings, convRuleLhs] using
      (by
        rw [conv_rule_match]
        simp [convRuleBindings] :
        convRuleBindings sig rawLeft rawRight ∈
          Metta.matchAtoms (mExpr "conv" [mVar "sig", mVar "x", mVar "y"])
            (convQuery sig rawLeft rawRight))
  have hcompat := legacyFresheningCompatible_empty_of_target_vars_nil
    St.init.counter (convQuery sig rawLeft rawRight) lhs rhs hclosedTarget
  have hbridge :=
    interpretStack1_eval_renamed_closed_coreBinding_reverse_alpha_of_match
      (atoms := kernelCoreRules) (gt := stdGroundings) (st := St.init) (fuel := 0)
      (prev := []) (x := convQuery sig rawLeft rawRight) (lhs := lhs) (rhs := rhs)
      (coreB := coreB) (op := "conv")
      (args := [sigAtom sig, termAtom rawLeft, termAtom rawRight])
      (pre := []) (post := [])
      hclosedTarget hclosedB hnodup rfl
      (by simp [Metta.instantiate_nil, convQuery, mExpr, mSym])
      (kernelCoreEnv_callGrounded_conv sig rawLeft rawRight) (by rfl) hsplit hcompat hmatchCore
  simpa [kernelCoreEnv, coreB, lhs, rhs, St.init, convQuery, convRuleBindings,
    convRuleLhs, convRuleRhs, mExpr, mSym] using hbridge

