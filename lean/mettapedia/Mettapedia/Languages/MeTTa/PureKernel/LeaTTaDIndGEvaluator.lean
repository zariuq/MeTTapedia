theorem mettaEval_kernelDefControlEnv_nf_srt_body_eq_state
    (fuel : Nat) (st : St) (sig : DIndGArtifactSig) (sort : DIndGArtifactSort)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hTypes : KernelDefControlEnvTypeWorld st.world) :
    mettaEval kernelDefControlEnv (fuel + 3) st [] (nfQuery sig (.srt sort)) =
      ([(termAtom (.srt sort), [])],
        { counter := st.counter + 8, world := st.world }) := by
  let root := termAtom (.srt sort)
  let rootBnd :=
    (renameBindings (counterSuffix (st.counter + 1))
      (nfSrtRuleBindings sig sort)).reverse
  let stRoot : St := { counter := st.counter + 8, world := st.world }
  have hRoot :
      interpretFuel kernelDefControlEnv (fuel + 2 + 1) st
          [evalItemNil (nfQuery sig (.srt sort))] [] =
        ([(root, rootBnd)], stRoot) := by
    simpa [root, rootBnd, stRoot, Nat.add_assoc] using
      interpretFuel_kernelDefControlEnv_nf_srt_root_eq
        (fuel := fuel + 2) (st := st) sig sort hStatic hImports
  have hFinal :
      mettaEval kernelDefControlEnv (fuel + 2) stRoot
          (restrictBnd (([sigAtom sig, termAtom (.srt sort)]).flatMap Metta.Atom.vars)
            ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) root =
        ([(termAtom (.srt sort), [])], stRoot) := by
    have hStaticRoot : stRoot.world.selfExtra = [] := by
      simpa [stRoot] using hStatic
    simpa [root, stRoot, restrictBnd_nil_vars, List.flatMap,
      sigAtom_vars_nil sig, termAtom_vars_nil (.srt sort), Nat.add_assoc] using
      mettaEval_kernelDefControlEnv_termAtom_srt_eq_state fuel stRoot sort hStaticRoot
        (by simpa [stRoot] using hImports) (by simpa [stRoot] using hTypes)
  have hNoErr :
      (([sigAtom sig, termAtom (.srt sort)].zip [sigAtom sig, termAtom (.srt sort)]).find?
        (fun ho : Metta.Atom × Metta.Atom => (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none := by
    simp [sigAtom_isError_false, termAtom_isError_false]
  have hRootNotNR : (root == notReducibleA) = false := by
    simpa [root] using termAtom_beq_notReducible_false (.srt sort)
  have hRootNotSelf : (root == nfQuery sig (.srt sort)) = false := by
    cases sort <;> simp [root, nfQuery, termAtom, sortAtom, mExpr, mSym] <;> rfl
  have hExact :=
    mettaEval_binary_expr_eq_of_quoted_args_and_root_eval_eq
      (env := kernelDefControlEnv) (fuel := fuel + 2)
      (st := st) (stRoot := stRoot) (stOut := stRoot)
      (op := "nf") (x := sigAtom sig) (y := termAtom (.srt sort))
      (root := root) (final := termAtom (.srt sort)) (rootBnd := rootBnd)
      (kernelDefControlEnv_nf_recursionNeutralPolicy st (sigAtom sig)
        (termAtom (.srt sort)) hTypes.nf) (by simp [Metta.Atom.isError]) hNoErr
      (by simpa [nfQuery, mExpr, mSym, root, rootBnd, stRoot, Nat.add_assoc] using hRoot)
      hRootNotNR
      (by simpa [nfQuery, mExpr, mSym] using hRootNotSelf)
      hFinal
  simpa [nfQuery, mExpr, mSym, root, rootBnd, stRoot, restrictBnd_nil_vars, List.flatMap,
    sigAtom_vars_nil sig, termAtom_vars_nil (.srt sort), Nat.add_assoc] using hExact

/-- Exact `nf Srt` evaluation under one closed public value binding.

The query worker introduces two private rule bindings, but both public
projection boundaries retain only the caller's singleton.  The reconciliation
premise is explicit because grounded `Atom` equality is not lawful in general. -/
theorem mettaEval_kernelDefControlEnv_nf_srt_body_eq_state_singleton_closed
    (fuel : Nat) (st : St) (sig : DIndGArtifactSig)
    (sort : DIndGArtifactSort) (binder : String) (value : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hTypes : KernelDefControlEnvTypeWorld st.world)
    (hValueClosed : value.vars = [])
    (hValueNonVar : ∀ name, value ≠ Metta.Atom.var name)
    (hValueUnify : Metta.Bindings.unifyValues [value, value] = some [])
    (hFresh :
      ∀ {v : String}, v = "s" ∨ v = "sig" →
        counterSuffix (st.counter + 1) v ≠ binder) :
    mettaEval kernelDefControlEnv (fuel + 3) st
        [Metta.BindingRel.val binder value] (nfQuery sig (.srt sort)) =
      ([(termAtom (.srt sort), [Metta.BindingRel.val binder value])],
        { counter := st.counter + 8, world := st.world }) := by
  let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
  let args : List Metta.Atom := [sigAtom sig, termAtom (.srt sort)]
  let f := counterSuffix (st.counter + 1)
  let sKey := f "s"
  let sigKey := f "sig"
  let root := termAtom (.srt sort)
  let rootBnd : Metta.Bindings :=
    (renameBindings f (nfSrtRuleBindings sig sort)).reverse ++ incoming
  let merged : Metta.Bindings :=
    [ Metta.BindingRel.val sKey (sortAtom sort)
    , Metta.BindingRel.val sigKey (sigAtom sig)
    , Metta.BindingRel.val binder value ]
  let stRoot : St := { counter := st.counter + 8, world := st.world }
  have hIncomingClosed : ClosedValueBindings incoming :=
    ClosedValueBindings.val hValueClosed ClosedValueBindings.nil
  have hLoop : Metta.Bindings.hasLoop incoming = false :=
    hIncomingClosed.hasLoop_false
  let plan := selectedApplicationExecutionPlan_atom_args_symbolic_return_from
    kernelDefControlEnv st.world "nf" "%Undefined%" args incoming hLoop
      (by simpa [args, OperatorTypesPinned, mExpr, mSym] using hTypes.nf)
  have hsBinder : sKey ≠ binder := by
    exact hFresh (v := "s") (Or.inl rfl)
  have hsigBinder : sigKey ≠ binder := by
    exact hFresh (v := "sig") (Or.inr rfl)
  have hsSig : sKey ≠ sigKey := by
    intro h
    exact (by decide : "s" ≠ "sig")
      ((counterSuffix_injective (st.counter + 1)) (by simpa [sKey, sigKey, f] using h))
  have hRootBndEq : rootBnd =
      [ Metta.BindingRel.val sigKey (sigAtom sig)
      , Metta.BindingRel.val sKey (sortAtom sort)
      , Metta.BindingRel.val binder value ] := by
    simp [rootBnd, incoming, nfSrtRuleBindings, renameBindings, f, sKey, sigKey]
  have hFirst :
      Metta.Bindings.mergeOne [incoming]
          (Metta.BindingRel.val sigKey (sigAtom sig)) =
        [[Metta.BindingRel.val sigKey (sigAtom sig)] ++ incoming] := by
    apply mergeOne_singleton_val_of_not_mem hIncomingClosed
      (sigAtom_vars_nil sig)
    simpa [incoming, bindingValueKeys] using hsigBinder
  have hSecond :
      Metta.Bindings.mergeOne
          [[Metta.BindingRel.val sigKey (sigAtom sig)] ++ incoming]
          (Metta.BindingRel.val sKey (sortAtom sort)) =
        [[Metta.BindingRel.val sKey (sortAtom sort),
          Metta.BindingRel.val sigKey (sigAtom sig)] ++ incoming] := by
    apply mergeOne_singleton_val_of_not_mem
      (ClosedValueBindings.val (sigAtom_vars_nil sig) hIncomingClosed)
      (by cases sort <;> simp [sortAtom, mSym, Metta.Atom.vars])
    simp [incoming, bindingValueKeys, hsSig, hsBinder]
  have hValues : Metta.Bindings.classValues merged binder = [value] := by
    rw [Metta.Bindings.classValues_eq_lookupVal_toList_of_eqVarsInOrder_nil]
    · simp [merged, Metta.Bindings.lookupVal, Ne.symm hsBinder,
        Ne.symm hsigBinder]
    · rfl
  have hThirdAdd :
      Metta.Bindings.addVarBinding merged binder value = [merged] := by
    apply Metta.Bindings.addVarBinding_nochange (values := [value])
    · exact hValueNonVar
    · exact hValues
    · simp
    · simpa using hValueUnify
  have hThird :
      Metta.Bindings.mergeOne [merged]
          (Metta.BindingRel.val binder value) = [merged] := by
    simpa [Metta.Bindings.mergeOne] using hThirdAdd
  have hMergeRoot : Metta.Bindings.merge incoming rootBnd = [merged] := by
    rw [hRootBndEq]
    unfold Metta.Bindings.merge
    simp only [List.foldl_cons, List.foldl_nil]
    rw [hFirst, hSecond]
    simpa [merged, incoming] using hThird
  have hMergedClosed : ClosedValueBindings merged :=
    ClosedValueBindings.val
      (by cases sort <;> simp [sortAtom, mSym, Metta.Atom.vars])
      (ClosedValueBindings.val (sigAtom_vars_nil sig) hIncomingClosed)
  have hMergedLookup : Metta.Bindings.lookupVal merged binder = some value := by
    simp [merged, Metta.Bindings.lookupVal, Ne.symm hsBinder,
      Ne.symm hsigBinder]
  have hRestrictRoot : restrictBnd [binder] merged = incoming := by
    simpa [incoming] using
      restrictBnd_singleton_of_closed_lookup merged binder value
        hMergedClosed hMergedLookup hValueClosed hValueNonVar
  have hIncomingVars : Metta.Bindings.vars incoming = [binder] := by
    unfold Metta.Bindings.vars
    simp only [incoming, List.flatMap_cons, List.flatMap_nil, List.append_nil]
    rw [hValueClosed]
    rfl
  have hScope : expectedApplicationRetentionScope incoming args = [binder] := by
    simp [expectedApplicationRetentionScope, args, incoming, hIncomingVars,
      sigAtom_vars_nil sig, termAtom_vars_nil (.srt sort)]
  have hRetained :
      restrictBnd (expectedApplicationRetentionScope incoming args)
          ((Metta.Bindings.merge incoming rootBnd).head?.getD rootBnd) =
        incoming := by
    rw [hScope, hMergeRoot]
    simp [hRestrictRoot]
  have hMergeSelf : Metta.Bindings.merge incoming incoming = [incoming] := by
    simpa [incoming] using
      merge_singleton_closed_self_eq binder value hValueNonVar hValueUnify
  have hRestrictSelf : restrictBnd [binder] incoming = incoming := by
    simpa [incoming] using
      restrictBnd_singleton_closed_val binder value hValueClosed hValueNonVar
  have hSourceClosed : (nfQuery sig (.srt sort)).vars = [] := by
    simp [nfQuery, sigAtom_vars_nil sig, termAtom_vars_nil (.srt sort),
      mExpr, mSym, Metta.Atom.vars]
  have hInst : Metta.instantiate incoming (nfQuery sig (.srt sort)) =
      Metta.Atom.expr (Metta.Atom.sym "nf" :: args) := by
    rw [instantiate_eq_self_of_vars_nil incoming hSourceClosed]
    rfl
  have hArgsStable : args.map (Metta.instantiate incoming) = args := by
    simp [args, instantiate_eq_self_of_vars_nil incoming
      (sigAtom_vars_nil sig), instantiate_eq_self_of_vars_nil incoming
      (termAtom_vars_nil (.srt sort))]
  have hSeed : plan.seeds = [incoming] := by
    simp [plan, SelectedApplicationExecutionPlan.seeds,
      selectedApplicationInitialBindingsFromTheory,
      expectedApplicationVisibleScope, args, sigAtom_vars_nil sig,
      termAtom_vars_nil (.srt sort), Metta.Atom.vars,
      restrictBnd_nil_vars, Metta.Bindings.merge]
  have hMask : argMask plan.selected args.length =
      List.replicate args.length false := by
    rw [selectedApplicationExecutionPlan_atom_args_symbolic_return_from_selected]
    change List.replicate 2
        (Metta.instantiate incoming (.sym "Atom") != .sym "Atom" &&
          Metta.instantiate incoming (.sym "Atom") != .sym "Variable" &&
          Metta.instantiate incoming (.sym "Atom") != .sym "Expression") =
      List.replicate 2 false
    rw [instantiate_sym]
    decide
  have hReturn : returnsAtom plan.selected = false := by
    rw [selectedApplicationExecutionPlan_atom_args_symbolic_return_from_selected]
    unfold returnsAtom
    rw [show Metta.instantiate incoming (.sym "%Undefined%") =
      .sym "%Undefined%" by exact instantiate_sym incoming "%Undefined%"]
    rfl
  have hNoErr :
      (((args.map (Metta.instantiate incoming)).zip args).find?
        (fun pair =>
          (pair.1 == emptyA || pair.1.isError) && pair.1 != pair.2)) = none := by
    rw [hArgsStable]
    simp [args, sigAtom_isError_false, termAtom_isError_false]
  have hRoot :
      interpretFuel kernelDefControlEnv (fuel + 2 + 1) st
          [{ stack := atomToStack
              (Metta.Atom.expr [Metta.Atom.sym "eval",
                Metta.Atom.expr
                  (Metta.Atom.sym "nf" ::
                    args.map (Metta.instantiate incoming))]) [],
             bnd := incoming }] [] =
        ([(root, rootBnd)], stRoot) := by
    rw [hArgsStable]
    simpa [args, evalItemBnd, nfQuery, root, rootBnd, stRoot, f,
      Nat.add_assoc, mExpr, mSym] using
      interpretFuel_kernelDefControlEnv_nf_srt_root_eq_singleton_closed
        (fuel := fuel + 2) (st := st) sig sort binder value
          hStatic hImports hValueClosed hFresh
  have hExpected : selectedResultExpected plan.selected =
      Metta.Atom.sym "%Undefined%" := by
    rw [selectedApplicationExecutionPlan_atom_args_symbolic_return_from_selected]
    unfold selectedResultExpected
    rw [show Metta.instantiate incoming (.sym "%Undefined%") =
      .sym "%Undefined%" by exact instantiate_sym incoming "%Undefined%"]
    rfl
  have hFinal :
      mettaEvalExpected kernelDefControlEnv (fuel + 2) stRoot
          (restrictBnd (expectedApplicationRetentionScope incoming args)
            ((Metta.Bindings.merge incoming rootBnd).head?.getD rootBnd))
          root (selectedResultExpected plan.selected) =
        ([(root, incoming)], stRoot) := by
    rw [hRetained, hExpected, mettaEvalExpected_undefined]
    simpa [root, stRoot] using
      mettaEval_kernelDefControlEnv_termAtom_srt_eq_state_singleton_closed
        fuel stRoot binder value sort (by simpa [stRoot] using hStatic)
          (by simpa [stRoot] using hImports) (by simpa [stRoot] using hTypes)
          hValueClosed hValueNonVar hValueUnify
  have hRootNotNR : (root == notReducibleA) = false := by
    simpa [root] using termAtom_beq_notReducible_false (.srt sort)
  have hRootNotSelf :
      (root == Metta.Atom.expr
        (Metta.Atom.sym "nf" :: args.map (Metta.instantiate incoming))) = false := by
    rw [hArgsStable]
    cases sort <;> simp [root, args, termAtom, sortAtom, mExpr, mSym] <;> rfl
  have hExact :=
    mettaEval_expr_eq_of_instantiated_all_quoted_and_root_expected_eq_bnd
      kernelDefControlEnv (fuel + 2) st stRoot stRoot incoming
      (nfQuery sig (.srt sort)) "nf" args root root rootBnd incoming plan
      hInst (by simp [args, Metta.Atom.isError]) hSeed hMask hReturn hNoErr
      hRoot hRootNotNR hRootNotSelf hFinal
  rw [hRetained, hScope, hMergeSelf] at hExact
  simp only [List.head?_cons, Option.getD_some] at hExact
  rw [hRestrictSelf] at hExact
  simpa [root, stRoot, incoming, Nat.add_assoc] using hExact

private theorem queryOpItems_nf_var_eq
    (counter : Nat) (sig : DIndGArtifactSig) (k : Nat) :
    Metta.Minimal.queryOpItemsOfRule [] (nfQuery sig (.var k)) [] counter nfVarRulePair =
      [evalResult [] (termAtom (.var k))
        ((renameBindings (counterSuffix counter) (nfVarRuleBindings sig k)).reverse)] := by
  let f := counterSuffix counter
  let coreB : Metta.Bindings := nfVarRuleBindings sig k
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  let root : Metta.Atom := termAtom (.var k)
  have hfresh :
      freshenRule counter nfVarRulePair.1 nfVarRulePair.2 =
        (mExpr "nf" [mVar (f "sig"), mExpr "Var" [mVar (f "k")]],
          mExpr "Var" [mVar (f "k")]) := by
    rw [freshenRule_eq_renBy]
    simp [f, nfVarRulePair, mExpr, mSym, mVar,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms
          (mExpr "nf" [mVar (f "sig"), mExpr "Var" [mVar (f "k")]])
          (nfQuery sig (.var k)) =
        [renameBindings f coreB] := by
    have hraw := match_binary_nested_unary_vars "nf" (f "sig") "Var" (f "k")
        (sigAtom sig) (mNat k)
        (by
          intro h
          have : "k" = "sig" := (counterSuffix_injective counter) h
          contradiction)
        (sigAtom_vars_absent sig) (mNat_vars_absent k)
        (sigAtom_not_var sig) (mNat_not_var k)
    unfold Metta.matchAtoms
    rw [show Metta.matchAtomsWith none
        (mExpr "nf" [mVar (f "sig"), mExpr "Var" [mVar (f "k")]])
        (nfQuery sig (.var k)) = [renameBindings f coreB] by
      simpa only [nfQuery, termAtom, coreB, nfVarRuleBindings,
        renameBindings] using hraw]
    exact filter_singleton_binding_of_hasLoop_false _
      (ClosedValueBindings.hasLoop_false
        (ClosedValueBindings.rename
          (ClosedValueBindings.val (mNat_vars_nil k)
            (ClosedValueBindings.val (sigAtom_vars_nil sig)
              ClosedValueBindings.nil))))
  have hmerge :
      Metta.Bindings.merge [] (renameBindings f coreB) = [m] := by
    have hclosedB : ClosedValueBindings coreB := by
      exact ClosedValueBindings.val (mNat_vars_nil k)
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
    have hnodup : (bindingValueKeys coreB).Nodup := by
      simp [coreB, nfVarRuleBindings, bindingValueKeys]
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename hclosedB
    have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
      rw [bindingValueKeys_renameBindings]
      exact List.Nodup.map (counterSuffix_injective counter) hnodup
    simpa [m] using
      (merge_closed_noConflict_eq hclosedRen hnodupRen ClosedValueBindings.nil
        (by intro x hx hmem; cases hmem))
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (by simp [mNat, Metta.Atom.vars])
      (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
  have hclosedM : ClosedValueBindings m := by
    simpa [m, coreB, f] using
      ClosedValueBindings.reverse (ClosedValueBindings.rename hclosedB)
  have hloop : Metta.Bindings.hasLoop m = false := by
    exact ClosedValueBindings.hasLoop_false hclosedM
  have hresult :
      Metta.instantiate m (mExpr "Var" [mVar (f "k")]) = root := by
    have hkSig : f "k" ≠ f "sig" := by
      intro h
      have hk : "k" = "sig" := (counterSuffix_injective counter) h
      contradiction
    rw [hclosedM.instantiate_eq_subst_apply]
    simp [root, m, coreB, nfVarRuleBindings, renameBindings, f, termAtom,
      Metta.bindingsToSubst, Metta.Subst.apply, Metta.Subst.lookup,
      mExpr, mSym, mVar, mNat, hkSig]
  rw [queryOpItemsOfRule_nfQuery_eq_legacy]
  rw [hfresh]
  change
    List.flatMap
        (fun mb =>
          List.filterMap
            (fun m' =>
              if Metta.Bindings.hasLoop m' = true then none
              else some (evalResult []
                (Metta.instantiate m' (mExpr "Var" [mVar (f "k")])) m'))
            (Metta.Bindings.merge [] mb))
        (Metta.matchAtoms
          (mExpr "nf" [mVar (f "sig"), mExpr "Var" [mVar (f "k")]])
          (nfQuery sig (.var k))) =
      [evalResult [] (termAtom (.var k))
        ((renameBindings (counterSuffix counter) (nfVarRuleBindings sig k)).reverse)]
  rw [hmatch]
  simp [hmerge, hloop, hresult, root, m, coreB, f]

/-- Exact live-binding readout of the leaf `nf`/`Var` candidate for one
closed public binding.  The selected rule contributes its two private
bindings before the caller's retained singleton. -/
private theorem queryOpItems_nf_var_eq_singleton_closed
    (counter : Nat) (sig : DIndGArtifactSig) (k : Nat)
    (binder : String) (value : Metta.Atom)
    (hclosedValue : value.vars = [])
    (hFresh :
      ∀ {v : String}, v = "k" ∨ v = "sig" →
        counterSuffix counter v ≠ binder) :
    let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
    let rootBnd : Metta.Bindings :=
      (renameBindings (counterSuffix counter)
        (nfVarRuleBindings sig k)).reverse ++ incoming
    Metta.Minimal.queryOpItemsOfRule [] (nfQuery sig (.var k)) incoming
        counter nfVarRulePair =
      [evalResult [] (termAtom (.var k)) rootBnd] := by
  dsimp only
  let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
  let f := counterSuffix counter
  let coreB : Metta.Bindings := nfVarRuleBindings sig k
  let matched : Metta.Bindings := renameBindings f coreB
  let merged : Metta.Bindings := matched.reverse ++ incoming
  let lhs := mExpr "nf" [mVar (f "sig"), mExpr "Var" [mVar (f "k")]]
  let rhs := mExpr "Var" [mVar (f "k")]
  let root := termAtom (.var k)
  have hclosedTarget : (nfQuery sig (.var k)).vars = [] := by
    simp [nfQuery, sigAtom_vars_nil sig, termAtom_vars_nil (.var k),
      mExpr, mSym, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (mNat_vars_nil k)
      (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, nfVarRuleBindings, bindingValueKeys]
  have hclosedIncoming : ClosedValueBindings incoming := by
    exact ClosedValueBindings.val hclosedValue ClosedValueBindings.nil
  have hcompat :
      LegacyFresheningCompatible [] (nfQuery sig (.var k)) incoming
        counter nfVarRulePair.1 nfVarRulePair.2 := by
    apply legacyFresheningCompatible_of_no_collision
    rintro ⟨name, hRule, hAvoid⟩
    have hRule' : name = f "sig" ∨ name = f "k" := by
      simpa [nfVarRulePair, freshenRule_eq_renBy, f, mExpr, mSym, mVar,
        Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
        Metta.Atom.vars] using hRule
    have hAvoid' : name = binder := by
      simpa [Metta.Minimal.queryOpAvoid, Metta.Minimal.liveStackVars,
        hclosedTarget, incoming, Metta.Bindings.vars, hclosedValue] using hAvoid
    rcases hRule' with rfl | rfl
    · exact hFresh (Or.inr rfl) hAvoid'
    · exact hFresh (Or.inl rfl) hAvoid'
  have hfresh : freshenRule counter nfVarRulePair.1 nfVarRulePair.2 =
      (lhs, rhs) := by
    rw [freshenRule_eq_renBy]
    simp [lhs, rhs, f, nfVarRulePair, mExpr, mSym, mVar,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch : Metta.matchAtoms lhs (nfQuery sig (.var k)) = [matched] := by
    have hraw := match_binary_nested_unary_vars "nf" (f "sig") "Var" (f "k")
      (sigAtom sig) (mNat k)
      (by
        intro h
        exact (by decide : "k" ≠ "sig")
          ((counterSuffix_injective counter) h))
      (sigAtom_vars_absent sig) (mNat_vars_absent k)
      (sigAtom_not_var sig) (mNat_not_var k)
    have hclosedMatched : ClosedValueBindings matched := by
      simpa [matched] using ClosedValueBindings.rename (f := f) hclosedB
    unfold Metta.matchAtoms
    rw [show Metta.matchAtomsWith none lhs (nfQuery sig (.var k)) = [matched] by
      simpa only [lhs, nfQuery, termAtom, matched, coreB, nfVarRuleBindings,
        renameBindings] using hraw]
    exact filter_singleton_binding_of_hasLoop_false _
      (ClosedValueBindings.hasLoop_false hclosedMatched)
  have hnodupMatched : (bindingValueKeys matched).Nodup := by
    rw [show matched = renameBindings f coreB by rfl,
      bindingValueKeys_renameBindings]
    exact List.Nodup.map (counterSuffix_injective counter) hnodup
  have hdisj :
      ∀ x ∈ bindingValueKeys matched, x ∉ bindingValueKeys incoming := by
    intro x hx hxIncoming
    have hx' : x = f "k" ∨ x = f "sig" := by
      simpa [matched, coreB, nfVarRuleBindings, bindingValueKeys,
        renameBindings, f] using hx
    have hxIncoming' : x = binder := by
      simpa [incoming, bindingValueKeys] using hxIncoming
    rcases hx' with rfl | rfl
    · exact hFresh (Or.inl rfl) hxIncoming'
    · exact hFresh (Or.inr rfl) hxIncoming'
  have hmerge : Metta.Bindings.merge incoming matched = [merged] := by
    simpa [merged] using
      (merge_closed_noConflict_eq
        (ClosedValueBindings.rename hclosedB) hnodupMatched
        hclosedIncoming hdisj)
  have hclosedMerged : ClosedValueBindings merged := by
    exact ClosedValueBindings.append
      (ClosedValueBindings.reverse (by
        simpa [matched] using ClosedValueBindings.rename (f := f) hclosedB))
      hclosedIncoming
  have hloop : Metta.Bindings.hasLoop merged = false :=
    ClosedValueBindings.hasLoop_false hclosedMerged
  have hinst : Metta.instantiate merged rhs = root := by
    have hkSig : f "k" ≠ f "sig" := by
      intro h
      exact (by decide : "k" ≠ "sig")
        ((counterSuffix_injective counter) h)
    rw [hclosedMerged.instantiate_eq_subst_apply]
    simp [merged, matched, incoming, f, coreB, nfVarRuleBindings, rhs,
      root, termAtom, renameBindings, Metta.bindingsToSubst,
      Metta.Subst.apply, Metta.Subst.lookup, mExpr, mSym, mVar, mNat,
      hkSig]
  simpa [incoming, merged, matched, f, coreB, root] using
    queryOpItemsOfRule_eq_singleton_from counter (nfQuery sig (.var k))
      incoming nfVarRulePair lhs rhs matched merged root hcompat hfresh
      hmatch hmerge hloop hinst

