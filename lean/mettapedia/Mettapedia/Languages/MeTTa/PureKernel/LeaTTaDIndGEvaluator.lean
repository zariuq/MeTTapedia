private theorem mettaEval_kernelDefControlEnv_convQuery_true_pair_implies_fresh_root_true_pair
    {fuel : Nat} {sig : DIndGArtifactSig}
    {rawLeft rawRight : DIndGArtifactTerm} {bnd : Metta.Bindings}
    (hmem :
      (mBool true, bnd) ∈
        (mettaEval kernelDefControlEnv (fuel + 1) St.init []
          (convQuery sig rawLeft rawRight)).1) :
    let root :=
      convFreshReadoutAt St.init.counter sig rawLeft rawRight
    let stRoot : St := { counter := St.init.counter + 1, world := St.init.world }
    ∃ finalBnd,
      (mBool true, finalBnd) ∈
        (mettaEval kernelDefControlEnv fuel stRoot [] root).1 := by
  dsimp
  let root :=
    convFreshReadoutAt St.init.counter sig rawLeft rawRight
  let rootBnd :=
    (renameBindings (counterSuffix St.init.counter)
      (convRuleBindings sig rawLeft rawRight)).reverse
  let stRoot : St := { counter := St.init.counter + 1, world := St.init.world }
  have hNoErr :
      (([sigAtom sig, termAtom rawLeft, termAtom rawRight].zip
          [sigAtom sig, termAtom rawLeft, termAtom rawRight]).find?
        (fun ho : Metta.Atom × Metta.Atom => ho.1.isError && ho.1 != ho.2)) = none := by
    simp [sigAtom_isError_false, termAtom_isError_false]
  have hRoot :
      interpretFuel kernelDefControlEnv (fuel + 1) St.init
          [evalItemNil (convQuery sig rawLeft rawRight)] [] =
        ([(root, rootBnd)], stRoot) := by
    simpa [root, rootBnd, stRoot] using
      interpretFuel_kernelDefControlEnv_conv_root_eq fuel sig rawLeft rawRight
  rcases
      mettaEval_ternary_expr_pair_mem_implies_root_eval_mem_of_quoted_args_and_root_eval_eq_bnd
        (env := kernelDefControlEnv) (fuel := fuel) (st := St.init)
        (stRoot := stRoot) (op := "conv")
        (x := sigAtom sig) (y := termAtom rawLeft) (z := termAtom rawRight)
        (root := root) (final := mBool true) (rootBnd := rootBnd)
        (outBnd := bnd)
        (kernelDefControlEnv_conv_typeMismatch sig rawLeft rawRight)
        kernelDefControlEnv_conv_argMask hNoErr
        (by simpa [root, rootBnd, stRoot, convQuery, mExpr, mSym] using hRoot)
        (by simpa [root] using
          (convFreshReadoutAt_beq_notReducible_false
            St.init.counter sig rawLeft rawRight))
        (by simpa [root, convQuery, mExpr, mSym] using
          (convFreshReadoutAt_beq_convQuery_false
            St.init.counter sig rawLeft rawRight))
        (by simpa [convQuery, mExpr, mSym] using
          kernelDefControlEnv_conv_returnsAtom sig rawLeft rawRight)
        (by simpa [convQuery, mExpr, mSym] using hmem) with
    ⟨finalBnd, hFinal⟩
  have hRestrict :
      restrictBnd (([sigAtom sig, termAtom rawLeft, termAtom rawRight]).flatMap Metta.Atom.vars)
          ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd) = [] := by
    simpa [sigAtom_vars_nil, termAtom_vars_nil, List.flatMap] using
      restrictBnd_nil_vars ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)
  have hRestrictAppend :
      restrictBnd ((sigAtom sig).vars ++
          ((termAtom rawLeft).vars ++ (termAtom rawRight).vars))
          ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd) = [] := by
    simpa [sigAtom_vars_nil, termAtom_vars_nil] using
      restrictBnd_nil_vars ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)
  exact ⟨finalBnd, by
    simpa [root, rootBnd, stRoot, hRestrictAppend] using hFinal⟩

