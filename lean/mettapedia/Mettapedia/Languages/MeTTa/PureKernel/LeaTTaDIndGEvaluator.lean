/-- Exact `nf Var` query readout under one closed public binding.  Candidate
order, private-prefix/public-suffix bindings, and the final counter are all
literal runtime observations. -/
private theorem queryOp_kernelDefControlEnv_nf_var_eq_singleton_closed
    (st : St) (sig : DIndGArtifactSig) (k : Nat)
    (binder : String) (value : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hclosedValue : value.vars = [])
    (hFresh :
      ∀ {v : String}, v = "k" ∨ v = "sig" →
        counterSuffix st.counter v ≠ binder) :
    let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
    let rootBnd : Metta.Bindings :=
      (renameBindings (counterSuffix st.counter)
        (nfVarRuleBindings sig k)).reverse ++ incoming
    queryOp kernelDefControlEnv st [] (nfQuery sig (.var k)) incoming =
      ([evalResult [] (termAtom (.var k)) rootBnd],
        { counter := st.counter + 8, world := st.world }) := by
  dsimp only
  let target := nfQuery sig (.var k)
  let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
  let rootBnd :=
    (renameBindings (counterSuffix st.counter)
      (nfVarRuleBindings sig k)).reverse ++ incoming
  have hNotVarHead : isVariableHeaded target = false := by
    simp [target, nfQuery, isVariableHeaded, mExpr, mSym]
  have hCand :
      kernelDefControlEnv.candidates target =
        [] ++ nfVarRulePair ::
          [nfSrtRulePair, nfConRulePair, (nfPiRuleLhs, nfPiRuleRhs),
            nfLamRulePair, nfBadRulePair, nfIndGZeroIotaRulePair,
            nfDefRulePair] := by
    have hcandidateEq :
        kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
      simp [MinEnv.candidates, kernelDefControlEnv]
    have hcand := kernelEnv_nf_var_candidates sig k
    have hstaticInit := candidatesW_init_eq_candidates kernelEnv target
    rw [hstaticInit] at hcand
    rw [hcandidateEq]
    simpa [target] using hcand
  have hVar :
      Metta.Minimal.queryOpItemsOfRule [] target incoming st.counter
          nfVarRulePair =
        [evalResult [] (termAtom (.var k)) rootBnd] := by
    simpa [target, incoming, rootBnd] using
      queryOpItems_nf_var_eq_singleton_closed st.counter sig k binder value
        hclosedValue hFresh
  have hSrt :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 1)
          nfSrtRulePair = [] := by
    simpa [target, nfQuery, termAtom, nfSrtRulePair, mExpr, mSym] using
      queryOpItems_nf_ctor_mismatch_eq_nil_from (st.counter + 1) sig "Var"
        [mNat k] incoming "Srt" [mVar "s"] (mExpr "Srt" [mVar "s"])
        (by decide)
  have hCon :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 2)
          nfConRulePair = [] := by
    simpa [target, nfQuery, termAtom, nfConRulePair, mExpr, mSym] using
      queryOpItems_nf_ctor_mismatch_eq_nil_from (st.counter + 2) sig "Var"
        [mNat k] incoming "Con" [mVar "x"] (mExpr "Con" [mVar "x"])
        (by decide)
  have hPi :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 3)
          (nfPiRuleLhs, nfPiRuleRhs) = [] := by
    simpa [target, nfQuery, termAtom, nfPiRuleLhs, mExpr, mSym] using
      queryOpItems_nf_ctor_mismatch_eq_nil_from (st.counter + 3) sig "Var"
        [mNat k] incoming "Pi" [mVar "A", mVar "B"] nfPiRuleRhs
        (by decide)
  have hLam :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 4)
          nfLamRulePair = [] := by
    simpa [target, nfQuery, termAtom, nfLamRulePair, nfLamRuleLhs,
      mExpr, mSym] using
      queryOpItems_nf_ctor_mismatch_eq_nil_from (st.counter + 4) sig "Var"
        [mNat k] incoming "Lam" [mVar "A", mVar "b"] nfLamRuleRhs
        (by decide)
  have hBad :
      Metta.Minimal.queryOpItemsOfRule [] target incoming (st.counter + 5)
