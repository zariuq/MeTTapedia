/-- A self-evaluated embedded `unify` row cannot trigger the changed-terminal
guard when its two data-bearing arguments are known non-errors.  The `Empty`
fallback is unchanged, so it is permitted by the exact executable guard. -/
private theorem embedded_unify_self_firstChangedArgumentStop_none
    (nx template : Metta.Atom) (nxBinder : String)
    (hNxNoErr : nx.isError = false)
    (hTemplateNoErr : template.isError = false) :
    firstChangedArgumentStop
        [nx, mVar nxBinder, template, mSym "Empty"]
        [nx, mVar nxBinder, template, mSym "Empty"] = none := by
  apply firstChangedArgumentStop_self_eq_none_of_forall_not_error
  intro atom hmem
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl
  · exact hNxNoErr
  · simp [mVar, Metta.Atom.isError]
  · exact hTemplateNoErr
  · simp [mSym, Metta.Atom.isError]

