      (termAtom (.bad reason)) := by
  exact Relation.ReflTransGen.tail
    (Relation.ReflTransGen.single (subst_bad_dispatch_appRules_mops_step index replacement reason))
    (bind_subst_bad_appRules_mops_step index replacement reason)

/-- The same two-step `subst` bad-term path transported through LeaTTa's
executable kernel relation. -/
theorem subst_bad_appRules_kernel_reaches_result
    (index : Nat) (replacement : DIndGArtifactTerm) (reason : String) :
    Relation.ReflTransGen (Metta.KernelStep kernelAppRules stdGroundings)
      (substQuery index replacement (.bad reason))
