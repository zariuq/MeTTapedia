private def exactApplicationPolicy_atom_atom_undefined
    (env : MinEnv) (st : St) (op : String) (a b : Metta.Atom)
    (hPinned : OperatorTypesPinned env st.world op
      [mExpr "->" [mSym "Atom", mSym "Atom", mSym "%Undefined%"]]) :
    ApplicationPolicyProjection env st.world op [a, b] [false, false] false := by
  let selected : SelectedFunctionType :=
    { functionType := mExpr "->" [mSym "Atom", mSym "Atom", mSym "%Undefined%"]
      argumentTypes := [mSym "Atom", mSym "Atom"]
      returnType := mSym "%Undefined%"
      typeBindings := [] }
  have hSelected :
      selectFunctionType env st.world (.sym op) [a, b] = .selected selected := by
    have hCheck : typeCheckArgsOutcome env st.world
        [.sym "Atom", .sym "Atom"] 0 [] [a, b] = .success [] := by
      simpa [mSym] using typeCheckArgsOutcome_two_atoms env st.world a b
    simpa [selected, mExpr, mSym] using
      (selectFunctionType_singleton_arrow_selected_of_outcome
        env st.world op [a, b] [.sym "Atom", .sym "Atom"]
        (.sym "%Undefined%") [] hPinned (by simp) hCheck)
  have hMask : argMask selected 2 = [false, false] := by
    simp only [selected, argMask, Metta.instantiate_nil, mSym]
    decide
