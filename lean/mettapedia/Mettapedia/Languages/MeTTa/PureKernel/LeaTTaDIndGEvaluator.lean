    (hmem :
      (out, outBnd) ∈
        (mettaEval env (fuel + 1) st []
          (Metta.Atom.expr [Metta.Atom.sym op, x, y])).1) :
    ∃ xOut xBnd,
      (xOut, xBnd) ∈ (mettaEval env fuel st [] x).1 ∧
      ∃ stBeforeY yOut yBnd,
        P stBeforeY ∧
        (yOut, yBnd) ∈ (mettaEval env fuel stBeforeY [] y).1 ∧
        (([xOut, yOut].zip [x, y]).find?
          (fun ho : Metta.Atom × Metta.Atom =>
            ho.1.isError && ho.1 != ho.2)) = none ∧
        out = Metta.Atom.expr [Metta.Atom.sym op, xOut, yOut] := by
  let firstParts : List (List Metta.Atom × Metta.Bindings) :=
    (mettaEval env fuel st [] x).1.map
      (fun p => ([p.1], ([] : Metta.Bindings)))
  let firstState : St := (mettaEval env fuel st [] x).2
  let secondFold : List (List Metta.Atom × Metta.Bindings) × St :=
    firstParts.foldl
      (fun (acc2 : List (List Metta.Atom × Metta.Bindings) × St)
          (part : List Metta.Atom × Metta.Bindings) =>
        (acc2.1 ++
          (mettaEval env fuel acc2.2 part.2 y).1.map
            (fun p =>
              (part.1 ++ [p.1],
                restrictBnd ([] : List String)
                  ((Metta.Bindings.merge part.2 p.2).head?.getD p.2))),
         (mettaEval env fuel acc2.2 part.2 y).2))
      (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
  have hQvars : List.flatMap Metta.Atom.vars [x, y] = [] := by
    simp [List.flatMap, hxClosed, hyClosed]
  have hSecondState' :
      ∀ (acc0 : List (List Metta.Atom × Metta.Bindings) × St)
        (part : List Metta.Atom × Metta.Bindings),
        part ∈ firstParts →
          P acc0.2 →
            P (mettaEval env fuel acc0.2 part.2 y).2 := by
    intro acc0 part hpart hP
    have hpartRaw :
        part ∈
          (mettaEval env fuel st [] x).1.map
            (fun p =>
              ([p.1],
                restrictBnd ([] : List String)
                  ((Metta.Bindings.merge [] p.2).head?.getD p.2))) := by
      simpa [firstParts, restrictBnd_nil_vars] using hpart
    rcases
        mettaEval_binary_first_arg_parts_mem
          env fuel ([] : List String) st x part hpartRaw with
      ⟨xOut, xBnd, hxMem, hpartEq⟩
    cases hpartEq
    simpa [restrictBnd_nil_vars] using
      hSecondState acc0 xOut xBnd hxMem hP
  have hSecondFoldP : P secondFold.2 := by
    simpa [secondFold, firstParts, firstState] using
      mettaEval_binary_second_arg_fold_preserves_state_pred
        env fuel ([] : List String) y firstParts
        (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
        P hFirstState hSecondState'
  have hRootParts :
      ∀ (acc0 : List (Metta.Atom × Metta.Bindings) × St)
        (part : List Metta.Atom × Metta.Bindings),
        part ∈ secondFold.1 →
          P acc0.2 →
            interpretFuel env (fuel + 1) acc0.2
              [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval",
                  Metta.Atom.expr (Metta.Atom.sym op :: part.1)]) [],
                 bnd := [] }] [] =
              ([(notReducibleA, [])], acc0.2) := by
    intro acc0 part hpart hP
    have hSelectedInv :=
      mettaEval_binary_second_arg_fold_pair_state_pred_before
        env fuel ([] : List String) y firstParts
        (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
        part.1 part.2 P hFirstState hSecondState'
        (by simpa [secondFold] using hpart)
    rcases hSelectedInv with hnil | hselected
    · cases hnil
    · rcases hselected with
        ⟨firstPart, hFirstPart, _stBeforeY, yOut, yBnd,
          _hPY, _hY, hPartEq⟩
      have hfirstRaw :
          firstPart ∈
            (mettaEval env fuel st [] x).1.map
              (fun p =>
                ([p.1],
                  restrictBnd ([] : List String)
                    ((Metta.Bindings.merge [] p.2).head?.getD p.2))) := by
        simpa [firstParts, restrictBnd_nil_vars] using hFirstPart
      rcases
          mettaEval_binary_first_arg_parts_mem
            env fuel ([] : List String) st x firstPart hfirstRaw with
        ⟨xOut, xBnd, _hxMem, hFirstEq⟩
      cases hFirstEq
      have hPartArgs : part.1 = [xOut, yOut] := by
        have hFst := congrArg Prod.fst hPartEq
        simpa [restrictBnd_nil_vars] using hFst
      rw [hPartArgs]
      simpa [evalItemNil, mExpr, mSym] using hRoot acc0 xOut yOut hP
  have hmemPart :
      (out, outBnd) ∈
        (secondFold.1.foldl
          (mettaEvalExprPartFoldStep env fuel ([] : List String) op [x, y] [])
          (([] : List (Metta.Atom × Metta.Bindings)), secondFold.2)).1 := by
    unfold mettaEval at hmem
    rw [Metta.instantiate_nil
        (Metta.Atom.expr [Metta.Atom.sym op, x, y])] at hmem
    simp only [hType, hMask, List.length_cons, List.length_nil,
      Nat.reduceAdd, List.zip_cons_cons, List.zip_nil_right,
      if_true, List.foldl_cons, List.foldl_nil] at hmem
    simp [hQvars, restrictBnd_nil_vars] at hmem
    unfold mettaEvalExprPartFoldStep mettaEvalExprRootFoldStep
    convert hmem using 1
    · simp [secondFold, firstParts, firstState, restrictBnd_nil_vars]
      rfl
  rcases
      mettaEvalExprPartFold_pair_nonError_notReducible_state_pred_before
        env fuel ([] : List String) op [x, y] [] secondFold.1
        (([] : List (Metta.Atom × Metta.Bindings)), secondFold.2)
        out outBnd P hOutNoErr hSecondFoldP hRootParts hmemPart with
    hnil | hpart
  · cases hnil
  · rcases hpart with
      ⟨selectedPart, hSelectedMem, stBeforeRoot, _hPRoot, hFind,
        hOutEq, _hBndEq⟩
    rcases selectedPart with ⟨selectedArgs, selectedBnd0⟩
    have hSelectedInv :=
      mettaEval_binary_second_arg_fold_pair_state_pred_before
        env fuel ([] : List String) y firstParts
        (([] : List (List Metta.Atom × Metta.Bindings)), firstState)
        selectedArgs selectedBnd0 P hFirstState hSecondState'
        (by simpa [secondFold] using hSelectedMem)
    rcases hSelectedInv with hnilSelected | hselected
    · cases hnilSelected
    · rcases hselected with
        ⟨firstPart, hFirstPart, stBeforeY, yOut, yBnd,
          hPY, hY, hSelectedEq⟩
      have hfirstRaw :
          firstPart ∈
            (mettaEval env fuel st [] x).1.map
              (fun p =>
                ([p.1],
                  restrictBnd ([] : List String)
                    ((Metta.Bindings.merge [] p.2).head?.getD p.2))) := by
        simpa [firstParts, restrictBnd_nil_vars] using hFirstPart
      rcases
          mettaEval_binary_first_arg_parts_mem
            env fuel ([] : List String) st x firstPart hfirstRaw with
        ⟨xOut, xBnd, hxMem, hFirstEq⟩
      cases hFirstEq
      have hSelectedArgs : selectedArgs = [xOut, yOut] := by
        have hFst := congrArg Prod.fst hSelectedEq
        simpa [restrictBnd_nil_vars] using hFst
      rw [hSelectedArgs] at hFind hOutEq
      refine ⟨xOut, xBnd, hxMem, stBeforeY, yOut, yBnd, hPY, ?_, ?_, ?_⟩
      · simpa [restrictBnd_nil_vars] using hY
      · simpa using hFind
      · simpa [mExpr, mSym] using hOutEq

theorem mettaEval_binary_expr_mem_of_quoted_args_and_open_root_eval_member_state_pred
    (env : MinEnv) (fuel : Nat) (st : St)
    (op : String)
    (x y root final : Metta.Atom) (rootBnd : Metta.Bindings)
    (P : St → Prop)
    (hType : typeMismatch env st.world op [x, y] = none)
    (hMask : argMask env op 2 = [false, false])
    (hNoErr :
      (([x, y].zip [x, y]).find?
        (fun ho => ho.1.isError && ho.1 != ho.2)) = none)
    (hinit : P st)
    (hrootState :
      ∀ acc : List (Metta.Atom × Metta.Bindings) × St,
        P acc.2 →
          P (interpretFuel env (fuel + 1) acc.2
            [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y])] []).2)
    (hrecState :
      ∀ (acc : List (Metta.Atom × Metta.Bindings) × St)
        (p : Metta.Atom × Metta.Bindings),
        P acc.2 →
          P (mettaEval env fuel acc.2
            (restrictBnd (([x, y]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] p.2).head?.getD p.2)) p.1).2)
    (hRoot : (root, rootBnd) ∈
      (interpretFuel env (fuel + 1) st
        [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y])] []).1)
    (hRootNotNotReducible : (root == notReducibleA) = false)
    (hRootNotSelf : (root == Metta.Atom.expr [Metta.Atom.sym op, x, y]) = false)
    (hReturns : returnsAtom env (Metta.Atom.expr [Metta.Atom.sym op, x, y]) = false)
    (hFinal : ∀ st0,
      P st0 →
        (final, []) ∈
          (mettaEval env fuel st0
            (restrictBnd (([x, y]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) root).1) :
    (final,
        restrictBnd (([x, y]).flatMap Metta.Atom.vars)
          (((restrictBnd (([x, y]).flatMap Metta.Atom.vars)
              ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)).merge
              ([] : Metta.Bindings)).head?.getD [])) ∈
      (mettaEval env (fuel + 1) st []
        (Metta.Atom.expr [Metta.Atom.sym op, x, y])).1 := by
  let qvars := ([x, y]).flatMap Metta.Atom.vars
  unfold mettaEval
  rw [Metta.instantiate_nil (Metta.Atom.expr [Metta.Atom.sym op, x, y])]
  simp only [hType, hMask, List.length_cons, List.length_nil, Nat.reduceAdd,
    List.zip_cons_cons, List.zip_nil_right, List.foldl_cons, List.foldl_nil]
  simp [Metta.instantiate_nil]
  have hNoErr' :
      List.find? (fun ho : Metta.Atom × Metta.Atom => ho.1.isError && ho.1 != ho.2)
        [(x, x), (y, y)] = none := by
    simpa using hNoErr
  rw [hNoErr']
  let rootItem : Item :=
    { stack := atomToStack
        (Metta.Atom.expr
          [Metta.Atom.sym "eval", Metta.Atom.expr [Metta.Atom.sym op, x, y]]) []
      bnd := [] }
  cases hpairs : interpretFuel env (fuel + 1) st [rootItem] [] with
  | mk pairs stRoot =>
      have hRootPairs : (root, rootBnd) ∈ pairs := by
        have hrootItem :
            [rootItem] = [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y])] := by
          simp [rootItem, evalItemNil]
        rw [hrootItem] at hpairs
        rw [hpairs] at hRoot
        exact hRoot
      have hRootState : P stRoot := by
        have hrootItem :
            [rootItem] = [evalItemNil (Metta.Atom.expr [Metta.Atom.sym op, x, y])] := by
          simp [rootItem, evalItemNil]
        have hstate := hrootState ([], st) hinit
        rw [hrootItem] at hpairs
        rw [hpairs] at hstate
        exact hstate
      have hfold :=
        mettaEval_expr_root_evals_selected_readout_state_pred
          env fuel qvars (Metta.Atom.expr [Metta.Atom.sym op, x, y]) []
          P (root, rootBnd) pairs stRoot final
          hRootPairs hRootNotNotReducible hRootNotSelf hReturns hRootState
          (by
            intro acc p hP
            simpa [qvars] using hrecState acc p hP)
          (by
            intro st0 hP
            simpa [qvars] using hFinal st0 hP)
      rw [show
        (fun a2 p =>
          if (p.1 == notReducibleA) = true ∨
              (p.1 == Metta.Atom.expr [Metta.Atom.sym op, x, y]) = true then
            (a2.1 ++ [(Metta.Atom.expr [Metta.Atom.sym op, x, y], [])], a2.2)
          else if returnsAtom env (Metta.Atom.expr [Metta.Atom.sym op, x, y]) = true ∧
              isEmbeddedOp p.1 = false then
            (a2.1 ++
              [(p.1,
                restrictBnd (x.vars ++ y.vars)
                  ((Metta.Bindings.merge [] p.2).head?.getD p.2))],
              a2.2)
          else
            (a2.1 ++
                (mettaEval env fuel a2.2
                  (restrictBnd (x.vars ++ y.vars)
                    ((Metta.Bindings.merge [] p.2).head?.getD p.2)) p.1).1.map (fun m =>
                    (m.1,
                      restrictBnd (x.vars ++ y.vars)
                        ((Metta.Bindings.merge
                          (restrictBnd (x.vars ++ y.vars)
                            ((Metta.Bindings.merge [] p.2).head?.getD p.2)) m.2).head?.getD m.2))),
              (mettaEval env fuel a2.2
                (restrictBnd (x.vars ++ y.vars)
                  ((Metta.Bindings.merge [] p.2).head?.getD p.2)) p.1).2)) =
          mettaEvalExprRootFoldStep env fuel qvars
            (Metta.Atom.expr [Metta.Atom.sym op, x, y]) [] by
        funext a2 p
        simp [mettaEvalExprRootFoldStep, qvars]]
      simpa [qvars] using hfold

theorem nf_interpretFuel_root_pair_mem_mettaEval_kernelEnv_state
    {st : St} {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {rootOut : Metta.Atom} {rootBnd : Metta.Bindings}
    (hroot :
      (rootOut, rootBnd) ∈
        (interpretFuel kernelEnv 1 st
          [{ stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", nfQuery sig raw]) []
             bnd := [] }] []).1)
    (hembed : isEmbeddedOp rootOut = false)
    (hnotNR : (rootOut == notReducibleA) = false)
    (hnotSelf : (rootOut == nfQuery sig raw) = false) :
    (rootOut, []) ∈
      (mettaEval kernelEnv 1 st [] (nfQuery sig raw)).1 := by
  unfold mettaEval
  rw [Metta.instantiate_nil]
  simp only [nfQuery, mExpr, mSym] at hnotSelf ⊢
  rw [show typeMismatch kernelEnv st.world "nf" [sigAtom sig, termAtom raw] = none by
    exact kernelEnv_nf_typeMismatch_state st sig raw]
  simp [kernelEnv_nf_argMask, Metta.instantiate_nil]
  cases hpairs : interpretFuel kernelEnv 1 st
      [{ stack := atomToStack
          (Metta.Atom.expr [Metta.Atom.sym "eval",
            Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]]) []
         bnd := [] }] [] with
  | mk pairs st' =>
      have hrootExpanded :
          (rootOut, rootBnd) ∈
            (interpretFuel kernelEnv 1 st
              [{ stack := atomToStack
                  (Metta.Atom.expr [Metta.Atom.sym "eval",
                    Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]]) []
                 bnd := [] }] []).1 := by
        simpa [nfQuery, mExpr, mSym] using hroot
      have hrootPairs : (rootOut, rootBnd) ∈ pairs := by
        rw [hpairs] at hrootExpanded
        simpa using hrootExpanded
      have hkeep :
          (rootOut,
              restrictBnd ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                ((Bindings.merge [] rootBnd).head?.getD rootBnd)) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelEnv 0
                ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
                (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [])
              ([], st')).1 :=
        mettaEval_expr_root_keeps_of_returnsAtom_readout
          kernelEnv 0 ([sigAtom sig, termAtom raw].flatMap Metta.Atom.vars)
          (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) []
          (rootOut, rootBnd) pairs st'
          hrootPairs (by simpa [nfQuery, mExpr, mSym] using kernelEnv_nf_returnsAtom sig raw)
          hembed hnotNR hnotSelf
      have hkeep' :
          (rootOut, []) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelEnv 0 []
                (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) [])
              ([], st')).1 := by
        simpa [restrictBnd_nil_vars, List.flatMap, sigAtom_vars_nil sig, termAtom_vars_nil raw]
          using hkeep
      have hkeep'' :
          (rootOut, []) ∈
            (List.foldl
              (fun (a2 : List (Metta.Atom × Metta.Bindings) × St)
                  (p : Metta.Atom × Metta.Bindings) =>
                if (p.1 == notReducibleA) = true ∨
                    (p.1 == Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) = true then
                  (a2.1 ++
                      [(Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw],
                        ([] : Metta.Bindings))],
                    a2.2)
                else
                  if returnsAtom kernelEnv (Metta.Atom.expr [Metta.Atom.sym "nf", sigAtom sig, termAtom raw]) = true ∧
                      isEmbeddedOp p.1 = false then
                    (a2.1 ++ [(p.1, ([] : Metta.Bindings))], a2.2)
                  else
                    (a2.1 ++ List.map (fun m => (m.1, ([] : Metta.Bindings)))
                        (mettaEval kernelEnv 0 a2.2 [] p.1).1,
                      (mettaEval kernelEnv 0 a2.2 [] p.1).2))
              ([], st') pairs).1 := by
        unfold mettaEvalExprRootFoldStep at hkeep'
        simpa [kernelEnv_nf_returnsAtom sig raw, restrictBnd_nil_vars] using hkeep'
      have hnoerr :
          List.find?
              (fun ho : Metta.Atom × Metta.Atom => ho.1.isError && ho.1 != ho.2)
              [(sigAtom sig, sigAtom sig), (termAtom raw, termAtom raw)] = none := by
        simp [sigAtom_isError_false, termAtom_isError_false]
      rw [hnoerr]
      rw [sigAtom_vars_nil sig, termAtom_vars_nil raw]
      simp only [List.append_nil, restrictBnd_nil_vars]
      exact hkeep''

/-- Select one concrete `nf` equality rule from the public executable kernel.

The public kernel has one additional `nf Def` candidate, so global equality
with `kernelCoreEnv` is no longer true.  For the old non-`Def` root rules we
instead select the intended candidate directly from `kernelEnv`; because the
new candidate is appended after the original root rules, the selected rule's
freshening counter is unchanged. -/
theorem interpretFuel_kernelEnv_nf_selected_rule_contains
    {fuel : Nat} {st : St} {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {lhs rhs : Metta.Atom} {coreB : Metta.Bindings}
    {pre post : List (Metta.Atom × Metta.Atom)}
    (hstatic : st.world.selfExtra = [])
    (hclosedB : ClosedValueBindings coreB)
    (hnodup : (bindingValueKeys coreB).Nodup)
    (hsplit : kernelEnv.candidates (nfQuery sig raw) = pre ++ (lhs, rhs) :: post)
    (hmatchCore : coreB ∈ Metta.matchAtoms lhs (nfQuery sig raw))
    (hnotFunction :
      isFunctionResult
        (Metta.instantiate
          (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse
          (freshenRule (st.counter + pre.length) lhs rhs).2) = false) :
    (Metta.instantiate
        (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse
        (freshenRule (st.counter + pre.length) lhs rhs).2,
      (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st [evalItemNil (nfQuery sig raw)] []).1 := by
  let mb : Metta.Bindings :=
    renameBindings (counterSuffix (st.counter + pre.length)) coreB
  let m : Metta.Bindings := mb.reverse
  let out : Metta.Atom :=
    Metta.instantiate m (freshenRule (st.counter + pre.length) lhs rhs).2
  have hclosedTarget : (nfQuery sig raw).vars = [] := by
    simp [nfQuery, sigAtom_vars_nil sig, termAtom_vars_nil raw, mExpr, mSym,
      Metta.Atom.vars]
  have hmatchFresh : mb ∈
      Metta.matchAtoms (freshenRule (st.counter + pre.length) lhs rhs).1
        (nfQuery sig raw) := by
    simpa [mb] using
      matchAtoms_freshenRule_lhs_closed_target_mem
        (st.counter + pre.length) hclosedTarget hmatchCore
  have hmerge : m ∈ Metta.Bindings.merge [] mb := by
    simpa [m, mb] using
      (merge_empty_renamed_closed_nodup_mem
        (counterSuffix_injective (st.counter + pre.length)) hclosedB hnodup)
  have hclosedMb : ClosedValueBindings mb := by
    simpa [mb] using
      (ClosedValueBindings.rename
        (f := counterSuffix (st.counter + pre.length)) hclosedB)
  have hclosedM : ClosedValueBindings m := by
    simpa [m] using ClosedValueBindings.reverse hclosedMb
  have hloop : Metta.Bindings.hasLoop m = false := by
    simpa [m] using ClosedValueBindings.hasLoop_false hclosedM
  have hquery :
      evalResult [] out m ∈
        (queryOp kernelEnv st [] (nfQuery sig raw) []).1 := by
    simpa [out, m, mb] using
      queryOp_contains_instantiated_item_of_staticCandidateSplit
        (env := kernelEnv) (st := st) (prev := []) (toEval := nfQuery sig raw)
        (b := []) (pre := pre) (post := post) (p := (lhs, rhs))
        (mb := mb) (m := m)
        hstatic
        (by cases raw <;> simp [nfQuery, termAtom, isVariableHeaded, mExpr, mSym])
        hsplit hmatchFresh hmerge hloop
  have hstack :
      evalResult [] out m ∈
        (interpretStack1 kernelEnv fuel st (evalItemNil (nfQuery sig raw))).1 := by
    exact
      (mem_interpretStack1_eval_queryOp_iff_of_instantiated_noReduce
        kernelEnv fuel st [] (nfQuery sig raw) [] "nf" [sigAtom sig, termAtom raw]
        (evalResult [] out m)
        (by simpa [nfQuery, mExpr, mSym] using
          (Metta.instantiate_nil (nfQuery sig raw)))
        (callGrounded_nf_of_stdGroundings kernelEnv sig raw (by rfl))
        (by rfl)).2 hquery
  have hevalEq : evalResult [] out m = finItem [] out m := by
    have hnot : isFunctionResult out = false := by
      simpa [out, m, mb] using hnotFunction
    simpa [out] using
      (evalResult_nil_eq_finItem_of_not_function (a := out) (b := m) hnot)
  have hfin : isFinal (evalResult [] out m) = true := by
    simp [hevalEq, finItem, isFinal]
  have hmem :
      finalPair (evalResult [] out m) ∈
        (interpretFuel kernelEnv (fuel + 1) st [evalItemNil (nfQuery sig raw)] []).1 :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelEnv fuel st (evalItemNil (nfQuery sig raw)) (evalResult [] out m)
      [] [] hstack hfin
  have hstable : Metta.instantiate m out = out := by
    simpa [out] using instantiate_closed_value_bindings_idempotent hclosedM
      (freshenRule (st.counter + pre.length) lhs rhs).2
  simpa [out, m, mb, finalPair, finItem, hevalEq, hstable] using hmem

theorem interpretFuel_kernelEnv_nf_def_root_contains
    {fuel : Nat} {st : St} {sig : DIndGArtifactSig}
    {name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName}
    (hstatic : st.world.selfExtra = []) :
    (Metta.instantiate
        (renameBindings (counterSuffix (st.counter + nfDefCandidatePreWithIndGZeroIota.length))
          (nfDefRuleBindings sig name)).reverse
        (freshenRule (st.counter + nfDefCandidatePreWithIndGZeroIota.length) nfDefRuleLhs nfDefRuleRhs).2,
      (renameBindings (counterSuffix (st.counter + nfDefCandidatePreWithIndGZeroIota.length))
        (nfDefRuleBindings sig name)).reverse) ∈
      (interpretFuel kernelEnv (fuel + 1) st [evalItemNil (nfQuery sig (.defn name))] []).1 := by
  let coreB : Metta.Bindings := nfDefRuleBindings sig name
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val
      (by unfold Metta.Atom.vars; rfl)
      (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    dsimp [coreB, nfDefRuleBindings, bindingValueKeys]
    decide
  have hsplit :
      kernelEnv.candidates (nfQuery sig (.defn name)) =
        nfDefCandidatePreWithIndGZeroIota ++ nfDefRulePair :: [] := by
    have hcand := kernelEnv_nf_def_candidates sig name
    have hstaticInit := candidatesW_init_eq_candidates kernelEnv (nfQuery sig (.defn name))
    rw [hstaticInit] at hcand
    simpa [nfDefRulePair] using hcand
  have hmatchCore : coreB ∈ Metta.matchAtoms nfDefRuleLhs (nfQuery sig (.defn name)) := by
    simpa [coreB] using
      (by
        rw [nf_def_rule_match sig name]
        simp [nfDefRuleBindings] :
          nfDefRuleBindings sig name ∈
            Metta.matchAtoms nfDefRuleLhs (nfQuery sig (.defn name)))
  have hnotFunction :
      isFunctionResult
        (Metta.instantiate
          (renameBindings
            (counterSuffix (st.counter + nfDefCandidatePreWithIndGZeroIota.length))
            coreB).reverse
          (freshenRule (st.counter + nfDefCandidatePreWithIndGZeroIota.length) nfDefRuleLhs nfDefRuleRhs).2) =
        false := by
    rw [freshenRule_eq_renBy]
    simp [coreB, nfDefRuleBindings, nfDefRuleRhs, nfDefCandidatePre,
