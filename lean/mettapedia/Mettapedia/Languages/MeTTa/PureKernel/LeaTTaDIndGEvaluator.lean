        ClosedValueBindings.nil)
  rw [(ClosedValueBindings.reverse
    (ClosedValueBindings.rename hclosedB)).instantiate_eq_subst_apply]
  rw [freshenRule_eq_renBy]
  simp [leattaDefControlNonWitnessNfDefFreshRoot,
    leattaDefControlNonWitnessNfDefFreshBinder, nfDefRuleBindings,
    nfDefRuleRhs, leattaDefControlNonWitnessSig,
    leattaDefControlNonWitnessName, leattaDefControlNonWitnessType,
    leattaDefControlNonWitnessBody, renameBindings,
    counterSuffix, Metta.bindingsToSubst,
    Metta.Subst.apply, Metta.Subst.lookup,
    Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
    defBodyOfQueryAtom, mExpr, mSym, mVar]

/-- Every encoded kernel `nf` query is closed, so repaired capture-avoiding freshening
coincides with the legacy counter suffix on this concrete lane. -/
private theorem queryOpItemsOfRule_nfQuery_eq_legacy
    (counter : Nat) (sig : DIndGArtifactSig) (term : DIndGArtifactTerm)
    (p : Metta.Atom × Metta.Atom) :
    Metta.Minimal.queryOpItemsOfRule [] (nfQuery sig term) [] counter p =
      let (lhs', rhs') := freshenRule counter p.1 p.2
      (Metta.matchAtoms lhs' (nfQuery sig term)).flatMap fun mb =>
        (Metta.Bindings.merge [] mb).filterMap fun m =>
          if Metta.Bindings.hasLoop m then none
          else some (evalResult [] (Metta.instantiate m rhs') m) := by
  exact queryOpItemsOfRule_eq_legacy_of_target_vars_nil counter _ p
    (by simp [nfQuery, sigAtom_vars_nil, termAtom_vars_nil,
      mExpr, mSym, Metta.Atom.vars])

private theorem queryOpItems_nf_var_on_srt_eq_nil
    (counter : Nat) (sig : DIndGArtifactSig) (sort : DIndGArtifactSort) :
    Metta.Minimal.queryOpItemsOfRule [] (nfQuery sig (.srt sort)) [] counter nfVarRulePair = [] := by
  let f := counterSuffix counter
  have hfresh :
      freshenRule counter nfVarRulePair.1 nfVarRulePair.2 =
        (mExpr "nf" [mVar (f "sig"), mExpr "Var" [mVar (f "k")]],
          mExpr "Var" [mVar (f "k")]) := by
    rw [freshenRule_eq_renBy]
    simp [f, nfVarRulePair, mExpr, mSym, mVar,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms
          (mExpr "nf" [mVar (f "sig"), mExpr "Var" [mVar (f "k")]])
          (nfQuery sig (.srt sort)) = [] := by
    simpa [nfQuery, termAtom] using
      fresh_nf_ctor_mismatch_match_nil f sig "Var" [mVar (f "k")]
        "Srt" [sortAtom sort] (by decide)
  rw [queryOpItemsOfRule_eq_legacy_of_target_vars_nil counter _ nfVarRulePair
    (by simp [nfQuery, sigAtom_vars_nil, termAtom_vars_nil,
      mExpr, mSym, Metta.Atom.vars])]
  rw [hfresh]
  simp [hmatch]

private theorem queryOpItems_nf_srt_eq
    (counter : Nat) (sig : DIndGArtifactSig) (sort : DIndGArtifactSort) :
    Metta.Minimal.queryOpItemsOfRule [] (nfQuery sig (.srt sort)) [] counter nfSrtRulePair =
      [evalResult [] (termAtom (.srt sort))
        ((renameBindings (counterSuffix counter) (nfSrtRuleBindings sig sort)).reverse)] := by
  let f := counterSuffix counter
  let coreB : Metta.Bindings := nfSrtRuleBindings sig sort
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  let root : Metta.Atom := termAtom (.srt sort)
  have hfresh :
      freshenRule counter nfSrtRulePair.1 nfSrtRulePair.2 =
        (mExpr "nf" [mVar (f "sig"), mExpr "Srt" [mVar (f "s")]],
          mExpr "Srt" [mVar (f "s")]) := by
    rw [freshenRule_eq_renBy]
    simp [f, nfSrtRulePair, mExpr, mSym, mVar,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms
          (mExpr "nf" [mVar (f "sig"), mExpr "Srt" [mVar (f "s")]])
          (nfQuery sig (.srt sort)) =
        [renameBindings f coreB] := by
    have hraw :=
      match_binary_nested_unary_vars "nf" (f "sig") "Srt" (f "s")
          (sigAtom sig) (sortAtom sort)
          (by
            intro h
            have : "s" = "sig" := (counterSuffix_injective counter) h
            contradiction)
          (sigAtom_vars_absent sig) (sortAtom_vars_absent sort)
          (sigAtom_not_var sig) (sortAtom_not_var sort)
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename
        (ClosedValueBindings.val
          (by cases sort <;> unfold Metta.Atom.vars <;> rfl)
          (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))
    unfold Metta.matchAtoms
    simpa only [nfQuery, termAtom, coreB, nfSrtRuleBindings, renameBindings] using
      (show (Metta.matchAtomsWith none
          (mExpr "nf" [mVar (f "sig"), mExpr "Srt" [mVar (f "s")]])
          (nfQuery sig (.srt sort))).filter (fun b => !b.hasLoop) =
          [renameBindings f coreB] by
        rw [show Metta.matchAtomsWith none
            (mExpr "nf" [mVar (f "sig"), mExpr "Srt" [mVar (f "s")]])
            (nfQuery sig (.srt sort)) = [renameBindings f coreB] by
          simpa only [nfQuery, termAtom, coreB, nfSrtRuleBindings,
            renameBindings] using hraw]
        exact filter_singleton_binding_of_hasLoop_false _
          (ClosedValueBindings.hasLoop_false hclosedRen))
  have hmerge :
      Metta.Bindings.merge [] (renameBindings f coreB) = [m] := by
    have hclosedB : ClosedValueBindings coreB := by
      exact ClosedValueBindings.val
        (by cases sort <;> unfold Metta.Atom.vars <;> rfl)
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
    have hnodup : (bindingValueKeys coreB).Nodup := by
      simp [coreB, nfSrtRuleBindings, bindingValueKeys]
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename hclosedB
    have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
      rw [bindingValueKeys_renameBindings]
      exact List.Nodup.map (counterSuffix_injective counter) hnodup
    simpa [m] using
      (merge_closed_noConflict_eq hclosedRen hnodupRen ClosedValueBindings.nil
        (by intro x hx hmem; cases hmem))
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val
      (by cases sort <;> unfold Metta.Atom.vars <;> rfl)
      (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
  have hclosedM : ClosedValueBindings m := by
    simpa [m, coreB, f] using
      ClosedValueBindings.reverse (ClosedValueBindings.rename hclosedB)
  have hloop : Metta.Bindings.hasLoop m = false := by
    exact ClosedValueBindings.hasLoop_false hclosedM
  have hresult :
      Metta.instantiate m (mExpr "Srt" [mVar (f "s")]) = root := by
    have hsSig : f "s" ≠ f "sig" := by
      intro h
      have hs : "s" = "sig" := (counterSuffix_injective counter) h
      contradiction
    rw [hclosedM.instantiate_eq_subst_apply]
    simp [root, m, coreB, nfSrtRuleBindings, renameBindings, f, termAtom, sortAtom,
      Metta.bindingsToSubst, Metta.Subst.apply, Metta.Subst.lookup,
      mExpr, mSym, mVar, hsSig]
  rw [queryOpItemsOfRule_eq_legacy_of_target_vars_nil counter _ nfSrtRulePair
    (by simp [nfQuery, sigAtom_vars_nil, termAtom_vars_nil,
      mExpr, mSym, Metta.Atom.vars])]
  rw [hfresh]
  change
    List.flatMap
        (fun mb =>
          List.filterMap
            (fun m' =>
              if Metta.Bindings.hasLoop m' = true then none
              else some (evalResult []
                (Metta.instantiate m' (mExpr "Srt" [mVar (f "s")])) m'))
            (Metta.Bindings.merge [] mb))
        (Metta.matchAtoms
          (mExpr "nf" [mVar (f "sig"), mExpr "Srt" [mVar (f "s")]])
          (nfQuery sig (.srt sort))) =
      [evalResult [] (termAtom (.srt sort))
        ((renameBindings (counterSuffix counter) (nfSrtRuleBindings sig sort)).reverse)]
  rw [hmatch]
  simp [hmerge, hloop, hresult, root, m, coreB, f]

/-- Exact live-binding readout of the leaf `nf`/`Srt` candidate for one
closed public binding.  The two private rule bindings precede the incoming
binding exactly; the freshness premise excludes only their concrete legacy
spellings. -/
private theorem queryOpItems_nf_srt_eq_singleton_closed
    (counter : Nat) (sig : DIndGArtifactSig) (sort : DIndGArtifactSort)
    (binder : String) (value : Metta.Atom)
    (hclosedValue : value.vars = [])
    (hFresh :
      ∀ {v : String}, v = "s" ∨ v = "sig" →
        counterSuffix counter v ≠ binder) :
    let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
    let rootBnd : Metta.Bindings :=
      (renameBindings (counterSuffix counter)
        (nfSrtRuleBindings sig sort)).reverse ++ incoming
    Metta.Minimal.queryOpItemsOfRule [] (nfQuery sig (.srt sort)) incoming
        counter nfSrtRulePair =
      [evalResult [] (termAtom (.srt sort)) rootBnd] := by
  dsimp only
  let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
  let f := counterSuffix counter
  let coreB : Metta.Bindings := nfSrtRuleBindings sig sort
  let m : Metta.Bindings := (renameBindings f coreB).reverse ++ incoming
  let root : Metta.Atom := termAtom (.srt sort)
  have hclosedTarget : (nfQuery sig (.srt sort)).vars = [] := by
    simp [nfQuery, sigAtom_vars_nil, termAtom_vars_nil, mExpr, mSym,
      Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val
      (by cases sort <;> unfold Metta.Atom.vars <;> rfl)
      (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, nfSrtRuleBindings, bindingValueKeys]
  have hclosedIncoming : ClosedValueBindings incoming := by
    exact ClosedValueBindings.val hclosedValue ClosedValueBindings.nil
  have hcompat :
      LegacyFresheningCompatible [] (nfQuery sig (.srt sort)) incoming
        counter nfSrtRulePair.1 nfSrtRulePair.2 := by
    apply legacyFresheningCompatible_of_no_collision
    rintro ⟨name, hRule, hAvoid⟩
    have hRule' : name = f "sig" ∨ name = f "s" := by
      simpa [nfSrtRulePair, freshenRule_eq_renBy, f, mExpr, mSym, mVar,
        Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
        Metta.Atom.vars] using hRule
    have hAvoid' : name = binder := by
      simpa [Metta.Minimal.queryOpAvoid, Metta.Minimal.liveStackVars,
        hclosedTarget, incoming, Metta.Bindings.vars, hclosedValue] using hAvoid
    rcases hRule' with rfl | rfl
    · exact hFresh (Or.inr rfl) hAvoid'
    · exact hFresh (Or.inl rfl) hAvoid'
  have hfresh :
      freshenRule counter nfSrtRulePair.1 nfSrtRulePair.2 =
        (mExpr "nf" [mVar (f "sig"), mExpr "Srt" [mVar (f "s")]],
          mExpr "Srt" [mVar (f "s")]) := by
    rw [freshenRule_eq_renBy]
    simp [f, nfSrtRulePair, mExpr, mSym, mVar,
      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  have hmatch :
      Metta.matchAtoms
          (mExpr "nf" [mVar (f "sig"), mExpr "Srt" [mVar (f "s")]])
          (nfQuery sig (.srt sort)) =
        [renameBindings f coreB] := by
    have hraw :=
      match_binary_nested_unary_vars "nf" (f "sig") "Srt" (f "s")
        (sigAtom sig) (sortAtom sort)
        (by
          intro h
          have : "s" = "sig" := (counterSuffix_injective counter) h
          contradiction)
        (sigAtom_vars_absent sig) (sortAtom_vars_absent sort)
        (sigAtom_not_var sig) (sortAtom_not_var sort)
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename hclosedB
    unfold Metta.matchAtoms
    simpa only [nfQuery, termAtom, coreB, nfSrtRuleBindings, renameBindings] using
      (show (Metta.matchAtomsWith none
          (mExpr "nf" [mVar (f "sig"), mExpr "Srt" [mVar (f "s")]])
          (nfQuery sig (.srt sort))).filter (fun b => !b.hasLoop) =
          [renameBindings f coreB] by
        rw [show Metta.matchAtomsWith none
            (mExpr "nf" [mVar (f "sig"), mExpr "Srt" [mVar (f "s")]])
            (nfQuery sig (.srt sort)) = [renameBindings f coreB] by
          simpa only [nfQuery, termAtom, coreB, nfSrtRuleBindings,
            renameBindings] using hraw]
        exact filter_singleton_binding_of_hasLoop_false _
          (ClosedValueBindings.hasLoop_false hclosedRen))
  have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
    rw [bindingValueKeys_renameBindings]
    exact List.Nodup.map (counterSuffix_injective counter) hnodup
  have hdisj :
      ∀ x ∈ bindingValueKeys (renameBindings f coreB),
        x ∉ bindingValueKeys incoming := by
    intro x hx hxIncoming
    have hx' : x = f "s" ∨ x = f "sig" := by
      simpa [coreB, nfSrtRuleBindings, bindingValueKeys, renameBindings, f]
        using hx
    have hxIncoming' : x = binder := by
      simpa [incoming, bindingValueKeys] using hxIncoming
    rcases hx' with rfl | rfl
    · exact hFresh (Or.inl rfl) hxIncoming'
    · exact hFresh (Or.inr rfl) hxIncoming'
  have hmerge :
      Metta.Bindings.merge incoming (renameBindings f coreB) = [m] := by
    simpa [m] using
      (merge_closed_noConflict_eq
        (ClosedValueBindings.rename hclosedB) hnodupRen hclosedIncoming hdisj)
  have hclosedM : ClosedValueBindings m := by
    exact ClosedValueBindings.append
      (ClosedValueBindings.reverse (ClosedValueBindings.rename hclosedB))
      hclosedIncoming
  have hloop : Metta.Bindings.hasLoop m = false := by
    exact ClosedValueBindings.hasLoop_false hclosedM
  have hresult :
      Metta.instantiate m (mExpr "Srt" [mVar (f "s")]) = root := by
    have hsSig : f "s" ≠ f "sig" := by
      exact fun h => (by
        have := (counterSuffix_injective counter) h
        contradiction)
    rw [hclosedM.instantiate_eq_subst_apply]
    simp [m, f, coreB, nfSrtRuleBindings, incoming, renameBindings,
      root, termAtom, sortAtom, Metta.bindingsToSubst,
      Metta.Subst.apply, Metta.Subst.lookup, mExpr, mSym, mVar, hsSig]
  unfold Metta.Minimal.queryOpItemsOfRule
  rw [hcompat]
  rw [hfresh]
  change
    List.flatMap
        (fun mb =>
          List.filterMap
            (fun m' =>
              if Metta.Bindings.hasLoop m' = true then none
              else some (evalResult []
                (Metta.instantiate m' (mExpr "Srt" [mVar (f "s")])) m'))
            (Metta.Bindings.merge incoming mb))
        (Metta.matchAtoms
          (mExpr "nf" [mVar (f "sig"), mExpr "Srt" [mVar (f "s")]])
          (nfQuery sig (.srt sort))) =
      [evalResult [] (termAtom (.srt sort))
        ((renameBindings (counterSuffix counter)
          (nfSrtRuleBindings sig sort)).reverse ++ incoming)]
  rw [hmatch]
  simp [hmerge, hloop, hresult, root, m, coreB, f]

