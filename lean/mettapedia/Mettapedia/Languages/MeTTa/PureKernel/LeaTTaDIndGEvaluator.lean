      helperOut ∈
          (mettaEval kernelInferApplyArgsNilEnv 1 St.init []
            (inferApplyArgsNilQuery sig rawType)).1.map (·.1) ∧
        Metta.AlphaEq helperOut helperCertified ∧
        helperCertified = nfQuery sig rawType ∧
        nfRootOut ∈
          (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig rawType)).1.map (·.1) ∧
        Metta.AlphaEq nfRootOut nfCertified ∧
        Relation.ReflTransGen
          (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
          (inferApplyArgsNilQuery sig rawType) out := by
  rcases infer_apply_args_nil_mettaEval_bridge_alpha_kernel_of_fragment
      (sig := sig) hfrag with
    ⟨out, helperOut, helperCertified, nfRootOut, nfCertified,
      hhelperRun, hhelperRoot, hhelperAlpha, hhelperEq,
      hnfRun, hnfRoot, hnfAlpha, hnfCtx⟩
  have hhelperCtx :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
        (inferApplyArgsNilQuery sig rawType) helperCertified :=
    kernelChain_to_exprCtxKernelChain hhelperRoot
  have hnfRootCtxCore :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelCoreRules stdGroundings)
        (nfQuery sig rawType) nfCertified :=
    kernelChain_to_exprCtxKernelChain hnfRoot
  have hnfRootCtx :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
        (nfQuery sig rawType) nfCertified := by
    simpa [kernelInferApplyArgsNilRules] using
      (exprCtxKernelChain_append_left
        (atoms := kernelCoreRules)
        (extra := [ruleInferApplyArgsDecl, ruleInferApplyArgsNil])
        (gt := stdGroundings) hnfRootCtxCore)
  have hnfCtxLift :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
        nfCertified out := by
    simpa [kernelInferApplyArgsNilRules] using
      (exprCtxKernelChain_append_left
        (atoms := kernelCoreRules)
        (extra := [ruleInferApplyArgsDecl, ruleInferApplyArgsNil])
        (gt := stdGroundings) hnfCtx)
  have hchain :
      Relation.ReflTransGen
        (ExprCtxKernelStep kernelInferApplyArgsNilRules stdGroundings)
        (inferApplyArgsNilQuery sig rawType) out := by
    subst helperCertified
    exact hhelperCtx.trans (hnfRootCtx.trans hnfCtxLift)
  exact ⟨out, helperOut, helperCertified, nfRootOut, nfCertified,
    hhelperRun, hhelperAlpha, hhelperEq, hnfRun, hnfAlpha, hchain⟩

/-- Closed Stage-3 instance of the D3 helper bridge.

This is the no-hypothesis smoke test for the smallest recursive infer-family
rule: the real helper readout for `infer-apply-args ... ArgsNil` exposes an
`nf` query, and the composed contextual kernel chain reaches the closed/static
`nf` result without assuming a readout witness. -/
