/-- The quoted `nf` query wrapper is injective on the name-free fragment. -/
theorem nfQuery_injective_on_nf_eq_fragment_nameFree
    {sig : DIndGArtifactSig}
    {rawL rawR : DIndGArtifactTerm}
    (hL : NfEqFragmentTermNameFree rawL)
    (hR : NfEqFragmentTermNameFree rawR)
    (hEq : nfQuery sig rawL = nfQuery sig rawR) : rawL = rawR := by
  have hList :
      [mSym "nf", sigAtom sig, termAtom rawL] =
        [mSym "nf", sigAtom sig, termAtom rawR] := by
    simpa [nfQuery, mExpr, mSym] using hEq
  have hTail := List.cons.inj hList
  have hPayload := List.cons.inj hTail.2
  have hTerm : termAtom rawL = termAtom rawR := by
    simpa using (List.cons.inj hPayload.2).1
  exact termAtom_injective_on_nf_eq_fragment_nameFree hL hR hTerm

/-- BEq version of `nfQuery_injective_on_nf_eq_fragment_nameFree`. -/
theorem nfQuery_beq_injective_on_nf_eq_fragment_nameFree
    {sig : DIndGArtifactSig}
    {rawL rawR : DIndGArtifactTerm}
    (hL : NfEqFragmentTermNameFree rawL)
    (hR : NfEqFragmentTermNameFree rawR)
    (hEq : (nfQuery sig rawL == nfQuery sig rawR) = true) : rawL = rawR := by
  change Metta.Atom.beq (nfQuery sig rawL) (nfQuery sig rawR) = true at hEq
  have hPayload := atom_beq_expr_binary_payload_true (tag := "nf")
    (a := sigAtom sig) (b := termAtom rawL) (c := sigAtom sig) (d := termAtom rawR) (by
      simpa [nfQuery, mExpr, mSym] using hEq)
  exact termAtom_beq_injective_on_nf_eq_fragment_nameFree hL hR hPayload.2

/-- The executable `nf` root readout shape is injective on the name-free recursive fragment. -/
theorem nfRootReadoutNameFree_injective_on_nf_eq_fragment_nameFree
    {sig : DIndGArtifactSig}
    {rawL rawR : DIndGArtifactTerm}
    (hL : NfEqFragmentTermNameFree rawL)
    (hR : NfEqFragmentTermNameFree rawR)
    (hEq : nfRootReadoutNameFree sig rawL = nfRootReadoutNameFree sig rawR) :
    rawL = rawR := by
  induction hL generalizing rawR with
  | var k =>
      cases hR <;> simp [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
        termAtom, mExpr, mSym, mNat, sortAtom] at hEq ⊢
      exact hEq
  | srt sort =>
      cases sort
      · cases hR <;> try (rename_i sortR; cases sortR) <;>
          simp [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
            termAtom, mExpr, mSym, mNat, sortAtom] at hEq ⊢
      · cases hR <;> try (rename_i sortR; cases sortR) <;>
          simp [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
            termAtom, mExpr, mSym, mNat, sortAtom] at hEq ⊢
  | bad reason =>
      cases hR <;> simp [nfRootReadoutNameFree, nfPiReadout, nfLamReadout,
        termAtom, mExpr, mSym, mNat, sortAtom] at hEq ⊢
      exact hEq
  | pi hDomain hBody ihDomain ihBody =>
      rename_i rawDomainL rawBodyL
      cases hR with
      | pi hDomainR hBodyR =>
          rename_i rawDomainR rawBodyR
          have hList :
              [mSym "Pi", nfQuery sig rawDomainL, nfQuery sig rawBodyL] =
                [mSym "Pi", nfQuery sig rawDomainR, nfQuery sig rawBodyR] := by
            simpa [nfRootReadoutNameFree, nfPiReadout, nfQuery, mExpr, mSym] using hEq
          have hTail := List.cons.inj hList
          have hPayload := List.cons.inj hTail.2
          have hBodyTail := List.cons.inj hPayload.2
          have hDomainEq :=
            nfQuery_injective_on_nf_eq_fragment_nameFree hDomain hDomainR hPayload.1
          have hBodyEq :=
            nfQuery_injective_on_nf_eq_fragment_nameFree hBody hBodyR hBodyTail.1
          cases hDomainEq
          cases hBodyEq
          rfl
      | var k =>
          simp [nfRootReadoutNameFree, nfPiReadout,
            termAtom, mExpr, mSym, mNat] at hEq
      | srt sort =>
          cases sort <;>
            simp [nfRootReadoutNameFree, nfPiReadout,
              termAtom, sortAtom, mExpr, mSym] at hEq
      | bad reason =>
          exfalso
          simp [nfRootReadoutNameFree, nfPiReadout, termAtom, mExpr, mSym] at hEq
      | lam _ _ =>
          exfalso
          simp [nfRootReadoutNameFree, nfPiReadout, nfLamReadout, mExpr, mSym] at hEq
  | lam hDomain hBody ihDomain ihBody =>
      rename_i rawDomainL rawBodyL
      cases hR with
      | lam hDomainR hBodyR =>
          rename_i rawDomainR rawBodyR
          have hList :
              [mSym "Lam", nfQuery sig rawDomainL, nfQuery sig rawBodyL] =
                [mSym "Lam", nfQuery sig rawDomainR, nfQuery sig rawBodyR] := by
            simpa [nfRootReadoutNameFree, nfLamReadout, nfQuery, mExpr, mSym] using hEq
          have hTail := List.cons.inj hList
          have hPayload := List.cons.inj hTail.2
          have hBodyTail := List.cons.inj hPayload.2
          have hDomainEq :=
            nfQuery_injective_on_nf_eq_fragment_nameFree hDomain hDomainR hPayload.1
          have hBodyEq :=
            nfQuery_injective_on_nf_eq_fragment_nameFree hBody hBodyR hBodyTail.1
          cases hDomainEq
          cases hBodyEq
          rfl
      | var k =>
          simp [nfRootReadoutNameFree, nfLamReadout,
            termAtom, mExpr, mSym, mNat] at hEq
      | srt sort =>
          cases sort <;>
            simp [nfRootReadoutNameFree, nfLamReadout,
              termAtom, sortAtom, mExpr, mSym] at hEq
      | bad reason =>
          exfalso
          simp [nfRootReadoutNameFree, nfLamReadout, termAtom, mExpr, mSym] at hEq
      | pi _ _ =>
          exfalso
          simp [nfRootReadoutNameFree, nfPiReadout, nfLamReadout, mExpr, mSym] at hEq

