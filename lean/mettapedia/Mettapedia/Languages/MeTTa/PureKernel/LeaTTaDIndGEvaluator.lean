/-- Encoded artifact signatures are object-language atoms, never LeaTTa matcher
variables. -/
private theorem sigAtom_not_var (sig : DIndGArtifactSig) (v : String) :
    sigAtom sig ≠ Metta.Atom.var v := by
  rcases sig with ⟨decls, _, _, _⟩
  induction decls with
  | nil => simp [sigAtom, mSym]
  | cons _ _ _ => simp [sigAtom, mExpr]

private theorem sigAtom_vars_absent (sig : DIndGArtifactSig) {v : String} :
    v ∉ (sigAtom sig).vars := by
  rw [sigAtom_vars_nil sig]
  simp

private theorem nfQuery_vars_absent
    (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm) {v : String} :
    v ∉ (nfQuery sig raw).vars := by
  rw [show (nfQuery sig raw).vars = [] by
    simp [nfQuery, mExpr, mSym, Metta.Atom.vars, sigAtom_vars_nil, termAtom_vars_nil]]
  simp

private theorem nfQuery_vars_nil_early
    (sig : DIndGArtifactSig) (raw : DIndGArtifactTerm) :
    (nfQuery sig raw).vars = [] := by
  simp [nfQuery, mExpr, mSym, Metta.Atom.vars, sigAtom_vars_nil, termAtom_vars_nil]

/-- The repaired matcher filters complete candidate bindings before threading
them into the next `matchAll` accumulator.  This helper exposes the singleton
case without unfolding the filter at every concrete matcher proof. -/
private theorem filter_singleton_binding_of_hasLoop_false
    (b : Metta.Bindings) (hloop : b.hasLoop = false) :
    List.filter (fun bindings : Metta.Bindings => !bindings.hasLoop) [b] = [b] := by
  simp [hloop]

/-- Lift an exact singleton `matchAtomsWith` computation through the repaired
whole-result loop filter. -/
private theorem matchAtoms_eq_singleton_of_matchAtomsWith_eq
    (lhs rhs : Metta.Atom) (b : Metta.Bindings)
    (hmatch : Metta.matchAtomsWith none lhs rhs = [b])
    (hloop : b.hasLoop = false) :
    Metta.matchAtoms lhs rhs = [b] := by
  unfold Metta.matchAtoms
  rw [hmatch]
  exact filter_singleton_binding_of_hasLoop_false b hloop

/-- Closed value-only singleton results are admitted by the repaired outer
matcher filter. -/
private theorem matchAtoms_eq_singleton_of_matchAtomsWith_eq_closed
    (lhs rhs : Metta.Atom) (b : Metta.Bindings)
    (hmatch : Metta.matchAtomsWith none lhs rhs = [b])
    (hclosed : ClosedValueBindings b) :
    Metta.matchAtoms lhs rhs = [b] :=
  matchAtoms_eq_singleton_of_matchAtomsWith_eq lhs rhs b hmatch hclosed.hasLoop_false

/-- Two value bindings are loop-free when every stored value is fresh for both keys.
This is the smallest reusable invariant needed by the repaired matcher's result filter;
self-freshness alone would miss a mutual dependency between the two values. -/
private theorem hasLoop_two_vals_false_of_fresh
    (x y : String) (a b : Metta.Atom)
    (hxa : x ∉ a.vars) (hxb : x ∉ b.vars)
    (hya : y ∉ a.vars) (hyb : y ∉ b.vars) :
    Metta.Bindings.hasLoop
      [Metta.BindingRel.val x a, Metta.BindingRel.val y b] = false := by
  apply ValueBindings.hasLoop_false_of_fresh
    (ValueBindings.val (ValueBindings.val ValueBindings.nil))
  intro key hkey z value hmem
  simp [bindingValueKeys] at hkey hmem
  rcases hkey with rfl | rfl <;>
    rcases hmem with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
    assumption

/-- Match-order loop freedom for the mixed binding shape emitted by `let`.
All three binding keys must be fresh for both payloads; this joint condition is
what excludes cross-value cycles after the repaired whole-result loop filter. -/
private theorem hasLoop_two_vals_one_eq_false_of_joint_fresh
    (templateKey atomKey patternKey binder : String)
    (template atom : Metta.Atom)
    (hPatternBinder : patternKey ≠ binder)
    (hPatternAtomKey : patternKey ≠ atomKey)
    (hPatternTemplateKey : patternKey ≠ templateKey)
    (hAtomTemplateKey : atomKey ≠ templateKey)
    (hAtomBinder : atomKey ≠ binder)
    (hTemplateBinder : templateKey ≠ binder)
    (hPatternAtom : patternKey ∉ atom.vars)
    (hAtomAtom : atomKey ∉ atom.vars)
    (hTemplateAtom : templateKey ∉ atom.vars)
    (hPatternTemplate : patternKey ∉ template.vars)
    (hAtomTemplate : atomKey ∉ template.vars)
    (hTemplateTemplate : templateKey ∉ template.vars)
    (hAtomNonVar : ∀ w, atom ≠ Metta.Atom.var w)
    (hTemplateNonVar : ∀ w, template ≠ Metta.Atom.var w) :
    Metta.Bindings.hasLoop
      [ Metta.BindingRel.val templateKey template
      , Metta.BindingRel.val atomKey atom
      , Metta.BindingRel.eq patternKey binder ] = false := by
  let b : Metta.Bindings :=
    [ Metta.BindingRel.val templateKey template
    , Metta.BindingRel.val atomKey atom
    , Metta.BindingRel.eq patternKey binder ]
  have payloadClassValues
      (x : String) (hxp : x ≠ patternKey)
      (hxt : x ≠ templateKey) (hxa : x ≠ atomKey) :
      Metta.Bindings.classValues b x = [] := by
    exact Bindings.classValues_two_vals_one_eq_eq_nil
      templateKey atomKey patternKey binder x template atom
      hPatternBinder hxp hxt hxa hPatternTemplateKey hPatternAtomKey
      (Ne.symm hTemplateBinder) (Ne.symm hAtomBinder)
  have payloadRepresentative
      (x : String) (hxp : x ≠ patternKey) :
      Metta.Bindings.eqRepresentative b x = x := by
    exact Bindings.eqRepresentative_two_vals_one_eq_of_ne_left
      templateKey atomKey patternKey binder x template atom
      hPatternBinder hxp
  have hclassAtom : Metta.Bindings.eqClassOrdered b atomKey = [atomKey] := by
    rw [Bindings.eqClassOrdered_two_vals_one_eq_of_ne_left
      templateKey atomKey patternKey binder atomKey template atom
      hPatternBinder (Ne.symm hPatternAtomKey)]
    simp [hAtomBinder]
  have hclassTemplate :
      Metta.Bindings.eqClassOrdered b templateKey = [templateKey] := by
    rw [Bindings.eqClassOrdered_two_vals_one_eq_of_ne_left
      templateKey atomKey patternKey binder templateKey template atom
      hPatternBinder (Ne.symm hPatternTemplateKey)]
    simp [hTemplateBinder]
  have hvaluesAtom : Metta.Bindings.classValues b atomKey = [atom] := by
    rw [Metta.Bindings.classValues, hclassAtom]
    simp [b, Metta.Bindings.lookupVal, hAtomTemplateKey]
  have hvaluesTemplate :
      Metta.Bindings.classValues b templateKey = [template] := by
    rw [Metta.Bindings.classValues, hclassTemplate]
    simp [b, Metta.Bindings.lookupVal, hAtomTemplateKey]
  have hAtomAux : Metta.Bindings.resolveAtomAux b
      (Metta.Bindings.resolutionFuel b (mVar atomKey)).pred [atomKey] atom =
        some atom := by
    apply Bindings.resolveAtomAux_inert
    · intro x hx
      exact payloadClassValues x
        (fun h => hPatternAtom (h ▸ hx))
        (fun h => hTemplateAtom (h ▸ hx))
        (fun h => hAtomAtom (h ▸ hx))
    · intro x hx
      exact payloadRepresentative x (fun h => hPatternAtom (h ▸ hx))
    · intro x hx y hy
      rw [Bindings.eqClassOrdered_two_vals_one_eq_of_ne_left
        templateKey atomKey patternKey binder x template atom
        hPatternBinder (fun h => hPatternAtom (h ▸ hx))] at hy
      by_cases hxb : x = binder
      · subst x
        simp at hy
        intro hya
        have hyAtom : y = atomKey := by simpa using hya
        rcases hy with hyBinder | hyPattern
        · exact hAtomBinder (hyAtom.symm.trans hyBinder)
        · exact hPatternAtomKey (hyPattern.symm.trans hyAtom)
      · simp [hxb] at hy
        intro hya
        have hyAtom : y = atomKey := by simpa using hya
        have hxAtom : x = atomKey := hy.symm.trans hyAtom
        exact hAtomAtom (hxAtom ▸ hx)
    · simp [b, Metta.Bindings.resolutionFuel,
        Metta.Bindings.relationResolutionFuel, mVar, Metta.Atom.size]
      omega
  have hTemplateAux : Metta.Bindings.resolveAtomAux b
      (Metta.Bindings.resolutionFuel b (mVar templateKey)).pred
        [templateKey] template = some template := by
    apply Bindings.resolveAtomAux_inert
    · intro x hx
      exact payloadClassValues x
        (fun h => hPatternTemplate (h ▸ hx))
        (fun h => hTemplateTemplate (h ▸ hx))
        (fun h => hAtomTemplate (h ▸ hx))
    · intro x hx
      exact payloadRepresentative x (fun h => hPatternTemplate (h ▸ hx))
    · intro x hx y hy
      rw [Bindings.eqClassOrdered_two_vals_one_eq_of_ne_left
        templateKey atomKey patternKey binder x template atom
        hPatternBinder (fun h => hPatternTemplate (h ▸ hx))] at hy
      by_cases hxb : x = binder
      · subst x
        simp at hy
        intro hyt
        have hyTemplate : y = templateKey := by simpa using hyt
        rcases hy with hyBinder | hyPattern
        · exact hTemplateBinder (hyTemplate.symm.trans hyBinder)
        · exact hPatternTemplateKey (hyPattern.symm.trans hyTemplate)
      · simp [hxb] at hy
        intro hyt
        have hyTemplate : y = templateKey := by simpa using hyt
        have hxTemplate : x = templateKey := hy.symm.trans hyTemplate
        exact hTemplateTemplate (hxTemplate ▸ hx)
    · simp [b, Metta.Bindings.resolutionFuel,
        Metta.Bindings.relationResolutionFuel, mVar, Metta.Atom.size]
      omega
  have hresolveAtom : Metta.Bindings.resolve b atomKey = some atom :=
    Bindings.resolve_eq_nonvar_class_value
      hclassAtom hvaluesAtom hAtomNonVar hAtomAux
  have hresolveTemplate :
      Metta.Bindings.resolve b templateKey = some template :=
    Bindings.resolve_eq_nonvar_class_value
      hclassTemplate hvaluesTemplate hTemplateNonVar hTemplateAux
  have hclassPattern :
      Metta.Bindings.eqClassOrdered b patternKey = [binder, patternKey] := by
    simpa [b] using
      (Bindings.eqClassOrdered_two_vals_one_eq_left
        templateKey atomKey patternKey binder template atom hPatternBinder)
  have hvaluesPattern : Metta.Bindings.classValues b patternKey = [] := by
    rw [Metta.Bindings.classValues, hclassPattern]
    simp [b, Metta.Bindings.lookupVal, hPatternAtomKey,
      hPatternTemplateKey, Ne.symm hAtomBinder, Ne.symm hTemplateBinder]
  have hrepresentativePattern :
      Metta.Bindings.eqRepresentative b patternKey = binder := by
    rw [Metta.Bindings.eqRepresentative, hclassPattern]
    simp
  have hresolvePattern :
      Metta.Bindings.resolve b patternKey = some (mVar binder) := by
    exact Bindings.resolve_eq_representative_of_valueless_class
      hclassPattern (by simp [hPatternBinder]) hvaluesPattern
      hrepresentativePattern
  have hclassBinder :
      Metta.Bindings.eqClassOrdered b binder = [binder, patternKey] := by
    rw [Bindings.eqClassOrdered_two_vals_one_eq_of_ne_left
      templateKey atomKey patternKey binder binder template atom
      hPatternBinder (Ne.symm hPatternBinder)]
    simp
  have hvaluesBinder : Metta.Bindings.classValues b binder = [] :=
    payloadClassValues binder (Ne.symm hPatternBinder)
      (Ne.symm hTemplateBinder) (Ne.symm hAtomBinder)
  have hrepresentativeBinder :
      Metta.Bindings.eqRepresentative b binder = binder :=
    payloadRepresentative binder (Ne.symm hPatternBinder)
  have hresolveBinder :
      Metta.Bindings.resolve b binder = some (mVar binder) := by
    exact Bindings.resolve_eq_representative_of_valueless_class
      hclassBinder (by simp [hPatternBinder]) hvaluesBinder
      hrepresentativeBinder
  have hdirect : b.any (fun r => match r with
      | Metta.BindingRel.val x (Metta.Atom.var y) => x == y
      | Metta.BindingRel.eq x y => x == y
      | _ => false) = false := by
    have hAtomDirect : (match Metta.BindingRel.val atomKey atom with
        | Metta.BindingRel.val x (Metta.Atom.var y) => x == y
        | Metta.BindingRel.eq x y => x == y
        | _ => false) = false := by
      cases atom with
      | var y => exact (hAtomNonVar y rfl).elim
      | sym _ => simp
      | gnd _ => simp
      | expr _ => simp
    have hTemplateDirect : (match Metta.BindingRel.val templateKey template with
        | Metta.BindingRel.val x (Metta.Atom.var y) => x == y
        | Metta.BindingRel.eq x y => x == y
        | _ => false) = false := by
      cases template with
      | var y => exact (hTemplateNonVar y rfl).elim
      | sym _ => simp
      | gnd _ => simp
      | expr _ => simp
    simp [b, hPatternBinder, hAtomDirect, hTemplateDirect]
  change Metta.Bindings.hasLoop b = false
  apply Bindings.hasLoop_false_of_resolveAtomAux_some hdirect
  intro x _hx
  by_cases hxa : x = atomKey
  · subst x
    exact Bindings.resolveAtomAux_some_of_resolve_some hresolveAtom
  by_cases hxt : x = templateKey
  · subst x
    exact Bindings.resolveAtomAux_some_of_resolve_some hresolveTemplate
  by_cases hxp : x = patternKey
  · subst x
    exact Bindings.resolveAtomAux_some_of_resolve_some hresolvePattern
  by_cases hxb : x = binder
  · subst x
    exact Bindings.resolveAtomAux_some_of_resolve_some hresolveBinder
  · refine ⟨mVar x, ?_⟩
    apply Bindings.resolveAtomAux_inert
    · intro y hy
      simp [Metta.Atom.vars] at hy
      subst y
      exact payloadClassValues x hxp hxt hxa
    · intro y hy
      simp [Metta.Atom.vars] at hy
      subst y
      exact payloadRepresentative x hxp
    · simp
    · simp [Metta.Bindings.resolutionFuel, mVar, Metta.Atom.size]

/-- The real kernel `conv` rule matches any encoded artifact conversion query.
This is the relation-level decomposition needed by the App body; it is not a
concrete interpreter trace. -/
theorem conv_rule_match
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.matchAtoms
      (mExpr "conv" [mVar "sig", mVar "x", mVar "y"])
      (convQuery sig rawLeft rawRight) =
    [[Metta.BindingRel.val "y" (termAtom rawRight),
      Metta.BindingRel.val "x" (termAtom rawLeft),
      Metta.BindingRel.val "sig" (sigAtom sig)]] := by
  have hmergeSig :
      Metta.Bindings.merge [] [Metta.BindingRel.val "sig" (sigAtom sig)] =
        [[Metta.BindingRel.val "sig" (sigAtom sig)]] := by
    simpa [bindingValueKeys] using
      (merge_closed_noConflict_eq
        (b := [Metta.BindingRel.val "sig" (sigAtom sig)]) (acc := [])
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
        (by simp [bindingValueKeys]) ClosedValueBindings.nil
        (by intro x hx hmem; cases hmem))
  have hloopSig :
      Metta.Bindings.hasLoop [Metta.BindingRel.val "sig" (sigAtom sig)] = false :=
    ClosedValueBindings.hasLoop_false
      (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
  have hmergeX :
      Metta.Bindings.merge [Metta.BindingRel.val "sig" (sigAtom sig)]
          [Metta.BindingRel.val "x" (termAtom rawLeft)] =
        [[ Metta.BindingRel.val "x" (termAtom rawLeft)
         , Metta.BindingRel.val "sig" (sigAtom sig) ]] := by
    simpa [bindingValueKeys] using
      (merge_closed_noConflict_eq
        (b := [Metta.BindingRel.val "x" (termAtom rawLeft)])
        (acc := [Metta.BindingRel.val "sig" (sigAtom sig)])
        (ClosedValueBindings.val (termAtom_vars_nil rawLeft) ClosedValueBindings.nil)
        (by simp [bindingValueKeys])
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
        (by simp [bindingValueKeys]))
  have hmergeY :
      Metta.Bindings.merge
          [ Metta.BindingRel.val "x" (termAtom rawLeft)
          , Metta.BindingRel.val "sig" (sigAtom sig) ]
          [Metta.BindingRel.val "y" (termAtom rawRight)] =
        [[ Metta.BindingRel.val "y" (termAtom rawRight)
         , Metta.BindingRel.val "x" (termAtom rawLeft)
         , Metta.BindingRel.val "sig" (sigAtom sig) ]] := by
    simpa [bindingValueKeys] using
      (merge_closed_noConflict_eq
        (b := [Metta.BindingRel.val "y" (termAtom rawRight)])
        (acc :=
          [ Metta.BindingRel.val "x" (termAtom rawLeft)
          , Metta.BindingRel.val "sig" (sigAtom sig) ])
        (ClosedValueBindings.val (termAtom_vars_nil rawRight) ClosedValueBindings.nil)
        (by simp [bindingValueKeys])
        (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
          (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))
        (by simp [bindingValueKeys]))
  have hloopX :
      Metta.Bindings.hasLoop [Metta.BindingRel.val "x" (termAtom rawLeft)] = false :=
    ClosedValueBindings.hasLoop_false
      (ClosedValueBindings.val (termAtom_vars_nil rawLeft) ClosedValueBindings.nil)
  have hloopY :
      Metta.Bindings.hasLoop [Metta.BindingRel.val "y" (termAtom rawRight)] = false :=
    ClosedValueBindings.hasLoop_false
      (ClosedValueBindings.val (termAtom_vars_nil rawRight) ClosedValueBindings.nil)
  have hloopResult :
      Metta.Bindings.hasLoop
        [ Metta.BindingRel.val "y" (termAtom rawRight)
        , Metta.BindingRel.val "x" (termAtom rawLeft)
        , Metta.BindingRel.val "sig" (sigAtom sig) ] = false :=
    ClosedValueBindings.hasLoop_false
      (ClosedValueBindings.val (termAtom_vars_nil rawRight)
        (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
          (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)))
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, convQuery, mExpr, mSym, mVar]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_occurs_free_nonvar_atom "sig" (sigAtom sig) (sigAtom_vars_absent sig)
    (sigAtom_not_var sig)]
  simp [hloopSig, hmergeSig]
  unfold Metta.matchAll
  rw [match_var_occurs_free_nonvar_atom "x" (termAtom rawLeft)
    (termAtom_vars_absent rawLeft) (termAtom_not_var rawLeft)]
  simp [hloopX, hmergeX]
  unfold Metta.matchAll
  rw [match_var_occurs_free_nonvar_atom "y" (termAtom rawRight)
    (termAtom_vars_absent rawRight) (termAtom_not_var rawRight)]
  simp [hloopY, hmergeY, hloopResult]
  unfold Metta.matchAll
  change List.filter (fun bindings => !Metta.Bindings.hasLoop bindings)
      [[ Metta.BindingRel.val "y" (termAtom rawRight)
       , Metta.BindingRel.val "x" (termAtom rawLeft)
       , Metta.BindingRel.val "sig" (sigAtom sig) ]] = _
  simp [hloopResult]

/-- Instantiating the kernel `conv` body with a matched artifact conversion
query exposes the two normalization subqueries and the structural equality test. -/
theorem conv_instantiate_bindings
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.instantiate
        [ Metta.BindingRel.val "y" (termAtom rawRight)
        , Metta.BindingRel.val "x" (termAtom rawLeft)
        , Metta.BindingRel.val "sig" (sigAtom sig) ]
        (mExpr "let"
          [ mVar "nx"
          , mExpr "nf" [mVar "sig", mVar "x"]
          , mExpr "let"
              [ mVar "ny"
              , mExpr "nf" [mVar "sig", mVar "y"]
              , mExpr "if"
                  [ mExpr "is-bad" [mVar "nx"]
                  , mBool false
                  , mExpr "if"
                      [ mExpr "is-bad" [mVar "ny"]
                      , mBool false
                      , mExpr "==" [mVar "nx", mVar "ny"] ] ] ] ]) =
      convReadout sig rawLeft rawRight := by
  have hclosed : ClosedValueBindings
      [ Metta.BindingRel.val "y" (termAtom rawRight)
      , Metta.BindingRel.val "x" (termAtom rawLeft)
      , Metta.BindingRel.val "sig" (sigAtom sig) ] :=
    ClosedValueBindings.val (termAtom_vars_nil rawRight)
      (ClosedValueBindings.val (termAtom_vars_nil rawLeft)
        (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil))
  rw [hclosed.instantiate_eq_subst_apply]
  simp [convReadout, Metta.bindingsToSubst,
    Metta.Subst.apply, Metta.Subst.lookup, mExpr, mSym, mVar, mBool]

/-- MOPS fires the kernel `conv` rule for any encoded artifact conversion query.
This is the reusable `conv` sub-derivation that the App rule must later consume
through the declaration-level conversion soundness theorem. -/
theorem conv_mops_readout
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    convReadout sig rawLeft rawRight ∈
      Metta.equalityReductions ⟨kernelCoreRules⟩
        (convQuery sig rawLeft rawRight) := by
  rw [Metta.mem_equalityReductions]
  refine ⟨(mExpr "conv" [mVar "sig", mVar "x", mVar "y"],
      mExpr "let"
        [ mVar "nx"
        , mExpr "nf" [mVar "sig", mVar "x"]
        , mExpr "let"
            [ mVar "ny"
            , mExpr "nf" [mVar "sig", mVar "y"]
            , mExpr "if"
                [ mExpr "is-bad" [mVar "nx"]
                , mBool false
                , mExpr "if"
                    [ mExpr "is-bad" [mVar "ny"]
                    , mBool false
                    , mExpr "==" [mVar "nx", mVar "ny"] ] ] ] ]), ?_, ?_⟩
  · simp [Metta.Space.equalityRules, kernelCoreRules, runtimeDecls, ruleConv,
      ruleIsBad, ruleNfVar, ruleNfSrt, ruleNfCon, ruleNfBad, ruleInferSrtType,
      ruleInferSrtKind, ruleInferBad, mExpr, mSym, mVar, mTypeDecl, mBool]
  · refine ⟨[Metta.BindingRel.val "y" (termAtom rawRight),
        Metta.BindingRel.val "x" (termAtom rawLeft),
        Metta.BindingRel.val "sig" (sigAtom sig)], ?_, ?_⟩
    · rw [conv_rule_match]
      simp
    · simp [conv_instantiate_bindings]

/-- The kernel `conv` readout as a one-step MOPS proposition. -/
theorem conv_mops_step
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.MopsStep kernelCoreRules
      (convQuery sig rawLeft rawRight)
      (convReadout sig rawLeft rawRight) := by
  constructor
  · refine ⟨"conv", ?_⟩
    simp [Metta.Minimal.headKey, convQuery, mExpr, mSym]
  · exact conv_mops_readout sig rawLeft rawRight

/-- The same `conv` decomposition transported through LeaTTa's executable
kernel/MOPS correspondence. -/
theorem conv_kernel_step
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.KernelStep kernelCoreRules stdGroundings
      (convQuery sig rawLeft rawRight)
      (convReadout sig rawLeft rawRight) := by
  exact (Metta.kernelStep_iff_mopsStep (atoms := kernelCoreRules) (gt := stdGroundings)).2
    (conv_mops_step sig rawLeft rawRight)

/-! ### Control-flow slice for `conv` bodies

The full `conv` body uses three control constructs after the root `conv`
dispatch: stdlib `let`, stdlib `if`, and grounded `==`.  The parsed prelude is
too large to use as a proof-reduction target here, so this section names the
small explicit rule slice needed by the body and proves its relation-level
steps.  The lemmas stay at the certified step layer; they do not unfold a
concrete `interpretFuel` trace.

This slice is deliberately relation-facing.  The executable `kernelEnv` below
uses the same small control interface rather than loading the whole parsed
prelude, so the conv proof does not depend on unrelated stdlib bookkeeping.
-/

theorem is_bad_rule_match
    (a : Metta.Atom) (hA : "x" ∉ a.vars)
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w) :
    Metta.matchAtoms isBadRulePair.1 (mExpr "is-bad" [a]) =
      [[Metta.BindingRel.val "x" a]] := by
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, isBadRulePair, mExpr, mSym, mVar]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_occurs_free_nonvar_atom "x" a hA hNonVar]
  have hloop :
      Metta.Bindings.hasLoop [Metta.BindingRel.val "x" a] = false :=
    hasLoop_singleton_val_not_false "x" a hA
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
