  exact
    mettaEval_kernelDefControlEnv_eq_true_beq_true
      (fuel := fuelBase + 1) (st := stRoot2) (a := nx) (b := ny)
      (outBnd := finalBnd)
      hWorldRoot2 hNxState hNyState
