/-- Premise-free runtime-root package for the equality-rule-only recursive `nf` fragment.

Unlike `nf_eq_fragment_mettaEval_root_bridge_alpha_mops`, this theorem does not accept a
`NfEqFragmentReadout` witness as an input.  It derives the readout from the structural fragment
predicate and then composes the actual `mettaEval` root readout with the certified MOPS/contextual
spine. -/
theorem nf_eq_fragment_mettaEval_root_bridge_alpha_mops_of_fragment
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    (hfrag : NfEqFragmentTerm raw) :
    ∃ out rootOut rootCertified,
      rootOut ∈ (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig raw)).1.map (·.1) ∧
        Relation.ReflTransGen (Metta.MopsStep kernelCoreRules)
          (nfQuery sig raw) rootCertified ∧
        Metta.AlphaEq rootOut rootCertified ∧
        Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules) rootCertified out := by
  rcases nf_eq_fragment_readout_exists (sig := sig) hfrag with ⟨out, hout⟩
  rcases nf_eq_fragment_mettaEval_root_bridge_alpha_mops hout with
    ⟨rootOut, rootCertified, hrun, hroot, halpha, hctx⟩
  exact ⟨out, rootOut, rootCertified, hrun, hroot, halpha, hctx⟩

/-- Kernel-facing form of `nf_eq_fragment_mettaEval_root_bridge_alpha_mops_of_fragment`.

This is the SR-facing interface: the actual `mettaEval` root readout is tied to LeaTTa's
certified executable-kernel relation, and the recursive `nf` spine is carried by the contextual
kernel closure. -/
theorem nf_eq_fragment_mettaEval_root_bridge_alpha_kernel_of_fragment
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    (hfrag : NfEqFragmentTerm raw) :
    ∃ out rootOut rootCertified,
      rootOut ∈ (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig raw)).1.map (·.1) ∧
        Relation.ReflTransGen (Metta.KernelStep kernelCoreRules stdGroundings)
          (nfQuery sig raw) rootCertified ∧
        Metta.AlphaEq rootOut rootCertified ∧
        Relation.ReflTransGen (ExprCtxKernelStep kernelCoreRules stdGroundings)
          rootCertified out := by
  rcases nf_eq_fragment_mettaEval_root_bridge_alpha_mops_of_fragment
    (sig := sig) hfrag with
    ⟨out, rootOut, rootCertified, hrun, hroot, halpha, hctx⟩
  exact ⟨out, rootOut, rootCertified, hrun,
    (Metta.reflTransGen_kernelStep_iff_mops kernelCoreRules stdGroundings
      (nfQuery sig raw) rootCertified).2 hroot,
    halpha,
    exprCtxMopsChain_to_kernel (gt := stdGroundings) hctx⟩

/-- Declaration-facing soundness package for the equality-rule-only `nf`
fragment.

This is the `nf` analogue of `infer_sound_srt`: it starts from the real LeaTTa
`mettaEval` root readout, ties that readout to LeaTTa's certified kernel step by
`AlphaEq`, follows the contextual kernel spine to the structural atom
`termAtom raw`, and then exposes the declaration-side conversion judgment for
the translated term.  The `NfEqFragmentReadout` witness is derived internally
from the structural fragment premise; no readout/crux premise is assumed. -/
theorem nf_eq_fragment_mettaEval_decl_conv_of_fragment
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {term : PureTm 0}
    (hfrag : NfEqFragmentTerm raw)
    (htr :
      DIndGArtifactTermTranslates sig.nameTranslates 0 raw term) :
    ∃ rootOut rootCertified,
      rootOut ∈ (mettaEval kernelCoreEnv 1 St.init [] (nfQuery sig raw)).1.map (·.1) ∧
        Relation.ReflTransGen (Metta.KernelStep kernelCoreRules stdGroundings)
          (nfQuery sig raw) rootCertified ∧
        Metta.AlphaEq rootOut rootCertified ∧
        Relation.ReflTransGen (ExprCtxKernelStep kernelCoreRules stdGroundings)
          rootCertified (termAtom raw) ∧
        RedStarDecl (envOfSpecs sig.translatedSpecs) term term ∧
        ConvDecl (envOfSpecs sig.translatedSpecs) term term := by
  rcases nf_eq_fragment_readout_exists (sig := sig) hfrag with ⟨out, hout⟩
  rcases nf_eq_fragment_mettaEval_root_bridge_alpha_mops hout with
    ⟨rootOut, rootCertified, hrun, hrootMops, halpha, hctxMops⟩
  have houtEq : out = termAtom raw :=
    nf_eq_fragment_readout_eq_termAtom hout
  refine ⟨rootOut, rootCertified, hrun, ?_, halpha, ?_, ?_, ?_⟩
  · exact
      (Metta.reflTransGen_kernelStep_iff_mops kernelCoreRules stdGroundings
