    {raw : DIndGArtifactTerm}
    (badVar : String)
    (hName : NfEqFragmentTermNameFree raw)
    (hNotBad : ∀ reason, raw ≠ .bad reason) :
    Metta.matchAtoms (termAtom raw) (mExpr "Bad" [mVar badVar]) = [] := by
  induction hName with
  | var k =>
      simp [termAtom, mExpr, mSym, mVar, mNat, Metta.matchAtoms, Metta.matchAtomsWith,
        Metta.matchAll]
  | srt sort =>
      cases sort <;>
        simp [termAtom, sortAtom, mExpr, mSym, mVar, Metta.matchAtoms, Metta.matchAtomsWith,
          Metta.matchAll]
  | bad reason =>
      exact False.elim (hNotBad reason rfl)
  | pi hDomain hBody ihDomain ihBody =>
      simp [termAtom, mExpr, mSym, mVar, Metta.matchAtoms, Metta.matchAtomsWith,
        Metta.matchAll]
  | lam hDomain hBody ihDomain ihBody =>
      simp [termAtom, mExpr, mSym, mVar, Metta.matchAtoms, Metta.matchAtomsWith,
        Metta.matchAll]

/-- Every structural equality-rule-only `nf` term has a declarative readout. -/
theorem nf_eq_fragment_readout_exists
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    (h : NfEqFragmentTerm raw) :
    ∃ out, NfEqFragmentReadout sig raw out := by
  induction h with
  | var k =>
      exact ⟨termAtom (.var k), NfEqFragmentReadout.var (sig := sig) k⟩
  | srt sort =>
      exact ⟨termAtom (.srt sort), NfEqFragmentReadout.srt (sig := sig) sort⟩
  | con name =>
      exact ⟨termAtom (.con name), NfEqFragmentReadout.con (sig := sig) name⟩
  | bad reason =>
      exact ⟨termAtom (.bad reason), NfEqFragmentReadout.bad (sig := sig) reason⟩
  | pi hDomain hBody ihDomain ihBody =>
      rcases ihDomain with ⟨domainOut, hDomainOut⟩
      rcases ihBody with ⟨bodyOut, hBodyOut⟩
      exact ⟨mExpr "Pi" [domainOut, bodyOut],
        NfEqFragmentReadout.pi hDomainOut hBodyOut⟩
  | lam hDomain hBody ihDomain ihBody =>
      rcases ihDomain with ⟨domainOut, hDomainOut⟩
      rcases ihBody with ⟨bodyOut, hBodyOut⟩
      exact ⟨mExpr "Lam" [domainOut, bodyOut],
        NfEqFragmentReadout.lam hDomainOut hBodyOut⟩

theorem nf_eq_fragment_nameFree_readout_termAtom
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    (h : NfEqFragmentTermNameFree raw) :
    NfEqFragmentReadout sig raw (termAtom raw) := by
  induction h with
  | var k =>
      exact NfEqFragmentReadout.var (sig := sig) k
  | srt sort =>
      exact NfEqFragmentReadout.srt (sig := sig) sort
  | bad reason =>
      exact NfEqFragmentReadout.bad (sig := sig) reason
  | pi hDomain hBody ihDomain ihBody =>
      simpa [termAtom] using
        (NfEqFragmentReadout.pi (sig := sig) ihDomain ihBody)
  | lam hDomain hBody ihDomain ihBody =>
      simpa [termAtom] using
        (NfEqFragmentReadout.lam (sig := sig) ihDomain ihBody)

/-- The equality-rule-only `nf` fragment computes the structural atom for the
same raw term.

This is the atom-level seam needed before the runtime bridge can be consumed by
the declaration calculus: the contextual certified kernel spine does not end at
an arbitrary MeTTa atom, but at the `termAtom` corresponding to the translated
raw term. -/
theorem nf_eq_fragment_readout_eq_termAtom
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : NfEqFragmentReadout sig raw out) :
    out = termAtom raw := by
  induction h with
  | var k =>
      rfl
  | srt sort =>
      rfl
  | con name =>
      rfl
  | bad reason =>
      rfl
  | pi hDomain hBody ihDomain ihBody =>
      simp [termAtom, ihDomain, ihBody]
  | lam hDomain hBody ihDomain ihBody =>
      simp [termAtom, ihDomain, ihBody]

/-- A quoted `nf` query is never itself the structural `nf` fragment readout.

This pins down the runtime/declaration seam precisely: LeaTTa's executable
`nf` query produces an Atom-valued root readout, while the declaration-side
proofs ultimately speak about the structural `termAtom` readout. -/
theorem nfQuery_ne_nf_eq_fragment_readout
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : NfEqFragmentReadout sig raw out) :
    nfQuery sig raw ≠ out := by
  cases h <;> simp [nfQuery, termAtom, sortAtom, mExpr, mSym]

/-- The executable recursive `nf`/`Pi` root readout is not yet the final
structural `Pi` readout.

Its first argument is still the quoted recursive query `nf sig A`, not the
recursively normalized domain readout. -/
theorem nfPiReadout_ne_nf_eq_fragment_readout
    {sig : DIndGArtifactSig}
    {rawDomain rawBody : DIndGArtifactTerm}
    {domainOut bodyOut : Metta.Atom}
    (hDomain : NfEqFragmentReadout sig rawDomain domainOut)
    (_hBody : NfEqFragmentReadout sig rawBody bodyOut) :
    nfPiReadout sig rawDomain rawBody ≠ mExpr "Pi" [domainOut, bodyOut] := by
  intro hEq
  have hFirst : nfQuery sig rawDomain = domainOut := by
    have h1 :
        [mSym "Pi", Atom.expr [Atom.sym "nf", sigAtom sig, termAtom rawDomain],
          Atom.expr [Atom.sym "nf", sigAtom sig, termAtom rawBody]] =
        [mSym "Pi", domainOut, bodyOut] := by
      simpa [nfPiReadout, nfQuery, mExpr, mSym] using hEq
    have h2 := List.cons.inj h1
    have h3 := List.cons.inj h2.2
    simpa [nfQuery, mExpr, mSym] using h3.1
  exact (nfQuery_ne_nf_eq_fragment_readout hDomain) hFirst

/-- The executable recursive `nf`/`Lam` root readout is not yet the final
structural `Lam` readout. -/
theorem nfLamReadout_ne_nf_eq_fragment_readout
    {sig : DIndGArtifactSig}
    {rawDomain rawBody : DIndGArtifactTerm}
    {domainOut bodyOut : Metta.Atom}
    (hDomain : NfEqFragmentReadout sig rawDomain domainOut)
    (_hBody : NfEqFragmentReadout sig rawBody bodyOut) :
    nfLamReadout sig rawDomain rawBody ≠ mExpr "Lam" [domainOut, bodyOut] := by
  intro hEq
  have hFirst : nfQuery sig rawDomain = domainOut := by
    have h1 :
        [mSym "Lam", Atom.expr [Atom.sym "nf", sigAtom sig, termAtom rawDomain],
          Atom.expr [Atom.sym "nf", sigAtom sig, termAtom rawBody]] =
        [mSym "Lam", domainOut, bodyOut] := by
      simpa [nfLamReadout, nfQuery, mExpr, mSym] using hEq
    have h2 := List.cons.inj h1
    have h3 := List.cons.inj h2.2
    simpa [nfQuery, mExpr, mSym] using h3.1
  exact (nfQuery_ne_nf_eq_fragment_readout hDomain) hFirst

/-- Runtime `evalOp` bridge for successful grounded equality on two `nf`
fragment readouts. -/
theorem evalOp_nf_readouts_eq_true
    {sig : DIndGArtifactSig} {rawLeft rawRight : DIndGArtifactTerm}
    {outLeft outRight : Metta.Atom}
    (prev : Stack)
    (hReadLeft : NfEqFragmentReadout sig rawLeft outLeft)
    (hReadRight : NfEqFragmentReadout sig rawRight outRight)
    (hcall :
      callGrounded stdGroundings "==" [outLeft, outRight] =
        ReduceResult.ok [mBool true]) :
    evalOp kernelCoreEnv St.init prev (mExpr "==" [outLeft, outRight]) [] =
      ([evalResult prev (mBool true) []], St.init) := by
  have hLeftOut := nf_eq_fragment_readout_eq_termAtom hReadLeft
  have hRightOut := nf_eq_fragment_readout_eq_termAtom hReadRight
  exact evalOp_eq_true_of_callGrounded prev outLeft outRight
    (by simp [hLeftOut, termAtom_resolveStates_init_world rawLeft])
    (by simp [hRightOut, termAtom_resolveStates_init_world rawRight])
    hcall

/-- Runtime `evalOp` bridge for successful grounded equality on two `nf`
fragment readouts in any state whose world is still the initial one. -/
theorem evalOp_nf_readouts_eq_true_state
    {sig : DIndGArtifactSig} {rawLeft rawRight : DIndGArtifactTerm}
    {outLeft outRight : Metta.Atom}
    (st : St) (prev : Stack)
    (hWorld : st.world = St.init.world)
    (hReadLeft : NfEqFragmentReadout sig rawLeft outLeft)
    (hReadRight : NfEqFragmentReadout sig rawRight outRight)
    (hcall :
      callGrounded stdGroundings "==" [outLeft, outRight] =
        ReduceResult.ok [mBool true]) :
    evalOp kernelCoreEnv st prev (mExpr "==" [outLeft, outRight]) [] =
      ([evalResult prev (mBool true) []], st) := by
  have hLeftOut := nf_eq_fragment_readout_eq_termAtom hReadLeft
  have hRightOut := nf_eq_fragment_readout_eq_termAtom hReadRight
  exact evalOp_eq_true_of_callGrounded_world_eq_init
    kernelCoreEnv st prev outLeft outRight (by rfl) hWorld
    (by
      have hstateLeft : resolveStates St.init.world outLeft = outLeft := by
        simpa [hLeftOut] using termAtom_resolveStates_init_world rawLeft
      simpa [hWorld] using hstateLeft)
    (by
      have hstateRight : resolveStates St.init.world outRight = outRight := by
        simpa [hRightOut] using termAtom_resolveStates_init_world rawRight
      simpa [hWorld] using hstateRight)
    hcall

/-- Scheduler-level lift of grounded equality on two `nf` fragment readouts. -/
theorem interpretStack1_eval_nf_readouts_eq_true
    {sig : DIndGArtifactSig} {rawLeft rawRight : DIndGArtifactTerm}
    {outLeft outRight : Metta.Atom}
    (fuel : Nat) (prev : Stack)
    (hReadLeft : NfEqFragmentReadout sig rawLeft outLeft)
    (hReadRight : NfEqFragmentReadout sig rawRight outRight)
    (hcall :
      callGrounded stdGroundings "==" [outLeft, outRight] =
        ReduceResult.ok [mBool true]) :
    interpretStack1 kernelCoreEnv fuel St.init
        { stack :=
            { atom := mExpr "eval" [mExpr "==" [outLeft, outRight]] } :: prev
          , bnd := [] } =
      ([evalResult prev (mBool true) []], St.init) := by
  simpa [mExpr, mSym] using
    (interpretStack1_eval_eq kernelCoreEnv fuel St.init prev
      (mExpr "==" [outLeft, outRight]) [])
      ▸ evalOp_nf_readouts_eq_true prev hReadLeft hReadRight hcall

/-- Scheduler-level lift of grounded equality on two `nf` fragment readouts in
any state whose world is still the initial one. -/
theorem interpretStack1_eval_nf_readouts_eq_true_state
    {sig : DIndGArtifactSig} {rawLeft rawRight : DIndGArtifactTerm}
    {outLeft outRight : Metta.Atom}
    (fuel : Nat) (st : St) (prev : Stack)
    (hWorld : st.world = St.init.world)
    (hReadLeft : NfEqFragmentReadout sig rawLeft outLeft)
    (hReadRight : NfEqFragmentReadout sig rawRight outRight)
    (hcall :
      callGrounded stdGroundings "==" [outLeft, outRight] =
        ReduceResult.ok [mBool true]) :
    interpretStack1 kernelCoreEnv fuel st
        { stack :=
            { atom := mExpr "eval" [mExpr "==" [outLeft, outRight]] } :: prev
          , bnd := [] } =
      ([evalResult prev (mBool true) []], st) := by
  simpa [mExpr, mSym] using
    (interpretStack1_eval_eq kernelCoreEnv fuel st prev
      (mExpr "==" [outLeft, outRight]) [])
      ▸ evalOp_nf_readouts_eq_true_state st prev hWorld hReadLeft hReadRight hcall

/-- Fuel-driver harvest of grounded equality on two `nf` fragment readouts.

This is the non-reflexive counterpart of
`interpretFuel_eval_termAtom_eq_self_true_contains`: once the control-flow
inversion exposes the final comparison frame, the executable scheduler harvests
the successful Boolean result. -/
theorem interpretFuel_eval_nf_readouts_eq_true_contains
    {sig : DIndGArtifactSig} {rawLeft rawRight : DIndGArtifactTerm}
    {outLeft outRight : Metta.Atom}
    (fuel : Nat)
    (hReadLeft : NfEqFragmentReadout sig rawLeft outLeft)
    (hReadRight : NfEqFragmentReadout sig rawRight outRight)
    (hcall :
      callGrounded stdGroundings "==" [outLeft, outRight] =
        ReduceResult.ok [mBool true]) :
    (mBool true, []) ∈
      (interpretFuel kernelCoreEnv (fuel + 1) St.init
        [evalItemNil (mExpr "==" [outLeft, outRight])] []).1 := by
  let it : Item := evalItemNil (mExpr "==" [outLeft, outRight])
  let out : Item := evalResult [] (mBool true) []
  have hmem : out ∈ (interpretStack1 kernelCoreEnv fuel St.init it).1 := by
    have hstep :
        (interpretStack1 kernelCoreEnv fuel St.init it).1 =
          [evalResult [] (mBool true) []] := by
      simpa [it, evalItemNil, atomToStack_eval, mExpr, mSym] using
        congrArg Prod.fst
          (interpretStack1_eval_nf_readouts_eq_true
            fuel [] hReadLeft hReadRight hcall)
    rw [hstep]
    simp [out]
  have hfinal : isFinal out = true := by
    simp [out, evalResult, finItem, isFinal, mBool]
  have hharvest :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelCoreEnv fuel St.init it out [] [] hmem hfinal (by
        simpa [out, finalPair, evalResult, finItem, mBool, Metta.instantiate_nil] using
          mBool_ne_empty true)
  simpa [it, out, evalItemNil, atomToStack_eval, finalPair, evalResult,
    finItem, mBool, Metta.instantiate_nil] using hharvest

/-- Fuel-driver harvest of grounded equality on two `nf` fragment readouts in
any state whose world is still the initial one. -/
theorem interpretFuel_eval_nf_readouts_eq_true_contains_state
    {sig : DIndGArtifactSig} {rawLeft rawRight : DIndGArtifactTerm}
    {outLeft outRight : Metta.Atom}
    (fuel : Nat) (st : St)
    (hWorld : st.world = St.init.world)
    (hReadLeft : NfEqFragmentReadout sig rawLeft outLeft)
    (hReadRight : NfEqFragmentReadout sig rawRight outRight)
    (hcall :
      callGrounded stdGroundings "==" [outLeft, outRight] =
        ReduceResult.ok [mBool true]) :
    (mBool true, []) ∈
      (interpretFuel kernelCoreEnv (fuel + 1) st
        [evalItemNil (mExpr "==" [outLeft, outRight])] []).1 := by
  let it : Item := evalItemNil (mExpr "==" [outLeft, outRight])
  let out : Item := evalResult [] (mBool true) []
  have hmem : out ∈ (interpretStack1 kernelCoreEnv fuel st it).1 := by
    have hstep :
        (interpretStack1 kernelCoreEnv fuel st it).1 =
          [evalResult [] (mBool true) []] := by
      simpa [it, evalItemNil, atomToStack_eval, mExpr, mSym] using
