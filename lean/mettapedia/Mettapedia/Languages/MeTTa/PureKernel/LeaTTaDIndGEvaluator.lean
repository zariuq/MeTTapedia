/-! ### Narrow infer-family helper slice

The full public `infer` recursion still goes through `infer-pi`, `infer-lam`, and
`infer-app`.  The smallest source rule that exercises the `infer` family while
reusing the discharged `nf` bridge is the IndG helper
`infer-apply-args ... ArgsNil`, whose RHS is exactly an `nf` query.
-/

def inferApplyArgsNilQuery (sig : DIndGArtifactSig)
    (rawType : DIndGArtifactTerm) : Metta.Atom :=
  mExpr "infer-apply-args" [sigAtom sig, ctxNilAtom, termAtom rawType, argsAtom []]

def ruleInferApplyArgsDecl : Metta.Atom :=
  mTypeDecl "infer-apply-args"
    [mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"]

private def inferApplyArgsNilRulePair : Metta.Atom × Metta.Atom :=
  ( mExpr "infer-apply-args" [mVar "sig", mVar "ctx", mVar "T", mSym "ArgsNil"]
  , mExpr "nf" [mVar "sig", mVar "T"] )

def ruleInferApplyArgsNil : Metta.Atom :=
  mExpr "=" [inferApplyArgsNilRulePair.1, inferApplyArgsNilRulePair.2]

def kernelInferApplyArgsNilRules : List Metta.Atom :=
  kernelCoreRules ++ [ruleInferApplyArgsDecl, ruleInferApplyArgsNil]

def kernelInferApplyArgsNilEnv : MinEnv :=
  MinEnv.ofAtomsGT kernelInferApplyArgsNilRules stdGroundings

/-! ### Next source-aligned IndG helper slice

The next helper that genuinely consumes `infer-apply-args` is
`infer-indg-params`.  We first certify only the `params = ArgsNil` source rule
and the subcall position it exposes; the surrounding `let`/`if` control-flow is
kept as an explicit boundary for the later full helper semantics.
-/

def inferIndgParamsArgsNilQuery (sig : DIndGArtifactSig) (name : DeclName)
    (motive : DIndGArtifactTerm)
    (cases : List (DeclName × DIndGArtifactTerm))
    (indices : DIndGArtifactArgs) (scrut : DIndGArtifactTerm)
    (ctors : List DIndGArtifactCtor) (rawT0 : DIndGArtifactTerm) : Metta.Atom :=
  mExpr "infer-indg-params"
    [ sigAtom sig
    , ctxNilAtom
    , declNameAtom name
    , argsAtom []
    , termAtom motive
    , casesAtom cases
    , argsAtom indices
    , termAtom scrut
    , ctorsAtom ctors
    , termAtom rawT0 ]

def inferIndgMotiveQuery (sig : DIndGArtifactSig)
    (motive : DIndGArtifactTerm)
    (cases : List (DeclName × DIndGArtifactTerm))
    (indices : DIndGArtifactArgs) (scrut : DIndGArtifactTerm)
    (ctors : List DIndGArtifactCtor) (typeAtom : Metta.Atom) : Metta.Atom :=
  mExpr "infer-indg-motive"
    [ sigAtom sig
    , ctxNilAtom
    , termAtom motive
    , casesAtom cases
    , argsAtom indices
    , termAtom scrut
    , ctorsAtom ctors
    , typeAtom ]

def inferIndgParamsArgsNilAfterApplyArgs (sig : DIndGArtifactSig)
    (motive : DIndGArtifactTerm)
    (cases : List (DeclName × DIndGArtifactTerm))
    (indices : DIndGArtifactArgs) (scrut : DIndGArtifactTerm)
    (ctors : List DIndGArtifactCtor) (typeAtom : Metta.Atom) : Metta.Atom :=
  mExpr "let"
    [ mVar "T1"
    , typeAtom
    , mExpr "if"
        [ mExpr "is-bad" [mVar "T1"]
        , mVar "T1"
        , inferIndgMotiveQuery sig motive cases indices scrut ctors (mVar "T1") ] ]

def inferIndgParamsArgsNilReadout (sig : DIndGArtifactSig)
    (motive : DIndGArtifactTerm)
    (cases : List (DeclName × DIndGArtifactTerm))
    (indices : DIndGArtifactArgs) (scrut : DIndGArtifactTerm)
    (ctors : List DIndGArtifactCtor) (rawT0 : DIndGArtifactTerm) : Metta.Atom :=
  inferIndgParamsArgsNilAfterApplyArgs sig motive cases indices scrut ctors
    (inferApplyArgsNilQuery sig rawT0)

def ruleInferIndgParamsDecl : Metta.Atom :=
  mTypeDecl "infer-indg-params"
    [ mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"
    , mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom", mSym "Atom"
    , mSym "Atom" ]

private def inferIndgParamsArgsNilRulePair : Metta.Atom × Metta.Atom :=
  ( mExpr "infer-indg-params"
      [ mVar "sig"
      , mVar "ctx"
      , mVar "name"
      , mSym "ArgsNil"
      , mVar "motive"
      , mVar "cases"
      , mVar "indices"
      , mVar "scrut"
      , mVar "ctors"
      , mVar "T0" ]
  , mExpr "let"
      [ mVar "T1"
      , mExpr "infer-apply-args" [mVar "sig", mVar "ctx", mVar "T0", mSym "ArgsNil"]
      , mExpr "if"
          [ mExpr "is-bad" [mVar "T1"]
          , mVar "T1"
          , mExpr "infer-indg-motive"
              [ mVar "sig"
              , mVar "ctx"
              , mVar "motive"
              , mVar "cases"
              , mVar "indices"
              , mVar "scrut"
              , mVar "ctors"
              , mVar "T1" ] ] ] )

def ruleInferIndgParamsArgsNil : Metta.Atom :=
  mExpr "=" [inferIndgParamsArgsNilRulePair.1, inferIndgParamsArgsNilRulePair.2]

def kernelInferIndgParamsArgsNilRules : List Metta.Atom :=
  kernelInferApplyArgsNilRules ++ [ruleInferIndgParamsDecl, ruleInferIndgParamsArgsNil]

/-- The public App dispatch rule from
`MettaKernel/kernel/kernel_signature_lf_indexed_lib_v0.metta`:
`(= (infer $sig $ctx (App $f $a)) (infer-app $sig $ctx $f $a))`.

It is kept in a separate slice until the recursive `infer-app`/`conv`/`subst`
support rules are linked to the declaration calculus. -/
def ruleInferAppDispatch : Metta.Atom :=
  mExpr "="
    [ mExpr "infer" [mVar "sig", mVar "ctx", mExpr "App" [mVar "f", mVar "a"]]
    , mExpr "infer-app" [mVar "sig", mVar "ctx", mVar "f", mVar "a"] ]

/-- Body of the recursive App inference rule from
`MettaKernel/kernel/kernel_signature_lf_indexed_lib_v0.metta`:
`(infer-app sig ctx f a)` normalizes the inferred function type, unifies it
with a Pi type, checks the argument by `conv`, and substitutes the argument into
the codomain. -/
def inferAppBodyRhs : Metta.Atom :=
  mExpr "let"
    [ mVar "tf"
    , mExpr "nf" [mVar "sig", mExpr "infer" [mVar "sig", mVar "ctx", mVar "f"]]
    , mExpr "unify"
        [ mVar "tf"
        , mExpr "Pi" [mVar "A", mVar "B"]
        , mExpr "if"
            [ mExpr "conv" [mVar "sig",
                mExpr "infer" [mVar "sig", mVar "ctx", mVar "a"], mVar "A"]
            , mExpr "subst" [mNat 0, mVar "a", mVar "B"]
            , mExpr "Bad" [mSym "arg-type-mismatch"] ]
        , mExpr "Bad" [mSym "applied-a-non-function"] ] ]

/-- The public recursive App inference rule from
`kernel_signature_lf_indexed_lib_v0.metta`. -/
def ruleInferAppBody : Metta.Atom :=
  mExpr "="
    [ mExpr "infer-app" [mVar "sig", mVar "ctx", mVar "f", mVar "a"]
    , inferAppBodyRhs ]

/-- A narrow rule slice adding only the public App dispatch rule. -/
def kernelAppDispatchRules : List Metta.Atom :=
  kernelCoreRules ++ [ruleInferAppDispatch]

/-- The App rule slice: core rules plus the public `infer-app` body and
`infer (App ...)` dispatch rules, in source order. -/
def kernelAppRules : List Metta.Atom :=
  kernelCoreRules ++ kernelSubstRules ++ [ruleInferAppBody, ruleInferAppDispatch]

/-- The body readout obtained by firing `ruleInferAppBody` on an encoded
artifact application. The rule-local variables `tf`, `A`, and `B` intentionally
remain variables here; they are bound by the subsequent `let`/`unify` steps. -/
def inferAppReadout (sig : DIndGArtifactSig)
    (rawFn rawArg : DIndGArtifactTerm) : Metta.Atom :=
  mExpr "let"
    [ mVar "tf"
    , mExpr "nf" [sigAtom sig, mExpr "infer" [sigAtom sig, ctxNilAtom, termAtom rawFn]]
    , mExpr "unify"
        [ mVar "tf"
        , mExpr "Pi" [mVar "A", mVar "B"]
        , mExpr "if"
            [ mExpr "conv" [sigAtom sig,
                mExpr "infer" [sigAtom sig, ctxNilAtom, termAtom rawArg], mVar "A"]
            , mExpr "subst" [mNat 0, termAtom rawArg, mVar "B"]
            , mExpr "Bad" [mSym "arg-type-mismatch"] ]
        , mExpr "Bad" [mSym "applied-a-non-function"] ] ]

/-- A pattern variable matched against a non-variable atom produces a value
binding.  The side condition matters: LeaTTa's matcher treats var/var as the
equality-ish special case instead. -/
private theorem match_var_nonvar_atom (v : String) (target : Metta.Atom)
    (h : ∀ w, target ≠ Metta.Atom.var w) :
    Metta.matchAtomsWith none (Metta.Atom.var v) target =
      [[Metta.BindingRel.val v target]] := by
  cases target with
  | var w => exact (h w rfl).elim
  | sym _ => simp [Metta.matchAtomsWith]
  | gnd _ => simp [Metta.matchAtomsWith]
  | expr _ => simp [Metta.matchAtomsWith]

private theorem match_var_distinct_var_atom (x y : String)
    (h : x ≠ y) :
    Metta.matchAtomsWith none (Metta.Atom.var x) (Metta.Atom.var y) =
      [[Metta.BindingRel.val x (Metta.Atom.var y)]] := by
  have hxy : (x == y) = false := by
    exact beq_eq_false_iff_ne.mpr h
  simp [Metta.matchAtomsWith, hxy]

/-- Encoded artifact terms are object-language atoms, never LeaTTa matcher
variables. -/
private theorem termAtom_not_var (raw : DIndGArtifactTerm) (v : String) :
    termAtom raw ≠ Metta.Atom.var v := by
  cases raw <;> simp [termAtom, mExpr]

private theorem termAtom_not_function_head
    (raw : DIndGArtifactTerm) (tail : List Metta.Atom) :
    termAtom raw ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail) := by
  cases raw <;> simp [termAtom, mExpr, mSym]

private theorem termAtom_beq_notReducible_false
    (raw : DIndGArtifactTerm) :
    (termAtom raw == notReducibleA) = false := by
  change Metta.Atom.beq (termAtom raw) notReducibleA = false
  cases raw <;>
    simp [termAtom, notReducibleA, mExpr, mSym, Metta.Atom.beq]

private theorem termAtom_beq_if_true_self_else_false
    (raw : DIndGArtifactTerm) (elseA : Metta.Atom) :
    (termAtom raw == mExpr "if" [mBool true, termAtom raw, elseA]) = false := by
  change Metta.Atom.beq (termAtom raw) (mExpr "if" [mBool true, termAtom raw, elseA]) = false
  cases raw <;>
    simp [termAtom, sortAtom, declNameAtom, mExpr, mSym, mBool,
      mNat, Metta.Atom.beq, Metta.Atom.beqList]

private theorem ctxNilAtom_not_var (v : String) :
    ctxNilAtom ≠ Metta.Atom.var v := by
  simp [ctxNilAtom, mSym]

private theorem mNat_not_var (n : Nat) (v : String) :
    mNat n ≠ Metta.Atom.var v := by
  simp [mNat]

private theorem mSym_not_var (s v : String) :
    mSym s ≠ Metta.Atom.var v := by
  simp [mSym]

private theorem sortAtom_not_var (sort : DIndGArtifactSort) (v : String) :
    sortAtom sort ≠ Metta.Atom.var v := by
  cases sort <;> simp [sortAtom, mSym]

private theorem declNameAtom_not_var
    (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName)
    (v : String) :
    declNameAtom name ≠ Metta.Atom.var v := by
  simp [declNameAtom, mSym]

private theorem argsAtom_not_var (args : DIndGArtifactArgs) (v : String) :
    argsAtom args ≠ Metta.Atom.var v := by
  cases args <;> simp [argsAtom, mExpr, mSym]

private theorem match_args_nil_atom :
    Metta.matchAtomsWith none (mSym "ArgsNil") (argsAtom []) = [[]] := by
  simp [argsAtom, mSym, Metta.matchAtomsWith]

private theorem casesAtom_not_var
    (cases : List (Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName ×
      DIndGArtifactTerm)) (v : String) :
    casesAtom cases ≠ Metta.Atom.var v := by
  cases cases <;> simp [casesAtom, mExpr, mSym]

private theorem ctorsAtom_not_var (ctors : List DIndGArtifactCtor) (v : String) :
    ctorsAtom ctors ≠ Metta.Atom.var v := by
  cases ctors <;> simp [ctorsAtom, mExpr, mSym]

/-- Encoded artifact signatures are object-language atoms, never LeaTTa matcher
variables. -/
private theorem sigAtom_not_var (sig : DIndGArtifactSig) (v : String) :
    sigAtom sig ≠ Metta.Atom.var v := by
  rcases sig with ⟨decls, _, _, _⟩
  induction decls with
  | nil => simp [sigAtom, mSym]
  | cons _ _ _ => simp [sigAtom, mExpr]

/-- The real kernel `conv` rule matches any encoded artifact conversion query.
This is the relation-level decomposition needed by the App body; it is not a
concrete interpreter trace. -/
theorem conv_rule_match
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.matchAtoms
      (mExpr "conv" [mVar "sig", mVar "x", mVar "y"])
      (convQuery sig rawLeft rawRight) =
    [[Metta.BindingRel.val "y" (termAtom rawRight),
      Metta.BindingRel.val "x" (termAtom rawLeft),
      Metta.BindingRel.val "sig" (sigAtom sig)]] := by
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, convQuery, mExpr, mSym, mVar]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "sig" (sigAtom sig) (sigAtom_not_var sig)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "x" (termAtom rawLeft) (termAtom_not_var rawLeft)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "y" (termAtom rawRight) (termAtom_not_var rawRight)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rfl

/-- Instantiating the kernel `conv` body with a matched artifact conversion
query exposes the two normalization subqueries and the structural equality test. -/
theorem conv_instantiate_bindings
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.instantiate
        [ Metta.BindingRel.val "y" (termAtom rawRight)
        , Metta.BindingRel.val "x" (termAtom rawLeft)
        , Metta.BindingRel.val "sig" (sigAtom sig) ]
        (mExpr "let"
          [ mVar "nx"
          , mExpr "nf" [mVar "sig", mVar "x"]
          , mExpr "let"
              [ mVar "ny"
              , mExpr "nf" [mVar "sig", mVar "y"]
              , mExpr "if"
                  [ mExpr "is-bad" [mVar "nx"]
                  , mBool false
                  , mExpr "if"
                      [ mExpr "is-bad" [mVar "ny"]
                      , mBool false
                      , mExpr "==" [mVar "nx", mVar "ny"] ] ] ] ]) =
      convReadout sig rawLeft rawRight := by
  simp [convReadout, Metta.instantiate, Metta.bindingsToSubst,
    Metta.Subst.apply, Metta.Subst.lookup, mExpr, mSym, mVar, mBool]

/-- MOPS fires the kernel `conv` rule for any encoded artifact conversion query.
This is the reusable `conv` sub-derivation that the App rule must later consume
through the declaration-level conversion soundness theorem. -/
theorem conv_mops_readout
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    convReadout sig rawLeft rawRight ∈
      Metta.equalityReductions ⟨kernelCoreRules⟩
        (convQuery sig rawLeft rawRight) := by
  rw [Metta.mem_equalityReductions]
  refine ⟨(mExpr "conv" [mVar "sig", mVar "x", mVar "y"],
      mExpr "let"
        [ mVar "nx"
        , mExpr "nf" [mVar "sig", mVar "x"]
        , mExpr "let"
            [ mVar "ny"
            , mExpr "nf" [mVar "sig", mVar "y"]
            , mExpr "if"
                [ mExpr "is-bad" [mVar "nx"]
                , mBool false
                , mExpr "if"
                    [ mExpr "is-bad" [mVar "ny"]
                    , mBool false
                    , mExpr "==" [mVar "nx", mVar "ny"] ] ] ] ]), ?_, ?_⟩
  · simp [Metta.Space.equalityRules, kernelCoreRules, runtimeDecls, ruleConv,
      ruleIsBad, ruleNfVar, ruleNfSrt, ruleNfCon, ruleNfBad, ruleInferSrtType,
      ruleInferSrtKind, ruleInferBad, mExpr, mSym, mVar, mTypeDecl, mBool]
  · refine ⟨[Metta.BindingRel.val "y" (termAtom rawRight),
        Metta.BindingRel.val "x" (termAtom rawLeft),
        Metta.BindingRel.val "sig" (sigAtom sig)], ?_, ?_⟩
    · rw [conv_rule_match]
      simp
    · simp [conv_instantiate_bindings]

/-- The kernel `conv` readout as a one-step MOPS proposition. -/
theorem conv_mops_step
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.MopsStep kernelCoreRules
      (convQuery sig rawLeft rawRight)
      (convReadout sig rawLeft rawRight) := by
  constructor
  · refine ⟨"conv", ?_⟩
    simp [Metta.Minimal.headKey, convQuery, mExpr, mSym]
  · exact conv_mops_readout sig rawLeft rawRight

/-- The same `conv` decomposition transported through LeaTTa's executable
kernel/MOPS correspondence. -/
theorem conv_kernel_step
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.KernelStep kernelCoreRules stdGroundings
      (convQuery sig rawLeft rawRight)
      (convReadout sig rawLeft rawRight) := by
  exact (Metta.kernelStep_iff_mopsStep (atoms := kernelCoreRules) (gt := stdGroundings)).2
    (conv_mops_step sig rawLeft rawRight)

/-! ### Control-flow slice for `conv` bodies

The full `conv` body uses three control constructs after the root `conv`
dispatch: stdlib `let`, stdlib `if`, and grounded `==`.  The parsed prelude is
too large to use as a proof-reduction target here, so this section names the
small explicit rule slice needed by the body and proves its relation-level
steps.  The lemmas stay at the certified step layer; they do not unfold a
concrete `interpretFuel` trace.

This slice is deliberately relation-facing.  The executable `kernelEnv` below
uses the same small control surface rather than loading the whole parsed
prelude, so the conv proof does not depend on unrelated stdlib bookkeeping.
-/

theorem is_bad_rule_match
    (a : Metta.Atom) (hA : ∀ w, a ≠ Metta.Atom.var w) :
    Metta.matchAtoms isBadRulePair.1 (mExpr "is-bad" [a]) =
      [[Metta.BindingRel.val "x" a]] := by
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, isBadRulePair, mExpr, mSym, mVar]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "x" a hA]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal]
  unfold Metta.matchAll
  rfl

private theorem fresh_is_bad_rule_match
    (counter : Nat) (a : Metta.Atom) (hA : ∀ w, a ≠ Metta.Atom.var w) :
    Metta.matchAtoms (freshenRule counter isBadRulePair.1 isBadRulePair.2).1
      (mExpr "is-bad" [a]) =
      [[Metta.BindingRel.val (counterSuffix counter "x") a]] := by
  rw [freshenRule_eq_renBy]
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, isBadRulePair, mExpr, mSym, mVar,
    Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge,
    Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom (counterSuffix counter "x") a hA]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal]
  unfold Metta.matchAll
  rfl

theorem is_bad_instantiate_bindings (a : Metta.Atom) :
    Metta.instantiate [Metta.BindingRel.val "x" a] isBadRulePair.2 =
      mExpr "unify" [a, mExpr "Bad" [mVar "e"], mBool true, mBool false] := by
  simp [isBadRulePair, Metta.instantiate, Metta.bindingsToSubst,
    Metta.Subst.apply, Metta.Subst.lookup, mExpr, mSym, mVar, mBool]

theorem if_true_rule_match
    (thenA elseA : Metta.Atom)
    (hThen : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElse : ∀ w, elseA ≠ Metta.Atom.var w) :
    Metta.matchAtoms ifTrueRulePair.1 (mExpr "if" [mBool true, thenA, elseA]) =
      [[Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]] := by
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, ifTrueRulePair, mExpr, mSym,
    mVar, mBool]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "t" thenA hThen]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "e" elseA hElse]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal]
  unfold Metta.matchAll
  rfl

theorem if_false_rule_match
    (thenA elseA : Metta.Atom)
    (hThen : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElse : ∀ w, elseA ≠ Metta.Atom.var w) :
    Metta.matchAtoms ifFalseRulePair.1 (mExpr "if" [mBool false, thenA, elseA]) =
