/-- A successful `Pi`/`Lam` argument row contains neither early-stop terminal.

The source arguments are `nfQuery` expressions, so a bare `Empty` result is
necessarily changed.  Thus the executable's `find? = none` witness rules out
both `Empty` and errors for each child. -/
private theorem nf_binary_readout_arg_find_none_nonterminal
    (sig : DIndGArtifactSig)
    (rawDomain rawBody : DIndGArtifactTerm)
    (domainOut bodyOut : Metta.Atom)
    (hNoErr :
      (([domainOut, bodyOut].zip
          [nfQuery sig rawDomain, nfQuery sig rawBody]).find?
        (fun ho : Metta.Atom × Metta.Atom =>
          (ho.1 == emptyA || ho.1.isError) && ho.1 != ho.2)) = none) :
    (domainOut == emptyA || domainOut.isError) = false ∧
      (bodyOut == emptyA || bodyOut.isError) = false := by
  have hErrors :=
    nf_binary_readout_arg_find_none_noerr
      sig rawDomain rawBody domainOut bodyOut hNoErr
  have hDomainEmpty : (domainOut == emptyA) = false := by
    cases hEmpty : (domainOut == emptyA) <;> simp
    have hEq : domainOut = emptyA := (beq_empty_eq_true_iff domainOut).mp hEmpty
    subst domainOut
    have hChanged : (emptyA != nfQuery sig rawDomain) = true := by
      rfl
    simp only [List.find?, List.zip_cons_cons, List.zip_nil_right] at hNoErr
    rw [show (emptyA == emptyA) = true by rfl,
      show emptyA.isError = false by rfl, hChanged] at hNoErr
    simp at hNoErr
  have hBodyEmpty : (bodyOut == emptyA) = false := by
    cases hEmpty : (bodyOut == emptyA) <;> simp
    have hEq : bodyOut = emptyA := (beq_empty_eq_true_iff bodyOut).mp hEmpty
    subst bodyOut
    have hChanged : (emptyA != nfQuery sig rawBody) = true := by
      rfl
    simp only [List.find?, List.zip_cons_cons, List.zip_nil_right] at hNoErr
    have hBodyStops :
        ((emptyA == emptyA || emptyA.isError) &&
          emptyA != nfQuery sig rawBody) = true := by
      rw [show (emptyA == emptyA) = true by rfl,
        show emptyA.isError = false by rfl, hChanged]
      rfl
    cases hLeft :
        ((domainOut == emptyA || domainOut.isError) &&
          domainOut != nfQuery sig rawDomain) <;>
      simp [hLeft, hBodyStops] at hNoErr
  exact ⟨Bool.or_eq_false_iff.mpr ⟨hDomainEmpty, hErrors.1⟩,
    Bool.or_eq_false_iff.mpr ⟨hBodyEmpty, hErrors.2⟩⟩

