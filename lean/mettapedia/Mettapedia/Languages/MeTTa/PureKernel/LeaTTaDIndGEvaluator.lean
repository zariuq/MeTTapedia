/-- Transport an ordinary `is-bad` equation through its exact all-`Atom`/`Bool` selected path. -/
theorem mettaEvalExpected_kernelDefControlEnv_is_bad_of_eval
    (fuel : Nat) (st : St) (a : Metta.Atom)
    (hTypes : KernelDefControlEnvTypeWorld st.world)
    {result : List (Metta.Atom × Metta.Bindings) × St}
    (hEval : mettaEval kernelDefControlEnv (fuel + 1) st []
      (mExpr "is-bad" [a]) = result) :
    mettaEvalExpected kernelDefControlEnv (fuel + 1) st []
      (mExpr "is-bad" [a]) (mSym "Bool") = result := by
  apply mettaEvalExpected_eq_of_atom_args_bool_eval
    kernelDefControlEnv fuel st "is-bad" [a]
  · simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.isBad
  · simpa [mExpr, mSym] using hEval

/-- A concrete Boolean `is-bad` result witnesses positive fuel, so its ordinary equation can be
transported to the exact expected-`Bool` path without exposing a predecessor at every caller. -/
theorem mettaEvalExpected_kernelDefControlEnv_is_bad_of_bool_eval
    (fuel : Nat) (st stOut : St) (a : Metta.Atom) (value : Bool)
    (hTypes : KernelDefControlEnvTypeWorld st.world)
    (hEval : mettaEval kernelDefControlEnv fuel st [] (mExpr "is-bad" [a]) =
      ([(mBool value, [])], stOut)) :
    mettaEvalExpected kernelDefControlEnv fuel st [] (mExpr "is-bad" [a])
        (mSym "Bool") =
      ([(mBool value, [])], stOut) := by
  cases fuel with
  | zero =>
      simp [mettaEval, mExpr, mSym, mBool, Metta.instantiate,
        Metta.Subst.apply] at hEval
  | succ fuel =>
      simpa [Nat.succ_eq_add_one] using
        mettaEvalExpected_kernelDefControlEnv_is_bad_of_eval
          fuel st a hTypes hEval

/-- Live-binding transport for a closed `is-bad` application.  The ordinary
and expected-`Bool` lanes select the same all-`Atom` arrow, operator-head
checking preserves the loop-free incoming theory, and the closed expression
is stable under the evaluator's second instantiation.  No claim is made that
an arbitrary noncanonical binding list is unchanged by unrelated projection:
the equality follows because both lanes consume the same computed seed list. -/
theorem mettaEvalExpected_kernelDefControlEnv_is_bad_of_eval_from
    (fuel : Nat) (st : St) (incoming : Metta.Bindings) (a : Metta.Atom)
    (hLoop : Metta.Bindings.hasLoop incoming = false)
    (hClosed : a.vars = [])
    (hTypes : KernelDefControlEnvTypeWorld st.world)
    {result : List (Metta.Atom × Metta.Bindings) × St}
    (hEval : mettaEval kernelDefControlEnv (fuel + 1) st incoming
      (mExpr "is-bad" [a]) = result) :
    mettaEvalExpected kernelDefControlEnv (fuel + 1) st incoming
      (mExpr "is-bad" [a]) (mSym "Bool") = result := by
  let plan := selectedApplicationExecutionPlan_atom_args_symbolic_return_from
    kernelDefControlEnv st.world "is-bad" "Bool" [a] incoming hLoop
      (by simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.isBad)
  have hExpressionClosed : (mExpr "is-bad" [a]).vars = [] := by
    simp [mExpr, mSym, Metta.Atom.vars, hClosed]
  have hStable :
      Metta.instantiate incoming (mExpr "is-bad" [a]) =
        mExpr "is-bad" [a] :=
    instantiate_eq_self_of_vars_nil incoming hExpressionClosed
  have hExpectedSelected :
      selectFunctionTypeForExpectedFrom kernelDefControlEnv st.world
          (.sym "is-bad") [a] (.sym "Bool") incoming =
        .selected plan.selected := by
    simpa [plan, mExpr, mSym] using
      (selectFunctionTypeForExpectedFrom_atom_args_bool_selected_from
        kernelDefControlEnv st.world "is-bad" [a] incoming hLoop
        (by simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.isBad))
  have hHead :
      mettaTypeCastAvoiding
          (expectedApplicationVisibleScope (mExpr "is-bad" [a]) (mSym "Bool"))
          kernelDefControlEnv st.world plan.selected.typeBindings
          (.sym "is-bad") plan.selected.functionType = .inr incoming := by
    simpa [plan, mExpr, mSym] using
      (mettaTypeCastAvoiding_symbolic_arrow_from
        (expectedApplicationVisibleScope (mExpr "is-bad" [a]) (mSym "Bool"))
        kernelDefControlEnv st.world incoming "is-bad" ["Atom", "Bool"] hLoop
        (by simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.isBad))
  have hSeeds :
      selectedApplicationInitialBindingsFromTheory incoming
          (mExpr "is-bad" [a]) (mSym "Bool") incoming = plan.seeds := by
    simp [plan, SelectedApplicationExecutionPlan.seeds,
      selectedApplicationInitialBindingsFromTheory,
      expectedApplicationVisibleScope, mExpr, mSym, Metta.Atom.vars,
      hClosed, restrictBnd_nil_vars]
  rw [← hEval]
  exact mettaEvalExpected_eq_mettaEval_of_same_selected_after_instantiate
    kernelDefControlEnv fuel st incoming (mExpr "is-bad" [a]) "is-bad" [a]
      (mSym "Bool") hStable hStable (by decide) (by decide)
      (by simp [Metta.Atom.isError]) plan hExpectedSelected incoming
      hHead hSeeds

