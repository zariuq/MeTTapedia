          (interpretStack1_eval_nf_readouts_eq_true_state
            fuel st [] hWorld hReadLeft hReadRight hcall)
    rw [hstep]
    simp [out]
  have hfinal : isFinal out = true := by
    simp [out, evalResult, finItem, isFinal, mBool]
  have hharvest :=
    mem_interpretFuel_cons_final_of_mem_interpretStack1
      kernelCoreEnv fuel st it out [] [] hmem hfinal (by
        simpa [out, finalPair, evalResult, finItem, mBool, Metta.instantiate_nil] using
          mBool_ne_empty true)
  simpa [it, out, evalItemNil, atomToStack_eval, finalPair, evalResult,
    finItem, mBool, Metta.instantiate_nil] using hharvest

/-- Exact executable `==` readout on two `nf` fragment outputs in the
stdlib-extended kernel environment. -/
theorem interpretFuel_kernelEnv_eval_nf_readouts_eq_true_eq_state
    {sig : DIndGArtifactSig} {rawLeft rawRight : DIndGArtifactTerm}
    {outLeft outRight : Metta.Atom}
    (fuel : Nat) (st : St)
    (hWorld : st.world = St.init.world)
    (hReadLeft : NfEqFragmentReadout sig rawLeft outLeft)
    (hReadRight : NfEqFragmentReadout sig rawRight outRight)
    (hcall :
      callGrounded stdGroundings "==" [outLeft, outRight] =
        ReduceResult.ok [mBool true]) :
    interpretFuel kernelEnv (fuel + 2) st
      [evalItemNil (mExpr "==" [outLeft, outRight])] [] =
      ([(mBool true, [])], st) := by
  let it : Item := evalItemNil (mExpr "==" [outLeft, outRight])
  have hstep :
      interpretStack1 kernelEnv (fuel + 1) st it =
        ([evalResult [] (mBool true) []], st) := by
    simpa [it, evalItemNil, atomToStack_eval, mExpr, mSym] using
      (interpretStack1_eval_eq kernelEnv (fuel + 1) st []
        (mExpr "==" [outLeft, outRight]) []) ▸
        (evalOp_eq_true_of_callGrounded_world_eq_init
          kernelEnv st [] outLeft outRight (by rfl) hWorld
          (by
            have hLeftOut := nf_eq_fragment_readout_eq_termAtom hReadLeft
            have hstateLeft : resolveStates St.init.world outLeft = outLeft := by
              simpa [hLeftOut] using termAtom_resolveStates_init_world rawLeft
            simpa [hWorld] using hstateLeft)
          (by
            have hRightOut := nf_eq_fragment_readout_eq_termAtom hReadRight
            have hstateRight : resolveStates St.init.world outRight = outRight := by
              simpa [hRightOut] using termAtom_resolveStates_init_world rawRight
            simpa [hWorld] using hstateRight)
          hcall)
  rw [interpretFuel_cons_step_eq]
  simp [it, hstep, evalResult, finItem, isFinal, finalPair, mBool]
  rw [interpretFuel_done]
  simp [interpretFuel, Metta.instantiate_nil]

/-- Encoded artifact terms are injective on the name-free `nf` fragment.

The excluded `Con`/`Def` cases encode Lean declaration names through
`Lean.Name.toString`; the full injectivity theorem for those cases must either
prove that string encoding faithful on the admitted signature, or carry an
explicit name-encoding invariant. -/
theorem termAtom_injective_on_nf_eq_fragment_nameFree
    {rawL rawR : DIndGArtifactTerm}
    (hL : NfEqFragmentTermNameFree rawL)
    (hR : NfEqFragmentTermNameFree rawR)
    (hEq : termAtom rawL = termAtom rawR) : rawL = rawR := by
  induction hL generalizing rawR with
  | var k =>
      cases hR <;> simp [termAtom, mExpr, mSym, mNat, sortAtom] at hEq ⊢
      exact hEq
  | srt sort =>
      cases sort
      · cases hR <;> try (rename_i sortR; cases sortR) <;>
          simp [termAtom, mExpr, mSym, mNat, sortAtom] at hEq ⊢
      · cases hR <;> try (rename_i sortR; cases sortR) <;>
          simp [termAtom, mExpr, mSym, mNat, sortAtom] at hEq ⊢
  | bad reason =>
      cases hR <;> simp [termAtom, mExpr, mSym, mNat, sortAtom] at hEq ⊢
      exact hEq
  | pi hDomain hBody ihDomain ihBody =>
      cases hR <;> simp [termAtom, mExpr, mSym, mNat, sortAtom] at hEq ⊢
      rename_i rawDomain rawBody hDomainR hBodyR
      rcases hEq with ⟨hDomainEq, hBodyEq⟩
      exact ⟨ihDomain hDomainR hDomainEq, ihBody hBodyR hBodyEq⟩
  | lam hDomain hBody ihDomain ihBody =>
      cases hR <;> simp [termAtom, mExpr, mSym, mNat, sortAtom] at hEq ⊢
      rename_i rawDomain rawBody hDomainR hBodyR
      rcases hEq with ⟨hDomainEq, hBodyEq⟩
      exact ⟨ihDomain hDomainR hDomainEq, ihBody hBodyR hBodyEq⟩

/-- Encoded artifact terms are also injective on the name-free `nf` fragment
through LeaTTa's structural `BEq`.

This is the exact shape produced by the grounded `==` operation after
`callGrounded_eq_true_implies_beq_true` has inverted a successful Boolean
readout.  It avoids any global `LawfulBEq Atom` assumption, which is false for
host-float grounded payloads; the name-free kernel encoding only uses symbols
and integer indices, so the needed inversion is structural. -/
theorem termAtom_beq_injective_on_nf_eq_fragment_nameFree
    {rawL rawR : DIndGArtifactTerm}
    (hL : NfEqFragmentTermNameFree rawL)
    (hR : NfEqFragmentTermNameFree rawR)
    (hEq : (termAtom rawL == termAtom rawR) = true) : rawL = rawR := by
  change Metta.Atom.beq (termAtom rawL) (termAtom rawR) = true at hEq
  induction hL generalizing rawR with
  | var k =>
      cases hR with
      | var l =>
          exact congrArg DIndGArtifactTerm.var (termAtom_var_beq_true hEq)
      | srt sort =>
          cases sort <;>
            exact False.elim (termAtom_head_contra (tagL := "Var") (tagR := "Srt")
              (by decide) (by simpa [termAtom, sortAtom, mExpr, mSym, mNat] using hEq))
      | bad reason =>
          exact False.elim (termAtom_head_contra (tagL := "Var") (tagR := "Bad")
            (by decide) (by simpa [termAtom, mExpr, mSym, mNat] using hEq))
      | pi _ _ =>
          exact False.elim (termAtom_head_contra (tagL := "Var") (tagR := "Pi")
            (by decide) (by simpa [termAtom, mExpr, mSym, mNat] using hEq))
      | lam _ _ =>
          exact False.elim (termAtom_head_contra (tagL := "Var") (tagR := "Lam")
            (by decide) (by simpa [termAtom, mExpr, mSym, mNat] using hEq))
  | srt sort =>
      cases hR with
      | var k =>
          cases sort <;>
            exact False.elim (termAtom_head_contra (tagL := "Srt") (tagR := "Var")
              (by decide) (by simpa [termAtom, sortAtom, mExpr, mSym, mNat] using hEq))
      | srt sortR =>
          exact congrArg DIndGArtifactTerm.srt (termAtom_srt_beq_true hEq)
      | bad reason =>
          cases sort <;>
            exact False.elim (termAtom_head_contra (tagL := "Srt") (tagR := "Bad")
              (by decide) (by simpa [termAtom, sortAtom, mExpr, mSym] using hEq))
      | pi _ _ =>
          cases sort <;>
            exact False.elim (termAtom_head_contra (tagL := "Srt") (tagR := "Pi")
              (by decide) (by simpa [termAtom, sortAtom, mExpr, mSym] using hEq))
      | lam _ _ =>
          cases sort <;>
            exact False.elim (termAtom_head_contra (tagL := "Srt") (tagR := "Lam")
              (by decide) (by simpa [termAtom, sortAtom, mExpr, mSym] using hEq))
  | bad reason =>
      cases hR with
      | bad reasonR =>
          exact congrArg DIndGArtifactTerm.bad (termAtom_bad_beq_true hEq)
      | var k =>
          exact False.elim (termAtom_head_contra (tagL := "Bad") (tagR := "Var")
            (by decide) (by simpa [termAtom, mExpr, mSym, mNat] using hEq))
      | srt sort =>
          cases sort <;>
            exact False.elim (termAtom_head_contra (tagL := "Bad") (tagR := "Srt")
              (by decide) (by simpa [termAtom, sortAtom, mExpr, mSym] using hEq))
      | pi _ _ =>
          exact False.elim (termAtom_head_contra (tagL := "Bad") (tagR := "Pi")
            (by decide) (by simpa [termAtom, mExpr, mSym] using hEq))
      | lam _ _ =>
          exact False.elim (termAtom_head_contra (tagL := "Bad") (tagR := "Lam")
            (by decide) (by simpa [termAtom, mExpr, mSym] using hEq))
  | pi hDomain hBody ihDomain ihBody =>
      cases hR with
      | pi hDomainR hBodyR =>
          have hp := atom_beq_expr_binary_payload_true (tag := "Pi")
            (a := termAtom _) (b := termAtom _) (c := termAtom _) (d := termAtom _) (by
              simpa [termAtom, mExpr, mSym] using hEq)
          have hdeq := ihDomain hDomainR hp.1
          have hbeq := ihBody hBodyR hp.2
          cases hdeq
          cases hbeq
          rfl
      | var k =>
          exact False.elim (termAtom_head_contra (tagL := "Pi") (tagR := "Var")
            (by decide) (by simpa [termAtom, mExpr, mSym, mNat] using hEq))
      | srt sort =>
          cases sort <;>
            exact False.elim (termAtom_head_contra (tagL := "Pi") (tagR := "Srt")
              (by decide) (by simpa [termAtom, sortAtom, mExpr, mSym] using hEq))
      | bad reason =>
          exact False.elim (termAtom_head_contra (tagL := "Pi") (tagR := "Bad")
            (by decide) (by simpa [termAtom, mExpr, mSym] using hEq))
      | lam _ _ =>
          exact False.elim (termAtom_head_contra (tagL := "Pi") (tagR := "Lam")
            (by decide) (by simpa [termAtom, mExpr, mSym] using hEq))
  | lam hDomain hBody ihDomain ihBody =>
      cases hR with
      | lam hDomainR hBodyR =>
          have hp := atom_beq_expr_binary_payload_true (tag := "Lam")
            (a := termAtom _) (b := termAtom _) (c := termAtom _) (d := termAtom _) (by
              simpa [termAtom, mExpr, mSym] using hEq)
          have hdeq := ihDomain hDomainR hp.1
          have hbeq := ihBody hBodyR hp.2
          cases hdeq
          cases hbeq
          rfl
      | var k =>
          exact False.elim (termAtom_head_contra (tagL := "Lam") (tagR := "Var")
            (by decide) (by simpa [termAtom, mExpr, mSym, mNat] using hEq))
      | srt sort =>
          cases sort <;>
            exact False.elim (termAtom_head_contra (tagL := "Lam") (tagR := "Srt")
              (by decide) (by simpa [termAtom, sortAtom, mExpr, mSym] using hEq))
      | bad reason =>
          exact False.elim (termAtom_head_contra (tagL := "Lam") (tagR := "Bad")
            (by decide) (by simpa [termAtom, mExpr, mSym] using hEq))
      | pi _ _ =>
          exact False.elim (termAtom_head_contra (tagL := "Lam") (tagR := "Pi")
            (by decide) (by simpa [termAtom, mExpr, mSym] using hEq))

/-- Stage-3 resolved `nf` terms whose equality readout does not need
declaration-name payload injectivity.

This keeps the witness `Def` delta readout available while leaving `Con` names
behind the explicit `Lean.Name.toString` seam. -/
inductive CicStage3NoConResolvedNfTerm : DIndGArtifactTerm → Prop
  | var (k : Nat) : CicStage3NoConResolvedNfTerm (.var k)
  | srt (sort : DIndGArtifactSort) :
      CicStage3NoConResolvedNfTerm (.srt sort)
  | witnessDefn :
      CicStage3NoConResolvedNfTerm (.defn cicStage3PropToType0WitnessName)
  | bad (reason : String) :
      CicStage3NoConResolvedNfTerm (.bad reason)
  | pi {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : CicStage3NoConResolvedNfTerm rawDomain)
      (hBody : CicStage3NoConResolvedNfTerm rawBody) :
      CicStage3NoConResolvedNfTerm (.pi rawDomain rawBody)
  | lam {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : CicStage3NoConResolvedNfTerm rawDomain)
      (hBody : CicStage3NoConResolvedNfTerm rawBody) :
      CicStage3NoConResolvedNfTerm (.lam rawDomain rawBody)

theorem cicStage3_no_con_resolved_nf_to_resolved
    {raw : DIndGArtifactTerm}
    (h : CicStage3NoConResolvedNfTerm raw) :
    CicStage3ResolvedNfTerm raw := by
  induction h with
  | var k =>
      exact CicStage3ResolvedNfTerm.var k
  | srt sort =>
      exact CicStage3ResolvedNfTerm.srt sort
  | witnessDefn =>
      exact CicStage3ResolvedNfTerm.witnessDefn
  | bad reason =>
      exact CicStage3ResolvedNfTerm.bad reason
  | pi hDomain hBody ihDomain ihBody =>
      exact CicStage3ResolvedNfTerm.pi ihDomain ihBody
  | lam hDomain hBody ihDomain ihBody =>
      exact CicStage3ResolvedNfTerm.lam ihDomain ihBody

theorem cicStage3_no_con_resolved_nf_decl_target_exists
    {n : Nat} {raw : DIndGArtifactTerm} {term : PureTm n}
    (hResolved : CicStage3NoConResolvedNfTerm raw)
    (hTrans :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness n raw term) :
    ∃ target : PureTm n,
      CicStage3ResolvedNfDeclTarget n raw target ∧
        RedStarDecl
          (envOfSpecs
            cicStage3RawArtifactSigWithPropToType0Witness.translatedSpecs)
          term target := by
  exact cicStage3_resolved_nf_decl_target_exists
    (cicStage3_no_con_resolved_nf_to_resolved hResolved) hTrans

theorem cicStage3_no_con_resolved_nf_decl_target_conv_exists
    {n : Nat} {raw : DIndGArtifactTerm} {term : PureTm n}
    (hResolved : CicStage3NoConResolvedNfTerm raw)
    (hTrans :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness n raw term) :
    ∃ target : PureTm n,
      CicStage3ResolvedNfDeclTarget n raw target ∧
        ConvDecl
          (envOfSpecs
            cicStage3RawArtifactSigWithPropToType0Witness.translatedSpecs)
          term target := by
  rcases cicStage3_no_con_resolved_nf_decl_target_exists hResolved hTrans with
    ⟨target, hTarget, hRed⟩
  exact ⟨target, hTarget, redStarDecl_implies_conv hRed⟩

theorem cicStage3_no_con_resolved_nf_decl_target_unique
    {n : Nat} {raw : DIndGArtifactTerm} {target₁ target₂ : PureTm n}
    (hResolved : CicStage3NoConResolvedNfTerm raw)
    (hTarget₁ : CicStage3ResolvedNfDeclTarget n raw target₁)
    (hTarget₂ : CicStage3ResolvedNfDeclTarget n raw target₂) :
    target₁ = target₂ := by
  induction hResolved generalizing n target₁ target₂ with
  | var k =>
      cases hTarget₁
      cases hTarget₂
      simp
  | srt sort =>
      cases sort <;> cases hTarget₁ <;> cases hTarget₂ <;> rfl
  | witnessDefn =>
      cases hTarget₁
      cases hTarget₂
      rfl
  | bad reason =>
      cases hTarget₁
  | pi hDomain hBody ihDomain ihBody =>
      cases hTarget₁ with
      | pi hDomain₁ hBody₁ =>
          cases hTarget₂ with
          | pi hDomain₂ hBody₂ =>
              have hDomainEq := ihDomain hDomain₁ hDomain₂
              have hBodyEq := ihBody hBody₁ hBody₂
              simp [hDomainEq, hBodyEq]
  | lam hDomain hBody ihDomain ihBody =>
      cases hTarget₁ with
      | lam hBody₁ =>
          cases hTarget₂ with
          | lam hBody₂ =>
              have hBodyEq := ihBody hBody₁ hBody₂
              simp [hBodyEq]

theorem cicStage3_no_con_resolved_decl_conv_of_common_target
    {rawLeft rawRight : DIndGArtifactTerm}
    {left right : PureTm 0}
    (hLeftResolved : CicStage3NoConResolvedNfTerm rawLeft)
    (hRightResolved : CicStage3NoConResolvedNfTerm rawRight)
    (hLeft :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness 0 rawLeft left)
    (hRight :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness 0 rawRight right)
    (hCommon :
      ∃ target : PureTm 0,
        CicStage3ResolvedNfDeclTarget 0 rawLeft target ∧
          CicStage3ResolvedNfDeclTarget 0 rawRight target) :
    ConvDecl
      (envOfSpecs
        cicStage3RawArtifactSigWithPropToType0Witness.translatedSpecs)
      left right := by
  rcases hCommon with ⟨target, hLeftTarget, hRightTarget⟩
  rcases cicStage3_no_con_resolved_nf_decl_target_exists hLeftResolved hLeft with
    ⟨leftTarget, hLeftTarget', hLeftRed⟩
  rcases cicStage3_no_con_resolved_nf_decl_target_exists hRightResolved hRight with
    ⟨rightTarget, hRightTarget', hRightRed⟩
  have hLeftTargetEq : leftTarget = target :=
    cicStage3_no_con_resolved_nf_decl_target_unique
      hLeftResolved hLeftTarget' hLeftTarget
  have hRightTargetEq : rightTarget = target :=
    cicStage3_no_con_resolved_nf_decl_target_unique
      hRightResolved hRightTarget' hRightTarget
  subst leftTarget
  subst rightTarget
  exact convDecl_of_common_reduct hLeftRed hRightRed

theorem cicStage3RawIdentityWitness_no_con_resolved_nf_term :
    CicStage3NoConResolvedNfTerm cicStage3RawIdentityWitness := by
  simpa [cicStage3RawIdentityWitness] using
    (CicStage3NoConResolvedNfTerm.lam
      (CicStage3NoConResolvedNfTerm.srt .type)
      (CicStage3NoConResolvedNfTerm.lam
        (CicStage3NoConResolvedNfTerm.srt .type)
        (CicStage3NoConResolvedNfTerm.var 0)))

theorem cicStage3RawPropToType0WitnessDefn_no_con_resolved_nf_term :
    CicStage3NoConResolvedNfTerm
      (.defn cicStage3PropToType0WitnessName) := by
  exact CicStage3NoConResolvedNfTerm.witnessDefn

/-- Non-`Bad` no-`Con` Stage-3 resolved terms do not match the `is-bad`
witness pattern. -/
theorem termAtom_not_match_bad_pattern_no_con_resolved
    {raw : DIndGArtifactTerm}
    (badVar : String)
    (hResolved : CicStage3NoConResolvedNfTerm raw)
    (hNotBad : ∀ reason, raw ≠ .bad reason) :
    Metta.matchAtoms (termAtom raw) (mExpr "Bad" [mVar badVar]) = [] := by
  induction hResolved with
  | var k =>
      simp [termAtom, mExpr, mSym, mVar, mNat, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]
  | srt sort =>
      cases sort <;>
        simp [termAtom, sortAtom, mExpr, mSym, mVar, Metta.matchAtoms,
          Metta.matchAtomsWith, Metta.matchAll]
  | witnessDefn =>
      simp [termAtom, declNameAtom, mExpr, mSym, mVar, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]
  | bad reason =>
      exact False.elim (hNotBad reason rfl)
  | pi hDomain hBody ihDomain ihBody =>
      simp [termAtom, mExpr, mSym, mVar, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]
  | lam hDomain hBody ihDomain ihBody =>
      simp [termAtom, mExpr, mSym, mVar, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]

theorem termAtom_not_match_bad_pattern_resolved
    {raw : DIndGArtifactTerm}
    (badVar : String)
    (hResolved : CicStage3ResolvedNfTerm raw)
    (hNotBad : ∀ reason, raw ≠ .bad reason) :
    Metta.matchAtoms (termAtom raw) (mExpr "Bad" [mVar badVar]) = [] := by
  induction hResolved with
  | var k =>
      simp [termAtom, mExpr, mSym, mVar, mNat, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]
  | srt sort =>
      cases sort <;>
        simp [termAtom, sortAtom, mExpr, mSym, mVar, Metta.matchAtoms,
          Metta.matchAtomsWith, Metta.matchAll]
  | con hName =>
      simp [termAtom, declNameAtom, mExpr, mSym, mVar, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]
  | witnessDefn =>
      simp [termAtom, declNameAtom, mExpr, mSym, mVar, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]
  | bad reason =>
      exact False.elim (hNotBad reason rfl)
  | pi hDomain hBody ihDomain ihBody =>
      simp [termAtom, mExpr, mSym, mVar, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]
  | lam hDomain hBody ihDomain ihBody =>
      simp [termAtom, mExpr, mSym, mVar, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]

theorem cicStage3_resolved_nf_runtime_output_not_bad_output
    {raw rawNf : DIndGArtifactTerm}
    (hOut : CicStage3ResolvedNfRuntimeOutput raw rawNf)
    (hNotBad : ∀ reason, raw ≠ .bad reason) :
    ∀ reason, rawNf ≠ .bad reason := by
  cases hOut with
  | var k =>
      intro reason hEq
      cases hEq
  | srt sort =>
      intro reason hEq
      cases hEq
  | con hName =>
      intro reason hEq
      cases hEq
  | witnessDefn =>
      intro reason hEq
      cases hEq
  | bad inputReason =>
      intro reason hEq
      cases hEq
      exact hNotBad inputReason rfl
  | pi hDomain hBody =>
      intro reason hEq
      cases hEq
  | lam hDomain hBody =>
      intro reason hEq
      cases hEq

theorem CicStage3NfRuntimeReadout_not_match_bad_pattern
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {out : Metta.Atom}
    (badVar : String)
    (h : CicStage3NfRuntimeReadout sig raw out)
    (hNotBad : ∀ reason, raw ≠ .bad reason) :
    Metta.matchAtoms out (mExpr "Bad" [mVar badVar]) = [] := by
  cases h with
  | resolved hOut =>
      exact
        termAtom_not_match_bad_pattern_resolved badVar
          (cicStage3_resolved_nf_runtime_output_resolved hOut)
          (cicStage3_resolved_nf_runtime_output_not_bad_output
            hOut hNotBad)
  | defnStuck hName hNotWitness hBodyClosed hBodyNoErr =>
      simp [mExpr, mSym, mVar, Metta.matchAtoms, Metta.matchAtomsWith,
        Metta.matchAll]
  | appStuck hFn hArg =>
      simp [nfQuery, mExpr, mSym, mVar, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]
  | indGStuck hFamily =>
      simp [nfQuery, mExpr, mSym, mVar, Metta.matchAtoms,
        Metta.matchAtomsWith, Metta.matchAll]
  | pi hDomain hBody =>
      simp [mExpr, mSym, mVar, Metta.matchAtoms, Metta.matchAtomsWith,
        Metta.matchAll]
  | lam hDomain hBody =>
      simp [mExpr, mSym, mVar, Metta.matchAtoms, Metta.matchAtomsWith,
        Metta.matchAll]

theorem CicStage3CanonicalNfRuntimeReadout_not_match_bad_pattern
    {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (badVar : String)
    (h : CicStage3CanonicalNfRuntimeReadout raw out)
    (hNotBad : ∀ reason, raw ≠ .bad reason) :
    Metta.matchAtoms out (mExpr "Bad" [mVar badVar]) = [] := by
  exact
    CicStage3NfRuntimeReadout_not_match_bad_pattern badVar
      (CicStage3CanonicalNfRuntimeReadout.toRuntimeReadout h)
      hNotBad

theorem nfQuery_beq_self_true (sig : DIndGArtifactSig)
    (raw : DIndGArtifactTerm) :
    (nfQuery sig raw == nfQuery sig raw) = true := by
  have hSig := sigAtom_beq_self_true sig
  have hTerm := termAtom_beq_self_true raw
  change Metta.Atom.beq (nfQuery sig raw) (nfQuery sig raw) = true
  change Metta.Atom.beq (sigAtom sig) (sigAtom sig) = true at hSig
  change Metta.Atom.beq (termAtom raw) (termAtom raw) = true at hTerm
  simp [nfQuery, mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
    hSig, hTerm]

theorem nfQuery_vars_nil (sig : DIndGArtifactSig)
    (raw : DIndGArtifactTerm) :
    (nfQuery sig raw).vars = [] := by
  simp [nfQuery, sigAtom_vars_nil, termAtom_vars_nil, mExpr, mSym,
    Metta.Atom.vars]

theorem nfQuery_isError_false (sig : DIndGArtifactSig)
    (raw : DIndGArtifactTerm) :
    (nfQuery sig raw).isError = false := by
  simp [nfQuery, mExpr, mSym, Metta.Atom.isError]

theorem nfQuery_not_var (sig : DIndGArtifactSig)
    (raw : DIndGArtifactTerm) :
    ∀ v, nfQuery sig raw ≠ Metta.Atom.var v := by
  intro v
  simp [nfQuery, mExpr, mSym]

theorem nfQuery_not_match_bad_pattern (sig : DIndGArtifactSig)
    (raw : DIndGArtifactTerm) (badVar : String) :
    Metta.matchAtoms (nfQuery sig raw) (mExpr "Bad" [mVar badVar]) = [] := by
  simp [nfQuery, mExpr, mSym, mVar, Metta.matchAtoms,
    Metta.matchAtomsWith, Metta.matchAll]

theorem nfQuery_resolveStates_init_world (sig : DIndGArtifactSig)
    (raw : DIndGArtifactTerm) :
    resolveStates St.init.world (nfQuery sig raw) = nfQuery sig raw := by
  simp [nfQuery, mExpr, mSym, resolveStates]
  exact ⟨by simpa [St.init, World.empty] using sigAtom_resolveStates_init_world sig,
    by simpa [St.init, World.empty] using termAtom_resolveStates_init_world raw⟩

private theorem cicStage3NonWitnessDefnStuckReadout_beq_self_true
    (name : DeclName) :
    (cicStage3NonWitnessDefnStuckReadout name ==
      cicStage3NonWitnessDefnStuckReadout name) = true := by
  have hOuter := sigAtom_beq_self_true
    cicStage3RawArtifactSigWithPropToType0Witness
  have hInnerSig := sigAtom_beq_self_true cicStage3RawArtifactSig
  have hName := declNameAtom_beq_self_true name
  change Metta.Atom.beq (cicStage3NonWitnessDefnStuckReadout name)
    (cicStage3NonWitnessDefnStuckReadout name) = true
  change Metta.Atom.beq
    (sigAtom cicStage3RawArtifactSigWithPropToType0Witness)
    (sigAtom cicStage3RawArtifactSigWithPropToType0Witness) = true at hOuter
  change Metta.Atom.beq (sigAtom cicStage3RawArtifactSig)
    (sigAtom cicStage3RawArtifactSig) = true at hInnerSig
  change Metta.Atom.beq (declNameAtom name) (declNameAtom name) = true at hName
  simp [cicStage3NonWitnessDefnStuckReadout, defBodyOfQueryAtom,
    mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
    hOuter, hInnerSig, hName]

private theorem cicStage3NonWitnessDefnStuckReadout_resolveStates_init_world
    (name : DeclName) :
    resolveStates St.init.world
        (cicStage3NonWitnessDefnStuckReadout name) =
      cicStage3NonWitnessDefnStuckReadout name := by
  simp [cicStage3NonWitnessDefnStuckReadout, defBodyOfQueryAtom,
    mExpr, mSym, resolveStates]
  exact
    ⟨by
      simpa [St.init, World.empty] using
        sigAtom_resolveStates_init_world
          cicStage3RawArtifactSigWithPropToType0Witness,
     by
      exact
        ⟨by
          simpa [St.init, World.empty] using
            sigAtom_resolveStates_init_world cicStage3RawArtifactSig,
         by
          simpa [St.init, World.empty] using
            declNameAtom_resolveStates_init_world name⟩⟩

theorem CicStage3CanonicalNfRuntimeReadout_beq_self_true
    {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadout raw out) :
    (out == out) = true := by
  induction h with
  | resolved hOut =>
      exact termAtom_beq_self_true _
  | defnStuck hName hNotWitness =>
      exact cicStage3NonWitnessDefnStuckReadout_beq_self_true _
  | appStuck hFn hArg =>
      exact nfQuery_beq_self_true
        cicStage3RawArtifactSigWithPropToType0Witness _
  | indGStuck hFamily =>
      exact nfQuery_beq_self_true
        cicStage3RawArtifactSigWithPropToType0Witness _
  | pi hDomain hBody ihDomain ihBody =>
      change Metta.Atom.beq (mExpr "Pi" [_, _]) (mExpr "Pi" [_, _]) = true
      change Metta.Atom.beq _ _ = true at ihDomain
      change Metta.Atom.beq _ _ = true at ihBody
      simp [mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
        ihDomain, ihBody]
  | lam hDomain hBody ihDomain ihBody =>
      change Metta.Atom.beq (mExpr "Lam" [_, _]) (mExpr "Lam" [_, _]) = true
      change Metta.Atom.beq _ _ = true at ihDomain
      change Metta.Atom.beq _ _ = true at ihBody
      simp [mExpr, mSym, Metta.Atom.beq, Metta.Atom.beqList,
        ihDomain, ihBody]

theorem CicStage3CanonicalNfRuntimeReadout_resolveStates_init_world
    {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadout raw out) :
    resolveStates St.init.world out = out := by
  induction h with
  | resolved hOut =>
      exact termAtom_resolveStates_init_world _
  | defnStuck hName hNotWitness =>
      exact cicStage3NonWitnessDefnStuckReadout_resolveStates_init_world _
  | appStuck hFn hArg =>
      exact nfQuery_resolveStates_init_world
        cicStage3RawArtifactSigWithPropToType0Witness _
  | indGStuck hFamily =>
      exact nfQuery_resolveStates_init_world
        cicStage3RawArtifactSigWithPropToType0Witness _
  | pi hDomain hBody ihDomain ihBody =>
      simp [mExpr, mSym, resolveStates]
      exact ⟨by simpa [St.init, World.empty] using ihDomain,
        by simpa [St.init, World.empty] using ihBody⟩
  | lam hDomain hBody ihDomain ihBody =>
      simp [mExpr, mSym, resolveStates]
      exact ⟨by simpa [St.init, World.empty] using ihDomain,
        by simpa [St.init, World.empty] using ihBody⟩

def cicStage3CanonicalDefnStuckReadoutForSig
    (sig : DIndGArtifactSig) (name : DeclName) : Metta.Atom :=
  mExpr "nf"
    [ sigAtom sig
    , defBodyOfQueryAtom (sigAtom sig) (declNameAtom name) ]

/-- Signature-parameterized canonical `nf` readouts. This keeps the old
witness-signature canonical relation intact while giving the primary signature
the same pinned stuck-frontier shape. -/
inductive CicStage3CanonicalNfRuntimeReadoutForSig
    (sig : DIndGArtifactSig) :
    DIndGArtifactTerm → Metta.Atom → Prop where
  | resolved {raw rawNf : DIndGArtifactTerm}
      (hOut : CicStage3ResolvedNfRuntimeOutput raw rawNf) :
      CicStage3CanonicalNfRuntimeReadoutForSig sig raw (termAtom rawNf)
  | defnStuck {name : DeclName}
      (hName : cicStage3RawNameWithPropToType0WitnessBounded name)
      (hNotWitness : name ≠ cicStage3PropToType0WitnessName) :
      CicStage3CanonicalNfRuntimeReadoutForSig sig (.defn name)
        (cicStage3CanonicalDefnStuckReadoutForSig sig name)
  | appStuck {fn arg : DIndGArtifactTerm}
      (hFn : CicStage3RawTermTranslationVisibleNamesBounded fn)
      (hArg : CicStage3RawTermTranslationVisibleNamesBounded arg) :
      CicStage3CanonicalNfRuntimeReadoutForSig sig (.app fn arg)
        (nfQuery sig (.app fn arg))
  | indGStuck {familyName : DeclName}
      {params : List DIndGArtifactTerm}
      {motive : DIndGArtifactTerm}
      {cases : List (DeclName × DIndGArtifactTerm)}
      {indices : List DIndGArtifactTerm}
      {scrutinee : DIndGArtifactTerm}
      (hFamily : cicStage3RawNameWithPropToType0WitnessBounded familyName) :
      CicStage3CanonicalNfRuntimeReadoutForSig sig
        (.indG familyName params motive cases indices scrutinee)
        (nfQuery sig
          (.indG familyName params motive cases indices scrutinee))
  | pi {rawDomain rawBody : DIndGArtifactTerm}
      {domainOut bodyOut : Metta.Atom}
      (hDomain :
        CicStage3CanonicalNfRuntimeReadoutForSig sig rawDomain domainOut)
      (hBody :
        CicStage3CanonicalNfRuntimeReadoutForSig sig rawBody bodyOut) :
      CicStage3CanonicalNfRuntimeReadoutForSig sig (.pi rawDomain rawBody)
        (mExpr "Pi" [domainOut, bodyOut])
  | lam {rawDomain rawBody : DIndGArtifactTerm}
      {domainOut bodyOut : Metta.Atom}
      (hDomain :
        CicStage3CanonicalNfRuntimeReadoutForSig sig rawDomain domainOut)
      (hBody :
        CicStage3CanonicalNfRuntimeReadoutForSig sig rawBody bodyOut) :
      CicStage3CanonicalNfRuntimeReadoutForSig sig (.lam rawDomain rawBody)
        (mExpr "Lam" [domainOut, bodyOut])

theorem CicStage3CanonicalNfRuntimeReadoutForSig.toRuntimeReadout
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadoutForSig sig raw out) :
    CicStage3NfRuntimeReadout sig raw out := by
  induction h with
  | resolved hOut =>
      exact CicStage3NfRuntimeReadout.resolved hOut
  | defnStuck hName hNotWitness =>
      refine CicStage3NfRuntimeReadout.defnStuck hName hNotWitness ?_ ?_
      · simp [defBodyOfQueryAtom, sigAtom_vars_nil, declNameAtom_vars_nil,
          mExpr, mSym, Metta.Atom.vars]
      · simp [defBodyOfQueryAtom, mExpr, mSym, Metta.Atom.isError]
  | appStuck hFn hArg =>
      exact CicStage3NfRuntimeReadout.appStuck hFn hArg
  | indGStuck hFamily =>
      exact CicStage3NfRuntimeReadout.indGStuck hFamily
  | pi hDomain hBody ihDomain ihBody =>
      exact CicStage3NfRuntimeReadout.pi ihDomain ihBody
  | lam hDomain hBody ihDomain ihBody =>
      exact CicStage3NfRuntimeReadout.lam ihDomain ihBody

theorem CicStage3CanonicalNfRuntimeReadoutForSig_vars_nil
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadoutForSig sig raw out) :
    out.vars = [] := by
