theorem kernelDefControlEnv_unify_evalOp_eq_kernelEnv
    (st : St) (prev : Stack)
    (atom pattern template elseAtom : Metta.Atom) :
    evalOp kernelDefControlEnv st prev
        (mExpr "unify" [atom, pattern, template, elseAtom]) [] =
      evalOp kernelEnv st prev
        (mExpr "unify" [atom, pattern, template, elseAtom]) [] := by
  unfold evalOp
  rw [show Metta.instantiate [] (mExpr "unify" [atom, pattern, template, elseAtom]) =
      mExpr "unify" [atom, pattern, template, elseAtom] by
    simpa using Metta.instantiate_nil
      (mExpr "unify" [atom, pattern, template, elseAtom])]
  change
    ((match callGrounded kernelDefControlEnv.gt "unify"
      ([atom, pattern, template, elseAtom].map
        (fun a => resolveStates st.world (subTokens st.world a))) with
    | ReduceResult.ok results =>
        (results.map (fun r => evalResult prev r []), st)
    | ReduceResult.runtimeError msg =>
        ([finItem prev (errAtom (mExpr "unify" [atom, pattern, template, elseAtom]) msg) []], st)
    | ReduceResult.incorrectArgument _ =>
        ([finItem prev notReducibleA []], st)
    | ReduceResult.noReduce =>
        if isEmbeddedOp (mExpr "unify" [atom, pattern, template, elseAtom]) = true then
          ([{ stack := atomToStack (mExpr "unify" [atom, pattern, template, elseAtom]) prev }], st)
        else
          queryOp kernelDefControlEnv st prev
            (mExpr "unify" [atom, pattern, template, elseAtom]) []) =
      (match callGrounded kernelEnv.gt "unify"
        ([atom, pattern, template, elseAtom].map
          (fun a => resolveStates st.world (subTokens st.world a))) with
      | ReduceResult.ok results =>
          (results.map (fun r => evalResult prev r []), st)
      | ReduceResult.runtimeError msg =>
          ([finItem prev (errAtom (mExpr "unify" [atom, pattern, template, elseAtom]) msg) []], st)
      | ReduceResult.incorrectArgument _ =>
          ([finItem prev notReducibleA []], st)
      | ReduceResult.noReduce =>
          if isEmbeddedOp (mExpr "unify" [atom, pattern, template, elseAtom]) = true then
            ([{ stack := atomToStack (mExpr "unify" [atom, pattern, template, elseAtom]) prev }], st)
          else
            queryOp kernelEnv st prev
              (mExpr "unify" [atom, pattern, template, elseAtom]) []))
  rw [kernelDefControlEnv_callGrounded_unify
      ([atom, pattern, template, elseAtom].map
        (fun a => resolveStates st.world (subTokens st.world a))),
    kernelEnv_callGrounded_unify
      ([atom, pattern, template, elseAtom].map
        (fun a => resolveStates st.world (subTokens st.world a)))]
  simp [isEmbeddedOp, mExpr, mSym]

