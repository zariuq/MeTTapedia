      { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", target]) [],
        bnd := ambient }
    interpretFuel kernelDefControlEnv (fuel + 1) st [rootItem] [] =
      ([(root, rootBnd)], { counter := st.counter + 1, world := st.world }) := by
  dsimp
  let target := mExpr "let" [mVar binder, atom, template]
  let coreB := letRuleBindings binder atom template
  let f := counterSuffix st.counter
  let root := mExpr "unify" [atom, mVar binder, template, mSym "Empty"]
  let rootBnd : Metta.Bindings := (renameBindings f coreB).reverse ++ ambient
  let rootItem : Item :=
    { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", target]) [],
      bnd := ambient }
  let st' : St := { counter := st.counter + 1, world := st.world }
  have hf : Function.Injective f := by
    simpa [f] using counterSuffix_injective st.counter
  have hvalB : ValueBindings coreB := by
    exact ValueBindings.val (ValueBindings.val (ValueBindings.val ValueBindings.nil))
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, letRuleBindings, bindingValueKeys]
  have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
    rw [bindingValueKeys_renameBindings]
    exact List.Nodup.map hf hnodup
  have hmatch :
      Metta.matchAtoms (freshenRule st.counter letRulePair.1 letRulePair.2).1 target =
        [renameBindings f coreB] := by
    rw [fresh_let_rule_match st.counter binder atom template
      hAtomNonVar hTemplateNonVar hPatternFresh]
    simp [coreB, letRuleBindings, f, renameBindings]
  have hdisj :
      ∀ x ∈ bindingValueKeys (renameBindings f coreB),
        x ∉ bindingValueKeys ambient := by
    intro x hx hxAmbient
    have hx' : x = f "template" ∨ x = f "atom" ∨ x = f "pattern" := by
      simpa [coreB, letRuleBindings, bindingValueKeys, renameBindings, f] using hx
    have hxAmbient' : x = ambientKey := hAmbientKeys x hxAmbient
    rcases hx' with rfl | rfl | rfl
    · exact hFreshKeys (Or.inl rfl) hxAmbient'
    · exact hFreshKeys (Or.inr (Or.inl rfl)) hxAmbient'
    · exact hFreshKeys (Or.inr (Or.inr rfl)) hxAmbient'
  have hmerge :
      Metta.Bindings.merge ambient (renameBindings f coreB) = [rootBnd] := by
    simpa [rootBnd, coreB, f] using
      (merge_value_noConflict_eq
        (b := renameBindings f coreB) (acc := ambient)
        (ValueBindings.rename hvalB) hnodupRen hdisj)
  have hitems :
      queryOpItemsOfRule [] target ambient st.counter letRulePair =
        [evalResult [] root rootBnd] := by
    unfold queryOpItemsOfRule
    rcases hfresh : freshenRule st.counter letRulePair.1 letRulePair.2 with
      ⟨lhs', rhs'⟩
    have hmatch' : Metta.matchAtoms lhs' target = [renameBindings f coreB] := by
      simpa [hfresh] using hmatch
    have hResult' : Metta.instantiate rootBnd rhs' = root := by
      simpa [root, rootBnd, coreB, f, hfresh] using hResult
    have hLoop' : Metta.Bindings.hasLoop rootBnd = false := by
      simpa [rootBnd, coreB, f] using hLoop
    change
      List.flatMap
          (fun mb =>
            List.filterMap
              (fun m =>
                if Metta.Bindings.hasLoop m = true then none
                else some (evalResult [] (Metta.instantiate m rhs') m))
              (Metta.Bindings.merge ambient mb))
          (Metta.matchAtoms lhs' target) =
        [evalResult [] root rootBnd]
    rw [hmatch']
    simp only [List.flatMap_cons, List.flatMap_nil]
    rw [hmerge]
    simp [hLoop', hResult']
  have hquery :
      queryOp kernelDefControlEnv st [] target ambient =
        ([evalResult [] root rootBnd], st') := by
    have hNotVarHead : isVariableHeaded target = false := by
      simp [target, isVariableHeaded, mExpr, mSym]
    have hCand : kernelDefControlEnv.candidates target = [letRulePair] := by
      have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
        simp [MinEnv.candidates, kernelDefControlEnv]
      rw [hcandidateEq]
      simpa [target] using kernelEnv_let_candidates binder atom template
    unfold queryOp
    rw [hNotVarHead]
    simp only [Bool.false_eq_true, ↓reduceIte]
    rw [candidatesW_eq_candidates_of_no_selfExtra
      kernelDefControlEnv st.world target hStatic]
    rw [hCand]
    simp only [List.foldl_cons, List.foldl_nil]
    change
      (if (([] ++ queryOpItemsOfRule [] target ambient st.counter letRulePair).isEmpty =
            true) then
          ([finItem [] notReducibleA ambient],
            ({ counter := st.counter + 1, world := st.world } : St))
        else
          ([] ++ queryOpItemsOfRule [] target ambient st.counter letRulePair,
            ({ counter := st.counter + 1, world := st.world } : St))) =
        ([evalResult [] root rootBnd], st')
    rw [hitems]
    simp [st']
  have hstep :
      interpretStack1 kernelDefControlEnv fuel st rootItem =
        ([evalResult [] root rootBnd], st') := by
    change interpretStack1 kernelDefControlEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := ambient } =
      ([evalResult [] root rootBnd], st')
    rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelDefControlEnv fuel st [] target ambient "let" [mVar binder, atom, template]]
    · exact hquery
    · exact hTargetInst
    · exact kernelDefControlEnv_callGrounded_let
        ([mVar binder, atom, template].map
          (fun a => resolveStates st.world (subTokens st.world a)))
    · simp [isEmbeddedOp]
  have heval : evalResult [] root rootBnd = finItem [] root rootBnd := by
    simp [root, evalResult, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root rootBnd) = true := by
    simp [heval, finItem, isFinal]
  have hpair : finalPair (evalResult [] root rootBnd) = (root, rootBnd) := by
    rw [heval]
    change (Metta.instantiate rootBnd root, rootBnd) = (root, rootBnd)
    simpa [rootBnd, root, coreB, f] using congrArg (fun a => (a, rootBnd)) hRootStable
  rw [interpretFuel, hstep]
  simp [interpretFuel, hfinal, hpair, root, rootBnd, coreB, f, st']

