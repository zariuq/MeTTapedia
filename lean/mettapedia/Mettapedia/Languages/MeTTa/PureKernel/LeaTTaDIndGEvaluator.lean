/-- Exact `kernelDefControlEnv` `is-bad` root step with a closed incoming
value environment.  The scheduler preserves the incoming bindings and adds
only the private rule match; private names remain existential. -/
theorem interpretFuel_kernelDefControlEnv_is_bad_root_eq_from_closed
    (fuel : Nat) (st : St) (a : Metta.Atom) (incoming : Metta.Bindings)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hClosed : a.vars = [])
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w)
    (hIncoming : ClosedValueBindings incoming) :
    ∃ x e,
      x ≠ e ∧ x ∉ incoming.vars ∧ e ∉ incoming.vars ∧
      interpretFuel kernelDefControlEnv (fuel + 1) st
          [evalItemBnd incoming (mExpr "is-bad" [a])] [] =
        ( [ (mExpr "unify"
              [a, mExpr "Bad" [mVar e], mBool true, mBool false],
              Metta.BindingRel.val x a :: incoming) ]
        , { counter := st.counter + 1, world := st.world }) := by
  rcases queryOp_kernelEnv_is_bad_eq_from_closed st a incoming
      hStatic hImports hClosed hNonVar hIncoming with
    ⟨x, e, hxe, hxIncoming, heIncoming, hquery⟩
  let target := mExpr "is-bad" [a]
  let root :=
    mExpr "unify" [a, mExpr "Bad" [mVar e], mBool true, mBool false]
  let merged : Metta.Bindings := Metta.BindingRel.val x a :: incoming
  let stOut : St := { counter := st.counter + 1, world := st.world }
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, hClosed, Metta.Atom.vars]
  have hstep :
      interpretStack1 kernelDefControlEnv fuel st
          (evalItemBnd incoming target) =
        ([evalResult [] root merged], stOut) := by
    unfold evalItemBnd
    change interpretStack1 kernelDefControlEnv fuel st
        { stack :=
            { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: []
          bnd := incoming } =
      ([evalResult [] root merged], stOut)
    calc
      interpretStack1 kernelDefControlEnv fuel st
          { stack :=
              { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: []
            bnd := incoming } =
          interpretStack1 kernelEnv fuel st
            { stack :=
                { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: []
              bnd := incoming } := by
            simpa [target, mExpr, mSym] using
              kernelDefControlEnv_is_bad_interpretStack1_eval_eq_kernelEnv_from
                fuel st [] incoming a hClosed
      _ = ([evalResult [] root merged], stOut) := by
            rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
              kernelEnv fuel st [] target incoming "is-bad" [a]]
            · simpa [target, root, merged, stOut, mExpr, mSym] using hquery
            · exact instantiate_eq_self_of_vars_nil incoming hclosedTarget
            · exact kernelEnv_callGrounded_isBad a
            · simp [isEmbeddedOp]
  have hrootStable : Metta.instantiate merged root = root := by
    simpa [root, merged] using
      is_bad_root_instantiate_stable_from_closed
        a incoming x e hClosed hIncoming hxe heIncoming
  have heval : evalResult [] root merged = finItem [] root merged := by
    simp [root, evalResult, finItem, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root merged) = true := by
    simp [heval, finItem, isFinal]
  have hpair : finalPair (evalResult [] root merged) = (root, merged) := by
    rw [heval]
    change (Metta.instantiate merged root, merged) = (root, merged)
    simp [hrootStable]
  have hnotEmpty :
      ((finalPair (evalResult [] root merged)).1 != emptyA) = true := by
    rw [hpair]
    rfl
  have hdriver := interpretFuel_single_of_interpretStack1_single_final
    kernelDefControlEnv fuel st stOut (evalItemBnd incoming target)
      (evalResult [] root merged) hstep hfinal hnotEmpty
  refine ⟨x, e, hxe, hxIncoming, heIncoming, ?_⟩
  rw [hpair] at hdriver
  simpa [target, root, merged, stOut] using hdriver

/-- Exact live selected-application assembly for an all-quoted argument row.

The theorem keeps both public projections visible.  The first projection
combines the quoted row's binding with the rule-reduction binding before
recursive result evaluation; the second combines that retained binding with
the recursive result binding.  Neither projection is identified with the
incoming list, since closed bindings need not already be in the canonical
order produced by `restrictBnd`. -/
private theorem mettaEval_expr_eq_of_instantiated_all_quoted_and_root_expected_eq_bnd
    (env : MinEnv) (fuel : Nat) (st stRoot stOut : St)
    (bnd : Metta.Bindings) (source : Metta.Atom)
    (op : String) (args : List Metta.Atom)
    (root final : Metta.Atom) (rootBnd finalBnd : Metta.Bindings)
    (plan : SelectedApplicationExecutionPlan env st.world bnd op args)
    (hInst : Metta.instantiate bnd source =
      Metta.Atom.expr (Metta.Atom.sym op :: args))
    (hNotError :
      (Metta.Atom.expr (Metta.Atom.sym op :: args)).isError = false)
    (hSeed : plan.seeds = [bnd])
    (hMask : argMask plan.selected args.length =
      List.replicate args.length false)
    (hReturn : returnsAtom plan.selected = false)
    (hNoErr :
      (((args.map (Metta.instantiate bnd)).zip args).find?
        (fun pair =>
          (pair.1 == emptyA || pair.1.isError) && pair.1 != pair.2)) = none)
    (hRoot : interpretFuel env (fuel + 1) st
        [{ stack := atomToStack
            (Metta.Atom.expr [Metta.Atom.sym "eval",
              Metta.Atom.expr
                (Metta.Atom.sym op :: args.map (Metta.instantiate bnd))]) [],
           bnd := bnd }] [] =
      ([(root, rootBnd)], stRoot))
    (hRootNotNotReducible : (root == notReducibleA) = false)
    (hRootNotSelf :
      (root == Metta.Atom.expr
        (Metta.Atom.sym op :: args.map (Metta.instantiate bnd))) = false)
    (hFinal :
      mettaEvalExpected env fuel stRoot
          (restrictBnd
            (expectedApplicationRetentionScope bnd args)
            ((Metta.Bindings.merge bnd rootBnd).head?.getD rootBnd))
          root (selectedResultExpected plan.selected) =
        ([(final, finalBnd)], stOut)) :
    mettaEval env (fuel + 1) st bnd source =
      ([(final,
          restrictBnd
            (expectedApplicationRetentionScope bnd args)
            ((Metta.Bindings.merge
              (restrictBnd
                (expectedApplicationRetentionScope bnd args)
                ((Metta.Bindings.merge bnd rootBnd).head?.getD rootBnd))
              finalBnd).head?.getD finalBnd))],
        stOut) := by
  rw [mettaEval_eq_evaluateExpectedApplication_of_selected_after_instantiate
    env fuel st bnd source op args hInst
      hNotError plan hSeed]
  rw [evaluateExpectedApplicationFrom_eq_factored]
  rw [evaluateExpectedApplicationFromFactored_all_quoted_eq_of_root_expected_eq
    env fuel st stRoot stOut bnd op args plan.selected root final
      rootBnd finalBnd hMask hReturn hNoErr hRoot
      hRootNotNotReducible hRootNotSelf hFinal]
  simp

/-- A closed grounded equality that is false remains false under any closed
incoming value theory.  The exact output theory is the pair of public
projections performed by the repaired selected-application pipeline; no
canonicality of the incoming list is assumed. -/
theorem mettaEval_kernelDefControlEnv_eq_false_eq_state_from
    (fuel : Nat) (st : St) (incoming : Metta.Bindings)
    (a b : Metta.Atom)
    (hWorld : st.world = St.init.world)
    (hClosedA : a.vars = [])
    (hClosedB : b.vars = [])
    (hStateA : resolveStates st.world a = a)
    (hStateB : resolveStates st.world b = b)
    (hAErr : a.isError = false)
    (hBErr : b.isError = false)
    (hIncoming : ClosedValueBindings incoming)
    (hcall :
      callGrounded stdGroundings "==" [a, b] =
        ReduceResult.ok [mBool false]) :
    ∃ outBindings,
      mettaEval kernelDefControlEnv (fuel + 2) st incoming
          (mExpr "==" [a, b]) =
        ([(mBool false, outBindings)], st) := by
  let args := [a, b]
  let plan := selectedApplicationExecutionPlan_atom_args_symbolic_return_from
    kernelDefControlEnv st.world "==" "Bool" args incoming
      hIncoming.hasLoop_false
      (by
        simpa [args, OperatorTypesPinned, mExpr, mSym] using
          (KernelDefControlEnvTypeWorld.eqOp
            (by simpa [hWorld] using kernelDefControlEnvTypeWorld_init)))
  let retained :=
    restrictBnd (expectedApplicationRetentionScope incoming args)
      ((Metta.Bindings.merge incoming incoming).head?.getD incoming)
  let outBindings :=
    restrictBnd (expectedApplicationRetentionScope incoming args)
      ((Metta.Bindings.merge retained retained).head?.getD retained)
  have hArgsClosed : args.flatMap Metta.Atom.vars = [] := by
    simp [args, hClosedA, hClosedB]
  have hInst :
      Metta.instantiate incoming (mExpr "==" [a, b]) =
        mExpr "==" [a, b] := by
    exact instantiate_eq_self_of_vars_nil incoming
      (by simp [mExpr, mSym, Metta.Atom.vars, hClosedA, hClosedB])
  have hSeed : plan.seeds = [incoming] := by
    change selectedApplicationInitialBindingsFromTheory incoming
      (Metta.Atom.expr (Metta.Atom.sym "==" :: args))
      (Metta.Atom.sym "%Undefined%") incoming = [incoming]
    unfold selectedApplicationInitialBindingsFromTheory
    have hScope :
        expectedApplicationVisibleScope
            (Metta.Atom.expr (Metta.Atom.sym "==" :: args))
            (Metta.Atom.sym "%Undefined%") = [] := by
      simp [expectedApplicationVisibleScope, args, hClosedA, hClosedB,
        Metta.Atom.vars]
    rw [hScope, restrictBnd_nil_vars]
    rfl
  have hMask :
      argMask plan.selected args.length = List.replicate args.length false := by
    rw [selectedApplicationExecutionPlan_atom_args_symbolic_return_from_selected]
    change List.replicate 2
      (Metta.instantiate incoming (.sym "Atom") != .sym "Atom" &&
        Metta.instantiate incoming (.sym "Atom") != .sym "Variable" &&
        Metta.instantiate incoming (.sym "Atom") != .sym "Expression") =
      List.replicate 2 false
    rw [instantiate_sym]
    decide
  have hReturn : returnsAtom plan.selected = false := by
    rw [selectedApplicationExecutionPlan_atom_args_symbolic_return_from_selected]
    unfold returnsAtom
    rw [show Metta.instantiate incoming (.sym "Bool") = .sym "Bool" by
      exact instantiate_sym incoming "Bool"]
    rfl
  have hNoErr :
      (((args.map (Metta.instantiate incoming)).zip args).find?
        (fun pair =>
          (pair.1 == emptyA || pair.1.isError) && pair.1 != pair.2)) = none := by
    rw [show args.map (Metta.instantiate incoming) = args by
      simp [args, instantiate_eq_self_of_vars_nil incoming hClosedA,
        instantiate_eq_self_of_vars_nil incoming hClosedB]]
    simp [args, hAErr, hBErr]
  have hRoot :
      interpretFuel kernelDefControlEnv (fuel + 2) st
          [{ stack := atomToStack
              (Metta.Atom.expr [Metta.Atom.sym "eval",
                Metta.Atom.expr (Metta.Atom.sym "==" ::
                  args.map (Metta.instantiate incoming))]) [],
             bnd := incoming }] [] =
        ([(mBool false, incoming)], st) := by
    rw [show args.map (Metta.instantiate incoming) = args by
      simp [args, instantiate_eq_self_of_vars_nil incoming hClosedA,
        instantiate_eq_self_of_vars_nil incoming hClosedB]]
    simpa [args, evalItemBnd, mExpr, mSym] using
      interpretFuel_kernelDefControlEnv_eq_false_eq_state_from
        (fuel + 1) st incoming a b hWorld hClosedA hClosedB
        hStateA hStateB hcall
  have hExpected :
      selectedResultExpected plan.selected = Metta.Atom.sym "Bool" := by
    rw [selectedApplicationExecutionPlan_atom_args_symbolic_return_from_selected]
    simp [selectedResultExpected, instantiate_sym, Metta.Atom.beq]
    decide
  have hStatic : st.world.selfExtra = [] := by
    simpa [hWorld] using (show St.init.world.selfExtra = [] by rfl)
  have hImports : st.world.selfImports = [] := by
    simpa [hWorld] using (show St.init.world.selfImports = [] by rfl)
  have hRetainedClosed : ClosedValueBindings retained := by
    simpa [retained] using
      closedValueBindings_restrictBnd (hIncoming.mergeHeadGetD hIncoming)
  have hFinal :
      mettaEvalExpected kernelDefControlEnv (fuel + 1) st retained
          (mBool false) (selectedResultExpected plan.selected) =
        ([(mBool false, retained)], st) := by
    rw [hExpected]
    exact mettaEvalExpected_kernelDefControlEnv_mBool_bool_eq_state_from
      fuel st retained false hStatic hImports hRetainedClosed
  refine ⟨outBindings, ?_⟩
  have hExact :=
    mettaEval_expr_eq_of_instantiated_all_quoted_and_root_expected_eq_bnd
      kernelDefControlEnv (fuel + 1) st st st incoming
      (mExpr "==" args) "==" args (mBool false) (mBool false)
      incoming retained plan
      (by simpa [args, mExpr, mSym] using hInst)
      (by simp [args, Metta.Atom.isError])
      hSeed hMask hReturn hNoErr hRoot (by rfl) (by rfl) hFinal
  simpa [args, retained, outBindings, plan] using hExact

