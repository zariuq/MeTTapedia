/-- Minimal-evaluator bridge for the leaf `nf`/`Var` rule. -/
theorem nf_var_evalAtomMin_bridge_alpha_mops
    (sig : DIndGArtifactSig) (k : Nat) :
    Metta.instantiate
        (renameBindings (counterSuffix St.init.counter)
          (nfVarRuleBindings sig k)).reverse
        (freshenRule St.init.counter nfVarRulePair.1 nfVarRulePair.2).2 ∈
        evalAtomMin kernelCoreEnv 1 (nfQuery sig (.var k)) ∧
      Relation.ReflTransGen (Metta.MopsStep kernelCoreRules)
        (nfQuery sig (.var k)) (termAtom (.var k)) ∧
      Metta.AlphaEq
        (Metta.instantiate
          (renameBindings (counterSuffix St.init.counter)
            (nfVarRuleBindings sig k)).reverse
          (freshenRule St.init.counter nfVarRulePair.1 nfVarRulePair.2).2)
        (termAtom (.var k)) := by
  let coreB : Metta.Bindings := nfVarRuleBindings sig k
  let lhs : Metta.Atom := nfVarRulePair.1
  let rhs : Metta.Atom := nfVarRulePair.2
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val (by simp [mNat, Metta.Atom.vars])
      (ClosedValueBindings.val (sigAtom_vars_nil sig) ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    dsimp [coreB, nfVarRuleBindings, bindingValueKeys]
    decide
  have hsplit :
      (MinEnv.ofAtomsGT kernelCoreRules stdGroundings).candidates
          (nfQuery sig (.var k)) =
        [] ++ (lhs, rhs) ::
          [nfSrtRulePair, nfConRulePair, (nfPiRuleLhs, nfPiRuleRhs),
            nfLamRulePair, nfBadRulePair] := by
    have hcand := kernelCoreEnv_nf_var_candidates sig k
    have hstatic := candidatesW_init_eq_candidates kernelCoreEnv (nfQuery sig (.var k))
    rw [hstatic] at hcand
    simpa [kernelCoreEnv, lhs, rhs, nfVarRulePair] using hcand
  have hclosedTarget : (nfQuery sig (.var k)).vars = [] := by
    simp [nfQuery, sigAtom_vars_nil sig, termAtom_vars_nil (.var k), mExpr, mSym,
      Metta.Atom.vars]
  have hmatchCore : coreB ∈ Metta.matchAtoms lhs (nfQuery sig (.var k)) := by
    simpa [coreB, lhs, nfVarRulePair] using
      (by
        rw [nf_var_rule_match]
        simp [nfVarRuleBindings] :
        nfVarRuleBindings sig k ∈
          Metta.matchAtoms (mExpr "nf" [mVar "sig", mExpr "Var" [mVar "k"]])
            (nfQuery sig (.var k)))
  have hnotFunction :
      isFunctionResult
        (Metta.instantiate
          (renameBindings (counterSuffix St.init.counter) coreB).reverse
          (freshenRule St.init.counter lhs rhs).2) = false := by
    rw [freshenRule_eq_renBy]
    simp [coreB, rhs, nfVarRuleBindings, nfVarRulePair, St.init,
      renameBindings, counterSuffix, Metta.instantiate, Metta.bindingsToSubst,
      Metta.Subst.apply, Metta.Subst.lookup, Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
      mExpr, mSym, mVar, isFunctionResult]
  have hbridge :=
    evalAtomMin_renamed_closed_coreBinding_reverse_alpha_mops_of_match
      (atoms := kernelCoreRules) (gt := stdGroundings) (fuel := 0)
      (x := nfQuery sig (.var k)) (lhs := lhs) (rhs := rhs) (coreB := coreB)
      (op := "nf") (args := [sigAtom sig, termAtom (.var k)])
      (pre := []) (post :=
        [nfSrtRulePair, nfConRulePair, (nfPiRuleLhs, nfPiRuleRhs),
          nfLamRulePair, nfBadRulePair])
      hclosedTarget hclosedB hnodup
      (by simp [Metta.instantiate_nil, nfQuery, termAtom, mExpr, mSym])
      (kernelCoreEnv_callGrounded_nf sig (.var k)) (by rfl) hsplit hmatchCore
      hnotFunction
  have hreadout : Metta.instantiate coreB rhs = termAtom (.var k) := by
    simpa [coreB, rhs, nfVarRulePair] using nf_var_instantiate_bindings sig k
  simpa [kernelCoreEnv, coreB, lhs, rhs, hreadout, nfQuery, termAtom, mExpr,
    mSym, St.init] using hbridge

/-- Minimal-evaluator bridge for the leaf `nf`/`Srt` rule. -/
