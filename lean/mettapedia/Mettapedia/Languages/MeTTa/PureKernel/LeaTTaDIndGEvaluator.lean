    (.selected policy.raw.decision.selectedType policy.selected_eq)
  obtain ⟨condTail, hCondTypes⟩ :=
    kernelDefControlEnv_getTypes_is_bad_bool_cons_init a
  exact
    EvalQuotedQuotedApplicationPolicy.applicationPlanCorresponds_init_of_bool_cons
      (mExpr "is-bad" [a]) thenBranch elseBranch condTail
      (by simpa [mExpr, mSym] using hCondTypes) policy

/-- Empty-seed plan correspondence for the exact `is-bad` policy value owned
by a caller at the initial kernel world.  This theorem intentionally says
nothing about nonempty incoming evaluator theories. -/
theorem kernelDefControlEnv_if_is_bad_applicationPlanCorresponds_of_world_eq
    {world : World} (a cond thenBranch elseBranch : Metta.Atom)
