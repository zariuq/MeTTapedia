private theorem atom_eq_mBool_true_of_beq_true {a : Metta.Atom}
    (h : (a == mBool true) = true) : a = mBool true := by
  change Metta.Atom.beq a (Metta.Atom.gnd (Metta.Ground.bool true)) = true at h
  cases a with
  | sym s => simp [Metta.Atom.beq] at h
  | var v => simp [Metta.Atom.beq] at h
  | expr xs => simp [Metta.Atom.beq] at h
  | gnd g =>
      cases g with
      | int i =>
          change Metta.instBEqGround.beq (Metta.Ground.int i)
            (Metta.Ground.bool true) = true at h
          unfold Metta.instBEqGround.beq at h
          simp at h
      | float f =>
          change Metta.instBEqGround.beq (Metta.Ground.float f)
            (Metta.Ground.bool true) = true at h
          unfold Metta.instBEqGround.beq at h
          simp at h
      | str s =>
          change Metta.instBEqGround.beq (Metta.Ground.str s)
            (Metta.Ground.bool true) = true at h
          unfold Metta.instBEqGround.beq at h
          simp at h
      | bool b =>
          change Metta.instBEqGround.beq (Metta.Ground.bool b)
            (Metta.Ground.bool true) = true at h
          unfold Metta.instBEqGround.beq at h
          cases b <;> simp [mBool] at h ⊢
      | unit =>
          change Metta.instBEqGround.beq Metta.Ground.unit
            (Metta.Ground.bool true) = true at h
          unfold Metta.instBEqGround.beq at h
          simp at h
      | error e =>
          change Metta.instBEqGround.beq (Metta.Ground.error e)
            (Metta.Ground.bool true) = true at h
          unfold Metta.instBEqGround.beq at h
          simp at h
      | external tag payload =>
          change Metta.instBEqGround.beq (Metta.Ground.external tag payload)
            (Metta.Ground.bool true) = true at h
          unfold Metta.instBEqGround.beq at h
          simp at h
      | bindings stored =>
          change Metta.instBEqGround.beq (Metta.Ground.bindings stored)
            (Metta.Ground.bool true) = true at h
          unfold Metta.instBEqGround.beq at h
          simp at h

