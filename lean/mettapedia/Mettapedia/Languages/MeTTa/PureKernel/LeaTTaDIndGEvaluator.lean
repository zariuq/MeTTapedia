private theorem interpretFuel_kernelDefControlEnv_if_false_bool_root_eq_with_keyed_ambient
    {fuel : Nat} {st : St}
    (binder : String) (elseA : Metta.Atom) (ambient : Metta.Bindings)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hElseClosed : elseA.vars = [])
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hElseNotFunction : isFunctionResult elseA = false)
    (hElseNotEmpty : (elseA != emptyA) = true)
    (hAmbientClosed : ClosedValueBindings ambient)
    (hAmbientKeys :
      ∀ x, x ∈ bindingValueKeys ambient → x = binder)
    (hFreshET :
      ∀ {v : String}, v = "e" ∨ v = "t" →
        counterSuffix (st.counter + 1) v ≠ binder) :
    let thenA := mBool false
    let target := mExpr "if" [mBool false, thenA, elseA]
    let rootItem : Item :=
      { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", target]) [],
        bnd := ambient }
    let rootBnd : Metta.Bindings :=
      (renameBindings (counterSuffix (st.counter + 1))
        [Metta.BindingRel.val "e" elseA,
         Metta.BindingRel.val "t" thenA]).reverse ++ ambient
    interpretFuel kernelDefControlEnv (fuel + 1) st [rootItem] [] =
      ([(elseA, rootBnd)], { counter := st.counter + 2, world := st.world }) := by
  dsimp
  let thenA := mBool false
  let target := mExpr "if" [mBool false, thenA, elseA]
  let coreB : Metta.Bindings :=
    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix (st.counter + 1)
  let m : Metta.Bindings := (renameBindings f coreB).reverse ++ ambient
  let rootItem : Item :=
    { stack := atomToStack (Metta.Atom.expr [Metta.Atom.sym "eval", target]) [],
      bnd := ambient }
  let st' : St := { counter := st.counter + 2, world := st.world }
  have hclosedTarget : target.vars = [] := by
    simp [target, thenA, hElseClosed, mExpr, mSym, mBool, Metta.Atom.vars]
  have hThenClosed : thenA.vars = [] := by
    simp [thenA, mBool, Metta.Atom.vars]
  have hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w := by
    intro w
    simp [thenA, mBool]
  have hinst :
      Metta.instantiate ambient target =
        Metta.Atom.expr (Metta.Atom.sym "if" :: [mBool false, thenA, elseA]) := by
    have htarget := instantiate_eq_self_of_vars_nil ambient hclosedTarget
    simpa [target, mExpr, mSym] using htarget
  have hquery :
      queryOp kernelDefControlEnv st [] target ambient =
        ([evalResult [] elseA m], st') := by
    have hNotVarHead : isVariableHeaded target = false := by
      simp [target, isVariableHeaded, mExpr, mSym]
    have hCand : kernelDefControlEnv.candidates target = [ifTrueRulePair, ifFalseRulePair] := by
      have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
        simp [MinEnv.candidates, kernelDefControlEnv]
      rw [hcandidateEq]
      simpa [target] using kernelEnv_if_candidates false thenA elseA
    have hcompatFalse :
        LegacyFresheningCompatible [] target ambient (st.counter + 1)
          ifFalseRulePair.1 ifFalseRulePair.2 := by
      exact legacyFresheningCompatible_ifFalseRule_of_closed_keyed_ambient
        target ambient binder (st.counter + 1) hclosedTarget
        hAmbientClosed hAmbientKeys hFreshET
    have hitemsTrue :
        Metta.Minimal.queryOpItemsOfRule [] target ambient st.counter ifTrueRulePair = [] := by
      simpa [target] using
        queryOpItems_if_true_on_false_eq_nil st.counter thenA elseA
          (ambient := ambient)
    have hitemsFalse :
        Metta.Minimal.queryOpItemsOfRule [] target ambient (st.counter + 1) ifFalseRulePair =
          [evalResult [] elseA m] := by
      have hclosedB : ClosedValueBindings coreB := by
        exact ClosedValueBindings.val hElseClosed
          (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
      have hnodup : (bindingValueKeys coreB).Nodup := by
        simp [coreB, bindingValueKeys]
      have hfresh :
          freshenRule (st.counter + 1) ifFalseRulePair.1 ifFalseRulePair.2 =
            (mExpr "if" [mBool false, mVar (f "t"), mVar (f "e")],
              mVar (f "e")) := by
        rw [freshenRule_eq_renBy]
        simp [f, ifFalseRulePair, mExpr, mSym, mVar, mBool,
          Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy]
      have hmatch :
          Metta.matchAtoms (mExpr "if" [mBool false, mVar (f "t"), mVar (f "e")])
              target =
            [[Metta.BindingRel.val (f "e") elseA, Metta.BindingRel.val (f "t") thenA]] := by
        simpa [target, f, hfresh] using
          fresh_if_false_rule_match (st.counter + 1) thenA elseA
            (by simp [hThenClosed]) (by simp [hElseClosed])
            hThenNonVar hElseNonVar
            (by simp [hThenClosed]) (by simp [hElseClosed])
      have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
        rw [bindingValueKeys_renameBindings]
        exact List.Nodup.map (counterSuffix_injective (st.counter + 1)) hnodup
      have hdisj :
          ∀ x ∈ bindingValueKeys (renameBindings f coreB),
            x ∉ bindingValueKeys ambient := by
        intro x hx hxAmbient
        have hx' : x = f "e" ∨ x = f "t" := by
          simpa [coreB, bindingValueKeys, renameBindings, f] using hx
        have hxAmbient' : x = binder := hAmbientKeys x hxAmbient
        rcases hx' with rfl | rfl
        · exact hFreshET (Or.inl rfl) hxAmbient'
        · exact hFreshET (Or.inr rfl) hxAmbient'
      have hmergeEq :
          Metta.Bindings.merge ambient (renameBindings f coreB) = [m] := by
        simpa [m] using
          (merge_closed_noConflict_eq
            (b := renameBindings f coreB) (acc := ambient)
            (ClosedValueBindings.rename hclosedB) hnodupRen hAmbientClosed hdisj)
      have hmergeRaw :
          Metta.Bindings.merge ambient
              [Metta.BindingRel.val (f "e") elseA, Metta.BindingRel.val (f "t") thenA] =
            [m] := by
        simpa [coreB, renameBindings] using hmergeEq
      have hclosedAmbient : ClosedValueBindings ambient := hAmbientClosed
      have hclosedM : ClosedValueBindings m := by
        exact ClosedValueBindings.append
          (ClosedValueBindings.reverse (ClosedValueBindings.rename hclosedB))
          hclosedAmbient
      have hloop : Metta.Bindings.hasLoop m = false := by
        simpa [m] using ClosedValueBindings.hasLoop_false hclosedM
      have hresult : Metta.instantiate m (mVar (f "e")) = elseA := by
        have het : f "e" ≠ f "t" := by
          intro h
          have ht : "e" = "t" := (counterSuffix_injective (st.counter + 1)) h
          contradiction
        rw [hclosedM.instantiate_eq_subst_apply]
        simp [m, f, coreB, mVar, renameBindings,
          Metta.bindingsToSubst, Metta.Subst.apply, Metta.Subst.lookup, het]
      unfold Metta.Minimal.queryOpItemsOfRule
      rw [hcompatFalse, hfresh]
      change
        List.flatMap
            (fun mb =>
              List.filterMap
                (fun mm =>
                  if Metta.Bindings.hasLoop mm = true then none
                  else some (evalResult [] (Metta.instantiate mm (mVar (f "e"))) mm))
                (Metta.Bindings.merge ambient mb))
            (Metta.matchAtoms (mExpr "if" [mBool false, mVar (f "t"), mVar (f "e")])
              target) =
          [evalResult [] elseA m]
      rw [hmatch]
      simp only [List.flatMap_cons, List.flatMap_nil]
      rw [hmergeRaw]
      simp [hloop, hresult]
    unfold queryOp
    rw [hNotVarHead]
    simp only [Bool.false_eq_true, ↓reduceIte]
    rw [candidatesW_eq_candidates_of_no_selfRules
      kernelDefControlEnv st.world target hStatic hImports]
    rw [hCand]
    simp only [List.foldl_cons, List.foldl_nil,
      Metta.Minimal.queryOpFoldStep,
      Metta.Minimal.freshenRuleAvoiding_counter]
    change
      (if ((([] ++ Metta.Minimal.queryOpItemsOfRule [] target ambient st.counter ifTrueRulePair) ++
                Metta.Minimal.queryOpItemsOfRule [] target ambient (st.counter + 1) ifFalseRulePair).isEmpty =
              true) then
          ([finItem [] notReducibleA ambient],
            ({ counter := st.counter + 1 + 1, world := st.world } : St))
        else
          ((([] ++ Metta.Minimal.queryOpItemsOfRule [] target ambient st.counter ifTrueRulePair) ++
                Metta.Minimal.queryOpItemsOfRule [] target ambient (st.counter + 1) ifFalseRulePair),
            ({ counter := st.counter + 1 + 1, world := st.world } : St))) =
        ([evalResult [] elseA m], st')
    rw [hitemsTrue, hitemsFalse]
    simp [st', m, f, coreB, renameBindings]
  have hstep :
      interpretStack1 kernelDefControlEnv fuel st rootItem =
        ([evalResult [] elseA m], st') := by
    change interpretStack1 kernelDefControlEnv fuel st
        { stack := { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := ambient } =
      ([evalResult [] elseA m], st')
    rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelDefControlEnv fuel st [] target ambient "if" [mBool false, thenA, elseA]]
    · exact hquery
    · exact hinst
    · exact kernelDefControlEnv_callGrounded_if
        ([mBool false, thenA, elseA].map
          (fun a => resolveStates st.world (subTokens st.world a)))
    · rfl
  have heval : evalResult [] elseA m = finItem [] elseA m :=
    evalResult_nil_eq_finItem_of_not_function (a := elseA) (b := m) hElseNotFunction
  have hfinal : isFinal (evalResult [] elseA m) = true := by
    simp [heval, finItem, isFinal]
  have hstable : Metta.instantiate m elseA = elseA := by
    exact instantiate_eq_self_of_vars_nil m hElseClosed
  have hpair : finalPair (evalResult [] elseA m) = (elseA, m) := by
    rw [heval]
    change (Metta.instantiate m elseA, m) = (elseA, m)
    simp [hstable]
  rw [interpretFuel, hstep]
  have htodo :
      List.filter (fun r => !isFinal r) [evalResult [] elseA m] = [] := by
    simp [hfinal]
  have hdone :
      (List.map finalPair (List.filter isFinal [evalResult [] elseA m])).reverse =
        [(elseA, m)] := by
    simp [hfinal, hpair]
  change
    interpretFuel kernelDefControlEnv fuel st'
      (List.filter (fun r => !isFinal r) [evalResult [] elseA m] ++ [])
      ((List.map finalPair (List.filter isFinal [evalResult [] elseA m])).reverse ++ []) =
        ([(elseA, m)], st')
  rw [htodo, hdone]
  simp only [List.append_nil]
  rw [interpretFuel_done]
  simp [interpretFuel, st', hElseNotEmpty]

/-- One live lazy-ternary layer preserves an arbitrary closed public theory.

The theorem exposes the exact projected seed passed to the selected branch.
It deliberately records only the semantic invariant available for a generic
closed presentation (closed values with one public key), rather than
normalizing that presentation to a singleton list. -/
private theorem mettaEval_if_is_bad_false_pair_mem_implies_else_pair_from_closed_keyed
    (fuel : Nat) (st : St) (incoming : Metta.Bindings) (binder : String)
    (a elseA final : Metta.Atom) {outBnd : Metta.Bindings}
    (hWorld : st.world = St.init.world)
    (hIncomingClosed : ClosedValueBindings incoming)
    (hIncomingKeys :
      ∀ x, x ∈ bindingValueKeys incoming → x = binder)
    (hFreshET :
      ∀ {v : String}, v = "e" ∨ v = "t" →
        counterSuffix (st.counter + 2) v ≠ binder)
    (hAClosed : a.vars = [])
    (hANoErr : a.isError = false)
    (hANonVar : ∀ w, a ≠ Metta.Atom.var w)
    (hANotBad :
      ∀ badVar, Metta.matchAtoms a (mExpr "Bad" [mVar badVar]) = [])
    (hElseClosed : elseA.vars = [])
    (hElseNoErr : elseA.isError = false)
    (hElseNotEmpty : (elseA != emptyA) = true)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hElseNotFunction : isFunctionResult elseA = false)
    (hElseNotNotReducible : (elseA == notReducibleA) = false)
    (hElseNotSelf :
      (elseA == mExpr "if" [mBool false, mBool false, elseA]) = false)
    (hmem :
      (final, outBnd) ∈
        (mettaEval kernelDefControlEnv (fuel + 4) st incoming
          (mExpr "if"
            [mExpr "is-bad" [a], mBool false, elseA])).1) :
    ∃ retained finalBnd,
      ClosedValueBindings retained ∧
      (∀ x, x ∈ bindingValueKeys retained → x = binder) ∧
      (final, finalBnd) ∈
        (mettaEval kernelDefControlEnv (fuel + 3)
          ({ counter := st.counter + 3, world := st.world } : St)
          retained elseA).1 := by
  let cond := mExpr "is-bad" [a]
  let stCond : St := { counter := st.counter + 1, world := st.world }
  let stRoot : St := { counter := st.counter + 3, world := st.world }
  have hStatic : st.world.selfExtra = [] := by
    simpa [hWorld] using (show St.init.world.selfExtra = [] by rfl)
  have hImports : st.world.selfImports = [] := by
    simpa [hWorld] using (show St.init.world.selfImports = [] by rfl)
  have hTypes : KernelDefControlEnvTypeWorld st.world := by
    simpa [hWorld] using kernelDefControlEnvTypeWorld_init
  have hLoop : Metta.Bindings.hasLoop incoming = false :=
    hIncomingClosed.hasLoop_false
  rcases mettaEval_kernelDefControlEnv_is_bad_false_eq_from_closed
      fuel st a incoming hStatic hImports hTypes hAClosed hANoErr hANonVar
      hIncomingClosed hANotBad with
    ⟨privateX, privateE, hPrivateNe, hPrivateX, hPrivateE,
      hCondBindingsClosed, hCondEval⟩
  let outerArgs := [a]
  let outerScope := expectedApplicationRetentionScope incoming outerArgs
  let rootArgs :=
    [a, mExpr "Bad" [mVar privateE], mBool true, mBool false]
  let rootBnd0 := Metta.BindingRel.val privateX a :: incoming
  let outerRetained := restrictBnd outerScope
    ((Metta.Bindings.merge incoming rootBnd0).head?.getD rootBnd0)
  let innerScope := expectedApplicationRetentionScope outerRetained rootArgs
  let innerRetained := restrictBnd innerScope
    ((Metta.Bindings.merge outerRetained outerRetained).head?.getD
