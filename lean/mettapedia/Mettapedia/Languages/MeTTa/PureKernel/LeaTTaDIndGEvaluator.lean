  let st' : St := { counter := st.counter + 2, world := st.world }
  have hclosedTarget : target.vars = [] := by
    simp [target, thenA, hElseClosed, mExpr, mSym, mBool, Metta.Atom.vars]
  have hThenClosed : thenA.vars = [] := by
    simp [thenA, mExpr, mSym, Metta.Atom.vars]
  have hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w := by
    intro w
    simp [thenA, mExpr, mSym]
  have hinst :
      Metta.instantiate ambient target =
        Metta.Atom.expr (Metta.Atom.sym "if" :: [mBool false, thenA, elseA]) := by
    have htarget := instantiate_eq_self_of_vars_nil ambient hclosedTarget
    simpa [target, mExpr, mSym] using htarget
  have hquery :
      queryOp kernelDefControlEnv st [] target ambient =
        ([evalResult [] elseA m], st') := by
