    (sig : DIndGArtifactSig) (rawRight : DIndGArtifactTerm) :
    Metta.KernelStep kernelControlRules stdGroundings
      (mExpr "let"
        [ mVar "ny"
        , nfQuery sig rawRight
        , mExpr "if"
            [ mExpr "is-bad" [mVar "nx"]
            , mBool false
            , mExpr "if"
                [ mExpr "is-bad" [mVar "ny"]
                , mBool false
                , mExpr "==" [mVar "nx", mVar "ny"] ] ] ])
      (mExpr "unify"
        [ nfQuery sig rawRight
        , mVar "ny"
        , mExpr "if"
            [ mExpr "is-bad" [mVar "nx"]
            , mBool false
            , mExpr "if"
                [ mExpr "is-bad" [mVar "ny"]
                , mBool false
                , mExpr "==" [mVar "nx", mVar "ny"] ] ]
        , mSym "Empty" ]) := by
  simpa [nfQuery, mExpr, mSym] using
    (let_ny_control_kernel_step
      (atom := nfQuery sig rawRight)
      (template :=
        mExpr "if"
          [ mExpr "is-bad" [mVar "nx"]
          , mBool false
          , mExpr "if"
              [ mExpr "is-bad" [mVar "ny"]
              , mBool false
              , mExpr "==" [mVar "nx", mVar "ny"] ] ])
      (by intro w; simp [nfQuery, mExpr])
      (by intro w; simp [mExpr]))

/-- The same kernel `conv` readout in the extended App rule slice.  The App
body evaluates under this environment, so later App soundness can consume this
lemma directly without a rule-list monotonicity detour. -/
theorem conv_appRules_mops_readout
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    convReadout sig rawLeft rawRight ∈
      Metta.equalityReductions ⟨kernelAppRules⟩
        (convQuery sig rawLeft rawRight) := by
  rw [Metta.mem_equalityReductions]
  refine ⟨(mExpr "conv" [mVar "sig", mVar "x", mVar "y"],
      mExpr "let"
        [ mVar "nx"
        , mExpr "nf" [mVar "sig", mVar "x"]
        , mExpr "let"
            [ mVar "ny"
            , mExpr "nf" [mVar "sig", mVar "y"]
            , mExpr "if"
                [ mExpr "is-bad" [mVar "nx"]
                , mBool false
                , mExpr "if"
                    [ mExpr "is-bad" [mVar "ny"]
                    , mBool false
                    , mExpr "==" [mVar "nx", mVar "ny"] ] ] ] ]), ?_, ?_⟩
  · simp [Metta.Space.equalityRules, kernelAppRules, ruleInferAppBody,
      inferAppBodyRhs, ruleInferAppDispatch, kernelCoreRules, runtimeDecls,
      ruleConv, ruleIsBad, ruleNfVar, ruleNfSrt, ruleNfCon, ruleNfBad,
      ruleInferSrtType, ruleInferSrtKind, ruleInferBad, mExpr, mSym, mVar,
      mTypeDecl, mBool, mNat]
  · refine ⟨[Metta.BindingRel.val "y" (termAtom rawRight),
        Metta.BindingRel.val "x" (termAtom rawLeft),
        Metta.BindingRel.val "sig" (sigAtom sig)], ?_, ?_⟩
    · rw [conv_rule_match]
      simp
    · simp [conv_instantiate_bindings]

/-- The kernel `conv` rule as a MOPS step in the extended App rule slice. -/
theorem conv_appRules_mops_step
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.MopsStep kernelAppRules
      (convQuery sig rawLeft rawRight)
      (convReadout sig rawLeft rawRight) := by
  constructor
  · refine ⟨"conv", ?_⟩
    simp [Metta.Minimal.headKey, convQuery, mExpr, mSym]
  · exact conv_appRules_mops_readout sig rawLeft rawRight

/-- The extended-slice `conv` step transported through LeaTTa's executable
kernel/MOPS correspondence. -/
theorem conv_appRules_kernel_step
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    Metta.KernelStep kernelAppRules stdGroundings
      (convQuery sig rawLeft rawRight)
      (convReadout sig rawLeft rawRight) := by
  exact (Metta.kernelStep_iff_mopsStep (atoms := kernelAppRules) (gt := stdGroundings)).2
    (conv_appRules_mops_step sig rawLeft rawRight)

/-- Matching the object-language `App` subterm returns its argument bindings.
The inner list is `[a, f]` because `Bindings.addValRaw` conses each new value;
the enclosing `infer` match merges this list back into the outer accumulator. -/
private theorem infer_app_inner_match
    (rawFn rawArg : DIndGArtifactTerm) :
    Metta.matchAll none [[]]
      [Metta.Atom.sym "App", Metta.Atom.var "f", Metta.Atom.var "a"]
      [Metta.Atom.sym "App", termAtom rawFn, termAtom rawArg] =
    [[Metta.BindingRel.val "a" (termAtom rawArg),
      Metta.BindingRel.val "f" (termAtom rawFn)]] := by
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "f" (termAtom rawFn) (termAtom_not_var rawFn)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "a" (termAtom rawArg) (termAtom_not_var rawArg)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rfl

/-- Wrapper for the `App` subterm match in LeaTTa's `matchAtomsWith`. -/
private theorem infer_app_expr_match
    (rawFn rawArg : DIndGArtifactTerm) :
    Metta.matchAtomsWith none
      (Metta.Atom.expr [Metta.Atom.sym "App", Metta.Atom.var "f", Metta.Atom.var "a"])
      (Metta.Atom.expr [Metta.Atom.sym "App", termAtom rawFn, termAtom rawArg]) =
    [[Metta.BindingRel.val "a" (termAtom rawArg),
      Metta.BindingRel.val "f" (termAtom rawFn)]] := by
  simp only [Metta.matchAtomsWith]
  exact infer_app_inner_match rawFn rawArg

/-- Generic one-argument constructor matcher used by the public binding-waist
dispatch rules. -/
private theorem match_unary_expr_var
    (head var : String) (target : Metta.Atom)
    (h : ∀ w, target ≠ Metta.Atom.var w) :
    Metta.matchAtomsWith none
      (Metta.Atom.expr [Metta.Atom.sym head, Metta.Atom.var var])
      (Metta.Atom.expr [Metta.Atom.sym head, target]) =
    [[Metta.BindingRel.val var target]] := by
  simp only [Metta.matchAtomsWith]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom var target h]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rfl

/-- Generic two-argument constructor matcher used by recursive `nf` rules. -/
private theorem match_binary_expr_vars
    (head var₁ var₂ : String) (target₁ target₂ : Metta.Atom)
    (hneq : var₂ ≠ var₁)
    (h₁ : ∀ w, target₁ ≠ Metta.Atom.var w)
    (h₂ : ∀ w, target₂ ≠ Metta.Atom.var w) :
    Metta.matchAtomsWith none
      (Metta.Atom.expr [Metta.Atom.sym head, Metta.Atom.var var₁, Metta.Atom.var var₂])
      (Metta.Atom.expr [Metta.Atom.sym head, target₁, target₂]) =
    [[Metta.BindingRel.val var₂ target₂,
      Metta.BindingRel.val var₁ target₁]] := by
  simp only [Metta.matchAtomsWith]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom var₁ target₁ h₁]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom var₂ target₂ h₂]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal, hneq]
  unfold Metta.matchAll
  have hneq_sym : var₁ ≠ var₂ := by
    intro h
    exact hneq h.symm
  simp [hneq_sym]

/-- Matcher for the `DDef $c $T $body` declaration head used by
`def-body-of`.

LeaTTa's list matcher accumulates the bindings right-to-left inside the
constructor, giving `body`, then `T`, then `c`. -/
private theorem match_ddef_expr_vars
    (defName : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName)
    (type body : DIndGArtifactTerm) :
    Metta.matchAtomsWith none
      (mExpr "DDef" [mVar "c", mVar "T", mVar "body"])
      (mExpr "DDef" [declNameAtom defName, termAtom type, termAtom body]) =
    [[Metta.BindingRel.val "body" (termAtom body),
      Metta.BindingRel.val "T" (termAtom type),
      Metta.BindingRel.val "c" (declNameAtom defName)]] := by
  simp only [Metta.matchAtomsWith, mExpr, mSym, mVar]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "c" (declNameAtom defName) (declNameAtom_not_var defName)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "T" (termAtom type) (termAtom_not_var type)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "body" (termAtom body) (termAtom_not_var body)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rfl

/-- Matcher for a signature whose head is a `DDef` declaration. -/
private theorem match_scons_ddef_expr
    (rest : DIndGArtifactSig)
    (defName : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName)
    (type body : DIndGArtifactTerm) :
    Metta.matchAtomsWith none
      (mExpr "SCons"
        [mExpr "DDef" [mVar "c", mVar "T", mVar "body"], mVar "rest"])
      (sigAtom (sigWithHeadDecl (.ddef defName type body) rest)) =
    [[Metta.BindingRel.val "rest" (sigAtom rest),
      Metta.BindingRel.val "c" (declNameAtom defName),
      Metta.BindingRel.val "T" (termAtom type),
      Metta.BindingRel.val "body" (termAtom body)]] := by
  rw [show sigAtom (sigWithHeadDecl (.ddef defName type body) rest) =
      mExpr "SCons"
        [mExpr "DDef" [declNameAtom defName, termAtom type, termAtom body],
          sigAtom rest] by
    simp [sigWithHeadDecl, sigAtom, declAtom, mExpr, mSym]]
  simp only [Metta.matchAtomsWith, mExpr, mSym, mVar]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [show
      Metta.matchAtomsWith none
        (Metta.Atom.expr [Metta.Atom.sym "DDef", Metta.Atom.var "c",
          Metta.Atom.var "T", Metta.Atom.var "body"])
        (Metta.Atom.expr [Metta.Atom.sym "DDef", declNameAtom defName,
          termAtom type, termAtom body]) =
        [[Metta.BindingRel.val "body" (termAtom body),
          Metta.BindingRel.val "T" (termAtom type),
          Metta.BindingRel.val "c" (declNameAtom defName)]] from
    match_ddef_expr_vars defName type body]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "rest" (sigAtom rest) (sigAtom_not_var rest)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rfl

private theorem match_ddef_expr_vars_named
    (c T bodyVar : String)
    (defName : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName)
    (type body : DIndGArtifactTerm)
    (hT_c : T ≠ c)
    (hbody_T : bodyVar ≠ T)
    (hbody_c : bodyVar ≠ c) :
    Metta.matchAtomsWith none
      (mExpr "DDef" [mVar c, mVar T, mVar bodyVar])
      (mExpr "DDef" [declNameAtom defName, termAtom type, termAtom body]) =
    [[Metta.BindingRel.val bodyVar (termAtom body),
      Metta.BindingRel.val T (termAtom type),
      Metta.BindingRel.val c (declNameAtom defName)]] := by
  simp only [Metta.matchAtomsWith, mExpr, mSym, mVar]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom c (declNameAtom defName) (declNameAtom_not_var defName)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom T (termAtom type) (termAtom_not_var type)]
  have hc_T : c ≠ T := by
    intro h
    exact hT_c h.symm
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal,
    hT_c, hc_T]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom bodyVar (termAtom body) (termAtom_not_var body)]
  have hT_body : T ≠ bodyVar := by
    intro h
    exact hbody_T h.symm
  have hc_body : c ≠ bodyVar := by
    intro h
    exact hbody_c h.symm
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal,
    hbody_T, hT_body, hbody_c, hc_body]
  unfold Metta.matchAll
  rfl

private theorem match_scons_ddef_expr_named
    (c T bodyVar restVar : String)
    (rest : DIndGArtifactSig)
    (defName : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName)
    (type body : DIndGArtifactTerm)
    (hT_c : T ≠ c)
    (hbody_T : bodyVar ≠ T)
    (hbody_c : bodyVar ≠ c)
    (hrest_body : restVar ≠ bodyVar)
    (hrest_T : restVar ≠ T)
    (hrest_c : restVar ≠ c) :
    Metta.matchAtomsWith none
      (mExpr "SCons"
        [mExpr "DDef" [mVar c, mVar T, mVar bodyVar], mVar restVar])
      (sigAtom (sigWithHeadDecl (.ddef defName type body) rest)) =
    [[Metta.BindingRel.val restVar (sigAtom rest),
      Metta.BindingRel.val c (declNameAtom defName),
      Metta.BindingRel.val T (termAtom type),
      Metta.BindingRel.val bodyVar (termAtom body)]] := by
  rw [show sigAtom (sigWithHeadDecl (.ddef defName type body) rest) =
      mExpr "SCons"
        [mExpr "DDef" [declNameAtom defName, termAtom type, termAtom body],
          sigAtom rest] by
    simp [sigWithHeadDecl, sigAtom, declAtom, mExpr, mSym]]
  simp only [Metta.matchAtomsWith, mExpr, mSym, mVar]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [show
      Metta.matchAtomsWith none
        (Metta.Atom.expr
          [Metta.Atom.sym "DDef", Metta.Atom.var c,
            Metta.Atom.var T, Metta.Atom.var bodyVar])
        (Metta.Atom.expr [Metta.Atom.sym "DDef", declNameAtom defName,
          termAtom type, termAtom body]) =
        [[Metta.BindingRel.val bodyVar (termAtom body),
          Metta.BindingRel.val T (termAtom type),
          Metta.BindingRel.val c (declNameAtom defName)]] from
    match_ddef_expr_vars_named c T bodyVar defName type body
      hT_c hbody_T hbody_c]
  have hc_T : c ≠ T := by
    intro h
    exact hT_c h.symm
  have hT_body : T ≠ bodyVar := by
    intro h
    exact hbody_T h.symm
  have hc_body : c ≠ bodyVar := by
    intro h
    exact hbody_c h.symm
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal,
    hT_c, hc_T, hbody_T, hT_body, hbody_c, hc_body]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom restVar (sigAtom rest) (sigAtom_not_var rest)]
  have hbody_rest : bodyVar ≠ restVar := by
    intro h
    exact hrest_body h.symm
  have hT_rest : T ≠ restVar := by
    intro h
    exact hrest_T h.symm
  have hc_rest : c ≠ restVar := by
    intro h
    exact hrest_c h.symm
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal,
    hrest_body, hbody_rest, hrest_T, hT_rest, hrest_c, hc_rest]
  unfold Metta.matchAll
  rfl

/-- The leaf `nf` rule for encoded variables matches with the two closed
bindings consumed by the certified `Var` readout. -/
theorem nf_var_rule_match
    (sig : DIndGArtifactSig) (k : Nat) :
    Metta.matchAtoms (mExpr "nf" [mVar "sig", mExpr "Var" [mVar "k"]])
      (nfQuery sig (.var k)) =
      [nfVarRuleBindings sig k] := by
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, nfQuery, termAtom, mExpr, mSym, mVar]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "sig" (sigAtom sig) (sigAtom_not_var sig)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_unary_expr_var "Var" "k" (mNat k) (mNat_not_var k)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal,
    nfVarRuleBindings]
  unfold Metta.matchAll
  rfl

/-- Instantiating the leaf `nf`/`Var` body returns the encoded variable. -/
theorem nf_var_instantiate_bindings
    (sig : DIndGArtifactSig) (k : Nat) :
    Metta.instantiate
        (nfVarRuleBindings sig k)
        (mExpr "Var" [mVar "k"]) =
      termAtom (.var k) := by
  simp [nfVarRuleBindings, termAtom, Metta.instantiate, Metta.bindingsToSubst,
    Metta.Subst.apply, Metta.Subst.lookup, mExpr, mSym, mVar, mNat]

/-- The leaf `nf` rule for encoded sorts matches with the two closed bindings
consumed by the certified `Srt` readout. -/
theorem nf_srt_rule_match
    (sig : DIndGArtifactSig) (sort : DIndGArtifactSort) :
    Metta.matchAtoms (mExpr "nf" [mVar "sig", mExpr "Srt" [mVar "s"]])
      (nfQuery sig (.srt sort)) =
      [nfSrtRuleBindings sig sort] := by
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, nfQuery, termAtom, mExpr, mSym, mVar]
  unfold Metta.matchAll
  simp [Metta.matchAtomsWith, Metta.Bindings.merge]
  unfold Metta.matchAll
  rw [match_var_nonvar_atom "sig" (sigAtom sig) (sigAtom_not_var sig)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal]
  unfold Metta.matchAll
  rw [match_unary_expr_var "Srt" "s" (sortAtom sort) (sortAtom_not_var sort)]
  simp [Metta.Bindings.merge, Metta.Bindings.mergeOne, Metta.Bindings.addVarBinding,
    Metta.Bindings.addValRaw, Metta.Bindings.removeVal, Metta.Bindings.lookupVal,
    nfSrtRuleBindings]
  unfold Metta.matchAll
  rfl

/-- Instantiating the leaf `nf`/`Srt` body returns the encoded sort. -/
theorem nf_srt_instantiate_bindings
    (sig : DIndGArtifactSig) (sort : DIndGArtifactSort) :
    Metta.instantiate
        (nfSrtRuleBindings sig sort)
        (mExpr "Srt" [mVar "s"]) =
      termAtom (.srt sort) := by
  simp [nfSrtRuleBindings, termAtom, sortAtom, Metta.instantiate, Metta.bindingsToSubst,
    Metta.Subst.apply, Metta.Subst.lookup, mExpr, mSym, mVar]

/-- The leaf `nf` rule for encoded constants matches with the two closed
bindings consumed by the certified `Con` readout. -/
theorem nf_con_rule_match
    (sig : DIndGArtifactSig) (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
    Metta.matchAtoms (mExpr "nf" [mVar "sig", mExpr "Con" [mVar "x"]])
      (nfQuery sig (.con name)) =
      [nfConRuleBindings sig name] := by
  simp only [Metta.matchAtoms, Metta.matchAtomsWith, nfQuery, termAtom, mExpr, mSym, mVar]
  unfold Metta.matchAll
