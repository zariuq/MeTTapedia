/-- Assemble the live recursion-neutral `let` plan without equating its
applicability theory to the legacy empty-seed selection. -/
private def kernelDefControlEnv_let_recursionNeutralExecutionPlan_from
    (st : St) (incoming : Metta.Bindings)
    (pattern atom template : Metta.Atom)
    (hTypes : KernelDefControlEnvTypeWorld st.world)
    (hLoop : Metta.Bindings.hasLoop incoming = false)
    (hSeed :
      (selectedApplicationExecutionPlan_let_policy_from
          kernelDefControlEnv st.world "let" pattern atom template incoming
          hLoop
          (by simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.letOp)).seeds =
        [incoming]) :
    RecursionNeutralApplicationExecutionPlan kernelDefControlEnv st.world
      incoming "let" [pattern, atom, template] [false, true, false] false := by
  let plan :=
    selectedApplicationExecutionPlan_let_policy_from
      kernelDefControlEnv st.world "let" pattern atom template incoming
      hLoop
      (by simpa [OperatorTypesPinned, mExpr, mSym] using hTypes.letOp)
  have hAtom :
      Metta.instantiate incoming (mSym "Atom") = mSym "Atom" :=
    instantiate_of_closed incoming (mSym "Atom") (by simp [mSym, Metta.Atom.vars])
  have hUndefined :
      Metta.instantiate incoming (mSym "%Undefined%") = mSym "%Undefined%" :=
    instantiate_of_closed incoming (mSym "%Undefined%")
      (by simp [mSym, Metta.Atom.vars])
  refine
    { plan := plan
      seedSingleton := ?_
      recursionNeutral := ?_
      argumentMask_eq := ?_
      returnIsAtom_eq := ?_ }
  · simpa [plan] using hSeed
  · simpa [plan, selectedApplicationExecutionPlan_let_policy_from,
      letSelectedTypeFrom, mExpr, mSym] using
      letSelectedTypeFrom_recursionNeutral incoming
  · change
      [ ((Metta.instantiate incoming (mSym "Atom") != .sym "Atom") &&
            (Metta.instantiate incoming (mSym "Atom") != .sym "Variable") &&
            (Metta.instantiate incoming (mSym "Atom") != .sym "Expression"))
      , ((Metta.instantiate incoming (mSym "%Undefined%") != .sym "Atom") &&
            (Metta.instantiate incoming (mSym "%Undefined%") != .sym "Variable") &&
            (Metta.instantiate incoming (mSym "%Undefined%") != .sym "Expression"))
      , ((Metta.instantiate incoming (mSym "Atom") != .sym "Atom") &&
            (Metta.instantiate incoming (mSym "Atom") != .sym "Variable") &&
            (Metta.instantiate incoming (mSym "Atom") != .sym "Expression")) ] =
        [false, true, false]
    rw [hAtom, hUndefined]
    rfl
  · change
      (Metta.instantiate incoming (mSym "%Undefined%") == mSym "Atom") = false
    rw [hUndefined]
    rfl

