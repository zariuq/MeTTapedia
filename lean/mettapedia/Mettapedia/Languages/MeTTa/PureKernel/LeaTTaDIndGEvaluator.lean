/-- A closed singleton public theory is retained literally by the concrete
`is-bad` false branch.  This is the canonical consumer form of the guarded
projection equation above; it does not identify arbitrary closed binding
lists with their normalized projections. -/
theorem mettaEval_kernelDefControlEnv_is_bad_false_eq_singleton_closed
    (fuel : Nat) (st : St) (binder : String) (a : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hTypes : KernelDefControlEnvTypeWorld st.world)
    (hClosed : a.vars = [])
    (hErr : a.isError = false)
    (hNonVar : ∀ w, a ≠ Metta.Atom.var w)
    (hUnify : Metta.Bindings.unifyValues [a, a] = some [])
    (hNoBad : ∀ e, Metta.matchAtoms a
      (mExpr "Bad" [mVar e]) = []) :
    mettaEval kernelDefControlEnv (fuel + 3) st
        [Metta.BindingRel.val binder a] (mExpr "is-bad" [a]) =
      ([(mBool false, [Metta.BindingRel.val binder a])],
        { counter := st.counter + 1, world := st.world }) := by
  have hIncoming : ClosedValueBindings
      [Metta.BindingRel.val binder a] :=
    ClosedValueBindings.val hClosed ClosedValueBindings.nil
  rcases mettaEval_kernelDefControlEnv_is_bad_false_eq_from_closed
      fuel st a [Metta.BindingRel.val binder a]
      hStatic hImports hTypes hClosed hErr hNonVar hIncoming hNoBad with
    ⟨x, e, hxe, hx, he, _hOutClosed, hEval⟩
  have hxb : x ≠ binder := by
    exact (by simpa [Metta.Bindings.vars] using hx :
      x ≠ binder ∧ x ∉ a.vars).1
  have heb : e ≠ binder := by
    exact (by simpa [Metta.Bindings.vars] using he :
      e ≠ binder ∧ e ∉ a.vars).1
  have hfirst :
      Metta.Bindings.mergeOne
          [[Metta.BindingRel.val binder a]]
          (Metta.BindingRel.val x a) =
        [[Metta.BindingRel.val x a, Metta.BindingRel.val binder a]] := by
    apply mergeOne_singleton_val_of_not_mem
    · exact ClosedValueBindings.val hClosed ClosedValueBindings.nil
    · exact hClosed
    · simpa [bindingValueKeys] using hxb
  have hvalues :
      Metta.Bindings.classValues
          [Metta.BindingRel.val x a, Metta.BindingRel.val binder a] binder =
        [a] := by
    have hbx : binder ≠ x := Ne.symm hxb
    rw [Metta.Bindings.classValues_eq_lookupVal_toList_of_eqVarsInOrder_nil]
    · simp [Metta.Bindings.lookupVal, hbx]
    · rfl
  have hsecond :
      Metta.Bindings.addVarBinding
          [Metta.BindingRel.val x a, Metta.BindingRel.val binder a]
          binder a =
        [[Metta.BindingRel.val x a, Metta.BindingRel.val binder a]] := by
    apply Metta.Bindings.addVarBinding_nochange (values := [a])
    · exact hNonVar
    · exact hvalues
    · simp
    · simpa using hUnify
  have hMergeRoot :
      Metta.Bindings.merge [Metta.BindingRel.val binder a]
          [Metta.BindingRel.val x a, Metta.BindingRel.val binder a] =
        [[Metta.BindingRel.val x a, Metta.BindingRel.val binder a]] := by
    unfold Metta.Bindings.merge
    simp only [List.foldl_cons, List.foldl_nil]
    rw [hfirst]
    simpa [Metta.Bindings.mergeOne] using hsecond
  have hResolveRoot :
      resolveAtom
          [Metta.BindingRel.val x a, Metta.BindingRel.val binder a]
          3 (Metta.Atom.var binder) = a :=
    resolveAtom_two_closed_vals_right x binder a hClosed
  have hRestrictRoot :
      restrictBnd [binder]
          [Metta.BindingRel.val x a, Metta.BindingRel.val binder a] =
        [Metta.BindingRel.val binder a] :=
    restrictBnd_singleton_two_vals_right x binder a hResolveRoot hNonVar
  have hMergeSelf :=
    merge_singleton_closed_self_eq binder a hNonVar hUnify
  have hRestrictSingleton :=
    restrictBnd_singleton_closed_val binder a hClosed hNonVar
  have hRestrictInner :=
    restrictBnd_fresh_cons_singleton_closed_val e binder a heb hClosed hNonVar
  have hIncomingVars :
      Metta.Bindings.vars [Metta.BindingRel.val binder a] = [binder] := by
    unfold Metta.Bindings.vars
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    rw [hClosed]
    rfl
  have hOuterScope :
      expectedApplicationRetentionScope
          [Metta.BindingRel.val binder a] [a] = [binder] := by
    rw [expectedApplicationRetentionScope_singleton_closed
      [Metta.BindingRel.val binder a] a hClosed]
    exact hIncomingVars
  have hInnerScope :
      expectedApplicationRetentionScope
          [Metta.BindingRel.val binder a]
          [a, mExpr "Bad" [mVar e], mBool true, mBool false] =
        [e, binder] := by
    have hbe : binder ≠ e := Ne.symm heb
    have hQueryVars :
        [a, mExpr "Bad" [mVar e], mBool true, mBool false].flatMap
            Metta.Atom.vars = [e] := by
      simp [hClosed, mExpr, mSym, mVar, mBool, Metta.Atom.vars]
    unfold expectedApplicationRetentionScope
    rw [hQueryVars, hIncomingVars]
    simp [hbe]
  rw [hOuterScope, hMergeRoot] at hEval
  simp only [List.head?_cons, Option.getD_some] at hEval
  rw [hRestrictRoot, hInnerScope, hMergeSelf] at hEval
  simp only [List.head?_cons, Option.getD_some] at hEval
  rw [hRestrictInner, hMergeSelf] at hEval
  simp only [List.head?_cons, Option.getD_some] at hEval
  rw [hRestrictInner, hMergeSelf] at hEval
  simp only [List.head?_cons, Option.getD_some] at hEval
  rw [hRestrictSingleton] at hEval
  exact hEval

