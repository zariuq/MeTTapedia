/-- The `kernel_signature_lf_indexed_v0.metta` SRT rule
`(= (infer $sig $ctx (Srt type)) (Srt kind))` matches the concrete Stage-3
artifact query with exactly the two value bindings the rule uses. -/
theorem infer_srt_type_rule_match :
    Metta.matchAtoms
      (mExpr "infer" [mVar "sig", mVar "ctx", mExpr "Srt" [mSym "type"]])
      (inferQuery cicStage3RawArtifactSig (.srt .type)) =
    [[BindingRel.val "ctx" ctxNilAtom,
      BindingRel.val "sig" (sigAtom cicStage3RawArtifactSig)]] := by
  unfold inferQuery termAtom sortAtom
  rw [match_ternary_two_vars_tail_filtered
    "infer" "sig" "ctx" (sigAtom cicStage3RawArtifactSig) ctxNilAtom
    (mExpr "Srt" [mSym "type"]) (mExpr "Srt" [mSym "type"])
    (by decide) (sigAtom_vars_absent cicStage3RawArtifactSig)
    ctxNilAtom_vars_absent (sigAtom_not_var cicStage3RawArtifactSig)
    ctxNilAtom_not_var]
  rw [show Metta.matchAtomsWith none
      (mExpr "Srt" [mSym "type"]) (mExpr "Srt" [mSym "type"]) = [[]] by rfl]
  rw [filter_singleton_binding_of_hasLoop_false ([] : Metta.Bindings) (by rfl)]
  simp only [List.flatMap_singleton]
  rw [show Metta.Bindings.merge
      [BindingRel.val "ctx" ctxNilAtom,
        BindingRel.val "sig" (sigAtom cicStage3RawArtifactSig)] [] =
      [[BindingRel.val "ctx" ctxNilAtom,
        BindingRel.val "sig" (sigAtom cicStage3RawArtifactSig)]] by rfl]
  rw [filter_singleton_binding_of_hasLoop_false _
    (ClosedValueBindings.hasLoop_false
      (ClosedValueBindings.val ctxNilAtom_vars_nil_local
        (ClosedValueBindings.val (sigAtom_vars_nil cicStage3RawArtifactSig)
          ClosedValueBindings.nil)))]

/-- The executable one-fuel `infer (Srt type)` readout, justified through the
generic LeaTTa evaluator-correctness bridge.

Unlike `kernelCoreEnv_infer_interpretFuel`, this proof does not recompute the
`queryOp` trace.  It instantiates the reusable static-candidate bridge with the
kernel's `Srt type` rule, so the observed runtime readout pins a certified
contextual MOPS step. -/
theorem infer_srt_type_interpretFuel_bridge_mops :
    (termAtom (.srt .kind), inferSrtTypeRuleBindings) ∈
        (interpretFuel kernelCoreEnv 1 St.init
          [{ stack :=
              [{ atom := (Metta.Atom.expr
                [Metta.Atom.sym "eval", inferQuery cicStage3RawArtifactSig (.srt .type)]) }],
             bnd := [] }] []).1 ∧
      Relation.ReflTransGen (ExprCtxMopsStep kernelCoreRules)
        (inferQuery cicStage3RawArtifactSig (.srt .type))
        (termAtom (.srt .kind)) := by
  let lhs := mExpr "infer" [mVar "sig", mVar "ctx", mExpr "Srt" [mSym "type"]]
  let rhs := mExpr "Srt" [mSym "kind"]
  let coreB : Metta.Bindings :=
    [BindingRel.val "ctx" ctxNilAtom,
     BindingRel.val "sig" (sigAtom cicStage3RawArtifactSig)]
  have hctxClosed : ctxNilAtom.vars = [] := by
    change (Metta.Atom.sym "CtxNil").vars = []
    unfold Metta.Atom.vars
    rfl
  have hsigClosed : (sigAtom cicStage3RawArtifactSig).vars = [] := by
    simp [sigAtom, cicStage3RawArtifactSig, cicStage3RawArtifactDecls,
      cicStage3RawNatDecl, cicStage3RawNatZeroCtor, cicStage3RawNatSuccCtor,
      declAtom, ctorAtom, ctorsAtom, telAtom, argsAtom, termAtom,
      mExpr, mSym, declNameAtom, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hctxClosed
      (ClosedValueBindings.val hsigClosed ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, bindingValueKeys]
  have hsplit :
      (MinEnv.ofAtomsGT kernelCoreRules stdGroundings).candidates
          (inferQuery cicStage3RawArtifactSig (.srt .type)) =
        [] ++ (lhs, rhs) ::
          [ (mExpr "infer" [mVar "sig", mVar "ctx", mExpr "Srt" [mSym "kind"]],
              mExpr "Bad" [mSym "kind-is-topsort"])
          , (mExpr "infer" [mVar "sig", mVar "ctx", mExpr "Bad" [mVar "e"]],
              mExpr "Bad" [mVar "e"]) ] := by
    have hcand := kernelCoreEnv_infer_candidates
    have hstatic :=
      candidatesW_init_eq_candidates kernelCoreEnv
        (inferQuery cicStage3RawArtifactSig (.srt .type))
    rw [hstatic] at hcand
    simpa [kernelCoreEnv, lhs, rhs] using hcand
  have hclosedTarget : (inferQuery cicStage3RawArtifactSig (.srt .type)).vars = [] := by
    simp [inferQuery, termAtom, sortAtom, sigAtom, cicStage3RawArtifactSig,
      cicStage3RawArtifactDecls, cicStage3RawNatDecl, cicStage3RawNatZeroCtor,
      cicStage3RawNatSuccCtor, declAtom, ctorAtom, ctorsAtom, telAtom, argsAtom,
      ctxNilAtom, mExpr, mSym, declNameAtom, Metta.Atom.vars]
  have hmatchCore :
      coreB ∈ Metta.matchAtoms lhs (inferQuery cicStage3RawArtifactSig (.srt .type)) := by
    rw [infer_srt_type_rule_match]
    simp [coreB]
  have hbound : ∀ v ∈ rhs.vars, ∃ t, Metta.Bindings.lookupVal coreB v = some t := by
    intro v hv
    simp [rhs, mExpr, mSym, Metta.Atom.vars] at hv
  have hclosedResult : (Metta.instantiate coreB rhs).vars = [] := by
    rw [hclosedB.instantiate_eq_subst_apply]
    simp [coreB, rhs, Metta.bindingsToSubst, Metta.Subst.apply,
      mExpr, mSym, Metta.Atom.vars]
  have hnotEmpty : (Metta.instantiate coreB rhs != emptyA) = true := by
    rw [hclosedB.instantiate_eq_subst_apply]
    simp [coreB, rhs, Metta.bindingsToSubst,
      Metta.Subst.apply, mExpr, mSym]
  have hnotFunction : isFunctionResult (Metta.instantiate coreB rhs) = false := by
    rw [hclosedB.instantiate_eq_subst_apply]
    simp [coreB, rhs, Metta.bindingsToSubst, Metta.Subst.apply,
      mExpr, mSym, isFunctionResult]
  have hresult : Metta.instantiate coreB rhs = termAtom (.srt .kind) := by
    rw [hclosedB.instantiate_eq_subst_apply]
    simp [coreB, rhs, termAtom, sortAtom, Metta.bindingsToSubst,
      Metta.Subst.apply, mExpr, mSym]
  have hbridge :=
    (interpretFuel_eval_renamed_closed_coreBinding_reverse_contains_closed_mops_of_match
      (atoms := kernelCoreRules) (gt := stdGroundings) (st := St.init) (fuel := 0)
      (x := inferQuery cicStage3RawArtifactSig (.srt .type)) (lhs := lhs) (rhs := rhs)
      (coreB := coreB) (op := "infer")
      (args := [sigAtom cicStage3RawArtifactSig, ctxNilAtom, termAtom (.srt .type)])
      (pre := []) (post :=
        [ (mExpr "infer" [mVar "sig", mVar "ctx", mExpr "Srt" [mSym "kind"]],
            mExpr "Bad" [mSym "kind-is-topsort"])
        , (mExpr "infer" [mVar "sig", mVar "ctx", mExpr "Bad" [mVar "e"]],
            mExpr "Bad" [mVar "e"]) ])
      hclosedTarget hclosedB hnodup rfl
      (by
        simp [Metta.instantiate_nil, inferQuery, termAtom, sortAtom, ctxNilAtom,
          mExpr, mSym])
      kernelCoreEnv_callGrounded_infer_srt_type (by rfl) hsplit hmatchCore
      hbound hclosedResult hnotEmpty hnotFunction)
  rw [hresult] at hbridge
  simpa [kernelCoreEnv, coreB, lhs, rhs, inferSrtTypeRuleBindings, counterSuffix, St.init,
    inferQuery, termAtom, sortAtom, sigAtom, cicStage3RawArtifactSig,
    cicStage3RawArtifactDecls, ctxNilAtom, mExpr, mSym, renameBindings,
    Metta.Subst.lookup] using hbridge

/-- The LeaTTa/MOPS query relation fires the SRT rule on the real Stage-3
artifact signature and reads out `Srt kind`. -/
theorem infer_srt_type_mops_readout :
    termAtom (.srt .kind) ∈
      Metta.equalityReductions ⟨kernelCoreRules⟩
        (inferQuery cicStage3RawArtifactSig (.srt .type)) := by
  rw [Metta.mem_equalityReductions]
  refine ⟨(mExpr "infer" [mVar "sig", mVar "ctx", mExpr "Srt" [mSym "type"]],
      mExpr "Srt" [mSym "kind"]), ?_, ?_⟩
  · simp [Metta.Space.equalityRules, kernelCoreRules, runtimeDecls, ruleInferSrtType, ruleIsBad,
      ruleNfVar, ruleNfSrt, ruleNfCon, ruleNfBad, ruleInferSrtKind, ruleInferBad, ruleConv,
      mExpr, mSym, mVar, mTypeDecl, mBool]
  · refine ⟨[BindingRel.val "ctx" ctxNilAtom,
        BindingRel.val "sig" (sigAtom cicStage3RawArtifactSig)], ?_, ?_⟩
    · rw [infer_srt_type_rule_match]
      simp
    · have hclosed : ClosedValueBindings
          [BindingRel.val "ctx" ctxNilAtom,
            BindingRel.val "sig" (sigAtom cicStage3RawArtifactSig)] :=
        ClosedValueBindings.val (by simp [ctxNilAtom, mSym, Metta.Atom.vars])
          (ClosedValueBindings.val (sigAtom_vars_nil cicStage3RawArtifactSig)
            ClosedValueBindings.nil)
      rw [hclosed.instantiate_eq_subst_apply]
      simp [Metta.bindingsToSubst, Metta.Subst.apply, termAtom, sortAtom,
        mExpr, mSym]

/-- The same readout as a LeaTTa/MOPS one-step proposition. -/
theorem infer_srt_type_mops_step :
    Metta.MopsStep kernelCoreRules
      (inferQuery cicStage3RawArtifactSig (.srt .type))
      (termAtom (.srt .kind)) := by
  constructor
  · refine ⟨"infer", ?_⟩
    simp [Metta.Minimal.headKey, inferQuery, termAtom, sortAtom, ctxNilAtom, mExpr, mSym]
  · exact infer_srt_type_mops_readout

/-- The readout consumed by the declaration calculus: `Srt type` has type
`Srt kind` in the Stage-3 artifact environment. -/
theorem infer_srt_type_decl_sound :
    HasTypeDecl (envOfSpecs cicStage3RawArtifactSig.translatedSpecs) .nil .u0 .u1 := by
  exact HasTypeDecl.u0_type
    (E := envOfSpecs cicStage3RawArtifactSig.translatedSpecs) (Γ := .nil)

/-- The concrete LeaTTa runtime readout for `infer (Srt type)` is sound for
the declaration calculus. The runtime hypothesis is load-bearing: it first
pins the observed raw readout to `Srt kind`, and only then consumes the raw-term
translation witnesses. -/
theorem infer_sound_srt
    {rawType : DIndGArtifactTerm} {term type : PureTm 0}
    (hinfer : evaluator.infer cicStage3RawArtifactSig (.srt .type) rawType)
    (htermTr :
      DIndGArtifactTermTranslates cicStage3RawArtifactSig.nameTranslates 0
        (.srt .type) term)
    (htypeTr :
      DIndGArtifactTermTranslates cicStage3RawArtifactSig.nameTranslates 0
        rawType type) :
    HasTypeDecl (envOfSpecs cicStage3RawArtifactSig.translatedSpecs) .nil term type := by
  have hRaw : rawType = .srt .kind := by
    change termAtom rawType ∈
      (mettaEval kernelCoreEnv 1 St.init []
        (inferQuery cicStage3RawArtifactSig (.srt .type))).1.map (·.1) at hinfer
    rw [infer_srt_type_core_mettaEval_readout] at hinfer
    simp at hinfer
    cases rawType <;>
      simp [termAtom, sortAtom, mExpr, mSym, mNat, declNameAtom] at hinfer
    case srt sort =>
      cases sort <;> simp at hinfer
      rfl
  subst hRaw
  cases htermTr
  cases htypeTr
  exact infer_srt_type_decl_sound

namespace DIndGArtifactTermTranslates

/-- Inversion for translated raw variables. At depth zero this immediately
discharges the impossible `Var` cases in runtime extraction. -/
theorem var_inv {nameTranslates : DeclName → DeclName → Prop}
    {index : Nat} {term : PureTm n}
    (h : DIndGArtifactTermTranslates nameTranslates n (.var index) term) :
    ∃ hIndex : index < n, term = .var ⟨index, hIndex⟩ := by
  cases h with
  | var hIndex =>
      exact ⟨hIndex, rfl⟩

/-- Inversion for translated raw `Type` sorts. -/
theorem srt_type_inv {nameTranslates : DeclName → DeclName → Prop}
    {term : PureTm n}
    (h : DIndGArtifactTermTranslates nameTranslates n (.srt .type) term) :
    term = .u0 := by
  cases h with
  | srt_type =>
      rfl

/-- Inversion for translated raw `Kind` sorts. -/
theorem srt_kind_inv {nameTranslates : DeclName → DeclName → Prop}
    {term : PureTm n}
    (h : DIndGArtifactTermTranslates nameTranslates n (.srt .kind) term) :
    term = .u1 := by
  cases h with
  | srt_kind =>
      rfl

/-- Inversion for translated raw constants. The finite-alphabet `conv` cases use
this before applying signature-specific name bounds. -/
theorem con_inv {nameTranslates : DeclName → DeclName → Prop}
    {raw : DeclName} {term : PureTm n}
    (h : DIndGArtifactTermTranslates nameTranslates n (.con raw) term) :
    ∃ lean : DeclName,
      term = .const lean ∧ nameTranslates raw lean := by
  cases h with
  | con hName =>
      exact ⟨_, rfl, hName⟩

/-- Inversion for translated raw definitions. The finite-alphabet `conv` cases
use this before applying signature-specific name bounds. -/
theorem defn_inv {nameTranslates : DeclName → DeclName → Prop}
    {raw : DeclName} {term : PureTm n}
    (h : DIndGArtifactTermTranslates nameTranslates n (.defn raw) term) :
    ∃ lean : DeclName,
      term = .const lean ∧ nameTranslates raw lean := by
  cases h with
  | defn hName =>
      exact ⟨_, rfl, hName⟩

/-- Inversion for translated raw applications. This is the App-case shape the
eventual `MettaCall` induction must expose before it can consume sub-`infer`
soundness proofs. -/
theorem app_inv {nameTranslates : DeclName → DeclName → Prop}
    {rawFn rawArg : DIndGArtifactTerm} {term : PureTm n}
    (h : DIndGArtifactTermTranslates nameTranslates n (.app rawFn rawArg) term) :
    ∃ fn arg : PureTm n,
      term = .app fn arg ∧
        DIndGArtifactTermTranslates nameTranslates n rawFn fn ∧
        DIndGArtifactTermTranslates nameTranslates n rawArg arg := by
  cases h with
  | app hFn hArg =>
      exact ⟨_, _, rfl, hFn, hArg⟩

/-- Inversion for translated raw Pi types. The App soundness case needs this
when the function's runtime `infer` readout translates to a Pi type. -/
theorem pi_inv {nameTranslates : DeclName → DeclName → Prop}
    {rawDomain rawBody : DIndGArtifactTerm} {term : PureTm n}
    (h : DIndGArtifactTermTranslates nameTranslates n (.pi rawDomain rawBody) term) :
    ∃ domain : PureTm n, ∃ body : PureTm (n + 1),
      term = .pi domain body ∧
        DIndGArtifactTermTranslates nameTranslates n rawDomain domain ∧
        DIndGArtifactTermTranslates nameTranslates (n + 1) rawBody body := by
  cases h with
  | pi hDomain hBody =>
      exact ⟨_, _, rfl, hDomain, hBody⟩

/-- Inversion for translated raw lambdas. This mirrors `pi_inv` for the
remaining binder-shaped runtime extraction cases. -/
theorem lam_inv {nameTranslates : DeclName → DeclName → Prop}
    {rawDomain rawBody : DIndGArtifactTerm} {term : PureTm n}
    (h : DIndGArtifactTermTranslates nameTranslates n (.lam rawDomain rawBody) term) :
    ∃ domain : PureTm n, ∃ body : PureTm (n + 1),
      term = .lam body ∧
        DIndGArtifactTermTranslates nameTranslates n rawDomain domain ∧
        DIndGArtifactTermTranslates nameTranslates (n + 1) rawBody body := by
  cases h with
  | lam hDomain hBody =>
      exact ⟨_, _, rfl, hDomain, hBody⟩

/-- Raw `Bad` artifacts have no Lean translation. -/
theorem bad_inv {nameTranslates : DeclName → DeclName → Prop}
    {reason : String} {term : PureTm n}
    (h : DIndGArtifactTermTranslates nameTranslates n (.bad reason) term) :
    False := by
  cases h

end DIndGArtifactTermTranslates

