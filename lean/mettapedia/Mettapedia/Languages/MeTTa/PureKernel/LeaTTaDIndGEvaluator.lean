/-- The concrete selected payload shared by the kernel `let` suppliers is recursion-neutral:
only the `%Undefined%` argument is evaluated, while both `Atom` arguments are quoted and the
result check is `%Undefined%`. -/
private theorem letSelectedType_recursionNeutral :
    SelectedApplicationRecursionNeutral
      { functionType := mExpr "->"
          [mSym "Atom", mSym "%Undefined%", mSym "Atom", mSym "%Undefined%"]
        argumentTypes := [mSym "Atom", mSym "%Undefined%", mSym "Atom"]
        returnType := mSym "%Undefined%"
        typeBindings := [] }
      3 := by
  constructor
  · intro policy hmem hEval
    have hPolicies :
        argumentEvaluationPolicies
            { functionType := mExpr "->"
                [mSym "Atom", mSym "%Undefined%", mSym "Atom", mSym "%Undefined%"]
              argumentTypes := [mSym "Atom", mSym "%Undefined%", mSym "Atom"]
              returnType := mSym "%Undefined%"
              typeBindings := [] }
            3 =
          [(false, mSym "Atom"), (true, mSym "%Undefined%"),
            (false, mSym "Atom")] := by
      change
        [ ((Metta.instantiate [] (mSym "Atom") != .sym "Atom") &&
              (Metta.instantiate [] (mSym "Atom") != .sym "Variable") &&
              (Metta.instantiate [] (mSym "Atom") != .sym "Expression"),
            Metta.instantiate [] (mSym "Atom"))
        , ((Metta.instantiate [] (mSym "%Undefined%") != .sym "Atom") &&
              (Metta.instantiate [] (mSym "%Undefined%") != .sym "Variable") &&
              (Metta.instantiate [] (mSym "%Undefined%") != .sym "Expression"),
            Metta.instantiate [] (mSym "%Undefined%"))
        , ((Metta.instantiate [] (mSym "Atom") != .sym "Atom") &&
              (Metta.instantiate [] (mSym "Atom") != .sym "Variable") &&
              (Metta.instantiate [] (mSym "Atom") != .sym "Expression"),
            Metta.instantiate [] (mSym "Atom")) ] = _
      simp [Metta.instantiate_nil, mSym]
      decide
    rw [hPolicies] at hmem
    simp at hmem
    rcases hmem with hmem | hmem | hmem <;> simp_all [mSym]
  · intro _
    simp [selectedResultExpected, Metta.instantiate_nil, mSym]

/-- The selected payload of the closed `let` arrow under a live incoming
applicability theory. -/
private def letSelectedTypeFrom
    (incoming : Metta.Bindings) : SelectedFunctionType :=
  ⟨mExpr "->" [mSym "Atom", mSym "%Undefined%", mSym "Atom", mSym "%Undefined%"],
    [mSym "Atom", mSym "%Undefined%", mSym "Atom"],
    mSym "%Undefined%", incoming⟩

/-- Exact expected-aware argument policies of the closed live `let` arrow. -/
private theorem letSelectedTypeFrom_argumentEvaluationPolicies
    (incoming : Metta.Bindings) :
    argumentEvaluationPolicies (letSelectedTypeFrom incoming) 3 =
      [(false, mSym "Atom"), (true, mSym "%Undefined%"),
        (false, mSym "Atom")] := by
  have hAtom :
      Metta.instantiate incoming (mSym "Atom") = mSym "Atom" :=
    instantiate_of_closed incoming (mSym "Atom") (by simp [mSym, Metta.Atom.vars])
  have hUndefined :
      Metta.instantiate incoming (mSym "%Undefined%") = mSym "%Undefined%" :=
    instantiate_of_closed incoming (mSym "%Undefined%")
      (by simp [mSym, Metta.Atom.vars])
  change
    [ ((Metta.instantiate incoming (mSym "Atom") != .sym "Atom") &&
          (Metta.instantiate incoming (mSym "Atom") != .sym "Variable") &&
          (Metta.instantiate incoming (mSym "Atom") != .sym "Expression"),
        Metta.instantiate incoming (mSym "Atom"))
    , ((Metta.instantiate incoming (mSym "%Undefined%") != .sym "Atom") &&
          (Metta.instantiate incoming (mSym "%Undefined%") != .sym "Variable") &&
          (Metta.instantiate incoming (mSym "%Undefined%") != .sym "Expression"),
        Metta.instantiate incoming (mSym "%Undefined%"))
    , ((Metta.instantiate incoming (mSym "Atom") != .sym "Atom") &&
          (Metta.instantiate incoming (mSym "Atom") != .sym "Variable") &&
          (Metta.instantiate incoming (mSym "Atom") != .sym "Expression"),
        Metta.instantiate incoming (mSym "Atom")) ] = _
  rw [hAtom, hUndefined]
  rfl

/-- The closed `let` arrow remains recursion-neutral when live applicability
retains an arbitrary incoming theory in its selected payload. -/
private theorem letSelectedTypeFrom_recursionNeutral
    (incoming : Metta.Bindings) :
    SelectedApplicationRecursionNeutral (letSelectedTypeFrom incoming) 3 := by
  have hUndefined :
      Metta.instantiate incoming (mSym "%Undefined%") = mSym "%Undefined%" :=
    instantiate_of_closed incoming (mSym "%Undefined%")
      (by simp [mSym, Metta.Atom.vars])
  constructor
  · intro policy hmem hEval
    have hPolicies :
        argumentEvaluationPolicies (letSelectedTypeFrom incoming) 3 =
          [(false, mSym "Atom"), (true, mSym "%Undefined%"),
            (false, mSym "Atom")] :=
      letSelectedTypeFrom_argumentEvaluationPolicies incoming
    rw [hPolicies] at hmem
    simp at hmem
    rcases hmem with hmem | hmem | hmem <;> simp_all [mSym]
  · intro _
    change
      (if Metta.instantiate incoming (mSym "%Undefined%") == mSym "Expression"
        then mSym "%Undefined%"
        else Metta.instantiate incoming (mSym "%Undefined%")) =
      mSym "%Undefined%"
    rw [hUndefined]
    rfl

/-- The selected `let` policy evaluates only its `%Undefined%` payload; the pattern and template
are quoted and the result check is also `%Undefined%`. -/
def kernelEnv_let_recursionNeutralPolicy
    (st : St) (pattern atom template : Metta.Atom)
    (hPinned : OperatorTypesPinned kernelEnv st.world "let"
      [mExpr "->" [mSym "Atom", mSym "%Undefined%", mSym "Atom",
        mSym "%Undefined%"]]) :
    RecursionNeutralApplicationPolicy kernelEnv st.world "let"
      [pattern, atom, template] [false, true, false] false := by
  apply (kernelEnv_let_exactPolicy st pattern atom template hPinned).withRecursionNeutral
  · apply ExactApplicationPolicy.applicationPlanCorresponds_let_policy
    simpa [OperatorTypesPinned, mExpr, mSym] using hPinned
  · change (SelectedApplicationRecursionNeutral
    { functionType := mExpr "->"
        [mSym "Atom", mSym "%Undefined%", mSym "Atom", mSym "%Undefined%"]
      argumentTypes := [mSym "Atom", mSym "%Undefined%", mSym "Atom"]
      returnType := mSym "%Undefined%"
      typeBindings := [] }
    3)
    exact letSelectedType_recursionNeutral

