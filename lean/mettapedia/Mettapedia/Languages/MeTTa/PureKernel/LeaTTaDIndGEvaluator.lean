/-- The exact root reduction for `nf Srt` under one closed public binding.
The singleton query equation fixes both the result order and the state seen by
the recursive evaluator. -/
private theorem interpretFuel_kernelDefControlEnv_nf_srt_root_eq_singleton_closed
    {fuel : Nat} {st : St} (sig : DIndGArtifactSig)
    (sort : DIndGArtifactSort) (binder : String) (value : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hImports : st.world.selfImports = [])
    (hclosedValue : value.vars = [])
    (hFresh :
      ∀ {v : String}, v = "s" ∨ v = "sig" →
        counterSuffix (st.counter + 1) v ≠ binder) :
    let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
    let rootBnd : Metta.Bindings :=
      (renameBindings (counterSuffix (st.counter + 1))
        (nfSrtRuleBindings sig sort)).reverse ++ incoming
    interpretFuel kernelDefControlEnv (fuel + 1) st
        [evalItemBnd incoming (nfQuery sig (.srt sort))] [] =
      ([(termAtom (.srt sort), rootBnd)],
        { counter := st.counter + 8, world := st.world }) := by
  dsimp only
  let target := nfQuery sig (.srt sort)
  let incoming : Metta.Bindings := [Metta.BindingRel.val binder value]
  let root := termAtom (.srt sort)
  let rootBnd :=
    (renameBindings (counterSuffix (st.counter + 1))
      (nfSrtRuleBindings sig sort)).reverse ++ incoming
  let st' : St := { counter := st.counter + 8, world := st.world }
  have htargetClosed : target.vars = [] := by
    simp [target, nfQuery, sigAtom_vars_nil, termAtom_vars_nil, mExpr, mSym,
      Metta.Atom.vars]
  have hstep :
      interpretStack1 kernelDefControlEnv fuel st (evalItemBnd incoming target) =
        ([evalResult [] root rootBnd], st') := by
    change interpretStack1 kernelDefControlEnv fuel st
        { stack :=
            { atom := Metta.Atom.expr [Metta.Atom.sym "eval", target] } :: [],
          bnd := incoming } =
      ([evalResult [] root rootBnd], st')
    rw [interpretStack1_eval_queryOp_of_instantiated_noReduce
      kernelDefControlEnv fuel st [] target incoming "nf"
        [sigAtom sig, termAtom (.srt sort)]]
    · simpa [target, incoming, root, rootBnd, st', nfQuery, mExpr, mSym] using
        queryOp_kernelDefControlEnv_nf_srt_eq_singleton_closed
          st sig sort binder value hStatic hImports hclosedValue hFresh
    · simpa [target, nfQuery, mExpr, mSym] using
        instantiate_eq_self_of_vars_nil incoming htargetClosed
    · exact kernelDefControlEnv_callGrounded_nf st sig (.srt sort)
    · simp [isEmbeddedOp]
  have heval : evalResult [] root rootBnd = finItem [] root rootBnd := by
    simp [root, termAtom, sortAtom, evalResult, mExpr, mSym]
  have hfinal : isFinal (evalResult [] root rootBnd) = true := by
    simp [heval, finItem, isFinal]
  have hrootStable : Metta.instantiate rootBnd root = root := by
    exact instantiate_eq_self_of_vars_nil rootBnd
      (by simpa [root] using termAtom_vars_nil (.srt sort))
  have hpair : finalPair (evalResult [] root rootBnd) = (root, rootBnd) := by
    rw [heval]
    change (Metta.instantiate rootBnd root, rootBnd) = (root, rootBnd)
    simp [hrootStable]
  have hnotEmpty : (root != emptyA) = true := by
    simp [root, termAtom_ne_empty]
  rw [interpretFuel, hstep]
  simp [interpretFuel, hfinal, hpair, hnotEmpty, root, rootBnd, st', incoming]

