      Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening.renBy,
      mExpr, mSym, mVar]
  have hbridge :=
    interpretFuel_eval_renamed_closed_coreBinding_reverse_alpha_final_mops_of_match
      (atoms := kernelCoreRules) (gt := stdGroundings) (st := St.init) (fuel := 0)
      (x := nfQuery sig (.lam rawDomain rawBody)) (lhs := lhs) (rhs := rhs)
      (coreB := coreB) (op := "nf")
      (args := [sigAtom sig, termAtom (.lam rawDomain rawBody)])
      (pre := nfLamCandidatePre) (post := nfLamCandidatePost)
      hclosedTarget hclosedB hnodup (by rfl)
      (by simp [Metta.instantiate_nil, nfQuery, termAtom, mExpr, mSym])
      (kernelCoreEnv_callGrounded_nf_lam sig rawDomain rawBody) (by rfl) hsplit
      hmatchCore hnotEmpty hnotFunction
  have hreadout : Metta.instantiate coreB rhs = nfLamReadout sig rawDomain rawBody := by
    simpa [coreB, rhs] using nf_lam_instantiate_bindings sig rawDomain rawBody
  simpa [kernelCoreEnv, coreB, lhs, rhs, hreadout, nfQuery, termAtom, mExpr,
    mSym, St.init, evalItemNil, atomToStack_eval] using hbridge

/-! ## Recursive `nf` equality-rule fragment -/

/-- Declarative readout relation for the equality-rule-only `nf` fragment.

This is the fragment covered by `KernelStep`/`MopsStep`: variables, sorts,
constants, bad terms, and the recursive binder constructors. `Def`, `App`, and
`IndG` require additional control-flow / lookup / generated-recursor rules and
are intentionally outside this relation. -/
inductive NfEqFragmentReadout
    (sig : DIndGArtifactSig) : DIndGArtifactTerm → Metta.Atom → Prop
  | var (k : Nat) :
      NfEqFragmentReadout sig (.var k) (termAtom (.var k))
  | srt (sort : DIndGArtifactSort) :
      NfEqFragmentReadout sig (.srt sort) (termAtom (.srt sort))
  | con (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
      NfEqFragmentReadout sig (.con name) (termAtom (.con name))
  | bad (reason : String) :
      NfEqFragmentReadout sig (.bad reason) (termAtom (.bad reason))
  | pi {rawDomain rawBody : DIndGArtifactTerm} {domainOut bodyOut : Metta.Atom}
      (hDomain : NfEqFragmentReadout sig rawDomain domainOut)
      (hBody : NfEqFragmentReadout sig rawBody bodyOut) :
      NfEqFragmentReadout sig (.pi rawDomain rawBody) (mExpr "Pi" [domainOut, bodyOut])
  | lam {rawDomain rawBody : DIndGArtifactTerm} {domainOut bodyOut : Metta.Atom}
      (hDomain : NfEqFragmentReadout sig rawDomain domainOut)
      (hBody : NfEqFragmentReadout sig rawBody bodyOut) :
      NfEqFragmentReadout sig (.lam rawDomain rawBody) (mExpr "Lam" [domainOut, bodyOut])

/-- The term-shape fragment whose `nf` readouts are covered by `NfEqFragmentReadout`.

This predicate is deliberately structural: it is the premise-free replacement for taking a
particular `NfEqFragmentReadout` as an input.  The readout itself is derived from the term shape. -/
inductive NfEqFragmentTerm : DIndGArtifactTerm → Prop
  | var (k : Nat) : NfEqFragmentTerm (.var k)
  | srt (sort : DIndGArtifactSort) : NfEqFragmentTerm (.srt sort)
  | con (name : Mettapedia.Languages.MeTTa.PureKernel.Syntax.DeclName) :
      NfEqFragmentTerm (.con name)
  | bad (reason : String) : NfEqFragmentTerm (.bad reason)
  | pi {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : NfEqFragmentTerm rawDomain)
      (hBody : NfEqFragmentTerm rawBody) :
      NfEqFragmentTerm (.pi rawDomain rawBody)
  | lam {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : NfEqFragmentTerm rawDomain)
      (hBody : NfEqFragmentTerm rawBody) :
      NfEqFragmentTerm (.lam rawDomain rawBody)

/-- Name-free subfragment of `NfEqFragmentTerm`.

This is the part of the equality-rule `nf` fragment whose encoded artifact
atoms can be inverted without a separate theorem saying that
`Lean.Name.toString` is injective on declaration names.  It is enough for the
first `conv` control-flow target (`Srt`/binder-shaped kernels) and keeps the
name-injectivity seam explicit for the full `Con`/`Def` case. -/
inductive NfEqFragmentTermNameFree : DIndGArtifactTerm → Prop
  | var (k : Nat) : NfEqFragmentTermNameFree (.var k)
  | srt (sort : DIndGArtifactSort) : NfEqFragmentTermNameFree (.srt sort)
  | bad (reason : String) : NfEqFragmentTermNameFree (.bad reason)
  | pi {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : NfEqFragmentTermNameFree rawDomain)
      (hBody : NfEqFragmentTermNameFree rawBody) :
      NfEqFragmentTermNameFree (.pi rawDomain rawBody)
  | lam {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : NfEqFragmentTermNameFree rawDomain)
      (hBody : NfEqFragmentTermNameFree rawBody) :
      NfEqFragmentTermNameFree (.lam rawDomain rawBody)

theorem nf_eq_fragment_nameFree_to_fragment
    {raw : DIndGArtifactTerm}
    (h : NfEqFragmentTermNameFree raw) :
    NfEqFragmentTerm raw := by
  induction h with
  | var k =>
      exact NfEqFragmentTerm.var k
  | srt sort =>
      exact NfEqFragmentTerm.srt sort
  | bad reason =>
      exact NfEqFragmentTerm.bad reason
  | pi hDomain hBody ihDomain ihBody =>
      exact NfEqFragmentTerm.pi ihDomain ihBody
  | lam hDomain hBody ihDomain ihBody =>
      exact NfEqFragmentTerm.lam ihDomain ihBody

/-- Stage-3 raw terms whose current `nf` behavior is covered by the existing
equality fragment plus the one banked witness-`Def` delta bridge. -/
inductive CicStage3ResolvedNfTerm : DIndGArtifactTerm → Prop
  | var (k : Nat) : CicStage3ResolvedNfTerm (.var k)
  | srt (sort : DIndGArtifactSort) : CicStage3ResolvedNfTerm (.srt sort)
  | con {name : DeclName}
      (hName : cicStage3RawNameWithPropToType0WitnessBounded name) :
      CicStage3ResolvedNfTerm (.con name)
  | witnessDefn :
      CicStage3ResolvedNfTerm (.defn cicStage3PropToType0WitnessName)
  | bad (reason : String) : CicStage3ResolvedNfTerm (.bad reason)
  | pi {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : CicStage3ResolvedNfTerm rawDomain)
      (hBody : CicStage3ResolvedNfTerm rawBody) :
      CicStage3ResolvedNfTerm (.pi rawDomain rawBody)
  | lam {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : CicStage3ResolvedNfTerm rawDomain)
      (hBody : CicStage3ResolvedNfTerm rawBody) :
      CicStage3ResolvedNfTerm (.lam rawDomain rawBody)

/-- Honest frontier left after the bounded Stage-3 alphabet split.

These are exactly the shapes not covered by the current equality-fragment nf
proofs or the concrete witness-`Def` delta bridge: non-witness `Def`, `App`,
`IndG`, and binder contexts containing such a frontier subterm. -/
inductive CicStage3NfSoundnessFrontier : DIndGArtifactTerm → Prop
  | defn {name : DeclName}
      (hName : cicStage3RawNameWithPropToType0WitnessBounded name)
      (hNotWitness : name ≠ cicStage3PropToType0WitnessName) :
      CicStage3NfSoundnessFrontier (.defn name)
  | app {fn arg : DIndGArtifactTerm}
      (hFn : CicStage3RawTermTranslationVisibleNamesBounded fn)
      (hArg : CicStage3RawTermTranslationVisibleNamesBounded arg) :
      CicStage3NfSoundnessFrontier (.app fn arg)
  | indG
      {familyName : DeclName}
      {params : List DIndGArtifactTerm}
      {motive : DIndGArtifactTerm}
      {cases : List (DeclName × DIndGArtifactTerm)}
      {indices : List DIndGArtifactTerm}
      {scrutinee : DIndGArtifactTerm}
      (hFamily : cicStage3RawNameWithPropToType0WitnessBounded familyName) :
      CicStage3NfSoundnessFrontier
        (.indG familyName params motive cases indices scrutinee)
  | piDomain {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : CicStage3NfSoundnessFrontier rawDomain)
      (hBody : CicStage3RawTermTranslationVisibleNamesBounded rawBody) :
      CicStage3NfSoundnessFrontier (.pi rawDomain rawBody)
  | piBody {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : CicStage3ResolvedNfTerm rawDomain)
      (hBody : CicStage3NfSoundnessFrontier rawBody) :
      CicStage3NfSoundnessFrontier (.pi rawDomain rawBody)
  | lamDomain {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : CicStage3NfSoundnessFrontier rawDomain)
      (hBody : CicStage3RawTermTranslationVisibleNamesBounded rawBody) :
      CicStage3NfSoundnessFrontier (.lam rawDomain rawBody)
  | lamBody {rawDomain rawBody : DIndGArtifactTerm}
      (hDomain : CicStage3ResolvedNfTerm rawDomain)
      (hBody : CicStage3NfSoundnessFrontier rawBody) :
      CicStage3NfSoundnessFrontier (.lam rawDomain rawBody)

theorem cicStage3_visible_bounded_resolved_or_frontier
    {raw : DIndGArtifactTerm}
    (h : CicStage3RawTermTranslationVisibleNamesBounded raw) :
    CicStage3ResolvedNfTerm raw ∨ CicStage3NfSoundnessFrontier raw := by
  induction h with
  | var index =>
      exact Or.inl (CicStage3ResolvedNfTerm.var index)
  | srt sort =>
      exact Or.inl (CicStage3ResolvedNfTerm.srt sort)
  | con hName =>
      exact Or.inl (CicStage3ResolvedNfTerm.con hName)
  | defn hName =>
      rename_i name
      by_cases hWitness : name = cicStage3PropToType0WitnessName
      · subst name
        exact Or.inl CicStage3ResolvedNfTerm.witnessDefn
      · exact Or.inr (CicStage3NfSoundnessFrontier.defn hName hWitness)
  | pi hDomain hBody ihDomain ihBody =>
      rcases ihDomain with hDomainResolved | hDomainFrontier
      · rcases ihBody with hBodyResolved | hBodyFrontier
        · exact Or.inl
            (CicStage3ResolvedNfTerm.pi hDomainResolved hBodyResolved)
        · exact Or.inr
            (CicStage3NfSoundnessFrontier.piBody
              hDomainResolved hBodyFrontier)
      · exact Or.inr
          (CicStage3NfSoundnessFrontier.piDomain
            hDomainFrontier hBody)
  | lam hDomain hBody ihDomain ihBody =>
      rcases ihDomain with hDomainResolved | hDomainFrontier
      · rcases ihBody with hBodyResolved | hBodyFrontier
        · exact Or.inl
            (CicStage3ResolvedNfTerm.lam hDomainResolved hBodyResolved)
        · exact Or.inr
            (CicStage3NfSoundnessFrontier.lamBody
              hDomainResolved hBodyFrontier)
      · exact Or.inr
          (CicStage3NfSoundnessFrontier.lamDomain
            hDomainFrontier hBody)
  | app hFn hArg _ _ =>
      exact Or.inr (CicStage3NfSoundnessFrontier.app hFn hArg)
  | indG hFamily =>
      exact Or.inr (CicStage3NfSoundnessFrontier.indG hFamily)
  | bad reason =>
      exact Or.inl (CicStage3ResolvedNfTerm.bad reason)

theorem cicStage3_translated_resolved_or_frontier
    {n : Nat} {raw : DIndGArtifactTerm} {term : PureTm n}
    (h :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness n raw term) :
    CicStage3ResolvedNfTerm raw ∨ CicStage3NfSoundnessFrontier raw := by
  exact
    cicStage3_visible_bounded_resolved_or_frontier
      (cicStage3RawTermTranslatesWithPropToType0Witness_visible_names_bounded h)

theorem cicStage3_translated_not_bad
    {n : Nat} {raw : DIndGArtifactTerm} {term : PureTm n}
    (h :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness n raw term) :
    ∀ reason, raw ≠ .bad reason := by
  intro reason hBad
  subst raw
  cases h

theorem cicStage3_resolved_nf_term_not_frontier
    {raw : DIndGArtifactTerm}
    (hResolved : CicStage3ResolvedNfTerm raw) :
    ¬ CicStage3NfSoundnessFrontier raw := by
  induction hResolved with
  | var k =>
      intro hFrontier
      cases hFrontier
  | srt sort =>
      intro hFrontier
      cases hFrontier
  | con hName =>
      intro hFrontier
      cases hFrontier
  | witnessDefn =>
      intro hFrontier
      cases hFrontier with
      | defn hName hNotWitness =>
          exact hNotWitness rfl
  | bad reason =>
      intro hFrontier
      cases hFrontier
  | pi hDomain hBody ihDomain ihBody =>
      intro hFrontier
      cases hFrontier with
      | piDomain hDomainFrontier _ =>
          exact ihDomain hDomainFrontier
      | piBody _ hBodyFrontier =>
          exact ihBody hBodyFrontier
  | lam hDomain hBody ihDomain ihBody =>
      intro hFrontier
      cases hFrontier with
      | lamDomain hDomainFrontier _ =>
          exact ihDomain hDomainFrontier
      | lamBody _ hBodyFrontier =>
          exact ihBody hBodyFrontier

theorem cicStage3_translated_not_frontier_iff_resolved
    {n : Nat} {raw : DIndGArtifactTerm} {term : PureTm n}
    (h :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness n raw term) :
    ¬ CicStage3NfSoundnessFrontier raw ↔ CicStage3ResolvedNfTerm raw := by
  constructor
  · intro hNotFrontier
    rcases cicStage3_translated_resolved_or_frontier h with
      hResolved | hFrontier
    · exact hResolved
    · exact False.elim (hNotFrontier hFrontier)
  · intro hResolved hFrontier
    exact cicStage3_resolved_nf_term_not_frontier hResolved hFrontier

theorem cicStage3RawIdentityWitness_resolved_nf_term :
    CicStage3ResolvedNfTerm cicStage3RawIdentityWitness := by
  simpa [cicStage3RawIdentityWitness] using
    (CicStage3ResolvedNfTerm.lam
      (CicStage3ResolvedNfTerm.srt .type)
      (CicStage3ResolvedNfTerm.lam
        (CicStage3ResolvedNfTerm.srt .type)
        (CicStage3ResolvedNfTerm.var 0)))

/-- The executable Stage-3 `nf` result shape for resolved terms.

All equality-fragment constructors return themselves. The concrete
`Prop -> Type 0` witness definition returns the identity witness body, matching
the runtime delta bridge rather than pretending that `Def` is a normal form. -/
inductive CicStage3ResolvedNfRuntimeOutput :
    DIndGArtifactTerm → DIndGArtifactTerm → Prop where
  | var (k : Nat) :
      CicStage3ResolvedNfRuntimeOutput (.var k) (.var k)
  | srt (sort : DIndGArtifactSort) :
      CicStage3ResolvedNfRuntimeOutput (.srt sort) (.srt sort)
  | con {name : DeclName}
      (hName : cicStage3RawNameWithPropToType0WitnessBounded name) :
      CicStage3ResolvedNfRuntimeOutput (.con name) (.con name)
  | witnessDefn :
      CicStage3ResolvedNfRuntimeOutput
        (.defn cicStage3PropToType0WitnessName)
        cicStage3RawIdentityWitness
  | bad (reason : String) :
      CicStage3ResolvedNfRuntimeOutput (.bad reason) (.bad reason)
  | pi {rawDomain rawBody nfDomain nfBody : DIndGArtifactTerm}
      (hDomain :
        CicStage3ResolvedNfRuntimeOutput rawDomain nfDomain)
      (hBody :
        CicStage3ResolvedNfRuntimeOutput rawBody nfBody) :
      CicStage3ResolvedNfRuntimeOutput
        (.pi rawDomain rawBody) (.pi nfDomain nfBody)
  | lam {rawDomain rawBody nfDomain nfBody : DIndGArtifactTerm}
      (hDomain :
        CicStage3ResolvedNfRuntimeOutput rawDomain nfDomain)
      (hBody :
        CicStage3ResolvedNfRuntimeOutput rawBody nfBody) :
      CicStage3ResolvedNfRuntimeOutput
        (.lam rawDomain rawBody) (.lam nfDomain nfBody)

theorem cicStage3_resolved_nf_runtime_output_input_resolved
    {raw rawNf : DIndGArtifactTerm}
    (hOut : CicStage3ResolvedNfRuntimeOutput raw rawNf) :
    CicStage3ResolvedNfTerm raw := by
  induction hOut with
  | var k =>
      exact CicStage3ResolvedNfTerm.var k
  | srt sort =>
      exact CicStage3ResolvedNfTerm.srt sort
  | con hName =>
      exact CicStage3ResolvedNfTerm.con hName
  | witnessDefn =>
      exact CicStage3ResolvedNfTerm.witnessDefn
  | bad reason =>
      exact CicStage3ResolvedNfTerm.bad reason
  | pi hDomain hBody ihDomain ihBody =>
      exact CicStage3ResolvedNfTerm.pi ihDomain ihBody
  | lam hDomain hBody ihDomain ihBody =>
      exact CicStage3ResolvedNfTerm.lam ihDomain ihBody

theorem cicStage3_resolved_nf_runtime_output_resolved
    {raw rawNf : DIndGArtifactTerm}
    (hOut : CicStage3ResolvedNfRuntimeOutput raw rawNf) :
    CicStage3ResolvedNfTerm rawNf := by
  induction hOut with
  | var k =>
      exact CicStage3ResolvedNfTerm.var k
  | srt sort =>
      exact CicStage3ResolvedNfTerm.srt sort
  | con hName =>
      exact CicStage3ResolvedNfTerm.con hName
  | witnessDefn =>
      exact cicStage3RawIdentityWitness_resolved_nf_term
  | bad reason =>
      exact CicStage3ResolvedNfTerm.bad reason
  | pi hDomain hBody ihDomain ihBody =>
      exact CicStage3ResolvedNfTerm.pi ihDomain ihBody
  | lam hDomain hBody ihDomain ihBody =>
      exact CicStage3ResolvedNfTerm.lam ihDomain ihBody

theorem cicStage3_resolved_nf_term_visible_bounded
    {raw : DIndGArtifactTerm}
    (h : CicStage3ResolvedNfTerm raw) :
    CicStage3RawTermTranslationVisibleNamesBounded raw := by
  induction h with
  | var k =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.var k
  | srt sort =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.srt sort
  | con hName =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.con hName
  | witnessDefn =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.defn (by
        simp [cicStage3RawNameWithPropToType0WitnessBounded])
  | bad reason =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.bad reason
  | pi hDomain hBody ihDomain ihBody =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.pi ihDomain ihBody
  | lam hDomain hBody ihDomain ihBody =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.lam ihDomain ihBody

theorem cicStage3_nf_soundness_frontier_visible_bounded
    {raw : DIndGArtifactTerm}
    (h : CicStage3NfSoundnessFrontier raw) :
    CicStage3RawTermTranslationVisibleNamesBounded raw := by
  induction h with
  | defn hName _hNotWitness =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.defn hName
  | app hFn hArg =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.app hFn hArg
  | indG hFamily =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.indG hFamily
  | piDomain _hDomain hBody ihDomain =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.pi ihDomain hBody
  | piBody hDomain _hBody ihBody =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.pi
        (cicStage3_resolved_nf_term_visible_bounded hDomain) ihBody
  | lamDomain _hDomain hBody ihDomain =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.lam ihDomain hBody
  | lamBody hDomain _hBody ihBody =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.lam
        (cicStage3_resolved_nf_term_visible_bounded hDomain) ihBody

/-- The executable `nf` readout shape after the resolved/frontier split.

Resolved leaves return encoded artifact terms. Frontier leaves remain inert
`nf` control syntax; recursive `Pi`/`Lam` readouts expose the child readouts
without assuming that every successful runtime value is a `termAtom`. -/
inductive CicStage3NfRuntimeReadout :
    DIndGArtifactSig → DIndGArtifactTerm → Metta.Atom → Prop where
  | resolved {sig : DIndGArtifactSig} {raw rawNf : DIndGArtifactTerm}
      (hOut : CicStage3ResolvedNfRuntimeOutput raw rawNf) :
      CicStage3NfRuntimeReadout sig raw (termAtom rawNf)
  | defnStuck {sig : DIndGArtifactSig} {name : DeclName}
      {bodyQuery : Metta.Atom}
      (hName : cicStage3RawNameWithPropToType0WitnessBounded name)
      (hNotWitness : name ≠ cicStage3PropToType0WitnessName)
      (hBodyClosed : bodyQuery.vars = [])
      (hBodyNoErr : bodyQuery.isError = false) :
      CicStage3NfRuntimeReadout sig (.defn name)
        (mExpr "nf" [sigAtom sig, bodyQuery])
  | appStuck {sig : DIndGArtifactSig} {fn arg : DIndGArtifactTerm}
      (hFn : CicStage3RawTermTranslationVisibleNamesBounded fn)
      (hArg : CicStage3RawTermTranslationVisibleNamesBounded arg) :
      CicStage3NfRuntimeReadout sig (.app fn arg)
        (nfQuery sig (.app fn arg))
  | indGStuck {sig : DIndGArtifactSig}
      {familyName : DeclName}
      {params : List DIndGArtifactTerm}
      {motive : DIndGArtifactTerm}
      {cases : List (DeclName × DIndGArtifactTerm)}
      {indices : List DIndGArtifactTerm}
      {scrutinee : DIndGArtifactTerm}
      (hFamily : cicStage3RawNameWithPropToType0WitnessBounded familyName) :
      CicStage3NfRuntimeReadout sig
        (.indG familyName params motive cases indices scrutinee)
        (nfQuery sig
          (.indG familyName params motive cases indices scrutinee))
  | pi {sig : DIndGArtifactSig}
      {rawDomain rawBody : DIndGArtifactTerm}
      {domainOut bodyOut : Metta.Atom}
      (hDomain : CicStage3NfRuntimeReadout sig rawDomain domainOut)
      (hBody : CicStage3NfRuntimeReadout sig rawBody bodyOut) :
      CicStage3NfRuntimeReadout sig (.pi rawDomain rawBody)
        (mExpr "Pi" [domainOut, bodyOut])
  | lam {sig : DIndGArtifactSig}
      {rawDomain rawBody : DIndGArtifactTerm}
      {domainOut bodyOut : Metta.Atom}
      (hDomain : CicStage3NfRuntimeReadout sig rawDomain domainOut)
      (hBody : CicStage3NfRuntimeReadout sig rawBody bodyOut) :
      CicStage3NfRuntimeReadout sig (.lam rawDomain rawBody)
        (mExpr "Lam" [domainOut, bodyOut])

theorem CicStage3NfRuntimeReadout_vars_nil
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {out : Metta.Atom}
    (h : CicStage3NfRuntimeReadout sig raw out) :
    out.vars = [] := by
  induction h with
  | resolved hOut =>
      simpa using termAtom_vars_nil _
  | defnStuck hName hNotWitness hBodyClosed hBodyNoErr =>
      simp [sigAtom_vars_nil, hBodyClosed, mExpr, mSym, Metta.Atom.vars]
  | appStuck hFn hArg =>
      simp [nfQuery, sigAtom_vars_nil, termAtom_vars_nil, mExpr, mSym,
        Metta.Atom.vars]
  | indGStuck hFamily =>
      simp [nfQuery, sigAtom_vars_nil, termAtom_vars_nil, mExpr, mSym,
        Metta.Atom.vars]
  | pi hDomain hBody ihDomain ihBody =>
      simp [ihDomain, ihBody, mExpr, mSym, Metta.Atom.vars]
  | lam hDomain hBody ihDomain ihBody =>
      simp [ihDomain, ihBody, mExpr, mSym, Metta.Atom.vars]

theorem CicStage3NfRuntimeReadout_isError_false
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {out : Metta.Atom}
    (h : CicStage3NfRuntimeReadout sig raw out) :
    out.isError = false := by
  induction h with
  | resolved hOut =>
      simpa using termAtom_isError_false _
  | defnStuck hName hNotWitness hBodyClosed hBodyNoErr =>
      simp [mExpr, mSym, Metta.Atom.isError]
  | appStuck hFn hArg =>
      simp [nfQuery, mExpr, mSym, Metta.Atom.isError]
  | indGStuck hFamily =>
      simp [nfQuery, mExpr, mSym, Metta.Atom.isError]
  | pi hDomain hBody ihDomain ihBody =>
      simp [mExpr, mSym, Metta.Atom.isError]
  | lam hDomain hBody ihDomain ihBody =>
      simp [mExpr, mSym, Metta.Atom.isError]

theorem CicStage3NfRuntimeReadout_not_var
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    {out : Metta.Atom}
    (h : CicStage3NfRuntimeReadout sig raw out) :
    ∀ v, out ≠ Metta.Atom.var v := by
  intro v
  cases h with
  | resolved hOut =>
      simpa using termAtom_not_var _ v
  | defnStuck hName hNotWitness hBodyClosed hBodyNoErr =>
      simp [mExpr, mSym]
  | appStuck hFn hArg =>
      simp [nfQuery, mExpr, mSym]
  | indGStuck hFamily =>
      simp [nfQuery, mExpr, mSym]
  | pi hDomain hBody =>
      simp [mExpr, mSym]
  | lam hDomain hBody =>
      simp [mExpr, mSym]

theorem cicStage3_nf_runtime_readout_exists_of_visible_bounded
    {sig : DIndGArtifactSig} {raw : DIndGArtifactTerm}
    (h : CicStage3RawTermTranslationVisibleNamesBounded raw) :
    ∃ out, CicStage3NfRuntimeReadout sig raw out := by
  induction h with
  | var index =>
      exact ⟨termAtom (.var index),
        CicStage3NfRuntimeReadout.resolved
          (CicStage3ResolvedNfRuntimeOutput.var index)⟩
  | srt sort =>
      exact ⟨termAtom (.srt sort),
        CicStage3NfRuntimeReadout.resolved
          (CicStage3ResolvedNfRuntimeOutput.srt sort)⟩
  | @con name hName =>
      exact ⟨termAtom (.con name),
        CicStage3NfRuntimeReadout.resolved
          (CicStage3ResolvedNfRuntimeOutput.con hName)⟩
  | @defn name hName =>
      by_cases hWitness : name = cicStage3PropToType0WitnessName
      · subst name
        exact ⟨termAtom cicStage3RawIdentityWitness,
          CicStage3NfRuntimeReadout.resolved
            CicStage3ResolvedNfRuntimeOutput.witnessDefn⟩
      · exact ⟨mExpr "nf"
            [sigAtom sig, defBodyOfQueryAtom (sigAtom sig) (declNameAtom name)],
          CicStage3NfRuntimeReadout.defnStuck hName hWitness
            (by
              simp [defBodyOfQueryAtom, sigAtom_vars_nil, declNameAtom_vars_nil,
                mExpr, mSym, Metta.Atom.vars])
            (by
              simp [defBodyOfQueryAtom, mExpr, mSym, Metta.Atom.isError])⟩
  | pi hDomain hBody ihDomain ihBody =>
      rcases ihDomain with ⟨domainOut, hDomainOut⟩
      rcases ihBody with ⟨bodyOut, hBodyOut⟩
      exact ⟨mExpr "Pi" [domainOut, bodyOut],
        CicStage3NfRuntimeReadout.pi hDomainOut hBodyOut⟩
  | lam hDomain hBody ihDomain ihBody =>
      rcases ihDomain with ⟨domainOut, hDomainOut⟩
      rcases ihBody with ⟨bodyOut, hBodyOut⟩
      exact ⟨mExpr "Lam" [domainOut, bodyOut],
        CicStage3NfRuntimeReadout.lam hDomainOut hBodyOut⟩
  | app hFn hArg ihFn ihArg =>
      exact ⟨nfQuery sig (.app _ _),
        CicStage3NfRuntimeReadout.appStuck hFn hArg⟩
  | indG hFamily =>
      exact ⟨nfQuery sig (.indG _ _ _ _ _ _),
        CicStage3NfRuntimeReadout.indGStuck hFamily⟩
  | bad reason =>
      exact ⟨termAtom (.bad reason),
        CicStage3NfRuntimeReadout.resolved
          (CicStage3ResolvedNfRuntimeOutput.bad reason)⟩

private def cicStage3NonWitnessDefnStuckReadout
    (name : DeclName) : Metta.Atom :=
  mExpr "nf"
    [ sigAtom cicStage3RawArtifactSigWithPropToType0Witness
    , defBodyOfQueryAtom (sigAtom cicStage3RawArtifactSig)
        (declNameAtom name) ]

theorem cicStage3_nonWitness_defn_runtime_readout_withPropToType0Witness
    {name : DeclName}
    (hName : cicStage3RawNameWithPropToType0WitnessBounded name)
    (hNotWitness : name ≠ cicStage3PropToType0WitnessName) :
    CicStage3NfRuntimeReadout
      cicStage3RawArtifactSigWithPropToType0Witness
      (.defn name)
      (cicStage3NonWitnessDefnStuckReadout name) := by
  refine CicStage3NfRuntimeReadout.defnStuck hName hNotWitness ?_ ?_
  · simp [defBodyOfQueryAtom, sigAtom_vars_nil, declNameAtom_vars_nil,
      mExpr, mSym, Metta.Atom.vars]
  · simp [defBodyOfQueryAtom, mExpr, mSym, Metta.Atom.isError]

/-- Canonical witness-signature `nf` readouts after the resolved/frontier
split.

The generic `CicStage3NfRuntimeReadout` relation intentionally permits any
closed, non-error `bodyQuery` at a stuck definition frontier. The conv
composition needs the executable witness-signature shape instead, so this
relation pins the non-witness definition readout to the same canonical query
used by the evaluator. -/
inductive CicStage3CanonicalNfRuntimeReadout :
    DIndGArtifactTerm → Metta.Atom → Prop where
  | resolved {raw rawNf : DIndGArtifactTerm}
      (hOut : CicStage3ResolvedNfRuntimeOutput raw rawNf) :
      CicStage3CanonicalNfRuntimeReadout raw (termAtom rawNf)
  | defnStuck {name : DeclName}
      (hName : cicStage3RawNameWithPropToType0WitnessBounded name)
      (hNotWitness : name ≠ cicStage3PropToType0WitnessName) :
      CicStage3CanonicalNfRuntimeReadout (.defn name)
        (cicStage3NonWitnessDefnStuckReadout name)
  | appStuck {fn arg : DIndGArtifactTerm}
      (hFn : CicStage3RawTermTranslationVisibleNamesBounded fn)
      (hArg : CicStage3RawTermTranslationVisibleNamesBounded arg) :
      CicStage3CanonicalNfRuntimeReadout (.app fn arg)
        (nfQuery cicStage3RawArtifactSigWithPropToType0Witness (.app fn arg))
  | indGStuck {familyName : DeclName}
      {params : List DIndGArtifactTerm}
      {motive : DIndGArtifactTerm}
      {cases : List (DeclName × DIndGArtifactTerm)}
      {indices : List DIndGArtifactTerm}
      {scrutinee : DIndGArtifactTerm}
      (hFamily : cicStage3RawNameWithPropToType0WitnessBounded familyName) :
      CicStage3CanonicalNfRuntimeReadout
        (.indG familyName params motive cases indices scrutinee)
        (nfQuery cicStage3RawArtifactSigWithPropToType0Witness
          (.indG familyName params motive cases indices scrutinee))
  | pi {rawDomain rawBody : DIndGArtifactTerm}
      {domainOut bodyOut : Metta.Atom}
      (hDomain :
        CicStage3CanonicalNfRuntimeReadout rawDomain domainOut)
      (hBody :
        CicStage3CanonicalNfRuntimeReadout rawBody bodyOut) :
      CicStage3CanonicalNfRuntimeReadout (.pi rawDomain rawBody)
        (mExpr "Pi" [domainOut, bodyOut])
  | lam {rawDomain rawBody : DIndGArtifactTerm}
      {domainOut bodyOut : Metta.Atom}
      (hDomain :
        CicStage3CanonicalNfRuntimeReadout rawDomain domainOut)
      (hBody :
        CicStage3CanonicalNfRuntimeReadout rawBody bodyOut) :
      CicStage3CanonicalNfRuntimeReadout (.lam rawDomain rawBody)
        (mExpr "Lam" [domainOut, bodyOut])

theorem CicStage3CanonicalNfRuntimeReadout.toRuntimeReadout
    {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadout raw out) :
    CicStage3NfRuntimeReadout
      cicStage3RawArtifactSigWithPropToType0Witness raw out := by
  induction h with
  | resolved hOut =>
      exact CicStage3NfRuntimeReadout.resolved hOut
  | defnStuck hName hNotWitness =>
      exact
        cicStage3_nonWitness_defn_runtime_readout_withPropToType0Witness
          hName hNotWitness
  | appStuck hFn hArg =>
      exact CicStage3NfRuntimeReadout.appStuck hFn hArg
  | indGStuck hFamily =>
      exact CicStage3NfRuntimeReadout.indGStuck hFamily
  | pi hDomain hBody ihDomain ihBody =>
      exact CicStage3NfRuntimeReadout.pi ihDomain ihBody
  | lam hDomain hBody ihDomain ihBody =>
      exact CicStage3NfRuntimeReadout.lam ihDomain ihBody

theorem CicStage3CanonicalNfRuntimeReadout_vars_nil
    {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadout raw out) :
    out.vars = [] := by
  exact
    CicStage3NfRuntimeReadout_vars_nil
      (CicStage3CanonicalNfRuntimeReadout.toRuntimeReadout h)

theorem CicStage3CanonicalNfRuntimeReadout_isError_false
    {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadout raw out) :
    out.isError = false := by
  exact
    CicStage3NfRuntimeReadout_isError_false
      (CicStage3CanonicalNfRuntimeReadout.toRuntimeReadout h)

theorem CicStage3CanonicalNfRuntimeReadout_floatFree
    {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadout raw out) :
    AtomFloatFree out := by
  induction h with
  | resolved hOut => exact termAtom_floatFree _
  | defnStuck hName hNotWitness =>
      simp [cicStage3NonWitnessDefnStuckReadout, defBodyOfQueryAtom,
        declNameAtom, mExpr, mSym, AtomFloatFree, sigAtom_floatFree]
  | appStuck hFn hArg => exact nfQuery_floatFree _ _
  | indGStuck hFamily => exact nfQuery_floatFree _ _
  | pi hDomain hBody ihDomain ihBody =>
      simp [mExpr, mSym, AtomFloatFree, ihDomain, ihBody]
  | lam hDomain hBody ihDomain ihBody =>
      simp [mExpr, mSym, AtomFloatFree, ihDomain, ihBody]

theorem CicStage3CanonicalNfRuntimeReadout_not_var
    {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadout raw out) :
    ∀ v, out ≠ Metta.Atom.var v := by
  exact
    CicStage3NfRuntimeReadout_not_var
      (CicStage3CanonicalNfRuntimeReadout.toRuntimeReadout h)

theorem CicStage3CanonicalNfRuntimeReadout_visible_bounded
    {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadout raw out) :
    CicStage3RawTermTranslationVisibleNamesBounded raw := by
  induction h with
  | resolved hOut =>
      exact cicStage3_resolved_nf_term_visible_bounded
        (cicStage3_resolved_nf_runtime_output_input_resolved hOut)
  | defnStuck hName _hNotWitness =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.defn hName
  | appStuck hFn hArg =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.app hFn hArg
  | indGStuck hFamily =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.indG hFamily
  | pi _hDomain _hBody ihDomain ihBody =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.pi ihDomain ihBody
  | lam _hDomain _hBody ihDomain ihBody =>
      exact CicStage3RawTermTranslationVisibleNamesBounded.lam ihDomain ihBody

theorem cicStage3_canonical_nf_runtime_readout_exists_of_visible_bounded
    {raw : DIndGArtifactTerm}
    (h : CicStage3RawTermTranslationVisibleNamesBounded raw) :
    ∃ out, CicStage3CanonicalNfRuntimeReadout raw out := by
  induction h with
  | var index =>
      exact ⟨termAtom (.var index),
        CicStage3CanonicalNfRuntimeReadout.resolved
          (CicStage3ResolvedNfRuntimeOutput.var index)⟩
  | srt sort =>
      exact ⟨termAtom (.srt sort),
        CicStage3CanonicalNfRuntimeReadout.resolved
          (CicStage3ResolvedNfRuntimeOutput.srt sort)⟩
  | @con name hName =>
      exact ⟨termAtom (.con name),
        CicStage3CanonicalNfRuntimeReadout.resolved
          (CicStage3ResolvedNfRuntimeOutput.con hName)⟩
  | @defn name hName =>
      by_cases hWitness : name = cicStage3PropToType0WitnessName
      · subst name
        exact ⟨termAtom cicStage3RawIdentityWitness,
          CicStage3CanonicalNfRuntimeReadout.resolved
            CicStage3ResolvedNfRuntimeOutput.witnessDefn⟩
      · exact ⟨cicStage3NonWitnessDefnStuckReadout name,
          CicStage3CanonicalNfRuntimeReadout.defnStuck hName hWitness⟩
  | pi hDomain hBody ihDomain ihBody =>
      rcases ihDomain with ⟨domainOut, hDomainOut⟩
      rcases ihBody with ⟨bodyOut, hBodyOut⟩
      exact ⟨mExpr "Pi" [domainOut, bodyOut],
        CicStage3CanonicalNfRuntimeReadout.pi hDomainOut hBodyOut⟩
  | lam hDomain hBody ihDomain ihBody =>
      rcases ihDomain with ⟨domainOut, hDomainOut⟩
      rcases ihBody with ⟨bodyOut, hBodyOut⟩
      exact ⟨mExpr "Lam" [domainOut, bodyOut],
        CicStage3CanonicalNfRuntimeReadout.lam hDomainOut hBodyOut⟩
  | app hFn hArg ihFn ihArg =>
      exact ⟨nfQuery cicStage3RawArtifactSigWithPropToType0Witness (.app _ _),
        CicStage3CanonicalNfRuntimeReadout.appStuck hFn hArg⟩
  | indG hFamily =>
      exact ⟨nfQuery cicStage3RawArtifactSigWithPropToType0Witness
          (.indG _ _ _ _ _ _),
        CicStage3CanonicalNfRuntimeReadout.indGStuck hFamily⟩
  | bad reason =>
      exact ⟨termAtom (.bad reason),
        CicStage3CanonicalNfRuntimeReadout.resolved
          (CicStage3ResolvedNfRuntimeOutput.bad reason)⟩

theorem CicStage3CanonicalNfRuntimeReadout_resolved_or_frontier
    {raw : DIndGArtifactTerm} {out : Metta.Atom}
    (h : CicStage3CanonicalNfRuntimeReadout raw out) :
    (∃ rawNf,
      out = termAtom rawNf ∧
        CicStage3ResolvedNfRuntimeOutput raw rawNf) ∨
      CicStage3NfSoundnessFrontier raw := by
  induction h with
  | resolved hOut =>
      exact Or.inl ⟨_, rfl, hOut⟩
  | defnStuck hName hNotWitness =>
      exact Or.inr (CicStage3NfSoundnessFrontier.defn hName hNotWitness)
  | appStuck hFn hArg =>
      exact Or.inr (CicStage3NfSoundnessFrontier.app hFn hArg)
  | indGStuck hFamily =>
      exact Or.inr (CicStage3NfSoundnessFrontier.indG hFamily)
  | pi hDomain hBody ihDomain ihBody =>
      rcases ihDomain with hDomainResolved | hDomainFrontier
      · rcases hDomainResolved with ⟨domainNf, hDomainOut, hDomainRun⟩
        rcases ihBody with hBodyResolved | hBodyFrontier
        · rcases hBodyResolved with ⟨bodyNf, hBodyOut, hBodyRun⟩
          subst_vars
          exact Or.inl
            ⟨.pi domainNf bodyNf, by simp [termAtom],
              CicStage3ResolvedNfRuntimeOutput.pi hDomainRun hBodyRun⟩
        · exact Or.inr
            (CicStage3NfSoundnessFrontier.piBody
              (cicStage3_resolved_nf_runtime_output_input_resolved
                hDomainRun)
              hBodyFrontier)
      · exact Or.inr
          (CicStage3NfSoundnessFrontier.piDomain hDomainFrontier
            (CicStage3CanonicalNfRuntimeReadout_visible_bounded hBody))
  | lam hDomain hBody ihDomain ihBody =>
      rcases ihDomain with hDomainResolved | hDomainFrontier
      · rcases hDomainResolved with ⟨domainNf, hDomainOut, hDomainRun⟩
        rcases ihBody with hBodyResolved | hBodyFrontier
        · rcases hBodyResolved with ⟨bodyNf, hBodyOut, hBodyRun⟩
          subst_vars
          exact Or.inl
            ⟨.lam domainNf bodyNf, by simp [termAtom],
              CicStage3ResolvedNfRuntimeOutput.lam hDomainRun hBodyRun⟩
        · exact Or.inr
            (CicStage3NfSoundnessFrontier.lamBody
              (cicStage3_resolved_nf_runtime_output_input_resolved
                hDomainRun)
              hBodyFrontier)
      · exact Or.inr
          (CicStage3NfSoundnessFrontier.lamDomain hDomainFrontier
            (CicStage3CanonicalNfRuntimeReadout_visible_bounded hBody))

def CicStage3CanonicalNfRuntimeReadoutAllResolved : Prop :=
  ∀ {raw : DIndGArtifactTerm} {out : Metta.Atom},
    CicStage3CanonicalNfRuntimeReadout raw out →
    ∃ rawNf,
      out = termAtom rawNf ∧
        CicStage3ResolvedNfRuntimeOutput raw rawNf

theorem cicStage3_nonWitness_defn_stuck_readout_beq_true_name_eq
    {leftName rightName : DeclName}
    (hLeftName :
      cicStage3RawNameWithPropToType0WitnessBounded leftName)
    (hRightName :
      cicStage3RawNameWithPropToType0WitnessBounded rightName)
    (hEq :
      (cicStage3NonWitnessDefnStuckReadout leftName ==
        cicStage3NonWitnessDefnStuckReadout rightName) = true) :
    leftName = rightName := by
  change
    Metta.Atom.beq (cicStage3NonWitnessDefnStuckReadout leftName)
      (cicStage3NonWitnessDefnStuckReadout rightName) = true at hEq
  have hNfPayload :=
    atom_beq_expr_binary_payload_true (tag := "nf")
      (a := sigAtom cicStage3RawArtifactSigWithPropToType0Witness)
      (b := defBodyOfQueryAtom (sigAtom cicStage3RawArtifactSig)
        (declNameAtom leftName))
      (c := sigAtom cicStage3RawArtifactSigWithPropToType0Witness)
      (d := defBodyOfQueryAtom (sigAtom cicStage3RawArtifactSig)
        (declNameAtom rightName))
      (by
        simpa [cicStage3NonWitnessDefnStuckReadout, mExpr, mSym]
          using hEq)
  have hBodyPayload :=
    atom_beq_expr_binary_payload_true (tag := "def-body-of")
      (a := sigAtom cicStage3RawArtifactSig)
      (b := declNameAtom leftName)
      (c := sigAtom cicStage3RawArtifactSig)
      (d := declNameAtom rightName)
      (by
        simpa [defBodyOfQueryAtom, mExpr, mSym] using hNfPayload.2)
  have hString :
      Lean.Name.toString (show Lean.Name from leftName) false =
        Lean.Name.toString (show Lean.Name from rightName) false :=
    by
      have hNameBeq := hBodyPayload.2
      change
        Metta.Atom.beq
          (Metta.Atom.sym
            (Lean.Name.toString (show Lean.Name from leftName) false))
          (Metta.Atom.sym
            (Lean.Name.toString (show Lean.Name from rightName) false)) =
          true at hNameBeq
      simpa [Metta.Atom.beq] using hNameBeq
  rcases hLeftName with
    hNatL | hRecL | hZeroL | hSuccL | hPropL | hUnivL | hTermL | hWitnessL
  all_goals
    rcases hRightName with
      hNatR | hRecR | hZeroR | hSuccR | hPropR | hUnivR | hTermR | hWitnessR
  all_goals
    subst leftName
    subst rightName
    first
    | rfl
    | exact False.elim
        ((by decide :
          Lean.Name.toString _ false ≠ Lean.Name.toString _ false) hString)

theorem dindg_translate_unique_on_defn_withPropToType0Witness
    {n : Nat} {name : DeclName} {left right : PureTm n}
    (hLeft :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness n
        (.defn name) left)
    (hRight :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness n
        (.defn name) right) :
    left = right := by
  rcases cicStage3RawDefnTranslatesWithPropToType0Witness_raw_cases
      hLeft with
    ⟨leanLeft, hLeftTerm, hLeftName, _hLeftCases⟩
  rcases cicStage3RawDefnTranslatesWithPropToType0Witness_raw_cases
      hRight with
    ⟨leanRight, hRightTerm, hRightName, _hRightCases⟩
  subst left
  subst right
  exact congrArg PureTm.const
    (cicStage3RawNameTranslatesWithPropToType0Witness_unique
      hLeftName hRightName)

theorem cicStage3_nonWitness_defn_stuck_readout_beq_true_translates_eq
    {leftName rightName : DeclName}
    {left right : PureTm 0}
    (hLeftName :
      cicStage3RawNameWithPropToType0WitnessBounded leftName)
    (hRightName :
      cicStage3RawNameWithPropToType0WitnessBounded rightName)
    (hEq :
      (cicStage3NonWitnessDefnStuckReadout leftName ==
        cicStage3NonWitnessDefnStuckReadout rightName) = true)
    (hLeft :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness 0
        (.defn leftName) left)
    (hRight :
      DIndGArtifactTermTranslates
        cicStage3RawNameTranslatesWithPropToType0Witness 0
        (.defn rightName) right) :
    left = right := by
  have hNameEq :
      leftName = rightName :=
    cicStage3_nonWitness_defn_stuck_readout_beq_true_name_eq
      hLeftName hRightName hEq
  subst rightName
  exact dindg_translate_unique_on_defn_withPropToType0Witness hLeft hRight

theorem cicStage3RawIdentityWitness_translates_any_depth {n : Nat} :
    DIndGArtifactTermTranslates
      cicStage3RawNameTranslatesWithPropToType0Witness n
      cicStage3RawIdentityWitness
      (Mettapedia.Languages.MeTTa.PureKernel.DeclarationEnv.liftClosed
        (n := n) cicStage3IdentityWitness) := by
  simpa [cicStage3RawIdentityWitness, cicStage3IdentityWitness,
    Mettapedia.Languages.MeTTa.PureKernel.DeclarationEnv.liftClosed,
    Mettapedia.Languages.MeTTa.PureKernel.Renaming.rename,
    Mettapedia.Languages.MeTTa.PureKernel.Renaming.liftRen] using
    (DIndGArtifactTermTranslates.lam
      (nameTranslates := cicStage3RawNameTranslatesWithPropToType0Witness)
      (n := n)
      (rawDomain := (.srt .type))
      (rawBody := (.lam (.srt .type) (.var 0)))
      (domain := (.u0 : PureTm n))
      (body := (.lam (.var ⟨0, by omega⟩) : PureTm (n + 1)))
      DIndGArtifactTermTranslates.srt_type
      (DIndGArtifactTermTranslates.lam
        (nameTranslates := cicStage3RawNameTranslatesWithPropToType0Witness)
        (n := n + 1)
        (rawDomain := (.srt .type))
        (rawBody := (.var 0))
        (domain := (.u0 : PureTm (n + 1)))
        (body := (.var ⟨0, by omega⟩ : PureTm ((n + 1) + 1)))
        DIndGArtifactTermTranslates.srt_type
        (DIndGArtifactTermTranslates.var (by omega))))

theorem cicStage3RawPropToType0WitnessType_nf_frontier :
    CicStage3NfSoundnessFrontier cicStage3RawPropToType0WitnessType := by
  have hBounded :
      CicStage3RawTermTranslationVisibleNamesBounded
        cicStage3RawPropToType0WitnessType :=
    cicStage3RawTermTranslatesWithPropToType0Witness_visible_names_bounded
      cicStage3RawPropToType0WitnessType_translates
  unfold cicStage3RawPropToType0WitnessType
  exact CicStage3NfSoundnessFrontier.piDomain
    (CicStage3NfSoundnessFrontier.app
      (CicStage3RawTermTranslationVisibleNamesBounded.con
        (by
          exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))))
      )
      (CicStage3RawTermTranslationVisibleNamesBounded.con
        (by
          exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))
      ))
    (by
      simpa [cicStage3RawPropToType0WitnessType] using
        (by
          cases hBounded with
          | pi _ hBody => exact hBody))

theorem cicStage3PropToType0Witness_defn_decl_reduces_any_depth
    {n : Nat} :
    RedStarDecl
      (envOfSpecs cicStage3RawArtifactSigWithPropToType0Witness.translatedSpecs)
      ((.const cicStage3PropToType0WitnessName : PureTm n))
      (Mettapedia.Languages.MeTTa.PureKernel.DeclarationEnv.liftClosed
        (n := n) cicStage3IdentityWitness) := by
  have hDelta :
      RedDecl cicStage3PropToType0WitnessDeclEnv
        ((.const cicStage3PropToType0WitnessName : PureTm n))
        (Mettapedia.Languages.MeTTa.PureKernel.DeclarationEnv.liftClosed
          (n := n) cicStage3IdentityWitness) :=
    RedDecl.deltaConst valueOf_cicStage3PropToType0Witness
  simpa [cicStage3RawArtifactSigWithPropToType0Witness,
    cicStage3PropToType0WitnessDeclEnv] using
    (redDecl_to_star hDelta)

inductive CicStage3ResolvedNfDeclTarget :
    (n : Nat) → DIndGArtifactTerm → PureTm n → Prop where
  | var {n index : Nat} (hIndex : index < n) :
      CicStage3ResolvedNfDeclTarget n (.var index) (.var ⟨index, hIndex⟩)
  | srt_type {n : Nat} :
      CicStage3ResolvedNfDeclTarget n (.srt .type) .u0
  | srt_kind {n : Nat} :
      CicStage3ResolvedNfDeclTarget n (.srt .kind) .u1
  | con {n : Nat} {raw lean : DeclName}
      (hName : cicStage3RawNameTranslatesWithPropToType0Witness raw lean) :
      CicStage3ResolvedNfDeclTarget n (.con raw) (.const lean)
  | witnessDefn {n : Nat} :
      CicStage3ResolvedNfDeclTarget n
        (.defn cicStage3PropToType0WitnessName)
        (Mettapedia.Languages.MeTTa.PureKernel.DeclarationEnv.liftClosed
          (n := n) cicStage3IdentityWitness)
  | pi {n : Nat}
      {rawDomain rawBody : DIndGArtifactTerm}
      {domainTarget : PureTm n} {bodyTarget : PureTm (n + 1)}
      (hDomain :
        CicStage3ResolvedNfDeclTarget n rawDomain domainTarget)
      (hBody :
        CicStage3ResolvedNfDeclTarget (n + 1) rawBody bodyTarget) :
      CicStage3ResolvedNfDeclTarget n
        (.pi rawDomain rawBody) (.pi domainTarget bodyTarget)
  | lam {n : Nat}
      {rawDomain rawBody : DIndGArtifactTerm}
      {bodyTarget : PureTm (n + 1)}
      (hBody :
        CicStage3ResolvedNfDeclTarget (n + 1) rawBody bodyTarget) :
      CicStage3ResolvedNfDeclTarget n
        (.lam rawDomain rawBody) (.lam bodyTarget)

theorem cicStage3RawNameTranslatesWithPropToType0Witness_witness_lean
    {lean : DeclName}
    (h :
      cicStage3RawNameTranslatesWithPropToType0Witness
