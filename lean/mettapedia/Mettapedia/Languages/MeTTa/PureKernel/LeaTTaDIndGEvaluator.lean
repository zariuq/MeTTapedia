theorem interpretFuel_kernelDefControlEnv_if_true_root_contains_fuel
    {fuel : Nat} {st : St} (thenA elseA : Metta.Atom)
    (hStatic : st.world.selfExtra = [])
    (hThenClosed : thenA.vars = []) (hElseClosed : elseA.vars = [])
    (hThenNonVar : ∀ w, thenA ≠ Metta.Atom.var w)
    (hElseNonVar : ∀ w, elseA ≠ Metta.Atom.var w)
    (hThenNotFunction : ∀ tail,
      thenA ≠ Metta.Atom.expr (Metta.Atom.sym "function" :: tail)) :
    (thenA,
        (renameBindings (counterSuffix st.counter)
          [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]).reverse) ∈
      (interpretFuel kernelDefControlEnv (fuel + 1) st
        [evalItemNil (mExpr "if" [mBool true, thenA, elseA])] []).1 := by
  let target := mExpr "if" [mBool true, thenA, elseA]
  let coreB : Metta.Bindings :=
    [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA]
  let f := counterSuffix st.counter
  let m : Metta.Bindings := (renameBindings f coreB).reverse
  have hclosedTarget : target.vars = [] := by
    simp [target, mExpr, mSym, mBool, hThenClosed, hElseClosed, Metta.Atom.vars]
  have hclosedB : ClosedValueBindings coreB := by
    exact ClosedValueBindings.val hElseClosed
      (ClosedValueBindings.val hThenClosed ClosedValueBindings.nil)
  have hnodup : (bindingValueKeys coreB).Nodup := by
    simp [coreB, bindingValueKeys]
  have hinst :
      Metta.instantiate [] target =
        Metta.Atom.expr (Metta.Atom.sym "if" :: [mBool true, thenA, elseA]) := by
    simp [target, mExpr, mSym, Metta.instantiate_nil]
  have hsplit :
      kernelDefControlEnv.candidates target = [] ++ ifTrueRulePair :: [ifFalseRulePair] := by
    have hcandidateEq : kernelDefControlEnv.candidates target = kernelEnv.candidates target := by
      simp [MinEnv.candidates, kernelDefControlEnv]
    rw [hcandidateEq]
    simpa [target] using kernelEnv_if_candidates true thenA elseA
  have hmatchCore : coreB ∈ Metta.matchAtoms ifTrueRulePair.1 target := by
    simpa [coreB, target] using
      (by
        rw [if_true_rule_match thenA elseA hThenNonVar hElseNonVar]
        simp :
        [Metta.BindingRel.val "e" elseA, Metta.BindingRel.val "t" thenA] ∈
          Metta.matchAtoms ifTrueRulePair.1 (mExpr "if" [mBool true, thenA, elseA]))
  have hresult :
      Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
        thenA := by
    have hf : Function.Injective f := by
      simpa [f] using counterSuffix_injective st.counter
    have hclosedRen : ClosedValueBindings (renameBindings f coreB) :=
      ClosedValueBindings.rename hclosedB
    have hnodupRen : (bindingValueKeys (renameBindings f coreB)).Nodup := by
      rw [bindingValueKeys_renameBindings]
      exact List.Nodup.map hf hnodup
    have hreverse :
        Metta.instantiate (renameBindings f coreB).reverse
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 :=
      instantiate_reverse_closed_nodup hclosedRen hnodupRen _
    have hbound :
        ∀ v ∈ ifTrueRulePair.2.vars, ∃ t, Metta.Bindings.lookupVal coreB v = some t := by
      intro v hv
      have hv' : v = "t" := by
        simpa [ifTrueRulePair, mVar, Metta.Atom.vars] using hv
      subst v
      exact ⟨thenA, by simp [coreB, Metta.Bindings.lookupVal]⟩
    have hfresh :
        Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate coreB ifTrueRulePair.2 := by
      simpa [f] using
        instantiate_freshenRule_rhs_of_renamed_bindings
          st.counter ifTrueRulePair.1 ifTrueRulePair.2 coreB hbound
    have hcore : Metta.instantiate coreB ifTrueRulePair.2 = thenA :=
      if_true_instantiate_bindings thenA elseA
    calc
      Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 =
          Metta.instantiate (renameBindings f coreB)
            (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2 := by
            simpa [m] using hreverse
      _ = Metta.instantiate coreB ifTrueRulePair.2 := hfresh
      _ = thenA := hcore
  have hnotFunction :
      isFunctionResult
        (Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2) =
        false := by
    rw [hresult]
    cases thenA with
    | expr xs =>
        cases xs with
        | nil => rfl
        | cons h rest =>
            cases h with
            | sym op =>
                by_cases hop : op = "function"
                · subst hop
                  exfalso
                  exact hThenNotFunction rest rfl
                · simp [isFunctionResult]
            | var _ => simp [isFunctionResult]
            | gnd _ => simp [isFunctionResult]
            | expr _ => simp [isFunctionResult]
    | sym _ => rfl
    | var _ => rfl
    | gnd _ => rfl
  have hmem :
      (Metta.instantiate m (freshenRule st.counter ifTrueRulePair.1 ifTrueRulePair.2).2, m) ∈
        (interpretFuel kernelDefControlEnv (fuel + 1) st [evalItemNil target] []).1 := by
    simpa [m, f, coreB, ifTrueRulePair] using
      (interpretFuel_selected_rule_contains_of_env
        (env := kernelDefControlEnv)
        (fuel := fuel) (st := st) (target := target)
        (lhs := ifTrueRulePair.1) (rhs := ifTrueRulePair.2)
        (coreB := coreB) (op := "if")
        (args := [mBool true, thenA, elseA])
        (pre := []) (post := [ifFalseRulePair])
        hStatic hclosedTarget hclosedB hnodup hinst
        (kernelDefControlEnv_callGrounded_if
          ([mBool true, thenA, elseA].map
            (fun a => resolveStates st.world (subTokens st.world a))))
        (by rfl) hsplit hmatchCore hnotFunction)
  have hmem' :
      (thenA, m) ∈
        (interpretFuel kernelDefControlEnv (fuel + 1) st [evalItemNil target] []).1 := by
    simpa [hresult] using hmem
  simpa [target, m, f, coreB] using hmem'

theorem interpretFuel_kernelDefControlEnv_if_false_root_contains_fuel
