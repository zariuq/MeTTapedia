  simp only [List.flatMap_singleton, List.singleton_append]
  rw [ValueBindings.merge_singleton_val_eq_of_not_key
    (ValueBindings.val
      (ValueBindings.val
        (ValueBindings.val
          (ValueBindings.val
            (ValueBindings.val
              (ValueBindings.val (ValueBindings.val ValueBindings.nil)))))))
