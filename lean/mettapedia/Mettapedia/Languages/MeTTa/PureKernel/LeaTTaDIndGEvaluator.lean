/-- Lift the helper root readout through the outer `mettaEval` loop.

This is the `infer-apply-args ArgsNil` analogue of
`nf_evalAtomMin_readout_mem_mettaEval`: the helper is declared as returning
`Atom`, so the root readout is kept inert by the outer expression fold.  The
recursive `nf` call exposed by the helper RHS is handled by the existing `nf`
bridge, not by unfolding the helper trace. -/
theorem infer_apply_args_nil_evalAtomMin_readout_mem_mettaEval
    {sig : DIndGArtifactSig} {rawType : DIndGArtifactTerm} {rootOut : Metta.Atom}
    (hmem : rootOut ∈
      evalAtomMin kernelInferApplyArgsNilEnv 1 (inferApplyArgsNilQuery sig rawType))
    (hembed : isEmbeddedOp rootOut = false)
    (hnotNR : (rootOut == notReducibleA) = false)
    (hnotSelf : (rootOut == inferApplyArgsNilQuery sig rawType) = false) :
    rootOut ∈
      (mettaEval kernelInferApplyArgsNilEnv 1 St.init []
        (inferApplyArgsNilQuery sig rawType)).1.map (·.1) := by
  have hpair :
      ∃ rootBnd,
        (rootOut, rootBnd) ∈
          (interpretFuel kernelInferApplyArgsNilEnv 1 St.init
            [{ stack := atomToStack
                (Metta.Atom.expr [Metta.Atom.sym "eval",
                  inferApplyArgsNilQuery sig rawType]) []
               bnd := [] }] []).1 := by
    unfold evalAtomMin interpretAtom at hmem
    rcases List.mem_map.mp hmem with ⟨p, hp, hpout⟩
    cases p with
    | mk out bnd =>
        cases hpout
        exact ⟨bnd, hp⟩
  rcases hpair with ⟨rootBnd, hrootBnd⟩
  unfold mettaEval
  rw [Metta.instantiate_nil]
  simp only [inferApplyArgsNilQuery, mExpr, mSym] at hrootBnd hnotSelf ⊢
  rw [show typeMismatch kernelInferApplyArgsNilEnv St.init.world "infer-apply-args"
      [sigAtom sig, ctxNilAtom, termAtom rawType, argsAtom []] = none by
    exact kernelInferApplyArgsNilEnv_typeMismatch sig rawType]
  simp [kernelInferApplyArgsNilEnv_argMask, Metta.instantiate_nil]
  cases hpairs : interpretFuel kernelInferApplyArgsNilEnv 1 St.init
      [{ stack := atomToStack
          (Metta.Atom.expr [Metta.Atom.sym "eval",
            Metta.Atom.expr
              [Metta.Atom.sym "infer-apply-args", sigAtom sig, ctxNilAtom,
                termAtom rawType, argsAtom []]]) []
         bnd := [] }] [] with
  | mk pairs st' =>
      have hrootPairs : (rootOut, rootBnd) ∈ pairs := by
        rw [hpairs] at hrootBnd
        simpa using hrootBnd
      have hkeep :
          (rootOut,
              restrictBnd
                ([sigAtom sig, ctxNilAtom, termAtom rawType, argsAtom []].flatMap Metta.Atom.vars)
                ((Metta.Bindings.merge [] rootBnd).head?.getD rootBnd)) ∈
            (pairs.foldl
              (mettaEvalExprRootFoldStep kernelInferApplyArgsNilEnv 0
                ([sigAtom sig, ctxNilAtom, termAtom rawType, argsAtom []].flatMap Metta.Atom.vars)
                (Metta.Atom.expr
                  [Metta.Atom.sym "infer-apply-args", sigAtom sig, ctxNilAtom,
                    termAtom rawType, argsAtom []]) [] ) ([], st')).1 :=
        mettaEval_expr_root_keeps_of_returnsAtom_readout
          kernelInferApplyArgsNilEnv 0
          ([sigAtom sig, ctxNilAtom, termAtom rawType, argsAtom []].flatMap Metta.Atom.vars)
          (Metta.Atom.expr
            [Metta.Atom.sym "infer-apply-args", sigAtom sig, ctxNilAtom,
              termAtom rawType, argsAtom []]) []
          (rootOut, rootBnd) pairs st'
          hrootPairs
          (by
            simpa [inferApplyArgsNilQuery, mExpr, mSym] using
              kernelInferApplyArgsNilEnv_returnsAtom sig rawType)
          hembed hnotNR hnotSelf
      have hnoerr :
          List.find?
              (fun ho : Metta.Atom × Metta.Atom => ho.1.isError && ho.1 != ho.2)
              [(sigAtom sig, sigAtom sig), (ctxNilAtom, ctxNilAtom),
                (termAtom rawType, termAtom rawType), (argsAtom [], argsAtom [])] = none := by
        have hctx : ctxNilAtom.isError = false := by
          simp [ctxNilAtom, mSym, Metta.Atom.isError]
        have hargs : (argsAtom []).isError = false := by
          simp [argsAtom, mSym, Metta.Atom.isError]
        simp [sigAtom_isError_false sig, termAtom_isError_false rawType, hctx, hargs]
      rw [hnoerr]
      simp only
      unfold mettaEvalExprRootFoldStep at hkeep
      exact ⟨_, by simpa [List.flatMap] using hkeep⟩

/-- Runtime-root package for the smallest infer-family helper.

The helper rule `(infer-apply-args sig ctx T ArgsNil) = (nf sig T)` is the
smallest source-aligned infer-family rule that invokes recursive normalization.
