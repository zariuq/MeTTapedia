/-- The same kernel `conv` readout in the extended App rule slice.  The App
body evaluates under this environment, so later App soundness can consume this
lemma directly without a rule-list monotonicity detour. -/
theorem conv_appRules_mops_readout
    (sig : DIndGArtifactSig) (rawLeft rawRight : DIndGArtifactTerm) :
    convReadout sig rawLeft rawRight ∈
      Metta.equalityReductions ⟨kernelAppRules⟩
        (convQuery sig rawLeft rawRight) := by
  rw [Metta.mem_equalityReductions]
  refine ⟨(mExpr "conv" [mVar "sig", mVar "x", mVar "y"],
      mExpr "let"
        [ mVar "nx"
        , mExpr "nf" [mVar "sig", mVar "x"]
        , mExpr "let"
            [ mVar "ny"
            , mExpr "nf" [mVar "sig", mVar "y"]
            , mExpr "if"
                [ mExpr "is-bad" [mVar "nx"]
                , mBool false
                , mExpr "if"
                    [ mExpr "is-bad" [mVar "ny"]
                    , mBool false
                    , mExpr "==" [mVar "nx", mVar "ny"] ] ] ] ]), ?_, ?_⟩
  · simp [Metta.Space.equalityRules, kernelAppRules, ruleInferAppBody,
      inferAppBodyRhs, ruleInferAppDispatch, kernelCoreRules, runtimeDecls,
      ruleConv, ruleIsBad, ruleNfVar, ruleNfSrt, ruleNfCon, ruleNfBad,
      ruleInferSrtType, ruleInferSrtKind, ruleInferBad, mExpr, mSym, mVar,
      mTypeDecl, mBool, mNat]
  · refine ⟨[Metta.BindingRel.val "y" (termAtom rawRight),
        Metta.BindingRel.val "x" (termAtom rawLeft),
        Metta.BindingRel.val "sig" (sigAtom sig)], ?_, ?_⟩
    · rw [conv_rule_match]
      simp
    · simp [conv_instantiate_bindings]

/-- The kernel `conv` rule as a MOPS step in the extended App rule slice. -/
