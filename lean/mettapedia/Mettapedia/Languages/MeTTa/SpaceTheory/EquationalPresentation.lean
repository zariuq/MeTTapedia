import Mettapedia.Languages.MeTTa.SpaceTheory.Presentation
import Mettapedia.GSLT.Equations.PreferredSection

/-!
# Printing the equations of a space

This is the constructor-language presentation, on its own patterns. For
equations on the full MeTTa atom carrier, see `AtomEquations`: names and
scalar payloads are not extra atom positions.

The logical quotient is generated by the written equations, regardless
of their preferences. A printed member is a section of that quotient.
The preference order is only consulted among the members actually
written in the class. A cyclic ground equation can have infinitely many
consequences without making this choice range over infinitely many terms.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.MeTTa.SpaceTheory.EquationalPresentation

open Mettapedia.Languages.MeTTa.OSLFCore (Atom)
open Mettapedia.OSLF.MeTTaIL.Syntax (Pattern LanguageDef)
open Mettapedia.OSLF.MeTTaIL.ContextualStep (BasePremiseEvaluator)
open Mettapedia.GSLT.LanguageDef.EquationSemantics
open Mettapedia.GSLT.LanguageDef.DecidableRelations (FirstOrder)
open Mettapedia.GSLT.LanguageDef.LiveModuleEdits (Order)
open Mettapedia.GSLT.Equations
open Mettapedia.GSLT.Equations.PreferredSection (printed same_print_iff)
open Presentation

def declarations (parts : List Contribution) : List WrittenEquation :=
  parts.filterMap Contribution.written

def preferences (parts : List Contribution) : List (Pattern × Pattern) :=
  (declarations parts).flatMap WrittenEquation.arrows

def writtenTerms (parts : List Contribution) : Finset Pattern :=
  ((declarations parts).flatMap WrittenEquation.terms).toFinset

private theorem arrow_endpoints {written : WrittenEquation} {a b : Pattern}
    (edge : (a, b) ∈ written.arrows) : a ∈ written.terms ∧ b ∈ written.terms := by
  cases orientation : written.preference with
  | indifferent => simp [WrittenEquation.arrows, orientation] at edge
  | rightward =>
    exact Preference.consecutive_inside
      (by simpa [Preference.Edge, WrittenEquation.arrows, orientation] using edge)
  | leftward =>
    have inside := Preference.consecutive_inside (xs := written.terms.reverse)
      (a := a) (b := b) (by simpa [Preference.Edge, WrittenEquation.arrows, orientation] using edge)
    simpa using inside

private theorem written_origin {vars : ConstructorSyntax.Variables}
    {authored : Atoms.Content} {part : Contribution} {written : WrittenEquation}
    (read : contribution? vars authored = some part) (found : part.written = some written) :
    FirstOrder written.anchor ∧ (∀ q ∈ written.members, FirstOrder q) ∧
      part.equations = aliasEquations written.anchor written.members := by
  cases authored with
  | equation pref first second tail =>
    obtain ⟨anchor, head, more⟩ := Option.bind_eq_some_iff.mp read
    obtain ⟨members, rest, result⟩ := Option.bind_eq_some_iff.mp more
    cases result
    obtain rfl := Option.some.inj found
    exact ⟨ConstructorSyntax.ground_term first head,
      ConstructorSyntax.ground_terms (second :: tail) rest, rfl⟩
  | data | definition | directed | assignment | subtype =>
    first
    | contradiction
    | cases read; cases found
    | obtain ⟨_, _, rest⟩ := Option.bind_eq_some_iff.mp read
      obtain ⟨_, _, output⟩ := Option.bind_eq_some_iff.mp rest
      cases output
      cases found

theorem preferences_inside_classes (order : Order) (core : LanguageDef) (base : BasePremiseEvaluator)
    (atoms : List Atom) (vars : ConstructorSyntax.Variables) {parts : List Contribution}
    (loaded : projections? atoms vars = some parts) {a b : Pattern}
    (edge : (a, b) ∈ preferences parts) : EquationEquiv base (assemble order core parts) a b := by
  obtain ⟨written, appears, arrow⟩ := List.mem_flatMap.mp edge
  obtain ⟨part, origin, found⟩ := List.mem_filterMap.mp appears
  obtain ⟨_, _, compiled⟩ :=
    Mettapedia.Data.List.option_mapM_origin (contribution? vars) (atoms.map Atoms.content)
      parts loaded part origin
  obtain ⟨ground, members, equal⟩ := written_origin compiled found
  have inside := arrow_endpoints arrow
  apply aliasEquations_connect base _ written.anchor written.members ground members
  · intro eq member
    apply List.mem_append_right
    exact List.mem_flatMap.mpr ⟨part, origin, equal ▸ member⟩
  · exact inside.1
  · exact inside.2

noncomputable def printIn (order : Order) (core : LanguageDef) (base : BasePremiseEvaluator)
    (parts : List Contribution) (score : Pattern → Nat) (q : Pattern) : Pattern :=
  let e := equationSetoid base (assemble order core parts)
  printed e (writtenTerms parts) (Preference.Edge (preferences parts)) score (Quotient.mk e q)

/-- Even a change to the score or directions of preference cannot
change which logical class is printed. -/
theorem printed_equivalent (order : Order) (core : LanguageDef) (base : BasePremiseEvaluator)
    (parts : List Contribution) (score : Pattern → Nat) (q : Pattern) :
    EquationEquiv base (assemble order core parts) (printIn order core base parts score q) q := by
  let e := equationSetoid base (assemble order core parts)
  change e.r _ _
  exact @Quotient.exact _ e _ _
    (Mettapedia.GSLT.Equations.PreferredSection.printed_section e
      (writtenTerms parts) (Preference.Edge (preferences parts)) score (Quotient.mk e q))

theorem equal_print_iff_equation (order : Order) (core : LanguageDef) (base : BasePremiseEvaluator)
    (parts : List Contribution) (score : Pattern → Nat) (q r : Pattern) :
    printIn order core base parts score q = printIn order core base parts score r ↔
      EquationEquiv base (assemble order core parts) q r :=
  same_print_iff (equationSetoid base (assemble order core parts)) _ _ _ q r

/-- The logical step cannot tell which eligible member was printed.
This conclusion is stronger than forward preservation: printing also
cannot introduce a successor class. Raw inspection is not this step. -/
theorem printed_step_iff (order : Order) (core : LanguageDef) (base : BasePremiseEvaluator)
    (parts : List Contribution) (score : Pattern → Nat) (q r : Pattern) :
    StepModuloEquations base (assemble order core parts) (printIn order core base parts score q)
        (printIn order core base parts score r) ↔
      StepModuloEquations base (assemble order core parts) q r := by
  let e := equationSetoid base (assemble order core parts)
  have left := printed_equivalent order core base parts score q
  have right := printed_equivalent order core base parts score r
  change e.r _ _ at left right
  constructor
  · rintro ⟨redex, result, source, step, target⟩
    exact ⟨redex, result, e.iseqv.trans (e.iseqv.symm left) source, step,
      e.iseqv.trans target right⟩
  · rintro ⟨redex, result, source, step, target⟩
    exact ⟨redex, result, e.iseqv.trans left source, step,
      e.iseqv.trans target (e.iseqv.symm right)⟩

section RawInspection

open Mettapedia.Languages.MeTTa.PeTTa.SpaceSemantics (query)

private def a : Pattern := .apply "A" []
private def b : Pattern := .apply "B" []
private def aAtom : Atom := .symbol "A"
private def bAtom : Atom := .symbol "B"
private def witness : Atom := .symbol "Found"
private def core : LanguageDef := .empty "raw-inspection"
private def withEquality : LanguageDef := { core with equations := aliasEquations a [b] }

/-- Querying a raw space differs from querying its quotient. A space with
only the atom A answers its literal match for A and not its literal match
for B, even in a theory whose equation view identifies A and B. -/
theorem literal_match_does_not_factor_through_equation_classes (base : BasePremiseEvaluator) :
    ¬ ∃ read : Quotient (equationSetoid base withEquality) → List Atom,
      read (Quotient.mk _ a) = query [aAtom] aAtom witness ∧
        read (Quotient.mk _ b) = query [aAtom] bAtom witness := by
  rintro ⟨read, readsA, readsB⟩
  have equal : EquationEquiv base withEquality a b :=
    aliasEquations_connect base withEquality a [b] (.apply (by simp))
      (by simp; exact .apply (by simp)) (List.Subset.refl _) (by simp) (by simp)
  have same := congrArg read (@Quotient.sound _ (equationSetoid base withEquality) _ _ equal)
  rw [readsA, readsB] at same
  exact (show query [aAtom] aAtom witness ≠ query [aAtom] bAtom witness by decide +kernel) same

end RawInspection

end Mettapedia.Languages.MeTTa.SpaceTheory.EquationalPresentation
