noncomputable section

universe uClaim uProof

/-! ## A generic gradual contract for free conversion -/

namespace Generic

/-- Native conversion faces comparable inside one complete-path contract. -/
inductive Face where
  | primitiveStep
  | completePath
  deriving DecidableEq, Repr

def Face.le : Face → Face → Prop
  | .primitiveStep, _ => True
  | .completePath, .completePath => True
  | .completePath, .primitiveStep => False

instance : PartialOrder Face where
  le := Face.le
  le_refl := by
    intro face
    cases face <;> trivial
  le_trans := by
    intro first middle last firstMiddle middleLast
    cases first <;> cases middle <;> cases last <;>
      simp_all [Face.le]
  le_antisymm := by
    intro first second firstSecond secondFirst
    cases first <;> cases second <;> simp_all [Face.le]

/-- Capabilities that distinguish primitive recognition from complete
structural realization. -/
inductive Capability where
  | exactPrimitiveStep
  | certificateFree
  | retainsFallback
  | completeProofRelevantPath
  deriving DecidableEq, Repr

def supports : Face → Capability → Prop
  | _, .exactPrimitiveStep => True
  | _, .certificateFree => True
  | _, .retainsFallback => True
  | .completePath, .completeProofRelevantPath => True
  | .primitiveStep, .completeProofRelevantPath => False

/-- A gradual result either realizes a native path or retains the complete
authored path in the surrounding receipt for fallback. -/
inductive Outcome (NativePath : Type) where
  | realized (path : NativePath)
  | outsideFragment

/-- Route provenance and the complete source path remain observable even when
the selected face realizes the target.  Exact recovery is intrinsic in every
realized receipt rather than being rechecked by the consumer. -/
structure Receipt (AuthoredPath NativePath : Type)
    (backward : NativePath → AuthoredPath) where
  face : Face
  source : AuthoredPath
  outcome : Outcome NativePath
  exact : match outcome with
    | .realized native => backward native = source
    | .outsideFragment => True

namespace Receipt

/-- The exact invariant already stored by a proof-carrying receipt. -/
def Valid {AuthoredPath NativePath : Type}
    {backward : NativePath → AuthoredPath}
    (receipt : Receipt AuthoredPath NativePath backward) : Prop :=
  match receipt.outcome with
  | .realized native => backward native = receipt.source
  | .outsideFragment => True

/-- Reading the invariant from a receipt is projection, not checking. -/
theorem valid {AuthoredPath NativePath : Type}
    {backward : NativePath → AuthoredPath}
    (receipt : Receipt AuthoredPath NativePath backward) : receipt.Valid :=
  receipt.exact

end Receipt

variable {Index : Type}
    {State : Index → Type}
    {AuthoredStep NativeStep :
      {index : Index} → State index → State index → Type}

/-- Exact primitive-step evidence determines an exact complete structural
path equivalence. -/
def completeEquiv
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index) :
    FreeConversion.Path State AuthoredStep source target ≃
      FreeConversion.Path State NativeStep source target :=
  FreeConversion.pathEquivOfStepEquiv
    (State := State) (SourceStep := AuthoredStep)
    (TargetStep := NativeStep) stepEquiv source target

def sourceObject {index : Index} (source target : State index) :
    AdmissionObject where
  Carrier := FreeConversion.Path State AuthoredStep source target
  Meaning := fun _ => True

/-- Exact recovery is enforced by the target carrier itself: every realized
receipt contains its round-trip proof, while every outside-fragment receipt
retains the authored path.  Consequently no second predicate-level checker is
needed at this constructional boundary. -/
def targetObject
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index) : AdmissionObject where
  Carrier := Receipt
    (FreeConversion.Path State AuthoredStep source target)
    (FreeConversion.Path State NativeStep source target)
    (completeEquiv (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv source target).symm
  Meaning := Receipt.Valid

/-- The primitive face realizes exactly one primitive step.  Every composite
path is retained unchanged for the ambient semantics. -/
def primitiveReceipt
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} {source target : State index}
    (path : FreeConversion.Path State AuthoredStep source target) :
    (targetObject (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv source target).Carrier :=
  match path with
    | .step evidence =>
        { face := .primitiveStep
          source := .step evidence
          outcome := .realized
            (completeEquiv (State := State) (AuthoredStep := AuthoredStep)
              (NativeStep := NativeStep) stepEquiv _ _ (.step evidence))
          exact := (completeEquiv (State := State)
            (AuthoredStep := AuthoredStep) (NativeStep := NativeStep)
            stepEquiv _ _).symm_apply_apply (.step evidence) }
    | .refl state =>
        { face := .primitiveStep
          source := .refl state
          outcome := .outsideFragment
          exact := trivial }
    | .symm earlier =>
        { face := .primitiveStep
          source := .symm earlier
          outcome := .outsideFragment
          exact := trivial }
    | .trans first second =>
        { face := .primitiveStep
          source := .trans first second
          outcome := .outsideFragment
          exact := trivial }

def primitiveOperation
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index) :
    sourceObject (State := State) (AuthoredStep := AuthoredStep)
        source target ⟶
      targetObject (State := State) (AuthoredStep := AuthoredStep)
        (NativeStep := NativeStep) stepEquiv source target where
  run := primitiveReceipt (State := State) (AuthoredStep := AuthoredStep)
    (NativeStep := NativeStep) stepEquiv
  preserves := fun path _ =>
    (primitiveReceipt (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv path).valid

/-- The strongest face is the universal structural extension.  Its runner is
only the free fold induced by the primitive-step equivalence. -/
def completeReceipt
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} {source target : State index}
    (path : FreeConversion.Path State AuthoredStep source target) :
    (targetObject (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv source target).Carrier :=
    { face := .completePath
      source := path
      outcome := .realized
        (completeEquiv (State := State) (AuthoredStep := AuthoredStep)
          (NativeStep := NativeStep) stepEquiv source target path)
      exact := (completeEquiv (State := State)
        (AuthoredStep := AuthoredStep) (NativeStep := NativeStep)
        stepEquiv source target).symm_apply_apply path }

def completeOperation
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index) :
    sourceObject (State := State) (AuthoredStep := AuthoredStep)
        source target ⟶
      targetObject (State := State) (AuthoredStep := AuthoredStep)
        (NativeStep := NativeStep) stepEquiv source target where
  run := completeReceipt (State := State) (AuthoredStep := AuthoredStep)
    (NativeStep := NativeStep) stepEquiv
  preserves := fun path _ =>
    (completeReceipt (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv path).valid

def family
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index) :
    RecognizedFamily Face
      (sourceObject (State := State) (AuthoredStep := AuthoredStep)
        source target)
      (targetObject (State := State) (AuthoredStep := AuthoredStep)
        (NativeStep := NativeStep) stepEquiv source target) where
  package
    | .primitiveStep => primitiveOperation (State := State)
        (AuthoredStep := AuthoredStep) (NativeStep := NativeStep)
        stepEquiv source target
    | .completePath => completeOperation (State := State)
        (AuthoredStep := AuthoredStep) (NativeStep := NativeStep)
        stepEquiv source target
  Capability := Capability
  supports := supports
  supports_mono := by
    intro weaker stronger related capability supported
    cases weaker with
    | primitiveStep =>
        cases stronger with
        | primitiveStep => exact supported
        | completePath => cases capability <;> trivial
    | completePath =>
        cases stronger with
        | primitiveStep =>
            change False at related
            exact related.elim
        | completePath => exact supported
  strict_support_gain := by
    intro weaker stronger strict
    cases weaker with
    | primitiveStep =>
        cases stronger with
        | primitiveStep => exact (lt_irrefl _ strict).elim
        | completePath =>
            exact ⟨.completeProofRelevantPath, trivial, by
              simp [supports]⟩
    | completePath =>
        cases stronger with
        | primitiveStep =>
            have impossible := strict.le
            change False at impossible
            exact impossible.elim
        | completePath => exact (lt_irrefl _ strict).elim
  recognized := {.primitiveStep, .completePath}
  licensed := {.primitiveStep, .completePath}
  licensed_subset_recognized := Finset.Subset.rfl
  licensed_nonempty := ⟨.primitiveStep, by simp⟩

theorem order_iff_capability_inclusion
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index) (first second : Face) :
    first ≤ second ↔
      ∀ capability,
        (family (State := State) (AuthoredStep := AuthoredStep)
          (NativeStep := NativeStep) stepEquiv source target).supports
            first capability →
          (family (State := State) (AuthoredStep := AuthoredStep)
            (NativeStep := NativeStep) stepEquiv source target).supports
              second capability := by
  constructor
  · exact fun related capability supported =>
      (family (State := State) (AuthoredStep := AuthoredStep)
        (NativeStep := NativeStep) stepEquiv source target).supports_mono
        related capability supported
  · intro included
    cases first <;> cases second
    · trivial
    · trivial
    · have impossible := included .completeProofRelevantPath
      simp [family, supports] at impossible
    · trivial

theorem family_directed
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index) :
    (family (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv source target).LicensedDirected := by
  intro first _ second _
  refine ⟨.completePath, by simp [family], ?_, ?_⟩
  · cases first <;> trivial
  · cases second <;> trivial

def completeCapabilities : Set Capability := fun capability =>
  capability = .exactPrimitiveStep ∨
    capability = .certificateFree ∨
    capability = .retainsFallback ∨
    capability = .completeProofRelevantPath

def completeRequest
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index) :
    (family (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv source target).CapabilityRequest where
  required := completeCapabilities
  candidates := {.completePath}
  candidates_exact := by
    intro candidate
    cases candidate with
    | primitiveStep =>
        constructor
        · intro impossible
          simp at impossible
        · rintro ⟨_, supportsRequired⟩
          have impossible := supportsRequired .completeProofRelevantPath (by
            change Capability.completeProofRelevantPath =
                Capability.exactPrimitiveStep ∨
              Capability.completeProofRelevantPath =
                Capability.certificateFree ∨
              Capability.completeProofRelevantPath =
                Capability.retainsFallback ∨
              Capability.completeProofRelevantPath =
                Capability.completeProofRelevantPath
            simp)
          simp [family, supports] at impossible
    | completePath =>
        constructor
        · intro _
          refine ⟨by simp [family], ?_⟩
          intro capability required
          change capability = .exactPrimitiveStep ∨
            capability = .certificateFree ∨
            capability = .retainsFallback ∨
            capability = .completeProofRelevantPath at required
          rcases required with rfl | rfl | rfl | rfl <;> trivial
        · intro _
          simp
  candidates_nonempty := by simp

def completeSelection
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index) :
    (completeRequest (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv source target)
        |>.StrongestNativeCalculusPrinciple where
  val := .completePath
  property := by
    constructor
    · simp [RecognizedFamily.CapabilityRequest.restrictedFamily,
        completeRequest]
    · intro candidate candidateMember
      have candidateEqual : candidate = .completePath := by
        simpa [RecognizedFamily.CapabilityRequest.restrictedFamily,
          completeRequest] using candidateMember
      subst candidate
      exact le_rfl

theorem completeRequest_uniqueStrongest
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index) :
    ∃! chosen,
      (completeRequest (State := State) (AuthoredStep := AuthoredStep)
        (NativeStep := NativeStep) stepEquiv source target).restrictedFamily
        |>.IsGreatestLicensed chosen :=
  (completeRequest (State := State) (AuthoredStep := AuthoredStep)
    (NativeStep := NativeStep) stepEquiv source target).existsUnique_strongest
    (family_directed (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv source target)

@[simp] theorem selected_face
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index)
    (path : FreeConversion.Path State AuthoredStep source target) :
    (((completeRequest (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv source target).strongestOperation
      (completeSelection (State := State) (AuthoredStep := AuthoredStep)
        (NativeStep := NativeStep) stepEquiv source target)).run path).face =
        Face.completePath :=
  rfl

@[simp] theorem selected_outcome
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} (source target : State index)
    (path : FreeConversion.Path State AuthoredStep source target) :
    (((completeRequest (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv source target).strongestOperation
      (completeSelection (State := State) (AuthoredStep := AuthoredStep)
        (NativeStep := NativeStep) stepEquiv source target)).run path).outcome =
        Outcome.realized
          (completeEquiv (State := State) (AuthoredStep := AuthoredStep)
            (NativeStep := NativeStep) stepEquiv source target path) :=
  rfl

/-- A primitive exact kernel is not falsely advertised as complete: a
composite path reaches the explicit fallback branch. -/
@[simp] theorem primitive_trans_is_outsideFragment
    (stepEquiv : ∀ {index : Index} (source target : State index),
      AuthoredStep source target ≃ NativeStep source target)
    {index : Index} {source middle target : State index}
    (first : FreeConversion.Path State AuthoredStep source middle)
    (second : FreeConversion.Path State AuthoredStep middle target) :
    ((primitiveOperation (State := State) (AuthoredStep := AuthoredStep)
      (NativeStep := NativeStep) stepEquiv source target).run
      (.trans first second)).outcome = Outcome.outsideFragment :=
  rfl

end Generic

/-! ## Native indexed-family instance -/

namespace NativeIndexedFamily

open AuthoredIndexedFamilyConversionPath.Canary
open NativeIndexedFamilyNIKAdmittedFlow

def family (presented : PresentedCandidate)
    {index : TypingIndex Tower.Head}
    (source target : (authoredIndexedComputation presented).State index) :=
  Generic.family
    (State := NativeIndexedState presented)
    (AuthoredStep := AuthoredIndexedStep presented)
    (NativeStep := NativeIndexedStep presented)
    (fun source target => authoredNativeStepEquiv presented source target)
    source target

def completeRequest (presented : PresentedCandidate)
    {index : TypingIndex Tower.Head}
    (source target : (authoredIndexedComputation presented).State index) :=
  Generic.completeRequest
    (State := NativeIndexedState presented)
    (AuthoredStep := AuthoredIndexedStep presented)
    (NativeStep := NativeIndexedStep presented)
    (fun source target => authoredNativeStepEquiv presented source target)
    source target

def completeSelection (presented : PresentedCandidate)
    {index : TypingIndex Tower.Head}
    (source target : (authoredIndexedComputation presented).State index) :=
  Generic.completeSelection
    (State := NativeIndexedState presented)
    (AuthoredStep := AuthoredIndexedStep presented)
    (NativeStep := NativeIndexedStep presented)
    (fun source target => authoredNativeStepEquiv presented source target)
    source target

theorem completeRequest_uniqueStrongest (presented : PresentedCandidate)
    {index : TypingIndex Tower.Head}
    (source target : (authoredIndexedComputation presented).State index) :
    ∃! chosen,
      (completeRequest presented source target).restrictedFamily
        |>.IsGreatestLicensed chosen :=
  Generic.completeRequest_uniqueStrongest
    (State := NativeIndexedState presented)
    (AuthoredStep := AuthoredIndexedStep presented)
    (NativeStep := NativeIndexedStep presented)
    (fun source target => authoredNativeStepEquiv presented source target)
    source target

def admitCompletePathAt (presented : PresentedCandidate)
    {index : TypingIndex Tower.Head}
    (source target : (authoredIndexedComputation presented).State index)
    (dependencies : DependencySystem) (revision : dependencies.Revision) :=
  admitStrongestAt (family presented source target)
    (completeRequest presented source target)
    (completeSelection presented source target)
    dependencies revision

namespace Canary

open NativeIndexedFamilyNIKAdmittedFlow.Canary
open NativeIndexedFamilySource

noncomputable def nilAdmission :=
  admitCompletePathAt nativeListPresentedCandidate
    canonicalNilTypedOccurrence.sourceState
    canonicalNilTypedOccurrence.targetState dependencies false

noncomputable def activeNil : nilAdmission.Active false :=
  nilAdmission.activate (dependencies.sameDependencies_refl false)

/-- NIK selects the complete structural lift for the List iota path. -/
theorem nil_selects_complete_path :
    (activeNil.run authoredNilLeftAssociated).face = Generic.Face.completePath ∧
      (activeNil.run authoredNilLeftAssociated).outcome =
        Generic.Outcome.realized
          (authoredToNativePath nativeListPresentedCandidate
            authoredNilLeftAssociated) := by
  constructor <;> rfl

/-- Selection and revision admission add no interior proof replay: the
realized payload is exactly the generic free-conversion lift already used by
the constructional NIK path runner. -/
theorem nil_selected_payload_is_free_conversion_lift :
    (activeNil.run authoredNilLeftAssociated).outcome =
      Generic.Outcome.realized
        ((authoredNativePathEquiv nativeListPresentedCandidate
          canonicalNilTypedOccurrence.sourceState
          canonicalNilTypedOccurrence.targetState).toFun
            authoredNilLeftAssociated) :=
  rfl

/-- The selected receipt exposes its constructional exactness: its realized
native path recovers the complete authored source, not only the endpoints. -/
theorem nil_selected_receipt_recovers_authored_path :
    ∃ native,
      (activeNil.run authoredNilLeftAssociated).outcome =
          Generic.Outcome.realized native ∧
        nativeToAuthoredPath nativeListPresentedCandidate native =
          authoredNilLeftAssociated :=
  ⟨authoredToNativePath nativeListPresentedCandidate
      authoredNilLeftAssociated,
    rfl,
    authored_native_path_roundtrip _ _⟩

/-- The weaker face gives a genuine refusing control on the same composite
path and retains that path verbatim in its receipt. -/
theorem nil_primitive_face_retains_fallback :
    let receipt :=
      (Generic.primitiveOperation
        (State := NativeIndexedState nativeListPresentedCandidate)
        (AuthoredStep := AuthoredIndexedStep nativeListPresentedCandidate)
        (NativeStep := NativeIndexedStep nativeListPresentedCandidate)
        (fun source target => authoredNativeStepEquiv
          nativeListPresentedCandidate source target)
        canonicalNilTypedOccurrence.sourceState
        canonicalNilTypedOccurrence.targetState).run
          authoredNilLeftAssociated
    receipt.outcome = Generic.Outcome.outsideFragment ∧
      receipt.source = authoredNilLeftAssociated := by
  exact ⟨rfl, rfl⟩

/-- A relevant dependency change cannot activate the selected path kernel. -/
theorem stale_nil_has_no_active_selection :
    ¬ Nonempty (nilAdmission.Active true) := by
  rintro ⟨active⟩
  have changed := active.current ()
  simp [dependencies] at changed

end Canary

end NativeIndexedFamily

/-! ## The request-local, not global, conclusion -/

/-- Complete conversion has a unique strongest structural realization, while
an unspecified proof-boundary request still has no strongest face.  NIK may
therefore choose canonically exactly when the requested semantic fibre earns
that choice. -/
theorem strongest_is_request_local
    {Claim : Type uClaim}
    {guest : NativeProofSystem.{uClaim, uProof} Claim}
    (kernel : NativeProofKernel guest)
    (presented : PresentedCandidate)
    {index : TypingIndex Tower.Head}
    (source target : (authoredIndexedComputation presented).State index) :
    (∃! chosen,
      (NativeIndexedFamily.completeRequest presented source target)
        |>.restrictedFamily.IsGreatestLicensed chosen) ∧
      ¬ ∃ chosen,
        (NIKEntryModeSelection.neutralProofRequest kernel)
          |>.restrictedFamily.IsGreatestLicensed chosen :=
  ⟨NativeIndexedFamily.completeRequest_uniqueStrongest
      presented source target,
    NIKEntryModeSelection.neutralProofRequest_noStrongest kernel⟩

