#print axioms Generic.selected_outcome
#print axioms Generic.primitive_trans_is_outsideFragment
#print axioms NativeIndexedFamily.completeRequest_uniqueStrongest
#print axioms NativeIndexedFamily.Canary.nil_selects_complete_path
#print axioms NativeIndexedFamily.Canary.nil_selected_payload_is_free_conversion_lift
#print axioms NativeIndexedFamily.Canary.nil_selected_receipt_recovers_authored_path
#print axioms NativeIndexedFamily.Canary.nil_primitive_face_retains_fallback
#print axioms NativeIndexedFamily.Canary.stale_nil_has_no_active_selection
#print axioms strongest_is_request_local

end

