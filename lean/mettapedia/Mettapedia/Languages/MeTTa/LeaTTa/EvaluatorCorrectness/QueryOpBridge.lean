          (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse ∈
        (queryOp (MinEnv.ofAtomsGT atoms gt) st prev toEval []).1 ∧
      KernelStep atoms gt toEval (instantiate coreB rhs) ∧
      Metta.AlphaEq
        (instantiate (renameBindings (counterSuffix (st.counter + pre.length)) coreB).reverse
          (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.2)
        (instantiate coreB rhs) := by
  have hmatchFresh : renameBindings (counterSuffix (st.counter + pre.length)) coreB ∈
      matchAtoms (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.1 toEval :=
    by
      rw [hcompat]
      exact matchAtoms_freshenRule_lhs_closed_target_mem
        (st.counter + pre.length) hclosedTarget hmatchCore
  exact queryOp_item_and_kernelStep_alpha_of_renamed_closed_coreBinding_reverse
    (hclosedB := hclosedB) (hnodup := hnodup) (hstatic := hstatic)
    (hNotVarHead := hNotVarHead) (hhead := hhead) (hsplit := hsplit)
    (hcompat := hcompat) (hmatchFresh := hmatchFresh) (hmatchCore := hmatchCore)

/-- Fully discharged leaf crossing: for the identity variable rule `$v ↦ $v`, runtime freshening,
empty ambient merge, and loop pruning produce exactly the same target as the certified unfreshened
`KernelStep`, on a closed symbol-headed query. -/
theorem queryOp_item_and_kernelStep_var_id_closed
    {atoms : List Atom} {gt : GroundingTable} {st : St} {prev : Stack}
    {toEval target : Atom} {v : String} {pre post : List (Atom × Atom)}
    (hclosed : target.vars = [])
    (htarget : toEval = target)
    (hstatic : st.world.selfExtra = [])
    (hNotVarHead : isVariableHeaded toEval = false)
    (hhead : ∃ k, headKey toEval = some k)
    (hsplit : (MinEnv.ofAtomsGT atoms gt).candidates toEval =
      pre ++ (Atom.var v, Atom.var v) :: post)
    (hcompat : LegacyFresheningCompatible prev toEval []
      (st.counter + pre.length) (.var v) (.var v)) :
    evalResult prev target [BindingRel.val (counterSuffix (st.counter + pre.length) v) target] ∈
        (queryOp (MinEnv.ofAtomsGT atoms gt) st prev toEval []).1 ∧
      KernelStep atoms gt toEval target := by
  subst toEval
  have htargetNotVar : ∀ w, target ≠ Atom.var w := by
    intro w h
    subst target
    simp [Atom.vars] at hclosed
  have hraw : v ∉ target.vars := by rw [hclosed]; simp
  have hfreshRaw : counterSuffix (st.counter + pre.length) v ∉ target.vars := by
    rw [hclosed]
    simp
  have hmatchFresh :
      [BindingRel.val (counterSuffix (st.counter + pre.length) v) target] ∈
        matchAtoms (freshenRuleAvoiding (st.counter + pre.length)
          (queryOpAvoid prev target []) (Atom.var v) (Atom.var v)).1.1 target := by
    rw [hcompat]
    unfold freshenRule
    simp [Atom.vars, Metta.Subst.apply, Metta.Subst.lookup, counterSuffix,
      matchAtoms_var_closed_mem, hclosed]
  have hmerge :
      [BindingRel.val (counterSuffix (st.counter + pre.length) v) target] ∈
        Bindings.merge [] [BindingRel.val (counterSuffix (st.counter + pre.length) v) target] :=
    singleton_val_mem_merge_empty_left _ _ htargetNotVar
  have hloop :
      Bindings.hasLoop [BindingRel.val (counterSuffix (st.counter + pre.length) v) target] = false :=
    hasLoop_singleton_val_closed_false _ _ hclosed
  have hmatchCore : [BindingRel.val v target] ∈ matchAtoms (Atom.var v) target :=
    matchAtoms_var_closed_mem v target hclosed
  have hpair := queryOp_item_and_kernelStep_of_staticCandidateSplit
    (st := st) (prev := prev) (toEval := target) (lhs := Atom.var v) (rhs := Atom.var v)
    (mb := [BindingRel.val (counterSuffix (st.counter + pre.length) v) target])
    (m := [BindingRel.val (counterSuffix (st.counter + pre.length) v) target])
    (coreB := [BindingRel.val v target]) (pre := pre) (post := post)
    hstatic hNotVarHead hhead hsplit hmatchFresh hmerge hloop hmatchCore
  rw [hcompat] at hpair
  have hinstFresh :
      instantiate [BindingRel.val (counterSuffix (st.counter + pre.length) v) target]
          (Atom.var (counterSuffix (st.counter + pre.length) v)) = target :=
    instantiate_singleton_val_var _ _ hfreshRaw
  constructor
  · simpa [freshenRule_eq_renBy, renBy, hinstFresh] using hpair.1
  · simpa [instantiate_singleton_val_var _ _ hraw] using hpair.2

/-- Fully discharged variable-LHS crossing over a closed symbol-headed query.

This is the one-variable generalization of `queryOp_item_and_kernelStep_var_id_closed`: the RHS may
be any atom whose variables are all the LHS variable `v`. Runtime freshening renames the matcher key
to `v#counter`, empty ambient merge returns that singleton binding, and the executable RHS
instantiation is exactly the certified unfreshened reduct. -/
theorem queryOp_item_and_kernelStep_var_lhs_closed
    {atoms : List Atom} {gt : GroundingTable} {st : St} {prev : Stack}
    {target rhs : Atom} {v : String} {pre post : List (Atom × Atom)}
    (hclosed : target.vars = [])
    (hstatic : st.world.selfExtra = [])
    (hNotVarHead : isVariableHeaded target = false)
    (hhead : ∃ k, headKey target = some k)
    (hsplit : (MinEnv.ofAtomsGT atoms gt).candidates target =
      pre ++ (Atom.var v, rhs) :: post)
    (hcompat : LegacyFresheningCompatible prev target []
      (st.counter + pre.length) (.var v) rhs)
    (hboundVars : ∀ w ∈ rhs.vars, w = v) :
    evalResult prev (instantiate [BindingRel.val v target] rhs)
          [BindingRel.val (counterSuffix (st.counter + pre.length) v) target] ∈
        (queryOp (MinEnv.ofAtomsGT atoms gt) st prev target []).1 ∧
      KernelStep atoms gt target (instantiate [BindingRel.val v target] rhs) := by
  let f := counterSuffix (st.counter + pre.length)
  have hclosedB : ClosedValueBindings [BindingRel.val v target] :=
    ClosedValueBindings.val hclosed ClosedValueBindings.nil
  have hnodup : (bindingValueKeys [BindingRel.val v target]).Nodup := by
    simp [bindingValueKeys]
  have hmatchFresh :
      renameBindings f [BindingRel.val v target] ∈
        matchAtoms (freshenRuleAvoiding (st.counter + pre.length)
          (queryOpAvoid prev target []) (Atom.var v) rhs).1.1 target := by
    rw [hcompat]
    have hfr := freshenRule_eq_renBy (st.counter + pre.length) (Atom.var v) rhs
    rw [hfr]
    simp [renameBindings, f]
    exact matchAtoms_var_closed_mem (counterSuffix (st.counter + pre.length) v) target hclosed
  have hmatchCore : [BindingRel.val v target] ∈ matchAtoms (Atom.var v) target :=
    matchAtoms_var_closed_mem v target hclosed
  have hbound : ∀ w ∈ rhs.vars, ∃ t, Bindings.lookupVal [BindingRel.val v target] w = some t := by
    intro w hw
    have hwv : w = v := hboundVars w hw
    subst hwv
    exact ⟨target, by simp [Bindings.lookupVal]⟩
  simpa [f, renameBindings] using
    (queryOp_item_and_kernelStep_of_renamed_closed_coreBinding_reverse
      (atoms := atoms) (gt := gt) (st := st) (prev := prev)
      (toEval := target) (lhs := Atom.var v) (rhs := rhs)
      (coreB := [BindingRel.val v target]) (pre := pre) (post := post)
      hclosedB hnodup hstatic hNotVarHead hhead hsplit hcompat hmatchFresh hmatchCore hbound)

/-- Open-target variable-LHS crossing.

This is the first positive open-target successor to the closed-target bridge. The extra hypotheses
are exactly the leaf freshness conditions exposed by
`not_matchAtoms_renBy_open_target_rename_all`: the queried target must not be the original rule
variable and must not be the runtime-freshened rule variable. Under those conditions, the matcher
binding still originates on the rule side, empty ambient merge returns the singleton binding, and
the executable freshened RHS instantiates to the certified unfreshened reduct. -/
theorem queryOp_item_and_kernelStep_var_lhs_open
    {atoms : List Atom} {gt : GroundingTable} {st : St} {prev : Stack}
    {target rhs : Atom} {v : String} {pre post : List (Atom × Atom)}
    (hraw : v ∉ target.vars)
    (hfresh : counterSuffix (st.counter + pre.length) v ∉ target.vars)
    (hstatic : st.world.selfExtra = [])
    (hNotVarHead : isVariableHeaded target = false)
    (hhead : ∃ k, headKey target = some k)
    (hsplit : (MinEnv.ofAtomsGT atoms gt).candidates target =
      pre ++ (Atom.var v, rhs) :: post)
    (hcompat : LegacyFresheningCompatible prev target []
      (st.counter + pre.length) (.var v) rhs)
    (hboundVars : ∀ w ∈ rhs.vars, w = v) :
    evalResult prev (instantiate [BindingRel.val v target] rhs)
          [BindingRel.val (counterSuffix (st.counter + pre.length) v) target] ∈
        (queryOp (MinEnv.ofAtomsGT atoms gt) st prev target []).1 ∧
      KernelStep atoms gt target (instantiate [BindingRel.val v target] rhs) := by
  let f := counterSuffix (st.counter + pre.length)
  have htargetNotVar : ∀ w, target ≠ Atom.var w := by
    intro w h
    subst target
    simp [isVariableHeaded] at hNotVarHead
  have hmatchFresh :
      renameBindings f [BindingRel.val v target] ∈
        matchAtoms (freshenRuleAvoiding (st.counter + pre.length)
          (queryOpAvoid prev target []) (Atom.var v) rhs).1.1 target := by
    rw [hcompat]
    rw [freshenRule_eq_renBy]
    simp [renameBindings, f]
    exact matchAtoms_var_not_mem (counterSuffix (st.counter + pre.length) v) target hfresh
      htargetNotVar
  have hmerge :
      renameBindings f [BindingRel.val v target] ∈
        Bindings.merge [] (renameBindings f [BindingRel.val v target]) := by
    simpa [renameBindings, f] using
      singleton_val_mem_merge_empty_left (counterSuffix (st.counter + pre.length) v) target
        htargetNotVar
  have hloop :
      Bindings.hasLoop (renameBindings f [BindingRel.val v target]) = false := by
    simpa [renameBindings, f] using
      hasLoop_singleton_val_not_false (counterSuffix (st.counter + pre.length) v) target hfresh
  have hmatchCore : [BindingRel.val v target] ∈ matchAtoms (Atom.var v) target :=
    matchAtoms_var_not_mem v target hraw htargetNotVar
  have hbound : ∀ w ∈ rhs.vars, ∃ t, Bindings.lookupVal [BindingRel.val v target] w = some t := by
    intro w hw
    have hwv : w = v := hboundVars w hw
    subst hwv
    exact ⟨target, by simp [Bindings.lookupVal]⟩
  have hresult :
      instantiate (renameBindings f [BindingRel.val v target])
          (freshenRuleAvoiding (st.counter + pre.length)
            (queryOpAvoid prev target []) (Atom.var v) rhs).1.2 =
        instantiate [BindingRel.val v target] rhs := by
    rw [hcompat]
    simpa [f] using
      (instantiate_freshenRule_rhs_of_renamed_bindings
        (st.counter + pre.length) (Atom.var v) rhs [BindingRel.val v target]
        (ValueBindings.val ValueBindings.nil)
        (singleton_valueKeysFreshForValues hraw)
        (singleton_renamedValueKeysFreshForValues _ hfresh) hbound)
  simpa [f, renameBindings] using
    (queryOp_item_and_kernelStep_of_staticCandidateSplit_eqResult
      (atoms := atoms) (gt := gt) (st := st) (prev := prev)
      (toEval := target) (lhs := Atom.var v) (rhs := rhs)
      (mb := renameBindings f [BindingRel.val v target])
      (m := renameBindings f [BindingRel.val v target])
      (coreB := [BindingRel.val v target]) (pre := pre) (post := post)
      hstatic hNotVarHead hhead hsplit hmatchFresh hmerge hloop hmatchCore hresult)

/-- Fully discharged variable-free symbolic-rule crossing. If the static candidate `(lhs, rhs)` has
no variables or grounded payloads, then runtime freshening is inert, empty ambient merge/loop pruning
collapses directly, and the executable `queryOp` item composes directly with LeaTTa's certified
`firedReducts`/`KernelStep` semantics.

The theorem still takes the ordinary `matchAtoms lhs toEval` witness as input; it does not recompute a
particular program rule. -/
theorem queryOp_item_and_kernelStep_symbolic_rule_closed
    {atoms : List Atom} {gt : GroundingTable} {st : St} {prev : Stack}
    {toEval lhs rhs : Atom} {pre post : List (Atom × Atom)}
    (hlhs : SymbolicClosed lhs) (hrhs : SymbolicClosed rhs)
    (hmatch : [] ∈ matchAtoms lhs toEval)
    (hstatic : st.world.selfExtra = [])
    (hNotVarHead : isVariableHeaded toEval = false)
    (hhead : ∃ k, headKey toEval = some k)
    (hsplit : (MinEnv.ofAtomsGT atoms gt).candidates toEval = pre ++ (lhs, rhs) :: post) :
    evalResult prev rhs [] ∈
        (queryOp (MinEnv.ofAtomsGT atoms gt) st prev toEval []).1 ∧
      KernelStep atoms gt toEval rhs := by
  have hfr : freshenRule (st.counter + pre.length) lhs rhs = (lhs, rhs) :=
    freshenRule_symbolicClosed_pair_id (st.counter + pre.length) hlhs hrhs
  have hcompat : LegacyFresheningCompatible prev toEval []
      (st.counter + pre.length) lhs rhs := by
    apply legacyFresheningCompatible_of_no_collision
    rw [hfr, SymbolicClosed.vars_nil hlhs, SymbolicClosed.vars_nil hrhs]
    simp
  have hmatchFresh :
      [] ∈ matchAtoms (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.1 toEval := by
    rw [hcompat, hfr]
    exact hmatch
  have hmerge : [] ∈ Bindings.merge [] [] := by
    simp [Bindings.merge]
  have hloop : Bindings.hasLoop [] = false := by
    simp [Bindings.hasLoop, Bindings.vars]
  have hpair := queryOp_item_and_kernelStep_of_staticCandidateSplit
    (st := st) (prev := prev) (toEval := toEval) (lhs := lhs) (rhs := rhs)
    (mb := []) (m := []) (coreB := []) (pre := pre) (post := post)
    hstatic hNotVarHead hhead hsplit hmatchFresh hmerge hloop hmatch
  rw [hcompat] at hpair
  constructor
  · simpa [hfr, Metta.instantiate_nil] using hpair.1
  · simpa [Metta.instantiate_nil] using hpair.2

/-- Fully discharged closed-symbolic identity crossing: for a static candidate `(a, a)` where `a`
is a symbol-only closed atom, executable `queryOp` emits the same result as the certified
unfreshened `KernelStep`.

This is the expression/list analogue of `queryOp_item_and_kernelStep_var_id_closed`; it composes the
generic `queryOp` fold bridge with `firedReducts`/`KernelStep` instead of recomputing a particular
program rule. -/
theorem queryOp_item_and_kernelStep_symbolic_id_closed
    {atoms : List Atom} {gt : GroundingTable} {st : St} {prev : Stack}
    {toEval target : Atom} {pre post : List (Atom × Atom)}
    (hsym : SymbolicClosed target)
    (htarget : toEval = target)
    (hstatic : st.world.selfExtra = [])
    (hNotVarHead : isVariableHeaded toEval = false)
    (hhead : ∃ k, headKey toEval = some k)
    (hsplit : (MinEnv.ofAtomsGT atoms gt).candidates toEval =
      pre ++ (target, target) :: post) :
    evalResult prev target [] ∈
        (queryOp (MinEnv.ofAtomsGT atoms gt) st prev toEval []).1 ∧
      KernelStep atoms gt toEval target := by
  subst toEval
  have hfr : freshenRule (st.counter + pre.length) target target = (target, target) :=
    freshenRule_symbolicClosed_id (st.counter + pre.length) hsym
  have hcompat : LegacyFresheningCompatible prev target []
      (st.counter + pre.length) target target := by
    apply legacyFresheningCompatible_of_no_collision
    rw [hfr, SymbolicClosed.vars_nil hsym]
    simp
  have hmatchFresh :
      [] ∈ matchAtoms (freshenRuleAvoiding (st.counter + pre.length)
        (queryOpAvoid prev target []) target target).1.1 target := by
    rw [hcompat, hfr]
    exact matchAtoms_symbolicClosed_self_empty hsym
  have hmerge : [] ∈ Bindings.merge [] [] := by
    simp [Bindings.merge]
  have hloop : Bindings.hasLoop [] = false := by
    simp [Bindings.hasLoop, Bindings.vars]
  have hmatchCore : [] ∈ matchAtoms target target :=
    matchAtoms_symbolicClosed_self_empty hsym
  have hpair := queryOp_item_and_kernelStep_of_staticCandidateSplit
    (st := st) (prev := prev) (toEval := target) (lhs := target) (rhs := target)
    (mb := []) (m := []) (coreB := []) (pre := pre) (post := post)
    hstatic hNotVarHead hhead hsplit hmatchFresh hmerge hloop hmatchCore
  rw [hcompat] at hpair
  constructor
  · simpa [hfr, Metta.instantiate_nil] using hpair.1
  · simpa [Metta.instantiate_nil] using hpair.2

end Mettapedia.Languages.MeTTa.LeaTTa.EvaluatorCorrectness.QueryOpBridge
