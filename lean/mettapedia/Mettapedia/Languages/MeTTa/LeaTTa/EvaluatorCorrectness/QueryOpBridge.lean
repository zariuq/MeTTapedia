import MettaHyperonFull.Minimal.Stdlib
import MettaHyperonFull.Proofs.Correspondence
import MettaHyperonFull.Proofs.Substitution
import MettaHyperonFull.Proofs.BindingLaws
import MettaHyperonFull.Proofs.CaptureAvoidingFreshening
import Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening

/-!
# Reusable `queryOp` candidate-fold bridge

`Metta.Minimal.queryOp` is the first executable layer above LeaTTa's certified
`KernelStep`/`MopsStep` relation. It does real runtime work that the relation
abstracts away: candidate selection, rule freshening, ambient binding merge, loop
pruning, and item construction.

This module factors the small, reusable fold lemma needed by verified-MeTTa corpus
entries: once a selected candidate contributes a work item at its actual fold
counter, that item is present in the real `queryOp` output. The lemma does not
claim full `mettaEval` scheduler correctness; it is one layer closer to the
running evaluator.
-/

namespace Mettapedia.Languages.MeTTa.LeaTTa.EvaluatorCorrectness.QueryOpBridge

open Metta
open Metta.Minimal
open Mettapedia.Languages.MeTTa.HE.CanonAbsorbsFreshening

/-! ## Static candidate surface -/

/-- When neither mutable nor imported rules have been added to `&self`, the executable candidate
surface `candidatesW` is exactly the pre-indexed static environment used by `KernelStep`. -/
theorem candidatesW_eq_candidates_of_no_selfRules
    (env : MinEnv) (w : World) (toEval : Atom)
    (hExtra : w.selfExtra = []) (hImports : w.selfImports = []) :
    candidatesW env w toEval = env.candidates toEval := by
  unfold candidatesW
  rw [hExtra, hImports]
  simp

/-- Initial evaluation starts in a static world, so `candidatesW` and the certified static
candidate index coincide. -/
theorem candidatesW_init_eq_candidates (env : MinEnv) (toEval : Atom) :
    candidatesW env St.init.world toEval = env.candidates toEval := by
  exact candidatesW_eq_candidates_of_no_selfRules env St.init.world toEval rfl rfl

/-! ## Executable `queryOp` fold surface -/

/-- The finite set of live spellings that executable rule freshening must avoid at a query step. -/
abbrev queryOpAvoid (prev : Stack) (toEval : Atom) (b : Bindings) : List VarName :=
  Metta.Minimal.queryOpAvoid prev toEval b

/-- The one-candidate worklist generated by the executable `queryOp` fold step. -/
abbrev queryOpItemsOfRule (prev : Stack) (toEval : Atom)
    (b : Bindings) (counter : Nat) (p : Atom × Atom) :
    List Item :=
  Metta.Minimal.queryOpItemsOfRule prev toEval b counter p

/-- Exact membership characterization for the one-candidate executable `queryOp` layer. This is
the generic replacement for per-rule unfolding: every emitted item comes from a freshened match,
a surviving ambient merge, and a non-looping instantiated RHS. -/
theorem mem_queryOpItemsOfRule_iff
    (prev : Stack) (toEval : Atom) (b : Bindings) (counter : Nat) (p : Atom × Atom)
    (item : Item) :
    item ∈ queryOpItemsOfRule prev toEval b counter p ↔
      ∃ mb ∈ matchAtoms
          (freshenRuleAvoiding counter (queryOpAvoid prev toEval b) p.1 p.2).1.1 toEval,
        ∃ m ∈ Bindings.merge b mb,
          Bindings.hasLoop m = false ∧
            item = evalResult prev (instantiate m
              (freshenRuleAvoiding counter (queryOpAvoid prev toEval b) p.1 p.2).1.2) m := by
  unfold queryOpItemsOfRule Metta.Minimal.queryOpItemsOfRule
  cases hfr : (freshenRuleAvoiding counter (queryOpAvoid prev toEval b) p.1 p.2).1 with
  | mk lhs' rhs' =>
      simp only [List.mem_flatMap, List.mem_filterMap]
      constructor
      · intro h
        rcases h with ⟨mb, hmb, m, hm, hitem⟩
        by_cases hloop : Bindings.hasLoop m
        · simp [hloop] at hitem
        · simp [hloop] at hitem
          exact ⟨mb, hmb, m, hm, by simpa using hloop, hitem.symm⟩
      · intro h
        rcases h with ⟨mb, hmb, m, hm, hloop, heq⟩
        exact ⟨mb, hmb, m, hm, by simp [hloop, heq]⟩

/-- The accumulator step inside `queryOp`, factored out so membership can be tracked
through the candidate fold directly. -/
abbrev queryOpFoldStep (prev : Stack) (toEval : Atom) (b : Bindings) :
    (List Item × St) → (Atom × Atom) → (List Item × St) :=
  Metta.Minimal.queryOpFoldStep prev toEval b

/-- The compatibility condition for older query lemmas whose witnesses name variables with the
legacy `counterSuffix`. It is deliberately explicit: after the capture-avoidance repair, this
condition is false exactly when the legacy spelling would capture a live variable. -/
abbrev LegacyFresheningCompatible (prev : Stack) (toEval : Atom) (b : Bindings)
    (counter : Nat) (lhs rhs : Atom) : Prop :=
  freshenRuleAvoiding counter (queryOpAvoid prev toEval b) lhs rhs =
    (freshenRule counter lhs rhs, counter + 1)

/-- Disjoint legacy spellings establish compatibility with the repaired query freshener. -/
theorem legacyFresheningCompatible_of_no_collision
    (prev : Stack) (toEval : Atom) (b : Bindings) (counter : Nat) (lhs rhs : Atom)
    (hsafe : ¬ ∃ v ∈ (freshenRule counter lhs rhs).1.vars ++
        (freshenRule counter lhs rhs).2.vars, v ∈ queryOpAvoid prev toEval b) :
    LegacyFresheningCompatible prev toEval b counter lhs rhs :=
  freshenRuleAvoiding_eq_legacy counter (queryOpAvoid prev toEval b) lhs rhs hsafe

/-- Once an item has entered the `queryOp` accumulator, later candidates cannot remove it. -/
theorem queryOpFold_preserves_mem (prev : Stack) (toEval : Atom) (b : Bindings) :
    ∀ cs acc st item,
      item ∈ acc →
        item ∈ ((List.foldl (queryOpFoldStep prev toEval b) (acc, st) cs).1) := by
  intro cs
  induction cs with
  | nil =>
      intro acc st item hmem
      simpa
  | cons _ ps ih =>
      intro acc st item hmem
      simp only [List.foldl_cons]
      exact ih _ _ _ (by simp [hmem])

/-- Processing `n` candidates in `queryOp` advances only the gensym counter by `n`. -/
theorem queryOpFold_counter (prev : Stack) (toEval : Atom) (b : Bindings) :
    ∀ cs acc st,
      ((List.foldl (queryOpFoldStep prev toEval b) (acc, st) cs).2).counter =
        st.counter + List.length cs := by
  intro cs
  induction cs with
  | nil =>
      intro acc st
      simp
  | cons _ ps ih =>
      intro acc st
      simp only [List.foldl_cons, queryOpFoldStep, Metta.Minimal.queryOpFoldStep]
      rw [freshenRuleAvoiding_counter]
      simp [ih, Nat.add_comm, Nat.add_left_comm]

/-- Processing candidates in `queryOp` never mutates the runtime world; it only advances the
fresh-name counter. -/
theorem queryOpFold_world (prev : Stack) (toEval : Atom) (b : Bindings) :
    ∀ cs acc st,
      ((List.foldl (queryOpFoldStep prev toEval b) (acc, st) cs).2).world = st.world := by
  intro cs
  induction cs with
  | nil =>
      intro acc st
      simp
  | cons _ ps ih =>
      intro acc st
      simp only [List.foldl_cons, queryOpFoldStep, Metta.Minimal.queryOpFoldStep]
      exact ih _ _

/-- The executable query layer preserves the runtime world. Candidate scanning freshens rule
variables by bumping the counter, but it does not perform effects such as `add-atom`. -/
theorem queryOp_world (env : MinEnv) (st : St) (prev : Stack) (toEval : Atom) (b : Bindings) :
    (queryOp env st prev toEval b).2.world = st.world := by
  unfold queryOp
  by_cases hvar : isVariableHeaded toEval
  · simp [hvar]
  · simp [hvar]
    let folded := List.foldl (queryOpFoldStep prev toEval b) ([], st)
      (candidatesW env st.world toEval)
    change (if folded.1 = [] then ([finItem prev notReducibleA b], folded.2) else folded).2.world =
      st.world
    by_cases hres : folded.1 = []
    · simp [hres, folded, queryOpFold_world]
    · simp [hres, folded, queryOpFold_world]

/-- `queryOp` depends on the runtime environment only through the candidate list for the atom
being queried. This is the reusable environment-monotonicity boundary: once helper rules are
shown not to change `candidatesW`, the executable query readout is unchanged without unfolding the
scheduler or redoing the matcher proof. -/
theorem queryOp_eq_of_candidatesW_eq
    {env₁ env₂ : MinEnv} {st : St} {prev : Stack} {toEval : Atom} {b : Bindings}
    (hcand : candidatesW env₁ st.world toEval = candidatesW env₂ st.world toEval) :
    queryOp env₁ st prev toEval b = queryOp env₂ st prev toEval b := by
  unfold queryOp
  by_cases hvar : isVariableHeaded toEval
  · simp [hvar]
  · simp [hvar, hcand]

/-- If the candidate list is split as `pre ++ p :: post`, and `p` contributes `item`
when processed at its actual fold counter, then that item survives into the final
candidate-fold result. -/
theorem mem_queryOpFold_of_split_candidate
    (prev : Stack) (toEval : Atom) (b : Bindings) (st : St)
    (pre post : List (Atom × Atom)) (p : Atom × Atom) (item : Item)
    (hitem :
      item ∈ queryOpItemsOfRule prev toEval b (st.counter + pre.length) p) :
    item ∈ (((pre ++ p :: post).foldl (queryOpFoldStep prev toEval b) ([], st)).1) := by
  rw [List.foldl_append]
  let prefixAcc := pre.foldl (queryOpFoldStep prev toEval b) ([], st)
  have hcounter : prefixAcc.2.counter = st.counter + pre.length := by
    simpa [prefixAcc] using queryOpFold_counter prev toEval b pre [] st
  simp only [List.foldl_cons]
  have hseed :
      item ∈ prefixAcc.1 ++ queryOpItemsOfRule prev toEval b prefixAcc.2.counter p := by
    simp [hcounter, hitem]
  exact queryOpFold_preserves_mem prev toEval b post _ _ _ hseed

/-- Operational lift for the executable query layer: once we know the candidate split and that
the selected candidate contributes an item at its actual fold counter, real `queryOp` contains
that item. -/
theorem queryOp_contains_item_of_splitCandidate
    (env : MinEnv) (st : St) (prev : Stack) (toEval : Atom) (b : Bindings)
    {pre post : List (Atom × Atom)} {p : Atom × Atom} {item : Item}
    (hNotVarHead : isVariableHeaded toEval = false)
    (hsplit : candidatesW env st.world toEval = pre ++ p :: post)
    (hitem : item ∈ queryOpItemsOfRule prev toEval b (st.counter + pre.length) p) :
    item ∈ (queryOp env st prev toEval b).1 := by
  have hmemResults :
      item ∈ ((candidatesW env st.world toEval).foldl
          (queryOpFoldStep prev toEval b) ([], st)).1 := by
    rw [hsplit]
    simpa using
      (mem_queryOpFold_of_split_candidate prev toEval b st pre post p item hitem)
  let folded : List Item × St :=
    (candidatesW env st.world toEval).foldl
      (queryOpFoldStep prev toEval b) ([], st)
  have hfoldedMem : item ∈ folded.1 := by
    simpa [folded] using hmemResults
  have hnonempty : folded.1.isEmpty = false := by
    cases hlist : folded.1 with
    | nil =>
        simp [hlist] at hfoldedMem
    | cons _ _ =>
        simp
  have hqueryOpResults :
      (queryOp env st prev toEval b).1 = folded.1 := by
    unfold queryOp
    rw [hNotVarHead]
    change
      (if folded.1.isEmpty then
          ([finItem prev notReducibleA b], folded.2)
        else
          folded).1 = folded.1
    simp [hnonempty]
  rw [hqueryOpResults]
  exact hfoldedMem

/-- If a non-variable-headed query has no executable candidates, real `queryOp` emits
`NotReducible`. This is the no-rule companion to the split-candidate bridge above; constructor
normal forms such as Peano `S` use this branch in the outer `mettaEval` loop. -/
theorem queryOp_contains_notReducible_of_no_candidates
    (env : MinEnv) (st : St) (prev : Stack) (toEval : Atom) (b : Bindings)
    (hNotVarHead : isVariableHeaded toEval = false)
    (hnone : candidatesW env st.world toEval = []) :
    finItem prev notReducibleA b ∈ (queryOp env st prev toEval b).1 := by
  unfold queryOp
  rw [hNotVarHead]
  rw [hnone]
  simp

/-- Exact structural form of the no-candidate query branch. This is not a concrete trace theorem:
it packages the generic branch law used by the full evaluator to treat constructor normal forms as
inert. -/
theorem queryOp_notReducible_of_no_candidates_eq
    (env : MinEnv) (st : St) (prev : Stack) (toEval : Atom) (b : Bindings)
    (hNotVarHead : isVariableHeaded toEval = false)
    (hnone : candidatesW env st.world toEval = []) :
    queryOp env st prev toEval b = ([finItem prev notReducibleA b], st) := by
  unfold queryOp
  rw [hNotVarHead]
  rw [hnone]
  simp

/-- Component form of `queryOp_contains_item_of_splitCandidate`: once a selected candidate has a
freshened match, an ambient merge that survives loop pruning, and an instantiated RHS, the real
executable `queryOp` output contains the corresponding item.

This is the generic replacement for per-rule recomputation of `matchAtoms` in verified-MeTTa
examples. -/
theorem queryOp_contains_instantiated_item_of_splitCandidate
    (env : MinEnv) (st : St) (prev : Stack) (toEval : Atom) (b : Bindings)
    {pre post : List (Atom × Atom)} {p : Atom × Atom}
    {mb m : Bindings}
    (hNotVarHead : isVariableHeaded toEval = false)
    (hsplit : candidatesW env st.world toEval = pre ++ p :: post)
    (hmatch : mb ∈ matchAtoms
      (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval b) p.1 p.2).1.1
        toEval)
    (hmerge : m ∈ Bindings.merge b mb)
    (hloop : Bindings.hasLoop m = false) :
    evalResult prev (instantiate m
      (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval b) p.1 p.2).1.2) m ∈
      (queryOp env st prev toEval b).1 := by
  apply queryOp_contains_item_of_splitCandidate env st prev toEval b hNotVarHead hsplit
  rw [mem_queryOpItemsOfRule_iff]
  exact ⟨mb, hmatch, m, hmerge, hloop, rfl⟩

/-- Static-KB form of `queryOp_contains_instantiated_item_of_splitCandidate`: the candidate split is
stated over the same static index `KernelStep` uses. -/
theorem queryOp_contains_instantiated_item_of_staticCandidateSplit
    (env : MinEnv) (st : St) (prev : Stack) (toEval : Atom) (b : Bindings)
    {pre post : List (Atom × Atom)} {p : Atom × Atom}
    {mb m : Bindings}
    (hstatic : st.world.selfExtra = [])
    (hNotVarHead : isVariableHeaded toEval = false)
    (hsplit : env.candidates toEval = pre ++ p :: post)
    (hmatch : mb ∈ matchAtoms
      (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval b) p.1 p.2).1.1
        toEval)
    (hmerge : m ∈ Bindings.merge b mb)
    (hloop : Bindings.hasLoop m = false) :
    evalResult prev (instantiate m
      (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval b) p.1 p.2).1.2) m ∈
      (queryOp env st prev toEval b).1 := by
  let importedRules : List (Atom × Atom) := st.world.selfImports.filterMap fun x => match x with
    | Atom.expr [Atom.sym "=", lhs, rhs] =>
        match headKey lhs, headKey toEval with
        | some k1, some k2 => if k1 == k2 then some (lhs, rhs) else none
        | none, _ => some (lhs, rhs)
        | _, _ => none
    | _ => none
  apply queryOp_contains_instantiated_item_of_splitCandidate
    (pre := pre) (post := post ++ importedRules) env st prev toEval b hNotVarHead
  · unfold candidatesW
    rw [hstatic, hsplit]
    simp only [List.nil_append, List.append_assoc, List.cons_append, importedRules]
    rfl
  · exact hmatch
  · exact hmerge
  · exact hloop

/-- A split of the static candidate list exposes the selected rule as a candidate. -/
theorem candidate_mem_of_staticCandidateSplit
    (env : MinEnv) (toEval : Atom)
    {pre post : List (Atom × Atom)} {p : Atom × Atom}
    (hsplit : env.candidates toEval = pre ++ p :: post) :
    p ∈ env.candidates toEval := by
  rw [hsplit]
  simp

/-- Every selected static candidate has some prefix/suffix split. The prefix length is the
freshening counter offset used by the executable `queryOp` fold. -/
theorem exists_staticCandidateSplit_of_candidate_mem
    (env : MinEnv) (toEval : Atom) {p : Atom × Atom}
    (hcand : p ∈ env.candidates toEval) :
    ∃ pre post, env.candidates toEval = pre ++ p :: post :=
  List.mem_iff_append.mp hcand

/-! ## Matcher leaf facts for the freshening crossing -/

/-- LeaTTa's executable occurs check agrees with absence from the proof-facing variable list. -/
theorem occurs_eq_false_of_not_mem_vars (v : VarName) :
    ∀ target : Atom, v ∉ target.vars → Subst.occurs v target = false := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s _
    simp [Subst.occurs]
  · intro w hnot
    simp [Atom.vars] at hnot
    simp [Subst.occurs, hnot]
  · intro g _
    simp [Subst.occurs]
  · intro xs ih hnot
    simp only [Subst.occurs, List.any_eq_false]
    intro a ha
    have haNot : v ∉ a.1.vars := by
      intro hv
      apply hnot
      simp only [Atom.vars, List.mem_flatten]
      exact ⟨a.1.vars, List.mem_map.mpr ⟨a.1, a.2, rfl⟩, hv⟩
    simp [ih a.1 a.2 haNot]

/-- A variable pattern matches any closed target with the corresponding value binding. This is the
leaf case of the freshened-matcher crossing used by the interpreter-correctness lift. -/
theorem matchAtoms_var_closed_mem (v : String) (target : Atom)
    (hclosed : target.vars = []) :
    [BindingRel.val v target] ∈ matchAtoms (Atom.var v) target := by
  have hnot : v ∉ target.vars := by rw [hclosed]; simp
  have hloop := Bindings.hasLoop_singleton_val_of_not_mem v target hnot
  cases target with
  | var w => simp [Atom.vars] at hclosed
  | sym s => simp [matchAtoms, matchAtomsWith, Subst.occurs, hloop]
  | gnd g => simp [matchAtoms, matchAtomsWith, Subst.occurs, hloop]
  | expr xs =>
      have hocc : Subst.occurs v (Atom.expr xs) = false :=
        occurs_eq_false_of_not_mem_vars v (Atom.expr xs) hnot
      simp [matchAtoms, matchAtomsWith, hocc, hloop]

/-- Open-target variant of `matchAtoms_var_closed_mem`: a variable pattern matches any target
with the corresponding value binding, except the degenerate same-variable target, where LeaTTa's
matcher returns the empty binding instead. -/
theorem matchAtoms_var_not_mem (v : String) (target : Atom)
    (hnot : v ∉ target.vars) (hnotvar : ∀ w, target ≠ Atom.var w) :
    [BindingRel.val v target] ∈ matchAtoms (Atom.var v) target := by
  have hloop := Bindings.hasLoop_singleton_val_of_not_mem v target hnot
  cases target with
  | var w =>
      exact (hnotvar w rfl).elim
  | sym _ =>
      simp [matchAtoms, matchAtomsWith, Subst.occurs, hloop]
  | gnd _ =>
      simp [matchAtoms, matchAtomsWith, Subst.occurs, hloop]
  | expr xs =>
      have hocc : Subst.occurs v (Atom.expr xs) = false :=
        occurs_eq_false_of_not_mem_vars v (Atom.expr xs) hnot
      simp [matchAtoms, matchAtomsWith, hocc, hloop]

/-- Instantiating a variable under a fresh singleton value binding returns that value. -/
theorem instantiate_singleton_val_var (v : String) (target : Atom)
    (hnot : v ∉ target.vars) :
    instantiate [BindingRel.val v target] (Atom.var v) = target := by
  exact instantiate_singleton_val_var_of_not_mem v target hnot

/-- A singleton value binding is inert on any atom that does not mention its key. This is the
open-target analogue of closed-result final-readout stability. -/
theorem instantiate_singleton_val_eq_self_of_not_mem
    (key : String) (value : Atom) :
    ∀ {target : Atom}, key ∉ target.vars →
      instantiate [BindingRel.val key value] target = target := by
  intro target
  exact instantiate_singleton_val_inert key value target

/-- If an RHS mentions only the rule variable `v`, substituting `v ↦ target` yields a result
stable under a second singleton binding whose key is fresh for `target`. -/
theorem instantiate_singleton_val_stable_after_singleton_subst
    (fresh v : String) (target : Atom)
    (hfresh : fresh ∉ target.vars) (hraw : v ∉ target.vars) :
    ∀ {rhs : Atom}, (∀ w ∈ rhs.vars, w = v) →
      instantiate [BindingRel.val fresh target]
          (instantiate [BindingRel.val v target] rhs) =
        instantiate [BindingRel.val v target] rhs := by
  intro rhs
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_ rhs
  · intro s _
    simp [instantiate, Bindings.resolveAtom]
  · intro w hboundVars
    have hwv : w = v := hboundVars w (by simp [Atom.vars])
    subst w
    simpa [instantiate_singleton_val_var v target hraw] using
      instantiate_singleton_val_eq_self_of_not_mem fresh target (target := target) hfresh
  · intro g _
    simp [instantiate, Bindings.resolveAtom]
  · intro xs ih hboundVars
    simp only [instantiate, Bindings.resolveAtom]
    rw [List.map_map]
    change Atom.expr (List.map (fun a => instantiate [BindingRel.val fresh target]
      (instantiate [BindingRel.val v target] a)) xs) =
      Atom.expr (List.map (fun a => instantiate [BindingRel.val v target] a) xs)
    congr 1
    apply List.map_congr_left
    intro child hchild
    exact ih child hchild (fun w hw => hboundVars w (by
      simp only [Atom.vars, List.mem_flatten, List.mem_map]
      exact ⟨child.vars, ⟨child, hchild, rfl⟩, hw⟩))

/-- A singleton value binding to a closed target is never a loop. -/
theorem hasLoop_singleton_val_closed_false (v : String) (target : Atom)
    (hclosed : target.vars = []) :
    Bindings.hasLoop [BindingRel.val v target] = false := by
  exact Bindings.hasLoop_singleton_val_of_not_mem v target (by rw [hclosed]; simp)

/-- Open-target variant of `hasLoop_singleton_val_closed_false`: a singleton value binding is a
loop only in the degenerate `$v ← $v` case. -/
theorem hasLoop_singleton_val_not_false (v : String) (target : Atom)
    (hnot : v ∉ target.vars) :
    Bindings.hasLoop [BindingRel.val v target] = false := by
  exact Bindings.hasLoop_singleton_val_of_not_mem v target hnot

/-- Empty ambient bindings preserve a singleton value binding. This is the one-binding base case for
the ambient-merge part of the runtime crossing. -/
theorem singleton_val_mem_merge_empty_left (v : String) (target : Atom)
    (hnotvar : ∀ w, target ≠ Atom.var w) :
    [BindingRel.val v target] ∈ Bindings.merge [] [BindingRel.val v target] := by
  cases target <;>
    simp_all [Bindings.merge, Bindings.mergeOne, Bindings.addVarBinding,
      Bindings.addValRaw, Bindings.removeVal]

theorem singleton_val_merge_empty_eq (v : String) (target : Atom)
    (hnotvar : ∀ w, target ≠ Atom.var w) :
    Bindings.merge [] [BindingRel.val v target] = [[BindingRel.val v target]] := by
  cases target <;>
    simp_all [Bindings.merge, Bindings.mergeOne, Bindings.addVarBinding,
      Bindings.addValRaw, Bindings.removeVal]

/-! ## Closed symbolic matcher facts -/

/-- Renaming variables is the identity on closed atoms. -/
theorem renBy_eq_self_of_vars_nil (f : VarName → VarName) :
    ∀ a : Atom, a.vars = [] → renBy f a = a := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s _
    simp [renBy]
  · intro v h
    simp [Atom.vars] at h
  · intro g _
    simp [renBy]
  · intro xs ih hvars
    simp only [Atom.vars] at hvars
    simp only [renBy_expr]
    have hmap : List.map (renBy f) xs = List.map (fun a => a) xs := by
      apply List.map_congr_left
      intro a ha
      apply ih a ha
      apply List.eq_nil_iff_forall_not_mem.mpr
      intro v hv
      have hvflat : v ∈ (xs.map Atom.vars).flatten := by
        rw [List.mem_flatten]
        exact ⟨a.vars, by rw [List.mem_map]; exact ⟨a, ha, rfl⟩, hv⟩
      rw [hvars] at hvflat
      cases hvflat
    simpa [List.map_id'] using hmap

/-- Symbol-only atoms, possibly nested in expressions. This is the first closed fragment where
`matchAtoms a a` can be proved without assuming reflexivity of grounded payload equality; grounded
float equality may be non-reflexive on NaN, so the generic closed-atom statement would be too strong.
-/
inductive SymbolicClosed : Atom → Prop
  | sym (s : String) : SymbolicClosed (Atom.sym s)
  | expr {xs : List Atom} : (∀ a, a ∈ xs → SymbolicClosed a) → SymbolicClosed (Atom.expr xs)

/-- Symbolic closed atoms have no variables. -/
theorem SymbolicClosed.vars_nil {a : Atom} (h : SymbolicClosed a) : a.vars = [] := by
  induction h with
  | sym s =>
      simp [Atom.vars]
  | expr hchildren ih =>
      apply List.eq_nil_iff_forall_not_mem.mpr
      intro v hv
      rw [Atom.vars, List.mem_flatten] at hv
      rcases hv with ⟨l, hl, hv⟩
      rw [List.mem_map] at hl
      rcases hl with ⟨a, ha, rfl⟩
      have hva : a.vars = [] := ih a ha
      rw [hva] at hv
      cases hv

/-- A symbolic closed atom matches itself with the empty binding set. This is the expression/list
matcher base case needed before generalizing the freshened runtime crossing beyond one variable
leaf. -/
theorem matchAtoms_symbolicClosed_self_empty {a : Atom} (h : SymbolicClosed a) :
    [] ∈ matchAtoms a a := by
  induction h with
  | sym s =>
      simp [matchAtoms, matchAtomsWith, Bindings.hasLoop, Bindings.vars]
  | @expr xs hchildren ih =>
      have hlist :
          ∀ ys acc, (∀ a ∈ ys, a ∈ xs) → [] ∈ acc → [] ∈ matchAll none acc ys ys := by
        intro ys
        induction ys with
        | nil =>
            intro acc hsub hacc
            simpa [matchAll] using hacc
        | cons y ys ihys =>
            intro acc hsub hacc
            simp only [matchAll]
            have hyMem : y ∈ xs := hsub y (by simp)
            have hyMatch : [] ∈ matchAtoms y y := ih y hyMem
            have hfiltered : [] ∈
                (matchAtomsWith none y y).filter (fun bindings => !bindings.hasLoop) := by
              simpa [matchAtoms] using hyMatch
            have hseed :
                [] ∈ acc.flatMap
                  (fun a => ((matchAtomsWith none y y).filter
                    (fun bindings => !bindings.hasLoop)).flatMap fun b => Bindings.merge a b) := by
              rw [List.mem_flatMap]
              refine ⟨[], hacc, ?_⟩
              rw [List.mem_flatMap]
              refine ⟨[], hfiltered, ?_⟩
              simp [Bindings.merge]
            exact ihys _ (fun a ha => hsub a (by simp [ha])) hseed
      rw [matchAtoms, List.mem_filter]
      exact ⟨hlist xs [[]] (fun a ha => ha) (by simp), by
        simp [Bindings.hasLoop, Bindings.vars]⟩

/-- Runtime freshening is literally inert on symbolic closed identity rules. -/
theorem freshenRule_symbolicClosed_id (counter : Nat) {a : Atom} (h : SymbolicClosed a) :
    freshenRule counter a a = (a, a) := by
  unfold freshenRule
  rw [SymbolicClosed.vars_nil h]
  simp

/-- Runtime freshening is literally inert on any variable-free symbolic rule. -/
theorem freshenRule_symbolicClosed_pair_id (counter : Nat) {lhs rhs : Atom}
    (hlhs : SymbolicClosed lhs) (hrhs : SymbolicClosed rhs) :
    freshenRule counter lhs rhs = (lhs, rhs) := by
  unfold freshenRule
  rw [SymbolicClosed.vars_nil hlhs, SymbolicClosed.vars_nil hrhs]
  simp

/-! ## Certified single-step bridge -/

/-! ### Runtime freshening is α-inert -/

def counterSuffix (counter : Nat) (v : String) : String :=
  v ++ "#" ++ toString counter

theorem counterSuffix_injective (counter : Nat) :
    Function.Injective (counterSuffix counter) := by
  intro x y h
  apply String.ext
  have h' : x.toList ++ ("#" ++ toString counter).toList =
      y.toList ++ ("#" ++ toString counter).toList := by
    simpa [counterSuffix, String.toList_append, List.append_assoc] using congrArg String.toList h
  exact (List.append_left_inj (("#" ++ toString counter).toList)).mp h'

private theorem counterSubst_lookup
    (counter : Nat) :
    ∀ (vars : List String) (v : String),
      Metta.Subst.lookup
          (vars.map fun x => (x, Metta.Atom.var (counterSuffix counter x))) v =
        (vars.find? (fun x => x == v)).map (fun x => Metta.Atom.var (counterSuffix counter x)) := by
  intro vars v
  induction vars with
  | nil =>
      simp [Metta.Subst.lookup]
  | cons x xs ih =>
      by_cases hx : x = v
      · subst hx
        simp [Metta.Subst.lookup]
      · have hbeq : (x == v) = false := by
          simp [hx]
        have hne : v ≠ x := by
          intro h
          exact hx h.symm
        have hbeq' : (v == x) = false := by
          simp [hne]
        simpa [Metta.Subst.lookup, hbeq, hbeq'] using ih

private theorem find?_beq_self_of_mem :
    ∀ (vars : List String) {v : String},
      v ∈ vars → vars.find? (fun x => x == v) = some v := by
  intro vars
  induction vars with
  | nil =>
      intro v hv
      cases hv
  | cons x xs ih =>
      intro v hv
      by_cases hx : x = v
      · subst hx
        simp
      · have hvxs : v ∈ xs := (List.mem_cons.mp hv).resolve_left (fun h => hx h.symm)
        have hbeq : (x == v) = false := by
          simp [hx]
        simpa [hbeq] using ih hvxs

private theorem counterSubst_apply_eq_renBy_of_varsSubset
    (counter : Nat) (vars : List String) :
    ∀ a : Metta.Atom,
      (∀ v ∈ a.vars, v ∈ vars) →
        Metta.Subst.apply
            (vars.map fun x => (x, Metta.Atom.var (counterSuffix counter x))) a =
          renBy (counterSuffix counter) a := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s _
    simp [Metta.Subst.apply, renBy]
  · intro v hvars
    have hv : v ∈ vars := hvars v (by simp [Metta.Atom.vars])
    rw [Metta.Subst.apply, counterSubst_lookup]
    have hfind : vars.find? (fun x => x == v) = some v :=
      find?_beq_self_of_mem vars hv
    simp [hfind]
  · intro g _
    simp [Metta.Subst.apply, renBy]
  · intro xs ih hvars
    simp only [Metta.Subst.apply, renBy_expr]
    refine congrArg Metta.Atom.expr (List.map_congr_left ?_)
    intro x hx
    exact ih x hx (fun v hv => hvars v (by
      simp only [Metta.Atom.vars, List.mem_flatten, List.mem_map]
      exact ⟨x.vars, ⟨x, hx, rfl⟩, hv⟩))

/-- Exact form of LeaTTa runtime rule freshening: it is the total variable renaming
`v ↦ v#counter` on both sides of the rule. -/
theorem freshenRule_eq_renBy (counter : Nat) (lhs rhs : Atom) :
    freshenRule counter lhs rhs =
      (renBy (counterSuffix counter) lhs, renBy (counterSuffix counter) rhs) := by
  unfold freshenRule
  cases hvars : lhs.vars ++ rhs.vars with
  | nil =>
      have hnil : lhs.vars = [] ∧ rhs.vars = [] :=
        List.append_eq_nil_iff.mp hvars
      have hl := renBy_eq_self_of_vars_nil (counterSuffix counter) lhs hnil.1
      have hr := renBy_eq_self_of_vars_nil (counterSuffix counter) rhs hnil.2
      simp [hl, hr]
  | cons v vs =>
      simp
      have hsubsetL : ∀ x ∈ lhs.vars, x ∈ v :: vs := by
        intro x hx
        rw [← hvars]
        exact List.mem_append_left rhs.vars hx
      have hsubsetR : ∀ x ∈ rhs.vars, x ∈ v :: vs := by
        intro x hx
        rw [← hvars]
        exact List.mem_append_right lhs.vars hx
      constructor
      · have h := counterSubst_apply_eq_renBy_of_varsSubset counter (v :: vs) lhs hsubsetL
        simpa [counterSuffix] using h
      · have h := counterSubst_apply_eq_renBy_of_varsSubset counter (v :: vs) rhs hsubsetR
        simpa [counterSuffix] using h

/-! ### Runtime freshening and binding-key renaming -/

/-- Rename the variable keys carried by a binding set, leaving bound atom values untouched. Runtime
rule freshening changes rule-variable names, while the matched target values remain in the original
atom language; this is the binding-level companion to `renBy`. -/
def renameBindings (f : VarName → VarName) : Bindings → Bindings
  | [] => []
  | BindingRel.val x a :: rest => BindingRel.val (f x) a :: renameBindings f rest
  | BindingRel.eq x y :: rest => BindingRel.eq (f x) y :: renameBindings f rest

/-- The value-binding keys in a binding set, ignoring equality-only relations. -/
def bindingValueKeys : Bindings → List VarName
  | [] => []
  | BindingRel.val x _ :: rest => x :: bindingValueKeys rest
  | BindingRel.eq _ _ :: rest => bindingValueKeys rest

/-- Every runtime-renamed value key is fresh for every value carried by the binding set.

This is the open-target freshness invariant needed beyond the closed fragment: final readout applies
the harvested runtime binding set once more, so freshened rule keys must be disjoint from the ambient
variables retained inside all matched target values. -/
def RenamedValueKeysFreshForValues (f : VarName → VarName) (b : Bindings) : Prop :=
  ∀ key, key ∈ bindingValueKeys b →
    ∀ x a, BindingRel.val x a ∈ b → f key ∉ a.vars

/-- Rule-side keys of both value and equality relations. The right endpoint of
an equality relation belongs to the matched target and is therefore payload,
not a key renamed by `renameBindings`. -/
def bindingRuleKeys : Bindings → List VarName
  | [] => []
  | BindingRel.val x _ :: rest => x :: bindingRuleKeys rest
  | BindingRel.eq x _ :: rest => x :: bindingRuleKeys rest

/-- Every renamed rule-side binding key is fresh for every ambient variable
carried by matched values or by equality-relation target endpoints. -/
def RenamedBindingKeysFreshForPayloads
    (f : VarName → VarName) (b : Bindings) : Prop :=
  ∀ key, key ∈ bindingRuleKeys b →
    (∀ x a, BindingRel.val x a ∈ b → f key ∉ a.vars) ∧
    (∀ x y, BindingRel.eq x y ∈ b → f key ≠ y)

/-- Every value-binding key is also a rule-side binding key. -/
theorem valueKey_mem_bindingRuleKeys {key : VarName} :
    ∀ {b : Bindings}, key ∈ bindingValueKeys b → key ∈ bindingRuleKeys b
  | [], h => by cases h
  | BindingRel.val x value :: rest, h => by
      simp only [bindingValueKeys, bindingRuleKeys, List.mem_cons] at h ⊢
      exact h.imp_right valueKey_mem_bindingRuleKeys
  | BindingRel.eq x y :: rest, h => by
      simp only [bindingValueKeys] at h
      simp only [bindingRuleKeys, List.mem_cons]
      exact Or.inr (valueKey_mem_bindingRuleKeys h)

/-- The payload-wide invariant retains the value-key/value freshness contract. -/
theorem RenamedBindingKeysFreshForPayloads.toValueKeys
    {f : VarName → VarName} {b : Bindings}
    (hfresh : RenamedBindingKeysFreshForPayloads f b) :
    RenamedValueKeysFreshForValues f b := by
  intro key hkey x atom hmem
  exact (hfresh key (valueKey_mem_bindingRuleKeys hkey)).1 x atom hmem

/-- A value relation contributes its left endpoint to `bindingRuleKeys`. -/
theorem ruleKey_mem_of_val_mem {x : VarName} {a : Atom} :
    ∀ {b : Bindings}, BindingRel.val x a ∈ b → x ∈ bindingRuleKeys b
  | [], h => by cases h
  | BindingRel.val y value :: rest, h => by
      simp only [List.mem_cons] at h
      simp only [bindingRuleKeys, List.mem_cons]
      rcases h with hhead | hrest
      · cases hhead
        exact Or.inl rfl
      · exact Or.inr (ruleKey_mem_of_val_mem hrest)
  | BindingRel.eq y z :: rest, h => by
      simp only [List.mem_cons] at h
      simp only [bindingRuleKeys, List.mem_cons]
      rcases h with h | hrest
      · cases h
      · exact Or.inr (ruleKey_mem_of_val_mem hrest)

/-- An equality relation contributes its rule endpoint to `bindingRuleKeys`. -/
theorem ruleKey_mem_of_eq_mem {x y : VarName} :
    ∀ {b : Bindings}, BindingRel.eq x y ∈ b → x ∈ bindingRuleKeys b
  | [], h => by cases h
  | BindingRel.val z value :: rest, h => by
      simp only [List.mem_cons] at h
      simp only [bindingRuleKeys, List.mem_cons]
      rcases h with h | hrest
      · cases h
      · exact Or.inr (ruleKey_mem_of_eq_mem hrest)
  | BindingRel.eq z w :: rest, h => by
      simp only [List.mem_cons] at h
      simp only [bindingRuleKeys, List.mem_cons]
      rcases h with hhead | hrest
      · cases hhead
        exact Or.inl rfl
      · exact Or.inr (ruleKey_mem_of_eq_mem hrest)

/-- Payload freshness specialized to a stored value. -/
theorem renamedBindingKey_fresh_for_value
    {f : VarName → VarName} {b : Bindings}
    (hfresh : RenamedBindingKeysFreshForPayloads f b)
    {key x : VarName} {a : Atom}
    (hkey : key ∈ bindingRuleKeys b) (hmem : BindingRel.val x a ∈ b) :
    f key ∉ a.vars :=
  (hfresh key hkey).1 x a hmem

/-- Payload freshness specialized to an equality target endpoint. -/
theorem renamedBindingKey_ne_eqTarget
    {f : VarName → VarName} {b : Bindings}
    (hfresh : RenamedBindingKeysFreshForPayloads f b)
    {key x y : VarName}
    (hkey : key ∈ bindingRuleKeys b) (hmem : BindingRel.eq x y ∈ b) :
    f key ≠ y :=
  (hfresh key hkey).2 x y hmem

/-- A direct value binding contributes its key to `bindingValueKeys`. -/
theorem valueKey_mem_of_val_mem {x : VarName} {a : Atom} :
    ∀ {b : Bindings}, BindingRel.val x a ∈ b → x ∈ bindingValueKeys b
  | [], h => by
      cases h
  | BindingRel.val y value :: rest, h => by
      cases h with
      | head =>
          simp [bindingValueKeys]
      | tail _ htail =>
          simp [bindingValueKeys, valueKey_mem_of_val_mem htail]
  | BindingRel.eq y z :: rest, h => by
      simp [bindingValueKeys] at h ⊢
      exact valueKey_mem_of_val_mem h

/-- The all-values freshness invariant implies the self-value freshness needed by loop pruning. -/
theorem renamedValueKeysFreshForValues_self {f : VarName → VarName} {b : Bindings}
    (hfresh : RenamedValueKeysFreshForValues f b) :
    ∀ x a, BindingRel.val x a ∈ b → f x ∉ a.vars := by
  intro x a hmem
  exact hfresh x (valueKey_mem_of_val_mem hmem) x a hmem

/-- Binding sets whose value bindings all point to closed atoms, and which contain no equality
relations. This is the no-capture shape produced by matching variable patterns against closed
targets. -/
inductive ClosedValueBindings : Bindings → Prop
  | nil : ClosedValueBindings []
  | val {x : VarName} {a : Atom} {rest : Bindings} :
      a.vars = [] → ClosedValueBindings rest →
        ClosedValueBindings (BindingRel.val x a :: rest)

/-- Binding sets containing only value bindings. Unlike `ClosedValueBindings`, values may be open;
this is the shape needed when a rule variable matches an open target under a binder. -/
inductive ValueBindings : Bindings → Prop
  | nil : ValueBindings []
  | val {x : VarName} {a : Atom} {rest : Bindings} :
      ValueBindings rest → ValueBindings (BindingRel.val x a :: rest)

/-- Closed-value bindings are value-only bindings. -/
theorem ClosedValueBindings.toValueBindings :
    ∀ {b : Bindings}, ClosedValueBindings b → ValueBindings b
  | _, ClosedValueBindings.nil => ValueBindings.nil
  | _, ClosedValueBindings.val _ hrest =>
      ValueBindings.val (ClosedValueBindings.toValueBindings hrest)

/-- Value-only binding sets have no explicit equality variables. -/
theorem ValueBindings.eqVarsInOrder_nil :
    ∀ {b : Bindings}, ValueBindings b → Bindings.eqVarsInOrder b = []
  | [], ValueBindings.nil => rfl
  | BindingRel.val _ _ :: rest, ValueBindings.val hrest => by
      simpa [Bindings.eqVarsInOrder] using ValueBindings.eqVarsInOrder_nil hrest

/-- Consequently, every equality class in a value-only binding set is the singleton queried class. -/
theorem ValueBindings.eqClassOrdered_singleton {b : Bindings} (h : ValueBindings b)
    (x : VarName) :
    Bindings.eqClassOrdered b x = [x] := by
  simp [Bindings.eqClassOrdered, ValueBindings.eqVarsInOrder_nil h]

/-- In value-only bindings, direct lookup and the head of the equality-class value list agree. -/
theorem ValueBindings.classValues_lookupVal :
    ∀ {b : Bindings}, ValueBindings b → ∀ x,
      (Bindings.lookupVal b x = none → Bindings.classValues b x = []) ∧
      (∀ a, Bindings.lookupVal b x = some a →
        ∃ rest, Bindings.classValues b x = a :: rest)
  | b, hval, x => by
      have hclass := Bindings.classValues_eq_lookupVal_toList_of_eqVarsInOrder_nil
        (ValueBindings.eqVarsInOrder_nil hval) x
      constructor
      · intro hlook
        rw [hclass, hlook]
        rfl
      · intro a hlook
        refine ⟨[], ?_⟩
        rw [hclass, hlook]
        rfl

/-- A successful direct lookup in value-only bindings comes from a stored value relation. -/
theorem ValueBindings.val_mem_of_lookup {b : Bindings} (hval : ValueBindings b) :
    ∀ {x : VarName} {a : Atom}, Bindings.lookupVal b x = some a →
      BindingRel.val x a ∈ b := by
  intro x a hlook
  induction hval with
  | nil => simp [Bindings.lookupVal] at hlook
  | @val y value rest hrest ih =>
      by_cases hxy : x = y
      · subst y
        simp [Bindings.lookupVal] at hlook
        subst a
        simp
      · have hbeq : (x == y) = false := by simp [hxy]
        have hrestLook : Bindings.lookupVal rest x = some a := by
          simpa [Bindings.lookupVal, hbeq] using hlook
        exact List.mem_cons_of_mem _ (ih hrestLook)

/-- Direct lookup from closed value-only bindings can return only a closed atom. -/
theorem ClosedValueBindings.lookup_closed {b : Bindings} (hclosed : ClosedValueBindings b) :
    ∀ {x : VarName} {a : Atom}, Bindings.lookupVal b x = some a → a.vars = [] := by
  intro x a hlook
  induction hclosed with
  | nil => simp [Bindings.lookupVal] at hlook
  | @val y value rest hvalueClosed hrest ih =>
      by_cases hxy : x = y
      · subst y
        simp [Bindings.lookupVal] at hlook
        subst a
        exact hvalueClosed
      · have hbeq : (x == y) = false := by simp [hxy]
        apply ih
        simpa [Bindings.lookupVal, hbeq] using hlook

/-- Every value gathered from an equality class of closed value-only bindings is closed. -/
theorem ClosedValueBindings.classValues_closed {b : Bindings}
    (hclosed : ClosedValueBindings b) (x : VarName) :
    ∀ value ∈ Bindings.classValues b x, value.vars = [] := by
  intro value hmem
  have hclass := Bindings.classValues_eq_lookupVal_toList_of_eqVarsInOrder_nil
    (ValueBindings.eqVarsInOrder_nil hclosed.toValueBindings) x
  cases hlook : Bindings.lookupVal b x with
  | none =>
      simp [hclass, hlook] at hmem
  | some atom =>
      have hvalue : value = atom := by
        simpa [hclass, hlook] using hmem
      subst value
      exact ClosedValueBindings.lookup_closed hclosed hlook

/-- On closed value-only bindings, full equality-class resolution conservatively agrees with direct
value lookup. -/
theorem ClosedValueBindings.resolve_eq_lookupVal {b : Bindings}
    (hclosed : ClosedValueBindings b) (x : VarName) :
    Bindings.resolve b x = Bindings.lookupVal b x := by
  have hval := hclosed.toValueBindings
  have hcls := ValueBindings.eqClassOrdered_singleton hval x
  cases hlook : Bindings.lookupVal b x with
  | none =>
      have hvalues := (ValueBindings.classValues_lookupVal hval x).1 hlook
      simp [Bindings.resolve, hcls, hvalues]
  | some value =>
      rcases (ValueBindings.classValues_lookupVal hval x).2 value hlook with
        ⟨tail, hvalues⟩
      have hvalueClosed := ClosedValueBindings.lookup_closed hclosed hlook
      have hmem := ValueBindings.val_mem_of_lookup hval hlook
      have hcostMem : Bindings.relationResolutionFuel (BindingRel.val x value) ∈
          (b.map Bindings.relationResolutionFuel) := List.mem_map_of_mem hmem
      have hcostLe : value.size + 1 ≤ (b.map Bindings.relationResolutionFuel).sum := by
        simpa [Bindings.relationResolutionFuel] using List.le_sum_of_mem hcostMem
      cases hfuelEq : Bindings.resolutionFuel b (Atom.var x) with
      | zero =>
          simp [Bindings.resolutionFuel, Atom.size] at hfuelEq
      | succ fuel =>
          have hfuel : value.size < fuel := by
            simp [Bindings.resolutionFuel, Atom.size] at hfuelEq
            omega
          have haux := Bindings.resolveAtomAux_of_closed b value fuel [x]
            hvalueClosed hfuel
          cases value with
          | var y => simp [Atom.vars] at hvalueClosed
          | sym s =>
              simp [Bindings.resolve, hcls, hvalues, hfuelEq,
                Bindings.resolveAtomAux, haux]
          | gnd g =>
              simp [Bindings.resolve, hcls, hvalues, hfuelEq,
                Bindings.resolveAtomAux, haux]
          | expr xs =>
              simp [Bindings.resolve, hcls, hvalues, hfuelEq,
                Bindings.resolveAtomAux, haux]

/-- Membership in the value-key surface of a value-only binding set gives a successful lookup. -/
theorem ValueBindings.lookup_some_of_key_mem {b : Bindings} (hval : ValueBindings b) :
    ∀ {x : VarName}, x ∈ bindingValueKeys b →
      ∃ value, Bindings.lookupVal b x = some value := by
  intro x hkey
  induction hval with
  | nil => simp [bindingValueKeys] at hkey
  | @val y value rest hrest ih =>
      simp only [bindingValueKeys, List.mem_cons] at hkey
      rcases hkey with rfl | hrestKey
      · exact ⟨value, by simp [Bindings.lookupVal]⟩
      · rcases ih hrestKey with ⟨result, hlook⟩
        by_cases hxy : x = y
        · subst y
          exact ⟨value, by simp [Bindings.lookupVal]⟩
        · exact ⟨result, by simpa [Bindings.lookupVal, hxy] using hlook⟩

/-- Every variable mentioned by closed value-only bindings is one of their direct value keys. -/
theorem ClosedValueBindings.key_mem_of_vars_mem {b : Bindings}
    (hclosed : ClosedValueBindings b) {x : VarName}
    (hx : x ∈ Bindings.vars b) : x ∈ bindingValueKeys b := by
  induction hclosed with
  | nil => simp [Bindings.vars] at hx
  | @val y value rest hvalueClosed hrest ih =>
      unfold Bindings.vars at hx
      rw [List.mem_eraseDups] at hx
      simp only [List.flatMap_cons] at hx
      simp [hvalueClosed] at hx
      rcases hx with rfl | ⟨relation, hrelation, hxRelation⟩
      · simp [bindingValueKeys]
      · have hrestVar : x ∈ Bindings.vars rest := by
          unfold Bindings.vars
          rw [List.mem_eraseDups, List.mem_flatMap]
          exact ⟨relation, hrelation, hxRelation⟩
        simp [bindingValueKeys, ih hrestVar]

/-- Every value-binding key is absent from every stored value. This is the acyclicity condition for
open value-only environments; self-freshness alone does not exclude mutual cycles. -/
def ValueKeysFreshForValues (b : Bindings) : Prop :=
  ∀ key, key ∈ bindingValueKeys b →
    ∀ x a, BindingRel.val x a ∈ b → key ∉ a.vars

/-- Every value relation stored in a closed-value binding set carries a closed atom. -/
theorem ClosedValueBindings.val_mem_closed {b : Bindings} (hclosed : ClosedValueBindings b) :
    ∀ {x : VarName} {a : Atom}, BindingRel.val x a ∈ b → a.vars = [] := by
  intro x a hmem
  induction hclosed with
  | nil => cases hmem
  | @val y value rest hvalueClosed hrest ih =>
      cases hmem with
      | head => exact hvalueClosed
      | tail _ htail => exact ih htail

/-- Closed-value environments satisfy the all-keys/all-values acyclicity invariant. -/
theorem ClosedValueBindings.valueKeysFreshForValues {b : Bindings}
    (hclosed : ClosedValueBindings b) : ValueKeysFreshForValues b := by
  intro _key _hkey x a hmem
  rw [ClosedValueBindings.val_mem_closed hclosed hmem]
  simp

/-- Renaming binding keys cannot capture variables in closed stored values. -/
theorem ClosedValueBindings.renamedValueKeysFreshForValues (f : VarName → VarName)
    {b : Bindings} (hclosed : ClosedValueBindings b) :
    RenamedValueKeysFreshForValues f b := by
  intro _key _hkey x a hmem
  rw [ClosedValueBindings.val_mem_closed hclosed hmem]
  simp

/-- A fresh singleton value binding satisfies the source acyclicity invariant. -/
theorem singleton_valueKeysFreshForValues {key : VarName} {value : Atom}
    (hfresh : key ∉ value.vars) :
    ValueKeysFreshForValues [BindingRel.val key value] := by
  intro candidate hcandidate x a hmem
  simp [bindingValueKeys] at hcandidate
  subst candidate
  simp at hmem
  rcases hmem with ⟨rfl, rfl⟩
  exact hfresh

/-- A runtime-renamed singleton key fresh for its stored value satisfies renamed freshness. -/
theorem singleton_renamedValueKeysFreshForValues (f : VarName → VarName)
    {key : VarName} {value : Atom} (hfresh : f key ∉ value.vars) :
    RenamedValueKeysFreshForValues f [BindingRel.val key value] := by
  intro candidate hcandidate x a hmem
  simp [bindingValueKeys] at hcandidate
  subst candidate
  simp at hmem
  rcases hmem with ⟨rfl, rfl⟩
  exact hfresh

/-- A key outside the value-key surface cannot have a direct value lookup. -/
theorem ValueBindings.lookup_none_of_not_key {b : Bindings} (hval : ValueBindings b) :
    ∀ {x : VarName}, x ∉ bindingValueKeys b → Bindings.lookupVal b x = none := by
  intro x hnot
  induction hval with
  | nil => simp [Bindings.lookupVal]
  | @val y value rest hrest ih =>
      have hxy : x ≠ y := by
        intro h
        subst y
        exact hnot (by simp [bindingValueKeys])
      have hnotRest : x ∉ bindingValueKeys rest := by
        intro hx
        exact hnot (by simp [bindingValueKeys, hx])
      simpa [Bindings.lookupVal, hxy] using ih hnotRest

private theorem List.mapM_some_self_of_forall_queryBridge {α : Type} (f : α → Option α) :
    ∀ xs : List α, (∀ x ∈ xs, f x = some x) → xs.mapM f = some xs
  | [], _ => by simp
  | x :: xs, h => by
      simp [h x (by simp), List.mapM_some_self_of_forall_queryBridge f xs
        (fun y hy => h y (by simp [hy]))]

/-- Under a value-only environment, recursive resolution is inert on an atom whose variables are
outside both the binding domain and the current resolver stack. -/
theorem ValueBindings.resolveAtomAux_inert {b : Bindings} (hval : ValueBindings b) :
    ∀ (a : Atom) (fuel : Nat) (visited : List VarName),
      (∀ x ∈ a.vars, x ∉ bindingValueKeys b) →
      (∀ x ∈ a.vars, x ∉ visited) →
      a.size < fuel → Bindings.resolveAtomAux b fuel visited a = some a := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s fuel visited _ _ hsize
    cases fuel with
    | zero => simp [Atom.size] at hsize
    | succ fuel => simp [Bindings.resolveAtomAux]
  · intro x fuel visited hkeys hvisited hsize
    cases fuel with
    | zero => simp [Atom.size] at hsize
    | succ fuel =>
        have hxKey : x ∉ bindingValueKeys b := hkeys x (by simp [Atom.vars])
        have hxVisited : x ∉ visited := hvisited x (by simp [Atom.vars])
        have hlook := ValueBindings.lookup_none_of_not_key hval hxKey
        have hvalues := (ValueBindings.classValues_lookupVal hval x).1 hlook
        have hcls := ValueBindings.eqClassOrdered_singleton hval x
        simp [Bindings.resolveAtomAux, hcls, hvalues, hxVisited,
          Bindings.eqRepresentative]
  · intro g fuel visited _ _ hsize
    cases fuel with
    | zero => simp [Atom.size] at hsize
    | succ fuel => simp [Bindings.resolveAtomAux]
  · intro xs ih fuel visited hkeys hvisited hsize
    cases fuel with
    | zero => simp [Atom.size] at hsize
    | succ fuel =>
        have hmap : xs.mapM (Bindings.resolveAtomAux b fuel visited) = some xs := by
          apply List.mapM_some_self_of_forall_queryBridge
          intro child hchild
          have hchildKeys : ∀ x ∈ child.vars, x ∉ bindingValueKeys b := by
            intro x hx
            exact hkeys x (by
              simp only [Atom.vars, List.mem_flatten, List.mem_map]
              exact ⟨child.vars, ⟨child, hchild, rfl⟩, hx⟩)
          have hchildVisited : ∀ x ∈ child.vars, x ∉ visited := by
            intro x hx
            exact hvisited x (by
              simp only [Atom.vars, List.mem_flatten, List.mem_map]
              exact ⟨child.vars, ⟨child, hchild, rfl⟩, hx⟩)
          have hchildLe : child.size ≤ (xs.map Atom.size).sum :=
            List.le_sum_of_mem (List.mem_map.mpr ⟨child, hchild, rfl⟩)
          have hchildSize : child.size < fuel := by
            simp only [Atom.size] at hsize
            omega
          exact ih child hchild fuel visited hchildKeys hchildVisited hchildSize
        simp [Bindings.resolveAtomAux, hmap]

/-- Recursive resolution is inert when every variable has no class value, is
already its class representative, and its equality class avoids the resolver
stack. This is the representation-independent form needed for open values that
may mention a valueless query-variable equality class. -/
theorem Bindings.resolveAtomAux_inert {b : Bindings} :
    ∀ (a : Atom) (fuel : Nat) (visited : List VarName),
      (∀ x ∈ a.vars, Bindings.classValues b x = []) →
      (∀ x ∈ a.vars, Bindings.eqRepresentative b x = x) →
      (∀ x ∈ a.vars, ∀ y ∈ Bindings.eqClassOrdered b x, y ∉ visited) →
      a.size < fuel → Bindings.resolveAtomAux b fuel visited a = some a := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s fuel visited _ _ _ hsize
    cases fuel with
    | zero => simp [Atom.size] at hsize
    | succ fuel => simp [Bindings.resolveAtomAux]
  · intro x fuel visited hvalues hrepresentative hvisited hsize
    cases fuel with
    | zero => simp [Atom.size] at hsize
    | succ fuel =>
        have hclassValues := hvalues x (by simp [Atom.vars])
        have hrepresentativeX := hrepresentative x (by simp [Atom.vars])
        have hclassVisited :
            (Bindings.eqClassOrdered b x).any visited.contains = false := by
          rw [List.any_eq_false]
          intro y hy
          have hyNotVisited := hvisited x (by simp [Atom.vars]) y hy
          intro hcontains
          exact hyNotVisited (List.contains_iff_mem.mp hcontains)
        simp [Bindings.resolveAtomAux, hclassVisited, hclassValues, hrepresentativeX]
  · intro g fuel visited _ _ _ hsize
    cases fuel with
    | zero => simp [Atom.size] at hsize
    | succ fuel => simp [Bindings.resolveAtomAux]
  · intro xs ih fuel visited hvalues hrepresentative hvisited hsize
    cases fuel with
    | zero => simp [Atom.size] at hsize
    | succ fuel =>
        have hmap : xs.mapM (Bindings.resolveAtomAux b fuel visited) = some xs := by
          apply List.mapM_some_self_of_forall_queryBridge
          intro child hchild
          have childVarsMem (x : VarName) (hx : x ∈ child.vars) :
              x ∈ (Atom.expr xs).vars := by
            simp only [Atom.vars, List.mem_flatten, List.mem_map]
            exact ⟨child.vars, ⟨child, hchild, rfl⟩, hx⟩
          have hchildSize : child.size < fuel := by
            have hchildLe : child.size ≤ (xs.map Atom.size).sum :=
              List.le_sum_of_mem (List.mem_map.mpr ⟨child, hchild, rfl⟩)
            simp only [Atom.size] at hsize
            omega
          exact ih child hchild fuel visited
            (fun x hx => hvalues x (childVarsMem x hx))
            (fun x hx => hrepresentative x (childVarsMem x hx))
            (fun x hx y hy => hvisited x (childVarsMem x hx) y hy)
            hchildSize
        simp [Bindings.resolveAtomAux, hmap]

@[simp] theorem Bindings.resolveAtom_nil (a : Atom) :
    Bindings.resolveAtom [] a = a := by
  simpa [instantiate] using Metta.instantiate_nil a

@[simp] theorem Bindings.resolve_nil (x : VarName) :
    Bindings.resolve [] x = none := by
  simp [Bindings.resolve, Bindings.eqClassOrdered, Bindings.eqVarsInOrder,
    Bindings.eqClass, Bindings.eqClassAux, Bindings.eqStep]

/-- A lone equality relation carries no value for any class. -/
theorem Bindings.classValues_one_eq_eq_nil
    (left right x : VarName) :
    Bindings.classValues [BindingRel.eq left right] x = [] := by
  simp [Bindings.classValues, Bindings.lookupVal]

/-- Two value relations do not affect the equality class generated by one
alias edge. Away from the rule endpoint, the query endpoint is the stable
representative and every other variable remains a singleton. -/
theorem Bindings.eqClassOrdered_two_vals_one_eq_of_ne_left
    (valueKey1 valueKey2 left right x : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right) (hxLeft : x ≠ left) :
    Bindings.eqClassOrdered
        [ BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2
        , BindingRel.eq left right ] x =
      if x = right then [right, left] else [x] := by
  by_cases hxRight : x = right
  · subst x
    simp [Bindings.eqClassOrdered, Bindings.eqVarsInOrder, Bindings.eqClass,
      Bindings.eqClassAux, Bindings.eqStep, hleftRight]
  · have hleftX : left ≠ x := Ne.symm hxLeft
    have hrightX : right ≠ x := Ne.symm hxRight
    simp [Bindings.eqClassOrdered, Bindings.eqVarsInOrder, Bindings.eqClass,
      Bindings.eqClassAux, Bindings.eqStep, hxRight, hleftX, hrightX, hleftRight]

theorem Bindings.eqClassOrdered_one_val_one_eq_of_ne_left
    (valueKey left right x : VarName) (value : Atom)
    (hleftRight : left ≠ right) (hxLeft : x ≠ left) :
    Bindings.eqClassOrdered
        [BindingRel.val valueKey value, BindingRel.eq left right] x =
      if x = right then [right, left] else [x] := by
  by_cases hxRight : x = right
  · subst x
    simp [Bindings.eqClassOrdered, Bindings.eqVarsInOrder, Bindings.eqClass,
      Bindings.eqClassAux, Bindings.eqStep, hleftRight]
  · have hleftX : left ≠ x := Ne.symm hxLeft
    have hrightX : right ≠ x := Ne.symm hxRight
    simp [Bindings.eqClassOrdered, Bindings.eqVarsInOrder, Bindings.eqClass,
      Bindings.eqClassAux, Bindings.eqStep, hxRight, hleftX, hrightX, hleftRight]

theorem Bindings.classValues_one_val_one_eq_eq_nil
    (valueKey left right x : VarName) (value : Atom)
    (hleftRight : left ≠ right) (hxLeft : x ≠ left)
    (hxKey : x ≠ valueKey) (hleftKey : left ≠ valueKey)
    (hrightKey : right ≠ valueKey) :
    Bindings.classValues [BindingRel.val valueKey value, BindingRel.eq left right] x = [] := by
  rw [Bindings.classValues,
    Bindings.eqClassOrdered_one_val_one_eq_of_ne_left
      valueKey left right x value hleftRight hxLeft]
  by_cases hxRight : x = right
  · subst x
    simp [Bindings.lookupVal, hrightKey, hleftKey]
  · simp [Bindings.lookupVal, hxRight, hxKey]

/-- In the same one-edge environment, every variable except the rule endpoint
is its class representative. -/
theorem Bindings.eqRepresentative_two_vals_one_eq_of_ne_left
    (valueKey1 valueKey2 left right x : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right) (hxLeft : x ≠ left) :
    Bindings.eqRepresentative
        [ BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2
        , BindingRel.eq left right ] x = x := by
  rw [Bindings.eqRepresentative,
    Bindings.eqClassOrdered_two_vals_one_eq_of_ne_left
      valueKey1 valueKey2 left right x value1 value2 hleftRight hxLeft]
  by_cases hxRight : x = right <;> simp [hxRight]

/-- The rule endpoint belongs to the same ordered class, whose representative
is still the query endpoint. -/
theorem Bindings.eqClassOrdered_two_vals_one_eq_left
    (valueKey1 valueKey2 left right : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right) :
    Bindings.eqClassOrdered
        [ BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2
        , BindingRel.eq left right ] left = [right, left] := by
  have hrightLeft : right ≠ left := Ne.symm hleftRight
  simp [Bindings.eqClassOrdered, Bindings.eqVarsInOrder, Bindings.eqClass,
    Bindings.eqClassAux, Bindings.eqStep, hleftRight, hrightLeft]

theorem Bindings.eqRepresentative_two_vals_one_eq_left
    (valueKey1 valueKey2 left right : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right) :
    Bindings.eqRepresentative
        [ BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2
        , BindingRel.eq left right ] left = right := by
  rw [Bindings.eqRepresentative,
    Bindings.eqClassOrdered_two_vals_one_eq_left
      valueKey1 valueKey2 left right value1 value2 hleftRight]
  simp

/-- A variable class disjoint from both value keys carries no value, including
the query endpoint of the one alias edge. -/
theorem Bindings.classValues_two_vals_one_eq_eq_nil
    (valueKey1 valueKey2 left right x : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right) (hxLeft : x ≠ left)
    (hxKey1 : x ≠ valueKey1) (hxKey2 : x ≠ valueKey2)
    (hleftKey1 : left ≠ valueKey1) (hleftKey2 : left ≠ valueKey2)
    (hrightKey1 : right ≠ valueKey1) (hrightKey2 : right ≠ valueKey2) :
    Bindings.classValues
        [ BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2
        , BindingRel.eq left right ] x = [] := by
  rw [Bindings.classValues,
    Bindings.eqClassOrdered_two_vals_one_eq_of_ne_left
      valueKey1 valueKey2 left right x value1 value2 hleftRight hxLeft]
  by_cases hxRight : x = right
  · subst x
    simp [Bindings.lookupVal, hrightKey1, hrightKey2, hleftKey1, hleftKey2]
  · simp [Bindings.lookupVal, hxRight, hxKey1, hxKey2]

/-- In runtime merge order, an equality relation preceding two unrelated value
relations still gives its query endpoint priority in the ordered class. -/
theorem Bindings.eqClassOrdered_one_eq_two_vals_left
    (left right valueKey1 valueKey2 : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right) :
    Bindings.eqClassOrdered
        [ BindingRel.eq left right
        , BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2 ] left = [right, left] := by
  have hrightLeft : right ≠ left := Ne.symm hleftRight
  simp [Bindings.eqClassOrdered, Bindings.eqVarsInOrder, Bindings.eqClass,
    Bindings.eqClassAux, Bindings.eqStep, hleftRight, hrightLeft]

/-- Away from the rule endpoint, the eq-first runtime order has the same
stable class observations as the value-first matcher order. -/
theorem Bindings.eqClassOrdered_one_eq_two_vals_of_ne_left
    (left right valueKey1 valueKey2 x : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right) (hxLeft : x ≠ left) :
    Bindings.eqClassOrdered
        [ BindingRel.eq left right
        , BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2 ] x =
      if x = right then [right, left] else [x] := by
  by_cases hxRight : x = right
  · subst x
    simp [Bindings.eqClassOrdered, Bindings.eqVarsInOrder, Bindings.eqClass,
      Bindings.eqClassAux, Bindings.eqStep, hleftRight]
  · have hleftX : left ≠ x := Ne.symm hxLeft
    have hrightX : right ≠ x := Ne.symm hxRight
    simp [Bindings.eqClassOrdered, Bindings.eqVarsInOrder, Bindings.eqClass,
      Bindings.eqClassAux, Bindings.eqStep, hxRight, hleftX, hrightX, hleftRight]

theorem Bindings.eqRepresentative_one_eq_two_vals_of_ne_left
    (left right valueKey1 valueKey2 x : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right) (hxLeft : x ≠ left) :
    Bindings.eqRepresentative
        [ BindingRel.eq left right
        , BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2 ] x = x := by
  rw [Bindings.eqRepresentative,
    Bindings.eqClassOrdered_one_eq_two_vals_of_ne_left
      left right valueKey1 valueKey2 x value1 value2 hleftRight hxLeft]
  by_cases hxRight : x = right <;> simp [hxRight]

/-- The equality class introduced at the head of a runtime binding has no
value when both endpoints are disjoint from the two value keys. -/
theorem Bindings.classValues_one_eq_two_vals_left_eq_nil
    (left right valueKey1 valueKey2 : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right)
    (hleftKey1 : left ≠ valueKey1) (hleftKey2 : left ≠ valueKey2)
    (hrightKey1 : right ≠ valueKey1) (hrightKey2 : right ≠ valueKey2) :
    Bindings.classValues
        [ BindingRel.eq left right
        , BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2 ] left = [] := by
  rw [Bindings.classValues,
    Bindings.eqClassOrdered_one_eq_two_vals_left
      left right valueKey1 valueKey2 value1 value2 hleftRight]
  simp [Bindings.lookupVal, hrightKey1, hrightKey2, hleftKey1, hleftKey2]

theorem Bindings.classValues_one_eq_two_vals_eq_nil
    (left right valueKey1 valueKey2 x : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right) (hxLeft : x ≠ left)
    (hxKey1 : x ≠ valueKey1) (hxKey2 : x ≠ valueKey2)
    (hleftKey1 : left ≠ valueKey1) (hleftKey2 : left ≠ valueKey2)
    (hrightKey1 : right ≠ valueKey1) (hrightKey2 : right ≠ valueKey2) :
    Bindings.classValues
        [ BindingRel.eq left right
        , BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2 ] x = [] := by
  rw [Bindings.classValues,
    Bindings.eqClassOrdered_one_eq_two_vals_of_ne_left
      left right valueKey1 valueKey2 x value1 value2 hleftRight hxLeft]
  by_cases hxRight : x = right
  · subst x
    simp [Bindings.lookupVal, hrightKey1, hrightKey2, hleftKey1, hleftKey2]
  · simp [Bindings.lookupVal, hxRight, hxKey1, hxKey2]

theorem Bindings.classValues_one_eq_two_vals_key1
    (left right valueKey1 valueKey2 : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right)
    (hkey1Left : valueKey1 ≠ left) (hkey1Right : valueKey1 ≠ right)
    (_hkey1Key2 : valueKey1 ≠ valueKey2) :
    Bindings.classValues
        [ BindingRel.eq left right
        , BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2 ] valueKey1 = [value1] := by
  rw [Bindings.classValues,
    Bindings.eqClassOrdered_one_eq_two_vals_of_ne_left
      left right valueKey1 valueKey2 valueKey1 value1 value2
      hleftRight hkey1Left]
  simp [Bindings.lookupVal, hkey1Right]

theorem Bindings.classValues_one_eq_two_vals_key2
    (left right valueKey1 valueKey2 : VarName) (value1 value2 : Atom)
    (hleftRight : left ≠ right)
    (hkey2Left : valueKey2 ≠ left) (hkey2Right : valueKey2 ≠ right)
    (hkey2Key1 : valueKey2 ≠ valueKey1) :
    Bindings.classValues
        [ BindingRel.eq left right
        , BindingRel.val valueKey1 value1
        , BindingRel.val valueKey2 value2 ] valueKey2 = [value2] := by
  rw [Bindings.classValues,
    Bindings.eqClassOrdered_one_eq_two_vals_of_ne_left
      left right valueKey1 valueKey2 valueKey2 value1 value2
      hleftRight hkey2Left]
  simp [Bindings.lookupVal, hkey2Right, hkey2Key1]

set_option maxRecDepth 4096 in
/-- A non-variable first class value resolves to the result produced by the
recursive resolver at the remaining fuel. -/
theorem Bindings.resolve_eq_nonvar_class_value {b : Bindings} {x : VarName}
    {cls : List VarName} {value resolved : Atom}
    (hclass : Bindings.eqClassOrdered b x = cls)
    (hvalues : Bindings.classValues b x = value :: [])
    (hnotvar : ∀ y, value ≠ Atom.var y)
    (haux : Bindings.resolveAtomAux b
      (Bindings.resolutionFuel b (Atom.var x)).pred cls value = some resolved) :
    Bindings.resolve b x = some resolved := by
  have hfuelPos : 0 < Bindings.resolutionFuel b (Atom.var x) := by
    simp [Bindings.resolutionFuel, Atom.size]
  have hfuel : Bindings.resolutionFuel b (Atom.var x) =
      (Bindings.resolutionFuel b (Atom.var x)).pred + 1 :=
    (Nat.succ_pred_eq_of_pos hfuelPos).symm
  unfold Bindings.resolve
  rw [hclass, hvalues]
  simp only [List.isEmpty_cons, Bool.and_false, Bool.false_eq_true, ↓reduceIte]
  rw [hfuel]
  simp only [Bindings.resolveAtomAux]
  rw [hclass]
  have hnotVisited : cls.any ([] : List VarName).contains = false := by simp
  rw [hnotVisited]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [hvalues]
  cases value with
  | var y => exact False.elim (hnotvar y rfl)
  | sym s => simpa using haux
  | gnd g => simpa using haux
  | expr children => simpa using haux

set_option maxRecDepth 4096 in
/-- A non-variable first class value resolves independently of any later class
values once its recursive resolver succeeds. -/
theorem Bindings.resolve_eq_nonvar_first_class_value {b : Bindings} {x : VarName}
    {cls : List VarName} {value resolved : Atom} {tail : List Atom}
    (hclass : Bindings.eqClassOrdered b x = cls)
    (hvalues : Bindings.classValues b x = value :: tail)
    (hnotvar : ∀ y, value ≠ Atom.var y)
    (haux : Bindings.resolveAtomAux b
      (Bindings.resolutionFuel b (Atom.var x)).pred cls value = some resolved) :
    Bindings.resolve b x = some resolved := by
  have hfuelPos : 0 < Bindings.resolutionFuel b (Atom.var x) := by
    simp [Bindings.resolutionFuel, Atom.size]
  have hfuel : Bindings.resolutionFuel b (Atom.var x) =
      (Bindings.resolutionFuel b (Atom.var x)).pred + 1 :=
    (Nat.succ_pred_eq_of_pos hfuelPos).symm
  unfold Bindings.resolve
  rw [hclass, hvalues]
  simp only [List.isEmpty_cons, Bool.and_false, Bool.false_eq_true, ↓reduceIte]
  rw [hfuel]
  simp only [Bindings.resolveAtomAux]
  rw [hclass]
  have hnotVisited : cls.any ([] : List VarName).contains = false := by simp
  rw [hnotVisited]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [hvalues]
  cases value with
  | var y => exact False.elim (hnotvar y rfl)
  | sym s => simpa using haux
  | gnd g => simpa using haux
  | expr children => simpa using haux

set_option maxRecDepth 4096 in
/-- A closed first value of a class resolves exactly when the resolver has
enough structural fuel. -/
theorem Bindings.resolve_eq_closed_class_value {b : Bindings} {x : VarName}
    {cls : List VarName} {value : Atom}
    (hclass : Bindings.eqClassOrdered b x = cls)
    (hvalues : Bindings.classValues b x = value :: [])
    (hclosed : value.vars = [])
    (hsize : value.size < (Bindings.resolutionFuel b (Atom.var x)).pred) :
    Bindings.resolve b x = some value := by
  have hfuelPos : 0 < Bindings.resolutionFuel b (Atom.var x) := by
    simp [Bindings.resolutionFuel, Atom.size]
  have hfuel : Bindings.resolutionFuel b (Atom.var x) =
      (Bindings.resolutionFuel b (Atom.var x)).pred + 1 :=
    (Nat.succ_pred_eq_of_pos hfuelPos).symm
  have haux := Bindings.resolveAtomAux_of_closed b value
    (Bindings.resolutionFuel b (Atom.var x)).pred cls hclosed hsize
  unfold Bindings.resolve
  rw [hclass, hvalues]
  simp only [List.isEmpty_cons, Bool.and_false, Bool.false_eq_true, ↓reduceIte]
  rw [hfuel]
  simp only [Bindings.resolveAtomAux]
  rw [hclass]
  have hnotVisited : cls.any ([] : List VarName).contains = false := by simp
  rw [hnotVisited]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [hvalues]
  cases value with
  | var y => simp [Atom.vars] at hclosed
  | sym s => simpa using haux
  | gnd g => simpa using haux
  | expr children => simpa using haux

/-- A valueless non-singleton equality class resolves to its stable
representative. -/
theorem Bindings.resolve_eq_representative_of_valueless_class
    {b : Bindings} {x representative : VarName} {cls : List VarName}
    (hclass : Bindings.eqClassOrdered b x = cls)
    (hnontrivial : cls ≠ [x])
    (hvalues : Bindings.classValues b x = [])
    (hrepresentative : Bindings.eqRepresentative b x = representative) :
    Bindings.resolve b x = some (Atom.var representative) := by
  have hfuelPos : 0 < Bindings.resolutionFuel b (Atom.var x) := by
    simp [Bindings.resolutionFuel, Atom.size]
  have hfuel : Bindings.resolutionFuel b (Atom.var x) =
      (Bindings.resolutionFuel b (Atom.var x)).pred + 1 :=
    (Nat.succ_pred_eq_of_pos hfuelPos).symm
  unfold Bindings.resolve
  rw [hclass, hvalues]
  simp only [List.isEmpty_nil, Bool.and_true]
  have hbeq : (cls == [x]) = false := by simp [hnontrivial]
  rw [hbeq]
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [hfuel]
  simp only [Bindings.resolveAtomAux]
  rw [hclass, hvalues, hrepresentative]
  simp

/-- Full resolution conservatively agrees with direct lookup in an acyclic value-only environment. -/
theorem ValueBindings.resolve_eq_lookupVal_of_fresh {b : Bindings}
    (hval : ValueBindings b) (hfresh : ValueKeysFreshForValues b) (x : VarName) :
    Bindings.resolve b x = Bindings.lookupVal b x := by
  have hcls := ValueBindings.eqClassOrdered_singleton hval x
  cases hlook : Bindings.lookupVal b x with
  | none =>
      have hvalues := (ValueBindings.classValues_lookupVal hval x).1 hlook
      simp [Bindings.resolve, hcls, hvalues]
  | some value =>
      rcases (ValueBindings.classValues_lookupVal hval x).2 value hlook with
        ⟨tail, hvalues⟩
      have hmem := ValueBindings.val_mem_of_lookup hval hlook
      have hkey : x ∈ bindingValueKeys b := valueKey_mem_of_val_mem hmem
      have hvalueKeys : ∀ y ∈ value.vars, y ∉ bindingValueKeys b := by
        intro y hy yKey
        exact hfresh y yKey x value hmem hy
      have hvalueVisited : ∀ y ∈ value.vars, y ∉ [x] := by
        intro y hy hyVisited
        simp at hyVisited
        subst y
        exact hfresh x hkey x value hmem hy
      have hcostMem : Bindings.relationResolutionFuel (BindingRel.val x value) ∈
          (b.map Bindings.relationResolutionFuel) := List.mem_map_of_mem hmem
      have hcostLe : value.size + 1 ≤ (b.map Bindings.relationResolutionFuel).sum := by
        simpa [Bindings.relationResolutionFuel] using List.le_sum_of_mem hcostMem
      cases hfuelEq : Bindings.resolutionFuel b (Atom.var x) with
      | zero => simp [Bindings.resolutionFuel, Atom.size] at hfuelEq
      | succ fuel =>
          have hfuel : value.size < fuel := by
            simp [Bindings.resolutionFuel, Atom.size] at hfuelEq
            omega
          have haux := ValueBindings.resolveAtomAux_inert hval value fuel [x]
            hvalueKeys hvalueVisited hfuel
          cases value with
          | var y =>
              have hyx : y ≠ x := by
                simpa [Atom.vars] using hvalueVisited y (by simp [Atom.vars])
              simp [Bindings.resolve, hcls, hvalues, hfuelEq,
                Bindings.resolveAtomAux, haux, hyx]
          | sym s =>
              simp [Bindings.resolve, hcls, hvalues, hfuelEq,
                Bindings.resolveAtomAux, haux]
          | gnd g =>
              simp [Bindings.resolve, hcls, hvalues, hfuelEq,
                Bindings.resolveAtomAux, haux]
          | expr xs =>
              simp [Bindings.resolve, hcls, hvalues, hfuelEq,
                Bindings.resolveAtomAux, haux]

/-- A value-only environment satisfying all-keys/all-values freshness has no direct or recursive
dependency loop. -/
theorem ValueBindings.hasLoop_false_of_fresh {b : Bindings}
    (hval : ValueBindings b) (hfresh : ValueKeysFreshForValues b) :
    Bindings.hasLoop b = false := by
  have hdirect : b.any (fun r => match r with
      | BindingRel.val x (Atom.var y) => x == y
      | BindingRel.eq x y => x == y
      | _ => false) = false := by
    induction hval with
    | nil => simp
    | @val x value rest hrest ih =>
        have hkey : x ∈ bindingValueKeys (BindingRel.val x value :: rest) := by
          simp [bindingValueKeys]
        have hself : x ∉ value.vars := hfresh x hkey x value (by simp)
        have hfreshRest : ValueKeysFreshForValues rest := by
          intro key hkeyRest y a hmem
          exact hfresh key (by simp [bindingValueKeys, hkeyRest]) y a (by simp [hmem])
        have ih' := ih hfreshRest
        cases value with
        | var y => simpa [Atom.vars] using And.intro hself ih'
        | sym _ => simp [ih']
        | gnd _ => simp [ih']
        | expr _ => simp [ih']
  unfold Bindings.hasLoop
  apply Bool.or_eq_false_iff.mpr
  refine ⟨hdirect, ?_⟩
  rw [List.any_eq_false]
  intro x hx
  by_cases hkey : x ∈ bindingValueKeys b
  · rcases ValueBindings.lookup_some_of_key_mem hval hkey with ⟨value, hlook⟩
    have hresolve : Bindings.resolve b x = some value := by
      rw [ValueBindings.resolve_eq_lookupVal_of_fresh hval hfresh x]
      exact hlook
    cases haux : Bindings.resolveAtomAux b
        (Bindings.resolutionFuel b (Atom.var x)) [] (Atom.var x) with
    | none => simp [Bindings.resolve, haux] at hresolve
    | some resolved => simp
  · have haux := ValueBindings.resolveAtomAux_inert hval (Atom.var x)
        (Bindings.resolutionFuel b (Atom.var x)) []
        (by
          intro y hy
          simp [Atom.vars] at hy
          subst y
          exact hkey)
        (by simp [Atom.vars])
        (by simp [Bindings.resolutionFuel, Atom.size])
    simp [haux]

/-- Successful recursive resolution for every variable observed by the binding
set is sufficient to discharge the recursive half of loop pruning. -/
theorem Bindings.hasLoop_false_of_resolveAtomAux_some {b : Bindings}
    (hdirect : b.any (fun r => match r with
      | BindingRel.val x (Atom.var y) => x == y
      | BindingRel.eq x y => x == y
      | _ => false) = false)
    (hresolve : ∀ x ∈ Bindings.vars b, ∃ a,
      Bindings.resolveAtomAux b (Bindings.resolutionFuel b (Atom.var x)) []
        (Atom.var x) = some a) :
    Bindings.hasLoop b = false := by
  unfold Bindings.hasLoop
  apply Bool.or_eq_false_iff.mpr
  refine ⟨hdirect, ?_⟩
  rw [List.any_eq_false]
  intro x hx
  rcases hresolve x hx with ⟨a, ha⟩
  simp [ha]

/-- A successful public variable resolution witnesses successful execution of
the recursive resolver used by `hasLoop`. -/
theorem Bindings.resolveAtomAux_some_of_resolve_some {b : Bindings}
    {x : VarName} {value : Atom} (hresolve : Bindings.resolve b x = some value) :
    ∃ resolved, Bindings.resolveAtomAux b
      (Bindings.resolutionFuel b (Atom.var x)) [] (Atom.var x) = some resolved := by
  cases haux : Bindings.resolveAtomAux b
      (Bindings.resolutionFuel b (Atom.var x)) [] (Atom.var x) with
  | none =>
      simp [Bindings.resolve, haux] at hresolve
  | some resolved => exact ⟨resolved, rfl⟩

/-- Renaming binding keys preserves the value-only shape. -/
theorem ValueBindings.rename {f : VarName → VarName} :
    ∀ {b : Bindings}, ValueBindings b → ValueBindings (renameBindings f b)
  | _, ValueBindings.nil => ValueBindings.nil
  | _, ValueBindings.val hrest => ValueBindings.val (ValueBindings.rename hrest)

/-- Renaming binding keys preserves the closed-value shape. -/
theorem ClosedValueBindings.rename {f : VarName → VarName} :
    ∀ {b : Bindings}, ClosedValueBindings b → ClosedValueBindings (renameBindings f b)
  | _, ClosedValueBindings.nil => ClosedValueBindings.nil
  | _, ClosedValueBindings.val hclosed hrest =>
      ClosedValueBindings.val hclosed (ClosedValueBindings.rename hrest)

/-- Renaming preserves the values carried by value relations. -/
theorem val_mem_renameBindings {f : VarName → VarName} :
    ∀ {b : Bindings} {x : VarName} {a : Atom},
      BindingRel.val x a ∈ renameBindings f b →
        ∃ original, x = f original ∧ BindingRel.val original a ∈ b
  | [], _, _, h => by cases h
  | BindingRel.val y value :: rest, x, a, h => by
      simp only [renameBindings, List.mem_cons] at h
      rcases h with h | h
      · cases h
        exact ⟨y, rfl, by simp⟩
      · rcases val_mem_renameBindings h with ⟨original, rfl, horiginal⟩
        exact ⟨original, rfl, by simp [horiginal]⟩
  | BindingRel.eq y z :: rest, x, a, h => by
      simp only [renameBindings, List.mem_cons] at h
      rcases h with h | h
      · cases h
      · rcases val_mem_renameBindings h with ⟨original, rfl, horiginal⟩
        exact ⟨original, rfl, by simp [horiginal]⟩

/-- Value-key collection commutes with key renaming. -/
theorem bindingValueKeys_renameBindings_early (f : VarName → VarName) :
    ∀ b : Bindings, bindingValueKeys (renameBindings f b) = (bindingValueKeys b).map f
  | [] => by simp [bindingValueKeys, renameBindings]
  | BindingRel.val x a :: rest => by
      simp [bindingValueKeys, renameBindings, bindingValueKeys_renameBindings_early f rest]
  | BindingRel.eq x y :: rest => by
      simp [bindingValueKeys, renameBindings, bindingValueKeys_renameBindings_early f rest]

/-- The all-keys freshness invariant transfers to runtime-renamed binding keys. -/
theorem ValueKeysFreshForValues.rename {f : VarName → VarName} {b : Bindings}
    (hfresh : RenamedValueKeysFreshForValues f b) :
    ValueKeysFreshForValues (renameBindings f b) := by
  intro key hkey x a hmem
  rw [bindingValueKeys_renameBindings_early] at hkey
  rcases List.mem_map.mp hkey with ⟨originalKey, hkeyOriginal, rfl⟩
  rcases val_mem_renameBindings hmem with ⟨originalX, rfl, hmemOriginal⟩
  exact hfresh originalKey hkeyOriginal originalX a hmemOriginal

/-- Value-key collection distributes over append. -/
theorem bindingValueKeys_append (left right : Bindings) :
    bindingValueKeys (left ++ right) = bindingValueKeys left ++ bindingValueKeys right := by
  induction left with
  | nil => simp [bindingValueKeys]
  | cons relation rest ih =>
      cases relation <;> simp [bindingValueKeys, ih]

/-- Append preserves the value-only shape. -/
theorem ValueBindings.append :
    ∀ {left right : Bindings}, ValueBindings left → ValueBindings right →
      ValueBindings (left ++ right)
  | [], _, ValueBindings.nil, hright => by simpa using hright
  | BindingRel.val x atom :: rest, right, ValueBindings.val hrest, hright => by
      simp only [List.cons_append]
      exact ValueBindings.val (ValueBindings.append hrest hright)

/-- Reversal preserves the value-only shape. -/
theorem ValueBindings.reverse :
    ∀ {b : Bindings}, ValueBindings b → ValueBindings b.reverse
  | [], ValueBindings.nil => ValueBindings.nil
  | BindingRel.val x atom :: rest, ValueBindings.val hrest => by
      rw [List.reverse_cons]
      exact ValueBindings.append (ValueBindings.reverse hrest)
        (ValueBindings.val ValueBindings.nil)

/-- Reversing value-only bindings reverses their value-key list. -/
theorem ValueBindings.bindingValueKeys_reverse {b : Bindings} (hval : ValueBindings b) :
    bindingValueKeys b.reverse = (bindingValueKeys b).reverse := by
  induction hval with
  | nil => simp [bindingValueKeys]
  | @val y value rest hrest ih =>
      rw [List.reverse_cons, bindingValueKeys_append, ih]
      simp [bindingValueKeys]

/-- Reversal preserves the all-keys/all-values freshness invariant. -/
theorem ValueKeysFreshForValues.reverse {b : Bindings} (hval : ValueBindings b)
    (hfresh : ValueKeysFreshForValues b) : ValueKeysFreshForValues b.reverse := by
  intro key hkey x a hmem
  have hkeys := ValueBindings.bindingValueKeys_reverse hval
  have hkeyOriginal : key ∈ bindingValueKeys b := by
    rw [hkeys, List.mem_reverse] at hkey
    exact hkey
  have hmemOriginal : BindingRel.val x a ∈ b := by
    simpa using (List.mem_reverse.mp hmem)
  exact hfresh key hkeyOriginal x a hmemOriginal

/-- Renamed value-only bindings survive loop pruning when every renamed key is fresh for every
stored value. -/
theorem ValueBindings.rename_hasLoop_false_of_not_mem_vars (f : VarName → VarName) :
    ∀ {b : Bindings}, ValueBindings b → RenamedValueKeysFreshForValues f b →
      Bindings.hasLoop (renameBindings f b) = false
  | _, hval, hfresh =>
      ValueBindings.hasLoop_false_of_fresh (ValueBindings.rename hval)
        (ValueKeysFreshForValues.rename hfresh)

/-- Reversed renamed value-only bindings preserve the same loop-safety invariant. -/
theorem ValueBindings.rename_reverse_hasLoop_false_of_not_mem_vars
    {f : VarName → VarName} {b : Bindings}
    (hval : ValueBindings b) (hfresh : RenamedValueKeysFreshForValues f b) :
    Bindings.hasLoop (renameBindings f b).reverse = false :=
  ValueBindings.hasLoop_false_of_fresh (ValueBindings.reverse (ValueBindings.rename hval))
    (ValueKeysFreshForValues.reverse (ValueBindings.rename hval)
      (ValueKeysFreshForValues.rename hfresh))

/-- Closed-value bindings never contain a loop. -/
theorem ClosedValueBindings.hasLoop_false :
    ∀ {b : Bindings}, ClosedValueBindings b → Bindings.hasLoop b = false := by
  intro b hclosed
  have hdirect : b.any (fun r => match r with
      | BindingRel.val x (Atom.var y) => x == y
      | BindingRel.eq x y => x == y
      | _ => false) = false := by
    induction hclosed with
    | nil => simp
    | @val x value rest hvalueClosed hrest ih =>
        cases value with
        | var y => simp [Atom.vars] at hvalueClosed
        | sym _ => simp [ih]
        | gnd _ => simp [ih]
        | expr _ => simp [ih]
  unfold Bindings.hasLoop
  apply Bool.or_eq_false_iff.mpr
  refine ⟨hdirect, ?_⟩
  rw [List.any_eq_false]
  intro x hx
  have hkey := ClosedValueBindings.key_mem_of_vars_mem hclosed hx
  rcases ValueBindings.lookup_some_of_key_mem hclosed.toValueBindings hkey with
    ⟨value, hlook⟩
  have hresolve : Bindings.resolve b x = some value := by
    rw [ClosedValueBindings.resolve_eq_lookupVal hclosed x]
    exact hlook
  cases haux : Bindings.resolveAtomAux b
      (Bindings.resolutionFuel b (Atom.var x)) [] (Atom.var x) with
  | none => simp [Bindings.resolve, haux] at hresolve
  | some resolved => simp

/-- Renamed closed-value bindings also survive runtime loop pruning. -/
theorem ClosedValueBindings.rename_hasLoop_false {f : VarName → VarName} {b : Bindings}
    (h : ClosedValueBindings b) :
    Bindings.hasLoop (renameBindings f b) = false :=
  ClosedValueBindings.hasLoop_false (ClosedValueBindings.rename h)

/-- Closed-value bindings are closed under append. -/
theorem ClosedValueBindings.append :
    ∀ {a b : Bindings}, ClosedValueBindings a → ClosedValueBindings b → ClosedValueBindings (a ++ b)
  | [], b, ClosedValueBindings.nil, hb => by
      simpa using hb
  | BindingRel.val x atom :: rest, b, ClosedValueBindings.val hclosed hrest, hb => by
      simp only [List.cons_append]
      exact ClosedValueBindings.val hclosed (ClosedValueBindings.append hrest hb)

/-- Reversing a closed-value binding set preserves the closed-value shape. -/
theorem ClosedValueBindings.reverse :
    ∀ {b : Bindings}, ClosedValueBindings b → ClosedValueBindings b.reverse
  | [], ClosedValueBindings.nil => ClosedValueBindings.nil
  | BindingRel.val x atom :: rest, ClosedValueBindings.val hclosed hrest => by
      rw [List.reverse_cons]
      exact ClosedValueBindings.append (ClosedValueBindings.reverse hrest)
        (ClosedValueBindings.val hclosed ClosedValueBindings.nil)

/-- Removing a value binding preserves the closed-value shape. -/
theorem removeVal_closed : ∀ {b : Bindings} {x : VarName},
    ClosedValueBindings b → ClosedValueBindings (Bindings.removeVal b x)
  | [], _, ClosedValueBindings.nil => by
      simp [Bindings.removeVal]
      exact ClosedValueBindings.nil
  | BindingRel.val y a :: rest, x, ClosedValueBindings.val hclosed hrest => by
      by_cases hyx : y = x
      · subst hyx
        simp [Bindings.removeVal]
        exact removeVal_closed hrest
      · have hbeq : (y != x) = true := by simp [hyx]
        simp [Bindings.removeVal, hbeq]
        exact ClosedValueBindings.val hclosed (removeVal_closed hrest)

/-- Raw value insertion preserves the closed-value shape when the inserted value is closed. -/
theorem addValRaw_closed {b : Bindings} {x : VarName} {a : Atom}
    (ha : a.vars = []) (hb : ClosedValueBindings b) :
    ClosedValueBindings (Bindings.addValRaw b x a) := by
  simp [Bindings.addValRaw]
  exact ClosedValueBindings.val ha (removeVal_closed hb)

/-- Consistency-checked value insertion preserves the closed-value shape when the inserted value is
closed and the accumulator is closed-value-only. -/
theorem addVarBinding_closed_mem {b out : Bindings} {x : VarName} {a : Atom}
    (ha : a.vars = []) (hb : ClosedValueBindings b)
    (hout : out ∈ Bindings.addVarBinding b x a) :
    ClosedValueBindings out := by
  have hnotvar : ∀ y, a ≠ Atom.var y := by
    intro y h
    subst a
    simp [Atom.vars] at ha
  cases hvalues : Bindings.classValues b x with
  | nil =>
      have hadd := Bindings.addVarBinding_fresh hvalues hnotvar
      rw [hadd] at hout
      simp at hout
      subst out
      exact addValRaw_closed ha hb
  | cons first rest =>
      cases hunify : Bindings.unifyValues ((first :: rest) ++ [a]) with
      | none =>
          have hadd := Bindings.addVarBinding_conflict hnotvar hvalues (by simp) hunify
          rw [hadd] at hout
          cases hout
      | some sigma =>
          have hclosedValues : ∀ value ∈ (first :: rest) ++ [a], value.vars = [] := by
            intro value hmem
            rw [List.mem_append] at hmem
            rcases hmem with hmemClass | hmemLast
            · exact ClosedValueBindings.classValues_closed hb x value (by
                rw [hvalues]
                exact hmemClass)
            · simp at hmemLast
              subst value
              exact ha
          have hsigma := Bindings.unifyValues_some_eq_empty_of_closed hclosedValues hunify
          subst sigma
          have hadd := Bindings.addVarBinding_nochange hnotvar hvalues (by simp) hunify
          rw [hadd] at hout
          simp at hout
          subst out
          exact hb

/-- Membership in `bindingValueKeys` is exactly membership of a direct value
relation with that key. -/
theorem mem_bindingValueKeys_iff {b : Bindings} {x : VarName} :
    x ∈ bindingValueKeys b ↔ ∃ a, BindingRel.val x a ∈ b := by
  induction b with
  | nil => simp [bindingValueKeys]
  | cons relation rest ih =>
      cases relation with
      | val key value =>
          constructor
          · intro hx
            simp [bindingValueKeys] at hx
            rcases hx with hkey | hrest
            · subst x
              exact ⟨value, by simp⟩
            · rcases ih.mp hrest with ⟨atom, hatom⟩
              exact ⟨atom, by simp [hatom]⟩
          · rintro ⟨atom, hatom⟩
            simp [bindingValueKeys] at hatom ⊢
            rcases hatom with hatom | hatom
            · exact Or.inl hatom.1
            · exact Or.inr (ih.mpr ⟨atom, hatom⟩)
      | eq left right =>
          constructor
          · intro hx
            simp [bindingValueKeys] at hx
            rcases ih.mp hx with ⟨atom, hatom⟩
            exact ⟨atom, by simp [hatom]⟩
          · rintro ⟨atom, hatom⟩
            simp [bindingValueKeys] at hatom ⊢
            exact ih.mpr ⟨atom, hatom⟩

/-- Every direct value-binding key occurs in the complete variable surface of
the binding set. -/
theorem bindingValueKey_mem_vars {b : Bindings} {x : VarName}
    (hx : x ∈ bindingValueKeys b) : x ∈ Bindings.vars b := by
  rcases mem_bindingValueKeys_iff.mp hx with ⟨value, hvalue⟩
  unfold Bindings.vars
  rw [List.mem_eraseDups]
  exact List.mem_flatMap.mpr ⟨BindingRel.val x value, hvalue, by simp⟩

/-- Removing a direct value cannot introduce a value-binding key. -/
theorem bindingValueKeys_removeVal_subset (b : Bindings) (removed : VarName) :
    ∀ {x}, x ∈ bindingValueKeys (Bindings.removeVal b removed) →
      x ∈ bindingValueKeys b := by
  intro x hx
  rcases mem_bindingValueKeys_iff.mp hx with ⟨value, hvalue⟩
  unfold Bindings.removeVal at hvalue
  rw [List.mem_filter] at hvalue
  exact mem_bindingValueKeys_iff.mpr ⟨value, hvalue.1⟩

/-- Inserting a direct value can add only the inserted key. -/
theorem bindingValueKeys_addValRaw_subset (b : Bindings) (key : VarName)
    (value : Atom) :
    ∀ {x}, x ∈ bindingValueKeys (Bindings.addValRaw b key value) →
      x = key ∨ x ∈ bindingValueKeys b := by
  intro x hx
  simp only [Bindings.addValRaw, bindingValueKeys, List.mem_cons] at hx
  rcases hx with rfl | hx
  · exact Or.inl rfl
  · exact Or.inr (bindingValueKeys_removeVal_subset b key hx)

/-- Consistency-checked insertion of a closed value can add only the requested
key. Reconciliation of closed atoms yields no variable assignments. -/
theorem addVarBinding_closed_valueKeys_subset
    {b out : Bindings} {key : VarName} {value : Atom}
    (hvalueClosed : value.vars = []) (hb : ClosedValueBindings b)
    (hout : out ∈ Bindings.addVarBinding b key value) :
    ∀ {x}, x ∈ bindingValueKeys out →
      x = key ∨ x ∈ bindingValueKeys b := by
  have hnotvar : ∀ y, value ≠ Atom.var y := by
    intro y h
    subst value
    simp [Atom.vars] at hvalueClosed
  cases hvalues : Bindings.classValues b key with
  | nil =>
      have hadd := Bindings.addVarBinding_fresh hvalues hnotvar
      rw [hadd] at hout
      simp at hout
      subst out
      intro x hx
      exact bindingValueKeys_addValRaw_subset b key value hx
  | cons first rest =>
      cases hunify : Bindings.unifyValues ((first :: rest) ++ [value]) with
      | none =>
          have hadd := Bindings.addVarBinding_conflict hnotvar hvalues (by simp) hunify
          rw [hadd] at hout
          cases hout
      | some sigma =>
          have hclosedValues :
              ∀ atom ∈ (first :: rest) ++ [value], atom.vars = [] := by
            intro atom hmem
            rw [List.mem_append] at hmem
            rcases hmem with hmemClass | hmemLast
            · exact ClosedValueBindings.classValues_closed hb key atom (by
                rw [hvalues]
                exact hmemClass)
            · simp at hmemLast
              subst atom
              exact hvalueClosed
          have hsigma :=
            Bindings.unifyValues_some_eq_empty_of_closed hclosedValues hunify
          subst sigma
          have hadd :=
            Bindings.addVarBinding_nochange hnotvar hvalues (by simp) hunify
          rw [hadd] at hout
          simp at hout
          subst out
          intro x hx
          exact Or.inr hx

/-- One closed value-relation merge step preserves a declared key support. -/
theorem mergeOne_closed_valueKeys_subset
    {accs : List Bindings} {key : VarName} {value : Atom} {allowed : List VarName}
    {out : Bindings}
    (hvalueClosed : value.vars = [])
    (haccClosed : ∀ b ∈ accs, ClosedValueBindings b)
    (haccKeys : ∀ b ∈ accs, ∀ x ∈ bindingValueKeys b, x ∈ allowed)
    (hkey : key ∈ allowed)
    (hout : out ∈ Bindings.mergeOne accs (BindingRel.val key value)) :
    ∀ x ∈ bindingValueKeys out, x ∈ allowed := by
  unfold Bindings.mergeOne at hout
  rw [List.mem_flatMap] at hout
  rcases hout with ⟨b, hb, hout⟩
  intro x hx
  rcases addVarBinding_closed_valueKeys_subset hvalueClosed
      (haccClosed b hb) hout hx with rfl | hx
  · exact hkey
  · exact haccKeys b hb x hx

/-- Folding a closed value-only right input through merge cannot introduce a
value-binding key outside a support containing both the accumulators and the
right input. -/
theorem merge_closed_right_valueKeys_subset :
    ∀ {right : Bindings}, ClosedValueBindings right →
      ∀ {accs : List Bindings} {allowed : List VarName} {out : Bindings},
        (∀ b ∈ accs, ClosedValueBindings b) →
        (∀ b ∈ accs, ∀ x ∈ bindingValueKeys b, x ∈ allowed) →
        (∀ x ∈ bindingValueKeys right, x ∈ allowed) →
        out ∈ right.foldl Bindings.mergeOne accs →
        ∀ x ∈ bindingValueKeys out, x ∈ allowed
  | [], ClosedValueBindings.nil, accs, allowed, out,
      _haccClosed, haccKeys, _hrightKeys, hout =>
      haccKeys out hout
  | BindingRel.val key value :: rest,
      ClosedValueBindings.val hvalueClosed hrest,
      accs, allowed, out, haccClosed, haccKeys, hrightKeys, hout => by
      simp only [List.foldl_cons] at hout
      apply merge_closed_right_valueKeys_subset hrest
          (accs := Bindings.mergeOne accs (BindingRel.val key value))
          (allowed := allowed) (out := out)
      · intro b hb
        unfold Bindings.mergeOne at hb
        rw [List.mem_flatMap] at hb
        rcases hb with ⟨acc, hacc, hb⟩
        exact addVarBinding_closed_mem hvalueClosed (haccClosed acc hacc) hb
      · intro b hb x hx
        exact mergeOne_closed_valueKeys_subset hvalueClosed haccClosed haccKeys
          (hrightKeys key (by simp [bindingValueKeys])) hb x hx
      · intro x hx
        exact hrightKeys x (by simp [bindingValueKeys, hx])
      · exact hout

/-- A merge of closed value-only binding sets has no value-binding keys beyond
those already present on either side. -/
theorem merge_closed_closed_valueKeys_subset
    {left right out : Bindings}
    (hleft : ClosedValueBindings left) (hright : ClosedValueBindings right)
    (hout : out ∈ Bindings.merge left right) :
    ∀ x ∈ bindingValueKeys out,
      x ∈ bindingValueKeys left ∨ x ∈ bindingValueKeys right := by
  intro x hx
  have hsupported : x ∈ bindingValueKeys left ++ bindingValueKeys right := by
    apply merge_closed_right_valueKeys_subset hright
        (accs := [left]) (allowed := bindingValueKeys left ++ bindingValueKeys right)
        (out := out)
    · intro b hb
      simp at hb
      subst b
      exact hleft
    · intro b hb y hy
      simp at hb
      subst b
      exact List.mem_append_left _ hy
    · intro y hy
      exact List.mem_append_right _ hy
    · exact hout
    · exact hx
  exact List.mem_append.mp hsupported

/-- One value-binding merge step preserves closed-value bindings. -/
theorem mergeOne_val_closed_mem {accs : List Bindings} {x : VarName} {a : Atom}
    {out : Bindings}
    (ha : a.vars = [])
    (haccs : ∀ b ∈ accs, ClosedValueBindings b)
    (hout : out ∈ Bindings.mergeOne accs (BindingRel.val x a)) :
    ClosedValueBindings out := by
  unfold Bindings.mergeOne at hout
  rw [List.mem_flatMap] at hout
  rcases hout with ⟨b, hb, hout⟩
  exact addVarBinding_closed_mem ha (haccs b hb) hout

/-- Folding a closed value-only right-hand binding set through `Bindings.merge` preserves
closed-value bindings. -/
theorem merge_closed_right_closed_mem : ∀ {right : Bindings}, ClosedValueBindings right →
    ∀ {accs : List Bindings} {out : Bindings},
      (∀ b ∈ accs, ClosedValueBindings b) →
        out ∈ right.foldl Bindings.mergeOne accs →
          ClosedValueBindings out
  | [], ClosedValueBindings.nil, _, out, haccs, hout => haccs out hout
  | BindingRel.val x a :: rest, ClosedValueBindings.val hclosed hrest, accs, out, haccs, hout => by
      simp only [List.foldl_cons] at hout
      exact merge_closed_right_closed_mem hrest
        (fun b hb => mergeOne_val_closed_mem hclosed haccs hb) hout

/-- Merging two closed-value binding sets can only produce closed-value binding sets. -/
theorem merge_closed_closed_mem {left right out : Bindings}
    (hleft : ClosedValueBindings left) (hright : ClosedValueBindings right)
    (hout : out ∈ Bindings.merge left right) :
    ClosedValueBindings out := by
  exact merge_closed_right_closed_mem hright
    (accs := [left]) (out := out) (by
      intro b hb
      cases hb with
      | head => exact hleft
      | tail _ htail => cases htail) hout

/-- Selecting the first successful merge result, with the runtime's right-hand
fallback, preserves the closed-value shape on both inputs. -/
theorem ClosedValueBindings.mergeHeadGetD
    {left right : Bindings}
    (hleft : ClosedValueBindings left) (hright : ClosedValueBindings right) :
    ClosedValueBindings ((Bindings.merge left right).head?.getD right) := by
  cases hmerge : Bindings.merge left right with
  | nil => simpa [hmerge] using hright
  | cons out outs =>
      have hout : out ∈ Bindings.merge left right := by
        rw [hmerge]
        simp
      simpa [hmerge] using merge_closed_closed_mem hleft hright hout

/-- Replaying closed bindings through the canonical empty accumulator, with
the runtime's total fallback, preserves the closed-value shape. -/
theorem ClosedValueBindings.mergeEmptyHeadGetD
    {b : Bindings} (hclosed : ClosedValueBindings b) :
    ClosedValueBindings ((Bindings.merge [] b).head?.getD b) := by
  cases hmerge : Bindings.merge [] b with
  | nil =>
      simpa [hmerge] using hclosed
  | cons out outs =>
      have hout : out ∈ Bindings.merge [] b := by
        rw [hmerge]
        simp
      have houtClosed : ClosedValueBindings out :=
        merge_closed_closed_mem ClosedValueBindings.nil hclosed hout
      simpa [hmerge] using houtClosed

/-- Removing a value binding preserves the value-only shape. -/
theorem removeVal_value : ∀ {b : Bindings} {x : VarName},
    ValueBindings b → ValueBindings (Bindings.removeVal b x)
  | [], _, ValueBindings.nil => by
      simp [Bindings.removeVal]
      exact ValueBindings.nil
  | BindingRel.val y a :: rest, x, ValueBindings.val hrest => by
      by_cases hyx : y = x
      · subst hyx
        simp [Bindings.removeVal]
        exact removeVal_value hrest
      · have hbeq : (y != x) = true := by
          simp [hyx]
        simp [Bindings.removeVal, hbeq]
        exact ValueBindings.val (removeVal_value hrest)

/-- Raw value insertion preserves the value-only shape. -/
theorem addValRaw_value {b : Bindings} {x : VarName} {a : Atom}
    (hb : ValueBindings b) :
    ValueBindings (Bindings.addValRaw b x a) := by
  simp [Bindings.addValRaw]
  exact ValueBindings.val (removeVal_value hb)

/-
Legacy value-only merge closure is false when variable-valued relations become explicit `eq`.
/-- Consistency-checked value insertion preserves the value-only shape. -/
theorem addVarBinding_value_mem {b out : Bindings} {x : VarName} {a : Atom}
    (hb : ValueBindings b) (hout : out ∈ Bindings.addVarBinding b x a) :
    ValueBindings out := by
  unfold Bindings.addVarBinding at hout
  cases hlook : Bindings.lookupVal b x with
  | none =>
      simp [hlook] at hout
      rw [hout]
      exact addValRaw_value hb
  | some prev =>
      simp [hlook] at hout
      by_cases hprev : prev == a
      · simp [hprev] at hout
        rw [hout]
        exact hb
      · simp [hprev] at hout
        cases hunify : Metta.Unify.unifyTop prev a with
        | none =>
            simp [hunify] at hout
        | some _ =>
            simp [hunify] at hout
            rw [hout]
            exact addValRaw_value hb

/-- One value-binding merge step preserves value-only bindings. -/
theorem mergeOne_val_value_mem {accs : List Bindings} {x : VarName} {a : Atom}
    {out : Bindings}
    (haccs : ∀ b ∈ accs, ValueBindings b)
    (hout : out ∈ Bindings.mergeOne accs (BindingRel.val x a)) :
    ValueBindings out := by
  unfold Bindings.mergeOne at hout
  rw [List.mem_flatMap] at hout
  rcases hout with ⟨b, hb, hout⟩
  exact addVarBinding_value_mem (haccs b hb) hout

/-- Folding a value-only right-hand binding set through `Bindings.merge` preserves value-only
bindings. -/
theorem merge_value_right_value_mem : ∀ {right : Bindings}, ValueBindings right →
    ∀ {accs : List Bindings} {out : Bindings},
      (∀ b ∈ accs, ValueBindings b) →
        out ∈ right.foldl Bindings.mergeOne accs → ValueBindings out
  | [], ValueBindings.nil, _, out, haccs, hout => haccs out hout
  | BindingRel.val x a :: rest, ValueBindings.val hrest, accs, out, haccs, hout => by
      simp only [List.foldl_cons] at hout
      exact merge_value_right_value_mem hrest
        (fun b hb => mergeOne_val_value_mem haccs hb) hout

/-- Merging two value-only binding sets can only produce value-only binding sets. -/
theorem merge_value_value_mem {left right out : Bindings}
    (hleft : ValueBindings left) (hright : ValueBindings right)
    (hout : out ∈ Bindings.merge left right) :
    ValueBindings out := by
  exact merge_value_right_value_mem hright
    (accs := [left]) (out := out) (by
      intro b hb
      cases hb with
      | head => exact hleft
      | tail _ htail => cases htail) hout

-/

/-- If an expression atom is closed, then every immediate child is closed. -/
theorem expr_vars_nil_of_mem {ys : List Atom} (hclosed : (Atom.expr ys).vars = []) :
    ∀ y ∈ ys, y.vars = [] := by
  intro y hy
  rw [Atom.vars] at hclosed
  induction ys with
  | nil =>
      simp at hy
  | cons z zs ih =>
      simp only [List.map_cons, List.flatten_cons] at hclosed
      simp at hy
      rcases hy with hy | hy
      · subst hy
        cases hz : Atom.vars y with
        | nil =>
            rfl
        | cons _ _ =>
            simp [hz] at hclosed
      · exact ih (by
          cases hz : Atom.vars z with
          | nil =>
              simpa [hz] using hclosed
          | cons _ _ =>
              simp [hz] at hclosed) hy

/-- Matching against a closed target produces only closed value bindings.

This is the matcher-side invariant needed by the generic freshening bridge: once the query atom is
closed, runtime matching cannot introduce equality aliases or open values. Expression matching is
handled through `matchAll` and the closedness-preservation of `Bindings.merge`. -/
theorem matchAtomsWith_closed_value_mem :
    ∀ (lhs target : Atom) (b : Bindings),
      target.vars = [] → b ∈ matchAtomsWith none lhs target → ClosedValueBindings b := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s target b hclosed hmem
    cases target with
    | sym t =>
        simp [matchAtomsWith] at hmem
        rcases hmem with ⟨_, rfl⟩
        exact ClosedValueBindings.nil
    | var v =>
        simp [Atom.vars] at hclosed
    | gnd g =>
        simp [matchAtomsWith] at hmem
        rcases hmem with ⟨_, rfl⟩
        exact ClosedValueBindings.nil
    | expr xs =>
        simp [matchAtomsWith] at hmem
        rcases hmem with ⟨_, rfl⟩
        exact ClosedValueBindings.nil
  · intro v target b hclosed hmem
    cases target with
    | var w =>
        simp [Atom.vars] at hclosed
    | sym s =>
        simp [matchAtomsWith, Subst.occurs] at hmem
        rcases hmem with rfl
        exact ClosedValueBindings.val (by simp [Atom.vars]) ClosedValueBindings.nil
    | gnd g =>
        simp [matchAtomsWith, Subst.occurs] at hmem
        rcases hmem with rfl
        exact ClosedValueBindings.val (by simp [Atom.vars]) ClosedValueBindings.nil
    | expr xs =>
        have hocc : Subst.occurs v (Atom.expr xs) = false :=
          occurs_eq_false_of_not_mem_vars v (Atom.expr xs) (by simp [hclosed])
        simp [matchAtomsWith, hocc] at hmem
        rcases hmem with rfl
        exact ClosedValueBindings.val hclosed ClosedValueBindings.nil
  · intro g target b hclosed hmem
    cases target with
    | var w =>
        simp [Atom.vars] at hclosed
    | sym s =>
        simp [matchAtomsWith] at hmem
        rcases hmem with ⟨_, rfl⟩
        exact ClosedValueBindings.nil
    | gnd g2 =>
        simp [matchAtomsWith] at hmem
        rcases hmem with ⟨_, rfl⟩
        exact ClosedValueBindings.nil
    | expr xs =>
        simp [matchAtomsWith] at hmem
        rcases hmem with ⟨_, rfl⟩
        exact ClosedValueBindings.nil
  · intro xs ih target b hclosed hmem
    cases target with
    | var w =>
        simp [Atom.vars] at hclosed
    | sym s =>
        simp [matchAtomsWith] at hmem
        rcases hmem with ⟨_, rfl⟩
        exact ClosedValueBindings.nil
    | gnd g =>
        simp [matchAtomsWith] at hmem
        rcases hmem with ⟨_, rfl⟩
        exact ClosedValueBindings.nil
    | expr ys =>
        simp only [Atom.vars] at hclosed
        have hysClosed : ∀ y ∈ ys, y.vars = [] := by
          intro y hy
          apply List.eq_nil_iff_forall_not_mem.mpr
          intro v hv
          have hvflat : v ∈ (ys.map Atom.vars).flatten := by
            rw [List.mem_flatten]
            exact ⟨y.vars, by rw [List.mem_map]; exact ⟨y, hy, rfl⟩, hv⟩
          rw [hclosed] at hvflat
          cases hvflat
        have hlist : ∀ xs' ys' acc out,
            (∀ x ∈ xs', x ∈ xs) →
            (∀ y ∈ ys', y.vars = []) →
            (∀ c ∈ acc, ClosedValueBindings c) →
            out ∈ matchAll none acc xs' ys' → ClosedValueBindings out := by
          intro xs'
          induction xs' with
          | nil =>
              intro ys' acc out _hxsub _hyclosed hacc hout
              cases ys' with
              | nil =>
                  simpa [matchAll] using hacc out hout
              | cons y ys =>
                  simp [matchAll] at hout
          | cons x xsTail ihTail =>
              intro ys' acc out hxsub hyclosed hacc hout
              cases ys' with
              | nil =>
                  simp [matchAll] at hout
              | cons y ysTail =>
                  simp only [matchAll] at hout
                  exact ihTail ysTail
                    (acc.flatMap fun a =>
                      ((matchAtomsWith none x y).filter
                        (fun bindings => !bindings.hasLoop)).flatMap fun b => Bindings.merge a b)
                    out
                    (fun z hz => hxsub z (by simp [hz]))
                    (fun z hz => hyclosed z (by simp [hz]))
                    (by
                      intro c hc
                      rw [List.mem_flatMap] at hc
                      rcases hc with ⟨a, ha, hc⟩
                      rw [List.mem_flatMap] at hc
                      rcases hc with ⟨hb, hhb, hmerge⟩
                      have haClosed := hacc a ha
                      have hyClosed : y.vars = [] := hyclosed y (by simp)
                      have hbClosed := ih x (hxsub x (by simp)) y hb hyClosed
                        (List.mem_filter.mp hhb).1
                      exact merge_closed_closed_mem haClosed hbClosed hmerge)
                    hout
        exact hlist xs ys [[]] b (fun x hx => hx) hysClosed
          (by
            intro c hc
            cases hc with
            | head => exact ClosedValueBindings.nil
            | tail _ htail => cases htail)
          hmem

/-- The public matcher inherits closed-value preservation from the raw recursive matcher. -/
theorem matchAtoms_closed_value_mem
    (lhs target : Atom) (b : Bindings)
    (hclosed : target.vars = []) (hmem : b ∈ matchAtoms lhs target) :
    ClosedValueBindings b := by
  have hfiltered : b ∈
      (matchAtomsWith none lhs target).filter (fun bindings => !bindings.hasLoop) := by
    simpa [matchAtoms] using hmem
  exact matchAtomsWith_closed_value_mem lhs target b hclosed
    (List.mem_filter.mp hfiltered).1

/-- Value keys commute with binding-key renaming. -/
theorem bindingValueKeys_renameBindings (f : VarName → VarName) :
    ∀ b : Bindings, bindingValueKeys (renameBindings f b) = (bindingValueKeys b).map f
  | [] => by
      simp [bindingValueKeys, renameBindings]
  | BindingRel.val x a :: rest => by
      simp [bindingValueKeys, renameBindings, bindingValueKeys_renameBindings f rest]
  | BindingRel.eq x y :: rest => by
      simp [bindingValueKeys, renameBindings, bindingValueKeys_renameBindings f rest]

/-- If a key is absent from the value-key surface, direct value lookup does not find it. -/
theorem lookupVal_none_of_not_mem_keys {x : VarName} :
    ∀ {b : Bindings}, x ∉ bindingValueKeys b → Bindings.lookupVal b x = none
  | [], _ => by
      simp [Bindings.lookupVal]
  | BindingRel.val y a :: rest, hnot => by
      have hnotRest : x ∉ bindingValueKeys rest := by
        intro hx
        exact hnot (by simp [bindingValueKeys, hx])
      have hxy : x ≠ y := by
        intro h
        subst h
        exact hnot (by simp [bindingValueKeys])
      have hbeq : (x == y) = false := by
        simp [hxy]
      simp [Bindings.lookupVal, hbeq, lookupVal_none_of_not_mem_keys hnotRest]
  | BindingRel.eq y z :: rest, hnot => by
      have hnotRest : x ∉ bindingValueKeys rest := by
        simpa [bindingValueKeys] using hnot
      simpa [Bindings.lookupVal] using lookupVal_none_of_not_mem_keys hnotRest

/-- If a key is absent from the value-key surface, every `removeVal` filter test succeeds. -/
theorem removeVal_filter_true_of_not_mem {x : VarName} :
    ∀ {b : Bindings}, x ∉ bindingValueKeys b →
      ∀ r ∈ b, (match r with | BindingRel.val y _ => y != x | _ => true) = true
  | [], _, r, hr => by
      cases hr
  | BindingRel.val y a :: rest, hnot, r, hr => by
      cases hr with
      | head =>
          have hyx : y ≠ x := by
            intro h
            subst h
            exact hnot (by simp [bindingValueKeys])
          simp [hyx]
      | tail _ hrRest =>
          have hnotRest : x ∉ bindingValueKeys rest := by
            intro hx
            exact hnot (by simp [bindingValueKeys, hx])
          exact removeVal_filter_true_of_not_mem hnotRest r hrRest
  | BindingRel.eq y z :: rest, hnot, r, hr => by
      have hnotRest : x ∉ bindingValueKeys rest := by
        simpa [bindingValueKeys] using hnot
      cases hr with
      | head =>
          simp
      | tail _ hrRest =>
          exact removeVal_filter_true_of_not_mem hnotRest r hrRest

/-- Removing an absent value key is the identity. -/
theorem removeVal_not_mem_eq_self {x : VarName} {b : Bindings}
    (hnot : x ∉ bindingValueKeys b) :
    Bindings.removeVal b x = b := by
  unfold Bindings.removeVal
  exact List.filter_eq_self.mpr (removeVal_filter_true_of_not_mem hnot)

/-- Adding one non-variable value at a fresh value key and a valueless equality
class has exactly the raw-cons merge result. -/
theorem merge_singleton_val_eq_of_fresh_class
    {acc : Bindings} {x : VarName} {a : Atom}
    (hvalues : Bindings.classValues acc x = [])
    (hnotvar : ∀ y, a ≠ Atom.var y)
    (hnotkey : x ∉ bindingValueKeys acc) :
    Bindings.merge acc [BindingRel.val x a] = [[BindingRel.val x a] ++ acc] := by
  have hremove : Bindings.removeVal acc x = acc := removeVal_not_mem_eq_self hnotkey
  simp [Bindings.merge, Bindings.mergeOne,
    Bindings.addVarBinding_fresh hvalues hnotvar, Bindings.addValRaw, hremove]

/-- Adding one non-reflexive equality edge whose joined class is valueless has
exactly the raw-cons merge result. -/
theorem merge_singleton_eq_eq_of_valueless_class
    {acc : Bindings} {x y : VarName}
    (hxy : x ≠ y)
    (hvalues : Bindings.classValues (BindingRel.eq x y :: acc) x = []) :
    Bindings.merge acc [BindingRel.eq x y] =
      [[BindingRel.eq x y] ++ acc] := by
  have hbeq : (x == y) = false := beq_eq_false_iff_ne.mpr hxy
  simp [Bindings.merge, Bindings.mergeOne, Bindings.addVarEquality,
    Bindings.addEqRaw, hbeq, hvalues, Bindings.unifyValues]

/-- A value-only accumulator accepts a non-variable value at any fresh key with
exactly the raw-cons result. -/
theorem ValueBindings.merge_singleton_val_eq_of_not_key
    {acc : Bindings} {x : VarName} {a : Atom}
    (hacc : ValueBindings acc)
    (hnotvar : ∀ y, a ≠ Atom.var y)
    (hnotkey : x ∉ bindingValueKeys acc) :
    Bindings.merge acc [BindingRel.val x a] = [[BindingRel.val x a] ++ acc] := by
  have hlook := ValueBindings.lookup_none_of_not_key hacc hnotkey
  have hvalues := (ValueBindings.classValues_lookupVal hacc x).1 hlook
  exact merge_singleton_val_eq_of_fresh_class hvalues hnotvar hnotkey

/-- A one-binding merge into an accumulator with no binding for that key succeeds by raw insertion. -/
theorem mergeOne_singleton_val_of_not_mem {acc : Bindings} {x : VarName} {a : Atom}
    (hacc : ClosedValueBindings acc) (ha : a.vars = [])
    (hnot : x ∉ bindingValueKeys acc) :
    Bindings.mergeOne [acc] (BindingRel.val x a) = [[BindingRel.val x a] ++ acc] := by
  have hlook := ValueBindings.lookup_none_of_not_key hacc.toValueBindings hnot
  have hvalues := (ValueBindings.classValues_lookupVal hacc.toValueBindings x).1 hlook
  have hnotvar : ∀ y, a ≠ Atom.var y := by
    intro y h
    subst a
    simp [Atom.vars] at ha
  rw [Bindings.mergeOne]
  simp [Bindings.addVarBinding_fresh hvalues hnotvar, Bindings.addValRaw,
    removeVal_not_mem_eq_self hnot]

/-- Closed value bindings with distinct keys merge into an accumulator by prepending each value
binding, hence the final output is the reverse of the incoming binding list followed by the
accumulator. -/
theorem merge_closed_noConflict_mem :
    ∀ {b acc : Bindings}, ClosedValueBindings b → (bindingValueKeys b).Nodup →
      ClosedValueBindings acc →
      (∀ x ∈ bindingValueKeys b, x ∉ bindingValueKeys acc) →
        b.reverse ++ acc ∈ Bindings.merge acc b
  | [], acc, ClosedValueBindings.nil, _, _, _ => by
      simp [Bindings.merge]
  | BindingRel.val x a :: rest, acc, ClosedValueBindings.val hclosed hrest, hnodup, hacc,
      hdisj => by
      have hxNotAcc : x ∉ bindingValueKeys acc := hdisj x (by simp [bindingValueKeys])
      have hmergeOne := mergeOne_singleton_val_of_not_mem (acc := acc) (x := x) (a := a)
        hacc hclosed hxNotAcc
      have hnodupParts := List.nodup_cons.mp (by simpa [bindingValueKeys] using hnodup)
      have hxNotRest : x ∉ bindingValueKeys rest := hnodupParts.1
      have hnodupRest : (bindingValueKeys rest).Nodup := hnodupParts.2
      have hdisjRest : ∀ y ∈ bindingValueKeys rest,
          y ∉ bindingValueKeys (BindingRel.val x a :: acc) := by
        intro y hy
        have hyNotAcc : y ∉ bindingValueKeys acc := hdisj y (by simp [bindingValueKeys, hy])
        have hyNeX : y ≠ x := by
          intro h
          subst h
          exact hxNotRest hy
        intro hyMem
        simp [bindingValueKeys] at hyMem
        cases hyMem with
        | inl hyx => exact hyNeX hyx
        | inr hyacc => exact hyNotAcc hyacc
      have hnextClosed : ClosedValueBindings (BindingRel.val x a :: acc) :=
        ClosedValueBindings.val hclosed hacc
      have ih := merge_closed_noConflict_mem hrest hnodupRest hnextClosed hdisjRest
      unfold Bindings.merge
      simp only [List.foldl_cons]
      rw [hmergeOne]
      simpa [Bindings.merge, List.reverse_cons, List.append_assoc] using ih

/-- Closed value bindings with distinct, fresh keys have a unique merge result.
This exact form keeps matcher proofs at the binding interface instead of
unfolding equality-class resolution inside `addVarBinding`. -/
theorem merge_closed_noConflict_eq :
    ∀ {b acc : Bindings}, ClosedValueBindings b → (bindingValueKeys b).Nodup →
      ClosedValueBindings acc →
      (∀ x ∈ bindingValueKeys b, x ∉ bindingValueKeys acc) →
        Bindings.merge acc b = [b.reverse ++ acc]
  | [], acc, ClosedValueBindings.nil, _, _, _ => by
      simp [Bindings.merge]
  | BindingRel.val x a :: rest, acc, ClosedValueBindings.val hclosed hrest, hnodup, hacc,
      hdisj => by
      have hxNotAcc : x ∉ bindingValueKeys acc := hdisj x (by simp [bindingValueKeys])
      have hmergeOne := mergeOne_singleton_val_of_not_mem (acc := acc) (x := x) (a := a)
        hacc hclosed hxNotAcc
      have hnodupParts := List.nodup_cons.mp (by simpa [bindingValueKeys] using hnodup)
      have hxNotRest : x ∉ bindingValueKeys rest := hnodupParts.1
      have hnodupRest : (bindingValueKeys rest).Nodup := hnodupParts.2
      have hdisjRest : ∀ y ∈ bindingValueKeys rest,
          y ∉ bindingValueKeys (BindingRel.val x a :: acc) := by
        intro y hy
        have hyNotAcc : y ∉ bindingValueKeys acc := hdisj y (by simp [bindingValueKeys, hy])
        have hyNeX : y ≠ x := by
          intro h
          subst h
          exact hxNotRest hy
        intro hyMem
        simp [bindingValueKeys] at hyMem
        cases hyMem with
        | inl hyx => exact hyNeX hyx
        | inr hyacc => exact hyNotAcc hyacc
      have hnextClosed : ClosedValueBindings (BindingRel.val x a :: acc) :=
        ClosedValueBindings.val hclosed hacc
      have ih := merge_closed_noConflict_eq hrest hnodupRest hnextClosed hdisjRest
      unfold Bindings.merge
      simp only [List.foldl_cons]
      rw [hmergeOne]
      simpa [Bindings.merge, List.reverse_cons, List.append_assoc] using ih

/-- Adding a closed value at a distinct key to one closed value has a unique
two-relation result in runtime cons order. -/
theorem merge_singleton_closed_vals_eq
    {existingKey newKey : VarName} {existingValue newValue : Atom}
    (hexistingClosed : existingValue.vars = [])
    (hnewClosed : newValue.vars = [])
    (hkeys : newKey ≠ existingKey) :
    Bindings.merge [BindingRel.val existingKey existingValue]
        [BindingRel.val newKey newValue] =
      [[BindingRel.val newKey newValue, BindingRel.val existingKey existingValue]] := by
  apply merge_closed_noConflict_eq
  · exact ClosedValueBindings.val hnewClosed ClosedValueBindings.nil
  · simp [bindingValueKeys]
  · exact ClosedValueBindings.val hexistingClosed ClosedValueBindings.nil
  · intro key hkey
    simp [bindingValueKeys] at hkey
    subst key
    simpa [bindingValueKeys] using hkeys

/-
Legacy exact-list merge is false for variable-valued relations, which merge as explicit `eq`.
/-- Value-only bindings with distinct keys merge into an accumulator by prepending each value
binding, even when the values are open. -/
theorem merge_value_noConflict_mem :
    ∀ {b acc : Bindings}, ValueBindings b → (bindingValueKeys b).Nodup →
      (∀ x ∈ bindingValueKeys b, x ∉ bindingValueKeys acc) →
        b.reverse ++ acc ∈ Bindings.merge acc b
  | [], acc, ValueBindings.nil, _, _ => by
      simp [Bindings.merge]
  | BindingRel.val x a :: rest, acc, ValueBindings.val hrest, hnodup, hdisj => by
      have hxNotAcc : x ∉ bindingValueKeys acc := hdisj x (by simp [bindingValueKeys])
      have hmergeOne := mergeOne_singleton_val_of_not_mem (acc := acc) (x := x) (a := a) hxNotAcc
      have hnodupParts := List.nodup_cons.mp (by simpa [bindingValueKeys] using hnodup)
      have hxNotRest : x ∉ bindingValueKeys rest := hnodupParts.1
      have hnodupRest : (bindingValueKeys rest).Nodup := hnodupParts.2
      have hdisjRest : ∀ y ∈ bindingValueKeys rest,
          y ∉ bindingValueKeys (BindingRel.val x a :: acc) := by
        intro y hy
        have hyNotAcc : y ∉ bindingValueKeys acc := hdisj y (by simp [bindingValueKeys, hy])
        have hyNeX : y ≠ x := by
          intro h
          subst h
          exact hxNotRest hy
        intro hyMem
        simp [bindingValueKeys] at hyMem
        cases hyMem with
        | inl hyx => exact hyNeX hyx
        | inr hyacc => exact hyNotAcc hyacc
      have ih := merge_value_noConflict_mem hrest hnodupRest hdisjRest
      unfold Bindings.merge
      simp only [List.foldl_cons]
      rw [hmergeOne]
      simpa [Bindings.merge, List.reverse_cons, List.append_assoc] using ih

-/

/-- Empty-ambient form of `merge_closed_noConflict_mem`. -/
theorem merge_empty_closed_nodup_mem {b : Bindings}
    (hclosed : ClosedValueBindings b) (hnodup : (bindingValueKeys b).Nodup) :
    b.reverse ∈ Bindings.merge [] b := by
  simpa using
    (merge_closed_noConflict_mem (b := b) (acc := []) hclosed hnodup
      ClosedValueBindings.nil
      (by intro x hx hmem; cases hmem))

/-- Renamed closed value bindings with distinct original keys merge from an empty ambient binding set
to the reversed renamed binding list. -/
theorem merge_empty_renamed_closed_nodup_mem {f : VarName → VarName} (hf : Function.Injective f)
    {b : Bindings} (hclosed : ClosedValueBindings b) (hnodup : (bindingValueKeys b).Nodup) :
    (renameBindings f b).reverse ∈ Bindings.merge [] (renameBindings f b) := by
  apply merge_empty_closed_nodup_mem
  · exact ClosedValueBindings.rename hclosed
  · rw [bindingValueKeys_renameBindings]
    exact List.Nodup.map hf hnodup

/-
Legacy renamed value-only exact-list merge; see the observational transport layer below.
/-- Renamed value-only bindings with distinct original keys merge from an empty ambient binding set
to the reversed renamed binding list, without requiring closed values. -/
theorem merge_empty_renamed_value_nodup_mem {f : VarName → VarName} (hf : Function.Injective f)
    {b : Bindings} (hval : ValueBindings b) (hnodup : (bindingValueKeys b).Nodup) :
    (renameBindings f b).reverse ∈ Bindings.merge [] (renameBindings f b) := by
  simpa using
    (merge_value_noConflict_mem (b := renameBindings f b) (acc := [])
      (ValueBindings.rename hval) (by
        rw [bindingValueKeys_renameBindings]
        exact List.Nodup.map hf hnodup)
      (by intro x hx hmem; cases hmem))

-/

/-- Value lookup over appended binding lists checks the left list first, then the right list. -/
theorem lookupVal_append (a b : Bindings) (x : VarName) :
    Bindings.lookupVal (a ++ b) x =
      (Bindings.lookupVal a x).orElse (fun _ => Bindings.lookupVal b x) := by
  induction a with
  | nil =>
      simp [Bindings.lookupVal]
  | cons r rest ih =>
      cases r with
      | val y atom =>
          by_cases hxy : x = y
          · subst hxy
            simp [Bindings.lookupVal]
          · have hbeq : (x == y) = false := by
              simp [hxy]
            simp [Bindings.lookupVal, hbeq, ih]
      | eq y z =>
          simp [Bindings.lookupVal, ih]

/-- A singleton binding for a different key does not affect lookup. -/
theorem lookupVal_singleton_ne {x y : VarName} (hxy : x ≠ y) (a : Atom) :
    Bindings.lookupVal [BindingRel.val y a] x = none := by
  have hbeq : (x == y) = false := by
    simp [hxy]
  simp [Bindings.lookupVal, hbeq]

/-- Reversing a closed-value binding set with distinct keys preserves direct value lookup. -/
theorem lookupVal_reverse_closed_nodup :
    ∀ {b : Bindings}, ClosedValueBindings b → (bindingValueKeys b).Nodup →
      ∀ q, Bindings.lookupVal b.reverse q = Bindings.lookupVal b q
  | [], ClosedValueBindings.nil, _, q => by
      simp [Bindings.lookupVal]
  | BindingRel.val key val :: rest, ClosedValueBindings.val hclosed hrest, hnodup, q => by
      have parts := List.nodup_cons.mp (by simpa [bindingValueKeys] using hnodup)
      have keyNotRest : key ∉ bindingValueKeys rest := parts.1
      have hnodupRest : (bindingValueKeys rest).Nodup := parts.2
      rw [List.reverse_cons, lookupVal_append]
      by_cases hqkey : q = key
      · have hrevNone : Bindings.lookupVal rest.reverse q = none := by
          rw [lookupVal_reverse_closed_nodup hrest hnodupRest]
          exact lookupVal_none_of_not_mem_keys (by simpa [hqkey] using keyNotRest)
        rw [hrevNone]
        simp [Bindings.lookupVal, hqkey]
      · have hrestEq := lookupVal_reverse_closed_nodup hrest hnodupRest q
        have hbeq : (q == key) = false := by
          simp [hqkey]
        rw [hrestEq]
        cases hrestLookup : Bindings.lookupVal rest q <;>
          simp [Bindings.lookupVal, hbeq, hrestLookup]

/-- Reversing a value-only binding set with distinct keys preserves direct value lookup, even when
values are open. -/
theorem lookupVal_reverse_value_nodup :
    ∀ {b : Bindings}, ValueBindings b → (bindingValueKeys b).Nodup →
      ∀ q, Bindings.lookupVal b.reverse q = Bindings.lookupVal b q
  | [], ValueBindings.nil, _, q => by
      simp [Bindings.lookupVal]
  | BindingRel.val key val :: rest, ValueBindings.val hrest, hnodup, q => by
      have parts := List.nodup_cons.mp (by simpa [bindingValueKeys] using hnodup)
      have keyNotRest : key ∉ bindingValueKeys rest := parts.1
      have hnodupRest : (bindingValueKeys rest).Nodup := parts.2
      rw [List.reverse_cons, lookupVal_append]
      by_cases hqkey : q = key
      · have hrevNone : Bindings.lookupVal rest.reverse q = none := by
          rw [lookupVal_reverse_value_nodup hrest hnodupRest]
          exact lookupVal_none_of_not_mem_keys (by simpa [hqkey] using keyNotRest)
        rw [hrevNone]
        simp [Bindings.lookupVal, hqkey]
      · have hrestEq := lookupVal_reverse_value_nodup hrest hnodupRest q
        have hbeq : (q == key) = false := by
          simp [hqkey]
        rw [hrestEq]
        cases hrestLookup : Bindings.lookupVal rest q <;>
          simp [Bindings.lookupVal, hbeq, hrestLookup]

/-- Looking up a value binding after `bindingsToSubst` agrees with direct `Bindings.lookupVal`.
Equality-only binding relations are ignored by both sides for instantiation. -/
theorem lookup_bindingsToSubst (b : Bindings) (v : VarName) :
    Metta.Subst.lookup (bindingsToSubst b) v = Bindings.lookupVal b v := by
  induction b with
  | nil =>
      simp [bindingsToSubst, Metta.Subst.lookup, Bindings.lookupVal]
  | cons r rest ih =>
      cases r with
      | val x a =>
          by_cases hx : v = x
          · subst hx
            simp [bindingsToSubst, Metta.Subst.lookup, Bindings.lookupVal]
          · have hvx : (v == x) = false := by
              simp [hx]
            simpa [bindingsToSubst, Metta.Subst.lookup, Bindings.lookupVal, hvx] using ih
      | eq x y =>
          simpa [bindingsToSubst, Bindings.lookupVal] using ih

/-- Value lookup commutes with an injective binding-key renaming. -/
theorem lookupVal_renameBindings_injective (f : VarName → VarName) (hf : Function.Injective f) :
    ∀ (b : Bindings) (v : VarName),
      Bindings.lookupVal (renameBindings f b) (f v) = Bindings.lookupVal b v := by
  intro b
  induction b with
  | nil =>
      intro v
      simp [renameBindings, Bindings.lookupVal]
  | cons r rest ih =>
      intro v
      cases r with
      | val x a =>
          by_cases hx : x = v
          · subst hx
            simp [renameBindings, Bindings.lookupVal]
          · have hfx : f v ≠ f x := by
              intro h
              exact hx ((hf h).symm)
            have hbeq1 : (f v == f x) = false := by
              simp [hfx]
            have hbeq2 : (v == x) = false := by
              have hvx : v ≠ x := by
                intro h
                exact hx h.symm
              simp [hvx]
            simpa [renameBindings, Bindings.lookupVal, hbeq1, hbeq2] using ih v
      | eq x y =>
          simpa [renameBindings, Bindings.lookupVal] using ih v

/-- Removing a value binding commutes with injective binding-key renaming. -/
theorem removeVal_renameBindings (f : VarName → VarName) (hf : Function.Injective f) :
    ∀ (b : Bindings) (x : VarName),
      Bindings.removeVal (renameBindings f b) (f x) =
        renameBindings f (Bindings.removeVal b x) := by
  intro b
  induction b with
  | nil =>
      intro x
      simp [Bindings.removeVal, renameBindings]
  | cons r rest ih =>
      intro x
      cases r with
      | val y a =>
          by_cases hxy : y = x
          · subst hxy
            simp [Bindings.removeVal, renameBindings]
            simpa [Bindings.removeVal] using ih y
          · have hfy : f y ≠ f x := by
              intro h
              exact hxy (hf h)
            have hbeq1 : (f y != f x) = true := by simp [hfy]
            have hbeq2 : (y != x) = true := by simp [hxy]
            simp [Bindings.removeVal, renameBindings, hbeq1, hbeq2]
            simpa [Bindings.removeVal] using ih x
      | eq y z =>
          simp [Bindings.removeVal, renameBindings]
          simpa [Bindings.removeVal] using ih x

/-- Raw value insertion commutes with injective binding-key renaming. -/
theorem addValRaw_renameBindings (f : VarName → VarName) (hf : Function.Injective f)
    (b : Bindings) (x : VarName) (a : Atom) :
    Bindings.addValRaw (renameBindings f b) (f x) a =
      renameBindings f (Bindings.addValRaw b x a) := by
  simp [Bindings.addValRaw, renameBindings, removeVal_renameBindings f hf]

/-- Equality-class values commute with injective key renaming on value-only bindings. -/
theorem classValues_renameBindings_value (f : VarName → VarName) (hf : Function.Injective f) :
    ∀ {b : Bindings}, ValueBindings b → ∀ x,
      Bindings.classValues (renameBindings f b) (f x) = Bindings.classValues b x
  | b, hval, x => by
      rw [Bindings.classValues_eq_lookupVal_toList_of_eqVarsInOrder_nil
          (ValueBindings.eqVarsInOrder_nil (ValueBindings.rename hval)) (f x),
        Bindings.classValues_eq_lookupVal_toList_of_eqVarsInOrder_nil
          (ValueBindings.eqVarsInOrder_nil hval) x,
        lookupVal_renameBindings_injective f hf b x]

/-- Consistency-checked insertion of a closed value commutes with injective key renaming on a closed
value-only accumulator. -/
theorem addVarBinding_renameBindings (f : VarName → VarName) (hf : Function.Injective f)
    (b : Bindings) (x : VarName) (a : Atom)
    (hb : ClosedValueBindings b) (ha : a.vars = []) :
    Bindings.addVarBinding (renameBindings f b) (f x) a =
      (Bindings.addVarBinding b x a).map (renameBindings f) := by
  have hclasses := classValues_renameBindings_value f hf hb.toValueBindings x
  have hnotvar : ∀ y, a ≠ Atom.var y := by
    intro y h
    subst a
    simp [Atom.vars] at ha
  cases hvalues : Bindings.classValues b x with
  | nil =>
      have hvaluesRen : Bindings.classValues (renameBindings f b) (f x) = [] := by
        rw [hclasses, hvalues]
      rw [Bindings.addVarBinding_fresh hvaluesRen hnotvar,
        Bindings.addVarBinding_fresh hvalues hnotvar,
        addValRaw_renameBindings f hf]
      rfl
  | cons first rest =>
      have hvaluesRen : Bindings.classValues (renameBindings f b) (f x) = first :: rest := by
        rw [hclasses, hvalues]
      cases hunify : Bindings.unifyValues ((first :: rest) ++ [a]) with
      | none =>
          rw [Bindings.addVarBinding_conflict hnotvar hvaluesRen (by simp) hunify,
            Bindings.addVarBinding_conflict hnotvar hvalues (by simp) hunify]
          rfl
      | some sigma =>
          have hclosedValues : ∀ value ∈ (first :: rest) ++ [a], value.vars = [] := by
            intro value hmem
            rw [List.mem_append] at hmem
            rcases hmem with hmemClass | hmemLast
            · exact ClosedValueBindings.classValues_closed hb x value (by
                rw [hvalues]
                exact hmemClass)
            · simp at hmemLast
              subst value
              exact ha
          have hsigma := Bindings.unifyValues_some_eq_empty_of_closed hclosedValues hunify
          subst sigma
          rw [Bindings.addVarBinding_nochange hnotvar hvaluesRen (by simp) hunify,
            Bindings.addVarBinding_nochange hnotvar hvalues (by simp) hunify]
          rfl

/-- One value-binding merge step commutes with injective binding-key renaming. -/
theorem mergeOne_val_renameBindings (f : VarName → VarName) (hf : Function.Injective f)
    (accs : List Bindings) (x : VarName) (a : Atom)
    (haccs : ∀ b ∈ accs, ClosedValueBindings b) (ha : a.vars = []) :
    Bindings.mergeOne (accs.map (renameBindings f)) (BindingRel.val (f x) a) =
      (Bindings.mergeOne accs (BindingRel.val x a)).map (renameBindings f) := by
  unfold Bindings.mergeOne
  simp only [List.flatMap_map, List.map_flatMap]
  apply List.flatMap_congr
  intro b hb
  exact addVarBinding_renameBindings f hf b x a (haccs b hb) ha

/-- Folding a closed value-only right-hand binding set through `Bindings.merge` commutes with
injective binding-key renaming. This is the merge-layer component of the generic freshened-matcher
bridge: runtime freshening renames rule-variable keys, but matched closed values are unchanged. -/
theorem merge_closed_right_renameBindings_mem (f : VarName → VarName) (hf : Function.Injective f) :
    ∀ {right : Bindings}, ClosedValueBindings right →
      ∀ {accs : List Bindings} {out : Bindings},
        (∀ b ∈ accs, ClosedValueBindings b) →
        out ∈ right.foldl Bindings.mergeOne accs →
          renameBindings f out ∈
            (renameBindings f right).foldl Bindings.mergeOne (accs.map (renameBindings f))
  | [], ClosedValueBindings.nil, accs, out, _haccs, hout => by
      simpa [renameBindings] using List.mem_map.mpr ⟨out, hout, rfl⟩
  | BindingRel.val x a :: rest, ClosedValueBindings.val hclosed hrest, accs, out, haccs, hout => by
      simp only [List.foldl_cons] at hout
      have hnext : ∀ b ∈ Bindings.mergeOne accs (BindingRel.val x a),
          ClosedValueBindings b := by
        intro b hb
        exact mergeOne_val_closed_mem hclosed haccs hb
      have ih := merge_closed_right_renameBindings_mem f hf hrest hnext (out := out) hout
      simp only [renameBindings, List.foldl_cons]
      rw [mergeOne_val_renameBindings f hf accs x a haccs hclosed]
      exact ih

/-- `Bindings.merge` commutes with injective key-renaming when the right-hand binding set is
closed and value-only. -/
theorem merge_renameBindings_closed_right_mem (f : VarName → VarName) (hf : Function.Injective f)
    {left right out : Bindings}
    (hclosedLeft : ClosedValueBindings left) (hclosedRight : ClosedValueBindings right)
    (hout : out ∈ Bindings.merge left right) :
    renameBindings f out ∈
      Bindings.merge (renameBindings f left) (renameBindings f right) := by
  simpa [Bindings.merge] using
    (merge_closed_right_renameBindings_mem f hf hclosedRight
      (accs := [left]) (out := out) (by
        intro b hb
        simp at hb
        subst b
        exact hclosedLeft) hout)

/-
Blind key renaming is not equivariant for target-origin relations emitted by open unification.
/-- Folding a value-only right-hand binding set through `Bindings.merge` commutes with injective
binding-key renaming. Values are intentionally not renamed: runtime rule freshening changes
rule-variable keys, while target atoms remain in the ambient namespace. -/
theorem merge_value_right_renameBindings_mem (f : VarName → VarName) (hf : Function.Injective f) :
    ∀ {right : Bindings}, ValueBindings right →
      ∀ {accs : List Bindings} {out : Bindings},
        out ∈ right.foldl Bindings.mergeOne accs →
          renameBindings f out ∈
            (renameBindings f right).foldl Bindings.mergeOne (accs.map (renameBindings f))
  | [], ValueBindings.nil, accs, out, hout => by
      simpa [renameBindings] using List.mem_map.mpr ⟨out, hout, rfl⟩
  | BindingRel.val x a :: rest, ValueBindings.val hrest, accs, out, hout => by
      simp only [List.foldl_cons] at hout
      have ih := merge_value_right_renameBindings_mem f hf hrest (out := out) hout
      simp only [renameBindings, List.foldl_cons]
      rw [mergeOne_val_renameBindings f hf accs x a]
      exact ih

/-- `Bindings.merge` commutes with injective key-renaming when the right-hand binding set is
value-only. -/
theorem merge_renameBindings_value_right_mem (f : VarName → VarName) (hf : Function.Injective f)
    {left right out : Bindings}
    (hvalueRight : ValueBindings right)
    (hout : out ∈ Bindings.merge left right) :
    renameBindings f out ∈
      Bindings.merge (renameBindings f left) (renameBindings f right) := by
  simpa [Bindings.merge] using
    (merge_value_right_renameBindings_mem f hf hvalueRight (accs := [left]) (out := out) hout)

-/

/-- The closed-target hypothesis in `matchAtoms_renBy_closed_target_mem` is load-bearing.

For open targets, runtime rule freshening can change a same-variable match into a value-binding
match: `$x` matches `$x` with the empty binding, but `$x#0` matches `$x` by binding `$x#0 ← $x`.
So the naive open-target theorem that renames every binding key is false. A correct open-target
extension needs either origin-aware key renaming or explicit hypotheses excluding target-origin
binding keys. -/
theorem not_matchAtoms_renBy_open_target_rename_all :
    ¬ (∀ (lhs target : Atom) (b : Bindings),
      b ∈ matchAtoms lhs target →
        renameBindings (counterSuffix 0) b ∈
          matchAtoms (renBy (counterSuffix 0) lhs) target) := by
  intro h
  have hcore : ([] : Bindings) ∈ matchAtoms (Atom.var "x") (Atom.var "x") := by
    simp [matchAtoms, matchAtomsWith, Bindings.hasLoop, Bindings.vars]
  have hfresh := h (Atom.var "x") (Atom.var "x") ([] : Bindings) hcore
  have hne : "x#" ++ Nat.repr 0 ≠ "x" := by decide
  simp [renameBindings, matchAtoms, matchAtomsWith, counterSuffix, hne,
    Bindings.hasLoop, Bindings.vars] at hfresh

/-
Source-origin shape for open-target matcher transport.

The pattern may bind variables to open target atoms, but target-side variables are never used as
binding keys. In the variable case the two freshness premises exclude exactly the counterexample in
`not_matchAtoms_renBy_open_target_rename_all`: neither the raw rule variable nor its freshened name is
allowed to occur in the target value. -/
mutual
  def LeftPatternShape (f : VarName → VarName) : Atom → Atom → Prop
    | Atom.var v, target => v ∉ target.vars ∧ f v ∉ target.vars
    | Atom.sym s, Atom.sym t => s = t
    | Atom.gnd g, Atom.gnd h => Atom.equiv (Atom.gnd g) (Atom.gnd h) = true
    | Atom.expr xs, Atom.expr ys => LeftPatternShapeList f xs ys
    | _, _ => False

  def LeftPatternShapeList (f : VarName → VarName) : List Atom → List Atom → Prop
    | [], [] => True
    | x :: xs, y :: ys => LeftPatternShape f x y ∧ LeftPatternShapeList f xs ys
    | _, _ => False
end

/-
The pre-equality-class open matcher ladder assumed value-only output and blind endpoint renaming.
It is retained here only as historical context while the active proof uses observational bindings.
/-- Under `LeftPatternShape`, matcher output is value-only even when the target carries ambient
variables. The shape rules out target-origin variable bindings. -/
theorem matchAtoms_leftPattern_value_mem (f : VarName → VarName) :
    ∀ (lhs target : Atom) (b : Bindings),
      LeftPatternShape f lhs target → b ∈ matchAtoms lhs target → ValueBindings b := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s target b hshape hmem
    cases target with
    | sym t =>
        simp [LeftPatternShape] at hshape
        subst hshape
        simp [matchAtoms, matchAtomsWith] at hmem
        rcases hmem with rfl
        exact ValueBindings.nil
    | var _ =>
        simp [LeftPatternShape] at hshape
    | gnd _ =>
        simp [LeftPatternShape] at hshape
    | expr _ =>
        simp [LeftPatternShape] at hshape
  · intro v target b hshape hmem
    have hraw : v ∉ target.vars := by
      simpa [LeftPatternShape] using hshape.1
    cases target with
    | var w =>
        simp [Atom.vars] at hraw
        have hvw : v ≠ w := hraw
        simp [matchAtoms, matchAtomsWith, hvw] at hmem
        rcases hmem with rfl
        exact ValueBindings.val ValueBindings.nil
    | sym _ =>
        simp [matchAtoms, matchAtomsWith, Subst.occurs] at hmem
        rcases hmem with rfl
        exact ValueBindings.val ValueBindings.nil
    | gnd _ =>
        simp [matchAtoms, matchAtomsWith, Subst.occurs] at hmem
        rcases hmem with rfl
        exact ValueBindings.val ValueBindings.nil
    | expr xs =>
        have hocc : Subst.occurs v (Atom.expr xs) = false :=
          occurs_eq_false_of_not_mem_vars v (Atom.expr xs) hraw
        simp [matchAtoms, matchAtomsWith, hocc] at hmem
        rcases hmem with rfl
        exact ValueBindings.val ValueBindings.nil
  · intro g target b hshape hmem
    cases target with
    | gnd h =>
        have hequiv : Atom.equiv (Atom.gnd g) (Atom.gnd h) = true := by
          simpa [LeftPatternShape] using hshape
        simp [matchAtoms, matchAtomsWith, hequiv] at hmem
        rcases hmem with rfl
        exact ValueBindings.nil
    | var _ =>
        simp [LeftPatternShape] at hshape
    | sym _ =>
        simp [LeftPatternShape] at hshape
    | expr _ =>
        simp [LeftPatternShape] at hshape
  · intro xs ih target b hshape hmem
    cases target with
    | expr ys =>
        have hshapeList : LeftPatternShapeList f xs ys := by
          simpa [LeftPatternShape] using hshape
        simp only [matchAtoms, matchAtomsWith] at hmem
        have hhelper : ∀ xs' ys' acc out,
            (∀ x ∈ xs', x ∈ xs) →
            LeftPatternShapeList f xs' ys' →
            (∀ c ∈ acc, ValueBindings c) →
            out ∈ matchAll none acc xs' ys' → ValueBindings out := by
          intro xs'
          induction xs' with
          | nil =>
              intro ys' acc out _ hshapeList hacc hout
              cases ys' <;> simp [LeftPatternShapeList, matchAll] at hshapeList hout
              exact hacc out hout
          | cons x xsTail ihTail =>
              intro ys' acc out hxsub hshapeList hacc hout
              cases ys' with
              | nil =>
                  simp [LeftPatternShapeList] at hshapeList
              | cons y ysTail =>
                  simp only [LeftPatternShapeList] at hshapeList
                  rcases hshapeList with ⟨hxy, htailShape⟩
                  simp only [matchAll] at hout
                  exact ihTail ysTail
                    (acc.flatMap (fun a =>
                      (matchAtomsWith none x y).flatMap fun bb => Bindings.merge a bb)) out
                    (by intro z hz; exact hxsub z (by simp [hz])) htailShape
                    (by
                      intro merged hmerged
                      rw [List.mem_flatMap] at hmerged
                      rcases hmerged with ⟨a, ha, hmerged⟩
                      rw [List.mem_flatMap] at hmerged
                      rcases hmerged with ⟨bb, hbb, hmerge⟩
                      exact merge_value_value_mem (hacc a ha)
                        (ih x (hxsub x (by simp)) y bb hxy (by simpa [matchAtoms] using hbb))
                        hmerge)
                    hout
        exact hhelper xs ys [[]] b (by intro x hx; exact hx) hshapeList
          (by intro c hc; simp at hc; subst c; exact ValueBindings.nil) hmem
    | var _ =>
        simp [LeftPatternShape] at hshape
    | sym _ =>
        simp [LeftPatternShape] at hshape
    | gnd _ =>
        simp [LeftPatternShape] at hshape

/-- Open-target matcher transport for source-origin matches.

This is the positive successor to the false unrestricted open-target theorem: if the match shape says
all binding keys originate from the LHS pattern, runtime freshening transports a matcher witness by
renaming binding keys, while leaving open target values untouched. -/
theorem matchAtoms_renBy_leftPattern_mem (f : VarName → VarName) (hf : Function.Injective f) :
    ∀ (lhs target : Atom) (b : Bindings),
      LeftPatternShape f lhs target → b ∈ matchAtoms lhs target →
        renameBindings f b ∈ matchAtoms (renBy f lhs) target := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s target b hshape hmem
    cases target with
    | sym t =>
        simp [LeftPatternShape] at hshape
        subst hshape
        simp [matchAtoms, matchAtomsWith, renBy] at hmem ⊢
        rcases hmem with rfl
        rfl
    | var _ =>
        simp [LeftPatternShape] at hshape
    | gnd _ =>
        simp [LeftPatternShape] at hshape
    | expr _ =>
        simp [LeftPatternShape] at hshape
  · intro v target b hshape hmem
    have hraw : v ∉ target.vars := by
      simpa [LeftPatternShape] using hshape.1
    have hfresh : f v ∉ target.vars := by
      simpa [LeftPatternShape] using hshape.2
    cases target with
    | var w =>
        simp [Atom.vars] at hraw hfresh
        have hvw : v ≠ w := hraw
        have hfw : f v ≠ w := hfresh
        simp [matchAtoms, matchAtomsWith, hvw, hfw] at hmem ⊢
        rcases hmem with rfl
        rfl
    | sym _ =>
        simp [matchAtoms, matchAtomsWith, Subst.occurs] at hmem ⊢
        rcases hmem with rfl
        rfl
    | gnd _ =>
        simp [matchAtoms, matchAtomsWith, Subst.occurs] at hmem ⊢
        rcases hmem with rfl
        rfl
    | expr xs =>
        have hocc : Subst.occurs v (Atom.expr xs) = false :=
          occurs_eq_false_of_not_mem_vars v (Atom.expr xs) hraw
        have hfocc : Subst.occurs (f v) (Atom.expr xs) = false :=
          occurs_eq_false_of_not_mem_vars (f v) (Atom.expr xs) hfresh
        simp [matchAtoms, matchAtomsWith, hocc, hfocc] at hmem ⊢
        rcases hmem with rfl
        rfl
  · intro g target b hshape hmem
    cases target with
    | gnd h =>
        have hequiv : Atom.equiv (Atom.gnd g) (Atom.gnd h) = true := by
          simpa [LeftPatternShape] using hshape
        simp [matchAtoms, matchAtomsWith, renBy, hequiv] at hmem ⊢
        rcases hmem with rfl
        rfl
    | var _ =>
        simp [LeftPatternShape] at hshape
    | sym _ =>
        simp [LeftPatternShape] at hshape
    | expr _ =>
        simp [LeftPatternShape] at hshape
  · intro xs ih target b hshape hmem
    cases target with
    | expr ys =>
        have hshapeList : LeftPatternShapeList f xs ys := by
          simpa [LeftPatternShape] using hshape
        simp only [matchAtoms, matchAtomsWith, renBy_expr]
        simp only [matchAtoms, matchAtomsWith] at hmem
        have hhelper : ∀ xs' ys' acc accRen out,
            (∀ x ∈ xs', x ∈ xs) →
            LeftPatternShapeList f xs' ys' →
            (∀ a ∈ acc, renameBindings f a ∈ accRen) →
            out ∈ matchAll none acc xs' ys' →
              renameBindings f out ∈ matchAll none accRen (xs'.map (renBy f)) ys' := by
          intro xs'
          induction xs' with
          | nil =>
              intro ys' acc accRen out _ hshapeList hacc hout
              cases ys' <;> simp [LeftPatternShapeList, matchAll] at hshapeList hout ⊢
              exact hacc out hout
          | cons x xsTail ihTail =>
              intro ys' acc accRen out hxsub hshapeList hacc hout
              cases ys' with
              | nil =>
                  simp [LeftPatternShapeList] at hshapeList
              | cons y ysTail =>
                  simp only [LeftPatternShapeList] at hshapeList
                  rcases hshapeList with ⟨hxy, htailShape⟩
                  simp only [matchAll] at hout ⊢
                  exact ihTail ysTail
                    (acc.flatMap (fun a =>
                      (matchAtomsWith none x y).flatMap fun bb => Bindings.merge a bb))
                    (accRen.flatMap (fun a =>
                      (matchAtomsWith none (renBy f x) y).flatMap fun bb => Bindings.merge a bb))
                    out
                    (by intro z hz; exact hxsub z (by simp [hz])) htailShape
                    (by
                      intro merged hmerged
                      rw [List.mem_flatMap] at hmerged ⊢
                      rcases hmerged with ⟨a, ha, hmerged⟩
                      rw [List.mem_flatMap] at hmerged
                      rcases hmerged with ⟨bb, hbb, hmerge⟩
                      have haRen := hacc a ha
                      have hbbRen : renameBindings f bb ∈ matchAtoms (renBy f x) y :=
                        ih x (hxsub x (by simp)) y bb hxy (by simpa [matchAtoms] using hbb)
                      refine ⟨renameBindings f a, haRen, ?_⟩
                      rw [List.mem_flatMap]
                      refine ⟨renameBindings f bb, hbbRen, ?_⟩
                      have hbbVal : ValueBindings bb :=
                        matchAtoms_leftPattern_value_mem f x y bb hxy
                          (by simpa [matchAtoms] using hbb)
                      exact merge_renameBindings_value_right_mem f hf hbbVal hmerge)
                    hout
        exact hhelper xs ys [[]] [[]] b (by intro x hx; exact hx) hshapeList
          (by intro a ha; simp at ha; subst a; simp [renameBindings]) hmem
    | var _ =>
        simp [LeftPatternShape] at hshape
    | sym _ =>
        simp [LeftPatternShape] at hshape
    | gnd _ =>
        simp [LeftPatternShape] at hshape

/-- Runtime freshening on the rule LHS transports matcher bindings for source-origin open matches. -/
theorem matchAtoms_freshenRule_lhs_leftPattern_mem
    (counter : Nat) {lhs rhs target : Atom} {b : Bindings}
    (hshape : LeftPatternShape (counterSuffix counter) lhs target)
    (hmatch : b ∈ matchAtoms lhs target) :
    renameBindings (counterSuffix counter) b ∈
      matchAtoms (freshenRule counter lhs rhs).1 target := by
  rw [freshenRule_eq_renBy]
  exact matchAtoms_renBy_leftPattern_mem
    (counterSuffix counter) (counterSuffix_injective counter) lhs target b hshape hmatch

-/

/-- Matching a renamed pattern against a closed target transports matcher bindings by renaming
their keys. The target values are not renamed: runtime rule freshening changes only rule-variable
names, while the queried atom stays in the ambient namespace. -/
theorem matchAtomsWith_renBy_closed_target_mem (f : VarName → VarName)
    (hf : Function.Injective f) :
    ∀ (lhs target : Atom) (b : Bindings),
      target.vars = [] → b ∈ matchAtomsWith none lhs target →
        renameBindings f b ∈ matchAtomsWith none (renBy f lhs) target := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s target b hclosed hmem
    cases target with
    | sym t =>
        simp [matchAtomsWith, renBy] at hmem ⊢
        rcases hmem with ⟨hst, rfl⟩
        exact ⟨hst, rfl⟩
    | var _ =>
        simp [Atom.vars] at hclosed
    | gnd _ =>
        simp [matchAtomsWith, Atom.equiv] at hmem
    | expr _ =>
        simp [matchAtomsWith, Atom.equiv] at hmem
  · intro v target b hclosed hmem
    cases target with
    | var _ =>
        simp [Atom.vars] at hclosed
    | sym _ =>
        simp [matchAtomsWith, Subst.occurs] at hmem ⊢
        rcases hmem with rfl
        rfl
    | gnd _ =>
        simp [matchAtomsWith, Subst.occurs] at hmem ⊢
        rcases hmem with rfl
        rfl
    | expr xs =>
        have hvNot : v ∉ (Atom.expr xs).vars := by simp [hclosed]
        have hfvNot : f v ∉ (Atom.expr xs).vars := by simp [hclosed]
        have hocc : Subst.occurs v (Atom.expr xs) = false :=
          occurs_eq_false_of_not_mem_vars v (Atom.expr xs) hvNot
        have hfocc : Subst.occurs (f v) (Atom.expr xs) = false :=
          occurs_eq_false_of_not_mem_vars (f v) (Atom.expr xs) hfvNot
        simp [matchAtomsWith, hocc, hfocc] at hmem ⊢
        rcases hmem with rfl
        rfl
  · intro g target b hclosed hmem
    cases target with
    | var _ =>
        simp [Atom.vars] at hclosed
    | sym _ =>
        simp [matchAtomsWith, Atom.equiv] at hmem
    | gnd _ =>
        simp [matchAtomsWith, renBy] at hmem ⊢
        rcases hmem with ⟨hgg, rfl⟩
        exact ⟨hgg, rfl⟩
    | expr _ =>
        simp [matchAtomsWith, Atom.equiv] at hmem
  · intro xs ih target b hclosed hmem
    cases target with
    | var _ =>
        simp [Atom.vars] at hclosed
    | sym _ =>
        simp [matchAtomsWith, Atom.equiv] at hmem
    | gnd _ =>
        simp [matchAtomsWith, Atom.equiv] at hmem
    | expr ys =>
        simp only [matchAtomsWith, renBy_expr]
        simp only [matchAtomsWith] at hmem
        have hysClosed : ∀ y ∈ ys, y.vars = [] := expr_vars_nil_of_mem hclosed
        have hlist : ∀ xs' ys' acc accRen out,
            (∀ x ∈ xs', x ∈ xs) →
            (∀ y ∈ ys', y.vars = []) →
            (∀ a ∈ acc, ClosedValueBindings a) →
            (∀ a ∈ acc, renameBindings f a ∈ accRen) →
            out ∈ matchAll none acc xs' ys' →
              renameBindings f out ∈ matchAll none accRen (xs'.map (renBy f)) ys' := by
          intro xs'
          induction xs' with
          | nil =>
              intro ys' acc accRen out _ _ _haccClosed hacc hout
              cases ys' with
              | nil =>
                  simp only [matchAll] at hout ⊢
                  exact hacc out hout
              | cons _ _ =>
                  simp [matchAll] at hout
          | cons x xsTail ihTail =>
              intro ys' acc accRen out hxsub hysClosed' haccClosed hacc hout
              cases ys' with
              | nil =>
                  simp [matchAll] at hout
              | cons y ysTail =>
                  simp only [matchAll] at hout ⊢
                  exact ihTail ysTail
                    (acc.flatMap (fun a =>
                      ((matchAtomsWith none x y).filter
                        (fun bindings => !bindings.hasLoop)).flatMap fun b => Bindings.merge a b))
                    (accRen.flatMap (fun a =>
                      ((matchAtomsWith none (renBy f x) y).filter
                        (fun bindings => !bindings.hasLoop)).flatMap fun b => Bindings.merge a b))
                    out
                    (by intro z hz; exact hxsub z (by simp [hz]))
                    (by intro z hz; exact hysClosed' z (by simp [hz]))
                    (by
                      intro merged hmerged
                      rw [List.mem_flatMap] at hmerged
                      rcases hmerged with ⟨a, ha, hmerged⟩
                      rw [List.mem_flatMap] at hmerged
                      rcases hmerged with ⟨b0, hb0, hmerge⟩
                      have hbClosed : ClosedValueBindings b0 :=
                        matchAtomsWith_closed_value_mem x y b0 (hysClosed' y (by simp))
                          (List.mem_filter.mp hb0).1
                      exact merge_closed_closed_mem (haccClosed a ha) hbClosed hmerge)
                    (by
                      intro merged hmerged
                      rw [List.mem_flatMap] at hmerged ⊢
                      rcases hmerged with ⟨a, ha, hmerged⟩
                      rw [List.mem_flatMap] at hmerged
                      rcases hmerged with ⟨b0, hb0, hmerge⟩
                      have haRen : renameBindings f a ∈ accRen := hacc a ha
                      have hbClosed : ClosedValueBindings b0 :=
                        matchAtomsWith_closed_value_mem x y b0 (hysClosed' y (by simp))
                          (List.mem_filter.mp hb0).1
                      have hbRenRaw : renameBindings f b0 ∈ matchAtomsWith none (renBy f x) y :=
                        ih x (hxsub x (by simp)) y b0 (hysClosed' y (by simp))
                          (List.mem_filter.mp hb0).1
                      have hbRen : renameBindings f b0 ∈
                          (matchAtomsWith none (renBy f x) y).filter
                            (fun bindings => !bindings.hasLoop) := by
                        rw [List.mem_filter]
                        exact ⟨hbRenRaw, by
                          simp [ClosedValueBindings.rename_hasLoop_false hbClosed]⟩
                      refine ⟨renameBindings f a, haRen, ?_⟩
                      rw [List.mem_flatMap]
                      refine ⟨renameBindings f b0, hbRen, ?_⟩
                      exact merge_renameBindings_closed_right_mem f hf
                        (haccClosed a ha) hbClosed hmerge)
                    hout
        exact hlist xs ys [[]] [[]] b (by intro x hx; exact hx) hysClosed
          (by intro a ha; simp at ha; subst a; exact ClosedValueBindings.nil)
          (by intro a ha; simp at ha; subst a; simp [renameBindings]) hmem

/-- Public closed-target matching transports across injective rule-variable renaming. -/
theorem matchAtoms_renBy_closed_target_mem (f : VarName → VarName) (hf : Function.Injective f)
    (lhs target : Atom) (b : Bindings)
    (hclosed : target.vars = []) (hmem : b ∈ matchAtoms lhs target) :
    renameBindings f b ∈ matchAtoms (renBy f lhs) target := by
  have hfiltered : b ∈
      (matchAtomsWith none lhs target).filter (fun bindings => !bindings.hasLoop) := by
    simpa [matchAtoms] using hmem
  have hraw := (List.mem_filter.mp hfiltered).1
  have hrenRaw := matchAtomsWith_renBy_closed_target_mem f hf
    lhs target b hclosed hraw
  have hclosedB := matchAtomsWith_closed_value_mem lhs target b hclosed hraw
  rw [matchAtoms, List.mem_filter]
  exact ⟨hrenRaw, by
    simp [ClosedValueBindings.rename_hasLoop_false hclosedB]⟩

/-- LeaTTa runtime freshening on the rule LHS transports matcher bindings by renaming their
variable keys when the queried atom is closed. -/
theorem matchAtoms_freshenRule_lhs_closed_target_mem
    (counter : Nat) {lhs rhs target : Atom} {b : Bindings}
    (hclosed : target.vars = [])
    (hmatch : b ∈ matchAtoms lhs target) :
    renameBindings (counterSuffix counter) b ∈
      matchAtoms (freshenRule counter lhs rhs).1 target := by
  rw [freshenRule_eq_renBy]
  exact matchAtoms_renBy_closed_target_mem
    (counterSuffix counter) (counterSuffix_injective counter) lhs target b hclosed hmatch

/-- Instantiation depends only on full variable-resolution observations made at variables occurring
in the instantiated atom. This is the representation-independent substitution interface used by the
query bridge. -/
theorem instantiate_eq_of_resolve_on_vars :
    ∀ (b1 b2 : Bindings) (a : Atom),
      (∀ v ∈ a.vars, Bindings.resolve b1 v = Bindings.resolve b2 v) →
        instantiate b1 a = instantiate b2 a := by
  intro b1 b2
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s _
    simp [instantiate, Bindings.resolveAtom]
  · intro v hresolve
    simp only [instantiate, Bindings.resolveAtom]
    rw [hresolve v (by simp [Atom.vars])]
  · intro g _
    simp [instantiate, Bindings.resolveAtom]
  · intro xs ih hresolve
    simp only [instantiate, Bindings.resolveAtom]
    congr 1
    apply List.map_congr_left
    intro child hchild
    exact ih child hchild (fun v hv => hresolve v (by
      simp only [Atom.vars, List.mem_flatten, List.mem_map]
      exact ⟨child.vars, ⟨child, hchild, rfl⟩, hv⟩))

/-- Instantiation observes the resolved atom with unknown variables defaulted
to themselves; equality classes that resolve to the same variable are therefore
equivalent to an absent direct binding at this boundary. -/
theorem instantiate_eq_of_resolve_readout_on_vars :
    ∀ (b1 b2 : Bindings) (a : Atom),
      (∀ v ∈ a.vars,
        (Bindings.resolve b1 v).getD (Atom.var v) =
          (Bindings.resolve b2 v).getD (Atom.var v)) →
        instantiate b1 a = instantiate b2 a := by
  intro b1 b2
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s _
    simp [instantiate, Bindings.resolveAtom]
  · intro v hresolve
    simpa only [instantiate, Bindings.resolveAtom] using
      hresolve v (by simp [Atom.vars])
  · intro g _
    simp [instantiate, Bindings.resolveAtom]
  · intro xs ih hresolve
    simp only [instantiate, Bindings.resolveAtom]
    congr 1
    apply List.map_congr_left
    intro child hchild
    exact ih child hchild (fun v hv => hresolve v (by
      simp only [Atom.vars, List.mem_flatten, List.mem_map]
      exact ⟨child.vars, ⟨child, hchild, rfl⟩, hv⟩))

/-- If every variable of `a` is assigned by an acyclic value-only environment, then instantiating
the renamed atom under renamed binding keys agrees exactly with instantiating the original atom.
Both freshness hypotheses are load-bearing for open values: values retain ambient variable names
when runtime freshening renames rule-variable keys. -/
theorem instantiate_renBy_of_renamed_bindings
    (f : VarName → VarName) (hf : Function.Injective f) :
    ∀ (b : Bindings) (a : Atom),
      ValueBindings b → ValueKeysFreshForValues b →
      RenamedValueKeysFreshForValues f b →
      (∀ v ∈ a.vars, ∃ t, Bindings.lookupVal b v = some t) →
        instantiate (renameBindings f b) (renBy f a) = instantiate b a := by
  intro b
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s _hval _hfresh _hrenamed _hbound
    simp [instantiate, Bindings.resolveAtom, renBy]
  · intro v hval hfresh hrenamed hbound
    rcases hbound v (by simp [Atom.vars]) with ⟨t, ht⟩
    have hvalRen := ValueBindings.rename (f := f) hval
    have hfreshRen := ValueKeysFreshForValues.rename hrenamed
    simp only [instantiate, Bindings.resolveAtom, renBy]
    rw [ValueBindings.resolve_eq_lookupVal_of_fresh hvalRen hfreshRen (f v),
      ValueBindings.resolve_eq_lookupVal_of_fresh hval hfresh v,
      lookupVal_renameBindings_injective f hf]
    simp [ht]
  · intro g _hval _hfresh _hrenamed _hbound
    simp [instantiate, Bindings.resolveAtom, renBy]
  · intro xs ih hval hfresh hrenamed hbound
    simp only [instantiate, Bindings.resolveAtom, renBy_expr]
    congr 1
    rw [List.map_map]
    apply List.map_congr_left
    intro child hchild
    exact ih child hchild hval hfresh hrenamed (fun v hv => hbound v (by
      simp only [Atom.vars, List.mem_flatten, List.mem_map]
      exact ⟨child.vars, ⟨child, hchild, rfl⟩, hv⟩))

/-- Direct value lookup in a closed-value binding set can only return a closed atom. -/
theorem lookupVal_closed_value :
    ∀ {b : Bindings}, ClosedValueBindings b →
      ∀ {v : VarName} {a : Atom},
        Bindings.lookupVal b v = some a → a.vars = []
  | [], ClosedValueBindings.nil, _v, _a, h => by
      simp [Bindings.lookupVal] at h
  | BindingRel.val x value :: rest, ClosedValueBindings.val hvalueClosed hrest, v, a, h => by
      by_cases hvx : v = x
      · subst hvx
        simp [Bindings.lookupVal] at h
        cases h
        exact hvalueClosed
      · have hbeq : (v == x) = false := by
          simp [hvx]
        simp [Bindings.lookupVal, hbeq] at h
        exact lookupVal_closed_value hrest h

/-- On closed value-only environments, full equality-class instantiation is conservative over the
legacy assignment substitution. -/
theorem ClosedValueBindings.instantiate_eq_subst_apply {b : Bindings}
    (hclosed : ClosedValueBindings b) :
    ∀ a : Atom, instantiate b a = (bindingsToSubst b).apply a := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s
    simp [instantiate, Bindings.resolveAtom, Metta.Subst.apply]
  · intro v
    simp only [instantiate, Bindings.resolveAtom, Metta.Subst.apply]
    rw [ClosedValueBindings.resolve_eq_lookupVal hclosed v, lookup_bindingsToSubst]
  · intro g
    simp [instantiate, Bindings.resolveAtom, Metta.Subst.apply]
  · intro xs ih
    simp only [instantiate, Bindings.resolveAtom, Metta.Subst.apply]
    congr 1
    apply List.map_congr_left
    intro child hchild
    exact ih child hchild

/-- On acyclic value-only environments, full equality-class instantiation is
conservative over legacy assignment substitution. -/
theorem ValueBindings.instantiate_eq_subst_apply_of_fresh {b : Bindings}
    (hval : ValueBindings b) (hfresh : ValueKeysFreshForValues b) :
    ∀ a : Atom, instantiate b a = (bindingsToSubst b).apply a := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro symbol
    simp [instantiate, Bindings.resolveAtom, Metta.Subst.apply]
  · intro v
    simp only [instantiate, Bindings.resolveAtom, Metta.Subst.apply]
    rw [ValueBindings.resolve_eq_lookupVal_of_fresh hval hfresh v,
      lookup_bindingsToSubst]
  · intro grounded
    simp [instantiate, Bindings.resolveAtom, Metta.Subst.apply]
  · intro children ih
    simp only [instantiate, Bindings.resolveAtom, Metta.Subst.apply]
    congr 1
    apply List.map_congr_left
    intro child hchild
    exact ih child hchild

/-- Instantiating twice under closed value-only bindings is the same as instantiating once.

This is the generic final-readout stability fact used by the fuel driver: once a runtime rule
result has been instantiated with a closed matcher environment, LeaTTa's final `finalPair`
projection cannot change it by applying the same environment again. -/
theorem instantiate_closed_value_bindings_idempotent
    {b : Bindings} (hclosed : ClosedValueBindings b) :
    ∀ a : Atom, instantiate b (instantiate b a) = instantiate b a := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s
    simp [instantiate, Bindings.resolveAtom]
  · intro v
    simp only [instantiate, Bindings.resolveAtom]
    rw [ClosedValueBindings.resolve_eq_lookupVal hclosed v]
    cases hlook : Bindings.lookupVal b v with
    | none =>
        simp [hlook, Bindings.resolveAtom,
          ClosedValueBindings.resolve_eq_lookupVal hclosed]
    | some value =>
        have hvalueClosed : value.vars = [] := lookupVal_closed_value hclosed hlook
        simp only [Option.getD_some]
        exact instantiate_of_closed b value hvalueClosed
  · intro g
    simp [instantiate, Bindings.resolveAtom]
  · intro xs ih
    simp only [instantiate, Bindings.resolveAtom]
    rw [List.map_map]
    congr 1
    apply List.map_congr_left
    intro child hchild
    exact ih child hchild

/-- Closed substitutions commute with injective runtime renaming up to the renamed result.

Unlike `instantiate_renBy_of_renamed_bindings`, this does not require the atom's variables to be
covered by the binding set. Unbound variables are renamed on both sides; bound variables map to
closed values, hence the outer renaming is inert on those substituted values. -/
theorem instantiate_renBy_of_renamed_closed_bindings
    (f : VarName → VarName) (hf : Function.Injective f) :
    ∀ (b : Bindings) (a : Atom),
      ClosedValueBindings b →
        instantiate (renameBindings f b) (renBy f a) =
          renBy f (instantiate b a) := by
  intro b
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s _hclosed
    simp [instantiate, Bindings.resolveAtom, renBy]
  · intro v hclosed
    have hclosedRen := ClosedValueBindings.rename (f := f) hclosed
    simp only [instantiate, Bindings.resolveAtom, renBy]
    rw [ClosedValueBindings.resolve_eq_lookupVal hclosedRen (f v),
      ClosedValueBindings.resolve_eq_lookupVal hclosed v,
      lookupVal_renameBindings_injective f hf]
    cases hlook : Bindings.lookupVal b v with
    | none =>
        simp
    | some value =>
        have hvalueClosed : value.vars = [] := lookupVal_closed_value hclosed hlook
        have hren : renBy f value = value := renBy_eq_self_of_vars_nil f value hvalueClosed
        simp [hren]
  · intro g _hclosed
    simp [instantiate, Bindings.resolveAtom, renBy]
  · intro xs ih hclosed
    simp only [instantiate, Bindings.resolveAtom, renBy_expr]
    congr 1
    rw [List.map_map, List.map_map]
    apply List.map_congr_left
    intro child hchild
    exact ih child hchild hclosed

/-- On closed value-only environments, lookup agreement on an atom's variables implies
instantiation agreement. -/
theorem instantiate_eq_of_closed_lookupVal_on_vars
    (b1 b2 : Bindings) (hclosed1 : ClosedValueBindings b1)
    (hclosed2 : ClosedValueBindings b2) (a : Atom)
    (hlookup : ∀ v ∈ a.vars, Bindings.lookupVal b1 v = Bindings.lookupVal b2 v) :
    instantiate b1 a = instantiate b2 a :=
  instantiate_eq_of_resolve_on_vars b1 b2 a (fun v hv => by
    rw [ClosedValueBindings.resolve_eq_lookupVal hclosed1 v,
      ClosedValueBindings.resolve_eq_lookupVal hclosed2 v]
    exact hlookup v hv)

/-- On acyclic value-only environments, lookup agreement on an atom's variables implies
instantiation agreement. -/
theorem instantiate_eq_of_fresh_lookupVal_on_vars
    (b1 b2 : Bindings) (hval1 : ValueBindings b1) (hval2 : ValueBindings b2)
    (hfresh1 : ValueKeysFreshForValues b1) (hfresh2 : ValueKeysFreshForValues b2)
    (a : Atom)
    (hlookup : ∀ v ∈ a.vars, Bindings.lookupVal b1 v = Bindings.lookupVal b2 v) :
    instantiate b1 a = instantiate b2 a :=
  instantiate_eq_of_resolve_on_vars b1 b2 a (fun v hv => by
    rw [ValueBindings.resolve_eq_lookupVal_of_fresh hval1 hfresh1 v,
      ValueBindings.resolve_eq_lookupVal_of_fresh hval2 hfresh2 v]
    exact hlookup v hv)

/-- Reversing closed value bindings with distinct keys preserves instantiation. -/
theorem instantiate_reverse_closed_nodup
    {b : Bindings} (hclosed : ClosedValueBindings b) (hnodup : (bindingValueKeys b).Nodup)
    (a : Atom) :
    instantiate b.reverse a = instantiate b a :=
  instantiate_eq_of_closed_lookupVal_on_vars b.reverse b
    (ClosedValueBindings.reverse hclosed) hclosed a
    (fun v _ => lookupVal_reverse_closed_nodup hclosed hnodup v)

/-- Reversing value-only bindings with distinct keys preserves instantiation, even when values are
open. -/
theorem instantiate_reverse_value_nodup
    {b : Bindings} (hval : ValueBindings b) (hnodup : (bindingValueKeys b).Nodup)
    (hfresh : ValueKeysFreshForValues b)
    (a : Atom) :
    instantiate b.reverse a = instantiate b a :=
  instantiate_eq_of_fresh_lookupVal_on_vars b.reverse b (ValueBindings.reverse hval) hval
    (ValueKeysFreshForValues.reverse hval hfresh) hfresh a
    (fun v _ => lookupVal_reverse_value_nodup hval hnodup v)

/-- A successful direct value lookup is witnessed by a value-binding member. -/
theorem lookupVal_some_val_mem {x : VarName} {a : Atom} :
    ∀ {b : Bindings}, Bindings.lookupVal b x = some a → BindingRel.val x a ∈ b
  | [], h => by
      simp [Bindings.lookupVal] at h
  | BindingRel.val y value :: rest, h => by
      by_cases hxy : x = y
      · subst hxy
        simp [Bindings.lookupVal] at h
        cases h
        simp
      · have hbeq : (x == y) = false := by
          simp [hxy]
        simp [Bindings.lookupVal, hbeq] at h
        exact List.mem_cons_of_mem _ (lookupVal_some_val_mem h)
  | BindingRel.eq y z :: rest, h => by
      simp [Bindings.lookupVal] at h
      exact List.mem_cons_of_mem _ (lookupVal_some_val_mem h)

/-- If every value-binding key is fresh for an atom, instantiation under that binding set is inert. -/
theorem instantiate_eq_self_of_fresh_value_keys (b : Bindings) (a : Atom)
    (hval : ValueBindings b) (hacyclic : ValueKeysFreshForValues b)
    (hfresh : ∀ x ∈ bindingValueKeys b, x ∉ a.vars) :
    instantiate b a = a := by
  have hlookup : ∀ v ∈ a.vars, Bindings.lookupVal b v = Bindings.lookupVal [] v := by
    intro v hv
    have hvNotKeys : v ∉ bindingValueKeys b := by
      intro hmem
      exact hfresh v hmem hv
    rw [lookupVal_none_of_not_mem_keys hvNotKeys]
    simp [Bindings.lookupVal]
  calc
    instantiate b a = instantiate [] a :=
      instantiate_eq_of_fresh_lookupVal_on_vars b [] hval ValueBindings.nil hacyclic
        (by intro key hkey; cases hkey) a hlookup
    _ = a := Metta.instantiate_nil a

/-- A renamed/reversed value-only binding set cannot further instantiate any value that belonged to
the original binding set, provided freshened keys are fresh for all original values. -/
theorem instantiate_renamed_reverse_eq_self_of_value_mem
    {f : VarName → VarName} (hf : Function.Injective f)
    {b : Bindings} {x : VarName} {a : Atom}
    (hval : ValueBindings b)
    (hnodup : (bindingValueKeys b).Nodup)
    (hfresh : RenamedValueKeysFreshForValues f b)
    (hmem : BindingRel.val x a ∈ b) :
    instantiate (renameBindings f b).reverse a = a := by
  have hvalRen : ValueBindings (renameBindings f b) := ValueBindings.rename hval
  have hnodupRen : (bindingValueKeys (renameBindings f b)).Nodup := by
    rw [bindingValueKeys_renameBindings]
    exact List.Nodup.map hf hnodup
  have hfreshRen : ValueKeysFreshForValues (renameBindings f b) :=
    ValueKeysFreshForValues.rename hfresh
  calc
    instantiate (renameBindings f b).reverse a
        = instantiate (renameBindings f b) a :=
          instantiate_reverse_value_nodup hvalRen hnodupRen hfreshRen a
    _ = a := by
      apply instantiate_eq_self_of_fresh_value_keys _ _ hvalRen hfreshRen
      intro key hkey
      rw [bindingValueKeys_renameBindings] at hkey
      rcases List.mem_map.mp hkey with ⟨orig, horig, rfl⟩
      exact hfresh orig horig x a hmem

/-- Final-readout stability for open value-only bindings: once `b` has substituted every RHS
variable, the runtime-renamed/reversed binding set cannot change the substituted RHS again. -/
theorem instantiate_renamed_reverse_stable_after_value_subst
    {f : VarName → VarName} (hf : Function.Injective f)
    {b : Bindings} (hval : ValueBindings b)
    (hnodup : (bindingValueKeys b).Nodup)
    (hacyclic : ValueKeysFreshForValues b)
    (hfresh : RenamedValueKeysFreshForValues f b) :
    ∀ (rhs : Atom), (∀ v ∈ rhs.vars, ∃ t, Bindings.lookupVal b v = some t) →
      instantiate (renameBindings f b).reverse (instantiate b rhs) = instantiate b rhs := by
  refine Metta.Atom.recAux ?_ ?_ ?_ ?_
  · intro s _
    simp [instantiate, Bindings.resolveAtom]
  · intro v hbound
    simp only [instantiate, Bindings.resolveAtom]
    rw [ValueBindings.resolve_eq_lookupVal_of_fresh hval hacyclic v]
    cases hlook : Bindings.lookupVal b v with
    | none =>
        rcases hbound v (by simp [Atom.vars]) with ⟨t, ht⟩
        rw [hlook] at ht
        cases ht
    | some a =>
        have hmem : BindingRel.val v a ∈ b := lookupVal_some_val_mem hlook
        have hstable := instantiate_renamed_reverse_eq_self_of_value_mem
          (f := f) hf hval hnodup hfresh hmem
        simp only [Option.getD_some]
        exact hstable
  · intro g _
    simp [instantiate, Bindings.resolveAtom]
  · intro xs ih hbound
    simp only [instantiate, Bindings.resolveAtom]
    rw [List.map_map]
    congr 1
    apply List.map_congr_left
    intro child hchild
    exact ih child hchild (fun v hv => hbound v (by
      simp only [Atom.vars, List.mem_flatten, List.mem_map]
      exact ⟨child.vars, ⟨child, hchild, rfl⟩, hv⟩))

/-- RHS-specialized form for LeaTTa's `freshenRule`: when the unfreshened core binding covers every
RHS variable, the runtime-freshened RHS instantiated under renamed binding keys is exactly the
certified unfreshened reduct. -/
theorem instantiate_freshenRule_rhs_of_renamed_bindings
    (counter : Nat) (lhs rhs : Atom) (b : Bindings)
    (hval : ValueBindings b) (hacyclic : ValueKeysFreshForValues b)
    (hfresh : RenamedValueKeysFreshForValues (counterSuffix counter) b)
    (hbound : ∀ v ∈ rhs.vars, ∃ t, Bindings.lookupVal b v = some t) :
    instantiate (renameBindings (counterSuffix counter) b) (freshenRule counter lhs rhs).2 =
      instantiate b rhs := by
  rw [freshenRule_eq_renBy]
  exact instantiate_renBy_of_renamed_bindings
    (counterSuffix counter) (counterSuffix_injective counter) b rhs hval hacyclic hfresh hbound

/-- Runtime freshening followed by a closed substitution is α-equivalent to the certified
unfreshened substitution, even when the RHS contains variables not bound by the matcher. Those
escaping variables are renamed by the runtime and then forgotten by canonicalization. -/
theorem instantiate_freshenRule_rhs_alpha_of_renamed_closed_bindings
    (counter : Nat) (lhs rhs : Atom) (b : Bindings)
    (hclosed : ClosedValueBindings b)
    (hnodup : (bindingValueKeys b).Nodup) :
    Metta.AlphaEq
      (instantiate (renameBindings (counterSuffix counter) b).reverse
        (freshenRule counter lhs rhs).2)
      (instantiate b rhs) := by
  unfold Metta.AlphaEq
  let f := counterSuffix counter
  have hf : Function.Injective f := by
    simpa [f] using counterSuffix_injective counter
  have hclosedRen : ClosedValueBindings (renameBindings f b) :=
    ClosedValueBindings.rename hclosed
  have hnodupRen : (bindingValueKeys (renameBindings f b)).Nodup := by
    rw [bindingValueKeys_renameBindings]
    exact List.Nodup.map hf hnodup
  have hreverseInst :
      instantiate (renameBindings f b).reverse (freshenRule counter lhs rhs).2 =
        instantiate (renameBindings f b) (freshenRule counter lhs rhs).2 :=
    instantiate_reverse_closed_nodup hclosedRen hnodupRen _
  have hfresh :
      instantiate (renameBindings f b) (freshenRule counter lhs rhs).2 =
        renBy f (instantiate b rhs) := by
    rw [freshenRule_eq_renBy]
    exact instantiate_renBy_of_renamed_closed_bindings f hf b rhs hclosed
  calc
    Metta.canonicalizeVars
        (instantiate (renameBindings (counterSuffix counter) b).reverse
          (freshenRule counter lhs rhs).2)
        = Metta.canonicalizeVars (renBy f (instantiate b rhs)) := by
            change Metta.canonicalizeVars
                (instantiate (renameBindings f b).reverse (freshenRule counter lhs rhs).2) =
              Metta.canonicalizeVars (renBy f (instantiate b rhs))
            rw [hreverseInst, hfresh]
    _ = Metta.canonicalizeVars (instantiate b rhs) :=
          canonicalizeVars_renBy_of_injective hf (instantiate b rhs)

/-- LeaTTa runtime freshening is α-inert on the LHS: canonicalization forgets the fresh counter
suffixes. This is the generic α component needed before relating executable `queryOp` output to
the un-freshened `firedReducts` semantics. -/
theorem freshenRule_alphaEq_fst
    (counter : Nat) (lhs rhs : Metta.Atom) :
    Metta.AlphaEq (Metta.Minimal.freshenRule counter lhs rhs).1 lhs := by
  unfold Metta.AlphaEq
  unfold Metta.Minimal.freshenRule
  cases hvars : lhs.vars ++ rhs.vars with
  | nil =>
      simp
  | cons v vs =>
      simp
      have hsubset : ∀ x ∈ lhs.vars, x ∈ v :: vs := by
        intro x hx
        rw [← hvars]
        exact List.mem_append_left rhs.vars hx
      calc
        Metta.canonicalizeVars
            (Metta.Subst.apply
              ((v, Metta.Atom.var (v ++ "#" ++ counter.repr)) ::
                vs.map fun x => (x, Metta.Atom.var (x ++ "#" ++ counter.repr))) lhs)
            =
              Metta.canonicalizeVars (renBy (counterSuffix counter) lhs) := by
                have happly :=
                  counterSubst_apply_eq_renBy_of_varsSubset counter (v :: vs) lhs hsubset
                simpa [counterSuffix] using congrArg Metta.canonicalizeVars happly
        _ = Metta.canonicalizeVars lhs :=
              canonicalizeVars_renBy_of_injective (counterSuffix_injective counter) lhs

/-- LeaTTa runtime freshening is α-inert on the RHS as well. -/
theorem freshenRule_alphaEq_snd
    (counter : Nat) (lhs rhs : Metta.Atom) :
    Metta.AlphaEq (Metta.Minimal.freshenRule counter lhs rhs).2 rhs := by
  unfold Metta.AlphaEq
  unfold Metta.Minimal.freshenRule
  cases hvars : lhs.vars ++ rhs.vars with
  | nil =>
      simp
  | cons v vs =>
      simp
      have hsubset : ∀ x ∈ rhs.vars, x ∈ v :: vs := by
        intro x hx
        rw [← hvars]
        exact List.mem_append_right lhs.vars hx
      calc
        Metta.canonicalizeVars
            (Metta.Subst.apply
              ((v, Metta.Atom.var (v ++ "#" ++ counter.repr)) ::
                vs.map fun x => (x, Metta.Atom.var (x ++ "#" ++ counter.repr))) rhs)
            =
              Metta.canonicalizeVars (renBy (counterSuffix counter) rhs) := by
                have happly :=
                  counterSubst_apply_eq_renBy_of_varsSubset counter (v :: vs) rhs hsubset
                simpa [counterSuffix] using congrArg Metta.canonicalizeVars happly
        _ = Metta.canonicalizeVars rhs :=
              canonicalizeVars_renBy_of_injective (counterSuffix_injective counter) rhs

/-- A candidate rule and one of its matcher bindings determine a certified indexed-kernel reduct.
This is the small generic bridge from the candidate/matcher side to LeaTTa's `firedReducts`
semantics; freshening, ambient-binding merge, and loop-pruning remain separate obligations for
the executable `queryOp` layer. -/
theorem firedReducts_of_candidate_match
    {atoms : List Atom} {gt : GroundingTable} {toEval lhs rhs : Atom} {b : Bindings}
    (hcand : (lhs, rhs) ∈ (MinEnv.ofAtomsGT atoms gt).candidates toEval)
    (hmatch : b ∈ matchAtoms lhs toEval) :
    instantiate b rhs ∈
      firedReducts ((MinEnv.ofAtomsGT atoms gt).candidates toEval) toEval := by
  rw [Metta.mem_firedReducts]
  exact ⟨(lhs, rhs), hcand, b, hmatch, rfl⟩

/-- Candidate/matcher form of a certified root `KernelStep`. -/
theorem kernelStep_of_candidate_match
    {atoms : List Atom} {gt : GroundingTable} {toEval lhs rhs : Atom} {b : Bindings}
    (hhead : ∃ k, headKey toEval = some k)
    (hcand : (lhs, rhs) ∈ (MinEnv.ofAtomsGT atoms gt).candidates toEval)
    (hmatch : b ∈ matchAtoms lhs toEval) :
    KernelStep atoms gt toEval (instantiate b rhs) :=
  ⟨hhead, firedReducts_of_candidate_match hcand hmatch⟩

/-- Split-index form of `kernelStep_of_candidate_match`, aligned with the executable `queryOp`
fold counter. -/
theorem kernelStep_of_staticCandidateSplit_match
    {atoms : List Atom} {gt : GroundingTable} {toEval lhs rhs : Atom} {b : Bindings}
    {pre post : List (Atom × Atom)}
    (hhead : ∃ k, headKey toEval = some k)
    (hsplit : (MinEnv.ofAtomsGT atoms gt).candidates toEval = pre ++ (lhs, rhs) :: post)
    (hmatch : b ∈ matchAtoms lhs toEval) :
    KernelStep atoms gt toEval (instantiate b rhs) :=
  kernelStep_of_candidate_match hhead
    (candidate_mem_of_staticCandidateSplit (MinEnv.ofAtomsGT atoms gt) toEval hsplit)
    hmatch

/-- The two halves currently proved for one static candidate split: executable `queryOp` emits the
freshened/merged item, while the same unfreshened candidate and matcher witness determine a certified
`KernelStep`.

The remaining runtime-correctness crossing is precisely to derive the unfreshened matcher witness
and relate the two instantiated RHS atoms from the freshened executable components. -/
theorem queryOp_item_and_kernelStep_of_staticCandidateSplit
    {atoms : List Atom} {gt : GroundingTable} {st : St} {prev : Stack}
    {toEval lhs rhs : Atom} {mb m coreB : Bindings}
    {pre post : List (Atom × Atom)}
    (hstatic : st.world.selfExtra = [])
    (hNotVarHead : isVariableHeaded toEval = false)
    (hhead : ∃ k, headKey toEval = some k)
    (hsplit : (MinEnv.ofAtomsGT atoms gt).candidates toEval = pre ++ (lhs, rhs) :: post)
    (hmatchFresh :
      mb ∈ matchAtoms (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.1 toEval)
    (hmerge : m ∈ Bindings.merge [] mb)
    (hloop : Bindings.hasLoop m = false)
    (hmatchCore : coreB ∈ matchAtoms lhs toEval) :
    evalResult prev (instantiate m (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.2) m ∈
        (queryOp (MinEnv.ofAtomsGT atoms gt) st prev toEval []).1 ∧
      KernelStep atoms gt toEval (instantiate coreB rhs) := by
  constructor
  · exact queryOp_contains_instantiated_item_of_staticCandidateSplit
      (MinEnv.ofAtomsGT atoms gt) st prev toEval [] hstatic hNotVarHead hsplit
      hmatchFresh hmerge hloop
  · exact kernelStep_of_staticCandidateSplit_match hhead hsplit hmatchCore

/-- MOPS-facing form of `queryOp_item_and_kernelStep_of_staticCandidateSplit`.

This exposes the same executable `queryOp` item together with LeaTTa's published root MOPS step.
The executable item still carries runtime freshening/merge details; callers remain responsible for
relating it to the certified unfreshened reduct when they need equality of readouts. -/
theorem queryOp_item_and_mopsStep_of_staticCandidateSplit
    {atoms : List Atom} {gt : GroundingTable} {st : St} {prev : Stack}
    {toEval lhs rhs : Atom} {mb m coreB : Bindings}
    {pre post : List (Atom × Atom)}
    (hstatic : st.world.selfExtra = [])
    (hNotVarHead : isVariableHeaded toEval = false)
    (hhead : ∃ k, headKey toEval = some k)
    (hsplit : (MinEnv.ofAtomsGT atoms gt).candidates toEval = pre ++ (lhs, rhs) :: post)
    (hmatchFresh :
      mb ∈ matchAtoms (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.1 toEval)
    (hmerge : m ∈ Bindings.merge [] mb)
    (hloop : Bindings.hasLoop m = false)
    (hmatchCore : coreB ∈ matchAtoms lhs toEval) :
    evalResult prev (instantiate m (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.2) m ∈
        (queryOp (MinEnv.ofAtomsGT atoms gt) st prev toEval []).1 ∧
      MopsStep atoms toEval (instantiate coreB rhs) := by
  rcases queryOp_item_and_kernelStep_of_staticCandidateSplit
    (atoms := atoms) (gt := gt) (st := st) (prev := prev)
    (toEval := toEval) (lhs := lhs) (rhs := rhs) (mb := mb) (m := m)
    (coreB := coreB) (pre := pre) (post := post)
    hstatic hNotVarHead hhead hsplit hmatchFresh hmerge hloop hmatchCore with
    ⟨hmem, hstep⟩
  exact ⟨hmem, kernelStep_iff_mopsStep.mp hstep⟩

/-- Result-equality form of `queryOp_item_and_kernelStep_of_staticCandidateSplit`. The runtime merge
may reorder or normalize bindings, so later B1 lemmas should relate the executable instantiated RHS
to the certified unfreshened reduct by an explicit equality rather than by requiring a particular
binding-list shape. -/
theorem queryOp_item_and_kernelStep_of_staticCandidateSplit_eqResult
    {atoms : List Atom} {gt : GroundingTable} {st : St} {prev : Stack}
    {toEval lhs rhs : Atom} {mb m coreB : Bindings}
    {pre post : List (Atom × Atom)}
    (hstatic : st.world.selfExtra = [])
    (hNotVarHead : isVariableHeaded toEval = false)
    (hhead : ∃ k, headKey toEval = some k)
    (hsplit : (MinEnv.ofAtomsGT atoms gt).candidates toEval = pre ++ (lhs, rhs) :: post)
    (hmatchFresh :
      mb ∈ matchAtoms (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.1 toEval)
    (hmerge : m ∈ Bindings.merge [] mb)
    (hloop : Bindings.hasLoop m = false)
    (hmatchCore : coreB ∈ matchAtoms lhs toEval)
    (hresult :
      instantiate m (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.2 = instantiate coreB rhs) :
    evalResult prev (instantiate coreB rhs) m ∈
        (queryOp (MinEnv.ofAtomsGT atoms gt) st prev toEval []).1 ∧
      KernelStep atoms gt toEval (instantiate coreB rhs) := by
  have hpair := queryOp_item_and_kernelStep_of_staticCandidateSplit
    (st := st) (prev := prev) (toEval := toEval) (lhs := lhs) (rhs := rhs)
    (mb := mb) (m := m) (coreB := coreB) (pre := pre) (post := post)
    hstatic hNotVarHead hhead hsplit hmatchFresh hmerge hloop hmatchCore
  constructor
  · simpa [hresult] using hpair.1
  · exact hpair.2

/-- MOPS-facing result-equality form of `queryOp_item_and_kernelStep_of_staticCandidateSplit`.

Once the executable freshened RHS is proved equal to the certified unfreshened reduct, the actual
`queryOp` item is paired directly with LeaTTa's published MOPS step. -/
theorem queryOp_item_and_mopsStep_of_staticCandidateSplit_eqResult
    {atoms : List Atom} {gt : GroundingTable} {st : St} {prev : Stack}
    {toEval lhs rhs : Atom} {mb m coreB : Bindings}
    {pre post : List (Atom × Atom)}
    (hstatic : st.world.selfExtra = [])
    (hNotVarHead : isVariableHeaded toEval = false)
    (hhead : ∃ k, headKey toEval = some k)
    (hsplit : (MinEnv.ofAtomsGT atoms gt).candidates toEval = pre ++ (lhs, rhs) :: post)
    (hmatchFresh :
      mb ∈ matchAtoms (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.1 toEval)
    (hmerge : m ∈ Bindings.merge [] mb)
    (hloop : Bindings.hasLoop m = false)
    (hmatchCore : coreB ∈ matchAtoms lhs toEval)
    (hresult :
      instantiate m (freshenRuleAvoiding (st.counter + pre.length) (queryOpAvoid prev toEval []) lhs rhs).1.2 = instantiate coreB rhs) :
    evalResult prev (instantiate coreB rhs) m ∈
        (queryOp (MinEnv.ofAtomsGT atoms gt) st prev toEval []).1 ∧
      MopsStep atoms toEval (instantiate coreB rhs) := by
  rcases queryOp_item_and_kernelStep_of_staticCandidateSplit_eqResult
    (atoms := atoms) (gt := gt) (st := st) (prev := prev)
    (toEval := toEval) (lhs := lhs) (rhs := rhs) (mb := mb) (m := m)
    (coreB := coreB) (pre := pre) (post := post)
    hstatic hNotVarHead hhead hsplit hmatchFresh hmerge hloop hmatchCore hresult with
