import Mettapedia.GSLT.LanguageDef.MeTTaILPatternMatrixCompilation
import Mettapedia.Languages.MeTTa.PeTTa.MainlineCallGuardExecuteOperational
import Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep

/-!
# Source-derived decision program for the completed-call executor

The hot executor `LanguageDef` is compiled by the generic ordered
pattern-matrix compiler.  The residual decision program carries exact source
rewrite indices and performs only constructor dispatch; the canonical MeTTaIL
matcher, premise evaluator, and right-hand-side instantiator remain the rule
continuation.  Execution of the residual program is identified with the least
contextual reduction generated by the twenty-one executor rules, so forward
coverage and reverse no-invention follow from one equality.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.MeTTa.PeTTa.MainlineCallGuardExecutePatternMatrixCompilation

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.ContextualStep
open Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep
open Mettapedia.OSLF.MeTTaIL.Engine
open Mettapedia.OSLF.Framework
open Mettapedia.Languages.MeTTa.PeTTa.MainlineTypeQueryGSLT
open Mettapedia.Languages.MeTTa.PeTTa.CallGuardNativeKernel
open Mettapedia.Languages.MeTTa.PeTTa.MainlineCallGuardControl
open Mettapedia.Languages.MeTTa.PeTTa.MainlineCallGuardExecuteOperational

namespace SourceCompiler
export Mettapedia.GSLT.LanguageDef.MeTTaILPatternMatrixCompilation.Matrix
  (Head RuleOccurrence ruleAt lowerSubject syntacticOccurrenceAttempt
    ofLanguage compileLanguage compileLanguage_evalAll_eq_rewriteAt
    compileLanguage_candidate_rules_exact)
end SourceCompiler

/-- The independently authored and validated executor language. -/
abbrev sourceLanguage : LanguageDef := validated.language

/-- Exact source occurrence indices carried by the residual program. -/
abbrev SourceOccurrence := SourceCompiler.RuleOccurrence sourceLanguage

/-- The total generic compilation of the twenty-one executor rows. -/
def decisionTree := SourceCompiler.compileLanguage sourceLanguage

/-- Non-contextual executor premise semantics: only the thirteen filter
relations authored by the operational language. -/
def premiseBase : BasePremiseEvaluator := engineBasePremises relationEnv

/-- Execute the residual decision program at one contextual depth. -/
def compiledReducts (recursiveFuel : Nat) (source : Pattern) : List Pattern :=
  decisionTree.evalAll
    (SourceCompiler.syntacticOccurrenceAttempt premiseBase sourceLanguage
      (Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep.rewriteAt
        .syntactic premiseBase sourceLanguage recursiveFuel)
      source)
    [SourceCompiler.lowerSubject source]

/-- The residual program is exactly the executable least contextual semantics
of the executor language. -/
theorem compiledReducts_eq_contextualRewriteAt (recursiveFuel : Nat) (source : Pattern) :
    compiledReducts recursiveFuel source =
      Mettapedia.OSLF.MeTTaIL.ContextualStep.rewriteAt
        premiseBase sourceLanguage (recursiveFuel + 1) source := by
  calc
    compiledReducts recursiveFuel source =
        Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep.rewriteAt
          .syntactic premiseBase sourceLanguage (recursiveFuel + 1) source :=
      SourceCompiler.compileLanguage_evalAll_eq_rewriteAt
        premiseBase sourceLanguage recursiveFuel source
    _ = Mettapedia.OSLF.MeTTaIL.ContextualStep.rewriteAt
          premiseBase sourceLanguage (recursiveFuel + 1) source :=
      Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep.rewriteAt_syntactic_eq_contextual
        premiseBase sourceLanguage (recursiveFuel + 1) source

/-- At root depth, residual execution is exactly the root executor, as a
complete ordered result list. -/
theorem compiledReducts_zero_eq_executor (source : Pattern) :
    compiledReducts 0 source = rewriteStepWithPremisesUsing relationEnv language source := by
  rw [compiledReducts_eq_contextualRewriteAt]
  simpa [premiseBase, sourceLanguage, validated] using
    (Mettapedia.OSLF.MeTTaIL.ContextualStep.rewriteAt_one_eq_rewriteStepWithPremisesUsing
        relationEnv language source)

/-- Exact bounded relational reading of residual execution. -/
theorem mem_compiledReducts_iff_stepAt (recursiveFuel : Nat) (source target : Pattern) :
    target ∈ compiledReducts recursiveFuel source ↔
      StepAt premiseBase sourceLanguage (recursiveFuel + 1) source target := by
  rw [compiledReducts_eq_contextualRewriteAt]
  exact mem_rewriteAt_iff_stepAt

/-- Reverse adequacy: the residual program cannot invent an executor
transition absent from the `LanguageDef`. -/
theorem compiledReducts_no_invention (recursiveFuel : Nat) {source target : Pattern}
    (member : target ∈ compiledReducts recursiveFuel source) :
    TypeSynthesis.langReducesUsing relationEnv sourceLanguage source target := by
  rw [compiledReducts_eq_contextualRewriteAt] at member
  unfold TypeSynthesis.langReducesUsing
  exact Mettapedia.OSLF.MeTTaIL.ContextualStep.exists_mem_rewriteAt_iff_step.mp
    ⟨recursiveFuel + 1, by simpa [premiseBase] using member⟩

/-- Forward adequacy: every least-contextual transition appears in the
residual program at some finite contextual depth. -/
theorem language_step_covered {source target : Pattern}
    (step : TypeSynthesis.langReducesUsing relationEnv sourceLanguage source target) :
    ∃ recursiveFuel, target ∈ compiledReducts recursiveFuel source := by
  have contextual : Step premiseBase sourceLanguage source target := by
    simpa [TypeSynthesis.langReducesUsing, premiseBase] using step
  obtain ⟨fuel, member⟩ :=
    Mettapedia.OSLF.MeTTaIL.ContextualStep.exists_mem_rewriteAt_iff_step.mpr contextual
  cases fuel with
  | zero => simp [Mettapedia.OSLF.MeTTaIL.ContextualStep.rewriteAt] at member
  | succ recursiveFuel =>
      refine ⟨recursiveFuel, ?_⟩
      rw [compiledReducts_eq_contextualRewriteAt]
      simpa [Nat.succ_eq_add_one] using member

/-- The executor's own step is covered by the residual program. -/
theorem executor_step_covered {source target : ExecuteControl}
    (step : executeStep? source = some target) :
    ∃ recursiveFuel,
      encodeExecuteControl target ∈ compiledReducts recursiveFuel (encodeExecuteControl source) := by
  apply language_step_covered
  exact (language_step_iff_executeStep source _).2 ⟨target, step, rfl⟩

/-- On the canonical executor-state image, the first residual reduct is
exactly the executor's successor. -/
theorem compiled_first_eq_executeStep (source : ExecuteControl) :
    (compiledReducts 0 (encodeExecuteControl source)).head? =
      (executeStep? source).map encodeExecuteControl := by
  rw [compiledReducts_zero_eq_executor, executor_exact]
  unfold executorImage
  split <;> simp_all

/-! ## Exact source indexing -/

/-- Candidate selection returns exact source occurrence indices. -/
def candidateOccurrences (source : Pattern) : List SourceOccurrence :=
  decisionTree.evalAll (fun occurrence => [occurrence]) [SourceCompiler.lowerSubject source]

theorem candidateOccurrences_exact (source : Pattern) :
    candidateOccurrences source =
      Mettapedia.GSLT.LanguageDef.OrderedPatternMatrixCompilation.runMatrixAll
        (fun occurrence => [occurrence]) (SourceCompiler.ofLanguage sourceLanguage)
        [SourceCompiler.lowerSubject source] :=
  SourceCompiler.compileLanguage_candidate_rules_exact sourceLanguage source

/-! ## Positive and negative controls -/

/-- The finished-plans transition is realized by residual execution. -/
example (snapshot : Snapshot) (call : Call) (accepted : List ArrowDeclaration)
    (events : List ControlEvent) :
    ∃ recursiveFuel,
      encodeExecuteControl (.halted ⟨.executed accepted, events⟩) ∈
        compiledReducts recursiveFuel
          (encodeExecuteControl (.plans snapshot call [] accepted events)) := by
  apply executor_step_covered
  rfl

/-- A target rejected by the executor language cannot be fabricated at any
residual depth. -/
theorem rejected_by_source_rejected_by_compiled (recursiveFuel : Nat) {source target : Pattern}
    (rejected : ¬ TypeSynthesis.langReducesUsing relationEnv sourceLanguage source target) :
    target ∉ compiledReducts recursiveFuel source := by
  intro member
  exact rejected (compiledReducts_no_invention recursiveFuel member)

#print axioms compiledReducts_eq_contextualRewriteAt
#print axioms compiledReducts_no_invention
#print axioms language_step_covered
#print axioms compiled_first_eq_executeStep

end Mettapedia.Languages.MeTTa.PeTTa.MainlineCallGuardExecutePatternMatrixCompilation
