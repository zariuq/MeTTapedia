/-- Commuting Cons-Invocations Task Square (`ScopedConfigurationRel.invocationsCons_step`):
Entering the head activation of `.bindingAlternatives` / `.invocations` steps in 1 silent
transition on both machines to `.func` / `.function` with `.calls` and `.append` pushed on
the stack, preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.invocationsCons_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator : Atom) (arguments : List Atom) (operatorType resultType expected : Atom)
    (fuel : Nat) (live : List Atom) (scope : List String)
    (signature : SelectedTypePolicy) (ctxOp : Entry.Value) (ctxArgs : List Entry.Value)
    (wHead : Bindings) (wRest : List Bindings)
    (cHead : Completed.Frame) (cRest : List Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (opEq : ctxOp.erase = operator)
    (argsEq : ctxArgs.map Entry.Value.erase = arguments)
    (sigTypeEq : signature.functionType = operatorType)
    (retTypeEq : Completed.invocationReturnType signature = resultType)
    (headRel : ScopedActivationRel wHead cHead)
    (restRel : List.Forall₂ ScopedActivationRel wRest cRest)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.bindingAlternatives (.expression (operator :: arguments))
          operatorType resultType fuel (wHead :: wRest) live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.func (.expression (operator :: arguments)) operatorType
          wHead fuel (resultType :: live)),
        .calls resultType fuel live ::
          .append (.bindingAlternatives (.expression (operator :: arguments))
            operatorType resultType fuel wRest live) :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.invocations live scope expected signature ctxOp ctxArgs (cHead :: cRest)),
        cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.function (Completed.invocationReturnType signature :: live)
          scope expected signature ctxOp ctxArgs cHead),
        .calls live scope (Completed.invocationReturnType signature) ::
          .append (.invocations live scope expected signature ctxOp ctxArgs cRest) :: cStack,
        cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  refine ⟨rfl, .invocationsCons, .internal .invocationsCons, ?_⟩
  subst retTypeEq
  exact ⟨rfl, .work (.func opEq argsEq sigTypeEq headRel),
    .cons .calls (.cons (.append (.bindingAlternatives opEq argsEq sigTypeEq rfl restRel)) stackRel),
    emittedRel⟩

