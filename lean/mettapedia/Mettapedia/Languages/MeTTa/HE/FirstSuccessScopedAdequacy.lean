and equation `(= (ident $y) $y)`. -/
def polyIdentSpace : Space :=
  Space.ofList [
    .expression [.symbol ":", .symbol "ident",
      .expression [.symbol "->", .var "t", .var "t"]],
    .expression [.symbol "=",
      .expression [.symbol "ident", .var "y"],
      .var "y"]
