    before.read_variable_free reusePolicy heldVal closedHeld
  have hHeldErase : (before.read reusePolicy heldVal).erase = .expression [.symbol "ident", argument] := by
    rw [hHeldRead]
    simp only [heldVal, argument, Entry.Value.erase, List.map]
