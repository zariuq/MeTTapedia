         { assignments := [("t", .symbol "Number")],
           equalities := [("x", "y#1"), ("caller", "x"), ("t", "t"), ("t", "t")] })],
       .finished ⟨polyIdentSpace, .returning [], [],
         [(mkError identTrueCall (.badArgType 1 (.var "t") (.symbol "Bool")),
           { assignments := [("t", .symbol "Number")],
             equalities := [("x", "y#1"), ("caller", "x"), ("t", "t"), ("t", "t")] })]⟩) :=
  run_eq_finished_of_strict (by decide +kernel)

/-- Multi-call / sibling fresh-type-variable separation theorem:
During `(Pair (ident $x) (ident true))`, the first sibling call `(ident $x)` enters with
`callerIncomingOpen` (`"t" ↦ Number`, `"caller" = "x"`) and receives fresh type variable `"t#0"`
(and head-cast `"t#1"`), producing `dupBranchOutBindings1`. When the second sibling call
`(ident true)` enters with `dupBranchOutBindings1` (which now contains `"t#0"` and `"t#1"`),
`scopedTypes` advances to fresh type variable `"t#2"` (`!= "t#0"`), whereas `rawTypes` reuses `"t"`
at both sibling calls and fails on `true : Bool`. -/
theorem pairSibling_fresh_type_instances_separated :
    let firstCallState : Configuration :=
      Configuration.initial polyIdentSpace
        (.expression identVarCall Atom.undefinedType callerIncomingOpen 13 [.var "x"])
    let secondCallState : Configuration :=
      Configuration.initial polyIdentSpace
        (.expression identTrueCall Atom.undefinedType dupBranchOutBindings1 13 [.var "x"])
    scopedTypes.types firstCallState callerIncomingOpen (.symbol "ident") Atom.undefinedType =
      [.expression [.symbol "->", .var "t#0", .var "t#0"]] ∧
    scopedTypes.types secondCallState dupBranchOutBindings1 (.symbol "ident") Atom.undefinedType =
      [.expression [.symbol "->", .var "t#2", .var "t#2"]] ∧
    rawTypes.types firstCallState callerIncomingOpen (.symbol "ident") Atom.undefinedType =
      [.expression [.symbol "->", .var "t", .var "t"]] ∧
    rawTypes.types secondCallState dupBranchOutBindings1 (.symbol "ident") Atom.undefinedType =
      [.expression [.symbol "->", .var "t", .var "t"]] := by
  refine ⟨by decide +kernel, by decide +kernel, rfl, rfl⟩

theorem sameMismatchOpen_scoped_rejected :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 6 sameMismatchOpenLoaded =
      ([(mkError sameMismatchCall (.badArgType 2 (.var "t#0") (.symbol "Bool")), callerIncomingOpen)],
       .finished ⟨polySameSpace, .returning [], [],
         [(mkError sameMismatchCall (.badArgType 2 (.var "t#0") (.symbol "Bool")), callerIncomingOpen)]⟩) :=
  run_eq_finished_of_strict (by decide +kernel)

theorem dupBranchOpen_scoped_completed :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 65 dupBranchOpenLoaded =
