/-- Open caller frame containing a prior binding `"t" ↦ Number` and an open
caller alias `"caller" ↦ $x`. -/
def callerIncoming : Bindings :=
  (Bindings.empty.assign "t" (.symbol "Number")).assign "caller" (.var "x")

def identTrueCall : Atom :=
  .expression [.symbol "ident", .grounded (.bool true)]

