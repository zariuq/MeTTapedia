/-! ## Block 3: Bidirectional Contextual Machine & Same-Space Renaming Bridge -/

namespace ContextualAndRenamingBridge

open FirstSuccessSourceExecution
open FirstSuccessRecursiveExecution
open Spec.Eval Spec.Eval.Completed
open Spec.Type Spec.Type.Presentation Spec.Type.RuntimeRefinement
open Spec.Bindings.ScopeObservation
open ScopedPolymorphicCompletion

/-- Bidirectional equivalence between `Contextual.Configuration.SourceRel` and
`RecursiveMachine.Contextual.Steps` under `Completed.scopedLookup`. -/
theorem contextual_scoped_source_iff_finished
    (dispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (state : RecursiveTasks.Contextual.Configuration) (answers : List Result) :
    state.SourceRel dispatch Completed.scopedLookup policy answers ↔
      RecursiveMachine.Contextual.Steps dispatch Completed.scopedLookup policy state
        ⟨state.space, .returning [], [], answers⟩ :=
  RecursiveExecution.Contextual.source_iff_finished state answers

/-- Bidirectional equivalence between `Contextual.Task.SourceRel` and
`RecursiveMachine.Contextual.Steps` under `Completed.scopedLookup`. -/
theorem contextual_scoped_task_iff_finished
    (space : Space) (dispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (task : RecursiveTasks.Contextual.Task) (answers : List Result) :
    task.SourceRel space dispatch Completed.scopedLookup policy answers ↔
      RecursiveMachine.Contextual.Steps dispatch Completed.scopedLookup policy
        (RecursiveTasks.Contextual.Configuration.initial space task)
        ⟨space, .returning [], [], answers⟩ :=
  RecursiveExecution.Contextual.task_source_iff_finished space task answers

/-- Bidirectional equivalence between `Completed.AtomRel` and
`RecursiveMachine.Contextual.Steps` under `Completed.scopedLookup`. -/
theorem contextual_scoped_atom_iff_steps
    (space : Space) (dispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (live : List Atom) (scope : List String) (value : Entry.Value) (expected : Atom)
    (frame : Completed.Frame) (answers : List Result) :
    Completed.AtomRel space dispatch Completed.scopedLookup live scope value expected frame
        answers (policy := policy) ↔
      RecursiveMachine.Contextual.Steps dispatch Completed.scopedLookup policy
        (RecursiveTasks.Contextual.Configuration.initial space
          (.atom live scope value expected frame))
        ⟨space, .returning [], [], answers⟩ :=
  RecursiveExecution.Contextual.task_source_iff_finished space
    (.atom live scope value expected frame) answers

/-- Bidirectional equivalence between `Completed.AtomRel` and observed terminal
configurations of `RecursiveMachine.Contextual.Steps` under `Completed.scopedLookup`. -/
theorem contextual_scoped_loaded_iff_observed
    (space : Space) (dispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (value expected : Atom) (answers : List Result) :
    Completed.AtomRel space dispatch Completed.scopedLookup [] []
        (Entry.Value.ofAtom value) expected Completed.Frame.empty answers (policy := policy) ↔
      ∃ final,
        RecursiveMachine.Contextual.Steps dispatch Completed.scopedLookup policy
          (RecursiveMachine.Contextual.load space value expected) final ∧
        RecursiveMachine.Contextual.observe final = some answers :=
  RecursiveExecution.Contextual.loaded_source_iff_observed space value expected answers

/-- Joint adequacy certificate bridging a completed `Checked.machine HE.GroundedDispatch.none scopedTypes`
worker run, `Completed.AtomRel` / `Contextual.Task.SourceRel`, and `RecursiveMachine.Contextual.Steps`
with exact answer multiplicity and caller-scope `BindingTheoryEquivAt`. -/
structure ScopedWorkerContextualAligned (space : Space) (callerScope : List String)
    (workerState : Configuration) (budget : Nat)
    (ctxTask : RecursiveTasks.Contextual.Task)
    (workerOut : List ResultPair)
    (ctxOut : List Result) : Prop where
  workerCompleted :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run budget workerState =
      (workerOut, .finished ⟨space, .returning [], [], workerState.emitted ++ workerOut⟩)
  contextualSource :
    ctxTask.SourceRel space noHost Completed.scopedLookup .unmarked ctxOut
  contextualSteps :
    RecursiveMachine.Contextual.Steps noHost Completed.scopedLookup .unmarked
      (RecursiveTasks.Contextual.Configuration.initial space ctxTask)
      ⟨space, .returning [], [], ctxOut⟩
  exactMultiplicityAndAtoms :
    ctxOut.map (fun r => r.1.erase) = workerOut.map Prod.fst ∧
    ctxOut.length = workerOut.length
  certifiedAndScopeEquiv :
    List.Forall₂ (fun w c =>
      w.1 = c.1.erase ∧
      (∃ table, ReadoutCertificate w.2 table) ∧
      BindingTheoryEquivAt callerScope w.2 c.2.bindings)
      workerOut ctxOut

/-- On the empty caller scope `[]`, any two satisfiable `Bindings` are `BindingTheoryEquivAt []`. -/
theorem bindingTheoryEquivAt_nil_of_satisfiable {b₁ b₂ : Bindings}
    (sat₁ : ∃ m, TypeBindingSatisfied m b₁)
    (sat₂ : ∃ m, TypeBindingSatisfied m b₂) :
    BindingTheoryEquivAt [] b₁ b₂ := by
  obtain ⟨m₁, hm₁⟩ := sat₁
  obtain ⟨m₂, hm₂⟩ := sat₂
  refine ⟨fun _ _ => ⟨m₂, hm₂, fun _ h => nomatch h⟩,
    fun _ _ => ⟨m₁, hm₁, fun _ h => nomatch h⟩⟩

/-- Witness of `ScopedWorkerContextualAligned` for the nested-priority discriminator under `scopedTypes`
and `Completed.scopedLookup`. -/
theorem nestedPriority_scoped_worker_contextual_aligned :
    ∃ ctxOut,
      ScopedWorkerContextualAligned NestedPriorityControls.context []
        NestedPriorityControls.initial 200
        (.atom [] [] (Entry.Value.ofAtom NestedPriorityControls.query)
          Atom.undefinedType Completed.Frame.empty)
        [(NestedPriorityControls.lateError, Bindings.empty)]
        ctxOut ∧
      NestedPriorityControls.earlyError ∉ ctxOut.map (fun r => r.1.erase) := by
  obtain ⟨results, atomRel, steps, erasedEq, noEarly⟩ :=
    NestedPriorityControls.completed_scoped_source_matches_run
  have hErased : results.map (fun r => r.1.erase) = [NestedPriorityControls.lateError] := by
    rw [NestedPriorityControls.checked_scoped_late_only] at erasedEq
    simpa using erasedEq
  refine ⟨results, ⟨?_, atomRel, steps, ?_, ?_⟩, noEarly⟩
  · simpa [NestedPriorityControls.initial, Configuration.initial] using
      NestedPriorityControls.checked_scoped_late_only
  · refine ⟨hErased, ?_⟩
    have hLen := congrArg List.length hErased
    simpa using hLen
  · rcases results with _ | ⟨c, _ | ⟨d, rest⟩⟩
    · simp at hErased
    · simp only [List.map_cons, List.map_nil, List.cons.injEq, and_true] at hErased
      refine .cons ⟨hErased.symm, ⟨[], Completed.Frame.empty.certified⟩, ?_⟩ .nil
      exact bindingTheoryEquivAt_nil_of_satisfiable
        Completed.Frame.empty.certified.satisfiable c.2.certified.satisfiable
    · simp at hErased

/-! ### Same-Space Renaming and Declaration Schema α-Invariance -/

/-- When a permutation fixes all variable names occurring in `source.atoms`,
`Spec.Eval.Renaming.space p source = source` holds identically. -/
theorem renaming_space_eq_self_of_fixed (p : Equiv.Perm String) (source : Space)
    (fixed : ∀ name ∈ TypeSubst.typeVarsList source.atoms, p name = name) :
    Spec.Eval.Renaming.space p source = source := by
  rcases source with ⟨atoms⟩
  simp only [Spec.Eval.Renaming.space, Space.mk.injEq]
  rw [ScopeObservation.renameTypeVarsList_congr_on_typeVars (right := id) atoms fixed]
  simp

/-- Same-space corollary for `RecursiveMachine.Contextual.Steps.rename_scopedLookup`:
when `p` fixes the variables of `before.space.atoms` and `publicScope`, the renamed run
executes over the **exact same `before.space`** (`(before.rename p).space = before.space`,
`(after.rename p).space = before.space`) and preserves `BindingTheoryEquivAt publicScope`
at every emitted answer. -/
theorem steps_rename_scopedLookup_same_space
    (publicScope : List String) (p : Equiv.Perm String)
    (fixedPublic : ∀ name ∈ publicScope, p name = name)
    {dispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {before after : RecursiveTasks.Contextual.Configuration}
    {answers : List Result}
    (fixedSpace : ∀ name ∈ TypeSubst.typeVarsList before.space.atoms, p name = name)
    (path : RecursiveMachine.Contextual.Steps dispatch Completed.scopedLookup policy before after)
    (done : RecursiveMachine.Contextual.observe after = some answers) :
    (before.rename p).space = before.space ∧
    (after.rename p).space = before.space ∧
    RecursiveMachine.Contextual.Steps (Spec.Eval.Renaming.dispatch p dispatch)
      Completed.scopedLookup policy (before.rename p) (after.rename p) ∧
    RecursiveMachine.Contextual.observe (after.rename p) =
      some (answers.map (Result.rename p)) ∧
    List.Forall₂ (fun original renamed =>
      renamed.1 = Entry.Value.rename p original.1 ∧
      renamed.2 = original.2.rename p ∧
      BindingTheoryEquivAt publicScope original.2.bindings renamed.2.bindings)
      answers (answers.map (Result.rename p)) := by
  have hSpaceEq : Spec.Eval.Renaming.space p before.space = before.space :=
    renaming_space_eq_self_of_fixed p before.space fixedSpace
  have hAfterSpace : after.space = before.space :=
    RecursiveExecution.Contextual.steps_space path
  have hObs := RecursiveMachine.Contextual.observed_public_scope_preserved
    publicScope p fixedPublic path done
  simp only [Completed.renameCastLookup_scopedLookup] at hObs
  refine ⟨hSpaceEq, ?_, hObs.1, hObs.2.1, hObs.2.2⟩
  change Spec.Eval.Renaming.space p after.space = before.space
  rw [hAfterSpace, hSpaceEq]

/-- Permuting the schematic variables of a source type declaration preserves
`TypeCandidateAlphaVariantRel` against any target and avoid scope. -/
theorem typeCandidateAlphaVariantRel_rename_source {avoid : List String} {source target : Atom}
    (q : Equiv.Perm String)
    (variant : Exact.TypeCandidateAlphaVariantRel avoid source target) :
    Exact.TypeCandidateAlphaVariantRel avoid (renameTypeVars q source) target := by
  obtain ⟨rename, injective, shape, fresh⟩ := variant
  refine ⟨rename ∘ q.symm, injective.comp q.symm.injective, ?_, ?_⟩
  · rw [ScopeObservation.renameTypeVars_comp]
    have cancel : (rename ∘ q.symm) ∘ q = rename := by
      funext x
      simp [Function.comp_apply]
    rw [cancel, shape]
  · intro name member present
    rw [ScopeObservation.typeVars_renameTypeVars] at member
    obtain ⟨orig, origMem, rfl⟩ := List.mem_map.mp member
    have hEq : (rename ∘ q.symm) (q orig) = rename orig := by
      simp [Function.comp_apply]
    rw [hEq] at present
    exact fresh orig origMem present

theorem typeCandidateAlphaVariantRel_rename_source_iff {avoid : List String} {source target : Atom}
    (q : Equiv.Perm String) :
    Exact.TypeCandidateAlphaVariantRel avoid (renameTypeVars q source) target ↔
      Exact.TypeCandidateAlphaVariantRel avoid source target := by
  constructor
  · intro h
    simpa using typeCandidateAlphaVariantRel_rename_source q.symm h
  · exact typeCandidateAlphaVariantRel_rename_source q

theorem argumentAlphaVariantsRel_rename_sources {avoid : List String} {sources targets : List Atom}
    (q : Equiv.Perm String)
    (variants : Exact.ArgumentAlphaVariantsRel avoid sources targets) :
    Exact.ArgumentAlphaVariantsRel avoid (sources.map (renameTypeVars q)) targets := by
  induction variants with
  | nil => exact .nil _
  | cons first _ ih =>
      exact .cons (typeCandidateAlphaVariantRel_rename_source q first) ih

theorem argumentAlphaVariantsRel_rename_sources_iff {avoid : List String} {sources targets : List Atom}
    (q : Equiv.Perm String) :
    Exact.ArgumentAlphaVariantsRel avoid (sources.map (renameTypeVars q)) targets ↔
      Exact.ArgumentAlphaVariantsRel avoid sources targets := by
  constructor
  · intro h
    have back := argumentAlphaVariantsRel_rename_sources q.symm h
    simpa only [Spec.Eval.Renaming.atoms_inverse] using back
  · exact argumentAlphaVariantsRel_rename_sources q

/-- Declaration Schema α-Invariance for `scopedTypeLookup`:
Permuting schematic type variables in `space` via `q` preserves `scopedTypeLookup`
on every subject fixed by `q` (such as any operator symbol `.symbol op`). -/
theorem scopedTypeLookup_rename_space_iff (q : Equiv.Perm String)
    (scope : List String) (space : Space) (bindings : Bindings)
    (subject expected : Atom) (candidates : List Atom)
    (subjectFixed : renameTypeVars q subject = subject) :
    Spec.Eval.scopedTypeLookup scope (Spec.Eval.Renaming.space q space)
        bindings subject expected candidates ↔
      Spec.Eval.scopedTypeLookup scope space bindings subject expected candidates := by
  unfold Spec.Eval.scopedTypeLookup
  constructor
  · rintro ⟨rawRenamed, inferred, variants⟩
    refine ⟨rawRenamed.map (renameTypeVars q.symm), ?_, ?_⟩
    · have back := inferred.rename q.symm
      have subSymm : renameTypeVars q.symm subject = subject := by
        simpa using congrArg (renameTypeVars q.symm) subjectFixed.symm
      rw [Spec.Eval.Renaming.space_inverse, subSymm] at back
      exact back
    · exact argumentAlphaVariantsRel_rename_sources q.symm variants
  · rintro ⟨raw, inferred, variants⟩
    refine ⟨raw.map (renameTypeVars q), ?_, ?_⟩
    · have fwd := inferred.rename q
      rw [subjectFixed] at fwd
      exact fwd
    · exact argumentAlphaVariantsRel_rename_sources q variants

end ContextualAndRenamingBridge

