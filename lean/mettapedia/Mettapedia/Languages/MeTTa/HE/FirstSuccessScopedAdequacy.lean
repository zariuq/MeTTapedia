/-! ### Helper Lemmas for Caller-Scope `BindingTheoryEquivAt` -/

/-- Any model of `callerIncomingOpen` extends to a model of `pairSiblingOpenOutBindings`
agreeing on `["caller", "x", "t"]`, and every model of `pairSiblingOpenOutBindings` is already
a model of `callerIncomingOpen`. -/
theorem callerIncomingOpen_equiv_pairSiblingOpenOutBindings :
    BindingTheoryEquivAt ["caller", "x", "t"] callerIncomingOpen pairSiblingOpenOutBindings := by
  constructor
  · intro m hm
    have hT : m "t" = .symbol "Number" := by
      simpa [applyTypeValuation] using hm.1 "t" (.symbol "Number") (by simp [callerIncomingOpen])
    have hCaller : m "caller" = m "x" :=
      hm.2 "caller" "x" (by simp [callerIncomingOpen])
    let m' : String → Atom := fun v =>
      if v = "y#2" then .grounded (.bool true)
      else if v = "t#2" ∨ v = "t#3" then .symbol "Bool"
      else if v = "y#1" then m "x"
      else if v = "t#0" ∨ v = "t#1" then .symbol "Unit"
      else m v
    refine ⟨m', ⟨?_, ?_⟩, ?_⟩
    · intro k val hMem
      simp only [pairSiblingOpenOutBindings, List.mem_cons, List.not_mem_nil, or_false,
        Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · simp [m', applyTypeValuation]
      · simpa [m', applyTypeValuation] using hT
      · simp [m', applyTypeValuation]
    · intro a b hMem
      simp only [pairSiblingOpenOutBindings, List.mem_cons, List.not_mem_nil, or_false,
        Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
        simp [m', hCaller]
    · intro v hv
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hv
      rcases hv with rfl | rfl | rfl <;> simp [m']
  · intro m hm
    refine ⟨m, ⟨?_, ?_⟩, fun _ _ => rfl⟩
    · intro k val hMem
      simp only [callerIncomingOpen, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩
      exact hm.1 "t" (.symbol "Number") (by simp [pairSiblingOpenOutBindings])
    · intro a b hMem
      simp only [callerIncomingOpen, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩
      exact hm.2 "caller" "x" (by simp [pairSiblingOpenOutBindings])

/-- Any model of `callerIncomingOpen` extends to a model of `dupBranchOutBindings1`
agreeing on `["caller", "x", "t"]`, and conversely. -/
theorem callerIncomingOpen_equiv_dupBranchOutBindings1 :
    BindingTheoryEquivAt ["caller", "x", "t"] callerIncomingOpen dupBranchOutBindings1 := by
  constructor
  · intro m hm
    have hT : m "t" = .symbol "Number" := by
      simpa [applyTypeValuation] using hm.1 "t" (.symbol "Number") (by simp [callerIncomingOpen])
    have hCaller : m "caller" = m "x" :=
      hm.2 "caller" "x" (by simp [callerIncomingOpen])
    let m' : String → Atom := fun v =>
      if v = "y#1" then m "x"
      else if v = "t#0" ∨ v = "t#1" then .symbol "Unit"
      else m v
    refine ⟨m', ⟨?_, ?_⟩, ?_⟩
    · intro k val hMem
      simp only [dupBranchOutBindings1, List.mem_cons, List.not_mem_nil, or_false,
        Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩
      simpa [m', applyTypeValuation] using hT
    · intro a b hMem
      simp only [dupBranchOutBindings1, List.mem_cons, List.not_mem_nil, or_false,
        Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
        simp [m', hCaller]
    · intro v hv
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hv
      rcases hv with rfl | rfl | rfl <;> simp [m']
  · intro m hm
    refine ⟨m, ⟨?_, ?_⟩, fun _ _ => rfl⟩
    · intro k val hMem
      simp only [callerIncomingOpen, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩
      exact hm.1 "t" (.symbol "Number") (by simp [dupBranchOutBindings1])
    · intro a b hMem
      simp only [callerIncomingOpen, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩
      exact hm.2 "caller" "x" (by simp [dupBranchOutBindings1])

/-! ### Control A: Repeated Polymorphic Call with Open Caller Aliases & Same-Space Schema α-Invariance -/

/-- Space with α-renamed polymorphic declaration `(: ident (-> $u $u))` and `(= (ident $y) $y)`. -/
def polyIdentSpaceU : Space :=
  Space.ofList [
    .expression [.symbol ":", .symbol "ident",
      .expression [.symbol "->", .var "u", .var "u"]],
    .expression [.symbol "=",
      .expression [.symbol "ident", .var "y"],
      .var "y"]
  ]

theorem polyIdentSpaceU_eq_rename_space :
    polyIdentSpaceU = Spec.Eval.Renaming.space (Equiv.swap "t" "u") polyIdentSpace := by
  simp [polyIdentSpaceU, polyIdentSpace, Spec.Eval.Renaming.space, Space.ofList, Equiv.swap_apply_def]

def pairSiblingOpenLoadedU : Configuration :=
  Configuration.initial polyIdentSpaceU (.atom pairSiblingCall Atom.undefinedType callerIncomingOpen 16 [.var "x"])

def pairSiblingOpenOutBindingsU : Bindings :=
  { assignments := [("y#2", .grounded (.bool true)),
                    ("t", .symbol "Number"),
                    ("u#2", .symbol "Bool")],
    equalities := [("x", "y#1"), ("caller", "x"),
                   ("u#0", "u#1"), ("u#0", "u#1"),
                   ("u#2", "u#3"), ("u#2", "u#3")] }

def swapPolyTU : Equiv.Perm String :=
  Equiv.swap "t#0" "u#0" * Equiv.swap "t#1" "u#1" *
    Equiv.swap "t#2" "u#2" * Equiv.swap "t#3" "u#3"

theorem pairSiblingOpenU_scoped_completed :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 141 pairSiblingOpenLoadedU =
      ([(.expression [.symbol "Pair", .var "x", .grounded (.bool true)], pairSiblingOpenOutBindingsU)],
       .finished ⟨polyIdentSpaceU, .returning [], [],
         [(.expression [.symbol "Pair", .var "x", .grounded (.bool true)], pairSiblingOpenOutBindingsU)]⟩) :=
  run_eq_finished_of_strict (by decide +kernel)

theorem pairSiblingOpenOutBindingsU_eq_rename :
    pairSiblingOpenOutBindingsU = renameBindings swapPolyTU pairSiblingOpenOutBindings := by
  simp [pairSiblingOpenOutBindingsU, pairSiblingOpenOutBindings,
    renameBindings, swapPolyTU, Equiv.swap_apply_def]
  simp [renameTypeVars]

/-- Control A (Repeated polymorphic call with open caller aliases):
`(Pair (ident $x) (ident true))` under `(: ident (-> $t $t))` and `(= (ident $y) $y)`
with open caller alias `"caller" = "x"` and `"t" ↦ Number`:
1. Succeeds under `scopedTypes` (`pairSiblingOpen_scoped_completed`),
2. Carries a verified `ReadoutCertificate` and `SourceBindingComparison.semantic.FrameRelated`,
3. Preserves the open caller alias `(nativeReadoutPresentation _).apply (.var "caller") = .var "x"`,
   the caller's `"t" ↦ Number`, and `BindingTheoryEquivAt ["caller", "x", "t"]` with the caller frame,
4. Preserves exact atom output and `BindingTheoryEquivAt ["caller", "x", "t"]` under α-renaming the
   declaration schema `(: ident (-> $t $t))` to `(: ident (-> $u $u))` (`polyIdentSpaceU_eq_rename_space`,
   `pairSiblingOpenU_scoped_completed`),
5. Rejects under `rawTypes` (`pairSiblingOpen_raw_rejected`) because `rawTypes` collides on `$t`. -/
theorem controlA_repeated_polymorphic_call_with_open_aliases :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 141 pairSiblingOpenLoaded =
      ([(.expression [.symbol "Pair", .var "x", .grounded (.bool true)], pairSiblingOpenOutBindings)],
       .finished ⟨polyIdentSpace, .returning [], [],
         [(.expression [.symbol "Pair", .var "x", .grounded (.bool true)], pairSiblingOpenOutBindings)]⟩) ∧
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 141 pairSiblingOpenLoadedU =
      ([(.expression [.symbol "Pair", .var "x", .grounded (.bool true)], pairSiblingOpenOutBindingsU)],
       .finished ⟨polyIdentSpaceU, .returning [], [],
         [(.expression [.symbol "Pair", .var "x", .grounded (.bool true)], pairSiblingOpenOutBindingsU)]⟩) ∧
    ReadoutCertificate pairSiblingOpenOutBindings
      (nativeReadoutPresentation pairSiblingOpenOutBindings) ∧
    (nativeReadoutPresentation pairSiblingOpenOutBindings).apply (.var "caller") = .var "x" ∧
    (nativeReadoutPresentation pairSiblingOpenOutBindings).apply (.var "t") = .symbol "Number" ∧
    BindingTheoryEquivAt ["caller", "x", "t"] callerIncomingOpen pairSiblingOpenOutBindings ∧
    BindingTheoryEquivAt ["caller", "x", "t"] pairSiblingOpenOutBindings pairSiblingOpenOutBindingsU ∧
    (((Checked.machine HE.GroundedDispatch.none rawTypes).run 86 pairSiblingOpenLoaded).1.map Prod.fst).map
      isErrorAtom = [true] := by
  refine ⟨pairSiblingOpen_scoped_completed,
    pairSiblingOpenU_scoped_completed,
    pairSiblingOpenOutBindings_certificate,
    by rw [nativeReadoutPresentation_apply_var]; decide +kernel,
    by rw [nativeReadoutPresentation_apply_var]; decide +kernel,
    callerIncomingOpen_equiv_pairSiblingOpenOutBindings,
    ?_,
    by rw [pairSiblingOpen_raw_rejected]; decide +kernel⟩
  rw [pairSiblingOpenOutBindingsU_eq_rename]
  apply BindingTheoryEquivAt.of_renameBindings ["caller", "x", "t"]
    pairSiblingOpenOutBindings swapPolyTU
  intro name hMem
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hMem
  rcases hMem with rfl | rfl | rfl <;>
    simp [swapPolyTU, Equiv.swap_apply_def]

/-! ### Control B: Polymorphic Correlation Rejection in Worker -/

/-- Control B (Within-signature polymorphic correlation rejection):
`(: same (-> $t $t $t))` applied to `(same 7 true)` is rejected at the worker argument-type
check under `scopedTypes` (`badArgType 2 (.var "t#0") (.symbol "Bool")`), preserving the
open caller frame `callerIncomingOpen` and its `ReadoutCertificate`, because both argument
positions of a single invocation share one fresh type variable `"t#0"`. -/
theorem controlB_polymorphic_correlation_rejection :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 6 sameMismatchOpenLoaded =
      ([(mkError sameMismatchCall (.badArgType 2 (.var "t#0") (.symbol "Bool")), callerIncomingOpen)],
       .finished ⟨polySameSpace, .returning [], [],
         [(mkError sameMismatchCall (.badArgType 2 (.var "t#0") (.symbol "Bool")), callerIncomingOpen)]⟩) ∧
    ReadoutCertificate callerIncomingOpen (nativeReadoutPresentation callerIncomingOpen) ∧
    (nativeReadoutPresentation callerIncomingOpen).apply (.var "x") = .var "caller" ∧
    isErrorAtom (mkError sameMismatchCall (.badArgType 2 (.var "t#0") (.symbol "Bool"))) = true :=
  ⟨sameMismatchOpen_scoped_rejected, callerIncomingOpen_certificate,
    by rw [nativeReadoutPresentation_apply_var]; decide +kernel,
    by decide +kernel⟩

/-! ### Control C: Multiplicity and Open Alias Preservation under `scopedTypes` -/

theorem dupBranchOutBindings2_eq_rename :
    dupBranchOutBindings2 = renameBindings (Equiv.swap "y#1" "y#2") dupBranchOutBindings1 := by
  simp [dupBranchOutBindings2, dupBranchOutBindings1,
    renameBindings, Equiv.swap_apply_def]

/-- Control C (Duplicate equation multiplicity and open caller alias preservation under `scopedTypes`):
Evaluating `(ident $x)` over `dupBranchSpace` (two copies of `(= (ident $y) $y)` under
`(: ident (-> $t $t))`) with `callerIncomingOpen`:
1. Emits the exact 2-element list `[(.var "x", dupBranchOutBindings1), (.var "x", dupBranchOutBindings2)]`,
2. Carries `ReadoutCertificate` on both emitted binding frames,
3. Preserves `(nativeReadoutPresentation _).apply (.var "caller") = .var "x"` on both branches,
4. Keeps the two physical records distinct (`dupBranchOutBindings1 ≠ dupBranchOutBindings2`) via
   their equation-freshened variables `"y#1"` and `"y#2"`, while proving they are observationally
   equivalent on the caller scope `["caller", "x", "t"]`. -/
theorem controlC_multiplicity_and_open_alias_preservation :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 65 dupBranchOpenLoaded =
      ([(.var "x", dupBranchOutBindings1), (.var "x", dupBranchOutBindings2)],
       .finished ⟨dupBranchSpace, .returning [], [],
         [(.var "x", dupBranchOutBindings1), (.var "x", dupBranchOutBindings2)]⟩) ∧
    ReadoutCertificate dupBranchOutBindings1 (nativeReadoutPresentation dupBranchOutBindings1) ∧
    ReadoutCertificate dupBranchOutBindings2 (nativeReadoutPresentation dupBranchOutBindings2) ∧
    (nativeReadoutPresentation dupBranchOutBindings1).apply (.var "caller") = .var "x" ∧
    (nativeReadoutPresentation dupBranchOutBindings2).apply (.var "caller") = .var "x" ∧
    dupBranchOutBindings1 ≠ dupBranchOutBindings2 ∧
    BindingTheoryEquivAt ["caller", "x", "t"] dupBranchOutBindings1 dupBranchOutBindings2 ∧
    BindingTheoryEquivAt ["caller", "x", "t"] callerIncomingOpen dupBranchOutBindings1 := by
  refine ⟨dupBranchOpen_scoped_completed,
    dupBranchOutBindings1_certificate,
    dupBranchOutBindings2_certificate,
    by rw [nativeReadoutPresentation_apply_var]; decide +kernel,
    by rw [nativeReadoutPresentation_apply_var]; decide +kernel,
    by decide +kernel,
    ?_,
    callerIncomingOpen_equiv_dupBranchOutBindings1⟩
  rw [dupBranchOutBindings2_eq_rename]
  apply BindingTheoryEquivAt.of_renameBindings ["caller", "x", "t"]
    dupBranchOutBindings1 (Equiv.swap "y#1" "y#2")
  intro name hMem
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hMem
  rcases hMem with rfl | rfl | rfl <;>
    simp [Equiv.swap_apply_def]

/-! ### Control D: Pause/Grant Residual Alignment under `scopedTypes` -/

def zeroDepthScopedState : Configuration :=
  { Configuration.initial polyIdentSpace
      (.atom identTrueCall Atom.undefinedType callerIncomingOpen 0 [.var "held", .var "x", .var "t#0"]) with
    emitted := [(.var "t#1", callerIncomingOpen)] }

/-- Control D (Pause/grant residual alignment under `scopedTypes`):
1. Splitting the 52-step open polymorphic run across `6 + 46` steps pauses at the exact
   intermediate configuration `polyIdentOpenAfterHead` (retaining `emitted = [(.var "t#1", callerIncomingOpen)]`
   and fresh type variables `"t#2"`, `"t#3"`) and resumes to the exact same final state,
2. An exhausted-depth polymorphic request (`depth = 0`) suspends with `.suspended .evaluationDepth`
   under `scopedTypes` without forging an empty completion,
3. Granting depth `12` via `RecursiveMachine.Checked.replenish 12` restores `polyIdentOpenLoaded`
   (preserving the emitted history and caller bindings) and completes in 52 steps. -/
theorem controlD_pause_and_grant_residual_alignment :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 6 polyIdentOpenLoaded =
      ([], .exhausted polyIdentOpenAfterHead) ∧
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run (6 + 46) polyIdentOpenLoaded =
      (Checked.machine HE.GroundedDispatch.none scopedTypes).run 46 polyIdentOpenAfterHead ∧
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 1 zeroDepthScopedState =
      ([], .suspended .evaluationDepth zeroDepthScopedState) ∧
    RecursiveMachine.Checked.replenish 12 zeroDepthScopedState = polyIdentOpenLoaded ∧
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 52
      (RecursiveMachine.Checked.replenish 12 zeroDepthScopedState) =
      ([(.grounded (.bool true), polyIdentOutBindings)],
       .finished ⟨polyIdentSpace, .returning [], [],
         [(.var "t#1", callerIncomingOpen),
          (.grounded (.bool true), polyIdentOutBindings)]⟩) := by
  have hRepl : RecursiveMachine.Checked.replenish 12 zeroDepthScopedState = polyIdentOpenLoaded := rfl
  refine ⟨polyIdentOpen_reaches_afterHead,
    polyIdentOpen_split_resume,
    rfl,
    hRepl,
    ?_⟩
  rw [hRepl]
  exact polyIdentOpen_scoped_completed

/-! ### Control E: Cyclic Match Admission Boundary -/

/-- Control E (Cyclic raw match non-certification boundary):
Raw type matching admits `Spec.Match.ModelTheory.cyclicMergeOut`, which has a variable cycle
(`cyclicMergeOut.hasLoop = true`) and no finite model (`cyclic_output_has_no_finite_model`).
Consequently:
1. No `ReadoutCertificate` exists for `cyclicMergeOut`,
2. No `SourceBindingComparison.semantic.FrameRelated` witness exists for `cyclicMergeOut`,
3. No contextual `CastResultRel` lift exists for `[(.symbol "datum", cyclicMergeOut)]`. -/
theorem controlE_cyclic_match_not_certifiable (policy : Policy) :
    TypeMatchRel (.var "y") (.expression [.var "x"])
      Spec.Match.ModelTheory.cyclicMergeLeft
      Spec.Match.ModelTheory.cyclicMergeOut ∧
    Spec.Match.ModelTheory.cyclicMergeOut.hasLoop = true ∧
    (¬∃ table, ReadoutCertificate Spec.Match.ModelTheory.cyclicMergeOut table) ∧
    (¬∃ frame, SourceBindingComparison.semantic.FrameRelated
      Spec.Match.ModelTheory.cyclicMergeOut frame) ∧
    (¬∃ results, List.Forall₂
      (CastResultRel policy (rawTypeLookupRel Spec.Eval.Completed.Controls.cyclicTypeSpace)
        Spec.Eval.Completed.Controls.cyclicInputFrame (.symbol "datum") (.var "y"))
      [(.symbol "datum", Spec.Match.ModelTheory.cyclicMergeOut)] results) := by
  refine ⟨Spec.Eval.Completed.Controls.cyclic_type_match,
    by decide +kernel,
    ?_,
    ?_,
    Spec.Eval.Completed.Controls.cyclic_cast_has_no_contextual_lift policy⟩
  · rintro ⟨table, cert⟩
    exact Spec.Eval.Completed.Controls.cyclic_output_has_no_finite_model cert.satisfiable
  · rintro ⟨frame, related⟩
    exact Spec.Eval.Completed.Controls.cyclic_output_has_no_finite_model related.model

end ScopedWorkerControls

/-! ## Block 5: Universal Local Scoped Cast & Type-Check Squares (Checkpoint 1)

This section establishes the universal local commuting squares for executed
configuration-scoped casts and schematic polymorphic head/argument checks at an
**arbitrary** `Checked.machine dispatch scopedTypes` configuration `state` (with
arbitrary retained `state.stack : List Frame` and `state.emitted : ResultSet`),
without `ClosedTypeAnnotations` and without fixed-fuel concrete spaces:

1. **Primitive Matcher & Cast Coverage Laws**:
   - `typeCastCovered_of_singleton_lookup` & `typeCast_of_singleton_lookup`:
     exact reduction of `typeCast` and `typeCastCovered` on any singleton lookup.
   - `repeated_arrow_atoms_covered`, `fresh_arrow_merge_covered`,
     `fresh_arrow_type_match_covered`, `fresh_arrow_typeCast_eq`, and
     `fresh_arrow_typeCastCovered`: primitive matcher and coverage proofs for
     `matchTypes (-> $left $left) (-> $right $right) (bindings.assign left value) (depth + 7)`.
   - `fresh_symbol_typeCast_eq` and `fresh_symbol_typeCastCovered`: primitive
     matcher and coverage proofs for `typeCast (.symbol subject) (.var expected)`
     against `[.symbol actual]`.

2. **General Executed Worker Cast Step & Contextual Lift (`scoped_worker_symbol_cast_local_square`)**:
   - Starts at any `state : Configuration` with
     `state.control = .work (.atom (.symbol operator) expected bindings (depth + 1) live)`
     and arbitrary retained `state.stack` and `state.emitted`.
   - Proves that whenever `typeCastCovered` holds, `(Checked.machine dispatch scopedTypes).step state`
     advances in 1 checked step to `.returning (typeCast ...)` while preserving `state.stack` and
     `state.emitted`, commutes with any depth grant `state.deepen extra`, and lifts any modelled
     `TypeCastBatchRel` to earned `Completed.Frame`s (with constructed `ReadoutCertificate`s),
     `Completed.CastResultRel`, `Completed.AtomRel`, and `RecursiveMachine.Contextual.LocalStep.cast` /
     `Steps` under `Completed.scopedLookup`.

3. **Universal Schematic Variable-Expected Symbol Cast Square (`scoped_fresh_symbol_cast_local_square`)**:
   - Discharges `typeCast`, `typeCastCovered`, `TypeCastBatchRel`, and finite-model admission directly
     from `getAtomTypes state.space (.symbol subject) = [.symbol actual]` and `expected ∉ specBindingVars native`
     under arbitrary open certified caller bindings `native` / `source` / `table` and arbitrary
     retained `state.stack` / `state.emitted`.

4. **Universal Schematic Arrow Head-Cast Square (`scoped_fresh_arrow_head_cast_local_square`)**:
   - Discharges `typeCast`, `typeCastCovered`, `TypeCastBatchRel`, and finite-model admission directly
     from `invocationTypes state` and `scopedTypeLookup` on `(: operator (-> $parameter $parameter))`
     under arbitrary open certified caller bindings `native` / `source` / `table` and arbitrary
     retained `state.stack` / `state.emitted`, earning the renewed `ReadoutCertificate` for
     `(source.assign left (.symbol actual)).addEquality left right` and deriving the contextual
     `Completed.AtomRel` and `RecursiveMachine.Contextual.LocalStep.cast` / `Steps` transitions.
-/

namespace UniversalScopedCastAndHeadBoundary

open FirstSuccessSourceExecution
open FirstSuccessSourceApplicability
open FirstSuccessRecursiveStrategy
open FirstSuccessRecursiveExecution
open Spec.Eval Spec.Eval.Completed
open Spec.Type Spec.Type.Presentation Spec.Type.Presentation.Exact
open Spec.Type.Presentation.BindingTheory Spec.Type.RuntimeRefinement
open Spec.Bindings.ScopeObservation
open Spec.Match.Merge

/-- For a singleton type lookup `lookup b atom expectedType = [actual]`,
`typeCastCovered` reduces identically to `matchTypesCovered expectedType actual b depth`. -/
theorem typeCastCovered_of_singleton_lookup
    (atom expectedType actual : Atom) (space : Space) (b : Bindings) (depth : Nat)
    (lookup : TypeLookup)
    (queried : lookup b atom expectedType = [actual]) :
    typeCastCovered atom expectedType space b depth lookup =
      matchTypesCovered expectedType actual b depth := by
  unfold typeCastCovered TypeCheckDepth.castQuery matchTypesCovered MatchDepth.queryCovered
  rw [queried]
  simp only [TypeCheckDepth.castLoopQuery, Mettapedia.Machines.ReadOnlyQuery.run_bind]
  split <;> simp [Mettapedia.Machines.ReadOnlyQuery.run]

/-- For a singleton type lookup `lookup b atom expectedType = [actual]` whose `matchTypes`
produces `head :: tail`, `typeCast` returns `(head :: tail).map (fun m => (atom, m))`. -/
theorem typeCast_of_singleton_lookup
    (atom expectedType actual : Atom) (space : Space) (b : Bindings) (depth : Nat)
    (lookup : TypeLookup) (head : Bindings) (tail : List Bindings)
    (queried : lookup b atom expectedType = [actual])
    (matched : matchTypes expectedType actual b depth = head :: tail) :
    typeCast atom expectedType space b depth lookup =
      (head :: tail).map fun m => (atom, m) := by
  unfold typeCast
  rw [queried]
  simp [typeCast.typeCastLoop, matched]

open Mettapedia.Machines.ReadOnlyQuery

/-- Structural atom-matching coverage for repeated binary arrow types
`(-> $left $left)` against `(-> $right $right)` at depth `depth + 7`. -/
theorem repeated_arrow_atoms_covered (left right : String) (depth : Nat) :
    matchCovered (depth + 7)
      (.atoms (.expression [.symbol "->", .var left, .var left])
        (.expression [.symbol "->", .var right, .var right])) = true := by
  have noLoop (edges : List (String × String)) :
      (⟨[], edges⟩ : Bindings).hasLoop = false :=
    Bindings.hasLoop_false_of_assignments_nil _ rfl
  have emptyClass (edges : List (String × String)) (name : String) :
      (⟨[], edges⟩ : Bindings).classValues name = [] := by
    simp [Bindings.classValues, Bindings.lookup]
  simp [matchCovered, depthCovered, MatchDepth.body, MatchDepth.rawAtoms, evalMatch,
    matchAtoms, matchAtomsList, mergeBindings, addVarEquality, getMetaType,
    Atom.variableType, Atom.symbolType, Atom.expressionType, Atom.groundedType,
    Bindings.empty, Bindings.addEquality, emptyClass, noLoop,
    Bindings.valuesConsistent, foldQueries, flatTraverse, run_bind, run_map, run]

/-- Merge coverage for linking both positions of `(-> $left $left)` and `(-> $right $right)`
into `bindings.assign left value` at depth `depth + 7`. -/
theorem fresh_arrow_merge_covered (bindings : Bindings) (left right : String)
    (value : Atom) (depth : Nat) (leftFresh : left ∉ bindings.names)
    (rightFresh : right ∉ bindings.names) (different : left ≠ right) :
    matchCovered (depth + 7)
      (.merge (bindings.assign left value)
        ((Bindings.empty.addEquality left right).addEquality left right)) = true := by
  have first := FirstSuccessSourceApplicability.fresh_instance_alias_values
    bindings left right value leftFresh rightFresh different
  have second : (((bindings.assign left value).addEquality left right).classValues
      left) = [value] := first
  have second2 : (((bindings.assign left value).addEquality left right).addEquality left right).classValues
      left = [value] := by
    rw [EqualityClosure.classValues_addEquality_of_mem (by simp [Bindings.addEquality])]
    exact first
  have firstAdded : addVarEquality (bindings.assign left value) left right (depth + 6) =
      [(bindings.assign left value).addEquality left right] := by
    rw [show depth + 6 = (depth + 5) + 1 by omega, addVarEquality]
    simp only [first, Bindings.valuesConsistent, List.all_nil, ↓reduceIte]
  rw [show (Bindings.empty.addEquality left right).addEquality left right =
    ⟨[], [(left, right), (left, right)]⟩ from rfl]
  simp [matchCovered, depthCovered, MatchDepth.body, evalMatch, first, second2, firstAdded,
    Bindings.valuesConsistent, foldQueries, flatTraverse, run_bind, run_map, run]

/-- Type-matching coverage for `(-> $left $left)` against `(-> $right $right)`
under `bindings.assign left value` at depth `depth + 7`. -/
theorem fresh_arrow_type_match_covered (bindings : Bindings) (left right : String)
    (value : Atom) (depth : Nat) (leftFresh : left ∉ bindings.names)
    (rightFresh : right ∉ bindings.names) (different : left ≠ right) :
    matchTypesCovered (.expression [.symbol "->", .var left, .var left])
      (.expression [.symbol "->", .var right, .var right])
      (bindings.assign left value) (depth + 7) = true := by
  have atomsCov := repeated_arrow_atoms_covered left right depth
  have mergeCov := fresh_arrow_merge_covered bindings left right value depth
    leftFresh rightFresh different
  unfold matchTypesCovered MatchDepth.queryCovered MatchDepth.typesQuery
  split
  · rfl
  · simp [run, evalMatch,
      FirstSuccessSourceExecution.repeated_arrow_match,
      run_flatTraverse_reads, atomsCov, mergeCov]

/-- Exact `typeCast` evaluation for a schematic arrow head under a singleton lookup. -/
theorem fresh_arrow_typeCast_eq (operator : Atom) (space : Space) (bindings : Bindings)
    (left right : String) (value : Atom) (depth : Nat) (lookup : TypeLookup)
    (leftFresh : left ∉ bindings.names) (rightFresh : right ∉ bindings.names)
    (different : left ≠ right)
    (queried : lookup (bindings.assign left value) operator
      (.expression [.symbol "->", .var left, .var left]) =
      [.expression [.symbol "->", .var right, .var right]]) :
    typeCast operator (.expression [.symbol "->", .var left, .var left])
      space (bindings.assign left value) (depth + 7) lookup =
      [(operator, ((bindings.assign left value).addEquality left right).addEquality left right)] := by
  exact typeCast_of_singleton_lookup operator
    (.expression [.symbol "->", .var left, .var left])
    (.expression [.symbol "->", .var right, .var right])
    space (bindings.assign left value) (depth + 7) lookup
    (((bindings.assign left value).addEquality left right).addEquality left right) []
    queried
    (FirstSuccessSourceExecution.fresh_arrow_type_match
      bindings left right value depth leftFresh rightFresh different)

/-- Exact `typeCastCovered` evaluation for a schematic arrow head under a singleton lookup. -/
theorem fresh_arrow_typeCastCovered (operator : Atom) (space : Space) (bindings : Bindings)
    (left right : String) (value : Atom) (depth : Nat) (lookup : TypeLookup)
    (leftFresh : left ∉ bindings.names) (rightFresh : right ∉ bindings.names)
    (different : left ≠ right)
    (queried : lookup (bindings.assign left value) operator
      (.expression [.symbol "->", .var left, .var left]) =
      [.expression [.symbol "->", .var right, .var right]]) :
    typeCastCovered operator (.expression [.symbol "->", .var left, .var left])
      space (bindings.assign left value) (depth + 7) lookup = true := by
  rw [typeCastCovered_of_singleton_lookup _ _ _ _ _ _ _ queried]
  exact fresh_arrow_type_match_covered bindings left right value depth
    leftFresh rightFresh different

/-- Exact `typeCast` evaluation for casting `subject` to a fresh schematic variable `.var expected`
when `lookup bindings subject (.var expected) = [.symbol actual]`. -/
theorem fresh_symbol_typeCast_eq (subject : Atom) (space : Space) (bindings : Bindings)
    (expected actual : String) (depth : Nat) (lookup : TypeLookup)
    (notUndefined : actual ≠ "%Undefined%") (notAtom : actual ≠ "Atom")
    (fresh : bindings.classValues expected = [])
    (queried : lookup bindings subject (.var expected) = [.symbol actual]) :
    typeCast subject (.var expected) space bindings (depth + 2) lookup =
      [(subject, bindings.assign expected (.symbol actual))] := by
  exact typeCast_of_singleton_lookup subject (.var expected) (.symbol actual)
    space bindings (depth + 2) lookup (bindings.assign expected (.symbol actual)) []
    queried
    (FirstSuccessSourceApplicability.fresh_symbol_type_match
      expected actual bindings depth notUndefined notAtom fresh)

/-- Exact `typeCastCovered` evaluation for casting `subject` to a fresh schematic variable
`.var expected` when `lookup bindings subject (.var expected) = [.symbol actual]`. -/
theorem fresh_symbol_typeCastCovered (subject : Atom) (space : Space) (bindings : Bindings)
    (expected actual : String) (depth : Nat) (lookup : TypeLookup)
    (fresh : bindings.classValues expected = [])
    (queried : lookup bindings subject (.var expected) = [.symbol actual]) :
    typeCastCovered subject (.var expected) space bindings (depth + 2) lookup = true := by
  rw [typeCastCovered_of_singleton_lookup _ _ _ _ _ _ _ queried]
  exact FirstSuccessSourceApplicability.fresh_symbol_type_match_covered
    expected actual bindings depth fresh

/-- Assigning an unbound variable preserves all existing variable names in `b.names`. -/
theorem names_subset_assign_of_lookup_none (b : Bindings) (v : String) (val : Atom)
    (unbound : b.lookup v = none) {x : String} (mem : x ∈ b.names) :
    x ∈ (b.assign v val).names := by
  have notBound : b.isBound v = false := by
    simp [Bindings.isBound, unbound]
  simp only [Bindings.assign, notBound, Bool.false_eq_true, ↓reduceIte, Bindings.names,
    List.flatMap_append, List.mem_append] at mem ⊢
  rcases mem with assignMem | eqMem
  · exact Or.inl (Or.inl assignMem)
  · exact Or.inr eqMem

open private atomVariables_eq_typeVars atomListVariables_eq_typeVarsList
  from Mettapedia.Languages.MeTTa.HE.EquationFreshening

/-- Universal Scoped Lookup Alignment at an Atom-Cast Request:
When `state.control = .work (.atom subject expected nativeBindings fuel live)`,
`nativeBindings` and `before.source` are semantically `FrameRelated`, and `scope` is
retained in `RecursiveScope.configurationNames state`, the worker's actual
`invocationTypes state nativeBindings subject expected` satisfies `Completed.scopedLookup`
for `before.bindings` at `invocationTypeScope scope live subject expected before.bindings`. -/
theorem scopedLookup_of_invocationTypes_related
    (state : Configuration) (subject expected : Atom)
    (nativeBindings : Bindings) (before : Completed.Frame)
    (fuel : Nat) (live : List Atom) (scope : List String)
    (pending : state.control = .work (.atom subject expected nativeBindings fuel live))
    (related : SourceBindingComparison.semantic.FrameRelated nativeBindings before.source)
    (retained : ∀ name ∈ scope, name ∈ RecursiveScope.configurationNames state) :
    Completed.scopedLookup
      (invocationTypeScope scope live subject expected before.bindings)
      state.space before.bindings subject expected
      (invocationTypes state nativeBindings subject expected) := by
  refine ⟨getAtomTypes state.space subject, FirstSuccessSourceReplies.source_types state.space subject, ?_⟩
  apply EquationFreshening.getAtomTypesScoped_variants
    (RecursiveScope.configurationNames state) state.space nativeBindings subject expected
  intro name member
  simp only [invocationTypeScope, List.nil_append, TypeSubst.typeVarsList,
    List.append_nil, List.mem_append] at member ⊢
  have beforeEq : before.source.bindings = before.bindings := rfl
  rcases member with (((kept | used) | bound) | subjectOrExpected) | boundAgain
  · exact Or.inl (Or.inl (Or.inl (retained name kept)))
  · left; left; left
    rw [← atomListVariables_eq_typeVarsList] at used
    simp only [atomListVariables_append, atomListVariables, List.append_nil,
      List.mem_append] at used
    simp only [RecursiveScope.configurationNames, RecursiveScope.liveAtoms, pending,
      RecursiveScope.controlAtoms, RecursiveScope.taskAtoms, atomListVariables_append,
      atomListVariables, List.append_nil, List.mem_append]
    tauto
  · exact Or.inl (Or.inl (Or.inr ((related.related.support name).mpr (beforeEq ▸ bound))))
  · rcases subjectOrExpected with subMem | expMem
    · exact Or.inl (Or.inr subMem)
    · exact Or.inr expMem
  · exact Or.inl (Or.inl (Or.inr ((related.related.support name).mpr (beforeEq ▸ boundAgain))))

/-- When `nativeBindings` and `sourceBindings` satisfy `BindingSourceAgreement`
(without requiring `SourceBindingComparison.semantic.FrameRelated`) and `scope` is
retained in `RecursiveScope.configurationNames state`, the worker's actual
`invocationTypes state nativeBindings subject expected` satisfies `Completed.scopedLookup`
for `sourceBindings` at `invocationTypeScope scope live subject expected sourceBindings`. -/
theorem scopedLookup_of_invocationTypes_agreed
    (state : Configuration) (subject expected : Atom)
    (nativeBindings sourceBindings : Bindings)
    (fuel : Nat) (live : List Atom) (scope : List String)
    (pending : state.control = .work (.atom subject expected nativeBindings fuel live))
    (agreed : BindingSourceAgreement nativeBindings sourceBindings)
    (retained : ∀ name ∈ scope, name ∈ RecursiveScope.configurationNames state) :
    Completed.scopedLookup
      (invocationTypeScope scope live subject expected sourceBindings)
      state.space sourceBindings subject expected
      (invocationTypes state nativeBindings subject expected) := by
  refine ⟨getAtomTypes state.space subject, FirstSuccessSourceReplies.source_types state.space subject, ?_⟩
  apply EquationFreshening.getAtomTypesScoped_variants
    (RecursiveScope.configurationNames state) state.space nativeBindings subject expected
  intro name member
  simp only [invocationTypeScope, List.nil_append, TypeSubst.typeVarsList,
    List.append_nil, List.mem_append] at member ⊢
  rcases member with (((kept | used) | bound) | subjectOrExpected) | boundAgain
  · exact Or.inl (Or.inl (Or.inl (retained name kept)))
  · left; left; left
    rw [← atomListVariables_eq_typeVarsList] at used
    simp only [atomListVariables_append, atomListVariables, List.append_nil,
      List.mem_append] at used
    simp only [RecursiveScope.configurationNames, RecursiveScope.liveAtoms, pending,
      RecursiveScope.controlAtoms, RecursiveScope.taskAtoms, atomListVariables_append,
      atomListVariables, List.append_nil, List.mem_append]
    tauto
  · exact Or.inl (Or.inl (Or.inr ((agreed.support name).mpr bound)))
  · rcases subjectOrExpected with subMem | expMem
    · exact Or.inl (Or.inr subMem)
    · exact Or.inr expMem
  · exact Or.inl (Or.inl (Or.inr ((agreed.support name).mpr boundAgain)))

/-- Self-lookup specialization of `scopedLookup_of_invocationTypes_agreed`:
when `scope` is retained in `RecursiveScope.configurationNames state`, the worker's
actual `invocationTypes state nativeBindings subject expected` satisfies `Completed.scopedLookup`
for `nativeBindings` at `invocationTypeScope scope live subject expected nativeBindings`. -/
theorem scopedLookup_of_invocationTypes_self
    (state : Configuration) (subject expected : Atom)
    (nativeBindings : Bindings)
    (fuel : Nat) (live : List Atom) (scope : List String)
    (pending : state.control = .work (.atom subject expected nativeBindings fuel live))
    (retained : ∀ name ∈ scope, name ∈ RecursiveScope.configurationNames state) :
    Completed.scopedLookup
      (invocationTypeScope scope live subject expected nativeBindings)
      state.space nativeBindings subject expected
      (invocationTypes state nativeBindings subject expected) :=
  scopedLookup_of_invocationTypes_agreed state subject expected nativeBindings nativeBindings
    fuel live scope pending (.refl nativeBindings) retained

/-- Under `BindingSourceAgreement left right`, the invocation type scope for `right`
is included in the invocation type scope for `left`. -/
theorem invocationTypeScope_included_of_agreement
    (scope : List String) (live : List Atom) (subject expected : Atom)
    {left right : Bindings} (agreed : BindingSourceAgreement left right) :
    ∀ name ∈ invocationTypeScope scope live subject expected right,
      name ∈ invocationTypeScope scope live subject expected left := by
  intro name member
  simp only [invocationTypeScope, List.mem_append] at member ⊢
  rcases member with (kept | used) | bound
  · exact Or.inl (Or.inl kept)
  · exact Or.inl (Or.inr used)
  · exact Or.inr ((agreed.support name).mpr bound)

/-- Single checked step of the configuration-scoped worker on a non-empty symbol cast
at an arbitrary configuration `state` (preserving arbitrary `state.stack` and `state.emitted`). -/
theorem scoped_worker_symbol_cast_step (state : Configuration)
    (dispatch : HE.GroundedDispatch) (operator : String) (expected : Atom)
    (bindings : Bindings) (depth : Nat) (live : List Atom)
    (pending : state.control = .work (.atom (.symbol operator) expected bindings (depth + 1) live))
    (clean : operator ≠ "Empty")
    (notAtom : expected ≠ Atom.atomType)
    (notSymbol : expected ≠ Atom.symbolType)
    (covered : typeCastCovered (.symbol operator) expected state.space bindings depth
      (invocationTypes state) = true) :
    let workerOut := typeCast (.symbol operator) expected state.space bindings depth
      (invocationTypes state)
    Checked.blocked dispatch state scopedTypes = none ∧
    (Checked.machine dispatch scopedTypes).step state =
      some (.silent { state with control := .returning workerOut }) := by
  dsimp only
  have notEmptyErr : isEmptyOrError (.symbol operator) = false := by
    simp [isEmptyOrError, isEmptyAtom, Atom.empty, isErrorAtom, clean]
  have notVarP : Atom.symbolType ≠ Atom.variableType := by decide
  have ready : Checked.blocked dispatch state scopedTypes = none := by
    simp [Checked.blocked, pending, FirstSuccessRecursiveStrategy.taskReady,
      RecursiveMachine.Checked.taskReady, scopedTypes, getMetaType,
      notEmptyErr, notAtom, notSymbol, notVarP, covered]
  refine ⟨ready, ?_⟩
  simp only [Checked.machine, RecursiveMachine.Checked.guardMachine]
  rw [ready]
  simp [FirstSuccessRecursiveExecution.machine, next, pending, scopedTypes,
    FirstSuccessRecursiveStrategy.enter, RecursiveMachine.enter, getMetaType,
    notEmptyErr, notAtom, notSymbol, notVarP, Transition.relabel]

/-- Internal helper lifting a pre-assembled modelled source batch `raw` to contextual
`CastResultRel`, `Completed.AtomRel`, and `RecursiveMachine.Contextual.LocalStep.cast`
under any `Policy` (used by the explicit fresh-variable/fresh-arrow squares under `.unmarked`). -/
private theorem scoped_worker_symbol_cast_of_modelled_source_batch
    (state : Configuration) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator : String) (expected : Atom) (bindings : Bindings)
    (depth : Nat) (live : List Atom) (scope : List String)
    (before : Completed.Frame)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result)
    (pending : state.control = .work (.atom (.symbol operator) expected bindings (depth + 1) live))
    (clean : operator ≠ "Empty")
    (notAtom : expected ≠ Atom.atomType)
    (notSymbol : expected ≠ Atom.symbolType)
    (related : SourceBindingComparison.semantic.FrameRelated bindings before.source)
    (covered : typeCastCovered (.symbol operator) expected state.space bindings depth
      (invocationTypes state) = true)
    (raw : ResultSet)
    (batch : TypeCastBatchRel state.space (.symbol operator) expected before.bindings raw
      (lookup := Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
      (matching := policy.matching.Rel))
    (models : ∀ result ∈ raw, ∃ valuation : String → Atom,
      TypeBindingSatisfied valuation result.2)
    (outRelated : List.Forall₂
      (fun w s : ResultPair =>
        w.1 = s.1 ∧ ∀ callerScope : List String, BindingTheoryEquivAt callerScope w.2 s.2)
      (typeCast (.symbol operator) expected state.space bindings depth (invocationTypes state))
      raw) :
    let workerOut := typeCast (.symbol operator) expected state.space bindings depth
      (invocationTypes state)
    (∀ callerScope : List String, BindingTheoryEquivAt callerScope bindings before.bindings) ∧
    Checked.blocked dispatch state scopedTypes = none ∧
    (Checked.machine dispatch scopedTypes).step state =
      some (.silent { state with control := .returning workerOut }) ∧
    (∀ extra : Nat,
      typeCast (.symbol operator) expected state.space bindings (depth + extra)
        (invocationTypes (state.deepen extra)) = workerOut) ∧
    ∃ ctxResults : List Completed.Result,
      ctxResults.map Completed.rawResult = raw ∧
      (∀ r ∈ ctxResults,
        ∃ table, ReadoutCertificate r.2.bindings table) ∧
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧ ∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings)
        workerOut ctxResults ∧
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
          before (.symbol operator) expected)
        raw ctxResults ∧
      Completed.AtomRel state.space hostDispatch Completed.scopedLookup
        live scope (.symbol operator) expected before ctxResults (policy := policy) ∧
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch
        Completed.scopedLookup policy
        (.work (.atom live scope (.symbol operator) expected before), ctxStack)
        (.returning ctxResults, ctxStack) ∧
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
        ⟨state.space, .work (.atom live scope (.symbol operator) expected before), ctxStack, ctxEmitted⟩
        ⟨state.space, .returning ctxResults, ctxStack, ctxEmitted⟩ := by
  dsimp only
  have inEquiv : ∀ callerScope : List String,
      BindingTheoryEquivAt callerScope bindings before.bindings :=
    fun callerScope => related.related.theoryEquivAt callerScope
  obtain ⟨unblocked, stepped⟩ := scoped_worker_symbol_cast_step
    state dispatch operator expected bindings depth live pending clean notAtom notSymbol covered
  have readSym : before.read policy (.symbol operator) = .symbol operator := by
    cases hRebuild : policy.rebuilding <;>
      simp [Completed.Frame.read, Entry.Value.substitute, hRebuild]
  have entryCast :
      Entry.Rel policy.reentry (before.read policy (.symbol operator)).status
        (before.read policy (.symbol operator)).erase expected .cast := by
    simp only [readSym, Entry.Value.status, Entry.Value.erase]
    exact Spec.Eval.Entry.Rel.cast (policy := policy.reentry) (status := .active)
      (by simpa [IsEmptyOrErrorRel, IsErrorRel, Atom.empty] using clean)
      (.symbol operator)
      (by
        rintro (hAtom | hSym | hVar)
        · exact notAtom hAtom
        · exact notSymbol hSym
        · exact absurd hVar (by decide))
      (Or.inl ⟨operator, rfl⟩)
      (fun _ => Or.inr rfl)
  obtain ⟨ctxResults, paired⟩ :=
    Completed.CastResultRel.lift_modelled_batch
      (space := state.space) (policy := policy)
      (lookup := Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
      (before := before) (original := .symbol operator) (expected := expected)
      (raw := raw) (by simpa [Entry.Value.erase] using batch) models
  have readouts := Completed.CastResultRel.readouts paired
  have pairedRead :
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope live
              (before.read policy (.symbol operator)).erase expected before.bindings) state.space)
          before (before.read policy (.symbol operator)) expected)
        raw ctxResults := by
    simpa only [readSym, Entry.Value.erase] using paired
  have batchRead :
      TypeCastBatchRel state.space (before.read policy (.symbol operator)).erase
        expected before.bindings raw
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live
            (before.read policy (.symbol operator)).erase expected before.bindings) state.space)
        (matching := policy.matching.Rel) := by
    simpa only [readSym, Entry.Value.erase] using batch
  have atomRel :
      Completed.AtomRel state.space hostDispatch Completed.scopedLookup
        live scope (.symbol operator) expected before ctxResults (policy := policy) :=
    Completed.AtomRel.cast entryCast batchRead pairedRead
  have localStep :
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch
        Completed.scopedLookup policy
        (.work (.atom live scope (.symbol operator) expected before), ctxStack)
        (.returning ctxResults, ctxStack) :=
    RecursiveMachine.Contextual.LocalStep.cast entryCast batchRead pairedRead
  have steps :
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
        ⟨state.space, .work (.atom live scope (.symbol operator) expected before), ctxStack, ctxEmitted⟩
        ⟨state.space, .returning ctxResults, ctxStack, ctxEmitted⟩ :=
    Relation.ReflTransGen.single (RecursiveMachine.Contextual.Step.internal localStep)
  have workerCtxAligned :
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧ ∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings)
        (typeCast (.symbol operator) expected state.space bindings depth (invocationTypes state))
        ctxResults := by
    rw [← readouts] at outRelated
    exact List.forall₂_map_right_iff.mp outRelated
  refine ⟨inEquiv, unblocked, stepped, ?_, ctxResults, readouts, ?_, workerCtxAligned,
    paired, atomRel, localStep, steps⟩
  · intro extra
    rw [invocationTypes_deepen]
    exact typeCastCovered_stable (.symbol operator) expected state.space bindings depth extra covered
  · intro r _
    exact ⟨Entry.Value.eraseEnvironment r.2.environment, r.2.certified⟩

/-- General Finite-Cast Join (`scoped_worker_symbol_cast_enabling_bridge`):
At any configuration `state` (with arbitrary retained `state.stack` and `state.emitted`),
when `bindings` and `before.bindings` satisfy `BindingSourceAgreement` (without requiring
literal `SourceBindingComparison.semantic.FrameRelated`) and `HEAssignmentsNonVariable`,
`policy.matching = .finite`, `typeCastCovered` holds on the worker's scoped
`invocationTypes state`, and the worker's output `workerOut` satisfies the native-side
scoped finite `TypeCastBatchRel` (`nativeBatch`):
1. `(Checked.machine dispatch scopedTypes).step state` advances in 1 checked step to
   `.returning workerOut`, preserving `state.stack` and `state.emitted`,
2. Increasing evaluator depth via `state.deepen extra` commutes with the step and produces
   the identical `workerOut`,
3. Without any source-side `raw`, `batch`, `models`, or `outRelated` oracle, constructs
   both the source batch `sourceResults : ResultSet` (via `BindingSourceAgreement.typeCastBatch_scoped_finite`)
   and the contextual output list `ctxResults : List Completed.Result` (via `Completed.CastResultRel.lift_finite_batch`),
4. Every contextual output frame carries its earned `ReadoutCertificate` and satisfies
   `Completed.CastResultRel`, `Completed.AtomRel`, `RecursiveMachine.Contextual.LocalStep.cast`,
   and `RecursiveMachine.Contextual.Steps` under `Completed.scopedLookup`,
5. Each pair `(w, c)` of `workerOut` and `ctxResults` satisfies `w.1 = c.1.erase`,
   `BindingSourceAgreement w.2 c.2.bindings`, `BindingTheoryEquivAt callerScope w.2 c.2.bindings`,
   and public readout equality
   `observedTuples w.2 (callerScope.map Atom.var ++ [w.1]) = RecursiveExecution.Contextual.Protocol.resultTheory callerScope c`
   on every `callerScope`. -/
theorem scoped_worker_symbol_cast_enabling_bridge
    (state : Configuration) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator : String) (expected : Atom) (bindings : Bindings)
    (depth : Nat) (live : List Atom) (scope : List String)
    (before : Completed.Frame)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result)
    (pending : state.control = .work (.atom (.symbol operator) expected bindings (depth + 1) live))
    (clean : operator ≠ "Empty")
    (notAtom : expected ≠ Atom.atomType)
    (notSymbol : expected ≠ Atom.symbolType)
    (agreed : BindingSourceAgreement bindings before.bindings)
    (nativeShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable bindings)
    (sourceShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable before.bindings)
    (finite : policy.matching = .finite)
    (covered : typeCastCovered (.symbol operator) expected state.space bindings depth
      (invocationTypes state) = true)
    (nativeBatch : TypeCastBatchRel state.space (.symbol operator) expected bindings
      (typeCast (.symbol operator) expected state.space bindings depth (invocationTypes state))
      (lookup := Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected bindings) state.space)
      (matching := TypeMatchingPolicy.Rel .finite)) :
    let workerOut := typeCast (.symbol operator) expected state.space bindings depth
      (invocationTypes state)
    (∀ callerScope : List String, BindingTheoryEquivAt callerScope bindings before.bindings) ∧
    Checked.blocked dispatch state scopedTypes = none ∧
    (Checked.machine dispatch scopedTypes).step state =
      some (.silent { state with control := .returning workerOut }) ∧
    (∀ extra : Nat,
      typeCast (.symbol operator) expected state.space bindings (depth + extra)
        (invocationTypes (state.deepen extra)) = workerOut) ∧
    ∃ sourceResults : ResultSet,
    ∃ ctxResults : List Completed.Result,
      TypeCastBatchRel state.space (.symbol operator) expected before.bindings sourceResults
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
        (matching := policy.matching.Rel) ∧
      ctxResults.map Completed.rawResult = sourceResults ∧
      (∀ r ∈ ctxResults,
        (∃ table, ReadoutCertificate r.2.bindings table) ∧
        Spec.Match.SolutionTheory.HEAssignmentsNonVariable r.2.bindings) ∧
      List.Forall₂
        (fun (w : ResultPair) (s : ResultPair) =>
          w.1 = s.1 ∧ BindingSourceAgreement w.2 s.2)
        workerOut sourceResults ∧
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧
          BindingSourceAgreement w.2 c.2.bindings ∧
          (∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings) ∧
          (∀ callerScope : List String,
            observedTuples w.2 (callerScope.map Atom.var ++ [w.1]) =
              RecursiveExecution.Contextual.Protocol.resultTheory callerScope c))
        workerOut ctxResults ∧
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
          before (.symbol operator) expected)
        sourceResults ctxResults ∧
      Completed.AtomRel state.space hostDispatch Completed.scopedLookup
        live scope (.symbol operator) expected before ctxResults (policy := policy) ∧
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch
        Completed.scopedLookup policy
        (.work (.atom live scope (.symbol operator) expected before), ctxStack)
        (.returning ctxResults, ctxStack) ∧
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
        ⟨state.space, .work (.atom live scope (.symbol operator) expected before), ctxStack, ctxEmitted⟩
        ⟨state.space, .returning ctxResults, ctxStack, ctxEmitted⟩ := by
  dsimp only
  let workerOut := typeCast (.symbol operator) expected state.space bindings depth
    (invocationTypes state)
  have inEquiv : ∀ callerScope : List String,
      BindingTheoryEquivAt callerScope bindings before.bindings :=
    fun callerScope => agreed.theoryEquivAt callerScope
  obtain ⟨unblocked, stepped⟩ := scoped_worker_symbol_cast_step
    state dispatch operator expected bindings depth live pending clean notAtom notSymbol covered
  have scopeInc :
      ∀ name ∈ invocationTypeScope scope live (.symbol operator) expected before.bindings,
        name ∈ invocationTypeScope scope live (.symbol operator) expected bindings :=
    invocationTypeScope_included_of_agreement scope live (.symbol operator) expected agreed
  obtain ⟨sourceResults, sourceBatchFinite, outAgreed, outShapes⟩ :=
    agreed.typeCastBatch_scoped_finite nativeShape sourceShape scopeInc nativeBatch
  have sourceBatch :
      TypeCastBatchRel state.space (.symbol operator) expected before.bindings sourceResults
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
        (matching := policy.matching.Rel) := by
    rw [← finite] at sourceBatchFinite
    exact sourceBatchFinite
  have readSym : before.read policy (.symbol operator) = .symbol operator := by
    cases hRebuild : policy.rebuilding <;>
      simp [Completed.Frame.read, Entry.Value.substitute, hRebuild]
  have entryCast :
      Entry.Rel policy.reentry (before.read policy (.symbol operator)).status
        (before.read policy (.symbol operator)).erase expected .cast := by
    simp only [readSym, Entry.Value.status, Entry.Value.erase]
    exact Spec.Eval.Entry.Rel.cast (policy := policy.reentry) (status := .active)
      (by simpa [IsEmptyOrErrorRel, IsErrorRel, Atom.empty] using clean)
      (.symbol operator)
      (by
        rintro (hAtom | hSym | hVar)
        · exact notAtom hAtom
        · exact notSymbol hSym
        · exact absurd hVar (by decide))
      (Or.inl ⟨operator, rfl⟩)
      (fun _ => Or.inr rfl)
  obtain ⟨ctxResults, paired⟩ :=
    Completed.CastResultRel.lift_finite_batch
      (space := state.space) (policy := policy)
      (lookup := Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
      (before := before) (original := .symbol operator) (expected := expected)
      (raw := sourceResults) finite (by simpa [Entry.Value.erase] using sourceBatch)
  have readouts := Completed.CastResultRel.readouts paired
  have pairedRead :
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope live
              (before.read policy (.symbol operator)).erase expected before.bindings) state.space)
          before (before.read policy (.symbol operator)) expected)
        sourceResults ctxResults := by
    simpa only [readSym, Entry.Value.erase] using paired
  have batchRead :
      TypeCastBatchRel state.space (before.read policy (.symbol operator)).erase
        expected before.bindings sourceResults
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live
            (before.read policy (.symbol operator)).erase expected before.bindings) state.space)
        (matching := policy.matching.Rel) := by
    simpa only [readSym, Entry.Value.erase] using sourceBatch
  have atomRel :
      Completed.AtomRel state.space hostDispatch Completed.scopedLookup
        live scope (.symbol operator) expected before ctxResults (policy := policy) :=
    Completed.AtomRel.cast entryCast batchRead pairedRead
  have localStep :
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch
        Completed.scopedLookup policy
        (.work (.atom live scope (.symbol operator) expected before), ctxStack)
        (.returning ctxResults, ctxStack) :=
    RecursiveMachine.Contextual.LocalStep.cast entryCast batchRead pairedRead
  have steps :
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
        ⟨state.space, .work (.atom live scope (.symbol operator) expected before), ctxStack, ctxEmitted⟩
        ⟨state.space, .returning ctxResults, ctxStack, ctxEmitted⟩ :=
    Relation.ReflTransGen.single (RecursiveMachine.Contextual.Step.internal localStep)
  have outMap :
      List.Forall₂
        (fun (w : ResultPair) (s : ResultPair) =>
          w.1 = s.1 ∧ BindingSourceAgreement w.2 s.2)
        workerOut (ctxResults.map Completed.rawResult) := by
    rw [readouts]
    exact outAgreed
  have rawPaired := List.forall₂_map_right_iff.mp outMap
  have workerCtxAligned :
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧
          BindingSourceAgreement w.2 c.2.bindings ∧
          (∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings) ∧
          (∀ callerScope : List String,
            observedTuples w.2 (callerScope.map Atom.var ++ [w.1]) =
              RecursiveExecution.Contextual.Protocol.resultTheory callerScope c))
        workerOut ctxResults := by
    refine rawPaired.imp ?_
    rintro ⟨wAtom, wBind⟩ ⟨cVal, cFrame⟩ ⟨hAtom, hAgree⟩
    dsimp [Completed.rawResult] at hAtom hAgree
    refine ⟨hAtom, hAgree, fun callerScope => hAgree.theoryEquivAt callerScope, fun callerScope => ?_⟩
    rw [hAtom]
    exact (hAgree.theoryEquivAt
      (TypeSubst.typeVarsList (callerScope.map Atom.var ++ [cVal.erase]))).observedTuples_eq
      (callerScope.map Atom.var ++ [cVal.erase]) (fun _ h => h)
  refine ⟨inEquiv, unblocked, stepped, ?_, sourceResults, ctxResults, sourceBatch, readouts,
    ?_, outAgreed, workerCtxAligned, paired, atomRel, localStep, steps⟩
  · intro extra
    rw [invocationTypes_deepen]
    exact typeCastCovered_stable (.symbol operator) expected state.space bindings depth extra covered
  · intro r hMem
    refine ⟨⟨Entry.Value.eraseEnvironment r.2.environment, r.2.certified⟩, ?_⟩
    have hRawMem : Completed.rawResult r ∈ sourceResults := by
      rw [← readouts]
      exact List.mem_map_of_mem hMem
    exact outShapes (Completed.rawResult r) hRawMem

/-- Covered Empty `matchTypes` Refutes Finite Source Type-Matching
(`covered_matchTypes_empty_not_typeMatch_finite`):
When `matchTypesCovered expected actual b depth = true` and `b` has no variable-valued
assignments (`Spec.Match.SolutionTheory.HEAssignmentsNonVariable b`), an empty executable result
`matchTypes expected actual b depth = []` refutes `TypeMatchingPolicy.Rel .finite expected actual b candidate`
for every `candidate : Bindings` (without requiring `b` itself to be satisfiable). -/
theorem covered_matchTypes_empty_not_typeMatch_finite
    {expected actual : Atom} {b : Bindings} {depth : Nat}
    (bShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable b)
    (covered : matchTypesCovered expected actual b depth = true)
    (empty : matchTypes expected actual b depth = []) :
    ∀ candidate : Bindings, ¬TypeMatchingPolicy.Rel .finite expected actual b candidate := by
  intro candidate ⟨hMatch, valuation, hSat⟩
  have notUndefLeft : expected ≠ Atom.undefinedType := by
    intro h; subst h; simp [matchTypes] at empty
  have notAtomLeft : expected ≠ Atom.atomType := by
    intro h; subst h; simp [matchTypes] at empty
  have notUndefRight : actual ≠ Atom.undefinedType := by
    intro h; subst h; simp [matchTypes] at empty
  have notAtomRight : actual ≠ Atom.atomType := by
    intro h; subst h; simp [matchTypes] at empty
  obtain ⟨hAtomsCov, hMergeCov⟩ :=
    (FirstSuccessSourceReplies.matchTypesCovered_nonWildcard_iff b depth
      notUndefLeft notAtomLeft notUndefRight notAtomRight).mp covered
  obtain ⟨matched, hSpecMatch, hSpecMerge⟩ :=
    hMatch.structural_of_nonWildcard notUndefLeft notAtomLeft notUndefRight notAtomRight
  have hConj := (bindingSatisfied_append_iff valuation b matched).mp
    ((hSpecMerge.bindingSourceAgreement.solutions valuation).mp hSat)
  let observer : String → Metta.Atom := fun name => Spec.Match.SolutionTheory.encodeModelAtom (valuation name)
  have hHeB : Spec.Match.SolutionTheory.HEBindingSatisfied observer b :=
    Spec.Bindings.ScopeObservation.ModelTransport.heBindingSatisfied_of_specTypeBindingSatisfied hConj.1
  have hHeMatched : Spec.Match.SolutionTheory.HEBindingSatisfied observer matched :=
    Spec.Bindings.ScopeObservation.ModelTransport.heBindingSatisfied_of_specTypeBindingSatisfied hConj.2
  have hEquation : Spec.Match.SolutionTheory.HEAtomEquationSatisfied observer expected actual :=
    (Spec.Match.SolutionTheory.matchRel_solution_iff hSpecMatch observer).mp hHeMatched
  obtain ⟨mb, hmb⟩ := MatchSizeTheory.covered_match_of_solution hAtomsCov hEquation
  have hHeMb : Spec.Match.SolutionTheory.HEBindingSatisfied observer mb :=
    (BindingComposition.matchAtoms_solution_iff hmb observer).mpr hEquation
  have hMbShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable mb :=
    MatchSizeTheory.heAssignmentsNonVariable_of_matchAtoms hmb
  obtain ⟨out, witnessDepth, hOutWitness⟩ :=
    MatchSizeTheory.exists_mergeBindings_of_common_model hHeB bShape hHeMb hMbShape
  have hLater := DeclMatchSpec.mergeBindings_mono b mb witnessDepth depth hOutWitness
  have hStable := matchCovered_stable depth witnessDepth (.merge b mb) (hMergeCov mb hmb)
  change mergeBindings b mb (depth + witnessDepth) = mergeBindings b mb depth at hStable
  rw [Nat.add_comm witnessDepth depth, hStable] at hLater
  have hGate :
      (expected == Atom.undefinedType || expected == Atom.atomType ||
       actual == Atom.undefinedType || actual == Atom.atomType) = false := by
    simp [notUndefLeft, notAtomLeft, notUndefRight, notAtomRight]
  have hOutMem : out ∈ matchTypes expected actual b depth := by
    unfold matchTypes
    rw [if_neg (by simp [hGate])]
    exact List.mem_flatMap.mpr ⟨mb, hmb, hLater⟩
  rw [empty] at hOutMem
  exact List.not_mem_nil hOutMem

/-- Positive Selected-Candidate Finite Construction (`matchTypes_mem_to_typeMatch_finite_agreed`):
Every member `out ∈ matchTypes expected actual b depth` on a non-variable-assigned input `b`
(`Spec.Match.SolutionTheory.HEAssignmentsNonVariable b`) that admits a finite model
(`∃ valuation : String → Atom, TypeBindingSatisfied valuation out`) constructs a source
`sourceOut : Bindings` satisfying:
1. `TypeMatchingPolicy.Rel .finite expected actual b sourceOut` (both `TypeMatchRel` and finite satisfiability),
2. `BindingSourceAgreement out sourceOut` (identical solution theory and variable support), and
3. `Spec.Match.SolutionTheory.HEAssignmentsNonVariable sourceOut`. -/
theorem matchTypes_mem_to_typeMatch_finite_agreed
    {expected actual : Atom} {b out : Bindings} {depth : Nat}
    (bShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable b)
    (mem : out ∈ matchTypes expected actual b depth)
    (satisfiable : ∃ valuation : String → Atom, TypeBindingSatisfied valuation out) :
    ∃ sourceOut : Bindings,
      TypeMatchingPolicy.Rel .finite expected actual b sourceOut ∧
      BindingSourceAgreement out sourceOut ∧
      Spec.Match.SolutionTheory.HEAssignmentsNonVariable sourceOut := by
  by_cases hUndefLeft : expected = Atom.undefinedType
  · subst hUndefLeft
    have hOut : out = b := by simpa [matchTypes] using mem
    cases hOut
    exact ⟨b, ⟨.undefinedLeft actual b, satisfiable⟩, .refl b, bShape⟩
  · by_cases hAtomLeft : expected = Atom.atomType
    · subst hAtomLeft
      have hOut : out = b := by simpa [matchTypes] using mem
      cases hOut
      exact ⟨b, ⟨.atomLeft actual b, satisfiable⟩, .refl b, bShape⟩
    · by_cases hUndefRight : actual = Atom.undefinedType
      · subst hUndefRight
        have hOut : out = b := by simpa [matchTypes] using mem
        cases hOut
        exact ⟨b, ⟨.undefinedRight expected b, satisfiable⟩, .refl b, bShape⟩
      · by_cases hAtomRight : actual = Atom.atomType
        · subst hAtomRight
          have hOut : out = b := by simpa [matchTypes] using mem
          cases hOut
          exact ⟨b, ⟨.atomRight expected b, satisfiable⟩, .refl b, bShape⟩
        · have hGate :
              (expected == Atom.undefinedType || expected == Atom.atomType ||
               actual == Atom.undefinedType || actual == Atom.atomType) = false := by
            simp [hUndefLeft, hAtomLeft, hUndefRight, hAtomRight]
          unfold matchTypes at mem
          rw [if_neg (by simp [hGate])] at mem
          obtain ⟨mb, hmb, hMerged⟩ := List.mem_flatMap.mp mem
          have hNativeAgree := QueryBindingProjection.LogicalMergeBridge.native_merge_agreement hMerged
          obtain ⟨valuation, hSatOut⟩ := satisfiable
          have hConj := (bindingSatisfied_append_iff valuation b mb).mp
            ((hNativeAgree.solutions valuation).mp hSatOut)
          let observer : String → Metta.Atom :=
            fun name => Spec.Match.SolutionTheory.encodeModelAtom (valuation name)
          have hHeB : Spec.Match.SolutionTheory.HEBindingSatisfied observer b :=
            Spec.Bindings.ScopeObservation.ModelTransport.heBindingSatisfied_of_specTypeBindingSatisfied hConj.1
          have hHeMb : Spec.Match.SolutionTheory.HEBindingSatisfied observer mb :=
            Spec.Bindings.ScopeObservation.ModelTransport.heBindingSatisfied_of_specTypeBindingSatisfied hConj.2
          have hEquation : Spec.Match.SolutionTheory.HEAtomEquationSatisfied observer expected actual :=
            (BindingComposition.matchAtoms_solution_iff hmb observer).mp hHeMb
          obtain ⟨sourceMatched, hSourceMatch, hHeSourceMatched⟩ :=
            Spec.Match.Completeness.exists_specMatch_of_solution hEquation
          have matchAgreement : BindingSourceAgreement mb sourceMatched := by
            constructor
            · intro obs
              rw [Spec.Bindings.ScopeObservation.ModelTransport.specTypeBindingSatisfied_iff_heBindingSatisfied_translated,
                Spec.Bindings.ScopeObservation.ModelTransport.specTypeBindingSatisfied_iff_heBindingSatisfied_translated,
                BindingComposition.matchAtoms_solution_iff hmb,
                Spec.Match.SolutionTheory.matchRel_solution_iff hSourceMatch]
              rfl
            · intro name
              rw [FreshPrivateMerge.match_support_iff hmb name,
                QueryBindingProjection.SourceSupport.match_support hSourceMatch name]
          obtain ⟨sourceOut, hSourceMerge, hHeSourceOut, hSourceShape⟩ :=
            Spec.Match.Completeness.exists_specMerge_of_solution
              hHeB bShape hHeSourceMatched
              (Spec.Match.ModelTheory.specMatch_assignmentsNonVariable hSourceMatch)
          have hTypeMatch : TypeMatchRel expected actual b sourceOut :=
            .structural hUndefLeft hAtomLeft hUndefRight hAtomRight hSourceMatch hSourceMerge
          have hSatSourceOut : TypeBindingSatisfied valuation sourceOut :=
            (Spec.Bindings.ScopeObservation.ModelTransport.specTypeBindingSatisfied_iff_heBindingSatisfied_translated
              valuation sourceOut).mpr hHeSourceOut
          have hOutAgree : BindingSourceAgreement out sourceOut :=
            hNativeAgree.trans
              (((BindingSourceAgreement.refl b).append matchAgreement).trans
                hSourceMerge.bindingSourceAgreement.symm)
          exact ⟨sourceOut, ⟨hTypeMatch, valuation, hSatSourceOut⟩, hOutAgree, hSourceShape⟩

/-- Complete Finite `TypeCastBatchRel` Construction from `typeCastCovered`
(`typeCast_to_typeCastBatch_finite_agreed`):
Given `typeCastCovered atom expectedType space b depth lookup = true`,
`Spec.Match.SolutionTheory.HEAssignmentsNonVariable b`, a lookup proof `hLookup`, and satisfiability
of any selected hit `(atom, out) ∈ typeCast atom expectedType space b depth lookup`,
constructs a `TypeCastBatchRel` batch `nativeResults` under `TypeMatchingPolicy.Rel .finite`
aligned with `typeCast atom expectedType space b depth lookup` via `List.Forall₂`
with `BindingSourceAgreement` and `Spec.Match.SolutionTheory.HEAssignmentsNonVariable` on every output. -/
theorem typeCast_to_typeCastBatch_finite_agreed
    (space : Space) (atom expectedType : Atom) (b : Bindings) (depth : Nat)
    (lookup : TypeLookup)
    (sourceLookup : TypeLookupRel)
    (bShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable b)
    (hLookup : sourceLookup b atom expectedType (lookup b atom expectedType))
    (covered : typeCastCovered atom expectedType space b depth lookup = true)
    (selectedSatisfiable : ∀ out : Bindings,
      (atom, out) ∈ typeCast atom expectedType space b depth lookup →
      ∃ valuation : String → Atom, TypeBindingSatisfied valuation out) :
    ∃ nativeResults : ResultSet,
      TypeCastBatchRel space atom expectedType b nativeResults
        (lookup := sourceLookup) (matching := TypeMatchingPolicy.Rel .finite) ∧
      List.Forall₂ (fun w s : ResultPair => w.1 = s.1 ∧ BindingSourceAgreement w.2 s.2)
        (typeCast atom expectedType space b depth lookup)
        nativeResults ∧
      (∀ r ∈ nativeResults, Spec.Match.SolutionTheory.HEAssignmentsNonVariable r.2) := by
  exact FirstSuccessSourceReplies.typeCast_to_typeCastBatch_related
    space atom expectedType b depth lookup sourceLookup
    (TypeMatchingPolicy.Rel .finite)
    BindingSourceAgreement
    Spec.Match.SolutionTheory.HEAssignmentsNonVariable
    (.refl b)
    bShape
    hLookup
    covered
    (fun _ _ hCov hEmpty =>
      covered_matchTypes_empty_not_typeMatch_finite bShape hCov hEmpty)
    (fun _ _ out hOutMem _ hPairMem =>
      matchTypes_mem_to_typeMatch_finite_agreed bShape hOutMem (selectedSatisfiable out hPairMem))

/-- Syntactic class-value coherence of a binding record `b`:
1. `b` has no variable-valued assignments (`Spec.Match.SolutionTheory.HEAssignmentsNonVariable b`),
2. `b` has unique assignment keys (`Spec.Match.SolutionTheory.AssignmentsNodup b`), and
3. Any two assignments in the same equality class of `b` have literally equal values.
This holds for `Bindings.empty`, pure-alias records (`b.assignments = []`), equality-free
records with unique keys (`b.equalities = []`), and any record where each equality class
contains at most one distinct assigned value. -/
abbrev SyntacticallyClassCoherent (b : Bindings) : Prop :=
  Spec.Match.SolutionTheory.HEAssignmentsNonVariable b ∧
  Spec.Match.SolutionTheory.AssignmentsNodup b ∧
  ∀ k1 k2 v1 v2,
    (k1, v1) ∈ b.assignments →
    (k2, v2) ∈ b.assignments →
    k2 ∈ b.eqClass k1 →
    v1 = v2

theorem assignmentsNonVariable_of_heAssignmentsNonVariable
    {b : Bindings} (h : Spec.Match.SolutionTheory.HEAssignmentsNonVariable b) :
    Spec.Match.ModelTheory.AssignmentsNonVariable b := by
  intro key value hMem
  cases value with
  | var target => exact (h key target hMem).elim
  | symbol _ => rfl
  | grounded _ => rfl
  | expression _ => rfl

theorem evalCoherentIn_of_syntacticClassCoherent
    {target seed : Bindings}
    (valuation : String → Metta.Atom)
    (source : Spec.Match.ModelTheory.DependencyNode target)
    (included : Spec.Match.ModelTheory.BindingSubrecord seed target)
    (synCoh : ∀ k1 k2 v1 v2,
      (k1, v1) ∈ seed.assignments →
      (k2, v2) ∈ seed.assignments →
      k2 ∈ seed.eqClass k1 →
      v1 = v2) :
    Spec.Match.StructuralModel.ClassAssignmentsEvalCoherentIn target seed valuation source := by
  refine ⟨included, ?_⟩
  intro leftKey rightKey leftValue rightValue leftPresent rightPresent sameClass _inAmbient
  have sameValue := synCoh leftKey rightKey leftValue rightValue leftPresent rightPresent sameClass
  exact congrArg (fun value => Spec.Match.SolutionTheory.applyClassSolution valuation
    (Spec.Match.SolutionTheory.encodeModelAtom value)) sameValue

theorem declMerge_canonicalClassCoherent_of_syntacticClassCoherent
    {left right out : Bindings}
    (merged : DeclMergeSpec.MergeRel left right out)
    (coh : SyntacticallyClassCoherent left)
    (loopFree : Spec.Match.Merge.SemanticLoopFree out)
    (nonvariable : Spec.Match.ModelTheory.AssignmentsNonVariable out) :
    Spec.Match.ModelTheory.CanonicalClassCoherent out loopFree nonvariable := by
  apply Spec.Match.StructuralModel.canonicalClassCoherent_of_evalCoherentAt loopFree nonvariable
  intro source smaller
  exact (QueryBindingProjection.declMerge_evalCoherentAt loopFree nonvariable source smaller merged
    (Spec.Match.ModelTheory.BindingSubrecord.refl _) coh.2.1
    (evalCoherentIn_of_syntacticClassCoherent _ source
      (FreshPrivateMerge.mergeRel_left_subrecord merged) coh.2.2)).1

/-- Any `SyntacticallyClassCoherent` binding record `b` with `b.hasLoop = false`
earns a `PrincipalBindingFrame b` directly from its syntactic class coherence
and executable loop check. -/
theorem principalBindingFrame_of_syntacticClassCoherent
    {b : Bindings}
    (coh : SyntacticallyClassCoherent b)
    (noLoop : b.hasLoop = false) :
    PrincipalBindingFrame b := by
  have loopFree : Spec.Match.Merge.SemanticLoopFree b :=
    (Spec.Match.Merge.hasLoop_eq_false_iff_semanticLoopFree b).mp noLoop
  have nonvariable : Spec.Match.ModelTheory.AssignmentsNonVariable b :=
    assignmentsNonVariable_of_heAssignmentsNonVariable coh.1
  refine ⟨loopFree, nonvariable, ?_⟩
  apply Spec.Match.StructuralModel.canonicalClassCoherent_of_structurallySolved
  intro left right leftValue rightValue leftPresent rightPresent sameClass
  have hEq := coh.2.2 left right leftValue rightValue leftPresent rightPresent sameClass
  subst hEq
  exact Spec.Match.StructuralModel.AtomSolved.refl b leftValue

/-- On any `SyntacticallyClassCoherent` input `b`, every selected output
`out ∈ matchTypes expected actual b depth` with `out.hasLoop = false` earns
`PrincipalBindingFrame out` (both in the wildcard pass-through cases and in the
structural `matchAtoms` + `mergeBindings` case). -/
theorem matchTypes_mem_principal_of_loopFree
    {expected actual : Atom} {b out : Bindings} {depth : Nat}
    (coh : SyntacticallyClassCoherent b)
    (mem : out ∈ matchTypes expected actual b depth)
    (noLoop : out.hasLoop = false) :
    PrincipalBindingFrame out := by
  by_cases hUndefLeft : expected = Atom.undefinedType
  · subst hUndefLeft
    have hOut : out = b := by simpa [matchTypes] using mem
    subst hOut
    exact principalBindingFrame_of_syntacticClassCoherent coh noLoop
  · by_cases hAtomLeft : expected = Atom.atomType
    · subst hAtomLeft
      have hOut : out = b := by simpa [matchTypes] using mem
      subst hOut
      exact principalBindingFrame_of_syntacticClassCoherent coh noLoop
    · by_cases hUndefRight : actual = Atom.undefinedType
      · subst hUndefRight
        have hOut : out = b := by simpa [matchTypes] using mem
        subst hOut
        exact principalBindingFrame_of_syntacticClassCoherent coh noLoop
      · by_cases hAtomRight : actual = Atom.atomType
        · subst hAtomRight
          have hOut : out = b := by simpa [matchTypes] using mem
          subst hOut
          exact principalBindingFrame_of_syntacticClassCoherent coh noLoop
        · have hGate :
              (expected == Atom.undefinedType || expected == Atom.atomType ||
               actual == Atom.undefinedType || actual == Atom.atomType) = false := by
            simp [hUndefLeft, hAtomLeft, hUndefRight, hAtomRight]
          unfold matchTypes at mem
          rw [if_neg (by simp [hGate])] at mem
          obtain ⟨mb, hmb, hMerged⟩ := List.mem_flatMap.mp mem
          have hLoopFree : Spec.Match.Merge.SemanticLoopFree out :=
            (Spec.Match.Merge.hasLoop_eq_false_iff_semanticLoopFree out).mp noLoop
          have hNonVar : Spec.Match.ModelTheory.AssignmentsNonVariable out :=
            QueryBindingProjection.mergeBindings_assignmentsNonVariable_model hMerged
              (assignmentsNonVariable_of_heAssignmentsNonVariable coh.1)
              (QueryBindingProjection.matchAtoms_assignmentsNonVariable_model hmb)
          have hOutCoh : Spec.Match.ModelTheory.CanonicalClassCoherent out hLoopFree hNonVar :=
            declMerge_canonicalClassCoherent_of_syntacticClassCoherent
              (DeclMergeSpec.mergeBindings_sound hMerged) coh hLoopFree hNonVar
          exact ⟨hLoopFree, hNonVar, hOutCoh⟩

/-- On a `SyntacticallyClassCoherent` and satisfiable input `b`, any `out ∈ matchTypes expected actual b depth`
with `out.hasLoop = false` is satisfiable (`∃ valuation, TypeBindingSatisfied valuation out`). -/
theorem matchTypes_mem_satisfiable_of_loopFree
    {expected actual : Atom} {b out : Bindings} {depth : Nat}
    (coh : SyntacticallyClassCoherent b)
    (_bSatisfiable : ∃ valuation : String → Atom, TypeBindingSatisfied valuation b)
    (mem : out ∈ matchTypes expected actual b depth)
    (noLoop : out.hasLoop = false) :
    ∃ valuation : String → Atom, TypeBindingSatisfied valuation out :=
  (matchTypes_mem_principal_of_loopFree coh mem noLoop).model

/-- Executable Loop-Free Specialization of `typeCast_to_typeCastBatch_finite_agreed`
(`typeCast_to_typeCastBatch_finite_of_loopFree`):
On a `SyntacticallyClassCoherent` and satisfiable input `b`, `selectedSatisfiable` reduces
to the executable loop check `out.hasLoop = false` on any selected hit `(atom, out)`. -/
theorem typeCast_to_typeCastBatch_finite_of_loopFree
    (space : Space) (atom expectedType : Atom) (b : Bindings) (depth : Nat)
    (lookup : TypeLookup)
    (sourceLookup : TypeLookupRel)
    (coh : SyntacticallyClassCoherent b)
    (bSatisfiable : ∃ valuation : String → Atom, TypeBindingSatisfied valuation b)
    (hLookup : sourceLookup b atom expectedType (lookup b atom expectedType))
    (covered : typeCastCovered atom expectedType space b depth lookup = true)
    (selectedLoopFree : ∀ out : Bindings,
      (atom, out) ∈ typeCast atom expectedType space b depth lookup →
      out.hasLoop = false) :
    ∃ nativeResults : ResultSet,
      TypeCastBatchRel space atom expectedType b nativeResults
        (lookup := sourceLookup) (matching := TypeMatchingPolicy.Rel .finite) ∧
      List.Forall₂ (fun w s : ResultPair => w.1 = s.1 ∧ BindingSourceAgreement w.2 s.2)
        (typeCast atom expectedType space b depth lookup)
        nativeResults ∧
      (∀ r ∈ nativeResults, Spec.Match.SolutionTheory.HEAssignmentsNonVariable r.2) := by
  exact FirstSuccessSourceReplies.typeCast_to_typeCastBatch_related
    space atom expectedType b depth lookup sourceLookup
    (TypeMatchingPolicy.Rel .finite)
    BindingSourceAgreement
    Spec.Match.SolutionTheory.HEAssignmentsNonVariable
    (.refl b)
    coh.1
    hLookup
    covered
    (fun _ _ hCov hEmpty =>
      covered_matchTypes_empty_not_typeMatch_finite coh.1 hCov hEmpty)
    (fun _ _ out hOutMem _ hPairMem =>
      matchTypes_mem_to_typeMatch_finite_agreed coh.1 hOutMem
        (matchTypes_mem_satisfiable_of_loopFree coh bSatisfiable hOutMem
          (selectedLoopFree out hPairMem)))

/-- Scoped Worker Symbol-Cast Bridge under Covered Selected Models
(`scoped_worker_symbol_cast_of_covered_selected_models`):
Discharges the `nativeBatch` premise of `scoped_worker_symbol_cast_enabling_bridge` from
`typeCastCovered`, ` Spec.Match.SolutionTheory.HEAssignmentsNonVariable bindings`, and `selectedSatisfiable`
(requiring any selected hit `(.symbol operator, out)` to admit a finite model).
Note: `typeCastCovered = true` alone does not guarantee that a selected raw hit has a finite model
(see `separation_cyclic_merge_certified_covered_not_finite`); `nativeShape` and `selectedSatisfiable`
explicitly restrict the theorem's domain. -/
theorem scoped_worker_symbol_cast_of_covered_selected_models
    (state : Configuration) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator : String) (expected : Atom) (bindings : Bindings)
    (depth : Nat) (live : List Atom) (scope : List String)
    (before : Completed.Frame)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result)
    (pending : state.control = .work (.atom (.symbol operator) expected bindings (depth + 1) live))
    (clean : operator ≠ "Empty")
    (notAtom : expected ≠ Atom.atomType)
    (notSymbol : expected ≠ Atom.symbolType)
    (agreed : BindingSourceAgreement bindings before.bindings)
    (nativeShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable bindings)
    (sourceShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable before.bindings)
    (retained : ∀ name ∈ scope, name ∈ RecursiveScope.configurationNames state)
    (finite : policy.matching = .finite)
    (covered : typeCastCovered (.symbol operator) expected state.space bindings depth
      (invocationTypes state) = true)
    (selectedSatisfiable : ∀ out : Bindings,
      (.symbol operator, out) ∈
        typeCast (.symbol operator) expected state.space bindings depth (invocationTypes state) →
      ∃ valuation : String → Atom, TypeBindingSatisfied valuation out) :
    let workerOut := typeCast (.symbol operator) expected state.space bindings depth
      (invocationTypes state)
    (∀ callerScope : List String, BindingTheoryEquivAt callerScope bindings before.bindings) ∧
    Checked.blocked dispatch state scopedTypes = none ∧
    (Checked.machine dispatch scopedTypes).step state =
      some (.silent { state with control := .returning workerOut }) ∧
    (∀ extra : Nat,
      typeCast (.symbol operator) expected state.space bindings (depth + extra)
        (invocationTypes (state.deepen extra)) = workerOut) ∧
    ∃ sourceResults : ResultSet,
    ∃ ctxResults : List Completed.Result,
      TypeCastBatchRel state.space (.symbol operator) expected before.bindings sourceResults
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
        (matching := policy.matching.Rel) ∧
      ctxResults.map Completed.rawResult = sourceResults ∧
      (∀ r ∈ ctxResults,
        (∃ table, ReadoutCertificate r.2.bindings table) ∧
        Spec.Match.SolutionTheory.HEAssignmentsNonVariable r.2.bindings) ∧
      List.Forall₂
        (fun (w : ResultPair) (s : ResultPair) =>
          w.1 = s.1 ∧ BindingSourceAgreement w.2 s.2)
        workerOut sourceResults ∧
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧
          BindingSourceAgreement w.2 c.2.bindings ∧
          (∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings) ∧
          (∀ callerScope : List String,
            observedTuples w.2 (callerScope.map Atom.var ++ [w.1]) =
              RecursiveExecution.Contextual.Protocol.resultTheory callerScope c))
        workerOut ctxResults ∧
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
          before (.symbol operator) expected)
        sourceResults ctxResults ∧
      Completed.AtomRel state.space hostDispatch Completed.scopedLookup
        live scope (.symbol operator) expected before ctxResults (policy := policy) ∧
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch
        Completed.scopedLookup policy
        (.work (.atom live scope (.symbol operator) expected before), ctxStack)
        (.returning ctxResults, ctxStack) ∧
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
        ⟨state.space, .work (.atom live scope (.symbol operator) expected before), ctxStack, ctxEmitted⟩
        ⟨state.space, .returning ctxResults, ctxStack, ctxEmitted⟩ := by
  dsimp only
  let workerOut := typeCast (.symbol operator) expected state.space bindings depth
    (invocationTypes state)
  have inEquiv : ∀ callerScope : List String,
      BindingTheoryEquivAt callerScope bindings before.bindings :=
    fun callerScope => agreed.theoryEquivAt callerScope
  obtain ⟨unblocked, stepped⟩ := scoped_worker_symbol_cast_step
    state dispatch operator expected bindings depth live pending clean notAtom notSymbol covered
  have hSelfLookup :
      Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected bindings)
        state.space bindings (.symbol operator) expected
        (invocationTypes state bindings (.symbol operator) expected) :=
    scopedLookup_of_invocationTypes_self state (.symbol operator) expected
      bindings (depth + 1) live scope pending retained
  obtain ⟨nativeResults, nativeBatch, workerNativeAgreed, _⟩ :=
    typeCast_to_typeCastBatch_finite_agreed state.space (.symbol operator) expected
      bindings depth (invocationTypes state)
      (Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected bindings) state.space)
      nativeShape hSelfLookup covered selectedSatisfiable
  have scopeInc :
      ∀ name ∈ invocationTypeScope scope live (.symbol operator) expected before.bindings,
        name ∈ invocationTypeScope scope live (.symbol operator) expected bindings :=
    invocationTypeScope_included_of_agreement scope live (.symbol operator) expected agreed
  obtain ⟨sourceResults, sourceBatchFinite, nativeSourceAgreed, outShapes⟩ :=
    agreed.typeCastBatch_scoped_finite nativeShape sourceShape scopeInc nativeBatch
  have outAgreed :
      List.Forall₂
        (fun (w : ResultPair) (s : ResultPair) =>
          w.1 = s.1 ∧ BindingSourceAgreement w.2 s.2)
        workerOut sourceResults := by
    change List.Forall₂ _
      (typeCast (.symbol operator) expected state.space bindings depth (invocationTypes state))
      sourceResults
    clear *- workerNativeAgreed nativeSourceAgreed
    generalize (typeCast (.symbol operator) expected state.space bindings depth (invocationTypes state)) = wList at workerNativeAgreed ⊢
    induction workerNativeAgreed generalizing sourceResults with
    | nil =>
        cases nativeSourceAgreed
        exact .nil
    | @cons w n wRest nRest hWN _ ih =>
        cases nativeSourceAgreed with
        | @cons _ s _ sRest hNS hTail =>
            exact .cons ⟨hWN.1.trans hNS.1, hWN.2.trans hNS.2⟩ (ih sRest hTail)
  have sourceBatch :
      TypeCastBatchRel state.space (.symbol operator) expected before.bindings sourceResults
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
        (matching := policy.matching.Rel) := by
    rw [← finite] at sourceBatchFinite
    exact sourceBatchFinite
  have readSym : before.read policy (.symbol operator) = .symbol operator := by
    cases hRebuild : policy.rebuilding <;>
      simp [Completed.Frame.read, Entry.Value.substitute, hRebuild]
  have entryCast :
      Entry.Rel policy.reentry (before.read policy (.symbol operator)).status
        (before.read policy (.symbol operator)).erase expected .cast := by
    simp only [readSym, Entry.Value.status, Entry.Value.erase]
    exact Spec.Eval.Entry.Rel.cast (policy := policy.reentry) (status := .active)
      (by simpa [IsEmptyOrErrorRel, IsErrorRel, Atom.empty] using clean)
      (.symbol operator)
      (by
        rintro (hAtom | hSym | hVar)
        · exact notAtom hAtom
        · exact notSymbol hSym
        · exact absurd hVar (by decide))
      (Or.inl ⟨operator, rfl⟩)
      (fun _ => Or.inr rfl)
  obtain ⟨ctxResults, paired⟩ :=
    Completed.CastResultRel.lift_finite_batch
      (space := state.space) (policy := policy)
      (lookup := Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
      (before := before) (original := .symbol operator) (expected := expected)
      (raw := sourceResults) finite (by simpa [Entry.Value.erase] using sourceBatch)
  have readouts := Completed.CastResultRel.readouts paired
  have pairedRead :
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope live
              (before.read policy (.symbol operator)).erase expected before.bindings) state.space)
          before (before.read policy (.symbol operator)) expected)
        sourceResults ctxResults := by
    simpa only [readSym, Entry.Value.erase] using paired
  have batchRead :
      TypeCastBatchRel state.space (before.read policy (.symbol operator)).erase
        expected before.bindings sourceResults
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live
            (before.read policy (.symbol operator)).erase expected before.bindings) state.space)
        (matching := policy.matching.Rel) := by
    simpa only [readSym, Entry.Value.erase] using sourceBatch
  have atomRel :
      Completed.AtomRel state.space hostDispatch Completed.scopedLookup
        live scope (.symbol operator) expected before ctxResults (policy := policy) :=
    Completed.AtomRel.cast entryCast batchRead pairedRead
  have localStep :
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch
        Completed.scopedLookup policy
        (.work (.atom live scope (.symbol operator) expected before), ctxStack)
        (.returning ctxResults, ctxStack) :=
    RecursiveMachine.Contextual.LocalStep.cast entryCast batchRead pairedRead
  have steps :
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
        ⟨state.space, .work (.atom live scope (.symbol operator) expected before), ctxStack, ctxEmitted⟩
        ⟨state.space, .returning ctxResults, ctxStack, ctxEmitted⟩ :=
    Relation.ReflTransGen.single (RecursiveMachine.Contextual.Step.internal localStep)
  have outMap :
      List.Forall₂
        (fun (w : ResultPair) (s : ResultPair) =>
          w.1 = s.1 ∧ BindingSourceAgreement w.2 s.2)
        workerOut (ctxResults.map Completed.rawResult) := by
    rw [readouts]
    exact outAgreed
  have rawPaired := List.forall₂_map_right_iff.mp outMap
  have workerCtxAligned :
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧
          BindingSourceAgreement w.2 c.2.bindings ∧
          (∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings) ∧
          (∀ callerScope : List String,
            observedTuples w.2 (callerScope.map Atom.var ++ [w.1]) =
              RecursiveExecution.Contextual.Protocol.resultTheory callerScope c))
        workerOut ctxResults := by
    refine rawPaired.imp ?_
    rintro ⟨wAtom, wBind⟩ ⟨cVal, cFrame⟩ ⟨hAtom, hAgree⟩
    dsimp [Completed.rawResult] at hAtom hAgree
    refine ⟨hAtom, hAgree, fun callerScope => hAgree.theoryEquivAt callerScope, fun callerScope => ?_⟩
    rw [hAtom]
    exact (hAgree.theoryEquivAt
      (TypeSubst.typeVarsList (callerScope.map Atom.var ++ [cVal.erase]))).observedTuples_eq
      (callerScope.map Atom.var ++ [cVal.erase]) (fun _ h => h)
  refine ⟨inEquiv, unblocked, stepped, ?_, sourceResults, ctxResults, sourceBatch, readouts,
    ?_, outAgreed, workerCtxAligned, paired, atomRel, localStep, steps⟩
  · intro extra
    rw [invocationTypes_deepen]
    exact typeCastCovered_stable (.symbol operator) expected state.space bindings depth extra covered
  · intro r hMem
    refine ⟨⟨Entry.Value.eraseEnvironment r.2.environment, r.2.certified⟩, ?_⟩
    have hRawMem : Completed.rawResult r ∈ sourceResults := by
      rw [← readouts]
      exact List.mem_map_of_mem hMem
    exact outShapes (Completed.rawResult r) hRawMem

/-- Executable Loop-Free Scoped Worker Symbol-Cast Bridge
(`scoped_worker_symbol_cast_of_covered_selected_loopFree`):
On a `SyntacticallyClassCoherent` worker input `bindings` aligned via `BindingSourceAgreement`
with `before : Completed.Frame`, `before.certified.satisfiable` supplies the input model for `bindings`
and `selectedLoopFree` (`out.hasLoop = false` on any selected hit `(.symbol operator, out)`)
discharges `selectedSatisfiable` via `matchTypes_mem_satisfiable_of_loopFree`.
Note: `coh : SyntacticallyClassCoherent bindings` and `selectedLoopFree` remain explicit domain
restrictions because `typeCastCovered = true` alone can admit cyclic selected records
(see `separation_cyclic_merge_certified_covered_not_finite`). -/
theorem scoped_worker_symbol_cast_of_covered_selected_loopFree
    (state : Configuration) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator : String) (expected : Atom) (bindings : Bindings)
    (depth : Nat) (live : List Atom) (scope : List String)
    (before : Completed.Frame)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result)
    (pending : state.control = .work (.atom (.symbol operator) expected bindings (depth + 1) live))
    (clean : operator ≠ "Empty")
    (notAtom : expected ≠ Atom.atomType)
    (notSymbol : expected ≠ Atom.symbolType)
    (agreed : BindingSourceAgreement bindings before.bindings)
    (coh : SyntacticallyClassCoherent bindings)
    (sourceShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable before.bindings)
    (retained : ∀ name ∈ scope, name ∈ RecursiveScope.configurationNames state)
    (finite : policy.matching = .finite)
    (covered : typeCastCovered (.symbol operator) expected state.space bindings depth
      (invocationTypes state) = true)
    (selectedLoopFree : ∀ out : Bindings,
      (.symbol operator, out) ∈
        typeCast (.symbol operator) expected state.space bindings depth (invocationTypes state) →
      out.hasLoop = false) :
    let workerOut := typeCast (.symbol operator) expected state.space bindings depth
      (invocationTypes state)
    (∀ callerScope : List String, BindingTheoryEquivAt callerScope bindings before.bindings) ∧
    Checked.blocked dispatch state scopedTypes = none ∧
    (Checked.machine dispatch scopedTypes).step state =
      some (.silent { state with control := .returning workerOut }) ∧
    (∀ extra : Nat,
      typeCast (.symbol operator) expected state.space bindings (depth + extra)
        (invocationTypes (state.deepen extra)) = workerOut) ∧
    ∃ sourceResults : ResultSet,
    ∃ ctxResults : List Completed.Result,
      TypeCastBatchRel state.space (.symbol operator) expected before.bindings sourceResults
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
        (matching := policy.matching.Rel) ∧
      ctxResults.map Completed.rawResult = sourceResults ∧
      (∀ r ∈ ctxResults,
        (∃ table, ReadoutCertificate r.2.bindings table) ∧
        Spec.Match.SolutionTheory.HEAssignmentsNonVariable r.2.bindings) ∧
      List.Forall₂
        (fun (w : ResultPair) (s : ResultPair) =>
          w.1 = s.1 ∧ BindingSourceAgreement w.2 s.2)
        workerOut sourceResults ∧
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧
          BindingSourceAgreement w.2 c.2.bindings ∧
          (∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings) ∧
          (∀ callerScope : List String,
            observedTuples w.2 (callerScope.map Atom.var ++ [w.1]) =
              RecursiveExecution.Contextual.Protocol.resultTheory callerScope c))
        workerOut ctxResults ∧
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
          before (.symbol operator) expected)
        sourceResults ctxResults ∧
      Completed.AtomRel state.space hostDispatch Completed.scopedLookup
        live scope (.symbol operator) expected before ctxResults (policy := policy) ∧
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch
        Completed.scopedLookup policy
        (.work (.atom live scope (.symbol operator) expected before), ctxStack)
        (.returning ctxResults, ctxStack) ∧
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
        ⟨state.space, .work (.atom live scope (.symbol operator) expected before), ctxStack, ctxEmitted⟩
        ⟨state.space, .returning ctxResults, ctxStack, ctxEmitted⟩ := by
  have bSatisfiable : ∃ valuation : String → Atom, TypeBindingSatisfied valuation bindings := by
    obtain ⟨v0, hSatBefore⟩ := before.certified.satisfiable
    exact ⟨v0, (agreed.solutions v0).mpr hSatBefore⟩
  have hSelfLookup :
      Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected bindings)
        state.space bindings (.symbol operator) expected
        (invocationTypes state bindings (.symbol operator) expected) :=
    scopedLookup_of_invocationTypes_self state (.symbol operator) expected
      bindings (depth + 1) live scope pending retained
  obtain ⟨nativeResults, nativeBatch, workerNativeAgreed, _⟩ :=
    typeCast_to_typeCastBatch_finite_of_loopFree state.space (.symbol operator) expected
      bindings depth (invocationTypes state)
      (Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected bindings) state.space)
      coh bSatisfiable hSelfLookup covered selectedLoopFree
  exact scoped_worker_symbol_cast_of_covered_selected_models
    state dispatch hostDispatch policy operator expected bindings depth live scope
    before ctxStack ctxEmitted pending clean notAtom notSymbol
    agreed coh.1 sourceShape retained finite covered
    (fun out hPairMem => by
      have hEx : ∃ s ∈ nativeResults, s.1 = .symbol operator ∧ BindingSourceAgreement out s.2 := by
        clear *- workerNativeAgreed hPairMem
        generalize (typeCast (.symbol operator) expected state.space bindings depth (invocationTypes state)) = wList at workerNativeAgreed hPairMem
        induction workerNativeAgreed with
        | nil => cases hPairMem
        | @cons w s wRest sRest hWS hTail ih =>
            rcases List.mem_cons.mp hPairMem with rfl | hMemRest
            · exact ⟨s, List.mem_cons_self, hWS.1.symm, hWS.2⟩
            · obtain ⟨s', hMem', hFst, hAg⟩ := ih hMemRest
              exact ⟨s', List.mem_cons_of_mem s hMem', hFst, hAg⟩
      obtain ⟨⟨sAtom, sBind⟩, hSMem, hSFst, hSAg⟩ := hEx
      dsimp only at hSFst hSAg
      subst hSFst
      cases nativeBatch with
      | success _ _ _ hFinMatch =>
          simp only [List.mem_singleton, Prod.mk.injEq] at hSMem
          obtain ⟨_, rfl⟩ := hSMem
          obtain ⟨v, hSatS⟩ := hFinMatch.2
          exact ⟨v, (hSAg.solutions v).mpr hSatS⟩
      | failure _ _ =>
          obtain ⟨actual, _, hErrEq⟩ := List.mem_map.mp hSMem
          have hNo : mkError (.symbol operator) (.badType expected actual) ≠ .symbol operator := by
            simp [mkError, Atom.error]
          exact (hNo (Prod.mk.inj hErrEq).1).elim)

/-- Universal Schematic Variable-Expected Symbol Cast Local Square
(`scoped_fresh_symbol_cast_local_square`):
At any configuration `state` (with arbitrary retained `state.stack` and `state.emitted`),
casting `.symbol subject` against a schematic variable `.var expected` under open certified
caller bindings `native` / `before` and `getAtomTypes state.space (.symbol subject) = [.symbol actual]`:
1. Executes `invocationTypes state`, `matchTypes`, `typeCast`, and `typeCastCovered` with no
   assumed `TypeCastBatchRel` or `models` premise,
2. Advances `(Checked.machine dispatch scopedTypes).step state` (and `state.deepen extra`) in 1
   checked step to `.returning [(.symbol subject, native.assign expected (.symbol actual))]`,
   preserving arbitrary `state.stack` and `state.emitted`,
3. Earns the renewed `ReadoutCertificate (before.bindings.assign expected (.symbol actual)) (table.bind expected (.symbol actual))`
   and `SourceBindingComparison.semantic.FrameRelated`,
4. Derives the contextual `Completed.Frame` (`after`), `Completed.CastResultRel`,
   `Completed.AtomRel`, and `RecursiveMachine.Contextual.LocalStep.cast` / `Steps` under
   `Completed.scopedLookup`, with `BindingTheoryEquivAt callerScope` on every `callerScope`. -/
theorem scoped_fresh_symbol_cast_local_square
    (state : Configuration) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch)
    (subject expected actual : String)
    (native : Bindings) (before : Completed.Frame)
    (depth : Nat) (live : List Atom) (scope : List String)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result)
    (pending : state.control = .work (.atom (.symbol subject) (.var expected) native (depth + 3) live))
    (clean : subject ≠ "Empty")
    (notUndefined : actual ≠ "%Undefined%") (notAtom : actual ≠ "Atom")
    (declared : getAtomTypes state.space (.symbol subject) = [.symbol actual])
    (related : SourceBindingComparison.semantic.FrameRelated native before.source)
    (fresh : expected ∉ specBindingVars native) :
    let table := Entry.Value.eraseEnvironment before.environment
    let workerOut : ResultSet := [(.symbol subject, native.assign expected (.symbol actual))]
    let sourceOut : ResultSet := [(.symbol subject, before.bindings.assign expected (.symbol actual))]
    invocationTypes state native (.symbol subject) (.var expected) = [.symbol actual] ∧
    typeCast (.symbol subject) (.var expected) state.space native (depth + 2)
      (invocationTypes state) = workerOut ∧
    typeCastCovered (.symbol subject) (.var expected) state.space native (depth + 2)
      (invocationTypes state) = true ∧
    (Checked.machine dispatch scopedTypes).step state =
      some (.silent { state with control := .returning workerOut }) ∧
    (∀ extra : Nat,
      (Checked.machine dispatch scopedTypes).step (state.deepen extra) =
        some (.silent { (state.deepen extra) with control := .returning workerOut })) ∧
    (∃ nextCertificate : ReadoutCertificate (before.bindings.assign expected (.symbol actual))
        (table.bind expected (.symbol actual)),
      SourceBindingComparison.semantic.FrameRelated
        (native.assign expected (.symbol actual))
        (.selected (before.bindings.assign expected (.symbol actual))
          (table.bind expected (.symbol actual)) nextCertificate) ∧
      BindingFrame.Update .renew before.source
        (.selected (before.bindings.assign expected (.symbol actual))
          (table.bind expected (.symbol actual)) nextCertificate) ∧
      ∀ pendingAtoms : List Atom,
        (pendingAtoms.map table.apply).map (table.bind expected (.symbol actual)).apply =
          pendingAtoms.map (table.bind expected (.symbol actual)).apply) ∧
    ∃ after : Completed.Frame,
      after.bindings = before.bindings.assign expected (.symbol actual) ∧
      (∀ callerScope : List String,
        BindingTheoryEquivAt callerScope
          (native.assign expected (.symbol actual)) after.bindings) ∧
      List.Forall₂
        (Completed.CastResultRel .unmarked
          (Completed.scopedLookup
            (invocationTypeScope scope live (.symbol subject) (.var expected) before.bindings) state.space)
          before (.symbol subject) (.var expected))
        sourceOut [(.symbol subject, after)] ∧
      Completed.AtomRel state.space hostDispatch Completed.scopedLookup
        live scope (.symbol subject) (.var expected) before [(.symbol subject, after)] ∧
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch
        Completed.scopedLookup .unmarked
        (.work (.atom live scope (.symbol subject) (.var expected) before), ctxStack)
        (.returning [(.symbol subject, after)], ctxStack) ∧
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup .unmarked
        ⟨state.space, .work (.atom live scope (.symbol subject) (.var expected) before), ctxStack, ctxEmitted⟩
        ⟨state.space, .returning [(.symbol subject, after)], ctxStack, ctxEmitted⟩ := by
  dsimp only
  have varNotAtom : (Atom.var expected) ≠ Atom.atomType := by intro h; cases h
  have varNotSym : (Atom.var expected) ≠ Atom.symbolType := by intro h; cases h
  have queried : invocationTypes state native (.symbol subject) (.var expected) = [.symbol actual] := by
    unfold invocationTypes getAtomTypesScoped
    rw [declared]
    simp [instantiateTypeSignatures, instantiateTypeSignature, renameAtom]
  have freshClass : native.classValues expected = [] := by
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro val member
    exact fresh (FreshPrivateMerge.class_key_support member)
  have castEq := fresh_symbol_typeCast_eq (.symbol subject) state.space native
    expected actual depth (invocationTypes state) notUndefined notAtom freshClass queried
  have castCov := fresh_symbol_typeCastCovered (.symbol subject) state.space native
    expected actual depth (invocationTypes state) freshClass queried
  have stepped := (scoped_worker_symbol_cast_step state dispatch subject (.var expected)
    native (depth + 2) live pending clean
    varNotAtom varNotSym castCov).2
  rw [castEq] at stepped
  have frameRenewal := FirstSuccessSourceExecution.scoped_type_assignment_frame
    before.certified related expected actual fresh
  obtain ⟨nextCertificate, nextRelated, renewal, absorbed⟩ := frameRenewal
  have sourceFreshClass : before.bindings.classValues expected = [] := by
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro val member
    have sourceFresh : expected ∉ specBindingVars before.bindings :=
      fun mem => fresh ((related.related.support expected).mpr mem)
    exact sourceFresh (FreshPrivateMerge.class_key_support member)
  have scopedLookuprel :
      Completed.scopedLookup
        (invocationTypeScope scope live (.symbol subject) (.var expected) before.bindings)
        state.space before.bindings (.symbol subject) (.var expected) [.symbol actual] := by
    refine ⟨[.symbol actual], ?_, .cons ?_ (.nil _)⟩
    · rw [← declared]
      exact FirstSuccessSourceReplies.source_types _ _
    · exact ⟨id, Function.injective_id, by simp, by simp [TypeSubst.typeVars]⟩
  have typeMatch :
      TypeMatchRel (.var expected) (.symbol actual) before.bindings
        (before.bindings.assign expected (.symbol actual)) :=
    FirstSuccessSourceApplicability.independent_fresh_symbol_type_match
      expected actual before.bindings notUndefined notAtom sourceFreshClass
  have batch :
      TypeCastBatchRel state.space (.symbol subject) (.var expected) before.bindings
        [(.symbol subject, before.bindings.assign expected (.symbol actual))]
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live (.symbol subject) (.var expected) before.bindings) state.space)
        (matching := Policy.unmarked.matching.Rel) := by
    exact TypeCastBatchRel.success (earlierTypes := []) (laterTypes := [])
      scopedLookuprel rfl (by simp) typeMatch
  have models :
      ∀ result ∈ ([(.symbol subject, before.bindings.assign expected (.symbol actual))] : ResultSet),
        ∃ valuation : String → Atom, TypeBindingSatisfied valuation result.2 := by
    intro result member
    obtain rfl := List.mem_singleton.mp member
    exact nextCertificate.satisfiable
  have outRel :
      List.Forall₂
        (fun w s : ResultPair =>
          w.1 = s.1 ∧ ∀ callerScope : List String, BindingTheoryEquivAt callerScope w.2 s.2)
        (typeCast (.symbol subject) (.var expected) state.space native (depth + 2) (invocationTypes state))
        [(.symbol subject, before.bindings.assign expected (.symbol actual))] := by
    rw [castEq]
    exact .cons ⟨rfl, fun callerScope => nextRelated.related.theoryEquivAt callerScope⟩ .nil
  have square := scoped_worker_symbol_cast_of_modelled_source_batch
    state dispatch hostDispatch .unmarked subject (.var expected) native (depth + 2)
    live scope before ctxStack ctxEmitted pending clean
    varNotAtom varNotSym related castCov
    [(.symbol subject, before.bindings.assign expected (.symbol actual))] batch models outRel
  obtain ⟨_, _, _, _, ctxResults, _, _, _, paired, atomRel, localStep, steps⟩ := square
  refine ⟨queried, castEq, castCov, stepped, ?_, ⟨nextCertificate, nextRelated, renewal, absorbed⟩, ?_⟩
  · intro extra
    have pendingExtra :
        (state.deepen extra).control =
          .work (.atom (.symbol subject) (.var expected) native ((depth + extra) + 2 + 1) live) := by
      rcases state with ⟨sp, ctrl, stk, em⟩
      dsimp only at pending
      subst pending
      simp only [Configuration.deepen, Control.deepen, Task.replenish]
      congr 2
      omega
    have queriedExtra :
        invocationTypes (state.deepen extra) native (.symbol subject) (.var expected) =
          [.symbol actual] := by
      rw [invocationTypes_deepen]
      exact queried
    have castEqExtra := fresh_symbol_typeCast_eq (.symbol subject) (state.deepen extra).space native
      expected actual (depth + extra) (invocationTypes (state.deepen extra))
      notUndefined notAtom freshClass queriedExtra
    have castCovExtra := fresh_symbol_typeCastCovered (.symbol subject) (state.deepen extra).space native
      expected actual (depth + extra) (invocationTypes (state.deepen extra))
      freshClass queriedExtra
    have stepExtra := (scoped_worker_symbol_cast_step (state.deepen extra) dispatch subject (.var expected)
      native ((depth + extra) + 2) live pendingExtra clean varNotAtom varNotSym castCovExtra).2
    rw [castEqExtra] at stepExtra
    exact stepExtra
  · cases paired with
    | @cons _ afterResult _ ctxTail headRel tailRel =>
      cases tailRel
      rcases afterResult with ⟨val, afterFrame⟩
      have hVal : val = .symbol subject := by
        have hPay := headRel.payload
        simp [Entry.Value.erase] at hPay
        exact hPay
      subst hVal
      have hBind : afterFrame.bindings = before.bindings.assign expected (.symbol actual) := by
        have hRead := headRel.readout
        simp [Completed.rawResult, Entry.Value.erase] at hRead
        exact hRead.symm
      refine ⟨afterFrame, hBind, ?_, .cons headRel .nil, atomRel, localStep, steps⟩
      intro callerScope
      rw [hBind]
      exact nextRelated.related.theoryEquivAt callerScope

/-- Universal Schematic Arrow Head-Cast Local Square
(`scoped_fresh_arrow_head_cast_local_square`):
At any configuration `state` (with arbitrary retained `state.stack` and `state.emitted`),
casting `.symbol operator` against `(-> $left $left)` under open certified caller bindings
`native.assign left (.symbol actual)` / `before` (with `before.bindings = source.assign left (.symbol actual)`)
when `getAtomTypes state.space (.symbol operator) = [.expression [.symbol "->", .var parameter, .var parameter]]`:
1. Computes the worker's scoped fresh instance `right := instanceName ...` and discharges
   `invocationTypes state ... = [.expression [.symbol "->", .var right, .var right]]`,
   `Completed.scopedLookup`, `left ≠ right`, and all freshness premises for `right` directly
   from the retained configuration and `declared`,
2. Executes `matchTypes`, `typeCast`, and `typeCastCovered` with no assumed `TypeCastBatchRel` or `models` premise,
3. Advances `(Checked.machine dispatch scopedTypes).step state` (and `state.deepen extra`) in 1
   checked step to `.returning [(.symbol operator, ((native.assign left (.symbol actual)).addEquality left right).addEquality left right)]`,
   preserving arbitrary `state.stack` and `state.emitted`,
4. Earns the renewed `ReadoutCertificate ((source.assign left (.symbol actual)).addEquality left right) (table.bind right (.symbol actual))`
   and `SourceBindingComparison.semantic.FrameRelated`,
5. Derives the contextual `Completed.Frame` (`after`), `Completed.CastResultRel`,
   `Completed.AtomRel`, and `RecursiveMachine.Contextual.LocalStep.cast` / `Steps` under
   `Completed.scopedLookup`, with `BindingTheoryEquivAt callerScope` on every `callerScope`. -/
theorem scoped_fresh_arrow_head_cast_local_square
    (state : Configuration) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch)
    (operator parameter left actual : String)
    (native source : Bindings) (before : Completed.Frame)
    (depth : Nat) (live : List Atom) (scope : List String)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result)
    (pending : state.control = .work (.atom (.symbol operator)
      (.expression [.symbol "->", .var left, .var left])
      (native.assign left (.symbol actual)) (depth + 8) live))
    (clean : operator ≠ "Empty")
    (declared : getAtomTypes state.space (.symbol operator) =
      [.expression [.symbol "->", .var parameter, .var parameter]])
    (beforeBindings : before.bindings = source.assign left (.symbol actual))
    (related : SourceBindingComparison.semantic.FrameRelated
      (native.assign left (.symbol actual)) before.source)
    (leftFresh : left ∉ native.names)
    (leftFreshSource : left ∉ source.names)
    (retained : ∀ name ∈ scope, name ∈ RecursiveScope.configurationNames state) :
    let expected := Atom.expression [.symbol "->", .var left, .var left]
    let avoid := RecursiveScope.configurationNames state ++
      (native.assign left (.symbol actual)).names ++
      atomVariables (.symbol operator) ++ atomVariables expected
    let right := instanceName avoid [parameter] 0 parameter
    let table := Entry.Value.eraseEnvironment before.environment
    let nativeOut := ((native.assign left (.symbol actual)).addEquality left right).addEquality left right
    let sourceOut := (source.assign left (.symbol actual)).addEquality left right
    let workerOut : ResultSet := [(.symbol operator, nativeOut)]
    invocationTypes state (native.assign left (.symbol actual)) (.symbol operator) expected =
      [.expression [.symbol "->", .var right, .var right]] ∧
    Completed.scopedLookup
      (invocationTypeScope scope live (.symbol operator) expected before.bindings)
      state.space before.bindings (.symbol operator) expected
      [.expression [.symbol "->", .var right, .var right]] ∧
    right ∉ RecursiveScope.configurationNames state ∧
    right ∉ (native.assign left (.symbol actual)).names ∧
    left ≠ right ∧
    typeCast (.symbol operator) expected state.space (native.assign left (.symbol actual))
      (depth + 7) (invocationTypes state) = workerOut ∧
    typeCastCovered (.symbol operator) expected state.space (native.assign left (.symbol actual))
      (depth + 7) (invocationTypes state) = true ∧
    (Checked.machine dispatch scopedTypes).step state =
      some (.silent { state with control := .returning workerOut }) ∧
    (∀ extra : Nat,
      (Checked.machine dispatch scopedTypes).step (state.deepen extra) =
        some (.silent { (state.deepen extra) with control := .returning workerOut })) ∧
    (∃ nextCertificate : ReadoutCertificate sourceOut (table.bind right (.symbol actual)),
      SourceBindingComparison.semantic.FrameRelated nativeOut
        (.selected sourceOut (table.bind right (.symbol actual)) nextCertificate) ∧
      BindingFrame.Update .renew
        (.selected (source.assign left (.symbol actual)) table (beforeBindings ▸ before.certified))
        (.selected sourceOut (table.bind right (.symbol actual)) nextCertificate) ∧
      ∀ pendingAtoms : List Atom,
        (pendingAtoms.map table.apply).map (table.bind right (.symbol actual)).apply =
          pendingAtoms.map (table.bind right (.symbol actual)).apply) ∧
    ∃ after : Completed.Frame,
      after.bindings = sourceOut ∧
      (∀ callerScope : List String,
        BindingTheoryEquivAt callerScope nativeOut after.bindings) ∧
      List.Forall₂
        (Completed.CastResultRel .unmarked
          (Completed.scopedLookup
            (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
          before (.symbol operator) expected)
        [(.symbol operator, sourceOut)] [(.symbol operator, after)] ∧
      Completed.AtomRel state.space hostDispatch Completed.scopedLookup
        live scope (.symbol operator) expected before [(.symbol operator, after)] ∧
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch
        Completed.scopedLookup .unmarked
        (.work (.atom live scope (.symbol operator) expected before), ctxStack)
        (.returning [(.symbol operator, after)], ctxStack) ∧
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup .unmarked
        ⟨state.space, .work (.atom live scope (.symbol operator) expected before), ctxStack, ctxEmitted⟩
        ⟨state.space, .returning [(.symbol operator, after)], ctxStack, ctxEmitted⟩ := by
  dsimp only
  let expected := Atom.expression [.symbol "->", .var left, .var left]
  let avoid := RecursiveScope.configurationNames state ++
    (native.assign left (.symbol actual)).names ++
    atomVariables (.symbol operator) ++ atomVariables expected
  let right := instanceName avoid [parameter] 0 parameter
  let nativeOut := ((native.assign left (.symbol actual)).addEquality left right).addEquality left right
  let sourceOut := (source.assign left (.symbol actual)).addEquality left right
  have expNotAtom : expected ≠ Atom.atomType := by intro h; dsimp [expected, Atom.atomType] at h; cases h
  have expNotSym : expected ≠ Atom.symbolType := by intro h; dsimp [expected, Atom.symbolType] at h; cases h
  have queried : invocationTypes state (native.assign left (.symbol actual)) (.symbol operator) expected =
      [.expression [.symbol "->", .var right, .var right]] := by
    simp [invocationTypes, getAtomTypesScoped, declared, instantiateTypeSignatures,
      instantiateTypeSignature, atomVariables, atomListVariables, renameAtom, renameAtomList,
      List.eraseDups_cons, avoid, right, expected]
  have scopedLookupRel :
      Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected before.bindings)
        state.space before.bindings (.symbol operator) expected
        [.expression [.symbol "->", .var right, .var right]] := by
    rw [← queried]
    exact scopedLookup_of_invocationTypes_related state (.symbol operator) expected
      (native.assign left (.symbol actual)) before (depth + 8) live scope pending related retained
  have freshAvoid : right ∉ avoid := instanceName_not_mem _ _ _ _
  have rightNotInConfig : right ∉ RecursiveScope.configurationNames state := by
    intro hMem
    apply freshAvoid
    simp [avoid, hMem]
  have rightNotInAssignedNames : right ∉ (native.assign left (.symbol actual)).names := by
    intro hMem
    apply freshAvoid
    simp [avoid, hMem]
  have different : left ≠ right := by
    intro hEq
    apply freshAvoid
    rw [← hEq]
    simp [avoid, expected, atomVariables, atomListVariables]
  have rightFreshAssigned : right ∉ specBindingVars (native.assign left (.symbol actual)) := by
    rwa [← EquationFreshening.bindings_names_eq_specBindingVars]
  have unbound : native.lookup left = none := by
    apply List.lookup_eq_none_iff.mpr
    intro entry stored
    apply bne_iff_ne.mpr
    intro same
    apply leftFresh
    apply List.mem_append_left
    exact List.mem_flatMap.mpr ⟨entry, stored, by simp [same]⟩
  have rightFresh : right ∉ native.names :=
    fun hMem => rightNotInAssignedNames
      (names_subset_assign_of_lookup_none native left (.symbol actual) unbound hMem)
  have unboundSource : source.lookup left = none := by
    apply List.lookup_eq_none_iff.mpr
    intro entry stored
    apply bne_iff_ne.mpr
    intro same
    apply leftFreshSource
    apply List.mem_append_left
    exact List.mem_flatMap.mpr ⟨entry, stored, by simp [same]⟩
  have rightFreshSourceAssigned : right ∉ (source.assign left (.symbol actual)).names := by
    rw [EquationFreshening.bindings_names_eq_specBindingVars]
    intro hMem
    have hBefore : right ∈ specBindingVars before.source.bindings := by
      change right ∈ specBindingVars before.bindings
      rwa [beforeBindings]
    exact rightFreshAssigned ((related.related.support right).mpr hBefore)
  have rightFreshSource : right ∉ source.names :=
    fun hMem => rightFreshSourceAssigned
      (names_subset_assign_of_lookup_none source left (.symbol actual) unboundSource hMem)
  have castEq := fresh_arrow_typeCast_eq (.symbol operator) state.space native
    left right (.symbol actual) depth (invocationTypes state)
    leftFresh rightFresh different queried
  have castCov := fresh_arrow_typeCastCovered (.symbol operator) state.space native
    left right (.symbol actual) depth (invocationTypes state)
    leftFresh rightFresh different queried
  have stepped := (scoped_worker_symbol_cast_step state dispatch operator expected
    (native.assign left (.symbol actual)) (depth + 7) live pending clean
    expNotAtom expNotSym castCov).2
  rw [castEq] at stepped
  have leftNoEdge : left ∉ (native.assign left (.symbol actual)).eqVarsInOrder := by
    have noEdge : left ∉ native.eqVarsInOrder := by
      intro stored
      apply leftFresh
      apply List.mem_append_right
      exact EqualityClosure.mem_eqVarsInOrder_iff.mp stored
    simpa [Bindings.assign, Bindings.isBound, unbound, Bindings.eqVarsInOrder] using noEdge
  have leftAssigned : (native.assign left (.symbol actual)).lookup left = some (.symbol actual) :=
    lookup_assign_of_lookup_none native left (.symbol actual) unbound
  have certSource : ReadoutCertificate (source.assign left (.symbol actual))
      (Entry.Value.eraseEnvironment before.environment) :=
    beforeBindings ▸ before.certified
  have relatedSource : SourceBindingComparison.semantic.FrameRelated
      (native.assign left (.symbol actual))
      (.selected (source.assign left (.symbol actual))
        (Entry.Value.eraseEnvironment before.environment) certSource) := by
    rcases before with ⟨bBindings, bEnv, bCert⟩
    dsimp only at beforeBindings
    subst beforeBindings
    exact related
  obtain ⟨nextCertificate, nextRelated, renewal, absorbed⟩ :=
    FirstSuccessSourceExecution.scoped_type_alias_frame
      certSource relatedSource left right actual
      leftNoEdge rightFreshAssigned different leftAssigned
  have typeMatchSource :
      TypeMatchRel expected (.expression [.symbol "->", .var right, .var right])
        before.bindings sourceOut := by
    rw [beforeBindings]
    exact FirstSuccessSourceExecution.independent_fresh_arrow_type_match
      source left right (.symbol actual) leftFreshSource rightFreshSource different
  have batch :
      TypeCastBatchRel state.space (.symbol operator) expected before.bindings
        [(.symbol operator, sourceOut)]
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
        (matching := Policy.unmarked.matching.Rel) := by
    exact TypeCastBatchRel.success (earlierTypes := []) (laterTypes := [])
      scopedLookupRel rfl (by simp) typeMatchSource
  have models :
      ∀ result ∈ ([(.symbol operator, sourceOut)] : ResultSet),
        ∃ valuation : String → Atom, TypeBindingSatisfied valuation result.2 := by
    intro result member
    obtain rfl := List.mem_singleton.mp member
    exact nextCertificate.satisfiable
  have outRel :
      List.Forall₂
        (fun w s : ResultPair =>
          w.1 = s.1 ∧ ∀ callerScope : List String, BindingTheoryEquivAt callerScope w.2 s.2)
        (typeCast (.symbol operator) expected state.space
          (native.assign left (.symbol actual)) (depth + 7) (invocationTypes state))
        [(.symbol operator, sourceOut)] := by
    rw [castEq]
    exact .cons ⟨rfl, fun callerScope => nextRelated.related.theoryEquivAt callerScope⟩ .nil
  have square := scoped_worker_symbol_cast_of_modelled_source_batch
    state dispatch hostDispatch .unmarked operator expected
    (native.assign left (.symbol actual)) (depth + 7)
    live scope before ctxStack ctxEmitted pending clean
    expNotAtom expNotSym related castCov
    [(.symbol operator, sourceOut)] batch models outRel
  obtain ⟨_, _, _, _, ctxResults, _, _, _, paired, atomRel, localStep, steps⟩ := square
  refine ⟨queried, scopedLookupRel, rightNotInConfig, rightNotInAssignedNames, different,
    castEq, castCov, stepped, ?_, ⟨nextCertificate, nextRelated, renewal, absorbed⟩, ?_⟩
  · intro extra
    have pendingExtra :
        (state.deepen extra).control =
          .work (.atom (.symbol operator) expected
            (native.assign left (.symbol actual)) ((depth + extra) + 7 + 1) live) := by
      rcases state with ⟨sp, ctrl, stk, em⟩
      dsimp only at pending
      subst pending
      simp only [Configuration.deepen, Control.deepen, Task.replenish]
      congr 2
      omega
    have queriedExtra :
        invocationTypes (state.deepen extra) (native.assign left (.symbol actual))
          (.symbol operator) expected =
          [.expression [.symbol "->", .var right, .var right]] := by
      rw [invocationTypes_deepen]
      exact queried
    have castEqExtra := fresh_arrow_typeCast_eq (.symbol operator) (state.deepen extra).space native
      left right (.symbol actual) (depth + extra) (invocationTypes (state.deepen extra))
      leftFresh rightFresh different queriedExtra
    have castCovExtra := fresh_arrow_typeCastCovered (.symbol operator) (state.deepen extra).space native
      left right (.symbol actual) (depth + extra) (invocationTypes (state.deepen extra))
      leftFresh rightFresh different queriedExtra
    have stepExtra := (scoped_worker_symbol_cast_step (state.deepen extra) dispatch operator expected
      (native.assign left (.symbol actual)) ((depth + extra) + 7) live pendingExtra clean
      expNotAtom expNotSym castCovExtra).2
    rw [castEqExtra] at stepExtra
    exact stepExtra
  · cases paired with
    | @cons _ afterResult _ ctxTail headRel tailRel =>
      cases tailRel
      rcases afterResult with ⟨val, afterFrame⟩
      have hVal : val = .symbol operator := by
        have hPay := headRel.payload
        simp [Entry.Value.erase] at hPay
        exact hPay
      subst hVal
      have hBind : afterFrame.bindings = sourceOut := by
        have hRead := headRel.readout
        simp [Completed.rawResult, Entry.Value.erase] at hRead
        exact hRead.symm
      refine ⟨afterFrame, hBind, ?_, .cons headRel .nil, atomRel, localStep, steps⟩
      intro callerScope
      rw [hBind]
      exact nextRelated.related.theoryEquivAt callerScope

open QueryBindingProjection.AliasReadout.Controls
open TypeMatchTransportControls

/-- Certified substitution table `[("a", .var "b")]` for `forwardAlias` (`a = b`). -/
def aliasTable : TypeSubst := [("a", .var "b")]

theorem aliasPresentation :
    AppliedTypePresentationMatchRel [] (.var "a") (.var "b") aliasTable := by
  apply AppliedTypePresentationMatchRel.ordinary
    (TypeSubst.apply_empty (.var "a")) (TypeSubst.apply_empty (.var "b"))
  simpa [aliasTable, TypeSubst.bind, TypeSubst.apply, TypeSubst.lookup, TypeSubst.erase] using
    (AppliedReducedTypeMatchRel.bindLeft
      (substitution := []) (name := "a") (right := .var "b") (by decide))

theorem aliasCertificate : ReadoutCertificate forwardAlias aliasTable := by
  apply ReadoutCertificate.of_fold
  change EquationListPresentationRel [(.var "a", .var "b")] [] aliasTable
  exact .cons aliasPresentation (.nil _)

/-- Contextual `Completed.Frame` for `forwardAlias` with environment `[("a", .var "b")]`. -/
def aliasFrame : Completed.Frame := by
  refine ⟨forwardAlias, [("a", .var "b")], ?_⟩
  simpa only [Entry.Value.eraseEnvironment, List.map_cons, List.map_nil, Entry.Value.erase,
    aliasTable] using aliasCertificate

/-- Concrete Control G (`controlG_variable_alias_cast_and_no_literal_frame_transport`):
1. Combines the root variable-match controls (`actual_variable_match_and_materialization`,
   `contextual_variable_match`, `variable_match_has_no_literal_frame_transport`,
   `variable_match_joint_public_readout`, and `wildcard_without_model_is_not_finite`) showing
   that matching `.var "a"` against `.var "b"` under `forwardAlias` has no literal
   `SourceBindingComparison.semantic.FrameRelated` witness to `aliasFrame.source` (whereas for
   `backwardAlias` the native representative `b` coincides with `aliasFrame`'s table `a ↦ b`),
   yet agrees on `observedTuples` and `resultTheory`, while wildcard matching on `inconsistent`
   is rejected by `TypeMatchingPolicy.Rel .finite`,
2. Verifies that `aliasFrame.represent backwardAlias reordered_aliases_agree` preserves the
   entire annotated `read` value (including nested readiness marks) and the invocation-scope
   support set across the reordered alias representation,
3. Executes `scoped_worker_symbol_cast_enabling_bridge` under `Policy.finiteTypes` on the
   reordered alias pair `(backwardAlias, aliasFrame)` casting `(: probe Int)` against
   `.symbol "Int"` with zero source-side `raw`/`batch`/`models`/`outRelated`
   oracle, constructing both `sourceResults` and `ctxResults` with `BindingSourceAgreement`,
   `HEAssignmentsNonVariable`, and `observedTuples = resultTheory` on every `callerScope`. -/
theorem controlG_variable_alias_cast_and_no_literal_frame_transport
    (dispatch : HE.GroundedDispatch) (hostDispatch : Spec.Eval.GroundedDispatch)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result) :
    let space : Space := Space.ofList
      [.expression [.symbol ":", .symbol "probe", .symbol "Int"]]
    let state : Configuration :=
      ⟨space, .work (.atom (.symbol "probe") (.symbol "Int") backwardAlias 5 []), [], []⟩
    let workerOut := typeCast (.symbol "probe") (.symbol "Int") space backwardAlias 4 (invocationTypes state)
    (matchTypes (.var "a") (.var "b") Bindings.empty 8 = [forwardAlias] ∧
      Entry.Value.UnifyRel .preserve [] (.var "a") (.var "b") aliasFrame.environment ∧
      ¬SourceBindingComparison.semantic.FrameRelated forwardAlias aliasFrame.source ∧
      (∀ policy : Policy, ∀ value : Entry.Value,
        (aliasFrame.represent backwardAlias reordered_aliases_agree).read policy value =
          aliasFrame.read policy value) ∧
      (∀ scope : List String, ∀ live : List Atom, ∀ subject expected : Atom, ∀ name : String,
        name ∈ invocationTypeScope scope live subject expected
            (aliasFrame.represent backwardAlias reordered_aliases_agree).bindings ↔
          name ∈ invocationTypeScope scope live subject expected aliasFrame.bindings) ∧
      observedTuples forwardAlias
          ([Atom.var "a", .var "b", .var "a"].map fun atom => forwardAlias.applyFull atom 8) =
        observedTuples forwardAlias
          ([Atom.var "a", .var "b", .var "a"].map aliasTable.apply) ∧
      (∀ scope : List String, ∀ payload : Entry.Value,
        observedTuples backwardAlias (scope.map Atom.var ++ [payload.erase]) =
          RecursiveExecution.Contextual.Protocol.resultTheory scope (payload, aliasFrame)) ∧
      TypeMatchRel Atom.undefinedType (.symbol "A") inconsistent inconsistent ∧
      ¬TypeMatchingPolicy.Rel .finite Atom.undefinedType (.symbol "A")
        inconsistent inconsistent) ∧
    workerOut = [(.symbol "probe", backwardAlias)] ∧
    Checked.blocked dispatch state scopedTypes = none ∧
    (Checked.machine dispatch scopedTypes).step state =
      some (.silent { state with control := .returning [(.symbol "probe", backwardAlias)] }) ∧
    ∃ sourceResults : ResultSet,
    ∃ ctxResults : List Completed.Result,
      TypeCastBatchRel space (.symbol "probe") (.symbol "Int") aliasFrame.bindings sourceResults
        (lookup := Completed.scopedLookup
          (invocationTypeScope [] [] (.symbol "probe") (.symbol "Int") aliasFrame.bindings) space)
        (matching := Policy.finiteTypes.matching.Rel) ∧
      ctxResults.map Completed.rawResult = sourceResults ∧
      (∀ r ∈ ctxResults,
        (∃ table, ReadoutCertificate r.2.bindings table) ∧
        Spec.Match.SolutionTheory.HEAssignmentsNonVariable r.2.bindings) ∧
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧
          BindingSourceAgreement w.2 c.2.bindings ∧
          (∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings) ∧
          (∀ callerScope : List String,
            observedTuples w.2 (callerScope.map Atom.var ++ [w.1]) =
              RecursiveExecution.Contextual.Protocol.resultTheory callerScope c))
        [(.symbol "probe", backwardAlias)] ctxResults ∧
      Completed.AtomRel space hostDispatch Completed.scopedLookup
        [] [] (.symbol "probe") (.symbol "Int") aliasFrame ctxResults (policy := Policy.finiteTypes) ∧
      RecursiveMachine.Contextual.LocalStep space hostDispatch
        Completed.scopedLookup Policy.finiteTypes
        (.work (.atom [] [] (.symbol "probe") (.symbol "Int") aliasFrame), ctxStack)
        (.returning ctxResults, ctxStack) ∧
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup Policy.finiteTypes
        ⟨space, .work (.atom [] [] (.symbol "probe") (.symbol "Int") aliasFrame), ctxStack, ctxEmitted⟩
        ⟨space, .returning ctxResults, ctxStack, ctxEmitted⟩ := by
  dsimp only
  let space : Space := Space.ofList
    [.expression [.symbol ":", .symbol "probe", .symbol "Int"]]
  let state : Configuration :=
    ⟨space, .work (.atom (.symbol "probe") (.symbol "Int") backwardAlias 5 []), [], []⟩
  have hVarMatch := actual_variable_match_and_materialization
  have hCtxMatch : Entry.Value.UnifyRel .preserve [] (.var "a") (.var "b") aliasFrame.environment :=
    contextual_variable_match .preserve
  have hNoLitFwd : ¬SourceBindingComparison.semantic.FrameRelated forwardAlias aliasFrame.source :=
    variable_match_has_no_literal_frame_transport .preserve aliasFrame hCtxMatch
  have hRepRead : ∀ policy : Policy, ∀ value : Entry.Value,
      (aliasFrame.represent backwardAlias reordered_aliases_agree).read policy value =
        aliasFrame.read policy value :=
    fun policy value => aliasFrame.represent_read backwardAlias reordered_aliases_agree policy value
  have hRepScope : ∀ scope : List String, ∀ live : List Atom, ∀ subject expected : Atom, ∀ name : String,
      name ∈ invocationTypeScope scope live subject expected
          (aliasFrame.represent backwardAlias reordered_aliases_agree).bindings ↔
        name ∈ invocationTypeScope scope live subject expected aliasFrame.bindings :=
    fun scope live subject expected name =>
      aliasFrame.represent_invocation_scope_iff backwardAlias reordered_aliases_agree
        scope live subject expected name
  have hReadout :
      observedTuples forwardAlias
          ([Atom.var "a", .var "b", .var "a"].map fun atom => forwardAlias.applyFull atom 8) =
        observedTuples forwardAlias
          ([Atom.var "a", .var "b", .var "a"].map aliasTable.apply) :=
    variable_match_joint_public_readout
  have hResultTheory : ∀ scope : List String, ∀ payload : Entry.Value,
      observedTuples backwardAlias (scope.map Atom.var ++ [payload.erase]) =
        RecursiveExecution.Contextual.Protocol.resultTheory scope (payload, aliasFrame) := by
    intro scope payload
    exact (reordered_aliases_agree.symm.theoryEquivAt
      (TypeSubst.typeVarsList (scope.map Atom.var ++ [payload.erase]))).observedTuples_eq
      (scope.map Atom.var ++ [payload.erase]) (fun _ h => h)
  have hWild := wildcard_without_model_is_not_finite
  have hWorkerOut :
      typeCast (.symbol "probe") (.symbol "Int") space backwardAlias 4 (invocationTypes state) =
        [(.symbol "probe", backwardAlias)] := by
    decide
  have hCovered :
      typeCastCovered (.symbol "probe") (.symbol "Int") space backwardAlias 4 (invocationTypes state) = true := by
    decide
  have hAgreed : BindingSourceAgreement backwardAlias aliasFrame.bindings :=
    reordered_aliases_agree.symm
  have hBwdCoh : SyntacticallyClassCoherent backwardAlias := by
    refine ⟨?_, by simp [Spec.Match.SolutionTheory.AssignmentsNodup, backwardAlias], ?_⟩
    · intro _ _ hMem; simp [backwardAlias] at hMem
    · intro _ _ _ _ hMem; simp [backwardAlias] at hMem
  have hFwdShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable aliasFrame.bindings := by
    intro _ _ hMem; simp [aliasFrame, forwardAlias] at hMem
  have bridge := scoped_worker_symbol_cast_of_covered_selected_loopFree
    state dispatch hostDispatch Policy.finiteTypes "probe" (.symbol "Int") backwardAlias 4 [] []
    aliasFrame ctxStack ctxEmitted rfl (by decide) (by decide) (by decide)
    hAgreed hBwdCoh hFwdShape (by intro _ h; cases h) rfl hCovered
    (by
      intro out hMem
      rw [hWorkerOut] at hMem
      simp only [List.mem_singleton, Prod.mk.injEq] at hMem
      rcases hMem with ⟨_, rfl⟩
      decide)
  obtain ⟨_, unblocked, stepped, _, sourceResults, ctxResults, sourceBatch, readouts,
    outCertShapes, _, workerCtxAligned, _, atomRel, localStep, steps⟩ := bridge
  rw [hWorkerOut] at stepped workerCtxAligned
  exact ⟨⟨hVarMatch.1, hCtxMatch, hNoLitFwd, hRepRead, hRepScope,
      hReadout, hResultTheory, hWild.1, hWild.2⟩,
    hWorkerOut, unblocked, stepped, sourceResults, ctxResults, sourceBatch, readouts,
    outCertShapes, workerCtxAligned, atomRel, localStep, steps⟩

/-- Concrete Control H (`controlH_duplicate_failure_cast_occurrences_preserved`):
On a space with duplicate type declarations `(: dup Int)` and `(: dup Int)`, casting
`.symbol "dup"` to `.symbol "Bool"` under `Policy.finiteTypes` via
`scoped_worker_symbol_cast_of_covered_selected_models` preserves both physical failure occurrences
`[mkError (.symbol "dup") (.badType (.symbol "Bool") (.symbol "Int")),
  mkError (.symbol "dup") (.badType (.symbol "Bool") (.symbol "Int"))]`
of length 2 across `workerOut`, `sourceResults`, and `ctxResults`. -/
theorem controlH_duplicate_failure_cast_occurrences_preserved
    (dispatch : HE.GroundedDispatch) (hostDispatch : Spec.Eval.GroundedDispatch)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result) :
    let space : Space := Space.ofList
      [ .expression [.symbol ":", .symbol "dup", .symbol "Int"]
      , .expression [.symbol ":", .symbol "dup", .symbol "Int"] ]
    let state : Configuration :=
      ⟨space, .work (.atom (.symbol "dup") (.symbol "Bool") Bindings.empty 2 []), [], []⟩
    let errAtom := mkError (.symbol "dup") (.badType (.symbol "Bool") (.symbol "Int"))
    let expectedOut : ResultSet := [(errAtom, Bindings.empty), (errAtom, Bindings.empty)]
    let workerOut := typeCast (.symbol "dup") (.symbol "Bool") space Bindings.empty 1 (invocationTypes state)
    workerOut = expectedOut ∧
    workerOut.length = 2 ∧
    Checked.blocked dispatch state scopedTypes = none ∧
    (Checked.machine dispatch scopedTypes).step state =
      some (.silent { state with control := .returning expectedOut }) ∧
    ∃ sourceResults : ResultSet,
    ∃ ctxResults : List Completed.Result,
      sourceResults.map Prod.fst = [errAtom, errAtom] ∧
      sourceResults.length = 2 ∧
      ctxResults.length = 2 ∧
      TypeCastBatchRel space (.symbol "dup") (.symbol "Bool") Completed.Frame.empty.bindings sourceResults
        (lookup := Completed.scopedLookup
          (invocationTypeScope [] [] (.symbol "dup") (.symbol "Bool") Completed.Frame.empty.bindings) space)
        (matching := Policy.finiteTypes.matching.Rel) ∧
      ctxResults.map Completed.rawResult = sourceResults ∧
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧
          BindingSourceAgreement w.2 c.2.bindings ∧
          (∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings) ∧
          (∀ callerScope : List String,
            observedTuples w.2 (callerScope.map Atom.var ++ [w.1]) =
              RecursiveExecution.Contextual.Protocol.resultTheory callerScope c))
        expectedOut ctxResults ∧
      Completed.AtomRel space hostDispatch Completed.scopedLookup
        [] [] (.symbol "dup") (.symbol "Bool") Completed.Frame.empty ctxResults (policy := Policy.finiteTypes) ∧
      RecursiveMachine.Contextual.LocalStep space hostDispatch
        Completed.scopedLookup Policy.finiteTypes
        (.work (.atom [] [] (.symbol "dup") (.symbol "Bool") Completed.Frame.empty), ctxStack)
        (.returning ctxResults, ctxStack) ∧
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup Policy.finiteTypes
        ⟨space, .work (.atom [] [] (.symbol "dup") (.symbol "Bool") Completed.Frame.empty), ctxStack, ctxEmitted⟩
        ⟨space, .returning ctxResults, ctxStack, ctxEmitted⟩ := by
  dsimp only
  let space : Space := Space.ofList
    [ .expression [.symbol ":", .symbol "dup", .symbol "Int"]
    , .expression [.symbol ":", .symbol "dup", .symbol "Int"] ]
  let state : Configuration :=
    ⟨space, .work (.atom (.symbol "dup") (.symbol "Bool") Bindings.empty 2 []), [], []⟩
  let errAtom := mkError (.symbol "dup") (.badType (.symbol "Bool") (.symbol "Int"))
  let expectedOut : ResultSet := [(errAtom, Bindings.empty), (errAtom, Bindings.empty)]
  have hWorkerOut :
      typeCast (.symbol "dup") (.symbol "Bool") space Bindings.empty 1 (invocationTypes state) =
        expectedOut := by
    decide
  have hCovered :
      typeCastCovered (.symbol "dup") (.symbol "Bool") space Bindings.empty 1 (invocationTypes state) = true := by
    decide
  have hEmptyShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable Bindings.empty := by
    intro _ _ hMem; cases hMem
  have bridge := scoped_worker_symbol_cast_of_covered_selected_models
    state dispatch hostDispatch Policy.finiteTypes "dup" (.symbol "Bool") Bindings.empty 1 [] []
    Completed.Frame.empty ctxStack ctxEmitted rfl (by decide) (by decide) (by decide)
    (.refl Bindings.empty) hEmptyShape hEmptyShape (by intro _ h; cases h) rfl hCovered
    (by
      intro out hMem
      rw [hWorkerOut] at hMem
      simp [expectedOut, errAtom, mkError, Atom.error] at hMem)
  obtain ⟨_, unblocked, stepped, _, sourceResults, ctxResults, sourceBatch, readouts,
    _, outAgreed, workerCtxAligned, _, atomRel, localStep, steps⟩ := bridge
  rw [hWorkerOut] at stepped outAgreed workerCtxAligned
  have hSourceShape : sourceResults.map Prod.fst = [errAtom, errAtom] ∧ sourceResults.length = 2 := by
    dsimp only [expectedOut] at outAgreed
    rcases outAgreed with _ | ⟨⟨h1, _⟩, _ | ⟨⟨h2, _⟩, _ | _⟩⟩
    exact ⟨by simp [← h1, ← h2], rfl⟩
  have hCtxLen : ctxResults.length = 2 := by
    have hMapLen := congrArg List.length readouts
    simpa [List.length_map, hSourceShape.2] using hMapLen
  exact ⟨hWorkerOut, rfl, unblocked, stepped, sourceResults, ctxResults,
    hSourceShape.1, hSourceShape.2, hCtxLen,
    sourceBatch, readouts, workerCtxAligned, atomRel, localStep, steps⟩

/-- Separation Witness 1 (`separation_aliasConstraints_not_typeCast_invariant`):
Replacing a raw variable-assigned input `rawVarAssign := ⟨[("x", .var "y")], []⟩`
(which violates `Spec.Match.SolutionTheory.HEAssignmentsNonVariable`) by its nonvariable alias presentation
`aliasExposed := ⟨[], [("x", "y")]⟩` preserves `BindingSourceAgreement`, yet changes the
executable `matchTypes` and `typeCast` behavior at covered depth:
casting `(: op (f $y))` against `.var "x"` rejects under `rawVarAssign` (because `classValues "x" = [$y]`
triggers the occurs check against `(f $y)`), whereas under `aliasExposed` (`classValues "x" = []`)
`matchTypes` succeeds with a cyclic record `⟨[("x", (f $y))], [("x", "y")]⟩`.
This establishes why `Spec.Match.SolutionTheory.HEAssignmentsNonVariable` on the actual worker input is required. -/
theorem separation_aliasConstraints_not_typeCast_invariant :
    let rawVarAssign : Bindings := ⟨[("x", .var "y")], []⟩
    let aliasExposed : Bindings := ⟨[], [("x", "y")]⟩
    let actualType : Atom := .expression [.symbol "f", .var "y"]
    let space : Space := Space.ofList [.expression [.symbol ":", .symbol "op", actualType]]
    let cyclicHit : Bindings := ⟨[("x", actualType)], [("x", "y")]⟩
    ¬Spec.Match.SolutionTheory.HEAssignmentsNonVariable rawVarAssign ∧
    Spec.Match.SolutionTheory.HEAssignmentsNonVariable aliasExposed ∧
    BindingSourceAgreement rawVarAssign aliasExposed ∧
    matchTypesCovered (.var "x") actualType rawVarAssign 4 = true ∧
    matchTypesCovered (.var "x") actualType aliasExposed 4 = true ∧
    matchTypes (.var "x") actualType rawVarAssign 4 = [] ∧
    matchTypes (.var "x") actualType aliasExposed 4 = [cyclicHit] ∧
    cyclicHit.hasLoop = true ∧
    typeCast (.symbol "op") (.var "x") space rawVarAssign 4 (rawTypeLookup space) =
      [(mkError (.symbol "op") (.badType (.var "x") actualType), rawVarAssign)] ∧
    typeCast (.symbol "op") (.var "x") space aliasExposed 4 (rawTypeLookup space) =
      [(.symbol "op", cyclicHit)] ∧
    typeCast (.symbol "op") (.var "x") space rawVarAssign 4 (rawTypeLookup space) ≠
      typeCast (.symbol "op") (.var "x") space aliasExposed 4 (rawTypeLookup space) := by
  dsimp only
  refine ⟨?_, ?_, ?_, by decide, by decide, by decide, by decide, by decide,
    by decide, by decide, by decide⟩
  · intro hShape
    exact hShape "x" "y" (by simp)
  · intro _ _ hMem
    cases hMem
  · constructor
    · intro valuation
      simp [TypeBindingSatisfied, applyTypeValuation]
    · intro name
      simp [specBindingVars, TypeSubst.typeVars]

/-- Separation Witness 2 (`separation_cyclic_merge_certified_covered_not_finite`):
Even when the caller input `cyclicInput := ⟨[("x", (f $y))], []⟩` satisfies
`SyntacticallyClassCoherent`, `HEAssignmentsNonVariable`, `hasLoop = false`, and
`∃ valuation, TypeBindingSatisfied valuation cyclicInput`, a covered `matchTypes` / `typeCast`
step against `(.var "y")` and `(g $x)` produces a 2-step cyclic record `cyclicOut` with
`cyclicOut.hasLoop = true` that has no finite model and no `TypeMatchingPolicy.Rel .finite`
derivation. This establishes why `typeCastCovered = true` alone does not guarantee that a
selected raw hit has a finite model, and why `selectedSatisfiable` / `selectedLoopFree`
(under `SyntacticallyClassCoherent`) cannot be omitted. -/
theorem separation_cyclic_merge_certified_covered_not_finite :
    let cyclicInput : Bindings := ⟨[("x", .expression [.symbol "f", .var "y"])], []⟩
    let actualType : Atom := .expression [.symbol "g", .var "x"]
    let space : Space := Space.ofList [.expression [.symbol ":", .symbol "op", actualType]]
    let cyclicOut : Bindings :=
      ⟨[("x", .expression [.symbol "f", .var "y"]), ("y", actualType)], []⟩
    SyntacticallyClassCoherent cyclicInput ∧
    cyclicInput.hasLoop = false ∧
    (∃ valuation : String → Atom, TypeBindingSatisfied valuation cyclicInput) ∧
    matchTypesCovered (.var "y") actualType cyclicInput 4 = true ∧
    matchTypes (.var "y") actualType cyclicInput 4 = [cyclicOut] ∧
    typeCastCovered (.symbol "op") (.var "y") space cyclicInput 4 (rawTypeLookup space) = true ∧
    typeCast (.symbol "op") (.var "y") space cyclicInput 4 (rawTypeLookup space) =
      [(.symbol "op", cyclicOut)] ∧
    cyclicOut.hasLoop = true ∧
    (¬∃ valuation : String → Atom, TypeBindingSatisfied valuation cyclicOut) ∧
    (∀ candidate : Bindings, ¬TypeMatchingPolicy.Rel .finite (.var "y") actualType cyclicInput candidate) := by
  dsimp only
  let cyclicInput : Bindings := ⟨[("x", .expression [.symbol "f", .var "y"])], []⟩
  let actualType : Atom := .expression [.symbol "g", .var "x"]
  let cyclicOut : Bindings :=
    ⟨[("x", .expression [.symbol "f", .var "y"]), ("y", actualType)], []⟩
  have hCoh : SyntacticallyClassCoherent cyclicInput := by
    refine ⟨?_, by simp [Spec.Match.SolutionTheory.AssignmentsNodup, cyclicInput], ?_⟩
    · intro key target hMem
      simp [cyclicInput] at hMem
    · intro k1 k2 v1 v2 h1 h2 _
      simp only [cyclicInput, List.mem_singleton, Prod.mk.injEq] at h1 h2
      exact h1.2.trans h2.2.symm
  have hSatIn : ∃ valuation : String → Atom, TypeBindingSatisfied valuation cyclicInput := by
    refine ⟨fun name => if name = "x" then .expression [.symbol "f", .symbol "a"] else .symbol "a", ?_⟩
    constructor
    · intro key val hMem
      simp only [cyclicInput, List.mem_singleton, Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩
      simp [applyTypeValuation]
    · intro _ _ hMem
      cases hMem
  have hNoOutModel : ¬∃ valuation : String → Atom, TypeBindingSatisfied valuation cyclicOut := by
    rintro ⟨valuation, hAssign, _⟩
    have hx := hAssign "x" (.expression [.symbol "f", .var "y"]) (by simp [cyclicOut])
    have hy := hAssign "y" actualType (by simp [cyclicOut, actualType])
    simp only [actualType, applyTypeValuation, List.map] at hx hy
    have hSizeX := congrArg sizeOf hx
    have hSizeY := congrArg sizeOf hy
    simp at hSizeX hSizeY
    omega
  have hNoFiniteMatch :
      ∀ candidate : Bindings,
        ¬TypeMatchingPolicy.Rel .finite (.var "y") actualType cyclicInput candidate := by
    intro candidate ⟨hMatch, valuation, hSatCand⟩
    obtain ⟨matched, hSpecMatch, hSpecMerge⟩ :=
      hMatch.structural_of_nonWildcard (by decide) (by decide) (by decide) (by decide)
    have hConj := (bindingSatisfied_append_iff valuation cyclicInput matched).mp
      ((hSpecMerge.bindingSourceAgreement.solutions valuation).mp hSatCand)
    have hx := hConj.1.1 "x" (.expression [.symbol "f", .var "y"]) (by simp [cyclicInput])
    simp only [applyTypeValuation, List.map] at hx
    let observer : String → Metta.Atom := fun name => Spec.Match.SolutionTheory.encodeModelAtom (valuation name)
    have hHeMatched : Spec.Match.SolutionTheory.HEBindingSatisfied observer matched :=
      Spec.Bindings.ScopeObservation.ModelTransport.heBindingSatisfied_of_specTypeBindingSatisfied hConj.2
    have hEq := (Spec.Match.SolutionTheory.matchRel_solution_iff hSpecMatch observer).mp hHeMatched
    change Spec.Match.SolutionTheory.applyClassSolution observer (Spec.Match.SolutionTheory.encodeModelAtom (.var "y")) =
      Spec.Match.SolutionTheory.applyClassSolution observer (Spec.Match.SolutionTheory.encodeModelAtom actualType) at hEq
    rw [← Spec.Bindings.ScopeObservation.ModelTransport.encodeModelAtom_applyTypeValuation,
      ← Spec.Bindings.ScopeObservation.ModelTransport.encodeModelAtom_applyTypeValuation] at hEq
    have hy : applyTypeValuation valuation (.var "y") = applyTypeValuation valuation actualType :=
      Spec.Match.SolutionTheory.encodeModelAtom_injective hEq
    simp only [actualType, applyTypeValuation, List.map] at hy
    have hSizeX := congrArg sizeOf hx
    have hSizeY := congrArg sizeOf hy
    simp at hSizeX hSizeY
    omega
  exact ⟨hCoh, by decide, hSatIn, by decide, by decide, by decide, by decide, by decide,
    hNoOutModel, hNoFiniteMatch⟩

/-- Representative Difference Witness (`duplicate_edge_record_difference_and_theory_agreement`):
When matching `.var "x"` and `.var "y"` under caller
`dupCaller := ⟨[("x", .symbol "Int")], [("x", "y")]⟩`, `matchTypes` at depth `2` produces
`workerOut := dupCaller.addEquality "x" "y"` with duplicate equality edges
`[("x", "y"), ("x", "y")]`, whereas the displayed caller representative `dupCaller` has a single
edge `[("x", "y")]` (`workerOut ≠ dupCaller`), and `matchTypes_mem_to_typeMatch_finite_agreed`
constructs a `sourceOut` satisfying `TypeMatchingPolicy.Rel .finite` and
`BindingSourceAgreement workerOut sourceOut`. -/
theorem duplicate_edge_record_difference_and_theory_agreement :
    let dupCaller : Bindings := ⟨[("x", .symbol "Int")], [("x", "y")]⟩
    let workerOut : Bindings := dupCaller.addEquality "x" "y"
    matchTypesCovered (.var "x") (.var "y") dupCaller 2 = true ∧
    matchTypes (.var "x") (.var "y") dupCaller 2 = [workerOut] ∧
    workerOut.equalities = [("x", "y"), ("x", "y")] ∧
    dupCaller.equalities = [("x", "y")] ∧
    workerOut ≠ dupCaller ∧
    ∃ sourceOut : Bindings,
      TypeMatchingPolicy.Rel .finite (.var "x") (.var "y") dupCaller sourceOut ∧
      BindingSourceAgreement workerOut sourceOut ∧
      Spec.Match.SolutionTheory.HEAssignmentsNonVariable sourceOut := by
  dsimp only
  let dupCaller : Bindings := ⟨[("x", .symbol "Int")], [("x", "y")]⟩
  let workerOut : Bindings := dupCaller.addEquality "x" "y"
  have hCoh : SyntacticallyClassCoherent dupCaller := by
    refine ⟨?_, by simp [Spec.Match.SolutionTheory.AssignmentsNodup, dupCaller], ?_⟩
    · intro key target hMem
      simp [dupCaller] at hMem
    · intro k1 k2 v1 v2 h1 h2 _
      simp only [dupCaller, List.mem_singleton, Prod.mk.injEq] at h1 h2
      exact h1.2.trans h2.2.symm
  have hSatCaller : ∃ valuation : String → Atom, TypeBindingSatisfied valuation dupCaller := by
    refine ⟨fun _ => .symbol "Int", ?_⟩
    constructor
    · intro key val hMem
      simp only [dupCaller, List.mem_singleton, Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩
      simp [applyTypeValuation]
    · intro lhs rhs hMem
      simp only [dupCaller, List.mem_singleton, Prod.mk.injEq] at hMem
      rcases hMem with ⟨rfl, rfl⟩
      rfl
  have hMatchEq : matchTypes (.var "x") (.var "y") dupCaller 2 = [workerOut] := by
    decide +kernel
  have hMem : workerOut ∈ matchTypes (.var "x") (.var "y") dupCaller 2 := by
    rw [hMatchEq]
    exact List.mem_cons_self
  have hSatOut : ∃ valuation : String → Atom, TypeBindingSatisfied valuation workerOut :=
    matchTypes_mem_satisfiable_of_loopFree hCoh hSatCaller hMem (by decide +kernel)
  have hNe : workerOut ≠ dupCaller := by
    intro h
    have hLen := congrArg (fun b : Bindings => b.equalities.length) h
    revert hLen
    decide +kernel
  exact ⟨by decide +kernel, hMatchEq, rfl, rfl, hNe,
    matchTypes_mem_to_typeMatch_finite_agreed hCoh.1 hMem hSatOut⟩

namespace CompoundCastControl

private def boolArrow : Atom := .expression [.symbol "->",.symbol "Bool",.symbol "Bool"]
private def intArrow : Atom := .expression [.symbol "->",.symbol "Int",.symbol "Int"]
private def expected : Atom := .expression [.symbol "->",.var "a",.symbol "Int"]
private def space : Space := Space.ofList
  [.expression [.symbol ":",.symbol "poly",boolArrow],.expression [.symbol ":",.symbol "poly",intArrow]]
private def state : Configuration :=
  ⟨space,.work (.atom (.symbol "poly") expected backwardAlias 9 []),[],[]⟩
private def selected : Bindings := ⟨[("a",.symbol "Int")],[("b","a")]⟩

private theorem lookup_types : invocationTypes state backwardAlias (.symbol "poly") expected =
    [boolArrow,intArrow] := by decide +kernel
private theorem first_rejected : matchTypes expected boolArrow backwardAlias 8 = [] := by decide +kernel
private theorem later_selected : matchTypes expected intArrow backwardAlias 8 = [selected] := by decide +kernel
private theorem cast_output : typeCast (.symbol "poly") expected state.space backwardAlias 8
    (invocationTypes state) = [(.symbol "poly",selected)] := by decide +kernel
private theorem cast_covered : typeCastCovered (.symbol "poly") expected state.space backwardAlias 8
    (invocationTypes state) = true := by decide +kernel
private theorem selected_reads : selected.applyFull (.var "b") 8 = .symbol "Int" ∧
    selected.applyFull (.var "a") 8 = .symbol "Int" := by decide +kernel
private theorem selected_loopFree : selected.hasLoop = false := by decide +kernel

end CompoundCastControl

set_option maxHeartbeats 100000 in
/-- Concrete Control I (`controlI_compound_arrow_and_fallback_cast_covered_selected_loopFree`):
On a space with two ordered candidate signatures `(: poly (-> Bool Bool))` and
`(: poly (-> Int Int))`, casting `.symbol "poly"` against the compound open arrow type
`expected := (-> $a Int)` under open caller alias `backwardAlias = ⟨[], [("b", "a")]⟩`
and contextual frame `aliasFrame` (`forwardAlias = ⟨[], [("a", "b")]⟩`):
1. The first candidate `(-> Bool Bool)` fails `matchTypes` at the return-type position (`Int` vs `Bool`),
2. The second candidate `(-> Int Int)` succeeds, binding `"a" ↦ .symbol "Int"` and propagating
   to `"b" ↦ .symbol "Int"` across the open alias `"b" = "a"`,
3. `scoped_worker_symbol_cast_of_covered_selected_loopFree` derives the worker step, `TypeCastBatchRel`
   (with non-empty rejected prefix `earlierTypes = [(-> Bool Bool)]`), `ctxResults`,
   `BindingSourceAgreement`, `BindingTheoryEquivAt`, `observedTuples = resultTheory`,
   `Completed.AtomRel`, `LocalStep`, and `Steps` under `Policy.finiteTypes` directly from
   `typeCastCovered`, `SyntacticallyClassCoherent`, and `hasLoop = false` with zero manual
   `TypeCastBatchRel` construction. -/
theorem controlI_compound_arrow_and_fallback_cast_covered_selected_loopFree
    (dispatch : HE.GroundedDispatch) (hostDispatch : Spec.Eval.GroundedDispatch)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result) :
    let boolArrow : Atom := CompoundCastControl.boolArrow
    let intArrow : Atom := CompoundCastControl.intArrow
    let expected : Atom := CompoundCastControl.expected
    let space : Space := CompoundCastControl.space
    let state : Configuration := CompoundCastControl.state
    let selectedBind : Bindings := CompoundCastControl.selected
    let workerOut := typeCast (.symbol "poly") expected space backwardAlias 8 (invocationTypes state)
    invocationTypes state backwardAlias (.symbol "poly") expected = [boolArrow, intArrow] ∧
    matchTypes expected boolArrow backwardAlias 8 = [] ∧
    matchTypes expected intArrow backwardAlias 8 = [selectedBind] ∧
    workerOut = [(.symbol "poly", selectedBind)] ∧
    selectedBind.applyFull (.var "b") 8 = .symbol "Int" ∧
    selectedBind.applyFull (.var "a") 8 = .symbol "Int" ∧
    Checked.blocked dispatch state scopedTypes = none ∧
    (Checked.machine dispatch scopedTypes).step state =
      some (.silent { state with control := .returning [(.symbol "poly", selectedBind)] }) ∧
    ∃ sourceResults : ResultSet,
    ∃ ctxResults : List Completed.Result,
      TypeCastBatchRel space (.symbol "poly") expected aliasFrame.bindings sourceResults
        (lookup := Completed.scopedLookup
          (invocationTypeScope [] [] (.symbol "poly") expected aliasFrame.bindings) space)
        (matching := Policy.finiteTypes.matching.Rel) ∧
      ctxResults.map Completed.rawResult = sourceResults ∧
      (∀ r ∈ ctxResults,
        (∃ table, ReadoutCertificate r.2.bindings table) ∧
        Spec.Match.SolutionTheory.HEAssignmentsNonVariable r.2.bindings) ∧
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧
          BindingSourceAgreement w.2 c.2.bindings ∧
          (∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings) ∧
          (∀ callerScope : List String,
            observedTuples w.2 (callerScope.map Atom.var ++ [w.1]) =
              RecursiveExecution.Contextual.Protocol.resultTheory callerScope c))
        [(.symbol "poly", selectedBind)] ctxResults ∧
      Completed.AtomRel space hostDispatch Completed.scopedLookup
        [] [] (.symbol "poly") expected aliasFrame ctxResults (policy := Policy.finiteTypes) ∧
      RecursiveMachine.Contextual.LocalStep space hostDispatch
        Completed.scopedLookup Policy.finiteTypes
        (.work (.atom [] [] (.symbol "poly") expected aliasFrame), ctxStack)
        (.returning ctxResults, ctxStack) ∧
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup Policy.finiteTypes
        ⟨space, .work (.atom [] [] (.symbol "poly") expected aliasFrame), ctxStack, ctxEmitted⟩
        ⟨space, .returning ctxResults, ctxStack, ctxEmitted⟩ := by
  let boolArrow : Atom := CompoundCastControl.boolArrow
  let intArrow : Atom := CompoundCastControl.intArrow
  let expected : Atom := CompoundCastControl.expected
  let space : Space := CompoundCastControl.space
  let state : Configuration := CompoundCastControl.state
  let selectedBind : Bindings := CompoundCastControl.selected
  have hWorkerOut :
      typeCast (.symbol "poly") expected state.space backwardAlias 8 (invocationTypes state) =
        [(.symbol "poly", selectedBind)] := CompoundCastControl.cast_output
  have hCovered :
      typeCastCovered (.symbol "poly") expected state.space backwardAlias 8 (invocationTypes state) = true := CompoundCastControl.cast_covered
  have hAgreed : BindingSourceAgreement backwardAlias aliasFrame.bindings :=
    reordered_aliases_agree.symm
  have hBwdCoh : SyntacticallyClassCoherent backwardAlias := by
    refine ⟨?_, by simp [Spec.Match.SolutionTheory.AssignmentsNodup, backwardAlias], ?_⟩
    · intro _ _ hMem; simp [backwardAlias] at hMem
    · intro _ _ _ _ hMem; simp [backwardAlias] at hMem
  have hFwdShape : Spec.Match.SolutionTheory.HEAssignmentsNonVariable aliasFrame.bindings := by
    intro _ _ hMem; simp [aliasFrame, forwardAlias] at hMem
  have hSelLoopFree :
      ∀ out : Bindings,
        (.symbol "poly", out) ∈
          typeCast (.symbol "poly") expected state.space backwardAlias 8 (invocationTypes state) →
        out.hasLoop = false := by
    rw [hWorkerOut]
    intro out hMem
    simp only [List.mem_singleton, Prod.mk.injEq] at hMem
    rcases hMem with ⟨_, rfl⟩
    exact CompoundCastControl.selected_loopFree
  have bridge := scoped_worker_symbol_cast_of_covered_selected_loopFree
    state dispatch hostDispatch Policy.finiteTypes "poly" expected backwardAlias 8 [] []
    aliasFrame ctxStack ctxEmitted rfl (by decide +kernel) (by decide +kernel) (by decide +kernel)
    hAgreed hBwdCoh hFwdShape (by intro _ h; cases h) rfl hCovered hSelLoopFree
  obtain ⟨_, unblocked, stepped, _, sourceResults, ctxResults, sourceBatch, readouts,
    outCertShapes, _, workerCtxAligned, _, atomRel, localStep, steps⟩ := bridge
  have stepped' :
      (Checked.machine dispatch scopedTypes).step state =
        some (.silent { state with control := .returning [(.symbol "poly", selectedBind)] }) :=
    stepped.trans
      (congrArg (fun r => some (Transition.silent { state with control := .returning r })) hWorkerOut)
  have workerCtxAligned' :
      List.Forall₂
        (fun (w : ResultPair) (c : Completed.Result) =>
          w.1 = c.1.erase ∧
          BindingSourceAgreement w.2 c.2.bindings ∧
          (∀ callerScope : List String,
            BindingTheoryEquivAt callerScope w.2 c.2.bindings) ∧
          (∀ callerScope : List String,
            observedTuples w.2 (callerScope.map Atom.var ++ [w.1]) =
              RecursiveExecution.Contextual.Protocol.resultTheory callerScope c))
        [(.symbol "poly", selectedBind)] ctxResults := by
    exact hWorkerOut ▸ workerCtxAligned
  refine ⟨?_,?_,?_,?_,?_,?_,?_,?_,sourceResults,ctxResults,?_,?_,?_,?_,?_,?_,?_⟩
  · exact CompoundCastControl.lookup_types
  · exact CompoundCastControl.first_rejected
  · exact CompoundCastControl.later_selected
  · exact hWorkerOut
  · exact CompoundCastControl.selected_reads.1
  · exact CompoundCastControl.selected_reads.2
  · exact unblocked
  · simpa only [state,selectedBind] using stepped'
  · exact sourceBatch
  · exact readouts
  · exact outCertShapes
  · exact workerCtxAligned'
  · exact atomRel
  · exact localStep
  · exact steps

end UniversalScopedCastAndHeadBoundary

/-! ## Block 6: Structural Retained-State Relation & Protocol Commuting Squares (`ScopedRetainedRelation`)

This section defines the structural correspondence between the checked configuration-scoped
worker (`RecursiveTasks.Task`, `Frame`, `Control`, `Configuration`) and the contextual
machine (`RecursiveTasks.Contextual.Task`, `Continuation`, `Control`, `Configuration`):
- `ScopedActivationRel`: semantic `FrameRelated` agreement between a worker `Bindings`
  and a contextual `Completed.Frame`.
- `ScopedResultRel`: erased-atom equality plus `ScopedActivationRel` on result pairs,
  together with joint model-observation equality (`ScopedResultRel.resultTheory_eq`,
  `ScopedResultRel.resultTheory_certified_table_eq`, `ScopedResultRel.publicAnswers_eq`)
  against `RecursiveExecution.Contextual.Protocol.resultTheory` / `publicAnswers` / `readout`.
- `ScopedAtomEntryReady`: explicit value-status and frame-readiness invariant required for
  semantic `.atom` entry under `policy` so future-use reentry is never inferred from erased payloads.
- `UnsupportedHostOrSnapshotTask`, `UnsupportedHostOrSnapshotContinuation`, and
  `UnsupportedContextControl`: explicit boundary predicates separating host-world
  snapshot/restore and context-handle operations from the read-only recursive worker.
- `ScopedTaskRel`, `ScopedFrameRel`, `ScopedControlRel`, `ScopedConfigurationRel`:
  constructor-by-constructor structural alignment across all admitted worker/contextual
  control states, continuations, and emitted histories.
- Grant/deepen stability (`ScopedTaskRel.replenish`, `ScopedFrameRel.deepen`,
  `ScopedControlRel.deepen`, `ScopedConfigurationRel.deepen`), public readout equivalence
  (`ScopedConfigurationRel.emitted_public_equiv`, `ScopedConfigurationRel.emitted_publicAnswers_eq`),
  publication/completion step simulation with `RecursiveExecution.Contextual.Protocol.Rule`,
  and continuation / semantic-entry resumption squares.
-/

namespace ScopedRetainedRelation

open FirstSuccessSourceExecution
open FirstSuccessRecursiveStrategy
open FirstSuccessRecursiveExecution
open Spec.Eval Spec.Eval.Completed
open Spec.Type Spec.Type.Presentation Spec.Type.Presentation.Exact
open Spec.Type.Presentation.BindingTheory Spec.Type.RuntimeRefinement
open Spec.Bindings.ScopeObservation

/-- Semantic activation alignment between a worker `Bindings` record and a contextual
`Completed.Frame` (retaining its `ReadoutCertificate` and single-pass substitution table). -/
abbrev ScopedActivationRel (nativeBindings : Bindings) (ctxFrame : Completed.Frame) : Prop :=
  SourceBindingComparison.semantic.FrameRelated nativeBindings ctxFrame.source

/-- Structural result pair alignment: identical erased payload atom and semantically
aligned binding/activation frames. -/
def ScopedResultRel (w : ResultPair) (c : Completed.Result) : Prop :=
  w.1 = c.1.erase ∧ ScopedActivationRel w.2 c.2

/-- Every `ScopedResultRel` pair agrees on its erased atom and satisfies
`BindingTheoryEquivAt` on every caller scope `callerScope`. -/
theorem ScopedResultRel.public_equiv {w : ResultPair} {c : Completed.Result}
    (rel : ScopedResultRel w c) :
    w.1 = (Completed.rawResult c).1 ∧
    ∀ callerScope : List String, BindingTheoryEquivAt callerScope w.2 (Completed.rawResult c).2 :=
  ⟨rel.1, fun callerScope => rel.2.related.theoryEquivAt callerScope⟩

/-- Pointwise `ScopedResultRel` lifts to `List.Forall₂` public observation equivalence
against `cResults.map Completed.rawResult`. -/
theorem ScopedResultRel.forall2_public_equiv
    {wResults : ResultSet} {cResults : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wResults cResults) :
    List.Forall₂
      (fun w s : ResultPair =>
        w.1 = s.1 ∧ ∀ callerScope : List String, BindingTheoryEquivAt callerScope w.2 s.2)
      wResults (cResults.map Completed.rawResult) := by
  rw [List.forall₂_map_right_iff]
  exact rel.imp fun _ _ h => h.public_equiv

/-- Joint model-observation readout for a worker `ResultPair`, reading the caller's
`publicScope` together with the returned atom `w.1` under one satisfying model of `w.2`. -/
def workerResultTheory (publicScope : List String) (w : ResultPair) : Set (List Atom) :=
  observedTuples w.2 (publicScope.map Atom.var ++ [w.1])

/-- Completed multiset answer readout for a worker `ResultSet`. -/
def workerPublicAnswers (publicScope : List String) (answers : ResultSet) :
    Multiset (Set (List Atom)) :=
  (answers.map (workerResultTheory publicScope) : Multiset (Set (List Atom)))

/-- Every `ScopedResultRel` pair has identical joint `resultTheory` observation on
every `publicScope` (`BindingSourceAgreement.theoryEquivAt` + `BindingTheoryEquivAt.observedTuples_eq`). -/
theorem ScopedResultRel.resultTheory_eq {w : ResultPair} {c : Completed.Result}
    (rel : ScopedResultRel w c) (publicScope : List String) :
    workerResultTheory publicScope w =
      RecursiveExecution.Contextual.Protocol.resultTheory publicScope c := by
  unfold workerResultTheory RecursiveExecution.Contextual.Protocol.resultTheory
  rw [rel.1]
  exact (rel.2.related.theoryEquivAt
    (TypeSubst.typeVarsList (publicScope.map Atom.var ++ [c.1.erase]))).observedTuples_eq
    (publicScope.map Atom.var ++ [c.1.erase]) (fun _ h => h)

/-- Combining `ScopedResultRel.resultTheory_eq` with `ReadoutCertificate.observedTuples_eq`
shows that the contextual frame's certified single-pass substitution table preserves
the worker's joint observation on every `publicScope`. -/
theorem ScopedResultRel.resultTheory_certified_table_eq {w : ResultPair} {c : Completed.Result}
    (rel : ScopedResultRel w c) (publicScope : List String) :
    workerResultTheory publicScope w =
      observedTuples c.2.bindings
        ((publicScope.map Atom.var ++ [c.1.erase]).map
          (Entry.Value.eraseEnvironment c.2.environment).apply) := by
  rw [rel.resultTheory_eq publicScope,
    RecursiveExecution.Contextual.Protocol.resultTheory,
    ← c.2.certified.observedTuples_eq]

/-- Pointwise `ScopedResultRel` preserves ordered `resultTheory` lists on every `publicScope`. -/
theorem ScopedResultRel.forall2_resultTheory_eq
    {wResults : ResultSet} {cResults : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wResults cResults) (publicScope : List String) :
    wResults.map (workerResultTheory publicScope) =
      cResults.map (RecursiveExecution.Contextual.Protocol.resultTheory publicScope) := by
  induction rel with
  | nil => rfl
  | cons head _ ih => simp [head.resultTheory_eq publicScope, ih]

/-- Pointwise `ScopedResultRel` preserves the completed multiset answer bag `publicAnswers`
and protocol `readout` verdict on every `publicScope` (preserving answer/caller correlations
and duplicate counts). -/
theorem ScopedResultRel.publicAnswers_eq
    {wResults : ResultSet} {cResults : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wResults cResults) (publicScope : List String) :
    workerPublicAnswers publicScope wResults =
      RecursiveExecution.Contextual.Protocol.publicAnswers publicScope cResults ∧
    workerPublicAnswers publicScope wResults =
      (RecursiveExecution.Contextual.Protocol.readout publicScope).verdict cResults := by
  have hMap := ScopedResultRel.forall2_resultTheory_eq rel publicScope
  exact ⟨congrArg Multiset.ofList hMap, congrArg Multiset.ofList hMap⟩

/-- Value-readiness and frame-read invariant required for semantic `.atom` entry
between the checked worker (which carries plain `Atom` syntax and always reinterprets
expressions) and the contextual machine under `policy`:
1. `ctxVal.erase = value`,
2. Reading `ctxVal` through `cFrame.read policy` erases to `value`, and
3. Either `policy.reentry = .reinterpret` (the checked worker's reentry policy, as in
   `Policy.unmarked`) or the read value is `.active` (`(cFrame.read policy ctxVal).status = .active`).
Administrative continuation squares remain policy-generic over `ScopedTaskRel`, whereas
semantic `.atom` entry squares require `ScopedAtomEntryReady` so future-use reentry is
never inferred from erased payloads alone. -/
def ScopedAtomEntryReady (policy : Policy) (value : Atom)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame) : Prop :=
  ctxVal.erase = value ∧
  (cFrame.read policy ctxVal).erase = value ∧
  (policy.reentry = .reinterpret ∨ (cFrame.read policy ctxVal).status = .active)

/-- Under any reinterpreting policy (`policy.reentry = .reinterpret`, such as `Policy.unmarked`),
any contextual value whose frame read erases to `value` satisfies `ScopedAtomEntryReady`. -/
theorem ScopedAtomEntryReady.of_reinterpret (policy : Policy) (value : Atom)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (valEq : ctxVal.erase = value)
    (readEq : (cFrame.read policy ctxVal).erase = value)
    (reinterp : policy.reentry = .reinterpret) :
    ScopedAtomEntryReady policy value ctxVal cFrame :=
  ⟨valEq, readEq, Or.inl reinterp⟩

/-- Frame-read stability and reentry status are separate entry obligations.
An unassigned open value is fixed as a whole, including its readiness marks. -/
theorem ScopedAtomEntryReady.of_unassigned (policy : Policy) (value : Atom)
    (ctxVal : Entry.Value) (frame : Completed.Frame)
    (erased : ctxVal.erase = value)
    (unassigned : Completed.FrameUnassignedOn frame ctxVal.erase)
    (status : policy.reentry = .reinterpret ∨ ctxVal.status = .active) :
    ScopedAtomEntryReady policy value ctxVal frame := by
  have fixed := unassigned.read_eq policy
  exact ⟨erased,by rw [fixed]; exact erased,by rw [fixed]; exact status⟩

/-- Arbitrary open queries start in an empty frame. A reusing policy still
requires an active entry; reinterpreting policies impose no status premise. -/
theorem ScopedAtomEntryReady.initial (policy : Policy) (value : Entry.Value)
    (status : policy.reentry = .reinterpret ∨ value.status = .active) :
    ScopedAtomEntryReady policy value.erase value Completed.Frame.empty :=
  ScopedAtomEntryReady.of_unassigned policy _ _ _ rfl (Completed.FrameUnassignedOn.empty _) status

/-- A materialized child or RHS is stable under the next frame read, even
when it retains unassigned free variables. The status policy remains explicit. -/
theorem ScopedAtomEntryReady.materialized (policy : Policy) (frame : Completed.Frame)
    (value : Entry.Value)
    (status : policy.reentry = .reinterpret ∨ (frame.read policy value).status = .active) :
    ScopedAtomEntryReady policy (frame.read policy value).erase (frame.read policy value) frame :=
  ScopedAtomEntryReady.of_unassigned policy _ _ _ rfl
    (Completed.FrameUnassignedOn.after_read policy frame value) status

theorem ScopedAtomEntryReady.materialized_reinterpret (policy : Policy) (frame : Completed.Frame)
    (value : Entry.Value) (reinterprets : policy.reentry = .reinterpret) :
    ScopedAtomEntryReady policy (frame.read policy value).erase (frame.read policy value) frame :=
  ScopedAtomEntryReady.materialized policy frame value (Or.inl reinterprets)

/-- The actual source cast preserves entry admission of pending siblings
from the strong key-and-value freshness invariant. No new-key footprint or
materialization of the pending operand is assumed. -/
theorem ScopedAtomEntryReady.after_private_cast
    {policy : Policy} {lookup : TypeLookupRel} {original expected : Atom}
    {before after : Completed.Frame} {forbidden : List String}
    (renewed : Completed.Frame.CastRenewRel policy lookup original expected before after)
    (incoming : (Entry.Value.eraseEnvironment before.environment).Avoids forbidden)
    (expectedFresh : Spec.Type.Presentation.Freshness.AtomAvoids expected forbidden)
    (queriesFresh : ∀ types, lookup before.bindings original expected types →
      ∀ actual ∈ types, Spec.Type.Presentation.Freshness.AtomAvoids actual forbidden)
    (value : Entry.Value)
    (protectedNames : ∀ name ∈ TypeSubst.typeVars value.erase, name ∈ forbidden)
    (status : policy.reentry = .reinterpret ∨ value.status = .active) :
    (Entry.Value.eraseEnvironment after.environment).Avoids forbidden ∧
    ScopedAtomEntryReady policy value.erase value after := by
  have preserved := renewed.pending_reads incoming expectedFresh queriesFresh
  have fixed := preserved.2 value protectedNames
  exact ⟨preserved.1,rfl,by rw [fixed],by rw [fixed]; exact status⟩

/-- Any variable-free active contextual value (such as `.symbol s` or `Entry.Value.ofAtom a`
for variable-free `a`) satisfies `ScopedAtomEntryReady` under every `policy` and `cFrame`. -/
theorem ScopedAtomEntryReady.of_variable_free_active (policy : Policy) (value : Atom)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (valEq : ctxVal.erase = value)
    (active : ctxVal.status = .active)
    (closed : ∀ name, ¬Spec.Match.Merge.AtomOccurs ctxVal.erase name) :
    ScopedAtomEntryReady policy value ctxVal cFrame := by
  have hRead : cFrame.read policy ctxVal = ctxVal :=
    cFrame.read_variable_free policy ctxVal closed
  exact ⟨valEq, hRead.symm ▸ valEq, Or.inr (hRead.symm ▸ active)⟩

/-- Explicit boundary of contextual task constructors that belong to the stateful
snapshot/restore or native host-callback layer outside the read-only recursive worker. -/
inductive UnsupportedHostOrSnapshotTask : RecursiveTasks.Contextual.Task → Prop where
  | capture {rows saved caller} :
      UnsupportedHostOrSnapshotTask (.capture rows saved caller)
  | restore {pairs saved caller} :
      UnsupportedHostOrSnapshotTask (.restore pairs saved caller)
  | nativeBoundary {live scope caller original expected provenance value activation} :
      UnsupportedHostOrSnapshotTask
        (.boundary live scope caller (.native original expected provenance) value activation)
  | nativeBoundaryBatch {live scope caller original expected provenance rows} :
      UnsupportedHostOrSnapshotTask
        (.boundaryBatch live scope caller (.native original expected provenance) rows)

/-- Explicit boundary of contextual continuations that belong to the stateful
snapshot/restore or native host-callback layer. -/
inductive UnsupportedHostOrSnapshotContinuation :
    RecursiveTasks.Contextual.Continuation → Prop where
  | collect {caller} :
      UnsupportedHostOrSnapshotContinuation (.collect caller)
  | nativeBoundaryBatch {live scope caller original expected provenance} :
      UnsupportedHostOrSnapshotContinuation
        (.boundaryBatch live scope caller (.native original expected provenance))

/-- Explicit boundary of contextual control nodes carrying an operational context handle. -/
inductive UnsupportedContextControl : RecursiveTasks.Contextual.Control → Prop where
  | context {label child stack} :
      UnsupportedContextControl (.context label child stack)

/-- Structural task relation between worker `RecursiveTasks.Task` and contextual
`RecursiveTasks.Contextual.Task` across all admitted read-only recursive evaluation modes. -/
inductive ScopedTaskRel : RecursiveTasks.Task → RecursiveTasks.Contextual.Task → Prop where
  | atom {value expected : Atom} {nativeB : Bindings} {fuel : Nat} {wLive cLive : List Atom}
      {scope : List String} {ctxVal : Entry.Value} {ctxFrame : Completed.Frame}
      (erase_eq : ctxVal.erase = value)
      (frame_rel : ScopedActivationRel nativeB ctxFrame)
      (live_rel : ∀ name, name ∈ TypeSubst.typeVarsList wLive ↔ name ∈ TypeSubst.typeVarsList cLive :=
        by intro _; exact Iff.rfl) :
      ScopedTaskRel (.atom value expected nativeB fuel wLive)
        (.atom cLive scope ctxVal expected ctxFrame)
  | expression {value expected : Atom} {nativeB : Bindings} {fuel : Nat} {live : List Atom}
      {scope : List String} {ctxVal : Entry.Value} {ctxFrame : Completed.Frame} :
      ctxVal.erase = value →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.expression value expected nativeB fuel live)
        (.atom live scope ctxVal expected ctxFrame)
  | functions {value expected : Atom} {nativeB : Bindings} {fuel : Nat}
      {types live : List Atom} {scope : List String}
      {ctxVal : Entry.Value} {ctxFrame : Completed.Frame} :
      ctxVal.erase = value →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.functions value expected nativeB fuel types live)
        (.atom live scope ctxVal expected ctxFrame)
  | bindingAlternatives {operator : Atom} {arguments : List Atom}
      {operatorType resultType expected : Atom} {fuel : Nat}
      {alternatives : List Bindings} {live : List Atom} {scope : List String}
      {signature : SelectedTypePolicy} {ctxOp : Entry.Value}
      {ctxArgs : List Entry.Value} {ctxFrames : List Completed.Frame} :
      ctxOp.erase = operator →
      ctxArgs.map Entry.Value.erase = arguments →
      signature.functionType = operatorType →
      Completed.invocationReturnType signature = resultType →
      List.Forall₂ ScopedActivationRel alternatives ctxFrames →
      ScopedTaskRel
        (.bindingAlternatives (.expression (operator :: arguments))
          operatorType resultType fuel alternatives live)
        (.invocations live scope expected signature ctxOp ctxArgs ctxFrames)
  | func {operator : Atom} {arguments : List Atom} {operatorType expected : Atom}
      {nativeB : Bindings} {fuel : Nat} {live : List Atom} {scope : List String}
      {signature : SelectedTypePolicy} {ctxOp : Entry.Value}
      {ctxArgs : List Entry.Value} {ctxFrame : Completed.Frame} :
      ctxOp.erase = operator →
      ctxArgs.map Entry.Value.erase = arguments →
      signature.functionType = operatorType →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.func (.expression (operator :: arguments)) operatorType nativeB fuel live)
        (.function live scope expected signature ctxOp ctxArgs ctxFrame)
  | heads {operatorType : Atom} {arguments : List Atom} {fuel : Nat}
      {alternatives : ResultSet} {live : List Atom} {scope : List String}
      {requests : List Completed.ArgumentRequest} {ctxHeads : List Completed.Result} :
      (requests.map Prod.fst).map Entry.Value.erase = arguments →
      List.Forall₂ ScopedResultRel alternatives ctxHeads →
      ScopedTaskRel (.heads operatorType arguments fuel alternatives live)
        (.functionBranches live scope requests ctxHeads)
  | args {values types : List Atom} {nativeB : Bindings} {fuel : Nat}
      {live : List Atom} {scope : List String}
      {requests : List Completed.ArgumentRequest} {ctxFrame : Completed.Frame} :
      (requests.map Prod.fst).map Entry.Value.erase = values →
      requests.map Prod.snd = types →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.args values types nativeB fuel live)
        (.arguments live scope requests ctxFrame)
  | argumentHeads {original : Atom} {remaining types : List Atom} {fuel : Nat}
      {alternatives : ResultSet} {live : List Atom} {scope : List String}
      {ctxOrig : Entry.Value} {requests : List Completed.ArgumentRequest}
      {ctxHeads : List Completed.Result} :
      ctxOrig.erase = original →
      (requests.map Prod.fst).map Entry.Value.erase = remaining →
      requests.map Prod.snd = types →
      List.Forall₂ ScopedResultRel alternatives ctxHeads →
      ScopedTaskRel (.argumentHeads original remaining types fuel alternatives live)
        (.argumentBranches live scope ctxOrig requests ctxHeads)
  | tuple {atoms : List Atom} {nativeB : Bindings} {fuel : Nat}
      {live : List Atom} {scope : List String}
      {ctxVals : List Entry.Value} {ctxFrame : Completed.Frame} :
      ctxVals.map Entry.Value.erase = atoms →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.tuple (.expression atoms) nativeB fuel live)
        (.tuple live scope ctxVals ctxFrame)
  | tupleHeads {tail : List Atom} {fuel : Nat} {alternatives : ResultSet}
      {live : List Atom} {scope : List String}
      {ctxTail : List Entry.Value} {ctxHeads : List Completed.Result} :
      ctxTail.map Entry.Value.erase = tail →
      List.Forall₂ ScopedResultRel alternatives ctxHeads →
      ScopedTaskRel (.tupleHeads (.expression tail) fuel alternatives live)
        (.branches live scope ctxTail ctxHeads)
  | calls {expected : Atom} {fuel : Nat} {alternatives : ResultSet}
      {live : List Atom} {scope : List String} {ctxRows : List Completed.Result} :
      List.Forall₂ ScopedResultRel alternatives ctxRows →
      ScopedTaskRel (.calls expected fuel alternatives live)
        (.calls live scope expected ctxRows)
  | call {value expected : Atom} {nativeB : Bindings} {fuel : Nat}
      {live : List Atom} {scope : List String}
      {ctxVal : Entry.Value} {ctxFrame : Completed.Frame} :
      ctxVal.erase = value →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.call value expected nativeB fuel live)
        (.call live scope ctxVal expected ctxFrame)
  | returned {original value expected : Atom} {nativeB : Bindings} {fuel : Nat}
      {live : List Atom} {scope : List String}
      {ctxOrig ctxVal : Entry.Value} {ctxFrame : Completed.Frame} :
      ctxOrig.erase = original →
      ctxVal.erase = value →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.returned original value expected nativeB fuel live)
        (.returned live scope ctxOrig expected ctxVal ctxFrame)
  | returns {original expected : Atom} {fuel : Nat} {alternatives : ResultSet}
      {live : List Atom} {scope : List String} {caller : Option Atom}
      {ctxOrig : Entry.Value} {ctxRows : List Completed.Result} :
      ctxOrig.erase = original →
      List.Forall₂ ScopedResultRel alternatives ctxRows →
      ScopedTaskRel (.returns original expected fuel alternatives live)
        (.boundaryBatch live scope caller (.returned ctxOrig expected) ctxRows)
  | invocationRaw {value : Atom} {nativeB : Bindings} {fuel : Nat}
      {live : List Atom} {caller : Option Atom} {scope : List String}
      {ctxVal : Entry.Value} {ctxFrame : Completed.Frame} :
      ctxVal.erase = value →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.invocation .raw value nativeB fuel live caller)
        (.invocation live scope caller ctxVal ctxFrame)
  | produced {value : Atom} {nativeB : Bindings} {fuel : Nat}
      {live : List Atom} {caller : Option Atom} {scope : List String}
      {ctxVal : Entry.Value} {ctxFrame : Completed.Frame} :
      ctxVal.erase = value →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.produced value nativeB fuel live caller .emitted)
        (.boundary live scope caller .producer ctxVal ctxFrame)
  | productions {fuel : Nat} {alternatives : ResultSet}
      {live : List Atom} {caller : Option Atom} {scope : List String}
      {ctxRows : List Completed.Result} :
      List.Forall₂ ScopedResultRel alternatives ctxRows →
      ScopedTaskRel (.productions fuel alternatives live caller .emitted)
        (.boundaryBatch live scope caller .producer ctxRows)
  | minimal {value : Atom} {nativeB : Bindings} {fuel : Nat}
      {live : List Atom} {caller : Option Atom} {scope : List String}
      {ctxVal : Entry.Value} {ctxFrame : Completed.Frame} :
      ctxVal.erase = value →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.minimal value nativeB fuel live caller)
        (.minimal live scope caller ctxVal ctxFrame)
  | minimals {fuel : Nat} {alternatives : ResultSet}
      {live : List Atom} {caller : Option Atom} {scope : List String}
      {ctxRows : List Completed.Result} :
      List.Forall₂ ScopedResultRel alternatives ctxRows →
      ScopedTaskRel (.minimals fuel alternatives live caller)
        (.boundaryBatch live scope caller .producer ctxRows)
  | primitive {value : Atom} {nativeB : Bindings} {fuel : Nat}
      {live : List Atom} {caller : Option Atom} {scope : List String}
      {ctxVal : Entry.Value} {ctxFrame : Completed.Frame} :
      ctxVal.erase = value →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.primitive value nativeB fuel live caller)
        (.minimal live scope caller ctxVal ctxFrame)
  | chainRows {name : String} {template : Atom} {fuel : Nat}
      {alternatives : ResultSet} {live : List Atom} {caller : Option Atom}
      {scope : List String} {ctxTmpl : Entry.Value} {ctxRows : List Completed.Result} :
      ctxTmpl.erase = template →
      List.Forall₂ ScopedResultRel alternatives ctxRows →
      ScopedTaskRel (.chainRows name template fuel alternatives)
        (.boundaryBatch live scope caller (.chain name ctxTmpl) ctxRows)
  | functionBody {value : Atom} {nativeB : Bindings} {fuel : Nat}
      {live : List Atom} {caller : Option Atom} {scope : List String}
      {ctxVal : Entry.Value} {ctxFrame : Completed.Frame} :
      ctxVal.erase = value →
      ScopedActivationRel nativeB ctxFrame →
      ScopedTaskRel (.functionBody value nativeB fuel live caller)
        (.body live scope caller ctxVal ctxFrame)
  | bodyResults {fuel : Nat} {alternatives : ResultSet}
      {live : List Atom} {caller : Option Atom} {scope : List String}
      {ctxRows : List Completed.Result} :
      List.Forall₂ ScopedResultRel alternatives ctxRows →
      ScopedTaskRel (.bodyResults fuel alternatives live caller)
        (.boundaryBatch live scope caller .body ctxRows)

/-- Granting extra depth (`Task.replenish extra`) to any worker task preserves
`ScopedTaskRel` against the same contextual task. -/
theorem ScopedTaskRel.replenish (extra : Nat) {wTask : RecursiveTasks.Task}
    {cTask : RecursiveTasks.Contextual.Task}
    (rel : ScopedTaskRel wTask cTask) :
    ScopedTaskRel (wTask.replenish extra) cTask := by
  cases rel with
  | atom h1 h2 h3 => exact .atom h1 h2 h3
  | expression h1 h2 => exact .expression h1 h2
  | functions h1 h2 => exact .functions h1 h2
  | bindingAlternatives h1 h2 h3 h4 h5 => exact .bindingAlternatives h1 h2 h3 h4 h5
  | func h1 h2 h3 h4 => exact .func h1 h2 h3 h4
  | heads h1 h2 => exact .heads h1 h2
  | args h1 h2 h3 => exact .args h1 h2 h3
  | argumentHeads h1 h2 h3 h4 => exact .argumentHeads h1 h2 h3 h4
  | tuple h1 h2 => exact .tuple h1 h2
  | tupleHeads h1 h2 => exact .tupleHeads h1 h2
  | calls h1 => exact .calls h1
  | call h1 h2 => exact .call h1 h2
  | returned h1 h2 h3 => exact .returned h1 h2 h3
  | returns h1 h2 => exact .returns h1 h2
  | invocationRaw h1 h2 => exact .invocationRaw h1 h2
  | produced h1 h2 => exact .produced h1 h2
  | productions h1 => exact .productions h1
  | minimal h1 h2 => exact .minimal h1 h2
  | minimals h1 => exact .minimals h1
  | primitive h1 h2 => exact .primitive h1 h2
  | chainRows h1 h2 => exact .chainRows h1 h2
  | functionBody h1 h2 => exact .functionBody h1 h2
  | bodyResults h1 => exact .bodyResults h1

/-- Structural continuation frame relation between worker `RecursiveTasks.Frame`
and contextual `RecursiveTasks.Contextual.Continuation`. -/
inductive ScopedFrameRel :
    RecursiveTasks.Frame → RecursiveTasks.Contextual.Continuation → Prop where
  | filter (original : Atom) :
      ScopedFrameRel .filter (.publish original)
  | heads {operatorType : Atom} {arguments : List Atom} {fuel : Nat}
      {live : List Atom} {scope : List String}
      {requests : List Completed.ArgumentRequest} :
      (requests.map Prod.fst).map Entry.Value.erase = arguments →
      ScopedFrameRel (.heads operatorType arguments fuel live)
        (.functionHeads live scope requests)
  | argumentHeads {original : Atom} {remaining types : List Atom} {fuel : Nat}
      {live : List Atom} {scope : List String}
      {ctxOrig : Entry.Value} {requests : List Completed.ArgumentRequest} :
      ctxOrig.erase = original →
      (requests.map Prod.fst).map Entry.Value.erase = remaining →
      requests.map Prod.snd = types →
      ScopedFrameRel (.argumentHeads original remaining types fuel live)
        (.arguments live scope ctxOrig requests)
  | tupleHeads {tail : List Atom} {fuel : Nat} {live : List Atom}
      {scope : List String} {ctxTail : List Entry.Value} :
      ctxTail.map Entry.Value.erase = tail →
      ScopedFrameRel (.tupleHeads (.expression tail) fuel live)
        (.branches live scope ctxTail)
  | calls {expected : Atom} {fuel : Nat} {live : List Atom} {scope : List String} :
      ScopedFrameRel (.calls expected fuel live) (.calls live scope expected)
  | functionTail {head : Atom} {ctxHead : Entry.Value} :
      ctxHead.erase = head →
      ScopedFrameRel (.functionTail head) (.functionAssemble ctxHead)
  | argumentTail {head : Atom} {ctxHead : Entry.Value} :
      ctxHead.erase = head →
      ScopedFrameRel (.argumentTail head) (.argumentTail ctxHead)
  | tupleSingleton :
      ScopedFrameRel .tupleSingleton .singleton
  | tupleTail {head : Atom} {ctxHead : Entry.Value} :
      ctxHead.erase = head →
      ScopedFrameRel (.tupleTail head) (.tupleTail ctxHead)
  | append {wTask : RecursiveTasks.Task} {cTask : RecursiveTasks.Contextual.Task} :
      ScopedTaskRel wTask cTask →
      ScopedFrameRel (.append wTask) (.append cTask)
  | prepend {wSelected : ResultSet} {cSelected : List Completed.Result} :
      List.Forall₂ ScopedResultRel wSelected cSelected →
      ScopedFrameRel (.prepend wSelected) (.prepend cSelected)
  | prependDiagnostics {nativeB : Bindings} {errors : List Atom} {ctxFrame : Completed.Frame} :
      ScopedActivationRel nativeB ctxFrame →
      ScopedFrameRel (.prepend (errors.map fun error => (error, nativeB)))
        (.diagnostics errors ctxFrame)
  | fallback {value expected : Atom} {nativeB : Bindings} {fuel : Nat}
      {types errors : List Atom} {ctxFrame : Completed.Frame} :
      ScopedActivationRel nativeB ctxFrame →
      ScopedFrameRel (.fallback value expected nativeB fuel types)
        (.diagnostics errors ctxFrame)
  | invocationReturnOrdinary {original expected : Atom} {fuel : Nat}
      {live : List Atom} {scope : List String} {caller : Option Atom}
      {ctxOrig : Entry.Value} :
      ctxOrig.erase = original →
      ScopedFrameRel (.invocationReturn (.ordinary expected) original fuel live)
        (.boundaryBatch live scope caller (.returned ctxOrig expected))
  | producerResults {mode : InvocationMode} {original : Atom} {incoming : Bindings}
      {fuel : Nat} {live : List Atom} {emptyReply : Atom}
      {scope : List String} {caller : Option Atom} :
      ScopedFrameRel (.producerResults mode original incoming fuel live emptyReply)
        (.boundaryBatch live scope caller .producer)
  | minimalResults {fuel : Nat} {live : List Atom} {caller : Option Atom}
      {scope : List String} :
      ScopedFrameRel (.minimalResults fuel live caller)
        (.boundaryBatch live scope caller .producer)
  | chainResults {name : String} {template : Atom} {fuel : Nat}
      {live : List Atom} {caller : Option Atom} {scope : List String}
      {ctxTmpl : Entry.Value} :
      ctxTmpl.erase = template →
      ScopedFrameRel (.chainResults name template fuel)
        (.boundaryBatch live scope caller (.chain name ctxTmpl))
  | functionTerminal {caller : Option Atom} {live : List Atom} {scope : List String} :
      ScopedFrameRel (.functionTerminal caller)
        (.boundaryBatch live scope caller .functionDone)
  | bodyResults {fuel : Nat} {live : List Atom} {caller : Option Atom}
      {scope : List String} :
      ScopedFrameRel (.bodyResults fuel live caller)
        (.boundaryBatch live scope caller .body)

/-- Deepening a worker continuation frame (`Frame.deepen extra`) preserves
`ScopedFrameRel` against the same contextual continuation. -/
theorem ScopedFrameRel.deepen (extra : Nat) {wFrame : RecursiveTasks.Frame}
    {cCont : RecursiveTasks.Contextual.Continuation}
    (rel : ScopedFrameRel wFrame cCont) :
    ScopedFrameRel (wFrame.deepen extra) cCont := by
  cases rel with
  | filter orig => exact .filter orig
  | heads h1 => exact .heads h1
  | argumentHeads h1 h2 h3 => exact .argumentHeads h1 h2 h3
  | tupleHeads h1 => exact .tupleHeads h1
  | calls => exact .calls
  | functionTail h1 => exact .functionTail h1
  | argumentTail h1 => exact .argumentTail h1
  | tupleSingleton => exact .tupleSingleton
  | tupleTail h1 => exact .tupleTail h1
  | append h1 => exact .append (h1.replenish extra)
  | prepend h1 => exact .prepend h1
  | prependDiagnostics h1 => exact .prependDiagnostics h1
  | fallback h1 => exact .fallback h1
  | invocationReturnOrdinary h1 => exact .invocationReturnOrdinary h1
  | producerResults => exact .producerResults
  | minimalResults => exact .minimalResults
  | chainResults h1 => exact .chainResults h1
  | functionTerminal => exact .functionTerminal
  | bodyResults => exact .bodyResults

/-- Deepening an entire worker stack preserves `List.Forall₂ ScopedFrameRel`. -/
theorem ScopedFrameRel.forall2_deepen (extra : Nat)
    {wStack : List RecursiveTasks.Frame}
    {cStack : List RecursiveTasks.Contextual.Continuation}
    (rel : List.Forall₂ ScopedFrameRel wStack cStack) :
    List.Forall₂ ScopedFrameRel (wStack.map (Frame.deepen extra)) cStack := by
  rw [List.forall₂_map_left_iff]
  exact rel.imp fun _ _ h => h.deepen extra

/-- Structural control relation between worker `RecursiveTasks.Control` and
contextual `RecursiveTasks.Contextual.Control`. -/
inductive ScopedControlRel :
    RecursiveTasks.Control → RecursiveTasks.Contextual.Control → Prop where
  | work {wTask : RecursiveTasks.Task} {cTask : RecursiveTasks.Contextual.Task} :
      ScopedTaskRel wTask cTask →
      ScopedControlRel (.work wTask) (.work cTask)
  | returning {wResults : ResultSet} {cResults : List Completed.Result} :
      List.Forall₂ ScopedResultRel wResults cResults →
      ScopedControlRel (.returning wResults) (.returning cResults)

/-- Deepening a worker control (`Control.deepen extra`) preserves `ScopedControlRel`. -/
theorem ScopedControlRel.deepen (extra : Nat)
    {wCtrl : RecursiveTasks.Control} {cCtrl : RecursiveTasks.Contextual.Control}
    (rel : ScopedControlRel wCtrl cCtrl) :
    ScopedControlRel (wCtrl.deepen extra) cCtrl := by
  cases rel with
  | work h => exact .work (h.replenish extra)
  | returning h => exact .returning h

/-- Full structural configuration alignment between the checked configuration-scoped
worker and the contextual machine, retaining identical spaces, structurally aligned
control states, pointwise aligned continuation stacks, and pointwise aligned emitted
publication histories. -/
structure ScopedConfigurationRel
    (wCfg : Configuration) (cCfg : RecursiveTasks.Contextual.Configuration) : Prop where
  space_eq : wCfg.space = cCfg.space
  control_rel : ScopedControlRel wCfg.control cCfg.control
  stack_rel : List.Forall₂ ScopedFrameRel wCfg.stack cCfg.stack
  emitted_rel : List.Forall₂ ScopedResultRel wCfg.emitted cCfg.emitted

/-- Granting extra depth (`wCfg.deepen extra`) to any worker configuration preserves
`ScopedConfigurationRel` against the same contextual configuration. -/
theorem ScopedConfigurationRel.deepen (extra : Nat)
    {wCfg : Configuration} {cCfg : RecursiveTasks.Contextual.Configuration}
    (rel : ScopedConfigurationRel wCfg cCfg) :
    ScopedConfigurationRel (wCfg.deepen extra) cCfg :=
  ⟨rel.space_eq, rel.control_rel.deepen extra,
   ScopedFrameRel.forall2_deepen extra rel.stack_rel, rel.emitted_rel⟩

/-- Replenishing only the pending operation (`RecursiveMachine.Checked.replenish extra wCfg`)
preserves both `ScopedConfigurationRel` and `invocationTypes` (`Checked.invocationTypes_replenish`). -/
theorem ScopedConfigurationRel.replenish (extra : Nat)
    {wCfg : Configuration} {cCfg : RecursiveTasks.Contextual.Configuration}
    (rel : ScopedConfigurationRel wCfg cCfg) :
    ScopedConfigurationRel (RecursiveMachine.Checked.replenish extra wCfg) cCfg ∧
    invocationTypes (RecursiveMachine.Checked.replenish extra wCfg) = invocationTypes wCfg := by
  refine ⟨?_, Checked.invocationTypes_replenish extra wCfg⟩
  rcases wCfg with ⟨space, control, stack, emitted⟩
  rcases cCfg with ⟨cSpace, cCtrl, cStack, cEmitted⟩
  rcases rel with ⟨spaceEq, ctrlRel, stackRel, emittedRel⟩
  dsimp only at spaceEq ctrlRel stackRel emittedRel
  cases ctrlRel with
  | work h =>
      exact ⟨spaceEq, .work (h.replenish extra), stackRel, emittedRel⟩
  | @returning wResults cResults h =>
      cases stackRel with
      | nil => exact ⟨spaceEq, .returning h, .nil, emittedRel⟩
      | @cons wFrame cFrame wRest cRest fRel restRel =>
          cases fRel with
          | filter orig => exact ⟨spaceEq, .returning h, .cons (.filter orig) restRel, emittedRel⟩
          | heads h1 => exact ⟨spaceEq, .returning h, .cons (.heads h1) restRel, emittedRel⟩
          | argumentHeads h1 h2 h3 => exact ⟨spaceEq, .returning h, .cons (.argumentHeads h1 h2 h3) restRel, emittedRel⟩
          | tupleHeads h1 => exact ⟨spaceEq, .returning h, .cons (.tupleHeads h1) restRel, emittedRel⟩
          | calls => exact ⟨spaceEq, .returning h, .cons .calls restRel, emittedRel⟩
          | functionTail h1 => exact ⟨spaceEq, .returning h, .cons (.functionTail h1) restRel, emittedRel⟩
          | argumentTail h1 => exact ⟨spaceEq, .returning h, .cons (.argumentTail h1) restRel, emittedRel⟩
          | tupleSingleton => exact ⟨spaceEq, .returning h, .cons .tupleSingleton restRel, emittedRel⟩
          | tupleTail h1 => exact ⟨spaceEq, .returning h, .cons (.tupleTail h1) restRel, emittedRel⟩
          | append h1 => exact ⟨spaceEq, .returning h, .cons (.append h1) restRel, emittedRel⟩
          | prepend h1 => exact ⟨spaceEq, .returning h, .cons (.prepend h1) restRel, emittedRel⟩
          | prependDiagnostics h1 => exact ⟨spaceEq, .returning h, .cons (.prependDiagnostics h1) restRel, emittedRel⟩
          | fallback h1 => exact ⟨spaceEq, .returning h, .cons (.fallback h1) restRel, emittedRel⟩
          | invocationReturnOrdinary h1 => exact ⟨spaceEq, .returning h, .cons (.invocationReturnOrdinary h1) restRel, emittedRel⟩
          | producerResults => exact ⟨spaceEq, .returning h, .cons .producerResults restRel, emittedRel⟩
          | minimalResults => exact ⟨spaceEq, .returning h, .cons .minimalResults restRel, emittedRel⟩
          | chainResults h1 => exact ⟨spaceEq, .returning h, .cons (.chainResults h1) restRel, emittedRel⟩
          | functionTerminal => exact ⟨spaceEq, .returning h, .cons .functionTerminal restRel, emittedRel⟩
          | bodyResults => exact ⟨spaceEq, .returning h, .cons .bodyResults restRel, emittedRel⟩

/-- Any pair of configurations related by `ScopedConfigurationRel` has public
observation equivalence (`BindingTheoryEquivAt`) across all emitted results on
every caller scope `callerScope`. -/
theorem ScopedConfigurationRel.emitted_public_equiv
    {wCfg : Configuration} {cCfg : RecursiveTasks.Contextual.Configuration}
    (rel : ScopedConfigurationRel wCfg cCfg) :
    List.Forall₂
      (fun w s : ResultPair =>
        w.1 = s.1 ∧ ∀ callerScope : List String, BindingTheoryEquivAt callerScope w.2 s.2)
      wCfg.emitted (cCfg.emitted.map Completed.rawResult) :=
  ScopedResultRel.forall2_public_equiv rel.emitted_rel

/-- Any pair of configurations related by `ScopedConfigurationRel` has identical
completed multiset answer bags `publicAnswers` and `readout` verdicts across all
emitted results on every `publicScope` (preserving answer/caller correlations
and duplicate counts). -/
theorem ScopedConfigurationRel.emitted_publicAnswers_eq
    {wCfg : Configuration} {cCfg : RecursiveTasks.Contextual.Configuration}
    (rel : ScopedConfigurationRel wCfg cCfg) (publicScope : List String) :
    workerPublicAnswers publicScope wCfg.emitted =
      RecursiveExecution.Contextual.Protocol.publicAnswers publicScope cCfg.emitted ∧
    workerPublicAnswers publicScope wCfg.emitted =
      (RecursiveExecution.Contextual.Protocol.readout publicScope).verdict cCfg.emitted :=
  ScopedResultRel.publicAnswers_eq rel.emitted_rel publicScope

/-- Occurrence-preserving alignment of retained publications, independently
of their internal enumeration. Completion of HE search is a separate judgment. -/
def ScopedEmittedBagRel (worker : ResultSet) (contextual : List Completed.Result) : Prop :=
  ∃ ordered : ResultSet, worker.Perm ordered ∧ List.Forall₂ ScopedResultRel ordered contextual

namespace ScopedEmittedBagRel

theorem of_forall2 {worker : ResultSet} {contextual : List Completed.Result}
    (related : List.Forall₂ ScopedResultRel worker contextual) :
    ScopedEmittedBagRel worker contextual := ⟨worker, List.Perm.refl _, related⟩

theorem length_eq {worker : ResultSet} {contextual : List Completed.Result}
    (related : ScopedEmittedBagRel worker contextual) : worker.length = contextual.length := by
  obtain ⟨ordered, permuted, paired⟩ := related
  exact permuted.length_eq.trans paired.length_eq

/-- Joint caller/answer observations agree at every public scope. A policy
change is not counted as an additional answer occurrence. -/
theorem publicAnswers_eq {worker : ResultSet} {contextual : List Completed.Result}
    (related : ScopedEmittedBagRel worker contextual) (publicScope : List String) :
    workerPublicAnswers publicScope worker =
      RecursiveExecution.Contextual.Protocol.publicAnswers publicScope contextual ∧
    workerPublicAnswers publicScope worker =
      (RecursiveExecution.Contextual.Protocol.readout publicScope).verdict contextual := by
  obtain ⟨ordered, permuted, paired⟩ := related
  have same : workerPublicAnswers publicScope worker = workerPublicAnswers publicScope ordered :=
    Multiset.coe_eq_coe.mpr (permuted.map (workerResultTheory publicScope))
  exact ⟨same.trans (ScopedResultRel.publicAnswers_eq paired publicScope).1,
    same.trans (ScopedResultRel.publicAnswers_eq paired publicScope).2⟩

/-- Reordering the worker's retained publications preserves bag alignment. -/
theorem perm_left {first second : ResultSet} {contextual : List Completed.Result}
    (same : first.Perm second) (related : ScopedEmittedBagRel second contextual) :
    ScopedEmittedBagRel first contextual := by
  obtain ⟨ordered, permuted, paired⟩ := related
  exact ⟨ordered, same.trans permuted, paired⟩

/-- Negative control: an occurrence bijection cannot discard a duplicate. -/
theorem no_duplicate_drop (worker : ResultPair) (contextual : Completed.Result) :
    ¬ScopedEmittedBagRel [worker, worker] [contextual] := by
  intro related
  have impossible := related.length_eq
  simp at impossible

end ScopedEmittedBagRel

/-- The fixed-traversal configuration relation supplies the more general
publication contract; its internal lockstep order is not the HE observer. -/
theorem ScopedConfigurationRel.emitted_bag_rel
    {worker : Configuration} {contextual : RecursiveTasks.Contextual.Configuration}
    (related : ScopedConfigurationRel worker contextual) :
    ScopedEmittedBagRel worker.emitted contextual.emitted :=
  .of_forall2 related.emitted_rel

/-- Concatenation of result batches related by `ScopedResultRel`. -/
theorem ScopedResultRel.forall2_append
    {w1 w2 : ResultSet} {c1 c2 : List Completed.Result}
    (h1 : List.Forall₂ ScopedResultRel w1 c1)
    (h2 : List.Forall₂ ScopedResultRel w2 c2) :
    List.Forall₂ ScopedResultRel (w1 ++ w2) (c1 ++ c2) := by
  induction h1 with
  | nil => exact h2
  | cons head _ ih => exact .cons head ih

/-- Singleton-tuple assembly preserves `ScopedResultRel`. -/
theorem ScopedResultRel.tupleSingleton
    {w : ResultPair} {c : Completed.Result}
    (rel : ScopedResultRel w c) :
    ScopedResultRel (HE.tupleSingleton w) (Completed.tupleSingleton c) := by
  rcases rel with ⟨hVal, hAct⟩
  unfold HE.tupleSingleton Completed.tupleSingleton
  rw [hVal]
  split
  · exact ⟨hVal, hAct⟩
  · exact ⟨by simp [Entry.Value.erase], hAct⟩

/-- Pointwise singleton-tuple assembly preserves `List.Forall₂ ScopedResultRel`. -/
theorem ScopedResultRel.forall2_tupleSingleton
    {wResults : ResultSet} {cResults : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wResults cResults) :
    List.Forall₂ ScopedResultRel
      (wResults.map HE.tupleSingleton)
      (cResults.map Completed.tupleSingleton) := by
  rw [List.forall₂_map_left_iff, List.forall₂_map_right_iff]
  exact rel.imp fun _ _ h => h.tupleSingleton

/-- Tuple-head prepending preserves `ScopedResultRel`. -/
theorem ScopedResultRel.tupleTail
    {head : Atom} {ctxHead : Entry.Value} (hHead : ctxHead.erase = head)
    {w : ResultPair} {c : Completed.Result}
    (rel : ScopedResultRel w c) :
    ScopedResultRel
      (if isEmptyOrError w.1 then (w.1, w.2)
       else (.expression (head :: atomElements w.1), w.2))
      (Completed.tuplePrepend ctxHead c) := by
  rcases w with ⟨wAtom, wB⟩
  rcases c with ⟨cVal, cFrame⟩
  rcases rel with ⟨hVal, hAct⟩
  dsimp only at hVal hAct ⊢
  unfold Completed.tuplePrepend
  dsimp only
  rw [hVal]
  split
  · exact ⟨rfl, hAct⟩
  · refine ⟨?_, hAct⟩
    cases hc : cVal <;> simp [Entry.Value.erase, atomElements, hHead]

/-- Pointwise tuple-head prepending preserves `List.Forall₂ ScopedResultRel`. -/
theorem ScopedResultRel.forall2_tupleTail
    {head : Atom} {ctxHead : Entry.Value} (hHead : ctxHead.erase = head)
    {wResults : ResultSet} {cResults : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wResults cResults) :
    List.Forall₂ ScopedResultRel
      (RecursiveTasks.tupleTail head wResults)
      (cResults.map (Completed.tuplePrepend ctxHead)) := by
  unfold RecursiveTasks.tupleTail
  rw [List.forall₂_map_left_iff, List.forall₂_map_right_iff]
  exact rel.imp fun _ _ h => h.tupleTail hHead

/-- Function-head assembly preserves `ScopedResultRel`. -/
theorem ScopedResultRel.functionTail
    {head : Atom} {ctxHead : Entry.Value} (hHead : ctxHead.erase = head)
    {w : ResultPair} {c : Completed.Result}
    (rel : ScopedResultRel w c) :
    ScopedResultRel
      (if argumentsSucceeded w.1 = false then (w.1, w.2)
       else (.expression (head :: argumentValues w.1), w.2))
      (Completed.functionAssemble ctxHead c) := by
  rcases w with ⟨wAtom, wB⟩
  rcases c with ⟨cVal, cFrame⟩
  rcases rel with ⟨rfl, hAct⟩
  dsimp only at hAct ⊢
  unfold Completed.functionAssemble
  dsimp only
  have hUnpackErase := Entry.Value.unpackArguments_erases cVal
  cases hUnpack : cVal.unpackArguments with
  | none =>
      rw [hUnpack] at hUnpackErase
      have hNone : HE.unpackArguments cVal.erase = none := hUnpackErase.symm
      have hFalse : argumentsSucceeded cVal.erase = false := by
        simp [argumentsSucceeded, hNone]
      simp only [hFalse, ↓reduceIte]
      exact ⟨rfl, hAct⟩
  | some values =>
      rw [hUnpack] at hUnpackErase
      have hSome : HE.unpackArguments cVal.erase = some (values.map Entry.Value.erase) :=
        hUnpackErase.symm
      have hTrue : argumentsSucceeded cVal.erase = true := by
        simp [argumentsSucceeded, hSome]
      have hArgs : argumentValues cVal.erase = values.map Entry.Value.erase := by
        simp [argumentValues, hSome]
      simp only [hTrue, Bool.true_eq_false, ↓reduceIte, hArgs]
      exact ⟨by simp [Entry.Value.erase, hHead], hAct⟩

/-- Pointwise function-head assembly preserves `List.Forall₂ ScopedResultRel`. -/
theorem ScopedResultRel.forall2_functionTail
    {head : Atom} {ctxHead : Entry.Value} (hHead : ctxHead.erase = head)
    {wResults : ResultSet} {cResults : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wResults cResults) :
    List.Forall₂ ScopedResultRel
      (RecursiveTasks.functionTail head wResults)
      (cResults.map (Completed.functionAssemble ctxHead)) := by
  unfold RecursiveTasks.functionTail
  rw [List.forall₂_map_left_iff, List.forall₂_map_right_iff]
  exact rel.imp fun _ _ h => h.functionTail hHead

/-- Argument-head prepending preserves `ScopedResultRel`. -/
theorem ScopedResultRel.argumentTail
    {head : Atom} {ctxHead : Entry.Value} (hHead : ctxHead.erase = head)
    {w : ResultPair} {c : Completed.Result}
    (rel : ScopedResultRel w c) :
    ScopedResultRel
      (if argumentsSucceeded w.1 = false then (w.1, w.2)
       else (argumentPacket (head :: argumentValues w.1), w.2))
      (Completed.argumentPrepend ctxHead c) := by
  rcases w with ⟨wAtom, wB⟩
  rcases c with ⟨cVal, cFrame⟩
  rcases rel with ⟨rfl, hAct⟩
  dsimp only at hAct ⊢
  unfold Completed.argumentPrepend
  dsimp only
  have hUnpackErase := Entry.Value.unpackArguments_erases cVal
  cases hUnpack : cVal.unpackArguments with
  | none =>
      rw [hUnpack] at hUnpackErase
      have hNone : HE.unpackArguments cVal.erase = none := hUnpackErase.symm
      have hFalse : argumentsSucceeded cVal.erase = false := by
        simp [argumentsSucceeded, hNone]
      simp only [hFalse, ↓reduceIte]
      exact ⟨rfl, hAct⟩
  | some values =>
      rw [hUnpack] at hUnpackErase
      have hSome : HE.unpackArguments cVal.erase = some (values.map Entry.Value.erase) :=
        hUnpackErase.symm
      have hTrue : argumentsSucceeded cVal.erase = true := by
        simp [argumentsSucceeded, hSome]
      have hArgs : argumentValues cVal.erase = values.map Entry.Value.erase := by
        simp [argumentValues, hSome]
      simp only [hTrue, Bool.true_eq_false, ↓reduceIte, hArgs]
      exact ⟨by simp [Entry.Value.erase_argumentPacket, hHead], hAct⟩

/-- Pointwise argument-head prepending preserves `List.Forall₂ ScopedResultRel`. -/
theorem ScopedResultRel.forall2_argumentTail
    {head : Atom} {ctxHead : Entry.Value} (hHead : ctxHead.erase = head)
    {wResults : ResultSet} {cResults : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wResults cResults) :
    List.Forall₂ ScopedResultRel
      (RecursiveTasks.argumentTail head wResults)
      (cResults.map (Completed.argumentPrepend ctxHead)) := by
  unfold RecursiveTasks.argumentTail
  rw [List.forall₂_map_left_iff, List.forall₂_map_right_iff]
  exact rel.imp fun _ _ h => h.argumentTail hHead

/-- Separate Grant Correspondence at Depth 0 (`ScopedConfigurationRel.atom_zero_suspends_and_grants`):
When a worker `.atom` task has exhausted its evaluator depth (`fuel = 0`) while aligned
with a contextual `.atom` task under `ScopedConfigurationRel`, the checked worker suspends
with `.call .evaluationDepth wBefore` (never erasing depth exhaustion into completed failure),
and granting any positive depth `extra + 1` via either `wBefore.deepen (extra + 1)` or
`RecursiveMachine.Checked.replenish (extra + 1) wBefore` preserves `ScopedConfigurationRel`
against the unchanged contextual configuration `cBefore`, while `replenish` also preserves
`invocationTypes` (`Checked.invocationTypes_replenish`). -/
theorem ScopedConfigurationRel.atom_zero_suspends_and_grants
    (space : Space) (dispatch : HE.GroundedDispatch) (extra : Nat)
    (value expected : Atom) (wB : Bindings) (live : List Atom)
    (scope : List String) (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (valEq : ctxVal.erase = value)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.atom value expected wB 0 live), wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal expected cFrame), cStack, cEmitted⟩
    ScopedConfigurationRel wBefore cBefore ∧
    (Checked.machine dispatch scopedTypes).step wBefore =
      some (.call .evaluationDepth wBefore) ∧
    ScopedConfigurationRel (wBefore.deepen (extra + 1)) cBefore ∧
    ScopedConfigurationRel (RecursiveMachine.Checked.replenish (extra + 1) wBefore) cBefore ∧
    invocationTypes (RecursiveMachine.Checked.replenish (extra + 1) wBefore) =
      invocationTypes wBefore := by
  intro wBefore cBefore
  have baseRel : ScopedConfigurationRel wBefore cBefore :=
    ⟨rfl, .work (.atom valEq actRel), stackRel, emittedRel⟩
  exact ⟨baseRel, rfl, baseRel.deepen (extra + 1), baseRel.replenish (extra + 1)⟩

/-- Commuting Publication Square (`ScopedConfigurationRel.publish_step`):
When related configurations are at `.returning (head :: tail)` with an empty stack,
both the checked worker and `RecursiveExecution.Contextual.Protocol.Rule` publish
the head occurrence and transition to `.returning tail` while preserving
`ScopedConfigurationRel` and public readout equivalence. -/
theorem ScopedConfigurationRel.publish_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (wHead : ResultPair) (wTail wEmitted : ResultSet)
    (cHead : Completed.Result) (cTail cEmitted : List Completed.Result)
    (headRel : ScopedResultRel wHead cHead)
    (tailRel : List.Forall₂ ScopedResultRel wTail cTail)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration := ⟨space, .returning (wHead :: wTail), [], wEmitted⟩
    let wAfter : Configuration := ⟨space, .returning wTail, [], wEmitted ++ [wHead]⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning (cHead :: cTail), [], cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning cTail, [], cEmitted ++ [cHead]⟩
    (Checked.machine dispatch scopedTypes).step wBefore =
      some (.publish [wHead] wAfter) ∧
    RecursiveMachine.Contextual.Step hostDispatch Completed.scopedLookup policy cBefore cAfter ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.publish [cHead] cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  refine ⟨rfl, .publish, .published, ?_⟩
  exact ⟨rfl, .returning tailRel, .nil,
    ScopedResultRel.forall2_append emittedRel (.cons headRel .nil)⟩

/-- Commuting Terminal Completion Square (`ScopedConfigurationRel.finish_step`):
When related configurations are at `.returning []` with an empty stack, both the
checked worker and `RecursiveExecution.Contextual.Protocol.Rule` emit `.finish`
with public observation equivalence across the entire accumulated history. -/
theorem ScopedConfigurationRel.finish_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wFinal : Configuration := ⟨space, .returning [], [], wEmitted⟩
    let cFinal : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [], [], cEmitted⟩
