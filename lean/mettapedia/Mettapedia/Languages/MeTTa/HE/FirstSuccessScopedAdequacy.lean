            .append (.equations live scope ctxCall expected cFrameIn []) :: cStack)
        (.returning [],
          .prepend [(ctxFinalVal, cFrameOut)] ::
            .append (.equations live scope ctxCall expected cFrameIn []) :: cStack) :=
    .boundaryBatchNil
  have cLocal8 :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (.returning [],
          .prepend [(ctxFinalVal, cFrameOut)] ::
            .append (.equations live scope ctxCall expected cFrameIn []) :: cStack)
        (.returning [(ctxFinalVal, cFrameOut)],
          .append (.equations live scope ctxCall expected cFrameIn []) :: cStack) := by
    simpa only [List.append_nil] using
      (RecursiveMachine.Contextual.LocalStep.prepend
        (selected := [(ctxFinalVal, cFrameOut)]) (results := []))
  have cLocal9 :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (.returning [(ctxFinalVal, cFrameOut)],
          .append (.equations live scope ctxCall expected cFrameIn []) :: cStack)
        (.work (.equations live scope ctxCall expected cFrameIn []),
          .prepend [(ctxFinalVal, cFrameOut)] :: cStack) :=
    .append
  have cLocal10 :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (.work (.equations live scope ctxCall expected cFrameIn []),
          .prepend [(ctxFinalVal, cFrameOut)] :: cStack)
        (.returning [],
          .prepend [(ctxFinalVal, cFrameOut)] :: cStack) :=
    .equationsNil
  have cLocal11 :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (.returning [],
          .prepend [(ctxFinalVal, cFrameOut)] :: cStack)
        (.returning [(ctxFinalVal, cFrameOut)], cStack) := by
    simpa only [List.append_nil] using
      (RecursiveMachine.Contextual.LocalStep.prepend
        (selected := [(ctxFinalVal, cFrameOut)]) (results := []))
  have cLocalSteps :
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (.work (.call live scope ctxCall expected cFrameIn), cStack)
        (.returning [(ctxFinalVal, cFrameOut)], cStack) := by
    have p1 := ((Relation.ReflTransGen.single cLocal1).tail cLocal2).trans prodRun.2
    have p2 := (((p1.tail cLocal3).tail cLocal4).tail cLocal5).trans retRun.2
    exact (((((p2.tail cLocal6).tail cLocal7).tail cLocal8).tail cLocal9).tail cLocal10).tail cLocal11
  have cSilentAll :
      ContextualSilentPath hostDispatch Completed.scopedLookup policy
        ⟨space, .work (.call live scope ctxCall expected cFrameIn), cStack, cEmitted⟩
        ⟨space, .returning [(ctxFinalVal, cFrameOut)], cStack, cEmitted⟩ :=
    localSteps_to_contextualSilentPath cLocalSteps
  have startRel :
      ScopedConfigurationRel
        ⟨space, .work (.call expr expected wBIn (fuel + 1) live), wStack, wEmitted⟩
        ⟨space, .work (.call live scope ctxCall expected cFrameIn), cStack, cEmitted⟩ :=
    ⟨rfl, .work (.call valEq actIn), stackRel, emittedRel⟩
  have endRel :
      ScopedConfigurationRel
        ⟨space, .returning [(finalVal, wBOut)], wStack, wEmitted⟩
        ⟨space, .returning [(ctxFinalVal, cFrameOut)], cStack, cEmitted⟩ :=
    ⟨rfl, .returning (.cons ⟨finalEq.symm, actOut⟩ .nil), stackRel, emittedRel⟩
  exact ⟨runAll, wRun0, cLocalSteps, localSteps_to_steps cLocalSteps, cSilentAll, endRel,
    ScopedSilentBlock.of_multi_step (by omega) startRel endRel wRun0 cSilentAll⟩

/-- Complete End-to-End Equation-Defined Function Invocation to Caller Publish Square
(`scoped_open_equation_invocation_complete_to_caller_publish_square`):
Composes `scoped_open_invocations_complete_to_caller_publish_square` (typed function head +
arbitrary-arity argument spine + function assembly + drain + caller `.filter`/`.publish`) with
`scoped_open_callEquations_single_complete_square` (equation query, unification, producer boundary,
and return evaluation) into a single `opSteps + argSteps + prodSteps + retSteps + 34`-step
simulation from `.work (.bindingAlternatives ... [wBIn])` / `.work (.invocations ... [cFrameIn])`
through caller `.filter` / `.publish` over any caller stack `wStack` / `cStack`, preserving
`ScopedConfigurationRel` and `ScopedSilentBlock`. -/
theorem scoped_open_equation_invocation_complete_to_caller_publish_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (opAtom opVal expected callAtom rhs wBodyVal prodVal finalVal : Atom)
    (signature : SelectedTypePolicy)
    (ctxOp ctxOpVal ctxProdVal ctxFinalVal : Entry.Value)
    (argAtoms retVals : List Atom) (ctxArgs ctxRetVals : List Entry.Value)
    (wBIn wBHead wBArgs selected wBEqMid wBProd wBOut : Bindings)
    (cFrameIn cFrameHead cFrameArgs cFrameEqMid cFrameProd cFrameOut : Completed.Frame)
    (work : Spec.Eval.Steps.EquationWork)
    (fuel opSteps argSteps prodSteps retSteps depth : Nat)
    (live : List Atom) (scope : List String)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (opEq : ctxOp.erase = opAtom)
    (opValEq : ctxOpVal.erase = opVal)
    (finalEq : ctxFinalVal.erase = finalVal)
    (argsEq : ctxArgs.map Entry.Value.erase = argAtoms)
    (retValsEq : ctxRetVals.map Entry.Value.erase = retVals)
    (arityEq : ctxArgs.length = signature.argumentTypes.length)
    (argTypesEq : getFunctionArgTypes signature.functionType = some signature.argumentTypes)
    (notStoppedOp : isEmptyOrError opVal = false)
    (notErrorCall : isErrorAtom (.expression (opVal :: retVals)) = false)
    (notExec :
      ∀ op args,
        Atom.expression (opVal :: retVals) = .expression (op :: args) →
        dispatch.isExecutable op = false)
    (nonGrounded :
      NonGroundedCallRel hostDispatch
        (Entry.Value.expression .active (ctxOpVal :: ctxRetVals)).erase)
    (notMin : minimalInstruction (.expression (opVal :: retVals)) = false)
    (queryCovered :
      queryEquationsCovered
        (equationScope live (.expression (opVal :: retVals))
          (Completed.invocationReturnType signature) wBArgs)
        space (.expression (opVal :: retVals)) (fuel + 1) = true)
    (queryEq :
      queryEquationsAvoiding
        (equationScope live (.expression (opVal :: retVals))
          (Completed.invocationReturnType signature) wBArgs)
        space (.expression (opVal :: retVals)) (fuel + 1) =
        [(rhs, selected)])
    (eqReady :
      (matchCovered (fuel + 1) (.merge selected (aliasConstraints wBArgs)) &&
        (mergeBindings selected (aliasConstraints wBArgs) (fuel + 1)).all fun merged =>
          (merged.hasLoop || merged.applyFullCovered rhs (fuel + 1))) = true)
    (mergeFilterEq :
      ((mergeBindings selected (aliasConstraints wBArgs) (fuel + 1)).filterMap fun merged =>
        if merged.hasLoop then none else some (merged.applyFull rhs (fuel + 1), merged)) =
      [(wBodyVal, wBEqMid)])
    (frontierEq :
      Spec.Eval.Steps.EquationFrontierRel space (Completed.invocationReturnType signature :: live)
        (Entry.Value.expression .active (ctxOpVal :: ctxRetVals)).erase
        cFrameArgs.bindings [work])
    (outBindingsEq : cFrameEqMid.bindings = work.bindings)
    (unifyRel :
      Entry.Value.UnifyRel policy.rebuilding cFrameArgs.environment
        (.expression .active (ctxOpVal :: ctxRetVals))
        (Entry.Value.ofAtom work.pattern) cFrameEqMid.environment)
    (notErrorRet : isErrorAtom finalVal = false)
    (coveredRet : wBOut.applyFullCovered finalVal depth = true)
    (stableRet : wBOut.applyFull finalVal depth = finalVal)
    (actIn : ScopedActivationRel wBIn cFrameIn)
    (actHead : ScopedActivationRel wBHead cFrameHead)
    (actArgs : ScopedActivationRel wBArgs cFrameArgs)
    (actOut : ScopedActivationRel wBOut cFrameOut)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (opRun :
      let resultType := Completed.invocationReturnType signature
      let wCallStack : List RecursiveTasks.Frame :=
        .calls resultType (fuel + 2) live ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack
      let cCallStack : List RecursiveTasks.Contextual.Continuation :=
        .calls live scope resultType ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack
      let wOpStart : Configuration :=
        ⟨space, .work (.atom opAtom signature.functionType wBIn (fuel + 1)
            (signature.functionType :: argAtoms ++ (resultType :: live))),
          .heads signature.functionType argAtoms (fuel + 1) (resultType :: live) :: wCallStack,
          wEmitted⟩
      let wOpEnd : Configuration :=
        ⟨space, .returning [(opVal, wBHead)],
          .heads signature.functionType argAtoms (fuel + 1) (resultType :: live) :: wCallStack,
          wEmitted⟩
      let cOpStart : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.atom (signature.functionType :: ctxArgs.map Entry.Value.erase ++ (resultType :: live))
            (scope ++ expectedApplicationScope (.expression ((ctxOp :: ctxArgs).map Entry.Value.erase)) expected)
            ctxOp signature.functionType cFrameIn),
          .functionHeads (resultType :: live) scope (ctxArgs.zip signature.argumentTypes) :: cCallStack,
          cEmitted⟩
      let cOpEnd : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .returning [(ctxOpVal, cFrameHead)],
          .functionHeads (resultType :: live) scope (ctxArgs.zip signature.argumentTypes) :: cCallStack,
          cEmitted⟩
      (∀ budget,
        (Checked.machine dispatch scopedTypes).run (opSteps + budget) wOpStart =
          (Checked.machine dispatch scopedTypes).run budget wOpEnd) ∧
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cOpStart.control, cOpStart.stack) (cOpEnd.control, cOpEnd.stack))
    (argsSpine :
      let resultType := Completed.invocationReturnType signature
      let wCallStack : List RecursiveTasks.Frame :=
        .calls resultType (fuel + 2) live ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack
      let cCallStack : List RecursiveTasks.Contextual.Continuation :=
        .calls live scope resultType ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack
      ScopedOpenArgsSpine space dispatch hostDispatch policy scope wEmitted cEmitted
        (fuel + 1) argSteps (opVal :: resultType :: live) argAtoms signature.argumentTypes
        (ctxArgs.zip signature.argumentTypes) retVals ctxRetVals
        wBHead cFrameHead wBArgs cFrameArgs
        (.functionTail opVal ::
          .append (.heads signature.functionType argAtoms (fuel + 1) [] (resultType :: live)) ::
          wCallStack)
        (.functionAssemble ctxOpVal ::
          .append (.functionBranches (resultType :: live) scope
            (ctxArgs.zip signature.argumentTypes) []) ::
          cCallStack))
    (prodRun :
      let resultType := Completed.invocationReturnType signature
      let outAtom : Atom := .expression (opVal :: retVals)
      let ctxCall : Entry.Value := .expression .active (ctxOpVal :: ctxRetVals)
      let wDrainStack : List RecursiveTasks.Frame :=
        .append (.calls resultType (fuel + 2) [] live) ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack
      let cDrainStack : List RecursiveTasks.Contextual.Continuation :=
        .append (.calls live scope resultType []) ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack
      let wProdStart : Configuration :=
        ⟨space, .work (.produced wBodyVal wBEqMid (fuel + 1) (resultType :: live)
            (some outAtom) .emitted),
          .append (.productions (fuel + 1) [] (resultType :: live) (some outAtom) .emitted) ::
            .invocationReturn (.ordinary resultType) outAtom (fuel + 1) live :: wDrainStack,
          wEmitted⟩
      let wProdEnd : Configuration :=
        ⟨space, .returning [(prodVal, wBProd)],
          .append (.productions (fuel + 1) [] (resultType :: live) (some outAtom) .emitted) ::
            .invocationReturn (.ordinary resultType) outAtom (fuel + 1) live :: wDrainStack,
          wEmitted⟩
      let cProdStart : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.boundary (resultType :: live) scope (some ctxCall.erase) .producer
          (cFrameEqMid.read policy (Entry.Value.ofAtom work.body)) cFrameEqMid),
          .boundaryBatch live scope none (.returned ctxCall resultType) ::
            .append (.equations live scope ctxCall resultType cFrameArgs []) :: cDrainStack,
          cEmitted⟩
      let cProdEnd : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .returning [(ctxProdVal, cFrameProd)],
          .boundaryBatch live scope none (.returned ctxCall resultType) ::
            .append (.equations live scope ctxCall resultType cFrameArgs []) :: cDrainStack,
          cEmitted⟩
      (∀ budget,
        (Checked.machine dispatch scopedTypes).run (prodSteps + budget) wProdStart =
          (Checked.machine dispatch scopedTypes).run budget wProdEnd) ∧
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cProdStart.control, cProdStart.stack) (cProdEnd.control, cProdEnd.stack))
    (retRun :
      let resultType := Completed.invocationReturnType signature
      let outAtom : Atom := .expression (opVal :: retVals)
      let ctxCall : Entry.Value := .expression .active (ctxOpVal :: ctxRetVals)
      let wDrainStack : List RecursiveTasks.Frame :=
        .append (.calls resultType (fuel + 2) [] live) ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack
      let cDrainStack : List RecursiveTasks.Contextual.Continuation :=
        .append (.calls live scope resultType []) ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack
      let wRetStart : Configuration :=
        ⟨space, .work (.returned outAtom prodVal resultType wBProd (fuel + 1) live),
          .append (.returns outAtom resultType (fuel + 1) [] live) :: wDrainStack,
          wEmitted⟩
      let wRetEnd : Configuration :=
        ⟨space, .returning [(finalVal, wBOut)],
          .append (.returns outAtom resultType (fuel + 1) [] live) :: wDrainStack,
          wEmitted⟩
      let cRetStart : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.returned live scope ctxCall resultType ctxProdVal cFrameProd),
          .append (.boundaryBatch live scope none (.returned ctxCall resultType) []) ::
            .append (.equations live scope ctxCall resultType cFrameArgs []) :: cDrainStack,
          cEmitted⟩
      let cRetEnd : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .returning [(ctxFinalVal, cFrameOut)],
          .append (.boundaryBatch live scope none (.returned ctxCall resultType) []) ::
            .append (.equations live scope ctxCall resultType cFrameArgs []) :: cDrainStack,
          cEmitted⟩
      (∀ budget,
        (Checked.machine dispatch scopedTypes).run (retSteps + budget) wRetStart =
          (Checked.machine dispatch scopedTypes).run budget wRetEnd) ∧
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cRetStart.control, cRetStart.stack) (cRetEnd.control, cRetEnd.stack)) :
    let resultType := Completed.invocationReturnType signature
    let cPublished : Completed.Result :=
      Completed.publishResult policy callAtom (cFrameOut.read policy ctxFinalVal, cFrameOut)
    let wBefore : Configuration :=
      ⟨space, .work (.bindingAlternatives (.expression (opAtom :: argAtoms))
          signature.functionType resultType (fuel + 2) [wBIn] live),
        .filter :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.invocations live scope expected signature ctxOp ctxArgs [cFrameIn]),
        .publish callAtom :: cStack, cEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning [(finalVal, wBOut)], wStack, wEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [cPublished], cStack, cEmitted⟩
    (∀ budget,
      (Checked.machine dispatch scopedTypes).run
        ((opSteps + argSteps + prodSteps + retSteps + 34) + budget) wBefore =
        (Checked.machine dispatch scopedTypes).run budget wAfter) ∧
    (Checked.machine dispatch scopedTypes).run
      (opSteps + argSteps + prodSteps + retSteps + 34) wBefore = ([], .exhausted wAfter) ∧
    RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy cBefore cAfter ∧
    ContextualSilentPath hostDispatch Completed.scopedLookup policy cBefore cAfter ∧
    ScopedConfigurationRel wAfter cAfter ∧
    ScopedSilentBlock dispatch hostDispatch policy wBefore cBefore wAfter cAfter := by
  intro resultType cPublished wBefore cBefore wAfter cAfter
  dsimp only at opRun prodRun retRun ⊢
  have assembledEq :
      (Entry.Value.expression .active (ctxOpVal :: ctxRetVals)).erase =
        .expression (opVal :: retVals) := by
    simp [Entry.Value.erase, opValEq, retValsEq]
  have drainStackRel :
      List.Forall₂ ScopedFrameRel
        (.append (.calls resultType (fuel + 2) [] live) ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack)
        (.append (.calls live scope resultType []) ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack) :=
    .cons (.append (.calls .nil))
      (.cons (.append (.bindingAlternatives opEq argsEq rfl rfl .nil))
        (.cons (.filter callAtom) stackRel))
  have callSq := scoped_open_callEquations_single_complete_square
    space dispatch hostDispatch policy
    (.expression (opVal :: retVals)) resultType
    rhs wBodyVal prodVal finalVal wBArgs selected wBEqMid wBProd wBOut
    (fuel + 1) prodSteps retSteps live scope
    (.expression .active (ctxOpVal :: ctxRetVals)) ctxProdVal ctxFinalVal
    work cFrameArgs cFrameEqMid cFrameProd cFrameOut
    (.append (.calls resultType (fuel + 2) [] live) ::
      .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
        signature.functionType resultType (fuel + 2) [] live) ::
      .filter :: wStack)
    (.append (.calls live scope resultType []) ::
      .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
      .publish callAtom :: cStack)
    wEmitted cEmitted
    assembledEq notErrorCall notExec nonGrounded notMin
    queryCovered queryEq eqReady mergeFilterEq
    frontierEq outBindingsEq unifyRel finalEq actArgs actOut
    drainStackRel emittedRel prodRun retRun
  have fullRun := scoped_open_invocations_complete_to_caller_publish_square
    space dispatch hostDispatch policy
    opAtom opVal expected callAtom finalVal signature
    ctxOp ctxOpVal ctxFinalVal argAtoms retVals ctxArgs ctxRetVals
    wBIn wBHead wBArgs wBOut cFrameIn cFrameHead cFrameArgs cFrameOut
    fuel opSteps argSteps (prodSteps + retSteps + 17) depth live scope
    wStack cStack wEmitted cEmitted
    opEq opValEq finalEq argsEq arityEq argTypesEq
    notStoppedOp notErrorRet coveredRet stableRet
    actIn actHead actOut stackRel emittedRel
    opRun argsSpine ⟨callSq.1, callSq.2.2.1⟩
  refine ⟨?_, ?_, fullRun.2.2.1, fullRun.2.2.2.1, fullRun.2.2.2.2.1,
    fullRun.2.2.2.2.2.1, fullRun.2.2.2.2.2.2⟩
  · intro budget
    rw [show (opSteps + argSteps + prodSteps + retSteps + 34) + budget =
      (opSteps + argSteps + (prodSteps + retSteps + 17) + 17) + budget by omega]
    exact fullRun.1 budget
  · rw [show opSteps + argSteps + prodSteps + retSteps + 34 =
      opSteps + argSteps + (prodSteps + retSteps + 17) + 17 by omega]
    exact fullRun.2.1


/-! ### Ordered equation occurrences and retained producer/return composition

The list induction composes local producer and return runs supplied at each
equation occurrence. It does not earn those child runs from arbitrary recursive
source derivations. -/

/-- Unified Multi-Row Equation-Frontier Spine (`ScopedOpenEquationWorksSpine`):
Simultaneously threads the worker's three sequential multi-row passes
(`.equations`, `.productions`, `.returns`) and the contextual machine's single-pass
`.equations` / `.invocationEquations` traversal over an arbitrary equation frontier
`rows : List (Atom × Bindings)` and `works : List Spec.Eval.Steps.EquationWork`.
Parameterizing `prodLive : List Atom` allows the same inductive spine to serve both:
- Ordinary equation calls (`prodLive = expected :: live`), and
- Raw `(eval ...)` equation invocations (`expected = Atom.undefinedType`, `prodLive = live`). -/
inductive ScopedOpenEquationWorksSpine
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (expr expected : Atom) (wBIn : Bindings) (fuel : Nat)
    (live prodLive : List Atom) (scope : List String)
    (ctxCall : Entry.Value) (cFrameIn : Completed.Frame)
    (wEmitted : ResultSet) :
    Nat → Nat → Nat →
    List (Atom × Bindings) → List Spec.Eval.Steps.EquationWork →
    ResultSet → ResultSet → List (Entry.Value × Completed.Frame) →
    ResultSet → List (Entry.Value × Completed.Frame) → Prop where
  | nil :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
        1 1 1 [] [] [] [] [] [] []
  | cons_rejected
      (rhs : Atom) (selected : Bindings)
      (remEqSteps remProdSteps remRetSteps : Nat)
      (remRows : List (Atom × Bindings))
      (works : List Spec.Eval.Steps.EquationWork)
      (bodyResults prodResults : ResultSet)
      (ctxProdResults : List (Entry.Value × Completed.Frame))
      (finalResults : ResultSet)
      (ctxFinalResults : List (Entry.Value × Completed.Frame))
      (eqReady :
        (matchCovered fuel (.merge selected (aliasConstraints wBIn)) &&
          (mergeBindings selected (aliasConstraints wBIn) fuel).all fun merged =>
            (merged.hasLoop || merged.applyFullCovered rhs fuel)) = true)
      (mergeFilterEmpty :
        ((mergeBindings selected (aliasConstraints wBIn) fuel).filterMap fun merged =>
          if merged.hasLoop then none else some (merged.applyFull rhs fuel, merged)) = [])
      (tailSpine :
        ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
          expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
          remEqSteps remProdSteps remRetSteps
          remRows works bodyResults prodResults ctxProdResults finalResults ctxFinalResults) :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
        (remEqSteps + 3) remProdSteps remRetSteps
        ((rhs, selected) :: remRows) works
        bodyResults prodResults ctxProdResults finalResults ctxFinalResults
  | cons
      (rhs wBodyVal prodVal : Atom)
      (selected wBMid wBProd : Bindings)
      (ctxProdVal : Entry.Value)
      (work : Spec.Eval.Steps.EquationWork)
      (cFrameMid cFrameProd : Completed.Frame)
      (headProdSteps headRetSteps remEqSteps remProdSteps remRetSteps : Nat)
      (remRows : List (Atom × Bindings))
      (remWorks : List Spec.Eval.Steps.EquationWork)
      (remBodyResults remProdResults : ResultSet)
      (remCtxProdResults : List (Entry.Value × Completed.Frame))
      (headFinalResults remFinalResults : ResultSet)
      (headCtxFinalResults remCtxFinalResults : List (Entry.Value × Completed.Frame))
      (eqReady :
        (matchCovered fuel (.merge selected (aliasConstraints wBIn)) &&
          (mergeBindings selected (aliasConstraints wBIn) fuel).all fun merged =>
            (merged.hasLoop || merged.applyFullCovered rhs fuel)) = true)
      (mergeFilterEq :
        ((mergeBindings selected (aliasConstraints wBIn) fuel).filterMap fun merged =>
          if merged.hasLoop then none else some (merged.applyFull rhs fuel, merged)) =
        [(wBodyVal, wBMid)])
      (outBindingsEq : cFrameMid.bindings = work.bindings)
      (unifyRel :
        Entry.Value.UnifyRel policy.rebuilding cFrameIn.environment ctxCall
          (Entry.Value.ofAtom work.pattern) cFrameMid.environment)
      (headProdRel : ScopedResultRel (prodVal, wBProd) (ctxProdVal, cFrameProd))
      (headFinalRel : List.Forall₂ ScopedResultRel headFinalResults headCtxFinalResults)
      (prodRun :
        ∀ (wStack : List RecursiveTasks.Frame)
          (cStack : List RecursiveTasks.Contextual.Continuation),
          let wProdStart : Configuration :=
            ⟨space, .work (.produced wBodyVal wBMid fuel prodLive (some expr) .emitted),
              wStack, wEmitted⟩
          let wProdEnd : Configuration :=
            ⟨space, .returning [(prodVal, wBProd)], wStack, wEmitted⟩
          (∀ budget,
            (Checked.machine dispatch scopedTypes).run (headProdSteps + budget) wProdStart =
              (Checked.machine dispatch scopedTypes).run budget wProdEnd) ∧
          RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
            (.work (.boundary prodLive scope (some ctxCall.erase) .producer
              (cFrameMid.read policy (Entry.Value.ofAtom work.body)) cFrameMid), cStack)
            (.returning [(ctxProdVal, cFrameProd)], cStack))
      (retRun :
        ∀ (wStack : List RecursiveTasks.Frame)
          (cStack : List RecursiveTasks.Contextual.Continuation),
          let wRetStart : Configuration :=
            ⟨space, .work (.returned expr prodVal expected wBProd fuel live),
              wStack, wEmitted⟩
          let wRetEnd : Configuration :=
            ⟨space, .returning headFinalResults, wStack, wEmitted⟩
          (∀ budget,
            (Checked.machine dispatch scopedTypes).run (headRetSteps + budget) wRetStart =
              (Checked.machine dispatch scopedTypes).run budget wRetEnd) ∧
          RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
            (.work (.returned live scope ctxCall expected ctxProdVal cFrameProd), cStack)
            (.returning headCtxFinalResults, cStack))
      (tailSpine :
        ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
          expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
          remEqSteps remProdSteps remRetSteps
          remRows remWorks remBodyResults remProdResults remCtxProdResults
          remFinalResults remCtxFinalResults) :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
        (remEqSteps + 3) (headProdSteps + remProdSteps + 3) (headRetSteps + remRetSteps + 3)
        ((rhs, selected) :: remRows) (work :: remWorks)
        ((wBodyVal, wBMid) :: remBodyResults)
        ((prodVal, wBProd) :: remProdResults)
        ((ctxProdVal, cFrameProd) :: remCtxProdResults)
        (headFinalResults ++ remFinalResults)
        (headCtxFinalResults ++ remCtxFinalResults)

/-- Every `ScopedOpenEquationWorksSpine` preserves `List.Forall₂ ScopedResultRel`
between `prodResults` and `ctxProdResults`. -/
theorem ScopedOpenEquationWorksSpine.prodResults_forall2
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    {eqSteps prodSteps retSteps : Nat}
    {rows : List (Atom × Bindings)} {works : List Spec.Eval.Steps.EquationWork}
    {bodyResults prodResults : ResultSet}
    {ctxProdResults : List (Entry.Value × Completed.Frame)}
    {finalResults : ResultSet}
    {ctxFinalResults : List (Entry.Value × Completed.Frame)}
    (spine : ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
      eqSteps prodSteps retSteps rows works
      bodyResults prodResults ctxProdResults finalResults ctxFinalResults) :
    List.Forall₂ ScopedResultRel prodResults ctxProdResults := by
  induction spine with
  | nil => exact .nil
  | cons_rejected _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ih => exact ih
  | cons _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ headProdRel _ _ _ _ ih =>
      exact .cons headProdRel ih

/-- Every `ScopedOpenEquationWorksSpine` preserves `List.Forall₂ ScopedResultRel`
between `finalResults` and `ctxFinalResults`. -/
theorem ScopedOpenEquationWorksSpine.finalResults_forall2
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    {eqSteps prodSteps retSteps : Nat}
    {rows : List (Atom × Bindings)} {works : List Spec.Eval.Steps.EquationWork}
    {bodyResults prodResults : ResultSet}
    {ctxProdResults : List (Entry.Value × Completed.Frame)}
    {finalResults : ResultSet}
    {ctxFinalResults : List (Entry.Value × Completed.Frame)}
    (spine : ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
      eqSteps prodSteps retSteps rows works
      bodyResults prodResults ctxProdResults finalResults ctxFinalResults) :
    List.Forall₂ ScopedResultRel finalResults ctxFinalResults := by
  induction spine with
  | nil => exact .nil
  | cons_rejected _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ih => exact ih
  | cons _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ headFinalRel _ _ _ ih =>
      exact List.rel_append headFinalRel ih

/-- Worker Pass 1 Theorem (`ScopedOpenEquationWorksSpine.equations_run`):
Executes `.work (.equations expr expected wBIn fuel rows live)` in `eqSteps` silent steps
to `.returning bodyResults` over any worker stack `wStack`. -/
theorem ScopedOpenEquationWorksSpine.equations_run
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    {eqSteps prodSteps retSteps : Nat}
    {rows : List (Atom × Bindings)} {works : List Spec.Eval.Steps.EquationWork}
    {bodyResults prodResults : ResultSet}
    {ctxProdResults : List (Entry.Value × Completed.Frame)}
    {finalResults : ResultSet}
    {ctxFinalResults : List (Entry.Value × Completed.Frame)}
    (spine : ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
      eqSteps prodSteps retSteps rows works
      bodyResults prodResults ctxProdResults finalResults ctxFinalResults)
    (wStack : List RecursiveTasks.Frame) (budget : Nat) :
    (Checked.machine dispatch scopedTypes).run (eqSteps + budget)
      ⟨space, .work (.equations expr expected wBIn fuel rows live), wStack, wEmitted⟩ =
    (Checked.machine dispatch scopedTypes).run budget
      ⟨space, .returning bodyResults, wStack, wEmitted⟩ := by
  induction spine generalizing wStack budget with
  | nil =>
      have wStep :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .work (.equations expr expected wBIn fuel [] live), wStack, wEmitted⟩ =
          some (.silent ⟨space, .returning [], wStack, wEmitted⟩) := rfl
      rw [Nat.add_comm 1 budget, (Checked.machine dispatch scopedTypes).run_succ_silent wStep]
  | cons_rejected rhs selected remEqSteps remProdSteps remRetSteps remRows works
      bodyResults prodResults ctxProdResults finalResults ctxFinalResults
      eqReady mergeFilterEmpty _ ih =>
      have hEqReady : ∀ lookup,
          RecursiveMachine.Checked.taskReady space dispatch
            (.equations expr expected wBIn fuel ((rhs, selected) :: remRows) live) lookup = true := by
        intro lookup
        simp [RecursiveMachine.Checked.taskReady, eqReady]
      have hEqEnter : ∀ lookup,
          RecursiveMachine.enter space dispatch
            (.equations expr expected wBIn fuel ((rhs, selected) :: remRows) live) lookup =
          (.returning [],
            [.append (.equations expr expected wBIn fuel remRows live)]) := by
        intro lookup
        simp [RecursiveMachine.enter, mergeFilterEmpty]
      have wStep1 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .work (.equations expr expected wBIn fuel ((rhs, selected) :: remRows) live),
              wStack, wEmitted⟩ =
          some (.silent
            ⟨space, .returning [],
              .append (.equations expr expected wBIn fuel remRows live) :: wStack, wEmitted⟩) := by
        simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
          FirstSuccessRecursiveStrategy.taskReady, hEqReady,
          FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
          FirstSuccessRecursiveStrategy.enter, hEqEnter, Transition.relabel]
      have wStep2 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .returning [],
              .append (.equations expr expected wBIn fuel remRows live) :: wStack, wEmitted⟩ =
          some (.silent
            ⟨space, .work (.equations expr expected wBIn fuel remRows live),
              .prepend [] :: wStack, wEmitted⟩) := rfl
      have wStep3 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .returning bodyResults, .prepend [] :: wStack, wEmitted⟩ =
          some (.silent ⟨space, .returning bodyResults, wStack, wEmitted⟩) := rfl
      calc
        (Checked.machine dispatch scopedTypes).run ((remEqSteps + 3) + budget) _
            = (Checked.machine dispatch scopedTypes).run
                (((remEqSteps + (budget + 1)) + 1) + 1) _ := by
                rw [show (remEqSteps + 3) + budget = ((remEqSteps + (budget + 1)) + 1) + 1 by omega]
        _ = (Checked.machine dispatch scopedTypes).run
              ((remEqSteps + (budget + 1)) + 1) _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep1
        _ = (Checked.machine dispatch scopedTypes).run
              (remEqSteps + (budget + 1)) _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep2
        _ = (Checked.machine dispatch scopedTypes).run (budget + 1) _ :=
              ih (.prepend [] :: wStack) (budget + 1)
        _ = (Checked.machine dispatch scopedTypes).run budget _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep3
  | cons rhs wBodyVal prodVal selected wBMid wBProd ctxProdVal work cFrameMid cFrameProd
      headProdSteps headRetSteps remEqSteps remProdSteps remRetSteps
      remRows remWorks remBodyResults remProdResults remCtxProdResults
      headFinalResults remFinalResults headCtxFinalResults remCtxFinalResults
      eqReady mergeFilterEq _ _ _ _ _ _ _ ih =>
      have hEqReady : ∀ lookup,
          RecursiveMachine.Checked.taskReady space dispatch
            (.equations expr expected wBIn fuel ((rhs, selected) :: remRows) live) lookup = true := by
        intro lookup
        simp [RecursiveMachine.Checked.taskReady, eqReady]
      have hEqEnter : ∀ lookup,
          RecursiveMachine.enter space dispatch
            (.equations expr expected wBIn fuel ((rhs, selected) :: remRows) live) lookup =
          (.returning [(wBodyVal, wBMid)],
            [.append (.equations expr expected wBIn fuel remRows live)]) := by
        intro lookup
        simp [RecursiveMachine.enter, mergeFilterEq]
      have wStep1 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .work (.equations expr expected wBIn fuel ((rhs, selected) :: remRows) live),
              wStack, wEmitted⟩ =
          some (.silent
            ⟨space, .returning [(wBodyVal, wBMid)],
              .append (.equations expr expected wBIn fuel remRows live) :: wStack, wEmitted⟩) := by
        simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
          FirstSuccessRecursiveStrategy.taskReady, hEqReady,
          FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
          FirstSuccessRecursiveStrategy.enter, hEqEnter, Transition.relabel]
      have wStep2 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .returning [(wBodyVal, wBMid)],
              .append (.equations expr expected wBIn fuel remRows live) :: wStack, wEmitted⟩ =
          some (.silent
            ⟨space, .work (.equations expr expected wBIn fuel remRows live),
              .prepend [(wBodyVal, wBMid)] :: wStack, wEmitted⟩) := rfl
      have wStep3 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .returning remBodyResults,
              .prepend [(wBodyVal, wBMid)] :: wStack, wEmitted⟩ =
          some (.silent
            ⟨space, .returning ((wBodyVal, wBMid) :: remBodyResults), wStack, wEmitted⟩) := rfl
      calc
        (Checked.machine dispatch scopedTypes).run ((remEqSteps + 3) + budget) _
            = (Checked.machine dispatch scopedTypes).run
                (((remEqSteps + (budget + 1)) + 1) + 1) _ := by
                rw [show (remEqSteps + 3) + budget = ((remEqSteps + (budget + 1)) + 1) + 1 by omega]
        _ = (Checked.machine dispatch scopedTypes).run
              ((remEqSteps + (budget + 1)) + 1) _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep1
        _ = (Checked.machine dispatch scopedTypes).run
              (remEqSteps + (budget + 1)) _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep2
        _ = (Checked.machine dispatch scopedTypes).run (budget + 1) _ :=
              ih (.prepend [(wBodyVal, wBMid)] :: wStack) (budget + 1)
        _ = (Checked.machine dispatch scopedTypes).run budget _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep3

/-- Worker Pass 2 Theorem (`ScopedOpenEquationWorksSpine.productions_run`):
Executes `.work (.productions fuel bodyResults prodLive (some expr) .emitted)` in `prodSteps`
silent steps to `.returning prodResults` over any worker stack `wStack`. -/
theorem ScopedOpenEquationWorksSpine.productions_run
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    {eqSteps prodSteps retSteps : Nat}
    {rows : List (Atom × Bindings)} {works : List Spec.Eval.Steps.EquationWork}
    {bodyResults prodResults : ResultSet}
    {ctxProdResults : List (Entry.Value × Completed.Frame)}
    {finalResults : ResultSet}
    {ctxFinalResults : List (Entry.Value × Completed.Frame)}
    (spine : ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
      eqSteps prodSteps retSteps rows works
      bodyResults prodResults ctxProdResults finalResults ctxFinalResults)
    (wStack : List RecursiveTasks.Frame) (budget : Nat) :
    (Checked.machine dispatch scopedTypes).run (prodSteps + budget)
      ⟨space, .work (.productions fuel bodyResults prodLive (some expr) .emitted),
        wStack, wEmitted⟩ =
    (Checked.machine dispatch scopedTypes).run budget
      ⟨space, .returning prodResults, wStack, wEmitted⟩ := by
  induction spine generalizing wStack budget with
  | nil =>
      have wStep :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .work (.productions fuel [] prodLive (some expr) .emitted),
              wStack, wEmitted⟩ =
          some (.silent ⟨space, .returning [], wStack, wEmitted⟩) := rfl
      rw [Nat.add_comm 1 budget, (Checked.machine dispatch scopedTypes).run_succ_silent wStep]
  | cons_rejected _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ih =>
      exact ih wStack budget
  | cons rhs wBodyVal prodVal selected wBMid wBProd ctxProdVal work cFrameMid cFrameProd
      headProdSteps headRetSteps remEqSteps remProdSteps remRetSteps
      remRows remWorks remBodyResults remProdResults remCtxProdResults
      headFinalResults remFinalResults headCtxFinalResults remCtxFinalResults
      _ _ _ _ _ _ prodRun _ _ ih =>
      have wStep1 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .work (.productions fuel ((wBodyVal, wBMid) :: remBodyResults) prodLive
                (some expr) .emitted),
              wStack, wEmitted⟩ =
          some (.silent
            ⟨space, .work (.produced wBodyVal wBMid fuel prodLive (some expr) .emitted),
              .append (.productions fuel remBodyResults prodLive (some expr) .emitted) :: wStack,
              wEmitted⟩) := rfl
      have wStep2 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .returning [(prodVal, wBProd)],
              .append (.productions fuel remBodyResults prodLive (some expr) .emitted) :: wStack,
              wEmitted⟩ =
          some (.silent
            ⟨space, .work (.productions fuel remBodyResults prodLive (some expr) .emitted),
              .prepend [(prodVal, wBProd)] :: wStack, wEmitted⟩) := rfl
      have wStep3 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .returning remProdResults,
              .prepend [(prodVal, wBProd)] :: wStack, wEmitted⟩ =
          some (.silent
            ⟨space, .returning ((prodVal, wBProd) :: remProdResults), wStack, wEmitted⟩) := rfl
      have hProd := (prodRun
        (.append (.productions fuel remBodyResults prodLive (some expr) .emitted) :: wStack) []).1
      calc
        (Checked.machine dispatch scopedTypes).run ((headProdSteps + remProdSteps + 3) + budget) _
            = (Checked.machine dispatch scopedTypes).run
                ((headProdSteps + ((remProdSteps + (budget + 1)) + 1)) + 1) _ := by
                rw [show (headProdSteps + remProdSteps + 3) + budget =
                  (headProdSteps + ((remProdSteps + (budget + 1)) + 1)) + 1 by omega]
        _ = (Checked.machine dispatch scopedTypes).run
              (headProdSteps + ((remProdSteps + (budget + 1)) + 1)) _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep1
        _ = (Checked.machine dispatch scopedTypes).run
              ((remProdSteps + (budget + 1)) + 1) _ :=
              hProd ((remProdSteps + (budget + 1)) + 1)
        _ = (Checked.machine dispatch scopedTypes).run
              (remProdSteps + (budget + 1)) _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep2
        _ = (Checked.machine dispatch scopedTypes).run (budget + 1) _ :=
              ih (.prepend [(prodVal, wBProd)] :: wStack) (budget + 1)
        _ = (Checked.machine dispatch scopedTypes).run budget _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep3

/-- Worker Pass 3 Theorem (`ScopedOpenEquationWorksSpine.returns_run`):
Executes `.work (.returns expr expected fuel prodResults live)` in `retSteps` silent steps
to `.returning finalResults` over any worker stack `wStack`. -/
theorem ScopedOpenEquationWorksSpine.returns_run
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    {eqSteps prodSteps retSteps : Nat}
    {rows : List (Atom × Bindings)} {works : List Spec.Eval.Steps.EquationWork}
    {bodyResults prodResults : ResultSet}
    {ctxProdResults : List (Entry.Value × Completed.Frame)}
    {finalResults : ResultSet}
    {ctxFinalResults : List (Entry.Value × Completed.Frame)}
    (spine : ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
      eqSteps prodSteps retSteps rows works
      bodyResults prodResults ctxProdResults finalResults ctxFinalResults)
    (wStack : List RecursiveTasks.Frame) (budget : Nat) :
    (Checked.machine dispatch scopedTypes).run (retSteps + budget)
      ⟨space, .work (.returns expr expected fuel prodResults live), wStack, wEmitted⟩ =
    (Checked.machine dispatch scopedTypes).run budget
      ⟨space, .returning finalResults, wStack, wEmitted⟩ := by
  induction spine generalizing wStack budget with
  | nil =>
      have wStep :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .work (.returns expr expected fuel [] live), wStack, wEmitted⟩ =
          some (.silent ⟨space, .returning [], wStack, wEmitted⟩) := rfl
      rw [Nat.add_comm 1 budget, (Checked.machine dispatch scopedTypes).run_succ_silent wStep]
  | cons_rejected _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ih =>
      exact ih wStack budget
  | cons rhs wBodyVal prodVal selected wBMid wBProd ctxProdVal work cFrameMid cFrameProd
      headProdSteps headRetSteps remEqSteps remProdSteps remRetSteps
      remRows remWorks remBodyResults remProdResults remCtxProdResults
      headFinalResults remFinalResults headCtxFinalResults remCtxFinalResults
      _ _ _ _ _ _ _ retRun _ ih =>
      have wStep1 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .work (.returns expr expected fuel ((prodVal, wBProd) :: remProdResults) live),
              wStack, wEmitted⟩ =
          some (.silent
            ⟨space, .work (.returned expr prodVal expected wBProd fuel live),
              .append (.returns expr expected fuel remProdResults live) :: wStack, wEmitted⟩) := rfl
      have wStep2 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .returning headFinalResults,
              .append (.returns expr expected fuel remProdResults live) :: wStack, wEmitted⟩ =
          some (.silent
            ⟨space, .work (.returns expr expected fuel remProdResults live),
              .prepend headFinalResults :: wStack, wEmitted⟩) := rfl
      have wStep3 :
          (Checked.machine dispatch scopedTypes).step
            ⟨space, .returning remFinalResults,
              .prepend headFinalResults :: wStack, wEmitted⟩ =
          some (.silent
            ⟨space, .returning (headFinalResults ++ remFinalResults), wStack, wEmitted⟩) := rfl
      have hRet := (retRun
        (.append (.returns expr expected fuel remProdResults live) :: wStack) []).1
      calc
        (Checked.machine dispatch scopedTypes).run ((headRetSteps + remRetSteps + 3) + budget) _
            = (Checked.machine dispatch scopedTypes).run
                ((headRetSteps + ((remRetSteps + (budget + 1)) + 1)) + 1) _ := by
                rw [show (headRetSteps + remRetSteps + 3) + budget =
                  (headRetSteps + ((remRetSteps + (budget + 1)) + 1)) + 1 by omega]
        _ = (Checked.machine dispatch scopedTypes).run
              (headRetSteps + ((remRetSteps + (budget + 1)) + 1)) _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep1
        _ = (Checked.machine dispatch scopedTypes).run
              ((remRetSteps + (budget + 1)) + 1) _ :=
              hRet ((remRetSteps + (budget + 1)) + 1)
        _ = (Checked.machine dispatch scopedTypes).run
              (remRetSteps + (budget + 1)) _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep2
        _ = (Checked.machine dispatch scopedTypes).run (budget + 1) _ :=
              ih (.prepend headFinalResults :: wStack) (budget + 1)
        _ = (Checked.machine dispatch scopedTypes).run budget _ :=
              (Checked.machine dispatch scopedTypes).run_succ_silent wStep3

/-- Contextual Multi-Row Equations Theorem (`ScopedOpenEquationWorksSpine.contextual_equations_localSteps`):
When `prodLive = expected :: live`, executes
`(.work (.equations live scope ctxCall expected cFrameIn works), cStack)` in `LocalSteps`
to `(.returning ctxFinalResults, cStack)` over any contextual stack `cStack`. -/
theorem ScopedOpenEquationWorksSpine.contextual_equations_localSteps
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    {eqSteps prodSteps retSteps : Nat}
    {rows : List (Atom × Bindings)} {works : List Spec.Eval.Steps.EquationWork}
    {bodyResults prodResults : ResultSet}
    {ctxProdResults : List (Entry.Value × Completed.Frame)}
    {finalResults : ResultSet}
    {ctxFinalResults : List (Entry.Value × Completed.Frame)}
    (spine : ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
      eqSteps prodSteps retSteps rows works
      bodyResults prodResults ctxProdResults finalResults ctxFinalResults)
    (prodLiveEq : prodLive = expected :: live)
    (cStack : List RecursiveTasks.Contextual.Continuation) :
    RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
      (.work (.equations live scope ctxCall expected cFrameIn works), cStack)
      (.returning ctxFinalResults, cStack) := by
  cases prodLiveEq
  induction spine generalizing cStack with
  | nil =>
      exact Relation.ReflTransGen.single .equationsNil
  | cons_rejected _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ih =>
      exact ih cStack
  | cons rhs wBodyVal prodVal selected wBMid wBProd ctxProdVal work cFrameMid cFrameProd
      headProdSteps headRetSteps remEqSteps remProdSteps remRetSteps
      remRows remWorks remBodyResults remProdResults remCtxProdResults
      headFinalResults remFinalResults headCtxFinalResults remCtxFinalResults
      _ _ outBindingsEq unifyRel _ _ prodRun retRun _ ih =>
      have cLocal1 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.work (.equations live scope ctxCall expected cFrameIn (work :: remWorks)), cStack)
            (.work (.boundary (expected :: live) scope (some ctxCall.erase) .producer
              (cFrameMid.read policy (Entry.Value.ofAtom work.body)) cFrameMid),
              .boundaryBatch live scope none (.returned ctxCall expected) ::
                .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack) :=
        .equationsCons outBindingsEq unifyRel
      have cProd := (prodRun []
        (.boundaryBatch live scope none (.returned ctxCall expected) ::
          .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack)).2
      have cLocal2 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.returning [(ctxProdVal, cFrameProd)],
              .boundaryBatch live scope none (.returned ctxCall expected) ::
                .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack)
            (.work (.boundaryBatch live scope none (.returned ctxCall expected)
              [(ctxProdVal, cFrameProd)]),
              .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack) :=
        .boundaryBatch
      have cLocal3 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.work (.boundaryBatch live scope none (.returned ctxCall expected)
              [(ctxProdVal, cFrameProd)]),
              .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack)
            (.work (.boundary live scope none (.returned ctxCall expected) ctxProdVal cFrameProd),
              .append (.boundaryBatch live scope none (.returned ctxCall expected) []) ::
                .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack) :=
        .boundaryBatchCons
      have cLocal4 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.work (.boundary live scope none (.returned ctxCall expected) ctxProdVal cFrameProd),
              .append (.boundaryBatch live scope none (.returned ctxCall expected) []) ::
                .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack)
            (.work (.returned live scope ctxCall expected ctxProdVal cFrameProd),
              .append (.boundaryBatch live scope none (.returned ctxCall expected) []) ::
                .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack) :=
        .boundaryReturned
      have cRet := (retRun []
        (.append (.boundaryBatch live scope none (.returned ctxCall expected) []) ::
          .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack)).2
      have cLocal5 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.returning headCtxFinalResults,
              .append (.boundaryBatch live scope none (.returned ctxCall expected) []) ::
                .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack)
            (.work (.boundaryBatch live scope none (.returned ctxCall expected) []),
              .prepend headCtxFinalResults ::
                .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack) :=
        .append
      have cLocal6 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.work (.boundaryBatch live scope none (.returned ctxCall expected) []),
              .prepend headCtxFinalResults ::
                .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack)
            (.returning [],
              .prepend headCtxFinalResults ::
                .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack) :=
        .boundaryBatchNil
      have cLocal7 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.returning [],
              .prepend headCtxFinalResults ::
                .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack)
            (.returning headCtxFinalResults,
              .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack) := by
        simpa only [List.append_nil] using
          (RecursiveMachine.Contextual.LocalStep.prepend
            (selected := headCtxFinalResults) (results := []))
      have cLocal8 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.returning headCtxFinalResults,
              .append (.equations live scope ctxCall expected cFrameIn remWorks) :: cStack)
            (.work (.equations live scope ctxCall expected cFrameIn remWorks),
              .prepend headCtxFinalResults :: cStack) :=
        .append
      have cTail := ih (.prepend headCtxFinalResults :: cStack)
      have cLocal9 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.returning remCtxFinalResults,
              .prepend headCtxFinalResults :: cStack)
            (.returning (headCtxFinalResults ++ remCtxFinalResults), cStack) :=
        .prepend
      have p1 := (Relation.ReflTransGen.single cLocal1).trans cProd
      have p2 := (((p1.tail cLocal2).tail cLocal3).tail cLocal4).trans cRet
      have p3 := ((((p2.tail cLocal5).tail cLocal6).tail cLocal7).tail cLocal8).trans cTail
      exact p3.tail cLocal9

/-- Contextual Multi-Row Raw Invocation Equations Theorem
(`ScopedOpenEquationWorksSpine.contextual_invocationEquations_localSteps`):
When `prodLive = live`, executes
`(.work (.invocationEquations live scope ctxCall cFrameIn works), cStack)` in `LocalSteps`
to `(.returning ctxProdResults, cStack)` over any contextual stack `cStack`. -/
theorem ScopedOpenEquationWorksSpine.contextual_invocationEquations_localSteps
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    {eqSteps prodSteps retSteps : Nat}
    {rows : List (Atom × Bindings)} {works : List Spec.Eval.Steps.EquationWork}
    {bodyResults prodResults : ResultSet}
    {ctxProdResults : List (Entry.Value × Completed.Frame)}
    {finalResults : ResultSet}
    {ctxFinalResults : List (Entry.Value × Completed.Frame)}
    (spine : ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn fuel live prodLive scope ctxCall cFrameIn wEmitted
      eqSteps prodSteps retSteps rows works
      bodyResults prodResults ctxProdResults finalResults ctxFinalResults)
    (prodLiveEq : prodLive = live)
    (cStack : List RecursiveTasks.Contextual.Continuation) :
    RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
      (.work (.invocationEquations live scope ctxCall cFrameIn works), cStack)
      (.returning ctxProdResults, cStack) := by
  cases prodLiveEq
  induction spine generalizing cStack with
  | nil =>
      exact Relation.ReflTransGen.single .invocationEquationsNil
  | cons_rejected _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ih =>
      exact ih cStack
  | cons rhs wBodyVal prodVal selected wBMid wBProd ctxProdVal work cFrameMid cFrameProd
      headProdSteps headRetSteps remEqSteps remProdSteps remRetSteps
      remRows remWorks remBodyResults remProdResults remCtxProdResults
      headFinalResults remFinalResults headCtxFinalResults remCtxFinalResults
      _ _ outBindingsEq unifyRel _ _ prodRun _ _ ih =>
      have cLocal1 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.work (.invocationEquations live scope ctxCall cFrameIn (work :: remWorks)), cStack)
            (.work (.boundary live scope (some ctxCall.erase) .producer
              (cFrameMid.read policy (Entry.Value.ofAtom work.body)) cFrameMid),
              .append (.invocationEquations live scope ctxCall cFrameIn remWorks) :: cStack) :=
        .invocationEquationsCons outBindingsEq unifyRel
      have cProd := (prodRun []
        (.append (.invocationEquations live scope ctxCall cFrameIn remWorks) :: cStack)).2
      have cLocal2 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.returning [(ctxProdVal, cFrameProd)],
              .append (.invocationEquations live scope ctxCall cFrameIn remWorks) :: cStack)
            (.work (.invocationEquations live scope ctxCall cFrameIn remWorks),
              .prepend [(ctxProdVal, cFrameProd)] :: cStack) :=
        .append
      have cTail := ih (.prepend [(ctxProdVal, cFrameProd)] :: cStack)
      have cLocal3 :
          RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
            (.returning remCtxProdResults,
              .prepend [(ctxProdVal, cFrameProd)] :: cStack)
            (.returning ((ctxProdVal, cFrameProd) :: remCtxProdResults), cStack) :=
        .prepend
      exact ((((Relation.ReflTransGen.single cLocal1).trans cProd).tail cLocal2).trans cTail).tail cLocal3

/-! #### Inductive Constructors Discharging Equation Producer & Return Premises -/

theorem worker_producedRaw_silent_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (wVal : Atom) (wB : Bindings) (fuel : Nat) (live : List Atom)
    (caller : Option Atom)
    (wStack : List RecursiveTasks.Frame) (wEmitted : ResultSet)
    (notFunc : ∀ body, wVal ≠ .expression [.symbol "function", body]) :
    (Checked.machine dispatch scopedTypes).step
      ⟨space, .work (.produced wVal wB (fuel + 1) live caller .emitted), wStack, wEmitted⟩ =
    some (.silent ⟨space, .returning [(wVal, wB)], wStack, wEmitted⟩) := by
  have hEnter : ∀ lookup,
      RecursiveMachine.enter space dispatch
        (.produced wVal wB (fuel + 1) live caller .emitted) lookup =
      (.returning [(wVal, wB)], []) := by
    intro lookup
    cases wVal with
    | symbol _ => rfl
    | var _ => rfl
    | grounded _ => rfl
    | expression es =>
        cases es with
        | nil => rfl
        | cons hd tl =>
            cases hd with
            | symbol s =>
                by_cases hs : s = "function"
                · subst hs
                  cases tl with
                  | nil => rfl
                  | cons body rest =>
                      cases rest with
                      | nil => exact False.elim (notFunc body rfl)
                      | cons _ _ => rfl
                · simp [RecursiveMachine.enter]
            | var _ => rfl
            | grounded _ => rfl
            | expression _ => rfl
  simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
    FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
    FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
    FirstSuccessRecursiveStrategy.enter, hEnter, Transition.relabel]

/-- Inductive Spine Constructor for Ordinary `Atom.notReducible` Equation Returns
(`ScopedOpenEquationWorksSpine.cons_ordinary_notReducible`):
Discharges both `prodRun` (in 1 step) and `retRun` (in 1 step) without supplied
execution premises when an ordinary equation body materializes to `Atom.notReducible`. -/
theorem ScopedOpenEquationWorksSpine.cons_ordinary_notReducible
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    (rhs : Atom) (selected wBMid : Bindings)
    (work : Spec.Eval.Steps.EquationWork) (cFrameMid : Completed.Frame)
    {remEqSteps remProdSteps remRetSteps : Nat}
    {remRows : List (Atom × Bindings)} {remWorks : List Spec.Eval.Steps.EquationWork}
    {remBodyResults remProdResults : ResultSet}
    {remCtxProdResults : List (Entry.Value × Completed.Frame)}
    {remFinalResults : ResultSet}
    {remCtxFinalResults : List (Entry.Value × Completed.Frame)}
    (callEq : ctxCall.erase = expr)
    (eqReady :
      (matchCovered (fuel + 1) (.merge selected (aliasConstraints wBIn)) &&
        (mergeBindings selected (aliasConstraints wBIn) (fuel + 1)).all fun merged =>
          (merged.hasLoop || merged.applyFullCovered rhs (fuel + 1))) = true)
    (mergeFilterEq :
      ((mergeBindings selected (aliasConstraints wBIn) (fuel + 1)).filterMap fun merged =>
        if merged.hasLoop then none else some (merged.applyFull rhs (fuel + 1), merged)) =
      [(Atom.notReducible, wBMid)])
    (outBindingsEq : cFrameMid.bindings = work.bindings)
    (unifyRel :
      Entry.Value.UnifyRel policy.rebuilding cFrameIn.environment ctxCall
        (Entry.Value.ofAtom work.pattern) cFrameMid.environment)
    (bodyEraseEq :
      (cFrameMid.read policy (Entry.Value.ofAtom work.body)).erase = Atom.notReducible)
    (actMid : ScopedActivationRel wBMid cFrameMid)
    (tailSpine :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr expected wBIn (fuel + 1) live prodLive scope ctxCall cFrameIn wEmitted
        remEqSteps remProdSteps remRetSteps
        remRows remWorks remBodyResults remProdResults remCtxProdResults
        remFinalResults remCtxFinalResults) :
    let ctxProdVal := cFrameMid.read policy (Entry.Value.ofAtom work.body)
    ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn (fuel + 1) live prodLive scope ctxCall cFrameIn wEmitted
      (remEqSteps + 3) (1 + remProdSteps + 3) (1 + remRetSteps + 3)
      ((rhs, selected) :: remRows) (work :: remWorks)
      ((Atom.notReducible, wBMid) :: remBodyResults)
      ((Atom.notReducible, wBMid) :: remProdResults)
      ((ctxProdVal, cFrameMid) :: remCtxProdResults)
      ((expr, wBMid) :: remFinalResults)
      ((ctxCall, cFrameMid) :: remCtxFinalResults) := by
  intro ctxProdVal
  have notFunc : ∀ body, Atom.notReducible ≠ .expression [.symbol "function", body] := by
    intro body h; cases h
  have headProdRel : ScopedResultRel (Atom.notReducible, wBMid) (ctxProdVal, cFrameMid) :=
    ⟨bodyEraseEq.symm, actMid⟩
  have headFinalRel :
      List.Forall₂ ScopedResultRel [(expr, wBMid)] [(ctxCall, cFrameMid)] :=
    .cons ⟨callEq.symm, actMid⟩ .nil
  apply ScopedOpenEquationWorksSpine.cons
    rhs Atom.notReducible Atom.notReducible selected wBMid wBMid ctxProdVal work cFrameMid cFrameMid
    1 1 remEqSteps remProdSteps remRetSteps
    remRows remWorks remBodyResults remProdResults remCtxProdResults
    [(expr, wBMid)] remFinalResults [(ctxCall, cFrameMid)] remCtxFinalResults
    eqReady mergeFilterEq outBindingsEq unifyRel headProdRel headFinalRel
  · intro wStack cStack
    have wStep := worker_producedRaw_silent_step
      space dispatch Atom.notReducible wBMid fuel prodLive (some expr) wStack wEmitted notFunc
    refine ⟨fun budget => ?_, ?_⟩
    · rw [Nat.add_comm 1 budget, (Checked.machine dispatch scopedTypes).run_succ_silent wStep]
    · have notPending : ¬Completed.FunctionPending policy ctxProdVal := by
        rintro ⟨⟨body, hErase⟩, _⟩
        exact notFunc body (bodyEraseEq.symm.trans hErase)
      exact Relation.ReflTransGen.single (.boundaryProducerRaw notPending)
  · intro wStack cStack
    have wStep :
        (Checked.machine dispatch scopedTypes).step
          ⟨space, .work (.returned expr Atom.notReducible expected wBMid (fuel + 1) live),
            wStack, wEmitted⟩ =
        some (.silent ⟨space, .returning [(expr, wBMid)], wStack, wEmitted⟩) := rfl
    refine ⟨fun budget => ?_, Relation.ReflTransGen.single (.returnRefused bodyEraseEq)⟩
    rw [Nat.add_comm 1 budget, (Checked.machine dispatch scopedTypes).run_succ_silent wStep]
  · exact tailSpine

/-- Inductive Spine Constructor for Ordinary Stopped (`Empty` / `Error`) Equation Returns
(`ScopedOpenEquationWorksSpine.cons_ordinary_stopped`):
Discharges both `prodRun` (in 1 step) and `retRun` (in 1 step) without supplied
execution premises when an ordinary equation body materializes to an empty or error atom. -/
theorem ScopedOpenEquationWorksSpine.cons_ordinary_stopped
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    (rhs wBodyVal : Atom) (selected wBMid : Bindings)
    (work : Spec.Eval.Steps.EquationWork) (cFrameMid : Completed.Frame)
    {remEqSteps remProdSteps remRetSteps : Nat}
    {remRows : List (Atom × Bindings)} {remWorks : List Spec.Eval.Steps.EquationWork}
    {remBodyResults remProdResults : ResultSet}
    {remCtxProdResults : List (Entry.Value × Completed.Frame)}
    {remFinalResults : ResultSet}
    {remCtxFinalResults : List (Entry.Value × Completed.Frame)}
    (eqReady :
      (matchCovered (fuel + 1) (.merge selected (aliasConstraints wBIn)) &&
        (mergeBindings selected (aliasConstraints wBIn) (fuel + 1)).all fun merged =>
          (merged.hasLoop || merged.applyFullCovered rhs (fuel + 1))) = true)
    (mergeFilterEq :
      ((mergeBindings selected (aliasConstraints wBIn) (fuel + 1)).filterMap fun merged =>
        if merged.hasLoop then none else some (merged.applyFull rhs (fuel + 1), merged)) =
      [(wBodyVal, wBMid)])
    (outBindingsEq : cFrameMid.bindings = work.bindings)
    (unifyRel :
      Entry.Value.UnifyRel policy.rebuilding cFrameIn.environment ctxCall
        (Entry.Value.ofAtom work.pattern) cFrameMid.environment)
    (bodyEraseEq :
      (cFrameMid.read policy (Entry.Value.ofAtom work.body)).erase = wBodyVal)
    (notFunc : ∀ body, wBodyVal ≠ .expression [.symbol "function", body])
    (notRefused : wBodyVal ≠ Atom.notReducible)
    (stopped : isEmptyOrError wBodyVal = true)
    (actMid : ScopedActivationRel wBMid cFrameMid)
    (tailSpine :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr expected wBIn (fuel + 1) live prodLive scope ctxCall cFrameIn wEmitted
        remEqSteps remProdSteps remRetSteps
        remRows remWorks remBodyResults remProdResults remCtxProdResults
        remFinalResults remCtxFinalResults) :
    let ctxProdVal := cFrameMid.read policy (Entry.Value.ofAtom work.body)
    ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn (fuel + 1) live prodLive scope ctxCall cFrameIn wEmitted
      (remEqSteps + 3) (1 + remProdSteps + 3) (1 + remRetSteps + 3)
      ((rhs, selected) :: remRows) (work :: remWorks)
      ((wBodyVal, wBMid) :: remBodyResults)
      ((wBodyVal, wBMid) :: remProdResults)
      ((ctxProdVal, cFrameMid) :: remCtxProdResults)
      ((wBodyVal, wBMid) :: remFinalResults)
      ((ctxProdVal, cFrameMid) :: remCtxFinalResults) := by
  intro ctxProdVal
  have headProdRel : ScopedResultRel (wBodyVal, wBMid) (ctxProdVal, cFrameMid) :=
    ⟨bodyEraseEq.symm, actMid⟩
  have headFinalRel :
      List.Forall₂ ScopedResultRel [(wBodyVal, wBMid)] [(ctxProdVal, cFrameMid)] :=
    .cons headProdRel .nil
  apply ScopedOpenEquationWorksSpine.cons
    rhs wBodyVal wBodyVal selected wBMid wBMid ctxProdVal work cFrameMid cFrameMid
    1 1 remEqSteps remProdSteps remRetSteps
    remRows remWorks remBodyResults remProdResults remCtxProdResults
    [(wBodyVal, wBMid)] remFinalResults [(ctxProdVal, cFrameMid)] remCtxFinalResults
    eqReady mergeFilterEq outBindingsEq unifyRel headProdRel headFinalRel
  · intro wStack cStack
    have wStep := worker_producedRaw_silent_step
      space dispatch wBodyVal wBMid fuel prodLive (some expr) wStack wEmitted notFunc
    refine ⟨fun budget => ?_, ?_⟩
    · rw [Nat.add_comm 1 budget, (Checked.machine dispatch scopedTypes).run_succ_silent wStep]
    · have notPending : ¬Completed.FunctionPending policy ctxProdVal := by
        rintro ⟨⟨body, hErase⟩, _⟩
        exact notFunc body (bodyEraseEq.symm.trans hErase)
      exact Relation.ReflTransGen.single (.boundaryProducerRaw notPending)
  · intro wStack cStack
    have wStep :
        (Checked.machine dispatch scopedTypes).step
          ⟨space, .work (.returned expr wBodyVal expected wBMid (fuel + 1) live),
            wStack, wEmitted⟩ =
        some (.silent ⟨space, .returning [(wBodyVal, wBMid)], wStack, wEmitted⟩) := by
      simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
        FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
        FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
        FirstSuccessRecursiveStrategy.enter,
        RecursiveMachine.enter, notRefused, stopped, Transition.relabel]
    have stoppedRel : IsEmptyOrErrorRel ctxProdVal.erase := by
      rw [bodyEraseEq, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
      exact stopped
    refine ⟨fun budget => ?_, Relation.ReflTransGen.single (.returnStopped stoppedRel)⟩
    rw [Nat.add_comm 1 budget, (Checked.machine dispatch scopedTypes).run_succ_silent wStep]
  · exact tailSpine

/-- Inductive Spine Constructor for Ordinary Type-Pass Equation Returns
(`ScopedOpenEquationWorksSpine.cons_ordinary_typePass`):
Discharges both `prodRun` (in 1 step) and `retRun` (in 2 steps via `.returned` → `.atom` →
type-pass `.returning`) without supplied execution premises when an ordinary equation body
passes its expected type check. -/
theorem ScopedOpenEquationWorksSpine.cons_ordinary_typePass
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    (rhs wBodyVal : Atom) (selected wBMid : Bindings)
    (work : Spec.Eval.Steps.EquationWork) (cFrameMid : Completed.Frame)
    {remEqSteps remProdSteps remRetSteps : Nat}
    {remRows : List (Atom × Bindings)} {remWorks : List Spec.Eval.Steps.EquationWork}
    {remBodyResults remProdResults : ResultSet}
    {remCtxProdResults : List (Entry.Value × Completed.Frame)}
    {remFinalResults : ResultSet}
    {remCtxFinalResults : List (Entry.Value × Completed.Frame)}
    (eqReady :
      (matchCovered (fuel + 1) (.merge selected (aliasConstraints wBIn)) &&
        (mergeBindings selected (aliasConstraints wBIn) (fuel + 1)).all fun merged =>
          (merged.hasLoop || merged.applyFullCovered rhs (fuel + 1))) = true)
    (mergeFilterEq :
      ((mergeBindings selected (aliasConstraints wBIn) (fuel + 1)).filterMap fun merged =>
        if merged.hasLoop then none else some (merged.applyFull rhs (fuel + 1), merged)) =
      [(wBodyVal, wBMid)])
    (outBindingsEq : cFrameMid.bindings = work.bindings)
    (unifyRel :
      Entry.Value.UnifyRel policy.rebuilding cFrameIn.environment ctxCall
        (Entry.Value.ofAtom work.pattern) cFrameMid.environment)
    (bodyEraseEq :
      (cFrameMid.read policy (Entry.Value.ofAtom work.body)).erase = wBodyVal)
    (notFunc : ∀ body, wBodyVal ≠ .expression [.symbol "function", body])
    (notRefused : wBodyVal ≠ Atom.notReducible)
    (clean : isEmptyOrError wBodyVal = false)
    (typePass : expected = Atom.atomType ∨ expected = getMetaType wBodyVal ∨
      getMetaType wBodyVal = Atom.variableType)
    (covered : wBMid.applyFullCovered wBodyVal fuel = true)
    (stable : wBMid.applyFull wBodyVal fuel = wBodyVal)
    (actMid : ScopedActivationRel wBMid cFrameMid)
    (tailSpine :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr expected wBIn (fuel + 1) live prodLive scope ctxCall cFrameIn wEmitted
        remEqSteps remProdSteps remRetSteps
        remRows remWorks remBodyResults remProdResults remCtxProdResults
        remFinalResults remCtxFinalResults) :
    let ctxProdVal := cFrameMid.read policy (Entry.Value.ofAtom work.body)
    let ctxFinalPair := Completed.readResult policy (ctxProdVal, cFrameMid)
    ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn (fuel + 1) live prodLive scope ctxCall cFrameIn wEmitted
      (remEqSteps + 3) (1 + remProdSteps + 3) (2 + remRetSteps + 3)
      ((rhs, selected) :: remRows) (work :: remWorks)
      ((wBodyVal, wBMid) :: remBodyResults)
      ((wBodyVal, wBMid) :: remProdResults)
      ((ctxProdVal, cFrameMid) :: remCtxProdResults)
      ((wBodyVal, wBMid) :: remFinalResults)
      (ctxFinalPair :: remCtxFinalResults) := by
  intro ctxProdVal ctxFinalPair
  have headProdRel : ScopedResultRel (wBodyVal, wBMid) (ctxProdVal, cFrameMid) :=
    ⟨bodyEraseEq.symm, actMid⟩
  have headFinalPairRel : ScopedResultRel (wBodyVal, wBMid) ctxFinalPair :=
    headProdRel.materialized_readResult_stable policy fuel covered stable
  have headFinalRel :
      List.Forall₂ ScopedResultRel [(wBodyVal, wBMid)] [ctxFinalPair] :=
    .cons headFinalPairRel .nil
  apply ScopedOpenEquationWorksSpine.cons
    rhs wBodyVal wBodyVal selected wBMid wBMid ctxProdVal work cFrameMid cFrameMid
    1 2 remEqSteps remProdSteps remRetSteps
    remRows remWorks remBodyResults remProdResults remCtxProdResults
    [(wBodyVal, wBMid)] remFinalResults [ctxFinalPair] remCtxFinalResults
    eqReady mergeFilterEq outBindingsEq unifyRel headProdRel headFinalRel
  · intro wStack cStack
    have wStep := worker_producedRaw_silent_step
      space dispatch wBodyVal wBMid fuel prodLive (some expr) wStack wEmitted notFunc
    refine ⟨fun budget => ?_, ?_⟩
    · rw [Nat.add_comm 1 budget, (Checked.machine dispatch scopedTypes).run_succ_silent wStep]
    · have notPending : ¬Completed.FunctionPending policy ctxProdVal := by
        rintro ⟨⟨body, hErase⟩, _⟩
        exact notFunc body (bodyEraseEq.symm.trans hErase)
      exact Relation.ReflTransGen.single (.boundaryProducerRaw notPending)
  · intro wStack cStack
    have wStep1 :
        (Checked.machine dispatch scopedTypes).step
          ⟨space, .work (.returned expr wBodyVal expected wBMid (fuel + 1) live),
            wStack, wEmitted⟩ =
        some (.silent ⟨space, .work (.atom wBodyVal expected wBMid (fuel + 1) live),
          wStack, wEmitted⟩) := by
      simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
        FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
        FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
        FirstSuccessRecursiveStrategy.enter,
        RecursiveMachine.enter, notRefused, clean, Transition.relabel]
    have hPass :
        (expected = Atom.atomType ∨ expected = getMetaType wBodyVal) ∨
          getMetaType wBodyVal = Atom.variableType := by
      rcases typePass with h1 | h2 | h3
      · exact Or.inl (Or.inl h1)
      · exact Or.inl (Or.inr h2)
      · exact Or.inr h3
    have wStep2 :
        (Checked.machine dispatch scopedTypes).step
          ⟨space, .work (.atom wBodyVal expected wBMid (fuel + 1) live),
            wStack, wEmitted⟩ =
        some (.silent ⟨space, .returning [(wBodyVal, wBMid)], wStack, wEmitted⟩) := by
      simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
        FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
        FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
        FirstSuccessRecursiveStrategy.enter,
        RecursiveMachine.enter, clean, hPass, Transition.relabel]
    have notRefusedCtx : ctxProdVal.erase ≠ Atom.notReducible := by
      rw [bodyEraseEq]; exact notRefused
    have notStoppedRel : ¬IsEmptyOrErrorRel ctxProdVal.erase := by
      rw [bodyEraseEq, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError, clean]
      decide
    have cLocal1 :
        RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
          (.work (.returned live scope ctxCall expected ctxProdVal cFrameMid), cStack)
          (.work (.atom live scope ctxProdVal expected cFrameMid), cStack) :=
      .returnEvaluate notRefusedCtx notStoppedRel
    have readEraseEq : (cFrameMid.read policy ctxProdVal).erase = wBodyVal :=
      (headProdRel.applyFull_eq_read_erase_of_covered policy fuel covered).symm.trans stable
    have notStoppedRead : ¬IsEmptyOrErrorRel (cFrameMid.read policy ctxProdVal).erase := by
      rw [readEraseEq, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError, clean]
      decide
    have cMeta : MetaTypeRel (cFrameMid.read policy ctxProdVal).erase (getMetaType wBodyVal) := by
      rw [readEraseEq, Conformance.metaTypeRel_iff_getMetaType]
    have entered :
        Entry.Rel policy.reentry (cFrameMid.read policy ctxProdVal).status
          (cFrameMid.read policy ctxProdVal).erase expected .deliver :=
      .pass notStoppedRead cMeta typePass
    have cLocal2 :
        RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
          (.work (.atom live scope ctxProdVal expected cFrameMid), cStack)
          (.returning [ctxFinalPair], cStack) :=
      .delivered entered
    refine ⟨fun budget => ?_, (Relation.ReflTransGen.single cLocal1).tail cLocal2⟩
    rw [show 2 + budget = (budget + 1) + 1 by omega,
      (Checked.machine dispatch scopedTypes).run_succ_silent wStep1,
      (Checked.machine dispatch scopedTypes).run_succ_silent wStep2]
  · exact tailSpine

/-- Inductive Spine Constructor for Recursive Equation Body Evaluation
(`ScopedOpenEquationWorksSpine.cons_ordinary_evaluate`):
Discharges `prodRun` (in 1 step) and reduces `retRun` (`1` step `.returned` → `.atom`)
directly to recursive `.atom wBodyVal expected wBMid (fuel + 1) live` /
`.atom live scope (cFrameMid.read policy (Entry.Value.ofAtom work.body)) expected cFrameMid`
evaluation (`childSteps` steps), allowing recursive equation calls and multi-row child
derivations to plug directly into the spine! -/
theorem ScopedOpenEquationWorksSpine.cons_ordinary_evaluate
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr expected : Atom} {wBIn : Bindings} {fuel : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    (rhs wBodyVal : Atom) (selected wBMid : Bindings)
    (work : Spec.Eval.Steps.EquationWork) (cFrameMid : Completed.Frame)
    (childSteps : Nat)
    {remEqSteps remProdSteps remRetSteps : Nat}
    {remRows : List (Atom × Bindings)} {remWorks : List Spec.Eval.Steps.EquationWork}
    {remBodyResults remProdResults : ResultSet}
    {remCtxProdResults : List (Entry.Value × Completed.Frame)}
    (headFinalResults : ResultSet)
    {remFinalResults : ResultSet}
    (headCtxFinalResults : List (Entry.Value × Completed.Frame))
    {remCtxFinalResults : List (Entry.Value × Completed.Frame)}
    (eqReady :
      (matchCovered (fuel + 1) (.merge selected (aliasConstraints wBIn)) &&
        (mergeBindings selected (aliasConstraints wBIn) (fuel + 1)).all fun merged =>
          (merged.hasLoop || merged.applyFullCovered rhs (fuel + 1))) = true)
    (mergeFilterEq :
      ((mergeBindings selected (aliasConstraints wBIn) (fuel + 1)).filterMap fun merged =>
        if merged.hasLoop then none else some (merged.applyFull rhs (fuel + 1), merged)) =
      [(wBodyVal, wBMid)])
    (outBindingsEq : cFrameMid.bindings = work.bindings)
    (unifyRel :
      Entry.Value.UnifyRel policy.rebuilding cFrameIn.environment ctxCall
        (Entry.Value.ofAtom work.pattern) cFrameMid.environment)
    (bodyEraseEq :
      (cFrameMid.read policy (Entry.Value.ofAtom work.body)).erase = wBodyVal)
    (notFunc : ∀ body, wBodyVal ≠ .expression [.symbol "function", body])
    (notRefused : wBodyVal ≠ Atom.notReducible)
    (clean : isEmptyOrError wBodyVal = false)
    (actMid : ScopedActivationRel wBMid cFrameMid)
    (headFinalRel : List.Forall₂ ScopedResultRel headFinalResults headCtxFinalResults)
    (childAtomRun :
      ∀ (wStack : List RecursiveTasks.Frame)
        (cStack : List RecursiveTasks.Contextual.Continuation),
        let ctxProdVal := cFrameMid.read policy (Entry.Value.ofAtom work.body)
        let wAtomStart : Configuration :=
          ⟨space, .work (.atom wBodyVal expected wBMid (fuel + 1) live), wStack, wEmitted⟩
        let wAtomEnd : Configuration :=
          ⟨space, .returning headFinalResults, wStack, wEmitted⟩
        (∀ budget,
          (Checked.machine dispatch scopedTypes).run (childSteps + budget) wAtomStart =
            (Checked.machine dispatch scopedTypes).run budget wAtomEnd) ∧
        RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
          (.work (.atom live scope ctxProdVal expected cFrameMid), cStack)
          (.returning headCtxFinalResults, cStack))
    (tailSpine :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr expected wBIn (fuel + 1) live prodLive scope ctxCall cFrameIn wEmitted
        remEqSteps remProdSteps remRetSteps
        remRows remWorks remBodyResults remProdResults remCtxProdResults
        remFinalResults remCtxFinalResults) :
    let ctxProdVal := cFrameMid.read policy (Entry.Value.ofAtom work.body)
    ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
      expr expected wBIn (fuel + 1) live prodLive scope ctxCall cFrameIn wEmitted
      (remEqSteps + 3) (1 + remProdSteps + 3) ((childSteps + 1) + remRetSteps + 3)
      ((rhs, selected) :: remRows) (work :: remWorks)
      ((wBodyVal, wBMid) :: remBodyResults)
      ((wBodyVal, wBMid) :: remProdResults)
      ((ctxProdVal, cFrameMid) :: remCtxProdResults)
      (headFinalResults ++ remFinalResults)
      (headCtxFinalResults ++ remCtxFinalResults) := by
  intro ctxProdVal
  have headProdRel : ScopedResultRel (wBodyVal, wBMid) (ctxProdVal, cFrameMid) :=
    ⟨bodyEraseEq.symm, actMid⟩
  apply ScopedOpenEquationWorksSpine.cons
    rhs wBodyVal wBodyVal selected wBMid wBMid ctxProdVal work cFrameMid cFrameMid
    1 (childSteps + 1) remEqSteps remProdSteps remRetSteps
    remRows remWorks remBodyResults remProdResults remCtxProdResults
    headFinalResults remFinalResults headCtxFinalResults remCtxFinalResults
    eqReady mergeFilterEq outBindingsEq unifyRel headProdRel headFinalRel
  · intro wStack cStack
    have wStep := worker_producedRaw_silent_step
      space dispatch wBodyVal wBMid fuel prodLive (some expr) wStack wEmitted notFunc
    refine ⟨fun budget => ?_, ?_⟩
    · rw [Nat.add_comm 1 budget, (Checked.machine dispatch scopedTypes).run_succ_silent wStep]
    · have notPending : ¬Completed.FunctionPending policy ctxProdVal := by
        rintro ⟨⟨body, hErase⟩, _⟩
        exact notFunc body (bodyEraseEq.symm.trans hErase)
      exact Relation.ReflTransGen.single (.boundaryProducerRaw notPending)
  · intro wStack cStack
    have wStep1 :
        (Checked.machine dispatch scopedTypes).step
          ⟨space, .work (.returned expr wBodyVal expected wBMid (fuel + 1) live),
            wStack, wEmitted⟩ =
        some (.silent ⟨space, .work (.atom wBodyVal expected wBMid (fuel + 1) live),
          wStack, wEmitted⟩) := by
      simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
        FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
        FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
        FirstSuccessRecursiveStrategy.enter,
        RecursiveMachine.enter, notRefused, clean, Transition.relabel]
    have notRefusedCtx : ctxProdVal.erase ≠ Atom.notReducible := by
      rw [bodyEraseEq]; exact notRefused
    have notStoppedRel : ¬IsEmptyOrErrorRel ctxProdVal.erase := by
      rw [bodyEraseEq, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError, clean]
      decide
    have cLocal1 :
        RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
          (.work (.returned live scope ctxCall expected ctxProdVal cFrameMid), cStack)
          (.work (.atom live scope ctxProdVal expected cFrameMid), cStack) :=
      .returnEvaluate notRefusedCtx notStoppedRel
    have hChild := childAtomRun wStack cStack
    refine ⟨fun budget => ?_, (Relation.ReflTransGen.single cLocal1).trans hChild.2⟩
    rw [show (childSteps + 1) + budget = (childSteps + budget) + 1 by omega,
      (Checked.machine dispatch scopedTypes).run_succ_silent wStep1,
      hChild.1 budget]
  · exact tailSpine

/-- Inductive Spine Constructor for Fresh-Variable Symbol Cast Returns
(`ScopedOpenEquationWorksSpine.cons_ordinary_freshSymbolCast`):
When an equation body evaluates to a ground-typed symbol `.symbol subject`
(`getAtomTypes space (.symbol subject) = [.symbol actual]`) and the expected return type
is a fresh variable `.var expectedVar` (`expectedVar ∉ specBindingVars wBMid`), earns the
renewed `cFrameOut : Completed.Frame` (`cFrameOut.bindings = cFrameMid.bindings.assign expectedVar (.symbol actual)`)
and discharges both `prodRun` (in 1 step) and `retRun` (in 2 steps via `.returned` → `.atom` →
`.returning`) without supplied execution premises. -/
theorem ScopedOpenEquationWorksSpine.cons_ordinary_freshSymbolCast
    {space : Space} {dispatch : HE.GroundedDispatch}
    {hostDispatch : Spec.Eval.GroundedDispatch} {policy : Policy}
    {expr : Atom} {wBIn : Bindings} {depth : Nat}
    {live prodLive : List Atom} {scope : List String}
    {ctxCall : Entry.Value} {cFrameIn : Completed.Frame}
    {wEmitted : ResultSet}
    (rhs : Atom) (subject expectedVar actual : String)
    (selected wBMid : Bindings)
    (work : Spec.Eval.Steps.EquationWork) (cFrameMid : Completed.Frame)
    {remEqSteps remProdSteps remRetSteps : Nat}
    {remRows : List (Atom × Bindings)} {remWorks : List Spec.Eval.Steps.EquationWork}
    {remBodyResults remProdResults : ResultSet}
    {remCtxProdResults : List (Entry.Value × Completed.Frame)}
    {remFinalResults : ResultSet}
    {remCtxFinalResults : List (Entry.Value × Completed.Frame)}
    (eqReady :
      (matchCovered (depth + 3) (.merge selected (aliasConstraints wBIn)) &&
        (mergeBindings selected (aliasConstraints wBIn) (depth + 3)).all fun merged =>
          (merged.hasLoop || merged.applyFullCovered rhs (depth + 3))) = true)
    (mergeFilterEq :
      ((mergeBindings selected (aliasConstraints wBIn) (depth + 3)).filterMap fun merged =>
        if merged.hasLoop then none else some (merged.applyFull rhs (depth + 3), merged)) =
      [(.symbol subject, wBMid)])
    (outBindingsEq : cFrameMid.bindings = work.bindings)
    (unifyRel :
      Entry.Value.UnifyRel policy.rebuilding cFrameIn.environment ctxCall
        (Entry.Value.ofAtom work.pattern) cFrameMid.environment)
    (bodyEraseEq :
      (cFrameMid.read policy (Entry.Value.ofAtom work.body)).erase = .symbol subject)
    (notRefused : (.symbol subject : Atom) ≠ Atom.notReducible)
    (clean : subject ≠ "Empty")
    (notUndefined : actual ≠ "%Undefined%")
    (notAtom : actual ≠ "Atom")
    (declared : getAtomTypes space (.symbol subject) = [.symbol actual])
    (fresh : expectedVar ∉ specBindingVars wBMid)
    (actMid : ScopedActivationRel wBMid cFrameMid)
    (tailSpine :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr (.var expectedVar) wBIn (depth + 3) live prodLive scope ctxCall cFrameIn wEmitted
        remEqSteps remProdSteps remRetSteps
        remRows remWorks remBodyResults remProdResults remCtxProdResults
        remFinalResults remCtxFinalResults) :
    let ctxProdVal := cFrameMid.read policy (Entry.Value.ofAtom work.body)
    ∃ cFrameOut : Completed.Frame,
      cFrameOut.bindings = cFrameMid.bindings.assign expectedVar (.symbol actual) ∧
      ScopedActivationRel (wBMid.assign expectedVar (.symbol actual)) cFrameOut ∧
      ScopedResultRel (.symbol subject, wBMid.assign expectedVar (.symbol actual))
        (.symbol subject, cFrameOut) ∧
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr (.var expectedVar) wBIn (depth + 3) live prodLive scope ctxCall cFrameIn wEmitted
        (remEqSteps + 3) (1 + remProdSteps + 3) (2 + remRetSteps + 3)
        ((rhs, selected) :: remRows) (work :: remWorks)
        ((.symbol subject, wBMid) :: remBodyResults)
        ((.symbol subject, wBMid) :: remProdResults)
        ((ctxProdVal, cFrameMid) :: remCtxProdResults)
        ((.symbol subject, wBMid.assign expectedVar (.symbol actual)) :: remFinalResults)
        ((.symbol subject, cFrameOut) :: remCtxFinalResults) := by
  intro ctxProdVal
  have ctxValEq : ctxProdVal = .symbol subject :=
    value_eq_symbol_of_erase bodyEraseEq
  have notFunc : ∀ body, (.symbol subject : Atom) ≠ .expression [.symbol "function", body] := by
    intro body h; cases h
  have cleanSym : isEmptyOrError (.symbol subject) = false := by
    simp [isEmptyOrError, isEmptyAtom, isErrorAtom, Atom.empty, clean]
  obtain ⟨nextCertificate, nextRelated, _, _⟩ :=
    FirstSuccessSourceExecution.scoped_type_assignment_frame
      cFrameMid.certified actMid expectedVar actual fresh
  have sourceFresh : expectedVar ∉ specBindingVars cFrameMid.bindings :=
    fun mem => fresh ((actMid.related.support expectedVar).mpr mem)
  have sourceFreshClass : cFrameMid.bindings.classValues expectedVar = [] := by
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro val member
    exact sourceFresh (FreshPrivateMerge.class_key_support member)
  have scopedLookupRel :
      Completed.scopedLookup
        (invocationTypeScope scope live (.symbol subject) (.var expectedVar) cFrameMid.bindings)
        space cFrameMid.bindings (.symbol subject) (.var expectedVar) [.symbol actual] := by
    refine ⟨[.symbol actual], ?_, .cons ?_ (.nil _)⟩
    · rw [← declared]
      exact FirstSuccessSourceReplies.source_types _ _
    · exact ⟨id, Function.injective_id, by simp, by simp [TypeSubst.typeVars]⟩
  have typeMatch :
      TypeMatchRel (.var expectedVar) (.symbol actual) cFrameMid.bindings
        (cFrameMid.bindings.assign expectedVar (.symbol actual)) :=
    FirstSuccessSourceApplicability.independent_fresh_symbol_type_match
      expectedVar actual cFrameMid.bindings notUndefined notAtom sourceFreshClass
  have matchedPolicy :
      policy.matching.Rel (.var expectedVar) (.symbol actual) cFrameMid.bindings
        (cFrameMid.bindings.assign expectedVar (.symbol actual)) := by
    cases hMatch : policy.matching with
    | raw => exact typeMatch
    | finite => exact ⟨typeMatch, nextCertificate.satisfiable⟩
  have derived :
      AppliedTypePresentationMatchRel
        (Entry.Value.eraseEnvironment cFrameMid.environment)
        (.var expectedVar) (.symbol actual)
        ((Entry.Value.eraseEnvironment cFrameMid.environment).bind expectedVar (.symbol actual)) :=
    appliedTypePresentationMatchRel_fresh_symbol
      cFrameMid.bindings (Entry.Value.eraseEnvironment cFrameMid.environment)
      expectedVar actual cFrameMid.certified sourceFresh
  obtain ⟨cFrameOut, hBind, hActOut, hResOut, castRes⟩ :=
    castResultRel_of_presentation_match policy
      (Completed.scopedLookup
        (invocationTypeScope scope live (.symbol subject) (.var expectedVar) cFrameMid.bindings) space)
      cFrameMid subject (.var expectedVar) (.symbol actual)
      (wBMid.assign expectedVar (.symbol actual))
      (cFrameMid.bindings.assign expectedVar (.symbol actual))
      ((Entry.Value.eraseEnvironment cFrameMid.environment).bind expectedVar (.symbol actual))
      nextCertificate nextRelated scopedLookupRel matchedPolicy derived
  have readSym : cFrameMid.read policy (.symbol subject) = .symbol subject := by
    cases hRebuild : policy.rebuilding <;>
      simp [Completed.Frame.read, Entry.Value.substitute, hRebuild]
  have entryCast :
      Entry.Rel policy.reentry (cFrameMid.read policy (.symbol subject)).status
        (cFrameMid.read policy (.symbol subject)).erase (.var expectedVar) .cast := by
    simp only [readSym, Entry.Value.status, Entry.Value.erase]
    exact Spec.Eval.Entry.Rel.cast (policy := policy.reentry) (status := .active)
      (by simpa [IsEmptyOrErrorRel, IsErrorRel, Atom.empty] using clean)
      (.symbol subject)
      (by
        rintro (hA | hS | hV)
        · cases hA
        · cases hS
        · exact absurd hV (by decide))
      (Or.inl ⟨subject, rfl⟩)
      (fun _ => Or.inr rfl)
  have batchRead :
      TypeCastBatchRel space (cFrameMid.read policy (.symbol subject)).erase
        (.var expectedVar) cFrameMid.bindings
        [(.symbol subject, cFrameMid.bindings.assign expectedVar (.symbol actual))]
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live
            (cFrameMid.read policy (.symbol subject)).erase (.var expectedVar) cFrameMid.bindings) space)
        (matching := policy.matching.Rel) := by
    simpa only [readSym, Entry.Value.erase] using
      (TypeCastBatchRel.success (earlierTypes := []) (laterTypes := [])
        scopedLookupRel rfl (by simp) matchedPolicy)
  have pairedRead :
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope live
              (cFrameMid.read policy (.symbol subject)).erase (.var expectedVar) cFrameMid.bindings) space)
          cFrameMid (cFrameMid.read policy (.symbol subject)) (.var expectedVar))
        [(.symbol subject, cFrameMid.bindings.assign expectedVar (.symbol actual))]
        [(.symbol subject, cFrameOut)] := by
    simpa only [readSym, Entry.Value.erase] using List.Forall₂.cons castRes .nil
  refine ⟨cFrameOut, hBind, hActOut, hResOut, ?_⟩
  simpa only [List.singleton_append] using
    ScopedOpenEquationWorksSpine.cons_ordinary_evaluate
      rhs (.symbol subject) selected wBMid work cFrameMid 1
      [(.symbol subject, wBMid.assign expectedVar (.symbol actual))]
      [(.symbol subject, cFrameOut)]
      eqReady mergeFilterEq outBindingsEq unifyRel bodyEraseEq
      notFunc notRefused cleanSym actMid (.cons hResOut .nil)
      (fun wStack cStack => by
        dsimp only
        let wAtomStart : Configuration :=
          ⟨space, .work (.atom (.symbol subject) (.var expectedVar) wBMid (depth + 3) live),
            wStack, wEmitted⟩
        have localSq := UniversalScopedCastAndHeadBoundary.scoped_fresh_symbol_cast_local_square
          wAtomStart dispatch hostDispatch subject expectedVar actual wBMid cFrameMid depth live scope
          cStack [] rfl clean notUndefined notAtom declared actMid fresh
        have wStep := localSq.2.2.2.1
        have cLocal :
            RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
              (.work (.atom live scope ctxProdVal (.var expectedVar) cFrameMid), cStack)
              (.returning [(.symbol subject, cFrameOut)], cStack) := by
          rw [ctxValEq]
          exact .cast entryCast batchRead pairedRead
        refine ⟨fun budget => ?_, Relation.ReflTransGen.single cLocal⟩
        rw [Nat.add_comm 1 budget, (Checked.machine dispatch scopedTypes).run_succ_silent wStep])
      tailSpine

/-- Complete Producer `(function <bodyChildren>)` to `(return <retVal>)` Unwrapping Block
(`scoped_open_produced_function_return_square`):
Composes `ScopedConfigurationRel.producedFunction_step` (1 step: `.produced` → `.primitive` /
`.boundary .producer` → `.minimal`), `.primitive` → `.functionBody` / `LocalStep.minimalFunction`
(1 step), `scoped_open_body_terminal_square` (`bodyMinSteps + 6` steps), and
`ScopedConfigurationRel.functionTerminalReturn_block` (1 step) into a `bodyMinSteps + 9`-step
`ScopedSilentBlock` evaluating `.produced (.expression [.symbol "function", .expression bodyChildren])`
all the way to `.returning [(retVal, wBOut)]` / `.returning [(ctxRetVal, cFrameOut)]` over any
caller stack `wStack` / `cStack`. -/
theorem scoped_open_produced_function_return_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (bodyChildren : List Atom) (bodyResVal retVal : Atom)
    (wBIn wBOut : Bindings) (depth bodyMinSteps : Nat)
    (live : List Atom) (caller : Option Atom) (scope : List String)
    (readiness bodyReadiness retReadiness : Entry.Status)
    (ctxBodyChildren : List Entry.Value) (ctxBodyResVal ctxRetVal : Entry.Value)
    (cFrameIn cFrameOut : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (pendingReady : policy.reentry = .reinterpret ∨ readiness = .active)
    (bodyEq : ctxBodyChildren.map Entry.Value.erase = bodyChildren)
    (resEq : ctxBodyResVal.erase = bodyResVal)
    (retEq : ctxRetVal.erase = retVal)
    (covered : wBOut.applyFullCovered bodyResVal depth = true)
    (wMatRet : wBOut.applyFull bodyResVal depth = .expression [.symbol "return", retVal])
    (cMatRet : cFrameOut.read policy ctxBodyResVal =
      .expression retReadiness [.symbol "return", ctxRetVal])
    (actIn : ScopedActivationRel wBIn cFrameIn)
    (actOut : ScopedActivationRel wBOut cFrameOut)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (bodyMinRun :
      let fnAtom := Atom.expression [.symbol "function", .expression bodyChildren]
      let wMinStart : Configuration :=
        ⟨space, .work (.minimal (.expression bodyChildren) wBIn depth (fnAtom :: live) (some fnAtom)),
          .bodyResults depth (fnAtom :: live) (some fnAtom) ::
            .functionTerminal caller :: wStack, wEmitted⟩
      let wMinEnd : Configuration :=
        ⟨space, .returning [(bodyResVal, wBOut)],
          .bodyResults depth (fnAtom :: live) (some fnAtom) ::
            .functionTerminal caller :: wStack, wEmitted⟩
      let cMinStart : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.minimal (fnAtom :: live) scope (some fnAtom)
            (.expression bodyReadiness ctxBodyChildren) cFrameIn),
          .boundaryBatch (fnAtom :: live) scope (some fnAtom) .body ::
            .boundaryBatch live scope caller .functionDone :: cStack, cEmitted⟩
      let cMinEnd : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .returning [(ctxBodyResVal, cFrameOut)],
          .boundaryBatch (fnAtom :: live) scope (some fnAtom) .body ::
            .boundaryBatch live scope caller .functionDone :: cStack, cEmitted⟩
      (∀ budget,
        (Checked.machine dispatch scopedTypes).run (bodyMinSteps + budget) wMinStart =
          (Checked.machine dispatch scopedTypes).run budget wMinEnd) ∧
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cMinStart.control, cMinStart.stack) (cMinEnd.control, cMinEnd.stack)) :
    let fnAtom := Atom.expression [.symbol "function", .expression bodyChildren]
    let ctxFn := Entry.Value.expression readiness
      [.symbol "function", .expression bodyReadiness ctxBodyChildren]
    let wStart : Configuration :=
      ⟨space, .work (.produced fnAtom wBIn (depth + 3) live caller .emitted), wStack, wEmitted⟩
    let wFinal : Configuration :=
      ⟨space, .returning [(retVal, wBOut)], wStack, wEmitted⟩
    let cStart : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.boundary live scope caller .producer ctxFn cFrameIn), cStack, cEmitted⟩
    let cFinal : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [(ctxRetVal, cFrameOut)], cStack, cEmitted⟩
    (∀ budget,
      (Checked.machine dispatch scopedTypes).run ((bodyMinSteps + 9) + budget) wStart =
        (Checked.machine dispatch scopedTypes).run budget wFinal) ∧
    (Checked.machine dispatch scopedTypes).run (bodyMinSteps + 9) wStart =
      ([], .exhausted wFinal) ∧
    RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
      (cStart.control, cStart.stack) (cFinal.control, cFinal.stack) ∧
    RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
      cStart cFinal ∧
    ContextualSilentPath hostDispatch Completed.scopedLookup policy
      cStart cFinal ∧
    ScopedConfigurationRel wFinal cFinal ∧
    ScopedSilentBlock dispatch hostDispatch policy wStart cStart wFinal cFinal := by
  dsimp only at bodyMinRun ⊢
  let fnAtom := Atom.expression [.symbol "function", .expression bodyChildren]
  let ctxBody := Entry.Value.expression bodyReadiness ctxBodyChildren
  let ctxFn := Entry.Value.expression readiness [.symbol "function", ctxBody]
  have fullBodyEq : ctxBody.erase = .expression bodyChildren := by
    simp [ctxBody, Entry.Value.erase, bodyEq]
  have fnEq : ctxFn.erase = fnAtom := by
    simp [ctxFn, fnAtom, Entry.Value.erase, fullBodyEq]
  have sProd := ScopedConfigurationRel.producedFunction_step
    space dispatch hostDispatch policy (.expression bodyChildren) wBIn (depth + 2) live caller scope
    ctxFn cFrameIn wStack cStack wEmitted cEmitted
    fnEq pendingReady actIn stackRel emittedRel
  have wStep2 :
      (Checked.machine dispatch scopedTypes).step
        ⟨space, .work (.primitive fnAtom wBIn (depth + 2) live caller), wStack, wEmitted⟩ =
      some (.silent
        ⟨space, .work (.functionBody (.expression bodyChildren) wBIn (depth + 1) (fnAtom :: live) (some fnAtom)),
          .functionTerminal caller :: wStack, wEmitted⟩) := rfl
  have cLocal2 :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (.work (.minimal live scope caller ctxFn cFrameIn), cStack)
        (.work (.body (fnAtom :: live) scope (some fnAtom) ctxBody cFrameIn),
          .boundaryBatch live scope caller .functionDone :: cStack) := by
    simpa only [fnAtom, fullBodyEq] using
      (RecursiveMachine.Contextual.LocalStep.minimalFunction
        (space := space) (dispatch := hostDispatch) (lookup := Completed.scopedLookup)
        (policy := policy) (live := live) (scope := scope) (caller := caller)
        (readiness := readiness) (body := ctxBody) (bodyReadiness := bodyReadiness)
        (children := ctxBodyChildren) (activation := cFrameIn) (stack := cStack) rfl)
  have notMin : minimalInstruction (wBOut.applyFull bodyResVal depth) = false := by
    rw [wMatRet]
    rfl
  have sBody := scoped_open_body_terminal_square
    space dispatch hostDispatch policy (.expression bodyChildren) bodyResVal
    ctxBody ctxBodyResVal
    wBIn wBOut cFrameIn cFrameOut depth bodyMinSteps (fnAtom :: live) (some fnAtom) scope
    (.functionTerminal caller :: wStack)
    (.boundaryBatch live scope caller .functionDone :: cStack)
    wEmitted cEmitted
    fullBodyEq resEq actIn actOut covered notMin
    (.cons .functionTerminal stackRel) emittedRel bodyMinRun
  have sRet := ScopedConfigurationRel.functionTerminalReturn_block
    space dispatch hostDispatch policy retReadiness retVal ctxRetVal
    wBOut cFrameOut live caller scope wStack cStack wEmitted cEmitted
    retEq actOut stackRel emittedRel
  have runAll : ∀ budget,
      (Checked.machine dispatch scopedTypes).run ((bodyMinSteps + 9) + budget)
        ⟨space, .work (.produced fnAtom wBIn (depth + 3) live caller .emitted), wStack, wEmitted⟩ =
      (Checked.machine dispatch scopedTypes).run budget
        ⟨space, .returning [(retVal, wBOut)], wStack, wEmitted⟩ := by
    intro budget
    calc
      (Checked.machine dispatch scopedTypes).run ((bodyMinSteps + 9) + budget) _
          = (Checked.machine dispatch scopedTypes).run
              ((((bodyMinSteps + 6) + (1 + budget)) + 1) + 1) _ := by
              rw [show (bodyMinSteps + 9) + budget =
                (((bodyMinSteps + 6) + (1 + budget)) + 1) + 1 by omega]
      _ = (Checked.machine dispatch scopedTypes).run
            (((bodyMinSteps + 6) + (1 + budget)) + 1) _ :=
            (Checked.machine dispatch scopedTypes).run_succ_silent sProd.1
      _ = (Checked.machine dispatch scopedTypes).run
            ((bodyMinSteps + 6) + (1 + budget)) _ :=
            (Checked.machine dispatch scopedTypes).run_succ_silent wStep2
      _ = (Checked.machine dispatch scopedTypes).run (1 + budget) _ := by
            simpa only [wMatRet] using sBody.1 (1 + budget)
      _ = (Checked.machine dispatch scopedTypes).run budget _ := sRet.2.1 budget
  have wRun0 :
      (Checked.machine dispatch scopedTypes).run (bodyMinSteps + 9)
        ⟨space, .work (.produced fnAtom wBIn (depth + 3) live caller .emitted), wStack, wEmitted⟩ =
      ([], .exhausted ⟨space, .returning [(retVal, wBOut)], wStack, wEmitted⟩) :=
    (runAll 0).trans rfl
  have sBodyLocal :
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (.work (.body (fnAtom :: live) scope (some fnAtom) ctxBody cFrameIn),
          .boundaryBatch live scope caller .functionDone :: cStack)
        (.returning [(.expression retReadiness [.symbol "return", ctxRetVal], cFrameOut)],
          .boundaryBatch live scope caller .functionDone :: cStack) := by
    simpa only [cMatRet] using sBody.2.2.1
  have cLocalSteps :
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (.work (.boundary live scope caller .producer ctxFn cFrameIn), cStack)
        (.returning [(ctxRetVal, cFrameOut)], cStack) :=
    (((Relation.ReflTransGen.single sProd.2.1).tail cLocal2).trans sBodyLocal).trans sRet.2.2.2.1
  have cSilentAll :
      ContextualSilentPath hostDispatch Completed.scopedLookup policy
        ⟨space, .work (.boundary live scope caller .producer ctxFn cFrameIn), cStack, cEmitted⟩
        ⟨space, .returning [(ctxRetVal, cFrameOut)], cStack, cEmitted⟩ :=
    localSteps_to_contextualSilentPath cLocalSteps
  have startRel :
      ScopedConfigurationRel
        ⟨space, .work (.produced fnAtom wBIn (depth + 3) live caller .emitted), wStack, wEmitted⟩
        ⟨space, .work (.boundary live scope caller .producer ctxFn cFrameIn), cStack, cEmitted⟩ :=
    ⟨rfl, .work (.produced fnEq actIn), stackRel, emittedRel⟩
  exact ⟨runAll, wRun0, cLocalSteps, localSteps_to_steps cLocalSteps, cSilentAll,
    sRet.2.2.2.2.2.2.1,
    ScopedSilentBlock.of_multi_step (by omega) startRel sRet.2.2.2.2.2.2.1 wRun0 cSilentAll⟩

/-! #### Complete Multi-Row Equation-Call, Raw-Invocation & Function-Invocation Simulation Squares -/

/-- Complete Multi-Row Ordinary Equation-Call Simulation Square
(`scoped_open_callEquations_multi_complete_square`):
Given any `ScopedOpenEquationWorksSpine` (with `prodLive = expected :: live`,
`bodyResults ≠ []`, and `works ≠ []`), executes `.work (.call expr expected wBIn (fuel + 1) live)`
against `.work (.call live scope ctxCall expected cFrameIn)` in `eqSteps + prodSteps + retSteps + 5`
silent worker steps across all three worker passes (`.equations`, `.productions`, `.returns`)
and contextual `LocalSteps` to `.returning finalResults` / `.returning ctxFinalResults`
over any caller stack `wStack` / `cStack`, preserving `ScopedConfigurationRel` and `ScopedSilentBlock`. -/
theorem scoped_open_callEquations_multi_complete_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (expr expected : Atom) (wBIn : Bindings) (fuel eqSteps prodSteps retSteps : Nat)
    (live : List Atom) (scope : List String)
    (ctxCall : Entry.Value) (cFrameIn : Completed.Frame)
    (rows : List (Atom × Bindings)) (works : List Spec.Eval.Steps.EquationWork)
    (bodyResults prodResults : ResultSet)
    (ctxProdResults : List (Entry.Value × Completed.Frame))
    (finalResults : ResultSet)
    (ctxFinalResults : List (Entry.Value × Completed.Frame))
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (valEq : ctxCall.erase = expr)
    (notError : isErrorAtom expr = false)
    (notExec : ∀ op args, expr = .expression (op :: args) → dispatch.isExecutable op = false)
    (nonGrounded : NonGroundedCallRel hostDispatch ctxCall.erase)
    (notMin : minimalInstruction expr = false)
    (queryCovered :
      queryEquationsCovered (equationScope live expr expected wBIn) space expr fuel = true)
    (queryEq :
      queryEquationsAvoiding (equationScope live expr expected wBIn) space expr fuel = rows)
    (bodyNonempty : bodyResults ≠ [])
    (frontierEq :
      Spec.Eval.Steps.EquationFrontierRel space (expected :: live) ctxCall.erase cFrameIn.bindings works)
    (worksNonempty : works ≠ [])
    (actIn : ScopedActivationRel wBIn cFrameIn)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (spine :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr expected wBIn fuel live (expected :: live) scope ctxCall cFrameIn wEmitted
        eqSteps prodSteps retSteps rows works
        bodyResults prodResults ctxProdResults finalResults ctxFinalResults) :
    let wStart : Configuration :=
      ⟨space, .work (.call expr expected wBIn (fuel + 1) live), wStack, wEmitted⟩
    let wFinal : Configuration :=
      ⟨space, .returning finalResults, wStack, wEmitted⟩
    let cStart : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.call live scope ctxCall expected cFrameIn), cStack, cEmitted⟩
    let cFinal : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning ctxFinalResults, cStack, cEmitted⟩
    List.Forall₂ ScopedResultRel finalResults ctxFinalResults ∧
    (∀ budget,
      (Checked.machine dispatch scopedTypes).run
        ((eqSteps + prodSteps + retSteps + 5) + budget) wStart =
        (Checked.machine dispatch scopedTypes).run budget wFinal) ∧
    (Checked.machine dispatch scopedTypes).run
      (eqSteps + prodSteps + retSteps + 5) wStart = ([], .exhausted wFinal) ∧
    RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
      (cStart.control, cStart.stack) (cFinal.control, cFinal.stack) ∧
    RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy cStart cFinal ∧
    ContextualSilentPath hostDispatch Completed.scopedLookup policy cStart cFinal ∧
    ScopedConfigurationRel wFinal cFinal ∧
    ScopedSilentBlock dispatch hostDispatch policy wStart cStart wFinal cFinal := by
  intro wStart wFinal cStart cFinal
  have wStep1 :
      (Checked.machine dispatch scopedTypes).step
        ⟨space, .work (.call expr expected wBIn (fuel + 1) live), wStack, wEmitted⟩ =
      some (.silent
        ⟨space, .work (.invocation (.ordinary expected) expr wBIn (fuel + 1) live none),
          wStack, wEmitted⟩) := rfl
  have noPass : (InvocationMode.ordinary expected).errorPassthrough expr = false := by
    simpa [InvocationMode.errorPassthrough] using notError
  have wStep2 :
      (Checked.machine dispatch scopedTypes).step
        ⟨space, .work (.invocation (.ordinary expected) expr wBIn (fuel + 1) live none),
          wStack, wEmitted⟩ =
      some (.silent
        ⟨space, .work (.equations expr expected wBIn fuel rows live),
          .producerResults (.ordinary expected) expr wBIn fuel live Atom.notReducible :: wStack,
          wEmitted⟩) := by
    have s := worker_invocation_query_step space dispatch (.ordinary expected) expr wBIn fuel
      live none wStack wEmitted noPass notExec notMin queryCovered
    simpa only [InvocationMode.expected, queryEq] using s
  have wStep3 :
      (Checked.machine dispatch scopedTypes).step
        ⟨space, .returning bodyResults,
          .producerResults (.ordinary expected) expr wBIn fuel live Atom.notReducible :: wStack,
          wEmitted⟩ =
      some (.silent
        ⟨space, .work (.producerResults (.ordinary expected) expr wBIn fuel live Atom.notReducible
            bodyResults),
          wStack, wEmitted⟩) := rfl
  have wStep4 :
      (Checked.machine dispatch scopedTypes).step
        ⟨space, .work (.producerResults (.ordinary expected) expr wBIn fuel live Atom.notReducible
            bodyResults),
          wStack, wEmitted⟩ =
      some (.silent
        ⟨space, .work (.productions fuel bodyResults (expected :: live) (some expr) .emitted),
          .invocationReturn (.ordinary expected) expr fuel live :: wStack, wEmitted⟩) := by
    simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter, RecursiveMachine.enter,
      InvocationMode.pendingScope, bodyNonempty, Transition.relabel]
  have wStep5 :
      (Checked.machine dispatch scopedTypes).step
        ⟨space, .returning prodResults,
          .invocationReturn (.ordinary expected) expr fuel live :: wStack, wEmitted⟩ =
      some (.silent
        ⟨space, .work (.returns expr expected fuel prodResults live), wStack, wEmitted⟩) := rfl
  have runAll : ∀ budget,
      (Checked.machine dispatch scopedTypes).run
        ((eqSteps + prodSteps + retSteps + 5) + budget) wStart =
        (Checked.machine dispatch scopedTypes).run budget wFinal := by
    intro budget
    calc
      (Checked.machine dispatch scopedTypes).run
          ((eqSteps + prodSteps + retSteps + 5) + budget) wStart
          = (Checked.machine dispatch scopedTypes).run
              (((eqSteps + (((prodSteps + ((retSteps + budget) + 1)) + 1) + 1)) + 1) + 1) wStart := by
              rw [show (eqSteps + prodSteps + retSteps + 5) + budget =
                ((eqSteps + (((prodSteps + ((retSteps + budget) + 1)) + 1) + 1)) + 1) + 1 by omega]
      _ = (Checked.machine dispatch scopedTypes).run
            ((eqSteps + (((prodSteps + ((retSteps + budget) + 1)) + 1) + 1)) + 1) _ :=
            (Checked.machine dispatch scopedTypes).run_succ_silent wStep1
      _ = (Checked.machine dispatch scopedTypes).run
            (eqSteps + (((prodSteps + ((retSteps + budget) + 1)) + 1) + 1)) _ :=
            (Checked.machine dispatch scopedTypes).run_succ_silent wStep2
      _ = (Checked.machine dispatch scopedTypes).run
            (((prodSteps + ((retSteps + budget) + 1)) + 1) + 1) _ :=
            spine.equations_run
              (.producerResults (.ordinary expected) expr wBIn fuel live Atom.notReducible :: wStack)
              (((prodSteps + ((retSteps + budget) + 1)) + 1) + 1)
      _ = (Checked.machine dispatch scopedTypes).run
            ((prodSteps + ((retSteps + budget) + 1)) + 1) _ :=
            (Checked.machine dispatch scopedTypes).run_succ_silent wStep3
      _ = (Checked.machine dispatch scopedTypes).run
            (prodSteps + ((retSteps + budget) + 1)) _ :=
            (Checked.machine dispatch scopedTypes).run_succ_silent wStep4
      _ = (Checked.machine dispatch scopedTypes).run
            ((retSteps + budget) + 1) _ :=
            spine.productions_run
              (.invocationReturn (.ordinary expected) expr fuel live :: wStack)
              ((retSteps + budget) + 1)
      _ = (Checked.machine dispatch scopedTypes).run
            (retSteps + budget) _ :=
            (Checked.machine dispatch scopedTypes).run_succ_silent wStep5
      _ = (Checked.machine dispatch scopedTypes).run budget wFinal :=
            spine.returns_run wStack budget
  have wRun0 :
      (Checked.machine dispatch scopedTypes).run
        (eqSteps + prodSteps + retSteps + 5) wStart = ([], .exhausted wFinal) :=
    (runAll 0).trans rfl
  have notErrRel : ¬IsErrorRel ctxCall.erase := by
    rw [valEq, Conformance.isErrorRel_iff_isErrorAtom]
    simp [notError]
  have cLocal1 :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (.work (.call live scope ctxCall expected cFrameIn), cStack)
        (.work (.equations live scope ctxCall expected cFrameIn works), cStack) :=
    .callEquations notErrRel nonGrounded frontierEq worksNonempty
  have cLocalSteps :
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cStart.control, cStart.stack) (cFinal.control, cFinal.stack) :=
    (Relation.ReflTransGen.single cLocal1).trans (spine.contextual_equations_localSteps rfl cStack)
  have cSilentAll :
      ContextualSilentPath hostDispatch Completed.scopedLookup policy cStart cFinal :=
    localSteps_to_contextualSilentPath cLocalSteps
  have startRel : ScopedConfigurationRel wStart cStart :=
    ⟨rfl, .work (.call valEq actIn), stackRel, emittedRel⟩
  have finalRel := spine.finalResults_forall2
  have endRel : ScopedConfigurationRel wFinal cFinal :=
    ⟨rfl, .returning finalRel, stackRel, emittedRel⟩
  exact ⟨finalRel, runAll, wRun0, cLocalSteps, localSteps_to_steps cLocalSteps, cSilentAll, endRel,
    ScopedSilentBlock.of_multi_step (by omega) startRel endRel wRun0 cSilentAll⟩

/-- Complete Multi-Row Raw Invocation Equation Simulation Square
(`scoped_open_invocationEquations_raw_multi_complete_square`):
Given any `ScopedOpenEquationWorksSpine` (with `expected = Atom.undefinedType`,
`prodLive = live`, `bodyResults ≠ []`, and `works ≠ []`), executes
`.work (.invocation .raw expr wBIn (fuel + 1) live caller)` against
`.work (.invocation live scope caller ctxCall cFrameIn)` in `eqSteps + prodSteps + 4`
silent worker steps across `.equations` and `.productions` and contextual `LocalSteps`
to `.returning prodResults` / `.returning ctxProdResults`, preserving `ScopedConfigurationRel`
and `ScopedSilentBlock`. -/
theorem scoped_open_invocationEquations_raw_multi_complete_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (expr : Atom) (wBIn : Bindings) (fuel eqSteps prodSteps retSteps : Nat)
    (live : List Atom) (caller : Option Atom) (scope : List String)
    (ctxCall : Entry.Value) (cFrameIn : Completed.Frame)
    (rows : List (Atom × Bindings)) (works : List Spec.Eval.Steps.EquationWork)
    (bodyResults prodResults : ResultSet)
    (ctxProdResults : List (Entry.Value × Completed.Frame))
    (finalResults : ResultSet)
    (ctxFinalResults : List (Entry.Value × Completed.Frame))
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (valEq : ctxCall.erase = expr)
    (notExec : ∀ op args, expr = .expression (op :: args) → dispatch.isExecutable op = false)
    (nonGrounded : NonGroundedCallRel hostDispatch ctxCall.erase)
    (notMin : minimalInstruction expr = false)
    (queryCovered :
      queryEquationsCovered (equationScope live expr Atom.undefinedType wBIn) space expr fuel = true)
    (queryEq :
      queryEquationsAvoiding (equationScope live expr Atom.undefinedType wBIn) space expr fuel = rows)
    (bodyNonempty : bodyResults ≠ [])
    (frontierEq :
      Spec.Eval.Steps.EquationFrontierRel space live ctxCall.erase cFrameIn.bindings works)
    (worksNonempty : works ≠ [])
    (actIn : ScopedActivationRel wBIn cFrameIn)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (spine :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        expr Atom.undefinedType wBIn fuel live live scope ctxCall cFrameIn wEmitted
        eqSteps prodSteps retSteps rows works
        bodyResults prodResults ctxProdResults finalResults ctxFinalResults) :
    let wStart : Configuration :=
      ⟨space, .work (.invocation .raw expr wBIn (fuel + 1) live caller), wStack, wEmitted⟩
    let wFinal : Configuration :=
      ⟨space, .returning prodResults, wStack, wEmitted⟩
    let cStart : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.invocation live scope caller ctxCall cFrameIn), cStack, cEmitted⟩
    let cFinal : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning ctxProdResults, cStack, cEmitted⟩
    List.Forall₂ ScopedResultRel prodResults ctxProdResults ∧
    (∀ budget,
      (Checked.machine dispatch scopedTypes).run
        ((eqSteps + prodSteps + 4) + budget) wStart =
        (Checked.machine dispatch scopedTypes).run budget wFinal) ∧
    (Checked.machine dispatch scopedTypes).run
      (eqSteps + prodSteps + 4) wStart = ([], .exhausted wFinal) ∧
    RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
      (cStart.control, cStart.stack) (cFinal.control, cFinal.stack) ∧
    RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy cStart cFinal ∧
    ContextualSilentPath hostDispatch Completed.scopedLookup policy cStart cFinal ∧
    ScopedConfigurationRel wFinal cFinal ∧
    ScopedSilentBlock dispatch hostDispatch policy wStart cStart wFinal cFinal := by
  intro wStart wFinal cStart cFinal
  have wStep1 :
      (Checked.machine dispatch scopedTypes).step
        ⟨space, .work (.invocation .raw expr wBIn (fuel + 1) live caller), wStack, wEmitted⟩ =
      some (.silent
        ⟨space, .work (.equations expr Atom.undefinedType wBIn fuel rows live),
          .producerResults .raw expr wBIn fuel live Atom.notReducible :: wStack,
          wEmitted⟩) := by
    have s := worker_invocation_query_step space dispatch .raw expr wBIn fuel
      live caller wStack wEmitted rfl notExec notMin queryCovered
    simpa only [InvocationMode.expected, queryEq] using s
  have wStep2 :
      (Checked.machine dispatch scopedTypes).step
        ⟨space, .returning bodyResults,
          .producerResults .raw expr wBIn fuel live Atom.notReducible :: wStack, wEmitted⟩ =
      some (.silent
        ⟨space, .work (.producerResults .raw expr wBIn fuel live Atom.notReducible bodyResults),
          wStack, wEmitted⟩) := rfl
  have wStep3 :
      (Checked.machine dispatch scopedTypes).step
        ⟨space, .work (.producerResults .raw expr wBIn fuel live Atom.notReducible bodyResults),
          wStack, wEmitted⟩ =
      some (.silent
        ⟨space, .work (.productions fuel bodyResults live (some expr) .emitted),
          .invocationReturn .raw expr fuel live :: wStack, wEmitted⟩) := by
    simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter, RecursiveMachine.enter,
      InvocationMode.pendingScope, bodyNonempty, Transition.relabel]
  have wStep4 :
      (Checked.machine dispatch scopedTypes).step
        ⟨space, .returning prodResults,
          .invocationReturn .raw expr fuel live :: wStack, wEmitted⟩ =
      some (.silent ⟨space, .returning prodResults, wStack, wEmitted⟩) := rfl
  have runAll : ∀ budget,
      (Checked.machine dispatch scopedTypes).run
        ((eqSteps + prodSteps + 4) + budget) wStart =
        (Checked.machine dispatch scopedTypes).run budget wFinal := by
    intro budget
    calc
      (Checked.machine dispatch scopedTypes).run
          ((eqSteps + prodSteps + 4) + budget) wStart
          = (Checked.machine dispatch scopedTypes).run
              ((eqSteps + (((prodSteps + (budget + 1)) + 1) + 1)) + 1) wStart := by
              rw [show (eqSteps + prodSteps + 4) + budget =
                (eqSteps + (((prodSteps + (budget + 1)) + 1) + 1)) + 1 by omega]
      _ = (Checked.machine dispatch scopedTypes).run
            (eqSteps + (((prodSteps + (budget + 1)) + 1) + 1)) _ :=
            (Checked.machine dispatch scopedTypes).run_succ_silent wStep1
      _ = (Checked.machine dispatch scopedTypes).run
            (((prodSteps + (budget + 1)) + 1) + 1) _ :=
            spine.equations_run
              (.producerResults .raw expr wBIn fuel live Atom.notReducible :: wStack)
              (((prodSteps + (budget + 1)) + 1) + 1)
      _ = (Checked.machine dispatch scopedTypes).run
            ((prodSteps + (budget + 1)) + 1) _ :=
            (Checked.machine dispatch scopedTypes).run_succ_silent wStep2
      _ = (Checked.machine dispatch scopedTypes).run
            (prodSteps + (budget + 1)) _ :=
            (Checked.machine dispatch scopedTypes).run_succ_silent wStep3
      _ = (Checked.machine dispatch scopedTypes).run (budget + 1) _ :=
            spine.productions_run
              (.invocationReturn .raw expr fuel live :: wStack) (budget + 1)
      _ = (Checked.machine dispatch scopedTypes).run budget wFinal :=
            (Checked.machine dispatch scopedTypes).run_succ_silent wStep4
  have wRun0 :
      (Checked.machine dispatch scopedTypes).run
        (eqSteps + prodSteps + 4) wStart = ([], .exhausted wFinal) :=
    (runAll 0).trans rfl
  have cLocal1 :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (.work (.invocation live scope caller ctxCall cFrameIn), cStack)
        (.work (.invocationEquations live scope ctxCall cFrameIn works), cStack) :=
    .invocationEquations nonGrounded frontierEq worksNonempty
  have cLocalSteps :
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cStart.control, cStart.stack) (cFinal.control, cFinal.stack) :=
    (Relation.ReflTransGen.single cLocal1).trans
      (spine.contextual_invocationEquations_localSteps rfl cStack)
  have cSilentAll :
      ContextualSilentPath hostDispatch Completed.scopedLookup policy cStart cFinal :=
    localSteps_to_contextualSilentPath cLocalSteps
  have startRel : ScopedConfigurationRel wStart cStart :=
    ⟨rfl, .work (.invocationRaw valEq actIn), stackRel, emittedRel⟩
  have prodRel := spine.prodResults_forall2
  have endRel : ScopedConfigurationRel wFinal cFinal :=
    ⟨rfl, .returning prodRel, stackRel, emittedRel⟩
  exact ⟨prodRel, runAll, wRun0, cLocalSteps, localSteps_to_steps cLocalSteps, cSilentAll, endRel,
    ScopedSilentBlock.of_multi_step (by omega) startRel endRel wRun0 cSilentAll⟩

/-- Complete Multi-Row Minimal `(eval atom)` Equations Simulation Square
(`scoped_open_minimalEval_equations_multi_complete_square`):
Composes `ScopedConfigurationRel.minimalEval_block` (`2` worker steps / `1` contextual step)
with `scoped_open_invocationEquations_raw_multi_complete_square` (`eqSteps + prodSteps + 4`
worker steps) into a complete `eqSteps + prodSteps + 6`-step simulation of
`.work (.minimal (.expression [.symbol "eval", atom]) wBIn (fuel + 3) live caller)`
against a multi-row equation space. -/
theorem scoped_open_minimalEval_equations_multi_complete_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (atom : Atom) (wBIn : Bindings) (fuel eqSteps prodSteps retSteps : Nat)
    (live : List Atom) (caller : Option Atom) (scope : List String)
    (readiness : Entry.Status) (ctxAtom : Entry.Value) (cFrameIn : Completed.Frame)
    (rows : List (Atom × Bindings)) (works : List Spec.Eval.Steps.EquationWork)
    (bodyResults prodResults : ResultSet)
    (ctxProdResults : List (Entry.Value × Completed.Frame))
    (finalResults : ResultSet)
    (ctxFinalResults : List (Entry.Value × Completed.Frame))
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (atomEq : ctxAtom.erase = atom)
    (covered : wBIn.applyFullCovered atom (fuel + 1) = true)
    (notExec :
      ∀ op args,
        wBIn.applyFull atom (fuel + 1) = .expression (op :: args) →
        dispatch.isExecutable op = false)
    (nonGrounded : NonGroundedCallRel hostDispatch (cFrameIn.read policy ctxAtom).erase)
    (notMin : minimalInstruction (wBIn.applyFull atom (fuel + 1)) = false)
    (queryCovered :
      queryEquationsCovered
        (equationScope live (wBIn.applyFull atom (fuel + 1)) Atom.undefinedType wBIn)
        space (wBIn.applyFull atom (fuel + 1)) fuel = true)
    (queryEq :
      queryEquationsAvoiding
        (equationScope live (wBIn.applyFull atom (fuel + 1)) Atom.undefinedType wBIn)
        space (wBIn.applyFull atom (fuel + 1)) fuel = rows)
    (bodyNonempty : bodyResults ≠ [])
    (frontierEq :
      Spec.Eval.Steps.EquationFrontierRel space live
        (cFrameIn.read policy ctxAtom).erase cFrameIn.bindings works)
    (worksNonempty : works ≠ [])
    (actIn : ScopedActivationRel wBIn cFrameIn)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (spine :
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        (wBIn.applyFull atom (fuel + 1)) Atom.undefinedType wBIn fuel live live scope
        (cFrameIn.read policy ctxAtom) cFrameIn wEmitted
        eqSteps prodSteps retSteps rows works
        bodyResults prodResults ctxProdResults finalResults ctxFinalResults) :
    let wStart : Configuration :=
      ⟨space, .work (.minimal (.expression [.symbol "eval", atom]) wBIn (fuel + 3) live caller),
        wStack, wEmitted⟩
    let wFinal : Configuration :=
      ⟨space, .returning prodResults, wStack, wEmitted⟩
    let cStart : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.minimal live scope caller
        (.expression readiness [.symbol "eval", ctxAtom]) cFrameIn), cStack, cEmitted⟩
    let cFinal : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning ctxProdResults, cStack, cEmitted⟩
    List.Forall₂ ScopedResultRel prodResults ctxProdResults ∧
    (∀ budget,
      (Checked.machine dispatch scopedTypes).run
        ((eqSteps + prodSteps + 6) + budget) wStart =
        (Checked.machine dispatch scopedTypes).run budget wFinal) ∧
    (Checked.machine dispatch scopedTypes).run
      (eqSteps + prodSteps + 6) wStart = ([], .exhausted wFinal) ∧
    RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
      (cStart.control, cStart.stack) (cFinal.control, cFinal.stack) ∧
    RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy cStart cFinal ∧
    ContextualSilentPath hostDispatch Completed.scopedLookup policy cStart cFinal ∧
    ScopedConfigurationRel wFinal cFinal ∧
    ScopedSilentBlock dispatch hostDispatch policy wStart cStart wFinal cFinal := by
  intro wStart wFinal cStart cFinal
  have sEval := ScopedConfigurationRel.minimalEval_block
    space dispatch hostDispatch policy
    atom wBIn (fuel + 1) live caller scope readiness ctxAtom cFrameIn
    wStack cStack wEmitted cEmitted
    atomEq covered actIn stackRel emittedRel
  have pairRel : ScopedResultRel (atom, wBIn) (ctxAtom, cFrameIn) :=
    ⟨atomEq.symm, actIn⟩
  have evalValEq : (cFrameIn.read policy ctxAtom).erase = wBIn.applyFull atom (fuel + 1) :=
    (pairRel.applyFull_eq_read_erase_of_covered policy (fuel + 1) covered).symm
  have sInv := scoped_open_invocationEquations_raw_multi_complete_square
    space dispatch hostDispatch policy
    (wBIn.applyFull atom (fuel + 1)) wBIn fuel eqSteps prodSteps retSteps
    live caller scope (cFrameIn.read policy ctxAtom) cFrameIn
    rows works bodyResults prodResults ctxProdResults finalResults ctxFinalResults
    wStack cStack wEmitted cEmitted
    evalValEq notExec nonGrounded notMin queryCovered queryEq bodyNonempty
    frontierEq worksNonempty actIn stackRel emittedRel spine
  have runAll : ∀ budget,
      (Checked.machine dispatch scopedTypes).run
        ((eqSteps + prodSteps + 6) + budget) wStart =
        (Checked.machine dispatch scopedTypes).run budget wFinal := by
    intro budget
    rw [show (eqSteps + prodSteps + 6) + budget =
      2 + ((eqSteps + prodSteps + 4) + budget) by omega,
      sEval.1 ((eqSteps + prodSteps + 4) + budget),
      sInv.2.1 budget]
  have wRun0 :
      (Checked.machine dispatch scopedTypes).run
        (eqSteps + prodSteps + 6) wStart = ([], .exhausted wFinal) :=
    (runAll 0).trans rfl
  have cLocalSteps :
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cStart.control, cStart.stack) (cFinal.control, cFinal.stack) :=
    (Relation.ReflTransGen.single sEval.2.2.1).trans sInv.2.2.2.1
  have cSilentAll :
      ContextualSilentPath hostDispatch Completed.scopedLookup policy cStart cFinal :=
    localSteps_to_contextualSilentPath cLocalSteps
  have startRel : ScopedConfigurationRel wStart cStart :=
    ⟨rfl, .work (.minimal (by simp [Entry.Value.erase, atomEq]) actIn), stackRel, emittedRel⟩
  exact ⟨sInv.1, runAll, wRun0, cLocalSteps, localSteps_to_steps cLocalSteps,
    cSilentAll, sInv.2.2.2.2.2.2.1,
    ScopedSilentBlock.of_multi_step (by omega) startRel sInv.2.2.2.2.2.2.1 wRun0 cSilentAll⟩

/-- Multi-Row Invocation-to-Call-to-Caller-Publication Block Simulation
(`scoped_open_invocations_multi_complete_to_caller_publish_square`):
Generalizes `scoped_open_invocations_complete_to_caller_publish_square` to arbitrary multi-row
`.call` outputs `finalResults : ResultSet` and `ctxFinalResults : List Completed.Result`
(`List.Forall₂ ScopedResultRel finalResults ctxFinalResults`), running from
`.work (.bindingAlternatives (.expression (opAtom :: argAtoms)) signature.functionType resultType (fuel + 2) [wBIn] live)` /
`.work (.invocations live scope expected signature ctxOp ctxArgs [cFrameIn])`
through caller `.filter` / `.publish` to
`.returning (successPriority finalResults)` /
`.returning ((completedSuccessPriority (ctxFinalResults.map (Completed.readResult policy))).map (Completed.publishResult policy callAtom))`
in `opSteps + argSteps + callSteps + 17` silent worker steps over any caller stack `wStack` / `cStack`. -/
theorem scoped_open_invocations_multi_complete_to_caller_publish_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (opAtom opVal expected callAtom : Atom) (signature : SelectedTypePolicy)
    (ctxOp ctxOpVal : Entry.Value)
    (argAtoms retVals : List Atom) (ctxArgs ctxRetVals : List Entry.Value)
    (wBIn wBHead wBOut : Bindings)
    (cFrameIn cFrameHead cFrameOut : Completed.Frame)
    (finalResults : ResultSet) (ctxFinalResults : List Completed.Result)
    (fuel opSteps argSteps callSteps depth : Nat) (live : List Atom) (scope : List String)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (opEq : ctxOp.erase = opAtom)
    (opValEq : ctxOpVal.erase = opVal)
    (argsEq : ctxArgs.map Entry.Value.erase = argAtoms)
    (arityEq : ctxArgs.length = signature.argumentTypes.length)
    (argTypesEq : getFunctionArgTypes signature.functionType = some signature.argumentTypes)
    (notStoppedOp : isEmptyOrError opVal = false)
    (finalRel : List.Forall₂ ScopedResultRel finalResults ctxFinalResults)
    (coveredRet : ∀ pair ∈ finalResults, pair.2.applyFullCovered pair.1 depth = true)
    (stableRet : ∀ pair ∈ finalResults, pair.2.applyFull pair.1 depth = pair.1)
    (actIn : ScopedActivationRel wBIn cFrameIn)
    (actHead : ScopedActivationRel wBHead cFrameHead)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (opRun :
      let resultType := Completed.invocationReturnType signature
      let wCallStack : List RecursiveTasks.Frame :=
        .calls resultType (fuel + 2) live ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack
      let cCallStack : List RecursiveTasks.Contextual.Continuation :=
        .calls live scope resultType ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack
      let wOpStart : Configuration :=
        ⟨space, .work (.atom opAtom signature.functionType wBIn (fuel + 1)
            (signature.functionType :: argAtoms ++ (resultType :: live))),
          .heads signature.functionType argAtoms (fuel + 1) (resultType :: live) :: wCallStack,
          wEmitted⟩
      let wOpEnd : Configuration :=
        ⟨space, .returning [(opVal, wBHead)],
          .heads signature.functionType argAtoms (fuel + 1) (resultType :: live) :: wCallStack,
          wEmitted⟩
      let cOpStart : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.atom (signature.functionType :: ctxArgs.map Entry.Value.erase ++ (resultType :: live))
            (scope ++ expectedApplicationScope (.expression ((ctxOp :: ctxArgs).map Entry.Value.erase)) expected)
            ctxOp signature.functionType cFrameIn),
          .functionHeads (resultType :: live) scope (ctxArgs.zip signature.argumentTypes) :: cCallStack,
          cEmitted⟩
      let cOpEnd : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .returning [(ctxOpVal, cFrameHead)],
          .functionHeads (resultType :: live) scope (ctxArgs.zip signature.argumentTypes) :: cCallStack,
          cEmitted⟩
      (∀ budget,
        (Checked.machine dispatch scopedTypes).run (opSteps + budget) wOpStart =
          (Checked.machine dispatch scopedTypes).run budget wOpEnd) ∧
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cOpStart.control, cOpStart.stack) (cOpEnd.control, cOpEnd.stack))
    (argsSpine :
      let resultType := Completed.invocationReturnType signature
      let wCallStack : List RecursiveTasks.Frame :=
        .calls resultType (fuel + 2) live ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack
      let cCallStack : List RecursiveTasks.Contextual.Continuation :=
        .calls live scope resultType ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack
      ScopedOpenArgsSpine space dispatch hostDispatch policy scope wEmitted cEmitted
        (fuel + 1) argSteps (opVal :: resultType :: live) argAtoms signature.argumentTypes
        (ctxArgs.zip signature.argumentTypes) retVals ctxRetVals
        wBHead cFrameHead wBOut cFrameOut
        (.functionTail opVal ::
          .append (.heads signature.functionType argAtoms (fuel + 1) [] (resultType :: live)) ::
          wCallStack)
        (.functionAssemble ctxOpVal ::
          .append (.functionBranches (resultType :: live) scope
            (ctxArgs.zip signature.argumentTypes) []) ::
          cCallStack))
    (callRun :
      let resultType := Completed.invocationReturnType signature
      let outAtom : Atom := .expression (opVal :: retVals)
      let ctxCall : Entry.Value := .expression .active (ctxOpVal :: ctxRetVals)
      let wDrainStack : List RecursiveTasks.Frame :=
        .append (.calls resultType (fuel + 2) [] live) ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack
      let cDrainStack : List RecursiveTasks.Contextual.Continuation :=
        .append (.calls live scope resultType []) ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack
      let wCallStart : Configuration :=
        ⟨space, .work (.call outAtom resultType wBOut (fuel + 2) live), wDrainStack, wEmitted⟩
      let wCallEnd : Configuration :=
        ⟨space, .returning finalResults, wDrainStack, wEmitted⟩
      let cCallStart : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.call live scope ctxCall resultType cFrameOut), cDrainStack, cEmitted⟩
      let cCallEnd : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .returning ctxFinalResults, cDrainStack, cEmitted⟩
      (∀ budget,
        (Checked.machine dispatch scopedTypes).run (callSteps + budget) wCallStart =
          (Checked.machine dispatch scopedTypes).run budget wCallEnd) ∧
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cCallStart.control, cCallStart.stack) (cCallEnd.control, cCallEnd.stack)) :
    let resultType := Completed.invocationReturnType signature
    let cSelected := completedSuccessPriority (ctxFinalResults.map (Completed.readResult policy))
    let cPublished := cSelected.map (Completed.publishResult policy callAtom)
    let wBefore : Configuration :=
      ⟨space, .work (.bindingAlternatives (.expression (opAtom :: argAtoms))
          signature.functionType resultType (fuel + 2) [wBIn] live),
        .filter :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.invocations live scope expected signature ctxOp ctxArgs [cFrameIn]),
        .publish callAtom :: cStack, cEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning (successPriority finalResults), wStack, wEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning cPublished, cStack, cEmitted⟩
    List.Forall₂ ScopedResultRel (successPriority finalResults) cPublished ∧
    (∀ budget,
      (Checked.machine dispatch scopedTypes).run
        ((opSteps + argSteps + callSteps + 17) + budget) wBefore =
        (Checked.machine dispatch scopedTypes).run budget wAfter) ∧
    (Checked.machine dispatch scopedTypes).run
      (opSteps + argSteps + callSteps + 17) wBefore = ([], .exhausted wAfter) ∧
    RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy cBefore cAfter ∧
    ContextualSilentPath hostDispatch Completed.scopedLookup policy cBefore cAfter ∧
    ScopedConfigurationRel wAfter cAfter ∧
    ScopedSilentBlock dispatch hostDispatch policy wBefore cBefore wAfter cAfter := by
  intro resultType cSelected cPublished wBefore cBefore wAfter cAfter
  have stackFilter :
      List.Forall₂ ScopedFrameRel (.filter :: wStack) (.publish callAtom :: cStack) :=
    .cons (.filter callAtom) stackRel
  have invSq := scoped_open_invocations_to_call_square
    space dispatch hostDispatch policy
    opAtom opVal expected signature ctxOp ctxOpVal
    argAtoms retVals ctxArgs ctxRetVals
    wBIn wBHead wBOut cFrameIn cFrameHead cFrameOut
    [] [] fuel opSteps argSteps live scope
    (.filter :: wStack) (.publish callAtom :: cStack)
    wEmitted cEmitted
    opEq opValEq argsEq arityEq argTypesEq notStoppedOp
    actIn actHead .nil stackFilter emittedRel opRun argsSpine
  rcases invSq with ⟨wInvRun, _, cInvLocal, _, _, _, _⟩
  rcases callRun with ⟨wCallRun, cCallLocal⟩
  have drainSq := scoped_open_callsNil_and_invocationsNil_drain_square
    space dispatch hostDispatch policy
    opAtom expected signature ctxOp argAtoms ctxArgs
    finalResults ctxFinalResults
    (fuel + 2) live scope
    (.filter :: wStack) (.publish callAtom :: cStack)
    wEmitted cEmitted
    opEq argsEq finalRel stackFilter emittedRel
  rcases drainSq with ⟨wDrainRun, _, cDrainLocal, _, _, _, _⟩
  have sPub := ScopedConfigurationRel.filter_publish_step_of_covered_stable
    space dispatch hostDispatch policy callAtom
    finalResults ctxFinalResults
    wStack cStack wEmitted cEmitted
    finalRel depth coveredRet stableRet stackRel emittedRel
  rcases sPub with ⟨wStepPub, cStepPub, _, cfgRelPub⟩
  have pubRel : List.Forall₂ ScopedResultRel (successPriority finalResults) cPublished := by
    rcases cfgRelPub with ⟨_, ctrlRel, _, _⟩
    cases ctrlRel with
    | returning rel => exact rel
  have runAll : ∀ budget,
      (Checked.machine dispatch scopedTypes).run
        ((opSteps + argSteps + callSteps + 17) + budget) wBefore =
        (Checked.machine dispatch scopedTypes).run budget wAfter := by
    intro budget
    rw [show (opSteps + argSteps + callSteps + 17) + budget =
      (opSteps + argSteps + 10) + (callSteps + (6 + (budget + 1))) by omega,
      wInvRun (callSteps + (6 + (budget + 1))),
      wCallRun (6 + (budget + 1)),
      wDrainRun (budget + 1),
      (Checked.machine dispatch scopedTypes).run_succ_silent wStepPub]
  have wRun0 :
      (Checked.machine dispatch scopedTypes).run
        (opSteps + argSteps + callSteps + 17) wBefore = ([], .exhausted wAfter) :=
    (runAll 0).trans rfl
  have cLocalAll :
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) :=
    (((cInvLocal.trans cCallLocal).trans cDrainLocal).tail cStepPub)
  have cSilentAll :
      ContextualSilentPath hostDispatch Completed.scopedLookup policy cBefore cAfter :=
    localSteps_to_contextualSilentPath cLocalAll
  have startRel : ScopedConfigurationRel wBefore cBefore :=
    ⟨rfl, .work (.bindingAlternatives opEq argsEq rfl rfl (.cons actIn .nil)),
      stackFilter, emittedRel⟩
  exact ⟨pubRel, runAll, wRun0, cLocalAll, localSteps_to_steps cLocalAll,
    cSilentAll, cfgRelPub,
    ScopedSilentBlock.of_multi_step (by omega) startRel cfgRelPub wRun0 cSilentAll⟩

/-- Complete Multi-Row Equation-Defined Function Invocation to Caller Publish Square
(`scoped_open_equation_invocation_multi_complete_to_caller_publish_square`):
Composes `scoped_open_invocations_multi_complete_to_caller_publish_square` with
`scoped_open_callEquations_multi_complete_square` over any multi-row `ScopedOpenEquationWorksSpine`
into a single `opSteps + argSteps + eqSteps + prodSteps + retSteps + 22`-step simulation
from `.work (.bindingAlternatives ...)` / `.work (.invocations ...)` through caller
`.filter` / `.publish` over any caller stack `wStack` / `cStack`, preserving
`ScopedConfigurationRel` and `ScopedSilentBlock`. -/
theorem scoped_open_equation_invocation_multi_complete_to_caller_publish_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (opAtom opVal expected callAtom : Atom) (signature : SelectedTypePolicy)
    (ctxOp ctxOpVal : Entry.Value)
    (argAtoms retVals : List Atom) (ctxArgs ctxRetVals : List Entry.Value)
    (wBIn wBHead wBArgs : Bindings)
    (cFrameIn cFrameHead cFrameArgs : Completed.Frame)
    (rows : List (Atom × Bindings)) (works : List Spec.Eval.Steps.EquationWork)
    (bodyResults prodResults : ResultSet)
    (ctxProdResults : List (Entry.Value × Completed.Frame))
    (finalResults : ResultSet)
    (ctxFinalResults : List (Entry.Value × Completed.Frame))
    (fuel opSteps argSteps eqSteps prodSteps retSteps depth : Nat)
    (live : List Atom) (scope : List String)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (opEq : ctxOp.erase = opAtom)
    (opValEq : ctxOpVal.erase = opVal)
    (argsEq : ctxArgs.map Entry.Value.erase = argAtoms)
    (retValsEq : ctxRetVals.map Entry.Value.erase = retVals)
    (arityEq : ctxArgs.length = signature.argumentTypes.length)
    (argTypesEq : getFunctionArgTypes signature.functionType = some signature.argumentTypes)
    (notStoppedOp : isEmptyOrError opVal = false)
    (notErrorCall : isErrorAtom (.expression (opVal :: retVals)) = false)
    (notExec :
      ∀ op args,
        Atom.expression (opVal :: retVals) = .expression (op :: args) →
        dispatch.isExecutable op = false)
    (nonGrounded :
      NonGroundedCallRel hostDispatch
        (Entry.Value.expression .active (ctxOpVal :: ctxRetVals)).erase)
    (notMin : minimalInstruction (.expression (opVal :: retVals)) = false)
    (queryCovered :
      queryEquationsCovered
        (equationScope live (.expression (opVal :: retVals))
          (Completed.invocationReturnType signature) wBArgs)
        space (.expression (opVal :: retVals)) (fuel + 1) = true)
    (queryEq :
      queryEquationsAvoiding
        (equationScope live (.expression (opVal :: retVals))
          (Completed.invocationReturnType signature) wBArgs)
        space (.expression (opVal :: retVals)) (fuel + 1) = rows)
    (bodyNonempty : bodyResults ≠ [])
    (frontierEq :
      Spec.Eval.Steps.EquationFrontierRel space
        (Completed.invocationReturnType signature :: live)
        (Entry.Value.expression .active (ctxOpVal :: ctxRetVals)).erase
        cFrameArgs.bindings works)
    (worksNonempty : works ≠ [])
    (coveredRet : ∀ pair ∈ finalResults, pair.2.applyFullCovered pair.1 depth = true)
    (stableRet : ∀ pair ∈ finalResults, pair.2.applyFull pair.1 depth = pair.1)
    (actIn : ScopedActivationRel wBIn cFrameIn)
    (actHead : ScopedActivationRel wBHead cFrameHead)
    (actArgs : ScopedActivationRel wBArgs cFrameArgs)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (opRun :
      let resultType := Completed.invocationReturnType signature
      let wCallStack : List RecursiveTasks.Frame :=
        .calls resultType (fuel + 2) live ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack
      let cCallStack : List RecursiveTasks.Contextual.Continuation :=
        .calls live scope resultType ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack
      let wOpStart : Configuration :=
        ⟨space, .work (.atom opAtom signature.functionType wBIn (fuel + 1)
            (signature.functionType :: argAtoms ++ (resultType :: live))),
          .heads signature.functionType argAtoms (fuel + 1) (resultType :: live) :: wCallStack,
          wEmitted⟩
      let wOpEnd : Configuration :=
        ⟨space, .returning [(opVal, wBHead)],
          .heads signature.functionType argAtoms (fuel + 1) (resultType :: live) :: wCallStack,
          wEmitted⟩
      let cOpStart : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.atom (signature.functionType :: ctxArgs.map Entry.Value.erase ++ (resultType :: live))
            (scope ++ expectedApplicationScope (.expression ((ctxOp :: ctxArgs).map Entry.Value.erase)) expected)
            ctxOp signature.functionType cFrameIn),
          .functionHeads (resultType :: live) scope (ctxArgs.zip signature.argumentTypes) :: cCallStack,
          cEmitted⟩
      let cOpEnd : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .returning [(ctxOpVal, cFrameHead)],
          .functionHeads (resultType :: live) scope (ctxArgs.zip signature.argumentTypes) :: cCallStack,
          cEmitted⟩
      (∀ budget,
        (Checked.machine dispatch scopedTypes).run (opSteps + budget) wOpStart =
          (Checked.machine dispatch scopedTypes).run budget wOpEnd) ∧
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cOpStart.control, cOpStart.stack) (cOpEnd.control, cOpEnd.stack))
    (argsSpine :
      let resultType := Completed.invocationReturnType signature
      let wCallStack : List RecursiveTasks.Frame :=
        .calls resultType (fuel + 2) live ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack
      let cCallStack : List RecursiveTasks.Contextual.Continuation :=
        .calls live scope resultType ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack
      ScopedOpenArgsSpine space dispatch hostDispatch policy scope wEmitted cEmitted
        (fuel + 1) argSteps (opVal :: resultType :: live) argAtoms signature.argumentTypes
        (ctxArgs.zip signature.argumentTypes) retVals ctxRetVals
        wBHead cFrameHead wBArgs cFrameArgs
        (.functionTail opVal ::
          .append (.heads signature.functionType argAtoms (fuel + 1) [] (resultType :: live)) ::
          wCallStack)
        (.functionAssemble ctxOpVal ::
          .append (.functionBranches (resultType :: live) scope
            (ctxArgs.zip signature.argumentTypes) []) ::
          cCallStack))
    (eqSpine :
      let resultType := Completed.invocationReturnType signature
      let outAtom : Atom := .expression (opVal :: retVals)
      let ctxCall : Entry.Value := .expression .active (ctxOpVal :: ctxRetVals)
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        outAtom resultType wBArgs (fuel + 1) live (resultType :: live) scope
        ctxCall cFrameArgs wEmitted
        eqSteps prodSteps retSteps rows works
        bodyResults prodResults ctxProdResults finalResults ctxFinalResults) :
    let resultType := Completed.invocationReturnType signature
    let cSelected := completedSuccessPriority (ctxFinalResults.map (Completed.readResult policy))
    let cPublished := cSelected.map (Completed.publishResult policy callAtom)
    let wBefore : Configuration :=
      ⟨space, .work (.bindingAlternatives (.expression (opAtom :: argAtoms))
          signature.functionType resultType (fuel + 2) [wBIn] live),
        .filter :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.invocations live scope expected signature ctxOp ctxArgs [cFrameIn]),
        .publish callAtom :: cStack, cEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning (successPriority finalResults), wStack, wEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning cPublished, cStack, cEmitted⟩
    List.Forall₂ ScopedResultRel (successPriority finalResults) cPublished ∧
    (∀ budget,
      (Checked.machine dispatch scopedTypes).run
        ((opSteps + argSteps + eqSteps + prodSteps + retSteps + 22) + budget) wBefore =
        (Checked.machine dispatch scopedTypes).run budget wAfter) ∧
    (Checked.machine dispatch scopedTypes).run
      (opSteps + argSteps + eqSteps + prodSteps + retSteps + 22) wBefore = ([], .exhausted wAfter) ∧
    RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy cBefore cAfter ∧
    ContextualSilentPath hostDispatch Completed.scopedLookup policy cBefore cAfter ∧
    ScopedConfigurationRel wAfter cAfter ∧
    ScopedSilentBlock dispatch hostDispatch policy wBefore cBefore wAfter cAfter := by
  intro resultType cSelected cPublished wBefore cBefore wAfter cAfter
  dsimp only at opRun eqSpine ⊢
  have assembledEq :
      (Entry.Value.expression .active (ctxOpVal :: ctxRetVals)).erase =
        .expression (opVal :: retVals) := by
    simp [Entry.Value.erase, opValEq, retValsEq]
  have drainStackRel :
      List.Forall₂ ScopedFrameRel
        (.append (.calls resultType (fuel + 2) [] live) ::
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live) ::
          .filter :: wStack)
        (.append (.calls live scope resultType []) ::
          .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
          .publish callAtom :: cStack) :=
    .cons (.append (.calls .nil))
      (.cons (.append (.bindingAlternatives opEq argsEq rfl rfl .nil))
        (.cons (.filter callAtom) stackRel))
  have callSq := scoped_open_callEquations_multi_complete_square
    space dispatch hostDispatch policy
    (.expression (opVal :: retVals)) resultType
    wBArgs (fuel + 1) eqSteps prodSteps retSteps live scope
    (.expression .active (ctxOpVal :: ctxRetVals)) cFrameArgs
    rows works bodyResults prodResults ctxProdResults finalResults ctxFinalResults
    (.append (.calls resultType (fuel + 2) [] live) ::
      .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
        signature.functionType resultType (fuel + 2) [] live) ::
      .filter :: wStack)
    (.append (.calls live scope resultType []) ::
      .append (.invocations live scope expected signature ctxOp ctxArgs []) ::
      .publish callAtom :: cStack)
    wEmitted cEmitted
    assembledEq notErrorCall notExec nonGrounded notMin
    queryCovered queryEq bodyNonempty frontierEq worksNonempty
    actArgs drainStackRel emittedRel eqSpine
  have fullRun := scoped_open_invocations_multi_complete_to_caller_publish_square
    space dispatch hostDispatch policy
    opAtom opVal expected callAtom signature
    ctxOp ctxOpVal argAtoms retVals ctxArgs ctxRetVals
    wBIn wBHead wBArgs cFrameIn cFrameHead cFrameArgs
    finalResults ctxFinalResults
    fuel opSteps argSteps (eqSteps + prodSteps + retSteps + 5) depth live scope
    wStack cStack wEmitted cEmitted
    opEq opValEq argsEq arityEq argTypesEq
    notStoppedOp callSq.1 coveredRet stableRet
    actIn actHead stackRel emittedRel
    opRun argsSpine ⟨callSq.2.1, callSq.2.2.2.1⟩
  refine ⟨fullRun.1, ?_, ?_, fullRun.2.2.2.1, fullRun.2.2.2.2.1,
    fullRun.2.2.2.2.2.1, fullRun.2.2.2.2.2.2.1, fullRun.2.2.2.2.2.2.2⟩
  · intro budget
