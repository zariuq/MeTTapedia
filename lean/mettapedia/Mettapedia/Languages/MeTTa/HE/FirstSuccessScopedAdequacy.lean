    exact fullRun.2.1 budget
  · rw [show opSteps + argSteps + eqSteps + prodSteps + retSteps + 22 =
      opSteps + argSteps + (eqSteps + prodSteps + retSteps + 5) + 17 by omega]
    exact fullRun.2.2.1

/-- Top-Level Multi-Row Equation-Defined Function Invocation Completion and Bag Drain
(`scoped_open_equation_invocation_multi_complete_and_drain_bag`):
Combines `scoped_open_equation_invocation_multi_complete_to_caller_publish_square` at top-level
caller stack (`wStack = []`, `cStack = []`) with `ScopedSilentBlockTrace.complete_and_drain_bag`
to establish complete drain to `.finished` on both machines, `ScopedBagConfigurationRel`,
`ScopedEmittedBagRel`, and exact `workerPublicAnswers = publicAnswers` and `readout` verdict
on every `publicScope`. -/
theorem scoped_open_equation_invocation_multi_complete_and_drain_bag
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (opAtom opVal expected callAtom : Atom) (signature : SelectedTypePolicy)
    (ctxOp ctxOpVal : Entry.Value)
    (argAtoms retVals : List Atom) (ctxArgs ctxRetVals : List Entry.Value)
    (wBIn wBHead wBArgs : Bindings)
    (cFrameIn cFrameHead cFrameArgs : Completed.Frame)
    (rows : List (Atom × Bindings)) (works : List Spec.Eval.Steps.EquationWork)
    (bodyResults prodResults : ResultSet)
    (ctxProdResults : List (Entry.Value × Completed.Frame))
    (finalResults : ResultSet)
    (ctxFinalResults : List (Entry.Value × Completed.Frame))
    (fuel opSteps argSteps eqSteps prodSteps retSteps depth : Nat)
    (live : List Atom) (scope : List String)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (opEq : ctxOp.erase = opAtom)
    (opValEq : ctxOpVal.erase = opVal)
    (argsEq : ctxArgs.map Entry.Value.erase = argAtoms)
    (retValsEq : ctxRetVals.map Entry.Value.erase = retVals)
    (arityEq : ctxArgs.length = signature.argumentTypes.length)
    (argTypesEq : getFunctionArgTypes signature.functionType = some signature.argumentTypes)
    (notStoppedOp : isEmptyOrError opVal = false)
    (notErrorCall : isErrorAtom (.expression (opVal :: retVals)) = false)
    (notExec :
      ∀ op args,
        Atom.expression (opVal :: retVals) = .expression (op :: args) →
        dispatch.isExecutable op = false)
    (nonGrounded :
      NonGroundedCallRel hostDispatch
        (Entry.Value.expression .active (ctxOpVal :: ctxRetVals)).erase)
    (notMin : minimalInstruction (.expression (opVal :: retVals)) = false)
    (queryCovered :
      queryEquationsCovered
        (equationScope live (.expression (opVal :: retVals))
          (Completed.invocationReturnType signature) wBArgs)
        space (.expression (opVal :: retVals)) (fuel + 1) = true)
    (queryEq :
      queryEquationsAvoiding
        (equationScope live (.expression (opVal :: retVals))
          (Completed.invocationReturnType signature) wBArgs)
        space (.expression (opVal :: retVals)) (fuel + 1) = rows)
    (bodyNonempty : bodyResults ≠ [])
    (frontierEq :
      Spec.Eval.Steps.EquationFrontierRel space
        (Completed.invocationReturnType signature :: live)
        (Entry.Value.expression .active (ctxOpVal :: ctxRetVals)).erase
        cFrameArgs.bindings works)
    (worksNonempty : works ≠ [])
    (coveredRet : ∀ pair ∈ finalResults, pair.2.applyFullCovered pair.1 depth = true)
    (stableRet : ∀ pair ∈ finalResults, pair.2.applyFull pair.1 depth = pair.1)
    (actIn : ScopedActivationRel wBIn cFrameIn)
    (actHead : ScopedActivationRel wBHead cFrameHead)
    (actArgs : ScopedActivationRel wBArgs cFrameArgs)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (opRun :
      let resultType := Completed.invocationReturnType signature
      let wCallStack : List RecursiveTasks.Frame :=
        [.calls resultType (fuel + 2) live,
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live),
          .filter]
      let cCallStack : List RecursiveTasks.Contextual.Continuation :=
        [.calls live scope resultType,
          .append (.invocations live scope expected signature ctxOp ctxArgs []),
          .publish callAtom]
      let wOpStart : Configuration :=
        ⟨space, .work (.atom opAtom signature.functionType wBIn (fuel + 1)
            (signature.functionType :: argAtoms ++ (resultType :: live))),
          .heads signature.functionType argAtoms (fuel + 1) (resultType :: live) :: wCallStack,
          wEmitted⟩
      let wOpEnd : Configuration :=
        ⟨space, .returning [(opVal, wBHead)],
          .heads signature.functionType argAtoms (fuel + 1) (resultType :: live) :: wCallStack,
          wEmitted⟩
      let cOpStart : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.atom (signature.functionType :: ctxArgs.map Entry.Value.erase ++ (resultType :: live))
            (scope ++ expectedApplicationScope (.expression ((ctxOp :: ctxArgs).map Entry.Value.erase)) expected)
            ctxOp signature.functionType cFrameIn),
          .functionHeads (resultType :: live) scope (ctxArgs.zip signature.argumentTypes) :: cCallStack,
          cEmitted⟩
      let cOpEnd : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .returning [(ctxOpVal, cFrameHead)],
          .functionHeads (resultType :: live) scope (ctxArgs.zip signature.argumentTypes) :: cCallStack,
          cEmitted⟩
      (∀ budget,
        (Checked.machine dispatch scopedTypes).run (opSteps + budget) wOpStart =
          (Checked.machine dispatch scopedTypes).run budget wOpEnd) ∧
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cOpStart.control, cOpStart.stack) (cOpEnd.control, cOpEnd.stack))
    (argsSpine :
      let resultType := Completed.invocationReturnType signature
      let wCallStack : List RecursiveTasks.Frame :=
        [.calls resultType (fuel + 2) live,
          .append (.bindingAlternatives (.expression (opAtom :: argAtoms))
            signature.functionType resultType (fuel + 2) [] live),
          .filter]
      let cCallStack : List RecursiveTasks.Contextual.Continuation :=
        [.calls live scope resultType,
          .append (.invocations live scope expected signature ctxOp ctxArgs []),
          .publish callAtom]
      ScopedOpenArgsSpine space dispatch hostDispatch policy scope wEmitted cEmitted
        (fuel + 1) argSteps (opVal :: resultType :: live) argAtoms signature.argumentTypes
        (ctxArgs.zip signature.argumentTypes) retVals ctxRetVals
        wBHead cFrameHead wBArgs cFrameArgs
        (.functionTail opVal ::
          .append (.heads signature.functionType argAtoms (fuel + 1) [] (resultType :: live)) ::
          wCallStack)
        (.functionAssemble ctxOpVal ::
          .append (.functionBranches (resultType :: live) scope
            (ctxArgs.zip signature.argumentTypes) []) ::
          cCallStack))
    (eqSpine :
      let resultType := Completed.invocationReturnType signature
      let outAtom : Atom := .expression (opVal :: retVals)
      let ctxCall : Entry.Value := .expression .active (ctxOpVal :: ctxRetVals)
      ScopedOpenEquationWorksSpine space dispatch hostDispatch policy
        outAtom resultType wBArgs (fuel + 1) live (resultType :: live) scope
        ctxCall cFrameArgs wEmitted
        eqSteps prodSteps retSteps rows works
        bodyResults prodResults ctxProdResults finalResults ctxFinalResults) :
    let resultType := Completed.invocationReturnType signature
    let cSelected := completedSuccessPriority (ctxFinalResults.map (Completed.readResult policy))
    let cPublished := cSelected.map (Completed.publishResult policy callAtom)
    let wStart : Configuration :=
      ⟨space, .work (.bindingAlternatives (.expression (opAtom :: argAtoms))
          signature.functionType resultType (fuel + 2) [wBIn] live),
        [.filter], wEmitted⟩
    let cStart : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.invocations live scope expected signature ctxOp ctxArgs [cFrameIn]),
        [.publish callAtom], cEmitted⟩
    let wCompleted : Configuration :=
      ⟨space, .returning [], [], wEmitted ++ successPriority finalResults⟩
    let cCompleted : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [], [], cEmitted ++ cPublished⟩
    ScopedBagConfigurationRel wCompleted cCompleted ∧
    ScopedEmittedBagRel (successPriority finalResults) cPublished ∧
    wCompleted.emitted.length = cCompleted.emitted.length ∧
    (∃ wBudget, (Checked.machine dispatch scopedTypes).run wBudget wStart =
      (successPriority finalResults, .finished wCompleted)) ∧
    RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
      cStart cCompleted ∧
    (∃ cBudget cEvents,
      Derivation
        (RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy)
        cBudget cStart cEvents (.finished cCompleted.emitted)) ∧
    (∀ publicScope : List String,
      workerPublicAnswers publicScope wCompleted.emitted =
        RecursiveExecution.Contextual.Protocol.publicAnswers publicScope cCompleted.emitted ∧
      workerPublicAnswers publicScope wCompleted.emitted =
        (RecursiveExecution.Contextual.Protocol.readout publicScope).verdict cCompleted.emitted) := by
  intro resultType cSelected cPublished wStart cStart wCompleted cCompleted
  have invSq := scoped_open_equation_invocation_multi_complete_to_caller_publish_square
    space dispatch hostDispatch policy
    opAtom opVal expected callAtom signature
    ctxOp ctxOpVal argAtoms retVals ctxArgs ctxRetVals
    wBIn wBHead wBArgs cFrameIn cFrameHead cFrameArgs
    rows works bodyResults prodResults ctxProdResults finalResults ctxFinalResults
    fuel opSteps argSteps eqSteps prodSteps retSteps depth live scope
    [] [] wEmitted cEmitted
    opEq opValEq argsEq retValsEq arityEq argTypesEq
    notStoppedOp notErrorCall notExec nonGrounded notMin
    queryCovered queryEq bodyNonempty frontierEq worksNonempty
    coveredRet stableRet actIn actHead actArgs .nil emittedRel
    opRun argsSpine eqSpine
  rcases invSq with ⟨_, _, _, _, _, _, cfgRelFinal, block⟩
  exact (ScopedSilentBlockTrace.step block
    (.refl (ScopedConfigurationRel.to_bagConfigurationRel cfgRelFinal))).complete_and_drain_bag


end UniversalScopedPolymorphicApplication


