/-- Open caller frame containing a prior binding `"t" ↦ Number` and an open
caller alias `"caller" = "x"`. -/
def callerIncomingOpen : Bindings :=
  ⟨[("t", .symbol "Number")], [("caller", "x")]⟩

theorem callerIncomingOpen_acyclic : callerIncomingOpen.hasLoop = false := by
  decide +kernel

theorem callerIncomingOpen_nonvariable : AssignmentsNonVariable callerIncomingOpen := by
  intro key value member
  simp only [callerIncomingOpen, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at member
  rcases member with ⟨rfl, rfl⟩
  rfl

theorem callerIncomingOpen_structurally_solved : ClassAssignmentsStructurallySolved callerIncomingOpen := by
  intro left right leftValue rightValue leftStored rightStored _
  simp only [callerIncomingOpen, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at leftStored rightStored
  rcases leftStored with ⟨rfl, rfl⟩
  rcases rightStored with ⟨rfl, rfl⟩
  exact AtomSolved.refl _ _

theorem callerIncomingOpen_principal : PrincipalBindingFrame callerIncomingOpen :=
  ⟨(hasLoop_eq_false_iff_semanticLoopFree _).mp callerIncomingOpen_acyclic,
   callerIncomingOpen_nonvariable,
   canonicalClassCoherent_of_structurallySolved _ _ callerIncomingOpen_structurally_solved⟩

theorem callerIncomingOpen_certificate :
    ReadoutCertificate callerIncomingOpen (nativeReadoutPresentation callerIncomingOpen) :=
  nativeReadoutPresentation_certificate callerIncomingOpen_principal.loopFree
    callerIncomingOpen_principal.nonvariable callerIncomingOpen_principal.coherent (fun _ => Iff.rfl)

theorem callerIncomingOpen_frameRelated :
    SourceBindingComparison.semantic.FrameRelated callerIncomingOpen
      (.selected callerIncomingOpen (nativeReadoutPresentation callerIncomingOpen)
        callerIncomingOpen_certificate) :=
  SourceBindingComparison.FrameRelated.of_principal callerIncomingOpen_principal (.refl _)

