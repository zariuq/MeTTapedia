theorem ScopedConfigurationRel.returnRefused_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original expected : Atom) (wB : Bindings) (fuel : Nat)
    (live : List Atom) (scope : List String)
    (ctxOrig ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (origEq : ctxOrig.erase = original)
    (refused : ctxVal.erase = Atom.notReducible)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.returned original Atom.notReducible expected wB fuel live),
        wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning [(original, wB)], wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.returned live scope ctxOrig expected ctxVal cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [(ctxOrig, cFrame)], cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter :=
  ⟨rfl, .returnRefused refused, .internal (.returnRefused refused),
   ⟨rfl, .returning (.cons ⟨origEq.symm, actRel⟩ .nil), stackRel, emittedRel⟩⟩

/-- Commuting Evaluate-Return Task Square (`ScopedConfigurationRel.returnEvaluate_step`):
When `.returned` receives a value that is neither `Atom.notReducible` nor empty/error
and satisfies `ScopedAtomEntryReady policy value ctxVal cFrame`, both machines step in 1
silent transition to `.atom` while preserving `ScopedConfigurationRel` and `ScopedAtomEntryReady`. -/
theorem ScopedConfigurationRel.returnEvaluate_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original value expected : Atom) (wB : Bindings) (fuel : Nat)
    (live : List Atom) (scope : List String)
    (ctxOrig ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (entryReady : ScopedAtomEntryReady policy value ctxVal cFrame)
    (notRefused : value ≠ Atom.notReducible)
    (notStopped : isEmptyOrError value = false)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.returned original value expected wB fuel live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.atom value expected wB fuel live), wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.returned live scope ctxOrig expected ctxVal cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal expected cFrame), cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter ∧
    ScopedAtomEntryReady policy value ctxVal cFrame := by
  have valEq := entryReady.1
  have wStep : (Checked.machine dispatch scopedTypes).step
      ⟨space, .work (.returned original value expected wB fuel live), wStack, wEmitted⟩ =
      some (.silent ⟨space, .work (.atom value expected wB fuel live), wStack, wEmitted⟩) := by
    simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, notRefused, notStopped, Transition.relabel]
  have cNotRefused : ctxVal.erase ≠ Atom.notReducible := by rwa [valEq]
  have cNotStopped : ¬IsEmptyOrErrorRel ctxVal.erase := by
    rw [valEq, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    simp [notStopped]
  exact ⟨wStep, .returnEvaluate cNotRefused cNotStopped,
    .internal (.returnEvaluate cNotRefused cNotStopped),
    ⟨rfl, .work (.atom valEq actRel), stackRel, emittedRel⟩, entryReady⟩

/-- Commuting Empty-or-Error Atom Entry Square (`ScopedConfigurationRel.atomEmptyOrError_step`):
When `.atom` enters an empty or error atom (`isEmptyOrError value = true`) under
`ScopedAtomEntryReady policy value ctxVal cFrame`, both machines step in 1 silent
transition (`LocalStep.delivered` via `Entry.Rel.stopped`) to `.returning`,
preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.atomEmptyOrError_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (value expected : Atom) (wB : Bindings) (fuel : Nat)
    (live : List Atom) (scope : List String)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (entryReady : ScopedAtomEntryReady policy value ctxVal cFrame)
    (stopped : isEmptyOrError value = true)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.atom value expected wB (fuel + 1) live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning [(value, wB)], wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal expected cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [(cFrame.read policy ctxVal, cFrame)], cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  have wStep : (Checked.machine dispatch scopedTypes).step
      ⟨space, .work (.atom value expected wB (fuel + 1) live), wStack, wEmitted⟩ =
      some (.silent ⟨space, .returning [(value, wB)], wStack, wEmitted⟩) := by
    simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, stopped, Transition.relabel]
  have cStopped : IsEmptyOrErrorRel (cFrame.read policy ctxVal).erase := by
    rw [entryReady.2.1, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    exact stopped
  have entered :
      Entry.Rel policy.reentry (cFrame.read policy ctxVal).status
        (cFrame.read policy ctxVal).erase expected .deliver :=
    .stopped cStopped
  exact ⟨wStep, .delivered entered, .internal (.delivered entered),
    ⟨rfl, .returning (.cons ⟨entryReady.2.1.symm, actRel⟩ .nil), stackRel, emittedRel⟩⟩

/-- Commuting Type-Pass Atom Entry Square (`ScopedConfigurationRel.atomTypePass_step`):
When `.atom` enters a non-empty/non-error atom under `ScopedAtomEntryReady policy value ctxVal cFrame`
and `expected = Atom.atomType ∨ expected = getMetaType value ∨ getMetaType value = Atom.variableType`,
both machines step in 1 silent transition (`LocalStep.delivered` via `Entry.Rel.pass`)
to `.returning`, preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.atomTypePass_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (value expected : Atom) (wB : Bindings) (fuel : Nat)
    (live : List Atom) (scope : List String)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (entryReady : ScopedAtomEntryReady policy value ctxVal cFrame)
    (notStopped : isEmptyOrError value = false)
    (typePass : expected = Atom.atomType ∨ expected = getMetaType value ∨
      getMetaType value = Atom.variableType)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.atom value expected wB (fuel + 1) live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning [(value, wB)], wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal expected cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [(cFrame.read policy ctxVal, cFrame)], cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  have hPass :
      (expected = Atom.atomType ∨ expected = getMetaType value) ∨
        getMetaType value = Atom.variableType := by
    rcases typePass with h1 | h2 | h3
    · exact Or.inl (Or.inl h1)
    · exact Or.inl (Or.inr h2)
    · exact Or.inr h3
  have wStep : (Checked.machine dispatch scopedTypes).step
      ⟨space, .work (.atom value expected wB (fuel + 1) live), wStack, wEmitted⟩ =
      some (.silent ⟨space, .returning [(value, wB)], wStack, wEmitted⟩) := by
    simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, notStopped, hPass, Transition.relabel]
  have cNotStopped : ¬IsEmptyOrErrorRel (cFrame.read policy ctxVal).erase := by
    rw [entryReady.2.1, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    simp [notStopped]
  have cMeta : MetaTypeRel (cFrame.read policy ctxVal).erase (getMetaType value) := by
    rw [entryReady.2.1, Conformance.metaTypeRel_iff_getMetaType]
  have entered :
      Entry.Rel policy.reentry (cFrame.read policy ctxVal).status
        (cFrame.read policy ctxVal).erase expected .deliver :=
    .pass cNotStopped cMeta typePass
  exact ⟨wStep, .delivered entered, .internal (.delivered entered),
    ⟨rfl, .returning (.cons ⟨entryReady.2.1.symm, actRel⟩ .nil), stackRel, emittedRel⟩⟩

/-- Commuting Function-Start Task Square (`ScopedConfigurationRel.func_functionStart_step`):
Entering `.func` / `.function` at positive depth steps in 1 silent transition on both
machines to `.atom` on the operator with `.heads` / `.functionHeads` pushed on the stack,
preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.func_functionStart_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator : Atom) (arguments : List Atom) (wB : Bindings) (fuel : Nat)
    (live : List Atom) (scope : List String) (expected : Atom)
    (signature : SelectedTypePolicy)
    (ctxOp : Entry.Value) (ctxArgs : List Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (opEq : ctxOp.erase = operator)
    (argsEq : ctxArgs.map Entry.Value.erase = arguments)
    (arityEq : ctxArgs.length = signature.argumentTypes.length)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.func (.expression (operator :: arguments))
          signature.functionType wB (fuel + 1) live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.atom operator signature.functionType wB fuel
          (signature.functionType :: arguments ++ live)),
        .heads signature.functionType arguments fuel live :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.function live scope expected signature ctxOp ctxArgs cFrame),
        cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom (signature.functionType :: ctxArgs.map Entry.Value.erase ++ live)
          (scope ++ expectedApplicationScope (.expression ((ctxOp :: ctxArgs).map Entry.Value.erase)) expected)
          ctxOp signature.functionType cFrame),
        .functionHeads live scope (ctxArgs.zip signature.argumentTypes) :: cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  have hTask :
      ScopedTaskRel
        (.atom operator signature.functionType wB fuel
          (signature.functionType :: arguments ++ live))
        (.atom (signature.functionType :: ctxArgs.map Entry.Value.erase ++ live)
          (scope ++ expectedApplicationScope (.expression ((ctxOp :: ctxArgs).map Entry.Value.erase)) expected)
          ctxOp signature.functionType cFrame) := by
    rw [argsEq]
    exact .atom opEq actRel
  have hZipFst : ((ctxArgs.zip signature.argumentTypes).map Prod.fst).map Entry.Value.erase = arguments := by
    rw [List.map_fst_zip (by omega), argsEq]
  have hFrame :
      ScopedFrameRel
        (.heads signature.functionType arguments fuel live)
        (.functionHeads live scope (ctxArgs.zip signature.argumentTypes)) :=
    .heads hZipFst
  exact ⟨rfl, .functionStart arityEq, .internal (.functionStart arityEq),
    ⟨rfl, .work hTask, .cons hFrame stackRel, emittedRel⟩⟩

open private atomVariables_eq_typeVars atomListVariables_eq_typeVarsList
  from Mettapedia.Languages.MeTTa.HE.EquationFreshening

/-- Protected-Variable Support Bridge (`argumentScope_typeVarsList_mem_iff`):
When `(requests.map Prod.fst).map Entry.Value.erase = remaining` and
`requests.map Prod.snd = types`, the contextual remaining-argument scope
`Completed.argumentScope requests` (which interleaves `[req.1.erase, req.2]`) and the
worker's remaining-values/remaining-types inventory `remaining ++ types` have identical
variable support in `TypeSubst.typeVarsList`, even though their element order differs
for two or more remaining requests. -/
theorem argumentScope_typeVarsList_mem_iff
    {requests : List Completed.ArgumentRequest} {remaining types : List Atom}
    (remEq : (requests.map Prod.fst).map Entry.Value.erase = remaining)
    (typesEq : requests.map Prod.snd = types)
    (name : String) :
    name ∈ TypeSubst.typeVarsList (Completed.argumentScope requests) ↔
      name ∈ TypeSubst.typeVarsList (remaining ++ types) := by
  subst remEq
  subst typesEq
  induction requests with
  | nil =>
      simp [Completed.argumentScope, TypeSubst.typeVarsList]
  | cons req rest ih =>
      rcases req with ⟨reqVal, reqTy⟩
      simp only [Completed.argumentScope, List.flatMap_cons, List.cons_append, List.nil_append,
        List.map_cons, TypeSubst.typeVarsList, TypeSubst.typeVarsList_append, List.mem_append] at ih ⊢
      tauto

/-- Protected-Variable Support Bridge with Live Suffix (`argumentScope_append_live_typeVarsList_mem_iff`):
Appending any `live : List Atom` suffix preserves exact variable-support equality between
`Completed.argumentScope requests ++ live` and `remaining ++ types ++ live`. -/
theorem argumentScope_append_live_typeVarsList_mem_iff
    {requests : List Completed.ArgumentRequest} {remaining types : List Atom}
    (remEq : (requests.map Prod.fst).map Entry.Value.erase = remaining)
    (typesEq : requests.map Prod.snd = types)
    (live : List Atom) (name : String) :
    name ∈ TypeSubst.typeVarsList (Completed.argumentScope requests ++ live) ↔
      name ∈ TypeSubst.typeVarsList (remaining ++ types ++ live) := by
  simp only [TypeSubst.typeVarsList_append, List.mem_append,
    argumentScope_typeVarsList_mem_iff remEq typesEq name]

/-- Protected-Variable Support Bridge for `invocationTypeScope`
(`invocationTypeScope_argumentScope_mem_iff`):
Replacing `Completed.argumentScope requests ++ live` by `remaining ++ types ++ live`
preserves membership in `invocationTypeScope`. -/
theorem invocationTypeScope_argumentScope_mem_iff
    {requests : List Completed.ArgumentRequest} {remaining types : List Atom}
    (remEq : (requests.map Prod.fst).map Entry.Value.erase = remaining)
    (typesEq : requests.map Prod.snd = types)
    (scope : List String) (live : List Atom) (subject expected : Atom) (bindings : Bindings)
    (name : String) :
    name ∈ invocationTypeScope scope (Completed.argumentScope requests ++ live)
        subject expected bindings ↔
      name ∈ invocationTypeScope scope (remaining ++ types ++ live)
        subject expected bindings := by
  simp only [invocationTypeScope, List.mem_append, TypeSubst.typeVarsList,
    List.append_nil, TypeSubst.typeVarsList_append,
    argumentScope_typeVarsList_mem_iff remEq typesEq name]

/-- Fresh-Lookup Support Bridge (`scopedLookup_of_invocationTypes_related_with_live`):
Consumes the protected-variable support equivalence
`liveRel : ∀ name, name ∈ TypeSubst.typeVarsList wLive ↔ name ∈ TypeSubst.typeVarsList cLive`
(such as `argumentScope_append_live_typeVarsList_mem_iff` after `argsCons_step`) to establish
`Completed.scopedLookup` at `invocationTypeScope scope cLive subject expected before.bindings`
from the worker's `invocationTypes state nativeBindings subject expected` when
`state.control = .work (.atom subject expected nativeBindings fuel wLive)`. -/
theorem scopedLookup_of_invocationTypes_related_with_live
    (state : Configuration) (subject expected : Atom)
    (nativeBindings : Bindings) (before : Completed.Frame)
    (fuel : Nat) (wLive cLive : List Atom) (scope : List String)
    (pending : state.control = .work (.atom subject expected nativeBindings fuel wLive))
    (related : SourceBindingComparison.semantic.FrameRelated nativeBindings before.source)
    (liveRel : ∀ name, name ∈ TypeSubst.typeVarsList wLive ↔ name ∈ TypeSubst.typeVarsList cLive)
    (retained : ∀ name ∈ scope, name ∈ RecursiveScope.configurationNames state) :
    Completed.scopedLookup
      (invocationTypeScope scope cLive subject expected before.bindings)
      state.space before.bindings subject expected
      (invocationTypes state nativeBindings subject expected) := by
  refine ⟨getAtomTypes state.space subject, FirstSuccessSourceReplies.source_types state.space subject, ?_⟩
  apply EquationFreshening.getAtomTypesScoped_variants
    (RecursiveScope.configurationNames state) state.space nativeBindings subject expected
  intro name member
  simp only [invocationTypeScope, List.nil_append, TypeSubst.typeVarsList,
    List.append_nil, List.mem_append] at member ⊢
  have beforeEq : before.source.bindings = before.bindings := rfl
  rcases member with (((kept | used) | bound) | subjectOrExpected) | boundAgain
  · exact Or.inl (Or.inl (Or.inl (retained name kept)))
  · left; left; left
    rw [← atomListVariables_eq_typeVarsList] at used
    simp only [atomListVariables_append, atomListVariables, List.append_nil,
      List.mem_append] at used
    have usedW :
        name ∈ atomListVariables cLive ∨ name ∈ atomVariables subject ∨ name ∈ atomVariables expected →
        name ∈ atomListVariables wLive ∨ name ∈ atomVariables subject ∨ name ∈ atomVariables expected := by
      rintro (hLive | hSub | hExp)
      · left
        rw [atomListVariables_eq_typeVarsList] at hLive ⊢
        exact (liveRel name).mpr hLive
      · exact Or.inr (Or.inl hSub)
      · exact Or.inr (Or.inr hExp)
    have usedW' := usedW used
    simp only [RecursiveScope.configurationNames, RecursiveScope.liveAtoms, pending,
      RecursiveScope.controlAtoms, RecursiveScope.taskAtoms, atomListVariables_append,
      atomListVariables, List.append_nil, List.mem_append]
    tauto
  · exact Or.inl (Or.inl (Or.inr ((related.related.support name).mpr (beforeEq ▸ bound))))
  · rcases subjectOrExpected with subMem | expMem
    · exact Or.inl (Or.inr subMem)
    · exact Or.inr expMem
  · exact Or.inl (Or.inl (Or.inr ((related.related.support name).mpr (beforeEq ▸ boundAgain))))

/-- Expression-Entry Fresh-Lookup Support Bridge
(`scopedLookup_of_expression_invocationTypes_related_with_live`):
Consumes `liveRel : ∀ name, name ∈ TypeSubst.typeVarsList wLive ↔ name ∈ TypeSubst.typeVarsList cLive`
to establish `Completed.scopedLookup` for expression operator lookup when the worker `.atom` task
carries `wLive` and the contextual `.atom` task carries `cLive`. -/
theorem scopedLookup_of_expression_invocationTypes_related_with_live
    (space : Space) (operator : Atom) (arguments : List Atom) (expected : Atom)
    (wB : Bindings) (cFrame : Completed.Frame)
    (fuel : Nat) (wLive cLive : List Atom) (scope : List String)
    (wStack : List RecursiveTasks.Frame) (wEmitted : ResultSet)
    (actRel : ScopedActivationRel wB cFrame)
    (liveRel : ∀ name, name ∈ TypeSubst.typeVarsList wLive ↔ name ∈ TypeSubst.typeVarsList cLive)
    (retained : ∀ name ∈ scope,
      name ∈ RecursiveScope.configurationNames
        ⟨space, .work (.atom (.expression (operator :: arguments)) expected wB fuel wLive),
          wStack, wEmitted⟩) :
    let expr := Atom.expression (operator :: arguments)
    let wBefore : Configuration :=
      ⟨space, .work (.atom expr expected wB fuel wLive), wStack, wEmitted⟩
    Completed.scopedLookup
      (invocationTypeScope scope cLive expr expected cFrame.bindings)
      space cFrame.bindings operator Atom.undefinedType
      (invocationTypes wBefore wB operator expected) := by
  intro expr wBefore
  refine ⟨getAtomTypes space operator, FirstSuccessSourceReplies.source_types space operator, ?_⟩
  apply EquationFreshening.getAtomTypesScoped_variants
    (RecursiveScope.configurationNames wBefore) space wB operator expected
  intro name member
  simp only [invocationTypeScope, List.nil_append, TypeSubst.typeVarsList,
    List.append_nil, List.mem_append] at member ⊢
  have beforeEq : cFrame.source.bindings = cFrame.bindings := rfl
  rcases member with (((kept | used) | bound) | exprOrExpected) | boundAgain
  · exact Or.inl (Or.inl (Or.inl (retained name kept)))
  · left; left; left
    rw [← atomListVariables_eq_typeVarsList] at used
    simp only [atomListVariables_append, atomListVariables, List.append_nil,
      List.mem_append] at used
    have usedW :
        name ∈ atomListVariables cLive ∨ name ∈ atomVariables expr ∨ name ∈ atomVariables expected →
        name ∈ atomListVariables wLive ∨ name ∈ atomVariables expr ∨ name ∈ atomVariables expected := by
      rintro (hLive | hSub | hExp)
      · left
        rw [atomListVariables_eq_typeVarsList] at hLive ⊢
        exact (liveRel name).mpr hLive
      · exact Or.inr (Or.inl hSub)
      · exact Or.inr (Or.inr hExp)
    have usedW' := usedW used
    simp only [wBefore, expr, RecursiveScope.configurationNames, RecursiveScope.liveAtoms,
      RecursiveScope.controlAtoms, RecursiveScope.taskAtoms, atomListVariables_append,
      atomListVariables, List.append_nil, List.mem_append] at usedW' ⊢
    tauto
  · exact Or.inl (Or.inl (Or.inr ((actRel.related.support name).mpr (beforeEq ▸ bound))))
  · rcases exprOrExpected with exprMem | expMem
    · exact Or.inl (Or.inr exprMem)
    · simp [TypeSubst.typeVars, Atom.undefinedType] at expMem
  · exact Or.inl (Or.inl (Or.inr ((actRel.related.support name).mpr (beforeEq ▸ boundAgain))))

/-- Commuting Arbitrary-Arity Argument Entry Task Square (`ScopedConfigurationRel.argsCons_step`):
Entering `.args (value :: remaining) (ty :: types)` / `.arguments ((ctxVal, ty) :: requests)`
at positive depth steps in 1 silent transition on both machines to `.atom` on `value` / `ctxVal`
with `wLive = remaining ++ types ++ live` and `cLive = Completed.argumentScope requests ++ live`,
pushing `.argumentHeads` / `.arguments` on the stack and preserving `ScopedConfigurationRel`
via the protected-variable support bridge `argumentScope_append_live_typeVarsList_mem_iff`. -/
theorem ScopedConfigurationRel.argsCons_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (value ty : Atom) (remaining types : List Atom)
    (wB : Bindings) (fuel : Nat) (live : List Atom) (scope : List String)
    (ctxVal : Entry.Value) (requests : List Completed.ArgumentRequest)
    (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (valEq : ctxVal.erase = value)
    (remEq : (requests.map Prod.fst).map Entry.Value.erase = remaining)
    (typesEq : requests.map Prod.snd = types)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.args (value :: remaining) (ty :: types) wB (fuel + 1) live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.atom value ty wB fuel (remaining ++ types ++ live)),
        .argumentHeads value remaining types fuel live :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.arguments live scope ((ctxVal, ty) :: requests) cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom (Completed.argumentScope requests ++ live) scope ctxVal ty cFrame),
        .arguments live scope ctxVal requests :: cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter :=
  ⟨rfl, .argumentsCons, .internal .argumentsCons,
   ⟨rfl,
    .work (.atom valEq actRel fun name =>
      (argumentScope_append_live_typeVarsList_mem_iff remEq typesEq live name).symm),
    .cons (.argumentHeads valEq remEq typesEq) stackRel,
    emittedRel⟩⟩

/-- Commuting Unary-Arguments Task Square (`ScopedConfigurationRel.argsSingleton_step`):
Entering `.args [value] [ty]` / `.arguments [(ctxVal, ty)]` at positive depth steps in
1 silent transition on both machines to `.atom` on `value` / `ctxVal` with
`.argumentHeads` / `.arguments` pushed on the stack, preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.argsSingleton_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (value ty : Atom) (wB : Bindings) (fuel : Nat) (live : List Atom) (scope : List String)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (valEq : ctxVal.erase = value)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.args [value] [ty] wB (fuel + 1) live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.atom value ty wB fuel live),
        .argumentHeads value [] [] fuel live :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.arguments live scope [(ctxVal, ty)] cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal ty cFrame),
        .arguments live scope ctxVal [] :: cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter :=
  ScopedConfigurationRel.argsCons_step space dispatch hostDispatch policy
    value ty [] [] wB fuel live scope ctxVal [] cFrame wStack cStack wEmitted cEmitted
    valEq rfl rfl actRel stackRel emittedRel

/-- Commuting Type-Pass Atom Entry Square with Support-Related Live Lists
(`ScopedConfigurationRel.atomTypePass_step_with_live`):
Generalizes `ScopedConfigurationRel.atomTypePass_step` to arbitrary `wLive` and `cLive`
(such as `remaining ++ types ++ live` vs `Completed.argumentScope requests ++ live`
after `argsCons_step`), since `.deliver` returns directly to `.returning` and discards the
task-local live list. -/
theorem ScopedConfigurationRel.atomTypePass_step_with_live
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (value expected : Atom) (wB : Bindings) (fuel : Nat)
    (wLive cLive : List Atom) (scope : List String)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (entryReady : ScopedAtomEntryReady policy value ctxVal cFrame)
    (notStopped : isEmptyOrError value = false)
    (typePass : expected = Atom.atomType ∨ expected = getMetaType value ∨
      getMetaType value = Atom.variableType)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.atom value expected wB (fuel + 1) wLive), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning [(value, wB)], wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom cLive scope ctxVal expected cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [(cFrame.read policy ctxVal, cFrame)], cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  have hPass :
      (expected = Atom.atomType ∨ expected = getMetaType value) ∨
        getMetaType value = Atom.variableType := by
    rcases typePass with h1 | h2 | h3
    · exact Or.inl (Or.inl h1)
    · exact Or.inl (Or.inr h2)
    · exact Or.inr h3
  have wStep : (Checked.machine dispatch scopedTypes).step
      ⟨space, .work (.atom value expected wB (fuel + 1) wLive), wStack, wEmitted⟩ =
      some (.silent ⟨space, .returning [(value, wB)], wStack, wEmitted⟩) := by
    simp [Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, notStopped, hPass, Transition.relabel]
  have cNotStopped : ¬IsEmptyOrErrorRel (cFrame.read policy ctxVal).erase := by
    rw [entryReady.2.1, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    simp [notStopped]
  have cMeta : MetaTypeRel (cFrame.read policy ctxVal).erase (getMetaType value) := by
    rw [entryReady.2.1, Conformance.metaTypeRel_iff_getMetaType]
  have entered :
      Entry.Rel policy.reentry (cFrame.read policy ctxVal).status
        (cFrame.read policy ctxVal).erase expected .deliver :=
    .pass cNotStopped cMeta typePass
  exact ⟨wStep, .delivered entered, .internal (.delivered entered),
    ⟨rfl, .returning (.cons ⟨entryReady.2.1.symm, actRel⟩ .nil), stackRel, emittedRel⟩⟩

/-- Commuting `.functionTail` / `.functionAssemble` Continuation Square
(`ScopedConfigurationRel.functionTail_step`):
Resuming `.returning` against `.functionTail head` / `.functionAssemble ctxHead` steps in
1 silent transition on both machines to `.returning` with the assembled function results,
preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.functionTail_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (head : Atom) (ctxHead : Entry.Value)
    (wResults : ResultSet) (cResults : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (headEq : ctxHead.erase = head)
    (resultsRel : List.Forall₂ ScopedResultRel wResults cResults)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .returning wResults, .functionTail head :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning (RecursiveTasks.functionTail head wResults), wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning cResults, .functionAssemble ctxHead :: cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning (cResults.map (Completed.functionAssemble ctxHead)), cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter :=
  ⟨rfl, .functionAssemble, .internal .functionAssemble,
   ⟨rfl, .returning (ScopedResultRel.forall2_functionTail headEq resultsRel), stackRel, emittedRel⟩⟩

/-- Commuting `.argumentTail` Continuation Square (`ScopedConfigurationRel.argumentTail_step`):
Resuming `.returning` against `.argumentTail head` / `.argumentTail ctxHead` steps in
1 silent transition on both machines to `.returning` with the prepended argument results,
preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.argumentTail_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (head : Atom) (ctxHead : Entry.Value)
    (wResults : ResultSet) (cResults : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (headEq : ctxHead.erase = head)
    (resultsRel : List.Forall₂ ScopedResultRel wResults cResults)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .returning wResults, .argumentTail head :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning (RecursiveTasks.argumentTail head wResults), wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning cResults, .argumentTail ctxHead :: cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning (cResults.map (Completed.argumentPrepend ctxHead)), cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter :=
  ⟨rfl, .argumentTail, .internal .argumentTail,
   ⟨rfl, .returning (ScopedResultRel.forall2_argumentTail headEq resultsRel), stackRel, emittedRel⟩⟩

/-- Commuting Function-Heads-Continue Task Square (`ScopedConfigurationRel.headsContinue_step`):
When the head operator result `(wHeadVal, wB)` / `(cHeadVal, cFrame)` in `.heads` /
`.functionBranches` is not empty/error (`isEmptyOrError wHeadVal = false`) and
`getFunctionArgTypes operatorType = some types`, both machines step in 1 silent transition
to `.args` / `.arguments` with `.functionTail` / `.functionAssemble` and `.append` pushed on
the stack, preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.headsContinue_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operatorType : Atom) (arguments types : List Atom) (fuel : Nat)
    (live : List Atom) (scope : List String)
    (requests : List Completed.ArgumentRequest)
    (wHeadVal : Atom) (wB : Bindings) (wRest : ResultSet)
    (cHeadVal : Entry.Value) (cFrame : Completed.Frame) (cRest : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (valsEq : (requests.map Prod.fst).map Entry.Value.erase = arguments)
    (typesEq : requests.map Prod.snd = types)
    (argTypes : getFunctionArgTypes operatorType = some types)
    (notStopped : isEmptyOrError wHeadVal = false)
    (headRel : ScopedResultRel (wHeadVal, wB) (cHeadVal, cFrame))
    (restRel : List.Forall₂ ScopedResultRel wRest cRest)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.heads operatorType arguments fuel ((wHeadVal, wB) :: wRest) live),
        wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.args arguments types wB fuel (wHeadVal :: live)),
        .functionTail wHeadVal ::
          .append (.heads operatorType arguments fuel wRest live) :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.functionBranches live scope requests ((cHeadVal, cFrame) :: cRest)),
        cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.arguments (cHeadVal.erase :: live) scope requests cFrame),
        .functionAssemble cHeadVal ::
          .append (.functionBranches live scope requests cRest) :: cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  rcases headRel with ⟨valEq, actRel⟩
  dsimp only at valEq actRel
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, notStopped, argTypes, Transition.relabel]
  have cNotStopped : ¬IsEmptyOrErrorRel (cHeadVal, cFrame).1.erase := by
    dsimp only
    rw [← valEq, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    simp [notStopped]
  have hTask :
      ScopedTaskRel
        (.args arguments types wB fuel (wHeadVal :: live))
        (.arguments (cHeadVal.erase :: live) scope requests cFrame) := by
    rw [← valEq]
    exact .args valsEq typesEq actRel
  exact ⟨wStep, .functionBranchesContinue cNotStopped,
    .internal (.functionBranchesContinue cNotStopped),
    ⟨rfl, .work hTask,
      .cons (.functionTail valEq.symm) (.cons (.append (.heads valsEq restRel)) stackRel),
      emittedRel⟩⟩

/-- A stopped operator does not demand its arguments. The worker uses two
administrative transitions (return and append); the contextual machine uses
one stopped-branch transition. Both retain the occurrence and the remaining
heads, caller frames and prior publications. -/
theorem ScopedConfigurationRel.headsStopped_block
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operatorType : Atom) (arguments : List Atom) (fuel : Nat)
    (live : List Atom) (scope : List String)
    (requests : List Completed.ArgumentRequest)
    (wHeadVal : Atom) (wB : Bindings) (wRest : ResultSet)
    (cHeadVal : Entry.Value) (cFrame : Completed.Frame) (cRest : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (valsEq : (requests.map Prod.fst).map Entry.Value.erase = arguments)
    (stopped : isEmptyOrError wHeadVal = true)
    (headRel : ScopedResultRel (wHeadVal,wB) (cHeadVal,cFrame))
    (restRel : List.Forall₂ ScopedResultRel wRest cRest)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space,.work (.heads operatorType arguments fuel ((wHeadVal,wB) :: wRest) live),
        wStack,wEmitted⟩
    let wAfter : Configuration :=
      ⟨space,.work (.heads operatorType arguments fuel wRest live),
        .prepend [(wHeadVal,wB)] :: wStack,wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space,.work (.functionBranches live scope requests ((cHeadVal,cFrame) :: cRest)),
        cStack,cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space,.work (.functionBranches live scope requests cRest),
        .prepend [(cHeadVal,cFrame)] :: cStack,cEmitted⟩
    (Checked.machine dispatch scopedTypes).run 2 wBefore = ([],.exhausted wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control,cBefore.stack) (cAfter.control,cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  have cStopped : IsEmptyOrErrorRel cHeadVal.erase := by
    rw [← headRel.1,Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    exact stopped
  have executed : (Checked.machine dispatch scopedTypes).run 2 wBefore =
      ([],.exhausted wAfter) := by
    simp [Machine.run,wBefore,wAfter,Checked.machine,
      RecursiveMachine.Checked.guardMachine,Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady,RecursiveMachine.Checked.taskReady,
      RecursiveMachine.Checked.frameReady,
      FirstSuccessRecursiveExecution.machine,FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter,RecursiveMachine.enter,
      RecursiveMachine.resume,stopped,Transition.relabel]
  exact ⟨executed,.functionBranchesStopped cStopped,
    .internal (.functionBranchesStopped cStopped),
    ⟨rfl,.work (.heads valsEq restRel),
      .cons (.prepend (.cons headRel .nil)) stackRel,emittedRel⟩⟩

/-- `Empty` skips argument demand and retains the pending sibling. The bare
symbol `Error` is an ordinary operator; only an error expression is stopped. -/
theorem stopped_head_and_symbol_error_discriminator :
    let space : Space := ⟨[]⟩
    let signature := Atom.expression [.symbol "->",.symbol "Int",.symbol "Int"]
    let argument := Atom.expression [.symbol "do-not-demand"]
    let requests : List Completed.ArgumentRequest := [(Entry.Value.ofAtom argument,.symbol "Int")]
    let sibling : ResultPair := (.symbol "later",Bindings.empty)
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 2
        ⟨space,.work (.heads signature [argument] 4
          [(Atom.empty,Bindings.empty),sibling] []),[],[]⟩ =
      ([],.exhausted ⟨space,.work (.heads signature [argument] 4 [sibling] []),
        [.prepend [(Atom.empty,Bindings.empty)]],[]⟩) ∧
    RecursiveMachine.Contextual.LocalStep space
      noHost Completed.scopedLookup Policy.finiteTypes
      (.work (.functionBranches [] [] requests [(Entry.Value.ofAtom Atom.empty,Completed.Frame.empty)]),[])
      (.work (.functionBranches [] [] requests []),
        [.prepend [(Entry.Value.ofAtom Atom.empty,Completed.Frame.empty)]]) ∧
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 1
        ⟨space,.work (.heads signature [argument] 4 [(.symbol "Error",Bindings.empty)] []),[],[]⟩ =
      ([],.exhausted ⟨space,.work (.args [argument] [.symbol "Int"] Bindings.empty 4 [.symbol "Error"]),
        [.functionTail (.symbol "Error"),.append (.heads signature [argument] 4 [] [])],[]⟩) ∧
    RecursiveMachine.Contextual.LocalStep space
      noHost Completed.scopedLookup Policy.finiteTypes
      (.work (.functionBranches [] [] requests [(.symbol "Error",Completed.Frame.empty)]),[])
      (.work (.arguments [.symbol "Error"] [] requests Completed.Frame.empty),
        [.functionAssemble (.symbol "Error"),.append (.functionBranches [] [] requests [])]) := by
  intro space signature argument requests sibling
  refine ⟨rfl,.functionBranchesStopped ?_,rfl,?_⟩
  · rw [Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    simp [Entry.Value.erase_ofAtom,Atom.empty,isEmptyOrError,isEmptyAtom,isErrorAtom]
  · have unstopped : ¬IsEmptyOrErrorRel (Entry.Value.symbol "Error").erase := by
      rw [Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
      simp [Entry.Value.erase,Atom.empty,isEmptyOrError,isEmptyAtom,isErrorAtom]
    simpa only [Entry.Value.erase] using
      (RecursiveMachine.Contextual.LocalStep.functionBranchesContinue
        (space := space) (dispatch := noHost) (lookup := Completed.scopedLookup)
        (policy := Policy.finiteTypes) (live := []) (scope := []) (requests := requests)
        (head := (.symbol "Error",Completed.Frame.empty)) (heads := []) (stack := []) unstopped)

/-- Commuting Argument-Heads-Continue Task Square (`ScopedConfigurationRel.argumentHeadsContinue_step`):
When the head argument result `(wHeadVal, wB)` / `(cHeadVal, cFrame)` in `.argumentHeads` /
`.argumentBranches` is not a stopped changed error (`(wHeadVal != original && isEmptyOrError wHeadVal) = false`),
both machines step in 1 silent transition to `.args` / `.arguments` with `.argumentTail` and
`.append` pushed on the stack, preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.argumentHeadsContinue_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original : Atom) (remaining types : List Atom) (fuel : Nat)
    (live : List Atom) (scope : List String)
    (ctxOrig : Entry.Value) (requests : List Completed.ArgumentRequest)
    (wHeadVal : Atom) (wB : Bindings) (wRest : ResultSet)
    (cHeadVal : Entry.Value) (cFrame : Completed.Frame) (cRest : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (origEq : ctxOrig.erase = original)
    (valsEq : (requests.map Prod.fst).map Entry.Value.erase = remaining)
    (typesEq : requests.map Prod.snd = types)
    (notStopped : (wHeadVal != original && isEmptyOrError wHeadVal) = false)
    (headRel : ScopedResultRel (wHeadVal, wB) (cHeadVal, cFrame))
    (restRel : List.Forall₂ ScopedResultRel wRest cRest)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.argumentHeads original remaining types fuel ((wHeadVal, wB) :: wRest) live),
        wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.args remaining types wB fuel (wHeadVal :: live)),
        .argumentTail wHeadVal ::
          .append (.argumentHeads original remaining types fuel wRest live) :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.argumentBranches live scope ctxOrig requests ((cHeadVal, cFrame) :: cRest)),
        cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.arguments (cHeadVal.erase :: live) scope requests cFrame),
        .argumentTail cHeadVal ::
          .append (.argumentBranches live scope ctxOrig requests cRest) :: cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  rcases headRel with ⟨valEq, actRel⟩
  dsimp only at valEq actRel
  have hNotCond : ¬(¬wHeadVal = original ∧ isEmptyOrError wHeadVal = true) := by
    rintro ⟨hNe, hErr⟩
    have hBne : (wHeadVal != original) = true := bne_iff_ne.mpr hNe
    simp [hBne, hErr] at notStopped
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, hNotCond, Transition.relabel]
  have cNotStopped : ¬Completed.ArgumentStopped ctxOrig (cHeadVal, cFrame) := by
    rintro ⟨hErr, hNe⟩
    dsimp only at hErr hNe
    rw [← valEq, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError] at hErr
    rw [← valEq, origEq] at hNe
    exact hNotCond ⟨hNe, hErr⟩
  have hTask :
      ScopedTaskRel
        (.args remaining types wB fuel (wHeadVal :: live))
        (.arguments (cHeadVal.erase :: live) scope requests cFrame) := by
    rw [← valEq]
    exact .args valsEq typesEq actRel
  exact ⟨wStep, .argumentBranchesContinue cNotStopped,
    .internal (.argumentBranchesContinue cNotStopped),
    ⟨rfl, .work hTask,
      .cons (.argumentTail valEq.symm)
        (.cons (.append (.argumentHeads origEq valsEq typesEq restRel)) stackRel),
      emittedRel⟩⟩

/-- Stopped Changed-Error Argument Branch (`ScopedConfigurationRel.argumentHeadsStopped_block`):
When an argument result `(wHeadVal, wB)` / `(cHeadVal, cFrame)` in `.argumentHeads` /
`.argumentBranches` is a changed empty/error value (`(wHeadVal != original && isEmptyOrError wHeadVal) = true`),
it does not demand the remaining arguments: the worker uses two administrative transitions
(return and append) and the contextual machine uses one stopped-branch transition
(`LocalStep.argumentBranchesStopped`). Both retain the stopped occurrence, the remaining
argument branches, caller frames, and prior publications while preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.argumentHeadsStopped_block
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original : Atom) (remaining types : List Atom) (fuel : Nat)
    (live : List Atom) (scope : List String)
    (ctxOrig : Entry.Value) (requests : List Completed.ArgumentRequest)
    (wHeadVal : Atom) (wB : Bindings) (wRest : ResultSet)
    (cHeadVal : Entry.Value) (cFrame : Completed.Frame) (cRest : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (origEq : ctxOrig.erase = original)
    (valsEq : (requests.map Prod.fst).map Entry.Value.erase = remaining)
    (typesEq : requests.map Prod.snd = types)
    (stopped : (wHeadVal != original && isEmptyOrError wHeadVal) = true)
    (headRel : ScopedResultRel (wHeadVal, wB) (cHeadVal, cFrame))
    (restRel : List.Forall₂ ScopedResultRel wRest cRest)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.argumentHeads original remaining types fuel ((wHeadVal, wB) :: wRest) live),
        wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.argumentHeads original remaining types fuel wRest live),
        .prepend [(wHeadVal, wB)] :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.argumentBranches live scope ctxOrig requests ((cHeadVal, cFrame) :: cRest)),
        cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.argumentBranches live scope ctxOrig requests cRest),
        .prepend [(cHeadVal, cFrame)] :: cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).run 2 wBefore = ([], .exhausted wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  have hAnd := Bool.and_eq_true_iff.mp stopped
  have hNe : wHeadVal ≠ original := bne_iff_ne.mp hAnd.1
  have hErr : isEmptyOrError wHeadVal = true := hAnd.2
  have cStopped : Completed.ArgumentStopped ctxOrig (cHeadVal, cFrame) := by
    refine ⟨?_, ?_⟩
    · dsimp only
      rw [← headRel.1, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
      exact hErr
    · dsimp only
      rw [← headRel.1, origEq]
      exact hNe
  have executed : (Checked.machine dispatch scopedTypes).run 2 wBefore =
      ([], .exhausted wAfter) := by
    simp [Machine.run, wBefore, wAfter, Checked.machine,
      RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      RecursiveMachine.Checked.frameReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter, RecursiveMachine.enter,
      RecursiveMachine.resume, hNe, hErr, Transition.relabel]
  exact ⟨executed, .argumentBranchesStopped cStopped,
    .internal (.argumentBranchesStopped cStopped),
    ⟨rfl, .work (.argumentHeads origEq valsEq typesEq restRel),
      .cons (.prepend (.cons headRel .nil)) stackRel, emittedRel⟩⟩

/-- Changed-error argument results stop without demanding remaining arguments (2 worker steps /
1 contextual step), whereas an unchanged literal error argument (`wHeadVal = original`) is not
stopped and continues to demand the remaining arguments. -/
theorem stopped_argument_and_unchanged_error_discriminator :
    let space : Space := ⟨[]⟩
    let origAtom := Atom.symbol "badArg"
    let ctxOrig := Entry.Value.symbol "badArg"
    let errAtom := Atom.expression [.symbol "Error", .symbol "badArg", .symbol "TypeError"]
    let ctxErr := Entry.Value.ofAtom errAtom
    let nextArg := Atom.symbol "nextArg"
    let requests : List Completed.ArgumentRequest := [(.symbol "nextArg", .symbol "Int")]
    let sibling : ResultPair := (.symbol "altArg", Bindings.empty)
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 2
        ⟨space, .work (.argumentHeads origAtom [nextArg] [.symbol "Int"] 4
          [(errAtom, Bindings.empty), sibling] []), [], []⟩ =
      ([], .exhausted ⟨space, .work (.argumentHeads origAtom [nextArg] [.symbol "Int"] 4
        [sibling] []), [.prepend [(errAtom, Bindings.empty)]], []⟩) ∧
    RecursiveMachine.Contextual.LocalStep space
      noHost Completed.scopedLookup Policy.finiteTypes
      (.work (.argumentBranches [] [] ctxOrig requests [(ctxErr, Completed.Frame.empty)]), [])
      (.work (.argumentBranches [] [] ctxOrig requests []),
        [.prepend [(ctxErr, Completed.Frame.empty)]]) ∧
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 1
        ⟨space, .work (.argumentHeads errAtom [nextArg] [.symbol "Int"] 4
          [(errAtom, Bindings.empty)] []), [], []⟩ =
      ([], .exhausted ⟨space, .work (.args [nextArg] [.symbol "Int"] Bindings.empty 4 [errAtom]),
        [.argumentTail errAtom,
          .append (.argumentHeads errAtom [nextArg] [.symbol "Int"] 4 [] [])], []⟩) ∧
    RecursiveMachine.Contextual.LocalStep space
      noHost Completed.scopedLookup Policy.finiteTypes
      (.work (.argumentBranches [] [] ctxErr requests [(ctxErr, Completed.Frame.empty)]), [])
      (.work (.arguments [errAtom] [] requests Completed.Frame.empty),
        [.argumentTail ctxErr, .append (.argumentBranches [] [] ctxErr requests [])]) := by
  intro space origAtom ctxOrig errAtom ctxErr nextArg requests sibling
  refine ⟨rfl, .argumentBranchesStopped ?_, rfl, ?_⟩
  · refine ⟨?_, ?_⟩
    · rw [Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
      simp [ctxErr, errAtom, Entry.Value.erase_ofAtom, isEmptyOrError, isEmptyAtom, isErrorAtom]
    · simp [ctxErr, ctxOrig, errAtom, Entry.Value.erase_ofAtom, Entry.Value.erase]
  · have unstopped : ¬Completed.ArgumentStopped ctxErr (ctxErr, Completed.Frame.empty) := by
      rintro ⟨_, hNe⟩
      exact hNe rfl
    have hEraseErr : ctxErr.erase = errAtom := Entry.Value.erase_ofAtom errAtom
    simpa only [hEraseErr] using
      (RecursiveMachine.Contextual.LocalStep.argumentBranchesContinue
        (space := space) (dispatch := noHost) (lookup := Completed.scopedLookup)
        (policy := Policy.finiteTypes) (live := []) (scope := [])
        (original := ctxErr) (requests := requests)
        (head := (ctxErr, Completed.Frame.empty)) (heads := []) (stack := []) unstopped)

/-- Commuting Function-Body Start Task Square (`ScopedConfigurationRel.bodyStart_step`):
Entering `.functionBody` / `.body` at positive depth steps in 1 silent transition on both
machines to `.minimal` with `.bodyResults` / `.boundaryBatch .body` pushed on the stack,
preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.bodyStart_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (value : Atom) (wB : Bindings) (fuel : Nat)
    (live : List Atom) (caller : Option Atom) (scope : List String)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (valEq : ctxVal.erase = value)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.functionBody value wB (fuel + 1) live caller), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.minimal value wB fuel live caller),
        .bodyResults fuel live caller :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.body live scope caller ctxVal cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.minimal live scope caller ctxVal cFrame),
        .boundaryBatch live scope caller .body :: cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter :=
  ⟨rfl, .bodyStart, .internal .bodyStart,
   ⟨rfl, .work (.minimal valEq actRel), .cons .bodyResults stackRel, emittedRel⟩⟩

/-- If `val.erase = .expression (operator :: arguments)`, then `val` is an
`.expression readiness (ctxOp :: ctxArgs)` whose head and tail erase to `operator` and `arguments`. -/
theorem erase_eq_expression_cons {val : Entry.Value} {operator : Atom} {arguments : List Atom}
    (h : val.erase = .expression (operator :: arguments)) :
    ∃ (readiness : Entry.Status) (ctxOp : Entry.Value) (ctxArgs : List Entry.Value),
      val = .expression readiness (ctxOp :: ctxArgs) ∧
      ctxOp.erase = operator ∧
      ctxArgs.map Entry.Value.erase = arguments := by
  cases val with
  | symbol _ => simp [Entry.Value.erase] at h
  | var _ => simp [Entry.Value.erase] at h
  | grounded _ => simp [Entry.Value.erase] at h
  | expression readiness children =>
      simp only [Entry.Value.erase, Atom.expression.injEq] at h
      cases children with
      | nil => simp at h
      | cons ctxOp ctxArgs =>
          simp only [List.map_cons, List.cons.injEq] at h
          exact ⟨readiness, ctxOp, ctxArgs, rfl, h.1, h.2⟩

/-- Under `ScopedAtomEntryReady policy (.expression (operator :: arguments)) ctxVal cFrame`,
when the expression is not empty/error and `expected` is neither `Atom.atomType` nor
`Atom.expressionType`, reading `ctxVal` in `cFrame` classifies as `.interpret` (`Entry.Rel.expression`). -/
theorem ScopedAtomEntryReady.entry_interpret
    {policy : Policy} {operator : Atom} {arguments : List Atom} {expected : Atom}
    {ctxVal : Entry.Value} {cFrame : Completed.Frame}
    (ready : ScopedAtomEntryReady policy (.expression (operator :: arguments)) ctxVal cFrame)
    (notStopped : isEmptyOrError (.expression (operator :: arguments)) = false)
    (notAtom : expected ≠ Atom.atomType)
    (notExpr : expected ≠ Atom.expressionType) :
    Entry.Rel policy.reentry (cFrame.read policy ctxVal).status
      (cFrame.read policy ctxVal).erase expected .interpret := by
  have cNotStopped : ¬IsEmptyOrErrorRel (.expression (operator :: arguments)) := by
    rw [Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    simp [notStopped]
  have cNotPass : ¬(expected = Atom.atomType ∨ expected = Atom.expressionType ∨
      Atom.expressionType = Atom.variableType) := by
    rintro (hA | hE | hV)
    · exact notAtom hA
    · exact notExpr hE
    · exact absurd hV (by decide)
  rw [ready.2.1]
  exact Entry.Rel.expression cNotStopped cNotPass ready.2.2

/-- Negative Reentry Discriminator (`ScopedAtomEntryReady.held_reuse_not_ready_and_delivers`):
When `policy.reentry = .reuse` and `(cFrame.read policy ctxVal).status = .held` on a non-empty/non-error
expression `.expression (operator :: arguments)` with `expected ≠ Atom.atomType` and
`expected ≠ Atom.expressionType`:
1. `ScopedAtomEntryReady policy (.expression (operator :: arguments)) ctxVal cFrame` is refuted,
2. The contextual machine classifies entry as `.deliver` (`Entry.Rel.held`) and steps in 1 silent
   transition (`LocalStep.delivered`) directly to `.returning [(cFrame.read policy ctxVal, cFrame)]`
   without interpreting the expression, whereas
3. The checked worker (which carries plain `Atom` syntax and always reinterprets expressions)
   steps in 1 silent transition to `.work (.expression ...)` with `.filter` pushed on the stack. -/
theorem ScopedAtomEntryReady.held_reuse_not_ready_and_delivers
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator : Atom) (arguments : List Atom) (expected : Atom)
    (wB : Bindings) (fuel : Nat) (live : List Atom) (scope : List String)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (readEq : (cFrame.read policy ctxVal).erase = .expression (operator :: arguments))
    (reuses : policy.reentry = .reuse)
    (heldStatus : (cFrame.read policy ctxVal).status = .held)
    (notStopped : isEmptyOrError (.expression (operator :: arguments)) = false)
    (notAtom : expected ≠ Atom.atomType)
    (notExpr : expected ≠ Atom.expressionType) :
    let expr := Atom.expression (operator :: arguments)
    let wBefore : Configuration :=
      ⟨space, .work (.atom expr expected wB (fuel + 1) live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.expression expr expected wB fuel live), .filter :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal expected cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [(cFrame.read policy ctxVal, cFrame)], cStack, cEmitted⟩
    ¬ScopedAtomEntryReady policy expr ctxVal cFrame ∧
    Entry.Rel policy.reentry (cFrame.read policy ctxVal).status
      (cFrame.read policy ctxVal).erase expected .deliver ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
  intro expr wBefore wAfter cBefore cAfter
  have notReady : ¬ScopedAtomEntryReady policy expr ctxVal cFrame := by
    rintro ⟨_, _, hRe | hAct⟩
    · rw [reuses] at hRe; cases hRe
    · rw [heldStatus] at hAct; cases hAct
  have cNotStopped : ¬IsEmptyOrErrorRel (.expression (operator :: arguments)) := by
    rw [Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    simp [notStopped]
  have cNotPass : ¬(expected = Atom.atomType ∨ expected = Atom.expressionType ∨
      Atom.expressionType = Atom.variableType) := by
    rintro (hA | hE | hV)
    · exact notAtom hA
    · exact notExpr hE
    · exact absurd hV (by decide)
  have entered :
      Entry.Rel policy.reentry (cFrame.read policy ctxVal).status
        (cFrame.read policy ctxVal).erase expected .deliver := by
    rw [readEq]
    exact Entry.Rel.held cNotStopped cNotPass reuses heldStatus
  have notVarT : Atom.expressionType ≠ Atom.variableType := by decide
  have notSymT : Atom.expressionType ≠ Atom.symbolType := by decide
  have notGrdT : Atom.expressionType ≠ Atom.groundedType := by decide
  have notUnit : Atom.expression (operator :: arguments) ≠ Atom.unit := by simp [Atom.unit]
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, expr, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, FirstSuccessRecursiveStrategy.taskReady,
      RecursiveMachine.Checked.taskReady, FirstSuccessRecursiveExecution.machine,
      FirstSuccessRecursiveExecution.next, FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, getMetaType, notStopped, notAtom, notExpr,
      notVarT, notSymT, notGrdT, notUnit, Transition.relabel]
  exact ⟨notReady, entered, .delivered entered, .internal (.delivered entered), wStep⟩

/-- Pointwise `ScopedResultRel` between worker diagnostic pairs `errors.map (fun e => (e, wB))`
and contextual `Completed.diagnosticResults errors cFrame`. -/
theorem ScopedResultRel.forall2_diagnosticResults
    {wB : Bindings} {cFrame : Completed.Frame} (actRel : ScopedActivationRel wB cFrame)
    (errors : List Atom) :
    List.Forall₂ ScopedResultRel
      (errors.map fun error => (error, wB))
      (Completed.diagnosticResults errors cFrame) := by
  induction errors with
  | nil => exact .nil
  | cons err rest ih =>
      exact .cons ⟨(Entry.Value.erase_ofAtom err).symm, actRel⟩ ih

/-- Commuting Prepend-Diagnostics Empty-Result Square (`ScopedConfigurationRel.prependDiagnostics_empty_step`):
When `.returning []` resumes `.prepend (errors.map fun error => (error, wB))` against
`.diagnostics errors cFrame`, both machines step in 1 silent transition to `.returning` the
diagnostic results, preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.prependDiagnostics_empty_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (errors : List Atom) (wB : Bindings) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wDiag : ResultSet := errors.map fun error => (error, wB)
    let wBefore : Configuration :=
      ⟨space, .returning [], .prepend wDiag :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning wDiag, wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [], .diagnostics errors cFrame :: cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning (Completed.diagnosticResults errors cFrame), cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wDiag wBefore wAfter cBefore cAfter
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, wDiag, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, RecursiveMachine.Checked.frameReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      RecursiveMachine.resume, Transition.relabel]
  have cLocal :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) := by
    simpa [cBefore, cAfter] using
      (RecursiveMachine.Contextual.LocalStep.diagnostics
        (space := space) (dispatch := hostDispatch) (lookup := Completed.scopedLookup)
        (policy := policy) (errors := errors) (activation := cFrame)
        (results := []) (stack := cStack))
  exact ⟨wStep, cLocal, .internal cLocal,
    ⟨rfl, .returning (ScopedResultRel.forall2_diagnosticResults actRel errors), stackRel, emittedRel⟩⟩

/-- Commuting Prepend-Diagnostics No-Errors Square (`ScopedConfigurationRel.prependDiagnostics_noErrors_step`):
When `.returning wResults` / `.returning cResults` resumes `.prepend []` against
`.diagnostics [] cFrame` (as pushed on non-function tuple fallback), both machines step in 1
silent transition to `.returning wResults` / `.returning cResults`, preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.prependDiagnostics_noErrors_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (wResults : ResultSet) (cResults : List Completed.Result)
    (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (resultsRel : List.Forall₂ ScopedResultRel wResults cResults)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .returning wResults, .prepend [] :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning wResults, wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning cResults, .diagnostics [] cFrame :: cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning cResults, cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, RecursiveMachine.Checked.frameReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      RecursiveMachine.resume, Transition.relabel]
  have cLocal :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) := by
    simpa [cBefore, cAfter, Completed.diagnosticResults] using
      (RecursiveMachine.Contextual.LocalStep.diagnostics
        (space := space) (dispatch := hostDispatch) (lookup := Completed.scopedLookup)
        (policy := policy) (errors := []) (activation := cFrame)
        (results := cResults) (stack := cStack))
  exact ⟨wStep, cLocal, .internal cLocal,
    ⟨rfl, .returning resultsRel, stackRel, emittedRel⟩⟩

/-- `FirstSuccessRecursiveStrategy.readPolicy candidate = none` if and only if
`isFunctionType candidate = false`. -/
theorem readPolicy_eq_none_iff_isFunctionType_false (candidate : Atom) :
    FirstSuccessRecursiveStrategy.readPolicy candidate = none ↔
      isFunctionType candidate = false := by
  cases candidate with
  | symbol _ => simp [FirstSuccessRecursiveStrategy.readPolicy, isFunctionType]
  | var _ => simp [FirstSuccessRecursiveStrategy.readPolicy, isFunctionType]
  | grounded _ => simp [FirstSuccessRecursiveStrategy.readPolicy, isFunctionType]
  | expression children =>
      cases children with
      | nil => simp [FirstSuccessRecursiveStrategy.readPolicy, isFunctionType]
      | cons head tail =>
          cases head with
          | symbol name =>
              by_cases hArrow : name = "->"
              · subst hArrow
                cases tail <;> simp [FirstSuccessRecursiveStrategy.readPolicy, isFunctionType]
              · simp [FirstSuccessRecursiveStrategy.readPolicy, isFunctionType, hArrow]
          | var _ => simp [FirstSuccessRecursiveStrategy.readPolicy, isFunctionType]
          | grounded _ => simp [FirstSuccessRecursiveStrategy.readPolicy, isFunctionType]
          | expression _ => simp [FirstSuccessRecursiveStrategy.readPolicy, isFunctionType]

/-- `isFunctionType candidate = false` if and only if `candidate` has no arrow decomposition
`FunctionTypeRel candidate domains returned`. -/
theorem isFunctionType_false_iff_not_functionTypeRel (candidate : Atom) :
    isFunctionType candidate = false ↔
      ¬∃ domains returned, FunctionTypeRel candidate domains returned := by
  rw [← readPolicy_eq_none_iff_isFunctionType_false]
  exact FirstSuccessRecursiveStrategy.readPolicy_none_iff candidate

/-- Renaming type variables preserves `isFunctionType`. -/
theorem isFunctionType_renameTypeVars (f : String → String) (candidate : Atom) :
    isFunctionType (renameTypeVars f candidate) = isFunctionType candidate := by
  cases candidate with
  | symbol _ => simp [renameTypeVars, isFunctionType]
  | var _ => simp [renameTypeVars, isFunctionType]
  | grounded _ => simp [renameTypeVars, isFunctionType]
  | expression children =>
      cases children with
      | nil => simp [renameTypeVars, isFunctionType]
      | cons head tail =>
          cases head with
          | symbol name =>
              by_cases hArrow : name = "->"
              · subst hArrow
                cases tail <;> simp [renameTypeVars, isFunctionType]
              · simp [renameTypeVars, isFunctionType, hArrow]
          | var _ => simp [renameTypeVars, isFunctionType]
          | grounded _ => simp [renameTypeVars, isFunctionType]
          | expression _ => simp [renameTypeVars, isFunctionType]

/-- If `ArgumentAlphaVariantsRel avoid raw candidates` and every `r ∈ raw` has
`isFunctionType r = false`, then `candidates.isEmpty = raw.isEmpty` and every
`c ∈ candidates` has `isFunctionType c = false`. -/
theorem ArgumentAlphaVariantsRel.nonfunctions
    {avoid : List String} {raw candidates : List Atom}
    (variants : ArgumentAlphaVariantsRel avoid raw candidates)
    (hRaw : ∀ r ∈ raw, isFunctionType r = false) :
    candidates.isEmpty = raw.isEmpty ∧
    ∀ c ∈ candidates, isFunctionType c = false := by
  induction variants with
  | nil => exact ⟨rfl, fun _ h => False.elim (List.not_mem_nil h)⟩
  | @cons avoid r c rawRest candRest hVar _ ih =>
      obtain ⟨f, _, hEq, _⟩ := hVar
      have hHead : isFunctionType c = false := by
        rw [hEq, isFunctionType_renameTypeVars]
        exact hRaw r List.mem_cons_self
      have hTail := ih (fun x hx => hRaw x (List.mem_cons_of_mem _ hx))
      refine ⟨rfl, ?_⟩
      intro x hx
      rcases List.mem_cons.mp hx with rfl | hxRest
      · exact hHead
      · exact hTail.2 x hxRest

/-- When all `candidates` are non-function types, `selectionReady` is unconditionally `true`. -/
theorem selectionReady_of_nonfunctions
    (space : Space) (lookup : TypeLookup) (value expected : Atom)
    (bindings : Bindings) (fuel : Nat) (candidates : List Atom)
    (hCand : ∀ c ∈ candidates, isFunctionType c = false) :
    FirstSuccessRecursiveStrategy.selectionReady (lookup := lookup)
      space value expected bindings fuel candidates = true := by
  induction candidates with
  | nil => rfl
  | cons c rest ih =>
      have hNone : FirstSuccessRecursiveStrategy.readPolicy c = none :=
        (readPolicy_eq_none_iff_isFunctionType_false c).mpr (hCand c List.mem_cons_self)
      simp [FirstSuccessRecursiveStrategy.selectionReady, hNone,
        ih (fun x hx => hCand x (List.mem_cons_of_mem _ hx))]

/-- When all `candidates` are non-function types, `select` returns `.exhausted [] (!candidates.isEmpty)`. -/
theorem select_of_nonfunctions
    (space : Space) (lookup : TypeLookup) (value expected : Atom)
    (bindings : Bindings) (fuel : Nat) (candidates : List Atom)
    (hCand : ∀ c ∈ candidates, isFunctionType c = false) :
    FirstSuccessRecursiveStrategy.select (lookup := lookup)
      space value expected bindings fuel candidates =
      .exhausted [] (!candidates.isEmpty) := by
  induction candidates with
  | nil => rfl
  | cons c rest ih =>
      have hNone : FirstSuccessRecursiveStrategy.readPolicy c = none :=
        (readPolicy_eq_none_iff_isFunctionType_false c).mpr (hCand c List.mem_cons_self)
      have hRest := ih (fun x hx => hCand x (List.mem_cons_of_mem _ hx))
      simp [FirstSuccessRecursiveStrategy.select, hNone, hRest,
        FirstSuccessRecursiveStrategy.noteNonFunction]

/-- When all `candidates` are non-function types, `Completed.InvocationScanRel` derives
`.exhausted [] (!candidates.isEmpty)` without any applicability assumptions. -/
theorem invocationScanRel_of_nonfunctions
    (space : Space) (lookup : TypeLookupRel) (policy : Policy)
    (expression expected : Atom) (before : Completed.Frame) (candidates : List Atom)
    (hCand : ∀ c ∈ candidates, isFunctionType c = false) :
    Completed.InvocationScanRel space lookup policy expression expected before candidates
      (.exhausted [] (!candidates.isEmpty)) := by
  induction candidates with
  | nil => exact .nil
  | cons c rest ih =>
      have hNotFn : ¬∃ domains returned, FunctionTypeRel c domains returned :=
        (isFunctionType_false_iff_not_functionTypeRel c).mp (hCand c List.mem_cons_self)
      have hRest := ih (fun x hx => hCand x (List.mem_cons_of_mem _ hx))
      exact .nonFunction hNotFn hRest

/-- When `selectionReady = true` and `select = .exhausted errors eligible`, every function
type in `types` is covered and fails applicability, and the flattened diagnostic list equals
`errors.map fun error => (error, bindings)`. -/
theorem fallback_exhausted_checks_and_ready
    (space : Space) (lookup : TypeLookup) (value expected : Atom)
    (bindings : Bindings) (fuel : Nat) (types : List Atom)
    (errors : List Atom) (eligible : Bool)
    (hReady : FirstSuccessRecursiveStrategy.selectionReady (lookup := lookup)
      space value expected bindings fuel types = true)
    (hSelect : FirstSuccessRecursiveStrategy.select (lookup := lookup)
      space value expected bindings fuel types = .exhausted errors eligible) :
    (types.all fun operatorType =>
      !isFunctionType operatorType ||
        functionTypeCovered value operatorType expected space bindings fuel lookup) = true ∧
    (types.all fun operatorType =>
      if isFunctionType operatorType then
        match checkIfFunctionTypeIsApplicable value operatorType expected space bindings fuel lookup with
        | .inl _ => true
        | .inr _ => false
      else true) = true ∧
    (types.flatMap fun operatorType =>
      if isFunctionType operatorType then
        match checkIfFunctionTypeIsApplicable value operatorType expected space bindings fuel lookup with
        | .inl errs => errs.map fun error => (error, bindings)
        | .inr _ => []
      else []) = errors.map fun error => (error, bindings) := by
  induction types generalizing errors eligible with
  | nil =>
      simp only [FirstSuccessRecursiveStrategy.select,
        FirstSuccessRecursiveStrategy.Selection.exhausted.injEq] at hSelect
      rcases hSelect with ⟨rfl, _⟩
      exact ⟨rfl, rfl, rfl⟩
  | cons candidate remaining ih =>
      cases hParsed : FirstSuccessRecursiveStrategy.readPolicy candidate with
      | none =>
          have hNotFn : isFunctionType candidate = false :=
            (readPolicy_eq_none_iff_isFunctionType_false candidate).mp hParsed
          have hReadyRest : FirstSuccessRecursiveStrategy.selectionReady (lookup := lookup)
              space value expected bindings fuel remaining = true := by
            simpa [FirstSuccessRecursiveStrategy.selectionReady, hParsed] using hReady
          cases hTail : FirstSuccessRecursiveStrategy.select (lookup := lookup)
              space value expected bindings fuel remaining with
          | selected pol alts =>
              simp [FirstSuccessRecursiveStrategy.select, hParsed, hTail,
                FirstSuccessRecursiveStrategy.noteNonFunction] at hSelect
          | exhausted tailErrors tailElig =>
              simp only [FirstSuccessRecursiveStrategy.select, hParsed, hTail,
                FirstSuccessRecursiveStrategy.noteNonFunction,
                FirstSuccessRecursiveStrategy.Selection.exhausted.injEq] at hSelect
              rcases hSelect with ⟨rfl, _⟩
              obtain ⟨hCov, hFailed, hFlat⟩ := ih tailErrors tailElig hReadyRest hTail
              refine ⟨?_, ?_, ?_⟩
              · simp only [List.all_cons, hNotFn, Bool.not_false, Bool.true_or,
                  Bool.true_and, hCov]
              · simp only [List.all_cons, hNotFn, Bool.false_eq_true, ↓reduceIte,
                  Bool.true_and, hFailed]
              · simp only [List.flatMap_cons, hNotFn, Bool.false_eq_true, ↓reduceIte,
                  List.nil_append, hFlat]
      | some pol =>
          have hFn : isFunctionType candidate = true := by
            cases hB : isFunctionType candidate with
            | true => rfl
            | false =>
                rw [(readPolicy_eq_none_iff_isFunctionType_false candidate).mpr hB] at hParsed
                cases hParsed
          cases hCheck : checkIfFunctionTypeIsApplicable (lookup := lookup)
              value candidate expected space bindings fuel with
          | inr alts =>
              simp [FirstSuccessRecursiveStrategy.select, hParsed, hCheck] at hSelect
          | inl headErrors =>
              simp only [FirstSuccessRecursiveStrategy.selectionReady, hParsed, hCheck,
                Bool.and_eq_true] at hReady
              obtain ⟨hCovHead, hReadyRest⟩ := hReady
              cases hTail : FirstSuccessRecursiveStrategy.select (lookup := lookup)
                  space value expected bindings fuel remaining with
              | selected pol2 alts =>
                  simp [FirstSuccessRecursiveStrategy.select, hParsed, hCheck, hTail,
                    FirstSuccessRecursiveStrategy.noteErrors] at hSelect
              | exhausted tailErrors tailElig =>
                  simp only [FirstSuccessRecursiveStrategy.select, hParsed, hCheck, hTail,
                    FirstSuccessRecursiveStrategy.noteErrors,
                    FirstSuccessRecursiveStrategy.Selection.exhausted.injEq] at hSelect
                  rcases hSelect with ⟨rfl, _⟩
                  obtain ⟨hCov, hFailed, hFlat⟩ := ih tailErrors tailElig hReadyRest hTail
                  refine ⟨?_, ?_, ?_⟩
                  · simp only [List.all_cons, hFn, Bool.not_true, Bool.false_or,
                      hCovHead, Bool.true_and, hCov]
                  · simp only [List.all_cons, hFn, ↓reduceIte, hCheck,
                      Bool.true_and, hFailed]
                  · simp only [List.flatMap_cons, hFn, ↓reduceIte, hCheck,
                      hFlat, List.map_append]

/-- Corollary: `selectionReady = true` and `select = .exhausted errors eligible` imply
`frameReady space [] (.fallback ...) = true` and `functionFallback ... [] = errors.map (·, bindings)`. -/
theorem fallback_exhausted_ready_and_eq
    (space : Space) (lookup : TypeLookup) (value expected : Atom)
    (bindings : Bindings) (fuel : Nat) (types : List Atom)
    (errors : List Atom) (eligible : Bool)
    (hReady : FirstSuccessRecursiveStrategy.selectionReady (lookup := lookup)
      space value expected bindings fuel types = true)
    (hSelect : FirstSuccessRecursiveStrategy.select (lookup := lookup)
      space value expected bindings fuel types = .exhausted errors eligible) :
    RecursiveMachine.Checked.frameReady space []
      (.fallback value expected bindings fuel types) lookup = true ∧
    RecursiveTasks.functionFallback space value expected bindings fuel types [] lookup =
      errors.map fun error => (error, bindings) := by
  obtain ⟨hCov, hFailed, hFlat⟩ :=
    fallback_exhausted_checks_and_ready space lookup value expected bindings fuel types
      errors eligible hReady hSelect
  refine ⟨?_, ?_⟩
  · simp [RecursiveMachine.Checked.frameReady, hCov]
  · unfold RecursiveTasks.functionFallback
    rw [if_neg (by decide)]
    change (if
      (types.all fun operatorType =>
        if isFunctionType operatorType then
          match checkIfFunctionTypeIsApplicable value operatorType expected space bindings fuel lookup with
          | .inl _ => true
          | .inr _ => false
        else true) = true then
      (types.flatMap fun operatorType =>
        if isFunctionType operatorType then
          match checkIfFunctionTypeIsApplicable value operatorType expected space bindings fuel lookup with
          | .inl errs => errs.map fun error => (error, bindings)
          | .inr _ => []
        else [])
      else []) = errors.map fun error => (error, bindings)
    rw [hFailed]
    exact hFlat

/-- Commuting Fallback Non-Empty Continuation Square (`ScopedConfigurationRel.fallback_nonempty_step`):
When `.returning (wHead :: wTail)` / `.returning (cHead :: cTail)` resumes
`.fallback value expected wB fuel types` against `.diagnostics [] cFrame`, both machines
keep the non-empty results unchanged and step in 1 silent transition while preserving
`ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.fallback_nonempty_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (value expected : Atom) (wB : Bindings) (fuel : Nat) (types : List Atom)
    (wHead : ResultPair) (wTail : ResultSet)
    (cHead : Completed.Result) (cTail : List Completed.Result)
    (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (headRel : ScopedResultRel wHead cHead)
    (tailRel : List.Forall₂ ScopedResultRel wTail cTail)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .returning (wHead :: wTail), .fallback value expected wB fuel types :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning (wHead :: wTail), wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning (cHead :: cTail), .diagnostics [] cFrame :: cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning (cHead :: cTail), cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, RecursiveMachine.Checked.frameReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      RecursiveMachine.resume, RecursiveTasks.functionFallback, Transition.relabel]
  have cLocal :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) := by
    simpa [cBefore, cAfter, Completed.diagnosticResults] using
      (RecursiveMachine.Contextual.LocalStep.diagnostics
        (space := space) (dispatch := hostDispatch) (lookup := Completed.scopedLookup)
        (policy := policy) (errors := []) (activation := cFrame)
        (results := cHead :: cTail) (stack := cStack))
  exact ⟨wStep, cLocal, .internal cLocal,
    ⟨rfl, .returning (.cons headRel tailRel), stackRel, emittedRel⟩⟩

/-- Commuting Fallback Exhausted Continuation Square (`ScopedConfigurationRel.fallback_exhausted_step`):
When `.returning []` resumes `.fallback value expected wB fuel types` against
`.diagnostics errors cFrame` under `selectionReady = true` and `select = .exhausted errors eligible`,
both machines step in 1 silent transition to `.returning` the diagnostic results,
preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.fallback_exhausted_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (value expected : Atom) (wB : Bindings) (fuel : Nat) (types errors : List Atom)
    (eligible : Bool) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (hReady : FirstSuccessRecursiveStrategy.selectionReady
      (lookup := invocationTypes ⟨space, .returning [], .fallback value expected wB fuel types :: wStack, wEmitted⟩)
      space value expected wB fuel types = true)
    (hSelect : FirstSuccessRecursiveStrategy.select
      (lookup := invocationTypes ⟨space, .returning [], .fallback value expected wB fuel types :: wStack, wEmitted⟩)
      space value expected wB fuel types = .exhausted errors eligible) :
    let wBefore : Configuration :=
      ⟨space, .returning [], .fallback value expected wB fuel types :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning (errors.map fun error => (error, wB)), wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [], .diagnostics errors cFrame :: cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning (Completed.diagnosticResults errors cFrame), cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  obtain ⟨hFrameReady, hFallbackEq⟩ :=
    fallback_exhausted_ready_and_eq space (invocationTypes wBefore)
      value expected wB fuel types errors eligible hReady hSelect
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, scopedTypes, hFrameReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      RecursiveMachine.resume, hFallbackEq, Transition.relabel]
  have cLocal :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) := by
    simpa [cBefore, cAfter] using
      (RecursiveMachine.Contextual.LocalStep.diagnostics
        (space := space) (dispatch := hostDispatch) (lookup := Completed.scopedLookup)
        (policy := policy) (errors := errors) (activation := cFrame)
        (results := []) (stack := cStack))
  exact ⟨wStep, cLocal, .internal cLocal,
    ⟨rfl, .returning (ScopedResultRel.forall2_diagnosticResults actRel errors), stackRel, emittedRel⟩⟩

/-- Contextual success-priority filter on `List Completed.Result`: keeps all non-error
occurrences when at least one non-error exists, and retains the full error list otherwise. -/
def completedSuccessPriority (results : List Completed.Result) : List Completed.Result :=
  let successes := results.filter fun result => !isErrorAtom result.1.erase
  if !successes.isEmpty then successes else results

/-- `completedSuccessPriority results` satisfies `SuccessPriorityRel` without any
external assumptions. -/
theorem completedSuccessPriority_rel (results : List Completed.Result) :
    SuccessPriorityRel (fun result : Completed.Result => isErrorAtom result.1.erase)
      results (completedSuccessPriority results) := by
  classical
  by_cases succeeds : ∃ row ∈ results, isErrorAtom row.1.erase = false
  · have nonempty : (results.filter fun row => !isErrorAtom row.1.erase) ≠ [] := by
      obtain ⟨row, member, clean⟩ := succeeds
      intro empty
      have present : row ∈ results.filter (fun row => !isErrorAtom row.1.erase) :=
        List.mem_filter.mpr ⟨member, by simp [clean]⟩
      rw [empty] at present
      exact List.not_mem_nil present
    have selected :
        completedSuccessPriority results =
          results.filter (fun row => !isErrorAtom row.1.erase) := by
      simp [completedSuccessPriority, List.isEmpty_eq_false_iff.mpr nonempty]
    rw [selected]
    exact .successes succeeds
  · have failed : ∀ row ∈ results, isErrorAtom row.1.erase = true := by
      intro row member
      cases classified : isErrorAtom row.1.erase with
      | true => rfl
      | false => exact False.elim (succeeds ⟨row, member, classified⟩)
    have empty : (results.filter fun row => !isErrorAtom row.1.erase) = [] := by
      apply List.filter_eq_nil_iff.mpr
      intro row member
      simp [failed row member]
    simp only [completedSuccessPriority, empty, List.isEmpty_nil, Bool.not_true,
      Bool.false_eq_true, ↓reduceIte]
    exact .allErrors failed

/-- Pointwise `ScopedResultRel` commutes with filtering non-error occurrences. -/
theorem ScopedResultRel.forall2_filter_not_error
    {wResults : ResultSet} {cResults : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wResults cResults) :
    List.Forall₂ ScopedResultRel
      (wResults.filter fun (value, _) => !isErrorAtom value)
      (cResults.filter fun result => !isErrorAtom result.1.erase) := by
  induction rel with
  | nil => exact .nil
  | @cons w c ws cs h rest ih =>
      rcases w with ⟨wVal, wB⟩
      rcases c with ⟨cVal, cFrame⟩
      have valEq : wVal = cVal.erase := h.1
      by_cases hClean : (!isErrorAtom cVal.erase) = true
      · have wClean : (!isErrorAtom wVal) = true := by rwa [valEq]
        simp only [List.filter_cons, wClean, hClean, ↓reduceIte]
        exact .cons h ih
      · have hFalse : (!isErrorAtom cVal.erase) = false :=
          Bool.eq_false_iff.mpr hClean
        have wFalse : (!isErrorAtom wVal) = false := by rwa [valEq]
        simp only [List.filter_cons, wFalse, hFalse, Bool.false_eq_true, ↓reduceIte]
        exact ih

/-- Pointwise `ScopedResultRel` commutes with `successPriority` and `completedSuccessPriority`. -/
theorem ScopedResultRel.forall2_successPriority
    {wResults : ResultSet} {cResults : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wResults cResults) :
    List.Forall₂ ScopedResultRel
      (successPriority wResults)
      (completedSuccessPriority cResults) := by
  have filtRel := ScopedResultRel.forall2_filter_not_error rel
  have isEmptyEq :
      (wResults.filter fun (value, _) => !isErrorAtom value).isEmpty =
        (cResults.filter fun result => !isErrorAtom result.1.erase).isEmpty := by
    generalize (wResults.filter fun (value, _) => !isErrorAtom value) = wF at filtRel
    generalize (cResults.filter fun result => !isErrorAtom result.1.erase) = cF at filtRel
    cases filtRel <;> rfl
  by_cases hNonEmpty :
      (!(cResults.filter fun result => !isErrorAtom result.1.erase).isEmpty) = true
  · have wNonEmpty :
        (!(wResults.filter fun (value, _) => !isErrorAtom value).isEmpty) = true := by
      rwa [isEmptyEq]
    simp only [successPriority, completedSuccessPriority, wNonEmpty, hNonEmpty, ↓reduceIte]
    exact filtRel
  · have cEmpty : (cResults.filter fun result => !isErrorAtom result.1.erase).isEmpty = true := by
      cases h : (cResults.filter fun result => !isErrorAtom result.1.erase).isEmpty <;>
        simp_all
    have wEmpty : (wResults.filter fun (value, _) => !isErrorAtom value).isEmpty = true := by
      rwa [isEmptyEq]
    have wNil : (wResults.filter fun (value, _) => !isErrorAtom value) = [] :=
      List.isEmpty_iff.mp wEmpty
    have wAllErr : ∀ row ∈ wResults, isErrorAtom row.1 = true := by
      intro row member
      have notClean := List.filter_eq_nil_iff.mp wNil row member
      cases h : isErrorAtom row.1 <;> simp_all
    have wKept : (wResults.filter fun (value, _) => isErrorAtom value) = wResults :=
      List.filter_eq_self.mpr wAllErr
    simp only [successPriority, completedSuccessPriority, wEmpty, cEmpty,
      Bool.not_true, Bool.false_eq_true, ↓reduceIte, wKept]
    exact rel

/-- From `ScopedResultRel (value, native) c` and an actual covered native read
`native.applyFullCovered value depth = true`, `SourceBindingComparison.FrameRelated.materialization`
and `Completed.Frame.read_source` show that `native.applyFull value depth` equals the erased
contextual read `(c.2.read policy c.1).erase`. -/
theorem ScopedResultRel.applyFull_eq_read_erase_of_covered
    (policy : Policy) {value : Atom} {native : Bindings} {c : Completed.Result}
    (rel : ScopedResultRel (value, native) c)
    (depth : Nat) (covered : native.applyFullCovered value depth = true) :
    native.applyFull value depth = (c.2.read policy c.1).erase := by
  have matNative : c.2.source.Materialization c.1.erase (native.applyFull value depth) := by
    rw [← rel.1]
    exact rel.2.materialization value depth covered
  have matRead : c.2.source.Materialization c.1.erase (c.2.read policy c.1).erase :=
    c.2.read_source policy c.1
  exact Spec.Eval.BindingFrame.Materialization.output_eq matNative matRead

/-- General Materialized Result-Read Law (`ScopedResultRel.materialized_readResult`):
From `ScopedResultRel (value, native) c` and an actual covered native read
`native.applyFullCovered value depth = true`, `SourceBindingComparison.FrameRelated.materialization`
and `Completed.Frame.read_source` on the same selected frame establish `ScopedResultRel`
between the materialized native result `(native.applyFull value depth, native)` and the
annotated contextual read `Completed.readResult policy c = (c.2.read policy c.1, c.2)`.
This preserves the full annotated value `Completed.readResult policy c` without assuming
`native.applyFull value depth = value` and without claiming entry readiness. -/
theorem ScopedResultRel.materialized_readResult
    (policy : Policy) {value : Atom} {native : Bindings} {c : Completed.Result}
    (rel : ScopedResultRel (value, native) c)
    (depth : Nat) (covered : native.applyFullCovered value depth = true) :
    ScopedResultRel (native.applyFull value depth, native) (Completed.readResult policy c) :=
  ⟨rel.applyFull_eq_read_erase_of_covered policy depth covered, rel.2⟩

/-- Covered materialization earns the next semantic entry for a reinterpreting
worker. Free variables are allowed; no payload-specific read-stability premise
is required. Reusing policies retain the separate active-status obligation. -/
theorem ScopedResultRel.materialized_entry_ready
    (policy : Policy) {value : Atom} {native : Bindings} {c : Completed.Result}
    (related : ScopedResultRel (value,native) c)
    (depth : Nat) (covered : native.applyFullCovered value depth = true)
    (reinterprets : policy.reentry = .reinterpret) :
    ScopedResultRel (native.applyFull value depth,native) (Completed.readResult policy c) ∧
    ScopedAtomEntryReady policy (native.applyFull value depth)
      (c.2.read policy c.1) c.2 := by
  have ready := ScopedAtomEntryReady.materialized_reinterpret policy c.2 c.1 reinterprets
  rw [←related.applyFull_eq_read_erase_of_covered policy depth covered] at ready
  exact ⟨related.materialized_readResult policy depth covered,ready⟩

/-- Stable-Read Specialization (`ScopedResultRel.materialized_readResult_stable`):
When `native.applyFull value depth = value` holds independently in addition to
`native.applyFullCovered value depth = true`, the original native result `(value, native)`
is aligned via `ScopedResultRel` with `Completed.readResult policy c`. -/
theorem ScopedResultRel.materialized_readResult_stable
    (policy : Policy) {value : Atom} {native : Bindings} {c : Completed.Result}
    (rel : ScopedResultRel (value, native) c)
    (depth : Nat) (covered : native.applyFullCovered value depth = true)
    (stable : native.applyFull value depth = value) :
    ScopedResultRel (value, native) (Completed.readResult policy c) := by
  simpa only [stable] using rel.materialized_readResult policy depth covered

/-- Occurrence-List Materialized Result-Read Law (`ScopedResultRel.forall2_materialized_readResult`):
Lifts `ScopedResultRel.materialized_readResult` over a complete occurrence list `wRaw` / `cRaw`
when every occurrence `(value, native) ∈ wRaw` has a covered native read at `depth`. -/
theorem ScopedResultRel.forall2_materialized_readResult
    (policy : Policy) {wRaw : ResultSet} {cRaw : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wRaw cRaw)
    (depth : Nat)
    (covered : ∀ pair ∈ wRaw, pair.2.applyFullCovered pair.1 depth = true) :
    List.Forall₂ ScopedResultRel
      (wRaw.map fun (value, native) => (native.applyFull value depth, native))
      (cRaw.map (Completed.readResult policy)) := by
  induction rel with
  | nil => exact .nil
  | @cons w c ws cs h rest ih =>
      rcases w with ⟨value, native⟩
      exact .cons
        (h.materialized_readResult policy depth (covered (value, native) List.mem_cons_self))
        (ih fun pair hMem => covered pair (List.mem_cons_of_mem _ hMem))

/-- Stable-Read Occurrence-List Specialization (`ScopedResultRel.forall2_materialized_readResult_stable`):
When every occurrence `(value, native) ∈ wRaw` is both covered at `depth` and independently
materialized (`native.applyFull value depth = value`), `wRaw` itself is aligned with
`cRaw.map (Completed.readResult policy)`. -/
theorem ScopedResultRel.forall2_materialized_readResult_stable
    (policy : Policy) {wRaw : ResultSet} {cRaw : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wRaw cRaw)
    (depth : Nat)
    (covered : ∀ pair ∈ wRaw, pair.2.applyFullCovered pair.1 depth = true)
    (stable : ∀ pair ∈ wRaw, pair.2.applyFull pair.1 depth = pair.1) :
    List.Forall₂ ScopedResultRel wRaw (cRaw.map (Completed.readResult policy)) := by
  induction rel with
  | nil => exact .nil
  | @cons w c ws cs h rest ih =>
      rcases w with ⟨value, native⟩
      exact .cons
        (h.materialized_readResult_stable policy depth
          (covered (value, native) List.mem_cons_self)
          (stable (value, native) List.mem_cons_self))
        (ih (fun pair hMem => covered pair (List.mem_cons_of_mem _ hMem))
            (fun pair hMem => stable pair (List.mem_cons_of_mem _ hMem)))

/-- `Completed.publishResult policy original` preserves `ScopedResultRel` on every list. -/
theorem ScopedResultRel.forall2_publishResult
    (policy : Policy) (original : Atom)
    {wResults : ResultSet} {cResults : List Completed.Result}
    (rel : List.Forall₂ ScopedResultRel wResults cResults) :
    List.Forall₂ ScopedResultRel wResults
      (cResults.map (Completed.publishResult policy original)) := by
  rw [List.forall₂_map_right_iff]
  exact rel.imp fun w c h => ⟨by simpa [Completed.publishResult_erase] using h.1, h.2⟩

/-- Commuting Filter / Publish Continuation Square (`ScopedConfigurationRel.filter_publish_step`):
When `.returning wRaw` / `.returning cRaw` resumes `.filter :: wStack` against
`.publish original :: cStack` and `wRaw` is aligned with `cRaw.map (Completed.readResult policy)`,
both machines step in 1 silent transition (`LocalStep.publish` with earned
`completedSuccessPriority_rel`) while preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.filter_publish_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original : Atom)
    (wRaw : ResultSet) (cRaw : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (rawReadRel : List.Forall₂ ScopedResultRel wRaw (cRaw.map (Completed.readResult policy)))
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let cSelected := completedSuccessPriority (cRaw.map (Completed.readResult policy))
    let wBefore : Configuration :=
      ⟨space, .returning wRaw, .filter :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning (successPriority wRaw), wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning cRaw, .publish original :: cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning (cSelected.map (Completed.publishResult policy original)),
        cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro cSelected wBefore wAfter cBefore cAfter
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, RecursiveMachine.Checked.frameReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      RecursiveMachine.resume, Transition.relabel]
  have prioRel := completedSuccessPriority_rel (cRaw.map (Completed.readResult policy))
  have cLocal :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) :=
    .publish prioRel
  have outRel :
      List.Forall₂ ScopedResultRel (successPriority wRaw)
        (cSelected.map (Completed.publishResult policy original)) :=
    ScopedResultRel.forall2_publishResult policy original
      (ScopedResultRel.forall2_successPriority rawReadRel)
  exact ⟨wStep, cLocal, .internal cLocal,
    ⟨rfl, .returning outRel, stackRel, emittedRel⟩⟩

/-- Covered Materialized Filter / Publish Continuation Square
(`ScopedConfigurationRel.filter_publish_step_of_covered`):
Derives `rawReadRel` for `ScopedConfigurationRel.filter_publish_step` from
`List.Forall₂ ScopedResultRel wRaw cRaw` and covered native reads
(`∀ pair ∈ wRaw, pair.2.applyFullCovered pair.1 depth = true`) via
`ScopedResultRel.forall2_materialized_readResult`, where the worker batch is the
materialized batch `wRaw.map (fun (value, native) => (native.applyFull value depth, native))`. -/
theorem ScopedConfigurationRel.filter_publish_step_of_covered
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original : Atom)
    (wRaw : ResultSet) (cRaw : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (rawRel : List.Forall₂ ScopedResultRel wRaw cRaw)
    (depth : Nat)
    (covered : ∀ pair ∈ wRaw, pair.2.applyFullCovered pair.1 depth = true)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wMat := wRaw.map fun (value, native) => (native.applyFull value depth, native)
    let cSelected := completedSuccessPriority (cRaw.map (Completed.readResult policy))
    let wBefore : Configuration :=
      ⟨space, .returning wMat, .filter :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning (successPriority wMat), wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning cRaw, .publish original :: cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning (cSelected.map (Completed.publishResult policy original)),
        cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter :=
  ScopedConfigurationRel.filter_publish_step space dispatch hostDispatch policy original
    (wRaw.map fun (value, native) => (native.applyFull value depth, native)) cRaw
    wStack cStack wEmitted cEmitted
    (ScopedResultRel.forall2_materialized_readResult policy rawRel depth covered)
    stackRel emittedRel

/-- Independently Materialized Filter / Publish Continuation Square
(`ScopedConfigurationRel.filter_publish_step_of_covered_stable`):
Derives `rawReadRel` for `ScopedConfigurationRel.filter_publish_step` from
`List.Forall₂ ScopedResultRel wRaw cRaw`, covered native reads
(`∀ pair ∈ wRaw, pair.2.applyFullCovered pair.1 depth = true`), and independent
materialization stability (`∀ pair ∈ wRaw, pair.2.applyFull pair.1 depth = pair.1`)
via `ScopedResultRel.forall2_materialized_readResult_stable`, without assuming `rawReadRel`
as a primitive hypothesis. -/
theorem ScopedConfigurationRel.filter_publish_step_of_covered_stable
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original : Atom)
    (wRaw : ResultSet) (cRaw : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (rawRel : List.Forall₂ ScopedResultRel wRaw cRaw)
    (depth : Nat)
    (covered : ∀ pair ∈ wRaw, pair.2.applyFullCovered pair.1 depth = true)
    (stable : ∀ pair ∈ wRaw, pair.2.applyFull pair.1 depth = pair.1)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let cSelected := completedSuccessPriority (cRaw.map (Completed.readResult policy))
    let wBefore : Configuration :=
      ⟨space, .returning wRaw, .filter :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning (successPriority wRaw), wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning cRaw, .publish original :: cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning (cSelected.map (Completed.publishResult policy original)),
        cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter :=
  ScopedConfigurationRel.filter_publish_step space dispatch hostDispatch policy original
    wRaw cRaw wStack cStack wEmitted cEmitted
    (ScopedResultRel.forall2_materialized_readResult_stable policy rawRel depth covered stable)
    stackRel emittedRel

/-- Scoped Lookup Alignment for Expression Operator Queries (`scopedLookup_of_expression_invocationTypes_related`):
At any configuration `wBefore = ⟨space, .work (.atom (.expression (operator :: arguments)) expected wB fuel live), wStack, wEmitted⟩`,
when `ScopedActivationRel wB cFrame` and `scope` is retained in `RecursiveScope.configurationNames wBefore`,
the worker's actual `invocationTypes wBefore wB operator expected` satisfies `Completed.scopedLookup`
at `invocationTypeScope scope live (.expression (operator :: arguments)) expected cFrame.bindings`. -/
theorem scopedLookup_of_expression_invocationTypes_related
    (space : Space) (operator : Atom) (arguments : List Atom) (expected : Atom)
    (wB : Bindings) (cFrame : Completed.Frame)
    (fuel : Nat) (live : List Atom) (scope : List String)
    (wStack : List RecursiveTasks.Frame) (wEmitted : ResultSet)
    (actRel : ScopedActivationRel wB cFrame)
    (retained : ∀ name ∈ scope,
      name ∈ RecursiveScope.configurationNames
        ⟨space, .work (.atom (.expression (operator :: arguments)) expected wB fuel live),
          wStack, wEmitted⟩) :
    let expr := Atom.expression (operator :: arguments)
    let wBefore : Configuration :=
      ⟨space, .work (.atom expr expected wB fuel live), wStack, wEmitted⟩
    Completed.scopedLookup
      (invocationTypeScope scope live expr expected cFrame.bindings)
      space cFrame.bindings operator Atom.undefinedType
      (invocationTypes wBefore wB operator expected) := by
  intro expr wBefore
  refine ⟨getAtomTypes space operator, FirstSuccessSourceReplies.source_types space operator, ?_⟩
  apply EquationFreshening.getAtomTypesScoped_variants
    (RecursiveScope.configurationNames wBefore) space wB operator expected
  intro name member
  simp only [invocationTypeScope, List.nil_append, TypeSubst.typeVarsList,
    List.append_nil, List.mem_append] at member ⊢
  have beforeEq : cFrame.source.bindings = cFrame.bindings := rfl
  rcases member with (((kept | used) | bound) | exprOrExpected) | boundAgain
  · exact Or.inl (Or.inl (Or.inl (retained name kept)))
  · left; left; left
    rw [← atomListVariables_eq_typeVarsList] at used
    simp only [wBefore, expr, RecursiveScope.configurationNames, RecursiveScope.liveAtoms,
      RecursiveScope.controlAtoms, RecursiveScope.taskAtoms, atomListVariables_append,
      atomListVariables, List.append_nil, List.mem_append] at used ⊢
    tauto
  · exact Or.inl (Or.inl (Or.inr ((actRel.related.support name).mpr (beforeEq ▸ bound))))
  · rcases exprOrExpected with exprMem | expMem
    · exact Or.inl (Or.inr exprMem)
    · simp [TypeSubst.typeVars, Atom.undefinedType] at expMem
  · exact Or.inl (Or.inl (Or.inr ((actRel.related.support name).mpr (beforeEq ▸ boundAgain))))

/-- General Non-Function / Constructor Expression Fallback Square
(`ScopedConfigurationRel.scoped_nonfunction_expression_fallback_square`):
When `operator` has non-empty non-arrow declarations (`getAtomTypes space operator ≠ []` and
`∀ r ∈ getAtomTypes space operator, isFunctionType r = false`) and `ctxVal` satisfies
`ScopedAtomEntryReady policy (.expression (operator :: arguments)) ctxVal cFrame`:
1. `Completed.InvocationSelectionRel` is earned with `.exhausted [] true` (no pre-assumed selection),
2. The worker advances in a 4-step silent block (`.atom` -> `.expression` -> `.functions` ->
   `.tupleCalls` -> `.tuple`) with `.calls expected fuel live :: .prepend [] :: .filter :: wStack`,
3. The contextual machine steps in 1 silent transition (`LocalStep.atomFallback`) to `.tuple`
   with `.calls live scope expected :: .diagnostics [] cFrame :: .publish expr :: cStack`, and
4. `ScopedConfigurationRel` holds at the resulting tuple configurations. -/
theorem ScopedConfigurationRel.scoped_nonfunction_expression_fallback_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator : Atom) (arguments : List Atom) (expected : Atom)
    (wB : Bindings) (fuel : Nat) (live : List Atom) (scope : List String)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (entryReady : ScopedAtomEntryReady policy (.expression (operator :: arguments)) ctxVal cFrame)
    (notStopped : isEmptyOrError (.expression (operator :: arguments)) = false)
    (notAtom : expected ≠ Atom.atomType)
    (notExpr : expected ≠ Atom.expressionType)
    (nonemptyRaw : getAtomTypes space operator ≠ [])
    (nonfunctions : ∀ r ∈ getAtomTypes space operator, isFunctionType r = false)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (retained : ∀ name ∈ scope,
      name ∈ RecursiveScope.configurationNames
        ⟨space, .work (.atom (.expression (operator :: arguments)) expected wB (fuel + 2) live),
          wStack, wEmitted⟩) :
    let expr := Atom.expression (operator :: arguments)
    let w0 : Configuration :=
      ⟨space, .work (.atom expr expected wB (fuel + 2) live), wStack, wEmitted⟩
    let candidates := invocationTypes w0 wB operator expected
    let w1 : Configuration :=
      ⟨space, .work (.expression expr expected wB (fuel + 1) live), .filter :: wStack, wEmitted⟩
    let w2 : Configuration :=
      ⟨space, .work (.functions expr expected wB fuel candidates live),
        .filter :: wStack, wEmitted⟩
    let w3 : Configuration :=
      ⟨space, .work (.tupleCalls expr expected wB fuel live),
        .prepend [] :: .filter :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.tuple expr wB fuel (expected :: live)),
        .calls expected fuel live :: .prepend [] :: .filter :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal expected cFrame), cStack, cEmitted⟩
    ∃ (readiness : Entry.Status) (ctxOp : Entry.Value) (ctxArgs : List Entry.Value),
      cFrame.read policy ctxVal = .expression readiness (ctxOp :: ctxArgs) ∧
      ctxOp.erase = operator ∧
      ctxArgs.map Entry.Value.erase = arguments ∧
      let cAfter : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.tuple (expected :: live) scope (ctxOp :: ctxArgs) cFrame),
          .calls live scope expected :: .diagnostics [] cFrame :: .publish expr :: cStack,
          cEmitted⟩
      Completed.InvocationSelectionRel space Completed.scopedLookup policy live scope
        expr operator expected cFrame (.exhausted [] true) ∧
      (Checked.machine dispatch scopedTypes).step w0 = some (.silent w1) ∧
      (Checked.machine dispatch scopedTypes).step w1 = some (.silent w2) ∧
      (Checked.machine dispatch scopedTypes).step w2 = some (.silent w3) ∧
      (Checked.machine dispatch scopedTypes).step w3 = some (.silent wAfter) ∧
      (∀ budget, (Checked.machine dispatch scopedTypes).run (4 + budget) w0 =
        (Checked.machine dispatch scopedTypes).run budget wAfter) ∧
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
      RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
        cBefore (some (.silent cAfter)) ∧
      ScopedConfigurationRel wAfter cAfter := by
  intro expr w0 candidates w1 w2 w3 wAfter cBefore
  obtain ⟨readiness, ctxOp, ctxArgs, hReadVal, hOpErase, hArgsErase⟩ :=
    erase_eq_expression_cons entryReady.2.1
  refine ⟨readiness, ctxOp, ctxArgs, hReadVal, hOpErase, hArgsErase, ?_⟩
  intro cAfter
  have hLookup :
      Completed.scopedLookup
        (invocationTypeScope scope live expr expected cFrame.bindings)
        space cFrame.bindings operator Atom.undefinedType candidates :=
    scopedLookup_of_expression_invocationTypes_related space operator arguments expected
      wB cFrame (fuel + 2) live scope wStack wEmitted actRel retained
  have ⟨raw, hRawTypes, hVar⟩ := hLookup
  have hRawEq : raw = getAtomTypes space operator :=
    hRawTypes.unique (FirstSuccessSourceReplies.source_types space operator)
  subst hRawEq
  obtain ⟨hIsEmptyEq, hCandNonFn⟩ := ArgumentAlphaVariantsRel.nonfunctions hVar nonfunctions
  have hCandNotEmpty : (!candidates.isEmpty) = true := by
    rw [hIsEmptyEq]
    simp [List.isEmpty_eq_false_iff.mpr nonemptyRaw]
  have hScan :
      Completed.InvocationScanRel space
        (Completed.scopedLookup
          (invocationTypeScope scope live expr expected cFrame.bindings) space)
        policy expr expected cFrame candidates (.exhausted [] true) := by
    rw [← hCandNotEmpty]
    exact invocationScanRel_of_nonfunctions space _ policy expr expected cFrame
      candidates hCandNonFn
  have hSelRel :
      Completed.InvocationSelectionRel space Completed.scopedLookup policy live scope
        expr operator expected cFrame (.exhausted [] true) :=
    ⟨candidates, hLookup, hScan⟩
  have notVarT : Atom.expressionType ≠ Atom.variableType := by decide
  have notSymT : Atom.expressionType ≠ Atom.symbolType := by decide
  have notGrdT : Atom.expressionType ≠ Atom.groundedType := by decide
  have notUnit : Atom.expression (operator :: arguments) ≠ Atom.unit := by simp [Atom.unit]
  have step0 : (Checked.machine dispatch scopedTypes).step w0 = some (.silent w1) := by
    simp [w0, w1, expr, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, FirstSuccessRecursiveStrategy.taskReady,
      RecursiveMachine.Checked.taskReady, FirstSuccessRecursiveExecution.machine,
      FirstSuccessRecursiveExecution.next, FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, getMetaType, notStopped, notAtom, notExpr,
      notVarT, notSymT, notGrdT, notUnit, Transition.relabel]
  have hInvEq : invocationTypes w1 = invocationTypes w0 := rfl
  have step1 : (Checked.machine dispatch scopedTypes).step w1 = some (.silent w2) := by
    simp [w1, w2, expr, candidates, hInvEq, Checked.machine,
      RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter, scopedTypes, Transition.relabel]
  have hReady2 :
      FirstSuccessRecursiveStrategy.selectionReady (lookup := invocationTypes w2)
        space expr expected wB fuel candidates = true :=
    selectionReady_of_nonfunctions space (invocationTypes w2) expr expected
      wB fuel candidates hCandNonFn
  have hSelect2 :
      FirstSuccessRecursiveStrategy.select (lookup := invocationTypes w2)
        space expr expected wB fuel candidates = .exhausted [] true := by
    rw [select_of_nonfunctions space (invocationTypes w2) expr expected
      wB fuel candidates hCandNonFn, hCandNotEmpty]
  have step2 : (Checked.machine dispatch scopedTypes).step w2 = some (.silent w3) := by
    simp [w2, w3, expr, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, FirstSuccessRecursiveStrategy.taskReady, scopedTypes,
      hReady2, FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter, hSelect2, Transition.relabel]
  have step3 : (Checked.machine dispatch scopedTypes).step w3 = some (.silent wAfter) := by
    simp [w3, wAfter, expr, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, FirstSuccessRecursiveStrategy.taskReady,
      RecursiveMachine.Checked.taskReady, FirstSuccessRecursiveExecution.machine,
      FirstSuccessRecursiveExecution.next, FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, Transition.relabel]
  have runPrefix : ∀ budget,
      (Checked.machine dispatch scopedTypes).run (4 + budget) w0 =
        (Checked.machine dispatch scopedTypes).run budget wAfter := by
    intro budget
    rw [show 4 + budget = (((budget + 1) + 1) + 1) + 1 by omega,
      (Checked.machine dispatch scopedTypes).run_succ_silent step0,
      (Checked.machine dispatch scopedTypes).run_succ_silent step1,
      (Checked.machine dispatch scopedTypes).run_succ_silent step2,
      (Checked.machine dispatch scopedTypes).run_succ_silent step3]
  have hEntry :
      Entry.Rel policy.reentry (cFrame.read policy ctxVal).status
        (cFrame.read policy ctxVal).erase expected .interpret :=
    entryReady.entry_interpret notStopped notAtom notExpr
  have hSelRead :
      Completed.InvocationSelectionRel space Completed.scopedLookup policy live scope
        (cFrame.read policy ctxVal).erase ctxOp.erase expected cFrame (.exhausted [] true) := by
    rwa [entryReady.2.1, hOpErase]
  have cLocal :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) := by
    simpa only [cBefore, cAfter, entryReady.2.1] using
      (RecursiveMachine.Contextual.LocalStep.atomFallback hEntry hReadVal hSelRead)
  have hTupleTask :
      ScopedTaskRel (.tuple expr wB fuel (expected :: live))
        (.tuple (expected :: live) scope (ctxOp :: ctxArgs) cFrame) := by
    refine .tuple ?_ actRel
    simp [hOpErase, hArgsErase]
  have hDiagFrame : ScopedFrameRel (.prepend []) (.diagnostics [] cFrame) :=
    .prependDiagnostics (errors := []) actRel
  exact ⟨hSelRel, step0, step1, step2, step3, runPrefix, cLocal, .internal cLocal,
    ⟨rfl, .work hTupleTask,
      .cons .calls (.cons hDiagFrame (.cons (.filter expr) stackRel)),
      emittedRel⟩⟩

/-- General Undefined-Operator Tuple Entry Square
(`ScopedConfigurationRel.scoped_undefined_operator_tuple_square`):
When `getAtomTypes space operator = [Atom.undefinedType]` (the default for untyped symbols and
tuple heads), `StorageTypesRel space operator [Atom.undefinedType]` and
`Completed.InvocationSelectionRel ... (.exhausted [] true)` are both earned:
1. The contextual machine steps in 1 silent transition via `LocalStep.atomTuple` to `.tuple`
   with `.calls live scope expected :: .publish expr :: cStack`, AND also via
   `LocalStep.atomFallback` to `.tuple` with `.diagnostics [] cFrame` inserted,
2. The worker advances in the 4-step silent block to `.tuple`, aligned with `LocalStep.atomFallback`
   under `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.scoped_undefined_operator_tuple_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator : Atom) (arguments : List Atom) (expected : Atom)
    (wB : Bindings) (fuel : Nat) (live : List Atom) (scope : List String)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (entryReady : ScopedAtomEntryReady policy (.expression (operator :: arguments)) ctxVal cFrame)
    (notStopped : isEmptyOrError (.expression (operator :: arguments)) = false)
    (notAtom : expected ≠ Atom.atomType)
    (notExpr : expected ≠ Atom.expressionType)
    (undefTypes : getAtomTypes space operator = [Atom.undefinedType])
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (retained : ∀ name ∈ scope,
      name ∈ RecursiveScope.configurationNames
        ⟨space, .work (.atom (.expression (operator :: arguments)) expected wB (fuel + 2) live),
          wStack, wEmitted⟩) :
    let expr := Atom.expression (operator :: arguments)
    let w0 : Configuration :=
      ⟨space, .work (.atom expr expected wB (fuel + 2) live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.tuple expr wB fuel (expected :: live)),
        .calls expected fuel live :: .prepend [] :: .filter :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal expected cFrame), cStack, cEmitted⟩
    ∃ (readiness : Entry.Status) (ctxOp : Entry.Value) (ctxArgs : List Entry.Value),
      cFrame.read policy ctxVal = .expression readiness (ctxOp :: ctxArgs) ∧
      ctxOp.erase = operator ∧
      ctxArgs.map Entry.Value.erase = arguments ∧
      let cTupleAfter : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.tuple (expected :: live) scope (ctxOp :: ctxArgs) cFrame),
          .calls live scope expected :: .publish expr :: cStack, cEmitted⟩
      let cFallbackAfter : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.tuple (expected :: live) scope (ctxOp :: ctxArgs) cFrame),
          .calls live scope expected :: .diagnostics [] cFrame :: .publish expr :: cStack,
          cEmitted⟩
      StorageTypesRel space operator [Atom.undefinedType] ∧
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cTupleAfter.control, cTupleAfter.stack) ∧
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cFallbackAfter.control, cFallbackAfter.stack) ∧
      (∀ budget, (Checked.machine dispatch scopedTypes).run (4 + budget) w0 =
        (Checked.machine dispatch scopedTypes).run budget wAfter) ∧
      ScopedConfigurationRel wAfter cFallbackAfter := by
  intro expr w0 wAfter cBefore
  have nonemptyRaw : getAtomTypes space operator ≠ [] := by simp [undefTypes]
  have nonfunctions : ∀ r ∈ getAtomTypes space operator, isFunctionType r = false := by
    intro r hr
    rw [undefTypes] at hr
    obtain rfl := List.mem_singleton.mp hr
    rfl
  obtain ⟨readiness, ctxOp, ctxArgs, hReadVal, hOpErase, hArgsErase,
      _, _, _, _, _, runPrefix, cFallbackLocal, _, cfgRel⟩ :=
    ScopedConfigurationRel.scoped_nonfunction_expression_fallback_square
      space dispatch hostDispatch policy operator arguments expected wB fuel live scope
      ctxVal cFrame wStack cStack wEmitted cEmitted entryReady notStopped notAtom notExpr
      nonemptyRaw nonfunctions actRel stackRel emittedRel retained
  refine ⟨readiness, ctxOp, ctxArgs, hReadVal, hOpErase, hArgsErase, ?_⟩
  intro cTupleAfter cFallbackAfter
  have hTypesOf : StorageTypesRel space operator [Atom.undefinedType] := by
    rw [← undefTypes]
    exact FirstSuccessSourceReplies.source_types space operator
  have hTypesOfOp : StorageTypesRel space ctxOp.erase [Atom.undefinedType] := by
    rwa [hOpErase]
  have hEntry :
      Entry.Rel policy.reentry (cFrame.read policy ctxVal).status
        (cFrame.read policy ctxVal).erase expected .interpret :=
    entryReady.entry_interpret notStopped notAtom notExpr
  have cTupleLocal :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cTupleAfter.control, cTupleAfter.stack) := by
    simpa only [cBefore, cTupleAfter, entryReady.2.1] using
      (RecursiveMachine.Contextual.LocalStep.atomTuple hEntry hReadVal (by simpa only [Multiset.coe_singleton] using hTypesOfOp.occurrences))
  exact ⟨hTypesOf, cTupleLocal, cFallbackLocal, runPrefix, cfgRel⟩

/-- General Empty-Declaration Selection-Failed Square
(`ScopedConfigurationRel.scoped_empty_types_selection_failed_square`):
When `getAtomTypes space operator = []` and `ctxVal` satisfies
`ScopedAtomEntryReady policy (.expression (operator :: arguments)) ctxVal cFrame`:
1. `Completed.InvocationSelectionRel` is earned with `.exhausted [] false`,
2. The worker advances in a 3-step silent block (`.atom` -> `.expression` -> `.functions` ->
   `.returning []`) with `.filter :: wStack`,
3. The contextual machine steps in 1 silent transition (`LocalStep.atomSelectionFailed`) to
   `.returning []` with `.publish expr :: cStack`, and
4. `ScopedConfigurationRel` holds at the resulting returning configurations. -/
theorem ScopedConfigurationRel.scoped_empty_types_selection_failed_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator : Atom) (arguments : List Atom) (expected : Atom)
    (wB : Bindings) (fuel : Nat) (live : List Atom) (scope : List String)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (entryReady : ScopedAtomEntryReady policy (.expression (operator :: arguments)) ctxVal cFrame)
    (notStopped : isEmptyOrError (.expression (operator :: arguments)) = false)
    (notAtom : expected ≠ Atom.atomType)
    (notExpr : expected ≠ Atom.expressionType)
    (emptyTypes : getAtomTypes space operator = [])
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (retained : ∀ name ∈ scope,
      name ∈ RecursiveScope.configurationNames
        ⟨space, .work (.atom (.expression (operator :: arguments)) expected wB (fuel + 2) live),
          wStack, wEmitted⟩) :
    let expr := Atom.expression (operator :: arguments)
    let w0 : Configuration :=
      ⟨space, .work (.atom expr expected wB (fuel + 2) live), wStack, wEmitted⟩
    let w1 : Configuration :=
      ⟨space, .work (.expression expr expected wB (fuel + 1) live), .filter :: wStack, wEmitted⟩
    let w2 : Configuration :=
      ⟨space, .work (.functions expr expected wB fuel [] live), .filter :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning [], .filter :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal expected cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [], .publish expr :: cStack, cEmitted⟩
    ∃ (readiness : Entry.Status) (ctxOp : Entry.Value) (ctxArgs : List Entry.Value),
      cFrame.read policy ctxVal = .expression readiness (ctxOp :: ctxArgs) ∧
      ctxOp.erase = operator ∧
      ctxArgs.map Entry.Value.erase = arguments ∧
      Completed.InvocationSelectionRel space Completed.scopedLookup policy live scope
        expr operator expected cFrame (.exhausted [] false) ∧
      (Checked.machine dispatch scopedTypes).step w0 = some (.silent w1) ∧
      (Checked.machine dispatch scopedTypes).step w1 = some (.silent w2) ∧
      (Checked.machine dispatch scopedTypes).step w2 = some (.silent wAfter) ∧
      (∀ budget, (Checked.machine dispatch scopedTypes).run (3 + budget) w0 =
        (Checked.machine dispatch scopedTypes).run budget wAfter) ∧
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
      RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
        cBefore (some (.silent cAfter)) ∧
      ScopedConfigurationRel wAfter cAfter := by
  intro expr w0 w1 w2 wAfter cBefore cAfter
  obtain ⟨readiness, ctxOp, ctxArgs, hReadVal, hOpErase, hArgsErase⟩ :=
    erase_eq_expression_cons entryReady.2.1
  refine ⟨readiness, ctxOp, ctxArgs, hReadVal, hOpErase, hArgsErase, ?_⟩
  have hCandNil : invocationTypes w0 wB operator expected = [] := by
    unfold invocationTypes getAtomTypesScoped
    rw [show w0.space = space from rfl, emptyTypes]
    rfl
  have hLookup :
      Completed.scopedLookup
        (invocationTypeScope scope live expr expected cFrame.bindings)
        space cFrame.bindings operator Atom.undefinedType [] := by
    rw [← hCandNil]
    exact scopedLookup_of_expression_invocationTypes_related space operator arguments expected
      wB cFrame (fuel + 2) live scope wStack wEmitted actRel retained
  have hSelRel :
      Completed.InvocationSelectionRel space Completed.scopedLookup policy live scope
        expr operator expected cFrame (.exhausted [] false) :=
    ⟨[], hLookup, .nil⟩
  have notVarT : Atom.expressionType ≠ Atom.variableType := by decide
  have notSymT : Atom.expressionType ≠ Atom.symbolType := by decide
  have notGrdT : Atom.expressionType ≠ Atom.groundedType := by decide
  have notUnit : Atom.expression (operator :: arguments) ≠ Atom.unit := by simp [Atom.unit]
  have step0 : (Checked.machine dispatch scopedTypes).step w0 = some (.silent w1) := by
    simp [w0, w1, expr, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, FirstSuccessRecursiveStrategy.taskReady,
      RecursiveMachine.Checked.taskReady, FirstSuccessRecursiveExecution.machine,
      FirstSuccessRecursiveExecution.next, FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, getMetaType, notStopped, notAtom, notExpr,
      notVarT, notSymT, notGrdT, notUnit, Transition.relabel]
  have hInvEq : invocationTypes w1 = invocationTypes w0 := rfl
  have step1 : (Checked.machine dispatch scopedTypes).step w1 = some (.silent w2) := by
    simp [w1, w2, expr, hInvEq, hCandNil, Checked.machine,
      RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter, scopedTypes, Transition.relabel]
  have step2 : (Checked.machine dispatch scopedTypes).step w2 = some (.silent wAfter) := by
    simp [w2, wAfter, expr, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, FirstSuccessRecursiveStrategy.taskReady,
      FirstSuccessRecursiveStrategy.selectionReady, FirstSuccessRecursiveExecution.machine,
      FirstSuccessRecursiveExecution.next, FirstSuccessRecursiveStrategy.enter,
      FirstSuccessRecursiveStrategy.select, Transition.relabel]
  have runPrefix : ∀ budget,
      (Checked.machine dispatch scopedTypes).run (3 + budget) w0 =
        (Checked.machine dispatch scopedTypes).run budget wAfter := by
    intro budget
    rw [show 3 + budget = ((budget + 1) + 1) + 1 by omega,
      (Checked.machine dispatch scopedTypes).run_succ_silent step0,
      (Checked.machine dispatch scopedTypes).run_succ_silent step1,
      (Checked.machine dispatch scopedTypes).run_succ_silent step2]
  have hEntry :
      Entry.Rel policy.reentry (cFrame.read policy ctxVal).status
        (cFrame.read policy ctxVal).erase expected .interpret :=
    entryReady.entry_interpret notStopped notAtom notExpr
  have hSelRead :
      Completed.InvocationSelectionRel space Completed.scopedLookup policy live scope
        (cFrame.read policy ctxVal).erase ctxOp.erase expected cFrame (.exhausted [] false) := by
    rwa [entryReady.2.1, hOpErase]
  have cLocal :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) := by
    simpa only [cBefore, cAfter, entryReady.2.1, Completed.diagnosticResults, List.map_nil] using
      (RecursiveMachine.Contextual.LocalStep.atomSelectionFailed
        (admission := .historical) hEntry hReadVal hSelRead)
  exact ⟨hSelRel, step0, step1, step2, runPrefix, cLocal, .internal cLocal,
    ⟨rfl, .returning .nil, .cons (.filter expr) stackRel, emittedRel⟩⟩

/-- General Scan-to-Leaf Reduction (`invocationScanRel_of_select_and_applicationChecks`):
Reduces `Completed.InvocationScanRel` across an arbitrary candidate list `candidates` to the
per-arrow `Completed.ApplicationChecksRel` leaf obligation:
- Non-function candidates (`readPolicy c = none`) are handled unconditionally by
  `Completed.InvocationScanRel.nonFunction`,
- Failed arrow candidates (`checkIfFunctionTypeIsApplicable = .inl errs`) compose via
  `Completed.InvocationScanRel.rejected` and `noteErrors`, and
- The first succeeding arrow candidate (`checkIfFunctionTypeIsApplicable = .inr (first :: rest)`)
  short-circuits via `Completed.InvocationScanRel.selected` with its earned `afterFrame`. -/
theorem invocationScanRel_of_select_and_applicationChecks
    (space : Space) (wLookup : TypeLookup) (cLookup : TypeLookupRel) (policy : Policy)
    (expression expected : Atom) (wB : Bindings) (before : Completed.Frame)
    (fuel : Nat) (candidates : List Atom)
    (hFailedLeaf : ∀ candidate ∈ candidates, ∀ sig errors,
      FirstSuccessRecursiveStrategy.readPolicy candidate = some sig →
      checkIfFunctionTypeIsApplicable (lookup := wLookup)
        expression candidate expected space wB fuel = .inl errors →
      Completed.ApplicationChecksRel space cLookup policy expression expected sig before [] errors)
    (hSelectedLeaf : ∀ candidate ∈ candidates, ∀ sig first rest,
      FirstSuccessRecursiveStrategy.readPolicy candidate = some sig →
      checkIfFunctionTypeIsApplicable (lookup := wLookup)
        expression candidate expected space wB fuel = .inr (first :: rest) →
      ∃ afterFrame errors,
        ScopedActivationRel first afterFrame ∧
        Completed.ApplicationChecksRel space cLookup policy
          expression expected sig before [afterFrame] errors) :
    match FirstSuccessRecursiveStrategy.select (lookup := wLookup)
        space expression expected wB fuel candidates with
    | .exhausted errors eligible =>
        Completed.InvocationScanRel space cLookup policy
          expression expected before candidates (.exhausted errors eligible)
    | .selected sig alternatives =>
        ∃ first afterFrame,
          alternatives = [first] ∧
          ScopedActivationRel first afterFrame ∧
          Completed.InvocationScanRel space cLookup policy
            expression expected before candidates (.selected sig [afterFrame]) := by
  induction candidates with
  | nil => exact .nil
  | cons candidate remaining ih =>
      have ihSub := ih
        (fun c hc => hFailedLeaf c (List.mem_cons_of_mem _ hc))
        (fun c hc => hSelectedLeaf c (List.mem_cons_of_mem _ hc))
      cases hParsed : FirstSuccessRecursiveStrategy.readPolicy candidate with
      | none =>
          have hNotFn : ¬∃ domains returned, FunctionTypeRel candidate domains returned :=
            (FirstSuccessRecursiveStrategy.readPolicy_none_iff candidate).mp hParsed
          simp only [FirstSuccessRecursiveStrategy.select, hParsed]
          cases hTail : FirstSuccessRecursiveStrategy.select (lookup := wLookup)
              space expression expected wB fuel remaining with
          | exhausted errors eligible =>
              rw [hTail] at ihSub
              exact .nonFunction hNotFn ihSub
          | selected sig alternatives =>
              rw [hTail] at ihSub
              obtain ⟨first, afterFrame, rfl, hAct, hScan⟩ := ihSub
              exact ⟨first, afterFrame, rfl, hAct, .nonFunction hNotFn hScan⟩
      | some sig =>
          have hSigEq : sig.functionType = candidate :=
            FirstSuccessRecursiveStrategy.readPolicy_sound hParsed
          simp only [FirstSuccessRecursiveStrategy.select, hParsed]
          cases hCheck : checkIfFunctionTypeIsApplicable (lookup := wLookup)
              expression candidate expected space wB fuel with
          | inl headErrors =>
              have hHeadApp :
                  Completed.ApplicationChecksRel space cLookup policy
                    expression expected sig before [] headErrors :=
                hFailedLeaf candidate List.mem_cons_self sig headErrors hParsed hCheck
              cases hTail : FirstSuccessRecursiveStrategy.select (lookup := wLookup)
                  space expression expected wB fuel remaining with
              | exhausted tailErrors eligible =>
                  rw [hTail] at ihSub
                  simpa only [FirstSuccessRecursiveStrategy.noteErrors, hSigEq] using
                    Completed.InvocationScanRel.rejected hHeadApp ihSub
              | selected selSig alternatives =>
                  rw [hTail] at ihSub
                  obtain ⟨first, afterFrame, rfl, hAct, hScan⟩ := ihSub
                  refine ⟨first, afterFrame, rfl, hAct, ?_⟩
                  simpa only [FirstSuccessRecursiveStrategy.noteErrors, hSigEq] using
                    Completed.InvocationScanRel.rejected hHeadApp hScan
          | inr alts =>
              have hNonEmpty :=
                FirstSuccessRecursiveStrategy.applicability_success_nonempty hCheck
              cases alts with
              | nil => exact False.elim (hNonEmpty rfl)
              | cons first rest =>
                  obtain ⟨afterFrame, errors, hAct, hHeadApp⟩ :=
                    hSelectedLeaf candidate List.mem_cons_self sig first rest hParsed hCheck
                  refine ⟨first, afterFrame, rfl, hAct, ?_⟩
                  simpa only [hSigEq] using
                    Completed.InvocationScanRel.selected hHeadApp (by simp)

/-- Commuting Cons-Returns Administrative Block (`ScopedConfigurationRel.returnsCons_block`):
Entering the head returned result `(wVal, wB)` / `(cVal, cFrame)` of a non-empty return batch
`.returns original expected fuel ((wVal, wB) :: wRest) live` /
`.boundaryBatch live scope caller (.returned ctxOrig expected) ((cVal, cFrame) :: cRest)`
steps in 1 silent worker transition and 2 contextual transitions
(`LocalStep.boundaryBatchCons` followed by `LocalStep.boundaryReturned`) to
`.returned original wVal expected wB fuel live` / `.returned live scope ctxOrig expected cVal cFrame`
with `.append (.returns original expected fuel wRest live)` /
`.append (.boundaryBatch live scope caller (.returned ctxOrig expected) cRest)` pushed on the stack,
preserving `ScopedConfigurationRel` without any entry-readiness assumption. -/
theorem ScopedConfigurationRel.returnsCons_block
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original expected : Atom) (fuel : Nat) (live : List Atom)
    (scope : List String) (caller : Option Atom) (ctxOrig : Entry.Value)
    (wVal : Atom) (wB : Bindings) (wRest : ResultSet)
    (cVal : Entry.Value) (cFrame : Completed.Frame) (cRest : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (origEq : ctxOrig.erase = original)
    (headRel : ScopedResultRel (wVal, wB) (cVal, cFrame))
    (restRel : List.Forall₂ ScopedResultRel wRest cRest)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.returns original expected fuel ((wVal, wB) :: wRest) live),
        wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.returned original wVal expected wB fuel live),
        .append (.returns original expected fuel wRest live) :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.boundaryBatch live scope caller (.returned ctxOrig expected) ((cVal, cFrame) :: cRest)),
        cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.returned live scope ctxOrig expected cVal cFrame),
        .append (.boundaryBatch live scope caller (.returned ctxOrig expected) cRest) :: cStack,
        cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
      cBefore cAfter ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  rcases headRel with ⟨valEq, actRel⟩
  have cLocal :
      RecursiveMachine.Contextual.LocalSteps space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) :=
    (Relation.ReflTransGen.refl.tail .boundaryBatchCons).tail .boundaryReturned
  have cSteps :
      RecursiveMachine.Contextual.Steps hostDispatch Completed.scopedLookup policy
        cBefore cAfter :=
    (Relation.ReflTransGen.refl.tail (.internal .boundaryBatchCons)).tail
      (.internal .boundaryReturned)
  exact ⟨rfl, cLocal, cSteps,
    ⟨rfl, .work (.returned origEq valEq.symm actRel),
      .cons (.append (.returns origEq restRel)) stackRel, emittedRel⟩⟩

/-- Commuting Stopped-Return Task Square (`ScopedConfigurationRel.returnStopped_step`):
When `.returned` receives an empty or error value (`value ≠ Atom.notReducible` and
`isEmptyOrError value = true`), both machines step in 1 silent transition
(`LocalStep.returnStopped`) directly to `.returning [(value, wB)]` / `.returning [(ctxVal, cFrame)]`
without entering `.atom` and without requiring `ScopedAtomEntryReady`, preserving
`ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.returnStopped_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original value expected : Atom) (wB : Bindings) (fuel : Nat)
    (live : List Atom) (scope : List String)
    (ctxOrig ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (valEq : ctxVal.erase = value)
    (notRefused : value ≠ Atom.notReducible)
    (stopped : isEmptyOrError value = true)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.returned original value expected wB fuel live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning [(value, wB)], wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.returned live scope ctxOrig expected ctxVal cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [(ctxVal, cFrame)], cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, notRefused, stopped, Transition.relabel]
  have cStopped : IsEmptyOrErrorRel ctxVal.erase := by
    rw [valEq, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    exact stopped
  exact ⟨wStep, .returnStopped cStopped,
    .internal (.returnStopped cStopped),
    ⟨rfl, .returning (.cons ⟨valEq.symm, actRel⟩ .nil), stackRel, emittedRel⟩⟩

/-- Readiness-Free Evaluate-Return Task Square (`ScopedConfigurationRel.returnEvaluate_of_erase_step`):
When `.returned` receives a value that is neither `Atom.notReducible` nor empty/error,
both machines step in 1 silent transition (`LocalStep.returnEvaluate`) to `.atom` using only
`valEq : ctxVal.erase = value` and `actRel : ScopedActivationRel wB cFrame` (without requiring
`ScopedAtomEntryReady`), so that both active and held/reuse returned values enter `.atom`
while preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.returnEvaluate_of_erase_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original value expected : Atom) (wB : Bindings) (fuel : Nat)
    (live : List Atom) (scope : List String)
    (ctxOrig ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (valEq : ctxVal.erase = value)
    (notRefused : value ≠ Atom.notReducible)
    (notStopped : isEmptyOrError value = false)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.returned original value expected wB fuel live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.atom value expected wB fuel live), wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.returned live scope ctxOrig expected ctxVal cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal expected cFrame), cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, notRefused, notStopped, Transition.relabel]
  have cNotRefused : ctxVal.erase ≠ Atom.notReducible := by rwa [valEq]
  have cNotStopped : ¬IsEmptyOrErrorRel ctxVal.erase := by
    rw [valEq, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    simp [notStopped]
  exact ⟨wStep, .returnEvaluate cNotRefused cNotStopped,
    .internal (.returnEvaluate cNotRefused cNotStopped),
    ⟨rfl, .work (.atom valEq actRel), stackRel, emittedRel⟩⟩

/-- Commuting Covered-Stable Type-Pass Atom Delivery Square
(`ScopedConfigurationRel.atomTypePass_of_covered_stable_step`):
When `.atom` enters a non-empty/non-error value (`isEmptyOrError value = false`) satisfying
`typePass : expected = Atom.atomType ∨ expected = getMetaType value ∨ getMetaType value = Atom.variableType`
with `headRel : ScopedResultRel (value, wB) (ctxVal, cFrame)`, covered native read
`wB.applyFullCovered value depth = true`, and independent read stability `wB.applyFull value depth = value`,
`ScopedResultRel.applyFull_eq_read_erase_of_covered` and `ScopedResultRel.materialized_readResult_stable`
earn `(cFrame.read policy ctxVal).erase = value` and `ScopedResultRel (value, wB) (cFrame.read policy ctxVal, cFrame)`
without requiring `ScopedAtomEntryReady`. Thus both active values and held/reuse expressions
deliver in 1 silent transition (`LocalStep.delivered` via `Entry.Rel.pass`) while preserving
`ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.atomTypePass_of_covered_stable_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (value expected : Atom) (wB : Bindings) (fuel depth : Nat)
    (wLive cLive : List Atom) (scope : List String)
    (ctxVal : Entry.Value) (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (headRel : ScopedResultRel (value, wB) (ctxVal, cFrame))
    (covered : wB.applyFullCovered value depth = true)
    (stable : wB.applyFull value depth = value)
    (notStopped : isEmptyOrError value = false)
    (typePass : expected = Atom.atomType ∨ expected = getMetaType value ∨
      getMetaType value = Atom.variableType)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.atom value expected wB (fuel + 1) wLive), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .returning [(value, wB)], wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom cLive scope ctxVal expected cFrame), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .returning [(cFrame.read policy ctxVal, cFrame)], cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  intro wBefore wAfter cBefore cAfter
  have hPass :
      (expected = Atom.atomType ∨ expected = getMetaType value) ∨
        getMetaType value = Atom.variableType := by
    rcases typePass with h1 | h2 | h3
    · exact Or.inl (Or.inl h1)
    · exact Or.inl (Or.inr h2)
    · exact Or.inr h3
  have wStep : (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) := by
    simp [wBefore, wAfter, Checked.machine, RecursiveMachine.Checked.guardMachine, Checked.blocked,
      FirstSuccessRecursiveStrategy.taskReady, RecursiveMachine.Checked.taskReady,
      FirstSuccessRecursiveExecution.machine, FirstSuccessRecursiveExecution.next,
      FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, notStopped, hPass, Transition.relabel]
  have readErase : (cFrame.read policy ctxVal).erase = value :=
    (headRel.applyFull_eq_read_erase_of_covered policy depth covered).symm.trans stable
  have cNotStopped : ¬IsEmptyOrErrorRel (cFrame.read policy ctxVal).erase := by
    rw [readErase, Conformance.isEmptyOrErrorRel_iff_isEmptyOrError]
    simp [notStopped]
  have cMeta : MetaTypeRel (cFrame.read policy ctxVal).erase (getMetaType value) := by
    rw [readErase, Conformance.metaTypeRel_iff_getMetaType]
  have entered :
      Entry.Rel policy.reentry (cFrame.read policy ctxVal).status
        (cFrame.read policy ctxVal).erase expected .deliver :=
    .pass cNotStopped cMeta typePass
  have outRel : ScopedResultRel (value, wB) (cFrame.read policy ctxVal, cFrame) :=
    headRel.materialized_readResult_stable policy depth covered stable
  exact ⟨wStep, .delivered entered, .internal (.delivered entered),
    ⟨rfl, .returning (.cons outRel .nil), stackRel, emittedRel⟩⟩

end ScopedRetainedRelation

/-! ## Section 7: Activation-Preserving Cast Configuration Squares (`UniversalScopedPolymorphicApplication`) -/

namespace UniversalScopedPolymorphicApplication

open Mettapedia.Languages.MeTTa.OSLFCore (Atom GroundedValue)
open Mettapedia.Machines.OrderedProtocol.Completion
open Mettapedia.GSLT.Distinction.ProductiveBlocks
open RecursiveTasks
open FirstSuccessRecursiveStrategy
open FirstSuccessRecursiveExecution
open FirstSuccessSourceExecution
open FirstSuccessSourceApplicability
open ScopedPolymorphicCompletion
open Spec.Eval
open Spec.Eval.Completed
open Spec.Type
open Spec.Type.Presentation
open Spec.Type.Presentation.Exact
