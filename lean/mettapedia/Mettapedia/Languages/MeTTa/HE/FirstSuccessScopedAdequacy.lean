/-- Commuting Cons-Calls Task Square (`ScopedConfigurationRel.callsCons_step`):
Entering the head result of `.calls` steps in 1 silent transition on both machines to
`.call` with `.append (.calls ...)` pushed on the stack, preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.callsCons_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (expected : Atom) (fuel : Nat) (live : List Atom) (scope : List String)
    (wHead : ResultPair) (wRest : ResultSet)
    (cHead : Completed.Result) (cRest : List Completed.Result)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (headRel : ScopedResultRel wHead cHead)
    (restRel : List.Forall₂ ScopedResultRel wRest cRest)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.calls expected fuel (wHead :: wRest) live), wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.call wHead.1 expected wHead.2 fuel live),
        .append (.calls expected fuel wRest live) :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.calls live scope expected (cHead :: cRest)), cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.call live scope cHead.1 expected cHead.2),
        .append (.calls live scope expected cRest) :: cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  rcases wHead with ⟨wVal, wB⟩
  rcases cHead with ⟨cVal, cFrame⟩
  rcases headRel with ⟨valEq, actRel⟩
  exact ⟨rfl, .callsCons, .internal .callsCons,
    ⟨rfl, .work (.call valEq.symm actRel), .cons (.append (.calls restRel)) stackRel, emittedRel⟩⟩

/-- Commuting Empty-Returns Task Square (`ScopedConfigurationRel.returnsNil_step`):
Exhausted `.returns` / `.boundaryBatch (.returned ...)` steps in 1 silent transition on
both machines to `.returning []` while preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.returnsNil_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (original expected : Atom) (fuel : Nat) (live : List Atom)
    (scope : List String) (caller : Option Atom) (ctxOrig : Entry.Value)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
