/-- Presentation-match derivation for binding a fresh variable `name` to a ground
symbol type `.symbol actual` under any certified table `table`. -/
theorem appliedTypePresentationMatchRel_fresh_symbol
    (bindings : Bindings) (table : TypeSubst) (name actual : String)
    (certificate : ReadoutCertificate bindings table)
    (fresh : name ∉ specBindingVars bindings) :
    AppliedTypePresentationMatchRel table (.var name) (.symbol actual)
      (table.bind name (.symbol actual)) := by
  have none : table.lookup name = none := certificate.lookup_none_of_outside fresh
  have leftRead : table.apply (.var name) = .var name := by
    simp [TypeSubst.apply, none]
  have rightRead : table.apply (.symbol actual) = .symbol actual := by
    simp [TypeSubst.apply]
  exact .ordinary leftRead rightRead (.bindLeft (by simp [TypeSubst.typeVars]))

/-- Presentation-match derivation for matching a repeated-variable unary arrow
`(-> $left $left)` against a fresh-instance arrow `(-> $right $right)` when `$left`
is forced to `.symbol actual` in `native` and `$right` is fresh for `source`. -/
theorem appliedTypePresentationMatchRel_fresh_arrow
    (native source : Bindings) (table : TypeSubst) (left right actual : String)
    (certificate : ReadoutCertificate source table)
    (related : SourceBindingComparison.semantic.FrameRelated native
      (.selected source table certificate))
    (assigned : native.lookup left = some (.symbol actual))
    (sourceFresh : right ∉ specBindingVars source) :
    AppliedTypePresentationMatchRel table
      (.expression [.symbol "->", .var left, .var left])
      (.expression [.symbol "->", .var right, .var right])
      (table.bind right (.symbol actual)) := by
  have agreement : BindingSourceAgreement native source := related.related
  have forced (valuation : String → Atom) (model : TypeBindingSatisfied valuation source) :
      applyTypeValuation valuation (.var left) = .symbol actual := by
    have nativeModel := (agreement.solutions valuation).mpr model
    obtain ⟨before, after, entries, _⟩ := List.lookup_eq_some_iff.mp assigned
    simpa only [applyTypeValuation] using
      nativeModel.1 left (.symbol actual) (by simp [entries])
  have leftApplied : table.apply (.var left) = .symbol actual :=
    certificate.forced_read (.var left) (.symbol actual) forced
  have rightNone : table.lookup right = none :=
    certificate.lookup_none_of_outside sourceFresh
  have rightApplied : table.apply (.var right) = .var right := by
    simp [TypeSubst.apply, rightNone]
  have leftRead :
      table.apply (.expression [.symbol "->", .var left, .var left]) =
        .expression [.symbol "->", .symbol actual, .symbol actual] := by
    simp [TypeSubst.apply, leftApplied]
  have rightRead :
      table.apply (.expression [.symbol "->", .var right, .var right]) =
        .expression [.symbol "->", .var right, .var right] := by
    simp [TypeSubst.apply, rightApplied]
  have symRead : table.apply (.symbol "->") = .symbol "->" := by
    simp [TypeSubst.apply]
  have step0 :
      AppliedTypePresentationMatchRel table (.symbol "->") (.symbol "->") table :=
    .ordinary symRead symRead (.identical table (.symbol "->"))
  have actRead : table.apply (.symbol actual) = .symbol actual := by
    simp [TypeSubst.apply]
  have step1 :
      AppliedTypePresentationMatchRel table
        (.symbol actual) (.var right) (table.bind right (.symbol actual)) :=
    .ordinary actRead rightApplied
      (.bindRight (fun _ h => Atom.noConfusion h) (by simp [TypeSubst.typeVars]))
  have afterRightApplied :
      (table.bind right (.symbol actual)).apply (.var right) = .symbol actual := by
    simp [TypeSubst.apply, TypeSubst.lookup_bind]
  have actRead2 :
      (table.bind right (.symbol actual)).apply (.symbol actual) = .symbol actual := by
    simp [TypeSubst.apply]
  have step2 :
      AppliedTypePresentationMatchRel (table.bind right (.symbol actual))
        (.symbol actual) (.var right) (table.bind right (.symbol actual)) :=
    .ordinary actRead2 afterRightApplied
      (.identical (table.bind right (.symbol actual)) (.symbol actual))
  exact .ordinary leftRead rightRead
    (.expression (.cons step0 (.cons step1 (.cons step2 (.nil _)))))

/-- Deterministic erased-environment identification (`scopedActivationRel_of_unifyRel`):
By `Entry.Value.UnifyRel.erases` and `AppliedTypePresentationMatchRel.output_eq`,
any `after : Completed.Frame` whose `after.environment` is reached by `Entry.Value.UnifyRel`
from `before.environment` on `Entry.Value.ofAtom expected` and `Entry.Value.ofAtom actualCandidate`
has `Entry.Value.eraseEnvironment after.environment = targetTable`, and therefore
satisfies `ScopedActivationRel nativeOut after` whenever `after.bindings = targetBindings`
and `FrameRelated nativeOut (.selected targetBindings targetTable targetCert)`. -/
theorem scopedActivationRel_of_unifyRel
    (policy : Policy) (before after : Completed.Frame)
    (expected actualCandidate : Atom)
    (nativeOut targetBindings : Bindings) (targetTable : TypeSubst)
    (targetCert : ReadoutCertificate targetBindings targetTable)
    (targetRelated : SourceBindingComparison.semantic.FrameRelated nativeOut
      (.selected targetBindings targetTable targetCert))
    (derived : AppliedTypePresentationMatchRel
      (Entry.Value.eraseEnvironment before.environment)
      expected actualCandidate targetTable)
    (bindEq : after.bindings = targetBindings)
    (unified : Entry.Value.UnifyRel policy.rebuilding before.environment
      (Entry.Value.ofAtom expected) (Entry.Value.ofAtom actualCandidate)
      after.environment) :
    Entry.Value.eraseEnvironment after.environment = targetTable ∧
    ScopedActivationRel nativeOut after := by
  have erasedMatch :
      AppliedTypePresentationMatchRel
        (Entry.Value.eraseEnvironment before.environment)
        expected actualCandidate
        (Entry.Value.eraseEnvironment after.environment) := by
    simpa only [Entry.Value.erase_ofAtom] using unified.erases
  have envEq : Entry.Value.eraseEnvironment after.environment = targetTable :=
    erasedMatch.output_eq derived
  refine ⟨envEq, ?_⟩
  rcases after with ⟨afterBindings, afterEnv, afterCert⟩
  dsimp only at bindEq envEq
  subst bindEq
  unfold ScopedActivationRel Completed.Frame.source
  dsimp only
  cases envEq
  exact targetRelated

/-- Lifting a singleton `lookup` + `policy.matching.Rel` + `AppliedTypePresentationMatchRel`
witness together with a certified `FrameRelated` output into `Completed.CastResultRel`
while preserving `ScopedActivationRel` and `ScopedResultRel`. -/
theorem castResultRel_of_presentation_match
    (policy : Policy) (lookup : TypeLookupRel) (before : Completed.Frame)
    (operator : String) (expected actualCandidate : Atom)
    (nativeOut targetBindings : Bindings) (targetTable : TypeSubst)
    (targetCert : ReadoutCertificate targetBindings targetTable)
    (targetRelated : SourceBindingComparison.semantic.FrameRelated nativeOut
      (.selected targetBindings targetTable targetCert))
    (queried : lookup before.bindings (.symbol operator) expected [actualCandidate])
    (matched : policy.matching.Rel expected actualCandidate before.bindings targetBindings)
    (derived : AppliedTypePresentationMatchRel
      (Entry.Value.eraseEnvironment before.environment)
      expected actualCandidate targetTable) :
    ∃ after : Completed.Frame,
      after.bindings = targetBindings ∧
      ScopedActivationRel nativeOut after ∧
      ScopedResultRel (.symbol operator, nativeOut) (.symbol operator, after) ∧
      Completed.CastResultRel policy lookup before (.symbol operator) expected
        (.symbol operator, targetBindings) (.symbol operator, after) := by
  have envDerived :
      AppliedTypePresentationMatchRel
        (Entry.Value.eraseEnvironment before.environment)
        (Entry.Value.ofAtom expected).erase
        (Entry.Value.ofAtom actualCandidate).erase
        targetTable := by
    simpa only [Entry.Value.erase_ofAtom] using derived
  obtain ⟨afterEnv, unified, hErase⟩ :=
    Entry.Value.UnifyRel.lift (policy := policy.rebuilding) envDerived
  let after : Completed.Frame := ⟨targetBindings, afterEnv, hErase ▸ targetCert⟩
  have hAct : ScopedActivationRel nativeOut after :=
    (scopedActivationRel_of_unifyRel policy before after
      expected actualCandidate nativeOut targetBindings targetTable
      targetCert targetRelated derived rfl unified).2
  have renewed :
      Completed.Frame.CastRenewRel policy lookup (.symbol operator) expected before after :=
    .matched (earlier := []) (later := []) queried rfl (by simp) matched unified
  have castRes :
      Completed.CastResultRel policy lookup before (.symbol operator) expected
        (.symbol operator, targetBindings) (.symbol operator, after) :=
    ⟨by simp [Completed.rawResult, Entry.Value.erase, after],
     by simpa [Entry.Value.erase] using renewed,
     by simp [Entry.Value.erase]⟩
  exact ⟨after, rfl, hAct, ⟨by simp [Entry.Value.erase], hAct⟩, castRes⟩

/-- Policy-Generic Activation-Preserving Fresh-Symbol Cast Configuration Square
(`scoped_fresh_symbol_cast_configuration_square`):
When worker and contextual configurations are aligned under `ScopedConfigurationRel` at
`.atom (.symbol subject) (.var expected)` with `getAtomTypes state.space (.symbol subject) = [.symbol actual]`
and `expected ∉ specBindingVars native`, both machines step in 1 transition (under ANY `policy : Policy`)
to `.returning` with an earned `Completed.Frame` witness `after` that preserves
`ScopedActivationRel`, `ScopedResultRel`, and `ScopedConfigurationRel` across arbitrary retained
`state.stack` / `ctxStack` and `state.emitted` / `ctxEmitted`. -/
theorem scoped_fresh_symbol_cast_configuration_square
    (state : Configuration) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (subject expected actual : String)
    (native : Bindings) (before : Completed.Frame)
    (depth : Nat) (live : List Atom) (scope : List String)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result)
    (pending : state.control = .work (.atom (.symbol subject) (.var expected) native (depth + 3) live))
    (clean : subject ≠ "Empty")
    (notUndefined : actual ≠ "%Undefined%") (notAtom : actual ≠ "Atom")
    (declared : getAtomTypes state.space (.symbol subject) = [.symbol actual])
    (actRel : ScopedActivationRel native before)
    (stackRel : List.Forall₂ ScopedFrameRel state.stack ctxStack)
    (emittedRel : List.Forall₂ ScopedResultRel state.emitted ctxEmitted)
    (fresh : expected ∉ specBindingVars native) :
    let workerOut : ResultSet := [(.symbol subject, native.assign expected (.symbol actual))]
    let wAfter : Configuration := { state with control := .returning workerOut }
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨state.space, .work (.atom live scope (.symbol subject) (.var expected) before),
        ctxStack, ctxEmitted⟩
    ∃ after : Completed.Frame,
      let cAfter : RecursiveTasks.Contextual.Configuration :=
        ⟨state.space, .returning [(.symbol subject, after)], ctxStack, ctxEmitted⟩
      after.bindings = before.bindings.assign expected (.symbol actual) ∧
      ScopedActivationRel (native.assign expected (.symbol actual)) after ∧
      (Checked.machine dispatch scopedTypes).step state = some (.silent wAfter) ∧
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
      RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
        cBefore (some (.silent cAfter)) ∧
      ScopedConfigurationRel wAfter cAfter := by
  intro workerOut wAfter cBefore
  have localSq := UniversalScopedCastAndHeadBoundary.scoped_fresh_symbol_cast_local_square
    state dispatch hostDispatch subject expected actual native before depth live scope
    ctxStack ctxEmitted pending clean notUndefined notAtom declared actRel fresh
  obtain ⟨_, _, _, stepped, _, ⟨nextCertificate, nextRelated, _, _⟩, _⟩ := localSq
  have sourceFresh : expected ∉ specBindingVars before.bindings :=
    fun mem => fresh ((actRel.related.support expected).mpr mem)
  have sourceFreshClass : before.bindings.classValues expected = [] := by
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro val member
    exact sourceFresh (FreshPrivateMerge.class_key_support member)
  have scopedLookupRel :
      Completed.scopedLookup
        (invocationTypeScope scope live (.symbol subject) (.var expected) before.bindings)
        state.space before.bindings (.symbol subject) (.var expected) [.symbol actual] := by
    refine ⟨[.symbol actual], ?_, .cons ?_ (.nil _)⟩
    · rw [← declared]
      exact FirstSuccessSourceReplies.source_types _ _
    · exact ⟨id, Function.injective_id, by simp, by simp [TypeSubst.typeVars]⟩
  have typeMatch :
      TypeMatchRel (.var expected) (.symbol actual) before.bindings
        (before.bindings.assign expected (.symbol actual)) :=
    FirstSuccessSourceApplicability.independent_fresh_symbol_type_match
      expected actual before.bindings notUndefined notAtom sourceFreshClass
  have matchedPolicy :
      policy.matching.Rel (.var expected) (.symbol actual) before.bindings
        (before.bindings.assign expected (.symbol actual)) := by
    cases hMatch : policy.matching with
    | raw => exact typeMatch
    | finite => exact ⟨typeMatch, nextCertificate.satisfiable⟩
  have derived :
      AppliedTypePresentationMatchRel
        (Entry.Value.eraseEnvironment before.environment)
        (.var expected) (.symbol actual)
        ((Entry.Value.eraseEnvironment before.environment).bind expected (.symbol actual)) :=
    appliedTypePresentationMatchRel_fresh_symbol
      before.bindings (Entry.Value.eraseEnvironment before.environment)
      expected actual before.certified sourceFresh
  obtain ⟨after, hBind, hActAfter, hResAfter, castRes⟩ :=
    castResultRel_of_presentation_match policy
      (Completed.scopedLookup
        (invocationTypeScope scope live (.symbol subject) (.var expected) before.bindings) state.space)
      before subject (.var expected) (.symbol actual)
      (native.assign expected (.symbol actual))
      (before.bindings.assign expected (.symbol actual))
      ((Entry.Value.eraseEnvironment before.environment).bind expected (.symbol actual))
      nextCertificate nextRelated scopedLookupRel matchedPolicy derived
  have readSym : before.read policy (.symbol subject) = .symbol subject := by
    cases hRebuild : policy.rebuilding <;>
      simp [Completed.Frame.read, Entry.Value.substitute, hRebuild]
  have entryCast :
      Entry.Rel policy.reentry (before.read policy (.symbol subject)).status
        (before.read policy (.symbol subject)).erase (.var expected) .cast := by
    simp only [readSym, Entry.Value.status, Entry.Value.erase]
    exact Spec.Eval.Entry.Rel.cast (policy := policy.reentry) (status := .active)
      (by simpa [IsEmptyOrErrorRel, IsErrorRel, Atom.empty] using clean)
      (.symbol subject)
      (by
        rintro (hA | hS | hV)
        · cases hA
        · cases hS
        · exact absurd hV (by decide))
      (Or.inl ⟨subject, rfl⟩)
      (fun _ => Or.inr rfl)
  have batchRead :
      TypeCastBatchRel state.space (before.read policy (.symbol subject)).erase
        (.var expected) before.bindings
        [(.symbol subject, before.bindings.assign expected (.symbol actual))]
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live
            (before.read policy (.symbol subject)).erase (.var expected) before.bindings) state.space)
        (matching := policy.matching.Rel) := by
    simpa only [readSym, Entry.Value.erase] using
      (TypeCastBatchRel.success (earlierTypes := []) (laterTypes := [])
        scopedLookupRel rfl (by simp) matchedPolicy)
  have pairedRead :
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope live
              (before.read policy (.symbol subject)).erase (.var expected) before.bindings) state.space)
          before (before.read policy (.symbol subject)) (.var expected))
        [(.symbol subject, before.bindings.assign expected (.symbol actual))]
        [(.symbol subject, after)] := by
    simpa only [readSym, Entry.Value.erase] using List.Forall₂.cons castRes .nil
  have cLocal :
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack)
        (.returning [(.symbol subject, after)], ctxStack) :=
    .cast entryCast batchRead pairedRead
  exact ⟨after, hBind, hActAfter, stepped, cLocal, .internal cLocal,
    ⟨rfl, .returning (.cons hResAfter .nil), stackRel, emittedRel⟩⟩

/-- Support-Related Live-List Generalization of `scoped_fresh_symbol_cast_configuration_square`
(`scoped_fresh_symbol_cast_configuration_square_with_live`):
Allows the worker live list `wLive` (e.g., `remaining ++ types ++ live` after `argsCons_step`)
and the contextual live list `cLive` (e.g., `Completed.argumentScope requests ++ live`) to differ
in list order while stepping both machines in 1 transition to `.returning` with the earned
`after : Completed.Frame` (`ScopedActivationRel (native.assign expected (.symbol actual)) after`). -/
theorem scoped_fresh_symbol_cast_configuration_square_with_live
    (state : Configuration) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (subject expected actual : String)
    (native : Bindings) (before : Completed.Frame)
    (depth : Nat) (wLive cLive : List Atom) (scope : List String)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result)
    (pending : state.control = .work (.atom (.symbol subject) (.var expected) native (depth + 3) wLive))
    (clean : subject ≠ "Empty")
    (notUndefined : actual ≠ "%Undefined%") (notAtom : actual ≠ "Atom")
    (declared : getAtomTypes state.space (.symbol subject) = [.symbol actual])
    (actRel : ScopedActivationRel native before)
    (stackRel : List.Forall₂ ScopedFrameRel state.stack ctxStack)
    (emittedRel : List.Forall₂ ScopedResultRel state.emitted ctxEmitted)
    (fresh : expected ∉ specBindingVars native) :
    let workerOut : ResultSet := [(.symbol subject, native.assign expected (.symbol actual))]
    let wAfter : Configuration := { state with control := .returning workerOut }
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨state.space, .work (.atom cLive scope (.symbol subject) (.var expected) before),
        ctxStack, ctxEmitted⟩
    ∃ after : Completed.Frame,
      let cAfter : RecursiveTasks.Contextual.Configuration :=
        ⟨state.space, .returning [(.symbol subject, after)], ctxStack, ctxEmitted⟩
      after.bindings = before.bindings.assign expected (.symbol actual) ∧
      ScopedActivationRel (native.assign expected (.symbol actual)) after ∧
      (Checked.machine dispatch scopedTypes).step state = some (.silent wAfter) ∧
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
      RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
        cBefore (some (.silent cAfter)) ∧
      ScopedConfigurationRel wAfter cAfter := by
  intro workerOut wAfter cBefore
  have localSq := UniversalScopedCastAndHeadBoundary.scoped_fresh_symbol_cast_local_square
    state dispatch hostDispatch subject expected actual native before depth wLive scope
    ctxStack ctxEmitted pending clean notUndefined notAtom declared actRel fresh
  obtain ⟨_, _, _, stepped, _, ⟨nextCertificate, nextRelated, _, _⟩, _⟩ := localSq
  have sourceFresh : expected ∉ specBindingVars before.bindings :=
    fun mem => fresh ((actRel.related.support expected).mpr mem)
  have sourceFreshClass : before.bindings.classValues expected = [] := by
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro val member
    exact sourceFresh (FreshPrivateMerge.class_key_support member)
  have scopedLookupRel :
      Completed.scopedLookup
        (invocationTypeScope scope cLive (.symbol subject) (.var expected) before.bindings)
        state.space before.bindings (.symbol subject) (.var expected) [.symbol actual] := by
    refine ⟨[.symbol actual], ?_, .cons ?_ (.nil _)⟩
    · rw [← declared]
      exact FirstSuccessSourceReplies.source_types _ _
    · exact ⟨id, Function.injective_id, by simp, by simp [TypeSubst.typeVars]⟩
  have typeMatch :
      TypeMatchRel (.var expected) (.symbol actual) before.bindings
        (before.bindings.assign expected (.symbol actual)) :=
    FirstSuccessSourceApplicability.independent_fresh_symbol_type_match
      expected actual before.bindings notUndefined notAtom sourceFreshClass
  have matchedPolicy :
      policy.matching.Rel (.var expected) (.symbol actual) before.bindings
        (before.bindings.assign expected (.symbol actual)) := by
    cases hMatch : policy.matching with
    | raw => exact typeMatch
    | finite => exact ⟨typeMatch, nextCertificate.satisfiable⟩
  have derived :
      AppliedTypePresentationMatchRel
        (Entry.Value.eraseEnvironment before.environment)
        (.var expected) (.symbol actual)
        ((Entry.Value.eraseEnvironment before.environment).bind expected (.symbol actual)) :=
    appliedTypePresentationMatchRel_fresh_symbol
      before.bindings (Entry.Value.eraseEnvironment before.environment)
      expected actual before.certified sourceFresh
  obtain ⟨after, hBind, hActAfter, hResAfter, castRes⟩ :=
    castResultRel_of_presentation_match policy
      (Completed.scopedLookup
        (invocationTypeScope scope cLive (.symbol subject) (.var expected) before.bindings) state.space)
      before subject (.var expected) (.symbol actual)
      (native.assign expected (.symbol actual))
      (before.bindings.assign expected (.symbol actual))
      ((Entry.Value.eraseEnvironment before.environment).bind expected (.symbol actual))
      nextCertificate nextRelated scopedLookupRel matchedPolicy derived
  have readSym : before.read policy (.symbol subject) = .symbol subject := by
    cases hRebuild : policy.rebuilding <;>
      simp [Completed.Frame.read, Entry.Value.substitute, hRebuild]
  have entryCast :
      Entry.Rel policy.reentry (before.read policy (.symbol subject)).status
        (before.read policy (.symbol subject)).erase (.var expected) .cast := by
    simp only [readSym, Entry.Value.status, Entry.Value.erase]
    exact Spec.Eval.Entry.Rel.cast (policy := policy.reentry) (status := .active)
      (by simpa [IsEmptyOrErrorRel, IsErrorRel, Atom.empty] using clean)
      (.symbol subject)
      (by
        rintro (hA | hS | hV)
        · cases hA
        · cases hS
        · exact absurd hV (by decide))
      (Or.inl ⟨subject, rfl⟩)
      (fun _ => Or.inr rfl)
  have batchRead :
      TypeCastBatchRel state.space (before.read policy (.symbol subject)).erase
        (.var expected) before.bindings
        [(.symbol subject, before.bindings.assign expected (.symbol actual))]
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope cLive
            (before.read policy (.symbol subject)).erase (.var expected) before.bindings) state.space)
        (matching := policy.matching.Rel) := by
    simpa only [readSym, Entry.Value.erase] using
      (TypeCastBatchRel.success (earlierTypes := []) (laterTypes := [])
        scopedLookupRel rfl (by simp) matchedPolicy)
  have pairedRead :
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope cLive
              (before.read policy (.symbol subject)).erase (.var expected) before.bindings) state.space)
          before (before.read policy (.symbol subject)) (.var expected))
        [(.symbol subject, before.bindings.assign expected (.symbol actual))]
        [(.symbol subject, after)] := by
    simpa only [readSym, Entry.Value.erase] using List.Forall₂.cons castRes .nil
  have cLocal :
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack)
        (.returning [(.symbol subject, after)], ctxStack) :=
    .cast entryCast batchRead pairedRead
  exact ⟨after, hBind, hActAfter, stepped, cLocal, .internal cLocal,
    ⟨rfl, .returning (.cons hResAfter .nil), stackRel, emittedRel⟩⟩

/-- Policy-Generic Activation-Preserving Repeated-Arrow Head-Cast Configuration Square
(`scoped_fresh_arrow_head_cast_configuration_square`):
When worker and contextual configurations are aligned under `ScopedConfigurationRel` at
`.atom (.symbol operator) (.expression [.symbol "->", .var left, .var left])` with
`getAtomTypes state.space (.symbol operator) = [.expression [.symbol "->", .var parameter, .var parameter]]`
under `native.assign left (.symbol actual)` / `before` (`before.bindings = source.assign left (.symbol actual)`),
both machines step in 1 transition (under ANY `policy : Policy`) to `.returning` with an earned
`Completed.Frame` witness `after` that preserves `ScopedActivationRel`, `ScopedResultRel`, and
`ScopedConfigurationRel` across arbitrary retained `state.stack` / `ctxStack` and `state.emitted` / `ctxEmitted`. -/
theorem scoped_fresh_arrow_head_cast_configuration_square
    (state : Configuration) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator parameter left actual : String)
    (native source : Bindings) (before : Completed.Frame)
    (depth : Nat) (live : List Atom) (scope : List String)
    (ctxStack : List RecursiveTasks.Contextual.Continuation)
    (ctxEmitted : List Completed.Result)
    (pending : state.control = .work (.atom (.symbol operator)
      (.expression [.symbol "->", .var left, .var left])
      (native.assign left (.symbol actual)) (depth + 8) live))
    (clean : operator ≠ "Empty")
    (declared : getAtomTypes state.space (.symbol operator) =
      [.expression [.symbol "->", .var parameter, .var parameter]])
    (beforeBindings : before.bindings = source.assign left (.symbol actual))
    (actRel : ScopedActivationRel (native.assign left (.symbol actual)) before)
    (stackRel : List.Forall₂ ScopedFrameRel state.stack ctxStack)
    (emittedRel : List.Forall₂ ScopedResultRel state.emitted ctxEmitted)
    (leftFresh : left ∉ native.names)
    (leftFreshSource : left ∉ source.names)
    (retained : ∀ name ∈ scope, name ∈ RecursiveScope.configurationNames state) :
    let expected := Atom.expression [.symbol "->", .var left, .var left]
    let avoid := RecursiveScope.configurationNames state ++
      (native.assign left (.symbol actual)).names ++
      atomVariables (.symbol operator) ++ atomVariables expected
    let right := instanceName avoid [parameter] 0 parameter
    let nativeOut := ((native.assign left (.symbol actual)).addEquality left right).addEquality left right
    let sourceOut := (source.assign left (.symbol actual)).addEquality left right
    let workerOut : ResultSet := [(.symbol operator, nativeOut)]
    let wAfter : Configuration := { state with control := .returning workerOut }
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨state.space, .work (.atom live scope (.symbol operator) expected before),
        ctxStack, ctxEmitted⟩
    ∃ after : Completed.Frame,
      let cAfter : RecursiveTasks.Contextual.Configuration :=
        ⟨state.space, .returning [(.symbol operator, after)], ctxStack, ctxEmitted⟩
      after.bindings = sourceOut ∧
      ScopedActivationRel nativeOut after ∧
      (Checked.machine dispatch scopedTypes).step state = some (.silent wAfter) ∧
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
      RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
        cBefore (some (.silent cAfter)) ∧
      ScopedConfigurationRel wAfter cAfter := by
  intro expected avoid right nativeOut sourceOut workerOut wAfter cBefore
  have localSq := UniversalScopedCastAndHeadBoundary.scoped_fresh_arrow_head_cast_local_square
    state dispatch hostDispatch operator parameter left actual native source before depth live scope
    ctxStack ctxEmitted pending clean declared beforeBindings actRel leftFresh leftFreshSource retained
  obtain ⟨_, scopedLookupRel, _, rightNotInAssignedNames, different,
    _, _, stepped, _, ⟨nextCertificate, nextRelated, _, _⟩, _⟩ := localSq
  have rightFreshAssigned : right ∉ specBindingVars (native.assign left (.symbol actual)) := by
    rwa [← EquationFreshening.bindings_names_eq_specBindingVars]
  have unbound : native.lookup left = none := by
    apply List.lookup_eq_none_iff.mpr
    intro entry stored
    apply bne_iff_ne.mpr
    intro same
    apply leftFresh
    apply List.mem_append_left
    exact List.mem_flatMap.mpr ⟨entry, stored, by simp [same]⟩
  have unboundSource : source.lookup left = none := by
    apply List.lookup_eq_none_iff.mpr
    intro entry stored
    apply bne_iff_ne.mpr
    intro same
    apply leftFreshSource
    apply List.mem_append_left
    exact List.mem_flatMap.mpr ⟨entry, stored, by simp [same]⟩
  have rightFreshSourceAssigned : right ∉ (source.assign left (.symbol actual)).names := by
    rw [EquationFreshening.bindings_names_eq_specBindingVars]
    intro hMem
    have hBefore : right ∈ specBindingVars before.source.bindings := by
      change right ∈ specBindingVars before.bindings
      rwa [beforeBindings]
    exact rightFreshAssigned ((actRel.related.support right).mpr hBefore)
  have rightFreshSource : right ∉ source.names :=
    fun hMem => rightFreshSourceAssigned
      (names_subset_assign_of_lookup_none source left (.symbol actual) unboundSource hMem)
  have leftAssigned : (native.assign left (.symbol actual)).lookup left = some (.symbol actual) :=
    lookup_assign_of_lookup_none native left (.symbol actual) unbound
  have rightFreshBefore : right ∉ specBindingVars before.bindings := by
    rw [beforeBindings, ← EquationFreshening.bindings_names_eq_specBindingVars]
    exact rightFreshSourceAssigned
  have typeMatchSource :
      TypeMatchRel expected (.expression [.symbol "->", .var right, .var right])
        before.bindings sourceOut := by
    rw [beforeBindings]
    exact FirstSuccessSourceExecution.independent_fresh_arrow_type_match
      source left right (.symbol actual) leftFreshSource rightFreshSource different
  have matchedPolicy :
      policy.matching.Rel expected (.expression [.symbol "->", .var right, .var right])
        before.bindings sourceOut := by
    cases hMatch : policy.matching with
    | raw => exact typeMatchSource
    | finite => exact ⟨typeMatchSource, nextCertificate.satisfiable⟩
  have derived :
      AppliedTypePresentationMatchRel
        (Entry.Value.eraseEnvironment before.environment)
        expected (.expression [.symbol "->", .var right, .var right])
        ((Entry.Value.eraseEnvironment before.environment).bind right (.symbol actual)) :=
    appliedTypePresentationMatchRel_fresh_arrow
      (native.assign left (.symbol actual)) before.bindings
      (Entry.Value.eraseEnvironment before.environment)
      left right actual before.certified actRel leftAssigned rightFreshBefore
  obtain ⟨after, hBind, hActAfter, hResAfter, castRes⟩ :=
    castResultRel_of_presentation_match policy
      (Completed.scopedLookup
        (invocationTypeScope scope live (.symbol operator) expected before.bindings) state.space)
      before operator expected (.expression [.symbol "->", .var right, .var right])
      nativeOut sourceOut
      ((Entry.Value.eraseEnvironment before.environment).bind right (.symbol actual))
      nextCertificate nextRelated scopedLookupRel matchedPolicy derived
  have readOp : before.read policy (.symbol operator) = .symbol operator := by
    cases hRebuild : policy.rebuilding <;>
      simp [Completed.Frame.read, Entry.Value.substitute, hRebuild]
  have entryCast :
      Entry.Rel policy.reentry (before.read policy (.symbol operator)).status
        (before.read policy (.symbol operator)).erase expected .cast := by
    simp only [readOp, Entry.Value.status, Entry.Value.erase]
    exact Spec.Eval.Entry.Rel.cast (policy := policy.reentry) (status := .active)
      (by simpa [IsEmptyOrErrorRel, IsErrorRel, Atom.empty] using clean)
      (.symbol operator)
      (by
        rintro (hA | hS | hV)
        · dsimp [expected, Atom.atomType] at hA; cases hA
        · dsimp [expected, Atom.symbolType] at hS; cases hS
        · exact absurd hV (by decide))
      (Or.inl ⟨operator, rfl⟩)
      (fun _ => Or.inr rfl)
  have batchRead :
      TypeCastBatchRel state.space (before.read policy (.symbol operator)).erase
        expected before.bindings [(.symbol operator, sourceOut)]
        (lookup := Completed.scopedLookup
          (invocationTypeScope scope live
            (before.read policy (.symbol operator)).erase expected before.bindings) state.space)
        (matching := policy.matching.Rel) := by
    simpa only [readOp, Entry.Value.erase] using
      (TypeCastBatchRel.success (earlierTypes := []) (laterTypes := [])
        scopedLookupRel rfl (by simp) matchedPolicy)
  have pairedRead :
      List.Forall₂
        (Completed.CastResultRel policy
          (Completed.scopedLookup
            (invocationTypeScope scope live
              (before.read policy (.symbol operator)).erase expected before.bindings) state.space)
          before (before.read policy (.symbol operator)) expected)
        [(.symbol operator, sourceOut)]
        [(.symbol operator, after)] := by
    simpa only [readOp, Entry.Value.erase] using List.Forall₂.cons castRes .nil
  have cLocal :
      RecursiveMachine.Contextual.LocalStep state.space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack)
        (.returning [(.symbol operator, after)], ctxStack) :=
    .cast entryCast batchRead pairedRead
  exact ⟨after, hBind, hActAfter, stepped, cLocal, .internal cLocal,
    ⟨rfl, .returning (.cons hResAfter .nil), stackRel, emittedRel⟩⟩

/-- Policy-Generic Earned Polymorphic Unary-Arrow Function-Entry Configuration Square
(`scoped_polymorphic_function_entry_configuration_square`):
When worker and contextual configurations are aligned at `.atom (.expression [.symbol operator, argument]) Atom.undefinedType`
under `ScopedAtomEntryReady policy (.expression [.symbol operator, argument]) ctxVal before`,
`getAtomTypes space (.symbol operator) = [.expression [.symbol "->", .var parameter, .var parameter]]`,
and `getAtomTypes space argument = [.symbol actual]`:
1. The worker advances in a 3-step silent block (`.atom` -> `.expression` -> `.functions` ->
   `.bindingAlternatives`) with `.filter :: wStack`, selecting the fresh instance variable
   `name := instanceName (RecursiveScope.configurationNames w0 ++ native.names) [parameter] 0 parameter`
   and binding `name ↦ .symbol actual`,
2. An earned `afterFrame : Completed.Frame` is constructed via `Entry.Value.UnifyRel.lift` and
   `scopedActivationRel_of_unifyRel` with `afterFrame.bindings = before.bindings.assign name (.symbol actual)`
   and `ScopedActivationRel (native.assign name (.symbol actual)) afterFrame`,
3. `Completed.InvocationSelectionRel` is earned (with zero pre-assumed selection) for
   `.selected (freshPolymorphicPolicy name) [afterFrame]`,
4. The contextual machine steps in 1 silent transition (`LocalStep.atomFunction`) to `.invocations`
   with `.publish (.expression [.symbol operator, argument]) :: cStack`, and
5. `ScopedConfigurationRel wAfter cAfter` holds across arbitrary retained `wStack` / `cStack`
   and `wEmitted` / `cEmitted`. -/
theorem scoped_polymorphic_function_entry_configuration_square
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator parameter actual : String) (argument : Atom)
    (native : Bindings) (before : Completed.Frame)
    (depth : Nat) (live : List Atom) (scope : List String)
    (ctxVal : Entry.Value)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (entryReady : ScopedAtomEntryReady policy (.expression [.symbol operator, argument]) ctxVal before)
    (cleanOp : operator ≠ "Error")
    (declared : getAtomTypes space (.symbol operator) =
      [.expression [.symbol "->", .var parameter, .var parameter]])
    (argumentTypes : getAtomTypes space argument = [.symbol actual])
    (notUndefined : actual ≠ "%Undefined%") (notAtom : actual ≠ "Atom")
    (actRel : ScopedActivationRel native before)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (retained : ∀ name ∈ scope,
      name ∈ RecursiveScope.configurationNames
        ⟨space, .work (.atom (.expression [.symbol operator, argument])
          Atom.undefinedType native (depth + 5) live), wStack, wEmitted⟩) :
    let call := Atom.expression [.symbol operator, argument]
    let w0 : Configuration :=
      ⟨space, .work (.atom call Atom.undefinedType native (depth + 5) live), wStack, wEmitted⟩
    let name := instanceName (RecursiveScope.configurationNames w0 ++ native.names)
      [parameter] 0 parameter
    let sigAtom := Atom.expression [.symbol "->", .var name, .var name]
    let sigPolicy := freshPolymorphicPolicy name
    let w1 : Configuration :=
      ⟨space, .work (.expression call Atom.undefinedType native (depth + 4) live),
        .filter :: wStack, wEmitted⟩
    let w2 : Configuration :=
      ⟨space, .work (.functions call Atom.undefinedType native (depth + 3) [sigAtom] live),
        .filter :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.bindingAlternatives call sigAtom (.var name) (depth + 3)
        [native.assign name (.symbol actual)] live), .filter :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal Atom.undefinedType before), cStack, cEmitted⟩
    ∃ (readiness : Entry.Status) (ctxOp : Entry.Value) (ctxArgs : List Entry.Value)
      (afterFrame : Completed.Frame),
      before.read policy ctxVal = .expression readiness (ctxOp :: ctxArgs) ∧
      ctxOp.erase = .symbol operator ∧
      ctxArgs.map Entry.Value.erase = [argument] ∧
      afterFrame.bindings = before.bindings.assign name (.symbol actual) ∧
      ScopedActivationRel (native.assign name (.symbol actual)) afterFrame ∧
      let cAfter : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.invocations live scope Atom.undefinedType sigPolicy
          ctxOp ctxArgs [afterFrame]),
          .publish call :: cStack, cEmitted⟩
      Completed.InvocationSelectionRel space Completed.scopedLookup policy live scope
        call (.symbol operator) Atom.undefinedType before (.selected sigPolicy [afterFrame]) ∧
      (Checked.machine dispatch scopedTypes).step w0 = some (.silent w1) ∧
      (Checked.machine dispatch scopedTypes).step w1 = some (.silent w2) ∧
      (Checked.machine dispatch scopedTypes).step w2 = some (.silent wAfter) ∧
      (∀ budget, (Checked.machine dispatch scopedTypes).run (3 + budget) w0 =
        (Checked.machine dispatch scopedTypes).run budget wAfter) ∧
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
      RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
        cBefore (some (.silent cAfter)) ∧
      ScopedConfigurationRel wAfter cAfter := by
  intro call w0 name sigAtom sigPolicy w1 w2 wAfter cBefore
  obtain ⟨readiness, ctxOp, ctxArgs, hReadVal, hOpErase, hArgsErase⟩ :=
    erase_eq_expression_cons entryReady.2.1
  have notStopped : isEmptyOrError call = false := by
    simp [call, isEmptyOrError, isEmptyAtom, Atom.empty, isErrorAtom, cleanOp]
  have notAtomU : Atom.undefinedType ≠ Atom.atomType := by decide
  have notExprU : Atom.undefinedType ≠ Atom.expressionType := by decide
  have notVarT : Atom.expressionType ≠ Atom.variableType := by decide
  have notSymT : Atom.expressionType ≠ Atom.symbolType := by decide
  have notGrdT : Atom.expressionType ≠ Atom.groundedType := by decide
  have notUnit : Atom.expression [.symbol operator, argument] ≠ Atom.unit := by simp [Atom.unit]
  have step0 : (Checked.machine dispatch scopedTypes).step w0 = some (.silent w1) := by
    simp [w0, w1, call, Checked.machine, RecursiveMachine.Checked.guardMachine,
      Checked.blocked, FirstSuccessRecursiveStrategy.taskReady,
      RecursiveMachine.Checked.taskReady, FirstSuccessRecursiveExecution.machine,
      FirstSuccessRecursiveExecution.next, FirstSuccessRecursiveStrategy.enter,
      RecursiveMachine.enter, getMetaType, notStopped, notAtomU, notExprU,
      notVarT, notSymT, notGrdT, notUnit, Transition.relabel]
  have annoPrefix := FirstSuccessSourceExecution.scoped_polymorphic_annotation_prefix
    w1 dispatch operator parameter actual argument native depth live rfl
    declared argumentTypes notUndefined notAtom
  obtain ⟨_, _, _, _, _, step1, step2, run12⟩ := annoPrefix
  have runPrefix : ∀ budget,
      (Checked.machine dispatch scopedTypes).run (3 + budget) w0 =
        (Checked.machine dispatch scopedTypes).run budget wAfter := by
    intro budget
    rw [show 3 + budget = (2 + budget) + 1 by omega,
      (Checked.machine dispatch scopedTypes).run_succ_silent step0]
    exact run12 budget
  have fresh : name ∉ RecursiveScope.configurationNames w0 ++ native.names :=
    instanceName_not_mem _ _ _ _
  have freshNative : name ∉ specBindingVars native := by
    intro mem
    apply fresh (List.mem_append_right _ _)
    rwa [EquationFreshening.bindings_names_eq_specBindingVars]
  have sourceFresh : name ∉ specBindingVars before.bindings :=
    fun mem => freshNative ((actRel.related.support name).mpr mem)
  have sourceFreshClass : before.bindings.classValues name = [] := by
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro val member
    exact sourceFresh (FreshPrivateMerge.class_key_support member)
  obtain ⟨nextCertificate, nextRelated, _, _⟩ :=
    FirstSuccessSourceExecution.scoped_type_assignment_frame
      before.certified actRel name actual freshNative
  have derived :
      AppliedTypePresentationMatchRel
        (Entry.Value.eraseEnvironment before.environment)
        (.var name) (.symbol actual)
        ((Entry.Value.eraseEnvironment before.environment).bind name (.symbol actual)) :=
    appliedTypePresentationMatchRel_fresh_symbol
      before.bindings (Entry.Value.eraseEnvironment before.environment)
      name actual before.certified sourceFresh
  have envDerived :
      AppliedTypePresentationMatchRel
        (Entry.Value.eraseEnvironment before.environment)
        (Entry.Value.ofAtom (.var name)).erase
        (Entry.Value.ofAtom (.symbol actual)).erase
        ((Entry.Value.eraseEnvironment before.environment).bind name (.symbol actual)) := by
    simpa only [Entry.Value.erase_ofAtom] using derived
  obtain ⟨afterEnv, unified, hErase⟩ :=
    Entry.Value.UnifyRel.lift (policy := policy.rebuilding) envDerived
  let afterFrame : Completed.Frame :=
    ⟨before.bindings.assign name (.symbol actual), afterEnv, hErase ▸ nextCertificate⟩
  have hActAfter : ScopedActivationRel (native.assign name (.symbol actual)) afterFrame :=
    (scopedActivationRel_of_unifyRel policy before afterFrame
      (.var name) (.symbol actual)
      (native.assign name (.symbol actual))
      (before.bindings.assign name (.symbol actual))
      ((Entry.Value.eraseEnvironment before.environment).bind name (.symbol actual))
      nextCertificate nextRelated derived rfl unified).2
  let cLookup := Completed.scopedLookup
    (invocationTypeScope scope live call Atom.undefinedType before.bindings) space
  have hQueriedOp :
      invocationTypes w0 native (.symbol operator) Atom.undefinedType = [sigAtom] := by
    unfold invocationTypes getAtomTypesScoped
    rw [show w0.space = space from rfl, declared]
    simp [Atom.undefinedType, instantiateTypeSignatures,
      instantiateTypeSignature, atomVariables, atomListVariables, renameAtom, renameAtomList,
      List.eraseDups_cons, sigAtom, name]
  have hOpLookup : cLookup before.bindings (.symbol operator) Atom.undefinedType [sigAtom] := by
    rw [← hQueriedOp]
    exact scopedLookup_of_expression_invocationTypes_related space (.symbol operator)
      [argument] Atom.undefinedType native before (depth + 5) live scope wStack wEmitted
      actRel retained
  have hArgLookup : cLookup before.bindings argument (.var name) [.symbol actual] := by
    refine ⟨[.symbol actual], ?_, .cons ?_ (.nil _)⟩
    · rw [← argumentTypes]
      exact FirstSuccessSourceReplies.source_types space argument
    · exact ⟨id, Function.injective_id, by simp, by simp [TypeSubst.typeVars]⟩
  have typeMatch :
      TypeMatchRel (.var name) (.symbol actual) before.bindings
        (before.bindings.assign name (.symbol actual)) :=
    FirstSuccessSourceApplicability.independent_fresh_symbol_type_match
      name actual before.bindings notUndefined notAtom sourceFreshClass
  have matchedPolicy :
      policy.matching.Rel (.var name) (.symbol actual) before.bindings afterFrame.bindings := by
    cases hMatch : policy.matching with
    | raw => exact typeMatch
    | finite => exact ⟨typeMatch, nextCertificate.satisfiable⟩
  have argRenew :
      Completed.Frame.TypeRenewRel policy (.var name) (.symbol actual) before afterFrame :=
    .unified matchedPolicy unified
  have argCheck :
      Completed.ArgumentChecksRel space cLookup policy call argument (.var name) 1
        [before] [afterFrame] [] := by
    simpa [Completed.checkedFrames, Completed.checkedFailures] using
      (Completed.ArgumentChecksRel.cons hArgLookup (.cons (.accepted argRenew) .nil) .nil)
  have appArgs :
      Completed.ApplicabilityArgumentsRel space cLookup policy call 1
        [argument] sigPolicy.argumentTypes [before] [afterFrame] [] := by
    simpa [sigPolicy, freshPolymorphicPolicy] using
      (Completed.ApplicabilityArgumentsRel.cons argCheck .nil)
  have retCheck :
      Completed.TypeCheckRel policy Atom.undefinedType afterFrame
        sigPolicy.returnType (.inr afterFrame) :=
    Completed.TypeCheckRel.accepted
      (.unchanged (afterFrame.preserved_type_match policy
        (.undefinedLeft sigPolicy.returnType afterFrame.bindings)))
  have appChecks :
      Completed.ApplicationChecksRel space cLookup policy call Atom.undefinedType
        sigPolicy before [afterFrame] [] := by
    simpa [Completed.checkedFrames, Completed.checkedFailures] using
      (Completed.ApplicationChecksRel.checked rfl appArgs (.cons retCheck .nil))
  have scanRel :
      Completed.InvocationScanRel space cLookup policy call Atom.undefinedType
        before [sigAtom] (.selected sigPolicy [afterFrame]) :=
    Completed.InvocationScanRel.selected (signature := sigPolicy) appChecks (by simp)
  have hSelRel :
      Completed.InvocationSelectionRel space Completed.scopedLookup policy live scope
        call (.symbol operator) Atom.undefinedType before (.selected sigPolicy [afterFrame]) :=
    ⟨[sigAtom], hOpLookup, scanRel⟩
  refine ⟨readiness, ctxOp, ctxArgs, afterFrame,
    hReadVal, hOpErase, hArgsErase, rfl, hActAfter, ?_⟩
  intro cAfter
  have hEntry :
      Entry.Rel policy.reentry (before.read policy ctxVal).status
        (before.read policy ctxVal).erase Atom.undefinedType .interpret :=
    entryReady.entry_interpret notStopped notAtomU notExprU
  have hSelRead :
      Completed.InvocationSelectionRel space Completed.scopedLookup policy live scope
        (before.read policy ctxVal).erase ctxOp.erase Atom.undefinedType before
        (.selected sigPolicy [afterFrame]) := by
    rwa [entryReady.2.1, hOpErase]
  have cLocal :
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) := by
    simpa only [cBefore, cAfter, entryReady.2.1] using
      (RecursiveMachine.Contextual.LocalStep.atomFunction hEntry hReadVal hSelRead)
  have hRetType : Completed.invocationReturnType sigPolicy = .var name := by
    simp [Completed.invocationReturnType, sigPolicy, freshPolymorphicPolicy, Atom.expressionType]
  have hInvTask :
      ScopedTaskRel
        (.bindingAlternatives call sigAtom (.var name) (depth + 3)
          [native.assign name (.symbol actual)] live)
        (.invocations live scope Atom.undefinedType sigPolicy ctxOp ctxArgs [afterFrame]) :=
    .bindingAlternatives hOpErase hArgsErase rfl hRetType (.cons hActAfter .nil)
  exact ⟨hSelRel, step0, step1, step2, runPrefix, cLocal, .internal cLocal,
    ⟨rfl, .work hInvTask, .cons (.filter call) stackRel, emittedRel⟩⟩

/-- Earned `Completed.Frame` for `callerIncomingOpen` with `ScopedActivationRel`. -/
theorem callerIncomingOpen_completedFrame_exists :
    ∃ before : Completed.Frame,
      before.bindings = callerIncomingOpen ∧ ScopedActivationRel callerIncomingOpen before := by
  let beforeTable := QueryBindingProjection.nativeReadoutPresentation callerIncomingOpen
  let beforeEnv : Entry.Value.Environment :=
    beforeTable.map fun (k, v) => (k, Entry.Value.ofAtom v)
  have hEnvEq :
      Entry.Value.eraseEnvironment beforeEnv = beforeTable := by
    dsimp only [beforeEnv]
    generalize beforeTable = tbl
    induction tbl with
    | nil => rfl
    | cons row rest ih =>
        rcases row with ⟨k, v⟩
        simpa only [List.map_cons, Entry.Value.eraseEnvironment, Entry.Value.erase_ofAtom] using
          congrArg (List.cons (k, v)) ih
  refine ⟨⟨callerIncomingOpen, beforeEnv, hEnvEq ▸ callerIncomingOpen_certificate⟩, rfl, ?_⟩
  simpa [ScopedActivationRel, Completed.Frame.source, beforeTable, hEnvEq] using
    callerIncomingOpen_frameRelated

/-- Named-instance corollary of `scoped_polymorphic_function_entry_configuration_square`
that substitutes `name` once symbolically before concrete instantiation, avoiding
re-matching `instanceName` across concrete configurations. -/
theorem scoped_polymorphic_function_entry_configuration_square_named
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (operator parameter actual name : String) (argument : Atom)
    (native : Bindings) (before : Completed.Frame)
    (depth : Nat) (live : List Atom) (scope : List String)
    (ctxVal : Entry.Value)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (entryReady : ScopedAtomEntryReady policy (.expression [.symbol operator, argument]) ctxVal before)
    (cleanOp : operator ≠ "Error")
    (declared : getAtomTypes space (.symbol operator) =
      [.expression [.symbol "->", .var parameter, .var parameter]])
    (argumentTypes : getAtomTypes space argument = [.symbol actual])
    (notUndefined : actual ≠ "%Undefined%") (notAtom : actual ≠ "Atom")
    (actRel : ScopedActivationRel native before)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted)
    (retained : ∀ v ∈ scope,
      v ∈ RecursiveScope.configurationNames
        ⟨space, .work (.atom (.expression [.symbol operator, argument])
          Atom.undefinedType native (depth + 5) live), wStack, wEmitted⟩)
    (hName :
      instanceName
        (RecursiveScope.configurationNames
          ⟨space, .work (.atom (.expression [.symbol operator, argument])
            Atom.undefinedType native (depth + 5) live), wStack, wEmitted⟩ ++ native.names)
        [parameter] 0 parameter = name) :
    let call := Atom.expression [.symbol operator, argument]
    let w0 : Configuration :=
      ⟨space, .work (.atom call Atom.undefinedType native (depth + 5) live), wStack, wEmitted⟩
    let sigAtom := Atom.expression [.symbol "->", .var name, .var name]
    let sigPolicy := freshPolymorphicPolicy name
    let w1 : Configuration :=
      ⟨space, .work (.expression call Atom.undefinedType native (depth + 4) live),
        .filter :: wStack, wEmitted⟩
    let w2 : Configuration :=
      ⟨space, .work (.functions call Atom.undefinedType native (depth + 3) [sigAtom] live),
        .filter :: wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.bindingAlternatives call sigAtom (.var name) (depth + 3)
        [native.assign name (.symbol actual)] live), .filter :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom live scope ctxVal Atom.undefinedType before), cStack, cEmitted⟩
    ∃ (readiness : Entry.Status) (ctxOp : Entry.Value) (ctxArgs : List Entry.Value)
      (afterFrame : Completed.Frame),
      before.read policy ctxVal = .expression readiness (ctxOp :: ctxArgs) ∧
      ctxOp.erase = .symbol operator ∧
      ctxArgs.map Entry.Value.erase = [argument] ∧
      afterFrame.bindings = before.bindings.assign name (.symbol actual) ∧
      ScopedActivationRel (native.assign name (.symbol actual)) afterFrame ∧
      let cAfter : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.invocations live scope Atom.undefinedType sigPolicy
          ctxOp ctxArgs [afterFrame]),
          .publish call :: cStack, cEmitted⟩
      Completed.InvocationSelectionRel space Completed.scopedLookup policy live scope
        call (.symbol operator) Atom.undefinedType before (.selected sigPolicy [afterFrame]) ∧
      (Checked.machine dispatch scopedTypes).step w0 = some (.silent w1) ∧
      (Checked.machine dispatch scopedTypes).step w1 = some (.silent w2) ∧
      (Checked.machine dispatch scopedTypes).step w2 = some (.silent wAfter) ∧
      (∀ budget, (Checked.machine dispatch scopedTypes).run (3 + budget) w0 =
        (Checked.machine dispatch scopedTypes).run budget wAfter) ∧
      RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
        (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
      RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
        cBefore (some (.silent cAfter)) ∧
      ScopedConfigurationRel wAfter cAfter := by
  subst hName
  exact scoped_polymorphic_function_entry_configuration_square
    space dispatch hostDispatch policy operator parameter actual argument
    native before depth live scope ctxVal wStack cStack wEmitted cEmitted
    entryReady cleanOp declared argumentTypes notUndefined notAtom
    actRel stackRel emittedRel retained

/-- Concrete Executed Retained Caller-Alias & Reentry Discriminator Control
(`controlF_polymorphic_function_entry_with_caller_alias`):
In the concrete space `(: ident (-> $t $t))` with incoming caller binding `$t ↦ Number`
and open caller alias `"caller" = "x"` (`callerIncomingOpen`),
retained stack frame `.functionTerminal (some (caller $t#0))`, and already-emitted occurrence
`($t#1, callerIncomingOpen)`:
1. The checked scoped worker advances in 3 silent steps from `.atom (ident true)` to
   `.bindingAlternatives (ident true) (-> $t#2 $t#2) $t#2` with `$t#2 ↦ Bool` while
   preserving `$t ↦ Number`, `"caller" = "x"`, the caller stack, and the emitted prefix,
2. An earned `before : Completed.Frame` and `afterFrame : Completed.Frame` witness
   `Completed.InvocationSelectionRel`, `LocalStep.atomFunction`, and `ScopedConfigurationRel`
   between the worker checkpoint and the contextual `.invocations` configuration, and
3. When the same expression is marked `.held` under `{ Policy.unmarked with reentry := .reuse }`,
   `ScopedAtomEntryReady` is refuted and the contextual machine takes `LocalStep.delivered`
   without interpreting the call. -/
theorem controlF_polymorphic_function_entry_with_caller_alias :
    let space := Space.ofList
      [.expression [.symbol ":", .symbol "ident",
        .expression [.symbol "->", .var "t", .var "t"]]]
    let incoming := callerIncomingOpen
    let argument := Atom.grounded (.bool true)
    let call := Atom.expression [.symbol "ident", argument]
    let live : List Atom := [.var "held", .var "x"]
    let callerOpt : Option Atom := some (.expression [.symbol "caller", .var "t#0"])
    let wStack : List RecursiveTasks.Frame := [.functionTerminal callerOpt]
    let wEmitted : ResultSet := [(.var "t#1", incoming)]
    let wLoaded : Configuration :=
      ⟨space, .work (.atom call Atom.undefinedType incoming 12 live), wStack, wEmitted⟩
    let sigAtom := Atom.expression [.symbol "->", .var "t#2", .var "t#2"]
    let sigPolicy := freshPolymorphicPolicy "t#2"
    let wReached : Configuration :=
      ⟨space, .work (.bindingAlternatives call sigAtom (.var "t#2") 10
        [incoming.assign "t#2" (.symbol "Bool")] live), .filter :: wStack, wEmitted⟩
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 3 wLoaded =
      ([], .exhausted wReached) ∧
    (incoming.assign "t#2" (.symbol "Bool")).lookup "t" = some (.symbol "Number") ∧
    (incoming.assign "t#2" (.symbol "Bool")).lookup "t#2" = some (.symbol "Bool") ∧
    ("caller", "x") ∈ (incoming.assign "t#2" (.symbol "Bool")).equalities ∧
    ∃ (before afterFrame : Completed.Frame),
      before.bindings = incoming ∧
      afterFrame.bindings = incoming.assign "t#2" (.symbol "Bool") ∧
      ScopedActivationRel incoming before ∧
      ScopedActivationRel (incoming.assign "t#2" (.symbol "Bool")) afterFrame ∧
      let cStack : List RecursiveTasks.Contextual.Continuation :=
        [.boundaryBatch live ["caller", "x", "t"] callerOpt .functionDone]
      let cEmitted : List Completed.Result := [(.var "t#1", before)]
      let cLoaded : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.atom live ["caller", "x", "t"] (Entry.Value.ofAtom call) Atom.undefinedType before),
          cStack, cEmitted⟩
      let cReached : RecursiveTasks.Contextual.Configuration :=
        ⟨space, .work (.invocations live ["caller", "x", "t"] Atom.undefinedType sigPolicy
          (.symbol "ident") [.grounded (.bool true)] [afterFrame]),
          .publish call :: cStack, cEmitted⟩
      Completed.InvocationSelectionRel space Completed.scopedLookup .unmarked live ["caller", "x", "t"]
        call (.symbol "ident") Atom.undefinedType before (.selected sigPolicy [afterFrame]) ∧
      RecursiveMachine.Contextual.LocalStep space noHost
        Completed.scopedLookup .unmarked
        (cLoaded.control, cLoaded.stack) (cReached.control, cReached.stack) ∧
      ScopedConfigurationRel wReached cReached ∧
      (let heldVal : Entry.Value := .expression .held [.symbol "ident", .grounded (.bool true)]
       let reusePolicy : Policy := { Policy.unmarked with reentry := .reuse }
       ¬ScopedAtomEntryReady reusePolicy call heldVal before ∧
       RecursiveMachine.Contextual.LocalStep space noHost
         Completed.scopedLookup reusePolicy
         (.work (.atom live ["caller", "x", "t"] heldVal Atom.undefinedType before), cStack)
         (.returning [(before.read reusePolicy heldVal, before)], cStack)) := by
  intro space incoming argument call live callerOpt wStack wEmitted wLoaded sigAtom sigPolicy wReached
  obtain ⟨before, hBeforeBind, actBefore⟩ := callerIncomingOpen_completedFrame_exists
  let cStack : List RecursiveTasks.Contextual.Continuation :=
    [.boundaryBatch live ["caller", "x", "t"] callerOpt .functionDone]
  let cEmitted : List Completed.Result := [(.var "t#1", before)]
  have stackRel : List.Forall₂ ScopedFrameRel wStack cStack :=
    .cons .functionTerminal .nil
  have hEmittedVal : (Atom.var "t#1" : Atom) = (Entry.Value.var "t#1").erase := by
    simp only [Entry.Value.erase]
  have emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted :=
    .cons ⟨hEmittedVal, actBefore⟩ .nil
  have closedCall : ∀ name, ¬Spec.Match.Merge.AtomOccurs (Entry.Value.ofAtom call).erase name := by
    intro name hOcc
    rw [Entry.Value.erase_ofAtom, ← Spec.Match.Merge.mem_vars_iff_atomOccurs] at hOcc
    cases hOcc
  have hStatusCall : (Entry.Value.ofAtom call).status = .active := by
    simp only [call, Entry.Value.ofAtom, Entry.Value.status]
  have entryReady : ScopedAtomEntryReady .unmarked call (Entry.Value.ofAtom call) before :=
    ScopedAtomEntryReady.of_variable_free_active .unmarked call (Entry.Value.ofAtom call)
      before (Entry.Value.erase_ofAtom call) hStatusCall closedCall
  have retained : ∀ name ∈ (["caller", "x", "t"] : List String),
      name ∈ RecursiveScope.configurationNames wLoaded := by
    intro name hMem
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hMem
    rcases hMem with rfl | rfl | rfl <;> decide
  have hNameEq :
      instanceName (RecursiveScope.configurationNames wLoaded ++ incoming.names) ["t"] 0 "t" = "t#2" := by
    decide +kernel
  have sq := scoped_polymorphic_function_entry_configuration_square_named
    space HE.GroundedDispatch.none noHost .unmarked
    "ident" "t" "Bool" "t#2" argument incoming before 7 live ["caller", "x", "t"]
    (Entry.Value.ofAtom call) wStack cStack wEmitted cEmitted
    entryReady (by decide) rfl rfl (by decide) (by decide)
    actBefore stackRel emittedRel retained hNameEq
  obtain ⟨readiness, ctxOp, ctxArgs, afterFrame,
      hReadVal, hOpErase, hArgsErase, hAfterBind, hActAfter,
      hSelRel, step0, step1, step2, runPrefix, cLocal, _, cfgRel⟩ := sq
  have hReadCall : before.read .unmarked (Entry.Value.ofAtom call) =
      .expression .active [.symbol "ident", .grounded (.bool true)] := by
    rw [before.read_variable_free .unmarked (Entry.Value.ofAtom call) closedCall]
    simp only [call, argument, Entry.Value.ofAtom, List.map]
  have shaped := hReadCall.symm.trans hReadVal
  have children := (Entry.Value.expression.inj shaped).2
  have hHead : ctxOp = .symbol "ident" := (List.cons.inj children).1.symm
  have hArguments : ctxArgs = [.grounded (.bool true)] := (List.cons.inj children).2.symm
  simp only [hHead, hArguments] at cLocal cfgRel
  rw [hBeforeBind] at hAfterBind
  have hRun3 :
      (Checked.machine HE.GroundedDispatch.none scopedTypes).run 3 wLoaded =
        ([], .exhausted wReached) :=
    runPrefix 0
  let heldVal : Entry.Value := .expression .held [.symbol "ident", .grounded (.bool true)]
  let reusePolicy : Policy := { Policy.unmarked with reentry := .reuse }
  have closedHeld : ∀ name, ¬Spec.Match.Merge.AtomOccurs heldVal.erase name := by
    have heldRaw : heldVal.erase = call := by
