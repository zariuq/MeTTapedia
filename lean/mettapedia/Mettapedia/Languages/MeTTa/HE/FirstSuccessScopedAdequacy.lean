/-- Resumption of paused checked scoped runs for `AtomDerivation`. -/
theorem AtomDerivation.scoped_resume_completed {space : Space} {comparison : SourceBindingComparison}
    {live : List Atom} {value expected : Atom} {incoming : Bindings} {fuel : Nat} {results : ResultSet}
    (derivation : AtomDerivation (comparison := comparison) space live value expected incoming fuel results)
    (covered : derivation.Covered) (closed : ClosedTypeAnnotations space) (earned : ResultSet)
    (first : Nat) (before : ResultSet) (saved : Configuration)
    (paused : (Checked.machine HE.GroundedDispatch.none scopedTypes).run first
      ⟨space, .work (.atom value expected incoming fuel live), [], earned⟩ = (before, .exhausted saved)) :
    ∃ budget after,
      (Checked.machine HE.GroundedDispatch.none scopedTypes).run budget saved =
        (after, .finished ⟨space, .returning [], [], earned ++ results⟩) ∧
      before ++ after = results :=
  scoped_completes_saved (AtomDerivation.scoped_realizes derivation covered closed)
    earned first before saved paused

/-- Shared first-order cursor (`Checked.Scheduler.visit`) completion for `AtomDerivation`
under closed type annotations, retaining `earned` publications and exact endpoints. -/
theorem AtomDerivation.scoped_visit_completed {space : Space} {comparison : SourceBindingComparison}
    {live : List Atom} {value expected : Atom} {incoming : Bindings} {fuel : Nat} {results : ResultSet}
    (derivation : AtomDerivation (comparison := comparison) space live value expected incoming fuel results)
    (covered : derivation.Covered) (closed : ClosedTypeAnnotations space)
    (price : Configuration → Nat) (earned : ResultSet) :
    let start : Configuration := ⟨space, .work (.atom value expected incoming fuel live), [], earned⟩
    ∃ budget, ∀ later,
      Mettapedia.Machines.ProductiveCoreAdapters.EventCursor.read
        (Checked.machine HE.GroundedDispatch.none scopedTypes)
        (Checked.Scheduler.visit HE.GroundedDispatch.none scopedTypes price (budget + later) start).2 =
        (results, .finished ⟨space, .returning [], [], earned ++ results⟩) ∧
      (Checked.Scheduler.visit HE.GroundedDispatch.none scopedTypes price (budget + later) start).1 =
        (Checked.machine HE.GroundedDispatch.none scopedTypes).spent price (budget + later) start := by
  intro start
  obtain ⟨budget, complete⟩ := AtomDerivation.scoped_completed derivation covered closed earned
  refine ⟨budget, fun later => ⟨?_, Checked.Scheduler.visit_account _ _ _ _ _⟩⟩
  rw [Checked.Scheduler.visit_read]
  exact complete later

/-- Shared first-order cursor (`Checked.Scheduler.visit`) endpoint uniqueness for `AtomDerivation`
under closed type annotations. -/
theorem AtomDerivation.scoped_visit_completed_unique {space : Space} {comparison : SourceBindingComparison}
    {live : List Atom} {value expected : Atom} {incoming : Bindings} {fuel : Nat} {results : ResultSet}
    (derivation : AtomDerivation (comparison := comparison) space live value expected incoming fuel results)
    (covered : derivation.Covered) (closed : ClosedTypeAnnotations space)
    (price : Configuration → Nat) (earned actual : ResultSet) (budget : Nat) (finished : Configuration)
    (visited :
      Mettapedia.Machines.ProductiveCoreAdapters.EventCursor.read
        (Checked.machine HE.GroundedDispatch.none scopedTypes)
        (Checked.Scheduler.visit HE.GroundedDispatch.none scopedTypes price budget
          ⟨space, .work (.atom value expected incoming fuel live), [], earned⟩).2 =
        (actual, .finished finished)) :
    actual = results ∧ finished = ⟨space, .returning [], [], earned ++ results⟩ := by
  rw [Checked.Scheduler.visit_read] at visited
  exact AtomDerivation.scoped_completed_unique derivation covered closed earned actual budget finished visited

/-- Shared first-order cursor (`Checked.Scheduler.visit` / `visit_split`) resumption for
paused `AtomDerivation` runs under closed type annotations, retaining `earned` publications
and exact endpoints. -/
theorem AtomDerivation.scoped_visit_resume_completed {space : Space} {comparison : SourceBindingComparison}
    {live : List Atom} {value expected : Atom} {incoming : Bindings} {fuel : Nat} {results : ResultSet}
    (derivation : AtomDerivation (comparison := comparison) space live value expected incoming fuel results)
    (covered : derivation.Covered) (closed : ClosedTypeAnnotations space)
    (price : Configuration → Nat) (earned : ResultSet)
    (first : Nat) (before : ResultSet) (saved : Configuration)
    (paused :
      Mettapedia.Machines.ProductiveCoreAdapters.EventCursor.read
        (Checked.machine HE.GroundedDispatch.none scopedTypes)
        (Checked.Scheduler.visit HE.GroundedDispatch.none scopedTypes price first
          ⟨space, .work (.atom value expected incoming fuel live), [], earned⟩).2 =
        (before, .exhausted saved)) :
    let m := Checked.machine HE.GroundedDispatch.none scopedTypes
    let start : Configuration := ⟨space, .work (.atom value expected incoming fuel live), [], earned⟩
    ∃ budget after,
      Mettapedia.Machines.ProductiveCoreAdapters.EventCursor.read m
        (Checked.Scheduler.visit HE.GroundedDispatch.none scopedTypes price budget saved).2 =
        (after, .finished ⟨space, .returning [], [], earned ++ results⟩) ∧
      Mettapedia.Machines.ProductiveCoreAdapters.EventCursor.read m
        (Mettapedia.Machines.Cursor.resume
          (Mettapedia.Machines.ProductiveCoreAdapters.EventCursor.provider m)
          Mettapedia.Machines.ProductiveCoreAdapters.EventCursor.client
          (Mettapedia.Machines.ProductiveCoreAdapters.EventCursor.charge m price)
          budget
          (Checked.Scheduler.visit HE.GroundedDispatch.none scopedTypes price first start)).2 =
        (results, .finished ⟨space, .returning [], [], earned ++ results⟩) ∧
      before ++ after = results := by
  intro m start
  have pausedRun : m.run first start = (before, .exhausted saved) := by
    rwa [Checked.Scheduler.visit_read] at paused
  obtain ⟨budget, after, savedRun, concatEq⟩ :=
    AtomDerivation.scoped_resume_completed derivation covered closed earned first before saved pausedRun
  refine ⟨budget, after, ?_, ?_, concatEq⟩
  · rw [Checked.Scheduler.visit_read]
    exact savedRun
  · rw [← Checked.Scheduler.visit_split, Checked.Scheduler.visit_read]
    have splitRun := m.established_and_pending first budget start saved before pausedRun
    rw [splitRun, savedRun]
    simp [concatEq]

/-- **Block 1 Certified Semantic Completion Theorem**:
For any `.semantic` `AtomDerivation` on a space with closed type annotations and a
certified incoming frame, `Checked.machine HE.GroundedDispatch.none scopedTypes`
completes with `results` AND every emitted result `(atom, nativeBindings)` carries an
earned `ReadoutCertificate`, an `EvalAtomRawRel` source derivation, and public-scope
`BindingTheoryEquivAt` agreement. -/
theorem AtomDerivation.scoped_semantic_completion_and_source {space : Space} {live : List Atom}
    {value expected : Atom} {incoming sourceIncoming : Bindings} {incomingTable : TypeSubst}
    (incomingCert : ReadoutCertificate sourceIncoming incomingTable)
    (incomingRelated : SourceBindingComparison.semantic.FrameRelated incoming
      (.selected sourceIncoming incomingTable incomingCert))
    {fuel : Nat} {results : ResultSet}
    (derivation : AtomDerivation (comparison := .semantic) space live value expected incoming fuel results)
    (covered : derivation.Covered) (closed : ClosedTypeAnnotations space) (earned : ResultSet)
    (scope : List String) :
    (∃ budget, ∀ later,
      (Checked.machine HE.GroundedDispatch.none scopedTypes).run (budget + later)
        ⟨space, .work (.atom value expected incoming fuel live), [], earned⟩ =
        (results, .finished ⟨space, .returning [], [], earned ++ results⟩)) ∧
    ∀ result ∈ results,
      ∃ (sourceOut : Bindings) (outTable : TypeSubst) (outCert : ReadoutCertificate sourceOut outTable),
        EvalAtomRawRel space noHost live (protectedScope := scope) value expected
          (.selected sourceIncoming incomingTable incomingCert)
          (result.1, .selected sourceOut outTable outCert) ∧
        SourceBindingComparison.semantic.FrameRelated result.2
          (.selected sourceOut outTable outCert) ∧
        BindingTheoryEquivAt scope result.2 sourceOut := by
  refine ⟨AtomDerivation.scoped_completed derivation covered closed earned, ?_⟩
  intro result member
  obtain ⟨independentOut, evaluated, relatedOut⟩ :=
    derivation.sound result member scope
      (.selected sourceIncoming incomingTable incomingCert) incomingRelated
  have relatedKeep := relatedOut
  cases relatedOut with
  | @semantic _ sourceOut outTable agreement outCert _ =>
      exact ⟨sourceOut, outTable, outCert, evaluated, relatedKeep, agreement.theoryEquivAt scope⟩

/-! ## Block 2: End-to-End Schematic Polymorphic Invocation (`ScopedPolymorphicInvocation` Completion) -/

namespace ScopedPolymorphicCompletion

