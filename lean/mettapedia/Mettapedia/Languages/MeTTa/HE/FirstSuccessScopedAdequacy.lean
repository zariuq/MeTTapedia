/-- Commuting Cons-Tuple Task Square (`ScopedConfigurationRel.tupleCons_step`):
Evaluating `.tuple (.expression (head :: second :: remaining))` /
`.tuple ... (ctxHead :: ctxSecond :: ctxRem)` at positive depth steps in 1 silent
transition on both machines to evaluate `head` / `ctxHead` with `.tupleHeads` / `.branches`
pushed on the stack, preserving `ScopedConfigurationRel`. -/
theorem ScopedConfigurationRel.tupleCons_step
    (space : Space) (dispatch : HE.GroundedDispatch)
    (hostDispatch : Spec.Eval.GroundedDispatch) (policy : Policy)
    (head second : Atom) (remaining : List Atom)
    (ctxHead ctxSecond : Entry.Value) (ctxRem : List Entry.Value)
    (wB : Bindings) (fuel : Nat) (live : List Atom) (scope : List String)
    (cFrame : Completed.Frame)
    (wStack : List RecursiveTasks.Frame)
    (cStack : List RecursiveTasks.Contextual.Continuation)
    (wEmitted : ResultSet) (cEmitted : List Completed.Result)
    (headEq : ctxHead.erase = head)
    (secondEq : ctxSecond.erase = second)
    (remEq : ctxRem.map Entry.Value.erase = remaining)
    (actRel : ScopedActivationRel wB cFrame)
    (stackRel : List.Forall₂ ScopedFrameRel wStack cStack)
    (emittedRel : List.Forall₂ ScopedResultRel wEmitted cEmitted) :
    let wBefore : Configuration :=
      ⟨space, .work (.tuple (.expression (head :: second :: remaining)) wB (fuel + 1) live),
        wStack, wEmitted⟩
    let wAfter : Configuration :=
      ⟨space, .work (.atom head Atom.undefinedType wB fuel
          (.expression (second :: remaining) :: live)),
        .tupleHeads (.expression (second :: remaining)) fuel live :: wStack, wEmitted⟩
    let cBefore : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.tuple live scope (ctxHead :: ctxSecond :: ctxRem) cFrame),
        cStack, cEmitted⟩
    let cAfter : RecursiveTasks.Contextual.Configuration :=
      ⟨space, .work (.atom (.expression ((ctxSecond :: ctxRem).map Entry.Value.erase) :: live)
          scope ctxHead Atom.undefinedType cFrame),
        .branches live scope (ctxSecond :: ctxRem) :: cStack, cEmitted⟩
    (Checked.machine dispatch scopedTypes).step wBefore = some (.silent wAfter) ∧
    RecursiveMachine.Contextual.LocalStep space hostDispatch Completed.scopedLookup policy
      (cBefore.control, cBefore.stack) (cAfter.control, cAfter.stack) ∧
    RecursiveExecution.Contextual.Protocol.Rule hostDispatch Completed.scopedLookup policy
      cBefore (some (.silent cAfter)) ∧
    ScopedConfigurationRel wAfter cAfter := by
  have tailEq : (ctxSecond :: ctxRem).map Entry.Value.erase = second :: remaining := by
    simp [secondEq, remEq]
  refine ⟨rfl, .tupleCons, .internal .tupleCons, ?_⟩
  rw [tailEq]
  exact ⟨rfl, .work (.atom headEq actRel), .cons (.tupleHeads tailEq) stackRel, emittedRel⟩

