/-- Exact configuration of `ScopedAnnotationControls` extended with open caller
alias `"caller" ↦ $x` and equation `(= (ident $y) $y)`. -/
def polyLive : List Atom := [.var "held", .var "x"]

def polyLoaded (space : Space) (incoming : Bindings := callerIncoming) : Configuration :=
  { Configuration.initial space (.atom identTrueCall Atom.undefinedType incoming 12 polyLive) with
    stack := [.functionTerminal (some (.expression [.symbol "caller", .var "t#0"]))]
    emitted := [(.var "t#1", incoming)] }

