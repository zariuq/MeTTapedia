  have hDisc := ScopedAtomEntryReady.held_reuse_not_ready_and_delivers
    space HE.GroundedDispatch.none noHost reusePolicy
    (.symbol "ident") [argument] Atom.undefinedType incoming 11 live ["caller", "x", "t"]
    heldVal before wStack cStack wEmitted cEmitted
