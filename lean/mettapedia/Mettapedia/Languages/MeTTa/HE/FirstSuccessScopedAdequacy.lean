/-! ## Block 1: General Scoped Realization & Closed-Annotation Transfer -/

/-- Silent multi-step path of the checked configuration-scoped HE worker. -/
abbrev ScopedSilentPath : Configuration → Configuration → Prop :=
  Relation.ReflTransGen (Checked.machine HE.GroundedDispatch.none scopedTypes).reading.silent

/-- A recursive task realizes `results` in the checked configuration-scoped HE worker
when it reaches `.returning results` under arbitrary retained caller continuations
and already published occurrences. -/
def ScopedRealizes (space : Space) (task : Task) (results : ResultSet) : Prop :=
  ∀ stack emitted,
    ScopedSilentPath ⟨space, .work task, stack, emitted⟩
      ⟨space, .returning results, stack, emitted⟩

/-- Draining `.returning results` in the checked configuration-scoped worker publishes
each occurrence in order and terminates at `.finished` with the accumulated history. -/
theorem scoped_drain_returning (space : Space) (results emitted : ResultSet) (later : Nat)
    (dispatch : HE.GroundedDispatch := HE.GroundedDispatch.none) :
    (Checked.machine dispatch scopedTypes).run (results.length + 1 + later)
      ⟨space, .returning results, [], emitted⟩ =
      (results, .finished ⟨space, .returning [], [], emitted ++ results⟩) := by
  induction results generalizing emitted with
  | nil =>
      have stepped : (Checked.machine dispatch scopedTypes).step
          ⟨space, .returning [], [], emitted⟩ =
          some (.finish ⟨space, .returning [], [], emitted⟩) := rfl
      rw [show ([] : ResultSet).length + 1 + later = later + 1 by simp; omega]
      simpa only [List.append_nil] using
        (Checked.machine dispatch scopedTypes).run_succ_finish (fuel := later) stepped
  | cons result results ih =>
      have stepped : (Checked.machine dispatch scopedTypes).step
          ⟨space, .returning (result :: results), [], emitted⟩ =
            some (.publish [result] ⟨space, .returning results, [], emitted ++ [result]⟩) := rfl
      rw [show (result :: results).length + 1 + later = (results.length + 1 + later) + 1 by simp; omega,
        (Checked.machine dispatch scopedTypes).run_succ_publish stepped, ih]
      simp only [List.singleton_append, List.append_assoc]

/-- Any task satisfying `ScopedRealizes` completes in `Checked.machine HE.GroundedDispatch.none scopedTypes`
with its exact ordered result list and accumulated publication history. -/
theorem scoped_realizes_completed {space : Space} {task : Task} {results : ResultSet}
    (realized : ScopedRealizes space task results) (earned : ResultSet) :
    ∃ budget, ∀ later,
      (Checked.machine HE.GroundedDispatch.none scopedTypes).run (budget + later)
        ⟨space, .work task, [], earned⟩ =
        (results, .finished ⟨space, .returning [], [], earned ++ results⟩) := by
  obtain ⟨administrative, pathRun⟩ :=
    (Checked.machine HE.GroundedDispatch.none scopedTypes).silent_run (realized [] earned)
  refine ⟨administrative + results.length + 1, fun later => ?_⟩
  rw [show administrative + results.length + 1 + later =
    administrative + (results.length + 1 + later) by omega,
    pathRun (results.length + 1 + later)]
  exact scoped_drain_returning space results earned later

/-- Once a `ScopedRealizes` task reaches `.finished` at any budget, its emitted result
list and final configuration are uniquely determined. -/
theorem scoped_realizes_completed_unique {space : Space} {task : Task} {results : ResultSet}
    (realized : ScopedRealizes space task results)
    (earned actual : ResultSet) (budget : Nat) (finished : Configuration)
    (ran : (Checked.machine HE.GroundedDispatch.none scopedTypes).run budget
      ⟨space, .work task, [], earned⟩ = (actual, .finished finished)) :
    actual = results ∧ finished = ⟨space, .returning [], [], earned ++ results⟩ := by
  obtain ⟨bound, complete⟩ := scoped_realizes_completed realized earned
  have stable := (Checked.machine HE.GroundedDispatch.none scopedTypes).run_stable budget bound
    ⟨space, .work task, [], earned⟩ (by
      intro residual impossible
      rw [ran] at impossible
      cases impossible)
  have same := complete budget
  rw [Nat.add_comm bound budget, stable, ran] at same
  have endpoints := Prod.mk.inj same
  exact ⟨endpoints.1, Outcome.finished.inj endpoints.2⟩

/-- Any budget-exhausted intermediate state of a `ScopedRealizes` task resumes from
the exact saved configuration to complete the remaining suffix of results. -/
theorem scoped_completes_saved {space : Space} {task : Task} {results : ResultSet}
    (realized : ScopedRealizes space task results) (earned : ResultSet)
    (first : Nat) (before : ResultSet) (saved : Configuration)
    (paused : (Checked.machine HE.GroundedDispatch.none scopedTypes).run first
      ⟨space, .work task, [], earned⟩ = (before, .exhausted saved)) :
    ∃ budget after,
      (Checked.machine HE.GroundedDispatch.none scopedTypes).run budget saved =
        (after, .finished ⟨space, .returning [], [], earned ++ results⟩) ∧
      before ++ after = results := by
  obtain ⟨budget, complete⟩ := scoped_realizes_completed realized earned
  have resumed := (Checked.machine HE.GroundedDispatch.none scopedTypes).established_and_pending
    first budget ⟨space, .work task, [], earned⟩ saved before paused
  have whole := complete first
  rw [Nat.add_comm budget first, resumed] at whole
  refine ⟨budget, ((Checked.machine HE.GroundedDispatch.none scopedTypes).run budget saved).1, ?_, ?_⟩
  · exact Prod.ext rfl (Prod.mk.inj whole).2
  · exact (Prod.mk.inj whole).1

/-! ### Closed Type Annotations and Policy Agreement -/

/-- A space has closed type annotations when every signature returned by `getAtomTypes`
contains no free variable occurrences. -/
def ClosedTypeAnnotations (space : Space) : Prop :=
  ∀ subject : Atom, ∀ signature ∈ getAtomTypes space subject, atomVariables signature = []

/-- Sufficient syntactic condition on `space.atoms`: every authored `(: subject signature)`
entry in `space` has a closed `signature`. -/
def ClosedColonAnnotations (space : Space) : Prop :=
  ∀ subject signature : Atom,
    .expression [.symbol ":", subject, signature] ∈ space.atoms →
      atomVariables signature = []

/-- Boolean checker for closed `(: subject signature)` annotations in a space. -/
def hasClosedColonAnnotations (space : Space) : Bool :=
  space.atoms.all fun atom =>
    match atom with
    | .expression [.symbol ":", _, signature] => (atomVariables signature).isEmpty
    | _ => true

theorem closedColonAnnotations_of_bool {space : Space}
    (checked : hasClosedColonAnnotations space = true) :
    ClosedColonAnnotations space := by
  intro subject signature member
  have allTrue := List.all_eq_true.mp checked (.expression [.symbol ":", subject, signature]) member
  simpa [List.isEmpty_iff] using allTrue

theorem getGroundedType_closed (g : GroundedValue) :
    atomVariables (getGroundedType g) = [] := by
  cases g <;> rfl

theorem getAnnotatedTypes_closed_of_closedColonAnnotations {space : Space}
    (closed : ClosedColonAnnotations space) (subject : Atom) :
    ∀ signature ∈ getAnnotatedTypes space subject, atomVariables signature = [] := by
  intro signature member
  simp only [getAnnotatedTypes, List.mem_filterMap] at member
  obtain ⟨atom, inSpace, matched⟩ := member
  split at matched
  · simp at matched
    rcases matched with ⟨rfl, rfl⟩
    exact closed _ _ inSpace
  · simp at matched

/-- Every space with closed `(: subject signature)` entries satisfies `ClosedTypeAnnotations`. -/
theorem ClosedColonAnnotations.closedTypeAnnotations {space : Space}
    (closed : ClosedColonAnnotations space) :
    ClosedTypeAnnotations space := by
  intro subject signature member
  cases subject with
  | var name =>
      simp only [getAtomTypes, List.isEmpty_nil, ↓reduceIte, List.mem_singleton] at member
      subst signature
      rfl
  | grounded g =>
      simp only [getAtomTypes] at member
      by_cases undef : (getGroundedType g == Atom.undefinedType) = true
      · simp only [undef, ↓reduceIte, List.isEmpty_nil, List.mem_singleton] at member
        subst signature
        rfl
      · simp only [undef, Bool.false_eq_true, ↓reduceIte, List.isEmpty_cons, List.mem_singleton] at member
        subst signature
        exact getGroundedType_closed g
  | symbol name =>
      simp only [getAtomTypes] at member
      split at member
      · simp only [List.mem_singleton] at member
        subst signature
        rfl
      · exact getAnnotatedTypes_closed_of_closedColonAnnotations closed (.symbol name) signature member
  | expression es =>
      simp only [getAtomTypes] at member
      by_cases isNil : es.isEmpty = true
      · simp only [isNil, ↓reduceIte, List.isEmpty_nil, List.mem_singleton] at member
        subst signature
        rfl
      · simp only [isNil, Bool.false_eq_true, ↓reduceIte] at member
        split at member
        · simp only [List.mem_singleton] at member
          subst signature
          rfl
        · exact getAnnotatedTypes_closed_of_closedColonAnnotations closed (.expression es) signature member

/-- Under `ClosedTypeAnnotations state.space`, `invocationTypes state` is extensionally
equal to `rawTypeLookup state.space`. -/
theorem invocationTypes_eq_rawTypeLookup_of_closed {state : Configuration}
    (closed : ClosedTypeAnnotations state.space) :
    invocationTypes state = rawTypeLookup state.space := by
  funext bindings subject expected
  exact invocationTypes_closed state bindings subject expected (closed subject)

theorem scopedTypes_eq_rawTypes_of_closed {state : Configuration}
    (closed : ClosedTypeAnnotations state.space) :
    scopedTypes.types state = rawTypes.types state :=
  invocationTypes_eq_rawTypeLookup_of_closed closed

/-- One transition step of `next` under `scopedTypes` agrees with `rawTypes` when
`state.space` has closed type annotations. -/
theorem next_scopedTypes_eq_rawTypes (dispatch : HE.GroundedDispatch) (state : Configuration)
    (closed : ClosedTypeAnnotations state.space) :
    FirstSuccessRecursiveExecution.next dispatch state scopedTypes =
      FirstSuccessRecursiveExecution.next dispatch state rawTypes := by
  simp only [FirstSuccessRecursiveExecution.next, scopedTypes_eq_rawTypes_of_closed closed]

/-- Resource readiness `Checked.blocked` under `scopedTypes` agrees with `rawTypes`
when `state.space` has closed type annotations. -/
theorem blocked_scopedTypes_eq_rawTypes (dispatch : HE.GroundedDispatch) (state : Configuration)
    (closed : ClosedTypeAnnotations state.space) :
    Checked.blocked dispatch state scopedTypes =
      Checked.blocked dispatch state rawTypes := by
  simp only [Checked.blocked, scopedTypes_eq_rawTypes_of_closed closed]

/-- Unchecked machine step under `scopedTypes` agrees with `rawTypes` on spaces with
closed type annotations. -/
theorem step_scopedTypes_eq_rawTypes (dispatch : HE.GroundedDispatch) (state : Configuration)
    (closed : ClosedTypeAnnotations state.space) :
    (FirstSuccessRecursiveExecution.machine dispatch scopedTypes).step state =
      (FirstSuccessRecursiveExecution.machine dispatch rawTypes).step state := by
  simp only [FirstSuccessRecursiveExecution.machine, next_scopedTypes_eq_rawTypes dispatch state closed]

/-- Checked machine step under `scopedTypes` agrees with `rawTypes` on spaces with
closed type annotations. -/
theorem checked_step_scopedTypes_eq_rawTypes (dispatch : HE.GroundedDispatch) (state : Configuration)
    (closed : ClosedTypeAnnotations state.space) :
    (Checked.machine dispatch scopedTypes).step state =
      (Checked.machine dispatch rawTypes).step state := by
  simp only [Checked.machine, RecursiveMachine.Checked.guardMachine,
    blocked_scopedTypes_eq_rawTypes dispatch state closed,
    step_scopedTypes_eq_rawTypes dispatch state closed]

/-- Every transition of `next` under any `policy` preserves `state.space`. -/
theorem next_preserves_space_any (dispatch : HE.GroundedDispatch) (policy : TypePolicy)
    {before after : Configuration}
    (advanced : FirstSuccessRecursiveExecution.next dispatch before policy = some after) :
    after.space = before.space := by
  rcases before with ⟨space, control, stack, emitted⟩
  cases control with
  | work task =>
      simp only [FirstSuccessRecursiveExecution.next, Option.some.injEq] at advanced
      rw [← advanced]
  | returning results =>
      cases stack with
      | nil => simp [FirstSuccessRecursiveExecution.next] at advanced
      | cons frame remaining =>
          simp only [FirstSuccessRecursiveExecution.next, Option.some.injEq] at advanced
          rw [← advanced]

/-- Every silent transition of the unchecked machine preserves `state.space`. -/
theorem machine_step_silent_preserves_space (dispatch : HE.GroundedDispatch) (policy : TypePolicy)
    {before after : Configuration}
    (stepped : (FirstSuccessRecursiveExecution.machine dispatch policy).step before = some (.silent after)) :
    after.space = before.space := by
  rcases before with ⟨space, control, stack, emitted⟩
  simp only [FirstSuccessRecursiveExecution.machine] at stepped
  cases hNext : FirstSuccessRecursiveExecution.next dispatch ⟨space, control, stack, emitted⟩ policy with
  | some nextState =>
      simp only [hNext, Option.some.injEq, Transition.silent.injEq] at stepped
      rw [← stepped]
      exact next_preserves_space_any dispatch policy hNext
  | none =>
      simp only [hNext] at stepped
      cases control with
      | work task => simp at stepped
      | returning results =>
          cases results <;> simp [reduceCtorEq] at stepped

/-- Every publish transition of the unchecked machine preserves `state.space`. -/
theorem machine_step_publish_preserves_space (dispatch : HE.GroundedDispatch) (policy : TypePolicy)
    {before after : Configuration} {events : List ResultPair}
    (stepped : (FirstSuccessRecursiveExecution.machine dispatch policy).step before = some (.publish events after)) :
    after.space = before.space := by
  rcases before with ⟨space, control, stack, emitted⟩
  simp only [FirstSuccessRecursiveExecution.machine] at stepped
  cases hNext : FirstSuccessRecursiveExecution.next dispatch ⟨space, control, stack, emitted⟩ policy with
  | some nextState =>
      simp [hNext, reduceCtorEq] at stepped
  | none =>
      simp only [hNext] at stepped
      cases control with
      | work task => simp at stepped
      | returning results =>
          cases results with
          | nil => simp [reduceCtorEq] at stepped
          | cons result remaining =>
              simp only [Option.some.injEq, Transition.publish.injEq] at stepped
              rw [← stepped.2]

/-- Every silent transition of the checked machine preserves `state.space`. -/
theorem checked_step_silent_preserves_space (dispatch : HE.GroundedDispatch) (policy : TypePolicy)
    {before after : Configuration}
    (stepped : (Checked.machine dispatch policy).step before = some (.silent after)) :
    after.space = before.space := by
  simp only [Checked.machine, RecursiveMachine.Checked.guardMachine] at stepped
  cases hBlocked : Checked.blocked dispatch before policy with
  | some request => simp [hBlocked, reduceCtorEq] at stepped
  | none =>
      simp only [hBlocked] at stepped
      cases hStep : (FirstSuccessRecursiveExecution.machine dispatch policy).step before with
      | none => simp [hStep] at stepped
      | some action =>
          simp only [hStep, Option.map_some, Option.some.injEq] at stepped
          cases action with
          | silent nextState =>
              simp only [Transition.relabel, Transition.silent.injEq] at stepped
              rw [← stepped]
              exact machine_step_silent_preserves_space dispatch policy hStep
          | publish _ _ => simp [Transition.relabel, reduceCtorEq] at stepped
          | finish _ => simp [Transition.relabel, reduceCtorEq] at stepped
          | fail _ => simp [Transition.relabel, reduceCtorEq] at stepped
          | call request _ => nomatch request

/-- Every publish transition of the checked machine preserves `state.space`. -/
theorem checked_step_publish_preserves_space (dispatch : HE.GroundedDispatch) (policy : TypePolicy)
    {before after : Configuration} {events : List ResultPair}
    (stepped : (Checked.machine dispatch policy).step before = some (.publish events after)) :
    after.space = before.space := by
  simp only [Checked.machine, RecursiveMachine.Checked.guardMachine] at stepped
  cases hBlocked : Checked.blocked dispatch before policy with
  | some request => simp [hBlocked, reduceCtorEq] at stepped
  | none =>
      simp only [hBlocked] at stepped
      cases hStep : (FirstSuccessRecursiveExecution.machine dispatch policy).step before with
      | none => simp [hStep] at stepped
      | some action =>
          simp only [hStep, Option.map_some, Option.some.injEq] at stepped
          cases action with
          | silent _ => simp [Transition.relabel, reduceCtorEq] at stepped
          | publish published nextState =>
              simp only [Transition.relabel, Transition.publish.injEq] at stepped
              rw [← stepped.2]
              exact machine_step_publish_preserves_space dispatch policy hStep
          | finish _ => simp [Transition.relabel, reduceCtorEq] at stepped
          | fail _ => simp [Transition.relabel, reduceCtorEq] at stepped
          | call request _ => nomatch request

/-- For any budget, running `FirstSuccessRecursiveExecution.machine dispatch scopedTypes`
equals running `FirstSuccessRecursiveExecution.machine dispatch rawTypes` when
`state.space` has closed type annotations. -/
theorem run_scopedTypes_eq_rawTypes (dispatch : HE.GroundedDispatch) (budget : Nat)
    (state : Configuration) (closed : ClosedTypeAnnotations state.space) :
    (FirstSuccessRecursiveExecution.machine dispatch scopedTypes).run budget state =
      (FirstSuccessRecursiveExecution.machine dispatch rawTypes).run budget state := by
  induction budget generalizing state with
  | zero => rfl
  | succ budget ih =>
      rw [Machine.run, Machine.run, step_scopedTypes_eq_rawTypes dispatch state closed]
      cases hStep : (FirstSuccessRecursiveExecution.machine dispatch rawTypes).step state with
      | none => rfl
      | some action =>
          cases action with
          | silent after =>
              have afterClosed : ClosedTypeAnnotations after.space := by
                rw [machine_step_silent_preserves_space dispatch rawTypes hStep]
                exact closed
              simpa using ih after afterClosed
          | publish events after =>
              have afterClosed : ClosedTypeAnnotations after.space := by
                rw [machine_step_publish_preserves_space dispatch rawTypes hStep]
                exact closed
              simp only [ih after afterClosed]
          | finish _ => rfl
          | fail _ => rfl
          | call request _ => nomatch request

/-- For any budget, running `Checked.machine dispatch scopedTypes` equals running
`Checked.machine dispatch rawTypes` when `state.space` has closed type annotations. -/
theorem checked_run_scopedTypes_eq_rawTypes (dispatch : HE.GroundedDispatch) (budget : Nat)
    (state : Configuration) (closed : ClosedTypeAnnotations state.space) :
    (Checked.machine dispatch scopedTypes).run budget state =
      (Checked.machine dispatch rawTypes).run budget state := by
  induction budget generalizing state with
  | zero => rfl
  | succ budget ih =>
      rw [Machine.run, Machine.run, checked_step_scopedTypes_eq_rawTypes dispatch state closed]
      cases hStep : (Checked.machine dispatch rawTypes).step state with
      | none => rfl
      | some action =>
          cases action with
          | silent after =>
              have afterClosed : ClosedTypeAnnotations after.space := by
                rw [checked_step_silent_preserves_space dispatch rawTypes hStep]
                exact closed
              simpa using ih after afterClosed
          | publish events after =>
              have afterClosed : ClosedTypeAnnotations after.space := by
                rw [checked_step_publish_preserves_space dispatch rawTypes hStep]
                exact closed
              simp only [ih after afterClosed]
          | finish _ => rfl
          | fail _ => rfl
          | call _ _ => rfl

/-- Along any silent path of `Checked.machine`, the space is invariant. -/
theorem silentPath_preserves_space {dispatch : HE.GroundedDispatch} {policy : TypePolicy}
    {before after : Configuration}
    (path : Relation.ReflTransGen (Checked.machine dispatch policy).reading.silent before after) :
    after.space = before.space := by
  induction path with
  | refl => rfl
  | tail _ step ih =>
      exact (checked_step_silent_preserves_space dispatch policy step).trans ih

/-- On any space with closed type annotations, `ScopedSilentPath` is equivalent to
`Covered.SilentPath`. -/
theorem scopedSilentPath_iff_silentPath_of_closed {before after : Configuration}
    (closed : ClosedTypeAnnotations before.space) :
    ScopedSilentPath before after ↔ Covered.SilentPath before after := by
  constructor
  · intro path
    induction path with
    | refl => exact Relation.ReflTransGen.refl
    | @tail mid last prefixPath step ih =>
        have midClosed : ClosedTypeAnnotations mid.space := by
          rw [silentPath_preserves_space prefixPath]
          exact closed
        have rawStep : (Checked.machine HE.GroundedDispatch.none rawTypes).reading.silent mid last := by
          change (Checked.machine HE.GroundedDispatch.none rawTypes).step mid = some (.silent last)
          rw [← checked_step_scopedTypes_eq_rawTypes HE.GroundedDispatch.none mid midClosed]
          exact step
        exact ih.tail rawStep
  · intro path
    induction path with
    | refl => exact Relation.ReflTransGen.refl
    | @tail mid last prefixPath step ih =>
        have midClosed : ClosedTypeAnnotations mid.space := by
          rw [silentPath_preserves_space prefixPath]
          exact closed
        have scopedStep : (Checked.machine HE.GroundedDispatch.none scopedTypes).reading.silent mid last := by
          change (Checked.machine HE.GroundedDispatch.none scopedTypes).step mid = some (.silent last)
          rw [checked_step_scopedTypes_eq_rawTypes HE.GroundedDispatch.none mid midClosed]
          exact step
        exact ih.tail scopedStep

/-- **Block 1 Core Transfer Theorem**: On any space with closed type annotations,
`ScopedRealizes` is equivalent to `Covered.Realizes`. -/
theorem scopedRealizes_iff_coveredRealizes_of_closed {space : Space} {task : Task} {results : ResultSet}
    (closed : ClosedTypeAnnotations space) :
    ScopedRealizes space task results ↔ Covered.Realizes space task results := by
  constructor
  · intro scopedPath stack emitted
    exact (scopedSilentPath_iff_silentPath_of_closed closed).mp (scopedPath stack emitted)
  · intro coveredPath stack emitted
    exact (scopedSilentPath_iff_silentPath_of_closed closed).mpr (coveredPath stack emitted)

