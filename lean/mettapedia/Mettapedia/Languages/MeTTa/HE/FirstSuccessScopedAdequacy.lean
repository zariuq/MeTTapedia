/-- Boolean observer for completed runs that enables `decide +kernel` (`ofReduceBool`)
evaluation without symbolic WHNF unfolding of `Outcome`. -/
def isFinishedWith (space : Space) (published emitted : List ResultPair)
    (result : List ResultPair × Outcome Configuration Configuration Checked.ResourceRequest) : Bool :=
  match result with
  | (pub, .finished ⟨sp, .returning [], [], em⟩) =>
      (pub == published) && (sp == space) && (em == emitted)
  | _ => false

theorem eq_finished_of_isFinishedWith {space : Space} {published emitted : List ResultPair}
    {result : List ResultPair × Outcome Configuration Configuration Checked.ResourceRequest}
    (ok : isFinishedWith space published emitted result = true) :
    result = (published, .finished ⟨space, .returning [], [], emitted⟩) := by
  rcases result with ⟨pub, out⟩
  cases out with
  | finished cfg =>
      rcases cfg with ⟨sp, ctrl, stk, em⟩
      cases ctrl with
      | work _ => simp [isFinishedWith] at ok
      | returning rs =>
          cases rs with
          | cons _ _ => simp [isFinishedWith] at ok
          | nil =>
              cases stk with
              | cons _ _ => simp [isFinishedWith] at ok
              | nil =>
                  simp only [isFinishedWith, Bool.and_eq_true, beq_iff_eq] at ok
                  rcases ok with ⟨⟨rfl, rfl⟩, rfl⟩
                  rfl
  | exhausted _ => simp [isFinishedWith] at ok
  | suspended _ _ => simp [isFinishedWith] at ok
  | faulted => simp [isFinishedWith] at ok
  | stuck => simp [isFinishedWith] at ok

/-- Boolean observer for paused `.exhausted` checkpoints. -/
def isExhaustedWith (published : List ResultPair) (expected : Configuration)
    (result : List ResultPair × Outcome Configuration Configuration Checked.ResourceRequest) : Bool :=
  match result with
  | (pub, .exhausted cfg) => (pub == published) && (cfg == expected)
  | _ => false

theorem eq_exhausted_of_isExhaustedWith {published : List ResultPair} {expected : Configuration}
    {result : List ResultPair × Outcome Configuration Configuration Checked.ResourceRequest}
    (ok : isExhaustedWith published expected result = true) :
    result = (published, .exhausted expected) := by
  rcases result with ⟨pub, out⟩
  cases out with
  | exhausted cfg =>
      simp only [isExhaustedWith, Bool.and_eq_true, beq_iff_eq] at ok
      rcases ok with ⟨rfl, rfl⟩
      rfl
  | finished _ => simp [isExhaustedWith] at ok
  | suspended _ _ => simp [isExhaustedWith] at ok
  | faulted => simp [isExhaustedWith] at ok
  | stuck => simp [isExhaustedWith] at ok

/-- Strict transition function that pattern-matches `(ctrl, frames)` before constructing
`Configuration.mk`, preventing call-by-name `let`-duplication in kernel WHNF reduction. -/
def strictNext (dispatch : HE.GroundedDispatch) (state : Configuration)
    (policy : TypePolicy := rawTypes) : Option Configuration :=
  match state.control, state.stack with
  | .work task, stack =>
      match FirstSuccessRecursiveStrategy.enter state.space dispatch task (policy.types state) with
      | (ctrl, frames) => some ⟨state.space, ctrl, frames ++ stack, state.emitted⟩
  | .returning results, frame :: remaining =>
      match RecursiveMachine.resume state.space frame results (policy.types state) with
      | (ctrl, frames) => some ⟨state.space, ctrl, frames ++ remaining, state.emitted⟩
  | .returning _, [] => none

theorem strictNext_eq_next (dispatch : HE.GroundedDispatch) (state : Configuration)
    (policy : TypePolicy) :
    strictNext dispatch state policy = FirstSuccessRecursiveExecution.next dispatch state policy := by
  rcases state with ⟨space, control, stack, emitted⟩
  cases control with
  | work task => rfl
  | returning results =>
      cases stack <;> rfl

def strictMachine (dispatch : HE.GroundedDispatch) (policy : TypePolicy := rawTypes) :
    Machine Configuration ResultPair Configuration Checked.ResourceRequest where
  step state :=
    match Checked.blocked dispatch state policy with
    | some req => some (.call req state)
    | none =>
        match strictNext dispatch state policy with
        | some after => some (.silent after)
        | none =>
            match state.control with
            | .work _ => none
            | .returning [] => some (.finish state)
            | .returning (result :: remaining) =>
                some (.publish [result] ⟨state.space, .returning remaining, state.stack, state.emitted ++ [result]⟩)

theorem strictMachine_step_eq (dispatch : HE.GroundedDispatch) (policy : TypePolicy)
    (state : Configuration) :
    (strictMachine dispatch policy).step state = (Checked.machine dispatch policy).step state := by
  simp only [strictMachine, Checked.machine, RecursiveMachine.Checked.guardMachine]
  cases Checked.blocked dispatch state policy with
  | some req => rfl
  | none =>
      simp only [FirstSuccessRecursiveExecution.machine, ← strictNext_eq_next]
      cases strictNext dispatch state policy with
      | some after => rfl
      | none =>
          rcases state with ⟨space, control, stack, emitted⟩
          cases control with
          | work _ => rfl
          | returning results =>
              cases results <;> rfl

theorem strictMachine_run_eq (dispatch : HE.GroundedDispatch) (policy : TypePolicy)
    (budget : Nat) (state : Configuration) :
    (strictMachine dispatch policy).run budget state =
      (Checked.machine dispatch policy).run budget state := by
  induction budget generalizing state with
  | zero => rfl
  | succ budget ih =>
      rw [Machine.run, Machine.run, strictMachine_step_eq]
      cases (Checked.machine dispatch policy).step state with
      | none => rfl
      | some action =>
          cases action with
          | silent after => exact ih after
          | publish events after => simp only [ih after]
          | finish _ => rfl
          | fail _ => rfl
          | call _ _ => rfl

theorem run_eq_finished_of_strict {dispatch : HE.GroundedDispatch} {policy : TypePolicy}
    {budget : Nat} {state : Configuration} {published emitted : List ResultPair}
    (ok : isFinishedWith state.space published emitted ((strictMachine dispatch policy).run budget state) = true) :
    (Checked.machine dispatch policy).run budget state =
      (published, .finished ⟨state.space, .returning [], [], emitted⟩) := by
  rw [← strictMachine_run_eq]
  exact eq_finished_of_isFinishedWith ok

theorem run_eq_exhausted_of_strict {dispatch : HE.GroundedDispatch} {policy : TypePolicy}
    {budget : Nat} {state expected : Configuration} {published : List ResultPair}
    (ok : isExhaustedWith published expected ((strictMachine dispatch policy).run budget state) = true) :
    (Checked.machine dispatch policy).run budget state =
      (published, .exhausted expected) := by
  rw [← strictMachine_run_eq]
  exact eq_exhausted_of_isExhaustedWith ok

/-! ### Explicit `afterHead` Checkpoint and End-to-End Continuation Completion -/

def polyIdentOpenLive : List Atom := [.var "held", .var "x", .var "t#0"]

def polyIdentOpenOperatorType : Atom :=
  .expression [.symbol "->", .var "t#2", .var "t#2"]

def polyIdentOpenApplicabilityBindings : Bindings :=
  callerIncomingOpen.assign "t#2" (.symbol "Bool")

def polyIdentOpenNativeHeadBindings : Bindings :=
  (polyIdentOpenApplicabilityBindings.addEquality "t#2" "t#3").addEquality "t#2" "t#3"

def polyIdentOpenAfterHead : Configuration :=
  { space := polyIdentSpace
    control := .returning [(.symbol "ident", polyIdentOpenNativeHeadBindings)]
    stack := [
      .heads polyIdentOpenOperatorType [.grounded (.bool true)] 9 (.var "t#2" :: polyIdentOpenLive),
      .calls (.var "t#2") 10 polyIdentOpenLive,
      .append (.bindingAlternatives identTrueCall polyIdentOpenOperatorType (.var "t#2") 10 [] polyIdentOpenLive),
      .filter
    ]
    emitted := [(.var "t#1", callerIncomingOpen)] }

/-- Step 6 (`afterHead`): `polyIdentOpenLoaded` reaches the exact head-cast checkpoint
with two fresh polymorphic signature instances (`t#2` and `t#3`) while preserving the
open caller alias `"caller" = "x"`, the caller's `"t" ↦ Number`, and the prior emitted history. -/
theorem polyIdentOpen_reaches_afterHead :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 6 polyIdentOpenLoaded =
      ([], .exhausted polyIdentOpenAfterHead) :=
  run_eq_exhausted_of_strict (by decide +kernel)

/-- Continuation completion from `afterHead` (46 steps): advances through `.heads` → `.args` →
`.func` assembly → `.calls` equation invocation (`(= (ident $y) $y)` freshened to `$y#1 ↦ true`) →
`.returned` → `.filter` → `.finished`. -/
theorem polyIdentOpen_afterHead_completes :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 46 polyIdentOpenAfterHead =
      ([(.grounded (.bool true), polyIdentOutBindings)],
       .finished ⟨polyIdentSpace, .returning [], [],
         [(.var "t#1", callerIncomingOpen),
          (.grounded (.bool true), polyIdentOutBindings)]⟩) :=
  run_eq_finished_of_strict (by decide +kernel)

theorem polyDeclNoTerm_scoped_completed :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 43 polyDeclNoTermLoaded =
      ([(identTrueCall, polyDeclOutBindings)],
       .finished ⟨polyDeclSpace, .returning [], [],
         [(.var "t#1", Bindings.empty.assign "t" (.symbol "Number")),
          (identTrueCall, polyDeclOutBindings)]⟩) :=
  run_eq_finished_of_strict (by decide +kernel)

theorem polyIdentOpen_scoped_completed :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 52 polyIdentOpenLoaded =
      ([(.grounded (.bool true), polyIdentOutBindings)],
       .finished ⟨polyIdentSpace, .returning [], [],
         [(.var "t#1", callerIncomingOpen),
          (.grounded (.bool true), polyIdentOutBindings)]⟩) :=
  run_eq_finished_of_strict (by decide +kernel)

theorem run_exhausted_trans {m : Machine Configuration ResultPair Configuration Checked.ResourceRequest}
    {n₁ n₂ : Nat} {s₀ s₁ : Configuration}
    (h₁ : m.run n₁ s₀ = ([], .exhausted s₁)) :
    m.run (n₁ + n₂) s₀ = m.run n₂ s₁ := by
  have h := m.established_and_pending n₁ n₂ s₀ s₁ [] h₁
  rw [h, List.nil_append, Prod.mk.eta]

/-- Composing the 6-step head-cast prefix and the 46-step continuation completion
via `Machine.established_and_pending` yields the full 52-step completed run. -/
theorem polyIdentOpen_split_resume :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run (6 + 46) polyIdentOpenLoaded =
      (Checked.machine HE.GroundedDispatch.none scopedTypes).run 46 polyIdentOpenAfterHead :=
  run_exhausted_trans polyIdentOpen_reaches_afterHead

theorem polyIdentOpen_raw_rejected :
    (Checked.machine HE.GroundedDispatch.none rawTypes).run 6 polyIdentOpenLoaded =
      ([(mkError identTrueCall (.badArgType 1 (.var "t") (.symbol "Bool")), callerIncomingOpen)],
       .finished ⟨polyIdentSpace, .returning [], [],
         [(.var "t#1", callerIncomingOpen),
          (mkError identTrueCall (.badArgType 1 (.var "t") (.symbol "Bool")), callerIncomingOpen)]⟩) :=
  run_eq_finished_of_strict (by decide +kernel)

theorem pairSiblingOpen_scoped_completed :
    (Checked.machine HE.GroundedDispatch.none scopedTypes).run 141 pairSiblingOpenLoaded =
      ([(.expression [.symbol "Pair", .var "x", .grounded (.bool true)], pairSiblingOpenOutBindings)],
       .finished ⟨polyIdentSpace, .returning [], [],
         [(.expression [.symbol "Pair", .var "x", .grounded (.bool true)], pairSiblingOpenOutBindings)]⟩) :=
  run_eq_finished_of_strict (by decide +kernel)

