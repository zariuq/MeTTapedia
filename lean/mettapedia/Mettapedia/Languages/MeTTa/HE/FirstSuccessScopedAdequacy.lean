/-- Concrete Negative Control K (`controlK_altered_representative_or_readiness_breaks_retained_frame`):
Demonstrates that weakening the retained contextual frame by altering either its canonical
table representative or its nested expression readiness mark breaks the exact correspondence:
1. Replacing the substitution table in the open-variable cast frame by the contextual
   left-binding representative (`aliasFrame` with `forwardAlias`) while keeping
   `BindingSourceAgreement` and `ScopedJointFrameRel` refutes `ScopedActivationRel forwardAlias aliasFrame`
   and `ScopedResultRel (.symbol "op", forwardAlias) (.symbol "op", aliasFrame)`, and
2. Marking the second call expression `(.expression .held [.symbol "poly2", .symbol "fortyTwo"])`
   as `.held` under `{ Policy.finiteTypes with reentry := .reuse }` while keeping the exact same
   erased atom `call2` and the exact retained frame `afterCast` (`ScopedActivationRel nativeCastOut afterCast`)
   refutes `ScopedAtomEntryReady` and causes the contextual machine to step via `LocalStep.delivered`
   to `.returning` instead of interpreting `poly2`. -/
theorem controlK_altered_representative_or_readiness_breaks_retained_frame :
    let space := RetainedCastFrameControl.space
    let call2 := RetainedCastFrameControl.call2
    let live := RetainedCastFrameControl.live
    let scope := RetainedCastFrameControl.scope
    let nativeCastOut := RetainedCastFrameControl.nativeCastOut
    let heldCall2 : Entry.Value := .expression .held [.symbol "poly2", .symbol "fortyTwo"]
    let reusePolicy : Policy := { Policy.finiteTypes with reentry := .reuse }
    (BindingSourceAgreement forwardAlias aliasFrame.bindings ∧
      ScopedJointFrameRel forwardAlias aliasFrame ∧
      ¬ScopedActivationRel forwardAlias aliasFrame ∧
      ¬ScopedResultRel (.symbol "op", forwardAlias) (.symbol "op", aliasFrame)) ∧
    ∃ afterCast : Completed.Frame,
      ScopedActivationRel nativeCastOut afterCast ∧
      heldCall2.erase = call2 ∧
      ¬ScopedAtomEntryReady reusePolicy call2 heldCall2 afterCast ∧
      let cStack : List RecursiveTasks.Contextual.Continuation := []
      RecursiveMachine.Contextual.LocalStep space noHost Completed.scopedLookup reusePolicy
        (.work (.atom live scope heldCall2 Atom.undefinedType afterCast), cStack)
        (.returning [(afterCast.read reusePolicy heldCall2, afterCast)], cStack) := by
  intro space call2 live scope nativeCastOut heldCall2 reusePolicy
  let wStack := RetainedCastFrameControl.wStack
  have sep := separation_open_var_cast_no_literal_scopedActivationRel
  have notRes : ¬ScopedResultRel (.symbol "op", forwardAlias) (.symbol "op", aliasFrame) :=
    fun h => sep.2.2.2.2.1 h.2
  obtain ⟨_, _, _, _, _, before0, _, afterCast, _, _, _,
    _, _, _, _, _, _, _, _, actAfterCast, _⟩ :=
    controlJ_retained_cast_frame_two_fresh_instances_and_return
  let cStack : List RecursiveTasks.Contextual.Continuation := []
  let wEmitted0 := RetainedCastFrameControl.wEmitted0
  let cEmitted0 : List Completed.Result :=
    [(Entry.Value.ofAtom RetainedCastFrameControl.priorEmittedAtom, before0)]
  have hHeldVars : SubstitutionAlgebra.vars heldCall2.erase = [] := by
    rw [← TypeSubst.typeVars_eq_vars]
    simp [heldCall2,Entry.Value.erase,TypeSubst.typeVars,TypeSubst.typeVarsList]
  have closedHeld : ∀ name, ¬Spec.Match.Merge.AtomOccurs heldCall2.erase name := by
    intro name hOcc
    rw [← Spec.Match.Merge.mem_vars_iff_atomOccurs, hHeldVars] at hOcc
    cases hOcc
  have hHeldRead : afterCast.read reusePolicy heldCall2 = heldCall2 :=
    afterCast.read_variable_free reusePolicy heldCall2 closedHeld
  have hHeldErase :
      (afterCast.read reusePolicy heldCall2).erase =
        .expression [.symbol "poly2", RetainedCastFrameControl.arg2] := by
    rw [hHeldRead]
    simp [heldCall2,Entry.Value.erase,RetainedCastFrameControl.arg2,RetainedCastFrameControl.argSym]
  have hHeldStatus : (afterCast.read reusePolicy heldCall2).status = .held := by
    rw [hHeldRead]
    rfl
  have hDisc := ScopedAtomEntryReady.held_reuse_not_ready_and_delivers
    space HE.GroundedDispatch.none noHost reusePolicy
    (.symbol "poly2") [RetainedCastFrameControl.arg2]
    Atom.undefinedType nativeCastOut 11 live scope
    heldCall2 afterCast wStack cStack wEmitted0 cEmitted0
    hHeldErase rfl hHeldStatus (by decide) (by decide) (by decide)
  exact ⟨⟨.refl forwardAlias, sep.2.2.2.2.2.1, sep.2.2.2.2.1, notRes⟩,
    afterCast, actAfterCast,
    by simp [heldCall2,call2,RetainedCastFrameControl.call2,RetainedCastFrameControl.arg2,
      RetainedCastFrameControl.argSym,Entry.Value.erase],hDisc.1,hDisc.2.2.1⟩

