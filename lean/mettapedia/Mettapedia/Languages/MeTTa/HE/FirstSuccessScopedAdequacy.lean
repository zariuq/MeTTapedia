    ∃ budget, ∀ later,
      (Checked.machine HE.GroundedDispatch.none scopedTypes).run (budget + later)
        ⟨space, .work (.atom value expected incoming fuel live), [], earned⟩ =
        (results, .finished ⟨space, .returning [], [], earned ++ results⟩) :=
  scoped_realizes_completed (AtomDerivation.scoped_realizes derivation covered closed) earned

