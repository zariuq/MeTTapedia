import Mettapedia.Languages.MeTTa.HE.Types
import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected
import Mathlib.Combinatorics.SimpleGraph.Paths

/-!
# Finite equality-graph closure

HE and LeaTTa store equality edges in different orders. This file gives the
fuelled saturation used by HE an order-independent meaning: membership is
exactly reachability in the finite undirected graph generated by the edge list.
-/

namespace Mettapedia.Languages.MeTTa.HE.EqualityClosure

/-- Endpoints mentioned by an equality-edge list, with multiplicity. -/
def edgeNodes (edges : List (String × String)) : List String :=
  edges.flatMap fun (x, y) => [x, y]

/-- The loopless undirected graph presented by an equality-edge list. Self
edges do not affect equality closure and are represented by reflexivity. -/
def edgeGraph (edges : List (String × String)) : SimpleGraph String where
  Adj x y := x ≠ y ∧ ((x, y) ∈ edges ∨ (y, x) ∈ edges)
  symm := ⟨by
    intro x y h
    exact ⟨h.1.symm, h.2.symm⟩⟩
  loopless := ⟨by simp⟩

@[simp] theorem edgeGraph_adj_iff {edges : List (String × String)}
    {x y : String} :
    (edgeGraph edges).Adj x y ↔
      x ≠ y ∧ ((x, y) ∈ edges ∨ (y, x) ∈ edges) :=
  Iff.rfl

theorem left_mem_edgeNodes {edges : List (String × String)}
    {x y : String} (h : (x, y) ∈ edges) : x ∈ edgeNodes edges := by
  simp only [edgeNodes, List.mem_flatMap]
  exact ⟨(x, y), h, by simp⟩

theorem right_mem_edgeNodes {edges : List (String × String)}
    {x y : String} (h : (x, y) ∈ edges) : y ∈ edgeNodes edges := by
  simp only [edgeNodes, List.mem_flatMap]
  exact ⟨(x, y), h, by simp⟩

private theorem adj_endpoints_mem_edgeNodes
    {edges : List (String × String)} {x y : String}
    (h : (edgeGraph edges).Adj x y) :
    x ∈ edgeNodes edges ∧ y ∈ edgeNodes edges := by
  rcases h.2 with hxy | hyx
  · exact ⟨left_mem_edgeNodes hxy, right_mem_edgeNodes hxy⟩
  · exact ⟨right_mem_edgeNodes hyx, left_mem_edgeNodes hyx⟩

/-- Every vertex of a walk is either its start or an endpoint from the finite
edge presentation. -/
theorem walk_support_subset_start_edgeNodes
    {edges : List (String × String)} {start finish : String}
    (walk : (edgeGraph edges).Walk start finish) :
    ∀ ⦃v⦄, v ∈ walk.support → v ∈ start :: edgeNodes edges := by
  induction walk with
  | nil => simp
  | cons hadj tail ih =>
      rename_i start next finish
      intro v hv
      simp only [SimpleGraph.Walk.support_cons, List.mem_cons] at hv ⊢
      rcases hv with rfl | hv
      · exact Or.inl rfl
      · have hi : v = next ∨ v ∈ edgeNodes edges := by
          simpa only [List.mem_cons] using ih hv
        rcases hi with hnext | hnode
        · exact Or.inr (by
            simpa [hnext] using (adj_endpoints_mem_edgeNodes hadj).2)
        · exact Or.inr hnode

/-- A simple path in a graph presented by `m` edges has length at most `2m`.
The loose endpoint bound is sufficient for the production saturation fuel and
avoids imposing a finite type on all strings. -/
theorem path_length_le_twice_edges
    {edges : List (String × String)} {start finish : String}
    (path : (edgeGraph edges).Path start finish) :
    path.val.length ≤ 2 * edges.length := by
  have hsubset : path.val.support.toFinset ⊆
      (start :: edgeNodes edges).toFinset := by
    intro v hv
    rw [List.mem_toFinset] at hv ⊢
    exact walk_support_subset_start_edgeNodes path.val hv
  have hcard := Finset.card_le_card hsubset
  have hsupport : path.val.support.Nodup :=
    (SimpleGraph.Walk.isPath_def _).mp path.property
  have hlength : path.val.support.length ≤
      (start :: edgeNodes edges).length := by
    calc
      path.val.support.length = path.val.support.toFinset.card :=
        (List.toFinset_card_of_nodup hsupport).symm
      _ ≤ (start :: edgeNodes edges).toFinset.card := hcard
      _ ≤ (start :: edgeNodes edges).length :=
        List.toFinset_card_le (start :: edgeNodes edges)
  rw [SimpleGraph.Walk.length_support] at hlength
  simp [edgeNodes] at hlength
  omega

/-- Reachability in the finite equality graph always has a path within the
fuel budget used by `Bindings.eqClass`. -/
theorem reachable_has_bounded_path
    {edges : List (String × String)} {start finish : String}
    (h : (edgeGraph edges).Reachable start finish) :
    ∃ path : (edgeGraph edges).Path start finish,
      path.val.length ≤ 2 * edges.length := by
  exact h.elim_path fun path => ⟨path, path_length_le_twice_edges path⟩

private def edgeUpdate (acc : List String) (edge : String × String) : List String :=
  let acc := if acc.contains edge.1 && !acc.contains edge.2 then acc ++ [edge.2] else acc
  if acc.contains edge.2 && !acc.contains edge.1 then acc ++ [edge.1] else acc

@[simp] private theorem eqStep_nil (acc : List String) :
    HE.Bindings.eqStep [] acc = acc := rfl

private theorem eqStep_cons (edge : String × String)
    (edges : List (String × String)) (acc : List String) :
    HE.Bindings.eqStep (edge :: edges) acc =
      HE.Bindings.eqStep edges (edgeUpdate acc edge) := rfl

private theorem mem_edgeUpdate_of_mem {acc : List String} {v : String}
    (edge : String × String) (hv : v ∈ acc) : v ∈ edgeUpdate acc edge := by
  simp only [edgeUpdate]
  split <;> split <;> simp_all

private theorem right_mem_edgeUpdate_of_left_mem {acc : List String} {x y : String}
    (hx : x ∈ acc) : y ∈ edgeUpdate acc (x, y) := by
  simp only [edgeUpdate]
  split <;> split <;> simp_all

private theorem left_mem_edgeUpdate_of_right_mem {acc : List String} {x y : String}
    (hy : y ∈ acc) : x ∈ edgeUpdate acc (x, y) := by
  simp only [edgeUpdate]
  split <;> split <;> simp_all

private theorem mem_edgeUpdate_cases {acc : List String} {x y v : String}
    (hv : v ∈ edgeUpdate acc (x, y)) :
    v ∈ acc ∨ (v = x ∧ y ∈ acc) ∨ (v = y ∧ x ∈ acc) := by
  simp only [edgeUpdate] at hv
  split at hv <;> split at hv <;> simp_all

private theorem reachable_of_mem_edgeUpdate
    {edges : List (String × String)} {start x y v : String}
    (hedge : (x, y) ∈ edges)
    (hacc : ∀ ⦃u⦄, u ∈ acc → (edgeGraph edges).Reachable start u)
    (hv : v ∈ edgeUpdate acc (x, y)) :
    (edgeGraph edges).Reachable start v := by
  rcases mem_edgeUpdate_cases hv with hv | ⟨hvx, hy⟩ | ⟨hvy, hx⟩
  · exact hacc hv
  · have hx : (edgeGraph edges).Reachable start x := by
      by_cases hxy : x = y
      · simpa [hxy] using hacc hy
      · exact (hacc hy).trans
          (show (edgeGraph edges).Adj y x from
            ⟨fun hyx => hxy hyx.symm, Or.inr hedge⟩).reachable
    simpa [hvx] using hx
  · have hy : (edgeGraph edges).Reachable start y := by
      by_cases hxy : x = y
      · simpa [hxy] using hacc hx
      · exact (hacc hx).trans
          (show (edgeGraph edges).Adj x y from
            ⟨hxy, Or.inl hedge⟩).reachable
    simpa [hvy] using hy

/-- A saturation pass retains every member of its input accumulator. -/
theorem mem_eqStep_of_mem {edges : List (String × String)}
    {acc : List String} {v : String} (hv : v ∈ acc) :
    v ∈ HE.Bindings.eqStep edges acc := by
  induction edges generalizing acc with
  | nil => simpa using hv
  | cons edge edges ih =>
      rw [eqStep_cons]
      exact ih (mem_edgeUpdate_of_mem edge hv)

/-- One complete pass crosses an equality edge in either orientation. -/
theorem right_mem_eqStep_of_left_mem {edges : List (String × String)}
    {acc : List String} {x y : String} (hedge : (x, y) ∈ edges)
    (hx : x ∈ acc) : y ∈ HE.Bindings.eqStep edges acc := by
  induction edges generalizing acc with
  | nil => simp at hedge
  | cons edge edges ih =>
      rw [eqStep_cons]
      rcases List.mem_cons.mp hedge with rfl | hedge
      · exact mem_eqStep_of_mem (right_mem_edgeUpdate_of_left_mem hx)
      · exact ih hedge (mem_edgeUpdate_of_mem edge hx)

theorem left_mem_eqStep_of_right_mem {edges : List (String × String)}
    {acc : List String} {x y : String} (hedge : (x, y) ∈ edges)
    (hy : y ∈ acc) : x ∈ HE.Bindings.eqStep edges acc := by
  induction edges generalizing acc with
  | nil => simp at hedge
  | cons edge edges ih =>
      rw [eqStep_cons]
      rcases List.mem_cons.mp hedge with rfl | hedge
      · exact mem_eqStep_of_mem (left_mem_edgeUpdate_of_right_mem hy)
      · exact ih hedge (mem_edgeUpdate_of_mem edge hy)

private theorem reachable_of_mem_eqStep_of_subset
    {allEdges edges : List (String × String)} {start v : String}
    (hsub : ∀ ⦃edge⦄, edge ∈ edges → edge ∈ allEdges)
    (hacc : ∀ ⦃u⦄, u ∈ acc → (edgeGraph allEdges).Reachable start u)
    (hv : v ∈ HE.Bindings.eqStep edges acc) :
    (edgeGraph allEdges).Reachable start v := by
  induction edges generalizing acc with
  | nil => exact hacc hv
  | cons edge edges ih =>
      rw [eqStep_cons] at hv
      apply ih (fun _ hedge => hsub (List.mem_cons_of_mem edge hedge))
        (fun _ hu => reachable_of_mem_edgeUpdate
          (hsub (List.mem_cons_self ..)) hacc hu) hv

/-- Every member produced by one saturation pass is graph-reachable from some
member of the input accumulator. -/
theorem reachable_of_mem_eqStep {edges : List (String × String)}
    {start v : String}
    (hacc : ∀ ⦃u⦄, u ∈ acc → (edgeGraph edges).Reachable start u)
    (hv : v ∈ HE.Bindings.eqStep edges acc) :
    (edgeGraph edges).Reachable start v :=
  reachable_of_mem_eqStep_of_subset (fun _ h => h) hacc hv

/-- Saturation never loses an accumulator member. -/
theorem mem_eqClassAux_of_mem {edges : List (String × String)}
    {acc : List String} {v : String} (hv : v ∈ acc) (fuel : Nat) :
    v ∈ HE.Bindings.eqClassAux edges fuel acc := by
  induction fuel generalizing acc with
  | zero => exact hv
  | succ fuel ih =>
      exact ih (mem_eqStep_of_mem hv)

/-- Every member generated by iterated saturation is reachable in the
undirected equality graph. -/
theorem reachable_of_mem_eqClassAux {edges : List (String × String)}
    {start v : String} {fuel : Nat}
    (hacc : ∀ ⦃u⦄, u ∈ acc → (edgeGraph edges).Reachable start u)
    (hv : v ∈ HE.Bindings.eqClassAux edges fuel acc) :
    (edgeGraph edges).Reachable start v := by
  induction fuel generalizing acc with
  | zero => exact hacc hv
  | succ fuel ih =>
      exact ih (fun _ hu => reachable_of_mem_eqStep hacc hu) hv

/-- A walk of length at most the available number of passes has its endpoint
in the saturated accumulator. -/
theorem walk_end_mem_eqClassAux_of_length_le
    {edges : List (String × String)} {start finish : String}
    (walk : (edgeGraph edges).Walk start finish) :
    ∀ {fuel : Nat} {acc : List String},
      walk.length ≤ fuel → start ∈ acc →
      finish ∈ HE.Bindings.eqClassAux edges fuel acc := by
  induction walk with
  | nil =>
      intro fuel acc _ hstart
      exact mem_eqClassAux_of_mem hstart fuel
  | cons hadj tail ih =>
      intro fuel acc hlength hstart
      cases fuel with
      | zero => simp at hlength
      | succ fuel =>
          apply ih (fuel := fuel) (acc := HE.Bindings.eqStep edges acc)
            (by simpa using hlength)
          rcases hadj.2 with hedge | hedge
          · exact right_mem_eqStep_of_left_mem hedge hstart
          · exact left_mem_eqStep_of_right_mem hedge hstart

/-- Production equality-class membership is exactly finite undirected graph
reachability. This is the order-independent semantic account of `eqClass`. -/
theorem mem_eqClass_iff_reachable {b : HE.Bindings} {start finish : String} :
    finish ∈ b.eqClass start ↔
      (edgeGraph b.equalities).Reachable start finish := by
  constructor
  · intro h
    apply reachable_of_mem_eqClassAux (acc := [start])
      (by
        intro u hu
        simp only [List.mem_singleton] at hu
        subst u
        exact .rfl)
    exact h
  · intro h
    obtain ⟨path, hlength⟩ := reachable_has_bounded_path h
    apply walk_end_mem_eqClassAux_of_length_le path.val
      (Nat.le_trans hlength (Nat.le_add_right _ 1))
    simp

private def orderUpdate (acc : List String) (edge : String × String) : List String :=
  let acc := if acc.contains edge.1 then acc else acc ++ [edge.1]
  if acc.contains edge.2 then acc else acc ++ [edge.2]

private theorem mem_orderUpdate_iff {acc : List String} {edge : String × String}
    {v : String} :
    v ∈ orderUpdate acc edge ↔ v ∈ acc ∨ v = edge.1 ∨ v = edge.2 := by
  rcases edge with ⟨x, y⟩
  simp only [orderUpdate]
  split <;> split <;> simp_all <;> aesop

private theorem mem_orderFold_iff (edges : List (String × String))
    (acc : List String) (v : String) :
    v ∈ edges.foldl orderUpdate acc ↔
      v ∈ acc ∨ v ∈ edgeNodes edges := by
  induction edges generalizing acc with
  | nil => simp [edgeNodes]
  | cons edge edges ih =>
      rw [List.foldl_cons, ih, mem_orderUpdate_iff]
      rcases edge with ⟨x, y⟩
      simp [edgeNodes, or_assoc, or_left_comm, or_comm]

/-- Representative-order membership is exactly occurrence as an equality-edge
endpoint. -/
theorem mem_eqVarsInOrder_iff {b : HE.Bindings} {v : String} :
    v ∈ b.eqVarsInOrder ↔ v ∈ edgeNodes b.equalities := by
  unfold HE.Bindings.eqVarsInOrder
  change v ∈ b.equalities.foldl orderUpdate [] ↔ _
  simpa using mem_orderFold_iff b.equalities [] v

private theorem reachable_ne_endpoints_mem_edgeNodes
    {edges : List (String × String)} {start finish : String}
    (hne : start ≠ finish)
    (hreach : (edgeGraph edges).Reachable start finish) :
    start ∈ edgeNodes edges ∧ finish ∈ edgeNodes edges := by
  apply hreach.elim
  intro walk
  cases walk with
  | nil => exact (hne rfl).elim
  | @cons start next finish hadj tail =>
      refine ⟨(adj_endpoints_mem_edgeNodes hadj).1, ?_⟩
      have hfinish : finish ∈ start :: edgeNodes edges :=
        walk_support_subset_start_edgeNodes (SimpleGraph.Walk.cons hadj tail)
          (SimpleGraph.Walk.end_mem_support _)
      rcases List.mem_cons.mp hfinish with hfinish | hfinish
      · exact (hne hfinish.symm).elim
      · exact hfinish

/-- Every reachable member appears in the stable ordered class, and no other
variable does. -/
theorem mem_eqClassOrdered_iff {b : HE.Bindings} {start finish : String} :
    finish ∈ b.eqClassOrdered start ↔ finish ∈ b.eqClass start := by
  unfold HE.Bindings.eqClassOrdered
  generalize hfiltered :
      b.eqVarsInOrder.filter (fun w => (b.eqClass start).contains w) = filtered
  cases filtered with
  | nil =>
      simp only [List.mem_singleton]
      constructor
      · rintro rfl
        rw [mem_eqClass_iff_reachable]
      · intro hclass
        by_contra hne
        have hne' : start ≠ finish := fun h => hne h.symm
        have hedge : finish ∈ edgeNodes b.equalities :=
          (reachable_ne_endpoints_mem_edgeNodes hne'
            (mem_eqClass_iff_reachable.mp hclass)).2
        have horder : finish ∈ b.eqVarsInOrder := mem_eqVarsInOrder_iff.mpr hedge
        have hmemFilter : finish ∈
            b.eqVarsInOrder.filter (fun w => (b.eqClass start).contains w) := by
          simp [horder, hclass]
        rw [hfiltered] at hmemFilter
        simp at hmemFilter
  | cons first rest =>
      constructor
      · intro hmem
        have hmem' : finish ∈
            b.eqVarsInOrder.filter (fun w => (b.eqClass start).contains w) := by
          rw [hfiltered]
          exact hmem
        simpa using (List.mem_filter.mp hmem').2
      · intro hclass
        have horder : finish ∈ b.eqVarsInOrder := by
          by_cases hEq : start = finish
          · subst finish
            have hfirst : first ∈
                b.eqVarsInOrder.filter (fun w => (b.eqClass start).contains w) := by
              rw [hfiltered]
              simp
            have hfirstOrder : first ∈ b.eqVarsInOrder :=
              (List.mem_filter.mp hfirst).1
            have hfirstClass : first ∈ b.eqClass start := by
              simpa using (List.mem_filter.mp hfirst).2
            by_cases hsf : start = first
            · simpa [hsf] using hfirstOrder
            · exact mem_eqVarsInOrder_iff.mpr
                (reachable_ne_endpoints_mem_edgeNodes hsf
                  (mem_eqClass_iff_reachable.mp hfirstClass)).1
          · exact mem_eqVarsInOrder_iff.mpr
              (reachable_ne_endpoints_mem_edgeNodes hEq
                (mem_eqClass_iff_reachable.mp hclass)).2
        have hmem' : finish ∈
            b.eqVarsInOrder.filter (fun w => (b.eqClass start).contains w) := by
          exact List.mem_filter.mpr ⟨horder, by simpa using hclass⟩
        rw [hfiltered] at hmem'
        exact hmem'

/-- Starting saturation from two connected variables gives extensionally the
same equality class. -/
theorem eqClass_mem_iff_of_reachable {b : HE.Bindings} {left right v : String}
    (hreach : (edgeGraph b.equalities).Reachable left right) :
    v ∈ b.eqClass left ↔ v ∈ b.eqClass right := by
  rw [mem_eqClass_iff_reachable, mem_eqClass_iff_reachable]
  constructor
  · exact fun hv => hreach.symm.trans hv
  · exact fun hv => hreach.trans hv

/-- Connected variables have one canonical stable ordered class. -/
theorem eqClassOrdered_eq_of_reachable {b : HE.Bindings} {left right : String}
    (hreach : (edgeGraph b.equalities).Reachable left right) :
    b.eqClassOrdered left = b.eqClassOrdered right := by
  have hcontains : ∀ v,
      (b.eqClass left).contains v = (b.eqClass right).contains v := by
    intro v
    rw [Bool.eq_iff_iff, List.contains_iff_mem, List.contains_iff_mem]
    exact eqClass_mem_iff_of_reachable hreach
  have hfilter :
      b.eqVarsInOrder.filter (fun v => (b.eqClass left).contains v) =
        b.eqVarsInOrder.filter (fun v => (b.eqClass right).contains v) := by
    apply List.filter_congr
    intro v _
    exact hcontains v
  unfold HE.Bindings.eqClassOrdered
  rw [hfilter]
  generalize hfiltered :
      b.eqVarsInOrder.filter (fun v => (b.eqClass right).contains v) = filtered
  cases filtered with
  | nil =>
      by_cases hlr : left = right
      · simp [hlr]
      · exfalso
        have hleftEdge : left ∈ edgeNodes b.equalities :=
          (reachable_ne_endpoints_mem_edgeNodes hlr hreach).1
        have hleftOrder : left ∈ b.eqVarsInOrder :=
          mem_eqVarsInOrder_iff.mpr hleftEdge
        have hleftClass : left ∈ b.eqClass right := by
          rw [mem_eqClass_iff_reachable]
          exact hreach.symm
        have hleftFilter : left ∈
            b.eqVarsInOrder.filter (fun v => (b.eqClass right).contains v) := by
          exact List.mem_filter.mpr ⟨hleftOrder, by simpa using hleftClass⟩
        rw [hfiltered] at hleftFilter
        simp at hleftFilter
  | cons first rest => rfl

/-- All direct values observed from connected variables use the same stable
class ordering. -/
theorem classValues_eq_of_reachable {b : HE.Bindings} {left right : String}
    (hreach : (edgeGraph b.equalities).Reachable left right) :
    b.classValues left = b.classValues right := by
  unfold HE.Bindings.classValues
  rw [eqClassOrdered_eq_of_reachable hreach]

end Mettapedia.Languages.MeTTa.HE.EqualityClosure
