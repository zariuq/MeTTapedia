import MettaHyperonFull.Proofs.TypeSoundness
import MettaHyperonFull.Proofs.BindingLaws
import MettaHyperonFull.Proofs.Substitution

/-!
# Operator-head type-cast freshness counterexample

Expected application selection protects variables in the complete application,
but the subsequent operator-head `mettaTypeCast` rebuilds its private candidate
family without that outer scope.  A live generated variable in an argument can
therefore be reused by a rejected overload, become bound while the selected
arrow is checked, and survive the caller-visible projection.

The witness is stated entirely at the runtime API carrier.  Source syntax need
not be able to spell the generated name: generated identities can re-enter
later evaluator calls through live atoms and bindings.
-/

namespace Mettapedia.Languages.MeTTa.HE.LeaTTaOperatorHeadFreshnessCounterexample

open Metta Metta.Minimal

private def earlierArrow : Atom :=
  .expr [.sym "->", .sym "A", .var "u"]

private def selectedArrow : Atom :=
  .expr [.sym "->", .sym "%Undefined%", .sym "C"]

private def argumentArrow : Atom :=
  .expr [.sym "->", .sym "%Undefined%", .sym "B"]

private def env : MinEnv :=
  MinEnv.ofAtomsGT
    [ .expr [.sym ":", .sym "f", earlierArrow]
    , .expr [.sym ":", .sym "f", selectedArrow]
    , .expr [.sym ":", .sym "g", argumentArrow] ]
    []

private def headAvoid : List VarName :=
  typeCastInferenceAvoid env (.sym "f") (.sym "f") selectedArrow []
    (getTypes env (.sym "f"))

private def collision : VarName :=
  captureAvoidingName headAvoid 0 "u"

private def collidingArgument : Atom :=
  .expr [.sym "g", .var collision]

private def safeArgument : Atom :=
  .expr [.sym "g", .var "safe"]

private theorem functionTypes :
    getTypes env (.sym "f") = [earlierArrow, selectedArrow] := by
  rw [getTypes.eq_8]
  simp [env, earlierArrow, selectedArrow, argumentArrow, MinEnv.ofAtomsGT,
    Std.HashMap.getD_insert, Std.HashMap.getD_emptyWithCapacity]

private theorem argumentFunctionTypes :
    getTypes env (.sym "g") = [argumentArrow] := by
  rw [getTypes.eq_8]
  simp [env, earlierArrow, selectedArrow, argumentArrow, MinEnv.ofAtomsGT,
    Std.HashMap.getD_insert, Std.HashMap.getD_emptyWithCapacity]

private theorem headAvoid_eq : headAvoid = ["u", "u"] := by
  change typeCastInferenceAvoid env (.sym "f") (.sym "f") selectedArrow []
    (getTypes env (.sym "f")) = ["u", "u"]
  have emptyVars : Bindings.vars [] = [] := rfl
  rw [functionTypes]
  simp [typeCastInferenceAvoid, typeInferenceAvoid, env, earlierArrow,
    selectedArrow, argumentArrow, MinEnv.ofAtomsGT, Metta.Atom.vars,
    emptyVars]

/-- The omitted application variable is exactly the private name generated by
the later head cast. -/
theorem collision_eq : collision = "###u#0" := by
  rw [collision, headAvoid_eq]
  rfl

private def protectedHeadScope : List VarName :=
  expectedApplicationVisibleScope
    (.expr [.sym "f", collidingArgument]) (.sym "C")

private def protectedHeadAvoid : List VarName :=
  protectedHeadScope ++ headAvoid

private def protectedFresh : VarName :=
  captureAvoidingName protectedHeadAvoid 0 "u"

private theorem protectedHeadScope_eq : protectedHeadScope = [collision] := by
  simp [protectedHeadScope, expectedApplicationVisibleScope,
    collidingArgument, Metta.Atom.vars, List.eraseDups,
    List.eraseDupsBy, List.eraseDupsBy.loop, collision_eq]

private theorem protectedFresh_eq : protectedFresh = "#########u#0" := by
  rw [protectedFresh, protectedHeadAvoid, protectedHeadScope_eq,
    headAvoid_eq, collision_eq]
  rfl

private theorem freshenUndefined (avoid : List VarName) :
    freshenArgumentTypes avoid 0 [.sym "%Undefined%"] =
      [.sym "%Undefined%"] := by
  simp [freshenArgumentTypes, freshenTypeCandidate, renameAllVars]

private theorem freshenArgumentArrow (avoid : List VarName) (position : Nat) :
    freshenTypeCandidate avoid position argumentArrow = argumentArrow := by
  simp [freshenTypeCandidate, argumentArrow, renameAllVars]

/-- The argument still has the ground type that rejects the earlier overload
and selects the second one. -/
theorem collidingArgument_types :
    getTypes env collidingArgument = [.sym "B"] := by
  have direct : env.exprTypes.filter
      (fun pair => pair.1 == .expr [.sym "g", .var collision]) = [] := by
    rfl
  have variableTypes : getTypes env (.var collision) = [.sym "%Undefined%"] :=
    getTypes.eq_7 env collision
  rw [show collidingArgument = .expr [.sym "g", .var collision] from rfl,
    getTypes.eq_10 env (.sym "g") [.var collision] (by simp)]
  rw [direct]
  dsimp only
  simp only [argumentFunctionTypes]
  simp only [List.map, List.cons_append, List.nil_append,
    List.length_cons, List.length_nil, Nat.reduceAdd]
  rw [variableTypes]
  unfold List.filterMap
  simp [argumentArrow, cartesian, freshenArgumentTypes, freshenTypeCandidate,
    renameAllVars, matchApplicationTypeArguments, matchType_undefined_left,
    instantiate, Bindings.resolveAtom]

private theorem collidingArgument_prep :
    typePrep World.empty collidingArgument = collidingArgument := by
  simp [typePrep, subTokens, wrapStates, World.empty, collidingArgument]

private def selectionBoundaryScope : List VarName :=
  applicationTypeInferenceScope (.sym "C") [collidingArgument]

private def selectionAvoid : List VarName :=
  functionTypeSelectionAvoiding env (.expr [.sym "f", collidingArgument])
    [collidingArgument] (.sym "C") [] [earlierArrow, selectedArrow]

private def freshEarlierArrow : Atom :=
  .expr [.sym "->", .sym "A", .var (captureAvoidingName selectionAvoid 1 "u")]

private theorem freshenedSelectionCandidates :
    freshenFunctionTypeCandidatesAvoiding env
        (.expr [.sym "f", collidingArgument]) [collidingArgument]
        (.sym "C") [] [earlierArrow, selectedArrow] =
      [freshEarlierArrow, selectedArrow] := by
  simp [freshenFunctionTypeCandidatesAvoiding, selectionAvoid,
    freshEarlierArrow, earlierArrow, selectedArrow, freshenTypeCandidate,
    renameAllVars]

private theorem earlierArgumentBranches :
    typeCheckArgsBranchesScoped env World.empty [.sym "A"]
        selectionBoundaryScope 0 [] [collidingArgument] =
      ⟨[], [{ position := 1, expected := .sym "A", actual := .sym "B" }]⟩ := by
  have mismatch : matchType [] (.sym "A") (.sym "B") = none := rfl
  simp [typeCheckArgsBranchesScoped, collidingArgument_prep,
    collidingArgument_types, freshenTypeCandidate, renameAllVars,
    scanActualTypeBranches, mismatch, instantiate, Bindings.resolveAtom]

private theorem selectedArgumentBranches :
    typeCheckArgsBranchesScoped env World.empty [.sym "%Undefined%"]
        selectionBoundaryScope 0 [] [collidingArgument] =
      ⟨[[]], []⟩ := by
  simp [typeCheckArgsBranchesScoped, collidingArgument_prep,
    collidingArgument_types, freshenTypeCandidate, renameAllVars,
    scanActualTypeBranches, matchType_undefined_left]

/-- Selection is sound in isolation: the rejected polymorphic overload does
not contribute a binding, and the selected arrow is ground. -/
theorem selected_before_head_cast :
    selectFunctionTypeForExpected env World.empty (.sym "f")
        [collidingArgument] (.sym "C") =
      .selected
        { functionType := selectedArrow
          argumentTypes := [.sym "%Undefined%"]
          returnType := .sym "C"
          typeBindings := [] } := by
  have hprepF : typePrep World.empty (.sym "f") = .sym "f" := by
    simp [typePrep, subTokens.eq_1, wrapStates.eq_3, World.empty]
  simp only [selectFunctionTypeForExpected,
    selectFunctionTypeForExpectedAvoiding]
  rw [hprepF, functionTypes]
  rw [freshenedSelectionCandidates]
  change scanFunctionTypeCandidatesForExpected env World.empty
    (.expr [.sym "f", collidingArgument]) [collidingArgument] (.sym "C")
      false [freshEarlierArrow, selectedArrow] = _
  simp only [scanFunctionTypeCandidatesForExpected, freshEarlierArrow,
    selectedArrow, List.length_cons, List.length_nil, Nat.reduceAdd,
    Bool.false_or, List.getLast?, List.dropLast]
  rw [show applicationTypeInferenceScope (.sym "C") [collidingArgument] =
      selectionBoundaryScope from rfl]
  rw [earlierArgumentBranches, selectedArgumentBranches]
  have cMatchesC : matchType [] (.sym "C") (.sym "C") = some [] := rfl
  rfl

private theorem selectedArrow_matches_fresh_earlier (freshName : VarName) :
    matchType [] selectedArrow
        (.expr [.sym "->", .sym "A", .var freshName]) =
      some [.val freshName (.sym "C")] := by
  have hloop : Bindings.hasLoop [.val freshName (.sym "C")] = false :=
    Bindings.hasLoop_singleton_val_of_not_mem _ _
      (by simp [Metta.Atom.vars])
  have leafMatch :
      matchReduced [] (.sym "C") (.var freshName) =
        some [.val freshName (.sym "C")] := by
    have rawMatch : Metta.matchAtoms (.sym "C") (.var freshName) =
        [[.val freshName (.sym "C")]] := by
      simp [Metta.matchAtoms, Metta.matchAtomsWith, Subst.occurs, hloop]
    have merged : Bindings.merge [] [.val freshName (.sym "C")] =
        [[.val freshName (.sym "C")]] := by
      simp [Bindings.merge, Bindings.mergeOne,
        Bindings.addVarBinding_fresh, Bindings.classValues,
        Bindings.lookupVal, Bindings.addValRaw, Bindings.removeVal]
    simp [matchReduced, rawMatch, merged, hloop,
      Metta.Atom.beq, BEq.beq]
  have headMatch :
      matchReduced [] (.sym "->") (.sym "->") = some [] := by
    rfl
  have undefinedMatch :
      matchReduced [] (.sym "%Undefined%") (.sym "A") = some [] := by
    simp [matchReduced, Metta.Atom.beq, BEq.beq]
  have arrowReduced :
      matchReduced [] selectedArrow
          (.expr [.sym "->", .sym "A", .var freshName]) =
        some [.val freshName (.sym "C")] := by
    rw [show selectedArrow =
      .expr [.sym "->", .sym "%Undefined%", .sym "C"] from rfl]
    rw [matchReduced]
    simp only [Metta.Atom.beq, BEq.beq, Bool.false_or]
    simp only [Bool.false_eq_true, if_false]
    change (match matchReduced [] (.sym "->") (.sym "->") with
      | some tb => matchReducedList tb [.sym "%Undefined%", .sym "C"]
          [.sym "A", .var freshName]
      | none => none) = _
    rw [headMatch]
    change (match matchReduced [] (.sym "%Undefined%") (.sym "A") with
      | some tb => matchReducedList tb [.sym "C"] [.var freshName]
      | none => none) = _
    rw [undefinedMatch]
    change (match matchReduced [] (.sym "C") (.var freshName) with
      | some tb => matchReducedList tb [] []
      | none => none) = _
    rw [leafMatch]
    rfl
  rw [matchType]
  simp only [selectedArrow, Metta.Atom.beq, BEq.beq, Bool.false_or]
  exact arrowReduced

/-- The separately freshened head candidate reuses the live argument spelling
and the operator cast binds it to `C`. -/
theorem head_cast_captures_argument_variable :
    mettaTypeCast env World.empty [] (.sym "f") selectedArrow =
      .inr [.val collision (.sym "C")] := by
  have hprepF : typePrep World.empty (.sym "f") = .sym "f" := by
    simp [typePrep, subTokens.eq_1, wrapStates.eq_3, World.empty]
  have freshened :
      freshenArgumentTypes headAvoid 0 [earlierArrow, selectedArrow] =
        [.expr [.sym "->", .sym "A", .var collision], selectedArrow] := by
    have generated : captureAvoidingName ["u", "u"] 0 "u" = collision := by
      rw [collision_eq]
      rfl
    rw [headAvoid_eq]
    simp [freshenArgumentTypes, freshenTypeCandidate, renameAllVars,
      earlierArrow, selectedArrow, generated]
  have arrowMatch := selectedArrow_matches_fresh_earlier collision
  have avoidEq :
      typeCastInferenceAvoid env (.sym "f") (.sym "f") selectedArrow []
          [earlierArrow, selectedArrow] = headAvoid := by
    rw [headAvoid, functionTypes]
  unfold mettaTypeCast mettaTypeCastAvoiding
  dsimp only
  rw [hprepF, functionTypes]
  simp only [List.nil_append]
  rw [avoidEq, freshened]
  simp only [matchExpectedType, arrowMatch]

/-- The repaired operator-head entry localizes the rejected overload away
from the complete application scope.  The cast still succeeds, but its one
assignment is private rather than reusing the live argument variable. -/
theorem protected_head_cast_avoids_argument_variable :
    mettaTypeCastAvoiding protectedHeadScope env World.empty []
        (.sym "f") selectedArrow =
      .inr [.val protectedFresh (.sym "C")] := by
  have hprepF : typePrep World.empty (.sym "f") = .sym "f" := by
    simp [typePrep, subTokens.eq_1, wrapStates.eq_3, World.empty]
  have localAvoid :
      typeCastInferenceAvoid env (.sym "f") (.sym "f") selectedArrow []
          [earlierArrow, selectedArrow] = headAvoid := by
    rw [headAvoid, functionTypes]
  have fullAvoid :
      protectedHeadScope ++
          typeCastInferenceAvoid env (.sym "f") (.sym "f") selectedArrow []
            [earlierArrow, selectedArrow] = protectedHeadAvoid := by
    rw [localAvoid]
    rfl
  have freshened :
      freshenArgumentTypes protectedHeadAvoid 0
          [earlierArrow, selectedArrow] =
        [.expr [.sym "->", .sym "A", .var protectedFresh], selectedArrow] := by
    simp [freshenArgumentTypes, freshenTypeCandidate, renameAllVars,
      earlierArrow, selectedArrow, protectedFresh, protectedHeadAvoid]
  have arrowMatch := selectedArrow_matches_fresh_earlier protectedFresh
  unfold mettaTypeCastAvoiding
  dsimp only
  rw [hprepF, functionTypes, fullAvoid, freshened]
  simp only [matchExpectedType, arrowMatch]

/-- The repaired private spelling differs from the caller-visible variable
that triggered the legacy capture. -/
theorem protected_fresh_not_visible : protectedFresh ≠ collision := by
  rw [protectedFresh_eq, collision_eq]
  decide

/-- The outer application scope observes the accidental binding, so the
post-cast projection does not make this capture private. -/
theorem captured_binding_survives_visible_projection :
    selectedApplicationInitialBindingsFromTheory []
        (.expr [.sym "f", collidingArgument]) (.sym "C")
        [.val collision (.sym "C")] =
      [[.val collision (.sym "C")]] := by
  have scopeEq :
      expectedApplicationVisibleScope
          (.expr [.sym "f", collidingArgument]) (.sym "C") = [collision] := by
    simp [expectedApplicationVisibleScope, collidingArgument,
      Metta.Atom.vars, List.eraseDups, List.eraseDupsBy,
      List.eraseDupsBy.loop, collision_eq]
  have instantiated :
      instantiate [.val collision (.sym "C")] (.var collision) = .sym "C" :=
    instantiate_singleton_val_var_of_not_mem collision (.sym "C")
      (by simp [Metta.Atom.vars])
  have resolved :
      resolveAtom [.val collision (.sym "C")] 2 (.var collision) = .sym "C" := by
    rw [resolveAtom, instantiated]
    have different : ((.sym "C" : Atom) == .var collision) = false := rfl
    rw [different, resolveAtom]
    have closed : instantiate [.val collision (.sym "C")] (.sym "C") =
        .sym "C" := by
      exact instantiate_of_closed _ _ (by simp [Metta.Atom.vars])
    rw [closed]
    have same : ((.sym "C" : Atom) == .sym "C") = true := rfl
    rw [same]
    simp
  have raw :
      restrictBndRaw [collision] [.val collision (.sym "C")] =
        [.val collision (.sym "C")] := by
    unfold restrictBndRaw
    simp only [List.filterMap_cons, List.filterMap_nil, List.length_cons,
      List.length_nil, Nat.reduceAdd]
    rw [resolved]
    simp
  have merged : Bindings.merge [] [.val collision (.sym "C")] =
      [[.val collision (.sym "C")]] := by
    simp [Bindings.merge, Bindings.mergeOne,
      Bindings.addVarBinding_fresh, Bindings.classValues,
      Bindings.lookupVal, Bindings.addValRaw, Bindings.removeVal]
  have restricted : restrictBnd [collision] [.val collision (.sym "C")] =
      [.val collision (.sym "C")] := by
    rw [restrictBnd, raw, merged]
    rfl
  rw [selectedApplicationInitialBindingsFromTheory, scopeEq, restricted,
    merged]

/-- Kernel-checked causal chain: selection is collision-free, the subsequent
head cast creates the collision, and the caller-visible projection retains it. -/
theorem operator_head_freshness_counterexample :
    selectFunctionTypeForExpected env World.empty (.sym "f")
        [collidingArgument] (.sym "C") =
      .selected
        { functionType := selectedArrow
          argumentTypes := [.sym "%Undefined%"]
          returnType := .sym "C"
          typeBindings := [] } ∧
    mettaTypeCast env World.empty [] (.sym "f") selectedArrow =
      .inr [.val collision (.sym "C")] ∧
    selectedApplicationInitialBindingsFromTheory []
        (.expr [.sym "f", collidingArgument]) (.sym "C")
        [.val collision (.sym "C")] =
      [[.val collision (.sym "C")]] :=
  ⟨selected_before_head_cast, head_cast_captures_argument_variable,
    captured_binding_survives_visible_projection⟩

/-- Negative canary: a noncolliding public variable does not retain the
head-cast private assignment. -/
theorem noncolliding_argument_does_not_expose_head_private :
    selectedApplicationInitialBindingsFromTheory []
        (.expr [.sym "f", safeArgument]) (.sym "C")
        [.val collision (.sym "C")] = [[]] := by
  have different : "safe" ≠ collision := by
    rw [collision_eq]
    decide
  have scopeEq :
      expectedApplicationVisibleScope
          (.expr [.sym "f", safeArgument]) (.sym "C") = ["safe"] := by
    simp [expectedApplicationVisibleScope, safeArgument, Metta.Atom.vars,
      List.eraseDups, List.eraseDupsBy, List.eraseDupsBy.loop]
  have inert :
      instantiate [.val collision (.sym "C")] (.var "safe") =
        .var "safe" :=
    instantiate_singleton_val_inert collision (.sym "C") (.var "safe")
      (by simpa [Metta.Atom.vars] using different.symm)
  have resolved :
      resolveAtom [.val collision (.sym "C")] 2 (.var "safe") =
        .var "safe" := by
    rw [resolveAtom, inert]
    have same : ((.var "safe" : Atom) == .var "safe") = true := rfl
    rw [same]
    simp
  have raw : restrictBndRaw ["safe"] [.val collision (.sym "C")] = [] := by
    unfold restrictBndRaw
    simp only [List.filterMap_cons, List.filterMap_nil, List.length_cons,
      List.length_nil, Nat.reduceAdd]
    rw [resolved]
    simp
  have restricted : restrictBnd ["safe"] [.val collision (.sym "C")] = [] := by
    rw [restrictBnd, raw]
    rfl
  rw [selectedApplicationInitialBindingsFromTheory, scopeEq, restricted]
  rfl

end Mettapedia.Languages.MeTTa.HE.LeaTTaOperatorHeadFreshnessCounterexample
