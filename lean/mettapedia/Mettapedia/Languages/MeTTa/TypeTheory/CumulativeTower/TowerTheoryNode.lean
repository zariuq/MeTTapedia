import Mettapedia.GSLT.LanguageDef.TheoryGraphModels
import Mettapedia.Languages.MeTTa.TypeTheory.CumulativeTower.CwfInhabitationInstitution

/-!
# The cumulative tower as a dependent node with a satisfying model

The cumulative-tower syntax is a CwF; its global-inhabitation institution is
a logical readout of that syntax.  This module places it in the theory graph
over model-valued institutions: the node is the closed theory generated by
the universe sentence `U₁` at the empty telescope, and the identity global
substitution is a satisfying model of it, witnessed by `U₀ : U₁`.

No arrow from the simple-families node into this node is constructed here:
the tower's contexts are native telescopes, not the sets of the families
CwF, and a comorphism between them is a separate construction.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.MeTTa.TypeTheory.CumulativeTower.TowerTheoryNode

open Mettapedia.GSLT.LanguageDef.NIKMetalogic
open Mettapedia.GSLT.LanguageDef.TheoryGraphModels
open Mettapedia.Languages.MeTTa.TypeTheory.CumulativeTower.CwfInhabitationInstitution

/-- The dependent node: the tower's inhabitation institution with the theory
generated by the universe sentence. -/
def towerNode :=
  Node.mk' towerInstitutionObject
    (PiInstitution.generatedTheory _ emptySignature {universeOneSentence})

/-- The identity global substitution satisfies the node's theory. -/
theorem emptyGlobal_satisfies : Satisfies towerNode emptyGlobal :=
  (satisfies_generated_iff towerInstitutionObject emptySignature _ emptyGlobal).2
    (fun sentence membership => by
      have equal : sentence = universeOneSentence := membership
      subst equal
      exact universeOne_satisfied)

/-- The tower's own syntax as a satisfying model of its universe node. -/
def towerModel : Model towerNode :=
  ⟨emptyGlobal, emptyGlobal_satisfies⟩

/-- The universe sentence is a theorem of the node. -/
theorem universeOne_mem_towerNode : universeOneSentence ∈ towerNode.theory.theory.1 :=
  ((Mettapedia.GSLT.LanguageDef.InstitutionConsequence.consequenceProjection
    towerInstitution).consequence emptySignature).le_closure _ (Set.mem_singleton _)

#print axioms towerNode
#print axioms emptyGlobal_satisfies
#print axioms universeOne_mem_towerNode

end Mettapedia.Languages.MeTTa.TypeTheory.CumulativeTower.TowerTheoryNode
