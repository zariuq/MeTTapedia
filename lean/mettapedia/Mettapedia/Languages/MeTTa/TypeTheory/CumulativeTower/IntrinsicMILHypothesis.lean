      · exact .sorts hypothesisLevel eliminationLevel
    · exact .sort eliminateAfterHypothesisLevel
    · exact .sorts sortLevel eliminateAfterHypothesisLevel
  · exact .sort eliminateAfterTargetLevel
  · exact .sorts sortLevel eliminateAfterTargetLevel

def eliminateAfterChainCaseLevel : LevelExpr :=
  .max chainCaseLevel eliminateResultLevel

def eliminateAfterPrimitiveCaseLevel : LevelExpr :=
  .max primitiveCaseLevel eliminateAfterChainCaseLevel

def eliminateAfterMotiveLevel : LevelExpr :=
  .max motiveDeclarationLevel eliminateAfterPrimitiveCaseLevel

def eliminateAfterPrimitiveLevel : LevelExpr :=
  .max primitiveFamilyTypeLevel eliminateAfterMotiveLevel

def eliminateDeclarationLevel : LevelExpr :=
  .max (.succ sortLevel) eliminateAfterPrimitiveLevel

theorem eliminateType_hasType :
    HasType (.nil : Tower.Ctx 0) eliminateType
      (sortTm eliminateDeclarationLevel) := by
  unfold eliminateType eliminateDeclarationLevel eliminateAfterPrimitiveLevel
    eliminateAfterMotiveLevel eliminateAfterPrimitiveCaseLevel
    eliminateAfterChainCaseLevel
  apply Presentation.HasType.piForm
  · exact .headType (.sort sortLevel)
  · exact .sort (.succ sortLevel)
  · apply Presentation.HasType.piForm
    · exact includeTowerTyping primitiveFamilyType_hasType
    · exact .sort primitiveFamilyTypeLevel
    · apply Presentation.HasType.piForm
      · exact motiveType_hasType
      · exact .sort motiveDeclarationLevel
      · apply Presentation.HasType.piForm
        · exact primitiveCaseType_hasType
        · exact .sort primitiveCaseLevel
        · apply Presentation.HasType.piForm
          · exact chainCaseType_hasType
          · exact .sort chainCaseLevel
          · exact eliminateResultType_hasType
          · exact .sort eliminateResultLevel
          · exact .sorts chainCaseLevel eliminateResultLevel
        · exact .sort eliminateAfterChainCaseLevel
        · exact .sorts primitiveCaseLevel eliminateAfterChainCaseLevel
      · exact .sort eliminateAfterPrimitiveCaseLevel
      · exact .sorts motiveDeclarationLevel
          eliminateAfterPrimitiveCaseLevel
    · exact .sort eliminateAfterMotiveLevel
    · exact .sorts primitiveFamilyTypeLevel eliminateAfterMotiveLevel
  · exact .sort eliminateAfterPrimitiveLevel
  · exact .sorts (.succ sortLevel) eliminateAfterPrimitiveLevel

/-! ## Formed signature -/

@[simp] theorem rawSignature_valueOf_none (name : DeclName) :
    rawSignature.valueOf? name = none := by
  by_cases isHypothesis : name = hypothesisName
  · subst name
    simp [rawSignature, Signature.valueOf?, hypothesisEntry]
  by_cases isPrimitive : name = primitiveName
  · subst name
    simp [rawSignature, Signature.valueOf?, primitiveEntry, isHypothesis]
  by_cases isChain : name = chainName
  · subst name
    simp [rawSignature, Signature.valueOf?, chainEntry, isHypothesis,
      isPrimitive]
  by_cases isEliminate : name = eliminateName
  · subst name
    simp [rawSignature, Signature.valueOf?, eliminateEntry, isHypothesis,
      isPrimitive, isChain]
  · simp [rawSignature, Signature.valueOf?, isHypothesis, isPrimitive,
      isChain, isEliminate]

theorem rawSignature_types_formed {name : DeclName} {type : Tower.Tm 0}
    (lookup : rawSignature.typeOf? name = some type) :
    ∃ level : Tower.Head,
      Tower.rules.isUniverse level ∧
      HasType (.nil : Tower.Ctx 0) type (.head level) := by
  by_cases isHypothesis : name = hypothesisName
  · subst name
    have typeEquality : type = hypothesisType := by simpa using lookup.symm
    subst type
    exact ⟨.sort hypothesisDeclarationLevel,
      .sort hypothesisDeclarationLevel,
      includeTowerTyping hypothesisType_hasType⟩
  by_cases isPrimitive : name = primitiveName
  · subst name
    have typeEquality : type = primitiveType := by simpa using lookup.symm
    subst type
    exact ⟨.sort primitiveDeclarationLevel, .sort primitiveDeclarationLevel,
      primitiveType_hasType⟩
  by_cases isChain : name = chainName
  · subst name
    have typeEquality : type = chainType := by simpa using lookup.symm
    subst type
    exact ⟨.sort chainDeclarationLevel, .sort chainDeclarationLevel,
      chainType_hasType⟩
  by_cases isEliminate : name = eliminateName
  · subst name
    have typeEquality : type = eliminateType := by simpa using lookup.symm
    subst type
    exact ⟨.sort eliminateDeclarationLevel, .sort eliminateDeclarationLevel,
      eliminateType_hasType⟩
  · simp [rawSignature, Signature.typeOf?, isHypothesis, isPrimitive,
      isChain, isEliminate] at lookup

theorem rawSignature_fresh {name : DeclName} {entry : Entry Tower.Head}
    (_lookup : rawSignature.entries name = some entry) :
    Tower.rules.constantType name = none :=
  rfl

def rawSignature_formed : rawSignature.Formed Tower.rules where
  fresh := rawSignature_fresh
  types := rawSignature_types_formed
  values := by
    intro name type value _typeLookup valueLookup
    rw [rawSignature_valueOf_none] at valueLookup
    cases valueLookup
  noSelfDelta := by
    intro name value valueLookup
    rw [rawSignature_valueOf_none] at valueLookup
    cases valueLookup

/-! ## Structural strict positivity -/

def freePrimitiveFamilyType : FreeOf hypothesisName primitiveFamilyType := by
  unfold primitiveFamilyType
  exact .pi (.var 0) (.pi (.var 1) (.head _))

def freePrimitiveApplication {primitives source target : Tower.Tm n}
    (primitivesFree : FreeOf hypothesisName primitives)
    (sourceFree : FreeOf hypothesisName source)
    (targetFree : FreeOf hypothesisName target) :
    FreeOf hypothesisName (.app (.app primitives source) target) :=
  .app (.app primitivesFree sourceFree) targetFree

def hypothesisFamilyApplication
    (sorts primitives source target : Tower.Tm n)
    (sortsFree : FreeOf hypothesisName sorts)
    (primitivesFree : FreeOf hypothesisName primitives)
    (sourceFree : FreeOf hypothesisName source)
    (targetFree : FreeOf hypothesisName target) :
    FamilyApplication hypothesisName 4
      (hypothesisApp sorts primitives source target) :=
  .intro [sorts, primitives, source, target] rfl (by
    intro argument membership
    simp only [List.mem_cons, List.not_mem_nil, or_false] at membership
    rcases membership with rfl | rfl | rfl | rfl
    · exact sortsFree
    · exact primitivesFree
    · exact sourceFree
    · exact targetFree) rfl

def primitiveConstructorPositive :
    ConstructorType hypothesisName 4 primitiveType := by
  unfold primitiveType primitiveBodyType
  exact .field (.free (.head _))
    (.field (.free freePrimitiveFamilyType)
      (.field (.free (.var 1))
        (.field (.free (.var 2))
          (.field
            (.free
              (freePrimitiveApplication (.var 2) (.var 1) (.var 0)))
            (.result
              (hypothesisFamilyApplication (.var 4) (.var 3)
                (.var 2) (.var 1) (.var 4) (.var 3) (.var 2)
                (.var 1)))))))

def chainConstructorPositive :
    ConstructorType hypothesisName 4 chainType := by
  unfold chainType chainBodyType
  exact .field (.free (.head _))
    (.field (.free freePrimitiveFamilyType)
      (.field (.free (.var 1))
        (.field (.free (.var 2))
          (.field (.free (.var 3))
            (.field
              (.recursive
                (hypothesisFamilyApplication (.var 4) (.var 3)
                  (.var 2) (.var 1) (.var 4) (.var 3) (.var 2)
                  (.var 1)))
              (.field
                (.recursive
                  (hypothesisFamilyApplication (.var 5) (.var 4)
                    (.var 2) (.var 1) (.var 5) (.var 4) (.var 2)
                    (.var 1)))
                (.result
                  (hypothesisFamilyApplication (.var 6) (.var 5)
                    (.var 4) (.var 2) (.var 6) (.var 5) (.var 4)
                    (.var 2)))))))))

def primitiveConstructorSpec :
    ConstructorSpec rawSignature hypothesisName 4 where
  name := primitiveName
  type := primitiveType
  declared := typeOf_primitive
  positive := primitiveConstructorPositive

def chainConstructorSpec :
    ConstructorSpec rawSignature hypothesisName 4 where
  name := chainName
  type := chainType
  declared := typeOf_chain
  positive := chainConstructorPositive

def hypothesisConstructors :
    List (ConstructorSpec rawSignature hypothesisName 4) :=
  [primitiveConstructorSpec, chainConstructorSpec]

def hypothesisEliminatorSpec : EliminatorSpec rawSignature where
  name := eliminateName
  type := eliminateType
  declared := typeOf_eliminate

def recursiveDomainCanary : Tower.Tm 4 :=
  hypothesisApp (.var 3) (.var 2) (.var 1) (.var 0)

def recursiveDomainApplication :
    FamilyApplication hypothesisName 4 recursiveDomainCanary := by
  unfold recursiveDomainCanary
  exact hypothesisFamilyApplication (.var 3) (.var 2) (.var 1) (.var 0)
    (.var 3) (.var 2) (.var 1) (.var 0)

theorem recursiveHypothesisInFunctionDomain_not_strictlyPositive :
    StrictlyPositive hypothesisName 4
      (.pi recursiveDomainCanary (.var 0)) → False := by
  exact recursivePiDomain_not_strictlyPositive recursiveDomainApplication
    (.var 0)

def partialHypothesisApplication : Tower.Tm 0 :=
  .app (.const hypothesisName) (sortTm sortLevel)

def applicationSpineLength : Tower.Tm n → Nat
  | .app function _ => applicationSpineLength function + 1
  | _ => 0

theorem applicationSpineLength_applyArgs (function : Tower.Tm n)
    (arguments : List (Tower.Tm n)) :
    applicationSpineLength (applyArgs function arguments) =
      applicationSpineLength function + arguments.length := by
  induction arguments generalizing function with
  | nil => simp [applyArgs]
  | cons argument rest ih =>
      rw [applyArgs_cons, ih]
      simp only [applicationSpineLength, List.length_cons]
      omega

theorem partialHypothesisApplication_not_familyApplication :
    FamilyApplication hypothesisName 4 partialHypothesisApplication →
      False := by
  rintro ⟨arguments, length, _free, equation⟩
  have spineEquality := congrArg applicationSpineLength equation
  rw [applicationSpineLength_applyArgs] at spineEquality
  simp [partialHypothesisApplication, applicationSpineLength, length]
    at spineEquality

