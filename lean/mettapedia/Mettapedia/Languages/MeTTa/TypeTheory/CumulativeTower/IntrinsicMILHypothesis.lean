        primitiveIotaEvidenceTerm
        (hypothesisApp (.var 7) (.var 6) (.var 2) (.var 1)) := by
      apply primitiveApp_hasType
      · exact Presentation.HasType.var 7
      · exact Presentation.HasType.var 6
      · exact Presentation.HasType.var 2
      · exact Presentation.HasType.var 1
      · exact Presentation.HasType.var 0
    have afterSource := Presentation.HasType.appElim
      eliminateAtPrimitiveParameters_hasType
      (Presentation.HasType.var 2)
    have afterTarget := Presentation.HasType.appElim afterSource (by
      convert (Presentation.HasType.var 1 : HasType
        contextSPMPCSourceTargetSymbol (.var 1) (.var 7)) using 1
      all_goals decide)
    have afterEvidence := Presentation.HasType.appElim afterTarget (by
      convert evidenceTyping using 1
      all_goals decide)
    convert afterEvidence using 1
    all_goals decide
  targetTyping := by
    have primitiveCaseTyping : HasType contextSPMPCSourceTargetSymbol
        (.var 4) (weaken5 primitiveCaseType) :=
      Presentation.HasType.var 4
    have afterSource := Presentation.HasType.appElim primitiveCaseTyping
