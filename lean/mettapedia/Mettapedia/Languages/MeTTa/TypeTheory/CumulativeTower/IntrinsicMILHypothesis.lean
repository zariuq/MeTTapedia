  eliminatorNotConstructor := by
    intro constructor membership
    simp only [hypothesisConstructors, List.mem_cons, List.not_mem_nil,
      or_false] at membership
    rcases membership with rfl | rfl <;> decide
  iotaClauses := hypothesisIotaClauses
  constructorsComputed := by
    intro constructorName membership
    simp [hypothesisConstructors, primitiveConstructorSpec,
      chainConstructorSpec] at membership
    rcases membership with rfl | rfl <;>
      simp [hypothesisIotaClauses, primitiveIotaClause, chainIotaClause]

theorem hypothesisCandidate_has_exact_shape :
    hypothesisCandidate.familyParameterCount = 2 ∧
      hypothesisCandidate.familyIndexCount = 2 ∧
      hypothesisCandidate.constructors.map ConstructorSpec.name =
        [primitiveName, chainName] := by
  simp [hypothesisCandidate, hypothesisConstructors, primitiveConstructorSpec,
    chainConstructorSpec]

theorem no_identity_constructor :
    `Prime.Hypothesis.identity ∉
      hypothesisCandidate.constructors.map ConstructorSpec.name := by
  change `Prime.Hypothesis.identity ∉ [primitiveName, chainName]
  decide

/-! ## Exact quotation of semantic hypothesis programs -/

universe uSort uCarrier uPrimitive

/-- A typed quotation chooses object-language representatives for a semantic
MIL vocabulary.  It is deliberately independent of search and examples. -/
structure TypedVocabularyQuotation
    (vocabulary : MILSchemaElaboration.Semantic.Vocabulary.{uSort, uCarrier,
      uPrimitive})
    (context : Tower.Ctx n) where
  sorts : Tower.Tm n
  primitives : Tower.Tm n
  sortCode : vocabulary.SortCode → Tower.Tm n
  primitiveCode : {source target : vocabulary.SortCode} →
    vocabulary.Primitive source target → Tower.Tm n
  sortsTyping : HasType context sorts (sortTm sortLevel)
  primitivesTyping : HasType context primitives
    (.pi sorts (.pi (weaken1 sorts) (sortTm primitiveLevel)))
  sortCodeTyping : ∀ sort, HasType context (sortCode sort) sorts
  primitiveCodeTyping : ∀ {source target}
      (symbol : vocabulary.Primitive source target),
    HasType context (primitiveCode symbol)
      (.app (.app primitives (sortCode source)) (sortCode target))

def quoteHypothesis
    {vocabulary : MILSchemaElaboration.Semantic.Vocabulary}
    {context : Tower.Ctx n}
    (quotation : TypedVocabularyQuotation vocabulary context) :
    {source target : vocabulary.SortCode} →
      MILSchemaElaboration.Semantic.Hypothesis vocabulary source target →
        Tower.Tm n
  | source, target, .primitive symbol =>
      primitiveApp quotation.sorts quotation.primitives
        (quotation.sortCode source) (quotation.sortCode target)
        (quotation.primitiveCode symbol)
  | source, target, .chain (middle := middle) earlier later =>
      chainApp quotation.sorts quotation.primitives
        (quotation.sortCode source) (quotation.sortCode middle)
        (quotation.sortCode target)
        (quoteHypothesis quotation earlier)
        (quoteHypothesis quotation later)

@[simp] theorem quoteHypothesis_primitive
    {vocabulary : MILSchemaElaboration.Semantic.Vocabulary}
    {context : Tower.Ctx n}
    (quotation : TypedVocabularyQuotation vocabulary context)
    {source target : vocabulary.SortCode}
    (symbol : vocabulary.Primitive source target) :
    quoteHypothesis quotation
        (MILSchemaElaboration.Semantic.Hypothesis.primitive symbol) =
      primitiveApp quotation.sorts quotation.primitives
        (quotation.sortCode source) (quotation.sortCode target)
        (quotation.primitiveCode symbol) :=
  rfl

@[simp] theorem quoteHypothesis_chain
    {vocabulary : MILSchemaElaboration.Semantic.Vocabulary}
    {context : Tower.Ctx n}
    (quotation : TypedVocabularyQuotation vocabulary context)
    {source middle target : vocabulary.SortCode}
    (earlier : MILSchemaElaboration.Semantic.Hypothesis vocabulary source middle)
    (later : MILSchemaElaboration.Semantic.Hypothesis vocabulary middle target) :
    quoteHypothesis quotation
        (MILSchemaElaboration.Semantic.Hypothesis.chain earlier later) =
      chainApp quotation.sorts quotation.primitives
        (quotation.sortCode source) (quotation.sortCode middle)
        (quotation.sortCode target)
        (quoteHypothesis quotation earlier)
        (quoteHypothesis quotation later) :=
  rfl

/-- Every semantic hypothesis program quotes to an inhabitant of the native
indexed family at exactly the same endpoints. -/
theorem quoteHypothesis_hasType
    {vocabulary : MILSchemaElaboration.Semantic.Vocabulary}
    {context : Tower.Ctx n}
    (quotation : TypedVocabularyQuotation vocabulary context)
    {source target : vocabulary.SortCode}
    (hypothesis :
      MILSchemaElaboration.Semantic.Hypothesis vocabulary source target) :
    HasType context (quoteHypothesis quotation hypothesis)
      (hypothesisApp quotation.sorts quotation.primitives
        (quotation.sortCode source) (quotation.sortCode target)) := by
  induction hypothesis with
  | primitive symbol =>
      apply primitiveApp_hasType
      · exact quotation.sortsTyping
      · exact quotation.primitivesTyping
      · exact quotation.sortCodeTyping _
      · exact quotation.sortCodeTyping _
      · exact quotation.primitiveCodeTyping symbol
  | chain earlier later ihEarlier ihLater =>
      apply chainApp_hasType
      · exact quotation.sortsTyping
      · exact quotation.primitivesTyping
      · exact quotation.sortCodeTyping _
      · exact quotation.sortCodeTyping _
      · exact quotation.sortCodeTyping _
      · exact ihEarlier
      · exact ihLater

