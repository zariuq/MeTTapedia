import Mettapedia.Languages.MeTTa.TypeTheory.CumulativeTower.MILSchemaElaboration

/-!
# Intrinsic typed hypothesis programs

`Hyp S P source target` is the free proof-relevant semigroupoid generated by
a typed primitive vocabulary `P : S → S → Type`.  It has exactly two
constructors: a primitive edge and witness-retaining relational composition.

The family is deliberately independent of MIL search, examples, checking,
runtime admission, and container-specific higher-order lifting.  In
particular, List lifting is supplied by the separately native `mapRel` family;
it is not a constructor of `Hyp`.

No associativity quotient is imposed.  Different chain trees are different
proof-relevant hypothesis programs, which preserves occurrence multiplicity
and learned-program provenance.
-/

namespace Mettapedia.Languages.MeTTa.TypeTheory.CumulativeTower
namespace IntrinsicMILHypothesis

open Presentation
open Presentation.SchemaElaboration
open Presentation.Declaration
open Presentation.Declaration.IndexedFamily
open Presentation.Declaration.ComputationAuthority

/-! ## Family and constructor syntax -/

def sortLevel : LevelExpr := .param 0
def primitiveLevel : LevelExpr := .param 1
def hypothesisLevel : LevelExpr := .param 2
def eliminationLevel : LevelExpr := .param 3

def hypothesisName : DeclName := `Prime.Hypothesis
def primitiveName : DeclName := `Prime.Hypothesis.primitive
def chainName : DeclName := `Prime.Hypothesis.chain
def eliminateName : DeclName := `Prime.Hypothesis.eliminate

/-- In context `S`, a typed primitive vocabulary has one family for every
ordered source/target pair. -/
def primitiveFamilyType : Tower.Tm 1 :=
  .pi (.var 0) (.pi (.var 1) (sortTm primitiveLevel))

def hypothesisApp (sorts primitives source target : Tower.Tm n) : Tower.Tm n :=
  .app (.app (.app (.app (.const hypothesisName) sorts) primitives) source)
    target

/-- In context `S,P`, the family is indexed by source and target sorts. -/
def hypothesisIndexType : Tower.Tm 2 :=
  .pi (.var 1) (.pi (.var 2) (sortTm hypothesisLevel))

def hypothesisType : Tower.Tm 0 :=
  .pi (sortTm sortLevel) (.pi primitiveFamilyType hypothesisIndexType)

def primitiveApp (sorts primitives source target symbol : Tower.Tm n) :
    Tower.Tm n :=
  .app
    (.app
      (.app
        (.app
          (.app (.const primitiveName) sorts)
          primitives)
        source)
      target)
    symbol

/-- In context `S,P`, a primitive symbol becomes a typed hypothesis. -/
def primitiveBodyType : Tower.Tm 2 :=
  .pi (.var 1)
    (.pi (.var 2)
      (.pi (.app (.app (.var 2) (.var 1)) (.var 0))
        (hypothesisApp (.var 4) (.var 3) (.var 2) (.var 1))))

def primitiveType : Tower.Tm 0 :=
  .pi (sortTm sortLevel) (.pi primitiveFamilyType primitiveBodyType)

def chainApp (sorts primitives source middle target earlier later :
    Tower.Tm n) : Tower.Tm n :=
  .app
    (.app
      (.app
        (.app
          (.app
            (.app
              (.app (.const chainName) sorts)
              primitives)
            source)
          middle)
        target)
      earlier)
    later

/-- In context `S,P`, chain can only connect programs sharing the same
middle index. -/
def chainBodyType : Tower.Tm 2 :=
  .pi (.var 1)
    (.pi (.var 2)
      (.pi (.var 3)
        (.pi (hypothesisApp (.var 4) (.var 3) (.var 2) (.var 1))
          (.pi (hypothesisApp (.var 5) (.var 4) (.var 2) (.var 1))
            (hypothesisApp (.var 6) (.var 5) (.var 4) (.var 2))))))

def chainType : Tower.Tm 0 :=
  .pi (sortTm sortLevel) (.pi primitiveFamilyType chainBodyType)

/-! ## Dependent elimination syntax -/

/-- In context `S,P`, the motive depends on both endpoint indices and on the
exact hypothesis-program inhabitant. -/
def motiveType : Tower.Tm 2 :=
  .pi (.var 1)
    (.pi (.var 2)
      (.pi (hypothesisApp (.var 3) (.var 2) (.var 1) (.var 0))
        (sortTm eliminationLevel)))

def motiveApp (motive source target hypothesis : Tower.Tm n) : Tower.Tm n :=
  .app (.app (.app motive source) target) hypothesis

/-- In context `S,P,M`, the primitive branch receives both indices and the
exact primitive symbol. -/
def primitiveCaseType : Tower.Tm 3 :=
  .pi (.var 2)
    (.pi (.var 3)
      (.pi (.app (.app (.var 3) (.var 1)) (.var 0))
        (motiveApp (.var 3) (.var 2) (.var 1)
          (primitiveApp (.var 5) (.var 4) (.var 2) (.var 1) (.var 0)))))

/-- In context `S,P,M,primitiveCase`, the chain branch receives both source
programs and both recursive motive witnesses before targeting their exact
composite. -/
def chainCaseType : Tower.Tm 4 :=
  .pi (.var 3)
    (.pi (.var 4)
      (.pi (.var 5)
        (.pi (hypothesisApp (.var 6) (.var 5) (.var 2) (.var 1))
          (.pi (hypothesisApp (.var 7) (.var 6) (.var 2) (.var 1))
            (.pi (motiveApp (.var 6) (.var 4) (.var 3) (.var 1))
              (.pi (motiveApp (.var 7) (.var 4) (.var 3) (.var 1))
                (motiveApp (.var 8) (.var 6) (.var 4)
                  (chainApp (.var 10) (.var 9) (.var 6) (.var 5)
                    (.var 4) (.var 3) (.var 2)))))))))

/-- In context `S,P,M,primitiveCase,chainCase`, eliminate every indexed
hypothesis while retaining its exact proof tree in the motive. -/
def eliminateResultType : Tower.Tm 5 :=
  .pi (.var 4)
    (.pi (.var 5)
      (.pi (hypothesisApp (.var 6) (.var 5) (.var 1) (.var 0))
        (motiveApp (.var 5) (.var 2) (.var 1) (.var 0))))

def eliminateType : Tower.Tm 0 :=
  .pi (sortTm sortLevel)
    (.pi primitiveFamilyType
      (.pi motiveType
        (.pi primitiveCaseType
          (.pi chainCaseType eliminateResultType))))

def eliminateApp (sorts primitives motive primitiveCase chainCase source
    target hypothesis : Tower.Tm n) : Tower.Tm n :=
  .app
    (.app
      (.app
        (.app
          (.app
            (.app
              (.app
                (.app (.const eliminateName) sorts)
                primitives)
              motive)
            primitiveCase)
          chainCase)
        source)
      target)
    hypothesis

/-! ## Proof-relevant computation and declaration signature -/

/-- Native iota evidence remembers which hypothesis constructor was
eliminated.  In the chain case the reduct contains both recursive eliminator
calls, so the exact binary proof tree remains observable. -/
inductive IotaEvidence (n : Nat) : Tower.Tm n → Tower.Tm n → Type where
  | primitive (sorts primitives motive primitiveCase chainCase source target
      symbol : Tower.Tm n) :
      IotaEvidence n
        (eliminateApp sorts primitives motive primitiveCase chainCase source
          target (primitiveApp sorts primitives source target symbol))
        (.app (.app (.app primitiveCase source) target) symbol)
  | chain (sorts primitives motive primitiveCase chainCase source middle target
      earlier later : Tower.Tm n) :
      IotaEvidence n
        (eliminateApp sorts primitives motive primitiveCase chainCase source
          target
          (chainApp sorts primitives source middle target earlier later))
        (.app
          (.app
            (.app
              (.app
                (.app
                  (.app
                    (.app chainCase source)
                    middle)
                  target)
                earlier)
              later)
            (eliminateApp sorts primitives motive primitiveCase chainCase
              source middle earlier))
          (eliminateApp sorts primitives motive primitiveCase chainCase
            middle target later))

def IotaEvidence.rename {left right : Tower.Tm n}
    (evidence : IotaEvidence n left right) (renameMap : Ren n m) :
    IotaEvidence m (Presentation.rename renameMap left)
      (Presentation.rename renameMap right) := by
  cases evidence with
  | primitive => exact .primitive _ _ _ _ _ _ _ _
  | chain => exact .chain _ _ _ _ _ _ _ _ _ _

def IotaEvidence.substitute {left right : Tower.Tm n}
    (evidence : IotaEvidence n left right)
    (substitution : Sub Tower.Head n m) :
    IotaEvidence m (Presentation.subst substitution left)
      (Presentation.subst substitution right) := by
  cases evidence with
  | primitive => exact .primitive _ _ _ _ _ _ _ _
  | chain => exact .chain _ _ _ _ _ _ _ _ _ _

def proofRelevantIotaComputation :
    ProofRelevantRootComputation Tower.Head where
  Evidence := IotaEvidence _
  rename := by
    intro n m renameMap left right evidence
    exact evidence.rename renameMap
  substitute := by
    intro n m substitution left right evidence
    exact evidence.substitute substitution

def hypothesisEntry : Entry Tower.Head := { type := hypothesisType }
def primitiveEntry : Entry Tower.Head := { type := primitiveType }
def chainEntry : Entry Tower.Head := { type := chainType }
def eliminateEntry : Entry Tower.Head := { type := eliminateType }

def rawSignature : Signature Tower.Head where
  entries := fun name =>
    if name = hypothesisName then some hypothesisEntry
    else if name = primitiveName then some primitiveEntry
    else if name = chainName then some chainEntry
    else if name = eliminateName then some eliminateEntry
    else none
  computation := proofRelevantIotaComputation.support

abbrev rules : Rules Tower.Head :=
  extendRules Tower.rules rawSignature

abbrev HasType {n : Nat} := @Presentation.HasType Tower.Head rules n

@[simp] theorem typeOf_hypothesis :
    rawSignature.typeOf? hypothesisName = some hypothesisType := by
  simp [rawSignature, Signature.typeOf?, hypothesisEntry, hypothesisName]

@[simp] theorem typeOf_primitive :
    rawSignature.typeOf? primitiveName = some primitiveType := by
  simp [rawSignature, Signature.typeOf?, primitiveEntry, hypothesisName,
    primitiveName]

@[simp] theorem typeOf_chain :
    rawSignature.typeOf? chainName = some chainType := by
  simp [rawSignature, Signature.typeOf?, chainEntry, hypothesisName,
    primitiveName, chainName]

@[simp] theorem typeOf_eliminate :
    rawSignature.typeOf? eliminateName = some eliminateType := by
  simp [rawSignature, Signature.typeOf?, eliminateEntry, hypothesisName,
    primitiveName, chainName, eliminateName]

def includeTowerTyping {context : Tower.Ctx n} {term type : Tower.Tm n}
    (typing : Tower.HasType context term type) :
    HasType context term type :=
  Presentation.Declaration.HasType.includeSignature Tower.rules rawSignature
    typing

def weaken1 (term : Tower.Tm n) : Tower.Tm (n + 1) :=
  Presentation.rename wk term

def weaken2 (term : Tower.Tm n) : Tower.Tm (n + 2) :=
  Presentation.rename wk (weaken1 term)

def weaken3 (term : Tower.Tm n) : Tower.Tm (n + 3) :=
  Presentation.rename wk (weaken2 term)

def weaken4 (term : Tower.Tm n) : Tower.Tm (n + 4) :=
  Presentation.rename wk (weaken3 term)

def weaken5 (term : Tower.Tm n) : Tower.Tm (n + 5) :=
  Presentation.rename wk (weaken4 term)

def weaken6 (term : Tower.Tm n) : Tower.Tm (n + 6) :=
  Presentation.rename wk (weaken5 term)

@[simp] theorem instantiateTwo_weaken2
    (first second term : Tower.Tm n) :
    Presentation.subst (subst0 second)
        (Presentation.subst (liftSub (subst0 first)) (weaken2 term)) =
      term := by
  unfold weaken2 weaken1
  rw [Presentation.subst_liftSub_wk]
  rw [show Presentation.subst (subst0 first)
      (Presentation.rename wk term) = term from
    Presentation.inst0_rename_wk first term]
  exact Presentation.inst0_rename_wk second term

@[simp] theorem instantiateThree_weaken3
    (first second third term : Tower.Tm n) :
    Presentation.subst (subst0 third)
        (Presentation.subst (liftSub (subst0 second))
          (Presentation.subst (liftSub (liftSub (subst0 first)))
            (weaken3 term))) =
      term := by
  unfold weaken3
  rw [Presentation.subst_liftSub_wk, Presentation.subst_liftSub_wk,
    instantiateTwo_weaken2]
  exact Presentation.inst0_rename_wk third term

@[simp] theorem instantiateTwo_varOne
    (first second : Tower.Tm n) :
    Presentation.subst (subst0 second)
        (Presentation.subst (liftSub (subst0 first)) (.var 1)) =
      first := by
  change Presentation.subst (subst0 second) (weaken1 first) = first
  exact Presentation.inst0_rename_wk second first

@[simp] theorem instantiateTwo_varZero
    (first second : Tower.Tm n) :
    Presentation.subst (subst0 second)
        (Presentation.subst (liftSub (subst0 first)) (.var 0)) =
      second := by
  rfl

@[simp] theorem instantiateThree_varTwo
    (first second third : Tower.Tm n) :
    Presentation.subst (subst0 third)
        (Presentation.subst (liftSub (subst0 second))
          (Presentation.subst (liftSub (liftSub (subst0 first))) (.var 2))) =
      first := by
  change Presentation.subst (subst0 third)
      (Presentation.subst (liftSub (subst0 second)) (weaken2 first)) = first
  exact instantiateTwo_weaken2 second third first

@[simp] theorem instantiateThree_varOne
    (first second third : Tower.Tm n) :
    Presentation.subst (subst0 third)
        (Presentation.subst (liftSub (subst0 second))
          (Presentation.subst (liftSub (liftSub (subst0 first))) (.var 1))) =
      second := by
  change Presentation.subst (subst0 third) (weaken1 second) = second
  exact Presentation.inst0_rename_wk third second

@[simp] theorem instantiateFour_weaken4
    (first second third fourth term : Tower.Tm n) :
    Presentation.subst (subst0 fourth)
        (Presentation.subst (liftSub (subst0 third))
          (Presentation.subst (liftSub (liftSub (subst0 second)))
            (Presentation.subst
              (liftSub (liftSub (liftSub (subst0 first))))
              (weaken4 term)))) =
      term := by
  unfold weaken4
  rw [Presentation.subst_liftSub_wk, Presentation.subst_liftSub_wk,
    Presentation.subst_liftSub_wk, instantiateThree_weaken3]
  exact Presentation.inst0_rename_wk fourth term

@[simp] theorem instantiateFive_weaken5
    (first second third fourth fifth term : Tower.Tm n) :
    Presentation.subst (subst0 fifth)
        (Presentation.subst (liftSub (subst0 fourth))
          (Presentation.subst (liftSub (liftSub (subst0 third)))
            (Presentation.subst
              (liftSub (liftSub (liftSub (subst0 second))))
              (Presentation.subst
                (liftSub (liftSub (liftSub (liftSub (subst0 first)))))
                (weaken5 term))))) =
      term := by
  unfold weaken5
  rw [Presentation.subst_liftSub_wk, Presentation.subst_liftSub_wk,
    Presentation.subst_liftSub_wk, Presentation.subst_liftSub_wk,
    instantiateFour_weaken4]
  exact Presentation.inst0_rename_wk fifth term

@[simp] theorem instantiateFour_varTwo
    (first second third fourth : Tower.Tm n) :
    Presentation.subst (subst0 fourth)
        (Presentation.subst (liftSub (subst0 third))
          (Presentation.subst (liftSub (liftSub (subst0 second)))
            (Presentation.subst
              (liftSub (liftSub (liftSub (subst0 first)))) (.var 2)))) =
      second := by
  change Presentation.subst (subst0 fourth)
      (Presentation.subst (liftSub (subst0 third)) (weaken2 second)) = second
  exact instantiateTwo_weaken2 third fourth second

@[simp] theorem instantiateFour_varOne
    (first second third fourth : Tower.Tm n) :
    Presentation.subst (subst0 fourth)
        (Presentation.subst (liftSub (subst0 third))
          (Presentation.subst (liftSub (liftSub (subst0 second)))
            (Presentation.subst
              (liftSub (liftSub (liftSub (subst0 first)))) (.var 1)))) =
      third := by
  change Presentation.subst (subst0 fourth) (weaken1 third) = third
  exact Presentation.inst0_rename_wk fourth third

@[simp] theorem instantiateFive_varFour
    (first second third fourth fifth : Tower.Tm n) :
    Presentation.subst (subst0 fifth)
        (Presentation.subst (liftSub (subst0 fourth))
          (Presentation.subst (liftSub (liftSub (subst0 third)))
            (Presentation.subst
              (liftSub (liftSub (liftSub (subst0 second))))
              (Presentation.subst
                (liftSub (liftSub (liftSub (liftSub (subst0 first)))))
                (.var 4))))) =
      first := by
  change Presentation.subst (subst0 fifth)
      (Presentation.subst (liftSub (subst0 fourth))
        (Presentation.subst (liftSub (liftSub (subst0 third)))
          (Presentation.subst (liftSub (liftSub (liftSub (subst0 second))))
            (weaken4 first)))) = first
  exact instantiateFour_weaken4 second third fourth fifth first

@[simp] theorem instantiateFive_varTwo
    (first second third fourth fifth : Tower.Tm n) :
    Presentation.subst (subst0 fifth)
        (Presentation.subst (liftSub (subst0 fourth))
          (Presentation.subst (liftSub (liftSub (subst0 third)))
            (Presentation.subst
              (liftSub (liftSub (liftSub (subst0 second))))
              (Presentation.subst
                (liftSub (liftSub (liftSub (liftSub (subst0 first)))))
                (.var 2))))) =
      third := by
  change Presentation.subst (subst0 fifth)
      (Presentation.subst (liftSub (subst0 fourth)) (weaken2 third)) = third
  exact instantiateTwo_weaken2 fourth fifth third

/-! ## Formation of the family parameters -/

def contextS : Tower.Ctx 1 :=
  .snoc .nil (sortTm sortLevel)

def contextSP : Tower.Ctx 2 :=
  .snoc contextS primitiveFamilyType

def primitiveFamilyTypeLevel : LevelExpr :=
  .max sortLevel (.max sortLevel (.succ primitiveLevel))

theorem primitiveFamilyType_hasType :
    Tower.HasType contextS primitiveFamilyType
      (sortTm primitiveFamilyTypeLevel) := by
  unfold contextS primitiveFamilyType primitiveFamilyTypeLevel
  apply Presentation.HasType.piForm
  · exact Presentation.HasType.var 0
  · exact .sort sortLevel
  · apply Presentation.HasType.piForm
    · exact Presentation.HasType.var 1
    · exact .sort sortLevel
    · exact .headType (.sort primitiveLevel)
    · exact .sort (.succ primitiveLevel)
    · exact .sorts sortLevel (.succ primitiveLevel)
  · exact .sort (.max sortLevel (.succ primitiveLevel))
  · exact .sorts sortLevel (.max sortLevel (.succ primitiveLevel))

def hypothesisIndexLevel : LevelExpr :=
  .max sortLevel (.max sortLevel (.succ hypothesisLevel))

theorem hypothesisIndexType_hasType :
    Tower.HasType contextSP hypothesisIndexType
      (sortTm hypothesisIndexLevel) := by
  unfold contextSP hypothesisIndexType hypothesisIndexLevel
  apply Presentation.HasType.piForm
  · exact Presentation.HasType.var 1
  · exact .sort sortLevel
  · apply Presentation.HasType.piForm
    · exact Presentation.HasType.var 2
    · exact .sort sortLevel
    · exact .headType (.sort hypothesisLevel)
    · exact .sort (.succ hypothesisLevel)
    · exact .sorts sortLevel (.succ hypothesisLevel)
  · exact .sort (.max sortLevel (.succ hypothesisLevel))
  · exact .sorts sortLevel (.max sortLevel (.succ hypothesisLevel))

def hypothesisAfterPrimitiveLevel : LevelExpr :=
  .max primitiveFamilyTypeLevel hypothesisIndexLevel

def hypothesisDeclarationLevel : LevelExpr :=
  .max (.succ sortLevel) hypothesisAfterPrimitiveLevel

theorem hypothesisType_hasType :
    Tower.HasType (.nil : Tower.Ctx 0) hypothesisType
      (sortTm hypothesisDeclarationLevel) := by
  unfold hypothesisType hypothesisDeclarationLevel hypothesisAfterPrimitiveLevel
  apply Presentation.HasType.piForm
  · exact .headType (.sort sortLevel)
  · exact .sort (.succ sortLevel)
  · apply Presentation.HasType.piForm
    · exact primitiveFamilyType_hasType
    · exact .sort primitiveFamilyTypeLevel
    · exact hypothesisIndexType_hasType
    · exact .sort hypothesisIndexLevel
    · exact .sorts primitiveFamilyTypeLevel hypothesisIndexLevel
  · exact .sort hypothesisAfterPrimitiveLevel
  · exact .sorts (.succ sortLevel) hypothesisAfterPrimitiveLevel

/-! ## Intrinsic formation of family and constructors -/

theorem hypothesisConstant_hasType {context : Tower.Ctx n} :
    HasType context (.const hypothesisName) (liftClosed hypothesisType) := by
  apply Presentation.HasType.const
  change combinedType Tower.rules rawSignature hypothesisName =
    some hypothesisType
  apply combinedType_of_signature
  · rfl
  · exact typeOf_hypothesis

theorem instantiateTwo_hypothesisIndexType
    (sorts primitives : Tower.Tm n) :
    Presentation.subst (subst0 primitives)
        (Presentation.subst (liftSub (subst0 sorts))
          (Presentation.rename (liftRen (liftRen Fin.elim0))
            hypothesisIndexType)) =
      .pi sorts (.pi (Presentation.rename wk sorts)
        (sortTm hypothesisLevel)) := by
  rw [NativeIndexedFamilies.Intrinsic.instantiateTwo_eq_subst sorts primitives
    hypothesisIndexType]
  rfl

/-- A typed application of the native hypothesis family. -/
theorem hypothesisApp_hasType {context : Tower.Ctx n}
    {sorts primitives source target : Tower.Tm n}
    (sortsTyping : HasType context sorts (sortTm sortLevel))
    (primitivesTyping : HasType context primitives
      (.pi sorts (.pi (Presentation.rename wk sorts)
        (sortTm primitiveLevel))))
    (sourceTyping : HasType context source sorts)
    (targetTyping : HasType context target sorts) :
    HasType context (hypothesisApp sorts primitives source target)
      (sortTm hypothesisLevel) := by
  have afterSorts := Presentation.HasType.appElim
    (hypothesisConstant_hasType (context := context)) sortsTyping
  have afterPrimitives := Presentation.HasType.appElim afterSorts
    primitivesTyping
  change HasType context _
    (Presentation.subst (subst0 primitives)
      (Presentation.subst (liftSub (subst0 sorts))
        (Presentation.rename (liftRen (liftRen Fin.elim0))
          hypothesisIndexType))) at afterPrimitives
  rw [instantiateTwo_hypothesisIndexType sorts primitives] at afterPrimitives
  have afterSource := Presentation.HasType.appElim afterPrimitives sourceTyping
  have targetTypingExpected : HasType context target
      (Presentation.inst0 source (Presentation.rename wk sorts)) := by
    rw [Presentation.inst0_rename_wk]
    exact targetTyping
  have afterTarget := Presentation.HasType.appElim afterSource
    targetTypingExpected
  exact afterTarget

theorem primitiveFamilyApp_hasType {context : Tower.Ctx n}
    {sorts primitives source target : Tower.Tm n}
    (primitivesTyping : HasType context primitives
      (.pi sorts (.pi (Presentation.rename wk sorts)
        (sortTm primitiveLevel))))
    (sourceTyping : HasType context source sorts)
    (targetTyping : HasType context target sorts) :
    HasType context (.app (.app primitives source) target)
      (sortTm primitiveLevel) := by
  have afterSource := Presentation.HasType.appElim primitivesTyping sourceTyping
  have targetTypingExpected : HasType context target
      (Presentation.inst0 source (Presentation.rename wk sorts)) := by
    rw [Presentation.inst0_rename_wk]
    exact targetTyping
  exact Presentation.HasType.appElim afterSource targetTypingExpected

theorem primitiveConstant_hasType {context : Tower.Ctx n} :
    HasType context (.const primitiveName) (liftClosed primitiveType) := by
  apply Presentation.HasType.const
  change combinedType Tower.rules rawSignature primitiveName =
    some primitiveType
  apply combinedType_of_signature
  · rfl
  · exact typeOf_primitive

theorem instantiateTwo_primitiveBodyType
    (sorts primitives : Tower.Tm n) :
    Presentation.subst (subst0 primitives)
        (Presentation.subst (liftSub (subst0 sorts))
          (Presentation.rename (liftRen (liftRen Fin.elim0))
            primitiveBodyType)) =
      .pi sorts
        (.pi (Presentation.rename wk sorts)
          (.pi
            (.app
              (.app
                (weaken2 primitives)
                (.var 1))
              (.var 0))
            (hypothesisApp
              (weaken3 sorts)
              (weaken3 primitives)
              (.var 2) (.var 1)))) := by
  rw [NativeIndexedFamilies.Intrinsic.instantiateTwo_eq_subst sorts primitives
    primitiveBodyType]
  rfl

theorem instantiatePrimitiveSymbolType
    (primitives source target : Tower.Tm n) :
    Presentation.subst (subst0 target)
        (Presentation.subst (liftSub (subst0 source))
          (.app (.app (weaken2 primitives) (.var 1)) (.var 0))) =
      .app (.app primitives source) target := by
  simp only [Presentation.subst]
  rw [instantiateTwo_weaken2]
  have sourceCancels :
      Presentation.subst (subst0 target)
          (liftSub (subst0 source) (1 : Fin (n + 2))) = source := by
    change Presentation.subst (subst0 target) (weaken1 source) = source
    exact Presentation.inst0_rename_wk target source
  rw [sourceCancels]
  rfl

theorem instantiatePrimitiveResult
    (sorts primitives source target symbol : Tower.Tm n) :
    Presentation.subst (subst0 symbol)
        (Presentation.subst (liftSub (subst0 target))
          (Presentation.subst (liftSub (liftSub (subst0 source)))
            (hypothesisApp (weaken3 sorts) (weaken3 primitives)
              (.var 2) (.var 1)))) =
      hypothesisApp sorts primitives source target := by
  change hypothesisApp
      (Presentation.subst (subst0 symbol)
        (Presentation.subst (liftSub (subst0 target))
          (Presentation.subst (liftSub (liftSub (subst0 source)))
            (weaken3 sorts))))
      (Presentation.subst (subst0 symbol)
        (Presentation.subst (liftSub (subst0 target))
          (Presentation.subst (liftSub (liftSub (subst0 source)))
            (weaken3 primitives))))
      (Presentation.subst (subst0 symbol)
        (Presentation.subst (liftSub (subst0 target))
          (Presentation.subst (liftSub (liftSub (subst0 source)))
            (.var 2))))
      (Presentation.subst (subst0 symbol)
        (Presentation.subst (liftSub (subst0 target))
          (Presentation.subst (liftSub (liftSub (subst0 source)))
            (.var 1)))) = _
  rw [instantiateThree_weaken3, instantiateThree_weaken3]
  rw [instantiateThree_varTwo, instantiateThree_varOne]

theorem primitiveApp_hasType {context : Tower.Ctx n}
    {sorts primitives source target symbol : Tower.Tm n}
    (sortsTyping : HasType context sorts (sortTm sortLevel))
    (primitivesTyping : HasType context primitives
      (.pi sorts (.pi (Presentation.rename wk sorts)
        (sortTm primitiveLevel))))
    (sourceTyping : HasType context source sorts)
    (targetTyping : HasType context target sorts)
    (symbolTyping : HasType context symbol
      (.app (.app primitives source) target)) :
    HasType context (primitiveApp sorts primitives source target symbol)
      (hypothesisApp sorts primitives source target) := by
  have afterSorts := Presentation.HasType.appElim
    (primitiveConstant_hasType (context := context)) sortsTyping
  have afterPrimitives := Presentation.HasType.appElim afterSorts
    primitivesTyping
  change HasType context _
    (Presentation.subst (subst0 primitives)
      (Presentation.subst (liftSub (subst0 sorts))
        (Presentation.rename (liftRen (liftRen Fin.elim0))
          primitiveBodyType))) at afterPrimitives
  rw [instantiateTwo_primitiveBodyType sorts primitives] at afterPrimitives
  have afterSource := Presentation.HasType.appElim afterPrimitives sourceTyping
  have targetTypingExpected : HasType context target
      (Presentation.inst0 source (Presentation.rename wk sorts)) := by
    rw [Presentation.inst0_rename_wk]
    exact targetTyping
  have afterTarget := Presentation.HasType.appElim afterSource
    targetTypingExpected
  have symbolTypingExpected : HasType context symbol
      (Presentation.subst (subst0 target)
        (Presentation.subst (liftSub (subst0 source))
          (.app (.app (weaken2 primitives) (.var 1)) (.var 0)))) := by
    rw [instantiatePrimitiveSymbolType]
    exact symbolTyping
  have afterSymbol := Presentation.HasType.appElim afterTarget
    symbolTypingExpected
  change HasType context _
    (Presentation.subst (subst0 symbol)
      (Presentation.subst (liftSub (subst0 target))
        (Presentation.subst (liftSub (liftSub (subst0 source)))
          (hypothesisApp (weaken3 sorts) (weaken3 primitives)
            (.var 2) (.var 1))))) at afterSymbol
  rw [instantiatePrimitiveResult sorts primitives source target symbol]
    at afterSymbol
  exact afterSymbol

