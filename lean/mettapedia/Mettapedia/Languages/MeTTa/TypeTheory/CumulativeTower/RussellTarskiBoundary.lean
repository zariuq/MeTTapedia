import Mettapedia.Languages.MeTTa.TypeTheory.CumulativeTower.LegacyTowerConservativity
import Mettapedia.Languages.MeTTa.TypeTheory.CumulativeTower.StructuralLaws

/-!
# Russell formation and an explicit Tarski code image

This module establishes the first honest Russell-to-Tarski presentation
boundary for the cumulative tower.  It deliberately covers the generated
type-former fragment: the legacy ground type, universe sorts, dependent
products, dependent sums, identity types, and cumulative lifting.  Arbitrary
code variables and global type-family declarations belong to the later schema
layer; they are not smuggled into this fragment as raw term variables.

The two sides are independent inductive presentations:

* `RussellForm Γ A l` says directly that the tower term `A` is a generated
  Russell-style type at level `l`;
* `HasCode Γ a l` says that an explicit Tarski code `a` is well formed at
  level `l`.

Decoding is a separately defined structural map.  Preservation and reflection
are proved by induction.  In particular, target formation is not defined to
mean source formation.  Cumulative lifts remain visible in codes even though
decoding erases them, so equality of decoded types is intentionally weaker
than equality of codes.
-/

namespace Mettapedia.Languages.MeTTa.TypeTheory.CumulativeTower.Presentation

namespace RussellTarski

open Mettapedia.Languages.MeTTa.TypeTheory.CumulativeTower

/-! ## Explicit codes and decoding -/

/-- Codes generated by the first Tarski fragment.  The endpoints of an
identity code are ordinary tower terms, so codes may describe genuinely
dependent identity families under binders.  `lift source target a` records a
cumulative choice that decoding deliberately forgets. -/
inductive Code : Nat → Type where
  | ground : Code n
  | univ : LevelExpr → Code n
  | pi : Code n → Code (n + 1) → Code n
  | sigma : Code n → Code (n + 1) → Code n
  | id : Code n → Tower.Tm n → Tower.Tm n → Code n
  | lift : LevelExpr → LevelExpr → Code n → Code n
  deriving DecidableEq, Repr

/-- Structural decoding into the Russell tower syntax. -/
def decode : Code n → Tower.Tm n
  | .ground => .head .legacyGround
  | .univ level => .head (.sort level)
  | .pi domain codomain => .pi (decode domain) (decode codomain)
  | .sigma domain codomain => .sigma (decode domain) (decode codomain)
  | .id type left right => .id (decode type) left right
  | .lift _source _target code => decode code

/-! ## Term-variable renaming and substitution -/

/-- Rename the ordinary term variables occurring in a code. -/
def Code.rename (rho : Ren n m) : Code n → Code m
  | .ground => .ground
  | .univ level => .univ level
  | .pi domain codomain =>
      .pi (rename rho domain) (rename (liftRen rho) codomain)
  | .sigma domain codomain =>
      .sigma (rename rho domain) (rename (liftRen rho) codomain)
  | .id type left right =>
      .id (rename rho type)
        (Presentation.rename rho left) (Presentation.rename rho right)
  | .lift source target code => .lift source target (rename rho code)

/-- Substitute ordinary tower terms for the term variables in a code. -/
def Code.subst (sigma : Sub Tower.Head n m) : Code n → Code m
  | .ground => .ground
  | .univ level => .univ level
  | .pi domain codomain =>
      .pi (subst sigma domain) (subst (liftSub sigma) codomain)
  | .sigma domain codomain =>
      .sigma (subst sigma domain) (subst (liftSub sigma) codomain)
  | .id type left right =>
      .id (subst sigma type)
        (Presentation.subst sigma left) (Presentation.subst sigma right)
  | .lift source target code => .lift source target (subst sigma code)

/-- Decoding commutes definitionally with term-variable renaming. -/
@[simp] theorem decode_rename (rho : Ren n m) (code : Code n) :
    decode (code.rename rho) = Presentation.rename rho (decode code) := by
  induction code generalizing m with
  | ground => rfl
  | univ level => rfl
  | pi domain codomain ihDomain ihCodomain =>
      simp only [Code.rename, decode, Presentation.rename, ihDomain,
        ihCodomain]
  | sigma domain codomain ihDomain ihCodomain =>
      simp only [Code.rename, decode, Presentation.rename, ihDomain,
        ihCodomain]
  | id type left right ihType =>
      simp only [Code.rename, decode, Presentation.rename, ihType]
  | lift source target code ih =>
      simp only [Code.rename, decode, ih]

/-- Decoding commutes definitionally with simultaneous term substitution,
including under the binders of dependent products and sums. -/
@[simp] theorem decode_subst (sigma : Sub Tower.Head n m) (code : Code n) :
    decode (code.subst sigma) = Presentation.subst sigma (decode code) := by
  induction code generalizing m with
  | ground => rfl
  | univ level => rfl
  | pi domain codomain ihDomain ihCodomain =>
      simp only [Code.subst, decode, Presentation.subst, ihDomain,
        ihCodomain]
  | sigma domain codomain ihDomain ihCodomain =>
      simp only [Code.subst, decode, Presentation.subst, ihDomain,
        ihCodomain]
  | id type left right ihType =>
      simp only [Code.subst, decode, Presentation.subst, ihType]
  | lift source target code ih =>
      simp only [Code.subst, decode, ih]

/-- Code renaming has the same identity law as the shared term grammar. -/
@[simp] theorem Code.rename_id (code : Code n) : code.rename idRen = code := by
  induction code with
  | ground => rfl
  | univ level => rfl
  | pi domain codomain ihDomain ihCodomain =>
      simp [Code.rename, ihDomain, ihCodomain]
  | sigma domain codomain ihDomain ihCodomain =>
      simp [Code.rename, ihDomain, ihCodomain]
  | id type left right ihType => simp [Code.rename, ihType]
  | lift source target code ih => simp [Code.rename, ih]

/-- Code substitution has the same identity law as ordinary terms. -/
@[simp] theorem Code.subst_ids (code : Code n) :
    code.subst (ids (Head := Tower.Head)) = code := by
  induction code with
  | ground => rfl
  | univ level => rfl
  | pi domain codomain ihDomain ihCodomain =>
      simp [Code.subst, ihDomain, ihCodomain]
  | sigma domain codomain ihDomain ihCodomain =>
      simp [Code.subst, ihDomain, ihCodomain]
  | id type left right ihType => simp [Code.subst, ihType]
  | lift source target code ih => simp [Code.subst, ih]

/-- Extensional equality of term substitutions induces equality of their
actions on codes. -/
theorem Code.subst_ext {sigma tau : Sub Tower.Head n m}
    (equal : ∀ i, sigma i = tau i) (code : Code n) :
    code.subst sigma = code.subst tau := by
  induction code generalizing m with
  | ground => rfl
  | univ level => rfl
  | pi domain codomain ihDomain ihCodomain =>
      simp only [Code.subst]
      congr 1
      · exact ihDomain equal
      · apply ihCodomain
        intro i
        refine Fin.cases ?_ ?_ i
        · rfl
        · intro j
          simp [liftSub, equal j]
  | sigma domain codomain ihDomain ihCodomain =>
      simp only [Code.subst]
      congr 1
      · exact ihDomain equal
      · apply ihCodomain
        intro i
        refine Fin.cases ?_ ?_ i
        · rfl
        · intro j
          simp [liftSub, equal j]
  | id type left right ihType =>
      simp only [Code.subst]
      congr 1
      · exact ihType equal
      · exact Presentation.subst_ext equal left
      · exact Presentation.subst_ext equal right
  | lift source target code ih =>
      simp only [Code.subst]
      exact congrArg (Code.lift source target) (ih equal)

/-- Simultaneous term substitutions compose on codes. -/
@[simp] theorem Code.subst_comp (tau : Sub Tower.Head m k)
    (sigma : Sub Tower.Head n m) (code : Code n) :
    (code.subst sigma).subst tau =
      code.subst (fun i => Presentation.subst tau (sigma i)) := by
  induction code generalizing m k with
  | ground => rfl
  | univ level => rfl
  | pi domain codomain ihDomain ihCodomain =>
      simp only [Code.subst]
      congr 1
      · exact ihDomain tau sigma
      · rw [ihCodomain]
        apply Code.subst_ext
        intro i
        exact liftSub_comp_apply tau sigma i
  | sigma domain codomain ihDomain ihCodomain =>
      simp only [Code.subst]
      congr 1
      · exact ihDomain tau sigma
      · rw [ihCodomain]
        apply Code.subst_ext
        intro i
        exact liftSub_comp_apply tau sigma i
  | id type left right ihType =>
      simp [Code.subst, ihType, Presentation.subst_comp]
  | lift source target code ih =>
      simp [Code.subst, ih]

/-! ## Level-parameter substitution -/

/-- Substitute admitted level expressions throughout a tower head. -/
def substLevelsHead (theta : Nat → LevelExpr) : Tower.Head → Tower.Head
  | .legacyGround => .legacyGround
  | .sort level => .sort (LevelExpr.subst theta level)

/-- Substitute levels throughout a tower term without changing term binders. -/
def substLevelsTm (theta : Nat → LevelExpr) (term : Tower.Tm n) :
    Tower.Tm n :=
  term.mapHead (substLevelsHead theta)

/-- Substitute levels throughout every entry of a tower context. -/
def substLevelsCtx (theta : Nat → LevelExpr) (Gamma : Tower.Ctx n) :
    Tower.Ctx n :=
  Gamma.mapHead (substLevelsHead theta)

/-- Level substitution in an explicit code also reaches identity endpoints. -/
def Code.substLevels (theta : Nat → LevelExpr) : Code n → Code n
  | .ground => .ground
  | .univ level => .univ (LevelExpr.subst theta level)
  | .pi domain codomain =>
      .pi (substLevels theta domain) (substLevels theta codomain)
  | .sigma domain codomain =>
      .sigma (substLevels theta domain) (substLevels theta codomain)
  | .id type left right =>
      .id (substLevels theta type)
        (substLevelsTm theta left) (substLevelsTm theta right)
  | .lift source target code =>
      .lift (LevelExpr.subst theta source) (LevelExpr.subst theta target)
        (substLevels theta code)

/-- Decoding commutes exactly with level-parameter substitution. -/
@[simp] theorem decode_substLevels (theta : Nat → LevelExpr) (code : Code n) :
    decode (code.substLevels theta) =
      substLevelsTm theta (decode code) := by
  induction code with
  | ground => rfl
  | univ level => rfl
  | pi domain codomain ihDomain ihCodomain =>
      simp only [Code.substLevels, decode, substLevelsTm, Tm.mapHead,
        ihDomain, ihCodomain]
  | sigma domain codomain ihDomain ihCodomain =>
      simp only [Code.substLevels, decode, substLevelsTm, Tm.mapHead,
        ihDomain, ihCodomain]
  | id type left right ihType =>
      simp only [Code.substLevels, decode, substLevelsTm, Tm.mapHead,
        ihType]
  | lift source target code ih =>
      simp only [Code.substLevels, decode, ih]

/-- Level substitution by the parameter variables is identity on heads. -/
@[simp] theorem substLevelsHead_param (head : Tower.Head) :
    substLevelsHead LevelExpr.param head = head := by
  cases head with
  | legacyGround => rfl
  | sort level => simp [substLevelsHead]

/-- Consequently it is identity on tower terms and contexts. -/
@[simp] theorem substLevelsTm_param (term : Tower.Tm n) :
    substLevelsTm LevelExpr.param term = term := by
  have headsIdentity : substLevelsHead LevelExpr.param =
      (fun head : Tower.Head => head) := by
    funext head
    exact substLevelsHead_param head
  rw [substLevelsTm, headsIdentity, Tm.mapHead_id]

@[simp] theorem substLevelsCtx_param (Gamma : Tower.Ctx n) :
    substLevelsCtx LevelExpr.param Gamma = Gamma := by
  have headsIdentity : substLevelsHead LevelExpr.param =
      (fun head : Tower.Head => head) := by
    funext head
    exact substLevelsHead_param head
  rw [substLevelsCtx, headsIdentity]
  induction Gamma with
  | nil => rfl
  | snoc Gamma type ih => simp [Ctx.mapHead, ih]

/-- Level substitution is identity on explicit codes as well. -/
@[simp] theorem Code.substLevels_param (code : Code n) :
    code.substLevels LevelExpr.param = code := by
  induction code with
  | ground => rfl
  | univ level => simp [Code.substLevels]
  | pi domain codomain ihDomain ihCodomain =>
      simp [Code.substLevels, ihDomain, ihCodomain]
  | sigma domain codomain ihDomain ihCodomain =>
      simp [Code.substLevels, ihDomain, ihCodomain]
  | id type left right ihType => simp [Code.substLevels, ihType]
  | lift source target code ih => simp [Code.substLevels, ih]

/-- Substitution of term variables and substitution of level parameters
commute on codes. -/
theorem Code.substLevels_subst (theta : Nat → LevelExpr)
    (sigma : Sub Tower.Head n m) (code : Code n) :
    (code.subst sigma).substLevels theta =
      (code.substLevels theta).subst
        (fun i => substLevelsTm theta (sigma i)) := by
  induction code generalizing m with
  | ground => rfl
  | univ level => rfl
  | pi domain codomain ihDomain ihCodomain =>
      simp only [Code.subst, Code.substLevels]
      congr 1
      · exact ihDomain sigma
      · rw [ihCodomain]
        apply Code.subst_ext
        intro i
        exact congrFun (Tm.mapHead_liftSub (substLevelsHead theta) sigma) i
  | sigma domain codomain ihDomain ihCodomain =>
      simp only [Code.subst, Code.substLevels]
      congr 1
      · exact ihDomain sigma
      · rw [ihCodomain]
        apply Code.subst_ext
        intro i
        exact congrFun (Tm.mapHead_liftSub (substLevelsHead theta) sigma) i
  | id type left right ihType =>
      simp only [Code.subst, Code.substLevels]
      congr 1
      · exact ihType sigma
      · exact Tm.mapHead_subst (substLevelsHead theta) sigma left
      · exact Tm.mapHead_subst (substLevelsHead theta) sigma right
  | lift source target code ih =>
      simp only [Code.subst, Code.substLevels]
      exact congrArg
        (Code.lift (LevelExpr.subst theta source)
          (LevelExpr.subst theta target)) (ih sigma)

/-- Every tower rule is stable under simultaneous substitution of level
parameters. -/
def levelSubstMorphism (theta : Nat → LevelExpr) :
    Tower.rules.Morphism Tower.rules (substLevelsHead theta) where
  headTyping := by
    intro head universeHead typing
    cases typing with
    | legacyGround => exact .legacyGround
    | sort level => exact .sort (LevelExpr.subst theta level)
  isUniverse := by
    intro head witness
    cases witness with
    | sort level => exact .sort (LevelExpr.subst theta level)
  join := by
    intro left right result witness
    cases witness with
    | sorts left right =>
      simpa [Tower.rules, substLevelsHead, LevelExpr.subst] using
        (Tower.Join.sorts (LevelExpr.subst theta left)
          (LevelExpr.subst theta right))
  cumulative := by
    intro lower upper order
    cases lower with
    | legacyGround => exact False.elim order
    | sort lowerLevel =>
      cases upper with
      | legacyGround => exact False.elim order
      | sort upperLevel =>
        exact LevelNF.level_le_subst order theta
  headEq := by
    intro left right equality
    cases left with
    | legacyGround =>
      cases right with
      | legacyGround => trivial
      | sort level => exact False.elim equality
    | sort leftLevel =>
      cases right with
      | legacyGround => exact False.elim equality
      | sort rightLevel =>
        intro valuation
        rw [LevelExpr.eval_subst, LevelExpr.eval_subst]
        exact equality (fun i => LevelExpr.eval valuation (theta i))
  constantType := by
    intro name type impossible
    simp [Tower.rules] at impossible
  computation := by
    intro n left right impossible
    exact False.elim impossible

/-- Tower typing is stable under substitution of explicit universe-level
parameters. -/
theorem towerHasType_substLevels {Gamma : Tower.Ctx n} {term type : Tower.Tm n}
    (typing : Tower.HasType Gamma term type) (theta : Nat → LevelExpr) :
    Tower.HasType (substLevelsCtx theta Gamma)
      (substLevelsTm theta term) (substLevelsTm theta type) := by
  exact typing.mapHead (levelSubstMorphism theta)

/-! ## Independent formation judgments -/

/-- Tarski code formation.  A lift is admitted only when its source
annotation agrees with the premise and the semantic level order proves the
requested cumulative move. -/
inductive HasCode : Tower.Ctx n → Code n → LevelExpr → Prop where
  | ground {Gamma : Tower.Ctx n} :
      HasCode Gamma .ground Tower.zero
  | univ {Gamma : Tower.Ctx n} (level : LevelExpr) :
      HasCode Gamma (.univ level) (.succ level)
  | pi {Gamma : Tower.Ctx n} {domain : Code n} {codomain : Code (n + 1)}
      {domainLevel codomainLevel : LevelExpr} :
      HasCode Gamma domain domainLevel →
      HasCode (.snoc Gamma (decode domain)) codomain codomainLevel →
      HasCode Gamma (.pi domain codomain)
        (.max domainLevel codomainLevel)
  | sigma {Gamma : Tower.Ctx n} {domain : Code n}
      {codomain : Code (n + 1)}
      {domainLevel codomainLevel : LevelExpr} :
      HasCode Gamma domain domainLevel →
      HasCode (.snoc Gamma (decode domain)) codomain codomainLevel →
      HasCode Gamma (.sigma domain codomain)
        (.max domainLevel codomainLevel)
  | id {Gamma : Tower.Ctx n} {type : Code n} {left right : Tower.Tm n}
      {level : LevelExpr} :
      HasCode Gamma type level →
      Tower.HasType Gamma left (decode type) →
      Tower.HasType Gamma right (decode type) →
      HasCode Gamma (.id type left right) level
  | lift {Gamma : Tower.Ctx n} {code : Code n}
      {source target : LevelExpr} :
      HasCode Gamma code source →
      Tower.Cumulative (.sort source) (.sort target) →
      HasCode Gamma (.lift source target code) target

/-- Russell-style formation for the same generated fragment.  This relation
is stated directly over tower terms and does not mention codes or decoding. -/
inductive RussellForm : Tower.Ctx n → Tower.Tm n → LevelExpr → Prop where
  | ground {Gamma : Tower.Ctx n} :
      RussellForm Gamma (.head .legacyGround) Tower.zero
  | univ {Gamma : Tower.Ctx n} (level : LevelExpr) :
      RussellForm Gamma (.head (.sort level)) (.succ level)
  | pi {Gamma : Tower.Ctx n} {domain : Tower.Tm n}
      {codomain : Tower.Tm (n + 1)}
      {domainLevel codomainLevel : LevelExpr} :
      RussellForm Gamma domain domainLevel →
      RussellForm (.snoc Gamma domain) codomain codomainLevel →
      RussellForm Gamma (.pi domain codomain)
        (.max domainLevel codomainLevel)
  | sigma {Gamma : Tower.Ctx n} {domain : Tower.Tm n}
      {codomain : Tower.Tm (n + 1)}
      {domainLevel codomainLevel : LevelExpr} :
      RussellForm Gamma domain domainLevel →
      RussellForm (.snoc Gamma domain) codomain codomainLevel →
      RussellForm Gamma (.sigma domain codomain)
        (.max domainLevel codomainLevel)
  | id {Gamma : Tower.Ctx n} {type left right : Tower.Tm n}
      {level : LevelExpr} :
      RussellForm Gamma type level →
      Tower.HasType Gamma left type →
      Tower.HasType Gamma right type →
      RussellForm Gamma (.id type left right) level
  | cumul {Gamma : Tower.Ctx n} {type : Tower.Tm n}
      {source target : LevelExpr} :
      RussellForm Gamma type source →
      Tower.Cumulative (.sort source) (.sort target) →
      RussellForm Gamma type target

/-! ## Formation is stable under level substitution -/

/-- Well-formed Tarski codes remain well formed after any simultaneous
substitution of admitted level expressions. -/
theorem HasCode.substLevels {Gamma : Tower.Ctx n} {code : Code n}
    {level : LevelExpr} (formation : HasCode Gamma code level)
    (theta : Nat → LevelExpr) :
    HasCode (substLevelsCtx theta Gamma) (code.substLevels theta)
      (LevelExpr.subst theta level) := by
  induction formation with
  | ground => exact .ground
  | univ level => exact .univ (LevelExpr.subst theta level)
  | @pi n Gamma domain codomain domainLevel codomainLevel
      domainFormation codomainFormation ihDomain ihCodomain =>
      have ihCodomain' : HasCode
          (.snoc (substLevelsCtx theta Gamma)
            (decode (Code.substLevels theta domain)))
          (Code.substLevels theta codomain)
          (LevelExpr.subst theta codomainLevel) := by
        simpa only [substLevelsCtx, substLevelsTm, Ctx.mapHead,
          decode_substLevels] using ihCodomain
      exact HasCode.pi ihDomain ihCodomain'
  | @sigma n Gamma domain codomain domainLevel codomainLevel
      domainFormation codomainFormation ihDomain ihCodomain =>
      have ihCodomain' : HasCode
          (.snoc (substLevelsCtx theta Gamma)
            (decode (Code.substLevels theta domain)))
          (Code.substLevels theta codomain)
          (LevelExpr.subst theta codomainLevel) := by
        simpa only [substLevelsCtx, substLevelsTm, Ctx.mapHead,
          decode_substLevels] using ihCodomain
      exact HasCode.sigma ihDomain ihCodomain'
  | id typeFormation leftTyping rightTyping ihType =>
      have leftTyping' := towerHasType_substLevels leftTyping theta
      have rightTyping' := towerHasType_substLevels rightTyping theta
      rw [← decode_substLevels] at leftTyping' rightTyping'
      exact HasCode.id ihType leftTyping' rightTyping'
  | lift codeFormation order ihCode =>
      apply HasCode.lift ihCode
      exact LevelNF.level_le_subst order theta

/-- The independent Russell formation relation has the same level-substitution
stability, proved without passing through codes. -/
theorem RussellForm.substLevels {Gamma : Tower.Ctx n} {type : Tower.Tm n}
    {level : LevelExpr} (formation : RussellForm Gamma type level)
    (theta : Nat → LevelExpr) :
    RussellForm (substLevelsCtx theta Gamma)
      (substLevelsTm theta type) (LevelExpr.subst theta level) := by
  induction formation with
  | ground => exact .ground
  | univ level => exact .univ (LevelExpr.subst theta level)
  | pi domainFormation codomainFormation ihDomain ihCodomain =>
      simpa [substLevelsCtx, substLevelsTm, Tm.mapHead,
        LevelExpr.subst] using RussellForm.pi ihDomain ihCodomain
  | sigma domainFormation codomainFormation ihDomain ihCodomain =>
      simpa [substLevelsCtx, substLevelsTm, Tm.mapHead,
        LevelExpr.subst] using RussellForm.sigma ihDomain ihCodomain
  | id typeFormation leftTyping rightTyping ihType =>
      exact RussellForm.id ihType
        (towerHasType_substLevels leftTyping theta)
        (towerHasType_substLevels rightTyping theta)
  | cumul sourceFormation order ihSource =>
      exact RussellForm.cumul ihSource (LevelNF.level_le_subst order theta)

/-! ## Presentation theorems -/

/-- Every well-formed code decodes to a type in the independent tower typing
judgment. -/
theorem HasCode.decode_hasType {Gamma : Tower.Ctx n} {code : Code n}
    {level : LevelExpr} (formation : HasCode Gamma code level) :
    Tower.HasType Gamma (decode code) (.head (.sort level)) := by
  induction formation with
  | ground => exact .headType .legacyGround
  | univ level => exact .headType (.sort level)
  | @pi n Gamma domain codomain domainLevel codomainLevel
      domainFormation codomainFormation ihDomain ihCodomain =>
      exact .piForm ihDomain (.sort domainLevel) ihCodomain
        (.sort codomainLevel) (.sorts domainLevel codomainLevel)
  | @sigma n Gamma domain codomain domainLevel codomainLevel
      domainFormation codomainFormation ihDomain ihCodomain =>
      exact .sigmaForm ihDomain (.sort domainLevel) ihCodomain
        (.sort codomainLevel) (.sorts domainLevel codomainLevel)
  | @id n Gamma type left right level typeFormation leftTyping rightTyping
      ihType =>
      exact .idForm ihType (.sort level) leftTyping rightTyping
  | @lift n Gamma code source target codeFormation order ihCode =>
      exact .cumul ihCode order

/-- Reflection on the code image: decoding a well-formed code always gives
an independently formed Russell type at the same level. -/
theorem HasCode.reflect {Gamma : Tower.Ctx n} {code : Code n}
    {level : LevelExpr} (formation : HasCode Gamma code level) :
    RussellForm Gamma (decode code) level := by
  induction formation with
  | ground => exact .ground
  | univ level => exact .univ level
  | pi domainFormation codomainFormation ihDomain ihCodomain =>
      exact .pi ihDomain ihCodomain
  | sigma domainFormation codomainFormation ihDomain ihCodomain =>
      exact .sigma ihDomain ihCodomain
  | id typeFormation leftTyping rightTyping ihType =>
      exact .id ihType leftTyping rightTyping
  | lift codeFormation order ihCode =>
      exact .cumul ihCode order

/-- Preservation into explicit codes: every generated Russell formation has
a well-formed code whose decoding is exactly the source type. -/
theorem RussellForm.elaborates {Gamma : Tower.Ctx n} {type : Tower.Tm n}
    {level : LevelExpr} (formation : RussellForm Gamma type level) :
    ∃ code : Code n, HasCode Gamma code level ∧ decode code = type := by
  induction formation with
  | ground => exact ⟨.ground, .ground, rfl⟩
  | univ level => exact ⟨.univ level, .univ level, rfl⟩
  | pi domainFormation codomainFormation ihDomain ihCodomain =>
      rcases ihDomain with ⟨domain, domainCode, rfl⟩
      rcases ihCodomain with ⟨codomain, codomainCode, rfl⟩
      exact ⟨.pi domain codomain, .pi domainCode codomainCode, rfl⟩
  | sigma domainFormation codomainFormation ihDomain ihCodomain =>
      rcases ihDomain with ⟨domain, domainCode, rfl⟩
      rcases ihCodomain with ⟨codomain, codomainCode, rfl⟩
      exact ⟨.sigma domain codomain, .sigma domainCode codomainCode, rfl⟩
  | id typeFormation leftTyping rightTyping ihType =>
      rcases ihType with ⟨type, typeCode, rfl⟩
      exact ⟨.id type _ _, .id typeCode leftTyping rightTyping, rfl⟩
  | @cumul n Gamma type source target sourceFormation order ihSource =>
      rcases ihSource with ⟨code, codeFormation, decoded⟩
      exact ⟨.lift source target code, .lift codeFormation order, decoded⟩

/-- The generated Russell fragment is exactly the decoded image of
well-formed Tarski codes. -/
theorem russellForm_iff_code_image (Gamma : Tower.Ctx n) (type : Tower.Tm n)
    (level : LevelExpr) :
    RussellForm Gamma type level ↔
      ∃ code : Code n, HasCode Gamma code level ∧ decode code = type := by
  constructor
  · exact RussellForm.elaborates
  · rintro ⟨code, codeFormation, rfl⟩
    exact codeFormation.reflect

/-- Russell formation is sound for the independent tower typing relation. -/
theorem RussellForm.toHasType {Gamma : Tower.Ctx n} {type : Tower.Tm n}
    {level : LevelExpr} (formation : RussellForm Gamma type level) :
    Tower.HasType Gamma type (.head (.sort level)) := by
  rcases formation.elaborates with ⟨code, codeFormation, rfl⟩
  exact codeFormation.decode_hasType

/-! ## Canonical image and the deliberate non-reflection of code equality -/

/-- Codes without explicit cumulative lifts form the canonical syntactic
image of the Russell generated fragment. -/
inductive Canonical : Code n → Prop where
  | ground : Canonical (.ground : Code n)
  | univ (level : LevelExpr) : Canonical (.univ level : Code n)
  | pi {domain : Code n} {codomain : Code (n + 1)} :
      Canonical domain → Canonical codomain → Canonical (.pi domain codomain)
  | sigma {domain : Code n} {codomain : Code (n + 1)} :
      Canonical domain → Canonical codomain →
      Canonical (.sigma domain codomain)
  | id {type : Code n} {left right : Tower.Tm n} :
      Canonical type → Canonical (.id type left right)

/-- Partial reification chooses the lift-free code for a generated Russell
type.  Term constructors that are not type formers remain outside its class. -/
def reify : Tower.Tm n → Option (Code n)
  | .head .legacyGround => some .ground
  | .head (.sort level) => some (.univ level)
  | .pi domain codomain => do
      let domainCode ← reify domain
      let codomainCode ← reify codomain
      pure (.pi domainCode codomainCode)
  | .sigma domain codomain => do
      let domainCode ← reify domain
      let codomainCode ← reify codomain
      pure (.sigma domainCode codomainCode)
  | .id type left right => do
      let typeCode ← reify type
      pure (.id typeCode left right)
  | _ => none

/-- Reification is a left inverse of decoding exactly on canonical codes. -/
@[simp] theorem reify_decode_of_canonical {code : Code n}
    (canonical : Canonical code) : reify (decode code) = some code := by
  induction canonical with
  | ground => rfl
  | univ level => rfl
  | pi domainCanonical codomainCanonical ihDomain ihCodomain =>
      simp [decode, reify, ihDomain, ihCodomain]
  | sigma domainCanonical codomainCanonical ihDomain ihCodomain =>
      simp [decode, reify, ihDomain, ihCodomain]
  | id typeCanonical ihType => simp [decode, reify, ihType]

/-- A positive dependent example: in a context containing one inhabitant of
the legacy ground type, reflexive identity has a code at level zero. -/
theorem groundIdentity_hasCode :
    HasCode
      (.snoc (.nil : Tower.Ctx 0) (.head .legacyGround))
      (.id .ground (.var 0) (.var 0)) Tower.zero := by
  apply HasCode.id .ground
  · exact Presentation.HasType.var 0
  · exact Presentation.HasType.var 0

/-- A cumulative lift of the ground code is well formed one level higher. -/
theorem liftedGround_hasCode :
    HasCode (.nil : Tower.Ctx 0)
      (Code.lift Tower.zero (.succ Tower.zero) Code.ground)
      (.succ Tower.zero) := by
  apply HasCode.lift .ground
  intro valuation
  simp [Tower.zero, LevelExpr.eval]

/-- Decoding erases lift evidence. -/
theorem decode_liftedGround :
    decode (.lift Tower.zero (.succ Tower.zero) (.ground : Code 0)) =
      decode (.ground : Code 0) := rfl

/-- The erased lift remains observable at the code layer. -/
theorem liftedGround_ne_ground :
    Code.lift Tower.zero (.succ Tower.zero) (Code.ground : Code 0) ≠
      Code.ground := by
  decide

/-- Negative example: a code for `U 0`, which lives at level one, cannot be
lifted downward and presented as a level-zero code. -/
theorem universe_cannot_lift_down :
    ¬ HasCode (.nil : Tower.Ctx 0)
      (Code.lift (.succ Tower.zero) Tower.zero (Code.univ Tower.zero))
      Tower.zero := by
  intro formation
  cases formation with
  | lift sourceFormation order =>
      have notOrder : ¬ Tower.Cumulative
          (.sort (.succ Tower.zero)) (.sort Tower.zero) := by
        decide
      exact notOrder order

end RussellTarski

