import Mettapedia.Languages.MeTTa.MeTTaZero
import Mathlib.Algebra.BigOperators.Group.Multiset.Basic
import Mathlib.Algebra.Ring.Defs

/-!
# The free answer algebra of MeTTa Zero

MeTTa Zero uses `Multiset Pattern` as its reference answer carrier.  This is
not a hidden choice of one universal weight semiring.  A multiset is the free
commutative additive carrier on answer occurrences: every assignment of
generators into an additive commutative monoid extends uniquely to an
additive observation of answer bags.

Consequently bag, support, natural-number counting, provenance-polynomial,
probability, and other observations belong downstream of the same occurrence
semantics.  A semiring becomes necessary when an observation also interprets
independent composition multiplicatively; the kernel itself need not select
which semiring that is.

The bind law below is the compositional bridge.  Interpreting a flattened
answer computation equals interpreting each continuation bag and then the
outer bag.  This is the free commutative-monad form of query/evaluation
composition.
-/

namespace Mettapedia.Languages.MeTTa.MeTTaZeroAnswerAlgebra

open Mettapedia.Languages.MeTTa.MeTTaZero
open Mettapedia.OSLF.MeTTaIL.Syntax

/-- Extend weights on individual answers to an additive observation of the
whole occurrence bag. -/
def foldMap {Observation : Type*} [AddCommMonoid Observation]
    (generator : Pattern → Observation) (answers : Multiset Pattern) :
    Observation :=
  (answers.map generator).sum

@[simp] theorem foldMap_zero {Observation : Type*}
    [AddCommMonoid Observation] (generator : Pattern → Observation) :
    foldMap generator 0 = 0 :=
  rfl

@[simp] theorem foldMap_singleton {Observation : Type*}
    [AddCommMonoid Observation] (generator : Pattern → Observation)
    (answer : Pattern) :
    foldMap generator {answer} = generator answer := by
  simp [foldMap]

@[simp] theorem foldMap_add {Observation : Type*}
    [AddCommMonoid Observation] (generator : Pattern → Observation)
    (first second : Multiset Pattern) :
    foldMap generator (first + second) =
      foldMap generator first + foldMap generator second := by
  simp [foldMap]

/-- An observation of answer bags that respects occurrence union. -/
structure AdditiveObservation (Observation : Type*)
    [AddCommMonoid Observation] where
  observe : Multiset Pattern → Observation
  observe_zero : observe 0 = 0
  observe_add : ∀ first second,
    observe (first + second) = observe first + observe second

namespace AdditiveObservation

/-- Every additive observation is generated by what it does to singleton
answers.  This is the existence half of the free-commutative-monoid property. -/
theorem observe_eq_foldMap {Observation : Type*}
    [AddCommMonoid Observation]
    (observation : AdditiveObservation Observation)
    (answers : Multiset Pattern) :
    observation.observe answers =
      foldMap (fun answer => observation.observe {answer}) answers := by
  induction answers using Multiset.induction_on with
  | empty => simpa using observation.observe_zero
  | @cons answer answers inductionHypothesis =>
      calc
        observation.observe (answer ::ₘ answers) =
            observation.observe ({answer} + answers) := rfl
        _ = observation.observe {answer} + observation.observe answers :=
          observation.observe_add {answer} answers
        _ = observation.observe {answer} +
            foldMap (fun value => observation.observe {value}) answers := by
          rw [inductionHypothesis]
        _ = foldMap (fun value => observation.observe {value})
            (answer ::ₘ answers) := by
          simp [foldMap]

/-- Two additive observations agreeing on singleton answers agree everywhere.
This is the uniqueness half of the free property. -/
theorem ext_singleton {Observation : Type*} [AddCommMonoid Observation]
    (first second : AdditiveObservation Observation)
    (singletons : ∀ answer, first.observe {answer} = second.observe {answer}) :
    first.observe = second.observe := by
  funext answers
  rw [first.observe_eq_foldMap answers, second.observe_eq_foldMap answers]
  congr 1
  funext answer
  exact singletons answer

end AdditiveObservation

/-- Interpreting multiset bind factors through the interpretations of the
continuation bags.  Choice remains additive; sequential answer production is
the monadic composition. -/
theorem foldMap_bind {Observation : Type*} [AddCommMonoid Observation]
    (generator : Pattern → Observation) (answers : Multiset Pattern)
    (next : Pattern → Multiset Pattern) :
    foldMap generator (answers.bind next) =
      foldMap (fun answer => foldMap generator (next answer)) answers := by
  induction answers using Multiset.induction_on with
  | empty => rfl
  | @cons answer answers inductionHypothesis =>
      rw [Multiset.cons_bind, foldMap_add, inductionHypothesis]
      simp [foldMap]

/-- Counting occurrences is the constant-one interpretation into `Nat`. -/
theorem foldMap_one_eq_card (answers : Multiset Pattern) :
    foldMap (fun _ => (1 : Nat)) answers = answers.card := by
  induction answers using Multiset.induction_on with
  | empty => rfl
  | @cons answer answers inductionHypothesis =>
      rw [show answer ::ₘ answers = ({answer} : Multiset Pattern) + answers by rfl,
        foldMap_add, foldMap_singleton, inductionHypothesis]
      simp [Nat.add_comm]

/-- Every commutative semiring receives the same occurrence count through its
natural-number map.  Choosing a richer generator yields weighted or
provenance-sensitive observations without changing Zero's kernel. -/
theorem foldMap_one_eq_natCast {K : Type*} [CommSemiring K]
    (answers : Multiset Pattern) :
    foldMap (fun _ => (1 : K)) answers = (answers.card : K) := by
  induction answers using Multiset.induction_on with
  | empty => simp [foldMap]
  | @cons answer answers inductionHypothesis =>
      rw [show answer ::ₘ answers = ({answer} : Multiset Pattern) + answers by rfl,
        foldMap_add, foldMap_singleton, inductionHypothesis]
      simp [Nat.cast_succ, add_comm]

/-! ## The query operation respects the free addition -/

/-- Querying a union of occurrence spaces is the union of the two query bags.
This is the reference-level law from which every additive observation
inherits distribution. -/
theorem structural_query_add (first second : Multiset Pattern)
    (pattern template : Pattern) :
    query (structuralModel fun _ => 0) (first + second) pattern template =
      query (structuralModel fun _ => 0) first pattern template +
        query (structuralModel fun _ => 0) second pattern template := by
  simp [query, structuralModel]

/-- Every additive observation therefore distributes over space union. -/
theorem observe_structural_query_add {Observation : Type*}
    [AddCommMonoid Observation] (generator : Pattern → Observation)
    (first second : Multiset Pattern) (pattern template : Pattern) :
    foldMap generator
        (query (structuralModel fun _ => 0) (first + second) pattern template) =
      foldMap generator
          (query (structuralModel fun _ => 0) first pattern template) +
        foldMap generator
          (query (structuralModel fun _ => 0) second pattern template) := by
  rw [structural_query_add, foldMap_add]

/-! ## Non-collapse canary -/

/-- The free occurrence carrier distinguishes one answer from two.  Any
idempotent observation may quotient this distinction, but cannot claim to
preserve it. -/
theorem singleton_ne_duplicate (answer : Pattern) :
    ({answer} : Multiset Pattern) ≠ {answer, answer} := by
  intro equal
  have cards := congrArg Multiset.card equal
  simp at cards

end Mettapedia.Languages.MeTTa.MeTTaZeroAnswerAlgebra
