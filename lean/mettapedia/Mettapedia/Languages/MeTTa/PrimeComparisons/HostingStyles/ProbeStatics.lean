open Mettapedia.Languages.MeTTa.PrimeCandidates.NucleusDerivedModalTyping (probeWithChoice)

/-! ## Languages whose static equivalence is quotation and dropping alone -/

/-- The quotation of a pattern. -/
def quoted (pattern : Pattern) : Pattern := .apply "prime-quote" [pattern]

/-- The dropping of a pattern. -/
def dropped (pattern : Pattern) : Pattern := .apply "prime-drop" [pattern]

/-- **The static equivalence of a language is generated by the equation of
quotation and dropping alone**: that is its one authored equation, and it
declares no bag, no set and no collection algebra. -/
structure QuoteDropOnly (lang : LanguageDef) : Prop where
  equations : lang.equations = [quoteDropEquation]
  noBags : lang.usesCollection .hashBag = false
  noSets : lang.usesCollection .hashSet = false
  noAlgebra : lang.hasAlgebraDeclarations = false

/-- **Positive**: the probe. -/
theorem language_quoteDropOnly : QuoteDropOnly language :=
  ⟨rfl, by decide, by decide, by decide⟩

/-- **Positive**: the probe extended with choice. -/
theorem probeWithChoice_quoteDropOnly : QuoteDropOnly probeWithChoice :=
  ⟨rfl, by decide, by decide, by decide⟩

/-- **Negative**: the query-first Zero language has no equation at all. -/
theorem zero_not_quoteDropOnly :
    ¬ QuoteDropOnly Mettapedia.Languages.MeTTa.MeTTaZero.language :=
  fun only => List.cons_ne_nil _ _ only.equations.symm

/-- **One generator relates a pattern and its quoted dropping**, in one of
the two directions. -/
theorem QuoteDropOnly.generator {lang : LanguageDef} (only : QuoteDropOnly lang)
    {base : BasePremiseEvaluator} {source target : Pattern}
    (generator : EquationGenerator base lang source target) :
    source = quoted (dropped target) ∨ target = quoted (dropped source) := by
  rcases generator with ⟨fuel, authored⟩ | derived
  · cases authored with
    | forward member _ matched premises applied =>
        rename_i equation initial final _
        rw [only.equations] at member
        obtain rfl : equation = quoteDropEquation := List.mem_singleton.mp member
        have same : final = initial := by
          change PremisesAt base lang fuel initial [] final at premises
          cases premises
          rfl
        subst same
        have rebuilt := matchPattern_correct matched (by decide)
        refine .inl ?_
        rw [← rebuilt, ← applied]
        simp [quoteDropEquation, applyBindings, quoted, dropped]
    | reverse member _ matched premises applied =>
        rename_i equation initial final _
        rw [only.equations] at member
        obtain rfl : equation = quoteDropEquation := List.mem_singleton.mp member
        have same : final = initial := by
          change PremisesAt base lang fuel initial [] final at premises
          cases premises
          rfl
        subst same
        have bound : final = [("name", source)] := by
          simpa [quoteDropEquation, matchPattern] using matched
        subst bound
        refine .inr ?_
        rw [← applied]
        simp [quoteDropEquation, applyBindings, quoted, dropped]
    | @declared equation _ _ _ _ member notRaw _ =>
        rw [only.equations] at member
        obtain rfl : equation = quoteDropEquation := List.mem_singleton.mp member
        rw [readsRaw_of_none rfl] at notRaw
        cases notRaw
  · exact (no_derivedInstance_of_no_derived_laws only.noBags only.noSets only.noAlgebra _ _
      derived).elim

/-! ## Contraction -/

/-- Contract a quotation of a dropping at the root. -/
def contractRoot (label : String) (arguments : List Pattern) : Pattern :=
  if label = "prime-quote" then
    match arguments with
    | [.apply inner [name]] => if inner = "prime-drop" then name else .apply label arguments
    | _ => .apply label arguments
  else .apply label arguments

mutual
  /-- **Remove every quotation of a dropping**, innermost first. -/
  def contract : Pattern → Pattern
    | .bvar index => .bvar index
    | .fvar name => .fvar name
    | .apply label arguments => contractRoot label (contractList arguments)
    | .lambda binder body => .lambda binder (contract body)
    | .multiLambda arity binders body => .multiLambda arity binders (contract body)
    | .subst body replacement => .subst (contract body) (contract replacement)
    | .collection kind elements rest => .collection kind (contractList elements) rest

  /-- Contraction, along a list. -/
  def contractList : List Pattern → List Pattern
    | [] => []
    | pattern :: patterns => contract pattern :: contractList patterns
end

@[simp] theorem contractList_eq_map :
    ∀ patterns : List Pattern, contractList patterns = patterns.map contract
  | [] => rfl
  | pattern :: patterns => by
      simp only [contractList, List.map_cons, contractList_eq_map patterns]

theorem contractRoot_of_ne {label : String} (other : label ≠ "prime-quote")
    (arguments : List Pattern) : contractRoot label arguments = .apply label arguments := by
  simp [contractRoot, other]

/-- The contraction of an application whose head is not quotation keeps the
head. -/
theorem contract_apply_of_ne {label : String} (other : label ≠ "prime-quote")
    (arguments : List Pattern) :
    contract (.apply label arguments) = .apply label (arguments.map contract) := by
  rw [contract, contractList_eq_map, contractRoot_of_ne other]

/-- **A quotation of a dropping contracts to what was dropped.** -/
theorem contract_quoted_dropped (pattern : Pattern) :
    contract (quoted (dropped pattern)) = contract pattern := by
  simp [quoted, dropped, contract, contractRoot]

/-- Contraction is compositional: it is determined by the contractions of
the parts. -/
theorem contract_fill (context : OneHoleContext) {first second : Pattern}
    (same : contract first = contract second) :
    contract (context.fill first) = contract (context.fill second) := by
  induction context with
  | hole => exact same
  | apply label before inner after ih =>
      simp only [OneHoleContext.fill, contract, contractList_eq_map, List.map_append, List.map_cons,
        ih]
  | lambda binder inner ih => simp only [OneHoleContext.fill, contract, ih]
  | multiLambda arity binders inner ih => simp only [OneHoleContext.fill, contract, ih]
  | substBody inner replacement ih => simp only [OneHoleContext.fill, contract, ih]
  | substReplacement body inner ih => simp only [OneHoleContext.fill, contract, ih]
  | collection kind before inner after rest ih =>
      simp only [OneHoleContext.fill, contract, contractList_eq_map, List.map_append, List.map_cons,
        ih]

/-! ## Weight -/

/-- A node counts, unless it is a quotation or a dropping of one pattern. -/
def nodeWeight (label : String) (arity : Nat) : Nat :=
  if (label = "prime-quote" ∨ label = "prime-drop") ∧ arity = 1 then 0 else 1

mutual
  /-- **The weight of a pattern**: the number of its nodes other than the
  quotations and the droppings of one pattern. -/
  def weight : Pattern → Nat
    | .bvar _ => 1
    | .fvar _ => 1
    | .apply label arguments => nodeWeight label arguments.length + weightList arguments
    | .lambda _ body => 1 + weight body
    | .multiLambda _ _ body => 1 + weight body
    | .subst body replacement => 1 + weight body + weight replacement
    | .collection _ elements _ => 1 + weightList elements

  /-- The weight of a list of patterns. -/
  def weightList : List Pattern → Nat
    | [] => 0
    | pattern :: patterns => weight pattern + weightList patterns
end

/-- **Every pattern has a positive weight.** -/
theorem weight_pos (pattern : Pattern) : 0 < weight pattern := by
  induction pattern using Pattern.inductionOn with
  | hbvar index => simp [weight]
  | hfvar name => simp [weight]
  | happly label arguments ih =>
      rw [weight]
      by_cases counted : (label = "prime-quote" ∨ label = "prime-drop") ∧ arguments.length = 1
      · obtain ⟨argument, rfl⟩ := List.length_eq_one_iff.mp counted.2
        have positive := ih argument (List.mem_singleton.mpr rfl)
        simp only [weightList]
        omega
      · simp only [nodeWeight, counted, if_false]
        omega
  | hlambda binder body ih => rw [weight]; omega
  | hmultiLambda arity binders body ih => rw [weight]; omega
  | hsubst body replacement ihBody ihReplacement => rw [weight]; omega
  | hcollection kind elements rest ih => rw [weight]; omega

/-- **A quotation of a dropping weighs what was dropped.** -/
theorem weight_quoted_dropped (pattern : Pattern) :
    weight (quoted (dropped pattern)) = weight pattern := by
  simp [quoted, dropped, weight, weightList, nodeWeight]

mutual
  /-- The weight of a pattern with holes, its holes not counted. -/
  def contextWeight {ι : Type} : MultiHoleContext ι → Nat
    | .hole _ => 0
    | .bvar _ => 1
    | .fvar _ => 1
    | .apply label arguments => nodeWeight label arguments.length + contextWeightList arguments
    | .lambda _ body => 1 + contextWeight body
    | .multiLambda _ _ body => 1 + contextWeight body
    | .subst body replacement => 1 + contextWeight body + contextWeight replacement
    | .collection _ elements _ => 1 + contextWeightList elements

  /-- The weight of a list of patterns with holes. -/
  def contextWeightList {ι : Type} : List (MultiHoleContext ι) → Nat
    | [] => 0
    | context :: contexts => contextWeight context + contextWeightList contexts
end

mutual
  /-- **A context adds the weights of what fills its holes**, each as often
  as its hole occurs. -/
  theorem weight_fill {ι : Type} (filling : ι → Pattern) :
      ∀ context : MultiHoleContext ι,
        weight (context.fill filling) =
          contextWeight context + (context.holes.map fun index => weight (filling index)).sum
    | .hole index => by
        simp [MultiHoleContext.fill, contextWeight, MultiHoleContext.holes]
    | .bvar index => by
        simp [MultiHoleContext.fill, contextWeight, MultiHoleContext.holes, weight]
    | .fvar name => by
        simp [MultiHoleContext.fill, contextWeight, MultiHoleContext.holes, weight]
    | .apply label arguments => by
        have lengths : (MultiHoleContext.fillList filling arguments).length = arguments.length := by
          simp
        rw [MultiHoleContext.fill, weight, contextWeight, MultiHoleContext.holes,
          weightList_fillList filling arguments, lengths]
        omega
    | .lambda binder body => by
        rw [MultiHoleContext.fill, weight, contextWeight, MultiHoleContext.holes,
          weight_fill filling body]
        omega
    | .multiLambda arity binders body => by
        rw [MultiHoleContext.fill, weight, contextWeight, MultiHoleContext.holes,
          weight_fill filling body]
        omega
    | .subst body replacement => by
        rw [MultiHoleContext.fill, weight, contextWeight, MultiHoleContext.holes,
          weight_fill filling body, weight_fill filling replacement, List.map_append,
          List.sum_append]
        omega
    | .collection kind elements rest => by
        rw [MultiHoleContext.fill, weight, contextWeight, MultiHoleContext.holes,
          weightList_fillList filling elements]
        omega

  theorem weightList_fillList {ι : Type} (filling : ι → Pattern) :
      ∀ contexts : List (MultiHoleContext ι),
        weightList (MultiHoleContext.fillList filling contexts) =
          contextWeightList contexts +
            ((MultiHoleContext.holesList contexts).map fun index => weight (filling index)).sum
    | [] => by
        simp [MultiHoleContext.fillList, weightList, contextWeightList, MultiHoleContext.holesList]
    | context :: contexts => by
        rw [MultiHoleContext.fillList, weightList, contextWeightList, MultiHoleContext.holesList,
          weight_fill filling context, weightList_fillList filling contexts, List.map_append,
          List.sum_append]
        omega
end

/-- A context of one hole adds the weight of what fills it. -/
theorem weight_fill_oneHole (context : OneHoleContext) (pattern : Pattern) :
    weight (context.fill pattern) =
      contextWeight (MultiHoleContext.ofOneHole context) + weight pattern := by
  have filled := weight_fill (fun _ : Unit => pattern) (MultiHoleContext.ofOneHole context)
  rw [MultiHoleContext.fill_ofOneHole, MultiHoleContext.holes_ofOneHole] at filled
  simpa using filled

/-! ## Both are constant on the classes of the static equivalence -/

/-- The static equivalence of the terms of one interface is contained in the
equivalence of their patterns, for every language and every evaluator of its
premises. -/
theorem equationEquiv_of_termSetoid {lang : LanguageDef} {base : BasePremiseEvaluator}
    {interface : Contexts.Interface} {first second : Contexts.Term lang interface}
    (related : (termSetoid base lang interface).r first second) :
    EquationEquiv base lang first.1 second.1 := by
  induction related with
  | rel _ _ step => exact .rel _ _ step
  | refl _ => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

namespace QuoteDropOnly

variable {lang : LanguageDef} {base : BasePremiseEvaluator}

/-- One generator in one context keeps the contraction and the weight. -/
theorem contextStep (only : QuoteDropOnly lang) {left right : Pattern}
    (step : EquationContextStep base lang left right) :
    contract left = contract right ∧ weight left = weight right := by
  cases step with
  | inContext context generator =>
      rcases only.generator generator with rfl | rfl
      · exact ⟨contract_fill context (contract_quoted_dropped _), by
          rw [weight_fill_oneHole, weight_fill_oneHole, weight_quoted_dropped]⟩
      · exact ⟨contract_fill context (contract_quoted_dropped _).symm, by
          rw [weight_fill_oneHole, weight_fill_oneHole, weight_quoted_dropped]⟩

/-- **Equivalent patterns have the same contraction and the same weight.** -/
theorem equiv (only : QuoteDropOnly lang) {left right : Pattern}
    (equivalent : EquationEquiv base lang left right) :
    contract left = contract right ∧ weight left = weight right := by
  induction equivalent with
  | rel _ _ step => exact only.contextStep step
  | refl _ => exact ⟨rfl, rfl⟩
  | symm _ _ _ ih => exact ⟨ih.1.symm, ih.2.symm⟩
  | trans _ _ _ _ _ first second => exact ⟨first.1.trans second.1, first.2.trans second.2⟩

/-- **Contraction is constant on the classes of the terms of an
interface.** -/
theorem contract_eq (only : QuoteDropOnly lang) {interface : Contexts.Interface}
    {first second : Contexts.Term lang interface}
    (related : (termSetoid base lang interface).r first second) :
    contract first.1 = contract second.1 :=
  (only.equiv (equationEquiv_of_termSetoid related)).1

/-- **Weight is constant on the classes of the terms of an interface.** -/
theorem weight_eq (only : QuoteDropOnly lang) {interface : Contexts.Interface}
    {first second : Contexts.Term lang interface}
    (related : (termSetoid base lang interface).r first second) :
    weight first.1 = weight second.1 :=
  (only.equiv (equationEquiv_of_termSetoid related)).2

/-- **The contexts of the presentation have a linear size**: the weight. -/
def linearSize (presentation : ValidatedLanguageDef)
    (only : QuoteDropOnly presentation.language) (base : BasePremiseEvaluator) :
    (contextTheory base presentation).LinearSize where
  size := fun term => weight term.1
  positive := fun term => weight_pos term.1
  respects := fun related => only.weight_eq related
  additive := fun {arity} _ _ _ context => by
    classical
    refine ⟨contextWeight context.shape, fun filling => ?_⟩
    show weight (context.shape.fill fun index => (filling index).1) = _
    rw [weight_fill, ← List.sum_toFinset _ context.linear.1]
    congr 2
    exact Finset.eq_univ_iff_forall.mpr fun index => List.mem_toFinset.mpr (context.linear.2 index)

end QuoteDropOnly

/-! ## The asymmetry of the equation -/

/-- **Dropping a quotation is not undone**: the equation contracts a
quotation of a dropping, and no equation contracts a dropping of a
quotation. -/
theorem dropped_quoted_ne_contract :
    contract (dropped (quoted (.apply "prime-unit" []))) ≠ contract (.apply "prime-unit" []) := by
  decide

/-- **Negative**: the quotation of the dropping of a quotation is contracted,
so quotation identifies what dropping keeps apart. -/
theorem quoted_dropped_quoted_contract (pattern : Pattern) :
    contract (quoted (dropped (quoted pattern))) = contract (quoted pattern) :=
  contract_quoted_dropped _

