import Mettapedia.Cybernetics.DistinctionCalculus.Ledger

/-!
# Graded congruences: the least closure and the greatest adequate policy

A fragment of terms with a monoid of contexts acting on it (the contexts of an
admissible class that keep the fragment closed) carries **graded congruences**:
metric tolerances for which every context is nonexpansive. Two canonical ones
bracket every selection problem.

* **The generated end.** Graded congruences are closed under pointwise minimum
  and include total collapse, and above every seed there is a least one:
  close the seed under contexts, then metrically (`leastCongruence`). It is a
  reflection onto graded congruences. For a crisp seed it is crisp, and its
  zero kernel is the congruence generated by the seed (`CongGen`), so the
  generated congruence of a finite fragment is decidable. Without contexts it
  is the equivalence closure.
* **The observational end.** For declared consumers `F`, with
  `d_F(x, y) = max_j |f_j x − f_j y|`, the all-continuation discrepancy
  `d_F^M(x, y) = max_c d_F(c x, c y)` gives the greatest graded congruence
  that protects `F` (`continuationTolerance`). Its zero kernel is the largest
  congruence inside the kernel of `F`. When every context is nonexpansive for
  `d_F`, it is `1 − d_F` itself.
* **The two senses of "weakest".** Under the baseline guard, the feasible
  graded congruences form the interval from the generated end to the
  observational end (`feasible_interval`). The generated congruence is inside
  the observational one as soon as every stipulated identification is
  observationally valid (`congGen_le_observational`); the converse is a
  completeness property of the stipulations, and it can fail.

Grades are readouts: a positive distance never identifies. The controls
module shows a metric tolerance whose threshold relation is not transitive.
-/

set_option autoImplicit false

namespace Mettapedia.Cybernetics.DistinctionCalculus

universe u v w

/-! ## Contexts on a fragment -/

/-- A monoid of contexts acting on a fragment of terms: the admissible
contexts that keep the fragment closed, with the identity and composition. -/
structure ContextMonoid (C : Type v) (V : Type u) where
  act : C → V → V
  unit : C
  mul : C → C → C
  act_unit : ∀ x, act unit x = x
  act_mul : ∀ c d x, act (mul c d) x = act c (act d x)

namespace ContextMonoid

/-- A monoid of contexts is inhabited by its unit. -/
theorem univ_nonempty {C : Type v} {V : Type u} [Fintype C] (M : ContextMonoid C V) :
    (Finset.univ : Finset C).Nonempty :=
  ⟨M.unit, Finset.mem_univ M.unit⟩

/-- Only the identity context. -/
def trivial (V : Type u) : ContextMonoid Unit V where
  act _ x := x
  unit := ()
  mul _ _ := ()
  act_unit _ := rfl
  act_mul _ _ _ := rfl

end ContextMonoid

variable {C : Type v} {V : Type u}

namespace Tolerance

/-- Every context is nonexpansive for the distance of `a`. -/
def ContextClosed (M : ContextMonoid C V) (a : Tolerance V) : Prop :=
  ∀ c x y, a.similarity x y ≤ a.similarity (M.act c x) (M.act c y)

/-- **A graded congruence**: a metric tolerance for which every context is
nonexpansive. -/
def GradedCongruence (M : ContextMonoid C V) (a : Tolerance V) : Prop :=
  a.Metric ∧ a.ContextClosed M

/-- The observer that identifies everything. -/
def top : Tolerance V where
  similarity _ _ := 1
  nonnegative _ _ := zero_le_one
  bounded _ _ := le_rfl
  reflexive _ := rfl
  symmetric _ _ := rfl

theorem extends_top (a : Tolerance V) : a.Extends top :=
  fun x y => a.bounded x y

theorem top_gradedCongruence (M : ContextMonoid C V) : top.GradedCongruence M :=
  ⟨fun _ _ _ => by simp [distance, top], fun _ _ _ => le_rfl⟩

variable {M : ContextMonoid C V} {a b : Tolerance V}

theorem ContextClosed.distance_le (closed : a.ContextClosed M) (c : C) (x y : V) :
    a.distance (M.act c x) (M.act c y) ≤ a.distance x y := by
  unfold distance
  linarith [closed c x y]

theorem ContextClosed.inf (ha : a.ContextClosed M) (hb : b.ContextClosed M) :
    (a.inf b).ContextClosed M :=
  fun c x y => min_le_min (ha c x y) (hb c x y)

/-- **Graded congruences are closed under pointwise minimum.** -/
theorem GradedCongruence.inf (ha : a.GradedCongruence M) (hb : b.GradedCongruence M) :
    (a.inf b).GradedCongruence M :=
  ⟨inf_metric ha.1 hb.1, ha.2.inf hb.2⟩

/-- The zero kernel of a graded congruence is a congruence. -/
theorem GradedCongruence.indistinguishable_act (congruence : a.GradedCongruence M) (c : C)
    {x y : V} (same : a.Indistinguishable x y) :
    a.Indistinguishable (M.act c x) (M.act c y) :=
  le_antisymm (same ▸ congruence.2.distance_le c x y)
    (a.distance_nonnegative _ _)

end Tolerance

/-! ## The context image of a seed -/

section Push

variable [Fintype C] [Fintype V] [DecidableEq V] (M : ContextMonoid C V)

/-- The context triples that carry a seed pair onto `(p, q)`. -/
def carriers (p q : V) : Finset (C × V × V) :=
  Finset.univ.filter fun t => M.act t.1 t.2.1 = p ∧ M.act t.1 t.2.2 = q

theorem mem_carriers {p q : V} {t : C × V × V} :
    t ∈ carriers M p q ↔ M.act t.1 t.2.1 = p ∧ M.act t.1 t.2.2 = q := by
  simp [carriers]

theorem unit_mem_carriers (p q : V) : (M.unit, p, q) ∈ carriers M p q :=
  (mem_carriers M).mpr ⟨M.act_unit p, M.act_unit q⟩

theorem carriers_nonempty (p q : V) : (carriers M p q).Nonempty :=
  ⟨_, unit_mem_carriers M p q⟩

/-- **The context image of a seed**: the largest seed similarity that some
context carries onto the pair. -/
def push (a : Tolerance V) : Tolerance V where
  similarity p q :=
    (carriers M p q).sup' (carriers_nonempty M p q) fun t => a.similarity t.2.1 t.2.2
  nonnegative p q := (a.nonnegative p q).trans
    (Finset.le_sup' (fun t : C × V × V => a.similarity t.2.1 t.2.2) (unit_mem_carriers M p q))
  bounded p q := Finset.sup'_le _ _ fun t _ => a.bounded _ _
  reflexive p := le_antisymm (Finset.sup'_le _ _ fun t _ => a.bounded _ _) (by
    have := Finset.le_sup' (fun t : C × V × V => a.similarity t.2.1 t.2.2) (unit_mem_carriers M p p)
    rwa [a.reflexive] at this)
  symmetric p q := by
    apply le_antisymm
    · refine Finset.sup'_le _ _ fun t member => ?_
      have swapped : (t.1, t.2.2, t.2.1) ∈ carriers M q p := by
        rw [mem_carriers] at member ⊢
        exact ⟨member.2, member.1⟩
      rw [a.symmetric]
      exact Finset.le_sup' (fun t : C × V × V => a.similarity t.2.1 t.2.2) swapped
    · refine Finset.sup'_le _ _ fun t member => ?_
      have swapped : (t.1, t.2.2, t.2.1) ∈ carriers M p q := by
        rw [mem_carriers] at member ⊢
        exact ⟨member.2, member.1⟩
      rw [a.symmetric]
      exact Finset.le_sup' (fun t : C × V × V => a.similarity t.2.1 t.2.2) swapped

theorem push_similarity (a : Tolerance V) (p q : V) :
    (push M a).similarity p q =
      (carriers M p q).sup' (carriers_nonempty M p q) fun t => a.similarity t.2.1 t.2.2 :=
  rfl

variable {M}

theorem le_push_similarity (a : Tolerance V) {c : C} {x y : V} :
    a.similarity x y ≤ (push M a).similarity (M.act c x) (M.act c y) :=
  Finset.le_sup' (fun t : C × V × V => a.similarity t.2.1 t.2.2)
    ((mem_carriers M).mpr (⟨rfl, rfl⟩ : M.act (c, x, y).1 (c, x, y).2.1 = M.act c x ∧
      M.act (c, x, y).1 (c, x, y).2.2 = M.act c y))

/-- The context image extends the seed. -/
theorem extends_push (a : Tolerance V) : a.Extends (push M a) := by
  intro x y
  have := le_push_similarity (M := M) a (c := M.unit) (x := x) (y := y)
  rwa [M.act_unit, M.act_unit] at this

/-- **The context image is context-closed**: composing contexts keeps the
carrying triple a carrying triple. -/
theorem push_contextClosed (a : Tolerance V) : (push M a).ContextClosed M := by
  intro c p q
  obtain ⟨t, member, attained⟩ :=
    Finset.exists_mem_eq_sup' (carriers_nonempty M p q) fun t => a.similarity t.2.1 t.2.2
  have carried := (mem_carriers M).mp member
  rw [push_similarity, attained]
  have composed := le_push_similarity (M := M) a (c := M.mul c t.1) (x := t.2.1) (y := t.2.2)
  rwa [M.act_mul, M.act_mul, carried.1, carried.2] at composed

/-- Every context-closed tolerance above the seed is above its context image. -/
theorem push_extends_of_contextClosed {a b : Tolerance V} (above : a.Extends b)
    (closed : b.ContextClosed M) : (push M a).Extends b := by
  intro p q
  rw [push_similarity]
  refine Finset.sup'_le _ _ fun t member => ?_
  have carried := (mem_carriers M).mp member
  have := closed t.1 t.2.1 t.2.2
  rw [carried.1, carried.2] at this
  exact (above _ _).trans this

end Push

/-! ## Closure preserves context-closedness -/

section Closure

variable [DecidableEq V]

/-- A nonexpansive map does not lengthen paths. -/
theorem pathCost_map_le (a : Tolerance V) (f : V → V)
    (nonexpansive : ∀ x y, a.distance (f x) (f y) ≤ a.distance x y) :
    ∀ path : List V, pathCost a (path.map f) ≤ pathCost a path
  | [] => le_rfl
  | [_] => le_rfl
  | x :: y :: rest => by
      simp only [List.map_cons, pathCost]
      exact combine_mono (nonexpansive x y) (pathCost_map_le a f nonexpansive (y :: rest))

variable [Fintype V] {M : ContextMonoid C V}

/-- **Metric closure preserves context-closedness**: a context maps a path to a
path that is no longer. -/
theorem shortestTolerance_contextClosed {a : Tolerance V} (closed : a.ContextClosed M) :
    (shortestTolerance a).ContextClosed M := by
  intro c x y
  obtain ⟨path, member, attained⟩ :=
    Finset.exists_mem_eq_inf' (simplePaths_nonempty (x := x) (y := y)) (pathCost a)
  have properties := (mem_simplePaths (x := x) (y := y)).1 member
  have nonempty : path.map (M.act c) ≠ [] := by
    rw [Ne, List.map_eq_nil_iff]
    exact ne_nil_of_head? properties.2.1
  have head : (path.map (M.act c)).head? = some (M.act c x) := by
    rw [List.head?_map, properties.2.1]
    rfl
  have last : (path.map (M.act c)).getLast? = some (M.act c y) := by
    rw [List.getLast?_map, properties.2.2.1]
    rfl
  have mapped := shortestDistance_le_pathCost a nonempty head last
  have shorter := pathCost_map_le a (M.act c) (closed.distance_le c) path
  have value : shortestDistance a x y = pathCost a path := attained
  change 1 - shortestDistance a x y ≤ 1 - shortestDistance a (M.act c x) (M.act c y)
  linarith

end Closure

/-! ## The least graded congruence above a seed -/

section Least

variable [Fintype C] [Fintype V] [DecidableEq V] (M : ContextMonoid C V)

/-- **The least graded congruence above a seed**: close under contexts, then
metrically. -/
def leastCongruence (a : Tolerance V) : Tolerance V :=
  shortestTolerance (push M a)

variable {M}

theorem extends_leastCongruence (a : Tolerance V) : a.Extends (leastCongruence M a) :=
  fun x y => (extends_push a x y).trans (shortestTolerance_extends _ x y)

theorem leastCongruence_gradedCongruence (a : Tolerance V) :
    (leastCongruence M a).GradedCongruence M :=
  ⟨shortestTolerance_metric _, shortestTolerance_contextClosed (push_contextClosed a)⟩

/-- **It is the least one**: every graded congruence above the seed is above
it. -/
theorem leastCongruence_extends {a b : Tolerance V} (congruence : b.GradedCongruence M)
    (above : a.Extends b) : (leastCongruence M a).Extends b :=
  (shortestTolerance_is_least _).2.2 b (push_extends_of_contextClosed above congruence.2)
    congruence.1

/-- **A reflection onto graded congruences**: for a graded congruence `b`,
`leastCongruence a ≤ b` exactly when `a ≤ b`. -/
theorem leastCongruence_extends_iff {a b : Tolerance V} (congruence : b.GradedCongruence M) :
    (leastCongruence M a).Extends b ↔ a.Extends b :=
  ⟨fun le x y => (extends_leastCongruence a x y).trans (le x y),
    leastCongruence_extends congruence⟩

/-- A graded congruence is its own least graded congruence. -/
theorem leastCongruence_eq_self {a : Tolerance V} (congruence : a.GradedCongruence M) :
    leastCongruence M a = a := by
  ext x y
  exact le_antisymm (leastCongruence_extends congruence (fun _ _ => le_rfl) x y)
    (extends_leastCongruence a x y)

/-- The least graded congruence is monotone in the seed. -/
theorem leastCongruence_mono {a b : Tolerance V} (le : a.Extends b) :
    (leastCongruence M a).Extends (leastCongruence M b) :=
  leastCongruence_extends (leastCongruence_gradedCongruence b)
    fun x y => (le x y).trans (extends_leastCongruence b x y)

/-- Without contexts the least graded congruence is the metric closure. -/
theorem leastCongruence_trivial (a : Tolerance V) :
    leastCongruence (ContextMonoid.trivial V) a = shortestTolerance a := by
  unfold leastCongruence
  congr 1
  ext p q
  apply le_antisymm
  · rw [push_similarity]
    refine Finset.sup'_le _ _ fun t member => ?_
    have carried := (mem_carriers (ContextMonoid.trivial V)).mp member
    change (ContextMonoid.trivial V).act t.1 t.2.1 = p ∧ (ContextMonoid.trivial V).act t.1 t.2.2 = q
      at carried
    simp only [ContextMonoid.trivial] at carried
    rw [carried.1, carried.2]
  · exact extends_push a p q

end Least

/-! ## Crisp seeds: the generated congruence -/

/-- The congruence generated by a relation: the least equivalence relation
containing it and preserved by every context. -/
inductive CongGen (M : ContextMonoid C V) (R : V → V → Prop) : V → V → Prop where
  | rel {x y : V} : R x y → CongGen M R x y
  | refl (x : V) : CongGen M R x x
  | symm {x y : V} : CongGen M R x y → CongGen M R y x
  | trans {x y z : V} : CongGen M R x y → CongGen M R y z → CongGen M R x z
  | act (c : C) {x y : V} : CongGen M R x y → CongGen M R (M.act c x) (M.act c y)

/-- Without contexts the generated congruence is the equivalence closure. -/
theorem congGen_trivial_iff (R : V → V → Prop) {x y : V} :
    CongGen (ContextMonoid.trivial V) R x y ↔ Relation.EqvGen R x y := by
  constructor
  · intro generated
    induction generated with
    | rel related => exact Relation.EqvGen.rel _ _ related
    | refl z => exact Relation.EqvGen.refl z
    | symm _ ih => exact Relation.EqvGen.symm _ _ ih
    | trans _ _ ih ih' => exact Relation.EqvGen.trans _ _ _ ih ih'
    | act _ _ ih => exact ih
  · intro generated
    induction generated with
    | rel _ _ related => exact CongGen.rel related
    | refl z => exact CongGen.refl z
    | symm _ _ _ ih => exact CongGen.symm ih
    | trans _ _ _ _ _ ih ih' => exact CongGen.trans ih ih'

/-- The generated congruence is the least congruence containing the relation. -/
theorem congGen_le {M : ContextMonoid C V} {R : V → V → Prop} {E : Setoid V}
    (contains : ∀ {x y}, R x y → E x y) (closed : ∀ c {x y}, E x y → E (M.act c x) (M.act c y))
    {x y : V} (generated : CongGen M R x y) : E x y := by
  induction generated with
  | rel related => exact contains related
  | refl z => exact E.refl' z
  | symm _ ih => exact E.symm' ih
  | trans _ _ ih ih' => exact E.trans' ih ih'
  | act c _ ih => exact closed c ih

section CrispLeast

variable [Fintype C] [Fintype V] [DecidableEq V] {M : ContextMonoid C V}
  (R : V → V → Prop) [DecidableRel R] (refl : ∀ x, R x x) (symm : ∀ {x y}, R x y → R y x)

/-- The context image of a crisp seed identifies a pair exactly when some
context carries a related pair onto it. -/
theorem push_ofRel_similarity_eq_one_iff {p q : V} :
    (push M (Tolerance.ofRel R refl symm)).similarity p q = 1 ↔
      ∃ c x y, R x y ∧ M.act c x = p ∧ M.act c y = q := by
  constructor
  · intro one
    obtain ⟨t, member, attained⟩ := Finset.exists_mem_eq_sup' (carriers_nonempty M p q)
      fun t => (Tolerance.ofRel R refl symm).similarity t.2.1 t.2.2
    have carried := (mem_carriers M).mp member
    have value : (Tolerance.ofRel R refl symm).similarity t.2.1 t.2.2 = 1 := by
      rw [← attained]
      exact one
    exact ⟨t.1, t.2.1, t.2.2, (Tolerance.ofRel_similarity_eq_one_iff R refl symm).mp value,
      carried.1, carried.2⟩
  · rintro ⟨c, x, y, related, rfl, rfl⟩
    apply le_antisymm ((push M (Tolerance.ofRel R refl symm)).bounded _ _)
    have := le_push_similarity (M := M) (Tolerance.ofRel R refl symm) (c := c) (x := x) (y := y)
    rwa [(Tolerance.ofRel_similarity_eq_one_iff R refl symm).mpr related] at this

/-- A chain of identified context-image edges of a crisp seed lies in the
generated congruence. -/
theorem congGen_of_reflTransGen_push {x y : V}
    (chain : Relation.ReflTransGen
      (fun u v => (push M (Tolerance.ofRel R refl symm)).distance u v = 0) x y) :
    CongGen M R x y := by
  induction chain with
  | refl => exact CongGen.refl x
  | @tail u v _ edge ih =>
      have one : (push M (Tolerance.ofRel R refl symm)).similarity u v = 1 := by
        unfold Tolerance.distance at edge
        linarith
      obtain ⟨c, x', y', related, rfl, rfl⟩ :=
        (push_ofRel_similarity_eq_one_iff R refl symm).mp one
      exact CongGen.trans ih (CongGen.act c (CongGen.rel related))

/-- **The least graded congruence of a crisp seed identifies exactly the
generated congruence.** -/
theorem leastCongruence_ofRel_indistinguishable_iff {x y : V} :
    (leastCongruence M (Tolerance.ofRel R refl symm)).Indistinguishable x y ↔ CongGen M R x y := by
  constructor
  · intro zero
    have closedZero : shortestDistance (push M (Tolerance.ofRel R refl symm)) x y = 0 := by
      rw [← shortestTolerance_distance]
      exact zero
    exact congGen_of_reflTransGen_push R refl symm
      (reflTransGen_of_shortestDistance_eq_zero _ closedZero)
  · intro generated
    have congruence := leastCongruence_gradedCongruence (M := M) (Tolerance.ofRel R refl symm)
    induction generated with
    | @rel u v related =>
        rw [Tolerance.indistinguishable_iff_similarity_one]
        apply le_antisymm (Tolerance.bounded _ _ _)
        have := extends_leastCongruence (M := M) (Tolerance.ofRel R refl symm) u v
        rwa [(Tolerance.ofRel_similarity_eq_one_iff R refl symm).mpr related] at this
    | refl z => exact Tolerance.distance_self _ z
    | symm _ ih => exact (Tolerance.zeroSetoid _ congruence.1).symm' ih
    | trans _ _ ih ih' => exact (Tolerance.zeroSetoid _ congruence.1).trans' ih ih'
    | act c _ ih => exact congruence.indistinguishable_act c ih

/-- **The least graded congruence of a crisp seed is crisp.** -/
theorem leastCongruence_ofRel_crisp (x y : V) :
    (leastCongruence M (Tolerance.ofRel R refl symm)).similarity x y = 0 ∨
      (leastCongruence M (Tolerance.ofRel R refl symm)).similarity x y = 1 := by
  obtain ⟨path, _, attained⟩ :=
    Finset.exists_mem_eq_inf' (simplePaths_nonempty (x := x) (y := y))
      (pathCost (push M (Tolerance.ofRel R refl symm)))
  have crisp : ∀ u v, (push M (Tolerance.ofRel R refl symm)).distance u v = 0 ∨
      (push M (Tolerance.ofRel R refl symm)).distance u v = 1 := by
    intro u v
    obtain ⟨t, _, attained'⟩ := Finset.exists_mem_eq_sup' (carriers_nonempty M u v)
      fun t => (Tolerance.ofRel R refl symm).similarity t.2.1 t.2.2
    unfold Tolerance.distance
    rw [push_similarity, attained', Tolerance.ofRel_similarity]
    split_ifs
    · left
      norm_num
    · right
      norm_num
  have value : (leastCongruence M (Tolerance.ofRel R refl symm)).similarity x y =
      1 - pathCost (push M (Tolerance.ofRel R refl symm)) path := by
    change 1 - shortestDistance _ x y = _
    rw [show shortestDistance (push M (Tolerance.ofRel R refl symm)) x y = _ from attained]
  rw [value]
  rcases pathCost_crisp _ crisp path with zero | one
  · right
    rw [zero]
    norm_num
  · left
    rw [one]
    norm_num

/-- **The generated congruence of a finite fragment is decidable**, computed by
the least graded congruence. -/
@[instance_reducible]
def decidableCongGen : DecidableRel (CongGen M R) := fun x y =>
  decidable_of_iff ((leastCongruence M (Tolerance.ofRel R refl symm)).distance x y = 0)
    (leastCongruence_ofRel_indistinguishable_iff R refl symm)

/-- **The least graded congruence of a crisp seed is the crisp tolerance of the
generated congruence.** -/
theorem leastCongruence_ofRel_eq [DecidableRel (CongGen M R)] :
    leastCongruence M (Tolerance.ofRel R refl symm) =
      Tolerance.ofRel (CongGen M R) CongGen.refl CongGen.symm := by
  ext x y
  rw [Tolerance.ofRel_similarity]
  split_ifs with generated
  · exact (Tolerance.indistinguishable_iff_similarity_one _ _ _).mp
      ((leastCongruence_ofRel_indistinguishable_iff R refl symm).mpr generated)
  · rcases leastCongruence_ofRel_crisp (M := M) R refl symm x y with zero | one
    · exact zero
    · exact absurd ((leastCongruence_ofRel_indistinguishable_iff R refl symm).mp
        ((Tolerance.indistinguishable_iff_similarity_one _ _ _).mpr one)) generated

end CrispLeast

/-! ## Consumers and the observational end -/

/-- A finite nonempty family of bounded consumers of the fragment. -/
structure ConsumerFamily (J : Type w) (V : Type u) where
  value : J → V → ℚ
  nonneg : ∀ j x, 0 ≤ value j x
  le_one : ∀ j x, value j x ≤ 1

namespace ConsumerFamily

variable {J : Type w} [Fintype J] [Nonempty J] (F : ConsumerFamily J V)

/-- The protected distance `d_F(x, y) = max_j |f_j x − f_j y|`. -/
def distance (x y : V) : ℚ :=
  (Finset.univ : Finset J).sup' Finset.univ_nonempty fun j => |F.value j x - F.value j y|

theorem abs_le_distance (j : J) (x y : V) : |F.value j x - F.value j y| ≤ F.distance x y :=
  Finset.le_sup' (fun j => |F.value j x - F.value j y|) (Finset.mem_univ j)

theorem distance_le_iff {x y : V} {r : ℚ} :
    F.distance x y ≤ r ↔ ∀ j, |F.value j x - F.value j y| ≤ r := by
  unfold distance
  rw [Finset.sup'_le_iff]
  simp

theorem distance_nonneg (x y : V) : 0 ≤ F.distance x y := by
  obtain ⟨j⟩ := (inferInstance : Nonempty J)
  exact (abs_nonneg _).trans (F.abs_le_distance j x y)

theorem distance_le_one (x y : V) : F.distance x y ≤ 1 := by
  rw [distance_le_iff]
  intro j
  rw [abs_le]
  constructor <;> linarith [F.nonneg j x, F.nonneg j y, F.le_one j x, F.le_one j y]

theorem distance_self (x : V) : F.distance x x = 0 :=
  le_antisymm ((F.distance_le_iff).mpr fun j => by simp) (F.distance_nonneg x x)

theorem distance_symm (x y : V) : F.distance x y = F.distance y x := by
  unfold distance
  congr 1
  funext j
  exact abs_sub_comm _ _

theorem distance_triangle (x y z : V) : F.distance x z ≤ F.distance x y + F.distance y z := by
  rw [distance_le_iff]
  intro j
  exact (abs_sub_le _ (F.value j y) _).trans
    (add_le_add (F.abs_le_distance j x y) (F.abs_le_distance j y z))

theorem distance_eq_zero_iff {x y : V} : F.distance x y = 0 ↔ ∀ j, F.value j x = F.value j y := by
  constructor
  · intro zero j
    have := F.abs_le_distance j x y
    rw [zero] at this
    exact sub_eq_zero.mp (abs_nonpos_iff.mp this)
  · intro same
    exact le_antisymm ((F.distance_le_iff).mpr fun j => by rw [same j, sub_self, abs_zero])
      (F.distance_nonneg x y)

/-- The protected tolerance `1 − d_F`. -/
def tolerance : Tolerance V where
  similarity x y := 1 - F.distance x y
  nonnegative x y := sub_nonneg.mpr (F.distance_le_one x y)
  bounded x y := by linarith [F.distance_nonneg x y]
  reflexive x := by rw [F.distance_self, sub_zero]
  symmetric x y := by rw [F.distance_symm]

theorem tolerance_distance (x y : V) : F.tolerance.distance x y = F.distance x y := by
  simp [Tolerance.distance, tolerance]

theorem tolerance_metric : F.tolerance.Metric := by
  intro x y z
  rw [F.tolerance_distance, F.tolerance_distance, F.tolerance_distance]
  exact F.distance_triangle x y z

end ConsumerFamily

section Observational

variable [Fintype C] {J : Type w} [Fintype J] [Nonempty J]
  (M : ContextMonoid C V) (F : ConsumerFamily J V)

/-- **The all-continuation discrepancy** `d_F^M(x, y) = max_c d_F(c x, c y)`. -/
def continuationDistance (x y : V) : ℚ :=
  (Finset.univ : Finset C).sup' M.univ_nonempty fun c =>
    F.distance (M.act c x) (M.act c y)

theorem distance_act_le_continuation (c : C) (x y : V) :
    F.distance (M.act c x) (M.act c y) ≤ continuationDistance M F x y :=
  Finset.le_sup' (fun c => F.distance (M.act c x) (M.act c y)) (Finset.mem_univ c)

theorem continuationDistance_le_iff {x y : V} {r : ℚ} :
    continuationDistance M F x y ≤ r ↔ ∀ c, F.distance (M.act c x) (M.act c y) ≤ r := by
  unfold continuationDistance
  rw [Finset.sup'_le_iff]
  simp

theorem distance_le_continuation (x y : V) : F.distance x y ≤ continuationDistance M F x y := by
  have := distance_act_le_continuation M F M.unit x y
  rwa [M.act_unit, M.act_unit] at this

/-- The observational tolerance `1 − d_F^M`. -/
def continuationTolerance : Tolerance V where
  similarity x y := 1 - continuationDistance M F x y
  nonnegative x y := sub_nonneg.mpr ((continuationDistance_le_iff M F).mpr
    fun c => F.distance_le_one _ _)
  bounded x y := by linarith [(F.distance_nonneg x y).trans (distance_le_continuation M F x y)]
  reflexive x := by
    have zero : continuationDistance M F x x = 0 :=
      le_antisymm ((continuationDistance_le_iff M F).mpr fun c => (F.distance_self _).le)
        ((F.distance_nonneg x x).trans (distance_le_continuation M F x x))
    rw [zero, sub_zero]
  symmetric x y := by
    have swap : continuationDistance M F x y = continuationDistance M F y x := by
      unfold continuationDistance
      congr 1
      funext c
      exact F.distance_symm _ _
    rw [swap]

theorem continuationTolerance_distance (x y : V) :
    (continuationTolerance M F).distance x y = continuationDistance M F x y := by
  simp [Tolerance.distance, continuationTolerance]

theorem continuationTolerance_metric : (continuationTolerance M F).Metric := by
  intro x y z
  rw [continuationTolerance_distance, continuationTolerance_distance,
    continuationTolerance_distance, continuationDistance_le_iff]
  intro c
  exact (F.distance_triangle _ (M.act c y) _).trans
    (add_le_add (distance_act_le_continuation M F c x y) (distance_act_le_continuation M F c y z))

theorem continuationTolerance_contextClosed : (continuationTolerance M F).ContextClosed M := by
  intro c x y
  change 1 - continuationDistance M F x y ≤ 1 - continuationDistance M F (M.act c x) (M.act c y)
  have : continuationDistance M F (M.act c x) (M.act c y) ≤ continuationDistance M F x y := by
    rw [continuationDistance_le_iff]
    intro d
    have := distance_act_le_continuation M F (M.mul d c) x y
    rwa [M.act_mul, M.act_mul] at this
  linarith

/-- The observational tolerance is a graded congruence. -/
theorem continuationTolerance_gradedCongruence :
    (continuationTolerance M F).GradedCongruence M :=
  ⟨continuationTolerance_metric M F, continuationTolerance_contextClosed M F⟩

/-- It protects the consumers: it lies below `1 − d_F`. -/
theorem continuationTolerance_extends_tolerance :
    (continuationTolerance M F).Extends F.tolerance := by
  intro x y
  change 1 - continuationDistance M F x y ≤ 1 - F.distance x y
  linarith [distance_le_continuation M F x y]

/-- **The greatest graded congruence protecting the consumers.** Every
context-closed tolerance below `1 − d_F` lies below `1 − d_F^M`. -/
theorem extends_continuationTolerance {b : Tolerance V} (closed : b.ContextClosed M)
    (protects : b.Extends F.tolerance) : b.Extends (continuationTolerance M F) := by
  intro x y
  change b.similarity x y ≤ 1 - continuationDistance M F x y
  have bound : continuationDistance M F x y ≤ 1 - b.similarity x y := by
    rw [continuationDistance_le_iff]
    intro c
    have lifted := (closed c x y).trans (protects (M.act c x) (M.act c y))
    change b.similarity x y ≤ 1 - F.distance (M.act c x) (M.act c y) at lifted
    linarith
  linarith

/-- **Under the consumer guard the greatest adequate graded congruence is
`1 − d_F`**: when every context is nonexpansive for `d_F`, the continuation
discrepancy is `d_F` itself. -/
theorem continuationTolerance_eq_of_guard
    (guard : ∀ c x y, F.distance (M.act c x) (M.act c y) ≤ F.distance x y) :
    continuationTolerance M F = F.tolerance := by
  ext x y
  change 1 - continuationDistance M F x y = 1 - F.distance x y
  congr 1
  exact le_antisymm ((continuationDistance_le_iff M F).mpr fun c => guard c x y)
    (distance_le_continuation M F x y)

/-- **The zero kernel is the coarsest congruence inside the kernel of the
consumers**: two terms are identified exactly when no context lets a consumer
separate them. -/
theorem continuationTolerance_indistinguishable_iff {x y : V} :
    (continuationTolerance M F).Indistinguishable x y ↔
      ∀ c j, F.value j (M.act c x) = F.value j (M.act c y) := by
  unfold Tolerance.Indistinguishable
  rw [continuationTolerance_distance]
  constructor
  · intro zero c
    apply (F.distance_eq_zero_iff).mp
    exact le_antisymm (zero ▸ distance_act_le_continuation M F c x y) (F.distance_nonneg _ _)
  · intro same
    apply le_antisymm _ ((F.distance_nonneg x y).trans (distance_le_continuation M F x y))
    rw [continuationDistance_le_iff]
    intro c
    exact ((F.distance_eq_zero_iff).mpr (same c)).le

/-- Every context-closed relation inside the kernel of the consumers is inside
the zero kernel of the observational tolerance. -/
theorem le_continuationKernel {E : V → V → Prop}
    (closed : ∀ c {x y}, E x y → E (M.act c x) (M.act c y))
    (inside : ∀ {x y}, E x y → ∀ j, F.value j x = F.value j y) {x y : V} (related : E x y) :
    (continuationTolerance M F).Indistinguishable x y :=
  (continuationTolerance_indistinguishable_iff M F).mpr fun c => inside (closed c related)

end Observational

/-! ## The feasible interval and the two senses of "weakest" -/

section Feasible

variable [Fintype C] [Fintype V] [DecidableEq V] {J : Type w} [Fintype J] [Nonempty J]
  (M : ContextMonoid C V) (F : ConsumerFamily J V)

/-- The feasible graded congruences for a baseline seed and protected
consumers: graded congruences above the seed that protect the consumers. -/
def Feasible (baseline b : Tolerance V) : Prop :=
  b.GradedCongruence M ∧ baseline.Extends b ∧ b.Extends F.tolerance

/-- **The feasible set is an interval between the generated end and the
observational end.** Under the baseline guard `baseline ≤ 1 − d_F^M`, both ends
are feasible, every feasible point lies between them, and every graded
congruence between them is feasible. -/
theorem feasible_interval {baseline : Tolerance V}
    (guard : baseline.Extends (continuationTolerance M F)) :
    Feasible M F baseline (leastCongruence M baseline) ∧
      Feasible M F baseline (continuationTolerance M F) ∧
      ∀ b, Feasible M F baseline b ↔
        b.GradedCongruence M ∧ (leastCongruence M baseline).Extends b ∧
          b.Extends (continuationTolerance M F) := by
  have leastBelow : (leastCongruence M baseline).Extends (continuationTolerance M F) :=
    leastCongruence_extends (continuationTolerance_gradedCongruence M F) guard
  refine ⟨⟨leastCongruence_gradedCongruence baseline, extends_leastCongruence baseline,
      fun x y => (leastBelow x y).trans (continuationTolerance_extends_tolerance M F x y)⟩,
    ⟨continuationTolerance_gradedCongruence M F, guard,
      continuationTolerance_extends_tolerance M F⟩, fun b => ?_⟩
  constructor
  · rintro ⟨congruence, above, protects⟩
    exact ⟨congruence, leastCongruence_extends congruence above,
      extends_continuationTolerance M F congruence.2 protects⟩
  · rintro ⟨congruence, above, below⟩
    exact ⟨congruence, fun x y => (extends_leastCongruence baseline x y).trans (above x y),
      fun x y => (below x y).trans (continuationTolerance_extends_tolerance M F x y)⟩

/-- **The greatest feasible point.** -/
theorem continuationTolerance_greatest_feasible {baseline : Tolerance V}
    (guard : baseline.Extends (continuationTolerance M F)) {b : Tolerance V}
    (feasible : Feasible M F baseline b) : b.Extends (continuationTolerance M F) :=
  ((feasible_interval M F guard).2.2 b).mp feasible |>.2.2

/-- **The least feasible point.** -/
theorem leastCongruence_least_feasible {baseline : Tolerance V} {b : Tolerance V}
    (feasible : Feasible M F baseline b) : (leastCongruence M baseline).Extends b :=
  leastCongruence_extends feasible.1 feasible.2.1

omit [Fintype V] [DecidableEq V] in
/-- **Soundness of the generated end**: if every stipulated identification is
observationally valid, the generated congruence lies inside the observational
one. -/
theorem congGen_le_observational (R : V → V → Prop)
    (valid : ∀ {x y}, R x y → ∀ c j, F.value j (M.act c x) = F.value j (M.act c y))
    {x y : V} (generated : CongGen M R x y) :
    (continuationTolerance M F).Indistinguishable x y := by
  let kernel := (continuationTolerance M F).zeroSetoid (continuationTolerance_metric M F)
  exact congGen_le (E := kernel)
    (fun related => (continuationTolerance_indistinguishable_iff M F).mpr (valid related))
    (fun c _ _ same => (continuationTolerance_gradedCongruence M F).indistinguishable_act c same)
    generated

/-- Completeness of stipulations, the property that makes the two ends meet on
the zero kernel. -/
def CompleteStipulations (R : V → V → Prop) : Prop :=
  ∀ {x y}, (continuationTolerance M F).Indistinguishable x y → CongGen M R x y

end Feasible

end Mettapedia.Cybernetics.DistinctionCalculus
