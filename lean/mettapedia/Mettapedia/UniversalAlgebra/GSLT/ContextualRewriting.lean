import Mathlib.Logic.Relation
import Mettapedia.GSLT.Core.GSLT
import Mettapedia.UniversalAlgebra.EquationalLogic

/-!
# Oriented contextual rewriting generated by an equation system

An equation system does not determine a one-step dynamics until each equation
occurrence has been oriented.  `Orientation` records that extra operational
choice.  Its contextual rewrite relation generates exactly the same
convertibility relation as equational consequence, independently of the
chosen directions, while retaining direction at the one-step GSLT level.
-/

set_option autoImplicit false

namespace Mettapedia.UniversalAlgebra

open Mettapedia.Logic

universe u

variable {S : Signature.{u}}

/-- The direction assigned to one equation occurrence. -/
inductive Direction where
  | forward
  | reverse
deriving DecidableEq, Repr

/-- An operational orientation chooses a direction for every equation
occurrence, preserving duplicate occurrences as distinct choices. -/
structure Orientation (system : EquationSystem S) where
  direction : Fin system.equations.length → Direction

namespace Orientation

variable {system : EquationSystem S}

/-- The source selected for an oriented occurrence. -/
def source (orientation : Orientation system)
    (occurrence : Fin system.equations.length) : Term S :=
  match orientation.direction occurrence with
  | .forward => (system.equations.get occurrence).1
  | .reverse => (system.equations.get occurrence).2

/-- The target selected for an oriented occurrence. -/
def target (orientation : Orientation system)
    (occurrence : Fin system.equations.length) : Term S :=
  match orientation.direction occurrence with
  | .forward => (system.equations.get occurrence).2
  | .reverse => (system.equations.get occurrence).1

end Orientation

/-- One oriented rewrite at the root, closed under one-hole operation
contexts. -/
inductive ContextualStep {system : EquationSystem S}
    (orientation : Orientation system) : Term S → Term S → Prop where
  | root (occurrence : Fin system.equations.length)
      (substitution : Nat → Term S) :
      ContextualStep orientation
        ((orientation.source occurrence).subst substitution)
        ((orientation.target occurrence).subst substitution)
  | congrArg (operation : S.Operation)
      (arguments : Fin (S.arity operation) → Term S)
      (position : Fin (S.arity operation)) {left right : Term S} :
      ContextualStep orientation left right →
      ContextualStep orientation
        (.op operation (Function.update arguments position left))
        (.op operation (Function.update arguments position right))

/-- The actual GSLT generated after an orientation has been supplied.  Its
equational setoid is syntactic equality; the input equations generate
convertibility rather than being silently installed as structural equality. -/
def contextualRewritingGSLT {system : EquationSystem S}
    (orientation : Orientation system) : Mettapedia.GSLT.GSLT where
  Term := Term S
  equations := ⟨Eq, eq_equivalence⟩
  rewrites := ContextualStep orientation
  rewrites_resp_left equivalence step := by
    subst equivalence
    exact ⟨_, step, rfl⟩
  rewrites_resp_right step equivalence := by
    subst equivalence
    exact step

/-! ## Convertibility is an operation congruence -/

theorem eqvGen_congrArg {system : EquationSystem S}
    {orientation : Orientation system} (operation : S.Operation)
    (arguments : Fin (S.arity operation) → Term S)
    (position : Fin (S.arity operation)) {left right : Term S}
    (equivalent : Relation.EqvGen (ContextualStep orientation) left right) :
    Relation.EqvGen (ContextualStep orientation)
      (.op operation (Function.update arguments position left))
      (.op operation (Function.update arguments position right)) := by
  induction equivalent with
  | rel left right step =>
      exact Relation.EqvGen.rel _ _
        (ContextualStep.congrArg operation arguments position step)
  | refl term => exact Relation.EqvGen.refl _
  | symm left right _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans left middle right _ _ ih₁ ih₂ =>
      exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

private theorem eqvGen_operation_aux {system : EquationSystem S}
    {orientation : Orientation system} (operation : S.Operation) :
    ∀ (positions : List (Fin (S.arity operation)))
      (left right : Fin (S.arity operation) → Term S),
      (∀ position,
        Relation.EqvGen (ContextualStep orientation)
          (left position) (right position)) →
      (∀ position ∉ positions, left position = right position) →
      Relation.EqvGen (ContextualStep orientation)
        (.op operation left) (.op operation right) := by
  intro positions
  induction positions with
  | nil =>
      intro left right _ outside
      have functionsEqual : left = right := funext fun position =>
        outside position (by simp)
      rw [functionsEqual]
      exact Relation.EqvGen.refl _
  | cons position positions ih =>
      intro left right pointwise outside
      have updateSelf : Function.update left position (left position) = left := by
        funext other
        by_cases equal : other = position
        · subst equal
          rw [Function.update_self]
        · rw [Function.update_of_ne equal]
      have first : Relation.EqvGen (ContextualStep orientation)
          (.op operation left)
          (.op operation (Function.update left position (right position))) := by
        have contextual := eqvGen_congrArg operation left position (pointwise position)
        rwa [updateSelf] at contextual
      refine Relation.EqvGen.trans _ _ _ first
        (ih (Function.update left position (right position)) right ?_ ?_)
      · intro other
        by_cases equal : other = position
        · subst equal
          rw [Function.update_self]
          exact Relation.EqvGen.refl _
        · rw [Function.update_of_ne equal]
          exact pointwise other
      · intro other absent
        by_cases equal : other = position
        · subst equal
          rw [Function.update_self]
        · rw [Function.update_of_ne equal]
          exact outside other (by simp [absent, equal])

/-- Convertibility passes pointwise through every operation. -/
theorem eqvGen_operation {system : EquationSystem S}
    {orientation : Orientation system} (operation : S.Operation)
    (left right : Fin (S.arity operation) → Term S)
    (pointwise : ∀ position,
      Relation.EqvGen (ContextualStep orientation)
        (left position) (right position)) :
    Relation.EqvGen (ContextualStep orientation)
      (.op operation left) (.op operation right) :=
  eqvGen_operation_aux operation (List.finRange (S.arity operation))
    left right pointwise
    (fun position absent => absurd (List.mem_finRange position) absent)

/-! ## Exactness -/

private theorem consequence_system_occurrence {system : EquationSystem S}
    (occurrence : Fin system.equations.length)
    (substitution : Nat → Term S) :
    EquationalConsequence system
      ((system.equations.get occurrence).1.subst substitution,
       (system.equations.get occurrence).2.subst substitution) :=
  Derives.node [] _
    (EquationalRule.systemInstance
      (List.mem_iff_get.mpr ⟨occurrence, rfl⟩) substitution)
    (by intro premise member; cases member)

theorem consequence_to_convertibility {system : EquationSystem S}
    (orientation : Orientation system) {left right : Term S}
    (derivation : EquationalConsequence system (left, right)) :
    Relation.EqvGen (ContextualStep orientation) left right := by
  refine Derives.least
    (fun equation : Equation S =>
      Relation.EqvGen (ContextualStep orientation) equation.1 equation.2)
    ?_ derivation
  intro premises conclusion rule premisesValid
  cases rule with
  | systemInstance member substitution =>
      change _ ∈ system.equations at member
      obtain ⟨occurrence, occurrenceEquation⟩ := List.mem_iff_get.mp member
      cases directionEquation : orientation.direction occurrence with
      | forward =>
          have step := Relation.EqvGen.rel _ _
            (ContextualStep.root (orientation := orientation)
              occurrence substitution)
          rw [← occurrenceEquation]
          simpa [Orientation.source, Orientation.target, directionEquation]
            using step
      | reverse =>
          have step := Relation.EqvGen.rel _ _
            (ContextualStep.root (orientation := orientation)
              occurrence substitution)
          have reversed := Relation.EqvGen.symm _ _ step
          rw [← occurrenceEquation]
          simpa [Orientation.source, Orientation.target, directionEquation]
            using reversed
  | refl term => exact Relation.EqvGen.refl term
  | symm left right =>
      exact Relation.EqvGen.symm _ _ (premisesValid (left, right) (by simp))
  | trans left middle right =>
      exact Relation.EqvGen.trans _ _ _
        (premisesValid (left, middle) (by simp))
        (premisesValid (middle, right) (by simp))
  | congruence operation left right =>
      exact eqvGen_operation operation left right (fun position =>
        premisesValid (left position, right position) (by
          rw [List.mem_ofFn]
          exact ⟨position, rfl⟩))

theorem convertibility_to_consequence {system : EquationSystem S}
    (orientation : Orientation system) {left right : Term S}
    (conversion : Relation.EqvGen (ContextualStep orientation) left right) :
    EquationalConsequence system (left, right) := by
  induction conversion with
  | rel left right step =>
      induction step with
      | root occurrence substitution =>
          have forward := consequence_system_occurrence occurrence substitution
          cases directionEquation : orientation.direction occurrence with
          | forward =>
              simpa [Orientation.source, Orientation.target, directionEquation]
                using forward
          | reverse =>
              have reversed : EquationalConsequence system
                  ((system.equations.get occurrence).2.subst substitution,
                   (system.equations.get occurrence).1.subst substitution) :=
                Derives.node [_] _ (EquationalRule.symm _ _)
                  (by
                    intro premise member
                    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
                    subst premise
                    exact forward)
              simpa [Orientation.source, Orientation.target, directionEquation]
                using reversed
      | congrArg operation arguments position step ih =>
          refine Derives.node _ _
            (EquationalRule.congruence operation _ _) ?_
          intro premise member
          rw [List.mem_ofFn] at member
          obtain ⟨other, rfl⟩ := member
          by_cases equal : other = position
          · subst equal
            rw [Function.update_self, Function.update_self]
            exact ih
          · rw [Function.update_of_ne equal, Function.update_of_ne equal]
            exact Derives.node [] _ (EquationalRule.refl _)
              (by intro premise member; cases member)
  | refl term =>
      exact Derives.node [] _ (EquationalRule.refl term)
        (by intro premise member; cases member)
  | symm left right _ ih =>
      exact Derives.node [(left, right)] _ (EquationalRule.symm left right)
        (by
          intro premise member
          simp only [List.mem_cons, List.not_mem_nil, or_false] at member
          subst premise
          exact ih)
  | trans left middle right _ _ ih₁ ih₂ =>
      exact Derives.node [(left, middle), (middle, right)] _
        (EquationalRule.trans left middle right)
        (by
          intro premise member
          simp only [List.mem_cons, List.not_mem_nil, or_false] at member
          rcases member with rfl | rfl
          · exact ih₁
          · exact ih₂)

/-- Equational consequence is exactly the equivalence closure of contextual
rewriting, for every orientation.  This is an equality of undirected closure,
not a claim that different orientations have the same one-step behavior. -/
theorem consequence_iff_convertibility (system : EquationSystem S)
    (orientation : Orientation system) (left right : Term S) :
    EquationalConsequence system (left, right) ↔
      Relation.EqvGen (ContextualStep orientation) left right :=
  ⟨consequence_to_convertibility orientation,
   convertibility_to_consequence orientation⟩

end Mettapedia.UniversalAlgebra
