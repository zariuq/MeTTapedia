import Mettapedia.Logic.Derivation
import Mettapedia.UniversalAlgebra.EquationSystem

/-!
# Equational logic generated by an equation system

The rule predicate is kept separate from the input `EquationSystem`.  Its least
closure is `EquationalConsequence`.
-/

set_option autoImplicit false

namespace Mettapedia.UniversalAlgebra

open Mettapedia.Logic

universe u v

variable {S : Signature.{u}}

/-- Standard equational logic: substitution instances of system equations,
reflexivity, symmetry, transitivity, and operation congruence. -/
inductive EquationalRule (system : EquationSystem S) :
    List (Equation S) → Equation S → Prop where
  | systemInstance {equation : Equation S} (member : equation ∈ system)
      (substitution : Nat → Term S) :
      EquationalRule system []
        (equation.1.subst substitution, equation.2.subst substitution)
  | refl (term : Term S) : EquationalRule system [] (term, term)
  | symm (left right : Term S) :
      EquationalRule system [(left, right)] (right, left)
  | trans (left middle right : Term S) :
      EquationalRule system [(left, middle), (middle, right)] (left, right)
  | congruence (operation : S.Operation)
      (left right : Fin (S.arity operation) → Term S) :
      EquationalRule system
        (List.ofFn fun i => (left i, right i))
        (.op operation left, .op operation right)

/-- The deductive consequence relation generated by an equation system. -/
def EquationalConsequence (system : EquationSystem S)
    (equation : Equation S) : Prop :=
  Derives (EquationalRule system) equation

namespace EquationalConsequence

/-- Reflexivity as a generated consequence. -/
theorem refl (system : EquationSystem S) (term : Term S) :
    EquationalConsequence system (term, term) :=
  Derives.node [] _ (EquationalRule.refl term)
    (by intro premise member; cases member)

/-- Symmetry as a generated consequence. -/
theorem symm {system : EquationSystem S} {left right : Term S}
    (derivation : EquationalConsequence system (left, right)) :
    EquationalConsequence system (right, left) :=
  Derives.node [(left, right)] _ (EquationalRule.symm left right)
    (by
      intro premise member
      simp only [List.mem_singleton] at member
      subst premise
      exact derivation)

/-- Transitivity as a generated consequence. -/
theorem trans {system : EquationSystem S} {first second third : Term S}
    (firstSecond : EquationalConsequence system (first, second))
    (secondThird : EquationalConsequence system (second, third)) :
    EquationalConsequence system (first, third) :=
  Derives.node [(first, second), (second, third)] _
    (EquationalRule.trans first second third)
    (by
      intro premise member
      simp only [List.mem_cons, List.not_mem_nil, or_false] at member
      rcases member with rfl | rfl
      · exact firstSecond
      · exact secondThird)

/-- Operation congruence from pointwise generated consequences. -/
theorem operation {system : EquationSystem S} (symbol : S.Operation)
    (left right : Fin (S.arity symbol) → Term S)
    (components : ∀ position,
      EquationalConsequence system (left position, right position)) :
    EquationalConsequence system (.op symbol left, .op symbol right) :=
  Derives.node (List.ofFn fun position => (left position, right position)) _
    (EquationalRule.congruence symbol left right)
    (by
      intro premise member
      rw [List.mem_ofFn] at member
      obtain ⟨position, rfl⟩ := member
      exact components position)

end EquationalConsequence

/-- Generated equational consequence is sound in every satisfying model,
independently of the carrier universe. -/
theorem EquationalConsequence.holdsInModel
    {system : EquationSystem S} {equation : Equation S}
    (derivation : EquationalConsequence system equation)
    {Carrier : Type v} (model : Model S Carrier)
    (satisfies : model.Satisfies system) : equation.Holds model := by
  refine Derives.least (fun equation => equation.Holds model) ?_ derivation
  intro premises conclusion rule premiseHolds
  cases rule with
  | systemInstance member substitution =>
      intro valuation
      rw [Term.evaluate_subst, Term.evaluate_subst]
      exact satisfies _ member _
  | refl term =>
      intro valuation
      rfl
  | symm left right =>
      intro valuation
      exact (premiseHolds (left, right) (by simp) valuation).symm
  | trans left middle right =>
      intro valuation
      exact (premiseHolds (left, middle) (by simp) valuation).trans
        (premiseHolds (middle, right) (by simp) valuation)
  | congruence operation left right =>
      intro valuation
      simp only [Term.evaluate]
      refine congrArg (model.interpret operation) (funext fun position => ?_)
      exact premiseHolds (left position, right position) (by
        rw [List.mem_ofFn]
        exact ⟨position, rfl⟩) valuation

/-- Every equational rule preserves truth in all models of the system. -/
theorem equationalRule_sound (system : EquationSystem S) :
    ∀ premises conclusion, EquationalRule system premises conclusion →
      (∀ premise ∈ premises, Entails system premise) →
      Entails system conclusion := by
  intro premises conclusion rule ih
  cases rule with
  | systemInstance member substitution =>
    intro Carrier model satisfies valuation
    rw [Term.evaluate_subst, Term.evaluate_subst]
    exact satisfies _ member _
  | refl term =>
    intro Carrier model _ valuation
    rfl
  | symm left right =>
    intro Carrier model satisfies valuation
    exact (ih (left, right) (by simp) Carrier model satisfies valuation).symm
  | trans left middle right =>
    intro Carrier model satisfies valuation
    exact (ih (left, middle) (by simp) Carrier model satisfies valuation).trans
      (ih (middle, right) (by simp) Carrier model satisfies valuation)
  | congruence operation left right =>
    intro Carrier model satisfies valuation
    simp only [Term.evaluate]
    refine congrArg (model.interpret operation) (funext fun i => ?_)
    exact ih (left i, right i) (by
      rw [List.mem_ofFn]
      exact ⟨i, rfl⟩) Carrier model satisfies valuation

/-- Every generated equational consequence is valid in every model. -/
theorem equationalConsequence_sound {system : EquationSystem S}
    {equation : Equation S} (derivation : EquationalConsequence system equation) :
    Entails system equation :=
  Derives.least (Entails system) (equationalRule_sound system) derivation

/-- Inclusion of equation occurrences transports generated consequence. -/
theorem EquationalConsequence.mono {system system' : EquationSystem S}
    (inclusion : ∀ equation, equation ∈ system → equation ∈ system')
    {equation : Equation S} :
    EquationalConsequence system equation →
      EquationalConsequence system' equation := by
  apply Derives.mono
  intro premises conclusion rule
  cases rule with
  | systemInstance member substitution =>
      exact EquationalRule.systemInstance (inclusion _ member) substitution
  | refl term => exact EquationalRule.refl term
  | symm left right => exact EquationalRule.symm left right
  | trans left middle right => exact EquationalRule.trans left middle right
  | congruence operation left right =>
      exact EquationalRule.congruence operation left right

end Mettapedia.UniversalAlgebra
