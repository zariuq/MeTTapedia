import Mettapedia.UniversalAlgebra.ConservativeExtension
import Mettapedia.UniversalAlgebra.ModelHom

/-!
# The free model generated by an equation system

Terms are quotiented by generated equational consequence.  The resulting
model satisfies the equation system, is free on its canonical countable
variable valuation, and yields equational completeness against the
same-universe model semantics `Entails`.
-/

set_option autoImplicit false

namespace Mettapedia.UniversalAlgebra

universe u v

variable {S : Signature.{u}}

namespace Term

/-- Generated equational consequence as a setoid on terms. -/
def consequenceSetoid (system : EquationSystem S) : Setoid (Term S) where
  r left right := EquationalConsequence system (left, right)
  iseqv := ⟨
    EquationalConsequence.refl system,
    fun {_left _right} => EquationalConsequence.symm,
    fun {_first _second _third} => EquationalConsequence.trans⟩

end Term

/-- Terms modulo the generated equational consequence of `system`. -/
abbrev TermQuotient (system : EquationSystem S) :=
  Quotient (Term.consequenceSetoid system)

namespace TermQuotient

variable (system : EquationSystem S)

/-- The consequence class of a term. -/
def classOf (term : Term S) : TermQuotient system :=
  Quotient.mk (Term.consequenceSetoid system) term

/-- Equality of term classes is exactly generated equational consequence. -/
theorem classOf_eq_iff (left right : Term S) :
    classOf system left = classOf system right ↔
      EquationalConsequence system (left, right) := by
  change
    Quotient.mk (Term.consequenceSetoid system) left =
        Quotient.mk (Term.consequenceSetoid system) right ↔ _
  exact Quotient.eq_iff_equiv

/-- Every quotient is represented by the class of its selected representative. -/
theorem classOf_out (value : TermQuotient system) :
    classOf system (Quotient.out value) = value := by
  change Quotient.mk (Term.consequenceSetoid system) (Quotient.out value) =
    value
  exact Quotient.out_eq value

/-- The quotient term model.  Selecting representatives for a finite argument
tuple is harmless because operation congruence identifies every alternative. -/
noncomputable def model : Model S (TermQuotient system) where
  interpret operation arguments :=
    classOf system (.op operation (fun position =>
      Quotient.out (arguments position)))

/-- Applying a quotient-model operation to displayed term classes gives the
class of the corresponding operation term. -/
theorem model_interpret_classOf (operation : S.Operation)
    (arguments : Fin (S.arity operation) → Term S) :
    (model system).interpret operation (fun position =>
        classOf system (arguments position)) =
      classOf system (.op operation arguments) := by
  change classOf system
      (.op operation (fun position =>
        Quotient.out (classOf system (arguments position)))) =
    classOf system (.op operation arguments)
  apply (classOf_eq_iff system _ _).mpr
  apply EquationalConsequence.operation
  intro position
  apply (classOf_eq_iff system _ _).mp
  exact classOf_out system (classOf system (arguments position))

/-- Evaluation in the quotient model is substitution by selected
representatives followed by passage to the consequence class. -/
theorem evaluate_eq_classOf_subst (valuation : Nat → TermQuotient system) :
    ∀ term : Term S,
      term.evaluate (model system) valuation =
        classOf system (term.subst (fun index => Quotient.out (valuation index)))
  | .var index => (classOf_out system (valuation index)).symm
  | .op operation arguments => by
      simp only [Term.evaluate, Term.subst_op]
      calc
        (model system).interpret operation (fun position =>
            (arguments position).evaluate (model system) valuation) =
          (model system).interpret operation (fun position =>
            classOf system ((arguments position).subst
              (fun index => Quotient.out (valuation index)))) := by
                congr 1
                funext position
                exact evaluate_eq_classOf_subst valuation (arguments position)
        _ = classOf system (.op operation (fun position =>
              (arguments position).subst
                (fun index => Quotient.out (valuation index)))) :=
            model_interpret_classOf system operation _

/-- Under the canonical variable valuation, a term evaluates to its own
consequence class. -/
theorem evaluate_canonical : ∀ term : Term S,
    term.evaluate (model system) (fun index => classOf system (.var index)) =
      classOf system term
  | .var _index => rfl
  | .op operation arguments => by
      simp only [Term.evaluate]
      calc
        (model system).interpret operation (fun position =>
            (arguments position).evaluate (model system)
              (fun index => classOf system (.var index))) =
          (model system).interpret operation
            (fun position => classOf system (arguments position)) := by
              congr 1
              funext position
              exact evaluate_canonical (arguments position)
        _ = classOf system (.op operation arguments) :=
          model_interpret_classOf system operation arguments

/-- The quotient term model satisfies every equation occurrence in the
system under every quotient-valued valuation. -/
theorem model_satisfies : (model system).Satisfies system := by
  intro equation member valuation
  rw [evaluate_eq_classOf_subst, evaluate_eq_classOf_subst]
  apply (classOf_eq_iff system _ _).mpr
  exact EquationalConsequence.subst
    (EquationalConsequence.of_mem member)
    (fun index => Quotient.out (valuation index))

end TermQuotient

/-! ## Equational completeness -/

/-- Generated consequence and validity in every same-universe model coincide.
The forward direction is soundness; the reverse direction uses the quotient
term model. -/
theorem equationalConsequence_iff_entails
    (system : EquationSystem S) (equation : Equation S) :
    EquationalConsequence system equation ↔ Entails system equation := by
  constructor
  · exact equationalConsequence_sound
  · intro entailed
    have equality := entailed (TermQuotient system) (TermQuotient.model system)
      (TermQuotient.model_satisfies system)
      (fun index => TermQuotient.classOf system (.var index))
    rw [TermQuotient.evaluate_canonical,
      TermQuotient.evaluate_canonical] at equality
    exact (TermQuotient.classOf_eq_iff system _ _).mp equality

/-! ## Universal mapping property -/

namespace TermQuotient

variable (system : EquationSystem S)

/-- The canonical homomorphism from the quotient term model to any satisfying
model, induced by a valuation of the free variables. -/
noncomputable def lift {Carrier : Type v} (target : Model S Carrier)
    (satisfies : target.Satisfies system) (valuation : Nat → Carrier) :
    Model.Hom (model system) target where
  toFun := Quotient.lift
    (fun term => term.evaluate target valuation)
    (by
      intro left right consequence
      exact EquationalConsequence.holdsInModel consequence target satisfies
        valuation)
  map_operation operation arguments := by
    rw [show (model system).interpret operation arguments =
        classOf system (.op operation (fun position =>
          Quotient.out (arguments position))) from rfl]
    change
      (Term.op operation (fun position =>
        Quotient.out (arguments position))).evaluate
          target valuation =
        target.interpret operation (fun position =>
          (Quotient.lift (fun term => term.evaluate target valuation) _)
            (arguments position))
    simp only [Term.evaluate]
    congr 1
    funext position
    calc
      (Quotient.out (arguments position)).evaluate target valuation =
          (Quotient.lift (fun term => term.evaluate target valuation) _)
            (classOf system (Quotient.out (arguments position))) := rfl
      _ = (Quotient.lift (fun term => term.evaluate target valuation) _)
            (arguments position) :=
        congrArg _ (classOf_out system (arguments position))

@[simp] theorem lift_classOf {Carrier : Type v} (target : Model S Carrier)
    (satisfies : target.Satisfies system) (valuation : Nat → Carrier)
    (term : Term S) :
    lift system target satisfies valuation (classOf system term) =
      term.evaluate target valuation := by
  rfl

@[simp] theorem lift_variable {Carrier : Type v} (target : Model S Carrier)
    (satisfies : target.Satisfies system) (valuation : Nat → Carrier)
    (index : Nat) :
    lift system target satisfies valuation (classOf system (.var index)) =
      valuation index := by
  rfl

/-- Any quotient-model homomorphism is determined by its values on the
canonical variables. -/
theorem hom_classOf_eq_evaluate {Carrier : Type v} (target : Model S Carrier)
    (valuation : Nat → Carrier) (homomorphism : Model.Hom (model system) target)
    (extendsVariables : ∀ index,
      homomorphism (classOf system (.var index)) = valuation index) :
    ∀ term : Term S,
      homomorphism (classOf system term) = term.evaluate target valuation
  | .var index => extendsVariables index
  | .op operation arguments => by
      rw [← model_interpret_classOf system operation arguments,
        homomorphism.map_operation]
      simp only [Term.evaluate]
      congr 1
      funext position
      exact hom_classOf_eq_evaluate target valuation homomorphism
        extendsVariables (arguments position)

/-- The canonical lift is the unique model homomorphism extending a selected
valuation of the countable free variables. -/
theorem existsUnique_lift {Carrier : Type v} (target : Model S Carrier)
    (satisfies : target.Satisfies system) (valuation : Nat → Carrier) :
    ∃! homomorphism : Model.Hom (model system) target,
      ∀ index, homomorphism (classOf system (.var index)) = valuation index := by
  refine ⟨lift system target satisfies valuation, lift_variable system target
    satisfies valuation, ?_⟩
  intro homomorphism extendsVariables
  apply Model.Hom.ext
  funext value
  induction value using Quotient.inductionOn with
  | _ term =>
      change homomorphism (classOf system term) =
        lift system target satisfies valuation (classOf system term)
      exact (hom_classOf_eq_evaluate system target valuation homomorphism
        extendsVariables term).trans
          (lift_classOf system target satisfies valuation term).symm

end TermQuotient

end Mettapedia.UniversalAlgebra
