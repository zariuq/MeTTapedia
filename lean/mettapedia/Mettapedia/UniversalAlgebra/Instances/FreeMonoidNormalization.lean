import Mathlib.Tactic
import Mettapedia.Logic.CertificateConservativeExtension
import Mettapedia.UniversalAlgebra.CertificateSubstitution
import Mettapedia.UniversalAlgebra.Instances.Monoid

/-!
# Canonical words for the free monoid equation system

Terms in the monoid signature have a canonical word obtained by deleting
units and flattening multiplication.  This file proves that word equality is
exactly the equational consequence generated by associativity and the two
unit laws.  The result supplies a decidable normalizer independently of the
generic equational replay checker.

Simultaneous substitution acts on words by `List.flatMap`.  Conversion is
therefore preserved by substitution, while the converse deliberately fails:
a substitution may identify two previously distinct variables.
-/

set_option autoImplicit false

namespace Mettapedia.UniversalAlgebra.Monoid.FreeNormalization

open Mettapedia.Logic
open Mettapedia.UniversalAlgebra

/-! ## Canonical words -/

private def mulLeft : Fin (signature.arity Operation.mul) :=
  ⟨0, by decide⟩

private def mulRight : Fin (signature.arity Operation.mul) :=
  ⟨1, by decide⟩

/-- Interpret a monoid term as a word in its variable occurrences. -/
def flatten : Term signature → List Nat
  | .var index => [index]
  | .op .one _arguments => []
  | .op .mul arguments =>
      flatten (arguments mulLeft) ++ flatten (arguments mulRight)

/-- Reify a word as a right-associated monoid term. -/
def reify : List Nat → Term signature
  | [] => one
  | index :: rest => mul (.var index) (reify rest)

@[simp] theorem flatten_var (index : Nat) :
    flatten (.var index : Term signature) = [index] := rfl

@[simp] theorem flatten_one : flatten one = [] := by
  simp [one, flatten]

@[simp] theorem flatten_mul (left right : Term signature) :
    flatten (mul left right) = flatten left ++ flatten right := by
  simp [mul, flatten, mulLeft, mulRight]

@[simp] theorem flatten_reify : ∀ word : List Nat,
    flatten (reify word) = word
  | [] => by simp [reify]
  | index :: rest => by simp [reify, flatten_reify rest]

/-- Word normalization commutes with simultaneous substitution. -/
theorem flatten_subst (substitution : Nat → Term signature) :
    ∀ term : Term signature,
      flatten (term.subst substitution) =
        (flatten term).flatMap (fun index => flatten (substitution index))
  | .var _ => by simp [flatten]
  | .op .one _arguments => rfl
  | .op .mul arguments => by
      simp only [Term.subst_op, flatten, List.flatMap_append]
      rw [flatten_subst substitution (arguments mulLeft),
        flatten_subst substitution (arguments mulRight)]

/-! ## Reusable monoid consequences -/

/-- An equation-system occurrence instantiated at a simultaneous
substitution is an equational consequence. -/
private theorem systemInstance
    {equation : Equation signature}
    (member : equation ∈ equationSystem)
    (substitution : Nat → Term signature) :
    EquationalConsequence equationSystem
      (equation.1.subst substitution, equation.2.subst substitution) :=
  Derives.node [] _
    (EquationalRule.systemInstance member substitution)
    (by intro premise premiseMember; cases premiseMember)

theorem leftUnit (term : Term signature) :
    EquationalConsequence equationSystem (mul one term, term) := by
  have instantiated := systemInstance
    (equation := (mul one x, x))
    (by
      change (mul one x, x) ∈ equationSystem.equations
      simp [equationSystem])
    (fun index => if index = 0 then term else .var index)
  simpa [subst_mul, subst_one, x] using instantiated

theorem rightUnit (term : Term signature) :
    EquationalConsequence equationSystem (mul term one, term) := by
  have instantiated := systemInstance
    (equation := (mul x one, x))
    (by
      change (mul x one, x) ∈ equationSystem.equations
      simp [equationSystem])
    (fun index => if index = 0 then term else .var index)
  simpa [subst_mul, subst_one, x] using instantiated

theorem associativity (first second third : Term signature) :
    EquationalConsequence equationSystem
      (mul (mul first second) third, mul first (mul second third)) := by
  have instantiated := systemInstance
    (equation := (mul (mul x y) z, mul x (mul y z)))
    (by
      change (mul (mul x y) z, mul x (mul y z)) ∈ equationSystem.equations
      simp [equationSystem])
    (fun index =>
      if index = 0 then first else if index = 1 then second else third)
  simpa [subst_mul, x, y, z] using instantiated

/-- Multiplication is congruent in both arguments. -/
theorem mulCongr {left left' right right' : Term signature}
    (leftConversion :
      EquationalConsequence equationSystem (left, left'))
    (rightConversion :
      EquationalConsequence equationSystem (right, right')) :
    EquationalConsequence equationSystem
      (mul left right, mul left' right') := by
  have congruence := EquationalConsequence.operation
    (system := equationSystem) Operation.mul
    (fun position => if position.val = 0 then left else right)
    (fun position => if position.val = 0 then left' else right')
    (fun position => by
      by_cases firstPosition : position.val = 0
      · simpa [firstPosition] using leftConversion
      · simpa [firstPosition] using rightConversion)
  simpa [mul] using congruence

/-- Multiplying two reified words is convertible to their concatenation. -/
theorem mulReify : ∀ first second : List Nat,
    EquationalConsequence equationSystem
      (mul (reify first) (reify second), reify (first ++ second))
  | [], second => by
      simpa [reify] using leftUnit (reify second)
  | index :: rest, second => by
      have reassociate :=
        associativity (.var index) (reify rest) (reify second)
      have recurse := mulCongr
        (EquationalConsequence.refl equationSystem (.var index))
        (mulReify rest second)
      exact EquationalConsequence.trans reassociate (by
        simpa [reify] using recurse)

/-! ## Exactness of normalization -/

/-- A raw multiplication node is the named binary constructor. -/
private theorem opMul_eq_mul
    (arguments : Fin 2 → Term signature) :
    Term.op Operation.mul arguments =
      mul (arguments mulLeft) (arguments mulRight) := by
  unfold mul
  congr 1
  funext position
  fin_cases position <;> rfl

/-- A nullary unit node is the named unit constructor. -/
private theorem opOne_eq_one
    (arguments : Fin 0 → Term signature) :
    Term.op Operation.one arguments = one := by
  unfold one
  congr 1
  funext position
  exact Fin.elim0 position

/-- Every monoid term converts to the reification of its canonical word. -/
theorem normalizes : ∀ term : Term signature,
    EquationalConsequence equationSystem (term, reify (flatten term))
  | .var index => by
      simpa [flatten, reify] using
        (EquationalConsequence.symm (rightUnit (.var index)))
  | .op .one arguments => by
      rw [opOne_eq_one arguments]
      exact EquationalConsequence.refl equationSystem one
  | .op .mul arguments => by
      rw [opMul_eq_mul arguments]
      have components := mulCongr
        (normalizes (arguments mulLeft))
        (normalizes (arguments mulRight))
      exact EquationalConsequence.trans components (by
        simpa only [flatten_mul] using
          mulReify
            (flatten (arguments mulLeft))
            (flatten (arguments mulRight)))

/-- The list model is the independent semantic model of canonical words. -/
def listModel : Model signature (List Nat) where
  interpret
    | .mul => fun arguments =>
        arguments mulLeft ++ arguments mulRight
    | .one => fun _arguments => []

@[simp] theorem evaluate_listModel_mul (valuation : Nat → List Nat)
    (left right : Term signature) :
    (mul left right).evaluate listModel valuation =
      left.evaluate listModel valuation ++ right.evaluate listModel valuation := by
  simp [Term.evaluate, listModel, mul, mulLeft, mulRight]

@[simp] theorem evaluate_listModel_one (valuation : Nat → List Nat) :
    one.evaluate listModel valuation = [] := by
  simp [Term.evaluate, listModel, one]

/-- The list model satisfies associativity and both unit equations. -/
theorem listModel_satisfies : listModel.Satisfies equationSystem := by
  intro equation member
  change equation ∈ equationSystem.equations at member
  simp only [equationSystem, List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl | rfl
  · intro valuation
    simp only [evaluate_listModel_mul]
    exact List.append_assoc _ _ _
  · intro valuation
    simp only [evaluate_listModel_mul, evaluate_listModel_one, List.nil_append]
  · intro valuation
    simp only [evaluate_listModel_mul, evaluate_listModel_one, List.append_nil]

/-- Evaluation in the list model is exactly word normalization. -/
theorem evaluate_listModel : ∀ term : Term signature,
    term.evaluate listModel (fun index => [index]) =
      flatten term
  | .var _ => rfl
  | .op .one _arguments => rfl
  | .op .mul arguments => by
      change
        (arguments mulLeft).evaluate listModel (fun index => [index]) ++
            (arguments mulRight).evaluate listModel (fun index => [index]) =
          flatten (arguments mulLeft) ++ flatten (arguments mulRight)
      rw [evaluate_listModel (arguments mulLeft),
        evaluate_listModel (arguments mulRight)]

/-- Equational consequence preserves canonical words. -/
theorem flatten_eq_of_consequence {left right : Term signature}
    (derivation : EquationalConsequence equationSystem (left, right)) :
    flatten left = flatten right := by
  have sound := EquationalConsequence.holdsInModel derivation listModel
    listModel_satisfies (fun index => [index])
  rw [evaluate_listModel left, evaluate_listModel right] at sound
  exact sound

/-- Canonical word equality is complete for the monoid equation system. -/
theorem consequence_of_flatten_eq {left right : Term signature}
    (wordsEqual : flatten left = flatten right) :
    EquationalConsequence equationSystem (left, right) := by
  have middle : EquationalConsequence equationSystem
      (reify (flatten left), reify (flatten right)) := by
    rw [wordsEqual]
    exact EquationalConsequence.refl equationSystem _
  exact EquationalConsequence.trans (normalizes left)
    (EquationalConsequence.trans middle
      (EquationalConsequence.symm (normalizes right)))

/-- The normalization theorem in exact iff form. -/
theorem consequence_iff_flatten_eq {left right : Term signature} :
    EquationalConsequence equationSystem (left, right) ↔
      flatten left = flatten right :=
  ⟨flatten_eq_of_consequence, consequence_of_flatten_eq⟩

/-- Decidable equality of canonical words decides monoid consequence. -/
def decideConversion (left right : Term signature) : Bool :=
  decide (flatten left = flatten right)

theorem decideConversion_eq_true_iff {left right : Term signature} :
    decideConversion left right = true ↔
      EquationalConsequence equationSystem (left, right) := by
  simp [decideConversion, consequence_iff_flatten_eq]

/-! ## Explicit replay certificates -/

abbrev monoidInterface := equationalRuleInterface equationSystem

/-- A concrete one-node certificate for the right-unit normalization canary. -/
def rightUnitXCertificate : AcceptedCertificate monoidInterface
    (mul x one, x) := by
  exact AcceptedCertificate.node monoidInterface
    (.systemInstance
      (⟨2, by simp [equationSystem]⟩ : Fin equationSystem.equations.length)
      Term.var)
    (mul x one, x) Fin.elim0 (by
      simp [monoidInterface, equationalRuleInterface,
        EquationalRuleWitness.isInstance, equationSystem,
        Term.subst_variables])
    (fun position => Fin.elim0 position)

@[simp] theorem rightUnitXCertificate_nodeCount :
    rightUnitXCertificate.nodeCount = 1 := rfl

/-- Every equational consequence has a replayable certificate.  The result is
propositional because the generic completeness theorem intentionally does not
select one certificate among many. -/
theorem nonemptyAcceptedOfConsequence {equation : Equation signature}
    (derivation : EquationalConsequence equationSystem equation) :
    Nonempty
      (AcceptedCertificate (equationalRuleInterface equationSystem) equation) := by
  obtain ⟨certificate, accepted, concludes⟩ :=
    Derives.exists_derivation (equationalRuleInterface equationSystem)
      derivation
  exact ⟨
    { certificate := certificate
      accepted := accepted
      concludes := concludes }⟩

/-- Every accepted certificate denotes an equational consequence. -/
theorem consequenceOfAccepted {equation : Equation signature}
    (certificate :
      AcceptedCertificate (equationalRuleInterface equationSystem) equation) :
    EquationalConsequence equationSystem equation := by
  have derivation := Derivation.valid_sound
    (equationalRuleInterface equationSystem) certificate.certificate
    certificate.accepted
  exact certificate.concludes ▸ derivation

/-- Accepted replay certificates exist exactly for convertible monoid terms. -/
theorem nonemptyAccepted_iff {left right : Term signature} :
    Nonempty (AcceptedCertificate
      (equationalRuleInterface equationSystem) (left, right)) ↔
      EquationalConsequence equationSystem (left, right) := by
  constructor
  · rintro ⟨certificate⟩
    exact consequenceOfAccepted certificate
  · intro derivation
    exact nonemptyAcceptedOfConsequence derivation

/-! ## Substitution preserves but need not reflect conversion -/

theorem flatten_eq_subst_of_flatten_eq
    (substitution : Nat → Term signature) {left right : Term signature}
    (wordsEqual : flatten left = flatten right) :
    flatten (left.subst substitution) = flatten (right.subst substitution) := by
  rw [flatten_subst, flatten_subst, wordsEqual]

theorem consequence_subst {left right : Term signature}
    (derivation : EquationalConsequence equationSystem (left, right))
    (substitution : Nat → Term signature) :
    EquationalConsequence equationSystem
      (left.subst substitution, right.subst substitution) :=
  consequence_of_flatten_eq
    (flatten_eq_subst_of_flatten_eq substitution
      (flatten_eq_of_consequence derivation))

/-- Positive substitution control. -/
theorem rightUnit_substitution_control (substitution : Nat → Term signature) :
    decideConversion
      ((mul x one).subst substitution) (x.subst substitution) = true :=
  decideConversion_eq_true_iff.mpr
    (consequence_subst (rightUnit x) substitution)

/-- A substitution can identify previously distinct variables, so conversion
reflection under arbitrary substitution is false. -/
theorem substitution_not_reflecting :
    ∃ substitution : Nat → Term signature,
      decideConversion
          ((Term.var 0).subst substitution)
          ((Term.var 1).subst substitution) = true ∧
        decideConversion (Term.var 0) (Term.var 1) = false := by
  refine ⟨fun _index => one, ?_, ?_⟩
  · simp [decideConversion]
  · simp [decideConversion]

/-! ## Axiom audit -/

#print axioms consequence_iff_flatten_eq
#print axioms decideConversion_eq_true_iff
#print axioms nonemptyAccepted_iff
#print axioms rightUnitXCertificate_nodeCount
#print axioms flatten_subst
#print axioms substitution_not_reflecting

end Mettapedia.UniversalAlgebra.Monoid.FreeNormalization
