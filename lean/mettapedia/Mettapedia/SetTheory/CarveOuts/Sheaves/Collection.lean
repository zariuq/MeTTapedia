import Mettapedia.SetTheory.CarveOuts.Sheaves.SmallMaps

/-!
# Collection for sheaves over a space, from collection in the base

**The base.** Collection (axiom (A7) of van den Berg and Moerdijk, *Aspects of predicative
algebraic set theory III: sheaves*, Definition 2.2) for Lean's types with the maps whose fibres
are `w`-small is `BaseCollection`: a surjection `p : Y → X` and a small map `f : X → A` fit into a
covering square whose left side is small. It is a named hypothesis here. The only proof given,
`baseCollection_of_choice`, takes a section of the surjection with `Function.surjInv`, so it uses
`Classical.choice`.

**Sheaves.** For sheaves on a space whose open sets form a `w`-small type, with the pointwise
small maps of `Sheaves.SmallMaps` and epimorphisms the locally surjective maps, collection holds
whenever it holds in the base (`sheafSmall_collection`). Given an epimorphism `p : Y ⟶ X` and a
small map `f : X ⟶ A`:

1. The base is applied once: to the local lifts along `p` (`LiftTarget`: a section `a` of `A` on
   `U`, a section `x` of `X` on `W ≤ U` over the restriction of `a`, and an open `V ≤ W` on which
   `x` lifts along `p`), indexed by the sections `(U, a)` of `A` (`liftTarget_fibre_small`). This
   gives a set `B₀` covering the sections of `A`, and over each `b ∈ B₀` a small set of lifts that
   covers every local section of `X` over `b`.
2. `B` is the sheaf generated by `B₀`: the sheafification of the presheaf whose sections on `W`
   are the `b ∈ B₀` living on an open set containing `W` (`baseValues`); its map to `A` is
   pointwise surjective, hence epi.
3. `Z` is the subsheaf of `Y × B` locally generated by the chosen lifts (`liftsSubfunctor`); its
   projections are the maps to `Y` and to `B`.
4. The comparison map from `Z` to the pullback is locally surjective, by local surjectivity of
   `p` and of the unit of `B`.
5. The map `Z ⟶ B` has small fibres: on a nonempty open set a section of `B` comes from at most
   one `b ∈ B₀` (the unit of `B` is locally injective, and a nonempty open set has a point),
   and a section of a fibre is determined by the set of chosen lifts it agrees with locally.

Choice enters through the base collection hypothesis, which only `baseCollection_of_choice`
discharges, and through Mathlib's API for open sets, sheafification, limits and `Small`. No other
declaration here calls a choice principle.
-/

set_option autoImplicit false

namespace Mettapedia.SetTheory.CarveOuts.Sheaves

open CategoryTheory Limits TopologicalSpace Opposite
open Mettapedia.SetTheory.CarveOuts.Sites
open Mettapedia.SetTheory.CarveOuts.Sites.SmallMaps

universe w u

/-! ## Collection in the base -/

/-- **Collection in the base** (A7) for Lean's types `Type u` with the maps whose fibres are
`w`-small: a surjection `p` and a small map `f` fit into a covering square
`Z → Y → X`, `Z → B → A`, with `B → A` surjective, `Z → B` small, and `Z` covering the pullback
of `B` and `X` over `A`. -/
def BaseCollection : Prop :=
  ∀ {Y Xb A : Type u} (p : Y → Xb) (f : Xb → A), Function.Surjective p →
    (∀ a, Small.{w} {x // f x = a}) →
    ∃ (Z B : Type u) (z : Z → Y) (g : Z → B) (h : B → A),
      Function.Surjective h ∧ (∀ b, Small.{w} {ζ // g ζ = b}) ∧
        (∀ ζ, f (p (z ζ)) = h (g ζ)) ∧ ∀ b x, h b = f x → ∃ ζ, g ζ = b ∧ p (z ζ) = x

/-- **Collection in the base from host choice**: a section of the surjection. -/
theorem baseCollection_of_choice : BaseCollection.{w, u} := by
  intro Y Xb A p f hp hf
  refine ⟨Xb, A, Function.surjInv hp, f, id, Function.surjective_id, hf, fun x => ?_,
    fun b x hb => ⟨x, hb.symm, Function.surjInv_eq hp x⟩⟩
  rw [Function.surjInv_eq hp]
  rfl

/-! ## Restriction -/

section Restriction

variable {X : Type u} [TopologicalSpace X]

/-- Restriction of sections along an inclusion of open sets. -/
abbrev res (P : (Opens X)ᵒᵖ ⥤ Type u) {U V : Opens X} (h : V ≤ U) (s : P.obj (op U)) :
    P.obj (op V) :=
  P.map (homOfLE h).op s

theorem res_res (P : (Opens X)ᵒᵖ ⥤ Type u) {U V W : Opens X} (h : V ≤ U) (h' : W ≤ V)
    (s : P.obj (op U)) : res P h' (res P h s) = res P (le_trans h' h) s :=
  (P.map_comp_apply (homOfLE h).op (homOfLE h').op s).symm

theorem res_self (P : (Opens X)ᵒᵖ ⥤ Type u) {U : Opens X} (h : U ≤ U) (s : P.obj (op U)) :
    res P h s = s :=
  P.map_id_apply (op U) s

theorem res_nat {P Q : (Opens X)ᵒᵖ ⥤ Type u} (θ : P ⟶ Q) {U V : Opens X} (h : V ≤ U)
    (s : P.obj (op U)) : θ.app (op V) (res P h s) = res Q h (θ.app (op U) s) :=
  NatTrans.naturality_apply θ (homOfLE h).op s

/-- Restricting a section given with its open set depends only on the pair. -/
theorem res_sigma_congr (P : (Opens X)ᵒᵖ ⥤ Type u) {s s' : Σ U : Opens X, P.obj (op U)}
    (e : s = s') {V : Opens X} (h : V ≤ s.1) (h' : V ≤ s'.1) : res P h s.2 = res P h' s'.2 := by
  subst e
  rfl

end Restriction

/-! ## The pair of two presheaves -/

section Pair

variable {X : Type u} [TopologicalSpace X]

/-- The pointwise product of two presheaves. -/
def pairPresheaf (P Q : (Opens X)ᵒᵖ ⥤ Type u) : (Opens X)ᵒᵖ ⥤ Type u where
  obj U := P.obj U × Q.obj U
  map f := TypeCat.ofHom (Prod.map (P.map f) (Q.map f))
  map_id U := by
    ext s
    · exact P.map_id_apply U s.1
    · exact Q.map_id_apply U s.2
  map_comp f g := by
    ext s
    · exact P.map_comp_apply f g s.1
    · exact Q.map_comp_apply f g s.2

theorem pairPresheaf_isSheaf {P Q : (Opens X)ᵒᵖ ⥤ Type u}
    (hP : Presieve.IsSheaf (Opens.grothendieckTopology X) P)
    (hQ : Presieve.IsSheaf (Opens.grothendieckTopology X) Q) :
    Presieve.IsSheaf (Opens.grothendieckTopology X) (pairPresheaf P Q) := by
  intro U S hS x hx
  let x₁ : Presieve.FamilyOfElements P S.arrows := fun _ f hf => (x f hf).1
  let x₂ : Presieve.FamilyOfElements Q S.arrows := fun _ f hf => (x f hf).2
  have hx₁ : x₁.Compatible := by
    intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ e
    exact congrArg Prod.fst (hx g₁ g₂ h₁ h₂ e)
  have hx₂ : x₂.Compatible := by
    intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ e
    exact congrArg Prod.snd (hx g₁ g₂ h₁ h₂ e)
  obtain ⟨t₁, ht₁, hu₁⟩ := hP S hS x₁ hx₁
  obtain ⟨t₂, ht₂, hu₂⟩ := hQ S hS x₂ hx₂
  refine ⟨(t₁, t₂), fun V f hf => Prod.ext (ht₁ f hf) (ht₂ f hf), fun t ht => Prod.ext ?_ ?_⟩
  · exact hu₁ t.1 fun V f hf => congrArg Prod.fst (ht f hf)
  · exact hu₂ t.2 fun V f hf => congrArg Prod.snd (ht f hf)

/-- The first projection. -/
def pairFst (P Q : (Opens X)ᵒᵖ ⥤ Type u) : pairPresheaf P Q ⟶ P where
  app _ := TypeCat.ofHom Prod.fst

/-- The second projection. -/
def pairSnd (P Q : (Opens X)ᵒᵖ ⥤ Type u) : pairPresheaf P Q ⟶ Q where
  app _ := TypeCat.ofHom Prod.snd

end Pair

/-! ## The lifts along an epimorphism -/

section Lifts

variable {X : Type u} [TopologicalSpace X]
variable {Y Xs A : SheafOn X} (p : Y ⟶ Xs) (f : Xs ⟶ A)

/-- The sections of `A`, each with its open set. -/
abbrev Sections (A : SheafOn X) : Type u :=
  Σ U : Opens X, A.obj.obj (op U)

/-- **A local lift to be collected**: a section `a` of `A` on `U`, a section `x` of `X` on
`W ≤ U` over the restriction of `a`, and an open `V ≤ W` on which `x` lifts along `p`. -/
structure LiftTarget where
  U : Opens X
  a : A.obj.obj (op U)
  W : Opens X
  hWU : W ≤ U
  x : Xs.obj.obj (op W)
  hx : f.hom.app (op W) x = res A.obj hWU a
  V : Opens X
  hVW : V ≤ W
  lifts : ∃ y : Y.obj.obj (op V), p.hom.app (op V) y = res Xs.obj hVW x

/-- A local lift together with a lift. -/
abbrev LiftSource : Type u :=
  Σ κ : LiftTarget p f, {y : Y.obj.obj (op κ.V) // p.hom.app (op κ.V) y = res Xs.obj κ.hVW κ.x}

/-- The section of `A` a local lift lies over. -/
def LiftTarget.over (κ : LiftTarget p f) : Sections A :=
  ⟨κ.U, κ.a⟩

theorem liftSource_surjective :
    Function.Surjective (Sigma.fst : LiftSource p f → LiftTarget p f) := by
  intro κ
  obtain ⟨y, hy⟩ := κ.lifts
  exact ⟨⟨κ, y, hy⟩, rfl⟩

/-- **The local lifts over one section of `A` form a small set**, when `f` is small. -/
theorem liftTarget_fibre_small [Small.{w} (Opens X)] (hf : sheafSmall.{w} f) (s : Sections A) :
    Small.{w} {κ : LiftTarget p f // κ.over p f = s} := by
  obtain ⟨U, a⟩ := s
  let T := {t : Σ (W : {W : Opens X // W ≤ U}),
      Σ (_ : {x : Xs.obj.obj (op W.1) // f.hom.app (op W.1) x = res A.obj W.2 a}),
        {V : Opens X // V ≤ W.1} //
    ∃ y : Y.obj.obj (op t.2.2.1), p.hom.app (op t.2.2.1) y = res Xs.obj t.2.2.2 t.2.1.1}
  have : ∀ W : {W : Opens X // W ≤ U},
      Small.{w} {x : Xs.obj.obj (op W.1) // f.hom.app (op W.1) x = res A.obj W.2 a} :=
    fun W => hf (op W.1) _
  refine small_of_surjective (α := T)
    (f := fun t => ⟨⟨U, a, t.1.1.1, t.1.1.2, t.1.2.1.1, t.1.2.1.2, t.1.2.2.1, t.1.2.2.2, t.2⟩, rfl⟩)
    ?_
  rintro ⟨⟨U', a', W, hWU, x, hx, V, hVW, hl⟩, hκ⟩
  cases hκ
  exact ⟨⟨⟨⟨W, hWU⟩, ⟨x, hx⟩, ⟨V, hVW⟩⟩, hl⟩, rfl⟩

/-- The output of collection in the base, applied to the local lifts. -/
structure BaseSquare where
  Z : Type u
  B : Type u
  z : Z → LiftSource p f
  g : Z → B
  h : B → Sections A
  h_surjective : Function.Surjective h
  g_small : ∀ b, Small.{w} {ζ // g ζ = b}
  comm : ∀ ζ, (z ζ).1.over p f = h (g ζ)
  cover : ∀ b κ, h b = κ.over p f → ∃ ζ, g ζ = b ∧ (z ζ).1 = κ

/-- Collection in the base gives the square. -/
theorem nonempty_baseSquare [Small.{w} (Opens X)] (hbase : BaseCollection.{w, u})
    (hf : sheafSmall.{w} f) : Nonempty (BaseSquare.{w} p f) := by
  obtain ⟨Z, B, z, g, h, hh, hg, hcomm, hcover⟩ :=
    hbase (Sigma.fst : LiftSource p f → LiftTarget p f) (LiftTarget.over p f)
      (liftSource_surjective p f) (liftTarget_fibre_small p f hf)
  exact ⟨⟨Z, B, z, g, h, hh, hg, hcomm, hcover⟩⟩

end Lifts

/-! ## The covering square of sheaves -/

section Square

variable {X : Type u} [TopologicalSpace X]
variable {Y Xs A : SheafOn X} {p : Y ⟶ Xs} {f : Xs ⟶ A} (S : BaseSquare.{w} p f)

theorem BaseSquare.bound (ζ : S.Z) {V : Opens X} (hV : V ≤ (S.z ζ).1.V) : V ≤ (S.h (S.g ζ)).1 := by
  rw [← S.comm ζ]
  exact le_trans hV (le_trans (S.z ζ).1.hVW (S.z ζ).1.hWU)

/-- The elements of the base cover, on the open sets inside theirs. -/
def baseValues : (Opens X)ᵒᵖ ⥤ Type u where
  obj W := {b : S.B // unop W ≤ (S.h b).1}
  map k := TypeCat.ofHom fun b => ⟨b.1, le_trans (leOfHom k.unop) b.2⟩

/-- **The sheaf `B`** generated by the base cover. -/
noncomputable abbrev baseSheaf : SheafOn X :=
  (presheafToSheaf (Opens.grothendieckTopology X) (Type u)).obj (baseValues S)

/-- The unit of `B`. -/
noncomputable abbrev baseUnit :
    baseValues S ⟶ sheafify (Opens.grothendieckTopology X) (baseValues S) :=
  toSheafify (Opens.grothendieckTopology X) (baseValues S)

/-- The base cover, read in `A`. -/
def baseToA : baseValues S ⟶ A.obj where
  app W := TypeCat.ofHom fun b => res A.obj b.2 (S.h b.1).2
  naturality W W' k := by
    ext b
    exact (res_res A.obj b.2 (leOfHom k.unop) _).symm

/-- **The map `B ⟶ A`.** -/
noncomputable def baseMap : baseSheaf S ⟶ A :=
  ObjectProperty.homMk (sheafifyLift (Opens.grothendieckTopology X) (baseToA S) A.property)

theorem baseMap_unit (W : Opens X) (b : (baseValues S).obj (op W)) :
    (baseMap S).hom.app (op W) ((baseUnit S).app (op W) b) = res A.obj b.2 (S.h b.1).2 :=
  congrArg (fun k => k.app (op W) b)
    (toSheafify_sheafifyLift (Opens.grothendieckTopology X) (baseToA S) A.property)

/-- **`B ⟶ A` is an epimorphism**: it is even pointwise surjective. -/
theorem baseMap_epi : Epi (baseMap S) := by
  have : Sheaf.IsLocallySurjective (baseMap S) := by
    refine Presheaf.isLocallySurjective_of_surjective _ _ fun W a => ?_
    obtain ⟨b, hb⟩ := S.h_surjective ⟨unop W, a⟩
    let b' : (baseValues S).obj (op (unop W)) := ⟨b, le_of_eq (congrArg Sigma.fst hb).symm⟩
    exact ⟨(baseUnit S).app W b', (baseMap_unit S (unop W) b').trans
      ((res_sigma_congr A.obj hb _ le_rfl).trans (res_self A.obj _ a))⟩
  exact (Sheaf.isLocallySurjective_iff_epi _).mp this

/-- The pairs of a section of `Y` and a section of `B` given by a chosen lift. -/
def liftsSubfunctor : Subfunctor (pairPresheaf Y.obj (baseSheaf S).obj) where
  obj W := {pr | ∃ (ζ : S.Z) (hV : unop W ≤ (S.z ζ).1.V),
    pr.1 = res Y.obj hV (S.z ζ).2.1 ∧
      pr.2 = (baseUnit S).app W ⟨S.g ζ, S.bound ζ hV⟩}
  map {W W'} k pr := by
    rintro ⟨ζ, hV, e₁, e₂⟩
    refine ⟨ζ, le_trans (leOfHom k.unop) hV, ?_, ?_⟩
    · show Y.obj.map k pr.1 = _
      rw [e₁]
      exact res_res Y.obj hV (leOfHom k.unop) _
    · show (baseSheaf S).obj.map k pr.2 = _
      rw [e₂]
      exact (NatTrans.naturality_apply (baseUnit S) k _).symm

theorem baseSheaf_isSheaf :
    Presieve.IsSheaf (Opens.grothendieckTopology X) (baseSheaf S).obj :=
  (isSheaf_iff_isSheaf_of_type _ _).mp (baseSheaf S).property

/-- **The sheaf `Z`**: the subsheaf of `Y × B` locally generated by the chosen lifts. -/
noncomputable def liftsSheaf : SheafOn X :=
  ⟨((liftsSubfunctor S).sheafify (Opens.grothendieckTopology X)).toFunctor,
    (isSheaf_iff_isSheaf_of_type _ _).mpr ((liftsSubfunctor S).sheafify_isSheaf
      (pairPresheaf_isSheaf ((isSheaf_iff_isSheaf_of_type _ _).mp Y.property)
        (baseSheaf_isSheaf S)))⟩

/-- The map `Z ⟶ Y`. -/
noncomputable def liftsToY : liftsSheaf S ⟶ Y :=
  ObjectProperty.homMk (((liftsSubfunctor S).sheafify (Opens.grothendieckTopology X)).ι ≫
    pairFst Y.obj (baseSheaf S).obj)

/-- The map `Z ⟶ B`. -/
noncomputable def liftsToB : liftsSheaf S ⟶ baseSheaf S :=
  ObjectProperty.homMk (((liftsSubfunctor S).sheafify (Opens.grothendieckTopology X)).ι ≫
    pairSnd Y.obj (baseSheaf S).obj)

theorem liftsToY_apply (W : (Opens X)ᵒᵖ) (ζ' : (liftsSheaf S).obj.obj W) :
    (liftsToY S).hom.app W ζ' = ζ'.1.1 :=
  rfl

theorem liftsToB_apply (W : (Opens X)ᵒᵖ) (ζ' : (liftsSheaf S).obj.obj W) :
    (liftsToB S).hom.app W ζ' = ζ'.1.2 :=
  rfl

/-- A local lift, read in `A` along `p` and `f`, is the restriction of the section it lies
over. -/
theorem lift_over (ζ : S.Z) {V : Opens X} (hV : V ≤ (S.z ζ).1.V) :
    f.hom.app (op V) (p.hom.app (op V) (res Y.obj hV (S.z ζ).2.1)) =
      res A.obj (S.bound ζ hV) (S.h (S.g ζ)).2 := by
  rw [res_nat, (S.z ζ).2.2, res_res, res_nat, (S.z ζ).1.hx, res_res]
  exact res_sigma_congr A.obj (S.comm ζ) _ _

/-- **The square commutes.** -/
theorem lifts_comm : (liftsToY S ≫ p) ≫ f = liftsToB S ≫ baseMap S := by
  apply Sheaf.hom_ext
  ext W ζ'
  show f.hom.app W (p.hom.app W ζ'.1.1) = (baseMap S).hom.app W ζ'.1.2
  refine sheaf_eq_of_covered A (U := unop W) (covered_of_mem ζ'.2 fun V k hk => ?_)
  obtain ⟨ζ, hV, e₁, e₂⟩ := hk
  have e₁' : res Y.obj (leOfHom k) ζ'.1.1 = res Y.obj hV (S.z ζ).2.1 := e₁
  have e₂' : res (baseSheaf S).obj (leOfHom k) ζ'.1.2 =
      (baseUnit S).app (op V) ⟨S.g ζ, S.bound ζ hV⟩ := e₂
  show res A.obj (leOfHom k) _ = res A.obj (leOfHom k) _
  rw [← res_nat, ← res_nat, e₁', lift_over, ← res_nat, e₂']
  exact (baseMap_unit S V ⟨S.g ζ, S.bound ζ hV⟩).symm

/-- On a nonempty open set, a section of `B` comes from at most one element of the base
cover. -/
theorem base_unique {V : Opens X} (hV : (V : Set X).Nonempty) (β : (baseSheaf S).obj.obj (op V))
    {b b' : S.B} (hb : V ≤ (S.h b).1) (hb' : V ≤ (S.h b').1)
    (e : (baseUnit S).app (op V) ⟨b, hb⟩ = β) (e' : (baseUnit S).app (op V) ⟨b', hb'⟩ = β) :
    b = b' := by
  have hmem := Presheaf.equalizerSieve_mem (Opens.grothendieckTopology X) (baseUnit S)
    (X := op V) ⟨b, hb⟩ ⟨b', hb'⟩ (e.trans e'.symm)
  obtain ⟨x, hx⟩ := hV
  rw [Opens.mem_grothendieckTopology] at hmem
  obtain ⟨V', k, hk, -⟩ := hmem x hx
  exact congrArg Subtype.val hk

variable [Small.{w} (Opens X)]

/-- **`Z ⟶ B` is small.** -/
theorem liftsToB_small : sheafSmall.{w} (liftsToB S) := by
  intro W β
  let Index := Σ V : {V : Opens X // V ≤ unop W ∧ (V : Set X).Nonempty},
    {ζ : S.Z // ∃ hV : V.1 ≤ (S.z ζ).1.V,
      res (baseSheaf S).obj V.2.1 β = (baseUnit S).app (op V.1) ⟨S.g ζ, S.bound ζ hV⟩}
  have : ∀ V : {V : Opens X // V ≤ unop W ∧ (V : Set X).Nonempty},
      Small.{w} {ζ : S.Z // ∃ hV : V.1 ≤ (S.z ζ).1.V,
        res (baseSheaf S).obj V.2.1 β = (baseUnit S).app (op V.1) ⟨S.g ζ, S.bound ζ hV⟩} := by
    intro V
    let Bs := {b : S.B // ∃ hb : V.1 ≤ (S.h b).1,
      res (baseSheaf S).obj V.2.1 β = (baseUnit S).app (op V.1) ⟨b, hb⟩}
    have : Subsingleton Bs := ⟨fun b b' => Subtype.ext (base_unique S V.2.2 _ b.2.1 b'.2.1
      b.2.2.symm b'.2.2.symm)⟩
    have : ∀ b : Bs, Small.{w} {ζ // S.g ζ = b.1} := fun b => S.g_small b.1
    refine small_of_injective (β := Σ b : Bs, {ζ // S.g ζ = b.1})
      (f := fun ζ => ⟨⟨S.g ζ.1, S.bound ζ.1 ζ.2.1, ζ.2.2⟩, ⟨ζ.1, rfl⟩⟩) ?_
    intro ζ₁ ζ₂ same
    exact Subtype.ext (congrArg (fun s : Σ b : Bs, {ζ // S.g ζ = b.1} => s.2.1) same)
  let encode : {ζ' // (liftsToB S).hom.app W ζ' = β} → Set Index := fun ζ' =>
    {t | ∀ hV : t.1.1 ≤ (S.z t.2.1).1.V,
      res Y.obj t.1.2.1 ζ'.1.1.1 = res Y.obj hV (S.z t.2.1).2.1}
  refine small_of_injective (f := encode) fun ζ₁ ζ₂ same => ?_
  have hβ : ζ₁.1.1.2 = ζ₂.1.1.2 := ζ₁.2.trans ζ₂.2.symm
  refine Subtype.ext (Subtype.ext (Prod.ext ?_ hβ))
  refine sheaf_eq_of_covered Y (U := unop W) (covered_opens_iff.mpr fun x hx => ?_)
  have hmem : (liftsSubfunctor S).sieveOfSection ζ₁.1.1 ∈
      Opens.grothendieckTopology X (unop W) := ζ₁.1.2
  rw [Opens.mem_grothendieckTopology] at hmem
  obtain ⟨V, k, ⟨ζ, hV, e₁, e₂⟩, hxV⟩ := hmem x hx
  have hβV : res (baseSheaf S).obj (leOfHom k) β =
      (baseUnit S).app (op V) ⟨S.g ζ, S.bound ζ hV⟩ := by
    rw [← ζ₁.2]
    exact e₂
  let t : Index := ⟨⟨V, leOfHom k, ⟨x, hxV⟩⟩, ⟨ζ, hV, hβV⟩⟩
  have mem₁ : t ∈ encode ζ₁ := fun _ => e₁
  rw [same] at mem₁
  exact ⟨V, leOfHom k, e₁.trans (mem₁ hV).symm, hxV⟩

omit [Small.{w} (Opens X)] in
/-- **The comparison map to the pullback is locally surjective.** -/
theorem lifts_comparison_epi (hp : Epi p) :
    Epi (pullback.lift (liftsToY S ≫ p) (liftsToB S) (lifts_comm S)) := by
  let L := pullback.lift (liftsToY S ≫ p) (liftsToB S) (lifts_comm S)
  have square : ∀ V : Opens X, IsPullback ((pullback.fst f (baseMap S)).hom.app (op V))
      ((pullback.snd f (baseMap S)).hom.app (op V)) (f.hom.app (op V))
      ((baseMap S).hom.app (op V)) := fun V =>
    Functor.map_isPullback ((evaluation _ _).obj (op V))
      (Functor.map_isPullback (sheafToPresheaf (Opens.grothendieckTopology X) (Type u))
        (IsPullback.of_hasPullback f (baseMap S)))
  have lift_fst : ∀ (V : Opens X) (ζ' : (liftsSheaf S).obj.obj (op V)),
      (pullback.fst f (baseMap S)).hom.app (op V) (L.hom.app (op V) ζ') =
        p.hom.app (op V) ζ'.1.1 :=
    fun V ζ' => congrArg (fun k : liftsSheaf S ⟶ Xs => k.hom.app (op V) ζ')
      (pullback.lift_fst (liftsToY S ≫ p) (liftsToB S) (lifts_comm S))
  have lift_snd : ∀ (V : Opens X) (ζ' : (liftsSheaf S).obj.obj (op V)),
      (pullback.snd f (baseMap S)).hom.app (op V) (L.hom.app (op V) ζ') = ζ'.1.2 :=
    fun V ζ' => congrArg (fun k : liftsSheaf S ⟶ baseSheaf S => k.hom.app (op V) ζ')
      (pullback.lift_snd (liftsToY S ≫ p) (liftsToB S) (lifts_comm S))
  have : Sheaf.IsLocallySurjective L := by
    refine ⟨fun {U} ω => (covered_iff_mem _).mp ?_⟩
    let x := (pullback.fst f (baseMap S)).hom.app (op U) ω
    let β := (pullback.snd f (baseMap S)).hom.app (op U) ω
    have hxβ : f.hom.app (op U) x = (baseMap S).hom.app (op U) β :=
      congrArg (fun k : pullback f (baseMap S) ⟶ A => k.hom.app (op U) ω) pullback.condition
    refine covered_trans (covered_surjective_of_isLocallySurjective (baseUnit S) U β)
      fun W₁ h₁ ⟨bb, hb⟩ => ?_
    have hb' : (baseUnit S).app (op W₁) bb = res (baseSheaf S).obj h₁ β := hb
    refine covered_mono (fun W₂ h₂ ⟨y, hy⟩ => ?_)
      (covered_surjective_of_epi p W₁ (res Xs.obj h₁ x))
    have hx : f.hom.app (op W₁) (res Xs.obj h₁ x) = res A.obj bb.2 (S.h bb.1).2 := by
      rw [res_nat, hxβ, ← res_nat, ← hb', baseMap_unit]
    let κ : LiftTarget p f := ⟨(S.h bb.1).1, (S.h bb.1).2, W₁, bb.2, res Xs.obj h₁ x, hx, W₂, h₂,
      ⟨y, hy⟩⟩
    obtain ⟨ζ, hgζ, hzζ⟩ := S.cover bb.1 κ rfl
    have hV : W₂ ≤ (S.z ζ).1.V := le_of_eq (congrArg LiftTarget.V hzζ).symm
    have hβ : res (baseSheaf S).obj (le_trans h₂ h₁) β =
        (baseUnit S).app (op W₂) ⟨S.g ζ, S.bound ζ hV⟩ := by
      rw [← res_res _ h₁ h₂, ← hb', ← res_nat]
      exact congrArg _ (Subtype.ext hgζ.symm)
    let ζ' : (liftsSheaf S).obj.obj (op W₂) :=
      ⟨(res Y.obj hV (S.z ζ).2.1, res (baseSheaf S).obj (le_trans h₂ h₁) β),
        Subfunctor.le_sheafify _ _ _ ⟨ζ, hV, rfl, hβ⟩⟩
    have chain : p.hom.app (op W₂) (res Y.obj hV (S.z ζ).2.1) =
        res Xs.obj (le_trans h₂ h₁) x := by
      rw [res_nat, (S.z ζ).2.2, res_res, ← res_res Xs.obj h₁ h₂]
      have key : ∀ κ' : LiftTarget p f, κ' = κ → ∀ hW : W₂ ≤ κ'.V,
          res Xs.obj (le_trans hW κ'.hVW) κ'.x = res Xs.obj h₂ (res Xs.obj h₁ x) := by
        rintro κ' rfl hW
        rfl
      exact key _ hzζ hV
    refine ⟨ζ', Limits.Types.ext_of_isPullback (square W₂) ?_ ?_⟩
    · exact (lift_fst W₂ ζ').trans
        (chain.trans (res_nat (pullback.fst f (baseMap S)).hom (le_trans h₂ h₁) ω).symm)
    · exact (lift_snd W₂ ζ').trans
        (res_nat (pullback.snd f (baseMap S)).hom (le_trans h₂ h₁) ω).symm
  exact (Sheaf.isLocallySurjective_iff_epi L).mp this

end Square

/-! ## Collection -/

/-- **Collection for sheaves on a space, from collection in the base.** For the pointwise small
maps of sheaves on a space whose open sets form a `w`-small type, with epimorphisms the locally
surjective maps, collection (A7) holds as soon as it holds for Lean's types. -/
theorem sheafSmall_collection {X : Type u} [TopologicalSpace X] [Small.{w} (Opens X)]
    (hbase : BaseCollection.{w, u}) :
    CollectionAxiom (sheafSmall.{w} : MorphismProperty (SheafOn X)) := by
  intro Y Xs A p f hp hf
  obtain ⟨S⟩ := nonempty_baseSquare p f hbase hf
  exact ⟨liftsSheaf S, baseSheaf S, liftsToY S, liftsToB S, baseMap S, lifts_comm S,
    baseMap_epi S, liftsToB_small S, lifts_comparison_epi S hp⟩

/-- **Collection for sheaves on a space, with host choice.** -/
theorem sheafSmall_collection_of_choice {X : Type u} [TopologicalSpace X] [Small.{w} (Opens X)] :
    CollectionAxiom (sheafSmall.{w} : MorphismProperty (SheafOn X)) :=
  sheafSmall_collection baseCollection_of_choice

