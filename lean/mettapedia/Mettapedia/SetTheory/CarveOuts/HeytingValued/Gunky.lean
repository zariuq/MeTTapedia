import Mettapedia.SetTheory.CarveOuts.HeytingValued.Points
import Mettapedia.SetTheory.CarveOuts.HeytingValued.DoubleNegation
import Mettapedia.Logic.StoneGunkDuality
import Mathlib.Topology.Sets.Opens
import Mathlib.Topology.Separation.Hausdorff

/-!
# Gunky frames: no principal point

A point of a frame is **principal** when the truth values it affirms have a least element
(`Point.IsPrincipal`); a point generated by an atom is principal (`atomPoint_isPrincipal`).

* **In a complete Boolean algebra every point is generated by an atom**
  (`exists_atom_of_point`). So an atomless complete Boolean algebra has no point at all
  (`isEmpty_point_of_isGunky`).
* **Spaces without isolated points.** For a T1 space with no isolated point, the frame of
  open sets is atomless (`isGunky_opens`) and none of its points is principal
  (`not_isPrincipal_opens`), although every point of the space gives a point of the frame
  (`Point.ofMem`). For a Hausdorff space with no isolated point, the double-negation part of
  that frame, the regular open sets, is atomless (`isGunky_regular_opens`) and so has no
  point at all (`isEmpty_point_regular_opens`).
* **The gunky witness** is Cantor space `ℕ → Bool` (`cantorGunkyWitness`). That it has no
  isolated point is read off the gunky Boolean algebra of its clopen sets
  (`Foundations.Gunk.isGunky_clopens_cantor`). The real line is a second witness
  (`realGunkyWitness`), read off the gunky frame `Opens ℝ`
  (`Foundations.Gunk.isGunky_opens_real`).

In the ultrainfinitist reading: the frame of perspectives of the continuum, or of Cantor space, has no
finite (principal) perspective; its classical carve-out by double negation has no two-valued
reading by a completely prime filter. These statements are classical.
-/

set_option autoImplicit false

namespace Mettapedia.SetTheory.CarveOuts.HeytingValued

universe u

open Heyting TopologicalSpace
open Mettapedia.Foundations.Gunk (IsGunky)

/-! ## Principal points -/

namespace Point

variable {H : Type u} [Order.Frame H]

/-- A point is principal when the truth values it affirms have a least element. -/
def IsPrincipal (p : Point H) : Prop :=
  ∃ a, ∀ h, p.holds h ↔ a ≤ h

/-- The point of a point of the space: the open sets containing it. -/
def ofMem {X : Type u} [TopologicalSpace X] (x : X) : Point (Opens X) where
  holds U := x ∈ U
  holds_top := trivial
  holds_inf _ _ := Iff.rfl
  holds_sSup S := by
    rw [Opens.mem_sSup]

end Point

theorem atomPoint_isPrincipal {H : Type u} [Order.Frame H] {a : H} (ha : IsAtom a) :
    (atomPoint ha).IsPrincipal :=
  ⟨a, fun _ => Iff.rfl⟩

/-! ## Points of complete Boolean algebras -/

section Boolean

variable {B : Type u} [CompleteBooleanAlgebra B]

/-- **Every point of a complete Boolean algebra is generated by an atom.** -/
theorem exists_atom_of_point (p : Point B) : ∃ a, IsAtom a ∧ ∀ h, p.holds h ↔ a ≤ h := by
  set a := sInf {h | p.holds h} with ha_def
  have split : ∀ h : B, p.holds h ∨ p.holds hᶜ := fun h => by
    rw [← p.holds_sup, sup_compl_eq_top]
    exact p.holds_top
  have hp : p.holds a := by
    rcases split a with h | h
    · exact h
    · exfalso
      rw [ha_def, compl_sInf, ← sSup_image] at h
      obtain ⟨_, ⟨k, hk, rfl⟩, hkc⟩ := (p.holds_sSup _).mp h
      exact p.not_holds_bot (by
        rw [← inf_compl_self k]
        exact (p.holds_inf _ _).mpr ⟨hk, hkc⟩)
  have least : ∀ h, p.holds h ↔ a ≤ h := fun h =>
    ⟨fun hh => sInf_le hh, fun hle => p.holds_mono hle hp⟩
  refine ⟨a, ⟨fun e => p.not_holds_bot (e ▸ hp), fun b hb => ?_⟩, least⟩
  have nb : ¬ p.holds b := fun hb' => (lt_iff_le_not_ge.mp hb).2 ((least b).mp hb')
  have hbc : a ≤ bᶜ := (least _).mp ((split b).resolve_left nb)
  exact le_bot_iff.mp (le_trans (le_inf le_rfl (le_trans hb.le hbc)) (le_of_eq (inf_compl_self b)))

/-- **An atomless complete Boolean algebra has no point.** -/
theorem isEmpty_point_of_isGunky (hg : IsGunky B) : IsEmpty (Point B) := by
  refine ⟨fun p => ?_⟩
  obtain ⟨a, ha, _⟩ := exists_atom_of_point p
  exact (Mettapedia.Foundations.Gunk.isGunky_iff_no_isAtom.mp hg) a ha

end Boolean

/-! ## The double-negation part of a splitting frame is atomless -/

section Splitting

variable {H : Type u} [Order.Frame H]

/-- If every non-bottom truth value contains two disjoint non-bottom parts, the
double-negation part is atomless. -/
theorem isGunky_regular_of_split
    (split : ∀ u : H, u ≠ ⊥ → ∃ v w, v ≤ u ∧ w ≤ u ∧ v ≠ ⊥ ∧ w ≠ ⊥ ∧ v ⊓ w = ⊥) :
    IsGunky (Regular H) := by
  intro r hr
  have hr' : (r : H) ≠ ⊥ := fun e => hr (Regular.coe_injective (e.trans Regular.coe_bot.symm))
  obtain ⟨v, w, hv, hw, hv0, hw0, hvw⟩ := split r hr'
  refine ⟨Regular.toRegular v, ?_, lt_of_le_of_ne ?_ ?_⟩
  · intro e
    apply hv0
    have : vᶜᶜ = ⊥ := by
      rw [← Regular.coe_toRegular, e, Regular.coe_bot]
    exact le_bot_iff.mp (le_trans le_compl_compl (le_of_eq this))
  · rw [← Regular.coe_le_coe, Regular.coe_toRegular]
    exact le_trans (compl_compl_mono hv) (le_of_eq r.prop)
  · intro e
    have hwv : w ≤ vᶜᶜ := by
      rw [← Regular.coe_toRegular, e]
      exact hw
    have hwc : w ≤ vᶜ := by
      rw [← himp_bot, le_himp_iff, inf_comm]
      exact le_of_eq hvw
    exact hw0 (le_bot_iff.mp (le_trans (le_inf hwc hwv) (le_of_eq (inf_compl_self vᶜ))))

end Splitting

/-! ## Frames of open sets without isolated points -/

section Spaces

variable {X : Type u} [TopologicalSpace X]

theorem opens_ne_bot_iff (U : Opens X) : U ≠ ⊥ ↔ (U : Set X).Nonempty := by
  rw [Ne, ← Opens.coe_eq_empty]
  exact Set.nonempty_iff_ne_empty.symm

/-- A non-empty open set without isolated points has a second point. -/
theorem exists_ne_of_open (noIsolated : ∀ x : X, ¬ IsOpen ({x} : Set X)) {U : Opens X}
    {x : X} (hx : x ∈ U) : ∃ y ∈ U, y ≠ x := by
  by_contra none
  push Not at none
  apply noIsolated x
  have : (U : Set X) = {x} := Set.eq_singleton_iff_unique_mem.mpr ⟨hx, none⟩
  exact this ▸ U.isOpen

/-- The open set `U` with the point `x` removed. -/
def Opens.erase [T1Space X] (U : Opens X) (x : X) : Opens X :=
  ⟨(U : Set X) \ {x}, U.isOpen.sdiff isClosed_singleton⟩

/-- **Without isolated points, the frame of open sets is atomless.** -/
theorem isGunky_opens [T1Space X] (noIsolated : ∀ x : X, ¬ IsOpen ({x} : Set X)) : IsGunky (Opens X) := by
  intro U hU
  obtain ⟨x, hx⟩ := (opens_ne_bot_iff U).mp hU
  obtain ⟨y, hy, hyx⟩ := exists_ne_of_open noIsolated hx
  refine ⟨Opens.erase U x, (opens_ne_bot_iff _).mpr ⟨y, hy, hyx⟩, lt_of_le_of_ne
    (fun z hz => hz.1) fun e => ?_⟩
  have : x ∈ Opens.erase U x := by
    rw [e]
    exact hx
  exact this.2 rfl

/-- **Without isolated points, no point of the frame of open sets is principal.** -/
theorem not_isPrincipal_opens [T1Space X] (noIsolated : ∀ x : X, ¬ IsOpen ({x} : Set X))
    (p : Point (Opens X)) : ¬ p.IsPrincipal := by
  rintro ⟨A, hA⟩
  have hpA : p.holds A := (hA A).mpr le_rfl
  have hA0 : A ≠ ⊥ := fun e => p.not_holds_bot (e ▸ hpA)
  obtain ⟨x, hx⟩ := (opens_ne_bot_iff A).mp hA0
  obtain ⟨y, hy, hyx⟩ := exists_ne_of_open noIsolated hx
  let W : Opens X := ⟨{y}ᶜ, isOpen_compl_singleton⟩
  have cover : A = Opens.erase A x ⊔ (A ⊓ W) := by
    apply le_antisymm
    · intro z hz
      by_cases hzx : z = x
      · subst hzx
        exact Or.inr ⟨hz, fun e => hyx (e ▸ rfl)⟩
      · exact Or.inl ⟨hz, hzx⟩
    · exact sup_le (fun z hz => hz.1) inf_le_left
  rcases (p.holds_sup _ _).mp (cover ▸ hpA) with h | h
  · have : x ∈ Opens.erase A x := (hA _).mp h hx
    exact this.2 rfl
  · have : y ∈ A ⊓ W := (hA _).mp h hy
    exact this.2 rfl

/-- In a Hausdorff space without isolated points, every non-empty open set contains two
disjoint non-empty open sets. -/
theorem opens_split [T2Space X] (noIsolated : ∀ x : X, ¬ IsOpen ({x} : Set X)) (U : Opens X)
    (hU : U ≠ ⊥) : ∃ V W : Opens X, V ≤ U ∧ W ≤ U ∧ V ≠ ⊥ ∧ W ≠ ⊥ ∧ V ⊓ W = ⊥ := by
  obtain ⟨x, hx⟩ := (opens_ne_bot_iff U).mp hU
  obtain ⟨y, hy, hyx⟩ := exists_ne_of_open noIsolated hx
  obtain ⟨V, W, hV, hW, hxV, hyW, hVW⟩ := t2_separation hyx.symm
  refine ⟨U ⊓ ⟨V, hV⟩, U ⊓ ⟨W, hW⟩, inf_le_left, inf_le_left,
    (opens_ne_bot_iff _).mpr ⟨x, hx, hxV⟩, (opens_ne_bot_iff _).mpr ⟨y, hy, hyW⟩, ?_⟩
  rw [← Opens.coe_eq_empty]
  exact Set.eq_empty_of_forall_notMem fun z hz => Set.disjoint_left.mp hVW hz.1.2 hz.2.2

/-- **The regular open sets of a Hausdorff space without isolated points are atomless.** -/
theorem isGunky_regular_opens [T2Space X] (noIsolated : ∀ x : X, ¬ IsOpen ({x} : Set X)) :
    IsGunky (Regular (Opens X)) :=
  isGunky_regular_of_split (opens_split noIsolated)

/-- **The double-negation part has no two-valued reading.** -/
theorem isEmpty_point_regular_opens [T2Space X]
    (noIsolated : ∀ x : X, ¬ IsOpen ({x} : Set X)) : IsEmpty (Point (Regular (Opens X))) :=
  isEmpty_point_of_isGunky (isGunky_regular_opens noIsolated)

end Spaces

/-! ## The witnesses -/

/-- What a gunky space gives: its frame of opens is atomless and has points, none principal;
its double-negation part is atomless and has no point. -/
structure GunkyWitness (X : Type u) [TopologicalSpace X] : Prop where
  opensGunky : IsGunky (Opens X)
  hasPoints : ∀ x : X, ∃ p : Point (Opens X), ∀ U : Opens X, p.holds U ↔ x ∈ U
  noPrincipalPoint : ∀ p : Point (Opens X), ¬ p.IsPrincipal
  regularGunky : IsGunky (Regular (Opens X))
  regularPointless : IsEmpty (Point (Regular (Opens X)))

theorem gunkyWitness {X : Type u} [TopologicalSpace X] [T2Space X]
    (noIsolated : ∀ x : X, ¬ IsOpen ({x} : Set X)) : GunkyWitness X where
  opensGunky := isGunky_opens noIsolated
  hasPoints x := ⟨Point.ofMem x, fun _ => Iff.rfl⟩
  noPrincipalPoint := not_isPrincipal_opens noIsolated
  regularGunky := isGunky_regular_opens noIsolated
  regularPointless := isEmpty_point_regular_opens noIsolated

/-- Cantor space has no isolated point: an open singleton would be an atom of its clopen
algebra, which is gunky. -/
theorem cantor_noIsolated (f : ℕ → Bool) : ¬ IsOpen ({f} : Set (ℕ → Bool)) := by
  intro hopen
  let K : Clopens (ℕ → Bool) := ⟨{f}, isClosed_singleton, hopen⟩
  obtain ⟨b, hb0, hbK⟩ := Mettapedia.Foundations.Gunk.isGunky_clopens_cantor K (by
    intro e
    have : f ∈ (K : Set (ℕ → Bool)) := rfl
    rw [e] at this
    exact this)
  apply hb0
  have hsub : (b : Set (ℕ → Bool)) ⊆ {f} := hbK.le
  rcases Set.subset_singleton_iff_eq.mp hsub with h | h
  · exact SetLike.coe_injective (h.trans Clopens.coe_bot.symm)
  · exact absurd (SetLike.coe_injective h) hbK.ne

/-- **The gunky witness: Cantor space.** -/
theorem cantorGunkyWitness : GunkyWitness (ℕ → Bool) :=
  gunkyWitness cantor_noIsolated

/-- The real line has no isolated point: an open singleton would be an atom of the gunky
frame of open sets. -/
theorem real_noIsolated (x : ℝ) : ¬ IsOpen ({x} : Set ℝ) := by
  intro hopen
  let K : Opens ℝ := ⟨{x}, hopen⟩
  obtain ⟨b, hb0, hbK⟩ := Mettapedia.Foundations.Gunk.isGunky_opens_real K (by
    intro e
    have : x ∈ (K : Set ℝ) := rfl
    rw [e] at this
    exact this)
  apply hb0
  have hsub : (b : Set ℝ) ⊆ {x} := hbK.le
  rcases Set.subset_singleton_iff_eq.mp hsub with h | h
  · exact SetLike.coe_injective (h.trans Opens.coe_bot.symm)
  · exact absurd (SetLike.coe_injective h) hbK.ne

/-- The real line: a second gunky witness. -/
theorem realGunkyWitness : GunkyWitness ℝ :=
  gunkyWitness real_noIsolated

end Mettapedia.SetTheory.CarveOuts.HeytingValued
