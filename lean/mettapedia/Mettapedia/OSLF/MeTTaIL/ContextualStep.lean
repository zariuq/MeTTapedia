import Mettapedia.OSLF.MeTTaIL.Engine

/-!
# Least reduction generated by authored contextual rules

This module gives `Premise.congruence` its recursive, least-fixed-point
meaning.  Non-contextual premises are supplied by an explicit evaluator;
contextual authority comes only from congruence premises in authored rewrite
rules.  There is no representation-wide collection-descent switch.

The executable interpreter is fuel-indexed.  Its relational specification is
independently inductive at the same index, and the two are proved equivalent.
The unbounded relation is the existence of a finite derivation index.
-/

namespace Mettapedia.OSLF.MeTTaIL.ContextualStep

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.Match
open Mettapedia.OSLF.MeTTaIL.Engine
open Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical
open Mettapedia.OSLF.MeTTaIL.ReflectiveSubstitution

/-- The non-contextual premise boundary.  Freshness and relation-query policy
can vary by host, but congruence is never delegated through this boundary. -/
abbrev BasePremiseEvaluator :=
  LanguageDef → Bindings → Premise → List Bindings

/-- Existing non-contextual premise behavior, with congruence removed. -/
def engineBasePremises (relEnv : RelationEnv) : BasePremiseEvaluator :=
  fun lang bindings premise =>
    match premise with
    | .congruence _ _ => []
    | _ => premiseStepWithEnv relEnv lang bindings premise

/-! ## Executable compiler -/

/-- Evaluate one premise, using `recursiveStep` only for an authored
congruence premise. -/
def premiseStepUsing
    (base : BasePremiseEvaluator) (lang : LanguageDef)
    (recursiveStep : Pattern → List Pattern)
    (bindings : Bindings) : Premise → List Bindings
  | .congruence source target =>
      let source' := applyBindings bindings source
      (recursiveStep source').flatMap fun candidate =>
        (matchPattern target candidate).filterMap fun premiseBindings =>
          mergeBindings bindings premiseBindings
  | premise => base lang bindings premise

/-- Evaluate an ordered premise list. -/
def premisesUsing
    (base : BasePremiseEvaluator) (lang : LanguageDef)
    (recursiveStep : Pattern → List Pattern) :
    List Premise → Bindings → List Bindings
  | [], bindings => [bindings]
  | premise :: premises, bindings =>
      (premiseStepUsing base lang recursiveStep bindings premise).flatMap
        (premisesUsing base lang recursiveStep premises)

/-- Apply one rule with the supplied recursive interpretation of congruence. -/
def applyRuleUsing
    (base : BasePremiseEvaluator) (lang : LanguageDef)
    (recursiveStep : Pattern → List Pattern)
    (rule : RewriteRule) (term : Pattern) : List Pattern :=
  (matchPatternForRule lang rule term).flatMap fun initialBindings =>
    (premisesUsing base lang recursiveStep rule.premises initialBindings).map
      fun finalBindings => applyBindingsForRule lang rule finalBindings

/-- Fuel-indexed compilation of the least relation generated by the authored
rewrite rules.  One unit of fuel is consumed at every contextual-rule layer. -/
def rewriteAt
    (base : BasePremiseEvaluator) (lang : LanguageDef) :
    Nat → Pattern → List Pattern
  | 0, _ => []
  | fuel + 1, term =>
      lang.rewrites.flatMap fun rule =>
        applyRuleUsing base lang (rewriteAt base lang fuel) rule term

/-- Execute the authored contextual rules with an explicit relation
environment and contextual-depth bound. -/
def reductsUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (contextFuel : Nat) (term : Pattern) : List Pattern :=
  rewriteAt (engineBasePremises relEnv) lang contextFuel term

/-- Execute the authored contextual rules with the empty relation environment
and an explicit contextual-depth bound. -/
def reducts (lang : LanguageDef) (contextFuel : Nat)
    (term : Pattern) : List Pattern :=
  reductsUsing RelationEnv.empty lang contextFuel term

/-- Follow the first authored reduct until no reduct remains or the explicit
step bound is exhausted.  `contextFuel` bounds each individual contextual
derivation; `stepFuel` bounds the number of successive reductions. -/
def normalizeFirstAt
    (base : BasePremiseEvaluator) (lang : LanguageDef)
    (contextFuel : Nat) : Nat → Pattern → Pattern
  | 0, term => term
  | stepFuel + 1, term =>
      match rewriteAt base lang contextFuel term with
      | [] => term
      | next :: _ => normalizeFirstAt base lang contextFuel stepFuel next

/-- First-reduct normalization with an explicit relation environment and both
bounds visible at the call site. -/
def normalizeFirstUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (contextFuel stepFuel : Nat) (term : Pattern) : Pattern :=
  normalizeFirstAt (engineBasePremises relEnv) lang contextFuel stepFuel term

/-- First-reduct normalization with the empty relation environment and both
bounds visible at the call site. -/
def normalizeFirst (lang : LanguageDef) (contextFuel stepFuel : Nat)
    (term : Pattern) : Pattern :=
  normalizeFirstUsing RelationEnv.empty lang contextFuel stepFuel term

/-! ## Independent bounded relation -/

mutual
  /-- Evidence for one premise at a fixed recursive depth. -/
  inductive PremiseAt
      (base : BasePremiseEvaluator) (lang : LanguageDef) :
      Nat → Bindings → Premise → Bindings → Prop where
    | freshness {bindings result : Bindings} {condition : FreshnessCondition} :
        result ∈ base lang bindings (.freshness condition) →
        PremiseAt base lang fuel bindings (.freshness condition) result
    | relationQuery {bindings result : Bindings} {relation : String}
        {arguments : List Pattern} :
        result ∈ base lang bindings (.relationQuery relation arguments) →
        PremiseAt base lang fuel bindings
          (.relationQuery relation arguments) result
    | forAll {bindings result : Bindings} {collection parameter : String}
        {body : Premise} :
        result ∈ base lang bindings (.forAll collection parameter body) →
        PremiseAt base lang fuel bindings
          (.forAll collection parameter body) result
    | congruence
        {bindings premiseBindings result : Bindings}
        {source target candidate : Pattern} :
        StepAt base lang fuel (applyBindings bindings source) candidate →
        premiseBindings ∈ matchPattern target candidate →
        mergeBindings bindings premiseBindings = some result →
        PremiseAt base lang fuel bindings (.congruence source target) result

  /-- Evidence for an ordered list of premises. -/
  inductive PremisesAt
      (base : BasePremiseEvaluator) (lang : LanguageDef) :
      Nat → Bindings → List Premise → Bindings → Prop where
    | nil (bindings : Bindings) :
        PremisesAt base lang fuel bindings [] bindings
    | cons {initial middle final : Bindings} {premise : Premise}
        {premises : List Premise} :
        PremiseAt base lang fuel initial premise middle →
        PremisesAt base lang fuel middle premises final →
        PremisesAt base lang fuel initial (premise :: premises) final

  /-- One authored-rule step at a bounded contextual depth. -/
  inductive StepAt
      (base : BasePremiseEvaluator) (lang : LanguageDef) :
      Nat → Pattern → Pattern → Prop where
    | rule
        {fuel : Nat} {source target : Pattern} {rule : RewriteRule}
        {initialBindings finalBindings : Bindings} :
        rule ∈ lang.rewrites →
        initialBindings ∈ matchPatternForRule lang rule source →
        PremisesAt base lang fuel initialBindings rule.premises finalBindings →
        applyBindingsForRule lang rule finalBindings = target →
        StepAt base lang (fuel + 1) source target
end

/-- The least authored contextual reduction relation: a derivation is valid
when it has some finite contextual depth. -/
def Step (base : BasePremiseEvaluator) (lang : LanguageDef)
    (source target : Pattern) : Prop :=
  ∃ fuel, StepAt base lang fuel source target

/-- If no authored rule matches the source, the least contextual relation has
no step from that source.  Contextual premises cannot grant authority before
the enclosing rule itself matches. -/
theorem not_step_of_matchPatternForRule_eq_nil
    {base : BasePremiseEvaluator} {lang : LanguageDef} {source target : Pattern}
    (noMatch : ∀ rule, rule ∈ lang.rewrites →
      matchPatternForRule lang rule source = []) :
    ¬ Step base lang source target := by
  rintro ⟨_, step⟩
  cases step with
  | @rule fuel source target rule initialBindings finalBindings
      ruleMember matchMember premiseEvidence targetEq =>
      rw [noMatch rule ruleMember] at matchMember
      exact List.not_mem_nil matchMember

/-! ## Compiler correctness -/

private theorem mem_premiseStepUsing_iff
    {base : BasePremiseEvaluator} {lang : LanguageDef} {fuel : Nat}
    {recursiveStep : Pattern → List Pattern}
    (recursiveExact : ∀ {source target},
      target ∈ recursiveStep source ↔ StepAt base lang fuel source target)
    {bindings result : Bindings} {premise : Premise} :
    result ∈ premiseStepUsing base lang recursiveStep bindings premise ↔
      PremiseAt base lang fuel bindings premise result := by
  cases premise with
  | freshness condition =>
      exact ⟨PremiseAt.freshness, fun evidence => by cases evidence; assumption⟩
  | relationQuery relation arguments =>
      exact ⟨PremiseAt.relationQuery, fun evidence => by cases evidence; assumption⟩
  | forAll collection parameter body =>
      exact ⟨PremiseAt.forAll, fun evidence => by cases evidence; assumption⟩
  | congruence source target =>
      constructor
      · intro member
        simp only [premiseStepUsing, List.mem_flatMap, List.mem_filterMap] at member
        obtain ⟨candidate, recursiveMember, premiseBindings,
          matchMember, merged⟩ := member
        exact .congruence (recursiveExact.mp recursiveMember) matchMember merged
      · intro evidence
        cases evidence with
        | congruence recursive matchMember merged =>
            simp only [premiseStepUsing, List.mem_flatMap, List.mem_filterMap]
            exact ⟨_, recursiveExact.mpr recursive, _, matchMember, merged⟩

private theorem mem_premisesUsing_iff
    {base : BasePremiseEvaluator} {lang : LanguageDef} {fuel : Nat}
    {recursiveStep : Pattern → List Pattern}
    (recursiveExact : ∀ {source target},
      target ∈ recursiveStep source ↔ StepAt base lang fuel source target)
    {premises : List Premise} {initial final : Bindings} :
    final ∈ premisesUsing base lang recursiveStep premises initial ↔
      PremisesAt base lang fuel initial premises final := by
  induction premises generalizing initial final with
  | nil =>
      simp only [premisesUsing, List.mem_singleton]
      constructor
      · intro equal
        subst final
        exact .nil initial
      · intro evidence
        cases evidence
        rfl
  | cons premise premises ih =>
      simp only [premisesUsing, List.mem_flatMap]
      constructor
      · rintro ⟨middle, first, rest⟩
        exact .cons ((mem_premiseStepUsing_iff recursiveExact).mp first)
          ((ih (initial := middle) (final := final)).mp rest)
      · intro evidence
        cases evidence with
        | cons first rest =>
            exact ⟨_, (mem_premiseStepUsing_iff recursiveExact).mpr first,
              (ih (initial := _) (final := final)).mpr rest⟩

/-- Exact bounded compiler theorem. -/
theorem mem_rewriteAt_iff_stepAt
    {base : BasePremiseEvaluator} {lang : LanguageDef} {fuel : Nat}
    {source target : Pattern} :
    target ∈ rewriteAt base lang fuel source ↔
      StepAt base lang fuel source target := by
  induction fuel generalizing source target with
  | zero =>
      constructor
      · intro member
        cases member
      · intro step
        cases step
  | succ fuel ih =>
      simp only [rewriteAt]
      constructor
      · intro member
        rw [List.mem_flatMap] at member
        obtain ⟨rule, ruleMember, ruleResult⟩ := member
        unfold applyRuleUsing at ruleResult
        rw [List.mem_flatMap] at ruleResult
        obtain ⟨initialBindings, matched, finalResult⟩ := ruleResult
        rw [List.mem_map] at finalResult
        obtain ⟨finalBindings, premises, targetEq⟩ := finalResult
        exact .rule ruleMember matched
          ((mem_premisesUsing_iff (fun {_ _} => ih)).mp premises) targetEq
      · intro step
        cases step with
        | rule ruleMember matched premises targetEq =>
            rw [List.mem_flatMap]
            refine ⟨_, ruleMember, ?_⟩
            unfold applyRuleUsing
            rw [List.mem_flatMap]
            refine ⟨_, matched, ?_⟩
            rw [List.mem_map]
            exact ⟨_,
              (mem_premisesUsing_iff (fun {_ _} => ih)).mpr premises, targetEq⟩

/-! ## Monotonicity -/

/-- Rule-set inclusion preserves a bounded contextual derivation when the two
languages share their reflective presentation. -/
theorem StepAt.mono_rules
    {lang₁ lang₂ : LanguageDef}
    (rulesMono : ∀ rule, rule ∈ lang₁.rewrites → rule ∈ lang₂.rewrites)
    (presentationsEq :
      lang₁.reflectivePresentations = lang₂.reflectivePresentations)
    {relEnv : RelationEnv} {fuel : Nat} {source target : Pattern}
    (evidence : StepAt (engineBasePremises relEnv) lang₁ fuel source target) :
    StepAt (engineBasePremises relEnv) lang₂ fuel source target := by
  induction fuel generalizing source target with
  | zero => cases evidence
  | succ fuel inductionHypothesis =>
      have premiseMono :
          ∀ {initial final : Bindings} {premise : Premise},
            PremiseAt (engineBasePremises relEnv) lang₁ fuel
                initial premise final →
              PremiseAt (engineBasePremises relEnv) lang₂ fuel
                initial premise final := by
        intro initial final premise premiseEvidence
        cases premiseEvidence with
        | freshness member =>
            exact .freshness (by
              simpa [engineBasePremises] using
                (premiseStepWithEnv_mono rulesMono relEnv initial
                  (.freshness _) final member))
        | relationQuery member =>
            exact .relationQuery (by
              simpa [engineBasePremises] using
                (premiseStepWithEnv_mono rulesMono relEnv initial
                  (.relationQuery _ _) final member))
        | forAll member =>
            exact .forAll (by
              simpa [engineBasePremises] using
                (premiseStepWithEnv_mono rulesMono relEnv initial
                  (.forAll _ _ _) final member))
        | congruence recursive matched merged =>
            exact .congruence (inductionHypothesis recursive) matched merged
      have premisesMono :
          ∀ {initial final : Bindings} {premises : List Premise},
            PremisesAt (engineBasePremises relEnv) lang₁ fuel
                initial premises final →
              PremisesAt (engineBasePremises relEnv) lang₂ fuel
                initial premises final := by
        intro initial final premises premiseEvidence
        induction premises generalizing initial final with
        | nil =>
            cases premiseEvidence
            exact .nil initial
        | cons premise premises inductionHypothesis =>
            cases premiseEvidence with
            | cons first rest =>
                exact .cons (premiseMono first) (inductionHypothesis rest)
      cases evidence with
      | rule ruleMember matched premises targetEq =>
          have matched₂ := matched
          rw [matchPatternForRule_eq_of_presentations_eq presentationsEq] at matched₂
          have targetEq₂ := targetEq
          rw [applyBindingsForRule_eq_of_presentations_eq presentationsEq] at targetEq₂
          exact .rule (rulesMono _ ruleMember) matched₂
            (premisesMono premises) targetEq₂

/-- Rule-set inclusion preserves the least contextual relation when the two
languages share their reflective presentation. -/
theorem Step.mono_rules
    {lang₁ lang₂ : LanguageDef}
    (rulesMono : ∀ rule, rule ∈ lang₁.rewrites → rule ∈ lang₂.rewrites)
    (presentationsEq :
      lang₁.reflectivePresentations = lang₂.reflectivePresentations)
    {relEnv : RelationEnv} {source target : Pattern}
    (evidence : Step (engineBasePremises relEnv) lang₁ source target) :
    Step (engineBasePremises relEnv) lang₂ source target := by
  obtain ⟨fuel, bounded⟩ := evidence
  exact ⟨fuel, bounded.mono_rules rulesMono presentationsEq⟩

/-- Enlarging a relation environment preserves a bounded contextual
derivation. -/
theorem StepAt.mono_relEnv
    {relEnv₁ relEnv₂ : RelationEnv} (envMono : relEnv₁ ≤ relEnv₂)
    {lang : LanguageDef} {fuel : Nat} {source target : Pattern}
    (evidence : StepAt (engineBasePremises relEnv₁) lang fuel source target) :
    StepAt (engineBasePremises relEnv₂) lang fuel source target := by
  induction fuel generalizing source target with
  | zero => cases evidence
  | succ fuel inductionHypothesis =>
      have premiseMono :
          ∀ {initial final : Bindings} {premise : Premise},
            PremiseAt (engineBasePremises relEnv₁) lang fuel
                initial premise final →
              PremiseAt (engineBasePremises relEnv₂) lang fuel
                initial premise final := by
        intro initial final premise premiseEvidence
        cases premiseEvidence with
        | freshness member =>
            exact .freshness (by
              simpa [engineBasePremises] using
                (premiseStepWithEnv_mono_relEnv envMono initial
                  (.freshness _) final member))
        | relationQuery member =>
            exact .relationQuery (by
              simpa [engineBasePremises] using
                (premiseStepWithEnv_mono_relEnv envMono initial
                  (.relationQuery _ _) final member))
        | forAll member =>
            exact .forAll (by
              simpa [engineBasePremises] using
                (premiseStepWithEnv_mono_relEnv envMono initial
                  (.forAll _ _ _) final member))
        | congruence recursive matched merged =>
            exact .congruence (inductionHypothesis recursive) matched merged
      have premisesMono :
          ∀ {initial final : Bindings} {premises : List Premise},
            PremisesAt (engineBasePremises relEnv₁) lang fuel
                initial premises final →
              PremisesAt (engineBasePremises relEnv₂) lang fuel
                initial premises final := by
        intro initial final premises premiseEvidence
        induction premises generalizing initial final with
        | nil =>
            cases premiseEvidence
            exact .nil initial
        | cons premise premises inductionHypothesis =>
            cases premiseEvidence with
            | cons first rest =>
                exact .cons (premiseMono first) (inductionHypothesis rest)
      cases evidence with
      | rule ruleMember matched premises targetEq =>
          exact .rule ruleMember matched (premisesMono premises) targetEq

/-- Enlarging a relation environment preserves the least contextual
relation. -/
theorem Step.mono_relEnv
    {relEnv₁ relEnv₂ : RelationEnv} (envMono : relEnv₁ ≤ relEnv₂)
    {lang : LanguageDef} {source target : Pattern}
    (evidence : Step (engineBasePremises relEnv₁) lang source target) :
    Step (engineBasePremises relEnv₂) lang source target := by
  obtain ⟨fuel, bounded⟩ := evidence
  exact ⟨fuel, bounded.mono_relEnv envMono⟩

/-! ## Non-contextual premise compatibility -/

private theorem flatMap_premisesUsing_engineBase_zero_eq_foldl
    (relEnv : RelationEnv) (lang : LanguageDef)
    (premises : List Premise) (seeds : List Bindings) :
    seeds.flatMap (premisesUsing (engineBasePremises relEnv) lang
      (rewriteAt (engineBasePremises relEnv) lang 0) premises) =
      premises.foldl
        (fun accumulated premise =>
          accumulated.flatMap fun bindings =>
            premiseStepWithEnv relEnv lang bindings premise)
        seeds := by
  induction premises generalizing seeds with
  | nil => simp [premisesUsing]
  | cons premise premises inductionHypothesis =>
      cases premise <;>
        simp only [premisesUsing, premiseStepUsing, engineBasePremises,
          rewriteAt, List.foldl_cons] <;>
        rw [← List.flatMap_assoc] <;>
        exact inductionHypothesis _

/-- At contextual depth zero, recursive congruence is unavailable, so the
new premise interpreter agrees with the established root-premise evaluator
for every premise list. -/
theorem premisesUsing_engineBase_zero_eq_applyPremisesWithEnv
    (relEnv : RelationEnv) (lang : LanguageDef)
    (premises : List Premise) (initial : Bindings) :
    premisesUsing (engineBasePremises relEnv) lang
        (rewriteAt (engineBasePremises relEnv) lang 0) premises initial =
      applyPremisesWithEnv relEnv lang premises initial := by
  have agreement := flatMap_premisesUsing_engineBase_zero_eq_foldl
    relEnv lang premises [initial]
  simpa [applyPremisesWithEnv] using agreement

/-- With one unit of contextual fuel, the authored-rule compiler is exactly
the established root-only premise-aware executor. -/
theorem rewriteAt_one_eq_rewriteStepWithPremisesUsing
    (relEnv : RelationEnv) (lang : LanguageDef) (term : Pattern) :
    rewriteAt (engineBasePremises relEnv) lang 1 term =
      rewriteStepWithPremisesUsing relEnv lang term := by
  simp only [rewriteAt, rewriteStepWithPremisesUsing]
  apply List.flatMap_congr
  intro rule _ruleMember
  simp only [applyRuleUsing, applyRuleWithPremisesUsing]
  apply List.flatMap_congr
  intro initialBindings _matched
  apply congrArg (List.map fun finalBindings =>
    applyBindingsForRule lang rule finalBindings)
  change premisesUsing (engineBasePremises relEnv) lang
      (rewriteAt (engineBasePremises relEnv) lang 0)
      rule.premises initialBindings = _
  exact premisesUsing_engineBase_zero_eq_applyPremisesWithEnv
    relEnv lang rule.premises initialBindings

/-- A premise list whose interpretation does not recursively invoke the
language step relation. -/
inductive NoncontextualPremises : List Premise → Prop where
  | nil : NoncontextualPremises []
  | freshness {condition premises} :
      NoncontextualPremises premises →
      NoncontextualPremises (.freshness condition :: premises)
  | relationQuery {relation arguments premises} :
      NoncontextualPremises premises →
      NoncontextualPremises (.relationQuery relation arguments :: premises)
  | forAll {collection parameter body premises} :
      NoncontextualPremises premises →
      NoncontextualPremises (.forAll collection parameter body :: premises)

private theorem flatMap_premisesUsing_engineBase_eq_foldl
    (relEnv : RelationEnv) (lang : LanguageDef)
    (recursiveStep : Pattern → List Pattern)
    {premises : List Premise}
    (noncontextual : NoncontextualPremises premises)
    (seeds : List Bindings) :
    seeds.flatMap (premisesUsing (engineBasePremises relEnv) lang
      recursiveStep premises) =
      premises.foldl
        (fun accumulated premise =>
          accumulated.flatMap fun bindings =>
            premiseStepWithEnv relEnv lang bindings premise)
        seeds := by
  induction noncontextual generalizing seeds with
  | nil => simp [premisesUsing]
  | freshness rest inductionHypothesis =>
      simp only [premisesUsing, premiseStepUsing, engineBasePremises,
        List.foldl_cons]
      rw [← List.flatMap_assoc]
      exact inductionHypothesis _
  | relationQuery rest inductionHypothesis =>
      simp only [premisesUsing, premiseStepUsing, engineBasePremises,
        List.foldl_cons]
      rw [← List.flatMap_assoc]
      exact inductionHypothesis _
  | forAll rest inductionHypothesis =>
      simp only [premisesUsing, premiseStepUsing, engineBasePremises,
        List.foldl_cons]
      rw [← List.flatMap_assoc]
      exact inductionHypothesis _

/-- On non-contextual premise lists, the new interpreter agrees exactly with
the established base-premise evaluator. -/
theorem premisesUsing_engineBase_eq_applyPremisesWithEnv
    (relEnv : RelationEnv) (lang : LanguageDef)
    (recursiveStep : Pattern → List Pattern)
    {premises : List Premise}
    (noncontextual : NoncontextualPremises premises)
    (initial : Bindings) :
    premisesUsing (engineBasePremises relEnv) lang recursiveStep
        premises initial =
      applyPremisesWithEnv relEnv lang premises initial := by
  have agreement := flatMap_premisesUsing_engineBase_eq_foldl
    relEnv lang recursiveStep noncontextual [initial]
  simpa [applyPremisesWithEnv] using agreement

/-- Relational form of non-contextual premise compatibility. -/
theorem premisesAt_engineBase_iff_mem_applyPremisesWithEnv
    {relEnv : RelationEnv} {lang : LanguageDef} {fuel : Nat}
    {premises : List Premise} (noncontextual : NoncontextualPremises premises)
    {initial final : Bindings} :
    PremisesAt (engineBasePremises relEnv) lang fuel initial premises final ↔
      final ∈ applyPremisesWithEnv relEnv lang premises initial := by
  rw [← premisesUsing_engineBase_eq_applyPremisesWithEnv
    relEnv lang (rewriteAt (engineBasePremises relEnv) lang fuel)
    noncontextual initial]
  exact (mem_premisesUsing_iff
    (fun {_ _} => mem_rewriteAt_iff_stepAt)).symm

/-- A root rule application with all base-premise evidence made explicit. -/
def RootStep (relEnv : RelationEnv) (lang : LanguageDef)
    (source target : Pattern) : Prop :=
  ∃ rule ∈ lang.rewrites,
    ∃ initialBindings ∈ matchPatternForRule lang rule source,
      ∃ finalBindings ∈
        applyPremisesWithEnv relEnv lang rule.premises initialBindings,
        applyBindingsForRule lang rule finalBindings = target

/-- A matched authored rule with non-contextual premises generates a step of
the least contextual relation. -/
theorem step_of_rule
    {relEnv : RelationEnv} {lang : LanguageDef}
    {rule : RewriteRule} {source target : Pattern}
    {initialBindings finalBindings : Bindings}
    (ruleMember : rule ∈ lang.rewrites)
    (matched : initialBindings ∈ matchPatternForRule lang rule source)
    (noncontextual : NoncontextualPremises rule.premises)
    (premises : finalBindings ∈
      applyPremisesWithEnv relEnv lang rule.premises initialBindings)
    (targetEq : applyBindingsForRule lang rule finalBindings = target) :
    Step (engineBasePremises relEnv) lang source target := by
  exact ⟨1, .rule ruleMember matched
    ((premisesAt_engineBase_iff_mem_applyPremisesWithEnv
      (fuel := 0) noncontextual).mpr premises)
    targetEq⟩

/-- An authored rule with exactly one contextual premise generates a step
when the premise source takes a step and the premise target matches its
result.  This is the basic derived-context introduction rule used by
language-specific contextual schemas. -/
theorem step_of_single_congruence_rule
    {base : BasePremiseEvaluator} {lang : LanguageDef}
    {rule : RewriteRule} {source target : Pattern}
    {initialBindings finalBindings premiseBindings : Bindings}
    {premiseSource premiseTarget candidate : Pattern}
    (ruleMember : rule ∈ lang.rewrites)
    (matched : initialBindings ∈ matchPatternForRule lang rule source)
    (premisesEq : rule.premises =
      [.congruence premiseSource premiseTarget])
    (recursive : Step base lang
      (applyBindings initialBindings premiseSource) candidate)
    (premiseMatched : premiseBindings ∈ matchPattern premiseTarget candidate)
    (merged : mergeBindings initialBindings premiseBindings =
      some finalBindings)
    (targetEq : applyBindingsForRule lang rule finalBindings = target) :
    Step base lang source target := by
  obtain ⟨fuel, recursiveAt⟩ := recursive
  have premiseEvidence :
      PremisesAt base lang fuel initialBindings rule.premises finalBindings := by
    rw [premisesEq]
    exact .cons (.congruence recursiveAt premiseMatched merged)
      (.nil finalBindings)
  exact ⟨fuel + 1, .rule ruleMember matched premiseEvidence targetEq⟩

/-- If every authored rule has only base premises, the least contextual
relation is exactly root rule application. -/
theorem step_iff_rootStep_of_noncontextualRules
    {relEnv : RelationEnv} {lang : LanguageDef} {source target : Pattern}
    (rulesNoncontextual : ∀ rule, rule ∈ lang.rewrites →
      NoncontextualPremises rule.premises) :
    Step (engineBasePremises relEnv) lang source target ↔
      RootStep relEnv lang source target := by
  constructor
  · rintro ⟨_, step⟩
    cases step with
    | rule ruleMember matched premises targetEq =>
        exact ⟨_, ruleMember, _, matched, _,
          (premisesAt_engineBase_iff_mem_applyPremisesWithEnv
            (rulesNoncontextual _ ruleMember)).mp premises,
          targetEq⟩
  · rintro ⟨rule, ruleMember, initialBindings, matched,
      finalBindings, premises, targetEq⟩
    exact ⟨1, .rule ruleMember matched
      ((premisesAt_engineBase_iff_mem_applyPremisesWithEnv
        (fuel := 0) (rulesNoncontextual _ ruleMember)).mpr premises)
      targetEq⟩

/-- Executable membership at some finite fuel is exactly the least relation. -/
theorem exists_mem_rewriteAt_iff_step
    {base : BasePremiseEvaluator} {lang : LanguageDef}
    {source target : Pattern} :
    (∃ fuel, target ∈ rewriteAt base lang fuel source) ↔
      Step base lang source target := by
  simp only [Step]
  constructor
  · rintro ⟨fuel, member⟩
    exact ⟨fuel, mem_rewriteAt_iff_stepAt.mp member⟩
  · rintro ⟨fuel, step⟩
    exact ⟨fuel, mem_rewriteAt_iff_stepAt.mpr step⟩

end Mettapedia.OSLF.MeTTaIL.ContextualStep
