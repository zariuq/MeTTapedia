import Mettapedia.OSLF.Syntax.Presentation
import Mettapedia.GSLT.Core.ProofRelevantGSLT

/-!
# Semantic and proof-relevant views of unconditional scoped presentations

The bare presentation gives an extensional GSLT at each closed sort and a
proof-relevant event fibre retaining the rule occurrence, matching context,
closing substitution and equation representatives. The latter erases exactly
to the former. Conditional authored premises remain a separate boundary.
-/

namespace Mettapedia.OSLF.Binding

set_option autoImplicit false

variable {S : Signature}

namespace UnpositionedRewrite

/-- Data of one root firing, including its chosen substitutions. -/
structure RootFiring {M : List (MetaArity S)}
    (rule : UnpositionedRewrite (withMetas S M))
    (source target : Term S [] rule.sort) where
  body : (i : Fin M.length) → Term S (M.get i).1 (M.get i).2
  close : Sub S rule.ctx []
  source_eq : bind close (instantiate body rule.lhs) = source
  target_eq : bind close (instantiate body rule.rhs) = target

/-- Data of an occurrence under one explicit linear context. -/
structure StepFiring {M : List (MetaArity S)}
    (rule : UnpositionedRewrite (withMetas S M))
    {s : S.Srt} (source target : Term S [] s) where
  context : Term S [rule.sort] s
  redex : Term S [] rule.sort
  reduct : Term S [] rule.sort
  linear : holeCount context = 1
  root : RootFiring rule redex reduct
  source_eq : inst context redex = source
  target_eq : inst context reduct = target

/-- An equation-closed occurrence retains the representatives and the
underlying context and substitutions. Equation proofs themselves are `Prop`.
They can be made proof relevant separately if histories observe their routes. -/
structure EquationClosedFiring {M : List (MetaArity S)}
    (equations : List (EqAxiom S M))
    (rule : UnpositionedRewrite (withMetas S M))
    {s : S.Srt} (source target : Term S [] s) where
  source' : Term S [] s
  target' : Term S [] s
  before : EqClosure equations source source'
  firing : StepFiring rule source' target'
  after : EqClosure equations target' target

/-- Forget an occurrence's data to the equation-closed proposition. -/
theorem EquationClosedFiring.toStepModE {M : List (MetaArity S)}
    {equations : List (EqAxiom S M)}
    {rule : UnpositionedRewrite (withMetas S M)}
    {s : S.Srt} {source target : Term S [] s}
    (firing : EquationClosedFiring equations rule source target) :
    rule.StepModE equations source target := by
  obtain ⟨source', target', before,
    ⟨context, redex, reduct, linear,
      ⟨body, close, rootSource, rootTarget⟩, contextSource, contextTarget⟩,
    after⟩ := firing
  exact ⟨source', target', before,
    ⟨context, redex, reduct, linear,
      ⟨body, close, rootSource, rootTarget⟩, contextSource, contextTarget⟩,
    after⟩

/-- Every equation-closed proposition has an occurrence witness. This asserts
inhabitation, not uniqueness of the witness. -/
theorem stepModE_hasFiring {M : List (MetaArity S)}
    {equations : List (EqAxiom S M)}
    {rule : UnpositionedRewrite (withMetas S M)}
    {s : S.Srt} {source target : Term S [] s}
    (step : rule.StepModE equations source target) :
    Nonempty (EquationClosedFiring equations rule source target) := by
  obtain ⟨source', target', before,
    ⟨context, redex, reduct, linear,
      ⟨body, close, rootSource, rootTarget⟩, contextSource, contextTarget⟩,
    after⟩ := step
  exact ⟨⟨source', target', before,
    ⟨context, redex, reduct, linear,
      ⟨body, close, rootSource, rootTarget⟩, contextSource, contextTarget⟩,
    after⟩⟩

end UnpositionedRewrite

namespace UnpositionedPresentation

/-- Each closed sort has a proposition-valued semantic GSLT. The underlying
presentation remains sorted and proof-relevant rule occurrences must be kept
separately when a consumer observes them. -/
def toExtensionalGSLTAt (presentation : UnpositionedPresentation S)
    (sort : S.Srt) : Mettapedia.GSLT.GSLT where
  Term := Term S [] sort
  equations :=
    { r := EqClosure presentation.eqs
      iseqv :=
        { refl := EqClosure.refl
          symm := EqClosure.symm
          trans := EqClosure.trans } }
  rewrites := presentation.StepModE
  rewrites_resp_left := by
    intro source source' target equivalent step
    exact ⟨target,
      presentation.stepModE_resp_left (EqClosure.symm equivalent) step,
      EqClosure.refl target⟩
  rewrites_resp_right := by
    intro source target target' step equivalent
    exact presentation.stepModE_resp_right step equivalent

/-- The proof-relevant graph generated by authored unconditional rules.
The rule index, context, chosen instance, and equation representatives survive
erasure to the extensional semantic GSLT. -/
def stepEvidenceAt (presentation : UnpositionedPresentation S)
    (sort : S.Srt) :
    Mettapedia.GSLT.ProofRelevant.StepEvidence
      (presentation.toExtensionalGSLTAt sort) where
  Evidence := fun source target =>
    Sigma fun i : Fin presentation.rules.length =>
      UnpositionedRewrite.EquationClosedFiring presentation.eqs
        (presentation.rules.get i) source target
  erases_iff := by
    intro source target
    constructor
    · rintro ⟨⟨i, firing⟩⟩
      exact ⟨i, firing.toStepModE⟩
    · rintro ⟨i, step⟩
      obtain ⟨firing⟩ := UnpositionedRewrite.stepModE_hasFiring step
      exact ⟨⟨i, firing⟩⟩

/-- Equations alone identify terms but cannot create an operational step. -/
theorem no_step_of_empty_rules (presentation : UnpositionedPresentation S)
    (empty : presentation.rules = []) {s : S.Srt}
    (source target : Term S [] s) :
    ¬ (presentation.toExtensionalGSLTAt s).Step source target := by
  rintro ⟨i, _⟩
  have impossible : i.val < 0 := by simpa [empty] using i.isLt
  omega

end UnpositionedPresentation

end Mettapedia.OSLF.Binding
