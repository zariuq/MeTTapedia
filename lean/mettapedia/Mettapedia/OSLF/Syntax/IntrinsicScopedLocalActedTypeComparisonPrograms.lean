import Mettapedia.OSLF.Syntax.IntrinsicScopedLocalActedTypeComparisonTransport
import Mettapedia.OSLF.Syntax.SecondOrderEquationClassArrows
import Mettapedia.OSLF.Syntax.CategoricalContextualEquationSoundness

/-!
# Program points and contextual binding-clone interpretations

The selected function objects represent metavariable values at every stage.
The contextual equation quotient is generated by those values together with
the authored operators and substitution.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Binding.IntrinsicScopedLocalActedTypeComparison

open _root_.CategoryTheory
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open Mettapedia.OSLF.Binding.CategoricalBindingModel
open Mettapedia.OSLF.Binding.SecondOrderContext
open Mettapedia.OSLF.Binding.BindingEquationInterpretation
open Mettapedia.OSLF.Binding.BindingEquationalModels
open Mettapedia.OSLF.Binding.FreeBindingTerms
open Mettapedia.OSLF.Binding.IntrinsicScopedLocalActedClassifier (Base modelAt)

universe u v

variable {D : Type u} [Category.{v} D] [CartesianMonoidalCategory D]
variable {S : Signature} {schema : List (MetaArity S)}
variable {equations : List (EqAxiom S schema)}

namespace ProgramPoints

variable (P : Model S D)

/-- A list of generalized metavariable values is represented by its tuple. -/
def ofValues (N : List (MetaArity S)) {Z : D} (values : MetaValuation (P.stage Z) N) :
    Z ⟶ P.family N :=
  P.familyLift N (fun i => P.elemEquiv (values i))

/-- The contextual generators of the equation quotient. -/
noncomputable def generators (X : Base equations) : MetaValuation (modelAt equations X) X.as.arities :=
  fun i => termClass equations (metaVar (M := X.as.arities) i)

/-- Interpreting a contextual generator recovers its component in the tuple. -/
theorem pointProgram_generator (sat : P.Satisfies (authoredEquationPresentation S equations))
    (X : Base equations) {Z : D} (x : Z ⟶ P.family X.as.arities)
    (i : Fin X.as.arities.length) :
    (P.pointProgram _ sat X.as x).raw.map (generators X i) =
      P.elemOfPoint (x ≫ P.familyProj X.as.arities i) :=
  P.restageElem_interp_metaVar X.as.arities x i

theorem pointProgram_ofValues_generator
    (sat : P.Satisfies (authoredEquationPresentation S equations))
    (N : List (MetaArity S)) {Z : D} (values : MetaValuation (P.stage Z) N)
    (i : Fin N.length) :
    (P.pointProgram _ sat ⟨N⟩ (ofValues P N values)).raw.map
        (generators (equations := equations) ⟨⟨N⟩⟩ i) = values i := by
  rw [pointProgram_generator]
  exact (congrArg P.elemOfPoint (P.familyLift_proj N _ i)).trans (P.elemEquiv.left_inv _)

mutual

theorem instantiate_generators (X : Object S) :
    ∀ {Γ : Ctx S} {s : S.Srt} (t : Term (withMetas S X.arities) Γ s),
      instantiate (S := withMetas S X.arities) (fun i => metaVar (M := X.arities) i)
        (liftSchema (M := X.arities) X t) = t
  | _, _, .var _ => rfl
  | _, _, .op (.inl o) args => by
      change Term.op (S := withMetas S X.arities) (Sum.inl o)
        (instantiateArgs _ (liftSchemaArgs X args)) = _
      rw [instantiate_generators_args X args]
  | _, _, .op (.inr (.mk i)) args => by
      change bind (argsToSub (instantiateArgs _ (liftSchemaArgs X args))) (metaVar i) = _
      rw [instantiate_generators_args X args]
      simp only [metaVar, bind, bindArgs_argsToSub_idArgs]

theorem instantiate_generators_args (X : Object S) :
    ∀ {Γ : Ctx S} {arity : List (List S.Srt × S.Srt)}
      (args : Args (withMetas S X.arities) arity Γ),
      instantiateArgs (S := withMetas S X.arities) (fun i => metaVar (M := X.arities) i)
        (liftSchemaArgs (M := X.arities) X args) = args
  | _, _, .nil => rfl
  | _, _, .cons head tail => congrArg₂ Args.cons
      (instantiate_generators X head) (instantiate_generators_args X tail)

end

private theorem ambientArgs_toSyntax (X : Object S) :
    ∀ {Γ : Ctx S} {arity : List (List S.Srt × S.Srt)}
      (args : FamilyArgs S (termAlgebra X).substitution.Carrier arity Γ),
      (FreeBindingTerms.terms.familyToSyntax (withMetas S X.arities))
        (toAmbientArgs X args) = toSyntax X args
  | _, _, .nil => rfl
  | _, _, .cons _ tail => congrArg _ (ambientArgs_toSyntax X tail)

/-- The contextual term model maps to its actual equation quotient. -/
noncomputable def quotientMap (X : Base equations) :
    FreeBindingClone.Hom (termAlgebra X.as) (modelAt equations X) where
  raw :=
    { map := fun t => termClass equations t
      map_variable := by intros; rfl
      map_operation := by
        intro Γ s o args
        have valid := (BindingEquationQuotientModel.projection
          ((authoredEquationPresentation S equations).axioms X.as)).raw.map_operation
            (Sum.inl o) (toAmbientArgs X.as args)
        change termClass equations (Term.op (Sum.inl o)
          ((FreeBindingTerms.terms.familyToSyntax (withMetas S X.as.arities))
            (toAmbientArgs X.as args))) =
          (BindingEquationQuotientModel.algebra
            ((authoredEquationPresentation S equations).axioms X.as)).operation (Sum.inl o)
              (FamilyArgs.map (fun {Γ s} t => termClass equations t) (toAmbientArgs X.as args)) at valid
        rw [ambientArgs_toSyntax X.as args] at valid
        exact valid.trans (congrArg _ (toAmbientArgs_map X.as
          (fun {Γ s} t => termClass equations t) args).symm) }
  map_substitute := (BindingEquationQuotientModel.projection
    ((authoredEquationPresentation S equations).axioms X.as)).map_substitute

/-- A contextual equation-class term is its schema interpreted at the
context's generators. -/
theorem schema_generators (X : Base equations) {Γ : Ctx S} {s : S.Srt}
    (t : Term (withMetas S X.as.arities) Γ s) :
    interpretSchema (modelAt equations X) (generators X) t = termClass equations t := by
  have valid := interpretSchema_map (quotientMap X)
    (fun i => metaVar (M := X.as.arities) i) t
  have identity := (interpretSchema_liftSchema X.as
    (fun i => metaVar (M := X.as.arities) i) t).trans (instantiate_generators X.as t)
  have valid' := (congrArg (quotientMap X).raw.map identity).symm.trans valid
  exact valid'.symm

/-- A clone interpretation of a contextual quotient is determined by its
metavariable components. This includes noninvertible interpretations. -/
theorem hom_ext {A : BindingCloneAlgebra.Algebra.{v} S} (X : Base equations)
    {f g : FreeBindingClone.Hom (modelAt equations X) A}
    (same : ∀ i, f.raw.map (generators X i) = g.raw.map (generators X i)) : f = g := by
  apply FreeBindingClone.Hom.ext
  apply FreeBindingTerms.Hom.ext
  intro Γ s q
  induction q using Quotient.inductionOn with
  | _ t =>
      change f.raw.map (termClass equations t) = g.raw.map (termClass equations t)
      have first := (congrArg f.raw.map (schema_generators X t).symm).trans
        (interpretSchema_map f (generators X) t)
      have second := (congrArg g.raw.map (schema_generators X t).symm).trans
        (interpretSchema_map g (generators X) t)
      rw [first, second]
      congr 1
      funext i
      exact same i

/-- Every contextual interpretation is represented by its metavariable tuple. -/
theorem pointProgram_ofValues
    (sat : P.Satisfies (authoredEquationPresentation S equations))
    (X : Base equations) {Z : D} (h : FreeBindingClone.Hom (modelAt equations X) (P.stage Z)) :
    P.pointProgram _ sat X.as (ofValues P X.as.arities (fun i => h.raw.map (generators X i))) = h := by
  apply hom_ext X
  intro i
  exact pointProgram_ofValues_generator P sat X.as.arities _ i

/-- Program points and all contextual binding-clone interpretations agree. -/
noncomputable def interpretationEquiv
    (sat : P.Satisfies (authoredEquationPresentation S equations)) (X : Base equations) (Z : D) :
    (Z ⟶ P.family X.as.arities) ≃ FreeBindingClone.Hom (modelAt equations X) (P.stage Z) where
  toFun x := P.pointProgram _ sat X.as x
  invFun h := ofValues P X.as.arities (fun i => h.raw.map (generators X i))
  left_inv x := by
    symm
    apply P.familyLift_unique X.as.arities
    intro i
    change x ≫ P.familyProj X.as.arities i =
      P.elemEquiv ((P.pointProgram _ sat X.as x).raw.map (generators X i))
    symm
    rw [pointProgram_generator]
    exact P.elemEquiv.right_inv _
  right_inv h := pointProgram_ofValues P sat X h

/-- All contextual semantic equation instances hold in every
generalized-element clone, with arbitrary ambient and ordinary values. -/
theorem stageSatisfies (sat : P.Satisfies (authoredEquationPresentation S equations)) (Z : D) :
    BindingEquationInterpretation.Satisfies (P.stage Z) equations :=
  P.stage_satisfies equations sat Z

end ProgramPoints

namespace CarrierTransport

variable (A : BindingCloneAlgebra.Algebra.{u} S)
variable {F : Ctx S → S.Srt → Type v}
variable (e : ∀ Γ s, A.substitution.Carrier Γ s ≃ F Γ s)

/-- Equation satisfaction crosses a contextwise carrier equivalence. -/
theorem satisfies (sat : BindingEquationInterpretation.Satisfies A equations) :
    BindingEquationInterpretation.Satisfies (algebra A e) equations := by
  intro i Θ Γ values ambient ordinary
  have valid := mapped_equation_instance (forward A e) sat i
    (fun k => (e _ _).symm (values k))
    (fun s v => (e _ s).symm (ambient s v))
    (fun s v => (e _ s).symm (ordinary s v))
  have metas : SemanticContextualMetavariables.mapValuation (forward A e)
      (fun k => (e _ _).symm (values k)) = values := by
    funext k
    exact Equiv.apply_symm_apply _ _
  have ambientValues : (fun s v => (forward A e).raw.map ((e _ s).symm (ambient s v))) = ambient := by
    funext s v
    exact Equiv.apply_symm_apply _ _
  have ordinaryValues : (fun s v => (forward A e).raw.map ((e _ s).symm (ordinary s v))) = ordinary := by
    funext s v
    exact Equiv.apply_symm_apply _ _
  rw [metas, ambientValues, ordinaryValues] at valid
  exact valid

end CarrierTransport

end Mettapedia.OSLF.Binding.IntrinsicScopedLocalActedTypeComparison
