import Mathlib.Algebra.BigOperators.Group.Multiset.Basic

/-!
# Independently authored associative, commutative and unit Cut equations

Closed first-order terms retain arbitrary opaque payloads. The actual equation
relation is generated by local congruence, associativity, commutativity and the
unit law. Only after forming that quotient do we prove that complete payload
multisets classify its terms, retaining multiplicities and every payload value.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.CommutativeCut

universe u

inductive Term (Payload : Type u) where
  | zero
  | atom (payload : Payload)
  | cut (left right : Term Payload)

variable {Payload : Type u}

inductive Equation : Term Payload → Term Payload → Prop where
  | refl (term) : Equation term term
  | symm {first second} : Equation first second → Equation second first
  | trans {first second third} : Equation first second → Equation second third → Equation first third
  | congr {first first' second second'} : Equation first first' → Equation second second' →
      Equation (.cut first second) (.cut first' second')
  | assoc (first second third) : Equation (.cut (.cut first second) third) (.cut first (.cut second third))
  | comm (first second) : Equation (.cut first second) (.cut second first)
  | unit (term) : Equation (.cut term .zero) term

def equationSetoid (Payload : Type u) : Setoid (Term Payload) where
  r := Equation
  iseqv := ⟨Equation.refl, Equation.symm, Equation.trans⟩

abbrev Class (Payload : Type u) := Quotient (equationSetoid Payload)

def classOf (term : Term Payload) : Class Payload := Quotient.mk _ term

def inventory : Term Payload → Multiset Payload
  | .zero => 0
  | .atom payload => {payload}
  | .cut first second => inventory first + inventory second

def Term.map {Target : Type*} (payload : Payload → Target) : Term Payload → Term Target
  | .zero => .zero
  | .atom value => .atom (payload value)
  | .cut first second => .cut (first.map payload) (second.map payload)

theorem inventory_map {Target : Type*} (payload : Payload → Target) (term : Term Payload) :
    inventory (term.map payload) = (inventory term).map payload := by
  induction term with
  | zero => rfl
  | atom => rfl
  | cut first second firstIH secondIH =>
    simp only [Term.map, inventory, firstIH, secondIH, Multiset.map_add]

theorem Equation.inventory {first second : Term Payload} (equation : Equation first second) :
    inventory first = inventory second := by
  induction equation with
  | refl => rfl
  | symm _ inductionHypothesis => exact inductionHypothesis.symm
  | trans _ _ first second => exact first.trans second
  | congr _ _ first second => exact congrArg₂ (· + ·) first second
  | assoc first second third => exact add_assoc _ _ _
  | comm first second => exact add_comm _ _
  | unit term => exact add_zero _

def inventoryQ : Class Payload → Multiset Payload :=
  Quotient.lift inventory (fun _ _ equation => equation.inventory)

instance classZero : Zero (Class Payload) := ⟨classOf .zero⟩

instance classAdd : Add (Class Payload) :=
  ⟨Quotient.map₂ Term.cut (fun _ _ first _ _ second => Equation.congr first second)⟩

instance classAddCommMonoid : AddCommMonoid (Class Payload) where
  add_assoc a b c := Quotient.inductionOn₃ a b c (fun a b c => Quotient.sound (Equation.assoc a b c))
  zero_add a := Quotient.inductionOn a (fun a =>
    Quotient.sound ((Equation.comm .zero a).trans (Equation.unit a)))
  add_zero a := Quotient.inductionOn a (fun a => Quotient.sound (Equation.unit a))
  add_comm a b := Quotient.inductionOn₂ a b (fun a b => Quotient.sound (Equation.comm a b))
  nsmul := nsmulRec

@[simp] theorem classOf_zero : classOf (Term.zero : Term Payload) = 0 := rfl

@[simp] theorem classOf_cut (first second : Term Payload) :
    classOf (.cut first second) = classOf first + classOf second := rfl

@[simp] theorem inventoryQ_classOf (term : Term Payload) : inventoryQ (classOf term) = inventory term := rfl

@[simp] theorem inventoryQ_zero : inventoryQ (0 : Class Payload) = 0 := rfl

@[simp] theorem inventoryQ_add (first second : Class Payload) :
    inventoryQ (first + second) = inventoryQ first + inventoryQ second := by
  exact Quotient.inductionOn₂ first second (fun _ _ => rfl)

def inventoryHom : Class Payload →+ Multiset Payload where
  toFun := inventoryQ
  map_zero' := inventoryQ_zero
  map_add' := inventoryQ_add

def fromInventory (supplied : Multiset Payload) : Class Payload :=
  (supplied.map (fun payload => classOf (.atom payload))).sum

@[simp] theorem fromInventory_zero : fromInventory (0 : Multiset Payload) = 0 := rfl

theorem fromInventory_add (first second : Multiset Payload) :
    fromInventory (first + second) = fromInventory first + fromInventory second := by
  simp only [fromInventory, Multiset.map_add, Multiset.sum_add]

@[simp] theorem fromInventory_singleton (payload : Payload) : fromInventory {payload} = classOf (.atom payload) := by
  simp [fromInventory]

theorem inventoryQ_fromInventory (supplied : Multiset Payload) :
    inventoryQ (fromInventory supplied) = supplied := by
  induction supplied using Multiset.induction_on with
  | empty => rfl
  | cons head tail inductionHypothesis =>
    rw [← Multiset.singleton_add, fromInventory_add, inventoryQ_add,
      fromInventory_singleton, inventoryQ_classOf, inductionHypothesis]
    rfl

theorem fromInventory_inventory (term : Term Payload) :
    fromInventory (inventory term) = classOf term := by
  induction term with
  | zero => rfl
  | atom payload => exact fromInventory_singleton payload
  | cut first second firstIH secondIH =>
    rw [inventory, fromInventory_add, firstIH, secondIH, classOf_cut]

def inventoryEquiv : Class Payload ≃+ Multiset Payload where
  toFun := inventoryQ
  invFun := fromInventory
  left_inv value := Quotient.inductionOn value (fun term => fromInventory_inventory term)
  right_inv := inventoryQ_fromInventory
  map_add' := inventoryQ_add

theorem equation_iff_inventory (first second : Term Payload) :
    Equation first second ↔ inventory first = inventory second := by
  refine ⟨Equation.inventory, fun same => ?_⟩
  have whole : classOf first = classOf second := inventoryEquiv.injective same
  exact Quotient.exact whole

theorem classOf_eq_iff (first second : Term Payload) :
    classOf first = classOf second ↔ Equation first second := by
  constructor
  · intro same
    exact Quotient.exact same
  · intro equation
    exact Quotient.sound equation

end Mettapedia.OSLF.CommutativeCut
