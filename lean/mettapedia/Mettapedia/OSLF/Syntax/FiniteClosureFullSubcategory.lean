import Mathlib.CategoryTheory.ObjectProperty.ColimitsClosure
import Mathlib.CategoryTheory.Limits.FullSubcategory

/-!
# Generated closures inside their full subcategories

If an object property is generated by specified colimits, then its full
subcategory is generated by the original objects using the same colimits.
The comparison retains the cocone presentations rather than using an
unproved identification of ambient and internal colimits.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Binding

open CategoryTheory CategoryTheory.Limits

universe u v t u' v'

variable {C : Type u} [Category.{v} C]
variable {α : Type t} (J : α → Type u') [∀ a, Category.{v'} (J a)]
variable (P : ObjectProperty C)

/-- The original generators, regarded as a property of the full subcategory
of objects generated under the specified colimits. -/
def originalGeneratorsInColimitsClosure :
    ObjectProperty (P.colimitsClosure J).FullSubcategory :=
  fun X => P X.1

/-- Every object of the generated full subcategory is internally generated
by the original property, with its original diagram shapes. -/
theorem colimitsClosure_generated_in_fullSubcategory
    (X : (P.colimitsClosure J).FullSubcategory) :
    (originalGeneratorsInColimitsClosure J P).colimitsClosure J X := by
  let Q := P.colimitsClosure J
  let R := (originalGeneratorsInColimitsClosure J P).colimitsClosure J
  have hgen : ∀ {Y : C} (hY : Q Y), R ⟨Y, hY⟩ := by
    intro Y hY
    induction hY with
    | of_mem Y hPY =>
        exact ObjectProperty.le_colimitsClosure _ _ _ hPY
    | of_isoClosure e hY ih =>
        exact R.prop_of_iso (Q.isoMk e) ih
    | @of_colimitPresentation Y a pres h ih =>
        let F : J a ⥤ Q.FullSubcategory := Q.lift pres.diag h
        let c : Cocone F :=
          { pt := ⟨Y, ObjectProperty.colimitsClosure.of_colimitPresentation pres h⟩
            ι := { app := fun j => ⟨pres.ι.app j⟩
                   naturality := by intros; apply Q.hom_ext; exact pres.ι.naturality _ } }
        have hc : IsColimit c := by
          have hmap : IsColimit (Q.ι.mapCocone c) := by
            change IsColimit pres.cocone
            exact pres.isColimit
          haveI : CreatesColimit F Q.ι :=
            createsColimitFullSubcategoryInclusion' F hmap
              (ObjectProperty.colimitsClosure.of_colimitPresentation pres h)
          exact isColimitOfReflects Q.ι hmap
        exact R.prop_of_isColimit hc ih
  exact hgen X.property

/-- Restriction of a generator property to an independently specified full
subcategory of the same ambient category. -/
def originalGeneratorsInFullSubcategory (Q : ObjectProperty C) :
    ObjectProperty Q.FullSubcategory :=
  fun X => P X.1

/-- The same result for any property proved equal to the generated closure.
This form supports full subcategories defined independently of a chosen
generation theorem. -/
theorem colimitsClosure_generated_in_fullSubcategory_of_eq
    (Q : ObjectProperty C) (hQ : Q = P.colimitsClosure J)
    (X : Q.FullSubcategory) :
    (originalGeneratorsInFullSubcategory P Q).colimitsClosure J X := by
  subst Q
  exact colimitsClosure_generated_in_fullSubcategory J P X

end Mettapedia.OSLF.Binding
