import Mettapedia.OSLF.Syntax.IndexedRulePolynomialMorphisms
import Mettapedia.TypeTheory.IndexedPolynomialFree

/-!
# Transporting free rule trees with typed event generators

A cartesian map of indexed rule polynomials extends to trees with typed
leaves. The leaf map is independent data, while every authored constructor
and recursive premise position is transported by the rule map. This is the
free-on-generators transport required when operational models have events
not generated by rules alone.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Binding.IndexedRuleFreeTransport

open Mettapedia.TypeTheory
open Mettapedia.OSLF.Binding.IndexedRulePolynomialMorphisms

universe uBase uIndex uOtherIndex uLastIndex uShape uPosition
  uOtherShape uOtherPosition uLastShape uLastPosition
  uHole uOtherHole uLastHole

variable {Base : Type uBase}
variable {I : Base → Type uIndex} {J : Base → Type uOtherIndex}
variable {P : IndexedPolynomial.{uBase, uIndex, uShape, uPosition} Base I}
variable {Q : IndexedPolynomial.{uBase, uOtherIndex, uOtherShape, uOtherPosition} Base J}
variable {f : ∀ b, I b → J b}
variable {H : (b : Base) → I b → Type uHole}
variable {K : (b : Base) → J b → Type uOtherHole}

/-- Map both authored constructors and typed event leaves. A rule position
is transported by the original cartesian position equivalence; leaves have
no recursive positions. -/
def withHolesMap (h : Hom P Q f)
    (leaf : ∀ b i, H b i → K b (f b i)) :
    Hom (P.withHoles H) (Q.withHoles K) f where
  onShape b i
    | .inl seed => .inl (leaf b i seed)
    | .inr shape => .inr (h.onShape b i shape)
  onPosition b i
    | .inl _ =>
        { toFun := fun position => position.elim
          invFun := fun position => position.elim
          left_inv := by intro position; exact position.elim
          right_inv := by intro position; exact position.elim }
    | .inr shape => h.onPosition b i shape
  onNext := by
    intro b i shape position
    cases shape with
    | inl seed => exact position.elim
    | inr rule => exact h.onNext b i rule position

/-- A map of rule presentations and a map of event generators determine
the transport of every finite firing tree with its original positions. -/
noncomputable def mapFree (h : Hom P Q f)
    (leaf : ∀ b i, H b i → K b (f b i)) :
    ∀ b i, P.Free H b i → Q.Free K b (f b i) :=
  (withHolesMap h leaf).mapFix

/-- The leaf case is exactly the given map of event generators. -/
theorem mapFree_pure (h : Hom P Q f)
    (leaf : ∀ b i, H b i → K b (f b i))
    {b : Base} {i : I b} (seed : H b i) :
    mapFree h leaf b i (IndexedPolynomial.Free.pure P seed) =
      IndexedPolynomial.Free.pure Q (leaf b i seed) := by
  change @IndexedPolynomial.Fix.roll Base J (Q.withHoles K) b (f b i)
      (Sum.inl (leaf b i seed)) _ =
    @IndexedPolynomial.Fix.roll Base J (Q.withHoles K) b (f b i)
      (Sum.inl (leaf b i seed)) _
  congr 1
  funext position
  exact position.elim

/-- The constructor case retains the authored rule shape and transports
every recursive premise through the original position equivalence. -/
theorem mapFree_node (h : Hom P Q f)
    (leaf : ∀ b i, H b i → K b (f b i))
    {b : Base} {i : I b} (shape : P.Shape b i)
    (children : ∀ position, P.Free H b (P.next shape position)) :
    mapFree h leaf b i (IndexedPolynomial.Free.node P shape children) =
      IndexedPolynomial.Free.node Q (h.onShape b i shape)
        (fun position => (h.onNext b i shape position).symm ▸
          mapFree h leaf b _ (children ((h.onPosition b i shape) position))) := by
  rfl

/-- Identity interpretation fixes every free tree, including its leaves
and all recursive constructor positions. -/
theorem mapFree_id
    (P : IndexedPolynomial.{uBase, uIndex, uShape, uPosition} Base I)
    (H : (b : Base) → I b → Type uHole)
    (b : Base) (i : I b) (tree : P.Free H b i) :
    mapFree (Hom.id P)
      (fun (b : Base) (i : I b) (seed : H b i) => seed) b i tree = tree := by
  induction tree with
  | roll shape children ih =>
      cases shape with
      | inl seed =>
          have empty : children = fun position => position.elim := by
            funext position
            exact position.elim
          subst children
          simpa only [IndexedPolynomial.Free.pure] using
            (mapFree_pure (Hom.id P)
              (fun (b : Base) (i : I b) (seed : H b i) => seed) seed)
      | inr shape =>
          change (position : P.Position shape) →
            P.Free H b (P.next shape position) at children
          change ∀ position : P.Position shape,
            mapFree (Hom.id P)
              (fun (b : Base) (i : I b) (seed : H b i) => seed)
                b (P.next shape position) (children position) = children position at ih
          change mapFree (Hom.id P)
              (fun (b : Base) (i : I b) (seed : H b i) => seed)
                b _ (IndexedPolynomial.Free.node P shape children) =
              IndexedPolynomial.Free.node P shape children
          rw [mapFree_node]
          congr 1
          funext position
          exact ih position

section Composition

variable {L : Base → Type uLastIndex}
variable {R : IndexedPolynomial.{uBase, uLastIndex, uLastShape, uLastPosition}
  Base L}
variable {g : ∀ b, J b → L b}
variable {T : (b : Base) → L b → Type uLastHole}

theorem withHolesMap_comp
    (first : Hom P Q f) (second : Hom Q R g)
    (firstLeaf : ∀ b i, H b i → K b (f b i))
    (secondLeaf : ∀ b j, K b j → T b (g b j)) :
    withHolesMap (Hom.comp first second)
        (fun b i seed => secondLeaf b (f b i) (firstLeaf b i seed)) =
      Hom.comp (withHolesMap first firstLeaf)
        (withHolesMap second secondLeaf) := by
  apply Hom.ext
  · funext b i shape
    cases shape <;> rfl
  · refine Function.hfunext rfl ?_
    intro b b' hb
    cases eq_of_heq hb
    refine Function.hfunext rfl ?_
    intro i i' hi
    cases eq_of_heq hi
    refine Function.hfunext rfl ?_
    intro shape shape' hs
    cases eq_of_heq hs
    cases shape with
    | inl seed =>
        apply heq_of_eq
        apply Equiv.ext
        intro position
        exact position.elim
    | inr rule =>
        apply heq_of_eq
        apply Equiv.ext
        intro position
        rfl

/-- Transporting authored constructors and event generators in two stages
agrees with their composite transport. -/
theorem mapFree_comp
    (first : Hom P Q f) (second : Hom Q R g)
    (firstLeaf : ∀ b i, H b i → K b (f b i))
    (secondLeaf : ∀ b j, K b j → T b (g b j))
    (b : Base) (i : I b) (tree : P.Free H b i) :
    mapFree (Hom.comp first second)
        (fun b i seed => secondLeaf b (f b i) (firstLeaf b i seed))
        b i tree =
      mapFree second secondLeaf b (f b i)
        (mapFree first firstLeaf b i tree) := by
  unfold mapFree
  rw [withHolesMap_comp]
  exact Hom.mapFix_comp (withHolesMap first firstLeaf)
    (withHolesMap second secondLeaf) b i tree

end Composition

end Mettapedia.OSLF.Binding.IndexedRuleFreeTransport
