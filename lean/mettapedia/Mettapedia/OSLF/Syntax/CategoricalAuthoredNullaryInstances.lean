import Mettapedia.OSLF.Syntax.CategoricalAuthoredNullaryFree
import Mettapedia.OSLF.Syntax.IntrinsicLambdaFourRulePresentation
import Mettapedia.OSLF.Syntax.RhoPayloadPresentation

/-!
# Authored rules at the nullary polynomial boundary

Communication, explicit drop, and lambda beta have no recursive premise.
Their firing occurrence is generated by one parameter assignment. Lambda
and parallel congruence have recursive premises and require the full free
polynomial construction; their event graphs cannot be generated by the
nullary construction.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Binding.CategoricalAuthoredNullaryInstances

open _root_.CategoryTheory
open _root_.CategoryTheory.Limits
open Mettapedia.OSLF.Binding.CategoricalBindingModel
open Mettapedia.OSLF.Binding.CategoricalAuthoredRuleInterpretation
open Mettapedia.OSLF.Binding.CategoricalAuthoredNullaryFree

universe u v
variable {D : Type u} [Category.{v} D] [CartesianMonoidalCategory D]
  [MonoidalClosed D] [HasPullbacks D]

theorem rho_comm_is_nullary :
    RhoPayloadPresentation.comm =
      nullaryRule RhoPayloadPresentation.comm.conclusion := rfl

theorem rho_drop_is_nullary :
    RhoPayloadPresentation.drop =
      nullaryRule RhoPayloadPresentation.drop.conclusion := rfl

theorem lambda_beta_is_nullary :
    IntrinsicLambdaFourRulePresentation.beta =
      nullaryRule IntrinsicLambdaFourRulePresentation.beta.conclusion := rfl

theorem rho_parallel_congruence_has_premise :
    RhoPayloadPresentation.parCong.premises ≠ [] := by
  decide

theorem lambda_binder_congruence_has_premise :
    IntrinsicLambdaFourRulePresentation.lamCong.premises ≠ [] := by
  decide

/-- Communication is freely generated, as an individual event for each
authored parameter assignment, over any fixed rho binding interpretation. -/
noncomputable def rhoCommIsInitial
    (M : Model RhoPayloadPresentation.sig D) (P : ProgramCarrier M) :
    IsInitial (freeNullary M P RhoPayloadPresentation.comm.conclusion :
      OperationalModel M P [RhoPayloadPresentation.comm]) :=
  freeNullaryIsInitial M P RhoPayloadPresentation.comm.conclusion

/-- The book's explicit drop event has the same nullary universal property;
this does not assert that the strict-core profile contains Drop. -/
noncomputable def rhoDropIsInitial
    (M : Model RhoPayloadPresentation.sig D) (P : ProgramCarrier M) :
    IsInitial (freeNullary M P RhoPayloadPresentation.drop.conclusion :
      OperationalModel M P [RhoPayloadPresentation.drop]) :=
  freeNullaryIsInitial M P RhoPayloadPresentation.drop.conclusion

/-- Lambda beta is a generated event, even when the target category's
function object satisfies its own currying equations. -/
noncomputable def lambdaBetaIsInitial
    (M : Model LambdaContextualRung.sig D)
    (P : ProgramCarrier M) :
    IsInitial (freeNullary M P IntrinsicLambdaFourRulePresentation.beta.conclusion :
      OperationalModel M P [IntrinsicLambdaFourRulePresentation.beta]) :=
  freeNullaryIsInitial M P IntrinsicLambdaFourRulePresentation.beta.conclusion

end Mettapedia.OSLF.Binding.CategoricalAuthoredNullaryInstances
