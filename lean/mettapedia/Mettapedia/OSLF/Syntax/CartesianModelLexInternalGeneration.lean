import Mettapedia.OSLF.Syntax.FiniteClosureFullSubcategory
import Mettapedia.OSLF.Syntax.CartesianModelLexGenerationDual
import Mettapedia.OSLF.Syntax.CartesianModelLexUniqueness

/-!
# Internal finite-limit generation of relative cartesian presentations

The ambient strong-generator theorem is transported through the full
subcategory of finitely presented models. Opposites then turn its internal
finite colimits into finite limits of the relative object category. This
closes the generation premise of the arbitrary-target uniqueness theorem;
constructing arbitrary-target extensions remains a distinct obligation.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.CartesianContextModels

open CategoryTheory CategoryTheory.Limits
open Mettapedia.OSLF.Binding

universe u v

variable (C : Type) [SmallCategory C] [HasFiniteProducts C]

attribute [local instance] Cardinal.fact_isRegular_aleph0

/-- Every finitely presented model is generated by authored context models
using finite colimits *inside* the full subcategory of finitely presented
models. -/
theorem finitePresentedModels_in_internalColimitClosure
    (M : FinitelyPresentedModels C) :
    (originalGeneratorsInFullSubcategory (authoredContexts C)
      (isCardinalPresentable.{0} (Models C) Cardinal.aleph0.{0})).colimitsClosure
        (SmallCategoryCardinalLT.categoryFamily Cardinal.aleph0.{0}) M :=
  colimitsClosure_generated_in_fullSubcategory_of_eq
    (SmallCategoryCardinalLT.categoryFamily Cardinal.aleph0.{0})
    (authoredContexts C)
    (isCardinalPresentable.{0} (Models C) Cardinal.aleph0.{0})
    (finiteModels_eq_authoredContexts_closure C) M

/-- The opposite of an internal authored generator is an authored context
object in the relative finite-limit category. -/
theorem internalGeneratorOp_le_authoredContext :
    (originalGeneratorsInFullSubcategory (authoredContexts C)
      (isCardinalPresentable.{0} (Models C) Cardinal.aleph0.{0})).op ≤
      ObjectProperty.ofObj (authoredContext C).obj := by
  intro X hX
  change authoredContexts C X.unop.1 at hX
  obtain ⟨Y, hY⟩ := (ObjectProperty.ofObj_iff _ _).1 hX
  have hfinite : (representedFiniteModel C).obj Y = X.unop := by
    apply ObjectProperty.FullSubcategory.ext
    exact hY
  apply (ObjectProperty.ofObj_iff _ _).2
  refine ⟨Y.unop, ?_⟩
  simpa [authoredContext] using congrArg Opposite.op hfinite

/-- Every object of the relative finite-presentation category lies in the
elementary finite-limit closure of the authored contexts. -/
theorem finitePresentationObjects_authoredFiniteLimitGenerated
    (X : FinitePresentationObjects C) :
    AuthoredFiniteLimitClosure C X := by
  let J := SmallCategoryCardinalLT.categoryFamily Cardinal.aleph0.{0}
  let G := originalGeneratorsInFullSubcategory (authoredContexts C)
    (isCardinalPresentable.{0} (Models C) Cardinal.aleph0.{0})
  have hinternal : (G.colimitsClosure J).op X :=
    finitePresentedModels_in_internalColimitClosure C X.unop
  rw [op_colimitsClosure_eq_limitsClosure] at hinternal
  have hbase : G.op ≤ ObjectProperty.ofObj (authoredContext C).obj :=
    internalGeneratorOp_le_authoredContext C
  have hall :
      (ObjectProperty.ofObj (authoredContext C).obj).limitsClosure
        (fun a : SmallCategoryCardinalLT Cardinal.aleph0.{0} =>
          (SmallCategoryCardinalLT.categoryFamily Cardinal.aleph0.{0} a)ᵒᵖ) X :=
    ObjectProperty.limitsClosure_monotone _ hbase X hinternal
  exact allFiniteLimitClosure_le_authoredFiniteLimitClosure C X hall

/-- Restriction of interpretations is faithful for every finitely complete
target: equality of maps on authored contexts forces equality on all relative
finite presentations. -/
theorem restrictLeftExactTarget_faithful
    (D : Type u) [Category.{v} D] [HasFiniteLimits D] :
    (restrictLeftExactTarget C D).Faithful := by
  constructor
  intro T U α β h
  apply ObjectProperty.hom_ext
  ext X
  apply transformation_eq_on_authoredFiniteLimitClosure C D T U α β
  · intro Y
    have hh := congrArg
      (fun f : (restrictLeftExactTarget C D).obj T ⟶
          (restrictLeftExactTarget C D).obj U => f.hom.app Y) h
    change α.hom.app ((authoredContext C).obj Y) =
      β.hom.app ((authoredContext C).obj Y) at hh
    exact hh
  · exact finitePresentationObjects_authoredFiniteLimitGenerated C X

end Mettapedia.OSLF.CartesianContextModels
