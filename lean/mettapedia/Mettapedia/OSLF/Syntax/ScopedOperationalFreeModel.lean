import Mettapedia.OSLF.Syntax.ScopedOperationalPresentation
import Mettapedia.OSLF.Syntax.IndexedOperationalPresentationCategory

/-!
# Free operational model of the fixed scoped rule presentation

The finite conditional-rule skeleton determines an indexed polynomial.
Its free algebra interprets each shape as a constructor with one proof
branch per listed recursive child. The relative hom equivalence is the
universal property of this exact polynomial. It is not yet the combined
binding-equation/function/event classifier of Finding Mind Chapter 7.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Binding.ScopedOperationalFreeModel

open _root_.CategoryTheory
open Mettapedia.TypeTheory
open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.Engine
open Mettapedia.OSLF.MeTTaIL.ScopedPremiseExecution
open Mettapedia.OSLF.Binding.ScopedRuleConstructorFrame
open Mettapedia.OSLF.Binding.ScopedOperationalPresentation
open Mettapedia.OSLF.Binding.IndexedRulePresentationCategory
open Mettapedia.OSLF.Binding.IndexedOperationalPresentationCategory

/-- The actual fixed polynomial induced by admitted authored conditional
rules, including premise-local binder contexts and ordered child positions. -/
def authoredRules (relEnv : RelationEnv) (lang : LanguageDef) :
    Presentation Unit where
  Judgment := fun _ => Judgment
  rules := (presentation relEnv lang).polynomial

/-- The least proof-relevant model generated by these scoped rule shapes. -/
def freeAuthoredRules (relEnv : RelationEnv) (lang : LanguageDef) :
    Equipped Unit :=
  free (authoredRules relEnv lang)

/-- A judgment predicate is closed under each admitted authored conditional
rule skeleton when it contains all of that skeleton's scoped children. -/
def AuthoredRuleClosed (relEnv : RelationEnv) (lang : LanguageDef)
    (predicate : Judgment → Prop) : Prop :=
  (presentation relEnv lang).RuleClosed (fun _ => predicate)

/-- The free derivations are the least relation closed under the exact
finite list of recursive judgments in each authored skeleton. -/
theorem derivation_least (relEnv : RelationEnv) (lang : LanguageDef)
    (predicate : Judgment → Prop)
    (closed : AuthoredRuleClosed relEnv lang predicate)
    (judgment : Judgment)
    (tree : (presentation relEnv lang).Derivation () judgment) :
    predicate judgment :=
  Mettapedia.OSLF.Binding.FiniteRulePremiseLists.FinitePresentation.derivation_least
    (presentation relEnv lang) (fun _ => predicate)
    closed () judgment tree

/-- No authored rule skeleton has a zero-fuel conclusion, hence the least
rule closure contains no zero-fuel derivation at any scoped endpoints. -/
theorem no_zero_fuel_derivation (relEnv : RelationEnv)
    (lang : LanguageDef) (ambient : Nat)
    (source target : Pattern) :
    ¬ Nonempty ((presentation relEnv lang).Derivation ()
      ⟨0, ambient, source, target⟩) := by
  have closed : AuthoredRuleClosed relEnv lang
      (fun judgment => judgment.fuel ≠ 0) := by
    intro _ judgment shape _
    cases judgment with
    | mk fuel ambient source target =>
        cases fuel with
        | zero => exact nomatch shape
        | succ previous => exact Nat.succ_ne_zero previous
  rintro ⟨tree⟩
  exact (derivation_least relEnv lang
    (fun judgment => judgment.fuel ≠ 0) closed
    ⟨0, ambient, source, target⟩ tree) rfl

/-- Interpreting the free scoped skeleton in any target rule algebra is
equivalent to interpreting its fixed authored rule presentation. -/
noncomputable def freeHomEquiv (relEnv : RelationEnv)
    (lang : LanguageDef) (target : Equipped Unit) :
    (freeAuthoredRules relEnv lang ⟶ target) ≃
      (authoredRules relEnv lang ⟶ target.presentation) :=
  IndexedOperationalPresentationCategory.freeHomEquiv
    (authoredRules relEnv lang) target

/-- An operational interpretation is uniquely determined by the authored
shape map it realizes, including the action on every recursive proof tree. -/
theorem interpretation_unique (relEnv : RelationEnv)
    (lang : LanguageDef) {target : Equipped Unit}
    (interpretation : freeAuthoredRules relEnv lang ⟶ target) :
    lift target interpretation.presentation = interpretation :=
  lift_unique interpretation

/-- Runtime evidence always yields a constructor of the free model's
polynomial at the matching bounded judgment. Supplying derivations for its
children, and comparing retained oracle ordinals, are separate obligations. -/
theorem runtime_has_constructor (relEnv : RelationEnv)
    (lang : LanguageDef) (fuel ambient : Nat)
    (source target : Pattern) (history : RuleHistory)
    (executed : (history, target) ∈
      Mettapedia.OSLF.MeTTaIL.ScopedPremiseExecution.rewriteAt
        relEnv lang (fuel + 1) ambient source) :
    Nonempty ((authoredRules relEnv lang).rules.Shape ()
      ⟨fuel + 1, ambient, source, target⟩) := by
  obtain ⟨shape, _⟩ := runtime_has_shape relEnv lang fuel ambient
    source target history executed
  exact ⟨shape⟩

/-- A concrete bounded execution builds a derivation in the free indexed
rule algebra. Every recursive branch is obtained from an actual oracle result
at its scoped child judgment. This existence theorem does not identify the
chosen child's history with the parent event, nor assert the converse: the
free signature permits constructor labels not selected by an oracle. -/
theorem runtime_to_free_derivation (relEnv : RelationEnv)
    (lang : LanguageDef) (fuel ambient : Nat)
    (source target : Pattern) (history : RuleHistory)
    (executed : (history, target) ∈
      rewriteAt relEnv lang fuel ambient source) :
    Nonempty ((presentation relEnv lang).Derivation ()
      ⟨fuel, ambient, source, target⟩) := by
  classical
  induction fuel generalizing ambient source target history with
  | zero =>
      simp [rewriteAt] at executed
  | succ previous inductionHypothesis =>
      obtain ⟨rule, ruleIndex, listedRule, firing, ⟨frame⟩,
          _, targetEq⟩ :=
        (mem_rewriteAt_succ_iff_frames relEnv lang previous ambient
          source target history).mp executed
      subst target
      let shape := RuleConstructorFrame.toSkeleton ruleIndex
        listedRule frame
      refine ⟨IndexedPolynomial.Fix.roll shape ?_⟩
      intro position
      have positionListed :
          ((presentation relEnv lang).premises ()
            ⟨previous + 1, ambient, source, firing.target⟩ shape).get
              position ∈
          (presentation relEnv lang).premises ()
            ⟨previous + 1, ambient, source, firing.target⟩ shape :=
        List.get_mem _ position
      change ((shape.children.map fun (child : Nat × Pattern × Pattern) =>
        (⟨previous, child.1, child.2.1, child.2.2⟩ : Judgment)).get
          position) ∈
        shape.children.map fun (child : Nat × Pattern × Pattern) =>
          (⟨previous, child.1, child.2.1, child.2.2⟩ : Judgment)
        at positionListed
      let listedWitness := List.mem_map.mp positionListed
      let child := Classical.choose listedWitness
      obtain ⟨childListed, childEq⟩ := Classical.choose_spec listedWitness
      let selectedWitness :=
        RuleConstructorFrame.toSkeleton_children_selected
          ruleIndex listedRule frame child childListed
      let childHistory := Classical.choose selectedWitness
      have childExecuted := Classical.choose_spec selectedWitness
      have childTree := inductionHypothesis child.1 child.2.1
        child.2.2 childHistory childExecuted
      change (presentation relEnv lang).Derivation ()
        ((shape.children.map fun (entry : Nat × Pattern × Pattern) =>
          (⟨previous, entry.1, entry.2.1, entry.2.2⟩ : Judgment)).get
            position)
      exact childEq ▸ Classical.choice childTree

end Mettapedia.OSLF.Binding.ScopedOperationalFreeModel
