import Mettapedia.OSLF.Syntax.BindingEquationExtension

/-!
# Finitary congruence generated by a small binding-equation family

A family may contain equations for every finite collection arity. Each
derivation nevertheless uses only a finite list of axioms. The congruence
below is the union of the established contextual equation closures over such
lists. Combining two derivations combines their finite lists; argument
contexts, including every declared binder prefix, remain unchanged.

The finite-list specialization agrees exactly with the existing closure.
This module supplies the relation and substitution contracts needed for a
quotient; it does not introduce a second language or claim a quotient model.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Binding.BindingEquationFamilyCongruence

open BindingEquationExtension

variable {S : Signature} {M : List (MetaArity S)}

def Supported (family : EqAxiom S M → Prop) (fragment : List (EqAxiom S M)) : Prop :=
  ∀ equation ∈ fragment, family equation

/-- The only axioms used by a derivation form one finite supported fragment. -/
def Related (family : EqAxiom S M → Prop)
    {Γ : Ctx S} {sort : S.Srt} (left right : Term S Γ sort) : Prop :=
  ∃ fragment, Supported family fragment ∧ EqClosure fragment left right

/-- Argument relations retain their original binder-extended contexts. -/
inductive RelatedArgs (family : EqAxiom S M → Prop) :
    {arity : List (List S.Srt × S.Srt)} → {Γ : Ctx S} →
      Args S arity Γ → Args S arity Γ → Prop where
  | nil {Γ : Ctx S} : RelatedArgs family (Args.nil (S := S) (Γ := Γ)) .nil
  | cons {binders : Ctx S} {sort : S.Srt}
      {arity : List (List S.Srt × S.Srt)} {Γ : Ctx S}
      {first second : Term S (binders ++ Γ) sort}
      {rest rest' : Args S arity Γ} :
      Related family first second → RelatedArgs family rest rest' →
        RelatedArgs family (.cons first rest) (.cons second rest')

/-- Literal list inclusion is sufficient; declaration order need not agree. -/
theorem axiomInclusion_of_subset {first second : List (EqAxiom S M)}
    (included : ∀ equation ∈ first, equation ∈ second) : AxiomInclusion first second := by
  intro i
  exact List.mem_iff_get.mp (included _ (List.get_mem first i))

/-- Reuse the established quotient soundness to transport a contextual
derivation along an axiom inclusion. No separate instantiation is defined. -/
theorem eqClosure_of_inclusion {first second : List (EqAxiom S M)}
    (included : AxiomInclusion first second)
    {Γ : Ctx S} {sort : S.Srt} {left right : Term S Γ sort}
    (relation : EqClosure first left right) : EqClosure second left right := by
  have satisfaction := satisfies_of_inclusion included
    (BindingEquationQuotientModel.algebra second)
    (BindingEquationQuotientModel.algebra_satisfies second)
  have interpreted := BindingEquationInterpretation.interpret_eqClosure
    (BindingEquationQuotientModel.algebra second) satisfaction relation
  rw [BindingEquationQuotientModel.interpret_eq_mk,
    BindingEquationQuotientModel.interpret_eq_mk] at interpreted
  exact Quotient.exact interpreted

theorem eqClosure_append_left (first second : List (EqAxiom S M))
    {Γ : Ctx S} {sort : S.Srt} {left right : Term S Γ sort}
    (relation : EqClosure first left right) : EqClosure (first ++ second) left right :=
  eqClosure_of_inclusion (axiomInclusion_of_subset (fun _ member =>
    List.mem_append_left _ member)) relation

theorem eqClosure_append_right (first second : List (EqAxiom S M))
    {Γ : Ctx S} {sort : S.Srt} {left right : Term S Γ sort}
    (relation : EqClosure second left right) : EqClosure (first ++ second) left right :=
  eqClosure_of_inclusion (axiomInclusion_of_subset (fun _ member =>
    List.mem_append_right _ member)) relation

theorem eqArgs_of_inclusion {first second : List (EqAxiom S M)}
    (included : AxiomInclusion first second) :
    ∀ {arity : List (List S.Srt × S.Srt)} {Γ : Ctx S}
      {left right : Args S arity Γ}, EqArgs first left right → EqArgs second left right
  | _, _, _, _, .nil => .nil
  | _, _, _, _, .cons head tail =>
      .cons (eqClosure_of_inclusion included head) (eqArgs_of_inclusion included tail)

theorem supported_append {family : EqAxiom S M → Prop}
    {first second : List (EqAxiom S M)}
    (firstSupported : Supported family first) (secondSupported : Supported family second) :
    Supported family (first ++ second) := by
  intro equation member
  exact (List.mem_append.mp member).elim (firstSupported equation) (secondSupported equation)

namespace Related

variable {family : EqAxiom S M → Prop}

theorem refl {Γ : Ctx S} {sort : S.Srt} (value : Term S Γ sort) :
    Related family value value :=
  ⟨[], (fun _ member => nomatch member), .refl value⟩

theorem symm {Γ : Ctx S} {sort : S.Srt} {left right : Term S Γ sort}
    (relation : Related family left right) : Related family right left := by
  obtain ⟨fragment, support, proof⟩ := relation
  exact ⟨fragment, support, .symm proof⟩

theorem trans {Γ : Ctx S} {sort : S.Srt} {first middle last : Term S Γ sort}
    (left : Related family first middle) (right : Related family middle last) :
    Related family first last := by
  obtain ⟨firstFragment, firstSupport, firstProof⟩ := left
  obtain ⟨secondFragment, secondSupport, secondProof⟩ := right
  exact ⟨firstFragment ++ secondFragment, supported_append firstSupport secondSupport,
    .trans (eqClosure_append_left _ _ firstProof)
      (eqClosure_append_right _ _ secondProof)⟩

theorem rename {Γ Δ : Ctx S} {sort : S.Srt} {left right : Term S Γ sort}
    (rho : Ren S Γ Δ) (relation : Related family left right) :
    Related family (Binding.rename rho left) (Binding.rename rho right) := by
  obtain ⟨fragment, support, proof⟩ := relation
  exact ⟨fragment, support, eqClosure_rename rho proof⟩

theorem bind {Γ Δ : Ctx S} {sort : S.Srt} {left right : Term S Γ sort}
    (environment : Sub S Γ Δ) (relation : Related family left right) :
    Related family (Binding.bind environment left) (Binding.bind environment right) := by
  obtain ⟨fragment, support, proof⟩ := relation
  exact ⟨fragment, support, eqClosure_bind environment proof⟩

end Related

/-- All finitely many argument proofs fit one supported fragment, including
heads whose variables live under different binder prefixes. -/
theorem relatedArgs_finite {family : EqAxiom S M → Prop} :
    ∀ {arity : List (List S.Srt × S.Srt)} {Γ : Ctx S}
      {first second : Args S arity Γ}, RelatedArgs family first second →
      ∃ fragment, Supported family fragment ∧ EqArgs fragment first second
  | _, _, _, _, .nil => ⟨[], (fun _ member => nomatch member), .nil⟩
  | _, _, _, _, .cons head tail => by
      obtain ⟨headFragment, headSupport, headProof⟩ := head
      obtain ⟨tailFragment, tailSupport, tailProof⟩ := relatedArgs_finite tail
      exact ⟨headFragment ++ tailFragment, supported_append headSupport tailSupport,
        .cons (eqClosure_append_left _ _ headProof)
          (eqArgs_of_inclusion (axiomInclusion_of_subset (fun _ member =>
            List.mem_append_right _ member)) tailProof)⟩

theorem Related.operation {family : EqAxiom S M → Prop}
    {Γ : Ctx S} {sort : S.Srt} (operator : S.Op sort)
    {first second : Args S (S.arity operator) Γ}
    (arguments : RelatedArgs family first second) :
    Related family (.op operator first) (.op operator second) := by
  obtain ⟨fragment, support, proof⟩ := relatedArgs_finite arguments
  exact ⟨fragment, support, .cong operator proof⟩

/-- A finite context's pointwise substitution comparisons also use only
finitely many family axioms. Repeated sorts retain distinct positions. -/
theorem environment_finite {family : EqAxiom S M → Prop} :
    ∀ {Γ Δ : Ctx S} (first second : Sub S Γ Δ),
      (∀ sort position, Related family (first sort position) (second sort position)) →
      ∃ fragment, Supported family fragment ∧
        ∀ sort position, EqClosure fragment (first sort position) (second sort position)
  | [], _, _, _, _ => ⟨[], (fun _ member => nomatch member),
      fun _ position => nomatch position⟩
  | sort :: Γ, Δ, first, second, agree => by
      obtain ⟨headFragment, headSupport, headProof⟩ := agree sort .zero
      obtain ⟨tailFragment, tailSupport, tailProof⟩ :=
        environment_finite (fun s v => first s (.succ v))
          (fun s v => second s (.succ v)) (fun s v => agree s (.succ v))
      refine ⟨headFragment ++ tailFragment, supported_append headSupport tailSupport, ?_⟩
      intro sort position
      cases position with
      | zero => exact eqClosure_append_left _ _ headProof
      | succ old => exact eqClosure_append_right _ _ (tailProof sort old)

theorem Related.bind_pointwise {family : EqAxiom S M → Prop}
    {Γ Δ : Ctx S} {sort : S.Srt} (first second : Sub S Γ Δ)
    (agree : ∀ type position, Related family (first type position) (second type position))
    (value : Term S Γ sort) :
    Related family (Binding.bind first value) (Binding.bind second value) := by
  obtain ⟨fragment, support, proof⟩ := environment_finite first second agree
  exact ⟨fragment, support, eqClosure_bind_pointwise first second proof value⟩

def setoid (family : EqAxiom S M → Prop) (Γ : Ctx S) (sort : S.Srt) :
    Setoid (Term S Γ sort) where
  r := Related family
  iseqv := ⟨Related.refl, Related.symm, Related.trans⟩

/-- Finite presentations are unchanged by passing to the family relation. -/
theorem related_mem_iff (equations : List (EqAxiom S M))
    {Γ : Ctx S} {sort : S.Srt} (left right : Term S Γ sort) :
    Related (fun equation => equation ∈ equations) left right ↔
      EqClosure equations left right := by
  constructor
  · rintro ⟨fragment, support, proof⟩
    exact eqClosure_of_inclusion (axiomInclusion_of_subset support) proof
  · intro proof
    exact ⟨equations, fun _ member => member, proof⟩

end Mettapedia.OSLF.Binding.BindingEquationFamilyCongruence
