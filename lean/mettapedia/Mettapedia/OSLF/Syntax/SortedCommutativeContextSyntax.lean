import Mettapedia.OSLF.Syntax.SortedCommutativeSyntaxProfile

/-!
# Independently authored one-hole sorted contexts and local equations

Raw contexts retain the selected free-constructor slot and every closed
sibling term. The two positions of the actual binary Cut are distinct raw
constructors. Their context equations are generated by local typed term
congruence, Cut commutativity, associativity and unit. Composition and filling
are defined independently and their compatibility is then proved.
-/

set_option autoImplicit false

noncomputable section

namespace Mettapedia.OSLF.SortedCommutative

open Mettapedia.OSLF.SortedConstructors

universe u v

variable (signature : Signature.{u,v}) (Parallel : signature.Srt → Prop)

inductive RawContext (holeSort : signature.Srt) : signature.Srt → Type (max u v) where
  | hole : RawContext holeSort holeSort
  | frame (constructor : signature.Constructor) (position : Fin (signature.arity constructor))
      (siblings : (other : Fin (signature.arity constructor)) → other ≠ position →
        Term signature Parallel (signature.input constructor other))
      (inner : RawContext holeSort (signature.input constructor position)) :
      RawContext holeSort (signature.output constructor)
  | left {sort} (parallel : Parallel sort) (inner : RawContext holeSort sort)
      (sibling : Term signature Parallel sort) : RawContext holeSort sort
  | right {sort} (parallel : Parallel sort) (sibling : Term signature Parallel sort)
      (inner : RawContext holeSort sort) : RawContext holeSort sort

variable {signature Parallel}

namespace RawContext

def insert (constructor : signature.Constructor) (position : Fin (signature.arity constructor))
    (siblings : (other : Fin (signature.arity constructor)) → other ≠ position →
      Term signature Parallel (signature.input constructor other))
    (value : Term signature Parallel (signature.input constructor position)) :
    (other : Fin (signature.arity constructor)) → Term signature Parallel (signature.input constructor other) :=
  fun other => if same : other = position then same.symm ▸ value else siblings other same

def fill {source target : signature.Srt} (value : Term signature Parallel source) :
    RawContext signature Parallel source target → Term signature Parallel target
  | .hole => value
  | .frame constructor position siblings inner => .node constructor (insert constructor position siblings (inner.fill value))
  | .left parallel inner sibling => .cut parallel (inner.fill value) sibling
  | .right parallel sibling inner => .cut parallel sibling (inner.fill value)

def comp {source middle target : signature.Srt} (inner : RawContext signature Parallel source middle) :
    RawContext signature Parallel middle target → RawContext signature Parallel source target
  | .hole => inner
  | .frame constructor position siblings outer => .frame constructor position siblings (inner.comp outer)
  | .left parallel outer sibling => .left parallel (inner.comp outer) sibling
  | .right parallel sibling outer => .right parallel sibling (inner.comp outer)

theorem fill_comp {source middle target : signature.Srt}
    (inner : RawContext signature Parallel source middle) (outer : RawContext signature Parallel middle target)
    (value : Term signature Parallel source) :
    (inner.comp outer).fill value = outer.fill (inner.fill value) := by
  induction outer with
  | hole => rfl
  | frame constructor position siblings outer inductionHypothesis =>
    exact congrArg (fun value => Term.node constructor (insert constructor position siblings value)) inductionHypothesis
  | left parallel outer sibling inductionHypothesis => exact congrArg (fun value => Term.cut parallel value sibling) inductionHypothesis
  | right parallel sibling outer inductionHypothesis => exact congrArg (Term.cut parallel sibling) inductionHypothesis

theorem identity_comp {source target : signature.Srt} (context : RawContext signature Parallel source target) :
    hole.comp context = context := by
  induction context with
  | hole => rfl
  | frame constructor position siblings _ inductionHypothesis =>
    exact congrArg (frame constructor position siblings) inductionHypothesis
  | left parallel _ sibling inductionHypothesis => exact congrArg (fun inner => left parallel inner sibling) inductionHypothesis
  | right parallel sibling _ inductionHypothesis => exact congrArg (right parallel sibling) inductionHypothesis

theorem comp_identity {source target : signature.Srt} (context : RawContext signature Parallel source target) :
    context.comp hole = context := rfl

theorem comp_assoc {first second third fourth : signature.Srt}
    (before : RawContext signature Parallel first second) (middle : RawContext signature Parallel second third)
    (after : RawContext signature Parallel third fourth) :
    (before.comp middle).comp after = before.comp (middle.comp after) := by
  induction after with
  | hole => rfl
  | frame constructor position siblings _ inductionHypothesis =>
    exact congrArg (frame constructor position siblings) inductionHypothesis
  | left parallel _ sibling inductionHypothesis => exact congrArg (fun inner => left parallel inner sibling) inductionHypothesis
  | right parallel sibling _ inductionHypothesis => exact congrArg (right parallel sibling) inductionHypothesis

end RawContext

inductive ContextEquation : {source target : signature.Srt} →
    RawContext signature Parallel source target → RawContext signature Parallel source target → Prop where
  | refl {source target} (context : RawContext signature Parallel source target) : ContextEquation context context
  | symm {source target} {first second : RawContext signature Parallel source target} :
      ContextEquation first second → ContextEquation second first
  | trans {source target} {first second third : RawContext signature Parallel source target} :
      ContextEquation first second → ContextEquation second third → ContextEquation first third
  | frame {source} (constructor : signature.Constructor) (position : Fin (signature.arity constructor))
      {firstSiblings secondSiblings : (other : Fin (signature.arity constructor)) → other ≠ position →
        Term signature Parallel (signature.input constructor other)}
      {first second : RawContext signature Parallel source (signature.input constructor position)} :
      (∀ other absent, Equation (firstSiblings other absent) (secondSiblings other absent)) →
      ContextEquation first second →
      ContextEquation (.frame constructor position firstSiblings first) (.frame constructor position secondSiblings second)
  | left {source target} (parallel : Parallel target)
      {first second : RawContext signature Parallel source target} {before after : Term signature Parallel target} :
      ContextEquation first second → Equation before after →
      ContextEquation (.left parallel first before) (.left parallel second after)
  | right {source target} (parallel : Parallel target)
      {before after : Term signature Parallel target} {first second : RawContext signature Parallel source target} :
      Equation before after → ContextEquation first second →
      ContextEquation (.right parallel before first) (.right parallel after second)
  | comm {source target} (parallel : Parallel target) (inner : RawContext signature Parallel source target)
      (sibling : Term signature Parallel target) :
      ContextEquation (.left parallel inner sibling) (.right parallel sibling inner)
  | assoc {source target} (parallel : Parallel target) (inner : RawContext signature Parallel source target)
      (first second : Term signature Parallel target) :
      ContextEquation (.left parallel (.left parallel inner first) second)
        (.left parallel inner (.cut parallel first second))
  | unit {source target} (parallel : Parallel target) (inner : RawContext signature Parallel source target) :
      ContextEquation (.left parallel inner (.zero parallel)) inner

theorem RawContext.fill_equation {source target : signature.Srt}
    (context : RawContext signature Parallel source target)
    {first second : Term signature Parallel source} (equation : Equation first second) :
    Equation (context.fill first) (context.fill second) := by
  induction context with
  | hole => exact equation
  | frame constructor position siblings _ inductionHypothesis =>
    apply Equation.node
    intro other
    by_cases same : other = position
    · subst other
      simpa only [RawContext.insert, dite_true] using inductionHypothesis
    · simpa only [RawContext.insert, dif_neg same] using Equation.refl (siblings other same)
  | left parallel _ sibling inductionHypothesis => exact Equation.cut parallel inductionHypothesis (Equation.refl sibling)
  | right parallel sibling _ inductionHypothesis => exact Equation.cut parallel (Equation.refl sibling) inductionHypothesis

theorem ContextEquation.fill {source target : signature.Srt}
    {first second : RawContext signature Parallel source target} (equation : ContextEquation first second)
    (value : Term signature Parallel source) : Equation (first.fill value) (second.fill value) := by
  induction equation with
  | refl => exact Equation.refl _
  | symm _ inductionHypothesis => exact inductionHypothesis.symm
  | trans _ _ first second => exact first.trans second
  | frame constructor position siblings _ inductionHypothesis =>
    apply Equation.node
    intro other
    by_cases same : other = position
    · subst other
      simpa only [RawContext.insert, dite_true] using inductionHypothesis
    · simpa only [RawContext.insert, dif_neg same] using siblings other same
  | left parallel _ sibling inner => exact Equation.cut parallel inner sibling
  | right parallel sibling _ inner => exact Equation.cut parallel sibling inner
  | comm parallel inner sibling => exact Equation.comm parallel (inner.fill value) sibling
  | assoc parallel inner first second => exact Equation.assoc parallel (inner.fill value) first second
  | unit parallel inner => exact Equation.unit parallel (inner.fill value)

theorem ContextEquation.comp_before {source middle target : signature.Srt}
    {first second : RawContext signature Parallel source middle}
    (equation : ContextEquation first second) (outer : RawContext signature Parallel middle target) :
    ContextEquation (first.comp outer) (second.comp outer) := by
  induction outer with
  | hole => exact equation
  | frame constructor position siblings _ inductionHypothesis =>
    exact .frame constructor position (fun other absent => .refl (siblings other absent)) inductionHypothesis
  | left parallel _ sibling inductionHypothesis => exact .left parallel inductionHypothesis (.refl sibling)
  | right parallel sibling _ inductionHypothesis => exact .right parallel (.refl sibling) inductionHypothesis

theorem ContextEquation.comp_after {source middle target : signature.Srt}
    (inner : RawContext signature Parallel source middle)
    {first second : RawContext signature Parallel middle target} (equation : ContextEquation first second) :
    ContextEquation (inner.comp first) (inner.comp second) := by
  induction equation with
  | refl => exact .refl _
  | symm _ inductionHypothesis => exact inductionHypothesis.symm
  | trans _ _ first second => exact first.trans second
  | frame constructor position siblings _ inductionHypothesis =>
    exact .frame constructor position siblings inductionHypothesis
  | left parallel _ sibling inductionHypothesis => exact .left parallel inductionHypothesis sibling
  | right parallel sibling _ inductionHypothesis => exact .right parallel sibling inductionHypothesis
  | comm parallel context sibling => exact .comm parallel (inner.comp context) sibling
  | assoc parallel context first second => exact .assoc parallel (inner.comp context) first second
  | unit parallel context => exact .unit parallel (inner.comp context)

theorem ContextEquation.comp {source middle target : signature.Srt}
    {firstInner secondInner : RawContext signature Parallel source middle}
    {firstOuter secondOuter : RawContext signature Parallel middle target}
    (inner : ContextEquation firstInner secondInner) (outer : ContextEquation firstOuter secondOuter) :
    ContextEquation (firstInner.comp firstOuter) (secondInner.comp secondOuter) :=
  (inner.comp_before firstOuter).trans (outer.comp_after secondInner)

end Mettapedia.OSLF.SortedCommutative
