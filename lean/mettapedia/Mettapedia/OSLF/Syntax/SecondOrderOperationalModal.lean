import Mettapedia.OSLF.Syntax.SecondOrderOperationalEventObject
import Mettapedia.OSLF.Syntax.EventGraphModalTransport

/-!
# OSLF observations of authored equation-class firing events

The authored graph keeps individual rule-constructor trees over the actual
quotient contexts. At each context its endpoint image supplies the one-step
relation for the generated OSLF modality. The observation asks whether a
firing reaches a state with the stated property; it does not identify the
individual events that witness this fact.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Binding.SecondOrderContext

open _root_.CategoryTheory
open Mettapedia.OSLF.Binding
open Mettapedia.OSLF.Binding.IntrinsicScopedConditionalSubstitution
open Mettapedia.OSLF.Binding.EventGraphImageMorphism
open Mettapedia.OSLF.Binding.EventGraphModalTransport
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis

variable (S : Signature) {M : List (MetaArity S)}
variable (equations : List (EqAxiom S M))
variable (rules : List (IntrinsicScopedConditionalPolynomial.Rule S M))
variable (sort : S.Srt)

/-- The OSLF input theory observed at one authored equation-class context.
Its program states and firings come from the same operational presheaf. -/
noncomputable def authoredTheoryAt
    (context : (EquationContexts
      (authoredEquationPresentation S equations))ᵒᵖ) :
    Mettapedia.GSLT.GSLT :=
  theoryAt (variableGraph (authoredEventGraph S equations rules sort))
    context

/-- An observed one-step transition is exactly a firing generated by the
authored conditional rules in the quotient binding clone. -/
theorem authoredTheoryAt_step_iff
    (context : (EquationContexts
      (authoredEquationPresentation S equations))ᵒᵖ)
    (source target : (authoredStates S equations rules sort).obj context) :
    (authoredTheoryAt S equations rules sort context).Step source target ↔
      IntrinsicScopedConditionalSubstitution.Reduces rules
        (A := (authoredEquationModelAt S equations context.unop.as).algebra)
        (⟨[], sort, (source, target)⟩ :
          AuthoredPositionedRulePolynomial.Judgment _) := by
  exact authoredReduction_iff_reduces S equations rules sort
    context source target

/-- The generated OSLF may modality observes exactly those source states
with a witnessed authored firing to a target satisfying the predicate. -/
theorem authoredDiamond_iff_reduces
    (context : (EquationContexts
      (authoredEquationPresentation S equations))ᵒᵖ)
    (predicate : (authoredStates S equations rules sort).obj context → Prop)
    (source : (authoredStates S equations rules sort).obj context) :
    gsltDiamond (authoredTheoryAt S equations rules sort context)
      predicate source ↔
      ∃ target,
        IntrinsicScopedConditionalSubstitution.Reduces rules
          (A := (authoredEquationModelAt S equations context.unop.as).algebra)
          (⟨[], sort, (source, target)⟩ :
            AuthoredPositionedRulePolynomial.Judgment _) ∧
        predicate target := by
  exact (gsltDiamond_spec
    (authoredTheoryAt S equations rules sort context) predicate source).trans
      (exists_congr (fun target =>
        (authoredTheoryAt_step_iff S equations rules sort
          context source target).and Iff.rfl))

/-- The one-step singleton modality is exactly the endpoint observation of
an individual firing tree; no target-step coverage is assumed. -/
theorem authoredDiamond_singleton_iff_event
    (context : (EquationContexts
      (authoredEquationPresentation S equations))ᵒᵖ)
    (source target : (authoredStates S equations rules sort).obj context) :
    gsltDiamond (authoredTheoryAt S equations rules sort context)
      (fun candidate => candidate = target) source ↔
      ∃ event : (authoredEvents S equations rules sort).obj context,
        (authoredEventSource S equations rules sort).app context event = source ∧
        (authoredEventTarget S equations rules sort).app context event = target := by
  exact (gsltDiamond_singleton_iff_step
    (authoredTheoryAt S equations rules sort context) source target).trans
      (authoredReduction_iff S equations rules sort context source target)

/-- Reindexing an authored equation context transports an observed step by
transporting its individual firing witness.  It requires no converse
coverage of events in the later context. -/
theorem authoredStep_contextMap
    {first last : (EquationContexts
      (authoredEquationPresentation S equations))ᵒᵖ}
    (assignment : first ⟶ last)
    (source target : (authoredStates S equations rules sort).obj first)
    (step : (authoredTheoryAt S equations rules sort first).Step
      source target) :
    (authoredTheoryAt S equations rules sort last).Step
      ((authoredStates S equations rules sort).map assignment source)
      ((authoredStates S equations rules sort).map assignment target) := by
  obtain ⟨event, sourceEq, targetEq⟩ :=
    (authoredReduction_iff S equations rules sort first source target).1 step
  let mapped := (authoredEvents S equations rules sort).map assignment event
  have sourceComm := congrArg
    (fun arrow :
      (authoredEvents S equations rules sort).obj first ⟶
        (authoredStates S equations rules sort).obj last => arrow event)
    ((authoredEventSource S equations rules sort).naturality assignment)
  have targetComm := congrArg
    (fun arrow :
      (authoredEvents S equations rules sort).obj first ⟶
        (authoredStates S equations rules sort).obj last => arrow event)
    ((authoredEventTarget S equations rules sort).naturality assignment)
  change
    (authoredStates S equations rules sort).map assignment
      ((authoredEventSource S equations rules sort).app first event) =
    (authoredEventSource S equations rules sort).app last mapped at sourceComm
  change
    (authoredStates S equations rules sort).map assignment
      ((authoredEventTarget S equations rules sort).app first event) =
    (authoredEventTarget S equations rules sort).app last mapped at targetComm
  rw [sourceEq] at sourceComm
  rw [targetEq] at targetComm
  exact (authoredReduction_iff S equations rules sort last _ _).2
    ⟨mapped, sourceComm.symm, targetComm.symm⟩

/-- Contextual substitution preserves the generated OSLF may modality for
predicates transported along the same authored substitution. -/
theorem authoredDiamond_contextMap
    {first last : (EquationContexts
      (authoredEquationPresentation S equations))ᵒᵖ}
    (assignment : first ⟶ last)
    (predicate : (authoredStates S equations rules sort).obj last → Prop)
    (source : (authoredStates S equations rules sort).obj first)
    (may : gsltDiamond
      (authoredTheoryAt S equations rules sort first)
      (fun target =>
        predicate ((authoredStates S equations rules sort).map assignment target))
      source) :
    gsltDiamond (authoredTheoryAt S equations rules sort last)
      predicate ((authoredStates S equations rules sort).map assignment source) := by
  obtain ⟨target, step, holds⟩ :=
    (gsltDiamond_spec
      (authoredTheoryAt S equations rules sort first) _ source).1 may
  exact (gsltDiamond_spec
    (authoredTheoryAt S equations rules sort last) _ _).2
      ⟨(authoredStates S equations rules sort).map assignment target,
        authoredStep_contextMap S equations rules sort
          assignment source target step, holds⟩

end Mettapedia.OSLF.Binding.SecondOrderContext

