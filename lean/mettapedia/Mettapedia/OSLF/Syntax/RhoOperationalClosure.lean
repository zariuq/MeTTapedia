import Mettapedia.OSLF.Syntax.RhoDropProfile

/-!
# The parallel-only operational closure of rho's Chapter 7 rules

The worked presentation declares COMM, Drop and a conditional ParCong.  The
general `Step` of a positioned rewrite closes under every term former.  This
module keeps the narrower closure generated by the three displayed rules
separate, then compares it to that general contextual relation.  The canonical
hash-bag and collection-rest representation still requires a further comparison.
-/

namespace Mettapedia.OSLF.Binding.RhoSchema

set_option autoImplicit false

/-- Base communication and Drop, then congruence under either component of
binary parallel composition. -/
inductive ParallelStep : Term sig [] Srt.pr → Term sig [] Srt.pr → Prop where
  | comm {source target} : RootStep comm source target → ParallelStep source target
  | drop {source target} : RootStep dropRule source target → ParallelStep source target
  | parLeft {source target} (remainder : Term sig [] Srt.pr) :
      ParallelStep source target →
      ParallelStep (parT source remainder) (parT target remainder)
  | parRight {source target} (remainder : Term sig [] Srt.pr) :
      ParallelStep source target →
      ParallelStep (parT remainder source) (parT remainder target)

/-- The authored equations surround one parallel-only operational step. -/
def ParallelStepModE (source target : Term sig [] Srt.pr) : Prop :=
  ∃ source' target', EqClosure rhoSourceE source source' ∧
    ParallelStep source' target' ∧ EqClosure rhoSourceE target' target

/-- Every displayed-rule derivation is an instance of the broader intrinsic
contextual closure. -/
theorem parallelStep_to_contextual : ∀ {source target : Term sig [] Srt.pr},
    ParallelStep source target → rhoSourceWithDrop.Step source target
  | _, _, .comm fires =>
      ⟨⟨0, by decide⟩, step_of_rootStep comm fires⟩
  | _, _, .drop fires =>
      ⟨⟨1, by decide⟩, step_of_rootStep dropRule fires⟩
  | _, _, .parLeft (source := source) (target := target) remainder step => by
      obtain ⟨i, fires⟩ := parallelStep_to_contextual step
      fin_cases i
      · exact ⟨⟨0, by decide⟩, by
          change Step comm (parT source remainder) (parT target remainder)
          have under := step_under_linear_context comm (parLeftHole remainder) fires
          simpa only [parLeftHole_inst] using under⟩
      · exact ⟨⟨1, by decide⟩, by
          change Step dropRule (parT source remainder) (parT target remainder)
          have under := step_under_linear_context dropRule (parLeftHole remainder) fires
          exact (parLeftHole_inst remainder source) ▸
            (parLeftHole_inst remainder target) ▸ under⟩
  | _, _, .parRight (source := source) (target := target) remainder step => by
      obtain ⟨i, fires⟩ := parallelStep_to_contextual step
      fin_cases i
      · exact ⟨⟨0, by decide⟩, by
          change Step comm (parT remainder source) (parT remainder target)
          have under := step_under_linear_context comm (parRightHole remainder) fires
          simpa only [parRightHole_inst] using under⟩
      · exact ⟨⟨1, by decide⟩, by
          change Step dropRule (parT remainder source) (parT remainder target)
          have under := step_under_linear_context dropRule (parRightHole remainder) fires
          exact (parRightHole_inst remainder source) ▸
            (parRightHole_inst remainder target) ▸ under⟩

/-- The comparison remains valid after passing to equation classes. -/
theorem parallelStepModE_to_contextual {source target : Term sig [] Srt.pr}
    (step : ParallelStepModE source target) :
    rhoSourceWithDrop.StepModE source target := by
  obtain ⟨source', target', before, firing, after⟩ := step
  obtain ⟨i, contextual⟩ := parallelStep_to_contextual firing
  exact ⟨i, source', target', before, contextual, after⟩

/-- The closed communication instance is admitted by the parallel-only
relation without using a congruence premise. -/
theorem parallel_communication : ParallelStep commSource commTarget :=
  .comm (rootStep_of_instance comm commInstance)

/-- The same relation admits the distinct Drop rule. -/
theorem parallel_drop : ParallelStep dropChan nilP :=
  .drop (rootStep_of_instance dropRule
    { body := contDiscard, close := closeDrop nilP })

/-- A representative source-order communication is recovered by the
commutativity equation before the COMM firing. -/
theorem parallel_input_output_communicates :
    ParallelStepModE (parT commInput commOutput) commTarget :=
  ⟨commSource, commTarget,
    EqClosure.ax (E := rhoSourceE) 0 contUnquote
      (closePair commInput commOutput),
    parallel_communication, EqClosure.refl _⟩

/-- The raw displayed rules can fire only at a parallel or Drop head.
This test is deliberately about raw steps, before structural congruence. -/
def parallelOrDropHead : Term sig [] Srt.pr → Bool
  | .op Op.par _ => true
  | .op Op.drp _ => true
  | _ => false

theorem parallelStep_source_head : ∀ {source target : Term sig [] Srt.pr},
    ParallelStep source target → parallelOrDropHead source = true
  | _, _, .comm fires => by
      obtain ⟨ruleInstance, sourceEq⟩ := rootStep_lhs_shape comm fires
      rw [sourceEq]
      rfl
  | _, _, .drop fires => by
      obtain ⟨ruleInstance, sourceEq⟩ := rootStep_lhs_shape dropRule fires
      rw [sourceEq]
      rfl
  | _, _, .parLeft _ _ => rfl
  | _, _, .parRight _ _ => rfl

/-- A context selecting the payload of an output. -/
def outPayloadHole : LinCtx sig Srt.pr [] Srt.pr :=
  .op Op.out (.there chan (.here .hole .nil))

abbrev outputCarrying (process : Term sig [] Srt.pr) : Term sig [] Srt.pr :=
  Term.op Op.out (.cons chan (.cons process .nil))

theorem outPayloadHole_inst (process : Term sig [] Srt.pr) :
    inst (LinCtx.toTerm outPayloadHole) process = outputCarrying process := by
  change Term.op Op.out (.cons (inst (weaken chan) process)
    (.cons process .nil)) = outputCarrying process
  rw [inst_weaken]

/-- The generic contextual closure fires COMM inside an output payload. -/
theorem broad_contextual_output_step :
    rhoSourceWithDrop.Step
      (outputCarrying commSource) (outputCarrying commTarget) := by
  have firing : Step comm commSource commTarget :=
    step_of_rootStep comm (rootStep_of_instance comm commInstance)
  have under := step_under_linear_context comm outPayloadHole firing
  exact ⟨⟨0, by decide⟩,
    (outPayloadHole_inst commSource) ▸
      (outPayloadHole_inst commTarget) ▸ under⟩

/-- That raw step is absent from the three displayed rules. Thus the
unrestricted contextual closure strictly extends the parallel-only reading. -/
theorem broad_contextual_step_not_parallel :
    ¬ ParallelStep
      (outputCarrying commSource) (outputCarrying commTarget) := by
  intro firing
  have head := parallelStep_source_head firing
  cases head

end Mettapedia.OSLF.Binding.RhoSchema
