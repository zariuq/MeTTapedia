/-!
# OSLF Formula Language + Verified Bounded Model Checker

The "output artifact" of the OSLF algorithm: a formula language for writing
behavioral properties of terms, together with an executable bounded model
checker and a proven-sound denotational semantics.

## Architecture

```
OSLFFormula (data)           -- behavioral property language
    |
    ├── sem : Formula → Pattern → Prop    (denotational semantics)
    │     connects to langDiamond/langBox from TypeSynthesis.lean
    |
    └── check : Formula → Pattern → CheckResult  (executable checker)
          proven sound: check = .sat → sem holds
```

## Formula Language

- `top`, `bot` — trivially true/false
- `atom a` — named atomic predicate (interpretation provided separately)
- `and φ ψ`, `or φ ψ`, `imp φ ψ` — Boolean connectives
- `dia φ` — step-future ◇: "can step to a state satisfying φ"
- `box φ` — step-past □: "all predecessors satisfy φ"

## Three-Valued Checker

The checker uses three-valued logic because:
- `box` (step-past) requires enumerating predecessors (not computable from a
  forward step function), so it returns `.unknown`
- `imp` is conservative: only returns `.sat` when the consequent is provably `.sat`
  (because checker `.unsat` doesn't imply semantic falsity)

Soundness: `check = .sat → sem` (proven generically).

## References

- Meredith & Stay, "Operational Semantics in Logical Form" §4, §6
- Williams & Stay, "Native Type Theory" (ACT 2021)
-/

namespace Mettapedia.OSLF.Formula

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.Match
open Mettapedia.OSLF.MeTTaIL.Engine
open Mettapedia.OSLF.MeTTaIL.ContextualStep
open Mettapedia.Languages.ProcessCalculi.RhoCalculus.Reduction
open Mettapedia.Languages.ProcessCalculi.RhoCalculus.Engine
open Mettapedia.OSLF.Framework.TypeSynthesis
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis

/-! ## Formula AST -/

/-- Behavioral property formulas for OSLF type systems.

    This is the "output artifact" of the OSLF algorithm: a concrete formula
    language for expressing behavioral properties of terms in any `LanguageDef`.

    Atomic predicates are named strings; their interpretation is provided
    separately via `AtomSem` (for proofs) or `AtomCheck` (for checking). -/
inductive OSLFFormula where
  | top : OSLFFormula
  | bot : OSLFFormula
  | atom : String → OSLFFormula
  | and : OSLFFormula → OSLFFormula → OSLFFormula
  | or : OSLFFormula → OSLFFormula → OSLFFormula
  | imp : OSLFFormula → OSLFFormula → OSLFFormula
  | dia : OSLFFormula → OSLFFormula
  | box : OSLFFormula → OSLFFormula
  /-- A scope variable, as a de Bruijn index into the enclosing binders. -/
  | var : Nat → OSLFFormula
  /-- The least scope generated by a formula in one scope variable.  The
      variable bound is index zero. -/
  | mu : OSLFFormula → OSLFFormula
  /-- The empty collection of a kind: the unit of the cut below, read in the
      frame so that the modulo-equations reading is the frame's own. -/
  | emptyColl : CollType → OSLFFormula
  /-- **The cut**: a collection of the given kind splits into two, the first
      part satisfying the left formula and the second the right.  Read in the
      frame, so in the equation frame it is the separating conjunction over
      decompositions modulo the equations, and in the ambient frame the
      positional one. -/
  | cut : CollType → OSLFFormula → OSLFFormula → OSLFFormula
  /-- **A declared unary former**: the term is that constructor applied to one
      argument satisfying the sub-formula.  Read in the frame like the cut.
      This is what a reflective calculus's quote needs, and with it the source's
      own generator is a formula of this language. -/
  | headed : String → OSLFFormula → OSLFFormula
  deriving DecidableEq, Repr, BEq

namespace OSLFFormula

/-- Negation: ¬φ ≡ φ → ⊥ -/
abbrev neg (φ : OSLFFormula) : OSLFFormula := .imp φ .bot

partial def toStr : OSLFFormula → String
  | .top => "⊤"
  | .bot => "⊥"
  | .atom a => a
  | .and φ ψ => "(" ++ toStr φ ++ " ∧ " ++ toStr ψ ++ ")"
  | .or φ ψ => "(" ++ toStr φ ++ " ∨ " ++ toStr ψ ++ ")"
  | .emptyColl _ => "emp"
  | .cut _ φ ψ => "(" ++ toStr φ ++ " | " ++ toStr ψ ++ ")"
  | .headed label φ => label ++ "(" ++ toStr φ ++ ")"
  | .imp φ ψ => "(" ++ toStr φ ++ " → " ++ toStr ψ ++ ")"
  | .dia φ => "◇" ++ toStr φ
  | .box φ => "□" ++ toStr φ
  | .var k => "X" ++ toString k
  | .mu φ => "µ." ++ toStr φ

instance : ToString OSLFFormula := ⟨toStr⟩

/-! ## Generator length

The number of symbols in a formula.  This is the quantity the scope
construction sets against the size of a generated extension, and it is a
function of the formula — which is why the binder is a constructor here rather
than a transformer elsewhere. -/

/-- The number of symbols in a formula, atoms counting as one. -/
def size : OSLFFormula → Nat
  | .top | .bot => 1
  | .atom _ => 1
  | .var _ => 1
  | .emptyColl _ => 1
  | .and φ ψ | .or φ ψ | .imp φ ψ | .cut _ φ ψ => 1 + size φ + size ψ
  | .dia φ | .box φ | .mu φ | .headed _ φ => 1 + size φ

/-- Formulas that read no structural shape: the fragment whose reading does not
depend on the frame, and therefore the fragment the frame-irrelevance and
bisimulation-invariance statements range over.  It is strictly smaller than the
generator-free fragment now that the language has a cut, and saying so is the
price of the cut being a connective of *this* language. -/
def spatialFree : OSLFFormula → Bool
  | .top => true
  | .bot => true
  | .atom _ => true
  | .var _ => true
  | .emptyColl _ => false
  | .cut _ _ _ => false
  | .headed _ _ => false
  | .and φ ψ | .or φ ψ | .imp φ ψ => spatialFree φ && spatialFree ψ
  | .dia φ | .box φ | .mu φ => spatialFree φ

/-- **The modal fragment**: no generator and no structural connective.  This is
what "generator-free" meant before the language gained a cut, and it is the
fragment the bisimulation-invariance and Hennessy–Milner statements range over —
a bisimulation preserves behaviour, not shape, and the cut reads shape. -/
def modalOnly : OSLFFormula → Bool
  | .top => true
  | .bot => true
  | .atom _ => true
  | .var _ => false
  | .mu _ => false
  | .emptyColl _ => false
  | .cut _ _ _ => false
  | .headed _ _ => false
  | .and φ ψ | .or φ ψ | .imp φ ψ => modalOnly φ && modalOnly ψ
  | .dia φ | .box φ => modalOnly φ

/-! ## Scope variables -/

/-- Shift every free scope variable at or above `cutoff` up by one. -/
def shift (cutoff : Nat) : OSLFFormula → OSLFFormula
  | .top => .top
  | .bot => .bot
  | .atom a => .atom a
  | .var k => if k < cutoff then .var k else .var (k + 1)
  | .emptyColl kind => .emptyColl kind
  | .cut kind φ ψ => .cut kind (shift cutoff φ) (shift cutoff ψ)
  | .headed label φ => .headed label (shift cutoff φ)
  | .and φ ψ => .and (shift cutoff φ) (shift cutoff ψ)
  | .or φ ψ => .or (shift cutoff φ) (shift cutoff ψ)
  | .imp φ ψ => .imp (shift cutoff φ) (shift cutoff ψ)
  | .dia φ => .dia (shift cutoff φ)
  | .box φ => .box (shift cutoff φ)
  | .mu φ => .mu (shift (cutoff + 1) φ)

/-- Replace the scope variable `depth` by `value`, shifting as it descends. -/
def substAt (depth : Nat) (value : OSLFFormula) : OSLFFormula → OSLFFormula
  | .top => .top
  | .bot => .bot
  | .atom a => .atom a
  | .emptyColl kind => .emptyColl kind
  | .cut kind φ ψ => .cut kind (substAt depth value φ) (substAt depth value ψ)
  | .headed label φ => .headed label (substAt depth value φ)
  | .var k => if k = depth then value else .var k
  | .and φ ψ => .and (substAt depth value φ) (substAt depth value ψ)
  | .or φ ψ => .or (substAt depth value φ) (substAt depth value ψ)
  | .imp φ ψ => .imp (substAt depth value φ) (substAt depth value ψ)
  | .dia φ => .dia (substAt depth value φ)
  | .box φ => .box (substAt depth value φ)
  | .mu φ => .mu (substAt (depth + 1) (shift 0 value) φ)

/-- Unfold a generator once: replace its bound variable by the generator. -/
def unfold (φ : OSLFFormula) : OSLFFormula := substAt 0 (.mu φ) φ

/-! ### Conditions on scope variables

Three decidable conditions, each carrying its own weight below.  `closedAt`
bounds the free scope variables; `muFree` says there is no generator at all,
which is the hypothesis under which a statement about the old formula language
still holds verbatim; and the positivity pair is the side condition under which
a generator is a *fixed* point rather than only an intersection. -/

/-- Every free scope variable of the formula is below `depth`. -/
def closedAt : Nat → OSLFFormula → Bool
  | _, .top => true
  | _, .bot => true
  | _, .atom _ => true
  | _, .emptyColl _ => true
  | depth, .cut _ φ ψ => closedAt depth φ && closedAt depth ψ
  | depth, .headed _ φ => closedAt depth φ
  | depth, .var k => decide (k < depth)
  | depth, .and φ ψ => closedAt depth φ && closedAt depth ψ
  | depth, .or φ ψ => closedAt depth φ && closedAt depth ψ
  | depth, .imp φ ψ => closedAt depth φ && closedAt depth ψ
  | depth, .dia φ => closedAt depth φ
  | depth, .box φ => closedAt depth φ
  | depth, .mu φ => closedAt (depth + 1) φ

/-- The formula contains no generator. -/
def muFree : OSLFFormula → Bool
  | .top => true
  | .bot => true
  | .atom _ => true
  | .emptyColl _ => true
  | .cut _ φ ψ => muFree φ && muFree ψ
  | .headed _ φ => muFree φ
  | .var _ => false
  | .and φ ψ => muFree φ && muFree ψ
  | .or φ ψ => muFree φ && muFree ψ
  | .imp φ ψ => muFree φ && muFree ψ
  | .dia φ => muFree φ
  | .box φ => muFree φ
  | .mu _ => false

/-- The modal fragment is exactly the generator-free, shape-blind one. -/
theorem modalOnly_iff (φ : OSLFFormula) :
    modalOnly φ = true ↔ (muFree φ = true ∧ spatialFree φ = true) := by
  induction φ with
  | top => simp [modalOnly, muFree, spatialFree]
  | bot => simp [modalOnly, muFree, spatialFree]
  | atom _ => simp [modalOnly, muFree, spatialFree]
  | var _ => simp [modalOnly, muFree, spatialFree]
  | emptyColl _ => simp [modalOnly, muFree, spatialFree]
  | cut _ _ _ _ _ => simp [modalOnly, muFree, spatialFree]
  | headed _ _ _ => simp [modalOnly, muFree, spatialFree]
  | and _ _ ihφ ihψ => simp [modalOnly, muFree, spatialFree, ihφ, ihψ]; tauto
  | or _ _ ihφ ihψ => simp [modalOnly, muFree, spatialFree, ihφ, ihψ]; tauto
  | imp _ _ ihφ ihψ => simp [modalOnly, muFree, spatialFree, ihφ, ihψ]; tauto
  | dia _ ih => simp [modalOnly, muFree, spatialFree, ih]
  | box _ ih => simp [modalOnly, muFree, spatialFree, ih]
  | mu _ _ => simp [modalOnly, muFree, spatialFree]

mutual

/-- The scope variable occurs only under an even number of implication
antecedents, so the transformer its body induces is monotone. -/
def positiveIn : Nat → OSLFFormula → Bool
  | _, .top => true
  | _, .bot => true
  | _, .atom _ => true
  | _, .emptyColl _ => true
  | index, .cut _ φ ψ => positiveIn index φ && positiveIn index ψ
  | index, .headed _ φ => positiveIn index φ
  | _, .var _ => true
  | index, .and φ ψ => positiveIn index φ && positiveIn index ψ
  | index, .or φ ψ => positiveIn index φ && positiveIn index ψ
  | index, .imp φ ψ => negativeIn index φ && positiveIn index ψ
  | index, .dia φ => positiveIn index φ
  | index, .box φ => positiveIn index φ
  | index, .mu φ => positiveIn (index + 1) φ

/-- The scope variable occurs only under an odd number of implication
antecedents, so the transformer its body induces is antitone. -/
def negativeIn : Nat → OSLFFormula → Bool
  | _, .top => true
  | _, .bot => true
  | _, .atom _ => true
  | _, .emptyColl _ => true
  | index, .cut _ φ ψ => negativeIn index φ && negativeIn index ψ
  | index, .headed _ φ => negativeIn index φ
  | index, .var k => !(k == index)
  | index, .and φ ψ => negativeIn index φ && negativeIn index ψ
  | index, .or φ ψ => negativeIn index φ && negativeIn index ψ
  | index, .imp φ ψ => positiveIn index φ && negativeIn index ψ
  | index, .dia φ => negativeIn index φ
  | index, .box φ => negativeIn index φ
  | index, .mu φ => negativeIn (index + 1) φ

end

/-- A formula closed at a depth is unchanged by shifting at that depth. -/
theorem shift_of_closedAt (φ : OSLFFormula) :
    ∀ depth : Nat, closedAt depth φ = true → shift depth φ = φ := by
  induction φ with
  | top => intro _ _; rfl
  | bot => intro _ _; rfl
  | atom _ => intro _ _; rfl
  | var k =>
      intro depth closed
      simp only [closedAt, decide_eq_true_eq] at closed
      simp [shift, closed]
  | emptyColl _ => intro _ _; rfl
  | headed label φ ihφ =>
      intro depth closed
      simp only [closedAt] at closed
      simp only [shift, ihφ depth closed]
  | cut kind φ ψ ihφ ihψ =>
      intro depth closed
      simp only [closedAt, Bool.and_eq_true] at closed
      simp only [shift, ihφ depth closed.1, ihψ depth closed.2]
  | and φ ψ ihφ ihψ =>
      intro depth closed
      simp only [closedAt, Bool.and_eq_true] at closed
      simp [shift, ihφ depth closed.1, ihψ depth closed.2]
  | or φ ψ ihφ ihψ =>
      intro depth closed
      simp only [closedAt, Bool.and_eq_true] at closed
      simp [shift, ihφ depth closed.1, ihψ depth closed.2]
  | imp φ ψ ihφ ihψ =>
      intro depth closed
      simp only [closedAt, Bool.and_eq_true] at closed
      simp [shift, ihφ depth closed.1, ihψ depth closed.2]
  | dia φ ih =>
      intro depth closed
      simp only [closedAt] at closed
      simp [shift, ih depth closed]
  | box φ ih =>
      intro depth closed
      simp only [closedAt] at closed
      simp [shift, ih depth closed]
  | mu φ ih =>
      intro depth closed
      simp only [closedAt] at closed
      simp [shift, ih (depth + 1) closed]

end OSLFFormula

/-! ## Denotational Semantics -/

/-- Semantic interpretation of atomic predicates: maps names to Prop-valued predicates. -/
abbrev AtomSem := String → Pattern → Prop

/-- Denotational semantics of OSLF formulas.

    Interprets a formula as a `Pattern → Prop` predicate, given:
    - `R : Pattern → Pattern → Prop` — the reduction relation
    - `I : AtomSem` — interpretation of atomic predicates

    The modal operators match the OSLF paper:
    - `◇ φ` (dia) = step-future: ∃ q, p ⇝ q ∧ φ(q)
    - `□ φ` (box) = step-past: ∀ q, q ⇝ p → φ(q)
-/
abbrev ScopeEnv := Nat → Pattern → Prop

/-- Extend a scope environment with a new innermost binding. -/
def ScopeEnv.push (value : Pattern → Prop) (env : ScopeEnv) : ScopeEnv
  | 0 => value
  | k + 1 => env k

/-- Rebind one scope variable, leaving the rest alone.  This is the environment
counterpart of `OSLFFormula.substAt`, which replaces a variable in place rather
than removing its binder. -/
def ScopeEnv.setAt (index : Nat) (value : Pattern → Prop) (env : ScopeEnv) :
    ScopeEnv :=
  fun k => if k = index then value else env k

/-- The environment in which no scope variable denotes anything. -/
def ScopeEnv.empty : ScopeEnv := fun _ _ => False

theorem ScopeEnv.setAt_succ_push (index : Nat) (value candidate : Pattern → Prop)
    (env : ScopeEnv) :
    ScopeEnv.setAt (index + 1) value (ScopeEnv.push candidate env)
      = ScopeEnv.push candidate (ScopeEnv.setAt index value env) := by
  funext k
  cases k with
  | zero => simp [ScopeEnv.setAt, ScopeEnv.push]
  | succ j => simp [ScopeEnv.setAt, ScopeEnv.push]

/-! ### The frame a generator is taken in

A generator denotes the least fixed point of the transformer its body induces,
and a least fixed point is an intersection — of those *predicates of the logic*
the transformer does not leave.  Which predicates those are is not a free
choice.  For a presentation with equations the project's own notion of a
predicate is `EquationPredicate`, an invariant one, and intersecting over the
full powerset instead would take the fixed point in a lattice the generated
logic does not have.

Carrying that class as a parameter is what lets one definition serve the raw
semantics and the modulo-equations semantics, and it is why
`langFormulaSemUsing` stays total: invariance of a generated scope then holds
for *every* body, monotone or not, because an intersection of invariant
predicates is invariant.  Positivity is still needed, but only for the fixed
point law, where it belongs. -/

/-- A class of predicates closed under arbitrary intersection. -/
structure PredFrame where
  /-- The predicates of the logic. -/
  Mem : (Pattern → Prop) → Prop
  /-- Closed under arbitrary intersection, which is what a least fixed point is
  built out of. -/
  mem_inter : ∀ selector : (Pattern → Prop) → Prop,
    Mem fun term => ∀ candidate, Mem candidate → selector candidate → candidate term
  /-- A predicate of the frame above an arbitrary one.  A structural connective
  reads a term's own shape, which an arbitrary frame's predicates need not see;
  closing is what carries such a reading into the frame, and it is the reason
  the cut can be a connective of *this* language rather than of a second one
  beside it. -/
  close : (Pattern → Prop) → (Pattern → Prop)
  /-- Closing only adds. -/
  le_close : ∀ predicate term, predicate term → close predicate term
  /-- And what it produces is of the frame. -/
  mem_close : ∀ predicate, Mem (close predicate)
  /-- Closing is monotone, which is what carries a connective's own monotonicity
  through it. -/
  close_mono : ∀ predicate predicate' : Pattern → Prop,
    (∀ term, predicate term → predicate' term) →
      ∀ term, close predicate term → close predicate' term

/-- The frame in which every predicate counts: the ambient powerset. -/
def fullFrame : PredFrame where
  Mem := fun _ => True
  mem_inter := fun _ => trivial
  close := fun predicate => predicate
  le_close := fun _ _ holds => holds
  mem_close := fun _ => trivial
  close_mono := fun _ _ weaker term holds => weaker term holds

/-- Denotational semantics under a scope environment.

A generator is the intersection of the pre-fixed points of its body *inside the
frame*.  That reading is total for every body, monotone or not, so the
semantics is a plain structural recursion with no side condition, and the
induction principle it yields — which is what a scope is surveyed by — is
unconditional.  Only the unfolding law needs the body to be positive. -/
def semEnv (R : Pattern → Pattern → Prop) (F : PredFrame) (I : AtomSem)
    (env : ScopeEnv) : OSLFFormula → Pattern → Prop
  | .top, _ => True
  | .bot, _ => False
  | .atom a, p => I a p
  | .and φ ψ, p => semEnv R F I env φ p ∧ semEnv R F I env ψ p
  | .or φ ψ, p => semEnv R F I env φ p ∨ semEnv R F I env ψ p
  | .imp φ ψ, p => semEnv R F I env φ p → semEnv R F I env ψ p
  | .dia φ, p => ∃ q, R p q ∧ semEnv R F I env φ q
  | .box φ, p => ∀ q, R q p → semEnv R F I env φ q
  | .var k, p => env k p
  | .mu φ, p =>
      ∀ candidate : Pattern → Prop, F.Mem candidate →
        (∀ t, semEnv R F I (ScopeEnv.push candidate env) φ t → candidate t) →
          candidate p
  | .emptyColl kind, p =>
      F.close (fun term => term = .collection kind [] none) p
  | .cut kind left right, p =>
      F.close
        (fun term => ∃ leftParts rightParts : List Pattern,
          term = .collection kind (leftParts ++ rightParts) none ∧
            semEnv R F I env left (.collection kind leftParts none) ∧
            semEnv R F I env right (.collection kind rightParts none)) p
  | .headed label body, p =>
      F.close
        (fun term => ∃ inner : Pattern,
          term = .apply label [inner] ∧ semEnv R F I env body inner) p

/-- The frame is closed under the semantics: a formula read in an environment of
predicates of the logic denotes a predicate of the logic.  This is the condition
under which a generated scope is a fixed point and not merely a lower bound. -/
def FrameClosed (R : Pattern → Pattern → Prop) (F : PredFrame) (I : AtomSem) :
    Prop :=
  ∀ (env : ScopeEnv) (φ : OSLFFormula),
    (∀ index, F.Mem (env index)) → F.Mem (semEnv R F I env φ)

theorem frameClosed_full (R : Pattern → Pattern → Prop) (I : AtomSem) :
    FrameClosed R fullFrame I := fun _ _ _ => trivial

/-- A generated scope is a predicate of the frame it was taken in. -/
theorem mem_semEnv_mu (R : Pattern → Pattern → Prop) (F : PredFrame)
    (I : AtomSem) (env : ScopeEnv) (φ : OSLFFormula) :
    F.Mem (semEnv R F I env (.mu φ)) :=
  F.mem_inter _

/-- Denotational semantics of a closed formula in the ambient powerset. -/
def sem (R : Pattern → Pattern → Prop) (I : AtomSem) :
    OSLFFormula → Pattern → Prop :=
  semEnv R fullFrame I ScopeEnv.empty

/-! ### Metatheory of the generator

Everything a generator needs in order to *be* one: that the semantics reads
only the scope variables a formula actually has, that syntactic substitution is
environment rebinding, that a positive body induces a monotone transformer,
and — from those three — that a closed positive generator equals its own
unfolding.  The last is the fixed point law, and it is the only place
positivity is required. -/

/-- The semantics reads only the scope variables the formula has. -/
theorem semEnv_congr_of_closedAt
    (R : Pattern → Pattern → Prop) (F : PredFrame) (I : AtomSem)
    (φ : OSLFFormula) :
    ∀ (depth : Nat) (env env' : ScopeEnv),
      OSLFFormula.closedAt depth φ = true →
      (∀ index, index < depth → env index = env' index) →
      semEnv R F I env φ = semEnv R F I env' φ := by
  induction φ with
  | top => intro _ _ _ _ _; rfl
  | bot => intro _ _ _ _ _; rfl
  | atom _ => intro _ _ _ _ _; rfl
  | var k =>
      intro depth env env' closed agree
      simp only [OSLFFormula.closedAt, decide_eq_true_eq] at closed
      funext t
      simp only [semEnv, agree k closed]
  | emptyColl _ => intro _ _ _ _ _; rfl
  | headed label φ ihφ =>
      intro depth env env' closed agree
      simp only [OSLFFormula.closedAt] at closed
      funext t
      simp only [semEnv, ihφ depth env env' closed agree]
  | cut kind φ ψ ihφ ihψ =>
      intro depth env env' closed agree
      simp only [OSLFFormula.closedAt, Bool.and_eq_true] at closed
      funext t
      simp only [semEnv, ihφ depth env env' closed.1 agree,
        ihψ depth env env' closed.2 agree]
  | and φ ψ ihφ ihψ =>
      intro depth env env' closed agree
      simp only [OSLFFormula.closedAt, Bool.and_eq_true] at closed
      funext t
      simp only [semEnv, ihφ depth env env' closed.1 agree,
        ihψ depth env env' closed.2 agree]
  | or φ ψ ihφ ihψ =>
      intro depth env env' closed agree
      simp only [OSLFFormula.closedAt, Bool.and_eq_true] at closed
      funext t
      simp only [semEnv, ihφ depth env env' closed.1 agree,
        ihψ depth env env' closed.2 agree]
  | imp φ ψ ihφ ihψ =>
      intro depth env env' closed agree
      simp only [OSLFFormula.closedAt, Bool.and_eq_true] at closed
      funext t
      simp only [semEnv, ihφ depth env env' closed.1 agree,
        ihψ depth env env' closed.2 agree]
  | dia φ ih =>
      intro depth env env' closed agree
      simp only [OSLFFormula.closedAt] at closed
      funext t
      simp only [semEnv, ih depth env env' closed agree]
  | box φ ih =>
      intro depth env env' closed agree
      simp only [OSLFFormula.closedAt] at closed
      funext t
      simp only [semEnv, ih depth env env' closed agree]
  | mu φ ih =>
      intro depth env env' closed agree
      simp only [OSLFFormula.closedAt] at closed
      have body : ∀ candidate : Pattern → Prop,
          semEnv R F I (ScopeEnv.push candidate env) φ
            = semEnv R F I (ScopeEnv.push candidate env') φ := by
        intro candidate
        refine ih (depth + 1) _ _ closed ?_
        intro index lt
        cases index with
        | zero => rfl
        | succ j => exact agree j (by omega)
      funext t
      simp only [semEnv]
      apply propext
      constructor
      · intro holds candidate memc pre
        refine holds candidate memc ?_
        intro u hu
        rw [body candidate] at hu
        exact pre u hu
      · intro holds candidate memc pre
        refine holds candidate memc ?_
        intro u hu
        rw [← body candidate] at hu
        exact pre u hu

/-- Substituting a closed formula for a scope variable is rebinding that
variable in the environment. -/
theorem semEnv_substAt
    (R : Pattern → Pattern → Prop) (F : PredFrame) (I : AtomSem)
    (value : OSLFFormula) (valueClosed : OSLFFormula.closedAt 0 value = true)
    (φ : OSLFFormula) :
    ∀ (index : Nat) (env : ScopeEnv),
      semEnv R F I env (OSLFFormula.substAt index value φ)
        = semEnv R F I
            (ScopeEnv.setAt index (semEnv R F I env value) env) φ := by
  induction φ with
  | top => intro _ _; rfl
  | bot => intro _ _; rfl
  | atom _ => intro _ _; rfl
  | var k =>
      intro index env
      by_cases hk : k = index
      · subst hk
        simp [OSLFFormula.substAt, semEnv, ScopeEnv.setAt]
      · simp [OSLFFormula.substAt, semEnv, ScopeEnv.setAt, hk]
  | emptyColl _ => intro _ _; rfl
  | headed label φ ihφ =>
      intro index env
      funext t
      simp only [OSLFFormula.substAt, semEnv, ihφ index env]
  | cut kind φ ψ ihφ ihψ =>
      intro index env
      funext t
      simp only [OSLFFormula.substAt, semEnv, ihφ index env, ihψ index env]
  | and φ ψ ihφ ihψ =>
      intro index env
      funext t
      simp only [OSLFFormula.substAt, semEnv, ihφ index env, ihψ index env]
  | or φ ψ ihφ ihψ =>
      intro index env
      funext t
      simp only [OSLFFormula.substAt, semEnv, ihφ index env, ihψ index env]
  | imp φ ψ ihφ ihψ =>
      intro index env
      funext t
      simp only [OSLFFormula.substAt, semEnv, ihφ index env, ihψ index env]
  | dia φ ih =>
      intro index env
      funext t
      simp only [OSLFFormula.substAt, semEnv, ih index env]
  | box φ ih =>
      intro index env
      funext t
      simp only [OSLFFormula.substAt, semEnv, ih index env]
  | mu φ ih =>
      intro index env
      have shiftEq : OSLFFormula.shift 0 value = value :=
        OSLFFormula.shift_of_closedAt value 0 valueClosed
      have body : ∀ candidate : Pattern → Prop,
          semEnv R F I (ScopeEnv.push candidate env)
              (OSLFFormula.substAt (index + 1) value φ)
            = semEnv R F I (ScopeEnv.push candidate
                (ScopeEnv.setAt index (semEnv R F I env value) env)) φ := by
        intro candidate
        rw [ih (index + 1) (ScopeEnv.push candidate env)]
        have valueEnv : semEnv R F I (ScopeEnv.push candidate env) value
            = semEnv R F I env value :=
          semEnv_congr_of_closedAt R F I value 0 _ _ valueClosed
            (fun i hi => absurd hi (Nat.not_lt_zero i))
        rw [valueEnv, ScopeEnv.setAt_succ_push]
      funext t
      simp only [OSLFFormula.substAt, shiftEq, semEnv]
      apply propext
      constructor
      · intro holds candidate memc pre
        refine holds candidate memc ?_
        intro u hu
        rw [body candidate] at hu
        exact pre u hu
      · intro holds candidate memc pre
        refine holds candidate memc ?_
        intro u hu
        rw [← body candidate] at hu
        exact pre u hu

/-- A positive occurrence gives a monotone reading and a negative occurrence an
antitone one.  The two are proved together because implication exchanges
them. -/
theorem semEnv_polarity
    (R : Pattern → Pattern → Prop) (F : PredFrame) (I : AtomSem)
    (φ : OSLFFormula) :
    ∀ (index : Nat) (env env' : ScopeEnv),
      (∀ j, j ≠ index → env j = env' j) →
      (∀ t, env index t → env' index t) →
      ((OSLFFormula.positiveIn index φ = true →
          ∀ t, semEnv R F I env φ t → semEnv R F I env' φ t) ∧
       (OSLFFormula.negativeIn index φ = true →
          ∀ t, semEnv R F I env' φ t → semEnv R F I env φ t)) := by
  induction φ with
  | top => intro _ _ _ _ _; exact ⟨fun _ _ _ => trivial, fun _ _ _ => trivial⟩
  | bot =>
      intro _ _ _ _ _
      exact ⟨fun _ _ h => h.elim, fun _ _ h => h.elim⟩
  | atom a => intro _ _ _ _ _; exact ⟨fun _ _ h => h, fun _ _ h => h⟩
  | var k =>
      intro index env env' agree le
      constructor
      · intro _ t ht
        by_cases hk : k = index
        · subst hk; exact le t ht
        · simp only [semEnv]; rw [← agree k hk]; exact ht
      · intro neg t ht
        simp only [OSLFFormula.negativeIn, Bool.not_eq_true', beq_eq_false_iff_ne,
          ne_eq] at neg
        simp only [semEnv]; rw [agree k neg]; exact ht
  | emptyColl _ =>
      intro _ _ _ _ _
      exact ⟨fun _ _ h => h, fun _ _ h => h⟩
  | headed label φ ihφ =>
      intro index env env' agree le
      have hφ := ihφ index env env' agree le
      constructor
      · intro pos t ht
        refine F.close_mono _ _ ?_ t ht
        rintro term ⟨inner, shape, holds⟩
        exact ⟨inner, shape, hφ.1 pos _ holds⟩
      · intro neg t ht
        refine F.close_mono _ _ ?_ t ht
        rintro term ⟨inner, shape, holds⟩
        exact ⟨inner, shape, hφ.2 neg _ holds⟩
  | cut kind φ ψ ihφ ihψ =>
      intro index env env' agree le
      have hφ := ihφ index env env' agree le
      have hψ := ihψ index env env' agree le
      constructor
      · intro pos t ht
        simp only [OSLFFormula.positiveIn, Bool.and_eq_true] at pos
        refine F.close_mono _ _ ?_ t ht
        rintro term ⟨leftParts, rightParts, shape, holdsLeft, holdsRight⟩
        exact ⟨leftParts, rightParts, shape, hφ.1 pos.1 _ holdsLeft,
          hψ.1 pos.2 _ holdsRight⟩
      · intro neg t ht
        simp only [OSLFFormula.negativeIn, Bool.and_eq_true] at neg
        refine F.close_mono _ _ ?_ t ht
        rintro term ⟨leftParts, rightParts, shape, holdsLeft, holdsRight⟩
        exact ⟨leftParts, rightParts, shape, hφ.2 neg.1 _ holdsLeft,
          hψ.2 neg.2 _ holdsRight⟩
  | and φ ψ ihφ ihψ =>
      intro index env env' agree le
      have hφ := ihφ index env env' agree le
      have hψ := ihψ index env env' agree le
      constructor
      · intro pos t ht
        simp only [OSLFFormula.positiveIn, Bool.and_eq_true] at pos
        exact ⟨hφ.1 pos.1 t ht.1, hψ.1 pos.2 t ht.2⟩
      · intro neg t ht
        simp only [OSLFFormula.negativeIn, Bool.and_eq_true] at neg
        exact ⟨hφ.2 neg.1 t ht.1, hψ.2 neg.2 t ht.2⟩
  | or φ ψ ihφ ihψ =>
      intro index env env' agree le
      have hφ := ihφ index env env' agree le
      have hψ := ihψ index env env' agree le
      constructor
      · intro pos t ht
        simp only [OSLFFormula.positiveIn, Bool.and_eq_true] at pos
        exact ht.imp (hφ.1 pos.1 t) (hψ.1 pos.2 t)
      · intro neg t ht
        simp only [OSLFFormula.negativeIn, Bool.and_eq_true] at neg
        exact ht.imp (hφ.2 neg.1 t) (hψ.2 neg.2 t)
  | imp φ ψ ihφ ihψ =>
      intro index env env' agree le
      have hφ := ihφ index env env' agree le
      have hψ := ihψ index env env' agree le
      constructor
      · intro pos t ht
        simp only [OSLFFormula.positiveIn, Bool.and_eq_true] at pos
        intro antecedent
        exact hψ.1 pos.2 t (ht (hφ.2 pos.1 t antecedent))
      · intro neg t ht
        simp only [OSLFFormula.negativeIn, Bool.and_eq_true] at neg
        intro antecedent
        exact hψ.2 neg.2 t (ht (hφ.1 neg.1 t antecedent))
  | dia φ ih =>
      intro index env env' agree le
      have hφ := ih index env env' agree le
      constructor
      · intro pos t ht
        obtain ⟨q, step, holds⟩ := ht
        exact ⟨q, step, hφ.1 pos q holds⟩
      · intro neg t ht
        obtain ⟨q, step, holds⟩ := ht
        exact ⟨q, step, hφ.2 neg q holds⟩
  | box φ ih =>
      intro index env env' agree le
      have hφ := ih index env env' agree le
      constructor
      · intro pos t ht q step
        exact hφ.1 pos q (ht q step)
      · intro neg t ht q step
        exact hφ.2 neg q (ht q step)
  | mu φ ih =>
      intro index env env' agree le
      have push_agree : ∀ candidate : Pattern → Prop,
          ∀ j, j ≠ index + 1 →
            ScopeEnv.push candidate env j = ScopeEnv.push candidate env' j := by
        intro candidate j hj
        cases j with
        | zero => rfl
        | succ i => exact agree i (fun h => hj (by omega))
      have push_le : ∀ candidate : Pattern → Prop,
          ∀ t, ScopeEnv.push candidate env (index + 1) t
            → ScopeEnv.push candidate env' (index + 1) t := by
        intro candidate t ht; exact le t ht
      constructor
      · intro pos t ht candidate memc pre
        simp only [OSLFFormula.positiveIn] at pos
        refine ht candidate memc ?_
        intro u hu
        exact pre u ((ih (index + 1) _ _ (push_agree candidate)
          (push_le candidate)).1 pos u hu)
      · intro neg t ht candidate memc pre
        simp only [OSLFFormula.negativeIn] at neg
        refine ht candidate memc ?_
        intro u hu
        exact pre u ((ih (index + 1) _ _ (push_agree candidate)
          (push_le candidate)).2 neg u hu)

/-- **The fixed point law.**  A closed generator whose body is positive in the
bound variable denotes exactly what its own unfolding denotes.  Without
positivity the generator is still a predicate of the frame and still supports
induction; it is this equation, and only this equation, that positivity buys. -/
theorem semEnv_mu_eq_unfold
    (R : Pattern → Pattern → Prop) (F : PredFrame) (I : AtomSem)
    (frameClosed : FrameClosed R F I)
    (φ : OSLFFormula)
    (closed : OSLFFormula.closedAt 1 φ = true)
    (positive : OSLFFormula.positiveIn 0 φ = true)
    (env : ScopeEnv) (envMem : ∀ index, F.Mem (env index)) :
    semEnv R F I env (.mu φ) = semEnv R F I env (OSLFFormula.unfold φ) := by
  have closedMu : OSLFFormula.closedAt 0 (OSLFFormula.mu φ) = true := closed
  have unfoldEq : semEnv R F I env (OSLFFormula.unfold φ)
      = semEnv R F I
          (ScopeEnv.push (semEnv R F I env (.mu φ)) env) φ := by
    rw [OSLFFormula.unfold,
      semEnv_substAt R F I (OSLFFormula.mu φ) closedMu φ 0 env]
    refine semEnv_congr_of_closedAt R F I φ 1 _ _ closed ?_
    intro i hi
    interval_cases i
    rfl
  have mono : ∀ X Y : Pattern → Prop, (∀ t, X t → Y t) →
      ∀ t, semEnv R F I (ScopeEnv.push X env) φ t
        → semEnv R F I (ScopeEnv.push Y env) φ t := by
    intro X Y hXY
    refine (semEnv_polarity R F I φ 0 (ScopeEnv.push X env)
      (ScopeEnv.push Y env) ?_ ?_).1 positive
    · intro j hj
      cases j with
      | zero => exact absurd rfl hj
      | succ i => rfl
    · exact hXY
  have below : ∀ t,
      semEnv R F I (ScopeEnv.push (semEnv R F I env (.mu φ)) env) φ t
        → semEnv R F I env (.mu φ) t := by
    intro t ht candidate memc pre
    have muLe : ∀ u, semEnv R F I env (.mu φ) u → candidate u := by
      intro u hu
      exact hu candidate memc pre
    exact pre t (mono _ _ muLe t ht)
  have above : ∀ t, semEnv R F I env (.mu φ) t
      → semEnv R F I (ScopeEnv.push (semEnv R F I env (.mu φ)) env) φ t := by
    intro t ht
    refine ht _ (frameClosed _ φ ?_) ?_
    · intro index
      cases index with
      | zero => exact mem_semEnv_mu R F I env φ
      | succ i => exact envMem i
    · intro u hu
      exact mono _ _ below u hu
  rw [unfoldEq]
  funext t
  exact propext ⟨fun h => above t h, fun h => below t h⟩

/-- The fixed point law for the ambient-powerset semantics. -/
theorem sem_mu_eq_unfold
    (R : Pattern → Pattern → Prop) (I : AtomSem) (φ : OSLFFormula)
    (closed : OSLFFormula.closedAt 1 φ = true)
    (positive : OSLFFormula.positiveIn 0 φ = true) :
    sem R I (.mu φ) = sem R I (OSLFFormula.unfold φ) :=
  semEnv_mu_eq_unfold R fullFrame I (frameClosed_full R I) φ closed positive
    ScopeEnv.empty (fun _ => trivial)

/-- **Park induction.**  A generator is below every pre-fixed point of its body
that is a predicate of the frame.  No positivity is needed: this is the whole
content of taking an intersection. -/
theorem semEnv_mu_le
    (R : Pattern → Pattern → Prop) (F : PredFrame) (I : AtomSem)
    (env : ScopeEnv) (φ : OSLFFormula) (candidate : Pattern → Prop)
    (memc : F.Mem candidate)
    (pre : ∀ t, semEnv R F I (ScopeEnv.push candidate env) φ t → candidate t) :
    ∀ t, semEnv R F I env (.mu φ) t → candidate t :=
  fun _ holds => holds candidate memc pre

/-- A formula of the modal fragment does not see the frame at all: it has no
generator to take an intersection inside one, and no structural connective to
read through its closure.  So every statement about the old formula language
transports verbatim. -/
theorem semEnv_frame_irrelevant
    (R : Pattern → Pattern → Prop) (F F' : PredFrame) (I : AtomSem)
    (φ : OSLFFormula) (modal : OSLFFormula.modalOnly φ = true) :
    ∀ env env' : ScopeEnv, semEnv R F I env φ = semEnv R F' I env' φ := by
  induction φ with
  | top => intro _ _; rfl
  | bot => intro _ _; rfl
  | atom _ => intro _ _; rfl
  | var _ => simp [OSLFFormula.modalOnly] at modal
  | mu _ _ => simp [OSLFFormula.modalOnly] at modal
  | emptyColl _ => simp [OSLFFormula.modalOnly] at modal
  | cut _ _ _ _ _ => simp [OSLFFormula.modalOnly] at modal
  | headed _ _ _ => simp [OSLFFormula.modalOnly] at modal
  | and φ ψ ihφ ihψ =>
      simp only [OSLFFormula.modalOnly, Bool.and_eq_true] at modal
      intro env env'
      funext t
      simp only [semEnv, ihφ modal.1 env env', ihψ modal.2 env env']
  | or φ ψ ihφ ihψ =>
      simp only [OSLFFormula.modalOnly, Bool.and_eq_true] at modal
      intro env env'
      funext t
      simp only [semEnv, ihφ modal.1 env env', ihψ modal.2 env env']
  | imp φ ψ ihφ ihψ =>
      simp only [OSLFFormula.modalOnly, Bool.and_eq_true] at modal
      intro env env'
      funext t
      simp only [semEnv, ihφ modal.1 env env', ihψ modal.2 env env']
  | dia φ ih =>
      simp only [OSLFFormula.modalOnly] at modal
      intro env env'
      funext t
      simp only [semEnv, ih modal env env']
  | box φ ih =>
      simp only [OSLFFormula.modalOnly] at modal
      intro env env'
      funext t
      simp only [semEnv, ih modal env env']

/-- Atomic observations for a language are semantic predicates: they may not
distinguish presentations identified by the language's equations. -/
abbrev EquationAtomSemUsing (relEnv : RelationEnv) (lang : LanguageDef) :=
  String → EquationPredicate (langGSLTUsing relEnv lang)

/-- Default-environment semantic atomic observations. -/
abbrev EquationAtomSem (lang : LanguageDef) :=
  EquationAtomSemUsing RelationEnv.empty lang

/-- Admit a raw family of atomic observations into the canonical OSLF when
the language is certified equation-free.  This packages the resulting
invariance theorem; it does not select a second formula semantics. -/
def equationAtomSemUsingOfEquationFree
    (relEnv : RelationEnv) {lang : LanguageDef}
    (equationFree : lang.isEquationFree = true)
    (interpretation : AtomSem) : EquationAtomSemUsing relEnv lang :=
  fun atom => equationPredicateUsingOfEquationFree
    relEnv equationFree (interpretation atom)

/-- Default-environment form of
`equationAtomSemUsingOfEquationFree`. -/
def equationAtomSemOfEquationFree
    {lang : LanguageDef} (equationFree : lang.isEquationFree = true)
    (interpretation : AtomSem) : EquationAtomSem lang :=
  equationAtomSemUsingOfEquationFree RelationEnv.empty equationFree interpretation

/-- Admit an ordinary family of authored-term observations into OSLF by
taking the least equation-invariant family containing it.  This is the sole
entry point for observations that have not supplied their own invariance
proof; it does not construct a second, equation-blind logic. -/
def saturateAtomSemUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (interpretation : AtomSem) : EquationAtomSemUsing relEnv lang :=
  fun atom => saturatePredicate (langGSLTUsing relEnv lang) (interpretation atom)

/-- Every authored observation holds in its modulo-equations admission. -/
theorem holds_saturateAtomSemUsing
    (relEnv : RelationEnv) (lang : LanguageDef) (interpretation : AtomSem)
    (atom : String) (term : Pattern) :
    interpretation atom term →
      (saturateAtomSemUsing relEnv lang interpretation atom).1 term := by
  intro holds
  exact ⟨term, (langGSLTUsing relEnv lang).equations.iseqv.refl term, holds⟩

/-! ### The frame a setoid selects

A frame of predicates is decided by an equivalence on terms and nothing else:
its members are the predicates the equivalence cannot see past, and its closure
is saturation along the equivalence.  Writing it once at that generality is
what lets a presentation change which equivalence it means -- a permissive one
or a disciplined one -- without a second copy of the metatheory. -/

/-- **The frame a setoid of patterns selects.** -/
def setoidFrame (equations : Setoid Pattern) : PredFrame where
  Mem := fun predicate =>
    ∀ ⦃left right : Pattern⦄, equations.r left right → (predicate left ↔ predicate right)
  mem_inter := by
    intro _ left right equivalent
    constructor
    · intro holds candidate memCandidate selected
      exact (memCandidate equivalent).mp (holds candidate memCandidate selected)
    · intro holds candidate memCandidate selected
      exact (memCandidate equivalent).mpr (holds candidate memCandidate selected)
  close := fun predicate term =>
    ∃ representative, equations.r term representative ∧ predicate representative
  le_close := by
    intro predicate term holds
    exact ⟨term, equations.iseqv.refl term, holds⟩
  mem_close := by
    rintro predicate left right equivalent
    constructor
    · rintro ⟨representative, leftEquivalent, holds⟩
      exact ⟨representative,
        equations.iseqv.trans (equations.iseqv.symm equivalent) leftEquivalent, holds⟩
    · rintro ⟨representative, rightEquivalent, holds⟩
      exact ⟨representative, equations.iseqv.trans equivalent rightEquivalent, holds⟩
  close_mono := by
    rintro predicate predicate' weaker term ⟨representative, equivalent, holds⟩
    exact ⟨representative, equivalent, weaker representative holds⟩

/-- **Invariance of the semantics, at the generality it actually holds.**  A
formula read over a step relation that respects an equivalence, with invariant
atoms and an invariant scope environment, denotes a predicate the equivalence
cannot see past.  The generator case is the frame's closure under intersection
and the structural cases are its closure operator landing in the frame, so
neither needs a condition on the body. -/
theorem semEnv_setoidInvariant
    (equations : Setoid Pattern) (R : Pattern → Pattern → Prop)
    (respLeft : ∀ {source source' target : Pattern},
      equations.r source source' → R source target →
        ∃ target', R source' target' ∧ equations.r target target')
    (respRight : ∀ {source target target' : Pattern},
      R source target → equations.r target target' → R source target')
    (I : AtomSem) (atomsInvariant : ∀ atom, (setoidFrame equations).Mem (I atom))
    (formula : OSLFFormula) :
    ∀ env : ScopeEnv,
      (∀ index, (setoidFrame equations).Mem (env index)) →
      (setoidFrame equations).Mem (semEnv R (setoidFrame equations) I env formula) := by
  induction formula with
  | top => intro _ _ _ _ _; exact Iff.rfl
  | bot => intro _ _ _ _ _; exact Iff.rfl
  | atom atom => intro _ _; exact atomsInvariant atom
  | emptyColl _ => intro _ _; exact (setoidFrame equations).mem_close _
  | cut _ _ _ _ _ => intro _ _; exact (setoidFrame equations).mem_close _
  | headed _ _ _ => intro _ _; exact (setoidFrame equations).mem_close _
  | and first second firstIH secondIH =>
      intro env envInv left right equivalent
      exact and_congr (firstIH env envInv equivalent) (secondIH env envInv equivalent)
  | or first second firstIH secondIH =>
      intro env envInv left right equivalent
      exact or_congr (firstIH env envInv equivalent) (secondIH env envInv equivalent)
  | imp first second firstIH secondIH =>
      intro env envInv left right equivalent
      exact imp_congr (firstIH env envInv equivalent) (secondIH env envInv equivalent)
  | dia body bodyIH =>
      intro env envInv left right equivalent
      constructor
      · rintro ⟨target, step, holds⟩
        obtain ⟨target', step', targetEquivalent⟩ := respLeft equivalent step
        exact ⟨target', step', (bodyIH env envInv targetEquivalent).mp holds⟩
      · rintro ⟨target, step, holds⟩
        obtain ⟨target', step', targetEquivalent⟩ :=
          respLeft (equations.iseqv.symm equivalent) step
        exact ⟨target', step', (bodyIH env envInv targetEquivalent).mp holds⟩
  | box body bodyIH =>
      intro env envInv left right equivalent
      constructor
      · intro holds source step
        exact holds source (respRight step (equations.iseqv.symm equivalent))
      · intro holds source step
        exact holds source (respRight step equivalent)
  | var index => intro env envInv; exact envInv index
  | mu body _ => intro env _; exact (setoidFrame equations).mem_inter _

/-- The frame of predicates of the generated logic: those that cannot
distinguish authored terms the equations identify.  A generator read in this
frame intersects only over predicates of the logic, which is why the result is
a predicate of the logic for *every* body. -/
def equationFrameUsing (relEnv : RelationEnv) (lang : LanguageDef) : PredFrame where
  Mem := EquationInvariant (langGSLTUsing relEnv lang)
  mem_inter := by
    intro _ left right equivalent
    constructor
    · intro holds candidate memCandidate selected
      exact (memCandidate equivalent).mp (holds candidate memCandidate selected)
    · intro holds candidate memCandidate selected
      exact (memCandidate equivalent).mpr (holds candidate memCandidate selected)
  close := fun predicate => (saturatePredicate (langGSLTUsing relEnv lang) predicate).1
  le_close := by
    intro predicate term holds
    exact ⟨term, (langGSLTUsing relEnv lang).equations.iseqv.refl term, holds⟩
  mem_close := fun predicate => (saturatePredicate (langGSLTUsing relEnv lang) predicate).2
  close_mono := by
    rintro predicate predicate' weaker term ⟨representative, equivalent, holds⟩
    exact ⟨representative, equivalent, weaker representative holds⟩

/-- Formula semantics over modulo-equations reduction is invariant whenever its
atomic observations are invariant.  The generator case needs the statement at
every environment of invariant predicates, not only at the empty one, so the
induction runs over that stronger claim; the generator case itself is then the
frame's closure under intersection, with no condition on the body. -/
theorem semEnv_equationInvariantUsing
    (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (formula : OSLFFormula) :
    ∀ env : ScopeEnv,
      (∀ index, EquationInvariant (langGSLTUsing relEnv lang) (env index)) →
      EquationInvariant (langGSLTUsing relEnv lang)
        (semEnv (langSemanticReducesUsing relEnv lang)
          (equationFrameUsing relEnv lang) (fun atom => (I atom).1) env formula) :=
  semEnv_setoidInvariant (langGSLTUsing relEnv lang).equations
    (langSemanticReducesUsing relEnv lang)
    (fun equivalent step => (langGSLTUsing relEnv lang).rewrites_resp_left equivalent step)
    (fun step equivalent => (langGSLTUsing relEnv lang).rewrites_resp_right step equivalent)
    (fun atom => (I atom).1) (fun atom => (I atom).2) formula

/-- **A setoid's frame is closed under the semantics**, so a generated scope
read in it is a fixed point and not merely a lower bound. -/
theorem frameClosed_setoidFrame
    (equations : Setoid Pattern) (R : Pattern → Pattern → Prop)
    (respLeft : ∀ {source source' target : Pattern},
      equations.r source source' → R source target →
        ∃ target', R source' target' ∧ equations.r target target')
    (respRight : ∀ {source target target' : Pattern},
      R source target → equations.r target target' → R source target')
    (I : AtomSem) (atomsInvariant : ∀ atom, (setoidFrame equations).Mem (I atom)) :
    FrameClosed R (setoidFrame equations) I :=
  fun env formula envInv =>
    semEnv_setoidInvariant equations R respLeft respRight I atomsInvariant formula env envInv

/-- The frame of the generated logic is the frame its equations select. -/
theorem equationFrameUsing_eq_setoidFrame (relEnv : RelationEnv) (lang : LanguageDef) :
    equationFrameUsing relEnv lang = setoidFrame (langGSLTUsing relEnv lang).equations :=
  rfl

/-- The empty scope environment consists of predicates of the logic. -/
theorem equationInvariant_scopeEnv_empty
    (relEnv : RelationEnv) (lang : LanguageDef) :
    ∀ index, EquationInvariant (langGSLTUsing relEnv lang) (ScopeEnv.empty index) :=
  fun _ _ _ _ => Iff.rfl

/-- The frame of the generated logic is closed under the semantics, which is
what makes a generated scope a fixed point there and not merely a bound. -/
theorem frameClosed_equationFrameUsing
    (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) :
    FrameClosed (langSemanticReducesUsing relEnv lang)
      (equationFrameUsing relEnv lang) (fun atom => (I atom).1) :=
  fun env formula envInv =>
    semEnv_equationInvariantUsing relEnv lang I formula env envInv

/-- Formula semantics read in the frame of the generated logic. -/
def langSemUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) : OSLFFormula → Pattern → Prop :=
  semEnv (langSemanticReducesUsing relEnv lang) (equationFrameUsing relEnv lang)
    (fun atom => (I atom).1) ScopeEnv.empty

/-- On a formula of the modal fragment the frame is never consulted, so the two
readings are the same function. -/
theorem langSemUsing_eq_sem_of_modalOnly
    (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (formula : OSLFFormula)
    (modal : OSLFFormula.modalOnly formula = true) :
    langSemUsing relEnv lang I formula
      = sem (langSemanticReducesUsing relEnv lang)
          (fun atom => (I atom).1) formula :=
  semEnv_frame_irrelevant _ _ _ _ formula modal ScopeEnv.empty ScopeEnv.empty

/-- Equation invariance of the ambient-powerset reading, on the formulas for
which the two readings coincide.  Beyond those the powerset intersection is
taken in a lattice the generated logic does not have, and invariance genuinely
fails without monotonicity — which is the reason `langSemUsing` exists. -/
theorem sem_equationInvariantUsing
    (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (formula : OSLFFormula)
    (modal : OSLFFormula.modalOnly formula = true) :
    EquationInvariant (langGSLTUsing relEnv lang)
      (sem (langSemanticReducesUsing relEnv lang)
        (fun atom => (I atom).1) formula) := by
  rw [← langSemUsing_eq_sem_of_modalOnly relEnv lang I formula modal]
  exact semEnv_equationInvariantUsing relEnv lang I formula ScopeEnv.empty
    (equationInvariant_scopeEnv_empty relEnv lang)

/-- Interpret every formula directly in the unique equation-respecting OSLF
predicate frame. -/
def langFormulaSemUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (formula : OSLFFormula) :
    EquationPredicate (langGSLTUsing relEnv lang) :=
  ⟨langSemUsing relEnv lang I formula,
    semEnv_equationInvariantUsing relEnv lang I formula ScopeEnv.empty
      (equationInvariant_scopeEnv_empty relEnv lang)⟩

/-- Default-environment semantic interpretation of formulas. -/
def langFormulaSem (lang : LanguageDef) (I : EquationAtomSem lang) :
    OSLFFormula → EquationPredicate (langGSLT lang) :=
  langFormulaSemUsing RelationEnv.empty lang I

/-- The semantic interpretation agrees pointwise with the formula semantics
read in the frame of the generated logic. -/
theorem langFormulaSemUsing_apply
    (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (formula : OSLFFormula) (term : Pattern) :
    langFormulaSemUsing relEnv lang I formula term ↔
      langSemUsing relEnv lang I formula term := Iff.rfl

/-- Default-environment pointwise agreement. -/
theorem langFormulaSem_apply
    (lang : LanguageDef) (I : EquationAtomSem lang)
    (formula : OSLFFormula) (term : Pattern) :
    langFormulaSem lang I formula term ↔
      langSemUsing RelationEnv.empty lang I formula term := Iff.rfl

/-- On formulas of the modal fragment the semantic interpretation is the
ordinary relational formula semantics over the step-modulo-equations
relation. -/
theorem langFormulaSemUsing_apply_sem_of_modalOnly
    (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (formula : OSLFFormula) (term : Pattern)
    (modal : OSLFFormula.modalOnly formula = true) :
    langFormulaSemUsing relEnv lang I formula term ↔
      sem (langSemanticReducesUsing relEnv lang)
        (fun atom => (I atom).1) formula term := by
  rw [langFormulaSemUsing_apply,
    langSemUsing_eq_sem_of_modalOnly relEnv lang I formula modal]

/-- When a presentation is certified equation-free, admitting raw atomic
observations by saturation and interpreting formulas in the canonical OSLF
recovers ordinary formula semantics over the primitive one-step relation.
This theorem is the equation-free specialization; there is no parallel raw
OSLF construction. -/
theorem langFormulaSemUsing_saturate_iff_of_equation_free
    (relEnv : RelationEnv) {lang : LanguageDef}
    (equationFree : lang.isEquationFree = true)
    (interpretation : AtomSem) (formula : OSLFFormula) (term : Pattern) :
    OSLFFormula.modalOnly formula = true →
    (langFormulaSemUsing relEnv lang
        (saturateAtomSemUsing relEnv lang interpretation) formula term ↔
      sem (langReducesUsing relEnv lang) interpretation formula term) := by
  simp only [langFormulaSemUsing_apply, langSemUsing]
  induction formula generalizing term with
  | emptyColl _ => intro modal; simp [OSLFFormula.modalOnly] at modal
  | cut _ _ _ _ _ => intro modal; simp [OSLFFormula.modalOnly] at modal
  | headed _ _ _ => intro modal; simp [OSLFFormula.modalOnly] at modal
  | top => intro _; rfl
  | bot => intro _; rfl
  | atom atom =>
      intro _
      exact saturatePredicate_langGSLTUsing_apply_iff_of_equation_free
        relEnv equationFree (interpretation atom) term
  | and first second firstIH secondIH =>
      intro modal
      simp only [OSLFFormula.modalOnly, Bool.and_eq_true] at modal
      simp only [sem, semEnv]
      exact and_congr (firstIH term modal.1) (secondIH term modal.2)
  | or first second firstIH secondIH =>
      intro modal
      simp only [OSLFFormula.modalOnly, Bool.and_eq_true] at modal
      simp only [sem, semEnv]
      exact or_congr (firstIH term modal.1) (secondIH term modal.2)
  | imp first second firstIH secondIH =>
      intro modal
      simp only [OSLFFormula.modalOnly, Bool.and_eq_true] at modal
      simp only [sem, semEnv]
      exact imp_congr (firstIH term modal.1) (secondIH term modal.2)
  | dia body bodyIH =>
      intro modal
      simp only [OSLFFormula.modalOnly] at modal
      simp only [sem, semEnv]
      constructor
      · rintro ⟨target, step, holds⟩
        exact ⟨target,
          (langSemanticReducesUsing_iff_langReducesUsing_of_equation_free
            relEnv equationFree term target).mp step,
          (bodyIH target modal).mp holds⟩
      · rintro ⟨target, step, holds⟩
        exact ⟨target,
          (langSemanticReducesUsing_iff_langReducesUsing_of_equation_free
            relEnv equationFree term target).mpr step,
          (bodyIH target modal).mpr holds⟩
  | box body bodyIH =>
      intro modal
      simp only [OSLFFormula.modalOnly] at modal
      simp only [sem, semEnv]
      constructor
      · intro holds source step
        exact (bodyIH source modal).mp
          (holds source
            ((langSemanticReducesUsing_iff_langReducesUsing_of_equation_free
              relEnv equationFree source term).mpr step))
      · intro holds source step
        exact (bodyIH source modal).mpr
          (holds source
            ((langSemanticReducesUsing_iff_langReducesUsing_of_equation_free
              relEnv equationFree source term).mp step))
  | var _ => intro modal; simp [OSLFFormula.modalOnly] at modal
  | mu _ _ => intro modal; simp [OSLFFormula.modalOnly] at modal

/-! ## Connection to OSLF Framework

We show that semantic formula interpretation equals `langDiamond`/`langBox`
from TypeSynthesis.lean. This connects the formula language to the
existing categorical OSLF infrastructure. -/

/-- `sem` of `◇ φ` equals `langDiamond` applied to `sem φ`.

    This follows from the definitions: both compute
    `fun p => ∃ q, langSemanticReduces lang p q ∧ (sem ... φ) q`. -/
theorem sem_dia_eq_langDiamond (lang : LanguageDef)
    (I : EquationAtomSem lang) (φ : OSLFFormula) :
    langFormulaSem lang I (.dia φ) = langDiamond lang (langFormulaSem lang I φ) :=
  by
    apply Subtype.ext
    refine funext (fun (source : Pattern) => ?_)
    apply propext
    rw [langFormulaSem_apply, langDiamond_spec]
    simp only [langSemUsing, semEnv, langFormulaSem_apply]
    exact Iff.rfl

/-- `sem` of `◇ φ` equals `langDiamondUsing` for an explicit relation env. -/
theorem sem_dia_eq_langDiamondUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (φ : OSLFFormula) :
    langFormulaSemUsing relEnv lang I (.dia φ) =
      langDiamondUsing relEnv lang (langFormulaSemUsing relEnv lang I φ) :=
  by
    apply Subtype.ext
    refine funext (fun (source : Pattern) => ?_)
    apply propext
    rw [langFormulaSemUsing_apply, langDiamondUsing_spec]
    simp only [langSemUsing, semEnv, langFormulaSemUsing_apply]

/-- `sem` of `□ φ` equals `langBox` applied to `sem φ`. -/
theorem sem_box_eq_langBox (lang : LanguageDef)
    (I : EquationAtomSem lang) (φ : OSLFFormula) :
    langFormulaSem lang I (.box φ) = langBox lang (langFormulaSem lang I φ) :=
  by
    apply Subtype.ext
    refine funext (fun (target : Pattern) => ?_)
    apply propext
    rw [langFormulaSem_apply, langBox_spec]
    simp only [langSemUsing, semEnv, langFormulaSem_apply]
    exact Iff.rfl

/-- `sem` of `□ φ` equals `langBoxUsing` for an explicit relation env. -/
theorem sem_box_eq_langBoxUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (φ : OSLFFormula) :
    langFormulaSemUsing relEnv lang I (.box φ) =
      langBoxUsing relEnv lang (langFormulaSemUsing relEnv lang I φ) :=
  by
    apply Subtype.ext
    refine funext (fun (target : Pattern) => ?_)
    apply propext
    rw [langFormulaSemUsing_apply, langBoxUsing_spec]
    simp only [langSemUsing, semEnv, langFormulaSemUsing_apply]

/-- Formula-layer `◇` interpreted directly over the internal reduction graph.

This routes formula semantics through the presheaf graph object
(`reductionGraphUsing`) rather than only the binary relation view. -/
theorem sem_dia_eq_graphStepUsing
    (C : Type _) [CategoryTheory.Category C]
    (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (φ : OSLFFormula) {X : Opposite C} :
    (langFormulaSemUsing relEnv lang I (.dia φ)).1 =
      (fun p =>
        ∃ e : (Mettapedia.OSLF.Framework.ToposReduction.reductionGraphUsing
          (C := C) relEnv lang).Edge.obj X,
          ((Mettapedia.OSLF.Framework.ToposReduction.reductionGraphUsing
            (C := C) relEnv lang).source.app X e).down = p ∧
          (langFormulaSemUsing relEnv lang I φ).1
            (((Mettapedia.OSLF.Framework.ToposReduction.reductionGraphUsing
              (C := C) relEnv lang).target.app X e).down)) := by
  funext p
  apply propext
  rw [sem_dia_eq_langDiamondUsing]
  simpa using
    (Mettapedia.OSLF.Framework.ToposReduction.langDiamondUsing_iff_exists_graphStep
      (C := C) (relEnv := relEnv) (lang := lang) (X := X)
      (φ := langFormulaSemUsing relEnv lang I φ) (p := p))

/-- Formula-layer `□` interpreted directly over incoming internal graph edges.

This routes box semantics through the presheaf reduction graph object
(`reductionGraphUsing`) instead of only the binary relation view. -/
theorem sem_box_eq_graphIncomingUsing
    (C : Type _) [CategoryTheory.Category C]
    (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (φ : OSLFFormula) {X : Opposite C} :
    (langFormulaSemUsing relEnv lang I (.box φ)).1 =
      (fun p =>
        ∀ e : (Mettapedia.OSLF.Framework.ToposReduction.reductionGraphUsing
          (C := C) relEnv lang).Edge.obj X,
          ((Mettapedia.OSLF.Framework.ToposReduction.reductionGraphUsing
            (C := C) relEnv lang).target.app X e).down = p →
          (langFormulaSemUsing relEnv lang I φ).1
            (((Mettapedia.OSLF.Framework.ToposReduction.reductionGraphUsing
              (C := C) relEnv lang).source.app X e).down)) := by
  funext p
  apply propext
  rw [sem_box_eq_langBoxUsing]
  simpa using
    (Mettapedia.OSLF.Framework.ToposReduction.langBoxUsing_iff_forall_graphIncoming
      (C := C) (relEnv := relEnv) (lang := lang) (X := X)
      (φ := langFormulaSemUsing relEnv lang I φ) (p := p))

/-- Formula-layer `□` semantics over a packaged `ReductionGraphObj`.

This is the reusable graph-object form, independent of the concrete
`reductionGraphUsing` construction. -/
theorem sem_box_eq_graphObjIncomingUsing
    (C : Type _) [CategoryTheory.Category C]
    (relEnv : RelationEnv) (lang : LanguageDef)
    (G : Mettapedia.OSLF.Framework.ToposReduction.ReductionGraphObj C relEnv lang)
    (I : EquationAtomSemUsing relEnv lang) (φ : OSLFFormula) {X : Opposite C} :
    (langFormulaSemUsing relEnv lang I (.box φ)).1 =
      (fun p =>
        ∀ e : G.Edge.obj X,
          (G.target.app X e).down = p →
          (langFormulaSemUsing relEnv lang I φ).1
            ((G.source.app X e).down)) := by
  funext p
  apply propext
  rw [sem_box_eq_langBoxUsing]
  exact
    (Mettapedia.OSLF.Framework.ToposReduction.langBoxUsing_iff_forall_graphObjIncoming
      (C := C) (relEnv := relEnv) (lang := lang) (G := G) (X := X)
      (φ := langFormulaSemUsing relEnv lang I φ) (p := p))

/-- Default-env wrapper for graph-form `□` formula semantics. -/
theorem sem_box_eq_graphIncoming
    (C : Type _) [CategoryTheory.Category C]
    (lang : LanguageDef)
    (I : EquationAtomSem lang) (φ : OSLFFormula) {X : Opposite C} :
    (langFormulaSem lang I (.box φ)).1 =
      (fun p =>
        ∀ e : (Mettapedia.OSLF.Framework.ToposReduction.reductionGraph
          (C := C) lang).Edge.obj X,
          ((Mettapedia.OSLF.Framework.ToposReduction.reductionGraph
            (C := C) lang).target.app X e).down = p →
          (langFormulaSem lang I φ).1
            (((Mettapedia.OSLF.Framework.ToposReduction.reductionGraph
              (C := C) lang).source.app X e).down)) := by
  exact
    (sem_box_eq_graphIncomingUsing (C := C) (relEnv := RelationEnv.empty)
      (lang := lang) (I := I) (φ := φ) (X := X))

/-- The formula-level Galois connection follows from the framework.

    Since `sem (.dia φ) = langDiamond (sem φ)` and `sem (.box φ) = langBox (sem φ)`,
    the Galois connection `langGalois` lifts directly to formulas. -/
theorem formula_galois (lang : LanguageDef) (I : EquationAtomSem lang)
    (φ ψ : OSLFFormula) :
    (∀ p, langFormulaSem lang I (.dia φ) p → langFormulaSem lang I ψ p) ↔
    (∀ p, langFormulaSem lang I φ p → langFormulaSem lang I (.box ψ) p) := by
  rw [sem_dia_eq_langDiamond, sem_box_eq_langBox]
  have hg := langGalois lang
  exact hg (langFormulaSem lang I φ) (langFormulaSem lang I ψ)

/-- Formula-level Galois connection for explicit relation env. -/
theorem formula_galoisUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (I : EquationAtomSemUsing relEnv lang) (φ ψ : OSLFFormula) :
    (∀ p, langFormulaSemUsing relEnv lang I (.dia φ) p →
      langFormulaSemUsing relEnv lang I ψ p) ↔
    (∀ p, langFormulaSemUsing relEnv lang I φ p →
      langFormulaSemUsing relEnv lang I (.box ψ) p) := by
  rw [sem_dia_eq_langDiamondUsing, sem_box_eq_langBoxUsing]
  have hg := langGaloisUsing relEnv lang
  exact hg (langFormulaSemUsing relEnv lang I φ)
    (langFormulaSemUsing relEnv lang I ψ)

/-- SC-empty representatives are unsatisfiable for `◇⊤` over the specialized
    executable ρ one-step relation (`reduceStep`). -/
theorem rhoCalc_SC_empty_sem_diaTop_unsat_reduceStep
    (I : AtomSem) {p : Pattern}
    (hsc : Mettapedia.Languages.ProcessCalculi.RhoCalculus.StructuralCongruence
      (.collection .hashBag [] none) p) :
    ¬ sem (fun a b => b ∈ reduceStep a) I (.dia .top) p := by
  intro hsem
  rcases hsem with ⟨q, hstep, _⟩
  exact (rhoCalc_SC_emptyBag_reduceStep_irreducible (hsc := hsc) (q := q)) hstep

/-! ## Bounded Model Checker -/

/-- Result of checking a formula against a term. -/
inductive CheckResult where
  | sat     : CheckResult
  | unsat   : CheckResult
  | unknown : CheckResult
  deriving DecidableEq, Repr, BEq

instance : ToString CheckResult where
  toString
    | .sat => "sat"
    | .unsat => "unsat"
    | .unknown => "unknown"

/-- Decidable interpretation of atomic predicates for the checker. -/
abbrev AtomCheck := String → Pattern → Bool

/-- Aggregate check results for disjunctive (◇) checking.

    Given a list of check results from checking φ on each successor:
    - If any is `.sat`, return `.sat` (witness found)
    - If all are `.unsat`, return `.unsat` (no witness possible)
    - Otherwise return `.unknown` -/
def aggregateDia : List CheckResult → CheckResult
  | [] => .unsat
  | .sat :: _ => .sat
  | .unsat :: rest => aggregateDia rest
  | .unknown :: rest =>
    match aggregateDia rest with
    | .sat => .sat
    | _ => .unknown

/-- Every positional split of a collection's elements into a prefix and a
suffix: the decompositions a checker can exhibit. -/
def cutSplits (kind : CollType) (elements : List Pattern) : List (Pattern × Pattern) :=
  (List.range (elements.length + 1)).map fun index =>
    (Pattern.collection kind (elements.take index) none,
      Pattern.collection kind (elements.drop index) none)

/-- Bounded model checker for OSLF formulas.

    Evaluates whether a term `p` satisfies a formula `φ` using:
    - `step`: forward step function producing successors
    - `I`: decidable atomic predicate checker
    - `fuel`: depth bound (decremented on every recursive call)

    Returns `.sat` / `.unsat` / `.unknown`.

    **Soundness**: when `check` returns `.sat`, the denotational semantics `sem`
    holds (proven in `check_sat_sound`).

    **Design**: `fuel` decreases on EVERY recursive call (not just `dia`) to
    keep the termination argument simple. With `fuel = 100`, formulas with up to
    ~50 nesting levels work fine.

    **Limitations**:
    - `box` always returns `.unknown` (step-past □ requires enumerating predecessors)
    - `imp` only returns `.sat` when the consequent is `.sat` (conservative but sound) -/
def check (step : Pattern → List Pattern) (I : AtomCheck)
    (fuel : Nat) (p : Pattern) (φ : OSLFFormula) : CheckResult :=
  match fuel with
  | 0 => .unknown
  | fuel + 1 =>
    match φ with
    | .top => .sat
    | .bot => .unsat
    | .atom a => if I a p then .sat else .unsat
    | .and φ₁ φ₂ =>
      match check step I fuel p φ₁, check step I fuel p φ₂ with
      | .sat, .sat => .sat
      | .unsat, _ => .unsat
      | _, .unsat => .unsat
      | _, _ => .unknown
    | .or φ₁ φ₂ =>
      match check step I fuel p φ₁, check step I fuel p φ₂ with
      | .sat, _ => .sat
      | _, .sat => .sat
      | .unsat, .unsat => .unsat
      | _, _ => .unknown
    | .imp _ φ₂ =>
      -- Sound: only return .sat when the consequent is provably .sat.
      -- (.unsat from checker doesn't guarantee ¬sem, so can't use vacuous truth)
      match check step I fuel p φ₂ with
      | .sat => .sat
      | _ => .unknown
    | .dia φ' =>
      aggregateDia ((step p).map fun q => check step I fuel q φ')
    | .box _ => .unknown
    -- A scope variable is not a closed formula; it can only appear under its
    -- own binder, which the generator arm has already discharged.
    | .var _ => .unknown
    -- A generator is decided by descent: one unfolding per unit of fuel.  The
    -- guard is exactly the hypothesis of the fixed point law, so the arm is
    -- checking the generator itself and not an approximation of it.
    | .mu φ' =>
      if OSLFFormula.closedAt 1 φ' && OSLFFormula.positiveIn 0 φ' then
        check step I fuel p (OSLFFormula.unfold φ')
      else
        .unknown
    -- A structural connective is decided positionally: the checker answers
    -- `.sat` on a decomposition it can see, and `.unknown` otherwise, because
    -- a term equal to one modulo the equations is not one it can exhibit.
    | .emptyColl kind =>
      if p == Pattern.collection kind [] none then .sat else .unknown
    | .cut kind left right =>
      match p with
      | .collection kind' elements none =>
        if kind' == kind then
          aggregateDia ((cutSplits kind elements).map fun split =>
            match check step I fuel split.1 left, check step I fuel split.2 right with
            | .sat, .sat => .sat
            | _, _ => .unknown)
        else .unknown
      | _ => .unknown
    | .headed label body =>
      match p with
      | .apply label' [inner] =>
        if label' == label then check step I fuel inner body else .unknown
      | _ => .unknown

/-- Formula checker entrypoint bound to a `LanguageDef` and explicit relation env. -/
def checkLangUsing (relEnv : RelationEnv) (lang : LanguageDef) (I : AtomCheck)
    (fuel : Nat) (p : Pattern) (φ : OSLFFormula) : CheckResult :=
  check (rewriteAt (engineBasePremises relEnv) lang fuel) I fuel p φ

/-- Formula checker entrypoint bound to a `LanguageDef` (default env). -/
def checkLang (lang : LanguageDef) (I : AtomCheck)
    (fuel : Nat) (p : Pattern) (φ : OSLFFormula) : CheckResult :=
  checkLangUsing RelationEnv.empty lang I fuel p φ

/-! ## Soundness -/

/-- `aggregateDia` returning `.sat` means some input element is `.sat`. -/
theorem aggregateDia_sat {results : List CheckResult}
    (h : aggregateDia results = .sat) :
    ∃ r ∈ results, r = CheckResult.sat := by
  induction results with
  | nil => simp [aggregateDia] at h
  | cons hd tl ih =>
    cases hd with
    | sat => exact ⟨.sat, List.mem_cons_self, rfl⟩
    | unsat =>
      -- aggregateDia (.unsat :: tl) = aggregateDia tl
      simp only [aggregateDia] at h
      obtain ⟨r, hr, heq⟩ := ih h
      exact ⟨r, List.mem_cons_of_mem _ hr, heq⟩
    | unknown =>
      -- aggregateDia (.unknown :: tl) = match aggregateDia tl with | .sat => .sat | _ => .unknown
      have hagg : aggregateDia tl = .sat := by
        simp only [aggregateDia] at h
        cases htl : aggregateDia tl with
        | sat => rfl
        | unsat => rw [htl] at h; simp at h
        | unknown => rw [htl] at h; simp at h
      obtain ⟨r, hr, heq⟩ := ih hagg
      exact ⟨r, List.mem_cons_of_mem _ hr, heq⟩

/-- Helper: if `check` returns `.sat` at a decreased fuel level,
    and the result is in a mapped list, we can extract the witness. -/
private theorem check_sat_of_map {step : Pattern → List Pattern}
    {I : AtomCheck} {fuel : Nat} {φ : OSLFFormula}
    {succs : List Pattern} {r : CheckResult}
    (hr_mem : r ∈ succs.map (fun q => check step I fuel q φ))
    (hr_sat : r = CheckResult.sat) :
    ∃ q ∈ succs, check step I fuel q φ = .sat := by
  rw [List.mem_map] at hr_mem
  obtain ⟨q, hq_mem, hq_eq⟩ := hr_mem
  exact ⟨q, hq_mem, hr_sat ▸ hq_eq⟩

/-- Soundness of the bounded model checker.

    If `check` returns `.sat`, then the denotational semantics `sem` holds.

    **Hypotheses**:
    - `h_atoms`: atom checker is sound w.r.t. atom semantics
    - `h_step`: step function is sound w.r.t. reduction relation R

    The proof proceeds by induction on `fuel`. -/
theorem check_semEnv_sat_sound
    {R : Pattern → Pattern → Prop} {F : PredFrame}
    {step : Pattern → List Pattern}
    {I_check : AtomCheck} {I_sem : AtomSem}
    (frameClosed : FrameClosed R F I_sem)
    (emptyMem : ∀ index, F.Mem (ScopeEnv.empty index))
    (h_atoms : ∀ a p, I_check a p = true → I_sem a p)
    (h_step : ∀ p q, q ∈ step p → R p q)
    {fuel : Nat} {p : Pattern} {φ : OSLFFormula}
    (h : check step I_check fuel p φ = .sat) :
    semEnv R F I_sem ScopeEnv.empty φ p := by
  induction fuel generalizing p φ with
  | zero => simp [check] at h
  | succ n ih =>
    cases φ with
    | top => exact trivial
    | emptyColl kind =>
      simp only [check] at h
      split at h
      · rename_i shape
        simp only [beq_iff_eq] at shape
        simp only [semEnv]
        exact F.le_close _ p shape
      · exact absurd h (by simp)
    | headed label body =>
      simp only [check] at h
      split at h
      · rename_i labelVar inner
        split at h
        · rename_i sameLabel
          simp only [beq_iff_eq] at sameLabel
          subst sameLabel
          simp only [semEnv]
          exact F.le_close _ _ ⟨inner, rfl, ih h⟩
        · exact absurd h (by simp)
      · exact absurd h (by simp)
    | cut kind left right =>
      simp only [check] at h
      split at h
      · rename_i kindVar elements
        split at h
        · rename_i sameKind
          simp only [beq_iff_eq] at sameKind
          subst sameKind
          obtain ⟨result, resultMember, resultSat⟩ := aggregateDia_sat h
          obtain ⟨split, splitMember, resultEq⟩ := List.mem_map.mp resultMember
          obtain ⟨index, -, splitEq⟩ := List.mem_map.mp splitMember
          subst splitEq
          subst resultEq
          simp only at resultSat
          split at resultSat
          · rename_i leftSat rightSat
            simp only [semEnv]
            refine F.le_close _ _ ⟨elements.take index, elements.drop index, ?_,
              ih leftSat, ih rightSat⟩
            rw [List.take_append_drop]
          · exact absurd resultSat (by simp)
        · exact absurd h (by simp)
      · exact absurd h (by simp)
    | bot => simp [check] at h
    | atom a =>
      unfold check at h
      simp at h
      exact h_atoms a p h
    | and φ₁ φ₂ =>
      simp only [semEnv]
      have hand : check step I_check n p φ₁ = .sat ∧ check step I_check n p φ₂ = .sat := by
        simp only [check] at h; revert h; split <;> intro h <;> simp_all
      exact ⟨ih hand.1, ih hand.2⟩
    | or φ₁ φ₂ =>
      simp only [semEnv]
      have hor : check step I_check n p φ₁ = .sat ∨ check step I_check n p φ₂ = .sat := by
        simp only [check] at h; revert h; split <;> intro h <;> simp_all
      cases hor with
      | inl h₁ => exact Or.inl (ih h₁)
      | inr h₂ => exact Or.inr (ih h₂)
    | imp φ₁ φ₂ =>
      simp only [semEnv]
      have hφ₂ : check step I_check n p φ₂ = .sat := by
        simp only [check] at h; revert h; split <;> intro h <;> simp_all
      intro _
      exact ih hφ₂
    | dia φ' =>
      unfold check at h
      simp only [semEnv]
      obtain ⟨r, hr_mem, hr_sat⟩ := aggregateDia_sat h
      obtain ⟨q, hq_mem, hq_check⟩ := check_sat_of_map hr_mem hr_sat
      exact ⟨q, h_step p q hq_mem, ih hq_check⟩
    | box _ =>
      simp [check] at h
    | var _ =>
      simp [check] at h
    | mu φ' =>
      simp only [check] at h
      split at h
      · rename_i guard
        simp only [Bool.and_eq_true] at guard
        rw [semEnv_mu_eq_unfold R F I_sem frameClosed φ' guard.1 guard.2
          ScopeEnv.empty emptyMem]
        exact ih h
      · simp at h

/-- Soundness of the bounded checker against the ambient-powerset semantics. -/
theorem check_sat_sound
    {R : Pattern → Pattern → Prop}
    {step : Pattern → List Pattern}
    {I_check : AtomCheck} {I_sem : AtomSem}
    (h_atoms : ∀ a p, I_check a p = true → I_sem a p)
    (h_step : ∀ p q, q ∈ step p → R p q)
    {fuel : Nat} {p : Pattern} {φ : OSLFFormula}
    (h : check step I_check fuel p φ = .sat) :
    sem R I_sem φ p :=
  check_semEnv_sat_sound (F := fullFrame) (frameClosed_full R I_sem)
    (fun _ => trivial) h_atoms h_step h

/-- Soundness of `checkLangUsing` with explicit relation env. -/
theorem checkLangUsing_sat_sound
    {relEnv : RelationEnv} {lang : LanguageDef}
    {I_check : AtomCheck} {I_sem : EquationAtomSemUsing relEnv lang}
    (h_atoms : ∀ a p, I_check a p = true → (I_sem a).1 p)
    {fuel : Nat} {p : Pattern} {φ : OSLFFormula}
    (h : checkLangUsing relEnv lang I_check fuel p φ = .sat) :
    langFormulaSemUsing relEnv lang I_sem φ p := by
  apply (langFormulaSemUsing_apply relEnv lang I_sem φ p).2
  exact check_semEnv_sat_sound
    (R := langSemanticReducesUsing relEnv lang)
    (F := equationFrameUsing relEnv lang)
    (step := rewriteAt (engineBasePremises relEnv) lang fuel)
    (I_check := I_check) (I_sem := fun atom => (I_sem atom).1)
    (frameClosed := frameClosed_equationFrameUsing relEnv lang I_sem)
    (emptyMem := equationInvariant_scopeEnv_empty relEnv lang)
    (h_atoms := h_atoms)
    (h_step := fun p q hq =>
      langReducesUsing_to_semantic relEnv lang
        (exec_to_langReducesUsing relEnv lang ⟨fuel, hq⟩))
    (h := h)

