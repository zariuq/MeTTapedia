import Mettapedia.GSLT.Core.GSLT
import Mettapedia.OSLF.Framework.DerivedModalities
import Mettapedia.OSLF.Framework.RewriteSystem

/-!
# OSLF synthesis from an abstract GSLT

The concrete `LanguageDef` synthesis builds its reduction span from the
MeTTaIL reduction engine.  At the mathematical boundary, however, OSLF needs
only the reduction relation of a GSLT.  This module records that direct route:
every GSLT supplies a reduction span, hence the derived diamond/box adjunction.

This module keeps the authored term carrier while deriving the semantic
predicate frame over its equation classes.  A native predicate is therefore a
predicate on authored terms together with the law that it cannot distinguish
equation-equivalent presentations.  Raw predicate generators are interpreted
by their least equation-saturated extension.  The resulting construction is
the OSLF of the GSLT; equations are not an optional companion layer.

The construction does not make a relation executable.  Executable evidence
for an edge is a separate proof/checker authority.  This separation is what
allows one OSLF trace theory to cover syntactic rewriting, collection
decomposition, reflective queries, and capability-backed steps without
pretending that all of them use the same matcher.
-/

namespace Mettapedia.OSLF.Framework.GSLTTypeSynthesis

open Mettapedia.GSLT
open Mettapedia.OSLF.Framework.DerivedModalities
open Mettapedia.OSLF.Framework

universe uTheory uSort

/-! ## The OSLF input generated by an abstract GSLT -/

/-- Equip an arbitrary one-step relation with syntactic equality as its
equation theory. This is the checked `E = equality` specialization used for
relations that do not declare additional equations; it still feeds the one
canonical OSLF construction. -/
def equalityGSLT (Term : Type uTheory) (rewrites : Term → Term → Prop) :
    GSLT.{uTheory} where
  Term := Term
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites := rewrites
  rewrites_resp_left := by
    rintro source _ target rfl step
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    rintro source target _ step rfl
    exact step

@[simp]
theorem equalityGSLT_equiv (Term : Type uTheory)
    (rewrites : Term → Term → Prop) (left right : Term) :
    (equalityGSLT Term rewrites).Equiv left right ↔ left = right :=
  Iff.rfl

@[simp]
theorem equalityGSLT_step (Term : Type uTheory)
    (rewrites : Term → Term → Prop) (source target : Term) :
    (equalityGSLT Term rewrites).Step source target ↔ rewrites source target :=
  Iff.rfl

/-- Reindex one GSLT term theory over an external family of sort names.  This
is a constant-fibre presentation: every sort retains the same authored term
carrier, and the distinguished process sort carries the GSLT step relation.
It is the common adapter used by both one-sorted GSLTs and string-sorted
`LanguageDef` clients. -/
def sortedGSLTRewriteSystem (theory : GSLT.{uTheory})
    (Sorts : Type uSort) (procSort : Sorts) : RewriteSystem where
  Sorts := Sorts
  procSort := procSort
  Term := fun _ => theory.Term
  Reduces := theory.Step

/-- Regard an abstract GSLT as a one-sorted OSLF rewrite system.  The GSLT
step relation is equation-saturated, while the authored term carrier remains
available to parsing, quotation, and execution. -/
def gsltRewriteSystem (theory : GSLT.{uTheory}) : RewriteSystem :=
  sortedGSLTRewriteSystem theory Unit ()

/-- The graph of the one-step relation of an arbitrary GSLT, as the reduction
span consumed by OSLF change-of-base. -/
def gsltSpan (theory : GSLT.{uTheory}) : ReductionSpan theory.Term where
  Edge := theory.LabeledStep
  source := GSLT.LabeledStep.source
  target := GSLT.LabeledStep.target

/-- Edges of the generated span are exactly GSLT one-step reductions. -/
theorem gsltSpan_edge_iff_step (theory : GSLT.{uTheory})
    (source target : theory.Term) :
    (∃ edge : (gsltSpan theory).Edge,
        (gsltSpan theory).source edge = source ∧
          (gsltSpan theory).target edge = target) ↔
      theory.Step source target := by
  constructor
  · rintro ⟨edge, sourceEq, targetEq⟩
    cases edge with
    | mk edgeSource edgeTarget step =>
        simp only [gsltSpan] at sourceEq targetEq
        subst sourceEq
        subst targetEq
        exact step
  · intro step
    exact ⟨⟨source, target, step⟩, rfl, rfl⟩

/-- OSLF step-future modality generated by a GSLT. -/
def gsltDiamond (theory : GSLT.{uTheory}) :
    (theory.Term → Prop) → theory.Term → Prop :=
  derivedDiamond (gsltSpan theory)

/-- OSLF step-past modality generated by a GSLT. -/
def gsltBox (theory : GSLT.{uTheory}) :
    (theory.Term → Prop) → theory.Term → Prop :=
  derivedBox (gsltSpan theory)

/-- The OSLF adjunction is generated for every GSLT without a
language-specific proof. -/
theorem gsltGalois (theory : GSLT.{uTheory}) :
    GaloisConnection (gsltDiamond theory) (gsltBox theory) :=
  derived_galois (gsltSpan theory)

/-- Concrete meaning of the generated diamond. -/
theorem gsltDiamond_spec (theory : GSLT.{uTheory})
    (predicate : theory.Term → Prop) (source : theory.Term) :
    gsltDiamond theory predicate source ↔
      ∃ target, theory.Step source target ∧ predicate target := by
  simp only [gsltDiamond, derivedDiamond, di, pb, Function.comp, gsltSpan]
  constructor
  · rintro ⟨edge, sourceEq, targetMeaning⟩
    exact ⟨edge.target, sourceEq ▸ edge.step, targetMeaning⟩
  · rintro ⟨target, step, targetMeaning⟩
    exact ⟨⟨source, target, step⟩, rfl, targetMeaning⟩

/-- An exact one-step claim is the generated diamond of the singleton target
predicate.  This is the OSLF/NTT meaning checked by a local step article. -/
theorem gsltDiamond_singleton_iff_step (theory : GSLT.{uTheory})
    (source target : theory.Term) :
    gsltDiamond theory (fun candidate => candidate = target) source ↔
      theory.Step source target := by
  rw [gsltDiamond_spec]
  constructor
  · rintro ⟨candidate, step, rfl⟩
    exact step
  · intro step
    exact ⟨target, step, rfl⟩

/-- Concrete meaning of the generated box.  OSLF's right adjoint is
predecessor-universal, matching the orientation of `derivedBox`. -/
theorem gsltBox_spec (theory : GSLT.{uTheory})
    (predicate : theory.Term → Prop) (target : theory.Term) :
    gsltBox theory predicate target ↔
      ∀ source, theory.Step source target → predicate source := by
  simp only [gsltBox, derivedBox, ui, pb, Function.comp, gsltSpan]
  constructor
  · intro universal source step
    exact universal ⟨source, target, step⟩ rfl
  · rintro universal ⟨source, edgeTarget, step⟩ targetEq
    simp only at targetEq
    subst targetEq
    exact universal source step

/-! ## Equation-respecting native predicates -/

/-- A predicate is semantic for a GSLT when it cannot distinguish authored
terms identified by the equation theory. -/
def EquationInvariant (theory : GSLT.{uTheory})
    (predicate : theory.Term → Prop) : Prop :=
  ∀ ⦃left right : theory.Term⦄,
    theory.Equiv left right → (predicate left ↔ predicate right)

/-- Predicates on authored terms equipped with their equation-invariance
law.  Keeping the authored carrier avoids forcing programs through a second
term representation while retaining exactly the predicates on `Term / E`. -/
abbrev EquationPredicate (theory : GSLT.{uTheory}) :=
  { predicate : theory.Term → Prop // EquationInvariant theory predicate }

/-- Semantic predicates may be applied directly to authored terms; the
subtype proof remains available as `.2`. -/
instance (theory : GSLT.{uTheory}) :
    CoeFun (EquationPredicate theory) (fun _ => theory.Term → Prop) where
  coe predicate := predicate.1

/-- An invariant authored-term predicate descends to equation classes. -/
def descendPredicate (theory : GSLT.{uTheory})
    (predicate : EquationPredicate theory) :
    Quotient theory.equations → Prop :=
  Quotient.lift predicate.1 fun _ _ equivalent =>
    propext (predicate.2 equivalent)

/-- A predicate on equation classes lifts to an invariant predicate on
authored representatives. -/
def liftPredicate (theory : GSLT.{uTheory})
    (predicate : Quotient theory.equations → Prop) :
    EquationPredicate theory where
  val term := predicate (Quotient.mk theory.equations term)
  property := by
    intro left right equivalent
    change predicate (Quotient.mk theory.equations left) ↔
      predicate (Quotient.mk theory.equations right)
    rw [Quotient.sound equivalent]

@[simp]
theorem descendPredicate_mk (theory : GSLT.{uTheory})
    (predicate : EquationPredicate theory) (term : theory.Term) :
    descendPredicate theory predicate (Quotient.mk theory.equations term) =
      predicate.1 term :=
  rfl

/-- Invariant predicates on the authored presentation are exactly predicates
on its semantic equation classes. -/
def equationPredicatesEquiv (theory : GSLT.{uTheory}) :
    EquationPredicate theory ≃ (Quotient theory.equations → Prop) where
  toFun := descendPredicate theory
  invFun := liftPredicate theory
  left_inv predicate := by
    apply Subtype.ext
    funext term
    rfl
  right_inv predicate := by
    funext semanticTerm
    refine Quotient.inductionOn semanticTerm ?_
    intro representative
    rfl

/-- The predicate equivalence preserves and reflects implication. -/
def equationPredicatesOrderIso (theory : GSLT.{uTheory}) :
    EquationPredicate theory ≃o (Quotient theory.equations → Prop) where
  toEquiv := equationPredicatesEquiv theory
  map_rel_iff' := by
    intro first second
    constructor
    · intro implication representative
      exact implication (Quotient.mk theory.equations representative)
    · intro implication semanticTerm
      induction semanticTerm using Quotient.inductionOn with
      | _ representative => exact implication representative

/-! ## Equation-respecting change of base -/

/-- A map between authored term carriers that is well defined on semantic
equation classes. This is the exact obligation needed before substitution,
translation, or any other term operation may act on OSLF predicates. -/
structure EquationRespectingMap (source target : GSLT.{uTheory}) where
  toFun : source.Term → target.Term
  map_equiv : ∀ {left right}, source.Equiv left right →
    target.Equiv (toFun left) (toFun right)

namespace EquationRespectingMap

/-- The induced function on semantic equation classes. -/
def onClasses {source target : GSLT.{uTheory}}
    (map : EquationRespectingMap source target) :
    Quotient source.equations → Quotient target.equations :=
  Quotient.map map.toFun fun _ _ equivalent => map.map_equiv equivalent

/-- Predicate pullback along an equation-respecting map. -/
def pullback {source target : GSLT.{uTheory}}
    (map : EquationRespectingMap source target)
    (predicate : EquationPredicate target) : EquationPredicate source :=
  liftPredicate source
    (pb map.onClasses (descendPredicate target predicate))

/-- Existential direct image along an equation-respecting map. -/
def directImage {source target : GSLT.{uTheory}}
    (map : EquationRespectingMap source target)
    (predicate : EquationPredicate source) : EquationPredicate target :=
  liftPredicate target
    (di map.onClasses (descendPredicate source predicate))

/-- Universal image along an equation-respecting map. -/
def universalImage {source target : GSLT.{uTheory}}
    (map : EquationRespectingMap source target)
    (predicate : EquationPredicate source) : EquationPredicate target :=
  liftPredicate target
    (ui map.onClasses (descendPredicate source predicate))

/-- Existential image is left adjoint to semantic pullback. -/
theorem directImage_pullback_galois
    {source target : GSLT.{uTheory}}
    (map : EquationRespectingMap source target) :
    GaloisConnection map.directImage map.pullback := by
  intro sourcePredicate targetPredicate
  change (map.directImage sourcePredicate).1 ≤ targetPredicate.1 ↔
    sourcePredicate.1 ≤ (map.pullback targetPredicate).1
  constructor
  · intro imageBelow sourceTerm sourceHolds
    apply imageBelow (map.toFun sourceTerm)
    change ∃ sourceClass,
      map.onClasses sourceClass =
          Quotient.mk target.equations (map.toFun sourceTerm) ∧
        descendPredicate source sourcePredicate sourceClass
    exact ⟨Quotient.mk source.equations sourceTerm, rfl, sourceHolds⟩
  · intro pullbackBelow targetTerm imageHolds
    change ∃ sourceClass,
      map.onClasses sourceClass = Quotient.mk target.equations targetTerm ∧
        descendPredicate source sourcePredicate sourceClass at imageHolds
    obtain ⟨sourceClass, imageEq, sourceHolds⟩ := imageHolds
    induction sourceClass using Quotient.inductionOn with
    | _ sourceTerm =>
        have targetAtImage : targetPredicate.1 (map.toFun sourceTerm) :=
          pullbackBelow sourceTerm sourceHolds
        exact (targetPredicate.2 (Quotient.exact imageEq)).mp targetAtImage

/-- Semantic pullback is left adjoint to universal image. -/
theorem pullback_universalImage_galois
    {source target : GSLT.{uTheory}}
    (map : EquationRespectingMap source target) :
    GaloisConnection map.pullback map.universalImage := by
  intro targetPredicate sourcePredicate
  change (map.pullback targetPredicate).1 ≤ sourcePredicate.1 ↔
    targetPredicate.1 ≤ (map.universalImage sourcePredicate).1
  constructor
  · intro pullbackBelow targetTerm targetHolds
    change ∀ sourceClass,
      map.onClasses sourceClass = Quotient.mk target.equations targetTerm →
        descendPredicate source sourcePredicate sourceClass
    intro sourceClass imageEq
    induction sourceClass using Quotient.inductionOn with
    | _ sourceTerm =>
        apply pullbackBelow sourceTerm
        exact (targetPredicate.2 (Quotient.exact imageEq)).mpr targetHolds
  · intro belowUniversal sourceTerm targetHolds
    have universalAtImage := belowUniversal (map.toFun sourceTerm) targetHolds
    exact universalAtImage (Quotient.mk source.equations sourceTerm) rfl

end EquationRespectingMap

/-- The semantic predicate carrier has the complete Heyting algebra structure
of predicates on equation classes.  This is the single lattice used by OSLF;
it is transported across the proved predicate/quotient equivalence rather than
inherited from all raw syntax predicates. -/
noncomputable instance equationPredicateFrame (theory : GSLT.{uTheory}) :
    Order.Frame (EquationPredicate theory) :=
  (equationPredicatesEquiv theory).frame

/-- The least equation-invariant predicate containing a raw predicate
generator.  Thus a singleton syntax pattern denotes its whole equation class
when used as an OSLF atom. -/
def saturatePredicate (theory : GSLT.{uTheory})
    (predicate : theory.Term → Prop) : EquationPredicate theory where
  val term := ∃ representative,
    theory.Equiv term representative ∧ predicate representative
  property := by
    intro left right equivalent
    constructor
    · rintro ⟨representative, leftEquivalent, holds⟩
      exact ⟨representative,
        theory.equations.iseqv.trans
          (theory.equations.iseqv.symm equivalent) leftEquivalent,
        holds⟩
    · rintro ⟨representative, rightEquivalent, holds⟩
      exact ⟨representative,
        theory.equations.iseqv.trans equivalent rightEquivalent,
        holds⟩

@[simp]
theorem saturatePredicate_apply (theory : GSLT.{uTheory})
    (predicate : theory.Term → Prop) (term : theory.Term) :
    saturatePredicate theory predicate term ↔
      ∃ representative,
        theory.Equiv term representative ∧ predicate representative :=
  Iff.rfl

/-- Saturation is literally transparent when the theory's equations are
equality.  This is the theorem, rather than a retained equation-blind OSLF,
that recovers the equation-free case. -/
theorem saturatePredicate_apply_iff_of_equiv_iff_eq
    (theory : GSLT.{uTheory})
    (equivIffEq : ∀ left right, theory.Equiv left right ↔ left = right)
    (predicate : theory.Term → Prop) (term : theory.Term) :
    saturatePredicate theory predicate term ↔ predicate term := by
  constructor
  · rintro ⟨representative, equivalent, holds⟩
    simpa [(equivIffEq term representative).mp equivalent] using holds
  · intro holds
    exact ⟨term, (equivIffEq term term).mpr rfl, holds⟩

/-- An already invariant predicate is unchanged by equation saturation. -/
theorem saturatePredicate_apply_iff_of_invariant
    (theory : GSLT.{uTheory})
    (predicate : theory.Term → Prop)
    (invariant : EquationInvariant theory predicate)
    (term : theory.Term) :
    saturatePredicate theory predicate term ↔ predicate term := by
  constructor
  · rintro ⟨representative, equivalent, holds⟩
    exact (invariant equivalent).mpr holds
  · intro holds
    exact ⟨term, theory.equations.iseqv.refl term, holds⟩

/-- Package an authored observation once its equation-invariance law has been
proved. -/
def invariantPredicate (theory : GSLT.{uTheory})
    (predicate : theory.Term → Prop)
    (invariant : EquationInvariant theory predicate) :
    EquationPredicate theory :=
  ⟨predicate, invariant⟩

/-- Raw predicate generators enter OSLF only through equation saturation. -/
instance (theory : GSLT.{uTheory}) :
    Coe (theory.Term → Prop) (EquationPredicate theory) :=
  ⟨saturatePredicate theory⟩

/-! ## Equation-respecting modalities -/

/-- The GSLT response laws make diamond preserve equation invariance. -/
theorem gsltDiamond_equationInvariant (theory : GSLT.{uTheory})
    (predicate : theory.Term → Prop)
    (invariant : EquationInvariant theory predicate) :
    EquationInvariant theory (gsltDiamond theory predicate) := by
  intro left right equivalent
  rw [gsltDiamond_spec, gsltDiamond_spec]
  constructor
  · rintro ⟨target, step, holds⟩
    obtain ⟨target', step', targetEquivalent⟩ :=
      theory.rewrites_resp_left equivalent step
    exact ⟨target', step', (invariant targetEquivalent).mp holds⟩
  · rintro ⟨target, step, holds⟩
    obtain ⟨target', step', targetEquivalent⟩ :=
      theory.rewrites_resp_left
        (theory.equations.iseqv.symm equivalent) step
    exact ⟨target', step', (invariant targetEquivalent).mp holds⟩

/-- The GSLT response laws make box equation-invariant. -/
theorem gsltBox_equationInvariant (theory : GSLT.{uTheory})
    (predicate : theory.Term → Prop) :
    EquationInvariant theory (gsltBox theory predicate) := by
  intro left right equivalent
  rw [gsltBox_spec, gsltBox_spec]
  constructor
  · intro holds source step
    have sourceStep : theory.Step source left :=
      theory.rewrites_resp_right step
        (theory.equations.iseqv.symm equivalent)
    exact holds source sourceStep
  · intro holds source step
    have sourceStep : theory.Step source right :=
      theory.rewrites_resp_right step equivalent
    exact holds source sourceStep

/-- Step-future on the semantic predicate frame. -/
def semanticDiamond (theory : GSLT.{uTheory})
    (predicate : EquationPredicate theory) : EquationPredicate theory :=
  ⟨gsltDiamond theory predicate.1,
    gsltDiamond_equationInvariant theory predicate.1 predicate.2⟩

/-- Step-past on the semantic predicate frame. -/
def semanticBox (theory : GSLT.{uTheory})
    (predicate : EquationPredicate theory) : EquationPredicate theory :=
  ⟨gsltBox theory predicate.1,
    gsltBox_equationInvariant theory predicate.1⟩

/-- Diamond and box remain adjoint after restricting observations to
equation-invariant predicates. -/
theorem semanticGalois (theory : GSLT.{uTheory}) :
    GaloisConnection (semanticDiamond theory) (semanticBox theory) := by
  intro first second
  change gsltDiamond theory first.1 ≤ second.1 ↔
    first.1 ≤ gsltBox theory second.1
  exact gsltGalois theory first.1 second.1

/-! ## The canonical OSLF result -/

/-- Generate the OSLF of a GSLT while retaining an external sort-name family.
The sort indexing is a constant-fibre interface only: the semantic predicate
frame and both modalities are still generated exactly once from the GSLT's
equation classes and step relation. -/
def sortedGSLTOSLF (theory : GSLT.{uTheory})
    (Sorts : Type uSort) (procSort : Sorts) :
    OSLFTypeSystem (sortedGSLTRewriteSystem theory Sorts procSort) where
  Pred := fun _ => EquationPredicate theory
  frame := fun _ => (equationPredicatesEquiv theory).frame
  satisfies := fun term predicate => predicate.1 term
  diamond := semanticDiamond theory
  diamond_spec := by
    intro predicate source
    exact gsltDiamond_spec theory predicate.1 source
  box := semanticBox theory
  box_spec := by
    intro predicate target
    exact gsltBox_spec theory predicate.1 target
  galois := by
    intro first second
    exact semanticGalois theory first second

/-- Generate the OSLF of a GSLT.  Its terms retain the authored
representation, its steps are saturated by the authored equations, and its
native predicates are exactly the predicates on equation classes. -/
def gsltOSLF (theory : GSLT.{uTheory}) :
    OSLFTypeSystem (gsltRewriteSystem theory) :=
  sortedGSLTOSLF theory Unit ()

/-- The rich OSLF native-type carrier generated from an abstract GSLT. -/
abbrev GSLTNativeType (theory : GSLT.{uTheory}) : Type _ :=
  NativeTypeOf (gsltOSLF theory)

/-- The exact-target behavioral native type generated for one target term. -/
def exactTargetNativeType (theory : GSLT.{uTheory}) (target : theory.Term) :
    GSLTNativeType theory where
  sort := ()
  pred := semanticDiamond theory
    (saturatePredicate theory (fun candidate => candidate = target))

/-- Inhabiting the exact-target native type is exactly one GSLT step. -/
theorem satisfies_exactTargetNativeType_iff_step (theory : GSLT.{uTheory})
    (source target : theory.Term) :
    (gsltOSLF theory).satisfies (S := ()) source
        (exactTargetNativeType theory target).pred ↔
      theory.Step source target :=
  by
    change gsltDiamond theory
        (saturatePredicate theory (fun candidate => candidate = target)).1
        source ↔ theory.Step source target
    rw [gsltDiamond_spec]
    constructor
    · rintro ⟨middle, step, representative, equivalent, rfl⟩
      exact theory.rewrites_resp_right step equivalent
    · intro step
      exact ⟨target, step, target,
        theory.equations.iseqv.refl target, rfl⟩


#print axioms equationPredicatesEquiv
#print axioms equationPredicatesOrderIso
#print axioms saturatePredicate
#print axioms gsltDiamond_equationInvariant
#print axioms gsltBox_equationInvariant
#print axioms semanticGalois
#print axioms gsltOSLF
#print axioms satisfies_exactTargetNativeType_iff_step

end Mettapedia.OSLF.Framework.GSLTTypeSynthesis
