import Mettapedia.OSLF.Framework.WMCalculusSemantics
import Mathlib.Data.Multiset.Fold

/-!
# A separating free semantic reading of the WM core

The closed WM syntax has named state and query atoms. State terms flatten to
multisets of state names; evidence terms flatten to multisets of state/query
name pairs. The reading below interprets those normal forms literally.

For any lawful WM reading, evidence-term denotation factors through its
pair-multiset normal form. Hence two closed evidence terms agree in every
lawful reading exactly when their normal forms agree. This is semantic
separation, not yet completeness of the authored directed rewrite relation:
the latter omits a syntactic `Combine` associativity law.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Framework.WMCalculusFreeSemanticModel

open Mettapedia.OSLF.Framework.WMCalculusOSLFBridge
open Mettapedia.OSLF.Framework.WMCalculusSemantics

/-- Flatten named WM state atoms, retaining multiplicity. -/
def stateNormalForm : WMTerm .state → Multiset String
  | .state name => {name}
  | .revise first second => stateNormalForm first + stateNormalForm second

/-- A closed WM query term is a named query atom. -/
def queryName : WMTerm .query → String
  | .query name => name

/-- Flatten evidence into occurrences of state/query atom pairs. -/
def evidenceNormalForm : WMTerm .evidence → Multiset (String × String)
  | .extract state query =>
      (stateNormalForm state).map (fun name => (name, queryName query))
  | .combine first second =>
      evidenceNormalForm first + evidenceNormalForm second
  | .zero => 0

/-- The raw multiset reading separates the normal forms. Its zero state is
not claimed to be generated by the closed state grammar. -/
def freeReading :
    WMReading (Multiset String) String (Multiset (String × String)) where
  revise := (· + ·)
  extract := fun states query => states.map (fun name => (name, query))
  combine := (· + ·)
  zero := 0
  world := fun name => {name}
  query := id

theorem freeReading_coreLaws : freeReading.CoreLaws where
  extract_revise := by
    intro first second query
    exact Multiset.map_add ..
  combine_comm := by intro first second; exact add_comm first second
  combine_assoc := by intro first second third; exact add_assoc first second third
  combine_zero := by intro value; exact add_zero value

/-- State-term interpretation in the separating reading is flattening. -/
theorem freeReading_denote_state : (term : WMTerm .state) →
    freeReading.denote term = stateNormalForm term
  | .state name => by
      simp only [WMReading.denote, stateNormalForm]
      rfl
  | .revise first second => by
      simp only [WMReading.denote, stateNormalForm]
      rw [freeReading_denote_state first, freeReading_denote_state second]
      rfl

/-- Query atoms retain their names in the separating reading. -/
theorem freeReading_denote_query (term : WMTerm .query) :
    freeReading.denote term = queryName term := by
  cases term with
  | query name => rfl

/-- Evidence-term interpretation in the separating reading is the
pair-multiset normal form. -/
theorem freeReading_denote_evidence : (term : WMTerm .evidence) →
    freeReading.denote term = evidenceNormalForm term
  | .extract state query => by
      simp only [WMReading.denote, evidenceNormalForm]
      rw [freeReading_denote_state state, freeReading_denote_query query]
      rfl
  | .combine first second => by
      simp only [WMReading.denote, evidenceNormalForm]
      rw [freeReading_denote_evidence first,
        freeReading_denote_evidence second]
      rfl
  | .zero => by
      simp only [WMReading.denote, evidenceNormalForm]
      rfl

/-! ## Universal semantic evaluation of evidence normal forms -/

/-- Fold a multiset of atomic contributions using exactly the evidence
monoid supplied by a lawful reading. -/
noncomputable def foldContributions {State Query V Atom : Type}
    (R : WMReading State Query V) (laws : R.CoreLaws)
    (contribution : Atom → V) (atoms : Multiset Atom) : V := by
  letI : Std.Commutative R.combine := ⟨laws.combine_comm⟩
  letI : Std.Associative R.combine := ⟨laws.combine_assoc⟩
  exact Multiset.fold R.combine R.zero (atoms.map contribution)

theorem foldContributions_zero {State Query V Atom : Type}
    (R : WMReading State Query V) (laws : R.CoreLaws)
    (contribution : Atom → V) :
    foldContributions R laws contribution (0 : Multiset Atom) = R.zero := by
  simp [foldContributions]

theorem foldContributions_singleton {State Query V Atom : Type}
    (R : WMReading State Query V) (laws : R.CoreLaws)
    (contribution : Atom → V) (atom : Atom) :
    foldContributions R laws contribution ({atom} : Multiset Atom) =
      contribution atom := by
  simpa only [foldContributions, Multiset.map_singleton,
    Multiset.fold_singleton] using laws.combine_zero (contribution atom)

theorem foldContributions_add {State Query V Atom : Type}
    (R : WMReading State Query V) (laws : R.CoreLaws)
    (contribution : Atom → V) (first second : Multiset Atom) :
    foldContributions R laws contribution (first + second) =
      R.combine (foldContributions R laws contribution first)
        (foldContributions R laws contribution second) := by
  simpa only [foldContributions, Multiset.map_add, laws.combine_zero] using
    (@Multiset.fold_add V R.combine
      ⟨laws.combine_comm⟩ ⟨laws.combine_assoc⟩
      (s₁ := first.map contribution)
      (s₂ := second.map contribution)
      (b₁ := R.zero) (b₂ := R.zero))

/-- The observable value of a multiset of named state atoms at an
arbitrary query of the reading. This does not require that the query be
denoted by a query atom. -/
noncomputable def evaluateStateAt {State Query V : Type}
    (R : WMReading State Query V) (laws : R.CoreLaws)
    (names : Multiset String) (query : Query) : V :=
  foldContributions R laws
    (fun name => R.extract (R.world name) query) names

/-- Revision of a closed state term is observationally the fold of its
named atoms, for *every* semantic query, including unnamed queries. -/
theorem extract_denote_state_anyQuery {State Query V : Type}
    (R : WMReading State Query V) (laws : R.CoreLaws) :
    (term : WMTerm .state) → (query : Query) →
      R.extract (R.denote term) query =
        evaluateStateAt R laws (stateNormalForm term) query
  | .state name, query => by
      simpa only [WMReading.denote, stateNormalForm, evaluateStateAt]
        using (foldContributions_singleton R laws
          (fun atom => R.extract (R.world atom) query) name).symm
  | .revise first second, query => by
      simp only [WMReading.denote, stateNormalForm]
      rw [laws.extract_revise]
      change R.combine (R.extract (R.denote first) query)
          (R.extract (R.denote second) query) =
        foldContributions R laws
          (fun name => R.extract (R.world name) query)
          (stateNormalForm first + stateNormalForm second)
      rw [foldContributions_add]
      exact congrArg₂ R.combine
        (extract_denote_state_anyQuery R laws first query)
        (extract_denote_state_anyQuery R laws second query)

/-- The free reading's observational equivalence on states is literal
multiset equality. One named query already distinguishes unequal states. -/
theorem freeReading_state_agree_iff_eq (first second : Multiset String) :
    freeReading.Agree .state first second ↔ first = second := by
  constructor
  · intro agree
    have mapped := agree "separating-query"
    change first.map (fun name => (name, "separating-query")) =
      second.map (fun name => (name, "separating-query")) at mapped
    apply Multiset.map_injective
      (f := fun name : String => (name, "separating-query"))
    · intro a b equal
      exact congrArg Prod.fst equal
    · exact mapped
  · intro equal
    subst second
    exact freeReading.agree_refl .state first

/-- Closed state terms are observationally equal in all lawful readings
exactly when they contain the same multiset of named atoms. This is
semantic completeness of the state normal form, not directed rewrite
completeness. -/
theorem allReadingsStateAgree_iff_normalForm_eq
    (first second : WMTerm .state) :
    (∀ (State Query V : Type) (R : WMReading State Query V),
      R.CoreLaws → R.Agree .state (R.denote first) (R.denote second)) ↔
        stateNormalForm first = stateNormalForm second := by
  constructor
  · intro allAgree
    apply (freeReading_state_agree_iff_eq _ _).1
    simpa only [freeReading_denote_state] using
      allAgree _ _ _ freeReading freeReading_coreLaws
  · intro same State Query V R laws query
    rw [extract_denote_state_anyQuery R laws first query,
      extract_denote_state_anyQuery R laws second query, same]

/-- The name-pair normal form has one canonical interpretation in any
lawful reading. -/
noncomputable def evaluateEvidence {State Query V : Type}
    (R : WMReading State Query V) (laws : R.CoreLaws)
    (normalForm : Multiset (String × String)) : V :=
  foldContributions R laws
    (fun pair => R.extract (R.world pair.1) (R.query pair.2)) normalForm

/-- Extraction from any closed state term at a named query factors through
the corresponding multiset of state/query pairs. -/
theorem extract_denote_state_eq_evaluate {State Query V : Type}
    (R : WMReading State Query V) (laws : R.CoreLaws) :
    (term : WMTerm .state) → (query : String) →
    R.extract (R.denote term) (R.query query) =
      evaluateEvidence R laws
        ((stateNormalForm term).map (fun name => (name, query)))
  | .state name, query => by
      simp [WMReading.denote, stateNormalForm, evaluateEvidence,
        foldContributions_singleton]
  | .revise first second, query => by
      rw [WMReading.denote, laws.extract_revise]
      simp only [stateNormalForm, Multiset.map_add]
      change R.combine (R.extract (R.denote first) (R.query query))
          (R.extract (R.denote second) (R.query query)) =
        foldContributions R laws
          (fun pair => R.extract (R.world pair.1) (R.query pair.2))
          ((stateNormalForm first).map (fun name => (name, query)) +
            (stateNormalForm second).map (fun name => (name, query)))
      rw [foldContributions_add]
      exact congrArg₂ R.combine
        (extract_denote_state_eq_evaluate R laws first query)
        (extract_denote_state_eq_evaluate R laws second query)

/-- Every closed WM evidence term is interpreted by folding its canonical
pair-multiset normal form. -/
theorem denote_evidence_eq_evaluate {State Query V : Type}
    (R : WMReading State Query V) (laws : R.CoreLaws) :
    (term : WMTerm .evidence) →
      R.denote term = evaluateEvidence R laws (evidenceNormalForm term)
  | .extract state query => by
      cases query with
      | query name =>
          simp only [WMReading.denote, evidenceNormalForm, queryName]
          exact extract_denote_state_eq_evaluate R laws state name
  | .combine first second => by
      simp only [WMReading.denote, evidenceNormalForm]
      change R.combine (R.denote first) (R.denote second) =
        evaluateEvidence R laws
          (evidenceNormalForm first + evidenceNormalForm second)
      unfold evaluateEvidence
      rw [foldContributions_add]
      exact congrArg₂ R.combine
        (denote_evidence_eq_evaluate R laws first)
        (denote_evidence_eq_evaluate R laws second)
  | .zero => by
      simp only [WMReading.denote, evidenceNormalForm]
      exact (foldContributions_zero R laws _).symm

/-- The free normal form separates exactly the equations valid in all
lawful WM readings, for closed evidence terms. This does not assert that
the present five directed rewrite rules generate all those equations. -/
theorem allReadingsAgree_iff_normalForm_eq
    (first second : WMTerm .evidence) :
    (∀ (State Query V : Type) (R : WMReading State Query V),
      R.CoreLaws → R.denote first = R.denote second) ↔
        evidenceNormalForm first = evidenceNormalForm second := by
  constructor
  · intro allAgree
    simpa only [freeReading_denote_evidence] using
      allAgree _ _ _ freeReading freeReading_coreLaws
  · intro same State Query V R laws
    rw [denote_evidence_eq_evaluate R laws first,
      denote_evidence_eq_evaluate R laws second, same]

/-- The separating reading also distinguishes query atom names. -/
theorem allReadingsQueryAgree_iff_name_eq
    (first second : WMTerm .query) :
    (∀ (State Query V : Type) (R : WMReading State Query V),
      R.CoreLaws → R.Agree .query (R.denote first) (R.denote second)) ↔
        queryName first = queryName second := by
  constructor
  · intro allAgree
    simpa only [WMReading.Agree, freeReading_denote_query] using
      allAgree _ _ _ freeReading freeReading_coreLaws
  · intro same State Query V R laws
    cases first with
    | query firstName =>
      cases second with
      | query secondName =>
        change R.query firstName = R.query secondName
        exact congrArg R.query same

/-- Normal forms for all three typed sorts, without coercing hidden state
equality to literal equality in an arbitrary reading. -/
def NormalForm : WMSort → Type
  | .state => Multiset String
  | .query => String
  | .evidence => Multiset (String × String)

def normalForm : {sort : WMSort} → WMTerm sort → NormalForm sort
  | .state, term => stateNormalForm term
  | .query, term => queryName term
  | .evidence, term => evidenceNormalForm term

/-- Across the *specified* lawful WM readings, observational equivalence
of closed terms is exactly equality of their sorted normal forms. For the
state sort this is behavioral agreement, not raw state equality. -/
theorem allReadingsAgree_iff_sortedNormalForm_eq (sort : WMSort)
    (first second : WMTerm sort) :
    (∀ (State Query V : Type) (R : WMReading State Query V),
      R.CoreLaws → R.Agree sort (R.denote first) (R.denote second)) ↔
        normalForm first = normalForm second := by
  cases sort with
  | state =>
      exact allReadingsStateAgree_iff_normalForm_eq first second
  | query =>
      exact allReadingsQueryAgree_iff_name_eq first second
  | evidence =>
      change (∀ (State Query V : Type) (R : WMReading State Query V),
        R.CoreLaws → R.denote first = R.denote second) ↔
          evidenceNormalForm first = evidenceNormalForm second
      exact allReadingsAgree_iff_normalForm_eq first second

/-- A single named observation and zero evidence are separated by the
free reading; the semantic normal form is not a constant collapse. -/
theorem namedObservation_not_zero :
    ¬ (∀ (State Query V : Type) (R : WMReading State Query V),
      R.CoreLaws →
        R.denote (.extract (.state "w") (.query "q")) =
          R.denote (.zero : WMTerm .evidence)) := by
  intro allAgree
  have same := (allReadingsAgree_iff_normalForm_eq
    (.extract (.state "w") (.query "q")) .zero).1 allAgree
  simp [evidenceNormalForm, stateNormalForm, queryName] at same

end Mettapedia.OSLF.Framework.WMCalculusFreeSemanticModel
