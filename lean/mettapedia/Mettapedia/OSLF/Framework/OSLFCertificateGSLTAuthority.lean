import Mettapedia.OSLF.Framework.GSLTTypeSynthesis
import Mettapedia.GSLT.LanguageDef.CertificateGSLTJudgmentAuthority

/-!
# CertificateGSLT authority for rich OSLF native judgments

OSLF generates a predicate-valued native type system from operational
semantics.  CertificateGSLT checks finite evidence for judgments in such a system.
This module is the generic waist between those constructions.

The semantic construction is automatic: every `OSLFTypeSystem` supplies the
meaning of native inhabitation.  A finite wire syntax is deliberately not
invented for an arbitrary predicate.  Instead, a concrete language supplies
an encoding into a validated CertificateGSLT calculus and proves that derivations
of the encoding imply the generated OSLF meaning.  Closed, open, and
native-lowered checking then reuse the single CertificateGSLT authority.
-/

namespace Mettapedia.OSLF.Framework.OSLFCertificateGSLTAuthority

open Mettapedia.GSLT
open Mettapedia.GSLT.LanguageDef
open Mettapedia.GSLT.LanguageDef.InferenceChecker
open Mettapedia.GSLT.LanguageDef.CertificateGSLT
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis

universe uAuthority uClaim uNative uPremiseCertificate

/-! ## Native inhabitation as a generic judgment family -/

/-- A term paired with one rich OSLF native type of the same sort. -/
structure NativeClaim {rewriteSystem : RewriteSystem}
    (types : OSLFTypeSystem rewriteSystem) where
  nativeType : NativeTypeOf types
  term : rewriteSystem.Term nativeType.sort

/-- The meaning generated by OSLF: the term satisfies the predicate carried
by its native type. -/
def NativeClaim.Meaning {rewriteSystem : RewriteSystem}
    {types : OSLFTypeSystem rewriteSystem}
    (claim : NativeClaim types) : Prop :=
  types.satisfies claim.term claim.nativeType.pred

/-- A sound finite CertificateGSLT encoding of rich native inhabitation. -/
abbrev NativeJudgmentAdequacy {rewriteSystem : RewriteSystem}
    (types : OSLFTypeSystem rewriteSystem)
    (presentation : ValidatedCalculusLanguageDef) :=
  JudgmentEncodingAdequacy
    (NativeClaim types) NativeClaim.Meaning presentation

/-- A two-sided finite CertificateGSLT encoding of rich native inhabitation. -/
abbrev ExactNativeJudgment {rewriteSystem : RewriteSystem}
    (types : OSLFTypeSystem rewriteSystem)
    (presentation : ValidatedCalculusLanguageDef) :=
  ExactJudgmentEncoding
    (NativeClaim types) NativeClaim.Meaning presentation

/-- A rich native-judgment encoding becomes the ordinary versioned
CertificateGSLT wire authority. -/
def nativeWireAuthority {AuthorityId : Type uAuthority}
    (authorityId : AuthorityId) {rewriteSystem : RewriteSystem}
    {types : OSLFTypeSystem rewriteSystem}
    {presentation : ValidatedCalculusLanguageDef}
    (adequacy : NativeJudgmentAdequacy types presentation) :
    SemanticAuthority AuthorityId (NativeClaim types) :=
  judgmentWireAuthority authorityId adequacy

/-- Exact native encodings identify OSLF truth with existence of an accepted
versioned article. -/
theorem nativeWireAuthority_correspondence
    {AuthorityId : Type uAuthority} (authorityId : AuthorityId)
    {rewriteSystem : RewriteSystem}
    {types : OSLFTypeSystem rewriteSystem}
    {presentation : ValidatedCalculusLanguageDef}
    (adequacy : ExactNativeJudgment types presentation)
    (claim : NativeClaim types) :
    (∃ article : WireArticle,
        (nativeWireAuthority authorityId
          adequacy.toJudgmentEncodingAdequacy).check claim article = true) ↔
      claim.Meaning :=
  judgmentWireAuthority_correspondence authorityId adequacy claim

/-! ## Open native judgments and premise discharge -/

/-- A sound open CertificateGSLT encoding.  Query rows, decomposition witnesses,
substitution facts, and capability receipts remain ordered premises. -/
abbrev OpenNativeJudgmentAdequacy {rewriteSystem : RewriteSystem}
    (types : OSLFTypeSystem rewriteSystem)
    (presentation : ValidatedCalculusLanguageDef) :=
  OpenJudgmentEncodingAdequacy
    (NativeClaim types) NativeClaim.Meaning presentation

/-- Open native articles are conditional authorities until their cited
premises are discharged. -/
def openNativeWireAuthority {AuthorityId : Type uAuthority}
    (authorityId : AuthorityId) {rewriteSystem : RewriteSystem}
    {types : OSLFTypeSystem rewriteSystem}
    {presentation : ValidatedCalculusLanguageDef}
    (adequacy : OpenNativeJudgmentAdequacy types presentation) :
    SemanticAuthority AuthorityId (OpenJudgmentClaim (NativeClaim types)) :=
  openJudgmentWireAuthority authorityId adequacy

/-- Closing the ordered premises with a separately sound checker produces an
unconditional authority for rich native inhabitation. -/
def dischargedOpenNativeWireAuthority {AuthorityId : Type uAuthority}
    (authorityId : AuthorityId) {rewriteSystem : RewriteSystem}
    {types : OSLFTypeSystem rewriteSystem}
    {presentation : ValidatedCalculusLanguageDef}
    (adequacy : OpenNativeJudgmentAdequacy types presentation)
    (discharger : PremiseDischarger.{uPremiseCertificate}
      adequacy.premiseMeaning) :
    SemanticAuthority AuthorityId (NativeClaim types) :=
  dischargedOpenWireAuthority authorityId adequacy discharger

/-! ## Native implementations lower to the same authority -/

/-- A NIK for rich OSLF native judgments is trusted only through checked
lowering to the corresponding CertificateGSLT authority. -/
abbrev NativeCheckedLowering {AuthorityId : Type uAuthority}
    (authorityId : AuthorityId) {rewriteSystem : RewriteSystem}
    {types : OSLFTypeSystem rewriteSystem}
    {presentation : ValidatedCalculusLanguageDef}
    (adequacy : NativeJudgmentAdequacy types presentation)
    (NativeEvidence : Type uNative) :=
  CheckedLowering (nativeWireAuthority authorityId adequacy) NativeEvidence

/-- Native acceptance therefore entails the OSLF-generated judgment, with no
second semantic interpretation in the lowering layer. -/
theorem NativeCheckedLowering.satisfies
    {AuthorityId : Type uAuthority} {authorityId : AuthorityId}
    {rewriteSystem : RewriteSystem}
    {types : OSLFTypeSystem rewriteSystem}
    {presentation : ValidatedCalculusLanguageDef}
    {adequacy : NativeJudgmentAdequacy types presentation}
    {NativeEvidence : Type uNative}
    (lowering : NativeCheckedLowering authorityId adequacy NativeEvidence)
    {claim : NativeClaim types} {evidence : NativeEvidence}
    (accepted : lowering.nativeCheck claim evidence = true) :
    claim.Meaning :=
  lowering.sound accepted

/-! ## Exact operational edges are native OSLF judgments -/

/-- The exact edge `source -> target` represented as inhabitation of the
OSLF-generated singleton-target diamond type. -/
def exactStepNativeClaim (theory : GSLT)
    (source target : theory.Term) : NativeClaim (gsltOSLF theory) where
  nativeType := exactTargetNativeType theory target
  term := source

/-- Exact operational checking is not a separate kind of proof: it is the
exact-target instance of rich OSLF native inhabitation. -/
theorem exactStepNativeClaim_meaning_iff_step (theory : GSLT)
    (source target : theory.Term) :
    (exactStepNativeClaim theory source target).Meaning ↔
      theory.Step source target :=
  satisfies_exactTargetNativeType_iff_step theory source target

end Mettapedia.OSLF.Framework.OSLFCertificateGSLTAuthority
