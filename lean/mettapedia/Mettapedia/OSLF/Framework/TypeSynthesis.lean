open Mettapedia.OSLF.Framework.GSLTTypeSynthesis
open Mettapedia.Languages.ProcessCalculi.RhoCalculus.Reduction

/-! ## Step 1: Reduction Relation from Executable Engine -/

/-- Reduction compiled at a fixed contextual derivation depth.  This is the
finite approximation used by executable consumers that require an explicit
branching bound. -/
def langReducesAtUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (contextFuel : Nat) (p q : Pattern) : Prop :=
  StepAt (engineBasePremises relEnv) lang contextFuel p q

/-- The fixed-depth compiler is exact for `langReducesAtUsing`. -/
theorem mem_rewriteAt_iff_langReducesAtUsing
    (relEnv : RelationEnv) (lang : LanguageDef) (contextFuel : Nat)
    (p q : Pattern) :
    q ∈ rewriteAt (engineBasePremises relEnv) lang contextFuel p ↔
      langReducesAtUsing relEnv lang contextFuel p q := by
  exact mem_rewriteAt_iff_stepAt

/-- Executable contextual reduction induced by a `LanguageDef`.

    A witness supplies the finite contextual depth.  This keeps the compiler
    total without imposing a representation-wide collection policy or a
    hidden global depth cap. -/
def langReducesExecUsing (relEnv : RelationEnv) (lang : LanguageDef) (p q : Pattern) : Prop :=
  ∃ fuel, q ∈ rewriteAt (engineBasePremises relEnv) lang fuel p

/-- Declarative/internal one-step reduction induced by a `LanguageDef`.

    This is the engine relation generated by authored rewrite rules.  It does
    not orient, close under, or quotient by `lang.equations`; the public OSLF
    consumes `langSemanticReducesUsing`, its modulo-equations closure.  A
    `Premise.congruence` recursively invokes this same relation; collection
    representation carries no independent reduction authority.

    The executable path is bridged by
    `langReducesUsing_iff_execUsing`. -/
def langReducesUsing (relEnv : RelationEnv) (lang : LanguageDef) (p q : Pattern) : Prop :=
  Step (engineBasePremises relEnv) lang p q

/-- Soundness/completeness bridge: declarative/internal and executable
    premise-aware one-step reduction coincide. -/
theorem langReducesUsing_iff_execUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (p q : Pattern) :
    langReducesUsing relEnv lang p q ↔ langReducesExecUsing relEnv lang p q := by
  simpa [langReducesUsing, langReducesExecUsing] using
    (exists_mem_rewriteAt_iff_step
      (base := engineBasePremises relEnv) (lang := lang)
      (source := p) (target := q)).symm

/-- Declarative/internal reduction implies executable reduction. -/
theorem langReducesUsing_to_exec (relEnv : RelationEnv) (lang : LanguageDef)
    {p q : Pattern} :
    langReducesUsing relEnv lang p q → langReducesExecUsing relEnv lang p q :=
  (langReducesUsing_iff_execUsing relEnv lang p q).1

/-- Executable reduction implies declarative/internal reduction. -/
theorem exec_to_langReducesUsing (relEnv : RelationEnv) (lang : LanguageDef)
    {p q : Pattern} :
    langReducesExecUsing relEnv lang p q → langReducesUsing relEnv lang p q :=
  (langReducesUsing_iff_execUsing relEnv lang p q).2

/-- Default declarative/internal reduction relation induced by a `LanguageDef`.

    This is `langReducesUsing RelationEnv.empty`. -/
def langReduces (lang : LanguageDef) (p q : Pattern) : Prop :=
  langReducesUsing RelationEnv.empty lang p q

/-! ## Step 2: Modulo-equations GSLT semantics -/

/-- The canonical GSLT generated from a language under an explicit relation
environment.  Authored rewrites remain the only directed steps; authored
equations change representatives at either endpoint. -/
def langGSLTUsing (relEnv : RelationEnv) (lang : LanguageDef) :
    Mettapedia.GSLT.GSLT :=
  gsltModuloEquations (engineBasePremises relEnv) lang

/-- Default GSLT modulo equations using `RelationEnv.empty`. -/
def langGSLT (lang : LanguageDef) : Mettapedia.GSLT.GSLT :=
  langGSLTUsing RelationEnv.empty lang

/-- The one-step relation consumed by OSLF. -/
def langSemanticReducesUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (source target : Pattern) : Prop :=
  (langGSLTUsing relEnv lang).Step source target

/-- Default one-step semantic relation consumed by OSLF. -/
def langSemanticReduces (lang : LanguageDef)
    (source target : Pattern) : Prop :=
  langSemanticReducesUsing RelationEnv.empty lang source target

/-- Every primitive engine step is a semantic step. -/
theorem langReducesUsing_to_semantic
    (relEnv : RelationEnv) (lang : LanguageDef) {source target : Pattern}
    (step : langReducesUsing relEnv lang source target) :
    langSemanticReducesUsing relEnv lang source target :=
  step_to_stepModuloEquations step

/-- Default-environment form of `langReducesUsing_to_semantic`. -/
theorem langReduces_to_semantic
    (lang : LanguageDef) {source target : Pattern}
    (step : langReduces lang source target) :
    langSemanticReduces lang source target :=
  langReducesUsing_to_semantic RelationEnv.empty lang step

/-- For an equation-free presentation, primitive and semantic one-step
reduction coincide. -/
theorem langSemanticReducesUsing_iff_langReducesUsing_of_equation_free
    (relEnv : RelationEnv) {lang : LanguageDef}
    (equationFree : lang.isEquationFree = true) (source target : Pattern) :
    langSemanticReducesUsing relEnv lang source target ↔
      langReducesUsing relEnv lang source target :=
  stepModuloEquations_iff_step_of_no_generators equationFree source target

/-- Default-environment form of
`langSemanticReducesUsing_iff_langReducesUsing_of_equation_free`.  This is a
recovery theorem for the sole semantic step relation, not a second reduction
semantics. -/
theorem langSemanticReduces_iff_langReduces_of_equation_free
    {lang : LanguageDef} (equationFree : lang.isEquationFree = true)
    (source target : Pattern) :
    langSemanticReduces lang source target ↔ langReduces lang source target := by
  simpa [langSemanticReduces, langReduces] using
    (langSemanticReducesUsing_iff_langReducesUsing_of_equation_free
      RelationEnv.empty equationFree source target)

/-- Every authored predicate is equation-invariant when the presentation is
certified equation-free.  This is the proof component for that specialization
of the canonical OSLF, not a separate predicate semantics. -/
theorem equationInvariant_langGSLTUsing_of_equation_free
    (relEnv : RelationEnv) {lang : LanguageDef}
    (equationFree : lang.isEquationFree = true) (predicate : Pattern → Prop) :
    EquationInvariant (langGSLTUsing relEnv lang) predicate := by
  intro left right equivalent
  have equal : left = right :=
    (gsltModuloEquations_equiv_iff_eq_of_no_generators
      equationFree left right).mp equivalent
  subst right
  rfl

/-- Default-environment form of
`equationInvariant_langGSLTUsing_of_equation_free`. -/
theorem equationInvariant_langGSLT_of_equation_free
    {lang : LanguageDef} (equationFree : lang.isEquationFree = true)
    (predicate : Pattern → Prop) :
    EquationInvariant (langGSLT lang) predicate := by
  simpa [langGSLT] using
    (equationInvariant_langGSLTUsing_of_equation_free
      RelationEnv.empty equationFree predicate)

/-- For an equation-free presentation, the canonical GSLT's equivalence is
exactly equality. -/
theorem langGSLT_equiv_iff_eq_of_equation_free
    {lang : LanguageDef} (equationFree : lang.isEquationFree = true)
    (left right : Pattern) :
    (langGSLT lang).Equiv left right ↔ left = right := by
  simpa [langGSLT, langGSLTUsing] using
    (gsltModuloEquations_equiv_iff_eq_of_no_generators
      (base := engineBasePremises RelationEnv.empty)
      equationFree left right)

/-- Package a raw predicate for the canonical OSLF when the presentation is
certified equation-free.  If any equation generator is later added, the
certificate ceases to exist and the client must prove its actual invariance
law. -/
def equationPredicateUsingOfEquationFree
    (relEnv : RelationEnv) {lang : LanguageDef}
    (equationFree : lang.isEquationFree = true) (predicate : Pattern → Prop) :
    EquationPredicate (langGSLTUsing relEnv lang) :=
  invariantPredicate (langGSLTUsing relEnv lang) predicate
    (equationInvariant_langGSLTUsing_of_equation_free
      relEnv equationFree predicate)

/-- Default-environment form of
`equationPredicateUsingOfEquationFree`. -/
def equationPredicateOfEquationFree
    {lang : LanguageDef} (equationFree : lang.isEquationFree = true)
    (predicate : Pattern → Prop) : EquationPredicate (langGSLT lang) :=
  invariantPredicate (langGSLT lang) predicate
    (equationInvariant_langGSLT_of_equation_free equationFree predicate)

/-- Raw predicate generators need no semantic enlargement for an equation-free
presentation.  This theorem is the exact equality-equivalence special case of
the one OSLF construction. -/
theorem saturatePredicate_langGSLTUsing_apply_iff_of_equation_free
    (relEnv : RelationEnv) {lang : LanguageDef}
    (equationFree : lang.isEquationFree = true)
    (predicate : Pattern → Prop) (term : Pattern) :
    saturatePredicate (langGSLTUsing relEnv lang) predicate term ↔
      predicate term :=
  saturatePredicate_apply_iff_of_equiv_iff_eq
    (langGSLTUsing relEnv lang)
    (gsltModuloEquations_equiv_iff_eq_of_no_generators
      equationFree)
    predicate term

/-- Default-environment form of
`saturatePredicate_langGSLTUsing_apply_iff_of_equation_free`. -/
theorem saturatePredicate_langGSLT_apply_iff_of_equation_free
    {lang : LanguageDef} (equationFree : lang.isEquationFree = true)
    (predicate : Pattern → Prop) (term : Pattern) :
    saturatePredicate (langGSLT lang) predicate term ↔ predicate term := by
  simpa [langGSLT] using
    (saturatePredicate_langGSLTUsing_apply_iff_of_equation_free
      RelationEnv.empty equationFree predicate term)

/-! ## Step 3: RewriteSystem from LanguageDef -/

/-- Convert a LanguageDef into a RewriteSystem, parameterized by relation env.

    - **Sorts**: `String` (from `lang.types`, e.g., "Proc", "Name")
    - **procSort**: the designated process sort (typically "Proc")
    - **Term**: `Pattern` at every sort (shared AST from MeTTaIL)
    - **Reduces**: one engine rewrite saturated by authored equations

    The `procSort` parameter specifies which sort carries the reduction relation.
    For the ρ-calculus, this is `"Proc"`. -/
def langRewriteSystemUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (procSort : String := "Proc") :
    RewriteSystem :=
  sortedGSLTRewriteSystem (langGSLTUsing relEnv lang) String procSort

/-- Default rewrite-system wrapper using `RelationEnv.empty`. -/
def langRewriteSystem (lang : LanguageDef) (procSort : String := "Proc") :
    RewriteSystem :=
  langRewriteSystemUsing RelationEnv.empty lang procSort

/-- Rewrite-system wrapper using relation tuples induced by an admitted finite
    Datalog extension. -/
def langRewriteSystemWithLogic (lang : LanguageDef)
    (logic : AdmittedProgram lang) (procSort : String := "Proc") :
    RewriteSystem :=
  langRewriteSystemUsing (logicDatalogRelationEnv logic.1) lang procSort

/-- Rewrite-system wrapper using only the ground facts of an admitted logic
    extension. -/
def langRewriteSystemWithLogicFacts (lang : LanguageDef)
    (logic : AdmittedProgram lang) (procSort : String := "Proc") :
    RewriteSystem :=
  langRewriteSystemUsing (logicFactRelationEnv logic.1) lang procSort

/-! ## Step 4: Reduction Span -/

/-- The modulo-equations reduction span for a LanguageDef and relation env.

    Edges are pairs `(p, q)` witnessed by a premise-aware one-step reduction.
    This is the input to the change-of-base adjunction machinery from DerivedModalities.lean. -/
def langSpanUsing (relEnv : RelationEnv) (lang : LanguageDef) : ReductionSpan Pattern where
  Edge :=
    { pair : Pattern × Pattern //
      langSemanticReducesUsing relEnv lang pair.1 pair.2 }
  source := fun e => e.val.1
  target := fun e => e.val.2

/-- Default reduction span using `RelationEnv.empty`. -/
def langSpan (lang : LanguageDef) : ReductionSpan Pattern :=
  langSpanUsing RelationEnv.empty lang

/-! ## Step 5: Modal Operators -/

/-- The equation-respecting step-future modal operator ◇ for a LanguageDef
and relation environment.

    `langDiamond lang φ p` = "p can reduce (via lang's rules) to some q satisfying φ"

    The predicate carrier and modality are inherited from the canonical
    GSLT modulo equations. -/
def langDiamondUsing (relEnv : RelationEnv) (lang : LanguageDef) :
    EquationPredicate (langGSLTUsing relEnv lang) →
      EquationPredicate (langGSLTUsing relEnv lang) :=
  semanticDiamond (langGSLTUsing relEnv lang)

/-- Default step-future modal operator using `RelationEnv.empty`. -/
def langDiamond (lang : LanguageDef) :
    EquationPredicate (langGSLT lang) → EquationPredicate (langGSLT lang) :=
  langDiamondUsing RelationEnv.empty lang

/-- The equation-respecting step-past modal operator □ for a LanguageDef and
relation environment.

    `langBox lang φ p` = "all predecessors of p (via lang's rules) satisfy φ"

    Defined by the same canonical GSLT construction as `langDiamondUsing`. -/
def langBoxUsing (relEnv : RelationEnv) (lang : LanguageDef) :
    EquationPredicate (langGSLTUsing relEnv lang) →
      EquationPredicate (langGSLTUsing relEnv lang) :=
  semanticBox (langGSLTUsing relEnv lang)

/-- Default step-past modal operator using `RelationEnv.empty`. -/
def langBox (lang : LanguageDef) :
    EquationPredicate (langGSLT lang) → EquationPredicate (langGSLT lang) :=
  langBoxUsing RelationEnv.empty lang

/-- The Galois connection ◇ ⊣ □ for any LanguageDef and relation env.

    This is an **automatic** consequence of the adjoint composition
    from DerivedModalities.lean. No manual proof needed! -/
theorem langGaloisUsing (relEnv : RelationEnv) (lang : LanguageDef) :
    GaloisConnection (langDiamondUsing relEnv lang) (langBoxUsing relEnv lang) :=
  semanticGalois (langGSLTUsing relEnv lang)

/-- Default Galois connection using `RelationEnv.empty`. -/
theorem langGalois (lang : LanguageDef) :
    GaloisConnection (langDiamond lang) (langBox lang) :=
  langGaloisUsing RelationEnv.empty lang

/-! ## Step 6: OSLFTypeSystem -/

/-- The diamond specification: `langDiamondUsing` computes the step-future modality. -/
theorem langDiamondUsing_spec (relEnv : RelationEnv) (lang : LanguageDef)
    (φ : EquationPredicate (langGSLTUsing relEnv lang)) (p : Pattern) :
    langDiamondUsing relEnv lang φ p ↔
      ∃ q, langSemanticReducesUsing relEnv lang p q ∧ φ.1 q := by
  change gsltDiamond (langGSLTUsing relEnv lang) φ.1 p ↔ _
  exact gsltDiamond_spec (langGSLTUsing relEnv lang) φ.1 p

/-- The default diamond specification (`RelationEnv.empty`). -/
theorem langDiamond_spec (lang : LanguageDef)
    (φ : EquationPredicate (langGSLT lang)) (p : Pattern) :
    langDiamond lang φ p ↔ ∃ q, langSemanticReduces lang p q ∧ φ.1 q := by
  simpa [langDiamond, langSemanticReduces, langGSLT] using
    (langDiamondUsing_spec RelationEnv.empty lang φ p)

/-- The box specification: `langBoxUsing` computes the step-past modality. -/
theorem langBoxUsing_spec (relEnv : RelationEnv) (lang : LanguageDef)
    (φ : EquationPredicate (langGSLTUsing relEnv lang)) (p : Pattern) :
    langBoxUsing relEnv lang φ p ↔
      ∀ q, langSemanticReducesUsing relEnv lang q p → φ.1 q := by
  change gsltBox (langGSLTUsing relEnv lang) φ.1 p ↔ _
  exact gsltBox_spec (langGSLTUsing relEnv lang) φ.1 p

/-- The default box specification (`RelationEnv.empty`). -/
theorem langBox_spec (lang : LanguageDef)
    (φ : EquationPredicate (langGSLT lang)) (p : Pattern) :
    langBox lang φ p ↔ ∀ q, langSemanticReduces lang q p → φ.1 q := by
  simpa [langBox, langSemanticReduces, langGSLT] using
    (langBoxUsing_spec RelationEnv.empty lang φ p)

/-- The OSLF type system generated from a `LanguageDef` and relation
environment.

The string sort index is retained for the existing LanguageDef interface, but
its operational fiber is the sole GSLT-derived semantics: predicates must
respect authored equations, and diamond/box range over the modulo-equations
one-step relation.  Raw predicate generators are admitted only through the
least modulo-equations predicate. -/
def langOSLFUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (procSort : String := "Proc") :
    OSLFTypeSystem (langRewriteSystemUsing relEnv lang procSort) :=
  sortedGSLTOSLF (langGSLTUsing relEnv lang) String procSort

/-- The default OSLF type system using `RelationEnv.empty`.

    Thin wrapper over `langOSLFUsing`. -/
def langOSLF (lang : LanguageDef) (procSort : String := "Proc") :
    OSLFTypeSystem (langRewriteSystem lang procSort) :=
  langOSLFUsing RelationEnv.empty lang procSort

/-- OSLF type system using relation tuples induced by an admitted finite
    Datalog extension. -/
def langOSLFWithLogic (lang : LanguageDef) (logic : AdmittedProgram lang)
    (procSort : String := "Proc") :
    OSLFTypeSystem (langRewriteSystemWithLogic lang logic procSort) :=
  langOSLFUsing (logicDatalogRelationEnv logic.1) lang procSort

/-- OSLF type system using only the ground facts of an admitted logic
    extension. -/
def langOSLFWithLogicFacts (lang : LanguageDef) (logic : AdmittedProgram lang)
    (procSort : String := "Proc") :
    OSLFTypeSystem (langRewriteSystemWithLogicFacts lang logic procSort) :=
  langOSLFUsing (logicFactRelationEnv logic.1) lang procSort

/-- `langOSLF` is definitionally equal to `langOSLFUsing RelationEnv.empty`. -/
theorem langOSLF_eq_langOSLFUsing_empty (lang : LanguageDef) (procSort : String) :
    langOSLF lang procSort = langOSLFUsing RelationEnv.empty lang procSort := rfl

/-- `langOSLFWithLogicFacts` is the `langOSLFUsing` specialization for
    `logicFactRelationEnv`. -/
theorem langOSLFWithLogicFacts_eq_langOSLFUsing_logicFactRelationEnv
    (lang : LanguageDef) (logic : AdmittedProgram lang) (procSort : String) :
    langOSLFWithLogicFacts lang logic procSort =
      langOSLFUsing (logicFactRelationEnv logic.1) lang procSort := rfl

/-- `langOSLFWithLogic` is the `langOSLFUsing` specialization for
    `logicDatalogRelationEnv`. -/
theorem langOSLFWithLogic_eq_langOSLFUsing_logicDatalogRelationEnv
    (lang : LanguageDef) (logic : AdmittedProgram lang) (procSort : String) :
    langOSLFWithLogic lang logic procSort =
      langOSLFUsing (logicDatalogRelationEnv logic.1) lang procSort := rfl

/-! ## Step 7: Native Types -/

/-- A native type for a generated type system (with relation env): a (sort, predicate) pair. -/
def langNativeTypeUsing (relEnv : RelationEnv) (lang : LanguageDef)
    (procSort : String := "Proc") :=
  NativeTypeOf (langOSLFUsing relEnv lang procSort)

/-- A native type for a generated type system: a (sort, predicate) pair. -/
def langNativeType (lang : LanguageDef) (procSort : String := "Proc") :=
  NativeTypeOf (langOSLF lang procSort)

/-! ## ρ Empty-Bag Irreducibility -/

set_option maxRecDepth 4096 in
set_option maxHeartbeats 800000 in
/-- Executable one-step rewrite on the empty ρ-process bag yields no reducts. -/
theorem rhoCalc_emptyBag_rewrite_nil :
    rewriteAt (engineBasePremises RelationEnv.empty) rhoCalc 1
      (.collection .hashBag [] none) = [] := by
  decide +kernel

/-- SC-empty representatives have no specialized one-step ρ reducts. -/
theorem rhoCalc_SC_emptyBag_reduceStep_irreducible
    {p q : Pattern}
    (hsc : Mettapedia.Languages.ProcessCalculi.RhoCalculus.StructuralCongruence
      (.collection .hashBag [] none) p) :
    ¬ q ∈ Mettapedia.Languages.ProcessCalculi.RhoCalculus.Engine.reduceStep p := by
  intro hstep
  exact emptyBag_SC_irreducible hsc
    (Mettapedia.Languages.ProcessCalculi.RhoCalculus.Engine.reduceStep_sound p q _ hstep).some

/-- OSLF-modal corollary of SC-empty irreducibility: no `◇⊤` at SC-empty
    representatives, provided the modulo-equations generated step has been
    related to the specialized rho semantics. -/
theorem rhoCalc_SC_emptyBag_no_diamondTop_of_soundBridge
    (soundBridge :
      ∀ {p q : Pattern}, langSemanticReduces rhoCalc p q → Nonempty (p ⇝ q))
    {p : Pattern}
    (hsc : Mettapedia.Languages.ProcessCalculi.RhoCalculus.StructuralCongruence
      (.collection .hashBag [] none) p) :
    ¬ langDiamond rhoCalc
      (saturatePredicate (langGSLT rhoCalc) (fun _ => True)) p := by
  intro hdia
  rcases (langDiamond_spec (lang := rhoCalc)
      (φ := saturatePredicate (langGSLT rhoCalc) (fun _ => True))
      (p := p)).1 hdia with
    ⟨q, hred, _⟩
  exact emptyBag_SC_irreducible hsc (soundBridge hred).some

/-! ## Executable Tests -/

open Mettapedia.Languages.ProcessCalculi.RhoCalculus.Engine (patternToString)

instance : ToString Pattern := ⟨patternToString⟩

-- Test: langReduces on rhoCalc COMM
#eval! do
  let x := Pattern.fvar "x"
  let term : Pattern := .collection .hashBag [
    .apply "POutput" [x, .apply "PZero" []],
    .apply "PInput" [x, .lambda none (.bvar 0)]
  ] none
  let reducts := rewriteAt (engineBasePremises RelationEnv.empty) rhoCalc 1 term
  IO.println s!"langReduces rhoCalc COMM test:"
  IO.println s!"  term: {term}"
  IO.println s!"  reducts ({reducts.length}):"
  for r in reducts do
    IO.println s!"    -> {r}"
  IO.println s!"  langReduces holds: {!reducts.isEmpty}"

-- Test: langDiamond on rhoCalc — check that diamond returns True for reducible terms
#eval! do
  let x := Pattern.fvar "x"
  let p : Pattern := .collection .hashBag [
    .apply "POutput" [x, .apply "PZero" []],
    .apply "PInput" [x, .lambda none (.bvar 0)]
  ] none
  -- diamond (fun _ => True) p should be True (p can reduce to something)
  let canReduce :=
    !(rewriteAt (engineBasePremises RelationEnv.empty) rhoCalc 1 p).isEmpty
  IO.println s!"langDiamond test: can {p} reduce? {canReduce}"

-- Test: langOSLF instantiation succeeds (type-checking is the test)
#check langOSLF rhoCalc
#check langGalois rhoCalc

end Mettapedia.OSLF.Framework.TypeSynthesis
