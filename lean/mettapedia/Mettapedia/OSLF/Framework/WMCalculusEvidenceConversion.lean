import Mettapedia.OSLF.Framework.WMCalculusRewriteCompletenessBoundary

/-!
# Generated evidence conversion for the WM calculus

The relation below is generated by extraction through revision, the evidence
commutative-monoid laws, and congruence. It is not defined by semantic equality.
A syntactic quotient reading proves that these generators capture exactly
equality in every lawful reading, for the existing closed evidence syntax.

Extraction remains a directed operation in the authored calculus. Conversion
forgets its direction, as well as event counts. This module does not replace
that calculus, add a state unit, or identify raw states by observation.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Framework.WMCalculusEvidenceConversion

open WMCalculusOSLFBridge WMCalculusSemantics WMCalculusFreeSemanticModel
open WMCalculusContextEncoding WMCalculusRewriteCompletenessBoundary

/-- The equational closure of extraction and the evidence monoid laws.
State and query terms are the existing sorted syntax, not new carriers. -/
inductive EvidenceConversion : WMTerm .evidence → WMTerm .evidence → Prop where
  | refl (term) : EvidenceConversion term term
  | symm {first second} : EvidenceConversion first second → EvidenceConversion second first
  | trans {first second third} : EvidenceConversion first second →
      EvidenceConversion second third → EvidenceConversion first third
  | combine {first first' second second'} :
      EvidenceConversion first first' → EvidenceConversion second second' →
      EvidenceConversion (.combine first second) (.combine first' second')
  | comm (first second) :
      EvidenceConversion (.combine first second) (.combine second first)
  | assoc (first second third) :
      EvidenceConversion (.combine (.combine first second) third)
        (.combine first (.combine second third))
  | zero (term) : EvidenceConversion (.combine term .zero) term
  | extract (first second : WMTerm .state) (query : WMTerm .query) :
      EvidenceConversion (.extract (.revise first second) query)
        (.combine (.extract first query) (.extract second query))

/-- Every generator preserves the previously constructed free normal form. -/
theorem EvidenceConversion.normalForm_eq {first second : WMTerm .evidence}
    (conversion : EvidenceConversion first second) :
    evidenceNormalForm first = evidenceNormalForm second := by
  induction conversion with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ihFirst ihSecond => exact ihFirst.trans ihSecond
  | combine _ _ ihFirst ihSecond =>
      simpa only [evidenceNormalForm] using congrArg₂ (· + ·) ihFirst ihSecond
  | comm => simp only [evidenceNormalForm, add_comm]
  | assoc => simp only [evidenceNormalForm, add_assoc]
  | zero => simp only [evidenceNormalForm, add_zero]
  | extract => simp only [evidenceNormalForm, stateNormalForm, Multiset.map_add]

def evidenceSetoid : Setoid (WMTerm .evidence) where
  r := EvidenceConversion
  iseqv := ⟨EvidenceConversion.refl, EvidenceConversion.symm, EvidenceConversion.trans⟩

def EvidenceClass := Quotient evidenceSetoid

def classOf (term : WMTerm .evidence) : EvidenceClass := Quotient.mk evidenceSetoid term

def combineClasses : EvidenceClass → EvidenceClass → EvidenceClass :=
  Quotient.lift₂ (fun first second => classOf (.combine first second))
    (fun _ _ _ _ first second => Quotient.sound (.combine first second))

/-- A term model with raw state trees and generated evidence classes. Its
state revision is deliberately not a commutative operation on raw states. -/
def syntaxReading : WMReading (WMTerm .state) (WMTerm .query) EvidenceClass where
  revise := .revise
  extract := fun state query => classOf (.extract state query)
  combine := combineClasses
  zero := classOf .zero
  world := .state
  query := .query

theorem syntaxReading_coreLaws : syntaxReading.CoreLaws where
  extract_revise := fun first second query =>
    Quotient.sound (.extract first second query)
  combine_comm := by
    intro first second
    induction first using Quotient.inductionOn with | h first =>
      induction second using Quotient.inductionOn with | h second =>
        exact Quotient.sound (.comm first second)
  combine_assoc := by
    intro first second third
    induction first using Quotient.inductionOn with | h first =>
      induction second using Quotient.inductionOn with | h second =>
        induction third using Quotient.inductionOn with | h third =>
          exact Quotient.sound (.assoc first second third)
  combine_zero := by
    intro term
    induction term using Quotient.inductionOn with | h term =>
      exact Quotient.sound (.zero term)

theorem syntaxReading_denote_state : (term : WMTerm .state) →
    syntaxReading.denote term = term
  | .state _ => rfl
  | .revise first second =>
      congrArg₂ WMTerm.revise (syntaxReading_denote_state first)
        (syntaxReading_denote_state second)

theorem syntaxReading_denote_query (term : WMTerm .query) :
    syntaxReading.denote term = term := by cases term; rfl

theorem syntaxReading_denote_evidence : (term : WMTerm .evidence) →
    syntaxReading.denote term = classOf term
  | .extract state query => by
      change classOf (.extract (syntaxReading.denote state)
        (syntaxReading.denote query)) = _
      rw [syntaxReading_denote_state, syntaxReading_denote_query]
  | .combine first second => by
      change combineClasses (syntaxReading.denote first) (syntaxReading.denote second) = _
      rw [syntaxReading_denote_evidence first, syntaxReading_denote_evidence second]
      rfl
  | .zero => rfl

/-- Completeness is obtained from the syntactic quotient model, not added
as a constructor or assumed in the definition of conversion. -/
theorem conversion_iff_allReadings (first second : WMTerm .evidence) :
    EvidenceConversion first second ↔
      ∀ (State Query V : Type) (R : WMReading State Query V),
        R.CoreLaws → R.denote first = R.denote second := by
  constructor
  · intro conversion
    exact (allReadingsAgree_iff_normalForm_eq first second).2 conversion.normalForm_eq
  · intro allReadings
    have same := allReadings _ _ _ syntaxReading syntaxReading_coreLaws
    rw [syntaxReading_denote_evidence, syntaxReading_denote_evidence] at same
    exact Quotient.exact same

theorem conversion_iff_normalForm_eq (first second : WMTerm .evidence) :
    EvidenceConversion first second ↔ evidenceNormalForm first = evidenceNormalForm second :=
  (conversion_iff_allReadings first second).trans
    (allReadingsAgree_iff_normalForm_eq first second)

/-- Contextual execution maps into conversion; the converse is false. -/
theorem conversion_of_contextStepStar {first second : WMTerm .evidence}
    (steps : WMContextStepStar first second) : EvidenceConversion first second := by
  apply (conversion_iff_allReadings first second).2
  intro State Query V R laws
  exact laws.agree_of_contextStepStar steps

/-- Observational equality of closed states can be checked syntactically
through generated evidence conversion, without asserting raw state equality. -/
def StateObservationConversion (first second : WMTerm .state) : Prop :=
  ∀ query : WMTerm .query,
    EvidenceConversion (.extract first query) (.extract second query)

theorem stateObservationConversion_iff_normalForm_eq (first second : WMTerm .state) :
    StateObservationConversion first second ↔ stateNormalForm first = stateNormalForm second := by
  constructor
  · intro observations
    have same := (observations (.query "separating-query")).normalForm_eq
    apply Multiset.map_injective
      (f := fun name : String => (name, "separating-query"))
    · intro a b equal
      exact congrArg Prod.fst equal
    · simpa only [evidenceNormalForm, queryName] using same
  · intro same query
    apply (conversion_iff_normalForm_eq _ _).2
    simp only [evidenceNormalForm, same]

theorem stateObservationConversion_iff_allReadings (first second : WMTerm .state) :
    StateObservationConversion first second ↔
      ∀ (State Query V : Type) (R : WMReading State Query V),
        R.CoreLaws → R.Agree .state (R.denote first) (R.denote second) :=
  (stateObservationConversion_iff_normalForm_eq first second).trans
    (allReadingsStateAgree_iff_normalForm_eq first second).symm

theorem revise_comm_observational (first second : WMTerm .state) :
    StateObservationConversion (.revise first second) (.revise second first) := by
  apply (stateObservationConversion_iff_normalForm_eq _ _).2
  simp only [stateNormalForm, add_comm]

theorem revise_assoc_observational (first second third : WMTerm .state) :
    StateObservationConversion (.revise (.revise first second) third)
      (.revise first (.revise second third)) := by
  apply (stateObservationConversion_iff_normalForm_eq _ _).2
  simp only [stateNormalForm, add_assoc]

/-- The complete syntactic reading still retains the ordering of raw state
trees. Observational revision laws do not imply literal revision laws. -/
theorem syntaxReading_revision_not_comm :
    syntaxReading.revise (.state "a") (.state "b") ≠
      syntaxReading.revise (.state "b") (.state "a") := by
  intro equal
  have names := WMTerm.state.inj (WMTerm.revise.inj equal).1
  exact (by decide : ("a" : String) ≠ "b") names

def revisionCount : WMTerm .state → Nat
  | .state _ => 0
  | .revise first second => revisionCount first + revisionCount second + 1

/-- Number of revision nodes still underneath evidence extractions. This
is a pending-work measure, not an arbitrary runtime cost semantics. -/
def pendingExtractions : WMTerm .evidence → Nat
  | .extract state _ => revisionCount state
  | .combine first second => pendingExtractions first + pendingExtractions second
  | .zero => 0

theorem pendingExtractions_extract (first second : WMTerm .state) (query : WMTerm .query) :
    pendingExtractions (.extract (.revise first second) query) =
      pendingExtractions (.combine (.extract first query) (.extract second query)) + 1 := by
  simp only [pendingExtractions, revisionCount]

/-- Conversion discards real computational information: even the remaining
number of extraction-distribution steps cannot be recovered from its class. -/
theorem pendingExtractions_does_not_descend :
    ¬ ∃ measure : EvidenceClass → Nat, ∀ term,
      measure (classOf term) = pendingExtractions term := by
  rintro ⟨measure, reads⟩
  let first : WMTerm .state := .state "a"
  let second : WMTerm .state := .state "b"
  let query : WMTerm .query := .query "q"
  have classes : classOf (.extract (.revise first second) query) =
      classOf (.combine (.extract first query) (.extract second query)) :=
    Quotient.sound (.extract first second query)
  have same := congrArg measure classes
  rw [reads, reads] at same
  simp only [pendingExtractions, revisionCount, first, second] at same
  omega

/-- The new conversion supplies the missing association equation, while
neither direction becomes an execution of the old contextual calculus. -/
theorem conversion_not_directed_execution :
    EvidenceConversion leftAssoc rightAssoc ∧
      ¬ WMContextStepStar leftAssoc rightAssoc ∧
      ¬ WMContextStepStar rightAssoc leftAssoc :=
  ⟨.assoc _ _ _, semantic_assoc_not_contextually_reachable.2⟩

theorem observation_not_zero :
    ¬ EvidenceConversion (.extract (.state "w") (.query "q")) .zero := by
  intro conversion
  exact namedObservation_not_zero ((conversion_iff_allReadings _ _).1 conversion)

