import Mettapedia.GSLT.Core.IndexedOperational

/-!
# Quotient coherence for generated OSLF

`GSLTTypeSynthesis.gsltOSLF` is the sole OSLF generated by a GSLT. It keeps
authored terms as its program-facing carrier and admits only predicates that
descend through the authored equation theory. This module proves that its
modalities compute exactly like the corresponding modalities on semantic
equation classes. The quotient objects below are comparison instruments, not
a second synthesis path.
-/

namespace Mettapedia.OSLF.Framework.GSLTQuotientCoherence

open Mettapedia.GSLT
open Mettapedia.GSLT.IndexedOperational
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis

universe uTheory

/-- Satisfaction in the generated OSLF is exactly satisfaction of the
descended predicate by the corresponding semantic equation class. -/
@[simp]
theorem gsltOSLF_satisfies_iff_descend (theory : GSLT.{uTheory})
    (term : theory.Term) (predicate : EquationPredicate theory) :
    (gsltOSLF theory).satisfies (S := ()) term predicate ↔
      descendPredicate theory predicate
        (Quotient.mk theory.equations term) :=
  Iff.rfl

/-- Step-future modality on equation classes. -/
def equationQuotientDiamond (theory : GSLT.{uTheory}) :=
  gsltDiamond (semanticTheory theory)

/-- Step-past modality on equation classes. -/
def equationQuotientBox (theory : GSLT.{uTheory}) :=
  gsltBox (semanticTheory theory)

/-- Quotient diamond, calculated on an authored representative. -/
theorem equationQuotientDiamond_mk_spec (theory : GSLT.{uTheory})
    (predicate : SemanticTerm theory → Prop) (source : theory.Term) :
    equationQuotientDiamond theory predicate
        (Quotient.mk theory.equations source) ↔
      ∃ target : theory.Term,
        theory.Step source target ∧
          predicate (Quotient.mk theory.equations target) := by
  rw [equationQuotientDiamond, gsltDiamond_spec]
  constructor
  · rintro ⟨targetClass, step, holds⟩
    induction targetClass using Quotient.inductionOn with
    | _ target =>
        exact ⟨target,
          (semanticStep_mk_iff_step theory source target).mp step, holds⟩
  · rintro ⟨target, step, holds⟩
    exact ⟨Quotient.mk theory.equations target,
      semanticStep_mk step, holds⟩

/-- Quotient box, calculated on an authored representative. -/
theorem equationQuotientBox_mk_spec (theory : GSLT.{uTheory})
    (predicate : SemanticTerm theory → Prop) (target : theory.Term) :
    equationQuotientBox theory predicate
        (Quotient.mk theory.equations target) ↔
      ∀ source : theory.Term,
        theory.Step source target →
          predicate (Quotient.mk theory.equations source) := by
  rw [equationQuotientBox, gsltBox_spec]
  constructor
  · intro holds source step
    exact holds (Quotient.mk theory.equations source)
      (semanticStep_mk step)
  · intro holds sourceClass step
    induction sourceClass using Quotient.inductionOn with
    | _ source =>
        exact holds source
          ((semanticStep_mk_iff_step theory source target).mp step)

/-- Descending after authored-term diamond agrees exactly with applying
diamond on semantic equation classes. -/
theorem descend_semanticDiamond (theory : GSLT.{uTheory})
    (predicate : EquationPredicate theory) :
    descendPredicate theory (semanticDiamond theory predicate) =
      equationQuotientDiamond theory (descendPredicate theory predicate) := by
  funext semanticTerm
  apply propext
  induction semanticTerm using Quotient.inductionOn with
  | _ source =>
      change gsltDiamond theory predicate.1 source ↔
        equationQuotientDiamond theory (descendPredicate theory predicate)
          (Quotient.mk theory.equations source)
      rw [equationQuotientDiamond_mk_spec, gsltDiamond_spec]
      rfl

/-- Descending after authored-term box agrees exactly with applying box on
semantic equation classes. -/
theorem descend_semanticBox (theory : GSLT.{uTheory})
    (predicate : EquationPredicate theory) :
    descendPredicate theory (semanticBox theory predicate) =
      equationQuotientBox theory (descendPredicate theory predicate) := by
  funext semanticTerm
  apply propext
  induction semanticTerm using Quotient.inductionOn with
  | _ target =>
      change gsltBox theory predicate.1 target ↔
        equationQuotientBox theory (descendPredicate theory predicate)
          (Quotient.mk theory.equations target)
      rw [equationQuotientBox_mk_spec, gsltBox_spec]
      rfl

/-- The semantic quotient retains the generic OSLF Galois connection. -/
theorem equationQuotientGalois (theory : GSLT.{uTheory}) :
    GaloisConnection (equationQuotientDiamond theory)
      (equationQuotientBox theory) :=
  gsltGalois (semanticTheory theory)

#print axioms gsltOSLF_satisfies_iff_descend
#print axioms descend_semanticDiamond
#print axioms descend_semanticBox
#print axioms equationQuotientGalois

end Mettapedia.OSLF.Framework.GSLTQuotientCoherence
