/-!
# Candidate operational/native-type and checked DTT reference canaries

This file keeps three boundaries visible around a parameterized occurrence/Need
candidate and two independently specified typing references:

* the candidate's semantic `Need` GSLT has the exact behavioral types generated by
  OSLF from its step relation;

* the directly indexed LF checker, for de Bruijn lookup, substitution, beta,
  and lambda/Pi checking; and
* the locally nameless two-sort experiment typing relation, for canonical binders and a
  genuinely dependent polymorphic identity.

The OSLF types and the authored DTT judgments are deliberately not identified.
The final non-factorization theorem specializes the generic obstruction showing
that a `LanguageDef` cannot determine an authored typing relation.  These are
narrow agreement and separation canaries, not a claim that either DTT reference
is a complete semantics for an adopted language or the current CeTTa runtime.
-/

open Mettapedia.Machines.BranchLocalNeed

namespace Mettapedia.OSLF.Framework.CandidateDTTCheckedIntroduction

open Mettapedia.OSLF.MeTTaIL.Syntax

namespace OperationalOSLFReference

open Mettapedia.Languages.MeTTa
open Mettapedia.Languages.MeTTa.PrimeCandidates.Language
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis

/-- OSLF exact-target inhabitation for this candidate's `Need` request is exactly
its operational occurrence bound. This is a behavioral type derived
from `needGSLT`; it does not assert an authored dependent typing judgment. -/
theorem need_exactTarget_satisfaction_iff_occurrence
    (model : Model) (space : model.Space) (subject result : Pattern)
    (occurrence : Nat) :
    (gsltOSLF (needGSLT model)).satisfies
        (.request space subject)
        (exactTargetNativeType (needGSLT model)
          (.answer space subject (needKey model space subject) occurrence result)).pred ↔
      occurrence < Multiset.count result
        (model.base.source.occurrences space subject) := by
  exact (satisfies_exactTargetNativeType_iff_step
    (needGSLT model)
    (.request space subject)
    (.answer space subject (needKey model space subject) occurrence result)).trans
      (needGSLT_step_iff model space subject result occurrence)

/-- Positive witness: an actual answer occurrence inhabits its generated
exact-target behavioral type. -/
theorem need_found_inhabits_exactTarget
    (model : Model) (space : model.Space) (subject result : Pattern)
    (occurrence : Nat)
    (copy : occurrence < Multiset.count result
      (model.base.source.occurrences space subject)) :
    (gsltOSLF (needGSLT model)).satisfies
        (.request space subject)
        (exactTargetNativeType (needGSLT model)
          (.answer space subject (needKey model space subject) occurrence result)).pred :=
  (need_exactTarget_satisfaction_iff_occurrence
    model space subject result occurrence).2 copy

/-- Negative witness: a terminal `Need` answer inhabits no generated
exact-target one-step type, because this candidate gives answers no outgoing `Need`
step. -/
theorem need_answer_inhabits_no_exactTarget
    (model : Model) (space : model.Space) (subject result : Pattern)
    (key : NeedKey model) (occurrence : Nat) (target : NeedTerm model) :
    ¬ (gsltOSLF (needGSLT model)).satisfies
        (.answer space subject key occurrence result)
        (exactTargetNativeType (needGSLT model) target).pred := by
  intro holds
  have step := (satisfies_exactTargetNativeType_iff_step
    (needGSLT model) (.answer space subject key occurrence result) target).mp holds
  cases step

end OperationalOSLFReference

namespace AuthoredTypingBoundary

open Mettapedia.GSLT.Core.NonFactorization

/-- The candidate's authored five-field language definition does not determine an
authored typing relation.  In particular, OSLF synthesis from that definition
cannot reconstruct the two-sort experiment judgments below. -/
theorem prime_language_does_not_determine_authored_typing :
    ¬ Factors
        (fun typed : StructuralModal.TypedLanguage => typed.1)
        (fun typed => typed.2) :=
  StructuralModal.authored_typing_not_determined_by_language
    Mettapedia.Languages.MeTTa.PrimeCandidates.LanguageDef.language

end AuthoredTypingBoundary

namespace LFReference

open Mettapedia.GSLT.LanguageDef.LF
open Mettapedia.GSLT.LanguageDef.LFTyping

def zero : Term := .con "zero"
def nat : Term := .con "nat"

theorem identity_checks :
    check 32 corpusSig [] idProof idProofTy = true :=
  corpus_id_check

theorem identity_is_typed :
    HasType corpusSig [] idProof idProofTy :=
  corpus_id_sound

theorem subst_var_zero : subst0 zero (.var 0) = zero := by
  rfl

theorem subst_crosses_inner_binder_without_capture :
    subst0 zero (.lam nat (.var 1)) = .lam nat zero := by
  rfl

theorem beta_identity :
    nfApp [] 2 (.lam nat (.var 0)) zero = zero := by
  rfl

end LFReference

namespace PureReference

open Mettapedia.OSLF.MeTTaIL.Substitution
open Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.Core
open Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.BinderOps
open Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.Fragment
open Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.Typing
open Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.Reduction

def zero : Pattern := .apply "Zero" []

theorem instantiate_var_zero :
    instantiateBVarAt 0 zero (.bvar 0) = zero := by
  simp [instantiateBVarAt, zero, liftBVars]

theorem instantiate_crosses_inner_binder_without_capture :
    instantiateBVarAt 0 zero (mkLam (.bvar 1)) = mkLam zero := by
  simp [instantiateBVarAt, mkLam, zero, liftBVars]

theorem identity_is_typed :
    TwoSortHasType [] (mkLam (.bvar 0)) (mkPi u0 u0) :=
  identity_type

theorem nested_projection_is_typed :
    TwoSortHasType [] (mkLam (mkLam (.bvar 1)))
      (mkPi u0 (mkPi u0 u0)) :=
  fst_proj_type

def polymorphicIdentity : Pattern :=
  mkLam (mkLam (.bvar 0))

def polymorphicIdentityType : Pattern :=
  mkPi u0 (mkPi (.bvar 0) (.bvar 1))

theorem polymorphic_identity_is_typed :
    TwoSortHasType [] polymorphicIdentity polymorphicIdentityType := by
  unfold polymorphicIdentity polymorphicIdentityType
  apply TwoSortHasType.lam_intro [] ∅
      u0 (mkLam (.bvar 0)) (mkPi (.bvar 0) (.bvar 1)) u1
      (.u0_type [])
  intro typeName _
  simp only [openBVar_mkLam, openBVar_mkPi, openBVar]
  apply TwoSortHasType.lam_intro
      [(typeName, u0)] ∅
      (.fvar typeName) (.bvar 0) (.fvar typeName) u0
  · exact .fvar [(typeName, u0)] typeName u0
      List.mem_cons_self TwoSortTermPattern.u0 (by rfl)
  · intro valueName _
    simp only [openBVar]
    exact .fvar
      [(valueName, .fvar typeName), (typeName, u0)]
      valueName (.fvar typeName)
      List.mem_cons_self (TwoSortTermPattern.fvar typeName)
      (by simp [lc_at])

/-! ### Calibrated structural metatheory canaries -/

def argumentName : String := "argument"
def binderName : String := "bound"
def argumentContext : TwoSortCtx := [(argumentName, u0)]

theorem argument_is_typed :
    TwoSortHasType argumentContext (.fvar argumentName) u0 := by
  exact .fvar argumentContext argumentName u0
    (by simp [argumentContext]) TwoSortTermPattern.u0
    (by simp [lc_at, lc_at_list, u0])

/-- The closed identity remains typed after extending its context.  This is a
concrete use of the general weakening theorem, not a second typing rule. -/
theorem identity_survives_context_extension :
    TwoSortHasType argumentContext (mkLam (.bvar 0)) (mkPi u0 u0) := by
  simpa [argumentContext, argumentName] using
    (Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.SubjectReduction.weakening
      (x := argumentName) (U := u0) identity_type)

/-- Substituting the typed argument for a genuinely free binder name preserves
typing in the calibrated one-variable context. -/
theorem calibrated_substitution :
    TwoSortHasType argumentContext
      (Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.SubjectReduction.substFVar
        binderName (.fvar argumentName) (.fvar binderName))
      (Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.SubjectReduction.substFVar
        binderName (.fvar argumentName) u0) := by
  have hBound :
      TwoSortHasType ((binderName, u0) :: argumentContext)
        (.fvar binderName) u0 := by
    exact .fvar _ binderName u0 List.mem_cons_self
      TwoSortTermPattern.u0 (by simp [lc_at, lc_at_list, u0])
  have hSub :=
    Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.SubjectReduction.typing_subst
    (x := binderName) (A := u0) (u := .fvar argumentName)
    (Γ := argumentContext)
    argument_is_typed
    (by simp [lc_at])
    (by
      simp [Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.SubjectReduction.ctxNames,
        argumentContext, argumentName, binderName])
    (by simp [isFresh, freeVars, u0, binderName])
    (by
      simp [Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.SubjectReduction.ctxFresh,
        argumentContext, isFresh, freeVars, u0, binderName])
    hBound
    (Δ := [])
    rfl
    (by
      simp [Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.SubjectReduction.ctxNames,
        binderName])
  simpa [argumentContext] using hSub

def identityApplication : Pattern :=
  mkApp (mkLam (.bvar 0)) (.fvar argumentName)

theorem identity_application_is_typed :
    TwoSortHasType argumentContext identityApplication u0 := by
  unfold identityApplication
  have hApp := TwoSortHasType.app argumentContext ∅
      (mkLam (.bvar 0)) (.fvar argumentName) u0 u0 u1
      identity_survives_context_extension argument_is_typed (by
        intro freshName _
        simpa [openBVar, u0] using
          (TwoSortHasType.u0_type ((freshName, u0) :: argumentContext)))
  simpa [openBVar, u0] using hApp

/-- The actual beta step for the calibrated identity application preserves its
type by the general two-sort experiment subject-reduction theorem. -/
theorem identity_beta_subject_reduction :
    TwoSortHasType argumentContext (.fvar argumentName) u0 := by
  have hReduction :
      TwoSortReduces identityApplication (.fvar argumentName) := by
    unfold identityApplication
    simpa [openBVar] using
      (TwoSortReduces.betaPi (.bvar 0) (.fvar argumentName))
  exact
    Mettapedia.Languages.MeTTa.Experimental.TwoSortPiSigmaId.Pattern.SubjectReduction.twoSortDependent_subject_reduction
      identity_application_is_typed hReduction

end PureReference

/-- Both independent substitution engines eliminate the innermost variable. -/
theorem substitution_agreement_canary :
    (Mettapedia.GSLT.LanguageDef.LFTyping.subst0
      LFReference.zero (.var 0) = LFReference.zero) ∧
    (Mettapedia.OSLF.MeTTaIL.Substitution.instantiateBVarAt
      0 PureReference.zero (.bvar 0) = PureReference.zero) := by
  exact ⟨LFReference.subst_var_zero, PureReference.instantiate_var_zero⟩

