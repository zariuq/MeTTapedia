import Mettapedia.OSLF.Framework.RewriteSystem
import Mettapedia.OSLF.Framework.DerivedModalities
import Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep

/-!
# OSLF synthesis under an explicit rule interpretation

A five-field `LanguageDef` authors the term, equation, and rewrite theory.  A
`RuleInterpretation` says how an authored rewrite schema matches and how its
right-hand side is instantiated.  This module derives the remaining OSLF
objects from those two inputs:

```
LanguageDef + RuleInterpretation + BasePremiseEvaluator
  -> interpreted reduction
  -> reduction span
  -> diamond / box
  -> OSLFTypeSystem
```

The construction adds no semantic fields to `LanguageDef`.  In particular,
the syntactic interpretation is proved to recover the existing contextual
semantics exactly; reflective interpretations remain explicit fibres over the
same authored core.
-/

namespace Mettapedia.OSLF.Framework.InterpretedTypeSynthesis

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.ContextualStep
open Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep
open Mettapedia.OSLF.Framework
open Mettapedia.OSLF.Framework.DerivedModalities

/-! ## The interpreted operational object -/

/-- The least finite contextual reduction generated by a language under one
explicit rule interpretation. -/
def interpretedReduces (interpretation : RuleInterpretation)
    (base : BasePremiseEvaluator) (language : LanguageDef)
    (source target : Pattern) : Prop :=
  Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep.Step
    interpretation base language source target

/-- A rewrite-system view of an explicitly interpreted five-field language. -/
def interpretedRewriteSystem (interpretation : RuleInterpretation)
    (base : BasePremiseEvaluator) (language : LanguageDef)
    (processSort : String := "Proc") : RewriteSystem where
  Sorts := String
  procSort := processSort
  Term := fun _ => Pattern
  Reduces := interpretedReduces interpretation base language

/-- The graph span of an explicitly interpreted language reduction. -/
def interpretedSpan (interpretation : RuleInterpretation)
    (base : BasePremiseEvaluator) (language : LanguageDef) :
    ReductionSpan Pattern where
  Edge := { pair : Pattern × Pattern //
    interpretedReduces interpretation base language pair.1 pair.2 }
  source := fun edge => edge.1.1
  target := fun edge => edge.1.2

/-! ## Modal operators and their laws -/

/-- Step-future modality induced by an explicit rule interpretation. -/
def interpretedDiamond (interpretation : RuleInterpretation)
    (base : BasePremiseEvaluator) (language : LanguageDef) :
    (Pattern → Prop) → Pattern → Prop :=
  derivedDiamond (interpretedSpan interpretation base language)

/-- Step-past modality induced by an explicit rule interpretation. -/
def interpretedBox (interpretation : RuleInterpretation)
    (base : BasePremiseEvaluator) (language : LanguageDef) :
    (Pattern → Prop) → Pattern → Prop :=
  derivedBox (interpretedSpan interpretation base language)

/-- Every explicitly interpreted language induces the canonical OSLF Galois
connection. -/
theorem interpretedGalois (interpretation : RuleInterpretation)
    (base : BasePremiseEvaluator) (language : LanguageDef) :
    GaloisConnection
      (interpretedDiamond interpretation base language)
      (interpretedBox interpretation base language) :=
  derived_galois (interpretedSpan interpretation base language)

/-- The interpreted diamond is exactly existential one-step reachability. -/
theorem interpretedDiamond_spec (interpretation : RuleInterpretation)
    (base : BasePremiseEvaluator) (language : LanguageDef)
    (predicate : Pattern → Prop) (source : Pattern) :
    interpretedDiamond interpretation base language predicate source ↔
      ∃ target,
        interpretedReduces interpretation base language source target ∧
          predicate target := by
  simp only [interpretedDiamond, derivedDiamond, di, pb, Function.comp,
    interpretedSpan]
  constructor
  · rintro ⟨⟨⟨source', target⟩, step⟩, sourceEq, satisfies⟩
    simp at sourceEq
    subst source'
    exact ⟨target, step, satisfies⟩
  · rintro ⟨target, step, satisfies⟩
    exact ⟨⟨⟨source, target⟩, step⟩, rfl, satisfies⟩

/-- The interpreted box is exactly universal predecessor closure. -/
theorem interpretedBox_spec (interpretation : RuleInterpretation)
    (base : BasePremiseEvaluator) (language : LanguageDef)
    (predicate : Pattern → Prop) (target : Pattern) :
    interpretedBox interpretation base language predicate target ↔
      ∀ source,
        interpretedReduces interpretation base language source target →
          predicate source := by
  simp only [interpretedBox, derivedBox, ui, pb, Function.comp,
    interpretedSpan]
  constructor
  · intro holds source step
    exact holds ⟨⟨source, target⟩, step⟩ rfl
  · rintro holds ⟨⟨source, target'⟩, step⟩ targetEq
    simp at targetEq
    subst target'
    exact holds source step

/-! ## The generated OSLF type system -/

/-- The full OSLF type system generated under an explicit rule
interpretation.  Its modal laws are consequences of the interpreted reduction
span, not additional assumptions. -/
def interpretedOSLF (interpretation : RuleInterpretation)
    (base : BasePremiseEvaluator) (language : LanguageDef)
    (processSort : String := "Proc") :
    OSLFTypeSystem
      (interpretedRewriteSystem interpretation base language processSort) where
  Pred := fun _ => Pattern → Prop
  frame := fun _ => inferInstance
  satisfies := fun term predicate => predicate term
  diamond := interpretedDiamond interpretation base language
  diamond_spec := interpretedDiamond_spec interpretation base language
  box := interpretedBox interpretation base language
  box_spec := interpretedBox_spec interpretation base language
  galois := by
    intro first second
    have connection :=
      (interpretedGalois interpretation base language) first second
    simp only [Pi.le_def] at connection
    exact connection

/-! ## Conservative syntactic specialization -/

/-- Executing the explicit syntactic interpretation is exactly the existing
five-field contextual compiler at every finite contextual depth. -/
theorem rewriteAt_syntactic (base : BasePremiseEvaluator)
    (language : LanguageDef) (fuel : Nat) (source : Pattern) :
    Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep.rewriteAt
        .syntactic base language fuel source =
      Mettapedia.OSLF.MeTTaIL.ContextualStep.rewriteAt
        base language fuel source := by
  induction fuel generalizing source with
  | zero => rfl
  | succ fuel inductionHypothesis =>
      simp only [Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep.rewriteAt,
        Mettapedia.OSLF.MeTTaIL.ContextualStep.rewriteAt]
      apply List.flatMap_congr
      intro rule _ruleMember
      unfold Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep.applyRuleUsing
        Mettapedia.OSLF.MeTTaIL.ContextualStep.applyRuleUsing
      rw [show
        Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep.rewriteAt
            .syntactic base language fuel =
          Mettapedia.OSLF.MeTTaIL.ContextualStep.rewriteAt
            base language fuel from
        funext inductionHypothesis]
      simp only [RuleInterpretation.syntactic,
        Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.matchPatternForRule_eq_syntactic,
        Mettapedia.OSLF.MeTTaIL.ReflectiveSubstitution.applyBindingsForRule_eq_syntactic]

/-- The relational syntactic specialization is likewise exactly the existing
five-field contextual relation. -/
theorem interpretedReduces_syntactic_iff
    (base : BasePremiseEvaluator) (language : LanguageDef)
    (source target : Pattern) :
    interpretedReduces .syntactic base language source target ↔
      Mettapedia.OSLF.MeTTaIL.ContextualStep.Step
        base language source target := by
  constructor
  · rintro ⟨fuel, step⟩
    refine ⟨fuel,
      Mettapedia.OSLF.MeTTaIL.ContextualStep.mem_rewriteAt_iff_stepAt.mp ?_⟩
    rw [← rewriteAt_syntactic base language fuel source]
    exact
      Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep.mem_rewriteAt_iff_stepAt.mpr
        step
  · rintro ⟨fuel, step⟩
    refine ⟨fuel,
      Mettapedia.OSLF.MeTTaIL.InterpretedContextualStep.mem_rewriteAt_iff_stepAt.mp ?_⟩
    rw [rewriteAt_syntactic base language fuel source]
    exact
      Mettapedia.OSLF.MeTTaIL.ContextualStep.mem_rewriteAt_iff_stepAt.mpr step

end Mettapedia.OSLF.Framework.InterpretedTypeSynthesis
