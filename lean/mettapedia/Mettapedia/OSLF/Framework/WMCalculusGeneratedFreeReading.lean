import Mettapedia.OSLF.Framework.WMCalculusFreeSemanticModel
import Mettapedia.OSLF.Framework.WMCalculusReadingCategory
import Mathlib.CategoryTheory.Limits.Shapes.Terminal

/-!
# Free generated WM reading among observationally separated models

The multiset separator has an empty state not generated by the closed WM
state grammar. Here the state carrier is instead the quotient of actual
closed state terms by equality of their multiset normal forms. Every state
is therefore generated by an authored term, while query names and evidence
pair-multisets are likewise generated by the WM signature.

This reading has a unique strict interpretation into every lawful reading
whose observational state agreement implies literal state equality. The
separation hypothesis is essential: arbitrary lawful readings can retain
noncommutative raw state history and admit no strict interpretation from a
commutative free state carrier. The universal property concerns semantic
models of the closed WM algebra, not completeness of the authored directed
rewrite rules or the generic LanguageDef classifying theory.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Framework.WMCalculusGeneratedFreeReading

open _root_.CategoryTheory
open _root_.CategoryTheory.Limits
open Mettapedia.OSLF.Framework.WMCalculusOSLFBridge
open Mettapedia.OSLF.Framework.WMCalculusSemantics
open Mettapedia.OSLF.Framework.WMCalculusFreeSemanticModel
open Mettapedia.OSLF.Framework.WMCalculusReadingMorphism
open Mettapedia.OSLF.Framework.WMCalculusReadingCategory

/-- The exact observable equality of closed state terms. -/
def stateNFEq (first second : WMTerm .state) : Prop :=
  stateNormalForm first = stateNormalForm second

def stateNFSetoid : Setoid (WMTerm .state) where
  r := stateNFEq
  iseqv := ⟨by intro term; rfl,
    by intro first second equal; exact equal.symm,
    by intro first middle last left right; exact left.trans right⟩

/-- Every element is represented by a closed WM state term. In particular,
there is no artificial empty state requiring a target-side unit. -/
abbrev GeneratedState := Quotient stateNFSetoid

def generatedState (term : WMTerm .state) : GeneratedState :=
  Quotient.mk stateNFSetoid term

/-- Read a generated state as its multiset of named atoms. -/
def generatedStateNF : GeneratedState → Multiset String :=
  Quotient.lift stateNormalForm (by
    intro first second equal
    exact equal)

@[simp] theorem generatedStateNF_mk (term : WMTerm .state) :
    generatedStateNF (generatedState term) = stateNormalForm term := rfl

theorem generatedStateNF_injective : Function.Injective generatedStateNF := by
  intro first second equal
  induction first using Quotient.inductionOn with
  | _ firstTerm =>
    induction second using Quotient.inductionOn with
    | _ secondTerm =>
      exact Quotient.sound equal

/-- No closed state term has an empty state normal form. This verifies that
the generated carrier did not sneak in a state unit absent from the syntax. -/
theorem stateNormalForm_card_pos : (term : WMTerm .state) →
    0 < (stateNormalForm term).card
  | .state name => by simp [stateNormalForm]
  | .revise first second => by
      have positive := stateNormalForm_card_pos first
      simp only [stateNormalForm, Multiset.card_add]
      omega

theorem generatedStateNF_ne_zero (state : GeneratedState) :
    generatedStateNF state ≠ 0 := by
  induction state using Quotient.inductionOn with
  | _ term =>
    intro empty
    have positive := stateNormalForm_card_pos term
    change generatedStateNF (generatedState term) = 0 at empty
    have emptyNF : stateNormalForm term = 0 := by
      simpa only [generatedStateNF_mk] using empty
    rw [emptyNF, Multiset.card_zero] at positive
    exact Nat.not_lt_zero _ positive

/-- Revision remains a generated state and is independent of the chosen
syntactic representatives. -/
def generatedRevise (first second : GeneratedState) : GeneratedState :=
  Quotient.liftOn₂ first second
    (fun firstTerm secondTerm =>
      generatedState (.revise firstTerm secondTerm))
    (by
      intro first first' second second' firstEq secondEq
      apply Quotient.sound
      change stateNormalForm (.revise first first') =
        stateNormalForm (.revise second second')
      simp only [stateNormalForm]
      exact congrArg₂ (· + ·) firstEq secondEq)

@[simp] theorem generatedRevise_mk
    (first second : WMTerm .state) :
    generatedRevise (generatedState first) (generatedState second) =
      generatedState (.revise first second) := rfl

theorem generatedStateNF_revise (first second : GeneratedState) :
    generatedStateNF (generatedRevise first second) =
      generatedStateNF first + generatedStateNF second := by
  induction first using Quotient.inductionOn with
  | _ firstTerm =>
    induction second using Quotient.inductionOn with
    | _ secondTerm =>
      change generatedStateNF
        (generatedRevise (generatedState firstTerm)
          (generatedState secondTerm)) =
          stateNormalForm firstTerm + stateNormalForm secondTerm
      rw [generatedRevise_mk]
      simp only [generatedStateNF_mk, stateNormalForm]

/-- The generated reading has no state unit, matching the authored grammar;
its evidence sort does have the authored zero. -/
def generatedReading :
    WMReading GeneratedState String (Multiset (String × String)) where
  revise := generatedRevise
  extract := fun state query =>
    (generatedStateNF state).map (fun name => (name, query))
  combine := (· + ·)
  zero := 0
  world := fun name => generatedState (.state name)
  query := id

theorem generatedReading_coreLaws : generatedReading.CoreLaws where
  extract_revise := by
    intro first second query
    change (generatedStateNF (generatedRevise first second)).map
        (fun name => (name, query)) =
      (generatedStateNF first).map (fun name => (name, query)) +
        (generatedStateNF second).map (fun name => (name, query))
    rw [generatedStateNF_revise, Multiset.map_add]
  combine_comm := by intro first second; exact add_comm first second
  combine_assoc := by intro first second third; exact add_assoc first second third
  combine_zero := by intro value; exact add_zero value

/-- Denotation of closed state syntax is precisely its generated class. -/
theorem generatedReading_denote_state : (term : WMTerm .state) →
    generatedReading.denote term = generatedState term
  | .state _ => rfl
  | .revise first second => by
      change generatedRevise
        (generatedReading.denote first)
        (generatedReading.denote second) =
          generatedState (.revise first second)
      rw [generatedReading_denote_state first,
        generatedReading_denote_state second]
      rfl

/-- The generated reading tests every state-name multiplicity at a named
query, so its behavioral equality is literal equality. -/
theorem generatedReading_state_agree_iff_eq
    (first second : GeneratedState) :
    generatedReading.Agree .state first second ↔ first = second := by
  constructor
  · intro agree
    have mapped := agree "separating-query"
    change (generatedStateNF first).map
        (fun name => (name, "separating-query")) =
      (generatedStateNF second).map
        (fun name => (name, "separating-query")) at mapped
    apply generatedStateNF_injective
    apply Multiset.map_injective
      (f := fun name : String => (name, "separating-query"))
    · intro a b equal
      exact congrArg Prod.fst equal
    · exact mapped
  · intro equal
    subst second
    exact generatedReading.agree_refl .state first

def generatedModel : LawfulReading where
  State := GeneratedState
  Query := String
  Evidence := Multiset (String × String)
  reading := generatedReading
  laws := generatedReading_coreLaws

theorem generatedModel_separated : ObservationSeparated generatedModel :=
  fun first second agree =>
    (generatedReading_state_agree_iff_eq first second).1 agree

/-! ## Canonical interpretation into a separated lawful reading -/

variable (target : LawfulReading) (separated : ObservationSeparated target)

/-- The map on generated states is well defined exactly because the target
identifies observationally agreeing denotations as literal states. -/
noncomputable def generatedStateMap : GeneratedState → target.State :=
  Quotient.lift (fun term => target.reading.denote term) (by
    intro first second same
    exact separated _ _
      ((allReadingsStateAgree_iff_normalForm_eq first second).2
        same _ _ _ target.reading target.laws))

@[simp] theorem generatedStateMap_mk (term : WMTerm .state) :
    generatedStateMap target separated (generatedState term) =
      target.reading.denote term := rfl

/-- The strict interpretation of the generated reading into a target whose
state equality is observationally separated. No unit-state choice is made. -/
noncomputable def generatedTo :
    ReadingMorphism generatedReading target.reading where
  mapState := generatedStateMap target separated
  mapQuery := target.reading.query
  mapEvidence := evaluateEvidence target.reading target.laws
  revise_comm := by
    intro first second
    induction first using Quotient.inductionOn with
    | _ firstTerm =>
      induction second using Quotient.inductionOn with
      | _ secondTerm =>
        rfl
  extract_comm := by
    intro state query
    induction state using Quotient.inductionOn with
    | _ term =>
      exact (extract_denote_state_eq_evaluate
        target.reading target.laws term query).symm
  combine_comm := by
    intro first second
    exact foldContributions_add target.reading target.laws
      (fun pair => target.reading.extract
        (target.reading.world pair.1) (target.reading.query pair.2))
      first second
  zero_comm := foldContributions_zero target.reading target.laws _
  world_comm := by intro name; rfl
  query_comm := by intro name; rfl

/-- Every generated state is named by closed syntax, so a strict reading
morphism has no freedom in its state component. -/
theorem generatedTo_state_unique
    (hom : ReadingMorphism generatedReading target.reading) :
    hom.mapState = (generatedTo target separated).mapState := by
  funext state
  induction state using Quotient.inductionOn with
  | _ term =>
    have mapped := hom.denote_map term
    change hom.mapState (generatedReading.denote term) =
      target.reading.denote term at mapped
    rw [generatedReading_denote_state] at mapped
    exact mapped

/-- Every query is a named atom, so the query component is forced. -/
theorem generatedTo_query_unique
    (hom : ReadingMorphism generatedReading target.reading) :
    hom.mapQuery = (generatedTo target separated).mapQuery := by
  funext name
  exact hom.query_comm name

/-- Singleton pair evidence is the extraction of a named state at a named
query, so an interpretation cannot choose its value independently. -/
private theorem singletonEvidence_forced
    (hom : ReadingMorphism generatedReading target.reading)
    (pair : String × String) :
    hom.mapEvidence ({pair} : Multiset (String × String)) =
      target.reading.extract
        (target.reading.world pair.1) (target.reading.query pair.2) := by
  cases pair with
  | mk name query =>
      have extracted := hom.extract_comm
        (generatedReading.world name) query
      change hom.mapEvidence
          (generatedReading.extract
            (generatedReading.world name)
            (generatedReading.query query)) =
          target.reading.extract
            (hom.mapState (generatedReading.world name))
            (hom.mapQuery (generatedReading.query query)) at extracted
      rw [hom.world_comm name, hom.query_comm query] at extracted
      simpa [generatedReading, generatedStateNF_mk,
        stateNormalForm] using extracted

/-- Zero, combination, and the singleton extraction above generate the
whole evidence carrier. Thus a strict map is determined on evidence too. -/
theorem generatedTo_evidence_unique
    (hom : ReadingMorphism generatedReading target.reading) :
    hom.mapEvidence = (generatedTo target separated).mapEvidence := by
  funext atoms
  induction atoms using Multiset.induction_on with
  | empty =>
      exact hom.zero_comm
  | @cons pair rest ih =>
      rw [← Multiset.singleton_add]
      change hom.mapEvidence
          (generatedReading.combine {pair} rest) =
        (generatedTo target separated).mapEvidence
          (generatedReading.combine {pair} rest)
      rw [hom.combine_comm,
        (generatedTo target separated).combine_comm]
      have canonicalSingleton :
          (generatedTo target separated).mapEvidence
            ({pair} : Multiset (String × String)) =
          target.reading.extract
            (target.reading.world pair.1)
            (target.reading.query pair.2) := by
        change evaluateEvidence target.reading target.laws {pair} = _
        exact foldContributions_singleton target.reading target.laws
          (fun atom => target.reading.extract
            (target.reading.world atom.1) (target.reading.query atom.2))
          pair
      rw [singletonEvidence_forced target hom pair,
        canonicalSingleton, ih]

/-- Closed WM syntax has a unique strict interpretation into each
observationally separated lawful reading. This is the precise relative
initiality statement; nonseparated raw-history readings are excluded. -/
theorem generatedTo_unique
    (hom : ReadingMorphism generatedReading target.reading) :
    hom = generatedTo target separated := by
  have state := generatedTo_state_unique target separated hom
  have query := generatedTo_query_unique target separated hom
  have evidence := generatedTo_evidence_unique target separated hom
  exact ReadingMorphism.ext hom (generatedTo target separated)
    state query evidence

theorem generatedMorphism_subsingleton
    (separated : ObservationSeparated target) :
    Subsingleton (ReadingMorphism generatedReading target.reading) := by
  constructor
  intro first second
  exact (generatedTo_unique target separated first).trans
    (generatedTo_unique target separated second).symm

theorem generatedMorphism_nonempty
    (separated : ObservationSeparated target) :
    Nonempty (ReadingMorphism generatedReading target.reading) :=
  ⟨generatedTo target separated⟩

/-! ## The actual category in which the generated reading is initial -/

/-- Lawful WM readings whose state carrier has no hidden distinction beyond
all query observations. The homs remain strict WM-reading morphisms. -/
structure SeparatedReading where
  model : LawfulReading
  separated : ObservationSeparated model

instance : Category SeparatedReading where
  Hom first second := first.model ⟶ second.model
  id first := 𝟙 first.model
  comp first second := first ≫ second
  id_comp := by
    intro first second hom
    exact Category.id_comp hom
  comp_id := by
    intro first second hom
    exact Category.comp_id hom
  assoc := by
    intro first second third fourth f g h
    exact Category.assoc f g h

def generatedSeparated : SeparatedReading where
  model := generatedModel
  separated := generatedModel_separated

/-- Genuine categorical initiality for the closed WM semantic algebra in
the separated-reading category. It does not classify arbitrary LanguageDef
models, raw-history readings, or operational rewrite derivations. -/
noncomputable def generatedSeparated_isInitial : IsInitial generatedSeparated :=
  IsInitial.ofUniqueHom
    (fun target => generatedTo target.model target.separated)
    (fun target hom => generatedTo_unique target.model target.separated hom)

end Mettapedia.OSLF.Framework.WMCalculusGeneratedFreeReading
