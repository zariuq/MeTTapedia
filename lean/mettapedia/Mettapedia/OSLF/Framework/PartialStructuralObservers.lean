import Mettapedia.OSLF.Framework.InstrumentMonotonicity

/-!
# Independent structural tests and their partial-observer characterization

Structural satisfaction reads the independent constructor algebra. Only
connectives licensed by the instrument set are admitted. A constructed
characteristic formula describes the entire partial view, including the
negative test that no opened root is present at an opaque boundary. This
earns logical equivalence exactly at labelled kit bisimilarity without an
image-finiteness premise.

Equations are independently generated by their supplied instances and
constructor congruence. Checking those generators earns, and is necessary
for, descent of the view and every admitted structural test. Binding and
interactive observation remain separate admission questions.
-/

set_option autoImplicit false

noncomputable section

namespace Mettapedia.OSLF.Framework.InstrumentObservations

universe u

variable {Symbols : Type u} {arity : Symbols → Nat}

inductive Formula (Symbols : Type u) (arity : Symbols → Nat) where
  | top
  | neg (body : Formula Symbols arity)
  | conj (left right : Formula Symbols arity)
  | headed (constructor : Symbols) (arguments : Fin (arity constructor) → Formula Symbols arity)

def Satisfies : Formula Symbols arity → Tree Symbols arity → Prop
  | .top, _ => True
  | .neg body, tree => ¬ Satisfies body tree
  | .conj left right, tree => Satisfies left tree ∧ Satisfies right tree
  | .headed constructor formulas, tree =>
      ∃ arguments : Fin (arity constructor) → Tree Symbols arity,
        tree = .node constructor arguments ∧
          ∀ position, Satisfies (formulas position) (arguments position)

inductive AdmittedFormula (opened : Policy Symbols) : Formula Symbols arity → Prop where
  | top : AdmittedFormula opened .top
  | neg {body} : AdmittedFormula opened body → AdmittedFormula opened (.neg body)
  | conj {left right} : AdmittedFormula opened left → AdmittedFormula opened right →
      AdmittedFormula opened (.conj left right)
  | headed (constructor : Symbols) (arguments : Fin (arity constructor) → Formula Symbols arity)
      (permission : opened constructor)
      (children : ∀ position, AdmittedFormula opened (arguments position)) :
      AdmittedFormula opened (.headed constructor arguments)

theorem satisfies_of_same_view (opened : Policy Symbols)
    (formula : Formula Symbols arity) (admitted : AdmittedFormula opened formula)
    {left right : Tree Symbols arity} (same : view opened left = view opened right) :
    Satisfies formula left ↔ Satisfies formula right := by
  induction admitted generalizing left right with
  | top => exact Iff.rfl
  | neg _ inductionHypothesis => exact not_congr (inductionHypothesis same)
  | conj _ _ leftIH rightIH => exact and_congr (leftIH same) (rightIH same)
  | headed constructor formulas permission children inductionHypothesis =>
    constructor
    · rintro ⟨arguments, rfl, holds⟩
      obtain ⟨compared, shape, readings⟩ :=
        related_visible_term opened (arguments := arguments) (other := .term right)
          permission (congrArg Readout.term same)
      have termShape : right = .node constructor compared := State.term.inj shape
      exact ⟨compared, termShape, fun position =>
        (inductionHypothesis position (readings position)).1 (holds position)⟩
    · rintro ⟨arguments, rfl, holds⟩
      obtain ⟨compared, shape, readings⟩ :=
        related_visible_term opened (arguments := arguments) (other := .term left)
          permission (congrArg Readout.term same.symm)
      have termShape : left = .node constructor compared := State.term.inj shape
      exact ⟨compared, termShape, fun position =>
        (inductionHypothesis position (readings position)).1 (holds position)⟩

def noneOpened : List Symbols → Formula Symbols arity
  | [] => .top
  | constructor :: rest =>
      .conj (.neg (.headed constructor (fun _ => .top))) (noneOpened rest)

theorem satisfies_head_top (constructor second : Symbols)
    (arguments : Fin (arity second) → Tree Symbols arity) :
    Satisfies (.headed constructor (fun _ => .top)) (.node second arguments) ↔
      constructor = second := by
  constructor
  · rintro ⟨_, shape, _⟩
    exact (Tree.node.inj shape).1.symm
  · rintro rfl
    exact ⟨arguments, rfl, fun _ => trivial⟩

theorem satisfies_noneOpened (kit : List Symbols) (constructor : Symbols)
    (arguments : Fin (arity constructor) → Tree Symbols arity) :
    Satisfies (noneOpened kit) (.node constructor arguments) ↔ constructor ∉ kit := by
  induction kit with
  | nil => simp [noneOpened, Satisfies]
  | cons first rest inductionHypothesis =>
    change (¬ Satisfies (.headed first (fun _ => .top)) (.node constructor arguments)) ∧
      Satisfies (noneOpened rest) (.node constructor arguments) ↔ constructor ∉ first :: rest
    rw [satisfies_head_top, inductionHypothesis]
    simp only [List.mem_cons, not_or, ne_comm]

theorem noneOpened_admitted (kit : List Symbols) :
    AdmittedFormula (arity := arity) (fun constructor => constructor ∈ kit) (noneOpened kit) := by
  have auxiliary : ∀ part : List Symbols, part ⊆ kit →
      AdmittedFormula (arity := arity) (fun constructor => constructor ∈ kit) (noneOpened part) := by
    intro part
    induction part with
    | nil => intro _; exact .top
    | cons constructor rest inductionHypothesis =>
      intro inclusion
      refine .conj (.neg (.headed constructor (fun _ => .top) ?_ (fun _ => .top))) ?_
      · exact inclusion (List.mem_cons_self)
      · exact inductionHypothesis (fun _ member => inclusion (List.mem_cons_of_mem _ member))
  exact auxiliary kit (fun _ member => member)

def characteristic (kit : List Symbols) : Tree Symbols arity → Formula Symbols arity
  | .node constructor arguments => by
      classical
      exact if constructor ∈ kit then
        .headed constructor (fun position => characteristic kit (arguments position))
      else noneOpened kit

theorem characteristic_admitted (kit : List Symbols) (tree : Tree Symbols arity) :
    AdmittedFormula (fun constructor => constructor ∈ kit) (characteristic kit tree) := by
  classical
  induction tree with
  | node constructor arguments inductionHypothesis =>
    by_cases allowed : constructor ∈ kit
    · simp only [characteristic, if_pos allowed]
      exact .headed constructor _ allowed inductionHypothesis
    · simp only [characteristic, if_neg allowed]
      exact noneOpened_admitted kit

theorem noneOpened_iff_opaque (kit : List Symbols) (tree : Tree Symbols arity) :
    Satisfies (noneOpened kit) tree ↔
      view (fun constructor => constructor ∈ kit) tree = .opaque := by
  classical
  cases tree with
  | node constructor arguments =>
    rw [satisfies_noneOpened]
    by_cases allowed : constructor ∈ kit
    · simp only [view, if_pos allowed]
      simp [allowed]
    · simp only [view, if_neg allowed]
      simp [allowed]

theorem characteristic_spec (kit : List Symbols) (left right : Tree Symbols arity) :
    Satisfies (characteristic kit left) right ↔
      view (fun constructor => constructor ∈ kit) left =
        view (fun constructor => constructor ∈ kit) right := by
  classical
  induction left generalizing right with
  | node constructor arguments inductionHypothesis =>
    by_cases allowed : constructor ∈ kit
    · simp only [characteristic, if_pos allowed]
      constructor
      · rintro ⟨compared, rfl, holds⟩
        simp only [view, if_pos allowed]
        congr 1
        funext position
        exact (inductionHypothesis position _).1 (holds position)
      · intro same
        obtain ⟨compared, shape, readings⟩ :=
          related_visible_term (fun constructor => constructor ∈ kit)
            (arguments := arguments) (other := .term right) allowed
            (congrArg Readout.term same)
        exact ⟨compared, State.term.inj shape,
          fun position => (inductionHypothesis position _).2 (readings position)⟩
    · simp only [characteristic, view, if_neg allowed]
      exact (noneOpened_iff_opaque kit right).trans eq_comm

def LogicallyEquivalent (opened : Policy Symbols) (left right : Tree Symbols arity) : Prop :=
  ∀ formula, AdmittedFormula opened formula → (Satisfies formula left ↔ Satisfies formula right)

theorem logicallyEquivalent_iff_view (kit : List Symbols) (left right : Tree Symbols arity) :
    LogicallyEquivalent (fun constructor => constructor ∈ kit) left right ↔
      view (fun constructor => constructor ∈ kit) left =
        view (fun constructor => constructor ∈ kit) right := by
  constructor
  · intro equivalent
    have self : Satisfies (characteristic kit left) left :=
      (characteristic_spec kit left left).2 rfl
    exact (characteristic_spec kit left right).1
      ((equivalent _ (characteristic_admitted kit left)).1 self)
  · intro same formula admitted
    exact satisfies_of_same_view _ formula admitted same

theorem partial_observer_characterization (kit : List Symbols)
    (left right : Tree Symbols arity) :
    Bisimilar (fun constructor => constructor ∈ kit) (.term left) (.term right) ↔
      LogicallyEquivalent (fun constructor => constructor ∈ kit) left right :=
  (term_bisimilar_iff_view _ left right).trans
    (logicallyEquivalent_iff_view kit left right).symm

theorem complete_view_injective (opened : Policy Symbols)
    (complete : ∀ constructor, opened constructor)
    {left right : Tree Symbols arity} (same : view opened left = view opened right) :
    left = right := by
  classical
  induction left generalizing right with
  | node constructor arguments inductionHypothesis =>
    obtain ⟨compared, shape, readings⟩ :=
      related_visible_term opened (arguments := arguments) (other := .term right)
        (complete constructor) (congrArg Readout.term same)
    have termShape : right = .node constructor compared := State.term.inj shape
    rw [termShape]
    congr 1
    funext position
    exact inductionHypothesis position (readings position)

theorem complete_kit_reconstruction (opened : Policy Symbols)
    (complete : ∀ constructor, opened constructor) (left right : Tree Symbols arity) :
    Bisimilar opened (.term left) (.term right) ↔ left = right := by
  rw [term_bisimilar_iff_view]
  exact ⟨complete_view_injective opened complete, fun same => congrArg (view opened) same⟩

inductive Equation (generators : Tree Symbols arity → Tree Symbols arity → Prop) :
    Tree Symbols arity → Tree Symbols arity → Prop where
  | refl (tree) : Equation generators tree tree
  | generator {left right} : generators left right → Equation generators left right
  | symm {left right} : Equation generators left right → Equation generators right left
  | trans {left middle right} : Equation generators left middle →
      Equation generators middle right → Equation generators left right
  | congruence (constructor : Symbols)
      (first second : Fin (arity constructor) → Tree Symbols arity)
      (children : ∀ position, Equation generators (first position) (second position)) :
      Equation generators (.node constructor first) (.node constructor second)

def LocalEquationAdmission (opened : Policy Symbols)
    (generators : Tree Symbols arity → Tree Symbols arity → Prop) : Prop :=
  ∀ left right, generators left right → view opened left = view opened right

theorem equations_preserve_view (opened : Policy Symbols)
    {generators : Tree Symbols arity → Tree Symbols arity → Prop}
    (admission : LocalEquationAdmission opened generators)
    {left right : Tree Symbols arity} (equation : Equation generators left right) :
    view opened left = view opened right := by
  classical
  induction equation with
  | refl => rfl
  | generator supplied => exact admission _ _ supplied
  | symm _ inductionHypothesis => exact inductionHypothesis.symm
  | trans _ _ firstIH secondIH => exact firstIH.trans secondIH
  | congruence constructor first second _ inductionHypothesis =>
    by_cases allowed : opened constructor
    · simp only [view, if_pos allowed]
      exact congrArg (View.visible constructor) (funext inductionHypothesis)
    · simp only [view, if_neg allowed]

theorem equation_descent_iff (opened : Policy Symbols)
    (generators : Tree Symbols arity → Tree Symbols arity → Prop) :
    LocalEquationAdmission opened generators ↔
      ∀ left right, Equation generators left right → view opened left = view opened right :=
  ⟨fun admission _ _ equation => equations_preserve_view opened admission equation,
    fun descent _ _ supplied => descent _ _ (.generator supplied)⟩

def equationSetoid (generators : Tree Symbols arity → Tree Symbols arity → Prop) :
    Setoid (Tree Symbols arity) where
  r := Equation generators
  iseqv := ⟨Equation.refl, Equation.symm, Equation.trans⟩

def quotientView (opened : Policy Symbols)
    (generators : Tree Symbols arity → Tree Symbols arity → Prop)
    (admission : LocalEquationAdmission opened generators) :
    Quotient (equationSetoid generators) → View Symbols arity :=
  Quotient.lift (view opened) (fun _ _ equation => equations_preserve_view opened admission equation)

theorem quotientView_readout (opened : Policy Symbols)
    (generators : Tree Symbols arity → Tree Symbols arity → Prop)
    (admission : LocalEquationAdmission opened generators) (tree : Tree Symbols arity) :
    quotientView opened generators admission (Quotient.mk _ tree) = view opened tree := rfl

theorem equation_calibration (opened : Policy Symbols)
    {generators : Tree Symbols arity → Tree Symbols arity → Prop}
    (admission : LocalEquationAdmission opened generators)
    {left right : Tree Symbols arity} (equation : Equation generators left right) :
    Bisimilar opened (.term left) (.term right) :=
  (term_bisimilar_iff_view opened left right).2
    (equations_preserve_view opened admission equation)

theorem structural_equation_invariance (opened : Policy Symbols)
    {generators : Tree Symbols arity → Tree Symbols arity → Prop}
    (admission : LocalEquationAdmission opened generators)
    (formula : Formula Symbols arity) (admitted : AdmittedFormula opened formula)
    {left right : Tree Symbols arity} (equation : Equation generators left right) :
    Satisfies formula left ↔ Satisfies formula right :=
  satisfies_of_same_view opened formula admitted (equations_preserve_view opened admission equation)

end Mettapedia.OSLF.Framework.InstrumentObservations
