import Mettapedia.OSLF.Framework.FormulaFixpoint

/-!
# Generated scopes, and membership by descent

A predicate over names does not only describe; it delimits, and a delimited
collection of names is a region.  What makes a region worth having is that it
can be finitely described and unboundedly large at once, which a list cannot
be.  The description is a generator — a least fixed point — and the region is
its extension.

## What this module does and does not formalise

The source material's generator is

    N = µX. @((ϕ ∨ X) | (ψ ∨ X))

with the atoms applied to the parallel *parts* under the quote, the recursive
occurrence read in process position as the drop of a name in the extension, and
`|` the separating conjunction.  What is defined below is a **variant**, and the
four differences are stated here rather than discovered later.

1. The atoms are applied to the whole name, not to the parts, so the base case
   is at the root instead of at the leaves of the composition.
2. The drop coercion is absent: the recursive occurrence is `quote left` rather
   than the drop of a member.  Since a quote of a drop collapses, the source's
   reading implies this one and not conversely, so the variant is strictly more
   permissive.
3. The cut is positional — a literal two-element bag — not the separating
   conjunction of the sibling module.  In consequence this predicate is **not
   invariant under the equations**: the same process written with the parallel
   former's own declared flattening or unit laws is not recognised.
4. Disjointness is replaced by the two-element shape, so the uniqueness of the
   split is syntactic and the source's disjointness hypothesis is not expressible
   here.

Repairing (1)–(4) needs a cut connective in a formula language, which neither
formula language in this tree currently has; that is the same gap the separating
conjunction module runs into.

## Why membership is decidable

The split is unique because the shape is, so the descent is deterministic rather
than a search.  It terminates because quoting a part of a composition is a
structural subterm decrease — `sizeOf_quote_lt_left` is exactly that and nothing
more.  Note that this is **weaker** than the source's situation and must not be
credited to reflection: the source needs the no-self-code property precisely
because its recursion goes through the drop coercion, so its recursive argument
is not a syntactic subterm.  Having omitted that coercion, the variant below
gets termination for free.

The decision procedure and the fixed point are then proved to agree, in both
directions: `inScope_iff`.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Framework.GeneratedScope

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.Framework.FormulaFixpoint

/-- The quotation of a process. -/
def quote (process : Pattern) : Pattern := .apply "NQuote" [process]

/-- The parallel composition of two processes. -/
def par (left right : Pattern) : Pattern :=
  .collection .hashBag [left, right] none

/-! ## The generator -/

/-- The transformer whose least fixed point is the generated scope. -/
def scopeStep (atomA atomB : Pred) : Pred →o Pred where
  toFun := fun inScope name =>
    atomA name ∨ atomB name ∨
      ∃ left right, name = quote (par left right) ∧
        inScope (quote left) ∧ inScope (quote right)
  monotone' := by
    intro first second inclusion name
    rintro (ha | hb | ⟨left, right, hname, hleft, hright⟩)
    · exact Or.inl ha
    · exact Or.inr (Or.inl hb)
    · exact Or.inr (Or.inr
        ⟨left, right, hname, inclusion _ hleft, inclusion _ hright⟩)

/-- The scope generated by two atoms. -/
def generatedScope (atomA atomB : Pred) : Pred := lfp (scopeStep atomA atomB)

/-- An atom is in the scope it generates. -/
theorem mem_of_atomA {atomA atomB : Pred} {name : Pattern} (ha : atomA name) :
    generatedScope atomA atomB name :=
  mem_lfp_of_mem_apply (Or.inl ha)

theorem mem_of_atomB {atomA atomB : Pred} {name : Pattern} (hb : atomB name) :
    generatedScope atomA atomB name :=
  mem_lfp_of_mem_apply (Or.inr (Or.inl hb))

/-- A composition of members is a member: this is the generator's unfolding,
and it is what makes the extension unboundedly large while the generator does
not grow. -/
theorem mem_of_par {atomA atomB : Pred} {left right : Pattern}
    (hleft : generatedScope atomA atomB (quote left))
    (hright : generatedScope atomA atomB (quote right)) :
    generatedScope atomA atomB (quote (par left right)) :=
  mem_lfp_of_mem_apply (Or.inr (Or.inr ⟨left, right, rfl, hleft, hright⟩))

/-- **Survey by induction.**  Anything true of the atoms and preserved by
composition is true throughout the scope.  This is the least fixed point's
induction principle, and it is the sense in which a generated scope can be
surveyed at all. -/
theorem scope_induction {atomA atomB invariant : Pred}
    (baseA : ∀ name, atomA name → invariant name)
    (baseB : ∀ name, atomB name → invariant name)
    (step : ∀ left right, invariant (quote left) → invariant (quote right) →
      invariant (quote (par left right))) :
    ∀ name, generatedScope atomA atomB name → invariant name := by
  have pre : (scopeStep atomA atomB) invariant ≤ invariant := by
    intro name
    rintro (ha | hb | ⟨left, right, hname, hleft, hright⟩)
    · exact baseA name ha
    · exact baseB name hb
    · rw [hname]
      exact step left right hleft hright
  exact fun name member => lfp_le pre name member

/-! ## Membership by descent -/

/-- Quoting one part of a composition is strictly smaller than quoting the
whole: the no-self-code property, in the form the descent needs. -/
theorem sizeOf_quote_lt_left (left right : Pattern) :
    sizeOf (quote left) < sizeOf (quote (par left right)) := by
  simp +arith [quote, par, Pattern.apply.sizeOf_spec, Pattern.collection.sizeOf_spec]

theorem sizeOf_quote_lt_right (left right : Pattern) :
    sizeOf (quote right) < sizeOf (quote (par left right)) := by
  simp +arith [quote, par, Pattern.apply.sizeOf_spec, Pattern.collection.sizeOf_spec]

/-- Membership decided by descent.  The split is unique, so no search is
needed; the descent terminates because quoting a part is smaller than quoting
the whole. -/
def inScope (atomA atomB : Pattern → Bool) : Pattern → Bool
  | .apply "NQuote" [.collection .hashBag [left, right] none] =>
      atomA (quote (par left right)) || atomB (quote (par left right)) ||
        (inScope atomA atomB (quote left) && inScope atomA atomB (quote right))
  | name => atomA name || atomB name
termination_by name => sizeOf name
decreasing_by
  · exact sizeOf_quote_lt_left _ _
  · exact sizeOf_quote_lt_right _ _

/-- The decision procedure never reports a member the generator excludes. -/
theorem generatedScope_of_inScope {atomA atomB : Pattern → Bool} (name : Pattern) :
    inScope atomA atomB name = true →
      generatedScope (fun t => atomA t = true) (fun t => atomB t = true) name := by
  induction name using inScope.induct with
  | case1 left right ihLeft ihRight =>
      intro decision
      rw [inScope] at decision
      rcases Bool.or_eq_true_iff.mp decision with atoms | split
      · rcases Bool.or_eq_true_iff.mp atoms with ha | hb
        · exact mem_of_atomA ha
        · exact mem_of_atomB hb
      · obtain ⟨hleft, hright⟩ := Bool.and_eq_true_iff.mp split
        exact mem_of_par (ihLeft hleft) (ihRight hright)
  | case2 name notSpecial =>
      intro decision
      rw [inScope.eq_def] at decision
      split at decision
      · exact (notSpecial _ _ rfl).elim
      · rcases Bool.or_eq_true_iff.mp decision with ha | hb
        · exact mem_of_atomA ha
        · exact mem_of_atomB hb

/-- An atom is reported wherever it holds. -/
theorem inScope_of_atom {atomA atomB : Pattern → Bool} :
    ∀ name : Pattern, (atomA name || atomB name) = true →
      inScope atomA atomB name = true := by
  intro name
  induction name using inScope.induct with
  | case1 left right _ _ =>
      intro atom
      rw [inScope]
      exact Bool.or_eq_true_iff.mpr (Or.inl (by simpa [quote, par] using atom))
  | case2 name notSpecial =>
      intro atom
      rw [inScope.eq_def]
      split
      · exact (notSpecial _ _ rfl).elim
      · exact atom

/-- And it reports every member the generator includes. -/
theorem inScope_of_generatedScope {atomA atomB : Pattern → Bool} :
    ∀ name : Pattern,
      generatedScope (fun t => atomA t = true) (fun t => atomB t = true) name →
        inScope atomA atomB name = true := by
  refine scope_induction (invariant := fun name => inScope atomA atomB name = true)
    ?_ ?_ ?_
  · intro name ha
    exact inScope_of_atom name (Bool.or_eq_true_iff.mpr (Or.inl ha))
  · intro name hb
    exact inScope_of_atom name (Bool.or_eq_true_iff.mpr (Or.inr hb))
  · intro left right hleft hright
    rw [quote, par, inScope]
    exact Bool.or_eq_true_iff.mpr
      (Or.inr (Bool.and_eq_true_iff.mpr ⟨hleft, hright⟩))

/-- **Membership is decidable by descent.**  The procedure and the generated
scope agree, so the region a generator describes is one an agent can survey. -/
theorem inScope_iff {atomA atomB : Pattern → Bool} (name : Pattern) :
    inScope atomA atomB name = true ↔
      generatedScope (fun t => atomA t = true) (fun t => atomB t = true) name :=
  ⟨generatedScope_of_inScope name, inScope_of_generatedScope name⟩

end Mettapedia.OSLF.Framework.GeneratedScope
