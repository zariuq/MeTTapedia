private instance : LawfulBEq Pattern where
  rfl := by intro value; change decide (value = value) = true; simp
  eq_of_beq := by intro left right same; change decide (left = right) = true at same; exact of_decide_eq_true same

/-! ## The communication index -/

/-- **An entry of the communication index**: an input or an output on a channel, with the input's continuation or the
output's datum, standing in the store or generated by a replicated component. -/
structure Entry where
  channel : Pattern
  /-- The input's continuation, or the output's datum. -/
  payload : Pattern
  /-- The guard that reacts: a component of the store, or the copy a replicated component generates. -/
  guard : Pattern
  input : Bool
  generated : Bool
deriving DecidableEq

/-- The entry of a guard, if it is an input or an output. -/
def guardEntry (generated : Bool) : Pattern → Option Entry
  | .apply label [channel, argument] =>
      if label = "PiInp" then
        match argument with
        | .lambda _ body => some ⟨channel, body, .apply label [channel, argument], true, generated⟩
        | _ => none
      else if label = "PiOut" then some ⟨channel, argument, .apply label [channel, argument], false, generated⟩
      else none
  | _ => none

/-- **The entry of a component of a store**: an input or an output stands for itself; a replicated one generates its
copy, read again as an unfolding reads it. -/
def entryOf (component : Pattern) : Option Entry :=
  match replicatedArgument piRepBlock component with
  | some argument => guardEntry true (recanon piRepBlock argument)
  | none => guardEntry false component

/-- A channel's part of the index: the channel, the inputs and the outputs on it. -/
abbrev Group := Pattern × List Entry × List Entry

/-- **The communication index of a store's components**: for each channel, the inputs and the outputs on it. -/
def index (components : List Pattern) : List Group :=
  let entries := components.filterMap entryOf
  (entries.map Entry.channel).dedup.map fun channel =>
    (channel, entries.filter (fun entry => entry.input && entry.channel == channel),
      entries.filter (fun entry => !entry.input && entry.channel == channel))

/-- The copies of generators an input and an output take. -/
def copiesOf (input output : Entry) : List Pattern := ([input, output].filter (·.generated)).map (·.guard)

/-- **The communication of an input and an output** of a store: beside the store's components and the copies the
generators among them give, the input receives the output's datum, under the store's restrictions. -/
def communicate (form : Prenex) (input output : Entry) : Option Pattern :=
  let elements := form.components ++ copiesOf input output
  let first := elements.idxOf input.guard
  (commAt elements first ((elements.eraseIdx first).idxOf output.guard)).map (Prenex.restricts piBlock form.count)

/-- **The successors of a store**, by its communication index: each input and each output on one channel. -/
def commSuccessors (form : Prenex) : List Pattern :=
  (index form.components).flatMap fun group =>
    group.2.1.flatMap fun input => group.2.2.filterMap fun output => communicate form input output

/-! ## Entries -/

theorem guardEntry_spec {generated : Bool} {guard : Pattern} {entry : Entry}
    (found : guardEntry generated guard = some entry) :
    entry.guard = guard ∧ entry.generated = generated ∧
      (entry.input = true → ∃ binder, guard = .apply "PiInp" [entry.channel, .lambda binder entry.payload]) ∧
      (entry.input = false → guard = .apply "PiOut" [entry.channel, entry.payload]) := by
  match guard, found with
  | .apply label [channel, argument], found =>
      simp only [guardEntry] at found
      split_ifs at found with isInput isOutput
      · subst isInput
        match argument, found with
        | .lambda binder body, found =>
            cases found
            exact ⟨rfl, rfl, fun _ => ⟨binder, rfl⟩, fun absurd => by simp at absurd⟩
      · subst isOutput
        cases found
        exact ⟨rfl, rfl, fun absurd => by simp at absurd, fun _ => rfl⟩

theorem guardEntry_input (generated : Bool) (channel body : Pattern) (binder : Option String) :
    guardEntry generated (.apply "PiInp" [channel, .lambda binder body]) =
      some ⟨channel, body, .apply "PiInp" [channel, .lambda binder body], true, generated⟩ := by
  simp [guardEntry]

theorem guardEntry_output (generated : Bool) (channel datum : Pattern) :
    guardEntry generated (.apply "PiOut" [channel, datum]) =
      some ⟨channel, datum, .apply "PiOut" [channel, datum], false, generated⟩ := by
  simp [guardEntry]

/-- **An entry stands in the store or is generated by a replicated component of it.** -/
theorem entryOf_spec {component : Pattern} {entry : Entry} (found : entryOf component = some entry) :
    (entry.generated = false ∧ entry.guard = component) ∨
      (entry.generated = true ∧ ∃ argument, component = .apply "PiRep" [argument] ∧
        entry.guard = recanon piRepBlock argument) := by
  unfold entryOf at found
  split at found
  · rename_i argument replicated
    obtain ⟨guardIs, generatedIs, -⟩ := guardEntry_spec found
    exact .inr ⟨generatedIs, argument, mem_replicatedArgument.mp replicated, guardIs⟩
  · obtain ⟨guardIs, generatedIs, -⟩ := guardEntry_spec found
    exact .inl ⟨generatedIs, guardIs⟩

theorem entryOf_guard {component : Pattern} {entry : Entry} (found : entryOf component = some entry) :
    (entry.input = true → ∃ binder, entry.guard = .apply "PiInp" [entry.channel, .lambda binder entry.payload]) ∧
      (entry.input = false → entry.guard = .apply "PiOut" [entry.channel, entry.payload]) := by
  unfold entryOf at found
  split at found
  · obtain ⟨guardIs, -, inputIs, outputIs⟩ := guardEntry_spec found
    rw [guardIs]
    exact ⟨inputIs, outputIs⟩
  · obtain ⟨guardIs, -, inputIs, outputIs⟩ := guardEntry_spec found
    rw [guardIs]
    exact ⟨inputIs, outputIs⟩

/-- **The index pairs exactly the inputs and the outputs on one channel.** -/
theorem mem_index {components : List Pattern} {input output : Entry} :
    (∃ group ∈ index components, input ∈ group.2.1 ∧ output ∈ group.2.2) ↔
      input ∈ components.filterMap entryOf ∧ output ∈ components.filterMap entryOf ∧ input.input = true ∧
        output.input = false ∧ input.channel = output.channel := by
  simp only [index]
  constructor
  · rintro ⟨group, inIndex, inputIn, outputIn⟩
    obtain ⟨channel, -, rfl⟩ := List.mem_map.mp inIndex
    simp only [List.mem_filter, Bool.and_eq_true, beq_iff_eq, Bool.not_eq_true'] at inputIn outputIn
    exact ⟨inputIn.1, outputIn.1, inputIn.2.1, outputIn.2.1, inputIn.2.2.trans outputIn.2.2.symm⟩
  · rintro ⟨inputIn, outputIn, isInput, isOutput, same⟩
    refine ⟨_, List.mem_map.mpr ⟨input.channel, List.mem_dedup.mpr (List.mem_map.mpr ⟨input, inputIn, rfl⟩), rfl⟩,
      ?_, ?_⟩
    · simp only [List.mem_filter, Bool.and_eq_true, beq_iff_eq]
      exact ⟨inputIn, isInput, trivial⟩
    · simp only [List.mem_filter, Bool.and_eq_true, beq_iff_eq, Bool.not_eq_true']
      exact ⟨outputIn, isOutput, same.symm⟩

/-- **The successors the index lists**: the communications of an input and an output on one channel. -/
theorem mem_commSuccessors {form : Prenex} {next : Pattern} :
    next ∈ commSuccessors form ↔ ∃ input output, input ∈ form.components.filterMap entryOf ∧
      output ∈ form.components.filterMap entryOf ∧ input.input = true ∧ output.input = false ∧
        input.channel = output.channel ∧ communicate form input output = some next := by
  unfold commSuccessors
  constructor
  · intro member
    obtain ⟨group, inIndex, inGroup⟩ := List.mem_flatMap.mp member
    obtain ⟨input, inputIn, inInput⟩ := List.mem_flatMap.mp inGroup
    obtain ⟨output, outputIn, communicated⟩ := List.mem_filterMap.mp inInput
    obtain ⟨inputIn', outputIn', isInput, isOutput, same⟩ := mem_index.mp ⟨group, inIndex, inputIn, outputIn⟩
    exact ⟨input, output, inputIn', outputIn', isInput, isOutput, same, communicated⟩
  · rintro ⟨input, output, inputIn, outputIn, isInput, isOutput, same, communicated⟩
    obtain ⟨group, inIndex, inputIn', outputIn'⟩ := mem_index.mpr ⟨inputIn, outputIn, isInput, isOutput, same⟩
    exact List.mem_flatMap.mpr ⟨group, inIndex,
      List.mem_flatMap.mpr ⟨input, inputIn', List.mem_filterMap.mpr ⟨output, outputIn', communicated⟩⟩⟩

/-! ## No invented step -/

theorem rawSuccessors_restricts : ∀ (count : Nat) (process : Pattern),
    rawSuccessors (Prenex.restricts piBlock count process) =
      (rawSuccessors process).map (Prenex.restricts piBlock count)
  | 0, process => by simp [Prenex.restricts]
  | count + 1, process => by
      have inner := rawSuccessors_restricts count process
      simp only [Prenex.restricts, rawSuccessors, inner, List.map_map]
      rfl

theorem body_of_two {elements : List Pattern} (two : 2 ≤ elements.length) :
    Prenex.body piBlock elements = .collection .hashBag elements none := by
  match elements, two with
  | _ :: _ :: _, _ => rfl

theorem commAt_spec {elements : List Pattern} {first second : Nat} {received : Pattern}
    (found : commAt elements first second = some received) :
    2 ≤ elements.length ∧ received ∈ communications elements := by
  have found' := found
  unfold commAt at found
  split at found
  · rename_i firstIs secondIs
    obtain ⟨firstInside, -⟩ := List.getElem?_eq_some_iff.mp firstIs
    obtain ⟨secondInside, -⟩ := List.getElem?_eq_some_iff.mp secondIs
    have shorter := List.length_eraseIdx_of_lt firstInside
    refine ⟨by omega, ?_⟩
    simp only [communications, List.mem_flatMap, List.mem_range, List.mem_filterMap]
    exact ⟨first, firstInside, second, by omega, found'⟩
  · cases found

/-- A communication of a bag is a successor of the bag. -/
theorem commAt_rawSuccessors {elements : List Pattern} {first second : Nat} {received : Pattern}
    (found : commAt elements first second = some received) :
    received ∈ rawSuccessors (Prenex.body piBlock elements) := by
  obtain ⟨two, member⟩ := commAt_spec found
  rw [body_of_two two]
  simp only [rawSuccessors, List.mem_append]
  exact .inl member

/-- **The copies generators give are unfoldings' copies**: for entries of a store whose replicated components copy one
component each, the copies the generated ones give, each a copy of the argument of a replicated component of the
store, read again. -/
theorem generated_pairs {form : Prenex} (flat : flatServers piRepBlock form = true) :
    ∀ entries : List Entry, (∀ entry ∈ entries, entry ∈ form.components.filterMap entryOf) →
      ∃ pairs : List (Pattern × Pattern), pairs.map Prod.snd = (entries.filter (·.generated)).map (·.guard) ∧
        pairs.length ≤ entries.length ∧
        ∀ pair ∈ pairs, ∃ argument, pair.1 = .apply piRepBlock.replicate [argument] ∧ pair.1 ∈ form.components ∧
          decompose piRepBlock.toBlock argument = Prenex.atom argument ∧ pair.2 = recanon piRepBlock argument
  | [], _ => ⟨[], rfl, le_refl _, by simp⟩
  | entry :: entries, all => by
      obtain ⟨pairs, pairsMap, pairsLength, pairsFacts⟩ :=
        generated_pairs flat entries fun other member => all other (List.mem_cons_of_mem _ member)
      obtain ⟨component, inForm, found⟩ := List.mem_filterMap.mp (all entry List.mem_cons_self)
      rcases entryOf_spec found with ⟨notGenerated, -⟩ | ⟨generated, argument, componentIs, guardIs⟩
      · refine ⟨pairs, ?_, by simp only [List.length_cons]; omega, pairsFacts⟩
        simp [notGenerated, pairsMap]
      · refine ⟨(component, entry.guard) :: pairs, ?_, by simp only [List.length_cons]; omega, ?_⟩
        · simp [generated, pairsMap]
        · intro pair member
          rcases List.mem_cons.mp member with rfl | later
          · exact ⟨argument, componentIs, inForm, (flatServers_spec flat component inForm argument componentIs).1,
              guardIs⟩
          · exact pairsFacts pair later

/-- **No invented step**: every successor the index lists is listed by the front door, a communication of a
presentation of the canonical form, the copies the generators give unfolded beside the store's components. -/
theorem commSuccessors_listed {term next : Pattern} (termIn : processes term)
    (flat : flatServers piRepBlock (canonP piRepBlock term) = true)
    (member : next ∈ commSuccessors (canonP piRepBlock term)) : next ∈ listed term := by
  obtain ⟨input, output, inputIn, outputIn, -, -, -, communicated⟩ := mem_commSuccessors.mp member
  have fresh := replicate_not_emptyUnit (block := piRepBlock) (language := piCalc)
  have restrictFresh := replicate_ne_restrict (block := piRepBlock) (language := piCalc)
  obtain ⟨typed, object⟩ := typed_of_domain termIn
  have facts := canonFacts fresh restrictFresh object (restrictionsBind_of_typed (block := piRepBlock) term typed)
  have decomposed : decompose piRepBlock.toBlock (canonR piRepBlock term) = canonP piRepBlock term := by
    unfold canonR
    exact decompose_toPattern facts.atomic facts.used
  -- the copies come from replicated components of the store
  obtain ⟨pairs, pairsMap, pairsLength, pairsFacts⟩ := generated_pairs flat [input, output] fun entry inEntries => by
    rcases List.mem_cons.mp inEntries with rfl | later
    · exact inputIn
    · rw [List.mem_singleton] at later
      subst later
      exact outputIn
  have within : UnfoldsWithin piRepBlock 2 (canonP piRepBlock term)
      ⟨(canonP piRepBlock term).count, (canonP piRepBlock term).components ++ copiesOf input output⟩ := by
    have unfolds := unfoldsWithin_copies fresh restrictFresh pairs pairsFacts
    rw [pairsMap] at unfolds
    exact unfolds.mono (by simpa using pairsLength)
  -- so the store beside the copies is a presentation of the canonical form
  have presented : Prenex.toPattern piRepBlock.toBlock
      ⟨(canonP piRepBlock term).count, (canonP piRepBlock term).components ++ copiesOf input output⟩ ∈
        presentations (canon term) := by
    unfold canon presentations replicationPresentations
    rw [if_pos termIn, decomposed]
    unfold presentationDepth
    rw [if_pos (moleculeServers_of_flat fresh restrictFresh flat)]
    exact List.mem_map_of_mem ((mem_unfoldings _ _ _).mpr within)
  -- and the communication is one of its successors
  unfold communicate at communicated
  obtain ⟨received, receivedIs, rfl⟩ := Option.map_eq_some_iff.mp communicated
  refine List.mem_flatMap.mpr ⟨_, presented, ?_⟩
  simp only [Prenex.toPattern, rawSuccessors_restricts]
  exact List.mem_map_of_mem (commAt_rawSuccessors receivedIs)

/-! ## Every step covered -/

/-- In a list without repeats split into two parts, the members in the first part are the first part, the others the
second. -/
theorem filter_mem_perm {parts first second : List Pattern} (nodup : parts.Nodup)
    (split : parts.Perm (first ++ second)) :
    (parts.filter fun part => decide (part ∈ first)).Perm first ∧
      (parts.filter fun part => !decide (part ∈ first)).Perm second := by
  have firstNodup : first.Nodup := (List.nodup_append.mp (split.nodup_iff.mp nodup)).1
  have firstPerm : (parts.filter fun part => decide (part ∈ first)).Perm first := by
    rw [List.perm_ext_iff_of_nodup (nodup.filter _) firstNodup]
    intro part
    simp only [List.mem_filter, decide_eq_true_eq]
    exact ⟨fun ⟨_, inFirst⟩ => inFirst,
      fun inFirst => ⟨split.symm.subset (List.mem_append_left _ inFirst), inFirst⟩⟩
  refine ⟨firstPerm, (List.perm_append_left_iff first).mp ?_⟩
  exact (firstPerm.symm.append_right _).trans
    ((List.filter_append_perm (fun part => decide (part ∈ first)) parts).trans split)

/-- **A part of a reaction of an unfolding of a store has its entry in the store**: a part taken from the store stands
for itself, and a part taken from a copy is generated by the replicated component it copies. -/
theorem entry_of_part {form : Prenex} {taken rest : List Pattern} {chosen : List (Pattern × Pattern)}
    {part : Pattern} (formPerm : form.components.Perm (taken ++ rest))
    (chosenFacts : ∀ pair ∈ chosen, ∃ argument, pair.1 = .apply piRepBlock.replicate [argument] ∧ pair.1 ∈ rest ∧
      decompose piRepBlock.toBlock argument = Prenex.atom argument ∧ pair.2 = recanon piRepBlock argument)
    (inParts : part ∈ taken ++ chosen.map Prod.snd) (notReplicated : replicatedArgument piRepBlock part = none)
    {entry : Entry} (found : guardEntry (!decide (part ∈ taken)) part = some entry) :
    entry ∈ form.components.filterMap entryOf := by
  by_cases inTaken : part ∈ taken
  · rw [decide_eq_true inTaken] at found
    refine List.mem_filterMap.mpr ⟨part, formPerm.symm.subset (List.mem_append_left _ inTaken), ?_⟩
    unfold entryOf
    rw [notReplicated]
    exact found
  · rw [decide_eq_false inTaken] at found
    have inChosen : part ∈ chosen.map Prod.snd := by
      rcases List.mem_append.mp inParts with here | there
      · exact absurd here inTaken
      · exact there
    obtain ⟨pair, pairIn, rfl⟩ := List.mem_map.mp inChosen
    obtain ⟨argument, serverIs, serverIn, -, copyIs⟩ := chosenFacts pair pairIn
    refine List.mem_filterMap.mpr ⟨pair.1, formPerm.symm.subset (List.mem_append_right _ serverIn), ?_⟩
    unfold entryOf
    rw [serverIs, mem_replicatedArgument.mpr rfl]
    rw [copyIs] at found
    exact found

/-- **Every step covered**: every reduction of a process ends at a process equivalent to a successor the index of its
store lists. -/
theorem reduces_commSuccessors {term target : Pattern} (termIn : processes term)
    (flat : flatServers piRepBlock (canonP piRepBlock term) = true) (step : Reduces term target) :
    ∃ next ∈ commSuccessors (canonP piRepBlock term),
      ObjectEquivalent RelationEnv.empty piCalc reading target next := by
  obtain ⟨-, -, redex, contractum, witness, before, -, valid, -, after, -⟩ := step
  have redexIn := (domain_iff_of_equivalent before).mp termIn
  have raw := step_iff_raw.mp ⟨witness, valid⟩
  have fresh := replicate_not_emptyUnit (block := piRepBlock) (language := piCalc)
  have restrictFresh := replicate_ne_restrict (block := piRepBlock) (language := piCalc)
  obtain ⟨typed, object⟩ := typed_of_domain redexIn
  -- the store is the redex's
  have sameStore : canonP piRepBlock term = canonP piRepBlock redex := by
    have canonSame := canonical.same termIn before
    unfold canon at canonSame
    rw [if_pos termIn, if_pos redexIn] at canonSame
    obtain ⟨termTyped, termObject⟩ := typed_of_domain termIn
    exact toPattern_injective
      (canonFacts fresh restrictFresh termObject (restrictionsBind_of_typed (block := piRepBlock) term termTyped)).atomic
      (canonFacts fresh restrictFresh object (restrictionsBind_of_typed (block := piRepBlock) redex typed)).atomic
      canonSame
  rw [sameStore] at flat ⊢
  -- the step is a reaction of an unfolding of the store, its parts from the store or from copies
  obtain ⟨count, rdx, rest, reached⟩ := step_block raw names_context typed object
  obtain ⟨unfolded, unfolds, redex', restU, split, plain, members, -, reaches⟩ :=
    replication_reaction piReactions names_context reached typed object
  obtain ⟨sameCount, taken, restK, chosen, formPerm, partsPerm, chosenFacts, inUnfolded, absorbed⟩ :=
    compress_parts piReactions names_context (flatServers_spec flat) unfolds split plain members
  set form := canonP piRepBlock redex with formIs
  set listener := Mettapedia.Languages.ProcessCalculi.PiCalculus.PrenexForm.Redex.listener redex' with listenerIs
  set output := Mettapedia.Languages.ProcessCalculi.PiCalculus.PrenexForm.Redex.output redex' with outputIs
  have partsIs : piReactions.parts redex' = [listener, output] := rfl
  rw [partsIs] at partsPerm
  have apart : listener ≠ output := by
    rw [listenerIs, outputIs]
    simp [Mettapedia.Languages.ProcessCalculi.PiCalculus.PrenexForm.Redex.listener,
      Mettapedia.Languages.ProcessCalculi.PiCalculus.PrenexForm.Redex.output]
  have nodup : [listener, output].Nodup := by simp [apart]
  obtain ⟨takenPerm, copiesPerm⟩ := filter_mem_perm nodup partsPerm
  -- their entries
  let inEntry : Entry := ⟨redex'.channel, redex'.body, listener, true, !decide (listener ∈ taken)⟩
  let outEntry : Entry := ⟨redex'.channel, redex'.datum, output, false, !decide (output ∈ taken)⟩
  have inEntryIn : inEntry ∈ form.components.filterMap entryOf :=
    entry_of_part formPerm chosenFacts (partsPerm.subset List.mem_cons_self) rfl (guardEntry_input _ _ _ _)
  have outEntryIn : outEntry ∈ form.components.filterMap entryOf :=
    entry_of_part formPerm chosenFacts (partsPerm.subset (List.mem_cons_of_mem _ List.mem_cons_self)) rfl
      (guardEntry_output _ _ _)
  -- their communication
  have copiesIs : copiesOf inEntry outEntry = [listener, output].filter fun part => !decide (part ∈ taken) := by
    simp only [copiesOf, inEntry, outEntry, List.filter_cons, List.filter_nil]
    cases decide (listener ∈ taken) <;> cases decide (output ∈ taken) <;> simp
  set elements := form.components ++ copiesOf inEntry outEntry with elementsIs
  have elementsPerm : elements.Perm ([listener, output] ++ restK) := by
    rw [elementsIs, copiesIs]
    have moved : ((taken ++ restK) ++ [listener, output].filter fun part => !decide (part ∈ taken)).Perm
        ((taken ++ [listener, output].filter fun part => !decide (part ∈ taken)) ++ restK) := by
      rw [List.append_assoc, List.append_assoc]
      exact List.perm_append_comm.append_left taken
    refine (formPerm.append_right _).trans (moved.trans (List.Perm.append_right restK ?_))
    exact (takenPerm.symm.append_right _).trans (List.filter_append_perm _ _)
  have listenerIn : listener ∈ elements := elementsPerm.symm.subset List.mem_cons_self
  have outputIn : output ∈ elements.erase listener :=
    (List.mem_erase_of_ne apart.symm).mpr (elementsPerm.symm.subset (List.mem_cons_of_mem _ List.mem_cons_self))
  have firstErase : elements.eraseIdx (elements.idxOf listener) = elements.erase listener :=
    (List.erase_eq_eraseIdx_of_idxOf rfl).symm
  have secondErase : (elements.erase listener).eraseIdx ((elements.erase listener).idxOf output) =
      (elements.erase listener).erase output := (List.erase_eq_eraseIdx_of_idxOf rfl).symm
  have communicated : communicate form inEntry outEntry =
      some (Prenex.restricts piBlock form.count (.collection .hashBag
        (instantiateBVar redex'.datum redex'.body :: (elements.erase listener).erase output) none)) := by
    have firstAt := List.getElem?_idxOf listenerIn
    have secondAt := List.getElem?_idxOf outputIn
    have restated : communicate form inEntry outEntry = (commAt elements (elements.idxOf listener)
        ((elements.eraseIdx (elements.idxOf listener)).idxOf output)).map (Prenex.restricts piBlock form.count) := rfl
    rw [restated, firstErase]
    unfold commAt
    rw [firstAt, firstErase, secondAt, secondErase]
    simp [listenerIs, outputIs, Mettapedia.Languages.ProcessCalculi.PiCalculus.PrenexForm.Redex.listener,
      Mettapedia.Languages.ProcessCalculi.PiCalculus.PrenexForm.Redex.output]
  have member : Prenex.restricts piBlock form.count (.collection .hashBag
      (instantiateBVar redex'.datum redex'.body :: (elements.erase listener).erase output) none) ∈
        commSuccessors form :=
    mem_commSuccessors.mpr ⟨inEntry, outEntry, inEntryIn, outEntryIn, rfl, rfl, rfl, communicated⟩
  refine ⟨_, member, ?_⟩
  -- what the communication leaves reads as the reduction's contractum
  have restPerm : ((elements.erase listener).erase output).Perm restK := by
    have erased := (elementsPerm.erase listener).erase output
    simpa [List.erase_cons_head, apart] using erased
  rw [sameCount] at members
  have elementsIn : ∀ component ∈ elements, component ∈ unfolded.components := by
    intro component inElements
    rw [elementsIs, List.mem_append] at inElements
    rcases inElements with inForm | inCopies
    · exact inUnfolded component (List.mem_append_left _ inForm)
    · rw [copiesIs] at inCopies
      exact inUnfolded component (List.mem_append_right _ (copiesPerm.subset inCopies))
  have partsMembers := fun part (inParts : part ∈ piReactions.parts redex') =>
    members part (split.symm.subset (List.mem_append_left _ inParts))
  have leftMembers : Members piCalc piRepBlock.toBlock names
      (List.replicate form.count (TypeExpr.base piRepBlock.name) ++ [])
      (piReactions.result redex' ++ (elements.erase listener).erase output) := by
    intro component inLeft
    rcases List.mem_append.mp inLeft with inResult | inRest
    · exact piReactions.result_members redex' partsMembers component inResult
    · exact members component (elementsIn component (List.erase_subset (List.erase_subset inRest)))
  have leftSame := restricts_equation (block := piBlock) form.count
    (bag_perm_equivalent (block := piRepBlock) leftMembers (restPerm.append_left _)).toEquationEquiv
  have toContractum : EquationEquiv (Mettapedia.OSLF.MeTTaIL.ContextualStep.engineBasePremises RelationEnv.empty) piCalc
      (Prenex.restricts piBlock form.count (.collection .hashBag
        (instantiateBVar redex'.datum redex'.body :: (elements.erase listener).erase output) none)) contractum :=
    Relation.EqvGen.trans _ _ _ leftSame (Relation.EqvGen.trans _ _ _ absorbed reaches)
  -- so the target is equivalent to it
  have nextIn : processes (Prenex.restricts piBlock form.count (.collection .hashBag
      (instantiateBVar redex'.datum redex'.body :: (elements.erase listener).erase output) none)) :=
    reduces_process redexIn (reduces_of_listed redexIn (commSuccessors_listed redexIn flat member))
  have contractumIn := process_of_raw redexIn raw
  refine .trans _ _ _ (.symm _ _ after) (equivalent_of_canon_eq contractumIn nextIn ?_)
  unfold canon
  rw [if_pos contractumIn, if_pos nextIn]
  exact canonR_complete (block := piRepBlock) (typed_of_domain contractumIn).2 (typed_of_domain nextIn).2
    (restrictionsBind_of_typed (block := piRepBlock) _ (typed_of_domain contractumIn).1)
    (Relation.EqvGen.symm _ _ toContractum)

/-! ## The store's successors at the front door -/

/-- **The successors of a process by its store**: by the communication index when every replicated component of the
store copies one component, the front door's listed successors otherwise. -/
def storeSuccessors (term : Pattern) : List Pattern :=
  if flatServers piRepBlock (canonP piRepBlock term) then commSuccessors (canonP piRepBlock term) else listed term

/-- **A successor of the store is a reduction.** -/
theorem reduces_of_store {source next : Pattern} (sourceIn : processes source)
    (member : next ∈ storeSuccessors source) : Reduces source next := by
  unfold storeSuccessors at member
  split_ifs at member with flat
  · exact reduces_of_listed sourceIn (commSuccessors_listed sourceIn flat member)
  · exact reduces_of_listed sourceIn member

/-- **A reduction is matched by a successor of the store**, to an equivalent process. -/
theorem reduces_store {source target : Pattern} (sourceIn : processes source) (step : Reduces source target) :
    ∃ next ∈ storeSuccessors source, Reduces source next ∧
      ObjectEquivalent RelationEnv.empty piCalc reading target next := by
  unfold storeSuccessors
  split_ifs with flat
  · obtain ⟨next, member, equivalent⟩ := reduces_commSuccessors sourceIn flat step
    exact ⟨next, member, reduces_of_listed sourceIn (commSuccessors_listed sourceIn flat member), equivalent⟩
  · exact reduces_listed sourceIn step

/-- The store's successors: under a plain label those of the process, under a partner's label those of the bag with
the partner. -/
def successorList : StepLabel → Pattern → Option (List Pattern)
  | .any, term => if domain term then some (storeSuccessors term) else none
  | .context hole (.collection .hashBag [.fvar hole', partner] none) .any, term =>
      if hole == hole' && avoidsHole hole partner && domain partner && domain term then
        some (storeSuccessors (par term partner))
      else none
  | _, _ => none

/-- **π's successors by the store, complete up to the laws** for plain steps and for partners' steps. -/
def successors : Successors RelationEnv.empty piCalc reading where
  list := successorList
  sound := by
    intro label term next listed target member
    unfold successorList at listed
    split at listed
    · split_ifs at listed with termIn
      cases listed
      exact reduces_of_store termIn member
    · rename_i hole hole' partner
      split_ifs at listed with conditions
      cases listed
      simp only [Bool.and_eq_true, beq_iff_eq] at conditions
      obtain ⟨⟨⟨rfl, avoids⟩, partnerIn⟩, termIn⟩ := conditions
      exact (step_partner_iff avoids partnerIn termIn).mpr (reduces_of_store (par_process termIn partnerIn) member)
    · cases listed
  complete := by
    intro label term next listed target step
    unfold successorList at listed
    split at listed
    · split_ifs at listed with termIn
      cases listed
      obtain ⟨next', member, -, equivalent⟩ := reduces_store termIn step
      exact ⟨next', member, .symm _ _ equivalent⟩
    · rename_i hole hole' partner
      split_ifs at listed with conditions
      cases listed
      simp only [Bool.and_eq_true, beq_iff_eq] at conditions
      obtain ⟨⟨⟨rfl, avoids⟩, partnerIn⟩, termIn⟩ := conditions
      obtain ⟨next', member, -, equivalent⟩ :=
        reduces_store (par_process termIn partnerIn) ((step_partner_iff avoids partnerIn termIn).mp step)
      exact ⟨next', member, .symm _ _ equivalent⟩
    · cases listed

/-- **π's modal decider on the store**: the step modalities, partners' labels included, evaluated at the store's
successors, over named terms by canonical forms. -/
def decider : Decider RelationEnv.empty piCalc reading :=
  modalDecider successors (namedDecider canon domain canonical)

theorem decided_holds {formula : Formula 0} {term : Pattern} (decided : decider.decide formula term = some true) :
    frontDoor.sat Env.closed formula term :=
  (decider.exact decided).mpr rfl

theorem decided_fails {formula : Formula 0} {term : Pattern} (decided : decider.decide formula term = some false) :
    ¬ frontDoor.sat Env.closed formula term :=
  fun holds => Bool.false_ne_true ((decider.exact decided).mp holds)

