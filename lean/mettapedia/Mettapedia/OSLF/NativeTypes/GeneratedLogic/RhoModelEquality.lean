import Mettapedia.OSLF.NativeTypes.GeneratedLogic.RhoModelLanguage
import Mettapedia.OSLF.MeTTaIL.Complete.RhoReference

/-!
# ρ's runtime model: its equations are the model's equality

The model language (`RhoModel.language`) authors the normalized ρ profile's equality as equations. Read as the syntax
theory, its equivalence of object terms is the profile's equality (`QuoteDropCoherence.ModelEquiv`), whose moves are
the law steps of ρ's parallel laws and the uses of `@(*n) = n`, in any context.

- **Each equation step is a move of the model** (`equationStep_move`, `modelEquiv_of_objectEquivalent`): flattening one
  member is two flattenings and a permutation, flattening the empty bag and removing `0` are one law step each, and the
  name equation is a use of `@(*n) = n`. The model declares no algebra and no sets, so the only derived law is a
  permutation of a bag.
- **Each move between object terms without sets is a chain of equation steps** (`same_of_move`), so the profile's
  equality is the model language's equivalence there (`same_iff`):
  - any member moves to the front in four steps: add the empty bag, wrap the member with it (flattening one member,
    read backwards), unwrap it, drop the empty bag (`same_moveFront`);
  - so a block moves past another (`same_rotate`), and every permutation of a bag is a chain (`same_perm`), with no
    typing of the members, which the derived permutation would need;
  - a nested bag flattens one member at a time (`same_flatten`); `0` and the name equation are one step each;
  - the steps hold in every context (`same_fill`), and a chain of moves keeps its terms objects without sets.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.NativeTypes.GeneratedLogic.RhoModel

open Mettapedia.OSLF.MeTTaIL Syntax Match MatchSpec
open Mettapedia.OSLF.MeTTaIL.Engine (RelationEnv)
open Mettapedia.OSLF.MeTTaIL.ReferenceStep
open Mettapedia.OSLF.MeTTaIL.CanonicalBags (LawStep StandardStep)
open Mettapedia.OSLF.MeTTaIL.QuoteDrop (QuoteDropStep)
open Mettapedia.OSLF.MeTTaIL.DerivedContexts (OneHoleContext)
open Mettapedia.GSLT.LanguageDef.WellSorted
open Mettapedia.GSLT.LanguageDef.EquationSemantics (DerivedInstance)

/-! ## The model's moves -/

abbrev plan := GeneralRho.Standard.plan
abbrev presentation := Complete.RhoQuoteDrop.presentation
abbrev laws := Complete.Normalized.laws plan

/-- **The profile's equality.** -/
abbrev ModelEquiv : Pattern → Pattern → Prop := Complete.QuoteDropCoherence.ModelEquiv plan [] proc presentation

/-- A move of the model: a law step of ρ's parallel laws, or a use of `@(*n) = n`, in any context. -/
def Move (left right : Pattern) : Prop := LawStep laws left right ∨ QuoteDropStep presentation left right

theorem move_of_equation {left right : Pattern}
    (equation : Complete.QuoteDropCoherence.ModelEquation plan [] proc presentation left right) : Move left right := by
  rcases equation with equation | moved | quoteDrop
  · exact absurd equation (Complete.RhoPresented.noEquations _ _ _ _)
  · rw [Complete.RhoPresented.extrusions_eq] at moved
    exact .inl (Complete.Coherence.lawStep_of_standardStep moved)
  · exact .inr quoteDrop

theorem equation_of_move {left right : Pattern} (move : Move left right) :
    Complete.QuoteDropCoherence.ModelEquation plan [] proc presentation left right := by
  rcases move with law | quoteDrop
  · exact .inr (.inl (.law law))
  · exact .inr (.inr quoteDrop)

/-- **The profile's equality is generated by the moves.** -/
theorem modelEquiv_iff {left right : Pattern} : ModelEquiv left right ↔ Relation.EqvGen Move left right :=
  ⟨fun same => Relation.EqvGen.mono (fun _ _ => move_of_equation) _ _ same,
    fun same => Relation.EqvGen.mono (fun _ _ => equation_of_move) _ _ same⟩

theorem law_equiv {left right : Pattern} (step : LawStep laws left right) : Relation.EqvGen Move left right :=
  .rel _ _ (.inl step)

theorem quoteDrop_equiv {left right : Pattern} (step : QuoteDropStep presentation left right) :
    Relation.EqvGen Move left right :=
  .rel _ _ (.inr step)

theorem Move.fill (context : OneHoleContext) {left right : Pattern} (move : Move left right) :
    Move (context.fill left) (context.fill right) := by
  induction context with
  | hole => exact move
  | apply _ _ _ _ ih =>
    rcases ih with law | quoteDrop
    · exact .inl (.apply law)
    · exact .inr (.apply quoteDrop)
  | lambda _ _ ih =>
    rcases ih with law | quoteDrop
    · exact .inl (.lambda law)
    · exact .inr (.lambda quoteDrop)
  | multiLambda _ _ _ ih =>
    rcases ih with law | quoteDrop
    · exact .inl (.multiLambda law)
    · exact .inr (.multiLambda quoteDrop)
  | substBody _ _ ih =>
    rcases ih with law | quoteDrop
    · exact .inl (.substBody law)
    · exact .inr (.substBody quoteDrop)
  | substReplacement _ _ ih =>
    rcases ih with law | quoteDrop
    · exact .inl (.substReplacement law)
    · exact .inr (.substReplacement quoteDrop)
  | collection _ _ _ _ _ ih =>
    rcases ih with law | quoteDrop
    · exact .inl (.element law)
    · exact .inr (.element quoteDrop)

theorem equiv_fill (context : OneHoleContext) {left right : Pattern} (same : Relation.EqvGen Move left right) :
    Relation.EqvGen Move (context.fill left) (context.fill right) := by
  induction same with
  | rel _ _ move => exact .rel _ _ (move.fill context)
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

/-! ## Bag laws as moves -/

theorem bag_perm {items items' : List Pattern} (permutation : items.Perm items') :
    Relation.EqvGen Move (bag items) (bag items') :=
  law_equiv (.permute rfl permutation)

theorem bag_flatten (before inner after : List Pattern) :
    Relation.EqvGen Move (bag (before ++ bag inner :: after)) (bag (before ++ inner ++ after)) :=
  law_equiv (.flatten Complete.RhoReference.bagLaw)

theorem bag_unit (before after : List Pattern) :
    Relation.EqvGen Move (bag (before ++ .apply "PZero" [] :: after)) (bag (before ++ after)) :=
  law_equiv (.unit Complete.RhoReference.bagLaw rfl)

/-- A member of a bag, split out at its position. -/
theorem split_at {items : List Pattern} {index : ℕ} (bound : index < items.length) :
    items = items.take index ++ items[index] :: items.drop (index + 1) := by
  rw [← List.drop_eq_getElem_cons bound, List.take_append_drop]

theorem eraseIdx_eq {items : List Pattern} (index : ℕ) :
    items.eraseIdx index = items.take index ++ items.drop (index + 1) :=
  List.eraseIdx_eq_take_drop_succ items index

/-- Removing a member at its position: a flattening of the bag it is, if it is the empty bag. -/
theorem bag_drop_empty {items : List Pattern} {index : ℕ} (bound : index < items.length)
    (empty : items[index] = bag []) : Relation.EqvGen Move (bag items) (bag (items.eraseIdx index)) := by
  have flattened := bag_flatten (items.take index) [] (items.drop (index + 1))
  rw [← empty, ← split_at bound, List.append_nil, ← eraseIdx_eq] at flattened
  exact flattened

/-- Removing `0` at its position. -/
theorem bag_drop_zero {items : List Pattern} {index : ℕ} (bound : index < items.length)
    (zero : items[index] = .apply "PZero" []) : Relation.EqvGen Move (bag items) (bag (items.eraseIdx index)) := by
  have removed := bag_unit (items.take index) (items.drop (index + 1))
  rw [← zero, ← split_at bound, ← eraseIdx_eq] at removed
  exact removed

/-- **Flattening one member is a move of the model**: both sides flatten to bags with the same members. -/
theorem bag_flattenHead {items inner : List Pattern} {index member : ℕ} (bound : index < items.length)
    (nested : items[index] = bag inner) (memberBound : member < inner.length) :
    Relation.EqvGen Move (bag items)
      (bag (inner[member] :: bag (inner.eraseIdx member) :: items.eraseIdx index)) := by
  have left := bag_flatten (items.take index) inner (items.drop (index + 1))
  rw [← nested, ← split_at bound] at left
  have right := bag_flatten [inner[member]] (inner.eraseIdx member) (items.eraseIdx index)
  simp only [List.cons_append, List.nil_append] at right
  refine .trans _ _ _ left (.trans _ _ _ (bag_perm ?_) (.symm _ _ right))
  rw [eraseIdx_eq index]
  have innerPerm : inner.Perm (inner[member] :: inner.eraseIdx member) :=
    (List.getElem_cons_eraseIdx_perm memberBound).symm
  have moved := (List.perm_append_comm (l₁ := items.take index) (l₂ := inner)).append_right (items.drop (index + 1))
  rw [List.append_assoc inner] at moved
  exact moved.trans (innerPerm.append_right _)

/-! ## Object terms -/

theorem objectList_iff {patterns : List Pattern} :
    isObjectPatternList patterns = true ↔ ∀ pattern ∈ patterns, isObjectPattern pattern = true := by
  induction patterns with
  | nil => simp [isObjectPatternList]
  | cons pattern patterns recurse => simp [isObjectPatternList, recurse]

theorem object_collection_iff {kind : CollType} {items : List Pattern} {tail : Option String} :
    isObjectPattern (.collection kind items tail) = true ↔
      tail = none ∧ ∀ item ∈ items, isObjectPattern item = true := by
  rw [isObjectPattern, Bool.and_eq_true, objectList_iff, Option.isNone_iff_eq_none]

/-! ## Matching the equations' sides -/

theorem collection_inv {kind : CollType} {elements : List Pattern} {rest : Option String} {term : Pattern}
    {bindings : Bindings} (notVector : kind ≠ .vec) (matched : MatchRel (.collection kind elements rest) term bindings) :
    ∃ items tail, term = .collection kind items tail ∧ MatchBagRel elements rest kind items bindings := by
  cases matched with
  | collection _ bagged => exact ⟨_, _, rfl, bagged⟩
  | vector => exact absurd rfl notVector
  | vectorRest => exact absurd rfl notVector

theorem find_single (name : String) (value : Pattern) :
    ([(name, value)] : Bindings).find? (·.1 == name) = some (name, value) := by
  simp

theorem scoped_fvar (lhs : Pattern) {bindings : Bindings} {name : String} {value : Pattern}
    (found : bindings.find? (·.1 == name) = some (name, value)) :
    applyBindingsScoped lhs bindings 0 (.fvar name) = value := by
  simp only [applyBindingsScoped, found]
  split <;> simp [Substitution.liftBVars_zero]

theorem liftBVars_zero_fun : Substitution.liftBVars 0 0 = id := funext fun pattern => Substitution.liftBVars_zero pattern 0

theorem scoped_rest (lhs : Pattern) {bindings : Bindings} {name : String} {items : List Pattern}
    (found : bindings.find? (·.1 == name) = some (name, bag items)) :
    restSplice lhs bindings 0 .hashBag (some name) = (items, none) := by
  simp only [restSplice, found, beq_self_eq_true, if_true]
  split <;> simp [liftBVars_zero_fun]

theorem scoped_collection (lhs : Pattern) (bindings : Bindings) (depth : ℕ) (kind : CollType) (elements : List Pattern)
    (rest : Option String) :
    applyBindingsScoped lhs bindings depth (.collection kind elements rest) =
      .collection kind (elements.map (applyBindingsScoped lhs bindings depth) ++ (restSplice lhs bindings depth kind rest).1)
        (restSplice lhs bindings depth kind rest).2 := by
  rw [applyBindingsScoped, applyBindingsScopedList_eq_map]

/-! ## Each equation step is a move of the model -/

variable {relEnv : RelationEnv}

theorem flattenHead_forward {source : Pattern} {initial : Bindings} (object : isObjectPattern source = true)
    (matched : initial ∈ matchPattern flattenHead.left source) (lhs : Pattern) :
    Relation.EqvGen Move source (applyBindingsScoped lhs initial 0 flattenHead.right) := by
  rw [matchPattern_iff_matchRel] at matched
  obtain ⟨items, tail, rfl, bagged⟩ := collection_inv (by decide) matched
  obtain ⟨rfl, members⟩ := object_collection_iff.mp object
  cases bagged with
  | cons index bound headMatch restMatch merged =>
    obtain ⟨inner, innerTail, innerEq, innerBag⟩ := collection_inv (by decide) headMatch
    have innerObject := members _ (List.getElem_mem bound)
    rw [innerEq] at innerObject
    obtain ⟨rfl, _⟩ := object_collection_iff.mp innerObject
    cases innerBag with
    | cons member memberBound memberMatch innerRest innerMerged =>
      cases memberMatch
      cases innerRest
      cases restMatch
      have foundX := mergeBindings_subsumed_left merged (mergeBindings_subsumed_left innerMerged (find_single _ _))
      have foundInner := mergeBindings_subsumed_left merged (mergeBindings_subsumed_right innerMerged (find_single _ _))
      have foundRest := mergeBindings_subsumed_right merged (find_single _ _)
      have target : applyBindingsScoped lhs initial 0 flattenHead.right =
          bag (inner[member] :: bag (inner.eraseIdx member) :: items.eraseIdx index) := by
        simp only [flattenHead, bag, scoped_collection, List.map_cons, List.map_nil, scoped_fvar _ foundX,
          scoped_rest _ foundInner, scoped_rest _ foundRest, List.nil_append, List.cons_append]
      rw [target]
      exact bag_flattenHead bound innerEq memberBound


theorem apply_inv {label : String} {arguments : List Pattern} {term : Pattern} {bindings : Bindings}
    (matched : MatchRel (.apply label arguments) term bindings) :
    ∃ items, term = .apply label items ∧ MatchArgsRel arguments items bindings := by
  cases matched with
  | apply argumentsMatch _ => exact ⟨_, rfl, argumentsMatch⟩

theorem merge_nil_right {bindings result : Bindings} (merged : mergeBindings bindings [] = some result) :
    result = bindings := by
  simp only [mergeBindings, List.foldlM_nil, Option.pure_def, Option.some.injEq] at merged
  exact merged.symm

theorem flattenHead_reverse {source : Pattern} {initial : Bindings} (object : isObjectPattern source = true)
    (matched : initial ∈ matchPattern flattenHead.right source) (lhs : Pattern) :
    Relation.EqvGen Move source (applyBindingsScoped lhs initial 0 flattenHead.left) := by
  rw [matchPattern_iff_matchRel] at matched
  obtain ⟨items, tail, rfl, bagged⟩ := collection_inv (by decide) matched
  obtain ⟨rfl, members⟩ := object_collection_iff.mp object
  cases bagged with
  | cons index bound headMatch restMatch merged =>
    cases headMatch
    cases restMatch with
    | cons nested nestedBound nestedMatch restRest restMerged =>
      obtain ⟨inner, innerTail, innerEq, innerBag⟩ := collection_inv (by decide) nestedMatch
      have innerObject := members _ (List.mem_of_mem_eraseIdx (List.getElem_mem nestedBound))
      rw [innerEq] at innerObject
      obtain ⟨rfl, _⟩ := object_collection_iff.mp innerObject
      cases innerBag
      cases restRest
      have foundX := mergeBindings_subsumed_left merged (find_single _ _)
      have foundInner := mergeBindings_subsumed_right merged (mergeBindings_subsumed_left restMerged (find_single _ _))
      have foundRest := mergeBindings_subsumed_right merged (mergeBindings_subsumed_right restMerged (find_single _ _))
      have target : applyBindingsScoped lhs initial 0 flattenHead.left =
          bag (bag (items[index] :: inner) :: (items.eraseIdx index).eraseIdx nested) := by
        simp only [flattenHead, bag, scoped_collection, List.map_cons, List.map_nil, scoped_fvar _ foundX,
          scoped_rest _ foundInner, scoped_rest _ foundRest, List.nil_append, List.cons_append]
      rw [target]
      have flattened := bag_flattenHead (items := bag (items[index] :: inner) :: (items.eraseIdx index).eraseIdx nested)
        (index := 0) (member := 0) (by simp) rfl (by simp)
      simp only [List.getElem_cons_zero, List.eraseIdx_cons_zero] at flattened
      refine .trans _ _ _ (bag_perm ?_) (.symm _ _ flattened)
      have first := (List.getElem_cons_eraseIdx_perm bound).symm
      have second := (List.getElem_cons_eraseIdx_perm nestedBound).symm
      rw [innerEq] at second
      exact first.trans (List.Perm.cons _ second)

theorem flattenEmpty_forward {source : Pattern} {initial : Bindings} (object : isObjectPattern source = true)
    (matched : initial ∈ matchPattern flattenEmpty.left source) (lhs : Pattern) :
    Relation.EqvGen Move source (applyBindingsScoped lhs initial 0 flattenEmpty.right) := by
  rw [matchPattern_iff_matchRel] at matched
  obtain ⟨items, tail, rfl, bagged⟩ := collection_inv (by decide) matched
  obtain ⟨rfl, members⟩ := object_collection_iff.mp object
  cases bagged with
  | cons index bound headMatch restMatch merged =>
    obtain ⟨inner, innerTail, innerEq, innerBag⟩ := collection_inv (by decide) headMatch
    have innerObject := members _ (List.getElem_mem bound)
    rw [innerEq] at innerObject
    obtain ⟨rfl, _⟩ := object_collection_iff.mp innerObject
    cases innerBag
    cases restMatch
    have foundRest := mergeBindings_subsumed_right merged (find_single _ _)
    have target : applyBindingsScoped lhs initial 0 flattenEmpty.right = bag (items.eraseIdx index) := by
      simp only [flattenEmpty, bag, scoped_collection, List.map_nil, scoped_rest _ foundRest, List.nil_append]
    rw [target]
    exact bag_drop_empty bound innerEq

theorem flattenEmpty_reverse {source : Pattern} {initial : Bindings} (object : isObjectPattern source = true)
    (matched : initial ∈ matchPattern flattenEmpty.right source) (lhs : Pattern) :
    Relation.EqvGen Move source (applyBindingsScoped lhs initial 0 flattenEmpty.left) := by
  rw [matchPattern_iff_matchRel] at matched
  obtain ⟨items, tail, rfl, bagged⟩ := collection_inv (by decide) matched
  obtain ⟨rfl, _⟩ := object_collection_iff.mp object
  cases bagged
  have target : applyBindingsScoped lhs [("rest", bag items)] 0 flattenEmpty.left = bag (bag [] :: items) := by
    simp only [flattenEmpty, bag, scoped_collection, List.map_cons, List.map_nil, List.nil_append,
      scoped_rest _ (find_single _ _)]
    simp [restSplice]
  rw [target]
  have dropped := bag_drop_empty (items := bag [] :: items) (index := 0) (by simp) rfl
  simp only [List.eraseIdx_cons_zero] at dropped
  exact .symm _ _ dropped

theorem unit_forward {source : Pattern} {initial : Bindings} (object : isObjectPattern source = true)
    (matched : initial ∈ matchPattern unitLaw.left source) (lhs : Pattern) :
    Relation.EqvGen Move source (applyBindingsScoped lhs initial 0 unitLaw.right) := by
  rw [matchPattern_iff_matchRel] at matched
  obtain ⟨items, tail, rfl, bagged⟩ := collection_inv (by decide) matched
  obtain ⟨rfl, _⟩ := object_collection_iff.mp object
  cases bagged with
  | cons index bound headMatch restMatch merged =>
    obtain ⟨arguments, zeroEq, argumentsMatch⟩ := apply_inv headMatch
    cases argumentsMatch
    cases restMatch
    have foundRest := mergeBindings_subsumed_right merged (find_single _ _)
    have target : applyBindingsScoped lhs initial 0 unitLaw.right = bag (items.eraseIdx index) := by
      simp only [unitLaw, bag, scoped_collection, List.map_nil, scoped_rest _ foundRest, List.nil_append]
    rw [target]
    exact bag_drop_zero bound zeroEq

theorem unit_reverse {source : Pattern} {initial : Bindings} (object : isObjectPattern source = true)
    (matched : initial ∈ matchPattern unitLaw.right source) (lhs : Pattern) :
    Relation.EqvGen Move source (applyBindingsScoped lhs initial 0 unitLaw.left) := by
  rw [matchPattern_iff_matchRel] at matched
  obtain ⟨items, tail, rfl, bagged⟩ := collection_inv (by decide) matched
  obtain ⟨rfl, _⟩ := object_collection_iff.mp object
  cases bagged
  have target : applyBindingsScoped lhs [("rest", bag items)] 0 unitLaw.left =
      bag (.apply "PZero" [] :: items) := by
    simp only [unitLaw, bag, scoped_collection, List.map_cons, List.map_nil, scoped_rest _ (find_single _ _)]
    simp [applyBindingsScoped]
  rw [target]
  have dropped := bag_drop_zero (items := .apply "PZero" [] :: items) (index := 0) (by simp) rfl
  simp only [List.eraseIdx_cons_zero] at dropped
  exact .symm _ _ dropped

theorem quoteDrop_left : (rhoCalc.equations[0]).left = .apply "NQuote" [.apply "PDrop" [.fvar "N"]] := rfl
theorem quoteDrop_right : (rhoCalc.equations[0]).right = .fvar "N" := rfl

theorem collapse (name : Pattern) :
    QuoteDropStep presentation (.apply "NQuote" [.apply "PDrop" [name]]) name :=
  QuoteDropStep.collapse name

theorem quoteDrop_forward {source : Pattern} {initial : Bindings}
    (matched : initial ∈ matchPattern (rhoCalc.equations[0]).left source) (lhs : Pattern) :
    Relation.EqvGen Move source (applyBindingsScoped lhs initial 0 (rhoCalc.equations[0]).right) := by
  rw [matchPattern_iff_matchRel, quoteDrop_left] at matched
  obtain ⟨arguments, rfl, argumentsMatch⟩ := apply_inv matched
  cases argumentsMatch with
  | cons dropMatch restArguments merged =>
    cases restArguments
    obtain ⟨dropArguments, rfl, dropArgumentsMatch⟩ := apply_inv dropMatch
    cases dropArgumentsMatch with
    | cons nameMatch nameRest nameMerged =>
      cases nameMatch
      cases nameRest
      have nameBindings := merge_nil_right nameMerged
      subst nameBindings
      have bindings := merge_nil_right merged
      subst bindings
      rw [quoteDrop_right, scoped_fvar _ (find_single _ _)]
      exact quoteDrop_equiv (collapse _)

theorem quoteDrop_reverse {source : Pattern} {initial : Bindings}
    (matched : initial ∈ matchPattern (rhoCalc.equations[0]).right source) (lhs : Pattern) :
    Relation.EqvGen Move source (applyBindingsScoped lhs initial 0 (rhoCalc.equations[0]).left) := by
  rw [matchPattern_iff_matchRel, quoteDrop_right] at matched
  cases matched
  rw [quoteDrop_left]
  simp only [applyBindingsScoped_apply, List.map_cons, List.map_nil, scoped_fvar _ (find_single _ _)]
  exact .symm _ _ (quoteDrop_equiv (collapse _))

/-- The ordinary matcher reads the model's equations. -/
theorem undeclared : ∀ equation ∈ language.equations, readsRaw equation = true := by
  intro equation member
  simp only [equations_eq, List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl | rfl | rfl <;> rfl

theorem authored_move {source target : Pattern} (object : isObjectPattern source = true)
    (instance_ : AuthoredEquation relEnv language source target) : Relation.EqvGen Move source target := by
  cases instance_ with
  | forward member _ matched valid =>
    simp only [equations_eq, List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl | rfl | rfl <;> cases valid
    · exact quoteDrop_forward matched _
    · exact flattenHead_forward object matched _
    · exact flattenEmpty_forward object matched _
    · exact unit_forward object matched _
  | reverse member _ matched valid =>
    simp only [equations_eq, List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl | rfl | rfl <;> cases valid
    · exact quoteDrop_reverse matched _
    · exact flattenHead_reverse object matched _
    · exact flattenEmpty_reverse object matched _
    · exact unit_reverse object matched _
  | declared member notRaw _ =>
    exact absurd (undeclared _ member) (by simp [notRaw])
  | premised member notRaw _ _ =>
    exact absurd (undeclared _ member) (by simp [notRaw])

/-- The model's constructors declare no set. -/
theorem no_sets : ∀ rule ∈ language.terms, ∀ parameter ∈ rule.params,
    parameter.typeExpr.mentionsCollection .hashSet = false := by
  decide

theorem derived_move {source target : Pattern} (derived : DerivedInstance language source target) :
    Relation.EqvGen Move source target := by
  cases derived with
  | bagPerm _ _ permutation => exact bag_perm permutation
  | setPerm member typed _ =>
    obtain ⟨parameter, parameterMember, mentions⟩ := typed.mentions
    rw [no_sets _ member parameter parameterMember] at mentions
    cases mentions
  | setDedup member typed =>
    obtain ⟨parameter, parameterMember, mentions⟩ := typed.mentions
    rw [no_sets _ member parameter parameterMember] at mentions
    cases mentions
  | flatten declared _ _ => exact absurd ((no_algebra declared.authored).symm.trans declared.declared) (by simp)
  | singleton declared _ _ => exact absurd ((no_algebra declared.authored).symm.trans declared.declared) (by simp)
  | unitElim declared _ _ => exact absurd ((no_algebra declared.authored).symm.trans declared.declared) (by simp)
  | emptyUnit declared _ _ => exact absurd ((no_algebra declared.authored).symm.trans declared.declared) (by simp)

theorem object_of_fill (context : OneHoleContext) {pattern : Pattern}
    (object : isObjectPattern (context.fill pattern) = true) : isObjectPattern pattern = true := by
  induction context with
  | hole => exact object
  | apply _ before _ after ih =>
    simp only [OneHoleContext.fill, isObjectPattern, objectList_iff] at object
    exact ih (object _ (by simp))
  | lambda _ _ ih => exact ih object
  | multiLambda _ _ _ ih => exact ih object
  | substBody => simp [OneHoleContext.fill, isObjectPattern] at object
  | substReplacement => simp [OneHoleContext.fill, isObjectPattern] at object
  | collection _ _ _ _ _ ih =>
    simp only [OneHoleContext.fill] at object
    exact ih ((object_collection_iff.mp object).2 _ (by simp))

/-- **An equation step between object terms is a move of the model.** -/
theorem equationStep_move {source target : Pattern} (object : isObjectPattern source = true)
    (step : EquationStep relEnv language source target) : Relation.EqvGen Move source target := by
  cases step with
  | inContext context generator =>
    refine equiv_fill context ?_
    rcases generator with authored | derived
    · exact authored_move (object_of_fill context object) authored
    · exact derived_move derived

/-- **The model language's equivalence of object terms is contained in the profile's equality.** -/
theorem modelEquiv_of_objectEquivalent {source target : Pattern}
    (same : ObjectEquivalent relEnv language reading source target) : ModelEquiv source target := by
  rw [modelEquiv_iff]
  induction same with
  | rel _ _ step => exact equationStep_move step.1 step.2.2
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second


/-! ## Each move of the model is a chain of equation steps -/

/-- The model language's equivalence of object terms. -/
abbrev Same (relEnv : RelationEnv) : Pattern → Pattern → Prop := ObjectEquivalent relEnv language reading

theorem equationStep_fill (context : OneHoleContext) {source target : Pattern}
    (step : EquationStep relEnv language source target) :
    EquationStep relEnv language (context.fill source) (context.fill target) := by
  cases step with
  | inContext inner generator =>
    rw [← OneHoleContext.fill_comp, ← OneHoleContext.fill_comp]
    exact .inContext (context.comp inner) generator

theorem object_fill_replace (context : OneHoleContext) {pattern : Pattern}
    (object : isObjectPattern (context.fill pattern) = true) {other : Pattern} (otherObject : isObjectPattern other = true) :
    isObjectPattern (context.fill other) = true := by
  induction context with
  | hole => exact otherObject
  | apply _ before _ after ih =>
    simp only [OneHoleContext.fill, isObjectPattern, objectList_iff, List.mem_append, List.mem_cons] at object ⊢
    rintro x (inBefore | rfl | inAfter)
    · exact object x (.inl inBefore)
    · exact ih (object _ (.inr (.inl rfl)))
    · exact object x (.inr (.inr inAfter))
  | lambda _ _ ih => exact ih object
  | multiLambda _ _ _ ih => exact ih object
  | substBody => simp [OneHoleContext.fill, isObjectPattern] at object
  | substReplacement => simp [OneHoleContext.fill, isObjectPattern] at object
  | collection _ before _ after _ ih =>
    simp only [OneHoleContext.fill] at object ⊢
    obtain ⟨rfl, members⟩ := object_collection_iff.mp object
    refine object_collection_iff.mpr ⟨rfl, ?_⟩
    simp only [List.mem_append, List.mem_cons] at members ⊢
    rintro x (inBefore | rfl | inAfter)
    · exact members x (.inl inBefore)
    · exact ih (members _ (.inr (.inl rfl)))
    · exact members x (.inr (.inr inAfter))

/-- **The equivalence holds in every context** whose filling is an object term. -/
theorem same_fill (context : OneHoleContext) {source target : Pattern}
    (object : isObjectPattern (context.fill source) = true) (same : Same relEnv source target) :
    Same relEnv (context.fill source) (context.fill target) := by
  have lift : ∀ {other : Pattern}, isObjectPattern other = true → isObjectPattern (context.fill other) = true :=
    fun otherObject => object_fill_replace context object otherObject
  clear object
  induction same with
  | rel x y step => exact .rel _ _ ⟨lift step.1, lift step.2.1, equationStep_fill context step.2.2⟩
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

theorem authored_same {equation : Equation} (member : equation ∈ language.equations) (noPremises : equation.premises = [])
    {source target : Pattern} {initial : Bindings} (sourceObject : isObjectPattern source = true)
    (targetObject : isObjectPattern target = true) (matched : MatchRel equation.left source initial)
    (instantiated : applyBindingsScoped (captureSitesOf equation.left equation.premises) initial 0 equation.right = target) :
    Same relEnv source target := by
  have valid : PremisesValid relEnv language (captureSitesOf equation.left equation.premises) initial equation.premises []
      initial := by rw [noPremises]; exact .nil _
  have authored := AuthoredEquation.forward member (undeclared equation member) (matchPattern_iff_matchRel.mpr matched) valid
  rw [instantiated] at authored
  exact .rel _ _ ⟨sourceObject, targetObject, EquationStep.inContext .hole (.inl authored)⟩

theorem authored_same_reverse {equation : Equation} (member : equation ∈ language.equations)
    (noPremises : equation.premises = []) {source target : Pattern} {initial : Bindings}
    (sourceObject : isObjectPattern source = true) (targetObject : isObjectPattern target = true)
    (matched : MatchRel equation.right source initial)
    (instantiated : applyBindingsScoped (captureSitesOf equation.right equation.premises) initial 0 equation.left = target) :
    Same relEnv source target := by
  have valid : PremisesValid relEnv language (captureSitesOf equation.right equation.premises) initial equation.premises []
      initial := by rw [noPremises]; exact .nil _
  have authored := AuthoredEquation.reverse member (undeclared equation member) (matchPattern_iff_matchRel.mpr matched) valid
  rw [instantiated] at authored
  exact .rel _ _ ⟨sourceObject, targetObject, EquationStep.inContext .hole (.inl authored)⟩

theorem bag_object {items : List Pattern} (objects : ∀ item ∈ items, isObjectPattern item = true) :
    isObjectPattern (bag items) = true :=
  object_collection_iff.mpr ⟨rfl, objects⟩

theorem empty_object : isObjectPattern (bag []) = true := bag_object (by simp)

theorem merge_into_empty (name : String) (value : Pattern) :
    mergeBindings [] [(name, value)] = some [(name, value)] := rfl

/-- **Removing the empty bag at a position.** -/
theorem same_drop_empty {items : List Pattern} {index : ℕ} (bound : index < items.length) (empty : items[index] = bag [])
    (objects : ∀ item ∈ items, isObjectPattern item = true) :
    Same relEnv (bag items) (bag (items.eraseIdx index)) := by
  refine authored_same (equation := flattenEmpty) (by simp [equations_eq]) rfl (bag_object objects)
    (bag_object fun item member => objects item (List.mem_of_mem_eraseIdx member))
    (initial := [("rest", bag (items.eraseIdx index))])
    (.collection (by decide) (.cons index bound (by rw [empty]; exact .collection (by decide) .nilNoRest) .nilRest
      (merge_into_empty _ _))) ?_
  simp only [flattenEmpty, bag, scoped_collection, List.map_nil, scoped_rest _ (find_single _ _), List.nil_append]

/-- **Adding the empty bag in front.** -/
theorem same_add_empty {items : List Pattern} (objects : ∀ item ∈ items, isObjectPattern item = true) :
    Same relEnv (bag items) (bag (bag [] :: items)) := by
  refine authored_same_reverse (equation := flattenEmpty) (by simp [equations_eq]) rfl (bag_object objects)
    (bag_object (by simp; exact ⟨empty_object, objects⟩)) (initial := [("rest", bag items)])
    (.collection (by decide) .nilRest) ?_
  simp only [flattenEmpty, bag, scoped_collection, List.map_cons, List.map_nil, scoped_rest _ (find_single _ _)]
  simp [restSplice]

/-- **Removing `0` at a position.** -/
theorem same_drop_zero {items : List Pattern} {index : ℕ} (bound : index < items.length)
    (zero : items[index] = .apply "PZero" []) (objects : ∀ item ∈ items, isObjectPattern item = true) :
    Same relEnv (bag items) (bag (items.eraseIdx index)) := by
  refine authored_same (equation := unitLaw) (by simp [equations_eq]) rfl (bag_object objects)
    (bag_object fun item member => objects item (List.mem_of_mem_eraseIdx member))
    (initial := [("rest", bag (items.eraseIdx index))])
    (.collection (by decide) (.cons index bound (by rw [zero]; exact .apply .nil rfl) .nilRest
      (merge_into_empty _ _))) ?_
  simp only [unitLaw, bag, scoped_collection, List.map_nil, scoped_rest _ (find_single _ _), List.nil_append]


theorem getElem_middle (before after : List Pattern) (value : Pattern) :
    (before ++ value :: after)[before.length]'(by simp) = value := by
  simp

theorem eraseIdx_middle (before after : List Pattern) (value : Pattern) :
    (before ++ value :: after).eraseIdx before.length = before ++ after := by
  rw [List.eraseIdx_append_of_length_le (le_refl _), Nat.sub_self, List.eraseIdx_cons_zero]

theorem objects_eraseIdx {items : List Pattern} (objects : ∀ item ∈ items, isObjectPattern item = true) (index : ℕ) :
    ∀ item ∈ items.eraseIdx index, isObjectPattern item = true :=
  fun item member => objects item (List.mem_of_mem_eraseIdx member)

/-- **Flattening one member of a nested bag**, at any position, as an equation step. -/
theorem same_flattenHead {items inner : List Pattern} {index member : ℕ} (bound : index < items.length)
    (nested : items[index] = bag inner) (memberBound : member < inner.length)
    (objects : ∀ item ∈ items, isObjectPattern item = true) :
    Same relEnv (bag items) (bag (inner[member] :: bag (inner.eraseIdx member) :: items.eraseIdx index)) := by
  have innerObject := objects _ (List.getElem_mem bound)
  rw [nested] at innerObject
  have innerObjects := (object_collection_iff.mp innerObject).2
  refine authored_same (equation := flattenHead) (by simp [equations_eq]) rfl (bag_object objects)
    (bag_object (by
      simp only [List.mem_cons]
      rintro item (rfl | rfl | member)
      · exact innerObjects _ (List.getElem_mem memberBound)
      · exact bag_object (objects_eraseIdx innerObjects member)
      · exact objects_eraseIdx objects index item member))
    (initial := [("rest", bag (items.eraseIdx index)), ("inner", bag (inner.eraseIdx member)), ("x", inner[member])])
    (.collection (by decide) (.cons index bound
      (by rw [nested]; exact .collection (by decide) (.cons member memberBound .fvar .nilRest rfl)) .nilRest rfl)) ?_
  simp only [flattenHead, bag, scoped_collection, List.map_cons, List.map_nil,
    scoped_fvar _ (show List.find? (fun pair => pair.1 == "x") [("rest", bag (items.eraseIdx index)),
      ("inner", bag (inner.eraseIdx member)), ("x", inner[member])] = some ("x", inner[member]) by simp),
    scoped_rest _ (show List.find? (fun pair => pair.1 == "inner") [("rest", bag (items.eraseIdx index)),
      ("inner", bag (inner.eraseIdx member)), ("x", inner[member])] = some ("inner", bag (inner.eraseIdx member)) by simp),
    scoped_rest _ (show List.find? (fun pair => pair.1 == "rest") [("rest", bag (items.eraseIdx index)),
      ("inner", bag (inner.eraseIdx member)), ("x", inner[member])] = some ("rest", bag (items.eraseIdx index)) by simp),
    List.nil_append, List.cons_append]

/-- **Wrapping a member and the empty bag**: `{{}, ...items}` is `{{v}, ...rest}` for any member `v` of `items`. -/
theorem same_wrap {items : List Pattern} {index : ℕ} (bound : index < items.length)
    (objects : ∀ item ∈ items, isObjectPattern item = true) :
    Same relEnv (bag (bag [] :: items)) (bag (bag [items[index]] :: items.eraseIdx index)) := by
  have valueObject := objects _ (List.getElem_mem bound)
  refine authored_same_reverse (equation := flattenHead) (by simp [equations_eq]) rfl
    (bag_object (by simp; exact ⟨empty_object, objects⟩))
    (bag_object (by
      simp only [List.mem_cons]
      rintro item (rfl | member)
      · exact bag_object (by simp [valueObject])
      · exact objects_eraseIdx objects index item member))
    (initial := [("inner", bag []), ("rest", bag (items.eraseIdx index)), ("x", items[index])])
    (.collection (by decide) (.cons (index + 1) (by simp [bound])
      (by simpa using (MatchRel.fvar : MatchRel (.fvar "x") items[index] _))
      (.cons 0 (by simp) (.collection (by decide) .nilRest) .nilRest rfl) rfl)) ?_
  simp only [flattenHead, bag, scoped_collection, List.map_cons, List.map_nil,
    scoped_fvar _ (show List.find? (fun pair => pair.1 == "x") [("inner", bag []),
      ("rest", bag (items.eraseIdx index)), ("x", items[index])] = some ("x", items[index]) by simp),
    scoped_rest _ (show List.find? (fun pair => pair.1 == "inner") [("inner", bag []),
      ("rest", bag (items.eraseIdx index)), ("x", items[index])] = some ("inner", bag []) by simp),
    scoped_rest _ (show List.find? (fun pair => pair.1 == "rest") [("inner", bag []),
      ("rest", bag (items.eraseIdx index)), ("x", items[index])] = some ("rest", bag (items.eraseIdx index)) by simp),
    List.nil_append, List.cons_append, List.append_nil]

/-- **Any member moves to the front.** -/
theorem same_moveFront {items : List Pattern} {index : ℕ} (bound : index < items.length)
    (objects : ∀ item ∈ items, isObjectPattern item = true) :
    Same relEnv (bag items) (bag (items[index] :: items.eraseIdx index)) := by
  have valueObject := objects _ (List.getElem_mem bound)
  have restObjects := objects_eraseIdx objects index
  have wrappedObjects : ∀ item ∈ bag [items[index]] :: items.eraseIdx index, isObjectPattern item = true := by
    simp only [List.mem_cons]
    rintro item (rfl | member)
    · exact bag_object (by simp [valueObject])
    · exact restObjects item member
  have unwrapped := same_flattenHead (relEnv := relEnv) (items := bag [items[index]] :: items.eraseIdx index)
    (inner := [items[index]]) (index := 0) (member := 0) (by simp) rfl (by simp) wrappedObjects
  simp only [List.getElem_cons_zero, List.eraseIdx_cons_zero] at unwrapped
  have dropped := same_drop_empty (relEnv := relEnv) (items := items[index] :: bag [] :: items.eraseIdx index)
    (index := 1) (by simp) rfl (by
      simp only [List.mem_cons]
      rintro item (rfl | rfl | member)
      · exact valueObject
      · exact empty_object
      · exact restObjects item member)
  simp only [List.eraseIdx_cons_succ, List.eraseIdx_cons_zero] at dropped
  exact .trans _ _ _ (same_add_empty objects) (.trans _ _ _ (same_wrap bound objects) (.trans _ _ _ unwrapped dropped))

/-- A member written in the middle moves to the front. -/
theorem same_moveFront_middle (before after : List Pattern) (value : Pattern)
    (objects : ∀ item ∈ before ++ value :: after, isObjectPattern item = true) :
    Same relEnv (bag (before ++ value :: after)) (bag (value :: before ++ after)) := by
  have moved := same_moveFront (relEnv := relEnv) (items := before ++ value :: after) (index := before.length)
    (by simp) objects
  rw [getElem_middle, eraseIdx_middle] at moved
  exact moved

/-- **A block moves past another**: `{x, ...pre, ...y}` is `{...pre, x, ...y}`. -/
theorem same_rotate (pre : List Pattern) : ∀ (front back : List Pattern),
    (∀ item ∈ front ++ pre ++ back, isObjectPattern item = true) →
      Same relEnv (bag (front ++ pre ++ back)) (bag (pre ++ front ++ back)) := by
  induction pre using List.reverseRecOn with
  | nil =>
    intro front back _
    rw [List.append_nil, List.nil_append]
    exact Relation.EqvGen.refl _
  | append_singleton pre last ih =>
    intro front back objects
    have moved := same_moveFront_middle (relEnv := relEnv) (front ++ pre) back last (by simpa using objects)
    have rest := ih (last :: front) back (by
      intro item member
      apply objects
      simp only [List.mem_append, List.mem_cons] at member ⊢
      tauto)
    simp only [List.append_assoc, List.cons_append] at moved rest ⊢
    exact .trans _ _ _ moved rest

/-- **A member moves to any position after a prefix.** -/
theorem same_moveAfter (pre : List Pattern) {items : List Pattern} {index : ℕ} (bound : index < items.length)
    (objects : ∀ item ∈ pre ++ items, isObjectPattern item = true) :
    Same relEnv (bag (pre ++ items)) (bag (pre ++ items[index] :: items.eraseIdx index)) := by
  have split := split_at bound
  have moved := same_moveFront_middle (relEnv := relEnv) (pre ++ items.take index) (items.drop (index + 1)) items[index]
    (by rw [List.append_assoc, ← split]; exact objects)
  have rotated := same_rotate (relEnv := relEnv) pre [items[index]] (items.take index ++ items.drop (index + 1)) (by
    intro item member
    apply objects
    simp only [List.mem_append, List.mem_singleton] at member ⊢
    rcases member with (rfl | inPre) | inTake | inDrop
    · exact .inr (List.getElem_mem bound)
    · exact .inl inPre
    · exact .inr (List.mem_of_mem_take inTake)
    · exact .inr (List.mem_of_mem_drop inDrop))
  rw [List.append_assoc, ← split] at moved
  rw [eraseIdx_eq index]
  simp only [List.append_assoc, List.cons_append] at moved rotated ⊢
  exact .trans _ _ _ moved rotated

/-- **Permutations of a bag are equation steps.** -/
theorem same_perm_after : ∀ (target pre items : List Pattern), items.Perm target →
    (∀ item ∈ pre ++ items, isObjectPattern item = true) →
      Same relEnv (bag (pre ++ items)) (bag (pre ++ target))
  | [], pre, items, permutation, _ => by
    rw [List.perm_nil.mp permutation]
    exact .refl _
  | value :: target, pre, items, permutation, objects => by
    obtain ⟨index, bound, found⟩ := List.getElem_of_mem (permutation.symm.subset (List.mem_cons_self))
    have moved := same_moveAfter (relEnv := relEnv) pre bound objects
    rw [found] at moved
    have restPerm : (items.eraseIdx index).Perm target := by
      have arranged := (List.getElem_cons_eraseIdx_perm bound).trans permutation
      rw [found] at arranged
      exact arranged.cons_inv
    have rest := same_perm_after target (pre ++ [value]) (items.eraseIdx index) restPerm (by
      intro item member
      simp only [List.mem_append, List.mem_singleton] at member
      rcases member with (inPre | rfl) | inRest
      · exact objects item (List.mem_append_left _ inPre)
      · exact objects _ (List.mem_append_right _ (found ▸ List.getElem_mem bound))
      · exact objects item (List.mem_append_right _ (List.mem_of_mem_eraseIdx inRest)))
    simp only [List.append_assoc, List.singleton_append] at rest
    exact .trans _ _ _ moved rest

theorem same_perm {items target : List Pattern} (permutation : items.Perm target)
    (objects : ∀ item ∈ items, isObjectPattern item = true) : Same relEnv (bag items) (bag target) := by
  simpa using same_perm_after (relEnv := relEnv) target [] items permutation (by simpa using objects)


/-- **Flattening a nested bag is a chain of equation steps**, one member at a time. -/
theorem same_flatten : ∀ (inner before after : List Pattern),
    (∀ item ∈ before ++ bag inner :: after, isObjectPattern item = true) →
      Same relEnv (bag (before ++ bag inner :: after)) (bag (before ++ inner ++ after))
  | [], before, after, objects => by
    have dropped := same_drop_empty (relEnv := relEnv) (items := before ++ bag [] :: after) (index := before.length)
      (by simp) (getElem_middle _ _ _) objects
    rw [eraseIdx_middle] at dropped
    simpa using dropped
  | value :: inner, before, after, objects => by
    have nestedObject := objects _ (List.mem_append_right _ List.mem_cons_self)
    have innerObjects := (object_collection_iff.mp nestedObject).2
    have restObjects : ∀ item ∈ before ++ after, isObjectPattern item = true := fun item member => by
      apply objects
      simp only [List.mem_append, List.mem_cons] at member ⊢
      tauto
    have first := same_flattenHead (relEnv := relEnv) (items := before ++ bag (value :: inner) :: after)
      (index := before.length) (member := 0) (by simp) (getElem_middle _ _ _) (by simp) objects
    rw [eraseIdx_middle] at first
    simp only [List.getElem_cons_zero, List.eraseIdx_cons_zero] at first
    have second := same_flatten inner [value] (before ++ after) (by
      simp only [List.singleton_append, List.mem_cons]
      rintro item (rfl | rfl | member)
      · exact innerObjects _ List.mem_cons_self
      · exact bag_object fun item member => innerObjects item (List.mem_cons_of_mem _ member)
      · exact restObjects item member)
    have third := same_perm (relEnv := relEnv) (items := value :: inner ++ (before ++ after))
      (target := before ++ (value :: inner) ++ after) (by
        simpa only [List.append_assoc, List.cons_append] using
          (List.perm_append_comm (l₁ := value :: inner) (l₂ := before)).append_right after)
      (by
        simp only [List.mem_cons, List.mem_append]
        rintro item ((rfl | inInner) | inRest)
        · exact innerObjects _ List.mem_cons_self
        · exact innerObjects item (List.mem_cons_of_mem _ inInner)
        · exact restObjects item (List.mem_append.mpr inRest))
    simp only [List.cons_append] at second
    exact .trans _ _ _ first (.trans _ _ _ second third)

/-- **The name equation** as an equation step. -/
theorem same_collapse {name : Pattern} (object : isObjectPattern name = true) :
    Same relEnv (.apply "NQuote" [.apply "PDrop" [name]]) name := by
  refine authored_same (equation := rhoCalc.equations[0]) (by simp [equations_eq]) rfl
    (by simp [isObjectPattern, isObjectPatternList, object]) object (initial := [("N", name)])
    (by rw [quoteDrop_left]; exact .apply (.cons (.apply (.cons .fvar .nil rfl) rfl) .nil rfl) rfl) ?_
  rw [quoteDrop_right, scoped_fvar _ (find_single _ _)]

open Mettapedia.Languages.ProcessCalculi.RhoCalculus.Canonical (HashSetFree) in
/-- **A law step between object terms without sets is a chain of equation steps.** -/
theorem same_of_lawStep {source target : Pattern} (step : LawStep laws source target)
    (object : isObjectPattern source = true) (pure : HashSetFree source) : Same relEnv source target := by
  induction step with
  | @permute kind elements permuted rest unordered permutation =>
    obtain ⟨rfl, members⟩ := object_collection_iff.mp object
    have notSet := (Complete.RhoReference.hashSetFree_collection.mp pure).1
    cases kind with
    | vec => cases unordered
    | hashSet => exact absurd rfl notSet
    | hashBag => exact same_perm permutation members
  | members _ => exact absurd pure (by simp [HashSetFree])
  | @flatten kind law before inner after rest found =>
    obtain ⟨rfl, rfl⟩ := Complete.RhoPresented.laws_found found
    obtain ⟨rfl, members⟩ := object_collection_iff.mp object
    exact same_flatten inner before after members
  | @unit kind law label before after rest found unit =>
    obtain ⟨rfl, rfl⟩ := Complete.RhoPresented.laws_found found
    cases unit
    obtain ⟨rfl, members⟩ := object_collection_iff.mp object
    have dropped := same_drop_zero (relEnv := relEnv) (items := before ++ .apply "PZero" [] :: after)
      (index := before.length) (by simp) (getElem_middle _ _ _) members
    rw [eraseIdx_middle] at dropped
    exact dropped
  | @apply label before after argument changed _ ih =>
    have argumentObject := object_of_fill (.apply label before .hole after) object
    have argumentPure := (Complete.RhoReference.hashSetFree_apply.mp pure) argument (by simp)
    exact same_fill (.apply label before .hole after) object (ih argumentObject argumentPure)
  | @lambda binder body changed _ ih =>
    exact same_fill (.lambda binder .hole) object (ih object (by simpa [HashSetFree] using pure))
  | @multiLambda arity binders body changed _ ih =>
    exact same_fill (.multiLambda arity binders .hole) object (ih object (by simpa [HashSetFree] using pure))
  | substBody => simp [isObjectPattern] at object
  | substReplacement => simp [isObjectPattern] at object
  | @element kind before after element changed rest _ ih =>
    have elementObject := object_of_fill (.collection kind before .hole after rest) object
    have elementPure := (Complete.RhoReference.hashSetFree_collection.mp pure).2 element (by simp)
    exact same_fill (.collection kind before .hole after rest) object (ih elementObject elementPure)

/-- **A use of the name equation between object terms is a chain of equation steps.** -/
theorem same_of_quoteDropStep {source target : Pattern} (step : QuoteDropStep presentation source target)
    (object : isObjectPattern source = true) : Same relEnv source target := by
  induction step with
  | collapse name =>
    exact same_collapse (object_of_fill (.apply "NQuote" [] (.apply "PDrop" [] .hole []) []) object)
  | @apply label before after argument changed _ ih =>
    exact same_fill (.apply label before .hole after) object (ih (object_of_fill (.apply label before .hole after) object))
  | @lambda binder body changed _ ih => exact same_fill (.lambda binder .hole) object (ih object)
  | @multiLambda arity binders body changed _ ih => exact same_fill (.multiLambda arity binders .hole) object (ih object)
  | substBody => simp [isObjectPattern] at object
  | substReplacement => simp [isObjectPattern] at object
  | @element kind before after element changed rest _ ih =>
    exact same_fill (.collection kind before .hole after rest) object
      (ih (object_of_fill (.collection kind before .hole after rest) object))

open Mettapedia.Languages.ProcessCalculi.RhoCalculus.Canonical (HashSetFree) in
theorem same_of_move {source target : Pattern} (move : Move source target) (object : isObjectPattern source = true)
    (pure : HashSetFree source) : Same relEnv source target := by
  rcases move with law | quoteDrop
  · exact same_of_lawStep law object pure
  · exact same_of_quoteDropStep quoteDrop object

open Mettapedia.Languages.ProcessCalculi.RhoCalculus.Canonical (HashSetFree) in
theorem Move.object_eq {source target : Pattern} (move : Move source target) :
    isObjectPattern source = isObjectPattern target := by
  rcases move with law | quoteDrop
  · exact law.objectPattern_eq
  · exact quoteDrop.objectPattern_eq

open Mettapedia.Languages.ProcessCalculi.RhoCalculus.Canonical (HashSetFree) in
theorem Move.pure_iff {source target : Pattern} (move : Move source target) :
    HashSetFree source ↔ HashSetFree target := by
  rcases move with law | quoteDrop
