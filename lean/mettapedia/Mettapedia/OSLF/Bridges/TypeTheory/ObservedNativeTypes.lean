import Mettapedia.GSLT.Logic.ObservedFamilyEnclosure
import Mettapedia.OSLF.Framework.HennessyMilnerNativeTypes

/-!
# Native predicates on actual observed material states

The native predicates generated by a GSLT respect its authored equations.
The material readout has the generally larger kernel of observed labelled
bisimilarity. Its actual image on native predicates is constructed below;
pulling that image back recovers the predicate exactly when it is constant
on that kernel. Formula-generated native types satisfy this condition.

The material state carrier consists of actual members of the readout range,
not every hyperset. Native modalities on it use the retained authored action
occurrences. Comparing them with the source GSLT's entire step relation also
requires exact agreement between labelled actions and source steps. Future lifting is
derived from faithful readout; predecessor box additionally needs incoming
lifting. No equation, occurrence or continuation identity is erased by a
claim about predicate support.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Bridges.TypeTheory.ObservedNativeTypes

open Mettapedia.GSLT Mettapedia.GSLT.HennessyMilner
open Mettapedia.GSLT.ObservedMaterialization
open Mettapedia.TypeTheory.MaterialSets
open Mettapedia.TypeTheory.MaterialSets.Hypersets
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis
open Mettapedia.OSLF.Framework.DerivedModalities

universe u
variable {S : GSLT.{u}} {M : System.{u, u} S}
variable (readings : LabelReadings M)

abbrev MaterialState := LiftedFamilyModel.Elements (ObservedFamilyEnclosure.valueRange readings)

theorem materialState_covered (member : MaterialState readings) :
    ∃ source, ObservedFamilyEnclosure.valueMember readings source = member := by
  obtain ⟨source, same⟩ := (ObservedFamilyEnclosure.mem_valueRange_iff readings member.1).mp member.2
  exact ⟨source, El.ext HSet.propositional same⟩

/-- The existential image of an actual generated native predicate. -/
def nativeImage (predicate : EquationPredicate S) : MaterialState readings → Prop :=
  fun member => ∃ source, ObservedFamilyEnclosure.valueMember readings source = member ∧ predicate.1 source

def BehaviourInvariant (predicate : EquationPredicate S) : Prop :=
  ∀ ⦃left right⦄, M.Bisimilar left right → (predicate.1 left ↔ predicate.1 right)

theorem nativeImage_at (faithful : readings.Faithful) (predicate : EquationPredicate S) (source : S.Term) :
    nativeImage readings predicate (ObservedFamilyEnclosure.valueMember readings source) ↔
      ∃ other, M.Bisimilar other source ∧ predicate.1 other := by
  exact exists_congr fun other => and_congr
    (ObservedFamilyEnclosure.valueMember_eq_iff readings faithful other source) Iff.rfl

theorem nativeImage_beta (faithful : readings.Faithful) (predicate : EquationPredicate S)
    (invariant : BehaviourInvariant (M := M) predicate) (source : S.Term) :
    nativeImage readings predicate (ObservedFamilyEnclosure.valueMember readings source) ↔ predicate.1 source := by
  rw [nativeImage_at readings faithful]
  exact ⟨fun ⟨_, related, holds⟩ => (invariant related).mp holds,
    fun holds => ⟨source, M.bisimilar_refl source, holds⟩⟩

/-- Exactness of this actual native-predicate image detects the additional
behavioural invariance; equation invariance alone does not suffice. -/
theorem nativeImage_exact_iff (faithful : readings.Faithful) (predicate : EquationPredicate S) :
    (∀ source, nativeImage readings predicate (ObservedFamilyEnclosure.valueMember readings source) ↔ predicate.1 source) ↔
      BehaviourInvariant (M := M) predicate := by
  constructor
  · intro reflects left right related
    constructor
    · intro holds
      exact (reflects right).mp ((nativeImage_at readings faithful predicate right).mpr ⟨left, related, holds⟩)
    · intro holds
      exact (reflects left).mp ((nativeImage_at readings faithful predicate left).mpr
        ⟨right, M.bisimilar_symm related, holds⟩)
  · exact nativeImage_beta readings faithful predicate

theorem generated_native_predicate_descends_iff (faithful : readings.Faithful)
    (nativeType : GSLTNativeType S) :
    ObservationSpans.PredicateDescends readings.value
      (fun source => (gsltOSLF S).satisfies (S := ()) source nativeType.pred) ↔
      BehaviourInvariant (M := M) nativeType.pred :=
  readings.predicateDescends_iff faithful nativeType.pred.1

def pullNative (predicate : MaterialState readings → Prop) : EquationPredicate S :=
  ⟨fun source => predicate (ObservedFamilyEnclosure.valueMember readings source), by
    intro left right equivalent
    have same : ObservedFamilyEnclosure.valueMember readings left =
        ObservedFamilyEnclosure.valueMember readings right :=
      El.ext HSet.propositional (readings.value_eq_of_equiv equivalent)
    change predicate _ ↔ predicate _
    rw [same]⟩

theorem pullNative_invariant (predicate : MaterialState readings → Prop) :
    BehaviourInvariant (M := M) (pullNative readings predicate) := by
  intro left right related
  have same : ObservedFamilyEnclosure.valueMember readings left =
      ObservedFamilyEnclosure.valueMember readings right :=
    El.ext HSet.propositional (readings.value_eq_of_bisimilar related)
  change predicate _ ↔ predicate _
  rw [same]

/-- The complete predicate frame of actual material states agrees with
exactly the kernel-constant fragment of the source's generated native frame. -/
def nativeMaterialOrderIso (faithful : readings.Faithful) :
    {predicate : EquationPredicate S // BehaviourInvariant (M := M) predicate} ≃o
      (MaterialState readings → Prop) where
  toFun predicate := nativeImage readings predicate.val
  invFun predicate := ⟨pullNative readings predicate, pullNative_invariant readings predicate⟩
  left_inv predicate := by
    apply Subtype.ext
    apply Subtype.ext
    funext source
    exact propext (nativeImage_beta readings faithful predicate.val predicate.property source)
  right_inv predicate := by
    funext member
    obtain ⟨source, rfl⟩ := materialState_covered readings member
    exact propext (nativeImage_beta readings faithful (pullNative readings predicate)
      (pullNative_invariant readings predicate) source)
  map_rel_iff' := by
    intro first second
    constructor
    · intro implication source holds
      exact (nativeImage_beta readings faithful second.val second.property source).mp
        (implication _ ((nativeImage_beta readings faithful first.val first.property source).mpr holds))
    · intro implication member ⟨source, same, holds⟩
      exact ⟨source, same, implication source holds⟩

theorem formula_invariant (formula : Formula M.Atom M.Label) :
    BehaviourInvariant (M := M) (Mettapedia.OSLF.Framework.HennessyMilnerNativeTypes.formulaPredicate M formula) := by
  intro left right related
  exact M.logicallyEquivalent_of_bisimilar related formula

/-- Formula native types have the actual tagged-membership interpretation
already constructed for the material readout, not a replacement semantics. -/
theorem nativeImage_formula (faithful : readings.Faithful) (formula : Formula M.Atom M.Label)
    (member : MaterialState readings) :
    nativeImage readings (Mettapedia.OSLF.Framework.HennessyMilnerNativeTypes.formulaPredicate M formula) member ↔
      readings.materialSat formula member.1 := by
  obtain ⟨source, rfl⟩ := materialState_covered readings member
  exact (nativeImage_beta readings faithful _ (formula_invariant formula) source).trans
    (readings.materialSat_value faithful formula source).symm

theorem formula_native_satisfaction (faithful : readings.Faithful)
    (formula : Formula M.Atom M.Label) (source : S.Term) :
    (gsltOSLF S).satisfies (S := ()) source
      (Mettapedia.OSLF.Framework.HennessyMilnerNativeTypes.formulaNativeType M formula).pred ↔
      readings.materialSat formula (readings.value source) :=
  (readings.materialSat_value faithful formula source).symm

/-- Only the HML converse uses finite behavioural covers. Forward truth
preservation and every single-formula comparison need no finiteness. -/
theorem formula_native_types_characterize_material_equality (faithful : readings.Faithful)
    (finite : M.ImageFiniteBisimilar) (left right : S.Term) :
    readings.value left = readings.value right ↔
      ∀ formula : Formula M.Atom M.Label,
        ((gsltOSLF S).satisfies (S := ()) left
          (Mettapedia.OSLF.Framework.HennessyMilnerNativeTypes.formulaNativeType M formula).pred ↔
         (gsltOSLF S).satisfies (S := ()) right
          (Mettapedia.OSLF.Framework.HennessyMilnerNativeTypes.formulaNativeType M formula).pred) :=
  (readings.value_eq_iff_bisimilar faithful left right).trans
    (Mettapedia.OSLF.Framework.HennessyMilnerNativeTypes.formulaNativeTypes_equivalent_iff_bisimilar_of_behavioral_cover M finite left right).symm

variable (occurrences : ActionOccurrences M)

/-- Labelled actions must agree in both directions with the full GSLT step
relation before the action span represents whole-step OSLF modalities. -/
def ActionsPresentSteps : Prop := ∀ source target, S.Step source target ↔ ∃ label, M.act label source target

theorem actionSpan_step_iff (complete : ActionsPresentSteps (M := M)) (source target : S.Term) :
    (∃ event : (occurrences.sourceSpan).Edge,
      (occurrences.sourceSpan).source event = source ∧ (occurrences.sourceSpan).target event = target) ↔
      S.Step source target := by
  constructor
  · rintro ⟨event, rfl, rfl⟩
    exact (complete event.source event.target).mpr ⟨event.label, (occurrences.erases event.label event.source event.target).mp ⟨event.occurrence⟩⟩
  · intro step
    obtain ⟨label, action⟩ := (complete source target).mp step
    obtain ⟨occurrence⟩ := (occurrences.erases label source target).mpr action
    exact ⟨⟨label, source, target, occurrence⟩, rfl, rfl⟩

def materialTheory : GSLT.{u + 1} :=
  equalityGSLT (MaterialState readings) (fun source target =>
    ∃ event : (ObservedFamilyEnclosure.Events.memberSpan readings occurrences).Edge,
      (ObservedFamilyEnclosure.Events.memberSpan readings occurrences).source event = source ∧
        (ObservedFamilyEnclosure.Events.memberSpan readings occurrences).target event = target)

def materialPredicate (predicate : EquationPredicate S) : EquationPredicate (materialTheory readings occurrences) :=
  ⟨nativeImage readings predicate, by intro left right same; cases same; rfl⟩

def materialNativeType (predicate : EquationPredicate S) : GSLTNativeType (materialTheory readings occurrences) where
  sort := ()
  pred := materialPredicate readings occurrences predicate

theorem materialDiamond_span (predicate : EquationPredicate S) (member : MaterialState readings) :
    (semanticDiamond (materialTheory readings occurrences) (materialPredicate readings occurrences predicate)).1 member ↔
      derivedDiamond (ObservedFamilyEnclosure.Events.memberSpan readings occurrences) (nativeImage readings predicate) member := by
  change gsltDiamond (materialTheory readings occurrences) (nativeImage readings predicate) member ↔ _
  refine (gsltDiamond_spec (materialTheory readings occurrences) (nativeImage readings predicate) member).trans ?_
  change (∃ target : MaterialState readings,
    (∃ event : (ObservedFamilyEnclosure.Events.memberSpan readings occurrences).Edge,
      (ObservedFamilyEnclosure.Events.memberSpan readings occurrences).source event = member ∧
      (ObservedFamilyEnclosure.Events.memberSpan readings occurrences).target event = target) ∧
        nativeImage readings predicate target) ↔ _
  constructor
  · rintro ⟨target, ⟨event, sourceEq, targetEq⟩, holds⟩
    refine ⟨event, sourceEq, ?_⟩
    change nativeImage readings predicate ((ObservedFamilyEnclosure.Events.memberSpan readings occurrences).target event)
    exact targetEq.symm ▸ holds
  · rintro ⟨event, sourceEq, holds⟩
    exact ⟨_, ⟨event, sourceEq, rfl⟩, holds⟩

theorem materialBox_span (predicate : EquationPredicate S) (member : MaterialState readings) :
    (semanticBox (materialTheory readings occurrences) (materialPredicate readings occurrences predicate)).1 member ↔
      derivedBox (ObservedFamilyEnclosure.Events.memberSpan readings occurrences) (nativeImage readings predicate) member := by
  change gsltBox (materialTheory readings occurrences) (nativeImage readings predicate) member ↔ _
  refine (gsltBox_spec (materialTheory readings occurrences) (nativeImage readings predicate) member).trans ?_
  change (∀ source : MaterialState readings,
    (∃ event : (ObservedFamilyEnclosure.Events.memberSpan readings occurrences).Edge,
      (ObservedFamilyEnclosure.Events.memberSpan readings occurrences).source event = source ∧
      (ObservedFamilyEnclosure.Events.memberSpan readings occurrences).target event = member) →
        nativeImage readings predicate source) ↔ _
  constructor
  · intro holds event targetEq
    exact holds _ ⟨event, rfl, targetEq⟩
  · rintro holds source ⟨event, sourceEq, targetEq⟩
    exact sourceEq ▸ holds event targetEq

/-- This comparison concerns the actual equation-invariant predicates and
modalities, independently of the legacy record's lattice-transport proofs. -/
theorem predicateDiamond_commutes (faithful : readings.Faithful) (complete : ActionsPresentSteps (M := M))
    (predicate : EquationPredicate S) (invariant : BehaviourInvariant (M := M) predicate) (source : S.Term) :
    (semanticDiamond (materialTheory readings occurrences) (materialPredicate readings occurrences predicate)).1
      (ObservedFamilyEnclosure.valueMember readings source)
      ↔ (semanticDiamond S predicate).1 source := by
  refine (materialDiamond_span readings occurrences predicate _).trans ?_
  refine (ObservedFamilyEnclosure.Events.diamond readings faithful occurrences (nativeImage readings predicate) source).trans ?_
  change derivedDiamond occurrences.sourceSpan
    (nativeImage readings predicate ∘ ObservedFamilyEnclosure.valueMember readings) source ↔ gsltDiamond S predicate.1 source
  rw [gsltDiamond_spec]
  constructor
  · rintro ⟨event, sourceEq, holds⟩
    refine ⟨event.target, ?_, (nativeImage_beta readings faithful predicate invariant event.target).mp holds⟩
    exact (actionSpan_step_iff occurrences complete source event.target).mp ⟨event, sourceEq, rfl⟩
  · rintro ⟨target, step, holds⟩
    obtain ⟨event, sourceEq, targetEq⟩ := (actionSpan_step_iff occurrences complete source target).mpr step
    refine ⟨event, sourceEq, ?_⟩
    change nativeImage readings predicate (ObservedFamilyEnclosure.valueMember readings event.target)
    change event.target = target at targetEq
    rw [targetEq]
    exact (nativeImage_beta readings faithful predicate invariant target).mpr holds

theorem predicateBox_commutes (faithful : readings.Faithful) (complete : ActionsPresentSteps (M := M))
    (incoming : (ObservedFamilyEnclosure.Events.observation readings occurrences).TargetLifts)
    (predicate : EquationPredicate S) (invariant : BehaviourInvariant (M := M) predicate) (source : S.Term) :
    (semanticBox (materialTheory readings occurrences) (materialPredicate readings occurrences predicate)).1
      (ObservedFamilyEnclosure.valueMember readings source)
      ↔ (semanticBox S predicate).1 source := by
  refine (materialBox_span readings occurrences predicate _).trans ?_
  refine ((ObservedFamilyEnclosure.Events.observation readings occurrences).box_pullback incoming
    (nativeImage readings predicate) source).trans ?_
  change derivedBox occurrences.sourceSpan
    (nativeImage readings predicate ∘ ObservedFamilyEnclosure.valueMember readings) source ↔ gsltBox S predicate.1 source
  rw [gsltBox_spec]
  constructor
  · intro holds previous step
    obtain ⟨event, sourceEq, targetEq⟩ := (actionSpan_step_iff occurrences complete previous source).mpr step
    have supported := holds event targetEq
    change nativeImage readings predicate (ObservedFamilyEnclosure.valueMember readings event.source) at supported
    change event.source = previous at sourceEq
    rw [sourceEq] at supported
    exact (nativeImage_beta readings faithful predicate invariant previous).mp supported
  · intro holds event targetEq
    apply (nativeImage_beta readings faithful predicate invariant event.source).mpr
    exact holds event.source ((actionSpan_step_iff occurrences complete event.source source).mp ⟨event, rfl, targetEq⟩)

/-- The same predicate comparison reaches the existing native OSLF judgment.
Its signature inherits the legacy OSLF frame-transport dependencies. -/
theorem nativeDiamond_commutes (faithful : readings.Faithful) (complete : ActionsPresentSteps (M := M))
    (predicate : EquationPredicate S) (invariant : BehaviourInvariant (M := M) predicate) (source : S.Term) :
    (gsltOSLF (materialTheory readings occurrences)).satisfies (S := ())
      (ObservedFamilyEnclosure.valueMember readings source)
      (semanticDiamond (materialTheory readings occurrences) (materialNativeType readings occurrences predicate).pred) ↔
        (gsltOSLF S).satisfies (S := ()) source (semanticDiamond S predicate) :=
  predicateDiamond_commutes readings occurrences faithful complete predicate invariant source

theorem nativeBox_commutes (faithful : readings.Faithful) (complete : ActionsPresentSteps (M := M))
    (incoming : (ObservedFamilyEnclosure.Events.observation readings occurrences).TargetLifts)
    (predicate : EquationPredicate S) (invariant : BehaviourInvariant (M := M) predicate) (source : S.Term) :
    (gsltOSLF (materialTheory readings occurrences)).satisfies (S := ())
      (ObservedFamilyEnclosure.valueMember readings source)
      (semanticBox (materialTheory readings occurrences) (materialNativeType readings occurrences predicate).pred) ↔
        (gsltOSLF S).satisfies (S := ()) source (semanticBox S predicate) :=
  predicateBox_commutes readings occurrences faithful complete incoming predicate invariant source

namespace Provenance

open Mettapedia.GSLT.ObservedMaterialization.ProvenanceControls OutcomeLabels

variable (result : Outcome.{u})

def sourceClass : GSLTNativeType theory.{u} :=
  Mettapedia.OSLF.Framework.HennessyMilnerNativeTypes.equationClassNativeType State.single

theorem sourceClass_rejects_double :
    ¬ (gsltOSLF theory.{u}).satisfies (S := ()) State.double (sourceClass.{u}).pred := by
  change ¬ (State.double : State.{u}) = State.single
  exact fun same => State.noConfusion same

/-- An actual native equation-class predicate is enlarged by the material
image: the other behaviourally equal source is included. -/
theorem nativeImage_accepts_double :
    nativeImage (plainReadings result) (sourceClass.{u}).pred
      (ObservedFamilyEnclosure.valueMember (plainReadings result) State.double) := by
  refine ⟨State.single, El.ext HSet.propositional (plain_values_eq result), ?_⟩
  exact Eq.refl State.single

theorem sourceClass_no_descent :
    ¬ ObservationSpans.PredicateDescends (plainReadings result).value
      (fun source => (gsltOSLF theory.{u}).satisfies (S := ()) source (sourceClass.{u}).pred) := by
  exact native_predicate_does_not_descend result

theorem actionsPresentSteps : ActionsPresentSteps (M := plain result) := by
  intro source target
  exact ⟨fun step => ⟨PUnit.unit, step⟩, fun ⟨_, step⟩ => step⟩

/-- This concrete system also supplies the incoming matching required by
predecessor box; it is derived from its actual terminal target. -/
theorem incomingLifts :
    (ObservedFamilyEnclosure.Events.observation (plainReadings result) (ProvenanceControls.occurrences result)).TargetLifts := by
  intro state event same
  have targetDone : event.target = State.done :=
    ((ProvenanceControls.occurrences result).erases event.label event.source event.target).mp ⟨event.occurrence⟩ |>.2
  have values := congrArg PSigma.fst same
  change (plainReadings result).value event.target = (plainReadings result).value state at values
  change event.target = State.done at targetDone
  have doneValue : (plainReadings result).value State.done = (plainReadings result).value state :=
    (congrArg (plainReadings result).value targetDone).symm.trans values
  cases state with
  | single => exact ((step_changes_value.{u, u} result).2 doneValue.symm).elim
  | double => exact ((step_changes_value.{u, u} result).2 ((plain_values_eq result).trans doneValue.symm)).elim
  | done => exact ⟨event, targetDone, rfl⟩

theorem material_future_support :
    (gsltOSLF (materialTheory (plainReadings result) (ProvenanceControls.occurrences result))).satisfies (S := ())
      (ObservedFamilyEnclosure.valueMember (plainReadings result) State.single)
      (semanticDiamond (materialTheory (plainReadings result) (ProvenanceControls.occurrences result))
        (materialNativeType (plainReadings result) (ProvenanceControls.occurrences result)
          (Mettapedia.OSLF.Framework.HennessyMilnerNativeTypes.formulaPredicate (plain result) (.atom result))).pred) := by
  apply (nativeDiamond_commutes (plainReadings result) (ProvenanceControls.occurrences result) (plainFaithful result)
    (actionsPresentSteps result) _ (formula_invariant (.atom result)) State.single).mpr
  exact (gsltDiamond_spec theory _ State.single).mpr
    ⟨State.done, (step_changes_value.{u, u} result).1, ⟨rfl, rfl⟩⟩

theorem material_past_support :
    (gsltOSLF (materialTheory (plainReadings result) (ProvenanceControls.occurrences result))).satisfies (S := ())
      (ObservedFamilyEnclosure.valueMember (plainReadings result) State.done)
      (semanticBox (materialTheory (plainReadings result) (ProvenanceControls.occurrences result))
        (materialNativeType (plainReadings result) (ProvenanceControls.occurrences result)
          (Mettapedia.OSLF.Framework.HennessyMilnerNativeTypes.formulaPredicate (plain result) (.neg (.atom result)))).pred) := by
  apply (nativeBox_commutes (plainReadings result) (ProvenanceControls.occurrences result) (plainFaithful result)
    (actionsPresentSteps result) (incomingLifts result) _ (formula_invariant (.neg (.atom result))) State.done).mpr
  apply (gsltBox_spec theory _ State.done).mpr
  intro source step atom
  exact step.1 atom.1

/-- The same retained events carry a typed Boolean continuation that cannot
be reconstructed from the material entry, despite exact modal support. -/
theorem typed_continuation_not_recoverable :
    ¬ ∃ continuation : HSet.{u} → Bool,
      ∀ event : ActionOccurrences.Event (ProvenanceControls.occurrences result),
        continuation (materialEntry result event) = provenance result event :=
  provenance_does_not_factor result

end Provenance

end Mettapedia.OSLF.Bridges.TypeTheory.ObservedNativeTypes
