/-
# Categorical evidence-register bridge

The scalar evidence-register bridge identifies one additive Gaussian register
behind PLN revision and predictive-coding settling.  This file supplies the
finite categorical analogue.  Natural-number `MultiEvidence` is embedded in
the established continuous evidential-opinion chart; its Dirichlet posterior
is both the static readout and the unique equilibrium of an explicit convex
quadratic PC energy.

A mask is applied only after the shared posterior has been formed.  Thus a
checker can remove support identically for a static readout and for the PC
equilibrium, while neither readout can manufacture legal support.
-/

import Mettapedia.PLN.Bridges.PredictiveCoding.EvidenceRegisterBridge
import Mettapedia.MachineLearning.NeuralNetworks.UnifiedCarrier.EvidentialOpinion

namespace Mettapedia.PLN.Bridges.PredictiveCoding

open scoped BigOperators
open Mettapedia.PLN.Bridges.ProbabilityTheory.EvidenceDirichlet
open Mettapedia.MachineLearning.NeuralNetworks.UnifiedCarrier.EvidentialOpinion

noncomputable section

variable {Class : Type*} [Fintype Class] [Nonempty Class]

/-- Embed exact categorical counts in the established continuous evidence
register.  No prior concentration is stored here; the opinion chart adds its
single unit base concentration at readout time. -/
def categoricalRegisterOfCounts (evidence : MultiEvidence (Fintype.card Class)) :
    Opinion Class where
  evidence classIndex := evidence.counts (Fintype.equivFin Class classIndex)
  evidence_nonneg classIndex := by positivity

/-- Identity-indexed specialization used by finite action vocabularies. -/
def finCategoricalRegisterOfCounts {k : ℕ} (evidence : MultiEvidence k) :
    Opinion (Fin k) where
  evidence classIndex := evidence.counts classIndex
  evidence_nonneg classIndex := by positivity

/-- Static WM-PLN categorical readout of the shared register. -/
def categoricalPosterior (register : Opinion Class) : Class → ℝ :=
  posteriorMean register

/-- Total Dirichlet concentration.  This is the precision multiplying the PC
energy below. -/
def categoricalPrecision (register : Opinion Class) : ℝ :=
  strength register

/-- Precision-weighted quadratic evidence energy on the finite action
coordinates. -/
def categoricalPCEnergy (register : Opinion Class) (state : Class → ℝ) : ℝ :=
  categoricalPrecision register *
    ∑ classIndex, (state classIndex - categoricalPosterior register classIndex) ^ 2

/-- The force generated by the categorical PC evidence energy, up to the
irrelevant common factor two. -/
def categoricalPCForce
    (register : Opinion Class) (state : Class → ℝ) (classIndex : Class) : ℝ :=
  categoricalPrecision register *
    (state classIndex - categoricalPosterior register classIndex)

/-- PC equilibrium is zero evidence-energy force in every coordinate. -/
def CategoricalPCEquilibrium
    (register : Opinion Class) (state : Class → ℝ) : Prop :=
  ∀ classIndex, categoricalPCForce register state classIndex = 0

theorem categoricalPrecision_pos (register : Opinion Class) :
    0 < categoricalPrecision register :=
  strength_pos register

/-- The declared energy is nonnegative. -/
theorem categoricalPCEnergy_nonneg
    (register : Opinion Class) (state : Class → ℝ) :
    0 ≤ categoricalPCEnergy register state := by
  exact mul_nonneg (categoricalPrecision_pos register).le
    (Finset.sum_nonneg fun classIndex _ => sq_nonneg
      (state classIndex - categoricalPosterior register classIndex))

/-- Coordinatewise Jensen inequality for the declared energy.  This is its
explicit convexity certificate, independent of differentiability APIs. -/
theorem categoricalPCEnergy_convexCombination
    (register : Opinion Class) (left right : Class → ℝ)
    (a b : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1) :
    categoricalPCEnergy register (a • left + b • right) ≤
      a * categoricalPCEnergy register left +
        b * categoricalPCEnergy register right := by
  have hpoint : ∀ classIndex : Class,
      (((a • left + b • right) classIndex -
          categoricalPosterior register classIndex) ^ 2) ≤
        a * (left classIndex - categoricalPosterior register classIndex) ^ 2 +
          b * (right classIndex - categoricalPosterior register classIndex) ^ 2 := by
    intro classIndex
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    have hb_eq : b = 1 - a := by linarith
    subst b
    have hvariance :
        0 ≤ a * (1 - a) * (left classIndex - right classIndex) ^ 2 :=
      mul_nonneg (mul_nonneg ha hb) (sq_nonneg _)
    calc
      (a * left classIndex + (1 - a) * right classIndex -
          categoricalPosterior register classIndex) ^ 2 =
        a * (left classIndex - categoricalPosterior register classIndex) ^ 2 +
          (1 - a) *
            (right classIndex - categoricalPosterior register classIndex) ^ 2 -
          a * (1 - a) * (left classIndex - right classIndex) ^ 2 := by ring
      _ ≤ a * (left classIndex - categoricalPosterior register classIndex) ^ 2 +
          (1 - a) *
            (right classIndex - categoricalPosterior register classIndex) ^ 2 :=
        sub_le_self _ hvariance
  have hsum :
      (∑ classIndex,
        ((a • left + b • right) classIndex -
          categoricalPosterior register classIndex) ^ 2) ≤
        ∑ classIndex,
          (a * (left classIndex - categoricalPosterior register classIndex) ^ 2 +
            b * (right classIndex - categoricalPosterior register classIndex) ^ 2) :=
    Finset.sum_le_sum (s := Finset.univ) fun classIndex _ => hpoint classIndex
  unfold categoricalPCEnergy
  have hprecision := (categoricalPrecision_pos register).le
  calc
    categoricalPrecision register *
        ∑ classIndex,
          ((a • left + b • right) classIndex -
            categoricalPosterior register classIndex) ^ 2 ≤
      categoricalPrecision register *
        ∑ classIndex,
          (a * (left classIndex - categoricalPosterior register classIndex) ^ 2 +
            b * (right classIndex - categoricalPosterior register classIndex) ^ 2) :=
      mul_le_mul_of_nonneg_left hsum hprecision
    _ = a * (categoricalPrecision register *
          ∑ classIndex,
            (left classIndex - categoricalPosterior register classIndex) ^ 2) +
        b * (categoricalPrecision register *
          ∑ classIndex,
            (right classIndex - categoricalPosterior register classIndex) ^ 2) := by
      rw [Finset.sum_add_distrib]
      simp_rw [← Finset.mul_sum]
      ring

/-- The same statement through mathlib's `ConvexOn` interface. -/
theorem categoricalPCEnergy_convexOn (register : Opinion Class) :
    ConvexOn ℝ Set.univ (categoricalPCEnergy register) := by
  refine ⟨convex_univ, ?_⟩
  intro left _ right _ a b ha hb hab
  simpa only [smul_eq_mul] using
    categoricalPCEnergy_convexCombination register left right a b ha hb hab

/-- **Categorical WM-PC bridge.**  The unique zero-force PC equilibrium is
exactly the WM-PLN Dirichlet posterior read from the same evidence register. -/
theorem categoricalPCEquilibrium_iff_eq_posterior
    (register : Opinion Class) (state : Class → ℝ) :
    CategoricalPCEquilibrium register state ↔
      state = categoricalPosterior register := by
  constructor
  · intro hequilibrium
    funext classIndex
    have hforce := hequilibrium classIndex
    unfold categoricalPCForce at hforce
    apply sub_eq_zero.mp
    exact (mul_eq_zero.mp hforce).resolve_left
      (categoricalPrecision_pos register).ne'
  · rintro rfl
    intro classIndex
    simp [categoricalPCForce]

/-- Equivalently, the posterior is the unique global minimizer of the declared
convex energy. -/
theorem categoricalPCEnergy_isMinOn_iff_eq_posterior
    (register : Opinion Class) (state : Class → ℝ) :
    IsMinOn (categoricalPCEnergy register) Set.univ state ↔
      state = categoricalPosterior register := by
  constructor
  · intro hmin
    have hle := (isMinOn_univ_iff.mp hmin) (categoricalPosterior register)
    have hzero : categoricalPCEnergy register
        (categoricalPosterior register) = 0 := by
      simp [categoricalPCEnergy]
    rw [hzero] at hle
    have heqzero : categoricalPCEnergy register state = 0 :=
      le_antisymm hle (categoricalPCEnergy_nonneg register state)
    unfold categoricalPCEnergy at heqzero
    have hsum :
        ∑ classIndex,
          (state classIndex - categoricalPosterior register classIndex) ^ 2 = 0 := by
      exact (mul_eq_zero.mp heqzero).resolve_left
        (categoricalPrecision_pos register).ne'
    funext classIndex
    have hterm :
        (state classIndex - categoricalPosterior register classIndex) ^ 2 = 0 := by
      have hnonneg : ∀ index ∈ (Finset.univ : Finset Class),
          0 ≤ (state index - categoricalPosterior register index) ^ 2 := by
        intro index _
        positivity
      exact (Finset.sum_eq_zero_iff_of_nonneg hnonneg).mp hsum classIndex
        (Finset.mem_univ classIndex)
    nlinarith [hterm]
  · rintro rfl
    apply isMinOn_univ_iff.mpr
    intro candidate
    simpa [categoricalPCEnergy] using
      categoricalPCEnergy_nonneg register candidate

omit [Nonempty Class] in
/-- Zero categorical evidence reads as the neutral uniform prior. -/
theorem zeroCounts_categoricalPosterior
    (classIndex : Class) :
    categoricalPosterior
        (categoricalRegisterOfCounts
          (MultiEvidence.zero : MultiEvidence (Fintype.card Class))) classIndex =
      1 / (Fintype.card Class : ℝ) := by
  simp [categoricalPosterior, categoricalRegisterOfCounts,
    posteriorMean, concentration, strength, MultiEvidence.zero]

/-- Increasing concentration while keeping every concentration proportion
fixed raises precision by the same factor and leaves every posterior mean
unchanged.  This is the precise categorical version of "more independent
evidence, same proportions." -/
theorem proportionalEvidenceScale_samePosterior_higherPrecision
    (register : Opinion Class) (scale : ℝ) (hscale : 1 < scale) :
    (∀ classIndex,
      categoricalPosterior
          (rescaleConcentration scale hscale.le register) classIndex =
        categoricalPosterior register classIndex) ∧
      categoricalPrecision
          (rescaleConcentration scale hscale.le register) =
        scale * categoricalPrecision register ∧
      categoricalPrecision register <
        categoricalPrecision
          (rescaleConcentration scale hscale.le register) := by
  refine ⟨posteriorMean_rescaleConcentration scale hscale.le register, ?_, ?_⟩
  · exact strength_rescaleConcentration scale hscale.le register
  · change strength register < strength (rescaleConcentration scale hscale.le register)
    rw [strength_rescaleConcentration]
    exact lt_mul_of_one_lt_left (categoricalPrecision_pos register) hscale

/-! ## Checker-owned support -/

/-- Apply a hard external mask after forming the shared posterior. -/
def maskedCategoricalScore
    (register : Opinion Class) (legal : Class → Bool) (classIndex : Class) : ℝ :=
  if legal classIndex then categoricalPosterior register classIndex else 0

/-- Normalize the masked scores.  The definition remains total; the support
theorems below require the checker's ordinary nonempty-legality premise. -/
def maskedCategoricalDistribution
    (register : Opinion Class) (legal : Class → Bool) (classIndex : Class) : ℝ :=
  maskedCategoricalScore register legal classIndex /
    ∑ index, maskedCategoricalScore register legal index

/-- Unnormalized Dirichlet concentration retained by the checker mask. -/
def maskedConcentrationTotal
    (register : Opinion Class) (legal : Class → Bool) : ℝ :=
  ∑ index, if legal index then concentration register index else 0

omit [Nonempty Class] in
theorem maskedConcentrationTotal_pos
    (register : Opinion Class) (legal : Class → Bool)
    (hlegal : ∃ classIndex, legal classIndex = true) :
    0 < maskedConcentrationTotal register legal := by
  obtain ⟨classIndex, hclassIndex⟩ := hlegal
  have hterm : 0 < (if legal classIndex then
      concentration register classIndex else 0) := by
    simp [hclassIndex, concentration_pos register classIndex]
  have hnonneg : ∀ index ∈ (Finset.univ : Finset Class),
      0 ≤ (if legal index then concentration register index else 0) := by
    intro index _
    by_cases h : legal index = true
    · simp [h, (concentration_pos register index).le]
    · simp [h]
  exact hterm.trans_le
    (Finset.single_le_sum hnonneg (Finset.mem_univ classIndex))

/-- Cancellation of the common Dirichlet strength gives the exact executable
concentration-ratio form of the masked distribution. -/
theorem maskedCategoricalDistribution_eq_concentrationRatio
    (register : Opinion Class) (legal : Class → Bool)
    (hlegal : ∃ classIndex, legal classIndex = true) (classIndex : Class) :
    maskedCategoricalDistribution register legal classIndex =
      (if legal classIndex then concentration register classIndex else 0) /
        maskedConcentrationTotal register legal := by
  have hstrength : strength register ≠ 0 := (strength_pos register).ne'
  have htotal : maskedConcentrationTotal register legal ≠ 0 :=
    (maskedConcentrationTotal_pos register legal hlegal).ne'
  have hscore : ∀ index,
      maskedCategoricalScore register legal index =
        (if legal index then concentration register index else 0) /
          strength register := by
    intro index
    by_cases h : legal index = true
    · simp [maskedCategoricalScore, categoricalPosterior, posteriorMean, h]
    · simp [maskedCategoricalScore, h]
  have hsum :
      (∑ index, maskedCategoricalScore register legal index) =
        maskedConcentrationTotal register legal / strength register := by
    simp_rw [hscore]
    simpa [maskedConcentrationTotal] using
      (Finset.sum_div (Finset.univ : Finset Class)
        (fun index => if legal index then concentration register index else 0)
        (strength register)).symm
  rw [maskedCategoricalDistribution, hscore, hsum]
  field_simp [hstrength, htotal]

theorem maskedCategoricalScore_ne_zero_iff
    (register : Opinion Class) (legal : Class → Bool) (classIndex : Class) :
    maskedCategoricalScore register legal classIndex ≠ 0 ↔
      legal classIndex = true := by
  by_cases hlegal : legal classIndex = true
  · have hpositive : 0 < categoricalPosterior register classIndex :=
      posteriorMean_pos register classIndex
    simp [maskedCategoricalScore, hlegal, ne_of_gt hpositive]
  · simp [maskedCategoricalScore, hlegal]

theorem maskedCategoricalDenominator_pos
    (register : Opinion Class) (legal : Class → Bool)
    (hlegal : ∃ classIndex, legal classIndex = true) :
    0 < ∑ index, maskedCategoricalScore register legal index := by
  obtain ⟨classIndex, hclassIndex⟩ := hlegal
  have hterm : 0 < maskedCategoricalScore register legal classIndex := by
    have hpositive : 0 < categoricalPosterior register classIndex :=
      posteriorMean_pos register classIndex
    simp [maskedCategoricalScore, hclassIndex, hpositive]
  have hnonneg : ∀ index ∈ (Finset.univ : Finset Class),
      0 ≤ maskedCategoricalScore register legal index := by
    intro index _
    by_cases h : legal index = true
    · have hnonnegative : 0 ≤ categoricalPosterior register index :=
        (posteriorMean_pos register index).le
      simp [maskedCategoricalScore, h, hnonnegative]
    · simp [maskedCategoricalScore, h]
  have hle := Finset.single_le_sum hnonneg (Finset.mem_univ classIndex)
  exact hterm.trans_le hle

/-- The normalized readout has support exactly on checker-legal actions. -/
theorem maskedCategoricalDistribution_ne_zero_iff
    (register : Opinion Class) (legal : Class → Bool)
    (hlegal : ∃ classIndex, legal classIndex = true) (classIndex : Class) :
    maskedCategoricalDistribution register legal classIndex ≠ 0 ↔
      legal classIndex = true := by
  have hdenom := maskedCategoricalDenominator_pos register legal hlegal
  rw [maskedCategoricalDistribution, div_ne_zero_iff]
  constructor
  · rintro ⟨hnumerator, _⟩
    exact (maskedCategoricalScore_ne_zero_iff register legal classIndex).mp
      hnumerator
  · intro hlegalIndex
    exact ⟨(maskedCategoricalScore_ne_zero_iff register legal classIndex).mpr
      hlegalIndex, ne_of_gt hdenom⟩

/-- A static BP-compatible readout and a settled PC readout consume the same
register and therefore obtain exactly the same checker-masked distribution. -/
theorem staticReadout_eq_settledReadout_and_sameSupport
    (register : Opinion Class) (settled : Class → ℝ)
    (hsettled : CategoricalPCEquilibrium register settled)
    (legal : Class → Bool)
    (hlegal : ∃ classIndex, legal classIndex = true) :
    settled = categoricalPosterior register ∧
      (∀ classIndex,
        maskedCategoricalDistribution register legal classIndex ≠ 0 ↔
          legal classIndex = true) := by
  exact ⟨(categoricalPCEquilibrium_iff_eq_posterior register settled).mp hsettled,
    maskedCategoricalDistribution_ne_zero_iff register legal hlegal⟩

/-! ## Positive and negative executable examples -/

def binaryCounts : MultiEvidence 2 :=
  ⟨fun classIndex => if classIndex = 0 then 3 else 1⟩

theorem binaryCounts_posterior_example :
    categoricalPosterior
        (finCategoricalRegisterOfCounts binaryCounts) 0 =
        2 / 3 ∧
      categoricalPosterior
        (finCategoricalRegisterOfCounts binaryCounts) 1 =
        1 / 3 := by
  norm_num [binaryCounts, categoricalPosterior, finCategoricalRegisterOfCounts,
    posteriorMean, concentration, strength]

/-- A posterior preference cannot bypass a checker mask. -/
theorem masked_preferred_action_rejected :
    maskedCategoricalDistribution
        (finCategoricalRegisterOfCounts binaryCounts)
        (fun action : Fin 2 => action = 1) 0 = 0 := by
  simp [maskedCategoricalDistribution, maskedCategoricalScore]

