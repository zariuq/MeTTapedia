import Mettapedia.Logic.ModalCompanion.Derivations
import Mettapedia.Logic.HostingStyles.ProofTheory

/-!
# The worked logic: intuitionistic propositional logic, natively

The logic carried through the three hostings is intuitionistic propositional
logic in Hilbert style: the formulas of Foundation's `Propositional.Formula ℕ`,
the axioms of Foundation's `Propositional.Int`, and modus ponens.  It contains
minimal implicational logic as the fragment generated by the two axioms
`implyK` and `implyS`.

Its derivations already exist as data: `Mettapedia.Logic.ModalCompanion.IntDeriv`.
This module presents the same calculus as a rule signature, so that the
generic constructions apply to it, and shows that nothing was changed.

* `intSignature`: a rule instance is an axiom instance, with no premise, or
  an instance of modus ponens, with the implication and its antecedent as
  premises.
* `derivEquiv`: the derivations of the signature are exactly the existing
  derivation trees without assumptions.
* `nonempty_proof_iff_provable`: a formula has a derivation exactly when it is
  a theorem of Foundation's `Propositional.Int`.

Examples at the end: two different derivations of one formula, of different
sizes.
-/

set_option autoImplicit false

namespace Mettapedia.Logic.HostingStyles

open LO
open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.IndexedPolynomial
open Mettapedia.Logic.ModalCompanion

/-- The formulas of the worked logic. -/
abbrev IntFormula : Type := Propositional.Formula ℕ

/-- The axiom instances of the intuitionistic Hilbert calculus. -/
inductive IntAxiom : IntFormula → Type where
  | efq (φ : IntFormula) : IntAxiom (⊥ ➝ φ)
  | implyK (φ ψ : IntFormula) : IntAxiom (φ ➝ ψ ➝ φ)
  | implyS (φ ψ χ : IntFormula) : IntAxiom ((φ ➝ ψ ➝ χ) ➝ (φ ➝ ψ) ➝ φ ➝ χ)
  | andElimL (φ ψ : IntFormula) : IntAxiom (φ ⋏ ψ ➝ φ)
  | andElimR (φ ψ : IntFormula) : IntAxiom (φ ⋏ ψ ➝ ψ)
  | andIntro (φ ψ : IntFormula) : IntAxiom (φ ➝ ψ ➝ φ ⋏ ψ)
  | orIntroL (φ ψ : IntFormula) : IntAxiom (φ ➝ φ ⋎ ψ)
  | orIntroR (φ ψ : IntFormula) : IntAxiom (ψ ➝ φ ⋎ ψ)
  | orElim (φ ψ χ : IntFormula) : IntAxiom ((φ ➝ χ) ➝ (ψ ➝ χ) ➝ φ ⋎ ψ ➝ χ)

/-- The rule instances: an axiom instance, or modus ponens. -/
inductive IntRule : IntFormula → Type where
  | axm {φ : IntFormula} : IntAxiom φ → IntRule φ
  | mdp (φ ψ : IntFormula) : IntRule ψ

/-- The premises of a rule instance: none for an axiom, two for modus
ponens. -/
def IntRule.Position : {φ : IntFormula} → IntRule φ → Type
  | _, .axm _ => Empty
  | _, .mdp _ _ => Bool

/-- The premises of modus ponens are the implication and its antecedent. -/
def IntRule.premise : {φ : IntFormula} → (rule : IntRule φ) → rule.Position → IntFormula
  | _, .axm _, position => nomatch position
  | _, .mdp φ ψ, position => cond position φ (φ ➝ ψ)

/-- **The rule signature of the intuitionistic Hilbert calculus.** -/
def intSignature : RuleSignature IntFormula where
  Shape := fun _ φ => IntRule φ
  Position := fun rule => rule.Position
  next := fun rule position => rule.premise position

/-- Every rule has finitely many premises. -/
def intFinitary : intSignature.Finitary where
  arity := fun rule => match rule with
    | .axm _ => 0
    | .mdp _ _ => 2
  position := fun rule => match rule with
    | .axm _ => finZeroEquiv
    | .mdp _ _ => finTwoEquiv

/-- The derivations of the worked logic. -/
abbrev IntProof (φ : IntFormula) : Type := intSignature.Proof φ

/-- The derivation that is one axiom instance. -/
def axiomProof {φ : IntFormula} (instance' : IntAxiom φ) : IntProof φ :=
  intSignature.node (.axm instance') fun position => nomatch position

/-- Modus ponens. -/
def mdpProof {φ ψ : IntFormula} (major : IntProof (φ ➝ ψ)) (minor : IntProof φ) : IntProof ψ :=
  intSignature.node (.mdp φ ψ) fun position =>
    match position with
    | false => major
    | true => minor

/-! ## Agreement with the existing derivation trees -/

/-- An axiom instance as an existing derivation tree. -/
def IntAxiom.toDeriv : {φ : IntFormula} → IntAxiom φ → IntDeriv [] φ
  | _, .efq φ => .efq φ
  | _, .implyK φ ψ => .implyK φ ψ
  | _, .implyS φ ψ χ => .implyS φ ψ χ
  | _, .andElimL φ ψ => .andElimL φ ψ
  | _, .andElimR φ ψ => .andElimR φ ψ
  | _, .andIntro φ ψ => .andIntro φ ψ
  | _, .orIntroL φ ψ => .orIntroL φ ψ
  | _, .orIntroR φ ψ => .orIntroR φ ψ
  | _, .orElim φ ψ χ => .orElim φ ψ χ

/-- An existing derivation tree without assumptions, as a derivation of the
signature. -/
def ofDeriv : {φ : IntFormula} → IntDeriv [] φ → IntProof φ
  | _, .hyp member => nomatch member
  | _, .efq φ => axiomProof (.efq φ)
  | _, .lem _ classical => nomatch classical
  | _, .implyK φ ψ => axiomProof (.implyK φ ψ)
  | _, .implyS φ ψ χ => axiomProof (.implyS φ ψ χ)
  | _, .andElimL φ ψ => axiomProof (.andElimL φ ψ)
  | _, .andElimR φ ψ => axiomProof (.andElimR φ ψ)
  | _, .andIntro φ ψ => axiomProof (.andIntro φ ψ)
  | _, .orIntroL φ ψ => axiomProof (.orIntroL φ ψ)
  | _, .orIntroR φ ψ => axiomProof (.orIntroR φ ψ)
  | _, .orElim φ ψ χ => axiomProof (.orElim φ ψ χ)
  | _, .mdp major minor => mdpProof (ofDeriv major) (ofDeriv minor)

/-- The existing derivation trees carry an algebra of the signature. -/
def derivAlgebra : intSignature.Algebra (fun _ φ => IntDeriv [] φ) where
  act := fun _ _ layer =>
    match layer with
    | ⟨.axm instance', _⟩ => instance'.toDeriv
    | ⟨.mdp _ _, children⟩ => .mdp (children false) (children true)

/-- A derivation of the signature, as an existing derivation tree. -/
noncomputable def toDeriv {φ : IntFormula} (proof : IntProof φ) : IntDeriv [] φ :=
  Fix.fold intSignature derivAlgebra.act PUnit.unit φ proof

theorem toDeriv_axiomProof {φ : IntFormula} (instance' : IntAxiom φ) :
    toDeriv (axiomProof instance') = instance'.toDeriv := rfl

theorem toDeriv_mdpProof {φ ψ : IntFormula} (major : IntProof (φ ➝ ψ)) (minor : IntProof φ) :
    toDeriv (mdpProof major minor) = .mdp (toDeriv major) (toDeriv minor) := rfl

theorem ofDeriv_toDeriv_axiom {φ : IntFormula} (instance' : IntAxiom φ) :
    ofDeriv instance'.toDeriv = axiomProof instance' := by
  cases instance' <;> rfl

theorem toDeriv_ofDeriv {φ : IntFormula} (derivation : IntDeriv [] φ) :
    toDeriv (ofDeriv derivation) = derivation := by
  induction derivation with
  | hyp member => exact nomatch member
  | lem _ classical => exact nomatch classical
  | mdp major minor ihMajor ihMinor =>
      rw [ofDeriv, toDeriv_mdpProof, ihMajor, ihMinor]
  | _ => rfl

theorem ofDeriv_toDeriv {φ : IntFormula} (proof : IntProof φ) :
    ofDeriv (toDeriv proof) = proof := by
  induction proof using RuleSignature.Proof.induction with
  | node rule children ih =>
      cases rule with
      | axm instance' =>
          have none : children = fun position => nomatch position := by
            funext position
            exact nomatch position
          subst none
          exact ofDeriv_toDeriv_axiom instance'
      | mdp φ ψ =>
          have both : intSignature.node (.mdp φ _) children =
              mdpProof (children false) (children true) := by
            unfold mdpProof
            congr 1
            funext position
            cases position <;> rfl
          have computed : ofDeriv (toDeriv (mdpProof (children false) (children true))) =
              mdpProof (ofDeriv (toDeriv (children false))) (ofDeriv (toDeriv (children true))) :=
            rfl
          exact (congrArg (fun proof => ofDeriv (toDeriv proof)) both).trans
            (computed.trans ((congrArg₂ mdpProof (ih false) (ih true)).trans both.symm))

/-- **The derivations of the signature are the existing derivation trees.** -/
noncomputable def derivEquiv (φ : IntFormula) : IntDeriv [] φ ≃ IntProof φ where
  toFun := ofDeriv
  invFun := toDeriv
  left_inv := toDeriv_ofDeriv
  right_inv := ofDeriv_toDeriv

/-- **A formula has a derivation exactly when it is a theorem of Foundation's
intuitionistic logic.** -/
theorem nonempty_proof_iff_provable (φ : IntFormula) :
    Nonempty (IntProof φ) ↔ Propositional.Int ⊢ φ :=
  ⟨fun ⟨proof⟩ => IntDeriv.provable (toDeriv proof),
    fun provable => (IntDeriv.nonempty_of_provable provable).map ofDeriv⟩

/-! ## Two derivations of one formula -/

/-- The usual derivation of `φ ➝ φ`, from one instance of `S` and two of
`K`. -/
def identityProof (φ : IntFormula) : IntProof (φ ➝ φ) :=
  mdpProof (mdpProof (axiomProof (.implyS φ (φ ➝ φ) φ)) (axiomProof (.implyK φ (φ ➝ φ))))
    (axiomProof (.implyK φ φ))

/-- A longer derivation of `φ ➝ φ`: the same, with `K` used once to discard
a second copy. -/
def detourProof (φ : IntFormula) : IntProof (φ ➝ φ) :=
  mdpProof (mdpProof (axiomProof (.implyK (φ ➝ φ) (φ ➝ φ))) (identityProof φ)) (identityProof φ)

theorem size_axiomProof {φ : IntFormula} (instance' : IntAxiom φ) :
    RuleSignature.size intFinitary (axiomProof instance') = 1 := rfl

theorem size_mdpProof {φ ψ : IntFormula} (major : IntProof (φ ➝ ψ)) (minor : IntProof φ) :
    RuleSignature.size intFinitary (mdpProof major minor) =
      1 + (RuleSignature.size intFinitary major + (RuleSignature.size intFinitary minor + 0)) := rfl

theorem size_identityProof (φ : IntFormula) :
    RuleSignature.size intFinitary (identityProof φ) = 5 := by
  simp [identityProof, size_mdpProof, size_axiomProof]

theorem size_detourProof (φ : IntFormula) :
    RuleSignature.size intFinitary (detourProof φ) = 13 := by
  simp [detourProof, size_mdpProof, size_axiomProof, size_identityProof]

/-- **Two different derivations of one formula.** -/
theorem identityProof_ne_detourProof (φ : IntFormula) : identityProof φ ≠ detourProof φ := by
  intro same
  have sizes := congrArg (RuleSignature.size intFinitary) same
  rw [size_identityProof, size_detourProof] at sizes
  exact absurd sizes (by decide)

#print axioms derivEquiv
#print axioms nonempty_proof_iff_provable
#print axioms identityProof_ne_detourProof

end Mettapedia.Logic.HostingStyles
