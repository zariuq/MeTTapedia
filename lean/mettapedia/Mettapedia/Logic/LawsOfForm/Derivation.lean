import Mettapedia.Logic.LawsOfForm.Form

/-!
# Laws of Form: the Primary Algebra with proof-relevant derivations

Forms with atoms (`ACross`, `AForm`), the Boolean value observation `denote`
(juxtaposition is disjunction of markedness, a cross is negation), and the
equational theory generated by Spencer-Brown's two axioms

* J1 (position): `⟨⟨p⟩ p⟩ = void`
* J2 (transposition): `⟨⟨p r⟩⟨q r⟩⟩ = ⟨⟨p⟩⟨q⟩⟩ r`

as a **proof-relevant** inductive family `Deriv : AForm → AForm → Type`.
Soundness is proved: every derivation preserves the value under every
valuation.  The consequences C1–C9 are proved *semantically valid*; their
syntactic derivation from J1/J2 alone is not attempted here except for the
arithmetic crossing rule, which is J1 at the void.

The identity experiment: two distinct derivations of one equation are
exhibited, shown distinct as terms, shown to agree under the value
observation, and the endpoint quotient of derivations is proved lawful for the
value observation and unlawful for the step-count observation.  Route
erasure is admissible exactly where the declared observation is constant on
the erased fibre.
-/

namespace Mettapedia.Logic.LawsOfForm

/-- A cross with atoms: encloses a form, or names a variable. -/
inductive ACross where
  | cross (contents : List ACross)
  | atom (name : String)

/-- A form with atoms. -/
abbrev AForm := List ACross

/-! ## The value observation under a valuation -/

mutual
  def ACross.denote (v : String → Bool) : ACross → Bool
    | .cross contents => !(AForm.denoteList v contents)
    | .atom n => v n
  def AForm.denoteList (v : String → Bool) : List ACross → Bool
    | [] => false
    | c :: cs => c.denote v || AForm.denoteList v cs
end

@[simp] theorem denoteList_nil (v : String → Bool) : AForm.denoteList v [] = false := rfl
@[simp] theorem denoteList_cons (v : String → Bool) (c : ACross) (cs : List ACross) :
    AForm.denoteList v (c :: cs) = (c.denote v || AForm.denoteList v cs) := rfl
@[simp] theorem denote_cross (v : String → Bool) (contents : List ACross) :
    (ACross.cross contents).denote v = !(AForm.denoteList v contents) := rfl
@[simp] theorem denote_atom (v : String → Bool) (n : String) :
    (ACross.atom n).denote v = v n := rfl

theorem denoteList_append (v : String → Bool) (a b : List ACross) :
    AForm.denoteList v (a ++ b) = (AForm.denoteList v a || AForm.denoteList v b) := by
  induction a with
  | nil => simp
  | cons c cs ih => simp [ih, Bool.or_assoc]

theorem denoteList_perm (v : String → Bool) {a b : List ACross} (h : List.Perm a b) :
    AForm.denoteList v a = AForm.denoteList v b := by
  induction h with
  | nil => rfl
  | cons _ _ ih => simp [ih]
  | swap => simp [Bool.or_left_comm]
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-! ## Proof-relevant derivations -/

/-- Derivations of the Primary Algebra.  A `Type`-valued family: distinct
derivations of one equation are distinct objects. -/
inductive Deriv : AForm → AForm → Type where
  | refl (a : AForm) : Deriv a a
  | symm {a b : AForm} : Deriv a b → Deriv b a
  | trans {a b c : AForm} : Deriv a b → Deriv b c → Deriv a c
  | juxtCong {a a' b b' : AForm} : Deriv a a' → Deriv b b' → Deriv (a ++ b) (a' ++ b')
  | crossCong {a b : AForm} : Deriv a b → Deriv [.cross a] [.cross b]
  | perm {a b : AForm} : List.Perm a b → Deriv a b
  /-- J1, position. -/
  | j1 (p : AForm) : Deriv [.cross (.cross p :: p)] []
  /-- J2, transposition. -/
  | j2 (p q r : AForm) :
      Deriv [.cross [.cross (p ++ r), .cross (q ++ r)]] (.cross [.cross p, .cross q] :: r)

/-- The number of inference steps in a derivation. -/
def Deriv.size : {a b : AForm} → Deriv a b → Nat
  | _, _, .refl _ => 1
  | _, _, .symm d => d.size + 1
  | _, _, .trans d₁ d₂ => d₁.size + d₂.size + 1
  | _, _, .juxtCong d₁ d₂ => d₁.size + d₂.size + 1
  | _, _, .crossCong d => d.size + 1
  | _, _, .perm _ => 1
  | _, _, .j1 _ => 1
  | _, _, .j2 _ _ _ => 1

/-- **Soundness.**  Every derivation preserves the value under every valuation. -/
theorem Deriv.sound (v : String → Bool) :
    ∀ {a b : AForm}, Deriv a b → AForm.denoteList v a = AForm.denoteList v b
  | _, _, .refl _ => rfl
  | _, _, .symm d => (Deriv.sound v d).symm
  | _, _, .trans d₁ d₂ => (Deriv.sound v d₁).trans (Deriv.sound v d₂)
  | _, _, .juxtCong d₁ d₂ => by
      rw [denoteList_append, denoteList_append, Deriv.sound v d₁, Deriv.sound v d₂]
  | _, _, .crossCong d => by
      simp only [denoteList_cons, denote_cross, denoteList_nil, Bool.or_false]
      rw [Deriv.sound v d]
  | _, _, .perm h => denoteList_perm v h
  | _, _, .j1 p => by
      simp only [denoteList_cons, denote_cross, denoteList_nil, Bool.or_false]
      cases AForm.denoteList v p <;> rfl
  | _, _, .j2 p q r => by
      simp only [denoteList_cons, denote_cross, denoteList_nil, Bool.or_false, denoteList_append]
      cases AForm.denoteList v p <;> cases AForm.denoteList v q <;>
        cases AForm.denoteList v r <;> rfl

/-- The arithmetic crossing rule `⟨⟨ ⟩⟩ = void` is J1 at the void: a syntactic
derivation, not merely a semantic validity. -/
def crossingDerivation : Deriv [.cross [.cross []]] [] :=
  .j1 []

/-! ## C1–C9: semantic validity

Each consequence is proved valid under every valuation.  Their derivation from
J1 and J2 inside `Deriv` is not attempted in this module. -/

section Consequences
variable (v : String → Bool)

/-- C1 reflexion: `⟨⟨a⟩⟩ = a`. -/
theorem c1_reflexion (a : AForm) :
    AForm.denoteList v [.cross [.cross a]] = AForm.denoteList v a := by
  simp only [denoteList_cons, denote_cross, denoteList_nil, Bool.or_false]
  cases AForm.denoteList v a <;> rfl

/-- C2 generation: `⟨a b⟩ b = ⟨a⟩ b`. -/
theorem c2_generation (a b : AForm) :
    AForm.denoteList v (.cross (a ++ b) :: b) = AForm.denoteList v (.cross a :: b) := by
  simp only [denoteList_cons, denote_cross, denoteList_append]
  cases AForm.denoteList v a <;> cases AForm.denoteList v b <;> rfl

/-- C3 integration: `⟨ ⟩ a = ⟨ ⟩`. -/
theorem c3_integration (a : AForm) :
    AForm.denoteList v (.cross [] :: a) = AForm.denoteList v [.cross []] := by
  simp only [denoteList_cons, denote_cross, denoteList_nil, Bool.or_false]
  cases AForm.denoteList v a <;> rfl

/-- C4 occultation: `⟨⟨a⟩ b⟩ a = a`. -/
theorem c4_occultation (a b : AForm) :
    AForm.denoteList v (.cross (.cross a :: b) :: a) = AForm.denoteList v a := by
  simp only [denoteList_cons, denote_cross]
  cases AForm.denoteList v a <;> cases AForm.denoteList v b <;> rfl

/-- C5 iteration: `a a = a`. -/
theorem c5_iteration (a : AForm) :
    AForm.denoteList v (a ++ a) = AForm.denoteList v a := by
  rw [denoteList_append]
  cases AForm.denoteList v a <;> rfl

/-- C6 extension: `⟨⟨a⟩⟨b⟩⟩ ⟨⟨a⟩ b⟩ = a`. -/
theorem c6_extension (a b : AForm) :
    AForm.denoteList v [.cross [.cross a, .cross b], .cross (.cross a :: b)] =
      AForm.denoteList v a := by
  simp only [denoteList_cons, denote_cross, denoteList_nil, Bool.or_false]
  cases AForm.denoteList v a <;> cases AForm.denoteList v b <;> rfl

/-- C7 echelon: `⟨⟨⟨a⟩ b⟩ c⟩ = ⟨a c⟩ ⟨⟨b⟩ c⟩`. -/
theorem c7_echelon (a b c : AForm) :
    AForm.denoteList v [.cross (.cross (.cross a :: b) :: c)] =
      AForm.denoteList v [.cross (a ++ c), .cross (.cross b :: c)] := by
  simp only [denoteList_cons, denote_cross, denoteList_nil, Bool.or_false, denoteList_append]
  cases AForm.denoteList v a <;> cases AForm.denoteList v b <;>
    cases AForm.denoteList v c <;> rfl

/-- C8 modified transposition: `⟨⟨a⟩ ⟨b r⟩ ⟨c r⟩⟩ = ⟨⟨a⟩⟨b⟩⟨c⟩⟩ ⟨⟨a⟩ ⟨r⟩⟩`. -/
theorem c8_modified_transposition (a b c r : AForm) :
    AForm.denoteList v [.cross [.cross a, .cross (b ++ r), .cross (c ++ r)]] =
      AForm.denoteList v [.cross [.cross a, .cross b, .cross c], .cross [.cross a, .cross r]] := by
  simp only [denoteList_cons, denote_cross, denoteList_nil, Bool.or_false, denoteList_append]
  cases AForm.denoteList v a <;> cases AForm.denoteList v b <;>
    cases AForm.denoteList v c <;> cases AForm.denoteList v r <;> rfl

/-- C9 crosstransposition:
`⟨⟨⟨b⟩⟨r⟩⟩ ⟨⟨a⟩⟨r⟩⟩ ⟨⟨x⟩ r⟩ ⟨⟨y⟩ r⟩⟩ = ⟨⟨r⟩ a b⟩ ⟨r x y⟩`. -/
theorem c9_crosstransposition (a b r x y : AForm) :
    AForm.denoteList v
        [.cross [.cross [.cross b, .cross r], .cross [.cross a, .cross r],
          .cross (.cross x :: r), .cross (.cross y :: r)]] =
      AForm.denoteList v [.cross (.cross r :: (a ++ b)), .cross (r ++ x ++ y)] := by
  simp only [denoteList_cons, denote_cross, denoteList_nil, Bool.or_false, denoteList_append]
  cases AForm.denoteList v a <;> cases AForm.denoteList v b <;>
    cases AForm.denoteList v r <;> cases AForm.denoteList v x <;>
    cases AForm.denoteList v y <;> rfl

end Consequences

/-! ## The identity experiment: distinct routes, one observation -/

/-- Route 1: crossing directly by J1. -/
def crossingRouteDirect : Deriv [.cross [.cross []]] [] :=
  .j1 []

/-- Route 2: the same equation by J1 followed by a reflexive step. -/
def crossingRouteDetour : Deriv [.cross [.cross []]] [] :=
  .trans (.j1 []) (.refl [])

/-- Route 3: the same equation by reflecting twice. -/
def crossingRouteReflected : Deriv [.cross [.cross []]] [] :=
  .symm (.symm (.j1 []))

theorem crossingRouteDirect_size : crossingRouteDirect.size = 1 := rfl
theorem crossingRouteDetour_size : crossingRouteDetour.size = 3 := rfl
theorem crossingRouteReflected_size : crossingRouteReflected.size = 3 := rfl

/-- The routes are distinct derivations. -/
theorem crossingRoutes_distinct : crossingRouteDirect ≠ crossingRouteDetour := by
  intro h
  have := congrArg Deriv.size h
  rw [crossingRouteDirect_size, crossingRouteDetour_size] at this
  exact absurd this (by decide)

/-- An observation of derivations. -/
abbrev RouteObservation (α : Type) := ∀ {a b : AForm}, Deriv a b → α

/-- An observation is lawful for the endpoint quotient when it is constant on
every fibre of derivations with the same endpoints. -/
def EndpointLawful {α : Type} (observe : RouteObservation α) : Prop :=
  ∀ {a b : AForm} (d₁ d₂ : Deriv a b), observe d₁ = observe d₂

/-- The value observation of a derivation: the values of its endpoints. -/
def denoteObservation (v : String → Bool) : RouteObservation (Bool × Bool) :=
  fun {a b} _ => (AForm.denoteList v a, AForm.denoteList v b)

/-- The step-count observation. -/
def sizeObservation : RouteObservation Nat :=
  fun d => d.size

/-- Under the value observation, erasing the route is lawful. -/
theorem denoteObservation_lawful (v : String → Bool) :
    EndpointLawful (denoteObservation v) :=
  fun _ _ => rfl

/-- And the observation is sound on every route: both endpoints have one value. -/
theorem denoteObservation_sound (v : String → Bool) {a b : AForm} (d : Deriv a b) :
    (denoteObservation v d).1 = (denoteObservation v d).2 :=
  Deriv.sound v d

/-- The two routes agree under the value observation. -/
theorem crossingRoutes_agree_on_value (v : String → Bool) :
    denoteObservation v crossingRouteDirect = denoteObservation v crossingRouteDetour :=
  rfl

/-- Under the step-count observation, erasing the route is **unlawful**: the
quotient would identify derivations the observation distinguishes. -/
theorem sizeObservation_unlawful : ¬ EndpointLawful sizeObservation := by
  intro h
  have := h crossingRouteDirect crossingRouteDetour
  simp only [sizeObservation, crossingRouteDirect_size, crossingRouteDetour_size] at this
  exact absurd this (by decide)

/-- The endpoint quotient of derivations: routes erased. -/
def RouteQuotient (a b : AForm) : Type :=
  Quot (fun (_ _ : Deriv a b) => True)

/-- The value observation descends to the quotient. -/
def denoteOnRoutes (v : String → Bool) {a b : AForm} : RouteQuotient a b → Bool × Bool :=
  Quot.lift (denoteObservation v) (fun _ _ _ => rfl)

theorem denoteOnRoutes_mk (v : String → Bool) {a b : AForm} (d : Deriv a b) :
    denoteOnRoutes v (Quot.mk _ d) = denoteObservation v d :=
  rfl

/-- The step count does **not** descend: no function on the quotient recovers
it, because the quotient identified the two routes. -/
theorem no_size_on_routes :
    ¬ ∃ f : RouteQuotient [.cross [.cross []]] [] → Nat,
      ∀ d : Deriv [.cross [.cross []]] [], f (Quot.mk _ d) = d.size := by
  rintro ⟨f, hf⟩
  have h₁ := hf crossingRouteDirect
  have h₂ := hf crossingRouteDetour
  have same : (Quot.mk _ crossingRouteDirect : RouteQuotient _ _) = Quot.mk _ crossingRouteDetour :=
    Quot.sound trivial
  rw [same, h₂, crossingRouteDetour_size, crossingRouteDirect_size] at h₁
  exact absurd h₁ (by decide)

#print axioms Deriv.sound
#print axioms c1_reflexion
#print axioms c9_crosstransposition
#print axioms crossingRoutes_distinct
#print axioms denoteObservation_lawful
#print axioms sizeObservation_unlawful
#print axioms no_size_on_routes

end Mettapedia.Logic.LawsOfForm
