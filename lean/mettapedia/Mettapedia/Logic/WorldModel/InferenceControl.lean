import Mettapedia.GSLT.Core.InferenceControl
import Mettapedia.Logic.WorldModel.CompressionTransfer

/-!
# Algorithmic-memory guidance as inference control

A guided algorithmic memory supplies priorities, not proof authority.  This
file turns the guide of a one-machine program memory into an
occurrence-preserving GSLT scheduler.  The branching system continues to
authorize successors and emissions; the guide only orders the live frontier.

Consequently every guided finite run is sound, and any guided and unguided
runs which both exhaust their frontiers have the same additive answer bag.
Hard top-k truncation is deliberately outside this adapter: deleting a live
occurrence is not a permutation and therefore needs a separate certified
pruning argument.
-/

namespace Mettapedia.Logic.WorldModel.InferenceControl

open KolmogorovComplexity
open Mettapedia.CognitiveArchitecture.GuidedAlgorithmicMemory
open Mettapedia.GSLT.Core.BranchingTemporal
open Mettapedia.GSLT.Core.InferenceControl
open Mettapedia.Logic.WorldModel.CompressionTransfer

/-- Interpret the program guide of a one-machine memory as a refinement of an
existing scheduler.  Sorting changes only occurrence order; integration and
multiplicity remain those of `base`. -/
def guidedScheduler
    {U : ConditionalAlgorithm} {Priority : Type*}
    (memory : GuidedMemory (compressionReferenceMachineFamily U) Priority)
    (prefer : Priority → Priority → Bool)
    (base : Scheduler BinString) : Scheduler BinString where
  reorder frontier :=
    List.insertionSort
      (fun first second =>
        prefer (memory.guide () first) (memory.guide () second) = true)
      (base.reorder frontier)
  reorder_complete frontier :=
    (List.perm_insertionSort _ (base.reorder frontier)).trans
      (base.reorder_complete frontier)
  integrate := base.integrate
  integrate_complete := base.integrate_complete

/-- The corresponding GSLT controller has no extra mutable state.  Updating a
learned memory creates a new controller; it does not alter the inference
system. -/
def guidedController
    {U : ConditionalAlgorithm} {Priority Answer : Type*}
    (memory : GuidedMemory (compressionReferenceMachineFamily U) Priority)
    (prefer : Priority → Priority → Bool)
    (base : Scheduler BinString) : Controller BinString Answer Unit :=
  Controller.fixed (guidedScheduler memory prefer base)

/-- Guidance neither creates nor removes a live candidate occurrence. -/
theorem mem_guidedScheduler_reorder_iff
    {U : ConditionalAlgorithm} {Priority : Type*}
    (memory : GuidedMemory (compressionReferenceMachineFamily U) Priority)
    (prefer : Priority → Priority → Bool)
    (base : Scheduler BinString) {frontier : List BinString} {program : BinString} :
    program ∈ (guidedScheduler memory prefer base).reorder frontier ↔
      program ∈ frontier :=
  Scheduler.mem_reorder_iff (guidedScheduler memory prefer base)

/-- Every answer and live program in a guided run is generated by the original
branching system and roots.  A score is never accepted as an inference. -/
theorem guided_run_sound
    {U : ConditionalAlgorithm} {Priority Answer : Type*}
    (memory : GuidedMemory (compressionReferenceMachineFamily U) Priority)
    (prefer : Priority → Priority → Bool)
    (base : Scheduler BinString)
    (system : BranchingSystem BinString Answer)
    (roots : List BinString) (fuel : Nat) :
    (Snapshot.run system (guidedController memory prefer base) fuel
      (Snapshot.initial (guidedController memory prefer base) roots)).search.Sound
        system roots := by
  exact Snapshot.sound_run system (guidedController memory prefer base)
    (initial_sound system roots) fuel

/-- If guided and base runs both finish, their additive answer bags agree.
Guidance may change first-answer time and stream order, but not exhaustive
semantics. -/
theorem guided_completed_bag_eq_base
    {U : ConditionalAlgorithm} {Priority Answer : Type*}
    (memory : GuidedMemory (compressionReferenceMachineFamily U) Priority)
    (prefer : Priority → Priority → Bool)
    (base : Scheduler BinString)
    (system : BranchingSystem BinString Answer)
    (denotation : AdditiveDenotation system)
    (roots : List BinString) (guidedFuel baseFuel : Nat)
    (guidedComplete :
      (Snapshot.run system (guidedController memory prefer base) guidedFuel
        (Snapshot.initial (guidedController memory prefer base) roots)).search.frontier = [])
    (baseComplete :
      (Snapshot.run system (Controller.fixed base) baseFuel
        (Snapshot.initial (Controller.fixed base) roots)).search.frontier = []) :
    eventBag
        (Snapshot.run system (guidedController memory prefer base) guidedFuel
          (Snapshot.initial (guidedController memory prefer base) roots)).search.events =
      eventBag
        (Snapshot.run system (Controller.fixed base) baseFuel
          (Snapshot.initial (Controller.fixed base) roots)).search.events := by
  exact Snapshot.completed_controllers_bag_agree system
    (guidedController memory prefer base) (Controller.fixed base)
    denotation roots guidedFuel baseFuel guidedComplete baseComplete

/-- No lawful occurrence-preserving scheduler can implement top-one truncation
on a two-occurrence frontier.  Pruning is a different authority boundary from
ranking. -/
theorem no_scheduler_reorders_two_occurrences_to_one
    {Node : Type*} (first second : Node) :
    ¬ ∃ scheduler : Scheduler Node,
      scheduler.reorder [first, second] = [first] := by
  rintro ⟨scheduler, truncates⟩
  have sameLength := (scheduler.reorder_complete [first, second]).length_eq
  rw [truncates] at sameLength
  simp at sameLength

/-! ## Executable guide-change control -/

/-- Larger natural priorities are selected first. -/
def preferLargerNat (first second : Nat) : Bool :=
  decide (second ≤ first)

/-- Before the retained guide update, tied priorities leave this frontier in
base order. -/
theorem literalGuideBefore_keeps_candidate_order :
    (guidedScheduler literalGuideBefore preferLargerNat
      Scheduler.breadthFirst).reorder [[true], []] = [[true], []] := by
  decide

/-- After the genuine guide-learning update, the promoted empty program moves
to the head while both candidates remain present. -/
theorem literalGuideAfter_promotes_empty_program :
    (guidedScheduler literalGuideAfter preferLargerNat
      Scheduler.breadthFirst).reorder [[true], []] = [[], [true]] := by
  decide

/-- The guide-learning witness has a visible scheduling effect on a concrete
frontier, without obtaining authority to discard either occurrence. -/
theorem literalGuideLearning_changes_selected_candidate :
    selected
        (guidedScheduler literalGuideBefore preferLargerNat Scheduler.breadthFirst)
        [[true], []] = some [true] ∧
      selected
        (guidedScheduler literalGuideAfter preferLargerNat Scheduler.breadthFirst)
        [[true], []] = some [] := by
  decide

