import Mettapedia.Logic.LinearLogic.KnowledgeTensorZoned

/-!
# The proof calculi are freely generated, and runs are the initial model

A model of the two-zone calculus is a relation on sequents that holds the declared transitions
and is closed under identity, cut, the frame rule of the linear zone and the frame rule of the
knowledge zone. The proofs are the least model by construction; the runs are a model, and they
are the least one. So the calculus is freely generated by the declarations under composition and
under the two actions: adding atoms, and refining knowledge.

For the whole calculus the same holds with grades: a model is closed under identity, the rule
leaf, widening, lending, strengthening, cut and restriction of the grade. "Running under every
extra context the grade admits" is a model, so every graded proof maps into it.

These statements are about provability, so the models are relations: they do not distinguish
two proofs of one sequent.

## Results

* `System.derives_iff_every_model`, `System.run_iff_every_model`: a sequent has a proof, or a
  run, exactly when it holds in every model.
* `System.Run.model`: the runs are a model.
* `ZonedSystem.Proves.initial`: the graded proofs map into every graded model.
* `ZonedSystem.runsUnder_model`: runs under every admitted extra context are a graded model.
-/

set_option autoImplicit false

namespace Mettapedia.Logic.LinearLogic.KnowledgeTensor

open _root_.CategoryTheory

universe uK uAtom uRule uF uH

namespace System

variable {K : Type uK} {Atom : Type uAtom} {Rule : Type uRule} [SemilatticeInf K]
  (sys : System K Atom Rule)

/-- A model of the two-zone calculus: a relation on sequents closed under its five rules. -/
structure Model (holds : K → Multiset Atom → List Rule → K → Multiset Atom → Prop) : Prop where
  identity : ∀ (k : K) (Γ : Multiset Atom), holds k Γ [] k Γ
  rule : ∀ (declaration : Rule) (k : K), sys.guard declaration (k ⊓ sys.tell declaration) →
    holds k (sys.premises declaration) [declaration] (k ⊓ sys.tell declaration)
      (sys.conclusions declaration)
  frame : ∀ {k k' : K} {Γ Γ' : Multiset Atom} {uses : List Rule} (extra : Multiset Atom),
    holds k Γ uses k' Γ' → holds k (Γ + extra) uses k' (Γ' + extra)
  strengthen : ∀ {k k' : K} {Γ Γ' : Multiset Atom} {uses : List Rule} (more : K),
    holds k Γ uses k' Γ' → holds (k ⊓ more) Γ uses (k' ⊓ more) Γ'
  cut : ∀ {k k₁ k' : K} {Γ Γ₁ Γ' : Multiset Atom} {first second : List Rule},
    holds k Γ first k₁ Γ₁ → holds k₁ Γ₁ second k' Γ' → holds k Γ (first ++ second) k' Γ'

variable {sys}

/-- The proofs are a model. -/
theorem Derives.model : sys.Model sys.Derives where
  identity := Derives.identity
  rule := Derives.rule
  frame := Derives.frame
  strengthen := Derives.strengthen
  cut := Derives.cut

/-- **The proofs are the initial model.** -/
theorem Derives.initial {holds : K → Multiset Atom → List Rule → K → Multiset Atom → Prop}
    (model : sys.Model holds) {k k' : K} {Γ Γ' : Multiset Atom} {uses : List Rule}
    (proof : sys.Derives k Γ uses k' Γ') : holds k Γ uses k' Γ' := by
  induction proof with
  | identity k Γ => exact model.identity k Γ
  | rule declaration k asked => exact model.rule declaration k asked
  | frame extra _ ih => exact model.frame extra ih
  | strengthen more _ ih => exact model.strengthen more ih
  | cut _ _ ihFirst ihSecond => exact model.cut ihFirst ihSecond

/-- **The runs are a model.** -/
theorem Run.model : sys.Model sys.Run where
  identity := Run.done
  rule := fun declaration k asked => Derives.run (Derives.rule declaration k asked)
  frame := fun extra run => Run.frame extra run
  strengthen := fun more run => Run.strengthen more run
  cut := fun one two => Run.append one two

/-- **The runs are the initial model.** -/
theorem Run.initial {holds : K → Multiset Atom → List Rule → K → Multiset Atom → Prop}
    (model : sys.Model holds) {k k' : K} {Γ Γ' : Multiset Atom} {uses : List Rule}
    (run : sys.Run k Γ uses k' Γ') : holds k Γ uses k' Γ' :=
  Derives.initial model (Run.derives run)

/-- Control: the full relation is a model, and it is not the least one in general. Holding in
one model says nothing; holding in every model is provability. -/
theorem full_model : sys.Model (fun _ _ _ _ _ => True) where
  identity := fun _ _ => trivial
  rule := fun _ _ _ => trivial
  frame := fun _ _ => trivial
  strengthen := fun _ _ => trivial
  cut := fun _ _ => trivial

/-- Control: the empty relation is not a model. -/
theorem empty_not_model [Inhabited K] : ¬ sys.Model (fun _ _ _ _ _ => False) :=
  fun model => model.identity default 0

/-- **The tensor is derived, not generated.** In every model in which knowledge only refines, two
sequents from one knowledge compose side by side: the rule is a consequence of the two frame
rules and cut. -/
theorem Model.tensor {holds : K → Multiset Atom → List Rule → K → Multiset Atom → Prop}
    (model : sys.Model holds)
    (refines : ∀ {k k' : K} {Γ Γ' : Multiset Atom} {uses : List Rule},
      holds k Γ uses k' Γ' → k' ≤ k)
    {k k₁ k₂ : K} {Γ Γ' Δ Δ' : Multiset Atom} {first second : List Rule}
    (one : holds k Γ first k₁ Γ') (two : holds k Δ second k₂ Δ') :
    holds k (Γ + Δ) (first ++ second) (k₁ ⊓ k₂) (Γ' + Δ') := by
  have later := model.frame Γ' (model.strengthen k₁ two)
  rw [inf_eq_right.mpr (refines one), add_comm Δ Γ', add_comm Δ' Γ', inf_comm k₂ k₁] at later
  exact model.cut (model.frame Δ one) later

/-- A sequent has a proof exactly when it holds in every model. -/
theorem derives_iff_every_model (k k' : K) (Γ Γ' : Multiset Atom) (uses : List Rule) :
    sys.Derives k Γ uses k' Γ' ↔
      ∀ holds : K → Multiset Atom → List Rule → K → Multiset Atom → Prop,
        sys.Model holds → holds k Γ uses k' Γ' :=
  ⟨fun proof _ model => Derives.initial model proof, fun every => every _ Derives.model⟩

/-- **A word runs between two states exactly when its sequent holds in every model.** -/
theorem run_iff_every_model (k k' : K) (Γ Γ' : Multiset Atom) (uses : List Rule) :
    sys.Run k Γ uses k' Γ' ↔
      ∀ holds : K → Multiset Atom → List Rule → K → Multiset Atom → Prop,
        sys.Model holds → holds k Γ uses k' Γ' :=
  ⟨fun run _ model => Run.initial model run, fun every => every _ Run.model⟩

end System

namespace ZonedSystem

open IndexedSystem

variable {Frame : Type uF} [Category.{uH} Frame] {K : Frame → Type uK} [∀ a, SemilatticeInf (K a)]
  {Atom : Frame → Type uAtom} {Rule : Frame → Type uRule} (sys : ZonedSystem Frame K Atom Rule)

/-- A model of the whole calculus: a relation on graded sequents over frame maps, closed under
its seven rules. -/
structure Model (holds : (a : Frame) → Multiset (Atom a) → K a → Multiset (Atom a) →
    (Multiset (Atom a) → Prop) → List (Sigma Rule) → (b : Frame) → (a ⟶ b) → K b →
    Multiset (Atom b) → Prop) : Prop where
  identity : ∀ (a : Frame) (lent : Multiset (Atom a)) (k : K a) (Γ : Multiset (Atom a)),
    holds a lent k Γ (fun _ => True) [] a (𝟙 a) k Γ
  rule : ∀ {a : Frame} (declaration : Rule a) (k : K a),
    sys.guard declaration (sys.know (sys.extend declaration) k ⊓ sys.tell declaration) →
    holds a (sys.read declaration) k (sys.take declaration)
      (fun extra => sys.check declaration
        (sys.know (sys.extend declaration) k ⊓ sys.tell declaration) (sys.read declaration + extra))
      [⟨a, declaration⟩] (sys.target declaration) (sys.extend declaration)
      (sys.know (sys.extend declaration) k ⊓ sys.tell declaration) (sys.make declaration)
  widen : ∀ {a b : Frame} {lent : Multiset (Atom a)} {k : K a} {Γ : Multiset (Atom a)}
    {grade : Multiset (Atom a) → Prop} {uses : List (Sigma Rule)} {along : a ⟶ b} {k' : K b}
    {Γ' : Multiset (Atom b)} (more : Multiset (Atom a)),
    holds a lent k Γ grade uses b along k' Γ' →
      holds a (lent + more) k Γ (fun extra => grade (more + extra)) uses b along k' Γ'
  lend : ∀ {a b : Frame} {lent : Multiset (Atom a)} {k : K a} {Γ : Multiset (Atom a)}
    {grade : Multiset (Atom a) → Prop} {uses : List (Sigma Rule)} {along : a ⟶ b} {k' : K b}
    {Γ' : Multiset (Atom b)} (borrowed : Multiset (Atom a)),
    holds a (lent + borrowed) k Γ grade uses b along k' Γ' →
      holds a lent k (Γ + borrowed) grade uses b along k' (Γ' + sys.carried along borrowed)
  strengthen : ∀ {a b : Frame} {lent : Multiset (Atom a)} {k : K a} {Γ : Multiset (Atom a)}
    {grade : Multiset (Atom a) → Prop} {uses : List (Sigma Rule)} {along : a ⟶ b} {k' : K b}
    {Γ' : Multiset (Atom b)} (more : K a),
    holds a lent k Γ grade uses b along k' Γ' →
      holds a lent (k ⊓ more) Γ grade uses b along (k' ⊓ sys.know along more) Γ'
  cut : ∀ {a b c : Frame} {lent : Multiset (Atom a)} {k : K a} {Γ : Multiset (Atom a)}
    {early : Multiset (Atom a) → Prop} {first second : List (Sigma Rule)} {along : a ⟶ b}
    {k₁ : K b} {Γ₁ : Multiset (Atom b)} {late : Multiset (Atom b) → Prop} {onward : b ⟶ c}
    {k' : K c} {Γ' : Multiset (Atom c)},
    holds a lent k Γ early first b along k₁ Γ₁ →
    holds b (sys.carried along lent) k₁ Γ₁ late second c onward k' Γ' →
      holds a lent k Γ (fun extra => early extra ∧ late (sys.carried along extra))
        (first ++ second) c (along ≫ onward) k' Γ'
  restrict : ∀ {a b : Frame} {lent : Multiset (Atom a)} {k : K a} {Γ : Multiset (Atom a)}
    {grade stricter : Multiset (Atom a) → Prop} {uses : List (Sigma Rule)} {along : a ⟶ b}
    {k' : K b} {Γ' : Multiset (Atom b)}, (∀ extra, stricter extra → grade extra) →
    holds a lent k Γ grade uses b along k' Γ' → holds a lent k Γ stricter uses b along k' Γ'

variable {sys}

/-- The graded proofs are a model. -/
theorem Proves.model : sys.Model sys.Proves where
  identity := Proves.identity
  rule := Proves.rule
  widen := Proves.widen
  lend := Proves.lend
  strengthen := Proves.strengthen
  cut := Proves.cut
  restrict := Proves.restrict

/-- **The graded proofs are the initial model.** -/
theorem Proves.initial {holds : (a : Frame) → Multiset (Atom a) → K a → Multiset (Atom a) →
      (Multiset (Atom a) → Prop) → List (Sigma Rule) → (b : Frame) → (a ⟶ b) → K b →
      Multiset (Atom b) → Prop} (model : sys.Model holds)
    {a b : Frame} {lent : Multiset (Atom a)} {k : K a} {Γ : Multiset (Atom a)}
    {grade : Multiset (Atom a) → Prop} {uses : List (Sigma Rule)} {along : a ⟶ b} {k' : K b}
    {Γ' : Multiset (Atom b)} (proof : sys.Proves a lent k Γ grade uses b along k' Γ') :
    holds a lent k Γ grade uses b along k' Γ' := by
  induction proof with
  | identity a lent k Γ => exact model.identity a lent k Γ
  | rule declaration k asked => exact model.rule declaration k asked
  | widen more _ ih => exact model.widen more ih
  | lend borrowed _ ih => exact model.lend borrowed ih
  | strengthen more _ ih => exact model.strengthen more ih
  | cut _ _ ihFirst ihSecond => exact model.cut ihFirst ihSecond
  | restrict implies _ ih => exact model.restrict implies ih

/-- **Running under every admitted extra context is a model**: the frame law relative to the
grade, rule by rule. -/
theorem runsUnder_model : sys.Model
    (fun a lent k Γ grade uses b along k' Γ' =>
      ∀ extra : Multiset (Atom a), grade extra →
        sys.RunUnder a (lent + extra) k Γ uses b along k' Γ') where
  identity := fun a lent k Γ extra _ => RunUnder.done a (lent + extra) k Γ
  rule := fun declaration k asked extra graded =>
    Proves.run (Proves.rule declaration k asked) extra graded
  widen := fun more ih extra graded => by
    simpa only [add_assoc] using ih (more + extra) graded
  lend := fun {_ _ lent _ _ _ _ _ _ _} borrowed ih extra graded =>
    RunUnder.lend (ih extra graded) (lent + extra) borrowed (add_right_comm lent borrowed extra)
  strengthen := fun more ih extra graded => RunUnder.strengthen (ih extra graded) more
  cut := fun ihFirst ihSecond extra graded => by
    have late := ihSecond _ graded.2
    rw [← carried_add] at late
    exact RunUnder.append (ihFirst extra graded.1) late
  restrict := fun implies ih extra graded => ih extra (implies extra graded)

/-- **Knowledge only refines along a run under a lent context**: the final knowledge refines the
initial knowledge, transported along the run. -/
theorem RunUnder.refines {a b : Frame} {lent : Multiset (Atom a)} {k : K a}
    {Γ : Multiset (Atom a)} {uses : List (Sigma Rule)} {along : a ⟶ b} {k' : K b}
    {Γ' : Multiset (Atom b)} (run : sys.RunUnder a lent k Γ uses b along k' Γ') :
    k' ≤ sys.know along k := by
  induction run with
  | done a lent k Γ => exact le_of_eq (sys.know_id k).symm
  | fire fires later ih =>
      obtain ⟨_, _, _, _, _, knowledge, _⟩ := fires
      rw [sys.know_comp]
      refine ih.trans (know_mono _ ?_)
      rw [knowledge]
      exact inf_le_left

/-- A run of a word that begins with a use begins with a firing of that use, at the frame of the
run, and continues with a run of the rest under the carried lent context. -/
theorem RunUnder.cons_inv {a b : Frame} {lent : Multiset (Atom a)} {k : K a}
    {Γ : Multiset (Atom a)} {use : Sigma Rule} {rest : List (Sigma Rule)} {along : a ⟶ b}
    {k' : K b} {Γ' : Multiset (Atom b)}
    (run : sys.RunUnder a lent k Γ (use :: rest) b along k' Γ') :
    ∃ (declaration : Rule a) (k₁ : K (sys.target declaration))
      (Γ₁ : Multiset (Atom (sys.target declaration))) (onward : sys.target declaration ⟶ b),
      use = ⟨a, declaration⟩ ∧ along = sys.extend declaration ≫ onward ∧
        sys.FiresUnder lent declaration k Γ k₁ Γ₁ ∧
        sys.RunUnder (sys.target declaration) (sys.carried (sys.extend declaration) lent) k₁ Γ₁
          rest b onward k' Γ' := by
  cases run with
  | fire fires later => exact ⟨_, _, _, _, rfl, rfl, fires, later⟩

/-- A graded sequent has a proof exactly when it holds in every model. -/
theorem proves_iff_every_model {a b : Frame} (lent : Multiset (Atom a)) (k : K a)
    (Γ : Multiset (Atom a)) (grade : Multiset (Atom a) → Prop) (uses : List (Sigma Rule))
    (along : a ⟶ b) (k' : K b) (Γ' : Multiset (Atom b)) :
    sys.Proves a lent k Γ grade uses b along k' Γ' ↔
      ∀ holds : (a : Frame) → Multiset (Atom a) → K a → Multiset (Atom a) →
          (Multiset (Atom a) → Prop) → List (Sigma Rule) → (b : Frame) → (a ⟶ b) → K b →
          Multiset (Atom b) → Prop,
        sys.Model holds → holds a lent k Γ grade uses b along k' Γ' :=
  ⟨fun proof _ model => Proves.initial model proof, fun every => every _ Proves.model⟩

end ZonedSystem

end Mettapedia.Logic.LinearLogic.KnowledgeTensor
