import Std

/-!
# Predicate types generated by ranked-tree rules

Symbols have fixed arities. Grammar states are types; a production assigns one
state to each constructor field. States need not be finite: they may include
instantiated parametric types. Each state/symbol pair has finitely many rules.
Without a finite-state hypothesis this is not a finite tree automaton, and its
languages need not be regular.
The executable recognizer is proved equivalent to independent derivation rules.
-/

set_option autoImplicit false

namespace Mettapedia.Logic.ConstraintTypes

universe u v

inductive Tree (Symbol : Type u) (arity : Symbol → Nat) where
  | node (symbol : Symbol) (children : Fin (arity symbol) → Tree Symbol arity)

structure Grammar (State : Type v) (Symbol : Type u) (arity : Symbol → Nat) where
  productions : State → (symbol : Symbol) → List (Fin (arity symbol) → State)

variable {State : Type v} {Symbol : Type u} {arity : Symbol → Nat}

namespace Grammar

inductive Derives (g : Grammar State Symbol arity) : State → Tree Symbol arity → Prop where
  | node {q : State} {s : Symbol} {children : Fin (arity s) → Tree Symbol arity}
      (fields : Fin (arity s) → State)
      (rule : fields ∈ g.productions q s)
      (typed : ∀ i, Derives g (fields i) (children i)) :
      Derives g q (.node s children)

def accepts (g : Grammar State Symbol arity) : Tree Symbol arity → State → Bool
  | .node s children, q =>
      (g.productions q s).any fun fields =>
        (List.finRange (arity s)).all fun i => accepts g (children i) (fields i)

theorem accepts_iff_derives (g : Grammar State Symbol arity)
    (t : Tree Symbol arity) (q : State) :
    g.accepts t q = true ↔ g.Derives q t := by
  induction t generalizing q with
  | node s children ih =>
      simp only [accepts, List.any_eq_true, List.all_eq_true]
      constructor
      · rintro ⟨fields, hr, hc⟩
        exact .node fields hr (fun i => (ih i _).1 (hc i (List.mem_finRange i)))
      · intro h
        cases h with
        | node fields hr hc =>
            exact ⟨fields, hr, fun i _ => (ih i _).2 (hc i)⟩

/-- An indexing or compilation pass may change rule representation, but not the
set of productions for any state and constructor. -/
theorem accepts_congr (g h : Grammar State Symbol arity)
    (same : ∀ q s fields, fields ∈ g.productions q s ↔ fields ∈ h.productions q s)
    (t : Tree Symbol arity) (q : State) : g.accepts t q = h.accepts t q := by
  have derivation : ∀ {t q}, g.Derives q t → h.Derives q t := by
    intro t q ht
    induction ht with
    | node fields hr _ ih => exact .node fields ((same _ _ _).1 hr) ih
  have converse : ∀ {t q}, h.Derives q t → g.Derives q t := by
    intro t q ht
    induction ht with
    | node fields hr _ ih => exact .node fields ((same _ _ _).2 hr) ih
  cases hg : g.accepts t q <;> cases hh : h.accepts t q <;> try rfl
  · exact False.elim (Bool.false_ne_true (hg.symm.trans
      ((g.accepts_iff_derives t q).2 (converse ((h.accepts_iff_derives t q).1 hh)))))
  · exact False.elim (Bool.false_ne_true (hh.symm.trans
      ((h.accepts_iff_derives t q).2 (derivation ((g.accepts_iff_derives t q).1 hg)))))

/-- Constructor-field evidence follows from a derivation, not from an arbitrary
nominal annotation on the entire value. -/
theorem derives_node_iff (g : Grammar State Symbol arity) (q : State) (s : Symbol)
    (children : Fin (arity s) → Tree Symbol arity) :
    g.Derives q (.node s children) ↔
      ∃ fields ∈ g.productions q s, ∀ i, g.Derives (fields i) (children i) := by
  constructor
  · intro h
    cases h with | node fields hr hc => exact ⟨fields, hr, hc⟩
  · rintro ⟨fields, hr, hc⟩
    exact .node fields hr hc

end Grammar

namespace Grammar

variable {OtherState : Type}

/-- Product construction for the intersection of constructor languages. -/
def intersection (left : Grammar State Symbol arity) (right : Grammar OtherState Symbol arity) :
    Grammar (State × OtherState) Symbol arity where
  productions state symbol := (left.productions state.1 symbol).flatMap fun ls =>
    (right.productions state.2 symbol).map fun rs => fun i => (ls i, rs i)

theorem intersection_rule (left : Grammar State Symbol arity)
    (right : Grammar OtherState Symbol arity) (q : State) (r : OtherState) (s : Symbol)
    (fields : Fin (arity s) → State × OtherState) :
    fields ∈ (left.intersection right).productions (q, r) s ↔
      ∃ ls ∈ left.productions q s, ∃ rs ∈ right.productions r s,
        (fun i => (ls i, rs i)) = fields := by
  simp [intersection]

/-- Intersection is an exact grammar construction, including recursive types. -/
theorem intersection_derives (left : Grammar State Symbol arity)
    (right : Grammar OtherState Symbol arity) (tree : Tree Symbol arity)
    (q : State) (r : OtherState) :
    (left.intersection right).Derives (q, r) tree ↔
      left.Derives q tree ∧ right.Derives r tree := by
  induction tree generalizing q r with
  | node s children ih =>
      constructor
      · intro h
        obtain ⟨fields, rule, typed⟩ := (derives_node_iff _ _ _ _).1 h
        obtain ⟨ls, hl, rs, hr, rfl⟩ := (intersection_rule _ _ _ _ _ _).1 rule
        exact ⟨.node ls hl (fun i => ((ih i _ _).1 (typed i)).1),
          .node rs hr (fun i => ((ih i _ _).1 (typed i)).2)⟩
      · rintro ⟨hl, hr⟩
        obtain ⟨ls, hls, hcl⟩ := (derives_node_iff _ _ _ _).1 hl
        obtain ⟨rs, hrs, hcr⟩ := (derives_node_iff _ _ _ _).1 hr
        exact .node (fun i => (ls i, rs i))
          ((intersection_rule _ _ _ _ _ _).2 ⟨ls, hls, rs, hrs, rfl⟩)
          (fun i => (ih i _ _).2 ⟨hcl i, hcr i⟩)

theorem intersection_accepts (left : Grammar State Symbol arity)
    (right : Grammar OtherState Symbol arity) (tree : Tree Symbol arity)
    (q : State) (r : OtherState) :
    (left.intersection right).accepts tree (q, r) =
      (left.accepts tree q && right.accepts tree r) := by
  have same : (left.intersection right).accepts tree (q, r) = true ↔
      (left.accepts tree q && right.accepts tree r) = true := by
    simp only [accepts_iff_derives, intersection_derives, Bool.and_eq_true]
  cases h₁ : (left.intersection right).accepts tree (q, r) <;>
    cases h₂ : left.accepts tree q && right.accepts tree r <;> simp_all

/-- Adding constructor productions cannot remove members from a type. -/
theorem derives_mono (before after : Grammar State Symbol arity)
    (added : ∀ q s fields, fields ∈ before.productions q s → fields ∈ after.productions q s)
    {q : State} {tree : Tree Symbol arity} (h : before.Derives q tree) : after.Derives q tree := by
  induction h with
  | node fields rule _ ih => exact .node fields (added _ _ _ rule) ih

def Productive (grammar : Grammar State Symbol arity) (q : State) : Prop :=
  ∃ tree, grammar.Derives q tree

def ProductionClosed (grammar : Grammar State Symbol arity) (states : State → Prop) : Prop :=
  ∀ q s fields, fields ∈ grammar.productions q s → (∀ i, states (fields i)) → states q

/-- Productive states form a closed set of productions. This is a semantic
fixed-point characterization and does not assume finite state universes. -/
theorem productive_closed (grammar : Grammar State Symbol arity) :
    grammar.ProductionClosed grammar.Productive := by
  classical
  intro q s fields rule children
  exact ⟨.node s (fun i => Classical.choose (children i)),
    .node fields rule (fun i => Classical.choose_spec (children i))⟩

theorem productive_least (grammar : Grammar State Symbol arity) (states : State → Prop)
    (closed : grammar.ProductionClosed states) :
    ∀ q, grammar.Productive q → states q := by
  intro q ⟨tree, h⟩
  induction h with
  | node fields rule _ ih => exact closed _ _ fields rule ih

/-- Exact emptiness characterization by closed supersets. A finite certified
saturation can instantiate this without enumerating inhabitant trees. -/
theorem unproductive_iff_closed_exclusion (grammar : Grammar State Symbol arity) (q : State) :
    ¬ grammar.Productive q ↔ ∃ states, grammar.ProductionClosed states ∧ ¬ states q := by
  constructor
  · intro empty
    exact ⟨grammar.Productive, grammar.productive_closed, empty⟩
  · rintro ⟨states, closed, excluded⟩ productive
    exact excluded (grammar.productive_least states closed q productive)

end Grammar

end Mettapedia.Logic.ConstraintTypes
