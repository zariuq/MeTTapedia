import Mettapedia.Logic.Institution
import Mathlib.CategoryTheory.Discrete.Basic
import Mathlib.CategoryTheory.Types.Basic

/-!
# Predicate institutions generated by semantic carriers

Every functor from signatures to semantic carriers induces an institution.
Carrier elements are sentences, predicates on the carrier are models, model
reduct is inverse image, and satisfaction is membership.  This construction
is useful for connecting small logical theories without identifying their
syntax: a natural map of carriers supplies both sentence translation and the
contravariant view of target predicates.
-/

set_option autoImplicit false

namespace Mettapedia.Logic.PredicateInstitution

open CategoryTheory
open scoped CategoryTheory

universe uSignature uSignatureHom uCarrier

variable {Signature : Type uSignature}
  [CategoryTheory.Category.{uSignatureHom} Signature]

/-- Predicates on a semantic carrier form a discrete model category.  A
signature morphism reduces predicates by inverse image along the carrier
map. -/
def predicateModel (carrier : Signature ⥤ Type uCarrier) :
    Signatureᵒᵖ ⥤ CategoryTheory.Cat.{uCarrier, uCarrier} where
  obj signature := CategoryTheory.Cat.of
    (CategoryTheory.Discrete (Set (carrier.obj signature.unop)))
  map := fun {source _target} translation =>
    (CategoryTheory.Discrete.functor fun model :
        Set (carrier.obj source.unop) =>
      CategoryTheory.Discrete.mk
        (Set.preimage (carrier.map translation.unop) model)).toCatHom
  map_id signature := by
    apply CategoryTheory.Cat.ext
    apply CategoryTheory.Discrete.functor_ext
    intro model
    apply CategoryTheory.Discrete.ext
    ext element
    simp
  map_comp first second := by
    apply CategoryTheory.Cat.ext
    apply CategoryTheory.Discrete.functor_ext
    intro model
    apply CategoryTheory.Discrete.ext
    ext element
    simp

/-- Satisfaction in the predicate model is membership in the selected
predicate. -/
def satisfies (carrier : Signature ⥤ Type uCarrier)
    (signature : Signature)
    (model : (predicateModel carrier).obj (Opposite.op signature))
    (sentence : carrier.obj signature) : Prop :=
  sentence ∈
    (show CategoryTheory.Discrete (Set (carrier.obj signature)) from model).as

/-- The predicate institution induced by a semantic carrier functor. -/
def ofCarrier (carrier : Signature ⥤ Type uCarrier) :
    Institution.{uSignature, uSignatureHom, uCarrier, uCarrier, uCarrier}
      Signature where
  sentence := carrier
  model := predicateModel carrier
  satisfies := satisfies carrier
  satisfaction_condition := by
    intro source target translation targetModel sourceSentence
    change carrier.map translation sourceSentence ∈
        (show CategoryTheory.Discrete (Set (carrier.obj target)) from
          targetModel).as ↔
      sourceSentence ∈ Set.preimage (carrier.map translation)
        (show CategoryTheory.Discrete (Set (carrier.obj target)) from
          targetModel).as
    rfl

/-- Predicate satisfaction is invariant under native model isomorphism.
Predicate models form a discrete category, so an isomorphism already carries
equality of the underlying predicates. -/
theorem satisfactionIsoInvariant (carrier : Signature ⥤ Type uCarrier) :
    (ofCarrier carrier).SatisfactionIsoInvariant := by
  intro signature sourceModel targetModel isomorphism sentence
  have modelEquality : sourceModel.as = targetModel.as :=
    CategoryTheory.Discrete.eq_of_hom isomorphism.hom
  change sentence ∈ sourceModel.as ↔ sentence ∈ targetModel.as
  rw [modelEquality]

@[simp]
theorem satisfaction_condition (carrier : Signature ⥤ Type uCarrier)
    {source target : Signature} (translation : source ⟶ target)
    (targetModel : Set (carrier.obj target))
    (sourceSentence : carrier.obj source) :
    (ofCarrier carrier).satisfies target
        (CategoryTheory.Discrete.mk targetModel)
        (carrier.map translation sourceSentence) ↔
      (ofCarrier carrier).satisfies source
        ((ofCarrier carrier).reduct translation
          (CategoryTheory.Discrete.mk targetModel))
        sourceSentence :=
  (ofCarrier carrier).satisfaction_condition translation
    (CategoryTheory.Discrete.mk targetModel) sourceSentence

/-! ## Routes induced by natural carrier maps -/

section CarrierRoute

variable {SourceSignature TargetSignature : Type uSignature}
  [CategoryTheory.Category.{uSignatureHom} SourceSignature]
  [CategoryTheory.Category.{uSignatureHom} TargetSignature]

/-- A natural map from source carriers into translated target carriers pulls
target predicates back to source predicates. -/
def modelView
    (sourceCarrier : SourceSignature ⥤ Type uCarrier)
    (targetCarrier : TargetSignature ⥤ Type uCarrier)
    (mapSignature : SourceSignature ⥤ TargetSignature)
    (mapCarrier : sourceCarrier ⟶ mapSignature ⋙ targetCarrier) :
    mapSignature.op ⋙ predicateModel targetCarrier ⟶
      predicateModel sourceCarrier where
  app signature :=
    (CategoryTheory.Discrete.functor fun model :
        Set (targetCarrier.obj (mapSignature.obj signature.unop)) =>
      CategoryTheory.Discrete.mk
        (Set.preimage (mapCarrier.app signature.unop) model)).toCatHom
  naturality := by
    intro source target translation
    apply CategoryTheory.Cat.Hom.ext
    apply CategoryTheory.Discrete.functor_ext
    intro model
    apply CategoryTheory.Discrete.ext
    ext element
    change
      mapCarrier.app target.unop element ∈
          Set.preimage
            (targetCarrier.map (mapSignature.map translation.unop)) model ↔
        sourceCarrier.map translation.unop element ∈
          Set.preimage (mapCarrier.app source.unop) model
    change
      targetCarrier.map (mapSignature.map translation.unop)
          (mapCarrier.app target.unop element) ∈ model ↔
        mapCarrier.app source.unop
          (sourceCarrier.map translation.unop element) ∈ model
    have pointEquality :
        targetCarrier.map (mapSignature.map translation.unop)
            (mapCarrier.app target.unop element) =
          mapCarrier.app source.unop
            (sourceCarrier.map translation.unop element) :=
      (congrArg (fun function => function element)
        (mapCarrier.naturality translation.unop)).symm
    rw [pointEquality]
    exact Iff.rfl

/-- A natural carrier map induces a full institution comorphism.  Sentence
translation is the carrier map, model translation is inverse image, and the
satisfaction law holds by construction. -/
def comorphism
    (sourceCarrier : SourceSignature ⥤ Type uCarrier)
    (targetCarrier : TargetSignature ⥤ Type uCarrier)
    (mapSignature : SourceSignature ⥤ TargetSignature)
    (mapCarrier : sourceCarrier ⟶ mapSignature ⋙ targetCarrier) :
    Institution.Comorphism (ofCarrier sourceCarrier)
      (ofCarrier targetCarrier) where
  mapSignature := mapSignature
  mapSentence := mapCarrier
  mapModel := modelView sourceCarrier targetCarrier mapSignature mapCarrier
  satisfaction_condition := by
    intro signature targetModel sourceSentence
    rfl

@[simp]
theorem comorphism_satisfaction
    (sourceCarrier : SourceSignature ⥤ Type uCarrier)
    (targetCarrier : TargetSignature ⥤ Type uCarrier)
    (mapSignature : SourceSignature ⥤ TargetSignature)
    (mapCarrier : sourceCarrier ⟶ mapSignature ⋙ targetCarrier)
    (signature : SourceSignature)
    (targetModel : Set (targetCarrier.obj (mapSignature.obj signature)))
    (sourceSentence : sourceCarrier.obj signature) :
    (ofCarrier targetCarrier).satisfies (mapSignature.obj signature)
        (CategoryTheory.Discrete.mk targetModel)
        (mapCarrier.app signature sourceSentence) ↔
      (ofCarrier sourceCarrier).satisfies signature
        (((comorphism sourceCarrier targetCarrier mapSignature mapCarrier).mapModel.app
          (Opposite.op signature)).toFunctor.obj
            (CategoryTheory.Discrete.mk targetModel))
        sourceSentence :=
  Iff.rfl

end CarrierRoute

