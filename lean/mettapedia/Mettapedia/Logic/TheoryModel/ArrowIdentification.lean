import Mettapedia.Logic.TheoryModel.Universe
import Mathlib.CategoryTheory.Quotient
import Mathlib.CategoryTheory.Category.Cat
import Mathlib.CategoryTheory.Limits.Shapes.Equalizers

/-!
# Functors and identifications of parallel arrows

The theory/model polarity of a category `C`: sentences are pairs of parallel
arrows of `C`, structures are functors out of `C` into the categories of a
universe `Cat.{v', u'}`, and a functor satisfies a pair when it identifies its
two arrows.

* The theory of any class of functors is the intersection of their kernels,
  hence a congruence.
* Over all functors into categories of the universes of `C`, the consequences
  of a set of arrow equations are exactly the congruence it generates: the
  quotient functor is a model that identifies nothing more. So the closed
  theories are exactly the congruences, and the quotient category hosts every
  arrow theory faithfully.
* Functors into thin categories identify every pair of parallel arrows; the
  universe of thin targets hosts the empty theory faithfully only when `C` has
  no two distinct parallel arrows.
* Control: the walking parallel pair has two parallel arrows, two proofs of one
  identity. Identifying them is a stronger theory with a smaller model class:
  the identity functor distinguishes them, the functor to a point identifies
  them, and thin targets validate the identification.
-/

set_option autoImplicit false

namespace Mettapedia.Logic.TheoryModel

open CategoryTheory Set Order

universe v u v' u'

/-- A pair of parallel arrows of `C`: an equation between arrows. -/
structure ParallelArrows (C : Type u) [Category.{v} C] where
  src : C
  tgt : C
  left : src ⟶ tgt
  right : src ⟶ tgt

namespace ParallelArrows

variable {C : Type u} [Category.{v} C]

/-- The equations of a relation on arrows. -/
def ofHomRel (r : HomRel C) : Set (ParallelArrows C) :=
  {p | r p.left p.right}

/-- The relation on arrows given by a set of equations. -/
def toHomRel (R : Set (ParallelArrows C)) : HomRel C :=
  fun X Y f g => (⟨X, Y, f, g⟩ : ParallelArrows C) ∈ R

theorem toHomRel_ofHomRel (r : HomRel C) : toHomRel (ofHomRel r) = r :=
  rfl

end ParallelArrows

variable {C : Type u} [Category.{v} C]

open ParallelArrows

/-- A functor into a category of the universe `Cat.{v', u'}` satisfies a pair of
parallel arrows when it identifies them. -/
def Identifies (F : Σ D : Cat.{v', u'}, C ⥤ D) (p : ParallelArrows C) : Prop :=
  F.2.map p.left = F.2.map p.right

/-- Identification by functors into categories of the universes of `C`. -/
abbrev IdentifiesIn (C : Type u) [Category.{v} C] :
    (Σ D : Cat.{v, u}, C ⥤ D) → ParallelArrows C → Prop :=
  Identifies

theorem mem_models_identifies_iff {R : Set (ParallelArrows C)} {F : Σ D : Cat.{v', u'}, C ⥤ D} :
    F ∈ models Identifies R ↔
      ∀ ⦃X Y : C⦄ (f g : X ⟶ Y), toHomRel R f g → F.2.map f = F.2.map g :=
  ⟨fun model _ _ f g related =>
      model (show (⟨_, _, f, g⟩ : ParallelArrows C) ∈ R from related),
    fun respects p member => respects p.left p.right member⟩

/-- **The theory of a class of functors is a congruence**: the intersection of
their kernels. -/
theorem theoryOf_congruence (K : Set (Σ D : Cat.{v', u'}, C ⥤ D)) :
    Congruence (toHomRel (theoryOf Identifies K)) where
  equivalence := {
    refl := fun _ _ _ => rfl
    symm := fun related _ member => (related member).symm
    trans := fun related related' _ member => (related member).trans (related' member) }
  comp_left := by
    intro X Y Z f g g' related F member
    change F.2.map (f ≫ g) = F.2.map (f ≫ g')
    rw [Functor.map_comp, Functor.map_comp]
    exact congrArg (F.2.map f ≫ ·) (related member)
  comp_right := by
    intro X Y Z f f' g related F member
    change F.2.map (f ≫ g) = F.2.map (f' ≫ g)
    rw [Functor.map_comp, Functor.map_comp]
    exact congrArg (· ≫ F.2.map g) (related member)

/-- The congruence generated by a set of arrow equations. -/
def generatedCongruence (R : Set (ParallelArrows C)) : Set (ParallelArrows C) :=
  {p | Relation.EqvGen (@HomRel.CompClosure C _ (toHomRel R) p.src p.tgt) p.left p.right}

/-- Every model of `R` identifies the arrows related by the generated
congruence. -/
theorem map_eq_of_eqvGen {R : Set (ParallelArrows C)} {F : Σ D : Cat.{v', u'}, C ⥤ D}
    (model : F ∈ models Identifies R) {X Y : C} {f g : X ⟶ Y}
    (generated : Relation.EqvGen (@HomRel.CompClosure C _ (toHomRel R) X Y) f g) :
    F.2.map f = F.2.map g := by
  induction generated with
  | rel f g closure =>
      obtain ⟨a, b, before, m₁, m₂, after, related⟩ := closure
      rw [Functor.map_comp, Functor.map_comp, Functor.map_comp, Functor.map_comp,
        mem_models_identifies_iff.mp model m₁ m₂ related]
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

/-- The quotient by the generated congruence, as a structure of the universe of
`C`. -/
def quotientModel (R : Set (ParallelArrows C)) : Σ D : Cat.{v, u}, C ⥤ D :=
  ⟨Cat.of (CategoryTheory.Quotient (toHomRel R)), CategoryTheory.Quotient.functor _⟩

theorem quotientModel_mem_models (R : Set (ParallelArrows C)) :
    quotientModel R ∈ models Identifies R :=
  fun _ member => CategoryTheory.Quotient.sound _ member

/-- **The consequences of a set of arrow equations are its generated
congruence**, computed over all functors into categories of the universes of
`C`. -/
theorem consequences_arrows (R : Set (ParallelArrows C)) :
    theoryOf (IdentifiesIn C) (models Identifies R) = generatedCongruence R := by
  ext p
  constructor
  · intro consequence
    exact (CategoryTheory.Quotient.functor_homRel_eq_compClosure_eqvGen (toHomRel R)
      p.left p.right).mp (consequence (quotientModel_mem_models R))
  · intro generated F model
    exact map_eq_of_eqvGen model generated

/-- The generated congruence of a congruence is itself. -/
theorem generatedCongruence_of_congruence {R : Set (ParallelArrows C)}
    (congruence : Congruence (toHomRel R)) : generatedCongruence R = R := by
  ext p
  constructor
  · intro generated
    have closure := (congruence.equivalence (X := p.src) (Y := p.tgt)).eqvGen_iff.mp
      (generated.mono fun _ _ step => (HomRel.compClosure_iff_self (toHomRel R) _ _).mp step)
    exact closure
  · intro member
    exact Relation.EqvGen.rel _ _ (HomRel.CompClosure.of member)

/-- **The closed arrow theories are exactly the congruences.** -/
theorem isIntent_identifies_iff {R : Set (ParallelArrows C)} :
    IsIntent (IdentifiesIn C) R ↔ Congruence (toHomRel R) := by
  constructor
  · rintro ⟨K, rfl⟩
    exact theoryOf_congruence K
  · intro congruence
    rw [isIntent_iff_consequences_eq, consequences_arrows,
      generatedCongruence_of_congruence congruence]

/-- The universe of all categories of the universes of `C` hosts every arrow
theory faithfully; the quotient functor alone does. -/
theorem hostsFaithfully_quotientModel (R : Set (ParallelArrows C)) :
    HostsFaithfully (IdentifiesIn C) {quotientModel R} R := by
  apply hostsFaithfully_iff_subset.mpr
  rw [consequences_arrows]
  intro p validated
  exact (CategoryTheory.Quotient.functor_homRel_eq_compClosure_eqvGen (toHomRel R)
    p.left p.right).mp (validated ⟨rfl, quotientModel_mem_models R⟩)

/-! ## Thin targets -/

/-- Functors into thin categories. -/
def thinTargets : Set (Σ D : Cat.{v', u'}, C ⥤ D) :=
  {F | Quiver.IsThin F.1}

/-- **Thin targets validate every identification of parallel arrows.** -/
theorem consequencesIn_thinTargets (R : Set (ParallelArrows C)) :
    consequencesIn Identifies (thinTargets : Set (Σ D : Cat.{v', u'}, C ⥤ D)) R = univ :=
  eq_univ_of_forall fun p F hosted =>
    @Subsingleton.elim _ (hosted.1 (F.2.obj p.src) (F.2.obj p.tgt)) _ _

/-- The congruence generated by no equations is equality. -/
theorem eq_of_eqvGen_compClosure_empty {X Y : C} {f g : X ⟶ Y}
    (generated : Relation.EqvGen (@HomRel.CompClosure C _ (toHomRel ∅) X Y) f g) : f = g := by
  induction generated with
  | rel _ _ closure =>
      obtain ⟨_, _, _, _, _, _, related⟩ := closure
      exact related.elim
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

/-- **Thin targets do not host the empty theory faithfully** once `C` has two
distinct parallel arrows. -/
theorem not_hostsFaithfully_thinTargets {X Y : C} {f g : X ⟶ Y} (distinct : f ≠ g) :
    ¬ HostsFaithfully (IdentifiesIn C) thinTargets (∅ : Set (ParallelArrows C)) := by
  apply not_hostsFaithfully_of (φ := ⟨X, Y, f, g⟩)
  · rw [consequencesIn_thinTargets]
    exact mem_univ _
  · intro entailed
    have generated : (⟨X, Y, f, g⟩ : ParallelArrows C) ∈
        theoryOf (IdentifiesIn C) (models Identifies (∅ : Set (ParallelArrows C))) :=
      entailed
    rw [consequences_arrows] at generated
    exact distinct (eq_of_eqvGen_compClosure_empty generated)

/-! ## Control: two parallel arrows -/

namespace Control

open Limits

/-- The two parallel arrows of the walking parallel pair: two proofs of one
identity. -/
def twoProofs : ParallelArrows WalkingParallelPair :=
  ⟨.zero, .one, WalkingParallelPairHom.left, WalkingParallelPairHom.right⟩

theorem left_ne_right :
    (WalkingParallelPairHom.left : WalkingParallelPair.zero ⟶ WalkingParallelPair.one) ≠
      WalkingParallelPairHom.right :=
  fun equal => by cases equal

/-- Identification by functors into small categories. -/
abbrev arrowSat : (Σ D : Cat.{0, 0}, WalkingParallelPair ⥤ D) →
    ParallelArrows WalkingParallelPair → Prop :=
  Identifies

/-- The identity functor: a model in which the two proofs differ. -/
def identityModel : Σ D : Cat.{0, 0}, WalkingParallelPair ⥤ D :=
  ⟨Cat.of WalkingParallelPair, 𝟭 _⟩

/-- The functor to a point: a model in which the two proofs are identified. -/
def pointModel : Σ D : Cat.{0, 0}, WalkingParallelPair ⥤ D :=
  ⟨Cat.of (Discrete PUnit),
    { obj := fun _ => ⟨PUnit.unit⟩
      map := fun _ => 𝟙 _
      map_id := fun _ => rfl
      map_comp := fun _ _ => rfl }⟩

theorem identityModel_mem_models_empty :
    identityModel ∈ models Identifies (∅ : Set (ParallelArrows WalkingParallelPair)) :=
  fun _ member => member.elim

/-- **The identity functor distinguishes the two proofs.** -/
theorem identityModel_not_mem_models_twoProofs :
    identityModel ∉ models Identifies {twoProofs} :=
  fun model => left_ne_right (model rfl)

/-- **The functor to a point identifies them.** -/
theorem pointModel_mem_models_twoProofs : pointModel ∈ models Identifies {twoProofs} := by
  rintro p rfl
  rfl

/-- The identification is the stronger theory: the model classes differ and
the weaker theory has the larger class. -/
theorem identification_shrinks_models :
    models Identifies {twoProofs} ⊆
        models arrowSat (∅ : Set (ParallelArrows WalkingParallelPair)) ∧
      identityModel ∈ models Identifies (∅ : Set (ParallelArrows WalkingParallelPair)) ∧
      identityModel ∉ models Identifies {twoProofs} :=
  ⟨models_anti (empty_subset _), identityModel_mem_models_empty,
    identityModel_not_mem_models_twoProofs⟩

/-- Negative control: the empty theory does not entail the identification. -/
theorem not_entails_twoProofs :
    ¬ Entails arrowSat (∅ : Set (ParallelArrows WalkingParallelPair))
      twoProofs :=
  fun entails => left_ne_right (entails identityModel_mem_models_empty)

/-- Thin targets validate the identification. -/
theorem twoProofs_mem_consequencesIn_thinTargets :
    twoProofs ∈ consequencesIn arrowSat thinTargets
      (∅ : Set (ParallelArrows WalkingParallelPair)) := by
  rw [consequencesIn_thinTargets]
  exact mem_univ _

theorem not_hostsFaithfully_thinTargets_walking :
    ¬ HostsFaithfully arrowSat thinTargets
      (∅ : Set (ParallelArrows WalkingParallelPair)) :=
  not_hostsFaithfully_thinTargets left_ne_right

/-- The identity functor alone hosts the empty theory of the walking parallel
pair faithfully. -/
theorem hostsFaithfully_identityModel :
    HostsFaithfully arrowSat {identityModel}
      (∅ : Set (ParallelArrows WalkingParallelPair)) := by
  apply hostsFaithfully_iff_subset.mpr
  intro p validated F _
  have equal : p.left = p.right := validated ⟨rfl, identityModel_mem_models_empty⟩
  change F.2.map p.left = F.2.map p.right
  rw [equal]

end Control

end Mettapedia.Logic.TheoryModel
