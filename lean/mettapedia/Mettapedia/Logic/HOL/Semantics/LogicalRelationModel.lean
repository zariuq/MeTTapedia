import Mettapedia.Logic.HOL.TypeSubstitutionModelCoherence

/-!
# Henkin domains generated by a logical relation

Reflexive relations on base carriers lift through function types. A value is
admissible when it is related to itself. The relation at propositions is
universal, so all logical connectives, equality, and quantifiers preserve it;
the substantive restriction is at function types with nontrivial base relations.

Boolean implication as the base relation yields a non-full Henkin model:
admissible Boolean endomaps are monotone and have fixed points. Standardization
adds negation, which has no fixed point, and changes a closed sentence's truth.

This model is closed under terms but does not satisfy `FunctionsRespectEqv`:
admissible predicates may distinguish ambient functions that agree on admitted
arguments. It is therefore not a model of the fixed-base institution, whose
models additionally require that extensional congruence law.
-/

set_option autoImplicit false

namespace Mettapedia.Logic.HOL

universe u v w

variable {Base : Type u} {Const : Ty Base → Type v}

namespace Ty

/-- The binary logical relation generated by the chosen base relations.
The proposition clause is intentionally universal, not propositional equality. -/
def logicalRelation {Carrier : Base → Type (max (u + 1) w)}
    (R : ∀ b, Carrier b → Carrier b → Prop) :
    (a : Ty Base) → denote Carrier a → denote Carrier a → Prop
  | .prop, _, _ => True
  | .base b, x, y => R b x y
  | .arr a b, f, g => ∀ x y, logicalRelation R a x y → logicalRelation R b (f x) (g y)

end Ty

namespace PreModel

/-- The logical-relations fundamental lemma for every HOL term. The
proposition clause permits arbitrary logical observations of related values. -/
theorem denote_logicalRelation (M : PreModel.{u, v, w} Base Const)
    (R : ∀ b, M.Carrier b → M.Carrier b → Prop)
    (constants : ∀ {a} (c : Const a), Ty.logicalRelation R a (M.constDen c) (M.constDen c))
    {Γ : Ctx Base} {a : Ty Base} (t : Term Const Γ a)
    (ρ ρ' : M.Valuation Γ)
    (relatedVars : ∀ {b} (x : Var Γ b), Ty.logicalRelation R b (ρ x) (ρ' x)) :
    Ty.logicalRelation R a (M.denote t ρ) (M.denote t ρ') := by
  induction t with
  | var x => exact relatedVars x
  | const c => exact constants c
  | app f t ihf iht => exact ihf ρ ρ' relatedVars _ _ (iht ρ ρ' relatedVars)
  | lam t ih =>
      intro x y related
      apply ih (M.extend ρ x) (M.extend ρ' y)
      intro b v
      cases v with
      | vz => exact related
      | vs v => exact relatedVars v
  | top => trivial
  | bot => trivial
  | and => trivial
  | or => trivial
  | imp => trivial
  | not => trivial
  | eq => trivial
  | all => trivial
  | ex => trivial

end PreModel

namespace HenkinModel

/-- A reflexive base relation and related constants generate domains closed
under every term, including lambda abstraction. -/
def ofLogicalRelation
    (Carrier : Base → Type (max (u + 1) w))
    (R : ∀ b, Carrier b → Carrier b → Prop)
    (reflexive : ∀ b x, R b x x)
    (constDen : ∀ {a}, Const a → Ty.denote Carrier a)
    (constants : ∀ {a} (c : Const a), Ty.logicalRelation R a (constDen c) (constDen c)) :
    HenkinModel.{u, v, w} Base Const :=
  let pre : PreModel.{u, v, w} Base Const :=
    { Carrier := Carrier
      adm := fun a x => Ty.logicalRelation R a x x
      base_mem := reflexive
      prop_mem := fun _ => True.intro
      app_mem := fun hf hx => hf _ _ hx
      constDen := constDen
      const_mem := constants }
  { toPreModel := pre
    term_closed := fun t ρ admissible =>
      pre.denote_logicalRelation R constants t ρ ρ admissible }

end HenkinModel

namespace MonotoneBooleanModel

abbrev Constants : Ty Unit → Type := fun _ => Empty

def model : HenkinModel.{0, 0, 0} Unit Constants :=
  HenkinModel.ofLogicalRelation (fun _ => ULift.{1} Bool)
    (fun _ x y => x.down = true → y.down = true)
    (fun _ _ h => h) (fun {_} c => nomatch c) (fun {_} c => nomatch c)

abbrev boolean : Ty Unit := .base ()

def negation : Ty.denote.{0, 0} model.Carrier (.arr boolean boolean) :=
  fun x => ⟨!x.down⟩

theorem negation_not_admissible : ¬ model.adm (.arr boolean boolean) negation := by
  intro monotone
  have impossible := monotone (ULift.up false) (ULift.up true) (by intro h; cases h) rfl
  cases impossible

theorem not_fullDomains : ¬ model.FullDomains :=
  fun full => negation_not_admissible (full _ negation)

/-- Every Boolean endomap has a fixed point. Its truth depends on the
admitted function domain, not just the ambient base carrier. -/
def fixedPointSentence : ClosedFormula Constants :=
  .all (σ := .arr boolean boolean) (.ex (σ := boolean)
    (.eq (.app (.var (.vs .vz)) (.var .vz)) (.var .vz)))

/-- A monotone endomap of the two-element chain has a fixed point. -/
theorem models_fixedPointSentence : model.models fixedPointSentence := by
  change ∀ f : ULift.{1} Bool → ULift.{1} Bool,
    (∀ x y, (x.down = true → y.down = true) → (f x).down = true → (f y).down = true) →
      ∃ x, (x.down = true → x.down = true) ∧ f x = x
  intro f monotone
  cases value : (f ⟨false⟩).down with
  | false =>
      refine ⟨⟨false⟩, fun h => h, ?_⟩
      exact ULift.ext _ _ value
  | true =>
      refine ⟨⟨true⟩, fun h => h, ?_⟩
      apply ULift.ext
      exact monotone ⟨false⟩ ⟨true⟩ (by intro h; cases h) value

/-- Standardization introduces the negation endomap, refuting the same
closed sentence while keeping the same base carrier and constants. -/
theorem standard_refutes_fixedPointSentence :
    ¬ (HenkinModel.standard model.Carrier model.constDen).models fixedPointSentence := by
  change ¬ (∀ f : ULift.{1} Bool → ULift.{1} Bool, True → ∃ x, True ∧ f x = x)
  intro holds
  obtain ⟨⟨x⟩, _, fixed⟩ := holds negation True.intro
  have impossible := congrArg ULift.down fixed
  cases x <;> cases impossible

/-- The unrestricted identity satisfaction law is false for a concrete
lambda-closed Henkin model, not merely for an arbitrary premodel. -/
theorem identity_reduct_changes_truth :
    model.models fixedPointSentence ∧
      ¬ (HenkinModel.standardTypeReduct (Const' := Constants) Ty.base
        (fun {a} c => (Ty.substitute_id a).symm ▸ c) model).models fixedPointSentence := by
  rw [HenkinModel.standardTypeReduct_id]
  exact ⟨models_fixedPointSentence, standard_refutes_fixedPointSentence⟩

/-- A higher-order Boolean observation takes a Boolean endomap as input. -/
abbrev endomapObservation : Ty Unit := .arr (.arr boolean boolean) boolean

def atFalse : Ty.denote.{0, 0} model.Carrier endomapObservation :=
  fun f => f ⟨false⟩

def andEndpoints : Ty.denote.{0, 0} model.Carrier endomapObservation :=
  fun f => ⟨(f ⟨false⟩).down && (f ⟨true⟩).down⟩

theorem atFalse_admissible : model.adm endomapObservation atFalse := by
  intro f g related
  exact related ⟨false⟩ ⟨false⟩ (fun h => h)

theorem andEndpoints_admissible : model.adm endomapObservation andEndpoints := by
  intro f g related both
  change ((g ⟨false⟩).down && (g ⟨true⟩).down) = true
  change ((f ⟨false⟩).down && (f ⟨true⟩).down) = true at both
  obtain ⟨atFalseTrue, atTrueTrue⟩ := Bool.and_eq_true_iff.mp both
  exact Bool.and_eq_true_iff.mpr
    ⟨related ⟨false⟩ ⟨false⟩ (fun h => h) atFalseTrue,
      related ⟨true⟩ ⟨true⟩ (fun h => h) atTrueTrue⟩

/-- Admitted endomaps are monotone, so these two observations agree on
every admitted argument. -/
theorem atFalse_eqv_andEndpoints : model.Eqv endomapObservation atFalse andEndpoints := by
  intro f monotone
  apply ULift.ext
  change (f ⟨false⟩).down = ((f ⟨false⟩).down && (f ⟨true⟩).down)
  cases first : (f ⟨false⟩).down with
  | false => simp
  | true =>
      have last : (f ⟨true⟩).down = true :=
        monotone ⟨false⟩ ⟨true⟩ (by intro h; cases h) first
      simp [last]

/-- Their ambient functions nevertheless differ on the excluded negation. -/
theorem atFalse_ne_andEndpoints : atFalse ≠ andEndpoints := by
  intro equal
  have impossible := congrArg (fun f => (f negation).down) equal
  cases impossible

/-- Predicates may inspect behavior on an inadmissible argument because
the generating relation at propositions is universal. -/
def observesNegation : Ty.denote.{0, 0} model.Carrier (.arr endomapObservation .prop) :=
  fun f => ⟨(f negation).down = true⟩

theorem observesNegation_admissible :
    model.adm (.arr endomapObservation .prop) observesNegation := by
  intro _ _ _
  trivial

theorem observesNegation_distinguishes :
    ¬ model.Eqv .prop (observesNegation atFalse) (observesNegation andEndpoints) := by
  change ¬ ((true = true) ↔ (false = true))
  simp

/-- Lambda closure alone does not supply extensional argument congruence.
This is an obstruction to bundling this particular model in the existing
fixed-base Henkin institution, not a model-coverage theorem for that institution. -/
theorem not_functionsRespectEqv : ¬ model.FunctionsRespectEqv := by
  intro respects
  exact observesNegation_distinguishes
    (respects observesNegation_admissible atFalse_admissible andEndpoints_admissible
      atFalse_eqv_andEndpoints)

end MonotoneBooleanModel

#print axioms PreModel.denote_logicalRelation
#print axioms HenkinModel.ofLogicalRelation
#print axioms MonotoneBooleanModel.not_fullDomains
#print axioms MonotoneBooleanModel.identity_reduct_changes_truth
#print axioms MonotoneBooleanModel.atFalse_eqv_andEndpoints
#print axioms MonotoneBooleanModel.not_functionsRespectEqv

end Mettapedia.Logic.HOL
