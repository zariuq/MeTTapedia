import Mathlib.Tactic
import Mettapedia.Logic.HOL.Embedding.HenkinDependentFamilyInterpretation
import Mettapedia.TypeTheory.CwfTarskiUniverse

/-!
# Small standard HOL models inside a dependent Tarski universe

A family of small base carriers generates a standard HOL model by lifting
each carrier one universe.  Every simple type of that model has a recursively
defined small representative.  Its ambient HOL denotation is equivalent to
the lift of that representative, so the type receives a code in the
substitution-stable Tarski universe of the large set-family CwF.

This puts a property-explicit standard simple-type semantics and dependent
products, dependent sums, contextual identity elimination, and a
Pi/Sigma-closed Tarski universe in one semantic CwF.  The simple image remains
proper: the universe also codes genuinely varying families which cannot be
equivalent to any constant interpreted HOL type.

The construction is semantic.  It does not select a HOL proof calculus, a
dependent syntax, a conversion algorithm, or a language integration.
-/

set_option autoImplicit false

namespace Mettapedia.Logic.HOL.Embedding.LiftedStandardModelTarskiInterpretation

open Mettapedia.GSLT.Core.ContextualLadder
open Mettapedia.Logic.HOL.Embedding.HenkinDependentFamilyInterpretation
open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.CwfTarskiUniverse
open Mettapedia.TypeTheory.CwfTarskiUniverse.SetFamilies

universe v

variable {Base : Type} {Const : Ty Base → Type v}

/-! ## Recursive small representatives of HOL types -/

/-- The small type represented by a HOL type when every base carrier is
small. -/
def SmallDenote (SmallCarrier : Base → Type) :
    Ty Base → Type
  | .prop => Prop
  | .base base => SmallCarrier base
  | .arr domain codomain =>
      SmallDenote SmallCarrier domain → SmallDenote SmallCarrier codomain

/-- The ambient base carriers of the associated Henkin model. -/
def liftedCarrier (SmallCarrier : Base → Type) :
    Base → Type 1 :=
  fun base => SmallLift.{0} (SmallCarrier base)

/-- Ambient HOL denotation agrees, up to a canonical equivalence, with the
one-universe lift of the recursive small representative. -/
def denoteEquiv (SmallCarrier : Base → Type) :
    (A : Ty Base) →
      Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A ≃
        SmallLift.{0} (SmallDenote SmallCarrier A)
  | .prop =>
      { toFun := fun proposition => ⟨proposition.down⟩
        invFun := fun proposition => ⟨proposition.down⟩
        left_inv := by
          intro proposition
          cases proposition
          rfl
        right_inv := by
          intro proposition
          cases proposition
          rfl }
  | .base _ => Equiv.refl _
  | .arr domain codomain =>
      let domainEquiv := denoteEquiv SmallCarrier domain
      let codomainEquiv := denoteEquiv SmallCarrier codomain
      { toFun := fun function =>
          ⟨fun argument =>
            (codomainEquiv
              (function (domainEquiv.symm ⟨argument⟩))).down⟩
        invFun := fun function argument =>
          codomainEquiv.symm
            ⟨function.down (domainEquiv argument).down⟩
        left_inv := by
          intro function
          funext argument
          change codomainEquiv.symm
              (⟨(codomainEquiv
                (function
                  (domainEquiv.symm
                    (⟨(domainEquiv argument).down⟩ :
                      SmallLift.{0}
                        (SmallDenote SmallCarrier domain))))).down⟩ :
                SmallLift.{0} (SmallDenote SmallCarrier codomain)) =
            function argument
          have domainRoundtrip :
              (⟨(domainEquiv argument).down⟩ :
                SmallLift.{0} (SmallDenote SmallCarrier domain)) =
                domainEquiv argument :=
            ULift.up_down _
          rw [domainRoundtrip, domainEquiv.symm_apply_apply]
          have codomainRoundtrip :
              (⟨(codomainEquiv (function argument)).down⟩ :
                SmallLift.{0} (SmallDenote SmallCarrier codomain)) =
                codomainEquiv (function argument) :=
            ULift.up_down _
          rw [codomainRoundtrip, codomainEquiv.symm_apply_apply]
        right_inv := by
          intro function
          cases function with
          | up function =>
              apply ULift.ext
              funext argument
              simp }

/-! ## Standard model and internal universe codes -/

/-- The standard Henkin model generated by the lifted carriers and a chosen
interpretation of constants. -/
def liftedStandardModel (SmallCarrier : Base → Type)
    (constantDenotation : {A : Ty Base} →
      Const A → Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A) :
    HenkinModel.{0, v, 0} Base Const :=
  HenkinModel.standard (liftedCarrier SmallCarrier) constantDenotation

/-- The generated standard model has full Henkin domains. -/
theorem liftedStandardModel_fullDomains
    (SmallCarrier : Base → Type)
    (constantDenotation : {A : Ty Base} →
      Const A → Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A) :
    (liftedStandardModel SmallCarrier constantDenotation).FullDomains :=
  HenkinModel.fullDomains_standard
    (liftedCarrier SmallCarrier) constantDenotation

/-- The context-constant Tarski code of an interpreted HOL type. -/
def typeCode (SmallCarrier : Base → Type)
    {context : Type 1} (A : Ty Base) :
    semanticCwf.{0}.Tm context (smallTypes.{0}.univ context) :=
  fun _ => ⟨SmallDenote SmallCarrier A⟩

/-- Decoding the internal code recovers the ambient standard-model
denotation of the HOL type. -/
def decodedTypeEquiv (SmallCarrier : Base → Type)
    {context : Type 1} (A : Ty Base) (point : context) :
    smallTypes.{0}.el (typeCode SmallCarrier A) point ≃
      Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A :=
  (denoteEquiv SmallCarrier A).symm

/-- Decoding also recovers the admissible-value semantics of the generated
standard model. -/
def decodedAdmissibleTypeEquiv
    (SmallCarrier : Base → Type)
    (constantDenotation : {A : Ty Base} →
      Const A → Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A)
    {context : Ctx Base} (A : Ty Base)
    (valuation : AdmissibleContext
      (liftedStandardModel SmallCarrier constantDenotation) context) :
    smallTypes.{0}.el
        (typeCode SmallCarrier (context :=
          AdmissibleContext
            (liftedStandardModel SmallCarrier constantDenotation) context) A)
        valuation ≃
      AdmissibleValue
        (liftedStandardModel SmallCarrier constantDenotation) A :=
  (decodedTypeEquiv SmallCarrier A valuation).trans
    (fullDomainsValueEquiv
      (liftedStandardModel SmallCarrier constantDenotation)
      (liftedStandardModel_fullDomains SmallCarrier constantDenotation) A).symm

/-- A HOL term interpreted as a section of its internal Tarski decoding. -/
def codedTerm
    (SmallCarrier : Base → Type)
    (constantDenotation : {A : Ty Base} →
      Const A → Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A)
    {context : Ctx Base} {A : Ty Base} (term : Term Const context A) :
    semanticCwf.{0}.Tm
      (AdmissibleContext
        (liftedStandardModel SmallCarrier constantDenotation) context)
      (smallTypes.{0}.el
        (typeCode SmallCarrier (context :=
          AdmissibleContext
            (liftedStandardModel SmallCarrier constantDenotation) context) A)) :=
  fun valuation =>
    (decodedAdmissibleTypeEquiv SmallCarrier constantDenotation A valuation).symm
      (interpretTerm
        (liftedStandardModel SmallCarrier constantDenotation) term valuation)

/-- The coded-term interpretation commutes with simultaneous substitution. -/
theorem codedTerm_substitution
    (SmallCarrier : Base → Type)
    (constantDenotation : {A : Ty Base} →
      Const A → Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A)
    {source target : Ctx Base} {A : Ty Base}
    (term : Term Const target A)
    (substitution :
      (ContextualStructure.holScwf Base Const).Sub source target) :
    semanticCwf.{0}.tmSub
        (codedTerm SmallCarrier constantDenotation term)
        (interpretSubstitution
          (liftedStandardModel SmallCarrier constantDenotation)
          substitution) =
      codedTerm SmallCarrier constantDenotation
        ((ContextualStructure.holScwf Base Const).tmSub term substitution) := by
  funext valuation
  change
    (decodedAdmissibleTypeEquiv
      SmallCarrier constantDenotation A valuation).symm
        (interpretTerm
          (liftedStandardModel SmallCarrier constantDenotation) term
          (interpretSubstitution
            (liftedStandardModel SmallCarrier constantDenotation)
            substitution valuation)) =
      (decodedAdmissibleTypeEquiv
        SmallCarrier constantDenotation A valuation).symm
        (interpretTerm
          (liftedStandardModel SmallCarrier constantDenotation)
          ((ContextualStructure.holScwf Base Const).tmSub term substitution)
          valuation)
  exact congrArg
    (decodedAdmissibleTypeEquiv
      SmallCarrier constantDenotation A valuation).symm
    (interpretTerm_substitution
      (liftedStandardModel SmallCarrier constantDenotation)
      term substitution valuation).symm

/-! ## Joint capability theorem and properness -/

/-- Every simple type is internally coded in the same dependent CwF that
supports the standard dependent capability family. -/
theorem simple_types_and_dependent_capabilities_share_model
    (SmallCarrier : Base → Type)
    (constantDenotation : {A : Ty Base} →
      Const A → Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A) :
    (∀ (context : Ctx Base) (A : Ty Base)
        (valuation : AdmissibleContext
          (liftedStandardModel SmallCarrier constantDenotation) context),
      Nonempty
        (smallTypes.{0}.el
            (typeCode SmallCarrier (context :=
              AdmissibleContext
                (liftedStandardModel SmallCarrier constantDenotation) context)
              A)
            valuation ≃
          AdmissibleValue
            (liftedStandardModel SmallCarrier constantDenotation) A)) ∧
      Nonempty (ContextualProductComparison.DependentProductBeta
        semanticCwf.{0}) ∧
      Nonempty (ContextualSumComparison.DependentSumBeta
        semanticCwf.{0}) ∧
      Nonempty
        (ContextualIdentityTypes.IdentityEliminationBeta semanticCwf.{0}
          ContextualIdentityTypes.Families.identityFormation
          ContextualIdentityTypes.Families.identityReflexivity) ∧
      Nonempty (TarskiUniverse semanticCwf.{0}) ∧
      Nonempty smallTypes.{0}.SubstitutionStable ∧
      Nonempty FibrewisePiClosed.{0} ∧
      Nonempty FibrewiseSigmaClosed.{0} := by
  refine ⟨fun context A valuation =>
      ⟨decodedAdmissibleTypeEquiv
        SmallCarrier constantDenotation A valuation⟩, ?_⟩
  exact dependent_capabilities_have_common_set_model

/-- A genuinely varying universe code cannot be equivalent at every point to
any constant interpreted HOL type. -/
theorem varyingCode_not_an_interpreted_simple_type
    (SmallCarrier : Base → Type)
    (constantDenotation : {A : Ty Base} →
      Const A → Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A)
    (A : Ty Base) :
    ¬ (∀ point : BoolContext.{0},
      Nonempty
        (smallTypes.{0}.el varyingCode point ≃
          AdmissibleValue
            (liftedStandardModel SmallCarrier constantDenotation) A)) := by
  intro equivalent
  rcases equivalent (ULift.up false) with ⟨atFalse⟩
  rcases equivalent (ULift.up true) with ⟨atTrue⟩
  have unitBoolEquiv :
      SmallLift.{0} PUnit ≃ SmallLift.{0} Bool := by
    exact atFalse.trans atTrue.symm
  have sameCardinality := Fintype.card_congr unitBoolEquiv
  norm_num at sameCardinality

/-- Positive coding and strict dependent properness coexist in the same
universe model. -/
theorem coded_simple_fragment_is_proper
    (SmallCarrier : Base → Type)
    (constantDenotation : {A : Ty Base} →
      Const A → Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A) :
    (∀ (A : Ty Base), Nonempty
      (smallTypes.{0}.el
          (typeCode SmallCarrier (context := PUnit) A) PUnit.unit ≃
        Ty.denote.{0, 0} (liftedCarrier SmallCarrier) A)) ∧
      (∀ A : Ty Base,
        ¬ (∀ point : BoolContext.{0},
          Nonempty
            (smallTypes.{0}.el varyingCode point ≃
              AdmissibleValue
                (liftedStandardModel SmallCarrier constantDenotation) A))) :=
  ⟨fun A => ⟨decodedTypeEquiv SmallCarrier A PUnit.unit⟩,
    varyingCode_not_an_interpreted_simple_type
      SmallCarrier constantDenotation⟩

