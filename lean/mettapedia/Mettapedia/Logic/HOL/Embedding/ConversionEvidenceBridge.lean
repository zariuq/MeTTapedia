import Mettapedia.Logic.HOL.Embedding.ConversionPrice
import Mettapedia.TypeTheory.FreeConversion

/-!
# Explicit conversion evidence for the dependent comparison core

Declarative convertibility records only that two expressions are convertible.
This module gives its exact proof-relevant counterpart: freely generated beta,
reflexivity, symmetry, and transitivity trees.  Declarative conversion is
equivalent to mere inhabitation of that path type.

Typing with conversion has the same factorization.  A typing receipt contains
one syntax-directed typing derivation followed by an explicit conversion path;
its mere existence is equivalent to declarative typing with conversion.  Thus
conversion work has a precise boundary: an implementation either constructs
the path while checking or receives it in the certificate.
-/

set_option autoImplicit false

namespace Mettapedia.Logic.HOL.Embedding.SimpleSliceOfDependent
namespace ConversionEvidenceBridge

open Expr
open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.JudgmentalEquality

universe u v

/-- The proof-relevant primitive beta generator. -/
inductive BetaStep (Base : Type u) (Const : Ty Base → Type v) :
    Expr Base Const → Expr Base Const → Type (max u v) where
  | beta (domain body argument : Expr Base Const) :
      BetaStep Base Const
        (app (lam domain body) argument) (substAt 0 argument body)

/-- The one-fibre judgmental computation generated by beta. -/
abbrev BetaComputation
    (Base : Type u) (Const : Ty Base → Type v) :
    JudgmentalComputation Unit :=
  FreeConversion.computation
    (fun _ : Unit => Expr Base Const)
    (fun {_index : Unit} source target => BetaStep Base Const source target)

/-- Complete proof-relevant conversion trees generated by beta. -/
abbrev ConversionPath
    {Base : Type u} {Const : Ty Base → Type v}
    (source target : Expr Base Const) : Type (max u v) :=
  ConversionEvidence (BetaComputation Base Const)
    (index := ()) source target

/-- The explicit reflexivity constructor, with its computation fixed. -/
def reflexivePath
    {Base : Type u} {Const : Ty Base → Type v}
    (expression : Expr Base Const) : ConversionPath expression expression :=
  @ConversionEvidence.refl Unit (BetaComputation Base Const) () expression

/-- Forget the construction tree of an explicit path. -/
def pathToConv
    {Base : Type u} {Const : Ty Base → Type v}
    {source target : Expr Base Const} :
    ConversionPath source target → Conv source target
  | .step evidence =>
      match evidence with
      | .beta domain body argument => Conv.beta domain body argument
  | .refl expression => Conv.refl expression
  | .symm path => Conv.symm (pathToConv path)
  | .trans first second =>
      Conv.trans (pathToConv first) (pathToConv second)

/-- Every declarative conversion derivation merely inhabits the explicit path
type.  The result is `Nonempty` because a proof in `Prop` cannot select data in
`Type`. -/
theorem conv_hasPath
    {Base : Type u} {Const : Ty Base → Type v}
    {source target : Expr Base Const} :
    Conv source target → Nonempty (ConversionPath source target) := by
  intro conversion
  induction conversion with
  | beta domain body argument =>
      exact ⟨.step (.beta domain body argument)⟩
  | refl expression =>
      exact ⟨reflexivePath expression⟩
  | symm conversion induction =>
      rcases induction with ⟨path⟩
      exact ⟨.symm path⟩
  | trans first second firstInduction secondInduction =>
      rcases firstInduction with ⟨firstPath⟩
      rcases secondInduction with ⟨secondPath⟩
      exact ⟨.trans firstPath secondPath⟩

/-- Declarative conversion is exactly the propositional shadow of explicit
conversion evidence. -/
theorem conv_iff_nonempty_path
    {Base : Type u} {Const : Ty Base → Type v}
    {source target : Expr Base Const} :
    Conv source target ↔ Nonempty (ConversionPath source target) := by
  constructor
  · intro conversion
    exact conv_hasPath conversion
  · rintro ⟨path⟩
    exact pathToConv path

/-- A syntax-directed typing derivation followed by explicit conversion
evidence. -/
structure TypingReceipt
    {Base : Type u} {Const : Ty Base → Type v}
    (context : List (Expr Base Const))
    (term targetType : Expr Base Const) : Type (max u v) where
  sourceType : Expr Base Const
  typing : HasType context term sourceType
  conversion : ConversionPath sourceType targetType

/-- Every explicit typing receipt yields declarative typing with conversion. -/
def TypingReceipt.toHasTypeC
    {Base : Type u} {Const : Ty Base → Type v}
    {context : List (Expr Base Const)}
    {term targetType : Expr Base Const}
    (receipt : TypingReceipt context term targetType) :
    HasTypeC context term targetType :=
  .conv (.of receipt.typing) (pathToConv receipt.conversion)

/-- Every declarative converted typing derivation has an explicit receipt. -/
theorem HasTypeC.hasReceipt
    {Base : Type u} {Const : Ty Base → Type v}
    {context : List (Expr Base Const)}
    {term targetType : Expr Base Const}
    (typing : HasTypeC context term targetType) :
    Nonempty (TypingReceipt context term targetType) := by
  induction typing with
  | of coreTyping =>
      exact ⟨{
        sourceType := _
        typing := coreTyping
        conversion := reflexivePath _ }⟩
  | conv prior conversion induction =>
      rcases induction with ⟨receipt⟩
      rcases conv_hasPath conversion with ⟨conversionPath⟩
      exact ⟨{
        sourceType := receipt.sourceType
        typing := receipt.typing
        conversion := .trans receipt.conversion conversionPath }⟩

/-- Typing with declarative conversion is exactly existence of a
syntax-directed typing receipt carrying an explicit path. -/
theorem hasTypeC_iff_nonempty_receipt
    {Base : Type u} {Const : Ty Base → Type v}
    {context : List (Expr Base Const)}
    {term targetType : Expr Base Const} :
    HasTypeC context term targetType ↔
      Nonempty (TypingReceipt context term targetType) := by
  constructor
  · exact HasTypeC.hasReceipt
  · rintro ⟨receipt⟩
    exact receipt.toHasTypeC

/-! ## Positive and negative controls -/

/-- A root beta conversion has a one-node explicit receipt. -/
def directBetaPath
    {Base : Type u} {Const : Ty Base → Type v}
    (domain body argument : Expr Base Const) :
    ConversionPath
      (app (lam domain body) argument) (substAt 0 argument body) :=
  .step (.beta domain body argument)

/-- Reflexivity as one constructor. -/
def singleReflexivityPath
    {Base : Type u} {Const : Ty Base → Type v}
    (expression : Expr Base Const) : ConversionPath expression expression :=
  reflexivePath expression

/-- The same endpoints witnessed by a two-node composition tree. -/
def doubledReflexivityPath
    {Base : Type u} {Const : Ty Base → Type v}
    (expression : Expr Base Const) : ConversionPath expression expression :=
  .trans (reflexivePath expression) (reflexivePath expression)

/-- Proof-relevant receipts retain construction history even when their
declarative conversions coincide. -/
theorem singleReflexivityPath_ne_doubled
    {Base : Type u} {Const : Ty Base → Type v}
    (expression : Expr Base Const) :
    singleReflexivityPath expression ≠ doubledReflexivityPath expression := by
  intro equality
  cases equality

#print axioms conv_iff_nonempty_path
#print axioms HasTypeC.hasReceipt
#print axioms hasTypeC_iff_nonempty_receipt
#print axioms singleReflexivityPath_ne_doubled

end ConversionEvidenceBridge
end Mettapedia.Logic.HOL.Embedding.SimpleSliceOfDependent
