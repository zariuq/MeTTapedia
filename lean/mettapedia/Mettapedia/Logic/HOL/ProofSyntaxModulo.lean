import Mettapedia.Logic.HOL.ProofSyntax
import Mettapedia.Logic.HOL.Soundness

/-!
# Natural deduction modulo definitional conversion

A source theory may define constants by equations that its checker uses as
computation: `add n zero` and `n` are the same proposition index once the
definition is admitted.  The proofs of such a checker are natural-deduction
proofs of implication and universal quantification, together with a retyping
step along the definitional conversion of the source (deduction modulo).

The conversion is generated by beta and by the substitution instances of the
admitted defining equations, closed under the term constructors, and it is
taken between core terms: variables, constants, application, abstraction,
implication, equality and universal quantification.  A conversion article is
a finite zig-zag of such steps.

The logical rules coincide with the corresponding rules of `ProofSyntax`, and
a proof without retyping steps is exactly a proof of that fragment.  Every
proof is sound in each Henkin model that satisfies the equations.
-/

set_option autoImplicit false

namespace Mettapedia.Logic.HOL

universe u v w

variable {Base : Type u}

/-- A defining equation: both sides over the pattern telescope `context`. -/
structure DefiningEquation (Const : Ty Base → Type v) where
  context : Ctx Base
  type : Ty Base
  left : Term Const context type
  right : Term Const context type

variable {Const : Ty Base → Type v}

namespace Term

/-- Whether a term is core: built from variables, constants, application,
abstraction, implication, equality and universal quantification, the
constructors of the proof checker's term language. -/
def isCore : {Γ : Ctx Base} → {τ : Ty Base} → Term Const Γ τ → Bool
  | _, _, .var _ => true
  | _, _, .const _ => true
  | _, _, .app function argument => function.isCore && argument.isCore
  | _, _, .lam body => body.isCore
  | _, _, .imp left right => left.isCore && right.isCore
  | _, _, .eq left right => left.isCore && right.isCore
  | _, _, .all body => body.isCore
  | _, _, .top | _, _, .bot | _, _, .and _ _ | _, _, .or _ _ | _, _, .not _
  | _, _, .ex _ => false

end Term

/-- One definitional step: beta, or an instance of an admitted equation by a
substitution of core terms, closed under the core constructors. -/
inductive SourceStep (equations : List (DefiningEquation Const)) :
    {Γ : Ctx Base} → {τ : Ty Base} → Term Const Γ τ → Term Const Γ τ → Prop where
  | beta {Γ : Ctx Base} {σ τ : Ty Base} (body : Term Const (σ :: Γ) τ)
      (argument : Term Const Γ σ) :
      SourceStep equations (.app (.lam body) argument) (instantiate argument body)
  | delta {Γ : Ctx Base} (equation : DefiningEquation Const) (listed : equation ∈ equations)
      (substitution : Subst Const equation.context Γ)
      (core : ∀ {τ : Ty Base} (index : Var equation.context τ), (substitution index).isCore = true) :
      SourceStep equations (subst substitution equation.left) (subst substitution equation.right)
  | appFun {Γ : Ctx Base} {σ τ : Ty Base} {function function' : Term Const Γ (σ ⇒ τ)}
      (argument : Term Const Γ σ) :
      SourceStep equations function function' →
      SourceStep equations (.app function argument) (.app function' argument)
  | appArg {Γ : Ctx Base} {σ τ : Ty Base} (function : Term Const Γ (σ ⇒ τ))
      {argument argument' : Term Const Γ σ} :
      SourceStep equations argument argument' →
      SourceStep equations (.app function argument) (.app function argument')
  | lam {Γ : Ctx Base} {σ τ : Ty Base} {body body' : Term Const (σ :: Γ) τ} :
      SourceStep equations body body' → SourceStep equations (.lam body) (.lam body')
  | impLeft {Γ : Ctx Base} {left left' : Formula Const Γ} (right : Formula Const Γ) :
      SourceStep equations left left' → SourceStep equations (.imp left right) (.imp left' right)
  | impRight {Γ : Ctx Base} (left : Formula Const Γ) {right right' : Formula Const Γ} :
      SourceStep equations right right' → SourceStep equations (.imp left right) (.imp left right')
  | eqLeft {Γ : Ctx Base} {τ : Ty Base} {left left' : Term Const Γ τ}
      (right : Term Const Γ τ) :
      SourceStep equations left left' → SourceStep equations (.eq left right) (.eq left' right)
  | eqRight {Γ : Ctx Base} {τ : Ty Base} (left : Term Const Γ τ)
      {right right' : Term Const Γ τ} :
      SourceStep equations right right' → SourceStep equations (.eq left right) (.eq left right')
  | all {Γ : Ctx Base} {σ : Ty Base} {body body' : Formula Const (σ :: Γ)} :
      SourceStep equations body body' → SourceStep equations (.all body) (.all body')

/-- A step between core terms. -/
def CoreStep (equations : List (DefiningEquation Const)) {Γ : Ctx Base} {τ : Ty Base}
    (left right : Term Const Γ τ) : Prop :=
  left.isCore = true ∧ right.isCore = true ∧ SourceStep equations left right

/-- A conversion article: a finite zig-zag of core definitional steps. -/
abbrev CoreConversion (equations : List (DefiningEquation Const)) {Γ : Ctx Base} {τ : Ty Base}
    (left right : Term Const Γ τ) : Prop :=
  Relation.EqvGen (CoreStep equations) left right

/-- Related terms are equal, or both core. -/
theorem CoreConversion.eq_or_core {equations : List (DefiningEquation Const)}
    {Γ : Ctx Base} {τ : Ty Base} {left right : Term Const Γ τ}
    (conversion : CoreConversion equations left right) :
    left = right ∨ (left.isCore = true ∧ right.isCore = true) := by
  induction conversion with
  | rel _ _ step => exact Or.inr ⟨step.1, step.2.1⟩
  | refl => exact Or.inl rfl
  | symm _ _ _ ih =>
      rcases ih with same | ⟨leftCore, rightCore⟩
      · exact Or.inl same.symm
      · exact Or.inr ⟨rightCore, leftCore⟩
  | trans _ _ _ _ _ first second =>
      rcases first with same | ⟨leftCore, middleCore⟩
      · rcases second with same' | ⟨middleCore', rightCore⟩
        · exact Or.inl (same.trans same')
        · subst same
          exact Or.inr ⟨middleCore', rightCore⟩
      · rcases second with same' | ⟨_, rightCore⟩
        · subst same'
          exact Or.inr ⟨leftCore, middleCore⟩
        · exact Or.inr ⟨leftCore, rightCore⟩

/-- The proofs of a checker for implication and universal quantification
modulo the source's definitional conversion. -/
inductive ProofSyntaxModulo (equations : List (DefiningEquation Const)) :
    {Γ : Ctx Base} → List (Formula Const Γ) → Formula Const Γ → Type (max u v) where
  | hyp {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (occurrence : Fin Δ.length) :
      ProofSyntaxModulo equations Δ (Δ.get occurrence)
  | impI {Γ : Ctx Base} {Δ : List (Formula Const Γ)} {φ ψ : Formula Const Γ} :
      ProofSyntaxModulo equations (φ :: Δ) ψ → ProofSyntaxModulo equations Δ (.imp φ ψ)
  | impE {Γ : Ctx Base} {Δ : List (Formula Const Γ)} {φ ψ : Formula Const Γ} :
      ProofSyntaxModulo equations Δ (.imp φ ψ) → ProofSyntaxModulo equations Δ φ →
      ProofSyntaxModulo equations Δ ψ
  | allI {Γ : Ctx Base} {Δ : List (Formula Const Γ)}
      {σ : Ty Base} {φ : Formula Const (σ :: Γ)} :
      ProofSyntaxModulo equations (weakenHyps (Base := Base) (σ := σ) Δ) φ →
      ProofSyntaxModulo equations Δ (.all φ)
  | allE {Γ : Ctx Base} {Δ : List (Formula Const Γ)}
      {σ : Ty Base} {φ : Formula Const (σ :: Γ)} (t : Term Const Γ σ) :
      ProofSyntaxModulo equations Δ (.all φ) →
      ProofSyntaxModulo equations Δ (instantiate (Base := Base) t φ)
  | convert {Γ : Ctx Base} {Δ : List (Formula Const Γ)} {φ ψ : Formula Const Γ} :
      CoreConversion equations φ ψ → ProofSyntaxModulo equations Δ φ →
      ProofSyntaxModulo equations Δ ψ

namespace ProofSyntaxModulo

variable {equations : List (DefiningEquation Const)}

/-- Proofs of the logical fragment of `ProofSyntax` are proofs modulo any
equations, with no retyping step.  Other rules are outside the checker. -/
def ofProofSyntax? {Γ : Ctx Base} {Δ : List (Formula Const Γ)} {φ : Formula Const Γ} :
    ProofSyntax Const Δ φ → Option (ProofSyntaxModulo equations Δ φ)
  | .hyp occurrence => some (.hyp occurrence)
  | .impI body => (ofProofSyntax? body).map .impI
  | .impE function argument => do
      let function' ← ofProofSyntax? function
      let argument' ← ofProofSyntax? argument
      pure (.impE function' argument')
  | .allI body => (ofProofSyntax? body).map .allI
  | .allE term function => (ofProofSyntax? function).map (.allE term)
  | _ => none

/-- Whether a proof has no retyping step. -/
def conversionFree : {Γ : Ctx Base} → {Δ : List (Formula Const Γ)} → {φ : Formula Const Γ} →
    ProofSyntaxModulo equations Δ φ → Bool
  | _, _, _, .hyp _ => true
  | _, _, _, .impI body => body.conversionFree
  | _, _, _, .impE function argument => function.conversionFree && argument.conversionFree
  | _, _, _, .allI body => body.conversionFree
  | _, _, _, .allE _ function => function.conversionFree
  | _, _, _, .convert _ _ => false

/-- Whether a `ProofSyntax` proof uses only the rules the checker shares:
hypotheses, implication and universal quantification. -/
def logicalFragment : {Γ : Ctx Base} → {Δ : List (Formula Const Γ)} → {φ : Formula Const Γ} →
    ProofSyntax Const Δ φ → Bool
  | _, _, _, .hyp _ => true
  | _, _, _, .impI body => logicalFragment body
  | _, _, _, .impE function argument => logicalFragment function && logicalFragment argument
  | _, _, _, .allI body => logicalFragment body
  | _, _, _, .allE _ function => logicalFragment function
  | _, _, _, _ => false

/-- Embedding succeeds exactly on the logical fragment. -/
theorem ofProofSyntax?_isSome {Γ : Ctx Base} {Δ : List (Formula Const Γ)}
    {φ : Formula Const Γ} (proof : ProofSyntax Const Δ φ) :
    (ofProofSyntax? (equations := equations) proof).isSome = logicalFragment proof := by
  induction proof with
  | hyp occurrence => rfl
  | impI body ih => simp only [ofProofSyntax?, Option.isSome_map, logicalFragment, ih]
  | impE function argument ihFunction ihArgument =>
      rw [logicalFragment, ← ihFunction, ← ihArgument]
      cases hf : ofProofSyntax? (equations := equations) function <;>
        cases ha : ofProofSyntax? (equations := equations) argument <;>
          simp [ofProofSyntax?, hf, ha]
  | allI body ih => simp only [ofProofSyntax?, Option.isSome_map, logicalFragment, ih]
  | allE term function ih => simp only [ofProofSyntax?, Option.isSome_map, logicalFragment, ih]
  | _ => rfl

/-- An embedded proof has no retyping step. -/
theorem ofProofSyntax?_conversionFree {Γ : Ctx Base} {Δ : List (Formula Const Γ)}
    {φ : Formula Const Γ} (proof : ProofSyntax Const Δ φ)
    {embedded : ProofSyntaxModulo equations Δ φ}
    (success : ofProofSyntax? proof = some embedded) : embedded.conversionFree = true := by
  induction proof with
  | hyp occurrence =>
      simp only [ofProofSyntax?, Option.some.injEq] at success
      subst embedded
      rfl
  | impI body ih =>
      simp only [ofProofSyntax?] at success
      obtain ⟨body', hb, rfl⟩ := Option.map_eq_some_iff.mp success
      exact ih hb
  | impE function argument ihFunction ihArgument =>
      cases hf : ofProofSyntax? (equations := equations) function <;>
        cases ha : ofProofSyntax? (equations := equations) argument <;>
          simp [ofProofSyntax?, hf, ha] at success
      subst embedded
      simp [conversionFree, ihFunction hf, ihArgument ha]
  | allI body ih =>
      simp only [ofProofSyntax?] at success
      obtain ⟨body', hb, rfl⟩ := Option.map_eq_some_iff.mp success
      exact ih hb
  | allE term function ih =>
      simp only [ofProofSyntax?] at success
      obtain ⟨function', hf, rfl⟩ := Option.map_eq_some_iff.mp success
      exact ih hf
  | _ => simp [ofProofSyntax?] at success

/-- A proof without retyping steps is a proof of the logical fragment; a
retyping step changes the formula index, so it has no counterpart. -/
def toProofSyntax? : {Γ : Ctx Base} → {Δ : List (Formula Const Γ)} → {φ : Formula Const Γ} →
    ProofSyntaxModulo equations Δ φ → Option (ProofSyntax Const Δ φ)
  | _, _, _, .hyp occurrence => some (.hyp occurrence)
  | _, _, _, .impI body => body.toProofSyntax?.map .impI
  | _, _, _, .impE function argument => do
      let function' ← function.toProofSyntax?
      let argument' ← argument.toProofSyntax?
      pure (.impE function' argument')
  | _, _, _, .allI body => body.toProofSyntax?.map .allI
  | _, _, _, .allE term function => function.toProofSyntax?.map (.allE term)
  | _, _, _, .convert _ _ => none

/-- The projection is defined exactly on proofs without retyping steps. -/
theorem toProofSyntax?_isSome {Γ : Ctx Base} {Δ : List (Formula Const Γ)}
    {φ : Formula Const Γ} (proof : ProofSyntaxModulo equations Δ φ) :
    proof.toProofSyntax?.isSome = proof.conversionFree := by
  induction proof with
  | hyp occurrence => rfl
  | impI _ ih => simp only [toProofSyntax?, Option.isSome_map, conversionFree, ih]
  | impE function argument ihFunction ihArgument =>
      rw [conversionFree, ← ihFunction, ← ihArgument]
      cases hf : function.toProofSyntax? <;> cases ha : argument.toProofSyntax? <;>
        simp [toProofSyntax?, hf, ha]
  | allI _ ih => simp only [toProofSyntax?, Option.isSome_map, conversionFree, ih]
  | allE _ _ ih => simp only [toProofSyntax?, Option.isSome_map, conversionFree, ih]
  | convert _ _ _ => rfl

/-- Embedding then projecting returns the original `ProofSyntax` proof. -/
theorem toProofSyntax?_ofProofSyntax? {Γ : Ctx Base} {Δ : List (Formula Const Γ)}
    {φ : Formula Const Γ} (proof : ProofSyntax Const Δ φ)
    {embedded : ProofSyntaxModulo equations Δ φ}
    (success : ofProofSyntax? proof = some embedded) : embedded.toProofSyntax? = some proof := by
  induction proof with
  | hyp occurrence =>
      simp only [ofProofSyntax?, Option.some.injEq] at success
      subst embedded
      rfl
  | impI body ih =>
      simp only [ofProofSyntax?] at success
      obtain ⟨body', hb, rfl⟩ := Option.map_eq_some_iff.mp success
      simp [toProofSyntax?, ih hb]
  | impE function argument ihFunction ihArgument =>
      cases hf : ofProofSyntax? (equations := equations) function <;>
        cases ha : ofProofSyntax? (equations := equations) argument <;>
          simp [ofProofSyntax?, hf, ha] at success
      subst embedded
      simp [toProofSyntax?, ihFunction hf, ihArgument ha]
  | allI body ih =>
      simp only [ofProofSyntax?] at success
      obtain ⟨body', hb, rfl⟩ := Option.map_eq_some_iff.mp success
      simp [toProofSyntax?, ih hb]
  | allE term function ih =>
      simp only [ofProofSyntax?] at success
      obtain ⟨function', hf, rfl⟩ := Option.map_eq_some_iff.mp success
      simp [toProofSyntax?, ih hf]
  | _ => simp [ofProofSyntax?] at success

/-- Projecting then embedding returns the original proof modulo. -/
theorem ofProofSyntax?_toProofSyntax? {Γ : Ctx Base} {Δ : List (Formula Const Γ)}
    {φ : Formula Const Γ} (proof : ProofSyntaxModulo equations Δ φ)
    {projected : ProofSyntax Const Δ φ}
    (success : proof.toProofSyntax? = some projected) : ofProofSyntax? projected = some proof := by
  induction proof with
  | hyp occurrence =>
      simp only [toProofSyntax?, Option.some.injEq] at success
      subst projected
      rfl
  | impI body ih =>
      simp only [toProofSyntax?] at success
      obtain ⟨body', hb, rfl⟩ := Option.map_eq_some_iff.mp success
      simp [ofProofSyntax?, ih hb]
  | impE function argument ihFunction ihArgument =>
      cases hf : function.toProofSyntax? <;> cases ha : argument.toProofSyntax? <;>
        simp [toProofSyntax?, hf, ha] at success
      subst projected
      simp [ofProofSyntax?, ihFunction hf, ihArgument ha]
  | allI body ih =>
      simp only [toProofSyntax?] at success
      obtain ⟨body', hb, rfl⟩ := Option.map_eq_some_iff.mp success
      simp [ofProofSyntax?, ih hb]
  | allE term function ih =>
      simp only [toProofSyntax?] at success
      obtain ⟨function', hf, rfl⟩ := Option.map_eq_some_iff.mp success
      simp [ofProofSyntax?, ih hf]
  | convert _ _ _ => simp [toProofSyntax?] at success

end ProofSyntaxModulo

/-! ## Soundness in models of the equations -/

namespace Soundness

/-- A Henkin model satisfies an equation when both sides denote the same value
at every valuation of the pattern telescope. -/
def EquationsHold (M : HenkinModel.{u, v, w} Base Const)
    (equations : List (DefiningEquation Const)) : Prop :=
  ∀ equation ∈ equations, ∀ ρ : HenkinModel.Valuation M equation.context,
    HenkinModel.denote M equation.left ρ = HenkinModel.denote M equation.right ρ

theorem denote_instantiate_value (M : HenkinModel.{u, v, w} Base Const)
    {Γ : Ctx Base} {σ τ : Ty Base} (argument : Term Const Γ σ)
    (body : Term Const (σ :: Γ) τ) (ρ : HenkinModel.Valuation M Γ) :
    HenkinModel.denote M (instantiate (Base := Base) argument body) ρ =
      HenkinModel.denote M body (HenkinModel.extend M ρ (HenkinModel.denote M argument ρ)) := by
  rw [instantiate, denote_subst M (Subst.single argument) body ρ]
  congr 1
  funext τ index
  cases index <;> rfl

/-- A definitional step preserves denotation exactly, at every valuation. -/
theorem sourceStep_denote (M : HenkinModel.{u, v, w} Base Const)
    {equations : List (DefiningEquation Const)} (hold : EquationsHold M equations)
    {Γ : Ctx Base} {τ : Ty Base} {left right : Term Const Γ τ}
    (step : SourceStep equations left right) :
    ∀ ρ : HenkinModel.Valuation M Γ,
      HenkinModel.denote M left ρ = HenkinModel.denote M right ρ := by
  induction step with
  | beta body argument =>
      intro ρ
      rw [denote_instantiate_value]
      rfl
  | delta equation listed substitution _ =>
      intro ρ
      rw [denote_subst M substitution equation.left ρ, denote_subst M substitution equation.right ρ]
      exact hold equation listed _
  | appFun argument _ ih =>
      intro ρ
      exact congrFun (ih ρ) (HenkinModel.denote M argument ρ)
  | appArg function _ ih =>
      intro ρ
      exact congrArg (HenkinModel.denote M function ρ) (ih ρ)
  | lam _ ih =>
      intro ρ
      funext x
      exact ih (HenkinModel.extend M ρ x)
  | impLeft right _ ih =>
      intro ρ
      exact congrArg (fun p : Ty.denote M.Carrier .prop =>
        (ULift.up (p.down → (HenkinModel.denote M right ρ).down) : Ty.denote M.Carrier .prop))
        (ih ρ)
  | impRight left _ ih =>
      intro ρ
      exact congrArg (fun p : Ty.denote M.Carrier .prop =>
        (ULift.up ((HenkinModel.denote M left ρ).down → p.down) : Ty.denote M.Carrier .prop))
        (ih ρ)
  | @eqLeft Γ τ left left' right _ ih =>
      intro ρ
      exact congrArg (fun p : Ty.denote M.Carrier τ =>
        (ULift.up (HenkinModel.Eqv M τ p (HenkinModel.denote M right ρ)) :
          Ty.denote M.Carrier .prop))
        (ih ρ)
  | @eqRight Γ τ left right right' _ ih =>
      intro ρ
      exact congrArg (fun p : Ty.denote M.Carrier τ =>
        (ULift.up (HenkinModel.Eqv M τ (HenkinModel.denote M left ρ) p) :
          Ty.denote M.Carrier .prop))
        (ih ρ)
  | @all Γ σ body body' _ ih =>
      intro ρ
      have equal : (fun x => HenkinModel.denote M body (HenkinModel.extend M ρ x)) =
          (fun x => HenkinModel.denote M body' (HenkinModel.extend M ρ x)) :=
        funext fun x => ih (HenkinModel.extend M ρ x)
      exact congrArg (fun F : Ty.denote M.Carrier σ → Ty.denote M.Carrier .prop =>
        (ULift.up (∀ x, M.adm σ x → (F x).down) : Ty.denote M.Carrier .prop)) equal

/-- Conversion articles preserve denotation. -/
theorem coreConversion_denote (M : HenkinModel.{u, v, w} Base Const)
    {equations : List (DefiningEquation Const)} (hold : EquationsHold M equations)
    {Γ : Ctx Base} {τ : Ty Base} {left right : Term Const Γ τ}
    (conversion : CoreConversion equations left right) (ρ : HenkinModel.Valuation M Γ) :
    HenkinModel.denote M left ρ = HenkinModel.denote M right ρ := by
  induction conversion with
  | rel _ _ step => exact sourceStep_denote M hold step.2.2 ρ
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ first second => exact first.trans second

/-- Every proof modulo the equations is sound in each model of the equations. -/
theorem proofSyntaxModulo_sound {equations : List (DefiningEquation Const)}
    {Γ : Ctx Base} {Δ : List (Formula Const Γ)} {φ : Formula Const Γ}
    (proof : ProofSyntaxModulo equations Δ φ) :
    ∀ {M : HenkinModel.{u, v, w} Base Const}, EquationsHold M equations →
      ∀ {ρ : HenkinModel.Valuation M Γ}, HenkinModel.ValuationAdmissible M ρ →
        SatisfiesHyps M ρ Δ → (HenkinModel.denote M φ ρ).down := by
  induction proof with
  | hyp occurrence =>
      intro M _ ρ _ hΔ
      exact hΔ _ (List.get_mem _ occurrence)
  | impI _ ih =>
      intro M hold ρ hρ hΔ hφ
      exact ih hold hρ (by
        intro χ hχ
        rw [List.mem_cons] at hχ
        rcases hχ with rfl | hχ
        · exact hφ
        · exact hΔ _ hχ)
  | impE _ _ ihFunction ihArgument =>
      intro M hold ρ hρ hΔ
      exact (ihFunction hold hρ hΔ) (ihArgument hold hρ hΔ)
  | allI _ ih =>
      intro M hold ρ hρ hΔ x hx
      exact ih hold (PreModel.extend_admissible M.toPreModel hρ hx)
        (satisfies_weakenHyps M hΔ x)
  | allE term _ ih =>
      intro M hold ρ hρ hΔ
      have hall := ih hold hρ hΔ
      exact (denote_instantiate M term _ ρ).mpr
        (hall _ (M.term_closed term ρ hρ))
  | convert conversion _ ih =>
      intro M hold ρ hρ hΔ
      rw [← coreConversion_denote M hold conversion ρ]
      exact ih hold hρ hΔ

end Soundness

