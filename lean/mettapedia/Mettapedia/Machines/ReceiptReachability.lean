import Mathlib.Data.Finset.Basic

/-!
# Receipt-DAG reachability

Native Prime receipts form a directed acyclic graph: a newly allocated frame
may point to immediate parent frames, and every parent has strictly smaller
depth in the same receipt session.  This module isolates the reachability
relation that any receipt index must preserve.

The guarded query models only representation-independent fast paths:

* different sessions cannot be related;
* every frame reaches itself;
* a distinct target of equal or greater depth cannot be an ancestor;
* an immediate parent is an ancestor.

All other queries go to an abstract fallback.  `guardedQuery_exact` proves
that these decisions preserve any exact fallback.  It does not claim that a
particular C representation implements the abstract graph.

The final discriminator shows why depth is only a rejection/fast-accept aid,
not a complete ancestry index: a disconnected frame may be shallower and in
the same session without being an ancestor.
-/

namespace Mettapedia.Machines

/-- The representation-independent order carried by a receipt DAG. -/
structure ReceiptOrder (Frame : Type) where
  session : Frame → Nat
  depth : Frame → Nat
  parent : Frame → Frame → Prop
  parent_depth :
    ∀ {child direct}, parent child direct → depth direct < depth child
  parent_session :
    ∀ {child direct}, parent child direct → session child = session direct

/-- Reflexive ancestry generated by immediate receipt-parent edges. -/
inductive ReceiptAncestor {Frame : Type} (order : ReceiptOrder Frame) :
    Frame → Frame → Prop
  | refl (frame) : ReceiptAncestor order frame frame
  | step {child direct target} :
      order.parent child direct →
      ReceiptAncestor order direct target →
      ReceiptAncestor order child target

namespace ReceiptAncestor

variable {Frame Label : Type} {order : ReceiptOrder Frame}

/-- Every label preserved by immediate parent edges is preserved by arbitrary
receipt ancestry. -/
theorem invariant_eq
    (label : Frame → Label)
    (preserved :
      ∀ {child direct},
        order.parent child direct → label child = label direct)
    {child target : Frame}
    (reachable : ReceiptAncestor order child target) :
    label child = label target := by
  induction reachable with
  | refl => rfl
  | step edge _ inductionHypothesis =>
      exact (preserved edge).trans inductionHypothesis

/-- Receipt ancestry never crosses a session boundary. -/
theorem session_eq
    {child target : Frame}
    (reachable : ReceiptAncestor order child target) :
    order.session child = order.session target :=
  invariant_eq order.session
    (fun edge => order.parent_session edge) reachable

/-- An ancestor cannot be deeper than its descendant. -/
theorem depth_le
    {child target : Frame}
    (reachable : ReceiptAncestor order child target) :
    order.depth target ≤ order.depth child := by
  induction reachable with
  | refl => exact Nat.le_refl _
  | step edge _ inductionHypothesis =>
      exact inductionHypothesis.trans
        (Nat.le_of_lt (order.parent_depth edge))

/-- Every proper ancestor has strictly smaller depth. -/
theorem depth_lt_of_ne
    {child target : Frame}
    (reachable : ReceiptAncestor order child target)
    (different : child ≠ target) :
    order.depth target < order.depth child := by
  cases reachable with
  | refl => exact (different rfl).elim
  | step edge tail =>
      exact lt_of_le_of_lt
        (depth_le tail) (order.parent_depth edge)

/-- A distinct frame of equal or greater depth is not an ancestor. -/
theorem not_of_child_depth_le
    {child target : Frame}
    (different : child ≠ target)
    (depthReject : order.depth child ≤ order.depth target) :
    ¬ ReceiptAncestor order child target := by
  intro reachable
  exact (Nat.not_lt_of_ge depthReject)
    (depth_lt_of_ne reachable different)

/-- Every immediate receipt parent is an ancestor. -/
theorem of_parent
    {child target : Frame}
    (direct : order.parent child target) :
    ReceiptAncestor order child target :=
  .step direct (.refl target)

end ReceiptAncestor

variable {Frame : Type} (order : ReceiptOrder Frame)

/-- Add the four representation-independent native fast paths in front of an
arbitrary fallback query.  Null sentinels are outside this mathematical
carrier and remain an ABI concern. -/
def guardedReceiptQuery
    [DecidableEq Frame] [DecidableRel order.parent]
    (fallback : Frame → Frame → Bool)
    (child target : Frame) : Bool :=
  if order.session child ≠ order.session target then false
  else if child = target then true
  else if order.depth child ≤ order.depth target then false
  else if order.parent child target then true
  else fallback child target

/-- The native fast paths preserve any exact receipt-reachability fallback. -/
theorem guardedReceiptQuery_exact
    [DecidableEq Frame] [DecidableRel order.parent]
    (fallback : Frame → Frame → Bool)
    (fallbackExact :
      ∀ child target,
        fallback child target = true ↔
          ReceiptAncestor order child target) :
    ∀ child target,
      guardedReceiptQuery order fallback child target = true ↔
        ReceiptAncestor order child target := by
  intro child target
  unfold guardedReceiptQuery
  split
  next differentSession =>
    simp only [Bool.false_eq_true, false_iff]
    intro reachable
    exact differentSession (ReceiptAncestor.session_eq reachable)
  next sameSession =>
    split
    next same =>
      subst target
      exact ⟨fun _ => .refl child, fun _ => rfl⟩
    next different =>
      split
      next depthReject =>
        simp only [Bool.false_eq_true, false_iff]
        exact ReceiptAncestor.not_of_child_depth_le
          different depthReject
      next depthAllows =>
        split
        next direct =>
          exact
            ⟨fun _ => ReceiptAncestor.of_parent direct,
             fun _ => rfl⟩
        next indirect =>
          exact fallbackExact child target

/-- A candidate reachability index qualifies only by deciding the complete
receipt-ancestry relation.  Construction cost and query cost are separate
empirical tournament observations. -/
structure ExactReceiptIndex
    [DecidableEq Frame] [DecidableRel order.parent] where
  query : Frame → Frame → Bool
  exact :
    ∀ child target,
      query child target = true ↔ ReceiptAncestor order child target

namespace ExactReceiptIndex

/-- Guarding an exact candidate with the representation-independent fast
paths produces another exact candidate. -/
def guarded
    [DecidableEq Frame] [DecidableRel order.parent]
    (index : ExactReceiptIndex order) :
    ExactReceiptIndex order where
  query := guardedReceiptQuery order index.query
  exact := guardedReceiptQuery_exact order index.query index.exact

end ExactReceiptIndex

/-! ## A depth-only false positive -/

private inductive DemoFrame
  | root
  | left
  | right
  | join
  | orphan
  | outsider
deriving DecidableEq

namespace DemoFrame

def depth : DemoFrame → Nat
  | root | orphan | outsider => 0
  | left | right => 1
  | join => 2

def session : DemoFrame → Nat
  | outsider => 1
  | _ => 0

/-- A discriminator label not available to a depth-only query. -/
def component : DemoFrame → Nat
  | root | left | right | join => 0
  | orphan => 1
  | outsider => 2

def parent : DemoFrame → DemoFrame → Prop
  | left, root
  | right, root
  | join, left
  | join, right => True
  | _, _ => False

instance : DecidableRel parent := fun child direct => by
  cases child <;> cases direct <;>
    simp [parent] <;> infer_instance

theorem parent_depth
    {child direct : DemoFrame}
    (edge : parent child direct) :
    depth direct < depth child := by
  cases child <;> cases direct <;>
    simp [parent, depth] at edge ⊢

theorem parent_session
    {child direct : DemoFrame}
    (edge : parent child direct) :
    session child = session direct := by
  cases child <;> cases direct <;>
    simp [parent, session] at edge ⊢

theorem parent_component
    {child direct : DemoFrame}
    (edge : parent child direct) :
    component child = component direct := by
  cases child <;> cases direct <;>
    simp [parent, component] at edge ⊢

def graph : ReceiptOrder DemoFrame where
  session := session
  depth := depth
  parent := parent
  parent_depth := parent_depth
  parent_session := parent_session

/-- An intentionally inadequate candidate: session plus depth only. -/
def depthOnlyQuery (child target : DemoFrame) : Bool :=
  decide
    (session child = session target ∧
      depth target ≤ depth child)

/-- Positive sanity check for the real relation: the join reaches the root
through its left parent. -/
example : ReceiptAncestor graph join root := by
  apply ReceiptAncestor.step (order := graph) (direct := left)
  · simp [graph, parent]
  · apply ReceiptAncestor.step (order := graph) (direct := root)
    · simp [graph, parent]
    · exact ReceiptAncestor.refl root

/-- The depth-only candidate accepts a shallower frame in the same session. -/
example : depthOnlyQuery join orphan = true := by decide

/-- But that orphan lies in another receipt component and is not an ancestor.
This kills depth-only reachability as a complete candidate. -/
theorem join_not_reach_orphan :
    ¬ ReceiptAncestor graph join orphan := by
  intro reachable
  have sameComponent :=
    ReceiptAncestor.invariant_eq
      component parent_component reachable
  simp [component] at sameComponent

end DemoFrame

end Mettapedia.Machines
