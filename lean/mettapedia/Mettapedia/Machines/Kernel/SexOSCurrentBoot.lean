def selectedDomains (enabled : Domain → Bool) : List Domain :=
  domains ++ optionalDomains.filter enabled

theorem all_declared_domains_disjoint :
    ((domains ++ optionalDomains).map Domain.id).Nodup ∧
    ((domains ++ optionalDomains).map Domain.layout).Nodup := by decide

theorem selected_domains_disjoint (enabled : Domain → Bool) :
    ((selectedDomains enabled).map Domain.id).Nodup ∧
    ((selectedDomains enabled).map Domain.layout).Nodup := by
  have selected : (selectedDomains enabled).Sublist (domains ++ optionalDomains) :=
    List.filter_sublist.append_left domains
  exact ⟨List.Nodup.sublist (selected.map Domain.id) all_declared_domains_disjoint.1,
    List.Nodup.sublist (selected.map Domain.layout) all_declared_domains_disjoint.2⟩

