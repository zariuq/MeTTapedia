import Mettapedia.Machines.TIsa.X86AssemblerExecution
import Mettapedia.Machines.TIsa.X86MemoryAdapterStore
import Mettapedia.Machines.TIsa.X86P1InvalidCapture

/-!
# Shared p1 handlers generated by the checked assembler

The symbolic handler layout resolves two branches to one shared outcome tail,
which falls through into the allowance receipt block and the six restores. Its
generated bytes are checked against the suffix of every current p1 image.
Those checks feed the existing original-model handler contract. Whole-source
lowering and complete consumer execution remain separate obligations.
-/

set_option autoImplicit false

namespace Mettapedia.Machines.TIsa.X86AssemblerCapture
open _root_.X86Registers X86RegisterRefinement X86Execution X86Assembler
local instance : MemoryPrimitives := X86Memory.ordinary

def trailerChunks : List Chunk :=
  [.label 0,.bytes [0xb8,2,0,0,0],.branch none 3,
   .label 1,.bytes [0xb8,3,0,0,0],.branch none 3,
   .label 2,.bytes [0xb8,4,0,0,0],.label 3,
   .bytes (X86OutcomeTail.code.map (BitVec.ofNat 8)),.label 4,.bytes (X86AllowanceCall.exitCode.map (BitVec.ofNat 8))]

def trailerEmission : Emission :=
  ⟨[0xb8,2,0,0,0,0xe9,15,0,0,0,0xb8,3,0,0,0,0xe9,5,0,0,0,0xb8,4,0,0,0] ++
    X86OutcomeTail.code.map (BitVec.ofNat 8) ++ X86AllowanceCall.exitCode.map (BitVec.ofNat 8),
    [⟨5,none,3,25⟩,⟨15,none,3,25⟩]⟩

theorem trailer_assembled : assemble trailerChunks = some trailerEmission := by decide
theorem trailer_length : trailerEmission.bytes.length = 67 := by decide

def trailerMatches (program : P1Capture.Program) : Bool :=
  match assemble trailerChunks with
  | none => false
  | some output => decide (67 ≤ program.size) &&
      (List.finRange 67).all (fun index =>
        program.view.read (program.size - 67 + index.val) == output.bytes[index.val]?)

theorem all_trailers : ImportedP1.programs.all trailerMatches = true := by kernel_reflexivity

theorem trailer_matched (program : P1Capture.Program) (member : program ∈ ImportedP1.programs) :
    trailerMatches program = true := List.all_eq_true.mp all_trailers program member

theorem suffix_bytes (program : P1Capture.Program) (checked : trailerMatches program = true) :
    67 ≤ program.size ∧ ∀ index : Fin 67,
      program.view.read (program.size - 67 + index.val) = trailerEmission.bytes[index.val]? := by
  simp only [trailerMatches,trailer_assembled,Bool.and_eq_true,decide_eq_true_eq] at checked
  refine ⟨checked.1,?_⟩
  intro index
  exact beq_iff_eq.mp (List.all_eq_true.mp checked.2 index (by simp))

theorem trailer_placed (program : P1Capture.Program) (checked : trailerMatches program = true)
    (native : State) (base : Int) (loaded : X86P1LoadCapture.Loaded program native base) :
    X86CodePlacement.Placed native (base + (program.size - 67 : Nat)) (X86Assembler.view trailerEmission.bytes) := by
  obtain ⟨enough,bytes⟩ := suffix_bytes program checked
  intro index byte present
  change trailerEmission.bytes[index]? = some byte at present
  have within : index < 67 := by
    have bounded := (List.getElem?_eq_some_iff.mp present).1
    simpa only [trailer_length] using bounded
  have source := bytes ⟨index,within⟩
  rw [present] at source
  have observed := (loaded (program.size - 67 + index) (by omega)).trans source
  have shifted : address base (program.size - 67 + index) = address (base + (program.size - 67 : Nat)) index := by
    simp only [address,Nat.cast_add,Int.add_assoc]
  simpa only [shifted] using observed

theorem invalid_trailer_byte (index : Fin 29) :
    trailerEmission.bytes[10 + index.val]? =
      (X86P1InvalidCapture.code[index.val]?).map (BitVec.ofNat 8) := by
  fin_cases index <;> decide

theorem invalid_window (program : P1Capture.Program) (checked : trailerMatches program = true)
    (index : Fin 29) :
    program.view.read (program.size - 57 + index.val) =
      (X86P1InvalidCapture.code[index.val]?).map (BitVec.ofNat 8) := by
  obtain ⟨enough,bytes⟩ := suffix_bytes program checked
  have offset : program.size - 57 + index.val = program.size - 67 + (10 + index.val) := by omega
  rw [offset,bytes ⟨10 + index.val,by have := index.isLt; omega⟩]
  exact invalid_trailer_byte index

/-- The invalid-input entry of an image with the checked trailer: the `mov eax, 3` of the shared
failure block, fifty-seven bytes before the end. -/
def invalidAt (program : P1Capture.Program) : Nat := program.size - 57

theorem invalid_entry (program : P1Capture.Program) (checked : trailerMatches program = true) :
    program.view.read (invalidAt program) = some (0xb8#8) ∧ program.view.read (invalidAt program + 1) = some (3#8) := by
  have first := invalid_window program checked 0
  have second := invalid_window program checked 1
  exact ⟨first.trans (by decide), second.trans (by decide)⟩

theorem all_invalid_entries (program : P1Capture.Program) (member : program ∈ ImportedP1.programs) :
    program.view.read (invalidAt program) = some (0xb8#8) ∧ program.view.read (invalidAt program + 1) = some (3#8) :=
  invalid_entry program (trailer_matched program member)

theorem invalid_executes (other : OtherOpcodeHandlers) (vector : VectorOpcodeHandlers)
    (program : P1Capture.Program) (checked : trailerMatches program = true)
    (native : State) (base : Int) (origin : X86LegacyFetch.Basis native)
    (facts : X86FailureHandler.FrameFacts native)
    (location : origin.address.toInt = base + (program.size - 57 : Nat))
    (upper : base + program.size < (2 ^ 47 : Int))
    (loaded : X86P1LoadCapture.Loaded program native base)
    (apart : ∀ index < program.size,
      ((address base index).signExtend 52).toNat ∉ X86P1RefusedCapture.writes facts) :
    letI : OtherOpcodeHandlers := X86P1InvalidCapture.handlers other
    letI : VectorOpcodeHandlers := vector
    ∃ after, (X86FuelPrefix.fetches 4).run native = .ok () after ∧
      after.regs.get? .rip = some ((address base (program.size - 28)).signExtend 64) ∧
      lookup after 0 = some (3#64) ∧
      (∀ byte < 8, after.mem.get? (X86WriteWords.physicalAddress facts.statusAddress byte) =
        some ((3#64).extractLsb' (8 * byte) 8)) ∧
      (∀ byte < 8, after.mem.get? (X86WriteWords.physicalAddress facts.resultAddress byte) =
        some ((3#64).extractLsb' (8 * byte) 8)) ∧
      X86StateFrame.Frame {.rax,.rip} (X86P1RefusedCapture.writes facts) native after ∧
      after.regs.get? .rflags = some facts.flags ∧ X86P1LoadCapture.Loaded program after base := by
  have enough := (suffix_bytes program checked).1
  have run := X86P1InvalidCapture.image_executes other vector program (program.size - 57)
    (invalid_window program checked) (by omega) native base origin facts location upper loaded apart
  have coordinate : program.size - 57 + 29 = program.size - 28 := by omega
  simpa only [coordinate] using run

namespace Controls

/-- The formula of the previous epilogue, `size - 39`, lands inside the shared outcome store of
R_DERIVE_IS_PROP (the displacement byte `0x90` of `mov [rdi+0x90],rax`), not on `mov eax, 3`. -/
theorem previous_formula_refused :
    X86P1LoadCapture.propImage.view.read (X86P1LoadCapture.propImage.size - 39) = some (0x90#8) ∧
    invalidAt X86P1LoadCapture.propImage = 590 := by
  constructor
  · rw [X86P1LoadCapture.byte_extent]
    kernel_reflexivity
  · rw [invalidAt, X86P1LoadCapture.byte_extent]

private noncomputable abbrev entry := X86MemoryAdapterStore.Controls.entryFixture .fast 0
private noncomputable def before : State := X86Move.putPointer entry.native (address 4096 3726)

private noncomputable def origin : X86LegacyFetch.Basis before :=
  X86StateFrame.basisAt entry.native before entry.origin
    (X86StateFrame.registerOnly (pointer_frame entry.native (address 4096 3726))) (by decide)
    (address 4096 3726) (by decide) (by simp [before,X86Move.putPointer])

private theorem loaded :
    X86CodePlacement.Placed before 7807 (X86Assembler.view trailerEmission.bytes) := by
  have member : X86P1SibStoreCapture.image ∈ ImportedP1.programs :=
    List.getElem_mem (by rw [ImportedP1.exact_count.2]; decide)
  have placed := trailer_placed X86P1SibStoreCapture.image
    (trailer_matched X86P1SibStoreCapture.image member) before 4096 entry.loaded
  have coordinate : (4096 : Int) + (X86P1SibStoreCapture.image.size - 67 : Nat) = 7807 := by
    rw [X86P1SibStoreCapture.byte_extent]
    norm_num
  rw [coordinate] at placed
  exact placed

theorem native_jump (other : OtherOpcodeHandlers) (vector : VectorOpcodeHandlers) :
    letI : OtherOpcodeHandlers := X86UnconditionalJump.linked other
    letI : VectorOpcodeHandlers := vector
    Step before (X86Move.putPointer before (address 7807 25)) ∧
      RegisterFrame {.rip} before (X86Move.putPointer before (address 7807 25)) := by
  let : OtherOpcodeHandlers := X86UnconditionalJump.linked other
  let : VectorOpcodeHandlers := vector
  exact X86AssemblerExecution.assembled_jump other vector trailerChunks trailerEmission trailer_assembled
    ⟨15,none,3,25⟩ (by decide) rfl before 7807 origin (by decide) (by decide)
    (by change (address 4096 3726).toInt = (7807 : Int) + 15; decide) loaded
    (((pointer_frame entry.native (address 4096 3726)).registers .log_register_writes (by decide)).trans entry.quiet)

theorem wrong_target_refused (other : OtherOpcodeHandlers) (vector : VectorOpcodeHandlers) :
    letI : OtherOpcodeHandlers := X86UnconditionalJump.linked other
    letI : VectorOpcodeHandlers := vector
    ¬ Step before (X86Move.putPointer before (address 7807 26)) := by
  let : OtherOpcodeHandlers := X86UnconditionalJump.linked other
  let : VectorOpcodeHandlers := vector
  intro wrong
  have correct := (native_jump other vector).1
  have same := X86FuelPrefix.fetches_deterministic 1 before
    (X86Move.putPointer before (address 7807 25)) (X86Move.putPointer before (address 7807 26))
    (X86FuelPrefix.fetches_one _ _ correct) (X86FuelPrefix.fetches_one _ _ wrong)
  have observed := congrArg (fun state : State => state.regs.get? .rip) same
  simp only [X86Move.putPointer,Std.ExtDHashMap.get?_insert,beq_self_eq_true] at observed
  exact (by decide : (address 7807 25).signExtend 64 ≠ (address 7807 26).signExtend 64) (Option.some.inj observed)

end Controls

end Mettapedia.Machines.TIsa.X86AssemblerCapture
