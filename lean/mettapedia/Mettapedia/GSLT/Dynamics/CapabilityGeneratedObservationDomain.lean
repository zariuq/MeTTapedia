import Mettapedia.GSLT.Dynamics.ObservationDisciplineCrown

/-!
# Capability-generated operational observation domains

`WitnessCollector.Reachable` is the exact image of accepted finite event
histories.  A scheduler may additionally construct plans from already
collected histories: chronological composition uses the collector's declared
history algebra, while parallel composition is available only with an
independence witness supplied by the operational theory.

This module makes that larger *observation* domain explicit.  It does not
infer executable states from the carrier of a container, and it does not
infer independence from commutativity of a container operation.  Instead it
builds the least proof-relevant container construction generated by:

* an accepted event history;
* a defined chronological composition;
* a defined independently parallel composition carrying its authorization.

Policies and maximum-score schedulers are then characterized on an arbitrary
declared operational domain.  The earlier reachable-history criterion is
recovered exactly as one instance.
-/

namespace Mettapedia.GSLT.Dynamics

universe uEvent uContainer uValue uDecision uAuthority
universe uLeftEvent uRightEvent uLeftContainer uRightContainer
  uLeftValue uRightValue
universe uSourceEvent uTargetEvent

namespace WitnessCollector

/-- One authorized independent composition.  The authorization is
proof-relevant and remains separate from the container algebra equation. -/
structure IndependentCombination {Event : Type uEvent}
    (collector : WitnessCollector.{uEvent, uContainer} Event)
    (parallel : IndependentParallelCapability collector)
    (Independent : collector.Container → collector.Container → Type uAuthority)
    (first second result : collector.Container) where
  authorization : Independent first second
  combines : parallel.algebra.op first second = some result

/-- The least proof-relevant observation-container construction generated
from collected histories and the two explicitly supplied composition
capabilities.  Its terms justify membership of an observation domain; they
are not operational executions. -/
inductive CapabilityCollection {Event : Type uEvent}
    (collector : WitnessCollector.{uEvent, uContainer} Event)
    (chronological : ChronologicalCapability collector)
    (parallel : IndependentParallelCapability collector)
    (Independent : collector.Container → collector.Container → Type uAuthority) :
    collector.Container → Type (max uEvent uContainer uAuthority) where
  | history (events : List Event) {result : collector.Container}
      (collected : collector.collect events = some result) :
      CapabilityCollection collector chronological parallel Independent result
  | sequential {first second result : collector.Container} :
      CapabilityCollection collector chronological parallel Independent first →
      CapabilityCollection collector chronological parallel Independent second →
      chronological.algebra.op first second = some result →
      CapabilityCollection collector chronological parallel Independent result
  | independentlyParallel {first second result : collector.Container} :
      CapabilityCollection collector chronological parallel Independent first →
      CapabilityCollection collector chronological parallel Independent second →
      IndependentCombination collector parallel Independent first second result →
      CapabilityCollection collector chronological parallel Independent result

/-- Raw history reachability is closed under the declared chronological
operation.  This is a theorem from `collect_append`, not another assumption. -/
theorem reachable_of_chronological_op {Event : Type uEvent}
    {collector : WitnessCollector.{uEvent, uContainer} Event}
    (chronological : ChronologicalCapability collector)
    {first second result : collector.Container}
    (firstReachable : collector.Reachable first)
    (secondReachable : collector.Reachable second)
    (combines : chronological.algebra.op first second = some result) :
    collector.Reachable result := by
  obtain ⟨firstEvents, firstCollected⟩ := firstReachable
  obtain ⟨secondEvents, secondCollected⟩ := secondReachable
  refine ⟨firstEvents ++ secondEvents, ?_⟩
  rw [chronological.collect_append, firstCollected, secondCollected]
  exact combines

end WitnessCollector

namespace WitnessCollector.CapabilityCollection

/-- A capability construction over a pulled-back event stream realizes the
same container construction over the target stream.  Histories map along the
event translation; composition trees and independence evidence are retained
exactly. -/
def toTarget
    (eventMap : SourceEvent → TargetEvent)
    (collector : WitnessCollector.{uTargetEvent, uContainer} TargetEvent)
    (chronological : ChronologicalCapability collector)
    (parallel : IndependentParallelCapability collector)
    (Independent : collector.Container → collector.Container → Type uAuthority)
    {result : collector.Container}
    (construction : CapabilityCollection
      (ObservationTransport.WitnessCollector.pullback eventMap collector)
      (ObservationTransport.WitnessCollector.pullbackChronological
        eventMap collector chronological)
      (ObservationTransport.WitnessCollector.pullbackIndependentParallel
        eventMap collector parallel)
      Independent result) :
    CapabilityCollection collector chronological parallel Independent result :=
  match construction with
  | .history events collected => .history (events.map eventMap) collected
  | .sequential first second combines =>
      .sequential
        (toTarget eventMap collector chronological parallel Independent first)
        (toTarget eventMap collector chronological parallel Independent second)
        combines
  | .independentlyParallel first second combination =>
      .independentlyParallel
        (toTarget eventMap collector chronological parallel Independent first)
        (toTarget eventMap collector chronological parallel Independent second)
        { authorization := combination.authorization
          combines := combination.combines }

end WitnessCollector.CapabilityCollection

namespace ChronologicalCapability

/-- Synchronized product collectors inherit chronological composition
componentwise on common success.  This combines capabilities without
identifying the two retained coordinates. -/
def prod {Event : Type uEvent}
    {left : WitnessCollector.{uEvent, uContainer} Event}
    {right : WitnessCollector.{uEvent, uRightContainer} Event}
    (leftCapability : ChronologicalCapability left)
    (rightCapability : ChronologicalCapability right) :
    ChronologicalCapability (left.prod right) where
  algebra := leftCapability.algebra.prod rightCapability.algebra
  collect_nil := by
    change
      (left.collect []).bind (fun leftResult =>
        (right.collect []).bind
          (fun rightResult => some (leftResult, rightResult))) =
        some (leftCapability.algebra.unit, rightCapability.algebra.unit)
    rw [leftCapability.collect_nil, rightCapability.collect_nil]
    rfl
  collect_append := by
    intro first second
    change
      (left.collect (first ++ second)).bind (fun leftResult =>
        (right.collect (first ++ second)).bind
          (fun rightResult => some (leftResult, rightResult))) =
        ((left.collect first).bind (fun leftResult =>
          (right.collect first).bind
            (fun rightResult => some (leftResult, rightResult)))).bind
          (fun firstResult =>
            ((left.collect second).bind (fun leftResult =>
              (right.collect second).bind
                (fun rightResult => some (leftResult, rightResult)))).bind
              (fun secondResult =>
                (leftCapability.algebra.prod rightCapability.algebra).op
                  firstResult secondResult))
    rw [leftCapability.collect_append, rightCapability.collect_append]
    cases leftFirst : left.collect first <;>
      cases leftSecond : left.collect second <;>
      cases rightFirst : right.collect first <;>
      cases rightSecond : right.collect second <;>
      simp [Mettapedia.GSLT.PartialMonoid.prod]

end ChronologicalCapability

namespace IndependentParallelCapability

/-- Synchronized product collectors inherit independently parallel container
composition on common success only when both coordinates separately supply
that capability. -/
def prod {Event : Type uEvent}
    {left : WitnessCollector.{uEvent, uContainer} Event}
    {right : WitnessCollector.{uEvent, uRightContainer} Event}
    (leftCapability : IndependentParallelCapability left)
    (rightCapability : IndependentParallelCapability right) :
    IndependentParallelCapability (left.prod right) where
  algebra := leftCapability.algebra.prod rightCapability.algebra
  commutative := by
    rintro ⟨firstLeft, firstRight⟩ ⟨secondLeft, secondRight⟩
    change
      (leftCapability.algebra.op firstLeft secondLeft).bind (fun leftResult =>
        (rightCapability.algebra.op firstRight secondRight).bind
          (fun rightResult => some (leftResult, rightResult))) = _
    rw [leftCapability.commutative, rightCapability.commutative]
    rfl

end IndependentParallelCapability

namespace WitnessCollector

/-- Projecting a joint history to its left events preserves chronological
composition because projection preserves list concatenation. -/
def onLeftChronological
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    {collector : WitnessCollector.{uLeftEvent, uLeftContainer} LeftEvent}
    (capability : ChronologicalCapability collector) :
    ChronologicalCapability (collector.onLeft (RightEvent := RightEvent)) where
  algebra := capability.algebra
  collect_nil := capability.collect_nil
  collect_append := by
    intro first second
    change collector.collect (leftProjection (first ++ second)) =
      (collector.collect (leftProjection first)).bind (fun leftResult =>
        (collector.collect (leftProjection second)).bind (fun rightResult =>
          capability.algebra.op leftResult rightResult))
    rw [leftProjection_append, capability.collect_append]

/-- Symmetric chronological preservation for the right projection. -/
def onRightChronological
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    {collector : WitnessCollector.{uRightEvent, uRightContainer} RightEvent}
    (capability : ChronologicalCapability collector) :
    ChronologicalCapability (collector.onRight (LeftEvent := LeftEvent)) where
  algebra := capability.algebra
  collect_nil := capability.collect_nil
  collect_append := by
    intro first second
    change collector.collect (rightProjection (first ++ second)) =
      (collector.collect (rightProjection first)).bind (fun leftResult =>
        (collector.collect (rightProjection second)).bind (fun rightResult =>
          capability.algebra.op leftResult rightResult))
    rw [rightProjection_append, capability.collect_append]

/-- Projection does not change an already supplied parallel container
algebra.  Operational independence evidence is still supplied separately. -/
def onLeftIndependentParallel
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    {collector : WitnessCollector.{uLeftEvent, uLeftContainer} LeftEvent}
    (capability : IndependentParallelCapability collector) :
    IndependentParallelCapability
      (collector.onLeft (RightEvent := RightEvent)) where
  algebra := capability.algebra
  commutative := capability.commutative

/-- Symmetric parallel-capability preservation for the right projection. -/
def onRightIndependentParallel
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    {collector : WitnessCollector.{uRightEvent, uRightContainer} RightEvent}
    (capability : IndependentParallelCapability collector) :
    IndependentParallelCapability
      (collector.onRight (LeftEvent := LeftEvent)) where
  algebra := capability.algebra
  commutative := capability.commutative

end WitnessCollector

namespace ObservationDiscipline

/-! ## Arbitrary declared operational domains -/

/-- A declared operational domain contains at least every state produced by
an accepted history.  It may additionally contain states justified by
capability-indexed plan construction. -/
structure OperationalDomain {Event : Type uEvent}
    (discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event) where
  contains : discipline.collection.Container → Prop
  reachable_mem : ∀ {container},
    discipline.collection.Reachable container → contains container

namespace OperationalDomain

/-- The smallest flat operational domain: exactly the collector's history
image. -/
def reachable {Event : Type uEvent}
    (discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event) :
    discipline.OperationalDomain where
  contains := discipline.collection.Reachable
  reachable_mem := id

/-- The capability-generated observation domain forgets only the container
construction tree when used as a policy domain; `Nonempty` still requires a
complete construction.  This is not an operational execution certificate:
such a certificate must be supplied at the execution layer and observed into
this domain. -/
def capabilityGenerated {Event : Type uEvent}
    (discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event)
    (chronological : ChronologicalCapability discipline.collection)
    (parallel : IndependentParallelCapability discipline.collection)
    (Independent : discipline.collection.Container →
      discipline.collection.Container → Type uAuthority) :
    discipline.OperationalDomain where
  contains := fun container => Nonempty
    (WitnessCollector.CapabilityCollection discipline.collection chronological
      parallel Independent container)
  reachable_mem := by
    rintro container ⟨events, collected⟩
    exact ⟨.history events collected⟩

/-- Capability-generated reachability is preserved when a pulled-back event
stream is realized in its target stream. -/
theorem capabilityGenerated_pullback_subset
    (eventMap : SourceEvent → TargetEvent)
    (discipline : ObservationDiscipline.{uTargetEvent, uContainer, uValue}
      TargetEvent)
    (chronological : ChronologicalCapability discipline.collection)
    (parallel : IndependentParallelCapability discipline.collection)
    (Independent : discipline.collection.Container →
      discipline.collection.Container → Type uAuthority)
    {container : discipline.collection.Container}
    (member :
      (capabilityGenerated
        (ObservationTransport.ObservationDiscipline.pullback eventMap discipline)
        (ObservationTransport.WitnessCollector.pullbackChronological
          eventMap discipline.collection chronological)
        (ObservationTransport.WitnessCollector.pullbackIndependentParallel
          eventMap discipline.collection parallel)
        Independent).contains container) :
    (capabilityGenerated discipline chronological parallel Independent).contains
      container := by
  obtain ⟨construction⟩ := member
  exact ⟨WitnessCollector.CapabilityCollection.toTarget eventMap
    discipline.collection chronological parallel Independent construction⟩

/-- A policy is supported on a declared operational domain when it factors
through the readout for every state in that domain. -/
def SupportsPolicy {Event : Type uEvent}
    {discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event}
    (domain : discipline.OperationalDomain)
    (policy : discipline.collection.Container → Decision) : Prop :=
  ∃ observedPolicy : discipline.Value → Decision,
    ∀ {container}, domain.contains container →
      observedPolicy (discipline.readout container) = policy container

/-- Information criterion for policy support on a declared domain. -/
def PolicyConstantOnReadoutFibers {Event : Type uEvent}
    {discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event}
    (domain : discipline.OperationalDomain)
    (policy : discipline.collection.Container → Decision) : Prop :=
  ∀ {first second}, domain.contains first → domain.contains second →
    discipline.readout first = discipline.readout second →
    policy first = policy second

/-- Exact factorization criterion on any declared operational domain. -/
theorem supportsPolicy_iff_constantOnReadoutFibers
    {Event : Type uEvent} [Nonempty Decision]
    {discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event}
    (domain : discipline.OperationalDomain)
    (policy : discipline.collection.Container → Decision) :
    domain.SupportsPolicy policy ↔
      domain.PolicyConstantOnReadoutFibers policy := by
  constructor
  · rintro ⟨observedPolicy, agrees⟩ first second firstMember secondMember
      sameReadout
    rw [← agrees firstMember, ← agrees secondMember, sameReadout]
  · intro constant
    classical
    let fallback : Decision := Classical.choice inferInstance
    let observedPolicy : discipline.Value → Decision := fun value =>
      if member : ∃ container,
          domain.contains container ∧ discipline.readout container = value then
        policy (Classical.choose member)
      else
        fallback
    refine ⟨observedPolicy, ?_⟩
    intro container containerMember
    simp only [observedPolicy]
    split
    · rename_i member
      exact constant
        (Classical.choose_spec member).1 containerMember
        (Classical.choose_spec member).2
    · rename_i notMember
      exact False.elim (notMember ⟨container, containerMember, rfl⟩)

/-- Candidate type exposed to a scheduler for one declared domain. -/
abbrev Candidate {Event : Type uEvent}
    {discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event}
    (domain : discipline.OperationalDomain) :=
  { container : discipline.collection.Container // domain.contains container }

/-- Maximum-score selection over exactly the states admitted by a declared
operational domain. -/
def SupportsMaxSelection {Event : Type uEvent}
    {discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event}
    (domain : discipline.OperationalDomain)
    (score : discipline.collection.Container → Nat) : Prop :=
  Mettapedia.GSLT.Core.ObservationSupportsMaxSelection
    (fun container : domain.Candidate => discipline.readout container.1)
    (fun container => score container.1)

/-- Exact maximum-selection criterion on a declared operational domain. -/
theorem supportsMaxSelection_iff_constantOnReadoutFibers
    {Event : Type uEvent}
    {discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event}
    (domain : discipline.OperationalDomain)
    (score : discipline.collection.Container → Nat) :
    domain.SupportsMaxSelection score ↔
      domain.PolicyConstantOnReadoutFibers score := by
  unfold SupportsMaxSelection
  rw [Mettapedia.GSLT.Core.observationSupportsMaxSelection_iff]
  constructor
  · intro constant first second firstMember secondMember sameReadout
    exact constant
      (first := ⟨first, firstMember⟩)
      (second := ⟨second, secondMember⟩)
      sameReadout
  · intro constant first second sameReadout
    exact constant first.property second.property sameReadout

/-- Policy factorization and maximum-score selection have the same exact
information requirement on a declared domain. -/
theorem supportsMaxSelection_iff_supportsPolicy
    {Event : Type uEvent}
    {discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event}
    (domain : discipline.OperationalDomain)
    (score : discipline.collection.Container → Nat) :
    domain.SupportsMaxSelection score ↔ domain.SupportsPolicy score := by
  rw [supportsMaxSelection_iff_constantOnReadoutFibers,
    supportsPolicy_iff_constantOnReadoutFibers]

/-- The generic history-image domain recovers the earlier reachable-policy
definition exactly; this is one theory at two abstraction levels. -/
theorem reachable_supportsPolicy_iff {Event : Type uEvent}
    (discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event)
    (policy : discipline.collection.Container → Decision) :
    (reachable discipline).SupportsPolicy policy ↔
      discipline.SupportsReachablePolicy policy :=
  Iff.rfl

/-- The generic history-image scheduler likewise recovers the earlier exact
reachable maximum-selection definition. -/
theorem reachable_supportsMaxSelection_iff {Event : Type uEvent}
    (discipline : ObservationDiscipline.{uEvent, uContainer, uValue} Event)
    (score : discipline.collection.Container → Nat) :
    (reachable discipline).SupportsMaxSelection score ↔
      discipline.SupportsReachableMaxSelection score :=
  Iff.rfl

end OperationalDomain

/-- A composite mind inherits chronological collection exactly when both
component observers supply it. -/
def parallelCompositeChronological
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    (left : ObservationDiscipline.{uLeftEvent, uLeftContainer, uLeftValue}
      LeftEvent)
    (right : ObservationDiscipline.{uRightEvent, uRightContainer, uRightValue}
      RightEvent)
    (leftCapability : ChronologicalCapability left.collection)
    (rightCapability : ChronologicalCapability right.collection) :
    ChronologicalCapability (parallelComposite left right).collection :=
  ChronologicalCapability.prod
    (WitnessCollector.onLeftChronological
      (RightEvent := RightEvent) leftCapability)
    (WitnessCollector.onRightChronological
      (LeftEvent := LeftEvent) rightCapability)

/-- A composite mind inherits parallel collection only from two explicitly
supplied component capabilities. -/
def parallelCompositeIndependentParallel
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    (left : ObservationDiscipline.{uLeftEvent, uLeftContainer, uLeftValue}
      LeftEvent)
    (right : ObservationDiscipline.{uRightEvent, uRightContainer, uRightValue}
      RightEvent)
    (leftCapability : IndependentParallelCapability left.collection)
    (rightCapability : IndependentParallelCapability right.collection) :
    IndependentParallelCapability (parallelComposite left right).collection :=
  IndependentParallelCapability.prod
    (WitnessCollector.onLeftIndependentParallel
      (RightEvent := RightEvent) leftCapability)
    (WitnessCollector.onRightIndependentParallel
      (LeftEvent := LeftEvent) rightCapability)

/-- Product independence requires evidence in both observational
coordinates. -/
def ProductIndependent
    {left : ObservationDiscipline.{uLeftEvent, uLeftContainer, uLeftValue}
      LeftEvent}
    {right : ObservationDiscipline.{uRightEvent, uRightContainer, uRightValue}
      RightEvent}
    (LeftIndependent : left.collection.Container →
      left.collection.Container → Type uAuthority)
    (RightIndependent : right.collection.Container →
      right.collection.Container → Type uDecision)
    (first second :
      (parallelComposite left right).collection.Container) :
    Type (max uAuthority uDecision) :=
  LeftIndependent first.1 second.1 × RightIndependent first.2 second.2

/-- The capability-generated operational domain of a composite mind.  Both
component capabilities and both component independence witnesses are visible
in its construction. -/
def parallelCompositeCapabilityDomain
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    (left : ObservationDiscipline.{uLeftEvent, uLeftContainer, uLeftValue}
      LeftEvent)
    (right : ObservationDiscipline.{uRightEvent, uRightContainer, uRightValue}
      RightEvent)
    (leftChronological : ChronologicalCapability left.collection)
    (rightChronological : ChronologicalCapability right.collection)
    (leftParallel : IndependentParallelCapability left.collection)
    (rightParallel : IndependentParallelCapability right.collection)
    (LeftIndependent : left.collection.Container →
      left.collection.Container → Type uAuthority)
    (RightIndependent : right.collection.Container →
      right.collection.Container → Type uDecision) :
    (parallelComposite left right).OperationalDomain :=
  OperationalDomain.capabilityGenerated (parallelComposite left right)
    (parallelCompositeChronological left right
      leftChronological rightChronological)
    (parallelCompositeIndependentParallel left right leftParallel rightParallel)
    (ProductIndependent LeftIndependent RightIndependent)

end ObservationDiscipline

/-! ## Composite-mind reachability -/

@[simp] theorem leftProjection_map_inl
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    (events : List LeftEvent) :
    leftProjection (events.map (Sum.inl : LeftEvent → Sum LeftEvent RightEvent)) =
      events := by
  induction events <;> simp [*]

@[simp] theorem rightProjection_map_inl
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    (events : List LeftEvent) :
    rightProjection (events.map (Sum.inl : LeftEvent → Sum LeftEvent RightEvent)) =
      [] := by
  induction events <;> simp [*]

@[simp] theorem leftProjection_map_inr
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    (events : List RightEvent) :
    leftProjection (events.map (Sum.inr : RightEvent → Sum LeftEvent RightEvent)) =
      [] := by
  induction events <;> simp [*]

@[simp] theorem rightProjection_map_inr
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    (events : List RightEvent) :
    rightProjection (events.map (Sum.inr : RightEvent → Sum LeftEvent RightEvent)) =
      events := by
  induction events <;> simp [*]

namespace ObservationDiscipline

/-- The reachable states of a composite mind are exactly the product of the
states reachable by its component observers.  The proof constructs one joint
interleaving in the reverse direction and loses neither coordinate. -/
theorem parallelComposite_reachable_iff
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    (left : ObservationDiscipline.{uLeftEvent, uLeftContainer, uLeftValue}
      LeftEvent)
    (right : ObservationDiscipline.{uRightEvent, uRightContainer, uRightValue}
      RightEvent)
    (leftContainer : left.collection.Container)
    (rightContainer : right.collection.Container) :
    (parallelComposite left right).collection.Reachable
        (leftContainer, rightContainer) ↔
      left.collection.Reachable leftContainer ∧
        right.collection.Reachable rightContainer := by
  constructor
  · rintro ⟨events, collected⟩
    change
      (left.collection.collect (leftProjection events)).bind (fun leftResult =>
        (right.collection.collect (rightProjection events)).bind
          (fun rightResult => some (leftResult, rightResult))) =
        some (leftContainer, rightContainer) at collected
    cases leftEquation : left.collection.collect (leftProjection events) with
    | none =>
        simp [leftEquation] at collected
    | some actualLeft =>
        cases rightEquation :
            right.collection.collect (rightProjection events) with
        | none =>
            simp [leftEquation, rightEquation] at collected
        | some actualRight =>
            have pairEquality :
                (actualLeft, actualRight) = (leftContainer, rightContainer) := by
              simpa [leftEquation, rightEquation] using collected
            cases pairEquality
            exact
              ⟨⟨leftProjection events, leftEquation⟩,
                ⟨rightProjection events, rightEquation⟩⟩
  · rintro ⟨⟨leftEvents, leftCollected⟩,
      ⟨rightEvents, rightCollected⟩⟩
    refine ⟨leftEvents.map Sum.inl ++ rightEvents.map Sum.inr, ?_⟩
    change
      (left.collection.collect
          (leftProjection (leftEvents.map Sum.inl ++ rightEvents.map Sum.inr)
            )).bind (fun leftResult =>
        (right.collection.collect
          (rightProjection (leftEvents.map Sum.inl ++ rightEvents.map Sum.inr)
            )).bind (fun rightResult => some (leftResult, rightResult))) =
        some (leftContainer, rightContainer)
    simp [leftCollected, rightCollected]

/-- If either component state is unreachable, their pair is unreachable by
the composite.  A second observer cannot mint a missing witness. -/
theorem not_parallelComposite_reachable_of_left
    {LeftEvent : Type uLeftEvent} {RightEvent : Type uRightEvent}
    (left : ObservationDiscipline.{uLeftEvent, uLeftContainer, uLeftValue}
      LeftEvent)
    (right : ObservationDiscipline.{uRightEvent, uRightContainer, uRightValue}
      RightEvent)
    {leftContainer : left.collection.Container}
    {rightContainer : right.collection.Container}
    (notReachable : ¬ left.collection.Reachable leftContainer) :
    ¬ (parallelComposite left right).collection.Reachable
      (leftContainer, rightContainer) := by
  intro compositeReachable
  exact notReachable
    ((parallelComposite_reachable_iff left right leftContainer rightContainer).1
      compositeReachable).1

end ObservationDiscipline

/-! ## Capability controls -/

namespace CapabilityDomainCanary

open Mettapedia.Algebra

def unitWork : Unit → WorkSpan := fun _ => ⟨1, 1⟩

def permitAll (_ _ : WorkSpan) : Type := Unit
def refuseAll (_ _ : WorkSpan) : Type := Empty

def oneHistory
    (Independent : WorkSpan → WorkSpan → Type uAuthority) :
    WitnessCollector.CapabilityCollection
      (WorkSpanObservation.discipline unitWork).collection
      (WorkSpanObservation.chronological unitWork)
      (WorkSpanObservation.independentParallel unitWork)
      Independent ⟨1, 1⟩ :=
  .history [()] rfl

/-- Sequential construction remains available without any independence
certificate. -/
def sequentialTwoWithRefusal :
    WitnessCollector.CapabilityCollection
      (WorkSpanObservation.discipline unitWork).collection
      (WorkSpanObservation.chronological unitWork)
      (WorkSpanObservation.independentParallel unitWork)
      refuseAll ⟨2, 2⟩ :=
  .sequential (oneHistory refuseAll) (oneHistory refuseAll) rfl

/-- A supplied separation witness licenses the distinct parallel result. -/
def parallelTwoWithPermission :
    WitnessCollector.CapabilityCollection
      (WorkSpanObservation.discipline unitWork).collection
      (WorkSpanObservation.chronological unitWork)
      (WorkSpanObservation.independentParallel unitWork)
      permitAll ⟨2, 1⟩ :=
  .independentlyParallel (oneHistory permitAll) (oneHistory permitAll)
    ⟨(), rfl⟩

/-- Refusing independence makes the parallel composition article
uninhabitable, without affecting sequential container construction. -/
theorem refused_parallel_combination_is_empty :
    IsEmpty
      (WitnessCollector.IndependentCombination
        (WorkSpanObservation.discipline unitWork).collection
        (WorkSpanObservation.independentParallel unitWork)
        refuseAll ⟨1, 1⟩ ⟨1, 1⟩ ⟨2, 1⟩) :=
  ⟨fun combination => Empty.elim combination.authorization⟩

/-- The two justified constructions retain genuinely different schedule
values. -/
theorem sequential_and_parallel_results_differ :
    (⟨2, 2⟩ : WorkSpan) ≠ ⟨2, 1⟩ := by
  intro equal
  have spans := congrArg WorkSpan.span equal
  norm_num at spans

end CapabilityDomainCanary

