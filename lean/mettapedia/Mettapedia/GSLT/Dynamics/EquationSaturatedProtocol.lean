import Mettapedia.GSLT.Core.OperationalRealization
import Mettapedia.GSLT.Dynamics.ProofRelevantRelationProtocol

/-!
# Equation-saturated proof-relevant protocols

A proof-relevant transition relation and a static equation setoid determine a
standard saturated transition occurrence:

```text
source  ==  redex  --receipt-->  contractum  ==  target
```

This file constructs the corresponding equation-saturated GSLT and the
literal-equality dependent protocol retaining the complete occurrence.  Their
endpoint step relations agree exactly, while their static equation structures
need not.  The identity-on-terms operational translation therefore goes from
the literal protocol to the saturated GSLT; a converse requires a separate
equation-reflection hypothesis.

The construction is independent of a language syntax, type discipline,
process calculus, evaluator, cost model, or product integration.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Dynamics.EquationSaturatedProtocol

open Mettapedia.GSLT
open Mettapedia.GSLT.Core.InteractionEvent
open Mettapedia.GSLT.Dynamics.IndexedPolynomialProtocol
open Mettapedia.GSLT.Dynamics.ProofRelevantRelationProtocol
open Mettapedia.GSLT.IndexedOperational

universe uState uReceipt

variable {State : Type uState}

/-- One exact transition occurrence modulo a selected static equation
setoid.  The middle receipt remains proof relevant. -/
structure Occurrence (equations : Setoid State)
    (Raw : State -> State -> Type uReceipt) (source target : State) where
  redex : State
  contractum : State
  sourceEquation : equations.r source redex
  receipt : Raw redex contractum
  targetEquation : equations.r contractum target

namespace Occurrence

/-- Change only the displayed source representative of an occurrence. -/
def changeSource {equations : Setoid State}
    {Raw : State -> State -> Type uReceipt}
    {source source' target : State}
    (equivalent : equations.r source source')
    (occurrence : Occurrence equations Raw source target) :
    Occurrence equations Raw source' target where
  redex := occurrence.redex
  contractum := occurrence.contractum
  sourceEquation := equations.iseqv.trans
    (equations.iseqv.symm equivalent) occurrence.sourceEquation
  receipt := occurrence.receipt
  targetEquation := occurrence.targetEquation

/-- Change only the displayed target representative of an occurrence. -/
def changeTarget {equations : Setoid State}
    {Raw : State -> State -> Type uReceipt}
    {source target target' : State}
    (occurrence : Occurrence equations Raw source target)
    (equivalent : equations.r target target') :
    Occurrence equations Raw source target' where
  redex := occurrence.redex
  contractum := occurrence.contractum
  sourceEquation := occurrence.sourceEquation
  receipt := occurrence.receipt
  targetEquation := equations.iseqv.trans occurrence.targetEquation equivalent

/-- Every raw receipt embeds with reflexive outer equations. -/
def ofRaw {equations : Setoid State}
    {Raw : State -> State -> Type uReceipt}
    {source target : State} (receipt : Raw source target) :
    Occurrence equations Raw source target where
  redex := source
  contractum := target
  sourceEquation := equations.iseqv.refl source
  receipt := receipt
  targetEquation := equations.iseqv.refl target

end Occurrence

/-- The equation-saturated endpoint GSLT generated by a proof-relevant raw
transition relation. -/
def saturatedSystem (equations : Setoid State)
    (Raw : State -> State -> Type uReceipt) : GSLT where
  Term := State
  equations := equations
  rewrites := fun source target =>
    Nonempty (Occurrence equations Raw source target)
  rewrites_resp_left := by
    intro source source' target equivalent step
    obtain ⟨occurrence⟩ := step
    exact ⟨target, ⟨occurrence.changeSource equivalent⟩,
      equations.iseqv.refl target⟩
  rewrites_resp_right := by
    intro source target target' step equivalent
    obtain ⟨occurrence⟩ := step
    exact ⟨occurrence.changeTarget equivalent⟩

/-- The occurrence-retaining interaction face of the saturated GSLT. -/
def interaction (equations : Setoid State)
    (Raw : State -> State -> Type uReceipt) :
    InteractionPresentation (saturatedSystem equations Raw) where
  Site := Unit
  Event := fun _ source target => Occurrence equations Raw source target
  sound := fun occurrence => ⟨occurrence⟩

/-- The interaction face retains every saturated endpoint step. -/
theorem interaction_complete (equations : Setoid State)
    (Raw : State -> State -> Type uReceipt) :
    (interaction equations Raw).Complete := by
  intro source target step
  obtain ⟨occurrence⟩ := step
  exact ⟨⟨(), occurrence⟩⟩

/-- The canonical dependent protocol generated from saturated occurrences. -/
abbrev protocol (equations : Setoid State)
    (Raw : State -> State -> Type uReceipt) :=
  ProofRelevantRelationProtocol.protocol (Occurrence equations Raw)

/-- The endpoint GSLT of the canonical protocol.  Unlike `saturatedSystem`,
its static equation is literal equality. -/
abbrev protocolSystem (equations : Setoid State)
    (Raw : State -> State -> Type uReceipt) :=
  IndexedPolynomialProtocol.lts (protocol equations Raw)

/-- Protocol endpoint steps and equation-saturated endpoint steps agree for
every pair of states. -/
theorem protocol_step_iff_saturated_step
    (equations : Setoid State) (Raw : State -> State -> Type uReceipt)
    {source target : State} :
    (protocolSystem equations Raw).Step source target <->
      (saturatedSystem equations Raw).Step source target := by
  exact lts_step_iff (Occurrence equations Raw)

/-- Forget literal protocol equations into the selected static equations and
retain every endpoint step. -/
def protocolToSaturated (equations : Setoid State)
    (Raw : State -> State -> Type uReceipt) :
    OperationalTranslation (protocolSystem equations Raw)
      (saturatedSystem equations Raw) where
  mapTerm := id
  mapEquiv := by
    intro left right equal
    subst right
    exact equations.iseqv.refl left
  mapStep := protocol_step_iff_saturated_step equations Raw |>.mp

/-- The direct interaction face and the canonical protocol retain exactly the
same target-indexed saturated occurrences. -/
def protocolEventEquiv (equations : Setoid State)
    (Raw : State -> State -> Type uReceipt) (source : State) :
    (IndexedPolynomialProtocol.interaction (protocol equations Raw)).Enabled
        source ≃
      (interaction equations Raw).Enabled source :=
  (eventEquiv (Occurrence equations Raw) source).trans
    { toFun := fun outgoing =>
        { site := ()
          target := outgoing.1
          evidence := outgoing.2 }
      invFun := fun event => ⟨event.target, event.evidence⟩
      left_inv := by
        rintro ⟨target, occurrence⟩
        rfl
      right_inv := by
        rintro ⟨site, target, occurrence⟩
        cases site
        rfl }

/-! ## Controls -/

namespace Canary

/-- A nontrivial equation setoid that identifies both Boolean states. -/
def indiscreteBool : Setoid Bool where
  r := fun _ _ => True
  iseqv := ⟨fun _ => trivial, fun _ => trivial, fun _ _ => trivial⟩

/-- One raw occurrence, used to show that the construction is executable and
not merely an equation quotient. -/
inductive Tick : Bool -> Bool -> Type where
  | fire : Tick false true

def rawOccurrence : Occurrence indiscreteBool Tick false true :=
  Occurrence.ofRaw .fire

theorem raw_receipt_enters_both_faces :
    (protocolSystem indiscreteBool Tick).Step false true /\
      (saturatedSystem indiscreteBool Tick).Step false true := by
  constructor
  · exact (lts_step_iff (Occurrence indiscreteBool Tick)).2 ⟨rawOccurrence⟩
  · exact ⟨rawOccurrence⟩

/-- Exact operational agreement does not reflect a richer static equation
setoid back into the literal protocol equation. -/
theorem operational_agreement_does_not_reflect_equations :
    (forall source target,
      (protocolSystem indiscreteBool Tick).Step source target <->
        (saturatedSystem indiscreteBool Tick).Step source target) /\
      (saturatedSystem indiscreteBool Tick).Equiv false true /\
      Not ((protocolSystem indiscreteBool Tick).Equiv false true) := by
  refine ⟨fun _ _ => protocol_step_iff_saturated_step indiscreteBool Tick,
    trivial, ?_⟩
  exact Bool.false_ne_true

end Canary

/-! ## Axiom audit -/

#print axioms Occurrence.changeSource
#print axioms Occurrence.changeTarget
#print axioms interaction_complete
#print axioms protocol_step_iff_saturated_step
#print axioms protocolToSaturated
#print axioms protocolEventEquiv
#print axioms Canary.raw_receipt_enters_both_faces
#print axioms Canary.operational_agreement_does_not_reflect_equations

end Mettapedia.GSLT.Dynamics.EquationSaturatedProtocol
