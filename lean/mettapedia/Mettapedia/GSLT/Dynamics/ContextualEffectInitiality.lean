import Mathlib.CategoryTheory.Limits.Shapes.IsTerminal
import Mettapedia.GSLT.Dynamics.ContextualEffectHandlers

/-!
# Initial algebra of contextual choice and state computations

The free contextual computation generated by values, binary choice, state
observation, state replacement, and deferred intents is initial among algebras
carrying those five operations.  Consequently, an interpretation is determined
by its handling of the operations rather than by an implicit evaluation order.

The isolated-world and shared-state evaluators are two folds from this same
initial algebra.  They disagree on a small computation, so initiality does not
select either handler or erase their semantic distinction.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Dynamics.ContextualEffectInitiality

open CategoryTheory CategoryTheory.Limits
open ContextualEffectHandlers

universe u

/-- An interpretation of the five constructors of a contextual computation. -/
structure EffectAlgebra (State Answer Intent : Type u) where
  Carrier : Type u
  pure : Answer → Carrier
  choose : Carrier → Carrier → Carrier
  read : (State → Carrier) → Carrier
  write : State → Carrier → Carrier
  intent : Intent → Carrier → Carrier

namespace EffectAlgebra

variable {State Answer Intent : Type u}

/-- A map preserving every contextual-effect constructor. -/
@[ext]
structure Hom (A B : EffectAlgebra State Answer Intent) where
  toFun : A.Carrier → B.Carrier
  map_pure : ∀ answer,
    toFun (A.pure answer) = B.pure answer
  map_choose : ∀ left right,
    toFun (A.choose left right) = B.choose (toFun left) (toFun right)
  map_read : ∀ next,
    toFun (A.read next) = B.read (fun state => toFun (next state))
  map_write : ∀ state next,
    toFun (A.write state next) = B.write state (toFun next)
  map_intent : ∀ request next,
    toFun (A.intent request next) = B.intent request (toFun next)

instance {A B : EffectAlgebra State Answer Intent} :
    CoeFun (Hom A B) (fun _ => A.Carrier → B.Carrier) :=
  ⟨Hom.toFun⟩

@[ext]
theorem Hom.ext' {A B : EffectAlgebra State Answer Intent} (f g : Hom A B)
    (pointwise : ∀ value : A.Carrier, f.toFun value = g.toFun value) : f = g := by
  cases f with
  | mk f fp fc fr fw fi =>
      cases g with
      | mk g gp gc gr gw gi =>
          change ∀ value, f value = g value at pointwise
          have functionsEqual : f = g := funext pointwise
          subst g
          rfl

/-- Identity contextual-effect homomorphism. -/
def Hom.id (A : EffectAlgebra State Answer Intent) : Hom A A where
  toFun := fun value => value
  map_pure := by intros; rfl
  map_choose := by intros; rfl
  map_read := by intros; rfl
  map_write := by intros; rfl
  map_intent := by intros; rfl

/-- Composition of contextual-effect homomorphisms. -/
def Hom.comp {A B C : EffectAlgebra State Answer Intent}
    (f : Hom A B) (g : Hom B C) : Hom A C where
  toFun := fun value => g (f value)
  map_pure := by intro answer; rw [f.map_pure, g.map_pure]
  map_choose := by intro left right; rw [f.map_choose, g.map_choose]
  map_read := by intro next; rw [f.map_read, g.map_read]
  map_write := by intro state next; rw [f.map_write, g.map_write]
  map_intent := by intro request next; rw [f.map_intent, g.map_intent]

instance : Category (EffectAlgebra State Answer Intent) where
  Hom := Hom
  id := Hom.id
  comp := Hom.comp
  id_comp := by intros; ext; rfl
  comp_id := by intros; ext; rfl
  assoc := by intros; ext; rfl

/-- The algebra carried by the free contextual computation syntax. -/
def programAlgebra : EffectAlgebra State Answer Intent where
  Carrier := Program State Answer Intent
  pure := Program.pure
  choose := Program.choose
  read := Program.read
  write := Program.write
  intent := Program.intent

/-- Interpret a free computation in an arbitrary effect algebra. -/
def fold (A : EffectAlgebra State Answer Intent) :
    Program State Answer Intent → A.Carrier
  | .pure answer => A.pure answer
  | .choose left right => A.choose (fold A left) (fold A right)
  | .read next => A.read (fun state => fold A (next state))
  | .write state next => A.write state (fold A next)
  | .intent request next => A.intent request (fold A next)

@[simp] theorem fold_pure (A : EffectAlgebra State Answer Intent)
    (answer : Answer) : fold A (.pure answer) = A.pure answer := rfl

@[simp] theorem fold_choose (A : EffectAlgebra State Answer Intent)
    (left right : Program State Answer Intent) :
    fold A (.choose left right) = A.choose (fold A left) (fold A right) := rfl

@[simp] theorem fold_read (A : EffectAlgebra State Answer Intent)
    (next : State → Program State Answer Intent) :
    fold A (.read next) = A.read (fun state => fold A (next state)) := rfl

@[simp] theorem fold_write (A : EffectAlgebra State Answer Intent)
    (state : State) (next : Program State Answer Intent) :
    fold A (.write state next) = A.write state (fold A next) := rfl

@[simp] theorem fold_intent (A : EffectAlgebra State Answer Intent)
    (request : Intent) (next : Program State Answer Intent) :
    fold A (.intent request next) = A.intent request (fold A next) := rfl

/-- Every fold preserves the five constructors. -/
def foldHom (A : EffectAlgebra State Answer Intent) : programAlgebra ⟶ A where
  toFun := fold A
  map_pure := by intros; rfl
  map_choose := by intros; rfl
  map_read := by intros; rfl
  map_write := by intros; rfl
  map_intent := by intros; rfl

/-- A constructor-preserving interpretation of the free syntax is its fold. -/
theorem hom_eq_fold (A : EffectAlgebra State Answer Intent)
    (f : programAlgebra ⟶ A) : f = foldHom A := by
  apply Hom.ext'
  intro program
  change f.toFun program = fold A program
  induction program with
  | pure answer =>
      simpa [programAlgebra] using f.map_pure answer
  | choose left right leftIH rightIH =>
      calc
        f.toFun (.choose left right) =
            A.choose (f.toFun left) (f.toFun right) := by
          simpa [programAlgebra] using f.map_choose left right
        _ = A.choose (fold A left) (fold A right) := by
          rw [leftIH, rightIH]
        _ = fold A (.choose left right) := rfl
  | read next nextIH =>
      calc
        f.toFun (.read next) =
            A.read (fun state => f.toFun (next state)) := by
          simpa [programAlgebra] using f.map_read next
        _ = A.read (fun state => fold A (next state)) := by
          congr 1
          funext state
          exact nextIH state
        _ = fold A (.read next) := rfl
  | write state next nextIH =>
      calc
        f.toFun (.write state next) = A.write state (f.toFun next) := by
          simpa [programAlgebra] using f.map_write state next
        _ = A.write state (fold A next) := by rw [nextIH]
        _ = fold A (.write state next) := rfl
  | intent request next nextIH =>
      calc
        f.toFun (.intent request next) = A.intent request (f.toFun next) := by
          simpa [programAlgebra] using f.map_intent request next
        _ = A.intent request (fold A next) := by rw [nextIH]
        _ = fold A (.intent request next) := rfl

/-- Contextual computations are initial among algebras with the five declared
operations. -/
def programAlgebra_isInitial : IsInitial (programAlgebra (State := State)
    (Answer := Answer) (Intent := Intent)) :=
  IsInitial.ofUniqueHom foldHom (fun A f => hom_eq_fold A f)

/-! ## Two distinct interpretations of the same initial algebra -/

/-- The algebra of isolated alternatives with retained branch provenance. -/
def worldsAlgebra : EffectAlgebra State Answer Intent where
  Carrier := State → BranchTrace → List (WorldResult State Answer Intent)
  pure := fun answer state branch =>
    [{ branch := branch, answer := answer, state := state, intents := [] }]
  choose := fun left right state branch =>
    left state (false :: branch) ++ right state (true :: branch)
  read := fun next state branch => next state state branch
  write := fun newState next _parentState branch => next newState branch
  intent := fun request next state branch =>
    (next state branch).map fun result =>
      { result with intents := request :: result.intents }

/-- Isolated-world evaluation preserves the effect operations. -/
def runWorldsHom :
    (programAlgebra (State := State) (Answer := Answer) (Intent := Intent)) ⟶
      (worldsAlgebra (State := State) (Answer := Answer) (Intent := Intent)) where
  toFun := runWorldsAt
  map_pure := by intros; rfl
  map_choose := by intros; rfl
  map_read := by intros; rfl
  map_write := by intros; rfl
  map_intent := by intros; rfl

/-- Isolated-world evaluation is the unique fold into its algebra. -/
theorem fold_worlds_eq_runWorldsAt :
    fold (worldsAlgebra (State := State) (Answer := Answer) (Intent := Intent)) =
      runWorldsAt := by
  have equality := congrArg Hom.toFun
    (hom_eq_fold worldsAlgebra (runWorldsHom (State := State)
      (Answer := Answer) (Intent := Intent)))
  exact equality.symm

/-- The algebra of left-to-right alternatives communicating through one
shared state. -/
def sharedAlgebra : EffectAlgebra State Answer Intent where
  Carrier := State → SharedResult State Answer Intent
  pure := fun answer state =>
    { answers := [answer], state := state, intents := [] }
  choose := fun left right state =>
    let leftResult := left state
    let rightResult := right leftResult.state
    { answers := leftResult.answers ++ rightResult.answers
      state := rightResult.state
      intents := leftResult.intents ++ rightResult.intents }
  read := fun next state => next state state
  write := fun newState next _parentState => next newState
  intent := fun request next state =>
    let result := next state
    { result with intents := request :: result.intents }

/-- Shared-state evaluation preserves the effect operations. -/
def runSharedHom :
    (programAlgebra (State := State) (Answer := Answer) (Intent := Intent)) ⟶
      (sharedAlgebra (State := State) (Answer := Answer) (Intent := Intent)) where
  toFun := runShared
  map_pure := by intros; rfl
  map_choose := by intros; rfl
  map_read := by intros; rfl
  map_write := by intros; rfl
  map_intent := by intros; rfl

/-- Shared-state evaluation is the unique fold into its algebra. -/
theorem fold_shared_eq_runShared :
    fold (sharedAlgebra (State := State) (Answer := Answer) (Intent := Intent)) =
      runShared := by
  have equality := congrArg Hom.toFun
    (hom_eq_fold sharedAlgebra (runSharedHom (State := State)
      (Answer := Answer) (Intent := Intent)))
  exact equality.symm

/-! ## Separating controls -/

/-- Both operational policies are interpretations of one initial syntax. -/
theorem twoIncrements_has_both_initial_folds :
    fold (worldsAlgebra (State := Nat) (Answer := Nat) (Intent := Unit))
        Canary.twoIncrements 0 [] =
      runWorlds Canary.twoIncrements 0 ∧
    fold (sharedAlgebra (State := Nat) (Answer := Nat) (Intent := Unit))
        Canary.twoIncrements 0 =
      runShared Canary.twoIncrements 0 := by
  constructor
  · rw [fold_worlds_eq_runWorldsAt]
    rfl
  · rw [fold_shared_eq_runShared]

/-- Initiality does not collapse isolated alternatives into shared state. -/
theorem initial_folds_are_observably_distinct :
    (fold (worldsAlgebra (State := Nat) (Answer := Nat) (Intent := Unit))
        Canary.twoIncrements 0 []).map WorldResult.answer ≠
      (fold (sharedAlgebra (State := Nat) (Answer := Nat) (Intent := Unit))
        Canary.twoIncrements 0).answers := by
  rw [fold_worlds_eq_runWorldsAt, fold_shared_eq_runShared]
  decide

/-! ## Axiom audit -/

#print axioms programAlgebra_isInitial
#print axioms fold_worlds_eq_runWorldsAt
#print axioms fold_shared_eq_runShared
#print axioms twoIncrements_has_both_initial_folds
#print axioms initial_folds_are_observably_distinct

end EffectAlgebra

end Mettapedia.GSLT.Dynamics.ContextualEffectInitiality
