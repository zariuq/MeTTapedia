import Mathlib.CategoryTheory.Functor.Basic
import Mathlib.CategoryTheory.EqToHom
import Mettapedia.GSLT.Dynamics.IndexedEventValuation

/-!
# Event valuations as functors from free histories

An event valuation extends from individual events to finite histories by the
universal composition law of lists.  This file identifies the exact
categorical structure behind that extension.

* `EventHistory Event` is the one-object category whose arrows are finite
  event histories and whose composition is concatenation.
* `PartialMonoidDelooping algebra` is the one-object category whose arrows are
  optional grades and whose composition is the partial product lifted through
  `Option`.
* every `IndexedEventValuation.Valuation` induces a functor between them;
* the functor action is uniquely determined on every history by its values on
  singleton events.

This classifies chronological, cost, provenance, and revision valuations as
compositional decorations.  It does not identify any such decoration with a
denotational semantics, an execution witness, or an admission authority.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Dynamics.EventValuationFunctor

open CategoryTheory
open Mettapedia.GSLT
open Mettapedia.GSLT.Dynamics.IndexedEventValuation

universe uEvent uSourceEvent uGrade uLeft uRight

/-! ## The free history category -/

/-- The one-object category freely generated by an event type.  Its arrows
are finite chronological histories. -/
inductive EventHistory (Event : Type uEvent) : Type uEvent
  | point

namespace EventHistory

instance (Event : Type uEvent) : Category (EventHistory Event) where
  Hom _ _ := List Event
  id _ := []
  comp earlier later := earlier ++ later
  id_comp history := List.nil_append history
  comp_id history := List.append_nil history
  assoc first second third := List.append_assoc first second third

/-- The unique object of the event-history category. -/
abbrev object (Event : Type uEvent) : EventHistory Event := .point

@[simp] theorem id_eq_nil {Event : Type uEvent}
    (source : EventHistory Event) :
    (𝟙 source : source ⟶ source) = [] :=
  rfl

@[simp] theorem comp_eq_append {Event : Type uEvent}
    {source middle target : EventHistory Event}
    (earlier : source ⟶ middle) (later : middle ⟶ target) :
    earlier ≫ later =
      (show List Event from earlier) ++ (show List Event from later) :=
  rfl

/-- An event map extends uniquely to the corresponding functor between free
history categories. -/
def mapFunctor {SourceEvent : Type uSourceEvent} {Event : Type uEvent}
    (encode : SourceEvent → Event) :
    EventHistory SourceEvent ⥤ EventHistory Event where
  obj _ := object Event
  map history := history.map encode
  map_id _ := rfl
  map_comp first second := by simp

@[simp] theorem mapFunctor_obj
    {SourceEvent : Type uSourceEvent} {Event : Type uEvent}
    (encode : SourceEvent → Event) (source : EventHistory SourceEvent) :
    (mapFunctor encode).obj source = object Event :=
  rfl

@[simp] theorem mapFunctor_map
    {SourceEvent : Type uSourceEvent} {Event : Type uEvent}
    (encode : SourceEvent → Event)
    {source target : EventHistory SourceEvent}
    (history : source ⟶ target) :
    (mapFunctor encode).map history = history.map encode :=
  rfl

end EventHistory

/-! ## The Option-lifted delooping of a partial monoid -/

/-- The one-object category induced by a partial monoid.  Partial products
become ordinary categorical composition because failure is retained as
`none`. -/
inductive PartialMonoidDelooping {Grade : Type uGrade}
    (algebra : PartialMonoid Grade) : Type uGrade
  | point

namespace PartialMonoidDelooping

/-- Composition of optional grades in the delooping. -/
def compose {Grade : Type uGrade} (algebra : PartialMonoid Grade)
    (earlier later : Option Grade) : Option Grade :=
  earlier.bind fun left =>
    later.bind fun right =>
      algebra.op left right

@[simp] theorem compose_none_left {Grade : Type uGrade}
    (algebra : PartialMonoid Grade) (later : Option Grade) :
    compose algebra none later = none :=
  rfl

@[simp] theorem compose_none_right {Grade : Type uGrade}
    (algebra : PartialMonoid Grade) (earlier : Option Grade) :
    compose algebra earlier none = none := by
  cases earlier <;> rfl

theorem compose_unit_left {Grade : Type uGrade}
    (algebra : PartialMonoid Grade) (grade : Option Grade) :
    compose algebra (some algebra.unit) grade = grade := by
  cases grade with
  | none => rfl
  | some value => exact algebra.unit_op value

theorem compose_unit_right {Grade : Type uGrade}
    (algebra : PartialMonoid Grade) (grade : Option Grade) :
    compose algebra grade (some algebra.unit) = grade := by
  cases grade with
  | none => rfl
  | some value => exact algebra.op_unit value

theorem compose_assoc {Grade : Type uGrade}
    (algebra : PartialMonoid Grade)
    (first second third : Option Grade) :
    compose algebra (compose algebra first second) third =
      compose algebra first (compose algebra second third) := by
  cases first with
  | none => rfl
  | some firstValue =>
      cases second with
      | none => rfl
      | some secondValue =>
          cases third with
          | none => simp [compose]
          | some thirdValue =>
              exact algebra.op_assoc firstValue secondValue thirdValue

instance {Grade : Type uGrade} (algebra : PartialMonoid Grade) :
    Category (PartialMonoidDelooping algebra) where
  Hom _ _ := Option Grade
  id _ := some algebra.unit
  comp := compose algebra
  id_comp := compose_unit_left algebra
  comp_id := compose_unit_right algebra
  assoc := compose_assoc algebra

/-- The unique object of the partial-monoid delooping. -/
abbrev object {Grade : Type uGrade} (algebra : PartialMonoid Grade) :
    PartialMonoidDelooping algebra := .point

@[simp] theorem id_eq_unit {Grade : Type uGrade}
    (algebra : PartialMonoid Grade)
    (source : PartialMonoidDelooping algebra) :
    (𝟙 source : source ⟶ source) = some algebra.unit :=
  rfl

@[simp] theorem comp_eq_compose {Grade : Type uGrade}
    (algebra : PartialMonoid Grade)
    {source middle target : PartialMonoidDelooping algebra}
    (earlier : source ⟶ middle) (later : middle ⟶ target) :
    earlier ≫ later = compose algebra earlier later :=
  rfl

end PartialMonoidDelooping

/-! ## The functor classified by an event valuation -/

/-- A valuation extends to a functor from finite event histories to optional
grades. -/
def toHistoryFunctor {Event : Type uEvent}
    (valuation : Valuation.{uEvent, uGrade} Event) :
    EventHistory Event ⥤ (PartialMonoidDelooping valuation.algebra) where
  obj _ := PartialMonoidDelooping.object valuation.algebra
  map history := valuation.historyGrade history
  map_id _ := valuation.historyGrade_nil
  map_comp first second := valuation.historyGrade_append first second

/-- The functor action at the unique objects, exposed without implicit
endpoint arguments. -/
def functorGrade {Event : Type uEvent}
    (valuation : Valuation.{uEvent, uGrade} Event)
    (history : List Event) : Option valuation.Grade :=
  (toHistoryFunctor valuation).map
    (X := EventHistory.object Event) (Y := EventHistory.object Event) history

@[simp] theorem functorGrade_eq_historyGrade {Event : Type uEvent}
    (valuation : Valuation.{uEvent, uGrade} Event)
    (history : List Event) :
    functorGrade valuation history = valuation.historyGrade history :=
  rfl

@[simp] theorem functorGrade_nil {Event : Type uEvent}
    (valuation : Valuation.{uEvent, uGrade} Event) :
    functorGrade valuation [] = some valuation.algebra.unit :=
  valuation.historyGrade_nil

@[simp] theorem functorGrade_append {Event : Type uEvent}
    (valuation : Valuation.{uEvent, uGrade} Event)
    (first second : List Event) :
    functorGrade valuation (first ++ second) =
      PartialMonoidDelooping.compose valuation.algebra
        (functorGrade valuation first) (functorGrade valuation second) :=
  valuation.historyGrade_append first second

/-- A singleton history is valued exactly as its generating event. -/
@[simp] theorem functorGrade_singleton {Event : Type uEvent}
    (valuation : Valuation.{uEvent, uGrade} Event) (event : Event) :
    functorGrade valuation [event] = valuation.grade event := by
  change
    (valuation.grade event).bind (fun head =>
      (some valuation.algebra.unit).bind fun tail =>
        valuation.algebra.op head tail) = valuation.grade event
  cases eventGrade : valuation.grade event with
  | none => rfl
  | some grade =>
      simpa only [eventGrade, Option.bind_some] using valuation.algebra.op_unit grade

/-- Any functor out of the free history category whose singleton action is a
given event grading has the corresponding partial-monoid fold on every
history.  This is the generator-level uniqueness theorem. -/
theorem map_eq_foldOption_of_singletons
    {Event : Type uEvent} {Grade : Type uGrade}
    (algebra : PartialMonoid Grade)
    (grade : Event → Option Grade)
    (functor : EventHistory Event ⥤ (PartialMonoidDelooping algebra))
    (onSingleton : ∀ event,
      functor.map (X := EventHistory.object Event)
          (Y := EventHistory.object Event) [event] = grade event) :
    ∀ history : List Event,
      functor.map (X := EventHistory.object Event)
          (Y := EventHistory.object Event) history =
        algebra.foldOption grade history := by
  intro history
  induction history with
  | nil =>
      simpa only [PartialMonoid.foldOption_nil,
        EventHistory.id_eq_nil, PartialMonoidDelooping.id_eq_unit] using
        functor.map_id (EventHistory.object Event)
  | cons event rest inductionHypothesis =>
      have mappedComposition :
          functor.map (X := EventHistory.object Event)
              (Y := EventHistory.object Event) ([event] ++ rest) =
            PartialMonoidDelooping.compose algebra
              (functor.map (X := EventHistory.object Event)
                (Y := EventHistory.object Event) [event])
              (functor.map (X := EventHistory.object Event)
                (Y := EventHistory.object Event) rest) := by
        simpa only [EventHistory.comp_eq_append,
          PartialMonoidDelooping.comp_eq_compose] using
          functor.map_comp
            (X := EventHistory.object Event)
            (Y := EventHistory.object Event)
            (Z := EventHistory.object Event)
            ([event] : EventHistory.object Event ⟶ EventHistory.object Event)
            (rest : EventHistory.object Event ⟶ EventHistory.object Event)
      change
        functor.map (X := EventHistory.object Event)
            (Y := EventHistory.object Event) ([event] ++ rest) =
          algebra.foldOption grade (event :: rest)
      rw [mappedComposition, onSingleton event, inductionHypothesis]
      rfl

/-- Consequently the functor induced by a valuation is the unique history
action extending its singleton grades. -/
theorem map_eq_toHistoryFunctor_of_singletons
    {Event : Type uEvent}
    (valuation : Valuation.{uEvent, uGrade} Event)
    (functor : EventHistory Event ⥤
      (PartialMonoidDelooping valuation.algebra))
    (onSingleton : ∀ event,
      functor.map (X := EventHistory.object Event)
          (Y := EventHistory.object Event) [event] = valuation.grade event)
    (history : List Event) :
    functor.map (X := EventHistory.object Event)
        (Y := EventHistory.object Event) history =
      functorGrade valuation history := by
  rw [functorGrade_eq_historyGrade]
  exact map_eq_foldOption_of_singletons valuation.algebra valuation.grade
    functor onSingleton history

/-! ## Change of event vocabulary -/

/-- Pulling a valuation back through an event encoding is exactly
precomposition of its history functor by the freely generated history map. -/
theorem toHistoryFunctor_pullback
    {SourceEvent : Type uSourceEvent} {Event : Type uEvent}
    (valuation : Valuation.{uEvent, uGrade} Event)
    (encode : SourceEvent → Event) :
    toHistoryFunctor (valuation.pullback encode) =
      EventHistory.mapFunctor encode ⋙ toHistoryFunctor valuation := by
  refine CategoryTheory.Functor.ext (fun object => ?_) ?_
  · cases object
    rfl
  · intro source target history
    cases source
    cases target
    change
      (valuation.pullback encode).historyGrade
          (show List SourceEvent from history) =
        PartialMonoidDelooping.compose valuation.algebra
          (some valuation.algebra.unit)
          (PartialMonoidDelooping.compose valuation.algebra
            (valuation.historyGrade
              ((show List SourceEvent from history).map encode))
            (some valuation.algebra.unit))
    rw [valuation.pullback_historyGrade]
    simp [PartialMonoidDelooping.compose_unit_left,
      PartialMonoidDelooping.compose_unit_right]

/-- Pointwise form of functorial pullback, convenient for clients that retain
histories as lists. -/
@[simp] theorem functorGrade_pullback
    {SourceEvent : Type uSourceEvent} {Event : Type uEvent}
    (valuation : Valuation.{uEvent, uGrade} Event)
    (encode : SourceEvent → Event) (history : List SourceEvent) :
    functorGrade (valuation.pullback encode) history =
    functorGrade valuation (history.map encode) :=
  valuation.pullback_historyGrade encode history

/-- Product valuation synchronizes the two independent history readouts: a
joint grade exists exactly when both coordinates exist. -/
theorem functorGrade_prod
    {Event : Type uEvent}
    (left : Valuation.{uEvent, uLeft} Event)
    (right : Valuation.{uEvent, uRight} Event)
    (history : List Event) :
    functorGrade (left.prod right) history =
      (functorGrade left history).bind fun leftGrade =>
        (functorGrade right history).bind fun rightGrade =>
          some (leftGrade, rightGrade) :=
  left.prod_historyGrade right history

/-! ## Acceptance and rejection controls -/

namespace Canary

/-- A partial monoid that accepts at most one `true` contribution. -/
def exclusive : PartialMonoid Bool where
  unit := false
  op
    | false, value => some value
    | true, false => some true
    | true, true => none
  unit_op := by
    intro value
    cases value <;> rfl
  op_unit := by
    intro value
    cases value <;> rfl
  op_assoc := by
    intro first second third
    cases first <;> cases second <;> cases third <;> rfl

/-- Every event requests the exclusive capability. -/
def exclusiveValuation : Valuation Bool where
  Grade := Bool
  algebra := exclusive
  grade := fun _ => some true

theorem one_event_is_accepted :
    functorGrade exclusiveValuation [false] = some true := by
  rfl

/-- Functoriality preserves rejection: two individually accepted events need
not form an accepted composite in a partial algebra. -/
theorem two_events_are_rejected :
    functorGrade exclusiveValuation [false, true] = none := by
  rfl

/-- The precomposition map is load-bearing: two event encodings can induce
different pulled-back valuation functors. -/
theorem distinct_encodings_are_observable :
    functorGrade
        ((chronological (fun value : Bool => value)).pullback
          (fun _ : Unit => false)) [()] ≠
      functorGrade
        ((chronological (fun value : Bool => value)).pullback
          (fun _ : Unit => true)) [()] := by
  simp [chronologicalListPartialMonoid]

/-- An independent chronological coordinate used to distinguish synchronized
product from the categorical product of the two target categories. -/
def rightHistoryValuation : Valuation Bool :=
  chronological (fun _ => ())

theorem synchronized_product_rejects_two_events :
    functorGrade
      (exclusiveValuation.prod rightHistoryValuation) [false, true] = none :=
  rfl

theorem right_coordinate_accepts_two_events :
    functorGrade rightHistoryValuation [false, true] = some [(), ()] :=
  rfl

/-- No function of the synchronized product grade can recover the independent
right-hand history valuation in general.  Two rejected joint histories retain
different right-hand counts. -/
theorem no_independent_right_projection :
    ¬ ∃ project : Option (Bool × List Unit) → Option (List Unit),
      ∀ history : List Bool,
        project (functorGrade
          (exclusiveValuation.prod rightHistoryValuation) history) =
          functorGrade rightHistoryValuation history := by
  rintro ⟨project, recovers⟩
  have two := recovers [false, true]
  have three := recovers [false, true, false]
  change project none = some [(), ()] at two
  change project none = some [(), (), ()] at three
  rw [two] at three
  simp at three

end Canary

