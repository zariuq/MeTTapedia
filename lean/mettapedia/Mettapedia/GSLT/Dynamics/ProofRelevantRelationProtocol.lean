import Mettapedia.GSLT.Dynamics.IndexedPolynomialProtocol

/-!
# Proof-relevant relations as response-indexed protocols

A proof-relevant transition relation has a canonical protocol-polynomial
reading.  At a source state there is one command exactly when an outgoing
transition exists; its responses are all target-and-receipt pairs; and the
successor is the selected target.

The resulting endpoint GSLT has exactly the propositional truncation of the
original relation as its step relation.  Its interaction presentation retains
the complete target and transition receipt.  A complete protocol round is a
dependent handler for every outgoing occurrence, not merely every distinct
endpoint.

The negative control has two receipts with the same endpoints.  Endpoint
semantics sees one self-loop, while the interaction fibre and a receipt tag
still distinguish the occurrences.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Dynamics.ProofRelevantRelationProtocol

open Mettapedia.GSLT
open Mettapedia.GSLT.Core.InteractionEvent
open Mettapedia.GSLT.Core.NonFactorization
open Mettapedia.GSLT.Dynamics.IndexedPolynomialProtocol

universe uState uReceipt uResult

variable {State : Type uState}
variable (Step : State -> State -> Type uReceipt)

/-- One outgoing transition together with its exact target and receipt. -/
abbrev Outgoing (source : State) :=
  Sigma (fun target => Step source target)

/-- A Type-valued witness that a state has at least one outgoing occurrence. -/
abbrev HasOutgoing (source : State) :=
  PLift (Nonempty (Outgoing Step source))

instance hasOutgoingSubsingleton (source : State) :
    Subsingleton (HasOutgoing Step source) where
  allEq left right := by
    cases left
    cases right
    rfl

/-- The response-indexed protocol canonically generated by a proof-relevant
transition relation. -/
def protocol : ProtocolPolynomial State where
  Shape := fun _ source => HasOutgoing Step source
  Position := fun {_base} {source} _command => Outgoing Step source
  next := fun {_base} {_source} _command outgoing => outgoing.1

/-- Any concrete outgoing occurrence enables the unique available command. -/
def commandOfOutgoing {source : State} (outgoing : Outgoing Step source) :
    Command (protocol Step) source :=
  PLift.up ⟨outgoing⟩

theorem command_eq {source : State}
    (left right : Command (protocol Step) source) : left = right := by
  change HasOutgoing Step source at left right
  exact Subsingleton.elim left right

/-- Retain an outgoing occurrence as an enabled protocol event. -/
def eventOfOutgoing {source : State} (outgoing : Outgoing Step source) :
    (interaction (protocol Step)).Enabled source :=
  enabled (protocol Step) (commandOfOutgoing Step outgoing) outgoing

/-- Enabled protocol events are exactly outgoing transition occurrences.  The
command only certifies nonemptiness and introduces no additional identity. -/
def eventEquiv (source : State) :
    (interaction (protocol Step)).Enabled source ≃ Outgoing Step source where
  toFun event := (enabledEquiv (protocol Step) source event).2
  invFun := eventOfOutgoing Step
  left_inv := by
    rintro ⟨site, target, evidence⟩
    cases site
    cases evidence with
    | fire command outgoing =>
        apply (enabledEquiv (protocol Step) source).injective
        apply Sigma.ext
        · exact command_eq Step _ _
        · rfl
  right_inv := by
    rintro ⟨target, receipt⟩
    rfl

/-- Endpoint transitions of the generated protocol are exactly inhabited
transition-receipt fibres of the source relation. -/
theorem lts_step_iff {source target : State} :
    (lts (protocol Step)).Step source target <->
      Nonempty (Step source target) := by
  constructor
  · rintro ⟨move⟩
    cases move with
    | fire _command outgoing =>
        exact ⟨outgoing.2⟩
  · rintro ⟨receipt⟩
    let outgoing : Outgoing Step source := ⟨target, receipt⟩
    exact ⟨Move.fire (protocol := protocol Step)
      (commandOfOutgoing Step outgoing) outgoing⟩

/-- A complete response handler and one witness of availability form a
dependent round.  The handler is indexed by the exact target selected by each
transition receipt. -/
def roundOf {Result : State -> Type uResult} {source : State}
    (available : Outgoing Step source)
    (handle : (outgoing : Outgoing Step source) -> Result outgoing.1) :
    OneRound (protocol Step) Result source :=
  ⟨commandOfOutgoing Step available, handle⟩

/-- Selecting an outgoing occurrence from a relation-generated round retains
that exact occurrence and its correctly indexed result. -/
@[simp] theorem select_roundOf
    {Result : State -> Type uResult} {source : State}
    (available outgoing : Outgoing Step source)
    (handle : (move : Outgoing Step source) -> Result move.1) :
    (selectResponse (protocol Step) (roundOf Step available handle) outgoing).2 =
      handle outgoing :=
  rfl

/-- A unit-result complete round exists exactly when the source state has an
outgoing transition occurrence. -/
theorem unitRound_nonempty_iff (source : State) :
    Nonempty (OneRound (protocol Step) (fun _ => PUnit) source) <->
      Nonempty (Outgoing Step source) := by
  constructor
  · rintro ⟨round⟩
    exact round.1.down
  · rintro ⟨outgoing⟩
    exact ⟨roundOf Step outgoing (fun _ => PUnit.unit)⟩

/-! ## Same-endpoint receipt control -/

namespace ReceiptCanary

/-- Two primitive occurrences have exactly the same source and target. -/
inductive Receipt : Unit -> Unit -> Type where
  | first : Receipt () ()
  | second : Receipt () ()

def firstOutgoing : Outgoing Receipt () := ⟨(), .first⟩
def secondOutgoing : Outgoing Receipt () := ⟨(), .second⟩

def firstEvent : (interaction (protocol Receipt)).Enabled () :=
  eventOfOutgoing Receipt firstOutgoing

def secondEvent : (interaction (protocol Receipt)).Enabled () :=
  eventOfOutgoing Receipt secondOutgoing

def receiptTag (event : (interaction (protocol Receipt)).Enabled ()) : Bool :=
  match (eventEquiv Receipt () event).2 with
  | .first => false
  | .second => true

@[simp] theorem first_receiptTag : receiptTag firstEvent = false :=
  rfl

@[simp] theorem second_receiptTag : receiptTag secondEvent = true :=
  rfl

/-- Receipt identity survives even when both occurrences have the same
endpoint. -/
theorem distinct_events_same_endpoint :
    firstEvent ≠ secondEvent /\
      firstEvent.target = secondEvent.target := by
  constructor
  · intro equalEvents
    have equalTags := congrArg receiptTag equalEvents
    exact Bool.false_ne_true equalTags
  · rfl

/-- Endpoint erasure cannot reconstruct an occurrence tag. -/
theorem receiptTag_not_endpoint_determined :
    ¬ Factors
      (fun event : (interaction (protocol Receipt)).Enabled () => event.target)
      receiptTag := by
  let fibre : NonTrivialFiber
      (fun event : (interaction (protocol Receipt)).Enabled () => event.target)
      receiptTag :=
    { left := firstEvent
      right := secondEvent
      sameShadow := rfl
      differentValue := Bool.false_ne_true }
  exact fibre.not_factors

/-- The proposition-valued endpoint GSLT is inhabited while the complete
interaction fibre retains two distinct receipts. -/
theorem relation_protocol_boundary :
    (lts (protocol Receipt)).Step () () /\
      firstEvent ≠ secondEvent /\
      ¬ Factors
        (fun event : (interaction (protocol Receipt)).Enabled () => event.target)
        receiptTag :=
  ⟨(lts_step_iff Receipt).2 ⟨Receipt.first⟩,
    distinct_events_same_endpoint.1,
    receiptTag_not_endpoint_determined⟩

end ReceiptCanary

/-! ## Axiom audit -/

#print axioms eventEquiv
#print axioms lts_step_iff
#print axioms select_roundOf
#print axioms unitRound_nonempty_iff
#print axioms ReceiptCanary.distinct_events_same_endpoint
#print axioms ReceiptCanary.receiptTag_not_endpoint_determined
#print axioms ReceiptCanary.relation_protocol_boundary

end Mettapedia.GSLT.Dynamics.ProofRelevantRelationProtocol
