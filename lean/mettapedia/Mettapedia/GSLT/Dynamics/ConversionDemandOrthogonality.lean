import Mettapedia.TypeTheory.FreeConversion
import Mettapedia.GSLT.Dynamics.ProofRelevantNeedOwnership
import Mettapedia.GSLT.Dynamics.ProofRelevantNeedProfile

/-!
# Orthogonality of judgmental conversion and operational demand

Judgmental conversion and call-by-need answer different questions.
Conversion compares typed states inside one judgment fibre.  Demand records
when a suspension is evaluated, cached, observed, retried, and owned.  This
module packages the two axes without imposing an accidental dependency and
then supplies countermodels to both possible functional-dependence claims.

* One fixed conversion computation supports both a value-only demand
  fragment and a retry-capable fragment.
* One fixed demand fragment supports both discrete conversion and a
  conversion computation relating distinct states.

Thus conversion cannot determine demand behavior, and demand behavior cannot
determine conversion.  Revision identity is treated as immutable suspension
origin data: once a cell is live, every exact trace preserves that identity.
Changing revision therefore requires a fresh cell rather than mutation of an
existing suspension.  Evaluation ownership remains a separate, erasable
coordinate whose mismatch prevents commit.

No object-language syntax, universe hierarchy, evaluator, or distinguished
calculus is selected here.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Dynamics.ConversionDemandOrthogonality

open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.JudgmentalEquality
open Mettapedia.GSLT.Dynamics.ProofRelevantNeed
open Mettapedia.GSLT.IndexedOperational

universe uIndex uState uStep uRevision uOrigin uCell uValue uStableFault
  uRetryableFault

/-! ## A product of independently selected semantic axes -/

/-- A typed conversion basis together with an independently selected finite
demand vocabulary.  The absence of a field relating the coordinates is
intentional: any such relation is an additional theorem or policy supplied by
a concrete language. -/
structure System
    (Index : Type uIndex) (State : Index -> Type uState) where
  PrimitiveStep : (index : Index) ->
    State index -> State index -> Type uStep
  demandOperators : OperatorSet

namespace System

variable {Index : Type uIndex} {State : Index -> Type uState}

/-- Proof-relevant judgmental conversion generated by the selected primitive
steps. -/
abbrev Conversion (system : System.{uIndex, uState, uStep} Index State)
    (index : Index) (source target : State index) :=
  FreeConversion.Path State (fun {index} => system.PrimitiveStep index)
    source target

/-- Whether the selected demand vocabulary admits the canonical retry edge.
This is an operational property, not a property of conversion receipts. -/
def SupportsRetry (system : System.{uIndex, uState, uStep} Index State) : Prop :=
  (fragmentTheory (Origin := Nat) (Value := Nat) (StableFault := Nat)
    system.demandOperators Nat 0).Step
      (.evaluating 7) (.suspended 7)

end System

/-! ## Conversion does not determine demand -/

namespace DemandCanary

/-- A small conversion computation retained unchanged across two demand
vocabularies. -/
def primitiveStep (source target : Bool) : Type :=
  PLift (source = target)

def valueOnly : System Unit (fun _ => Bool) where
  PrimitiveStep := fun _ => primitiveStep
  demandOperators := pureNeedOperators

def retryCapable : System Unit (fun _ => Bool) where
  PrimitiveStep := fun _ => primitiveStep
  demandOperators := allNeedOperators

/-- The conversion coordinate is definitionally the same while retry behavior
is genuinely different. -/
theorem same_conversion_different_demand :
    valueOnly.PrimitiveStep = retryCapable.PrimitiveStep ∧
      retryCapable.SupportsRetry ∧
      ¬ valueOnly.SupportsRetry := by
  refine ⟨rfl, ?_, ?_⟩
  · exact ProfileCanary.retryStepInAll
  exact ProfileCanary.retryStepNotInPure

/-- In particular, no identity-on-cell-states operational translation can
manufacture retry in the value-only fragment. -/
theorem retry_is_not_conversion_sugar :
    ¬ ∃ translation : OperationalTranslation
      (fragmentTheory (Origin := Nat) (Value := Nat) (StableFault := Nat)
        allNeedOperators Nat 0)
      (fragmentTheory (Origin := Nat) (Value := Nat) (StableFault := Nat)
        pureNeedOperators Nat 0),
      translation.mapTerm = id :=
  ProfileCanary.no_identity_translation_all_to_pure

end DemandCanary

/-! ## Demand does not determine conversion -/

namespace ConversionCanary

/-- Primitive conversion which can only relate equal Boolean states. -/
def discreteStep (source target : Bool) : Type :=
  PLift (source = target)

/-- Primitive conversion which relates every pair of Boolean states. -/
def indiscreteStep (_source _target : Bool) : Type :=
  Unit

def discrete : System Unit (fun _ => Bool) where
  PrimitiveStep := fun _ => discreteStep
  demandOperators := pureNeedOperators

def indiscrete : System Unit (fun _ => Bool) where
  PrimitiveStep := fun _ => indiscreteStep
  demandOperators := pureNeedOperators

/-- Every freely generated discrete conversion preserves its Boolean
endpoint. -/
def discreteConversionSound {source target : Bool} :
    discrete.Conversion () source target -> source = target
  | .step evidence => evidence.down
  | .refl _ => rfl
  | .symm path => (discreteConversionSound path).symm
  | .trans first second =>
      (discreteConversionSound first).trans
        (discreteConversionSound second)

/-- Distinct Booleans have no discrete conversion receipt. -/
theorem discrete_false_true_empty :
    IsEmpty (discrete.Conversion () false true) :=
  ⟨fun conversion => Bool.false_ne_true (discreteConversionSound conversion)⟩

/-- The indiscrete basis supplies a direct conversion receipt between the
same distinct endpoints. -/
def indiscrete_false_true : indiscrete.Conversion () false true :=
  .step Unit.unit

/-- The demand coordinate is definitionally the same while conversion
inhabitation is genuinely different. -/
theorem same_demand_different_conversion :
    discrete.demandOperators = indiscrete.demandOperators ∧
      IsEmpty (discrete.Conversion () false true) ∧
      Nonempty (indiscrete.Conversion () false true) :=
  ⟨rfl, discrete_false_true_empty, ⟨indiscrete_false_true⟩⟩

end ConversionCanary

/-! ## Revision identity is immutable origin data -/

/-- A suspension origin decorated with the semantic revision under which its
computation was allocated. -/
structure RevisionOrigin (Revision : Type uRevision) (Origin : Type uOrigin) where
  revision : Revision
  origin : Origin
deriving DecidableEq, Repr

/-- A live cell is one whose immutable origin is exactly the supplied value. -/
def LiveAt
    {Origin : Type uOrigin} {Value : Type uValue}
    {StableFault : Type uStableFault}
    (origin : Origin) (state : CellState Origin Value StableFault) : Prop :=
  state.origin? = some origin

/-- Every exact protocol event from a live cell preserves its complete
origin.  Allocation and resampling cannot occur from a live source. -/
theorem step_preserves_live_origin
    {Cell : Type uCell} {Origin : Type uOrigin} {Value : Type uValue}
    {StableFault : Type uStableFault}
    {RetryableFault : Type uRetryableFault}
    {cell : Cell} {origin : Origin}
    {source target : CellState Origin Value StableFault}
    {event : Event Cell Origin Value StableFault RetryableFault}
    (live : LiveAt origin source)
    (step : Step RetryableFault cell source event target) :
    LiveAt origin target := by
  cases step <;> simp_all [LiveAt]

/-- Origin preservation extends to arbitrary chronological traces. -/
theorem trace_preserves_live_origin
    {Cell : Type uCell} {Origin : Type uOrigin} {Value : Type uValue}
    {StableFault : Type uStableFault}
    {RetryableFault : Type uRetryableFault}
    {cell : Cell} {origin : Origin}
    {source target : CellState Origin Value StableFault}
    (trace : Trace RetryableFault cell source target)
    (live : LiveAt origin source) :
    LiveAt origin target := by
  apply trace.preserves
    (P := LiveAt origin)
    (fun event liveAt step => step_preserves_live_origin liveAt step)
    live

/-- A trace inside one cell cannot silently retag a suspension with another
revision. -/
theorem suspended_trace_preserves_revision
    {Revision : Type uRevision} {Origin : Type uOrigin}
    {Cell : Type uCell} {Value : Type uValue}
    {StableFault : Type uStableFault}
    {RetryableFault : Type uRetryableFault}
    {cell : Cell}
    {sourceOrigin targetOrigin : RevisionOrigin Revision Origin}
    (trace : Trace RetryableFault cell
      (.suspended sourceOrigin :
        CellState (RevisionOrigin Revision Origin) Value StableFault)
      (.suspended targetOrigin)) :
    sourceOrigin.revision = targetOrigin.revision := by
  have originEquality : targetOrigin = sourceOrigin := by
    have preserved := trace_preserves_live_origin trace
      (origin := sourceOrigin) (by simp [LiveAt])
    simpa [LiveAt] using preserved
  exact congrArg RevisionOrigin.revision originEquality.symm

/-- Negative canary: changing semantic revision in place is impossible.  A
new revision requires allocation or resampling of a fresh cell identity. -/
theorem revision_change_requires_fresh_cell
    {Revision : Type uRevision} {Origin : Type uOrigin}
    {Cell : Type uCell} {Value : Type uValue}
    {StableFault : Type uStableFault}
    {RetryableFault : Type uRetryableFault}
    {cell : Cell}
    {sourceOrigin targetOrigin : RevisionOrigin Revision Origin}
    (different : sourceOrigin.revision ≠ targetOrigin.revision) :
    IsEmpty
      (Trace RetryableFault cell
        (.suspended sourceOrigin :
          CellState (RevisionOrigin Revision Origin) Value StableFault)
        (.suspended targetOrigin)) :=
  ⟨fun trace => different (suspended_trace_preserves_revision trace)⟩

/-! ## Ownership is another independent, erasable coordinate -/

def demoRevisionOrigin : RevisionOrigin Nat Nat :=
  ⟨3, 7⟩

/-- A matching owner may commit a value under an immutable revisioned origin. -/
def ownedRevisionCommit :
    Ownership.Step (Cell := Nat) (Owner := Bool)
      (Origin := RevisionOrigin Nat Nat) (Value := Nat)
      (StableFault := Nat) Nat 0
      (.evaluating demoRevisionOrigin true)
      (.commitValue 0 demoRevisionOrigin true 11)
      (.cachedValue demoRevisionOrigin 11) :=
  .commitValue demoRevisionOrigin true 11

/-- The same revision and value do not authorize a different evaluator to
commit.  Revision provenance and evaluator ownership therefore remain
separate coordinates. -/
theorem wrong_owner_cannot_commit_same_revision :
    IsEmpty
      (Ownership.Step (Cell := Nat) (Owner := Bool)
        (Origin := RevisionOrigin Nat Nat) (Value := Nat)
        (StableFault := Nat) Nat 0
        (.evaluating demoRevisionOrigin true)
        (.commitValue 0 demoRevisionOrigin false 11)
        (.cachedValue demoRevisionOrigin 11)) :=
  ⟨by intro impossible; cases impossible⟩

/-! ## Axiom audit -/

#print axioms DemandCanary.same_conversion_different_demand
#print axioms DemandCanary.retry_is_not_conversion_sugar
#print axioms ConversionCanary.same_demand_different_conversion
#print axioms trace_preserves_live_origin
#print axioms suspended_trace_preserves_revision
#print axioms revision_change_requires_fresh_cell
#print axioms wrong_owner_cannot_commit_same_revision

end Mettapedia.GSLT.Dynamics.ConversionDemandOrthogonality
