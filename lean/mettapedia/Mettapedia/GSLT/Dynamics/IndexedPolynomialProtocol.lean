import Mettapedia.Algebra.WorkSpan
import Mettapedia.GSLT.Core.InteractionEvent
import Mettapedia.GSLT.Core.NonFactorization
import Mettapedia.TypeTheory.DependentFamilyObserverFactorization
import Mettapedia.TypeTheory.IndexedPolynomial

/-!
# Indexed polynomials as dependent interaction protocols

An indexed polynomial over a state family has a standard interactive reading:

* a shape at a state is a command available there;
* a position of that shape is a possible response; and
* `next` is the state reached after that response.

Its extension at a state is therefore one command together with a dependent
continuation for every response.  This module derives the corresponding GSLT
and proof-relevant interaction presentation without adding another transition
relation.  Selecting a response retains the command, response, successor, and
dependent continuation result.

The positive and negative controls expose two boundaries.  A coarse
completion observation cannot carry a continuation family whose two completed
states have non-equivalent fibres.  Separately, two response occurrences may
reach the same endpoint while retaining different costs.  Thus neither an
endpoint nor an extensional state observation determines the typed protocol
interaction.

This is general protocol mathematics.  It does not select a process syntax,
session discipline, scheduler, effect theory, cost algebra, or product
calculus.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Dynamics.IndexedPolynomialProtocol

open Mettapedia.Algebra
open Mettapedia.GSLT
open Mettapedia.GSLT.Core.InteractionEvent
open Mettapedia.GSLT.Core.InteractionEvent.InteractionPresentation
open Mettapedia.GSLT.Core.NonFactorization
open Mettapedia.TypeTheory
open Mettapedia.TypeTheory.DependentFamilyObserverFactorization
open Mettapedia.TypeTheory.IndexedPolynomial

universe uState uShape uResponse uResult uValue

/-- An indexed polynomial whose indices are protocol states. -/
abbrev ProtocolPolynomial (State : Type uState) :=
  IndexedPolynomial.{0, uState, uShape, uResponse} Unit (fun _ => State)

variable {State : Type uState}
variable (protocol : ProtocolPolynomial.{uState, uShape, uResponse} State)

/-- Commands available at one protocol state. -/
abbrev Command (state : State) : Type uShape :=
  protocol.Shape () state

/-- Responses available to one selected command. -/
abbrev Response {state : State} (command : Command protocol state) :
    Type uResponse :=
  protocol.Position command

/-- The successor selected by a response. -/
abbrev next {state : State} (command : Command protocol state)
    (response : Response protocol command) : State :=
  protocol.next command response

/-- One complete response occurrence, indexed by both endpoints. -/
inductive Move : State -> State -> Type (max uShape uResponse) where
  | fire {source : State} (command : Command protocol source)
      (response : Response protocol command) :
      Move source (protocol.next command response)

/-- The endpoint-only transition relation generated by protocol moves. -/
def lts : GSLT.{uState} where
  Term := State
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites := fun source target => Nonempty (Move protocol source target)
  rewrites_resp_left := by
    intro source source' target equal step
    subst source'
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    intro source target target' step equal
    subst target'
    exact step

/-- The proof-relevant presentation of the same transition relation.  The
single site says that the polynomial is the rule source; command and response
identity remain in the event evidence. -/
def interaction : InteractionPresentation (lts protocol) where
  Site := Unit
  Event := fun _ source target => Move protocol source target
  sound := fun move => ⟨move⟩

/-- Every endpoint step of the derived GSLT comes from an exact command and
response occurrence. -/
theorem interaction_complete : (interaction protocol).Complete := by
  intro source target step
  obtain ⟨move⟩ := step
  exact ⟨⟨(), move⟩⟩

/-- Package a command and response as an enabled proof-relevant event. -/
def enabled {source : State} (command : Command protocol source)
    (response : Response protocol command) :
    (interaction protocol).Enabled source where
  site := ()
  target := protocol.next command response
  evidence := .fire command response

/-- Enabled events are exactly command-response pairs.  The target index in
the event is reconstructed rather than stored independently. -/
def enabledEquiv (source : State) :
    (interaction protocol).Enabled source ≃
      Sigma (fun command : Command protocol source =>
        Response protocol command) where
  toFun event := by
    obtain ⟨site, target, evidence⟩ := event
    cases site
    cases evidence with
    | fire command response => exact ⟨command, response⟩
  invFun pair := enabled protocol pair.1 pair.2
  left_inv := by
    rintro ⟨site, target, evidence⟩
    cases site
    cases evidence
    rfl
  right_inv := by
    rintro ⟨command, response⟩
    rfl

/-- A protocol round is the polynomial extension of a successor-indexed
result family: choose a command and provide one result in the correct fibre
for every possible response. -/
abbrev OneRound (Result : State -> Type uResult) (source : State) : Type _ :=
  protocol.Extension (fun _ state => Result state) () source

/-- Select one response from a complete round.  The resulting sigma retains
the exact event on which its dependent value is indexed. -/
def selectResponse {Result : State -> Type uResult} {source : State}
    (round : OneRound protocol Result source)
    (response : Response protocol round.1) :
    Sigma (fun event : (interaction protocol).Enabled source =>
      Result event.target) :=
  ⟨enabled protocol round.1 response, round.2 response⟩

/-- Event-indexed dependent outcomes are exactly a command, a selected
response, and a result in that response's successor fibre. -/
def outcomeEquiv (Result : State -> Type uResult) (source : State) :
    (Sigma (fun event : (interaction protocol).Enabled source =>
      Result event.target)) ≃
      Sigma (fun command : Command protocol source =>
        Sigma (fun response : Response protocol command =>
          Result (protocol.next command response))) where
  toFun outcome := by
    obtain ⟨event, result⟩ := outcome
    obtain ⟨site, target, evidence⟩ := event
    cases site
    cases evidence with
    | fire command response => exact ⟨command, response, result⟩
  invFun outcome :=
    ⟨enabled protocol outcome.1 outcome.2.1, outcome.2.2⟩
  left_inv := by
    rintro ⟨event, result⟩
    obtain ⟨site, target, evidence⟩ := event
    cases site
    cases evidence
    rfl
  right_inv := by
    rintro ⟨command, response, result⟩
    rfl

/-- Selecting a response always authorizes the endpoint at which its result
is typed. -/
theorem selectResponse_step {Result : State -> Type uResult}
    {source : State} (round : OneRound protocol Result source)
    (response : Response protocol round.1) :
    (lts protocol).Step source (selectResponse protocol round response).1.target :=
  (selectResponse protocol round response).1.step

/-- Map every response continuation without changing its command, response
space, or successor state. -/
def mapRound {First : State -> Type uResult}
    {Second : State -> Type uValue}
    (mapping : forall state, First state -> Second state)
    {source : State} :
    OneRound protocol First source -> OneRound protocol Second source :=
  IndexedPolynomial.Extension.map protocol
    (fun _ state value => mapping state value)

@[simp] theorem mapRound_selectResponse
    {First : State -> Type uResult} {Second : State -> Type uValue}
    (mapping : forall state, First state -> Second state)
    {source : State} (round : OneRound protocol First source)
    (response : Response protocol round.1) :
    (selectResponse protocol (mapRound protocol mapping round) response).2 =
      mapping _ (selectResponse protocol round response).2 :=
  rfl

/-! ## Varying-fibre protocol control -/

namespace VaryingCanary

inductive Phase where
  | start
  | unitDone
  | boolDone
deriving DecidableEq, Repr

/-- The sole query command is available only at the initial phase. -/
inductive QueryCommand : Phase -> Type where
  | ask : QueryCommand .start

/-- A Boolean reply selects one of two differently typed completed phases. -/
def query : ProtocolPolynomial Phase where
  Shape := fun _ phase => QueryCommand phase
  Position := fun command =>
    match command with
    | .ask => Bool
  next := fun command response =>
    match command with
    | .ask => if response then .boolDone else .unitDone

/-- The continuation family is genuinely varying. -/
def Result : Phase -> Type
  | .start => PEmpty
  | .unitDone => PUnit
  | .boolDone => Bool

/-- A complete dependent strategy supplies a correctly typed continuation for
both possible responses. -/
def round : OneRound query Result .start :=
  ⟨.ask, fun response =>
    match response with
    | false => PUnit.unit
    | true => false⟩

def unitOutcome := selectResponse query round false
def boolOutcome := selectResponse query round true

theorem selected_results_have_expected_types :
    unitOutcome.1.target = .unitDone /\
      boolOutcome.1.target = .boolDone /\
      unitOutcome.2 = PUnit.unit /\
      boolOutcome.2 = false :=
  ⟨rfl, rfl, rfl, rfl⟩

/-- No query is enabled after either completed phase. -/
theorem completed_phases_have_no_commands :
    (¬ Nonempty ((interaction query).Enabled Phase.unitDone)) /\
      ¬ Nonempty ((interaction query).Enabled Phase.boolDone) := by
  constructor
  · rintro ⟨event⟩
    obtain ⟨command, _response⟩ := enabledEquiv query .unitDone event
    exact nomatch command
  · rintro ⟨event⟩
    obtain ⟨command, _response⟩ := enabledEquiv query .boolDone event
    exact nomatch command

/-- The coarse observer remembers only whether the protocol has completed. -/
def completion : Phase -> Bool
  | .start => false
  | .unitDone => true
  | .boolDone => true

/-- Completion identifies states whose continuation fibres have different
cardinality, so the dependent family cannot descend through that observer. -/
theorem result_not_determined_by_completion :
    ¬ Nonempty (FamilyFactorization completion Result) := by
  apply FamilyFactorization.not_nonempty_of_nonEquivalent_fibres
    (left := Phase.unitDone) (right := Phase.boolDone) rfl
  simpa [Result] using
    Mettapedia.TypeTheory.DependentFamilyObserverFactorization.Canary.unit_not_equiv_bool

/-- Exact state observation is the positive control: every result family
descends along identity. -/
def result_determined_by_exact_state : FamilyFactorization id Result :=
  FamilyFactorization.pullback id Result

/-- The paired boundary: dependent response selection is valid, but hiding
the response-selected state behind completion is not. -/
theorem dependent_protocol_observer_boundary :
    (lts query).Step Phase.start unitOutcome.1.target /\
      (lts query).Step Phase.start boolOutcome.1.target /\
      Nonempty (FamilyFactorization id Result) /\
      ¬ Nonempty (FamilyFactorization completion Result) :=
  ⟨unitOutcome.1.step, boolOutcome.1.step,
    ⟨result_determined_by_exact_state⟩,
    result_not_determined_by_completion⟩

end VaryingCanary

/-! ## Equal-endpoint occurrence and cost control -/

namespace CostCanary

/-- One command has two response occurrences, both returning to the same
state. -/
def loop : ProtocolPolynomial Unit where
  Shape := fun _ _ => Unit
  Position := fun _ => Bool
  next := fun _ _ => ()

def falseEvent : (interaction loop).Enabled () :=
  enabled loop () false

def trueEvent : (interaction loop).Enabled () :=
  enabled loop () true

/-- Recover the response tag retained by an enabled event. -/
def responseTag (event : (interaction loop).Enabled ()) : Bool :=
  (enabledEquiv loop () event).2

/-- The two response occurrences have one endpoint but remain unequal. -/
theorem distinct_responses_same_endpoint :
    falseEvent ≠ trueEvent /\
      falseEvent.target = trueEvent.target := by
  constructor
  · intro equalEvents
    have equalTags := congrArg responseTag equalEvents
    exact Bool.false_ne_true equalTags
  · rfl

/-- A response-sensitive work/span valuation. -/
def workSpan (event : (interaction loop).Enabled ()) : WorkSpan :=
  if responseTag event then ⟨2, 2⟩ else ⟨1, 1⟩

@[simp] theorem false_workSpan : workSpan falseEvent = ⟨1, 1⟩ :=
  rfl

@[simp] theorem true_workSpan : workSpan trueEvent = ⟨2, 2⟩ :=
  rfl

/-- Endpoint erasure cannot reconstruct response-sensitive cost. -/
theorem workSpan_not_endpoint_determined :
    ¬ Factors
      (fun event : (interaction loop).Enabled () => event.target)
      workSpan := by
  let fibre : NonTrivialFiber
      (fun event : (interaction loop).Enabled () => event.target)
      workSpan :=
    { left := falseEvent
      right := trueEvent
      sameShadow := rfl
      differentValue := by decide }
  exact fibre.not_factors

/-- The endpoint-only GSLT contains the common self-loop while the interaction
presentation retains both distinct response witnesses. -/
theorem endpoint_step_with_two_occurrences :
    (lts loop).Step () () /\
      falseEvent ≠ trueEvent /\
      ¬ Factors
        (fun event : (interaction loop).Enabled () => event.target)
        workSpan :=
  ⟨falseEvent.step, distinct_responses_same_endpoint.1,
    workSpan_not_endpoint_determined⟩

end CostCanary

