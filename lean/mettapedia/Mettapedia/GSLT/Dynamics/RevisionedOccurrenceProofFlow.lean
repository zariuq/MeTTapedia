import Mettapedia.GSLT.Dynamics.ProofRelevantNeedProfile
import Mettapedia.GSLT.LanguageDef.NIKMetalogic

/-!
# Native proof flow for revisioned occurrence sources

The inputs are an occurrence source and its selected keying policy. No
operational host, candidate language, or source-specific cause vocabulary is
required. The construction reuses the revisioned occurrence GSLT and its
elaboration, and admits its sound steps into NIK's proof-relevant clone.

The positive flow and exact publication laws retain the complete answer bag
and accepted proof fibre. Terminal answers reject invented continuations,
and unequal keys remain distinct. These laws do not select a keying policy.
-/

namespace Mettapedia.GSLT.Dynamics.RevisionedOccurrenceProofFlow

universe uSpace uRequest uAnswer uKey

variable {Space : Type uSpace} {Request : Type uRequest}
  {Answer : Type uAnswer} [DecidableEq Answer]

open Mettapedia.GSLT.Dynamics.OccurrenceSemantics
open Mettapedia.GSLT.Dynamics.ProofRelevantNeed
open Mettapedia.GSLT.LanguageDef.NIKMetalogic

/-- A Need judgment states both the live operational term and the complete bag
it denotes.  Keeping the bag in the claim makes preservation non-vacuous. -/
structure Claim (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request) where
  term : RevisionedOccurrenceTerm occurrences keying
  expected : Multiset Answer

/-- One admitted operation is an actual Need step whose expected bag is
unchanged across the endpoints. -/
structure Step (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (source target : Claim occurrences keying) where
  operational : PLift
    ((revisionedOccurrenceGSLT occurrences keying).Step source.term target.term)
  expected_eq : source.expected = target.expected

/-- Independent semantic meaning of a Need claim, through the revisioned occurrence
elaboration rather than through the admission checker. -/
def Meaning (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (claim : Claim occurrences keying) : Prop :=
  (revisionedOccurrenceElaboration occurrences keying).elaborate claim.term =
    some claim.expected

/-- An admission seed is proof that the starting claim has its declared live
occurrence meaning.  It is paid for at admission time, not reconstructed per step. -/
abbrev Seed (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (claim : Claim occurrences keying) :=
  PLift (Meaning occurrences keying claim)

/-- Live Need steps preserve claim meaning. -/
theorem step_sound (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    {source target : Claim occurrences keying} (step : Step occurrences keying source target)
    (sourceMeaning : Meaning occurrences keying source) : Meaning occurrences keying target := by
  have preserves :=
    (revisionedOccurrenceElaboration occurrences keying).rewrite step.operational.down
  calc
    (revisionedOccurrenceElaboration occurrences keying).elaborate target.term =
        (revisionedOccurrenceElaboration occurrences keying).elaborate source.term :=
      preserves.symm
    _ = some source.expected := sourceMeaning
    _ = some target.expected := congrArg some step.expected_eq

/-- Admission seeds are meaningful by construction. -/
theorem seed_sound (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    {claim : Claim occurrences keying}
    (seed : Seed occurrences keying claim) : Meaning occurrences keying claim :=
  seed.down

/-- The proof-relevant substitution algebra generated by live Need steps. -/
abbrev Clone (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request) :=
  operationalDerivationClone (Step occurrences keying) (Seed occurrences keying)

/-- Every live Need step is admitted as a one-premise native operation. -/
def admittedRules (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request) :
    AdmittedCloneRules (Clone occurrences keying) (Meaning occurrences keying) :=
  operationalAdmittedRules (step_sound occurrences keying)

/-- The whole closed Need proof algebra is semantically sound without an
interior checker call. -/
theorem soundClone (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request) :
    SoundClone (Clone occurrences keying) (Meaning occurrences keying) :=
  operationalSoundClone (seed_sound occurrences keying) (step_sound occurrences keying)

/-- The singleton proof environment used to apply one admitted unary rule. -/
def singletonEnvironment (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    {source : Claim occurrences keying}
    (proof : (Clone occurrences keying).Hom [] source) :
    (index : Fin ([source].length)) →
      (Clone occurrences keying).Hom [] ([source].get index) := by
  intro index
  refine Fin.cases proof ?_ index
  intro impossible
  exact Fin.elim0 impossible

/-- Apply one already-admitted Need operation.  This is the zero-recheck
interior path: it is clone substitution, with no checker argument. -/
def applyAdmitted (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (rule : OperationalRule (Step occurrences keying))
    (prior : (Clone occurrences keying).Hom [] rule.source) :
    (Clone occurrences keying).Hom [] rule.target :=
  (admittedRules occurrences keying).applyClosed rule
    (singletonEnvironment occurrences keying prior)

/-- Admission adds no hidden replay phase: operational application is exactly
one native `advance` node over the already-held proof. -/
theorem applyAdmitted_eq_advance (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (rule : OperationalRule (Step occurrences keying))
    (prior : (Clone occurrences keying).Hom [] rule.source) :
    applyAdmitted occurrences keying rule prior =
      OperationalDerivation.advance prior rule.step := by
  rfl

/-- The zero-recheck application preserves semantic meaning by the law paid
for when the operation was admitted. -/
theorem applyAdmitted_sound (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (rule : OperationalRule (Step occurrences keying))
    (prior : (Clone occurrences keying).Hom [] rule.source)
    (sourceMeaning : Meaning occurrences keying rule.source) :
    Meaning occurrences keying rule.target :=
  (admittedRules occurrences keying).applyClosed_sound rule
    (singletonEnvironment occurrences keying prior)
    (fun index => by
      refine Fin.cases sourceMeaning ?_ index
      intro impossible
      exact Fin.elim0 impossible)

/-- The exact request claim for the live occurrence bag. -/
def requestClaim (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (space : Space)
    (subject : Request) : Claim occurrences keying where
  term := .request space subject
  expected := occurrences.occurrences space subject

/-- The corresponding occurrence answer retains the same complete bag. -/
def answerClaim (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (space : Space)
    (subject : Request) (result : Answer) (occurrence : Nat) : Claim occurrences keying where
  term := .answer space subject (keying.key space subject)
    occurrence result
  expected := occurrences.occurrences space subject

/-- A request seed is meaningful by computation of the live elaboration. -/
theorem request_meaning (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (space : Space)
    (subject : Request) : Meaning occurrences keying (requestClaim occurrences keying space subject) :=
  rfl

/-- An admitted occurrence is an actual rule of the live Need GSLT. -/
def foundRule (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (space : Space)
    (subject : Request) (result : Answer) (occurrence : Nat)
    (copy : occurrence < Multiset.count result
      (occurrences.occurrences space subject)) :
    OperationalRule (Step occurrences keying) where
  source := requestClaim occurrences keying space subject
  target := answerClaim occurrences keying space subject result occurrence
  step :=
    { operational := ⟨(revisionedOccurrenceGSLT_step_iff occurrences keying space subject
          result occurrence).2 copy⟩
      expected_eq := rfl }

/-- The admitted request seed, retained as native evidence rather than a
micro-trace of how its complete bag was computed. -/
def requestProof (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (space : Space)
    (subject : Request) :
    (Clone occurrences keying).Hom [] (requestClaim occurrences keying space subject) :=
  .admittedSeed ⟨request_meaning occurrences keying space subject⟩

/-- A real Need occurrence flows by applying the already-admitted operation;
there is no interior certificate construction or checker invocation. -/
def foundProof (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (space : Space)
    (subject : Request) (result : Answer) (occurrence : Nat)
    (copy : occurrence < Multiset.count result
      (occurrences.occurrences space subject)) :
    (Clone occurrences keying).Hom [] (answerClaim occurrences keying space subject result occurrence) :=
  applyAdmitted occurrences keying (foundRule occurrences keying space subject result occurrence copy)
    (requestProof occurrences keying space subject)

/-- Positive Mode-B theorem: the actual Need answer retains the full declared
bag after zero-recheck native application. -/
theorem found_flows_without_recheck (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (space : Space) (subject : Request) (result : Answer) (occurrence : Nat)
    (copy : occurrence < Multiset.count result
      (occurrences.occurrences space subject)) :
    Meaning occurrences keying (answerClaim occurrences keying space subject result occurrence) :=
  (soundClone occurrences keying).closed_sound
    (foundProof occurrences keying space subject result occurrence copy)

/-- Native proof objects and their entire exact judged fibres. -/
abbrev ProofSystem (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request) :=
  cloneNativeProofSystem (Clone occurrences keying)

/-- A realization with decidable claim identity checks only the retained
output index; it never replays the Need derivation. -/
def nativeKernel (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    [DecidableEq (Claim occurrences keying)] :
    NativeProofKernel (ProofSystem occurrences keying) :=
  cloneNativeProofKernel (Clone occurrences keying)

/-- The primary publication boundary preserves the exact native proof fibre. -/
def primaryBoundary (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    [DecidableEq (Claim occurrences keying)] :
    CertificateEquivalence
      (nativeKernel occurrences keying).toChecker (ProofSystem occurrences keying) :=
  (nativeKernel occurrences keying).certificateEquivalence

/-- Optional publication of a flowed Need result checks only its output index;
semantic soundness still comes from admission and native composition. -/
theorem found_reaches_primary_boundary (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    [DecidableEq (Claim occurrences keying)]
    (space : Space) (subject : Request) (result : Answer) (occurrence : Nat)
    (copy : occurrence < Multiset.count result
      (occurrences.occurrences space subject)) :
    (∃ certificate,
      (nativeKernel occurrences keying).toChecker.check
        (answerClaim occurrences keying space subject result occurrence) certificate = true) ∧
      Meaning occurrences keying (answerClaim occurrences keying space subject result occurrence) :=
  closedCloneProof_flows_without_recheck
    (soundClone occurrences keying) (primaryBoundary occurrences keying)
    (foundProof occurrences keying space subject result occurrence copy)

/-- Negative witness: an answer is terminal in the Need algebra, so no
admitted Need operation can use it as the source of another step. -/
theorem answer_has_no_admitted_successor (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    (space : Space) (subject : Request) (result : Answer) (occurrence : Nat) :
    ¬ ∃ target : Claim occurrences keying,
      Nonempty
        (Step occurrences keying (answerClaim occurrences keying space subject result occurrence) target) := by
  intro successor
  rcases successor with ⟨⟨targetTerm, targetExpected⟩, ⟨step⟩⟩
  cases targetTerm <;> cases step.operational.down

omit [DecidableEq Answer] in
/-- Different keys distinguish answer identity even for the same request and
occurrence. A revision policy may instantiate this law with its own
revision-change condition. -/
theorem answer_identity_changes_with_key (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request)
    {first second : Space} (subject : Request) (result : Answer) (occurrence : Nat)
    (different : keying.key first subject ≠ keying.key second subject) :
    (answerClaim occurrences keying first subject result occurrence).term ≠
      (answerClaim occurrences keying second subject result occurrence).term := by
  intro equal
  injection equal with _ _ keyEqual _ _
  exact different keyEqual


/-- The proof-flow laws for one occurrence source and one keying policy.
All fields refer to those same inputs. -/
structure Witness (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request) where
  rules : AdmittedCloneRules.{_, _, max uSpace uRequest uAnswer uKey}
    (Clone occurrences keying) (Meaning occurrences keying)
  semantics : SoundClone (Clone occurrences keying) (Meaning occurrences keying)
  exactBoundary : [DecidableEq (Claim occurrences keying)] →
    CertificateEquivalence
      (nativeKernel occurrences keying).toChecker (ProofSystem occurrences keying)
  occurrenceFlows : ∀ (space : Space) (subject : Request) (result : Answer)
    (occurrence : Nat),
    occurrence < Multiset.count result (occurrences.occurrences space subject) →
    Meaning occurrences keying (answerClaim occurrences keying space subject result occurrence)
  answerTerminal : ∀ (space : Space) (subject : Request) (result : Answer)
    (occurrence : Nat),
    ¬ ∃ target : Claim occurrences keying,
      Nonempty (Step occurrences keying
        (answerClaim occurrences keying space subject result occurrence) target)
  keyChangeSeparates : ∀ {first second : Space} (subject : Request)
    (result : Answer) (occurrence : Nat),
    keying.key first subject ≠ keying.key second subject →
    (answerClaim occurrences keying first subject result occurrence).term ≠
      (answerClaim occurrences keying second subject result occurrence).term

/-- The existing revisioned occurrence construction supplies every field
without reconstructing a separate evaluator or checker. -/
def witness (occurrences : OccurrenceSource Space Request Answer)
    (keying : RevisionKeying.{uSpace, uRequest, uKey} Space Request) : Witness occurrences keying where
  rules := admittedRules occurrences keying
  semantics := soundClone occurrences keying
  exactBoundary := primaryBoundary occurrences keying
  occurrenceFlows := found_flows_without_recheck occurrences keying
  answerTerminal := answer_has_no_admitted_successor occurrences keying
  keyChangeSeparates := answer_identity_changes_with_key occurrences keying

#print axioms step_sound
#print axioms applyAdmitted_eq_advance
#print axioms applyAdmitted_sound
#print axioms request_meaning
#print axioms found_flows_without_recheck
#print axioms primaryBoundary
#print axioms found_reaches_primary_boundary
#print axioms answer_has_no_admitted_successor
#print axioms answer_identity_changes_with_key
#print axioms witness

end Mettapedia.GSLT.Dynamics.RevisionedOccurrenceProofFlow
