/-!
# Chu spaces of specifications and the witness-open topology

A specification-exploration space pairs candidate specifications `S` with observable
discriminator witnesses `W` via a realization relation `pass : S → W → Prop`
(a Barwise–Seligman classification / Boolean Chu space), or quantitatively via a
graded score `score : S → W → ℝ` in `[0, 1]`.

Topologically, the **witness topology** (`witnessTopology`) generated by the basic
capability opens `U_w = {s | pass s w}` captures the exact asymmetry between positive
capabilities and impossibility theorems:
* positive capabilities and finite conjunctions thereof are **open**
  (`isOpen_capabilityOpen`, `isOpen_finiteConjunction`);
* impossibility theorems / obstructions `{s | ¬ pass s w}` are **closed walls**
  (`isClosed_obstructionWall`);
* every **Chu transform** (infomorphism `(f, g)` obeying `pass₂ (f s) w ↔ pass₁ s (g w)`)
  is automatically **continuous** (`chuTransform_continuous`);
* the induced Galois connection links sets of specifications to sets of shared witnesses
  (`galois_spec_witness`);
* the topological specialization preorder coincides with capability refinement
  (`witnessRefines_iff_forall_open`);
* topological indistinguishability coincides with identical witness profiles
  (`indistinguishable_iff_sameWitnesses`);
* when the discriminator witness family is finite, the specification space is **compact**
  (`isCompact_of_finiteWitnesses`);
* quantitatively, a graded Chu space induces a directed supremum quasimetric obeying the
  directed triangle inequality (`gradedDefect_triangle`).
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Distinction.SpecSpace

open Mettapedia.GSLT.Core.NonFactorization

universe uS uW uS' uW'

/-! ## Boolean Chu space of specifications and witnesses -/

/-- A **Chu space (classification)** pairing specifications `S` with discriminator
witnesses `W`. -/
structure SpecChuSpace (S : Type uS) (W : Type uW) where
  /-- `pass s w` holds when specification `s` realizes witness / capability `w`. -/
  pass : S → W → Prop

/-- A **Chu transform (infomorphism)** between specification-witness spaces:
a covariant map on specifications paired with a contravariant translation of witnesses
satisfying the adjointness condition. -/
structure ChuTransform {S₁ : Type uS} {W₁ : Type uW} {S₂ : Type uS'} {W₂ : Type uW'}
    (C₁ : SpecChuSpace S₁ W₁) (C₂ : SpecChuSpace S₂ W₂) where
  onSpec : S₁ → S₂
  onWitness : W₂ → W₁
  adjoint : ∀ s w, C₂.pass (onSpec s) w ↔ C₁.pass s (onWitness w)

namespace ChuTransform

/-- The identity Chu transform. -/
def id {S : Type uS} {W : Type uW} (C : SpecChuSpace S W) : ChuTransform C C where
  onSpec := _root_.id
  onWitness := _root_.id
  adjoint _ _ := Iff.rfl

/-- Composition of Chu transforms (covariant on specs, contravariant on witnesses). -/
def comp {S₁ : Type uS} {W₁ : Type uW} {S₂ : Type uS'} {W₂ : Type uW'}
    {S₃ : Type*} {W₃ : Type*}
    {C₁ : SpecChuSpace S₁ W₁} {C₂ : SpecChuSpace S₂ W₂} {C₃ : SpecChuSpace S₃ W₃}
    (first : ChuTransform C₁ C₂) (second : ChuTransform C₂ C₃) : ChuTransform C₁ C₃ where
  onSpec := second.onSpec ∘ first.onSpec
  onWitness := first.onWitness ∘ second.onWitness
  adjoint s w := (second.adjoint (first.onSpec s) w).trans (first.adjoint s (second.onWitness w))

end ChuTransform

/-! ## Galois connection between specification sets and witness sets -/

section Galois

variable {S : Type uS} {W : Type uW} (C : SpecChuSpace S W)

/-- Witnesses realized by every specification in `A`. -/
def sharedWitnesses (A : Set S) : Set W :=
  {w | ∀ s ∈ A, C.pass s w}

/-- Specifications realizing every witness in `B`. -/
def realizingSpecs (B : Set W) : Set S :=
  {s | ∀ w ∈ B, C.pass s w}

/-- **Syntax–semantics Galois polarity**: `A ⊆ realizingSpecs B ↔ B ⊆ sharedWitnesses A`. -/
theorem galois_spec_witness (A : Set S) (B : Set W) :
    A ⊆ realizingSpecs C B ↔ B ⊆ sharedWitnesses C A := by
  constructor
  · intro h w hw s hs
    exact h hs w hw
  · intro h s hs w hw
    exact h hw s hs

theorem galoisConnection_spec_witness :
    GaloisConnection (fun A : Set S => OrderDual.toDual (sharedWitnesses C A))
      (fun B : (Set W)ᵒᵈ => realizingSpecs C (OrderDual.ofDual B)) := by
  intro A B
  exact (galois_spec_witness C A (OrderDual.ofDual B)).symm

end Galois

/-! ## The witness-open topology -/

section WitnessTopology

variable {S : Type uS} {W : Type uW} (C : SpecChuSpace S W)

/-- The **capability open** carved out by a single witness `w`. -/
def capabilityOpen (w : W) : Set S :=
  {s | C.pass s w}

/-- The **obstruction wall** carved out by failing witness `w`. -/
def obstructionWall (w : W) : Set S :=
  {s | ¬ C.pass s w}

theorem obstructionWall_eq_compl (w : W) :
    obstructionWall C w = (capabilityOpen C w)ᶜ := rfl

/-- The subbasis of capability opens. -/
def witnessSubbasis : Set (Set S) :=
  Set.range (capabilityOpen C)

/-- **The witness topology** on specifications: generated by all capability opens `U_w`. -/
@[instance_reducible]
def witnessTopology : TopologicalSpace S :=
  TopologicalSpace.generateFrom (witnessSubbasis C)

/-- Every positive capability witness defines an open set. -/
theorem isOpen_capabilityOpen (w : W) :
    @IsOpen S (witnessTopology C) (capabilityOpen C w) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨w, rfl⟩

/-- Every impossibility / obstruction wall is a **closed set**. -/
theorem isClosed_obstructionWall (w : W) :
    @IsClosed S (witnessTopology C) (obstructionWall C w) := by
  let _ := witnessTopology C
  rw [obstructionWall_eq_compl, isClosed_compl_iff]
  exact isOpen_capabilityOpen C w

/-- Every finite conjunction of positive capabilities is open. -/
theorem isOpen_finiteConjunction (F : Finset W) :
    @IsOpen S (witnessTopology C) {s | ∀ w ∈ F, C.pass s w} := by
  let _ := witnessTopology C
  have heq : {s | ∀ w ∈ F, C.pass s w} = ⋂ w ∈ F, capabilityOpen C w := by
    ext s; simp [capabilityOpen]
  rw [heq]
  exact isOpen_biInter_finset fun w _ => isOpen_capabilityOpen C w

/-- Every Chu transform is **continuous** with respect to the witness topologies. -/
theorem chuTransform_continuous {S₁ : Type uS} {W₁ : Type uW} {S₂ : Type uS'} {W₂ : Type uW'}
    {C₁ : SpecChuSpace S₁ W₁} {C₂ : SpecChuSpace S₂ W₂} (f : ChuTransform C₁ C₂) :
    @Continuous S₁ S₂ (witnessTopology C₁) (witnessTopology C₂) f.onSpec := by
  let _ := witnessTopology C₁
  let _ := witnessTopology C₂
  apply continuous_generateFrom_iff.mpr
  rintro _ ⟨w, rfl⟩
  have hpre : f.onSpec ⁻¹' capabilityOpen C₂ w = capabilityOpen C₁ (f.onWitness w) := by
    ext s
    exact f.adjoint s w
  rw [hpre]
  exact isOpen_capabilityOpen C₁ (f.onWitness w)

/-- Capability refinement preorder: `s₂` realizes every witness that `s₁` realizes. -/
def WitnessRefines (s₁ s₂ : S) : Prop :=
  ∀ w : W, C.pass s₁ w → C.pass s₂ w

/-- **Specialization preorder theorem**: `s₁` refines into `s₂` if and only if every
witness-open neighborhood of `s₁` contains `s₂`. -/
theorem witnessRefines_iff_forall_open (s₁ s₂ : S) :
    WitnessRefines C s₁ s₂ ↔
      ∀ U : Set S, @IsOpen S (witnessTopology C) U → s₁ ∈ U → s₂ ∈ U := by
  constructor
  · intro href U hU
    induction hU with
    | basic V hV =>
      rcases hV with ⟨w, rfl⟩
      exact href w
    | univ => intro _; trivial
    | inter U₁ U₂ _ _ ih₁ ih₂ =>
      intro hmem
      exact ⟨ih₁ hmem.1, ih₂ hmem.2⟩
    | sUnion 𝒮 _ ih =>
      rintro ⟨V, hV, hs₁⟩
      exact ⟨V, hV, ih V hV hs₁⟩
  · intro hopen w hw
    exact hopen (capabilityOpen C w) (isOpen_capabilityOpen C w) hw

/-- **Topological indistinguishability = identical witness profile** (`T₀`-quotient kernel). -/
theorem indistinguishable_iff_sameWitnesses (s₁ s₂ : S) :
    (∀ U : Set S, @IsOpen S (witnessTopology C) U → (s₁ ∈ U ↔ s₂ ∈ U)) ↔
      (∀ w : W, C.pass s₁ w ↔ C.pass s₂ w) := by
  constructor
  · intro h U
    exact h (capabilityOpen C U) (isOpen_capabilityOpen C U)
  · intro h U hU
    exact ⟨(witnessRefines_iff_forall_open C s₁ s₂).mp (fun w hw => (h w).mp hw) U hU,
           (witnessRefines_iff_forall_open C s₂ s₁).mp (fun w hw => (h w).mpr hw) U hU⟩

/-- **Non-factorization witness criterion**: a witness separating two specs refutes
indistinguishability (`NonTrivialFiber` over the witness profile). -/
def witnessProfile (s : S) : W → Prop := C.pass s

theorem indistinguishable_iff_profile_eq (s₁ s₂ : S) :
    (∀ U : Set S, @IsOpen S (witnessTopology C) U → (s₁ ∈ U ↔ s₂ ∈ U)) ↔
      witnessProfile C s₁ = witnessProfile C s₂ := by
  rw [indistinguishable_iff_sameWitnesses]
  constructor
  · intro h; funext w; exact propext (h w)
  · intro h w; exact (congrFun h w).to_iff

/-- **Finite-witness compactness**: whenever the discriminator witness family `W` is finite,
every open set is a union of the finitely many profile-equivalence classes, so the entire
specification space `(S, witnessTopology C)` is compact. -/
theorem isCompact_of_finiteWitnesses [Fintype W] :
    @IsCompact S (witnessTopology C) Set.univ := by
  classical
  let _ := witnessTopology C
  rw [isCompact_iff_finite_subcover]
  intro ι U hU hcover
  -- Map each point to its finite witness signature `W → Bool`.
  let sig : S → (W → Bool) := fun s w => decide (C.pass s w)
  -- For each realized signature `p`, choose one representative spec and one covering open.
  let realized : Finset (W → Bool) := Finset.univ.filter (fun p => ∃ s : S, sig s = p)
  have pick : ∀ p ∈ realized, ∃ i : ι, ∃ s : S, sig s = p ∧ s ∈ U i := by
    intro p hp
    obtain ⟨s, hs⟩ := (Finset.mem_filter.mp hp).2
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcover (Set.mem_univ s))
    exact ⟨i, s, hs, hi⟩
  choose idx rep hrep_sig hrep_mem using pick
  refine ⟨realized.attach.image (fun p => idx p.1 p.2), ?_⟩
  intro s _
  have hmem : sig s ∈ realized := Finset.mem_filter.mpr ⟨Finset.mem_univ _, ⟨s, rfl⟩⟩
  refine Set.mem_iUnion₂.mpr ⟨idx (sig s) hmem,
    Finset.mem_image.mpr ⟨⟨sig s, hmem⟩, Finset.mem_attach _ _, rfl⟩, ?_⟩
  have hsame : ∀ w : W, C.pass (rep (sig s) hmem) w ↔ C.pass s w := by
    intro w
    have hbool := congrFun (hrep_sig (sig s) hmem) w
    simpa [sig] using hbool
  exact ((indistinguishable_iff_sameWitnesses C (rep (sig s) hmem) s).mpr hsame
    (U (idx (sig s) hmem)) (hU _)).mp (hrep_mem (sig s) hmem)

end WitnessTopology

/-! ## Quantitative (graded) Chu space and directed defect -/

/-- A **graded Chu space**: each witness returns a preservation score in `[0, 1]`. -/
structure GradedChuSpace (S : Type uS) (W : Type uW) where
  score : S → W → ℝ
  nonneg : ∀ s w, 0 ≤ score s w
  le_one : ∀ s w, score s w ≤ 1

section GradedChu

variable {S : Type uS} {W : Type uW} (G : GradedChuSpace S W)

/-- Directed witness-score gap from `s₁` to `s₂`: supremum loss over all witnesses. -/
noncomputable def gradedDefect (s₁ s₂ : S) : ℝ :=
  sSup (insert (0 : ℝ) (Set.range fun w : W => G.score s₁ w - G.score s₂ w))

theorem bddAbove_gradedGaps (s₁ s₂ : S) :
    BddAbove (insert (0 : ℝ) (Set.range fun w : W => G.score s₁ w - G.score s₂ w)) := by
  refine ⟨1, ?_⟩
  rintro _ (rfl | ⟨w, rfl⟩)
  · exact zero_le_one
  · linarith [G.le_one s₁ w, G.nonneg s₂ w]

theorem gradedDefect_nonneg (s₁ s₂ : S) : 0 ≤ gradedDefect G s₁ s₂ :=
  le_csSup (bddAbove_gradedGaps G s₁ s₂) (Set.mem_insert 0 _)

theorem gradedDefect_self (s : S) : gradedDefect G s s = 0 := by
  apply le_antisymm _ (gradedDefect_nonneg G s s)
  apply csSup_le (Set.insert_nonempty _ _)
  rintro _ (rfl | ⟨w, rfl⟩)
  · exact le_rfl
  · linarith

/-- **Directed triangle inequality** for the quantitative Chu space defect. -/
theorem gradedDefect_triangle (a b c : S) :
    gradedDefect G a c ≤ gradedDefect G a b + gradedDefect G b c := by
  apply csSup_le (Set.insert_nonempty _ _)
  rintro _ (rfl | ⟨w, rfl⟩)
  · exact add_nonneg (gradedDefect_nonneg G a b) (gradedDefect_nonneg G b c)
  · have h1 : G.score a w - G.score b w ≤ gradedDefect G a b :=
      le_csSup (bddAbove_gradedGaps G a b) (Set.mem_insert_of_mem _ ⟨w, rfl⟩)
    have h2 : G.score b w - G.score c w ≤ gradedDefect G b c :=
      le_csSup (bddAbove_gradedGaps G b c) (Set.mem_insert_of_mem _ ⟨w, rfl⟩)
    linarith

/-- Zero graded defect coincides with pointwise witness dominance `∀ w, score a w ≤ score b w`. -/
theorem gradedDefect_eq_zero_iff (a b : S) :
    gradedDefect G a b = 0 ↔ ∀ w : W, G.score a w ≤ G.score b w := by
  constructor
  · intro hzero w
    have hle : G.score a w - G.score b w ≤ gradedDefect G a b :=
      le_csSup (bddAbove_gradedGaps G a b) (Set.mem_insert_of_mem _ ⟨w, rfl⟩)
    linarith
  · intro hdom
    apply le_antisymm _ (gradedDefect_nonneg G a b)
    apply csSup_le (Set.insert_nonempty _ _)
    rintro _ (rfl | ⟨w, rfl⟩)
    · exact le_rfl
    · linarith [hdom w]

end GradedChu

end Mettapedia.GSLT.Distinction.SpecSpace
