import Mettapedia.Machines.BranchLocalNeed.Worlds
import Mettapedia.GSLT.Causality.SiteValuationDescent
import Mettapedia.Algebra.OrderedProductCommutation

/-!
# Causal prefix gluing and the swap law of footprinted occurrences

Two branches extend a shared causal prefix.  Gluing them keeps each logical
event once, checks conflicts only between the two exclusive extensions
(`NeedWorlds.Configuration.compatible_iff_exclusive_hazards`), and then has to
say what the glued run observes.  This module gives the occurrences an actual
semantics and derives the independence of the trace monoid from it.

* **Footprinted occurrences** (`Occurrences`).  Each logical occurrence identity
  has a footprint, the cells it reads and the payload it writes to each cell it
  writes, and possibly an observed channel of the declared observer.  The store
  records every cell's value together with the occurrence that wrote it, so two
  writes with equal payloads remain distinct events.
* **Independence from the actual conditions** (`Occurrences.Independent`).  Two
  distinct occurrences are independent when neither writes a cell the other
  reads or writes (`Hazard`), and the declared observer does not see both on one
  ordered channel (`SharesChannel`).  Shared reads are not hazards; they still
  depend on each other when one ordered channel observes both.
* **The swap law** (`final_swap`, `log_swap`, `observe_swap`, `account_swap`).
  Swapping two adjacent independent occurrences keeps the final store with its
  provenance, every occurrence's own reading, every channel's ordered
  observation, the multiset of occurrence identities, and a declared account in
  a commutative monoid.  For an account in a noncommutative monoid the tile needs
  its own lawful condition, that the two coefficients commute
  (`account_tile_iff_commute`).
* **The trace equivalence** (`TraceEquiv`) is generated by those swaps and keeps
  all of these readings (`TraceEquiv.final_eq`, `TraceEquiv.observe_eq`,
  `TraceEquiv.perm`, `TraceEquiv.account_eq`).  Mutually independent blocks
  commute (`TraceEquiv.block`).
* **The configuration machine** (`Fires`).  An occurrence fires once, after its
  causal support, and conflicts with nothing already fired.  Every run fires a
  causal configuration of `NeedWorlds` (`fires_configuration`).  As an event
  concurrency of the shared trace core, its site valuations and declared
  accounts descend by the shared criterion of `Causality.SiteValuationDescent`
  (`siteValuation_descends`, `accountValuation_descends_iff`).
* **Causal prefix gluing** (`glue_fires_iff`, `glue_trace`, `glue_log`).  With
  conflict the causally unordered dependence, two branch runs through a common
  prefix glue to a run exactly when their configurations are compatible, which
  the exclusive hazard check decides.  The glued run fires the join
  configuration, each event once (`glue_events`); every interleaving of the two
  exclusive extensions is trace equivalent; each extension reads exactly what it
  read in its own branch, and the glued store agrees with each branch outside
  the other branch's writes.  Removing shared identities from the second branch
  (`glue`) builds the glued run.

Nothing here concerns the physical lock-freedom of a runtime, and a
commutative syntax for parallel composition does not by itself supply any of
these premises (the controls).
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Distinction.CausalGluing

open Mettapedia.Machines.BranchLocalNeed.NeedWorlds

/-! ## Footprinted occurrences on a store with provenance -/

/-- What one occurrence does to the store: the cells it reads, and the payload
it writes to each cell it writes. -/
structure Footprint (Cell Value : Type) where
  reads : Cell → Bool
  writes : Cell → Option Value

/-- Occurrences with logical identities.  Each identity has a footprint and,
when the declared observer sees it, an observed channel.  Distinct identities
may carry equal footprints. -/
structure Occurrences (Id Cell Value Channel : Type) where
  footprint : Id → Footprint Cell Value
  channel : Id → Option Channel

/-- A store: each cell's value with the occurrence that wrote it (`none` for the
initial value). -/
abbrev Store (Id Cell Value : Type) := Cell → Value × Option Id

/-- What an occurrence read: the contents, with provenance, of its read cells. -/
abbrev Reading (Id Cell Value : Type) := Cell → Option (Value × Option Id)

namespace Occurrences

variable {Id Cell Value Channel : Type} (O : Occurrences Id Cell Value Channel)

/-- Fire occurrence `i`: each cell it writes takes its payload, with `i` as the
writer. -/
def apply (i : Id) (store : Store Id Cell Value) : Store Id Cell Value := fun cell =>
  match (O.footprint i).writes cell with
  | some payload => (payload, some i)
  | none => store cell

/-- What occurrence `i` reads from a store. -/
def seen (i : Id) (store : Store Id Cell Value) : Reading Id Cell Value := fun cell =>
  if (O.footprint i).reads cell then some (store cell) else none

/-- The store after a word of occurrences. -/
def final : List Id → Store Id Cell Value → Store Id Cell Value
  | [], store => store
  | i :: rest, store => final rest (O.apply i store)

/-- The ordered log of a word: each occurrence with what it read. -/
def log : List Id → Store Id Cell Value → List (Id × Reading Id Cell Value)
  | [], _ => []
  | i :: rest, store => (i, O.seen i store) :: log rest (O.apply i store)

theorem final_append (u w : List Id) (store : Store Id Cell Value) :
    O.final (u ++ w) store = O.final w (O.final u store) := by
  induction u generalizing store with
  | nil => rfl
  | cons i u ih => exact ih (O.apply i store)

theorem log_append (u w : List Id) (store : Store Id Cell Value) :
    O.log (u ++ w) store = O.log u store ++ O.log w (O.final u store) := by
  induction u generalizing store with
  | nil => rfl
  | cons i u ih =>
      change (i, O.seen i store) :: O.log (u ++ w) (O.apply i store) =
        (i, O.seen i store) :: (O.log u (O.apply i store) ++ O.log w (O.final u (O.apply i store)))
      rw [ih]

/-- Occurrence `i` writes `cell`. -/
def Writes (i : Id) (cell : Cell) : Prop := ((O.footprint i).writes cell).isSome = true

/-- Occurrence `i` reads `cell`. -/
def Reads (i : Id) (cell : Cell) : Prop := (O.footprint i).reads cell = true

/-- **The read/write hazard**: `a` writes a cell that `b` writes or reads. -/
def Hazard (a b : Id) : Prop :=
  ∃ cell, O.Writes a cell ∧ (O.Writes b cell ∨ O.Reads b cell)

/-- **The observation condition**: the declared observer sees both occurrences
on one channel, which orders them. -/
def SharesChannel (a b : Id) : Prop :=
  ∃ channel, O.channel a = some channel ∧ O.channel b = some channel

/-- Dependence: a hazard or a common observed channel. -/
def Dependent (a b : Id) : Prop := O.Hazard a b ∨ O.SharesChannel a b

/-- **Independence supplied by the actual conditions**: distinct occurrences, no
hazard in either direction, and no common observed channel. -/
def Independent (a b : Id) : Prop := a ≠ b ∧ ¬ O.Dependent a b ∧ ¬ O.Dependent b a

theorem Independent.symm {O : Occurrences Id Cell Value Channel} {a b : Id}
    (independent : O.Independent a b) : O.Independent b a :=
  ⟨independent.1.symm, independent.2.2, independent.2.1⟩

theorem Independent.no_common_write {O : Occurrences Id Cell Value Channel} {a b : Id}
    (independent : O.Independent a b) (cell : Cell) : ¬ (O.Writes a cell ∧ O.Writes b cell) :=
  fun both => independent.2.1 (.inl ⟨cell, both.1, .inl both.2⟩)

theorem Independent.unread_left {O : Occurrences Id Cell Value Channel} {a b : Id}
    (independent : O.Independent a b) (cell : Cell) : O.Reads b cell → ¬ O.Writes a cell :=
  fun reads writes => independent.2.1 (.inl ⟨cell, writes, .inr reads⟩)

theorem Independent.unread_right {O : Occurrences Id Cell Value Channel} {a b : Id}
    (independent : O.Independent a b) (cell : Cell) : O.Reads a cell → ¬ O.Writes b cell :=
  independent.symm.unread_left cell

theorem Independent.no_common_channel {O : Occurrences Id Cell Value Channel} {a b : Id}
    (independent : O.Independent a b) : ¬ O.SharesChannel a b :=
  fun shares => independent.2.1 (.inr shares)

theorem apply_of_not_writes {i : Id} {cell : Cell} (unwritten : ¬ O.Writes i cell)
    (store : Store Id Cell Value) : O.apply i store cell = store cell := by
  cases written : (O.footprint i).writes cell with
  | none => simp only [apply, written]
  | some payload => exact absurd (by simp [Writes, written]) unwritten

theorem apply_of_writes {i : Id} {cell : Cell} {payload : Value}
    (written : (O.footprint i).writes cell = some payload) (store : Store Id Cell Value) :
    O.apply i store cell = (payload, some i) := by
  simp only [apply, written]

/-- Occurrences writing disjoint cells commute on the store, provenance
included. -/
theorem apply_comm {a b : Id} (disjoint : ∀ cell, ¬ (O.Writes a cell ∧ O.Writes b cell))
    (store : Store Id Cell Value) :
    O.apply a (O.apply b store) = O.apply b (O.apply a store) := by
  funext cell
  cases writtenA : (O.footprint a).writes cell with
  | none =>
      cases writtenB : (O.footprint b).writes cell with
      | none => simp only [apply, writtenA, writtenB]
      | some payloadB => simp only [apply, writtenA, writtenB]
  | some payloadA =>
      cases writtenB : (O.footprint b).writes cell with
      | none => simp only [apply, writtenA, writtenB]
      | some payloadB =>
          exact absurd ⟨by simp [Writes, writtenA], by simp [Writes, writtenB]⟩ (disjoint cell)

/-- An occurrence reads the same after another that writes none of its read
cells. -/
theorem seen_apply {a b : Id} (unread : ∀ cell, O.Reads a cell → ¬ O.Writes b cell)
    (store : Store Id Cell Value) : O.seen a (O.apply b store) = O.seen a store := by
  funext cell
  cases reads : (O.footprint a).reads cell with
  | false => simp [seen, reads]
  | true => simp [seen, reads, O.apply_of_not_writes (unread cell reads)]

/-! ## The swap law -/

theorem final_swap {a b : Id} (independent : O.Independent a b) (u v : List Id)
    (store : Store Id Cell Value) :
    O.final (u ++ a :: b :: v) store = O.final (u ++ b :: a :: v) store := by
  rw [O.final_append, O.final_append]
  change O.final v (O.apply b (O.apply a _)) = O.final v (O.apply a (O.apply b _))
  rw [O.apply_comm (fun cell => independent.symm.no_common_write cell)]

/-- The two orders of an independent tile log the same two emissions, in the
two orders, and continue from the same store. -/
theorem log_tile {a b : Id} (independent : O.Independent a b) (v : List Id)
    (store : Store Id Cell Value) :
    O.log (a :: b :: v) store =
        (a, O.seen a store) :: (b, O.seen b store) :: O.log v (O.apply b (O.apply a store)) ∧
      O.log (b :: a :: v) store =
        (b, O.seen b store) :: (a, O.seen a store) :: O.log v (O.apply b (O.apply a store)) := by
  constructor
  · change (a, O.seen a store) :: (b, O.seen b (O.apply a store)) :: _ = _
    rw [O.seen_apply (fun cell => independent.unread_left cell)]
  · change (b, O.seen b store) :: (a, O.seen a (O.apply b store)) ::
      O.log v (O.apply a (O.apply b store)) = _
    rw [O.seen_apply (fun cell => independent.unread_right cell),
      O.apply_comm (fun cell => independent.no_common_write cell)]

variable [DecidableEq Channel]

/-- **The declared observer**: each channel's ordered emissions. -/
def observe (w : List Id) (store : Store Id Cell Value) (channel : Channel) :
    List (Id × Reading Id Cell Value) :=
  (O.log w store).filter fun emission => decide (O.channel emission.1 = some channel)

theorem observe_swap {a b : Id} (independent : O.Independent a b) (u v : List Id)
    (store : Store Id Cell Value) :
    O.observe (u ++ a :: b :: v) store = O.observe (u ++ b :: a :: v) store := by
  funext channel
  simp only [observe, O.log_append, List.filter_append]
  congr 1
  obtain ⟨first, second⟩ := O.log_tile independent v (O.final u store)
  rw [first, second]
  by_cases seenA : O.channel a = some channel
  · have unseenB : O.channel b ≠ some channel :=
      fun seenB => independent.no_common_channel ⟨channel, seenA, seenB⟩
    simp [seenA, unseenB]
  · by_cases seenB : O.channel b = some channel
    · simp [seenA, seenB]
    · simp [seenA, seenB]

/-- The declared account of a word: the ordered product of the occurrences'
coefficients. -/
def account {M : Type} [Monoid M] (coefficient : Id → M) (w : List Id) : M :=
  (w.map coefficient).prod

theorem account_swap {M : Type} [Monoid M] (coefficient : Id → M) {a b : Id}
    (commute : Commute (coefficient a) (coefficient b)) (u v : List Id) :
    account coefficient (u ++ a :: b :: v) = account coefficient (u ++ b :: a :: v) := by
  have swapped := Mettapedia.Algebra.OrderedProductCommutation.prod_swap_of_commute commute
    (u.map coefficient) (v.map coefficient)
  simpa only [account, List.map_append, List.map_cons] using swapped

/-- **The lawful swap condition of a noncommutative account**: the tile keeps
the account exactly when the two coefficients commute.  This is
`Algebra.OrderedProductCommutation.prod_pair_eq_iff_commute`, the one-occurrence
case of the move that also decides `ProductionLicences.eager_eq_lazy_iff_commute_denote`. -/
theorem account_tile_iff_commute {M : Type} [Monoid M] (coefficient : Id → M) (a b : Id) :
    account coefficient [a, b] = account coefficient [b, a] ↔
      Commute (coefficient a) (coefficient b) :=
  Mettapedia.Algebra.OrderedProductCommutation.prod_pair_eq_iff_commute (coefficient a)
    (coefficient b)

/-- **Moving one occurrence across a block** of a noncommutative account: the
account is kept exactly when the occurrence's coefficient commutes with the
block's account. -/
theorem account_cons_eq_concat_iff {M : Type} [Monoid M] (coefficient : Id → M) (a : Id)
    (block : List Id) :
    account coefficient (a :: block) = account coefficient (block ++ [a]) ↔
      Commute (coefficient a) (account coefficient block) :=
  Mettapedia.Algebra.OrderedProductCommutation.map_prod_cons_eq_concat_iff coefficient a block

end Occurrences

/-! ## The trace equivalence generated by independent swaps -/

section Traces

variable {Id : Type}

/-- One swap of two adjacent independent occurrences. -/
inductive Swap (independent : Id → Id → Prop) : List Id → List Id → Prop
  | swap (u v : List Id) {a b : Id} : independent a b →
      Swap independent (u ++ a :: b :: v) (u ++ b :: a :: v)

/-- **The trace equivalence**: the equivalence generated by independent swaps. -/
abbrev TraceEquiv (independent : Id → Id → Prop) : List Id → List Id → Prop :=
  Relation.EqvGen (Swap independent)

variable {independent : Id → Id → Prop}

/-- A reading that every tile keeps is a property of the trace. -/
theorem TraceEquiv.invariant {β : Sort*} (reading : List Id → β)
    (tile : ∀ (u v : List Id) (a b : Id), independent a b →
      reading (u ++ a :: b :: v) = reading (u ++ b :: a :: v))
    {w w' : List Id} (equivalent : TraceEquiv independent w w') : reading w = reading w' := by
  induction equivalent with
  | rel _ _ swapped =>
      cases swapped with
      | swap u v related => exact tile u v _ _ related
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ first second => exact first.trans second

/-- Trace equivalent words are permutations of each other: occurrence
identities are kept with their multiplicities. -/
theorem TraceEquiv.perm {w w' : List Id} (equivalent : TraceEquiv independent w w') :
    List.Perm w w' := by
  have same := TraceEquiv.invariant (fun w : List Id => (w : Multiset Id))
    (fun u v a b _ => Multiset.coe_eq_coe.mpr ((List.Perm.swap b a v).append_left u)) equivalent
  exact Multiset.coe_eq_coe.mp same

theorem TraceEquiv.mono {other : Id → Id → Prop} (included : ∀ a b, independent a b → other a b)
    {w w' : List Id} (equivalent : TraceEquiv independent w w') : TraceEquiv other w w' := by
  induction equivalent with
  | rel _ _ swapped =>
      cases swapped with
      | swap u v related => exact .rel _ _ (.swap u v (included _ _ related))
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

theorem TraceEquiv.append_left (p : List Id) {w w' : List Id}
    (equivalent : TraceEquiv independent w w') : TraceEquiv independent (p ++ w) (p ++ w') := by
  induction equivalent with
  | rel _ _ swapped =>
      cases swapped with
      | swap u v related =>
          have step := Swap.swap (p ++ u) v related
          simp only [List.append_assoc] at step
          exact .rel _ _ step
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

theorem TraceEquiv.append_right (q : List Id) {w w' : List Id}
    (equivalent : TraceEquiv independent w w') : TraceEquiv independent (w ++ q) (w' ++ q) := by
  induction equivalent with
  | rel _ _ swapped =>
      cases swapped with
      | swap u v related =>
          have step := Swap.swap u (v ++ q) related
          simp only [List.append_assoc, List.cons_append] at step ⊢
          exact .rel _ _ step
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

/-- An occurrence independent of a whole block moves across it. -/
theorem TraceEquiv.cons_across (a : Id) (r t : List Id) (across : ∀ b ∈ r, independent a b) :
    TraceEquiv independent (a :: (r ++ t)) (r ++ a :: t) := by
  induction r with
  | nil => exact .refl _
  | cons b r ih =>
      have first : TraceEquiv independent (a :: b :: (r ++ t)) (b :: a :: (r ++ t)) :=
        .rel _ _ (by simpa using Swap.swap [] (r ++ t) (across b (List.mem_cons_self ..)))
      have rest := TraceEquiv.append_left [b]
        (ih fun c member => across c (List.mem_cons_of_mem b member))
      exact .trans _ _ _ first (by simpa using rest)

/-- **Mutually independent blocks commute.** -/
theorem TraceEquiv.block (l r : List Id) (across : ∀ a ∈ l, ∀ b ∈ r, independent a b) :
    TraceEquiv independent (l ++ r) (r ++ l) := by
  induction l with
  | nil => simpa using (Relation.EqvGen.refl r : TraceEquiv independent r r)
  | cons a l ih =>
      have inner := TraceEquiv.append_left [a]
        (ih fun c member b inR => across c (List.mem_cons_of_mem a member) b inR)
      have moved := TraceEquiv.cons_across a r l (across a (List.mem_cons_self ..))
      exact .trans _ _ _ (by simpa using inner) moved

end Traces

namespace Occurrences

variable {Id Cell Value Channel : Type} (O : Occurrences Id Cell Value Channel)

/-- **The swap law on traces**: trace equivalent words reach the same store, with
its provenance. -/
theorem final_eq_of_trace {w w' : List Id} (equivalent : TraceEquiv O.Independent w w')
    (store : Store Id Cell Value) : O.final w store = O.final w' store :=
  TraceEquiv.invariant (fun w => O.final w store)
    (fun u v _ _ independent => O.final_swap independent u v store) equivalent

/-- Trace equivalent words have the same observation on every channel. -/
theorem observe_eq_of_trace [DecidableEq Channel] {w w' : List Id}
    (equivalent : TraceEquiv O.Independent w w') (store : Store Id Cell Value) :
    O.observe w store = O.observe w' store :=
  TraceEquiv.invariant (fun w => O.observe w store)
    (fun u v _ _ independent => O.observe_swap independent u v store) equivalent

/-- A commutative declared account is a property of the trace. -/
theorem account_eq_of_trace_comm {M : Type} [CommMonoid M] (coefficient : Id → M)
    {independent : Id → Id → Prop} {w w' : List Id} (equivalent : TraceEquiv independent w w') :
    account coefficient w = account coefficient w' :=
  ((TraceEquiv.perm equivalent).map coefficient).prod_eq

/-- A noncommutative declared account is a property of the trace of the swaps
whose coefficients commute. -/
theorem account_eq_of_trace {M : Type} [Monoid M] (coefficient : Id → M)
    {independent : Id → Id → Prop}
    (lawful : ∀ a b, independent a b → Commute (coefficient a) (coefficient b))
    {w w' : List Id} (equivalent : TraceEquiv independent w w') :
    account coefficient w = account coefficient w' :=
  TraceEquiv.invariant (account coefficient)
    (fun u v a b related => account_swap coefficient (lawful a b related) u v) equivalent

/-! ## What a block reads after an unrelated block -/

/-- A word reads the same from two stores that agree on every cell it reads. -/
theorem log_congr {w : List Id} {first second : Store Id Cell Value}
    (agree : ∀ cell, (∃ i ∈ w, O.Reads i cell) → first cell = second cell) :
    O.log w first = O.log w second := by
  induction w generalizing first second with
  | nil => rfl
  | cons i w ih =>
      have sameSeen : O.seen i first = O.seen i second := by
        funext cell
        cases reads : (O.footprint i).reads cell with
        | false => simp [seen, reads]
        | true =>
            simp only [seen, reads, if_true]
            rw [agree cell ⟨i, List.mem_cons_self .., reads⟩]
      have rest : O.log w (O.apply i first) = O.log w (O.apply i second) := by
        apply ih
        rintro cell ⟨j, member, reads⟩
        cases written : (O.footprint i).writes cell with
        | none =>
            simp only [apply, written]
            exact agree cell ⟨j, List.mem_cons_of_mem i member, reads⟩
        | some payload => simp only [apply, written]
      change (i, O.seen i first) :: O.log w (O.apply i first) =
        (i, O.seen i second) :: O.log w (O.apply i second)
      rw [sameSeen, rest]

/-- A cell no occurrence of a word writes keeps its contents. -/
theorem final_unwritten {w : List Id} {cell : Cell} (unwritten : ∀ i ∈ w, ¬ O.Writes i cell)
    (store : Store Id Cell Value) : O.final w store cell = store cell := by
  induction w generalizing store with
  | nil => rfl
  | cons i w ih =>
      change O.final w (O.apply i store) cell = store cell
      rw [ih (fun j member => unwritten j (List.mem_cons_of_mem i member)),
        O.apply_of_not_writes (unwritten i (List.mem_cons_self ..))]

/-- **A block reads exactly what it read without an earlier block that writes
none of its read cells.** -/
theorem log_after_unrelated {l r : List Id}
    (unread : ∀ a ∈ l, ∀ b ∈ r, ∀ cell, O.Reads b cell → ¬ O.Writes a cell)
    (store : Store Id Cell Value) : O.log r (O.final l store) = O.log r store :=
  O.log_congr fun cell ⟨b, member, reads⟩ =>
    O.final_unwritten (fun a inL => unread a inL b member cell reads) store

end Occurrences

/-! ## The configuration machine -/

section Firing

variable {Id : Type} [DecidableEq Id] (basis : FiniteCausalBasis Id) (conflict : Id → Id → Prop)

/-- Occurrence `i` may fire after `done`: it has not fired, its causal support
has, and it conflicts with nothing that has, in either orientation. -/
def Enabled (done : Finset Id) (i : Id) : Prop :=
  i ∉ done ∧ basis.support i ⊆ insert i done ∧ ∀ d ∈ done, ¬ conflict d i ∧ ¬ conflict i d

/-- A run of the configuration machine: each occurrence enabled when it fires. -/
def Fires : Finset Id → List Id → Prop
  | _, [] => True
  | done, i :: rest => Enabled basis conflict done i ∧ Fires (insert i done) rest

variable {basis conflict}

theorem fires_append (done : Finset Id) (u w : List Id) :
    Fires basis conflict done (u ++ w) ↔
      Fires basis conflict done u ∧ Fires basis conflict (done ∪ u.toFinset) w := by
  induction u generalizing done with
  | nil => simp [Fires]
  | cons i u ih =>
      change Enabled basis conflict done i ∧ Fires basis conflict (insert i done) (u ++ w) ↔
        (Enabled basis conflict done i ∧ Fires basis conflict (insert i done) u) ∧ _
      rw [ih, List.toFinset_cons, Finset.union_insert, ← Finset.insert_union, and_assoc]

/-- **Occurrence identity**: a run fires each logical occurrence once, and none
that had fired. -/
theorem fires_nodup {done : Finset Id} {w : List Id} (runs : Fires basis conflict done w) :
    w.Nodup ∧ ∀ i ∈ w, i ∉ done := by
  induction w generalizing done with
  | nil => exact ⟨List.nodup_nil, fun _ member => by simp at member⟩
  | cons i w ih =>
      obtain ⟨enabled, rest⟩ := runs
      obtain ⟨nodup, fresh⟩ := ih rest
      refine ⟨List.nodup_cons.mpr ⟨fun member => fresh i member (Finset.mem_insert_self i done),
        nodup⟩, ?_⟩
      intro j member
      rcases List.mem_cons.mp member with rfl | inRest
      · exact enabled.1
      · exact fun inDone => fresh j inRest (Finset.mem_insert_of_mem inDone)

theorem closed_insert {done : Finset Id} {i : Id} (closed : basis.Closed done)
    (supported : basis.support i ⊆ insert i done) : basis.Closed (insert i done) := by
  unfold FiniteCausalBasis.Closed FiniteCausalBasis.close at closed ⊢
  rw [Finset.biUnion_insert, closed]
  apply Finset.Subset.antisymm
  · exact Finset.union_subset supported (Finset.subset_insert i done)
  · intro j member
    rcases Finset.mem_insert.mp member with rfl | inDone
    · exact Finset.mem_union_left _ (basis.self_mem j)
    · exact Finset.mem_union_right _ inDone

/-- The occurrences fired by a run, together with those already fired, form a
causally closed set. -/
theorem fires_closed {done : Finset Id} {w : List Id} (runs : Fires basis conflict done w)
    (closed : basis.Closed done) : basis.Closed (done ∪ w.toFinset) := by
  induction w generalizing done with
  | nil => simpa using closed
  | cons i w ih =>
      obtain ⟨enabled, rest⟩ := runs
      have grown := ih rest (closed_insert closed enabled.2.1)
      rwa [List.toFinset_cons, Finset.union_insert, ← Finset.insert_union]

/-- ... and a conflict-free one, when conflict is irreflexive. -/
theorem fires_conflictFree {done : Finset Id} {w : List Id} (runs : Fires basis conflict done w)
    (free : ConflictFree conflict done) (irreflexive : ∀ i, ¬ conflict i i) :
    ConflictFree conflict (done ∪ w.toFinset) := by
  induction w generalizing done with
  | nil => simpa using free
  | cons i w ih =>
      obtain ⟨enabled, rest⟩ := runs
      have grown : ConflictFree conflict (insert i done) := by
        intro left right inLeft inRight
        rcases Finset.mem_insert.mp inLeft with rfl | leftDone <;>
          rcases Finset.mem_insert.mp inRight with rfl | rightDone
        · exact irreflexive _
        · exact (enabled.2.2 right rightDone).2
        · exact (enabled.2.2 left leftDone).1
        · exact free leftDone rightDone
      have result := ih rest grown
      rwa [List.toFinset_cons, Finset.union_insert, ← Finset.insert_union]

/-- Firing remains possible after occurrences outside the word that conflict
with none of it. -/
theorem fires_enlarge {done : Finset Id} {w : List Id} (runs : Fires basis conflict done w)
    (extra : Finset Id) (outside : ∀ i ∈ w, i ∉ extra)
    (compatible : ∀ i ∈ w, ∀ e ∈ extra, ¬ conflict e i ∧ ¬ conflict i e) :
    Fires basis conflict (done ∪ extra) w := by
  induction w generalizing done with
  | nil => trivial
  | cons i w ih =>
      obtain ⟨⟨fresh, supported, safe⟩, rest⟩ := runs
      show Enabled basis conflict (done ∪ extra) i ∧ Fires basis conflict (insert i (done ∪ extra)) w
      refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
      · intro member
        rcases Finset.mem_union.mp member with inDone | inExtra
        · exact fresh inDone
        · exact outside i (List.mem_cons_self ..) inExtra
      · intro j member
        rcases Finset.mem_insert.mp (supported member) with rfl | inDone
        · exact Finset.mem_insert_self _ _
        · exact Finset.mem_insert_of_mem (Finset.mem_union_left _ inDone)
      · intro d member
        rcases Finset.mem_union.mp member with inDone | inExtra
        · exact safe d inDone
        · exact compatible i (List.mem_cons_self ..) d inExtra
      · have later := ih rest (fun j member => outside j (List.mem_cons_of_mem i member))
          (fun j member => compatible j (List.mem_cons_of_mem i member))
        rwa [Finset.insert_union] at later

/-- **Every run of the configuration machine fires a causal configuration.** -/
def firedConfiguration {w : List Id} (runs : Fires basis conflict ∅ w)
    (irreflexive : ∀ i, ¬ conflict i i) : Configuration basis conflict where
  events := w.toFinset
  closed := by
    have closed := fires_closed runs (by
      simp [FiniteCausalBasis.Closed, FiniteCausalBasis.close])
    simpa using closed
  consistent := by
    have free := fires_conflictFree runs (by intro _ _ member; simp at member) irreflexive
    simpa using free

end Firing

/-! ## Causal prefix gluing -/

namespace Occurrences

variable {Id Cell Value Channel : Type} [DecidableEq Id]
  (O : Occurrences Id Cell Value Channel) (basis : FiniteCausalBasis Id)

/-- **Causal conflict of the declared dependence**: dependent occurrences that
are causally unordered. -/
abbrev conflict : Id → Id → Prop := basis.unorderedConflict O.Dependent

theorem conflict_irreflexive (i : Id) : ¬ O.conflict basis i i :=
  fun conflicting => conflicting.2.1 (basis.self_mem i)

/-- Exclusive occurrences of compatible configurations are independent. -/
theorem exclusive_independent (left right : Configuration basis (O.conflict basis))
    (compatible : Configuration.Compatible left right) {a b : Id}
    (inLeft : a ∈ left.events \ right.events) (inRight : b ∈ right.events \ left.events) :
    O.Independent a b := by
  have checked := (Configuration.compatible_iff_exclusive_hazards O.Dependent left right).mp
    compatible a inLeft b inRight
  refine ⟨?_, checked.1, checked.2⟩
  rintro rfl
  exact (Finset.mem_sdiff.mp inLeft).2 (Finset.mem_sdiff.mp inRight).1

/-- Remove from the second branch the logical identities the first already
fired; payloads play no part. -/
def glue (first second : List Id) : List Id :=
  first ++ second.filter fun i => decide (i ∉ first)

/-- Removing shared identities from a branch through a common prefix leaves
its exclusive extension. -/
theorem glue_prefix (p l r : List Id) (fresh : ∀ b ∈ r, b ∉ p ++ l) :
    glue (p ++ l) (p ++ r) = p ++ l ++ r := by
  have dropped : p.filter (fun i => decide (i ∉ p ++ l)) = [] :=
    List.filter_eq_nil_iff.mpr fun a member => by simp [member]
  have kept : r.filter (fun i => decide (i ∉ p ++ l)) = r :=
    List.filter_eq_self.mpr fun b member => by simpa using fresh b member
  simp only [glue, List.filter_append, dropped, kept, List.nil_append]

variable {O basis}

/-- **The glued run fires the join**, each logical event once. -/
theorem glue_events {left right : Configuration basis (O.conflict basis)}
    (compatible : Configuration.Compatible left right) {p l r : List Id}
    (shared : p.toFinset = left.events ∩ right.events)
    (leftOnly : l.toFinset = left.events \ right.events)
    (rightOnly : r.toFinset = right.events \ left.events) :
    (p ++ l ++ r).toFinset = (Configuration.join left right compatible).events := by
  change _ = basis.close (left.events ∪ right.events)
  rw [Configuration.union_closed, List.toFinset_append, List.toFinset_append, shared, leftOnly,
    rightOnly]
  ext event
  simp only [Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff]
  tauto

/-- **Causal prefix gluing.** Two branch runs through a common prefix, with
exclusive extensions `l` and `r`, glue to a run of the configuration machine
exactly when their configurations are compatible. -/
theorem glue_fires_iff (left right : Configuration basis (O.conflict basis)) {p l r : List Id}
    (leftRun : Fires basis (O.conflict basis) ∅ (p ++ l))
    (rightRun : Fires basis (O.conflict basis) ∅ (p ++ r))
    (shared : p.toFinset = left.events ∩ right.events)
    (leftOnly : l.toFinset = left.events \ right.events)
    (rightOnly : r.toFinset = right.events \ left.events) :
    Fires basis (O.conflict basis) ∅ (p ++ l ++ r) ↔ Configuration.Compatible left right := by
  constructor
  · intro glued
    rw [Configuration.compatible_iff_union_conflict_free]
    have free := fires_conflictFree glued (by intro _ _ member; simp at member)
      (O.conflict_irreflexive basis)
    have events : (∅ : Finset Id) ∪ (p ++ l ++ r).toFinset = left.events ∪ right.events := by
      rw [Finset.empty_union, List.toFinset_append, List.toFinset_append, shared, leftOnly,
        rightOnly]
      ext event
      simp only [Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff]
      tauto
    rwa [events] at free
  · intro compatible
    rw [fires_append]
    refine ⟨leftRun, ?_⟩
    have rightRest := ((fires_append ∅ p r).mp rightRun).2
    have enlarged := fires_enlarge rightRest l.toFinset
      (fun b member inL => by
        have onlyRight : b ∈ right.events \ left.events := rightOnly ▸ List.mem_toFinset.mpr member
        have leftEvent : b ∈ left.events \ right.events := leftOnly ▸ inL
        exact (Finset.mem_sdiff.mp onlyRight).2 (Finset.mem_sdiff.mp leftEvent).1)
      (fun b member a inL => by
        have onlyRight : b ∈ right.events \ left.events := rightOnly ▸ List.mem_toFinset.mpr member
        have onlyLeft : a ∈ left.events \ right.events := leftOnly ▸ inL
        exact (Configuration.compatible_iff_exclusive_conflicts left right).mp compatible
          a onlyLeft b onlyRight)
    rw [List.toFinset_append, ← Finset.union_assoc]
    exact enlarged

/-- **Every interleaving of the exclusive extensions is one trace.** -/
theorem glue_trace {left right : Configuration basis (O.conflict basis)}
    (compatible : Configuration.Compatible left right) (p : List Id) {l r : List Id}
    (leftOnly : ∀ a ∈ l, a ∈ left.events \ right.events)
    (rightOnly : ∀ b ∈ r, b ∈ right.events \ left.events) :
    TraceEquiv O.Independent (p ++ l ++ r) (p ++ r ++ l) := by
  have blocks := TraceEquiv.block (independent := O.Independent) l r
    (fun a inL b inR => O.exclusive_independent basis left right compatible
      (leftOnly a inL) (rightOnly b inR))
  simpa [List.append_assoc] using TraceEquiv.append_left p blocks

/-- **The glued run reads what each branch read**: the shared prefix's log, then
the left extension's log as in the left branch, then the right extension's log
as in the right branch. -/
theorem glue_log {left right : Configuration basis (O.conflict basis)}
    (compatible : Configuration.Compatible left right) (p : List Id) {l r : List Id}
    (leftOnly : ∀ a ∈ l, a ∈ left.events \ right.events)
    (rightOnly : ∀ b ∈ r, b ∈ right.events \ left.events) (store : Store Id Cell Value) :
    O.log (p ++ l ++ r) store =
      O.log p store ++ O.log l (O.final p store) ++ O.log r (O.final p store) := by
  rw [O.log_append, O.log_append, O.final_append,
    O.log_after_unrelated (fun a inL b inR cell reads =>
      (O.exclusive_independent basis left right compatible (leftOnly a inL)
        (rightOnly b inR)).unread_left cell reads)]

omit [DecidableEq Id] in
/-- **The glued store agrees with the left branch** outside the right
extension's writes. -/
theorem glue_store_left (p l : List Id) {r : List Id} {cell : Cell}
    (unwritten : ∀ b ∈ r, ¬ O.Writes b cell) (store : Store Id Cell Value) :
    O.final (p ++ l ++ r) store cell = O.final (p ++ l) store cell := by
  rw [O.final_append, O.final_unwritten unwritten]

/-- **... and with the right branch** outside the left extension's writes. -/
theorem glue_store_right {left right : Configuration basis (O.conflict basis)}
    (compatible : Configuration.Compatible left right) (p : List Id) {l r : List Id}
    (leftOnly : ∀ a ∈ l, a ∈ left.events \ right.events)
    (rightOnly : ∀ b ∈ r, b ∈ right.events \ left.events) {cell : Cell}
    (unwritten : ∀ a ∈ l, ¬ O.Writes a cell) (store : Store Id Cell Value) :
    O.final (p ++ l ++ r) store cell = O.final (p ++ r) store cell := by
  rw [final_eq_of_trace O (glue_trace compatible p leftOnly rightOnly) store, O.final_append,
    O.final_unwritten unwritten]

/-- The glued run's observation on every channel does not depend on the order
of the exclusive extensions. -/
theorem glue_observe [DecidableEq Channel] {left right : Configuration basis (O.conflict basis)}
    (compatible : Configuration.Compatible left right) (p : List Id) {l r : List Id}
    (leftOnly : ∀ a ∈ l, a ∈ left.events \ right.events)
    (rightOnly : ∀ b ∈ r, b ∈ right.events \ left.events) (store : Store Id Cell Value) :
    O.observe (p ++ l ++ r) store = O.observe (p ++ r ++ l) store :=
  observe_eq_of_trace O (glue_trace compatible p leftOnly rightOnly) store

omit [DecidableEq Id] in
/-- A noncommutative account does not depend on the order of two blocks
exactly when this is supplied: their coefficients commute pairwise.  The
independence of the occurrences gives no such premise. -/
theorem account_blocks {M : Type} [Monoid M] (coefficient : Id → M) (p : List Id) {l r : List Id}
    (lawful : ∀ a ∈ l, ∀ b ∈ r, Commute (coefficient a) (coefficient b)) :
    account coefficient (p ++ l ++ r) = account coefficient (p ++ r ++ l) := by
  have blocks := TraceEquiv.block (independent := fun a b => a ∈ l ∧ b ∈ r ∨ a ∈ r ∧ b ∈ l) l r
    (fun a inL b inR => .inl ⟨inL, inR⟩)
  have whole := TraceEquiv.append_left p blocks
  simp only [List.append_assoc]
  exact account_eq_of_trace coefficient (fun a b related => by
    rcases related with ⟨inL, inR⟩ | ⟨inR, inL⟩
    · exact lawful a inL b inR
    · exact (lawful b inL a inR).symm) whole

end Occurrences

/-! ## The configuration machine in the shared trace core -/

namespace Occurrences

open Mettapedia.GSLT
open Mettapedia.GSLT.Core.InteractionEvent
open Mettapedia.GSLT.Causality.OccurrenceHistory
open Mettapedia.GSLT.Causality.Mazurkiewicz (SiteWord)
open Mettapedia.GSLT.Causality.EventConcurrency

variable {Id Cell Value Channel : Type} [DecidableEq Id]
  (O : Occurrences Id Cell Value Channel) (basis : FiniteCausalBasis Id)

/-- A point of the configuration machine: the store and the occurrences already
fired. -/
abbrev Point (Id Cell Value : Type) := Store Id Cell Value × Finset Id

/-- One firing of occurrence `i`. -/
def Step (i : Id) (point next : Point Id Cell Value) : Prop :=
  Enabled basis (O.conflict basis) point.2 i ∧ next = (O.apply i point.1, insert i point.2)

/-- **The configuration machine** as a GSLT, with equality as its equations. -/
abbrev machine : GSLT.{0} where
  Term := Point Id Cell Value
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites point next := ∃ i, O.Step basis i point next
  rewrites_resp_left := by
    intro _ _ target equal step
    exact ⟨target, equal ▸ step, rfl⟩
  rewrites_resp_right := by
    intro _ _ _ step equal
    exact equal ▸ step

/-- Its interaction presentation: the site of a firing is the occurrence's
logical identity. -/
abbrev presentation : InteractionPresentation (O.machine basis) where
  Site := Id
  Event i point next := PLift (O.Step basis i point next)
  sound evidence := ⟨_, evidence.down⟩

variable {O basis}

/-- An occurrence enabled beside an independent one stays enabled after it. -/
theorem enabled_after {done : Finset Id} {a b : Id}
    (enabled : Enabled basis (O.conflict basis) done b) (independent : O.Independent a b) :
    Enabled basis (O.conflict basis) (insert a done) b := by
  obtain ⟨fresh, supported, safe⟩ := enabled
  refine ⟨?_, ?_, ?_⟩
  · intro member
    rcases Finset.mem_insert.mp member with same | inDone
    · exact independent.1 same.symm
    · exact fresh inDone
  · intro j member
    rcases Finset.mem_insert.mp (supported member) with rfl | inDone
    · exact Finset.mem_insert_self _ _
    · exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem inDone)
  · intro d member
    rcases Finset.mem_insert.mp member with rfl | inDone
    · exact ⟨fun conflicting => independent.2.1 conflicting.1,
        fun conflicting => independent.2.2 conflicting.1⟩
    · exact safe d inDone

theorem target_eq {point : Point Id Cell Value} (event : (O.presentation basis).Enabled point) :
    event.target = (O.apply event.site point.1, insert event.site point.2) :=
  event.evidence.down.2

theorem enabled_of_event {point : Point Id Cell Value}
    (event : (O.presentation basis).Enabled point) :
    Enabled basis (O.conflict basis) point.2 event.site :=
  event.evidence.down.1

/-- The residual of `b` after an independent `a`: the same occurrence identity,
fired at `a`'s target. -/
def residual {point : Point Id Cell Value} (a b : (O.presentation basis).Enabled point)
    (independent : O.Independent a.site b.site) : (O.presentation basis).Enabled a.target where
  site := b.site
  target := (O.apply b.site a.target.1, insert b.site a.target.2)
  evidence := ⟨by
    refine ⟨?_, rfl⟩
    rw [target_eq a]
    exact enabled_after (enabled_of_event b) independent⟩

variable (O basis) in
/-- **Independence of events from footprints and the declared observer**: the
event concurrency of the configuration machine.  The two routes of every tile
meet at one store, with its provenance, and one configuration. -/
def concurrency : Concurrency (O.presentation basis) where
  Independent a b := O.Independent a.site b.site
  symm independent := independent.symm
  residual {_ a b} independent := residual a b independent
  residual_site _ := rfl
  close {point a b} independent := by
    change (O.apply b.site a.target.1, insert b.site a.target.2) =
      (O.apply a.site b.target.1, insert a.site b.target.2)
    rw [target_eq a, target_eq b]
    exact Prod.ext (O.apply_comm (fun cell => independent.symm.no_common_write cell) point.1)
      (Finset.insert_comm _ _ _)

/-- Concatenation of occurrence paths concatenates their site words. -/
theorem sites_append {P : InteractionPresentation (O.machine basis)}
    {s m t : (O.machine basis).Term} (p : OccurrencePath P s m) (q : OccurrencePath P m t) :
    OccurrencePath.sites (OccurrencePath.append p q) = OccurrencePath.sites p ++ OccurrencePath.sites q := by
  induction p with
  | refl => rfl
  | cons o rest ih => simp [OccurrencePath.append, ih]

theorem sites_cast {P : InteractionPresentation (O.machine basis)}
    {s t t' : (O.machine basis).Term} (h : t = t') (p : OccurrencePath P s t) :
    OccurrencePath.sites (h ▸ p) = OccurrencePath.sites p := by
  cases h
  rfl

theorem onPath_cast {P : InteractionPresentation (O.machine basis)} {A : Type} [AddMonoid A]
    (valuation : OccurrenceValuation P A) {s t t' : (O.machine basis).Term} (h : t = t')
    (p : OccurrencePath P s t) : valuation.onPath (h ▸ p) = valuation.onPath p :=
  valuation.onPath_cast h p

/-- **Paths of the configuration machine are firing words**: the sites of a path
fire from its source configuration, and its target is the final store with the
enlarged configuration. -/
theorem path_fires {point next : (O.machine basis).Term}
    (path : OccurrencePath (O.presentation basis) point next) :
    Fires basis (O.conflict basis) point.2 (OccurrencePath.sites path) ∧
      next = (O.final (OccurrencePath.sites path) point.1,
        point.2 ∪ (OccurrencePath.sites path).toFinset) := by
  induction path with
  | refl point => exact ⟨trivial, Prod.ext rfl (by simp)⟩
  | @cons source middle target occurrence rest ih =>
      obtain ⟨enabled, middleEq⟩ := occurrence.evidence.down
      obtain ⟨runs, targetEq⟩ := ih
      have firstEq : middle.1 = O.apply occurrence.site source.1 := congrArg Prod.fst middleEq
      have secondEq : middle.2 = insert occurrence.site source.2 := congrArg Prod.snd middleEq
      rw [secondEq] at runs
      refine ⟨⟨enabled, runs⟩, targetEq.trans ?_⟩
      rw [firstEq, secondEq]
      refine Prod.ext rfl ?_
      change insert occurrence.site source.2 ∪ (OccurrencePath.sites rest).toFinset =
        source.2 ∪ (occurrence.site :: OccurrencePath.sites rest).toFinset
      rw [List.toFinset_cons, Finset.union_insert, Finset.insert_union]

/-- **Occurrence identity along every path**: no occurrence fires twice. -/
theorem path_sites_nodup {point next : (O.machine basis).Term}
    (path : OccurrencePath (O.presentation basis) point next) :
    (OccurrencePath.sites path).Nodup :=
  (fires_nodup (path_fires path).1).1

/-- **Trace equivalent paths have trace equivalent site words**: the trace
category of the configuration machine maps to the word traces of the
footprint independence. -/
theorem traceEq_sites {point next : (O.machine basis).Term}
    {p q : OccurrencePath (O.presentation basis) point next}
    (related : TraceEq (O.concurrency basis).tiles p q) :
    TraceEquiv O.Independent (OccurrencePath.sites p) (OccurrencePath.sites q) := by
  induction related with
  | refl _ => exact .refl _
  | symm _ ih => exact .symm _ _ ih
  | trans _ _ first second => exact .trans _ _ _ first second
  | tile pair =>
      change TraceEquiv O.Independent (OccurrencePath.sites (pair.route (O.concurrency basis)))
        (OccurrencePath.sites (pair.swapped (O.concurrency basis)))
      unfold Concurrency.Pair.swapped
      rw [sites_cast]
      exact .rel _ _ (Swap.swap (independent := O.Independent) [] []
        (a := pair.first.site) (b := pair.second.site) pair.independent)
  | cong_left pre _ ih =>
      rw [sites_append, sites_append]
      exact TraceEquiv.append_left _ ih
  | cong_right post _ ih =>
      rw [sites_append, sites_append]
      exact TraceEquiv.append_right _ ih

/-- **Occurrence identities are a property of the trace** (the shared core's
site bag). -/
theorem identities_descend :
    Descends (O.concurrency basis).tiles (bagValuation (O.presentation basis)) :=
  (O.concurrency basis).bagValuation_descends

/-- A valuation of occurrence identities in a commutative monoid, such as a
commutative declared account, is a property of the trace. -/
def siteValuation {A : Type} [AddMonoid A] (grade : Id → A) :
    OccurrenceValuation (O.presentation basis) A where
  grade occurrence := grade occurrence.site

theorem siteValuation_descends {A : Type} [AddCommMonoid A] (grade : Id → A) :
    Descends (O.concurrency basis).tiles (siteValuation (O := O) (basis := basis) grade) :=
  (O.concurrency basis).siteValuation_descends grade

/-- **A noncommutative declared account on paths**, multiplied in path order. -/
def accountValuation {M : Type} [Monoid M] (coefficient : Id → M) :
    OccurrenceValuation (O.presentation basis) (Additive M) :=
  siteValuation fun i => Additive.ofMul (coefficient i)

/-- **The lawful swap condition on paths**: a noncommutative account is a
property of the trace exactly when the coefficients of every tile commute. -/
theorem accountValuation_descends_iff {M : Type} [Monoid M] (coefficient : Id → M) :
    Descends (O.concurrency basis).tiles (accountValuation (O := O) (basis := basis) coefficient) ↔
      ∀ (point : Point Id Cell Value) (pair : (O.concurrency basis).Pair point),
        Commute (coefficient pair.first.site) (coefficient pair.second.site) :=
  ((O.concurrency basis).siteValuation_descends_iff fun i => Additive.ofMul (coefficient i)).trans
    ⟨fun commute _ pair => commute pair, fun commute _ pair => commute _ pair⟩

variable [DecidableEq Channel]

/-- **The declared observer on paths**: each occurrence contributes what it read
to its own channel, in path order. -/
def observationValuation :
    OccurrenceValuation (O.presentation basis) (Channel → SiteWord (Id × Reading Id Cell Value)) where
  grade {point _} occurrence channel :=
    if O.channel occurrence.site = some channel then
      ⟨[(occurrence.site, O.seen occurrence.site point.1)]⟩
    else 0

/-- **Each channel's observation is a property of the trace.** -/
theorem observationValuation_descends :
    Descends (O.concurrency basis).tiles (observationValuation (O := O) (basis := basis)) := by
  refine (descends_iff_tiles _ _).2 ?_
  intro point pair
  change (observationValuation (O := O) (basis := basis)).onPath (pair.route (O.concurrency basis)) =
    (observationValuation (O := O) (basis := basis)).onPath (pair.swapped (O.concurrency basis))
  unfold Concurrency.Pair.swapped
  rw [onPath_cast]
  have independent : O.Independent pair.first.site pair.second.site := pair.independent
  have afterFirst : O.seen pair.second.site pair.first.target.1 = O.seen pair.second.site point.1 := by
    rw [target_eq pair.first]
    exact O.seen_apply (fun cell => independent.unread_left cell) point.1
  have afterSecond : O.seen pair.first.site pair.second.target.1 = O.seen pair.first.site point.1 := by
    rw [target_eq pair.second]
    exact O.seen_apply (fun cell => independent.unread_right cell) point.1
  funext channel
  simp only [Concurrency.Pair.route, OccurrenceValuation.onPath, observationValuation,
    Concurrency.occ, add_zero, Pi.add_apply]
  change (if O.channel pair.first.site = some channel then
        (⟨[(pair.first.site, O.seen pair.first.site point.1)]⟩ : SiteWord _) else 0) +
      (if O.channel pair.second.site = some channel then
        ⟨[(pair.second.site, O.seen pair.second.site pair.first.target.1)]⟩ else 0) =
    (if O.channel pair.second.site = some channel then
        (⟨[(pair.second.site, O.seen pair.second.site point.1)]⟩ : SiteWord _) else 0) +
      (if O.channel pair.first.site = some channel then
        ⟨[(pair.first.site, O.seen pair.first.site pair.second.target.1)]⟩ else 0)
  rw [afterFirst, afterSecond]
  by_cases seenFirst : O.channel pair.first.site = some channel
  · have unseenSecond : O.channel pair.second.site ≠ some channel :=
      fun seenSecond => independent.no_common_channel ⟨channel, seenFirst, seenSecond⟩
    simp only [seenFirst, unseenSecond, if_true, if_false, add_zero, zero_add]
  · simp only [seenFirst, if_false, add_zero, zero_add]

end Occurrences

end Mettapedia.GSLT.Distinction.CausalGluing
