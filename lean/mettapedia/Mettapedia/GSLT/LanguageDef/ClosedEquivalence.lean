import Mettapedia.GSLT.LanguageDef.SemanticCategory

/-!
# The static equivalence on the closed terms of one sort

A language definition determines, at each of its sorts, a carrier of closed
well-sorted terms.  Its static equivalence on that carrier is generated by
single equation steps between closed terms, each step being an authored
equation or a presentation-derived law placed in a context.  Every vertex of a
chain is a closed term of the sort, so an ill-sorted intermediate pattern
never mediates an equality.

An interactive presentation uses this relation at its interacting sort.  The
relation is defined here for any language and any sort, so that it is also
available to a language with no interaction at all.

Three tools for working with it are supplied.  An equivalence of closed terms
is an equivalence of the underlying patterns, which is where invariants are
proved.  A context that keeps closed terms closed carries an equivalence to an
equivalence, which is how a chain is built beneath a constructor.  And a
matched instance of a premise-free equation at the root is one step.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.LanguageDef

open Mettapedia.OSLF.Framework.ConstructorCategory
open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.Match
open Mettapedia.OSLF.MeTTaIL.ContextualStep
open Mettapedia.OSLF.MeTTaIL.DerivedContexts
open EquationSemantics
open WellSorted

/-- One static-equation step whose two ends are closed terms of the sort. -/
def closedEquationGenerator
    (base : BasePremiseEvaluator) (language : LanguageDef) (sort : LangSort language)
    (left right : ClosedTerm language sort) : Prop :=
  EquationContextStep base language left.1 right.1

/-- The static equivalence of a language on the closed terms of one sort. -/
def closedEquationSetoid
    (base : BasePremiseEvaluator) (language : LanguageDef) (sort : LangSort language) :
    Setoid (ClosedTerm language sort) where
  r := Relation.EqvGen (closedEquationGenerator base language sort)
  iseqv :=
    { refl := Relation.EqvGen.refl
      symm := fun relation => Relation.EqvGen.symm _ _ relation
      trans := fun first second => Relation.EqvGen.trans _ _ _ first second }

/-- At the interacting sort of a presentation, this is the presented static
equivalence. -/
theorem presentedEquationSetoid_eq_closedEquationSetoid
    (base : BasePremiseEvaluator) (presentation : InteractivePresentation) :
    presentedEquationSetoid base presentation =
      closedEquationSetoid base presentation.presentation.language
        presentation.interactingLangSort :=
  rfl

section Tools

variable {base : BasePremiseEvaluator} {language : LanguageDef}

/-- One step between closed terms relates them. -/
theorem closedEquationSetoid_of_step {sort : LangSort language}
    {left right : ClosedTerm language sort}
    (step : EquationContextStep base language left.1 right.1) :
    (closedEquationSetoid base language sort).r left right :=
  Relation.EqvGen.rel _ _ step

/-- Equivalent closed terms have equivalent underlying patterns. -/
theorem equationEquiv_of_closedEquationSetoid {sort : LangSort language}
    {left right : ClosedTerm language sort}
    (equivalent : (closedEquationSetoid base language sort).r left right) :
    EquationEquiv base language left.1 right.1 := by
  induction equivalent with
  | rel left right step => exact Relation.EqvGen.rel _ _ step
  | refl term => exact Relation.EqvGen.refl _
  | symm left right _ recurse => exact Relation.EqvGen.symm _ _ recurse
  | trans left middle right _ _ first second => exact Relation.EqvGen.trans _ _ _ first second

/-- **Congruence.**  A context that sends closed terms of one sort to closed
terms of another carries equivalent terms to equivalent terms. -/
theorem closedEquationSetoid_fill {source target : LangSort language}
    (context : OneHoleContext)
    (closed : ∀ term : ClosedTerm language source,
      ClosedTermWellSorted language target (context.fill term.1))
    {left right : ClosedTerm language source}
    (equivalent : (closedEquationSetoid base language source).r left right) :
    (closedEquationSetoid base language target).r
      ⟨context.fill left.1, closed left⟩ ⟨context.fill right.1, closed right⟩ := by
  induction equivalent with
  | rel left right step =>
      exact Relation.EqvGen.rel _ _ (equationContextStep_fill context step)
  | refl term => exact Relation.EqvGen.refl _
  | symm left right _ recurse => exact Relation.EqvGen.symm _ _ recurse
  | trans left middle right _ _ first second => exact Relation.EqvGen.trans _ _ _ first second

/-- A matched instance of a premise-free authored equation, read from left to
right at the root, is one equation step. -/
theorem equationContextStep_of_forward {equation : Equation}
    (membership : List.Mem equation language.equations)
    (premiseFree : equation.premises = [])
    {source target : Pattern} {bindings : Bindings}
    (matched : bindings ∈ matchPattern equation.left source)
    (applied : applyBindings bindings equation.right = target) :
    EquationContextStep base language source target := by
  have premises : PremisesAt base language 0 bindings equation.premises bindings := by
    rw [premiseFree]
    exact PremisesAt.nil bindings
  exact EquationContextStep.inContext .hole
    (Or.inl ⟨0, EquationInstanceAt.forward membership matched premises applied⟩)

/-- The same instance read from right to left. -/
theorem equationContextStep_of_reverse {equation : Equation}
    (membership : List.Mem equation language.equations)
    (premiseFree : equation.premises = [])
    {source target : Pattern} {bindings : Bindings}
    (matched : bindings ∈ matchPattern equation.right source)
    (applied : applyBindings bindings equation.left = target) :
    EquationContextStep base language source target := by
  have premises : PremisesAt base language 0 bindings equation.premises bindings := by
    rw [premiseFree]
    exact PremisesAt.nil bindings
  exact EquationContextStep.inContext .hole
    (Or.inl ⟨0, EquationInstanceAt.reverse membership matched premises applied⟩)

end Tools

end Mettapedia.GSLT.LanguageDef
