import Mettapedia.GSLT.LanguageDef.EffectiveSection
import Mettapedia.GSLT.LanguageDef.ReflectiveCanonicalSection

/-!
# Effective sections of the reflective static equivalence

A reflective theory identifies a quoted drop with the name dropped, so its
static equivalence on closed terms is larger than the one generated by its
equations alone, and its canonical section is a section of that larger
relation.  Such a section is still a section on the closed terms of the
interacting sort, and it is effective when a computable function on
structural codes tracks it.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.LanguageDef

namespace ComputableReflectiveCanonicalSection

variable {theory : IGSLT}
  {reflection : ReflectionExtension.AdmittedProfile theory.presentation.presentation.language}

/-- A section of the reflective closed relation, as a section on the closed
terms of the interacting sort. -/
def toComputableSetoidSection (canonical : ComputableReflectiveCanonicalSection theory reflection) :
    ComputableSetoidSection theory.toGSLT.Term
      (reflectiveClosedEquationSetoid theory reflection) where
  normalize := canonical.normalize
  equivalent := canonical.equivalent
  complete := canonical.complete

/-- A section of the reflective closed relation is effective when a
computable function on structural codes tracks its normal-form function. -/
def Effective (canonical : ComputableReflectiveCanonicalSection theory reflection) : Prop :=
  canonical.toComputableSetoidSection.Effective

/-- An effective section decides the reflective static equivalence along
every family of terms whose codes are computable.  This is the statement for
closed terms of a sort, read for the reflective relation. -/
theorem Effective.computablePred
    {canonical : ComputableReflectiveCanonicalSection theory reflection}
    (effective : canonical.Effective) {left right : ℕ → theory.toGSLT.Term}
    (leftComputable : Computable fun index => theory.termCode (left index))
    (rightComputable : Computable fun index => theory.termCode (right index)) :
    ComputablePred fun index =>
      (reflectiveClosedEquationSetoid theory reflection).r (left index) (right index) :=
  ComputableSetoidSection.Effective.computablePred effective leftComputable rightComputable

end ComputableReflectiveCanonicalSection

end Mettapedia.GSLT.LanguageDef
