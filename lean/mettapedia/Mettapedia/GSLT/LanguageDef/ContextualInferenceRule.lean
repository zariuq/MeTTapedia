import Mathlib.Data.Set.Lattice
import Mettapedia.GSLT.Core.NonFactorization
import Mettapedia.GSLT.LanguageDef.CalculusLanguageDef

/-!
# Contextual inference rules and their explicit first-order lowering

An inference rule may use different variable and relation contexts in each
premise.  That hypothetical structure should remain visible while rules are
authored, but the generic inference engine consumes ordinary first-order
`RuleSchema` values.

This module gives both views and an injective lowering between them. Contexts
are free schemas generated by empty context, context metavariables, and
ordered extension. They are encoded as ordinary constructor terms, so the
lowered rule still belongs to one flat `CalculusLanguageDef`. No structural
rule is implicit: order and multiplicity are retained, and weakening,
exchange, contraction, or cut must be supplied by the authored calculus when
they are valid.
-/

namespace Mettapedia.GSLT.LanguageDef.ContextualInference

open Mettapedia.GSLT.Core.NonFactorization
open Mettapedia.OSLF.MeTTaIL.Syntax

/-! ## The shared explicit-context signature -/

/-- Carrier of object-language claims reified as proof-calculus data. -/
def formulaType : TypeDecl := TypeDecl.plain "$gslt:formula"

/-- Carrier of ordered, occurrence-sensitive contexts. -/
def contextType : TypeDecl := TypeDecl.plain "$gslt:context"

/-- Empty ordered context. -/
def emptyContextTerm : GrammarRule where
  label := "$gslt:context:nil"
  category := contextType.name
  params := []
  syntaxPattern := []

/-- Context extension retains one formula occurrence at the head. -/
def extendContextTerm : GrammarRule where
  label := "$gslt:context:cons"
  category := contextType.name
  params :=
    [ .simple "formula" (.base formulaType.name)
    , .simple "tail" (.base contextType.name) ]
  syntaxPattern := []

/-- Explicit contextual entailment has separate variable and relation
contexts followed by its reified conclusion. -/
def contextualJudgment : JudgmentDecl where
  head := "$gslt:derives"
  arity := 3

/-- The minimal flat signature used by every explicit contextual lowering.
Guest calculi extend the formula carrier with their own claim constructors. -/
def definition : CalculusLanguageDef where
  name := "$gslt:contextual-inference"
  types := [formulaType, contextType]
  terms := [emptyContextTerm, extendContextTerm]
  equations := []
  rewrites := []
  judgments := [contextualJudgment]
  rules := []

/-- The generic context signature passes the ordinary calculus gate. -/
theorem definition_valid : definition.isValid = true := by
  have validate : definition.toLanguageDef.validate = [] := by
    apply LanguageDef.validate_eq_nil_of_constructorOnly <;>
      simp [definition, formulaType, contextType, emptyContextTerm,
        extendContextTerm, LanguageDef.typeNames, TypeDecl.plain,
        TermParam.typeExpr, TypeExpr.baseNames]
  have uniqueHead :
      ["$gslt:derives"].eraseDups.length = 1 := by
    decide
  unfold CalculusLanguageDef.isValid CalculusLanguageDef.hasValidLocalRules
  rw [validate]
  simp [definition, emptyContextTerm, extendContextTerm,
    contextualJudgment,
    CalculusLanguageDef.judgmentSignatureValid,
    CalculusLanguageDef.conversionDeclarationValid,
    CalculusLanguageDef.judgmentHeads,
    CalculusLanguageDef.ruleIds, uniqueHead,
    Pattern.zipHead, Pattern.mapHead, Pattern.evalHead]

/-- Checked context signature, ready for lawful formula/rule extensions. -/
def validated : ValidatedCalculusLanguageDef :=
  ⟨definition, definition_valid⟩

/-! ## Hypothetical authoring view -/

/-- A first-order schema for an ordered hypothetical context. A hole denotes
an arbitrary ambient context such as Γ or Δ; extension retains one formula
occurrence in front of that tail. -/
inductive ContextSchema where
  | empty
  | hole (name : String)
  | extend (formula : Pattern) (tail : ContextSchema)
deriving Repr, DecidableEq

namespace ContextSchema

/-- A closed context is the special case whose tail is empty. -/
def ofList : List Pattern → ContextSchema
  | [] => .empty
  | formula :: rest => .extend formula (ofList rest)

/-- Prefix a finite list of assumptions to an arbitrary ambient context. -/
def prepend : List Pattern → ContextSchema → ContextSchema
  | [], tail => tail
  | formula :: rest, tail => .extend formula (prepend rest tail)

@[simp]
theorem prepend_empty (tail : ContextSchema) : prepend [] tail = tail := rfl

@[simp]
theorem prepend_cons (formula : Pattern) (rest : List Pattern)
    (tail : ContextSchema) :
    prepend (formula :: rest) tail = .extend formula (prepend rest tail) := rfl

@[simp]
theorem ofList_eq_prepend_empty (context : List Pattern) :
    ofList context = prepend context .empty := by
  induction context with
  | nil => rfl
  | cons formula rest inductionHypothesis =>
      simp [ofList, inductionHypothesis]

end ContextSchema

/-- One sequent with independently retained variable and relation contexts. -/
structure Sequent where
  variableContext : ContextSchema
  relationContext : ContextSchema
  conclusion : Pattern
deriving Repr, DecidableEq

/-- One inference rule whose premises may live under contexts different from
the conclusion context.  This is enough to express hypothetical discharge
without building any particular structural discipline into the checker. -/
structure Rule where
  id : RuleId
  metavariables : List (String × Nat)
  premises : List Sequent
  conclusion : Sequent
  sideConditions : List RuleSideCondition := []
deriving Repr, DecidableEq

/-! ## Explicit first-order encoding -/

/-- Encode a context schema as ordinary first-order constructor data. -/
def encodeContext : ContextSchema → Pattern
  | .empty => .apply emptyContextTerm.label []
  | .hole name => .fvar name
  | .extend formula rest =>
      .apply extendContextTerm.label [formula, encodeContext rest]

/-- Partial inverse recognizing exactly the canonical context encoding. -/
def decodeContext? : Pattern → Option ContextSchema
  | .fvar name => some (.hole name)
  | .apply head [] =>
      if head = emptyContextTerm.label then some .empty else none
  | .apply head [formula, rest] =>
      if head = extendContextTerm.label then
        (decodeContext? rest).map (.extend formula)
      else none
  | _ => none

@[simp]
theorem decodeContext?_encodeContext (context : ContextSchema) :
    decodeContext? (encodeContext context) = some context := by
  induction context with
  | empty => simp [encodeContext, decodeContext?, emptyContextTerm]
  | hole name => simp [encodeContext, decodeContext?]
  | extend formula rest inductionHypothesis =>
      simp [encodeContext, decodeContext?, extendContextTerm,
        inductionHypothesis]

/-- Successful decoding recognizes only the canonical context wire; it cannot
silently canonicalize a foreign or malformed representation. -/
theorem encodeContext_of_decodeContext?_eq_some
    {wire : Pattern} {context : ContextSchema}
    (decoded : decodeContext? wire = some context) :
    encodeContext context = wire := by
  induction wire using Pattern.inductionOn generalizing context with
  | hbvar index => simp [decodeContext?] at decoded
  | hfvar name =>
      simp [decodeContext?] at decoded
      cases decoded
      rfl
  | happly head arguments inductionHypothesis =>
      cases arguments with
      | nil =>
          simp only [decodeContext?] at decoded
          split at decoded
          next equal =>
            cases decoded
            subst head
            rfl
          next different => simp at decoded
      | cons first rest =>
          cases rest with
          | nil => simp [decodeContext?] at decoded
          | cons second tail =>
              cases tail with
              | nil =>
                  simp only [decodeContext?] at decoded
                  split at decoded
                  next equal =>
                    have secondIH : ∀ {context : ContextSchema},
                        decodeContext? second = some context →
                          encodeContext context = second :=
                      inductionHypothesis second (by simp)
                    cases secondDecode : decodeContext? second with
                    | none => simp [secondDecode] at decoded
                    | some tailContext =>
                        simp only [secondDecode, Option.map_some] at decoded
                        cases decoded
                        subst head
                        simp only [encodeContext]
                        rw [secondIH secondDecode]
                  next different => simp at decoded
              | cons third more => simp [decodeContext?] at decoded
  | hlambda name body inductionHypothesis =>
      simp [decodeContext?] at decoded
  | hmultiLambda arity names body inductionHypothesis =>
      simp [decodeContext?] at decoded
  | hsubst body replacement bodyIH replacementIH =>
      simp [decodeContext?] at decoded
  | hcollection collectionType elements rest inductionHypothesis =>
      simp [decodeContext?] at decoded

/-- The explicit context code retains order and occurrence multiplicity. -/
theorem encodeContext_injective : Function.Injective encodeContext := by
  intro first second equality
  apply Option.some.inj
  calc
    some first = decodeContext? (encodeContext first) :=
      (decodeContext?_encodeContext first).symm
    _ = decodeContext? (encodeContext second) := congrArg decodeContext? equality
    _ = some second := decodeContext?_encodeContext second

/-- Ambient contexts remain ordinary schema metavariables after lowering;
extension does not force Γ or Δ to be materialized as a closed list. -/
theorem encode_extend_hole (formula : Pattern) (name : String) :
    encodeContext (.extend formula (.hole name)) =
      .apply extendContextTerm.label [formula, .fvar name] :=
  rfl

/-- Encode one contextual sequent as the declared ternary judgment. -/
def lowerSequent (sequent : Sequent) : Pattern :=
  .apply contextualJudgment.head
    [ encodeContext sequent.variableContext
    , encodeContext sequent.relationContext
    , sequent.conclusion ]

/-- Recognize the canonical explicit form of a contextual sequent. -/
def decodeSequent? : Pattern → Option Sequent
  | .apply head [variableCode, relationCode, conclusion] =>
      if head = contextualJudgment.head then do
        let variableContext ← decodeContext? variableCode
        let relationContext ← decodeContext? relationCode
        pure { variableContext, relationContext, conclusion }
      else none
  | _ => none

@[simp]
theorem decodeSequent?_lowerSequent (sequent : Sequent) :
    decodeSequent? (lowerSequent sequent) = some sequent := by
  cases sequent
  simp [lowerSequent, decodeSequent?, contextualJudgment,
    decodeContext?_encodeContext]

/-- Successful sequent decoding reconstructs both ordered contexts and the
conclusion exactly.  In particular, decoding never repairs a malformed
context code behind the caller's back. -/
theorem lowerSequent_of_decodeSequent?_eq_some
    {wire : Pattern} {sequent : Sequent}
    (decoded : decodeSequent? wire = some sequent) :
    lowerSequent sequent = wire := by
  cases wire with
  | apply head arguments =>
      cases arguments with
      | nil => simp [decodeSequent?] at decoded
      | cons variableCode rest =>
          cases rest with
          | nil => simp [decodeSequent?] at decoded
          | cons relationCode rest =>
              cases rest with
              | nil => simp [decodeSequent?] at decoded
              | cons conclusion tail =>
                  cases tail with
                  | cons extra more => simp [decodeSequent?] at decoded
                  | nil =>
                      by_cases headEq : head = contextualJudgment.head
                      · simp only [decodeSequent?, headEq, ↓reduceIte] at decoded
                        cases variableDecode : decodeContext? variableCode with
                        | none => simp [variableDecode] at decoded
                        | some variableContext =>
                            cases relationDecode :
                                decodeContext? relationCode with
                            | none => simp [variableDecode, relationDecode] at decoded
                            | some relationContext =>
                                simp only [variableDecode, relationDecode] at decoded
                                cases decoded
                                subst head
                                simp only [lowerSequent]
                                rw [
                                  encodeContext_of_decodeContext?_eq_some
                                    variableDecode,
                                  encodeContext_of_decodeContext?_eq_some
                                    relationDecode]
                      · simp [decodeSequent?, headEq] at decoded
  | _ => simp [decodeSequent?] at decoded

/-- Explicit lowering is faithful to the complete hypothetical sequent. -/
theorem lowerSequent_injective : Function.Injective lowerSequent := by
  intro first second equality
  apply Option.some.inj
  calc
    some first = decodeSequent? (lowerSequent first) :=
      (decodeSequent?_lowerSequent first).symm
    _ = decodeSequent? (lowerSequent second) :=
      congrArg decodeSequent? equality
    _ = some second := decodeSequent?_lowerSequent second

/-- Compile a hypothetical rule to the ordinary checker schema. -/
def lowerRule (rule : Rule) : RuleSchema where
  id := rule.id
  metavariables := rule.metavariables
  premises := rule.premises.map lowerSequent
  conclusion := lowerSequent rule.conclusion
  sideConditions := rule.sideConditions

/-- Rule lowering loses neither premise contexts nor discharge shape. -/
theorem lowerRule_injective : Function.Injective lowerRule := by
  intro first second equality
  have idEquality := congrArg RuleSchema.id equality
  have metavariableEquality := congrArg RuleSchema.metavariables equality
  have premiseEquality := congrArg RuleSchema.premises equality
  have conclusionEquality := congrArg RuleSchema.conclusion equality
  have conditionEquality := congrArg RuleSchema.sideConditions equality
  have sourcePremises : first.premises = second.premises :=
    (List.map_injective_iff.mpr lowerSequent_injective) premiseEquality
  have sourceConclusion : first.conclusion = second.conclusion :=
    lowerSequent_injective conclusionEquality
  cases first with
  | mk firstId firstMetavariables firstPremises firstConclusion
      firstConditions =>
    cases second with
    | mk secondId secondMetavariables secondPremises secondConclusion
        secondConditions =>
      change firstId = secondId at idEquality
      change firstMetavariables = secondMetavariables at metavariableEquality
      change firstPremises = secondPremises at sourcePremises
      change firstConclusion = secondConclusion at sourceConclusion
      change firstConditions = secondConditions at conditionEquality
      cases idEquality
      cases metavariableEquality
      cases sourcePremises
      cases sourceConclusion
      cases conditionEquality
      rfl

/-- Homogeneous rule-family composition is ordinary append and lowers
homomorphically.  Nontrivial interleaving belongs to the later heterogeneous
language-construction algebra, not to this one row family. -/
theorem lowerRules_append (first second : List Rule) :
    (first ++ second).map lowerRule =
      first.map lowerRule ++ second.map lowerRule := by
  exact List.map_append

/-! ## What the explicit encoding prevents -/

/-- The unordered shadow of an authored context. -/
def setShadow (context : List Pattern) : Set Pattern :=
  { formula | formula ∈ context }

private def firstFormula : Pattern := .apply "$gslt:canary:first" []
private def secondFormula : Pattern := .apply "$gslt:canary:second" []

/-- Set erasure forgets occurrence multiplicity. -/
theorem duplicate_setShadow :
    setShadow [firstFormula, firstFormula] = setShadow [firstFormula] := by
  ext formula
  simp [setShadow]

/-- Set erasure also forgets authored context order. -/
theorem exchange_setShadow :
    setShadow [firstFormula, secondFormula] =
      setShadow [secondFormula, firstFormula] := by
  ext formula
  simp [setShadow, or_comm]

/-- Ordered contexts cannot be reconstructed from their set shadow. -/
theorem ordered_context_not_determined_by_set :
    ¬ Factors setShadow (fun context : List Pattern => context) := by
  apply (NonTrivialFiber.mk
    (shadow := setShadow)
    (invariant := fun context : List Pattern => context)
    [firstFormula, firstFormula]
    [firstFormula]
    duplicate_setShadow
    (by simp)).not_factors

/-- The canonical explicit encoding distinguishes the multiplicity that set
contexts erase. -/
theorem encoded_duplicate_ne_singleton :
    encodeContext (ContextSchema.ofList [firstFormula, firstFormula]) ≠
      encodeContext (ContextSchema.ofList [firstFormula]) := by
  intro equality
  have sourceEquality := encodeContext_injective equality
  simp at sourceEquality

/-- The canonical explicit encoding distinguishes authored exchange. -/
theorem encoded_exchange_ne :
    encodeContext (ContextSchema.ofList [firstFormula, secondFormula]) ≠
      encodeContext (ContextSchema.ofList [secondFormula, firstFormula]) := by
  intro equality
  have sourceEquality := encodeContext_injective equality
  simp [firstFormula, secondFormula] at sourceEquality

/-- Forgetting both contexts retains only the concluding formula. -/
def conclusionShadow (sequent : Sequent) : Pattern := sequent.conclusion

private def bareSequent : Sequent :=
  { variableContext := .empty
    relationContext := .empty
    conclusion := firstFormula }

private def assumedSequent : Sequent :=
  { variableContext := .empty
    relationContext := .extend secondFormula .empty
    conclusion := firstFormula }

/-- A raw conclusion cannot determine the hypothetical sequent that produced
it.  This is the obstruction to treating today's context-free `RuleSchema`
shape as the full paper calculus. -/
theorem contextual_sequent_not_determined_by_conclusion :
    ¬ Factors conclusionShadow lowerSequent := by
  exact
    (NonTrivialFiber.mk
      (shadow := conclusionShadow)
      (invariant := lowerSequent)
      bareSequent
      assumedSequent
      rfl
      (fun equality => by
        have sourceEquality := lowerSequent_injective equality
        simp [bareSequent, assumedSequent] at sourceEquality)).not_factors

/-- Positive control: explicit lowering visibly retains a relation
assumption even when the conclusion is unchanged. -/
theorem lowered_bare_ne_assumed :
    lowerSequent bareSequent ≠ lowerSequent assumedSequent := by
  intro equality
  have sourceEquality := lowerSequent_injective equality
  simp [bareSequent, assumedSequent] at sourceEquality

