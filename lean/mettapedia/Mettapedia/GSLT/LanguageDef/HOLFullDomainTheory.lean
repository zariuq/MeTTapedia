import Mettapedia.GSLT.LanguageDef.HOLTypeDerivedConsequence
import Mettapedia.GSLT.LanguageDef.TheoryGraphModels
import Mettapedia.Logic.HOL.FullDomainInstitution
import Mettapedia.Logic.HOL.StandardAxiomProperties
import Mettapedia.Logic.HOL.Semantics.KripkeHenkinCountermodel

/-!
# Full-domain HOL models in the theory graph

Finite extensional derivations are sound for the full-domain institution.
This gives a consequence comorphism, not an identification of derivability
with full-model validity: excluded middle witnesses failure of reflection for
the current EM-free proof calculus. The existing satisfying-model fibration hosts
theories and reducts along type-derived signature interpretations.

The specimen interprets a base sort by a function type. Its source axiom says
that the sort has two distinct elements; the translated axiom is satisfied by
two distinct constant Boolean functions. A singleton model refutes the source
axiom, so the theory extension is not merely a logical validity.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.LanguageDef.HOLFullDomainTheory

open _root_.CategoryTheory
open scoped _root_.CategoryTheory
open Mettapedia.Logic Mettapedia.Logic.HOL
open Mettapedia.GSLT.LanguageDef.NIKMetalogic

universe u

/-- Soundness against full models; no converse completeness law is assumed. -/
theorem provable_entails {S : TypeDerivedSignature.{u}}
    {axioms : ClosedTheorySet S.2.Const} {formula : ClosedFormula S.2.Const}
    (proof : ClosedTheorySet.Provable axioms formula) :
    FullDomainInstitution.institution.Entails S axioms formula := by
  intro model satisfiesAxioms
  exact StandardAxiomProperties.provable_sound_of_models model.as.1
    (HenkinModel.functionsRespectEqv_of_fullDomains model.as.1 model.as.2)
    axioms satisfiesAxioms proof

/-- The proof-theoretic consequence institution maps soundly into semantic
consequence, with the same signatures and sentence translations. -/
def soundness : PiInstitution.Comorphism HOLTypeDerivedConsequence.institution
    (InstitutionConsequence.consequenceProjection FullDomainInstitution.institution.{u}) where
  mapSignature := 𝟭 _
  mapSentence _ := id
  mapSentence_natural _ _ := rfl
  preserves := by
    intro S axioms formula proof
    change FullDomainInstitution.institution.Entails S (id '' axioms) formula
    simpa only [Set.image_id] using (provable_entails proof)

/-- Set-based full models validate the excluded-middle instance whose
underivability in the current calculus has an independent Kripke countermodel. -/
theorem excludedMiddle_valid :
    FullDomainInstitution.institution.Entails
      (⟨KripkeHenkin.EMCanaryBase, ⟨KripkeHenkin.EMCanaryConst⟩⟩ : TypeDerivedSignature)
      ∅ KripkeHenkin.emCanaryExcludedMiddle := by
  intro M _
  change M.as.1.models (.or (.const KripkeHenkin.EMCanaryConst.p)
    (.not (.const KripkeHenkin.EMCanaryConst.p)))
  exact Classical.em _

/-- This soundness comorphism does not reflect consequence. The failure is
for the stated EM-free calculus, not for every possible classical HOL calculus. -/
theorem soundness_not_reflecting :
    let S : TypeDerivedSignature :=
      ⟨KripkeHenkin.EMCanaryBase, ⟨KripkeHenkin.EMCanaryConst⟩⟩
    KripkeHenkin.emCanaryExcludedMiddle ∈
        (InstitutionConsequence.consequenceProjection FullDomainInstitution.institution).theorems S ∧
      KripkeHenkin.emCanaryExcludedMiddle ∉ HOLTypeDerivedConsequence.institution.theorems S :=
  ⟨excludedMiddle_valid, KripkeHenkin.em_not_derivable⟩

/-- The full-domain institution, retaining its models and satisfaction law. -/
def institutionObject : InstitutionCategory.Object where
  Signature := Cat.of TypeDerivedSignature.{u}
  logic := FullDomainInstitution.institution

/-- A semantic theory node generated by the specified object-theory axioms. -/
def node (S : TypeDerivedSignature.{u}) (axioms : ClosedTheorySet S.2.Const) :
    TheoryGraphModels.Node :=
  TheoryGraphModels.Node.mk' institutionObject
    (PiInstitution.generatedTheory
      (InstitutionConsequence.consequenceProjection FullDomainInstitution.institution) S axioms)

/-- Type interpretation induces a theory arrow when the translated source
axioms follow from the target axioms. -/
def theoryHom {S T : TypeDerivedSignature.{u}} (f : S ⟶ T)
    (sourceAxioms : ClosedTheorySet S.2.Const) (targetAxioms : ClosedTheorySet T.2.Const)
    (admitted : ∀ formula ∈ sourceAxioms,
      FullDomainInstitution.institution.Entails T targetAxioms
        (TypeDerivedSignature.sentence.map f formula)) :
    node S sourceAxioms ⟶ node T targetAxioms :=
  TheoryGraphModels.Node.Hom.mk (𝟙 _) f (by
    intro formula consequence model satisfiesAxioms
    apply (FullDomainInstitution.satisfaction_iff f model.as formula).2
    apply consequence (Discrete.mk (FullDomainInstitution.Model.reduct f model.as))
    intro premise membership
    exact (FullDomainInstitution.satisfaction_iff f model.as premise).1
      (admitted premise membership model satisfiesAxioms))

/-- An independently supplied axiom model inhabits the satisfying-model fibre. -/
def satisfyingModel (S : TypeDerivedSignature.{u}) (axioms : ClosedTheorySet S.2.Const)
    (M : FullDomainInstitution.Model S) (satisfiesAxioms : ∀ formula ∈ axioms, M.1.models formula) :
    TheoryGraphModels.Model (node S axioms) :=
  ⟨Discrete.mk M,
    (TheoryGraphModels.satisfies_generated_iff institutionObject S axioms (Discrete.mk M)).2
      satisfiesAxioms⟩

namespace FunctionSort

open TypeSubstitutionExample

abbrev signature : TypeDerivedSignature := ⟨Unit, ⟨NoConstants Unit⟩⟩

/-- The base sort is interpreted by its endomorphism type. -/
def interpretation : signature ⟶ signature where
  base := functionInterpretation
  constants := fun {a} c => noConstantsMap functionInterpretation (A := a) c

/-- The chosen sort contains two distinguishable elements. -/
def twoPoints (a : Ty Unit) : ClosedFormula (NoConstants Unit) :=
  .ex (σ := a) (.ex (σ := a) (.not (.eq (.var (.vs .vz)) (.var .vz))))

abbrev sourceAxiom := twoPoints (.base ())
abbrev targetAxiom := twoPoints (.arr (.base ()) (.base ()))

theorem translates_axiom :
    TypeDerivedSignature.sentence.map interpretation sourceAxiom = targetAxiom := rfl

def sourceNode := node signature {sourceAxiom}
def targetNode := node signature {targetAxiom}

/-- An actual theory-graph arrow with a non-logical source axiom. -/
def arrow : sourceNode ⟶ targetNode :=
  theoryHom interpretation {sourceAxiom} {targetAxiom} (by
    rintro formula member model satisfiesAxioms
    have equal : formula = sourceAxiom := member
    subst equal
    rw [translates_axiom]
    exact satisfiesAxioms targetAxiom (Set.mem_singleton _))

/-- Two constant Boolean functions witness the translated object-theory axiom. -/
theorem boolean_functions_satisfy : booleanFunctionModel.models targetAxiom := by
  change ∃ f : ULift.{1} Bool → ULift.{1} Bool, True ∧
    ∃ g : ULift.{1} Bool → ULift.{1} Bool, True ∧
      ¬ (∀ x : ULift.{1} Bool, True → f x = g x)
  refine ⟨fun _ => ⟨false⟩, trivial, fun _ => ⟨true⟩, trivial, ?_⟩
  intro equal
  have impossible := congrArg ULift.down (equal ⟨false⟩ trivial)
  exact Bool.false_ne_true impossible

/-- The concrete target model satisfies the generated theory, not only its axiom. -/
def targetModel : TheoryGraphModels.Model targetNode :=
  satisfyingModel signature {targetAxiom}
    ⟨booleanFunctionModel, HenkinModel.fullDomains_standard _ _⟩ (by
      rintro formula member
      have equal : formula = targetAxiom := member
      subst equal
      exact boolean_functions_satisfy)

/-- The existing fibration transports this model through the function-sort arrow. -/
def transported :
    TheoryGraphModels.SatisfyingModel.mk' sourceNode
        ((TheoryGraphModels.reduct arrow).obj targetModel) ⟶
      TheoryGraphModels.SatisfyingModel.mk' targetNode targetModel :=
  TheoryGraphModels.transport arrow targetModel

/-- The source object theory genuinely restricts models: a singleton refutes it. -/
def singletonModel : HenkinModel.{0, 0, 0} Unit (NoConstants Unit) :=
  HenkinModel.standard (fun _ => ULift.{1} Unit) (fun {_} c => nomatch c)

theorem singleton_refutes : ¬ singletonModel.models sourceAxiom := by
  change ¬ ∃ x : ULift.{1} Unit, True ∧ ∃ y : ULift.{1} Unit, True ∧ x ≠ y
  rintro ⟨x, _, y, _, different⟩
  exact different (Subsingleton.elim x y)

/-- Consequently the source axiom is not an unqualified theorem of HOL. -/
theorem sourceAxiom_not_provable :
    ¬ ExtDerivation.Theorem (NoConstants Unit) sourceAxiom := by
  intro proof
  exact singleton_refutes (Soundness.extTheorem_sound proof singletonModel
    (HenkinModel.functionsRespectEqv_of_fullDomains _
      (HenkinModel.fullDomains_standard _ _)))

end FunctionSort

#print axioms soundness
#print axioms soundness_not_reflecting
#print axioms theoryHom
#print axioms FunctionSort.boolean_functions_satisfy
#print axioms FunctionSort.transported
#print axioms FunctionSort.sourceAxiom_not_provable

