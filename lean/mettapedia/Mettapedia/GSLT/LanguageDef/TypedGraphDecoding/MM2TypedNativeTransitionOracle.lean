import Mettapedia.GSLT.LanguageDef.TypedGraphDecoding.MM2NativeTypedRefinement

/-!
# Finite differential oracle for the MM2 typed native transition

The runtime implementation is independent Python.  This module exports a
finite but exhaustive-by-constructor transition matrix from Lean's executable
`compileChildren?`: every expected-role constructor, every source-derived head
and one absent head, representative boundary arities, list heads, and variable
actions.  Runtime conformance compares its own transition result against these
generated bytes and separately replays every known-positive corpus prefix.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.LanguageDef.TypedGraphDecoding.MM2TypedNativeTransitionOracle

open Mettapedia.GSLT.LanguageDef.TypedGraphDecoding.MM2NativeTypedRefinement
open Mettapedia.GSLT.LanguageDef.TypedGraphDecoding.MM2NativeActionCodec

def roles : List Role :=
  [.atom, .key, .pattern, .template, .inputSpec, .inputFactor,
    .outputSpec, .outputSink]

def oracleSymbols : List String :=
  (schemas.map (fun schema => schema.head) ++
    inputProviderSchemas.map (fun schema => schema.head) ++
    outputProviderSchemas.map (fun schema => schema.head) ++
    [Execution.source.input.compatibility.interface,
      Execution.source.input.explicitHead,
      Execution.source.output.compatibility.interface,
      Execution.source.output.explicitHead,
      Cursor.source.quotedRuleHead,
      "unknown-head"]).eraseDups

def arities : List Nat := (List.range 10) ++ [63, 128]

def expectedInventory : List Expected :=
  [.program] ++
    roles.map .atom ++
    roles.flatMap (fun role => arities.map (.listHead role)) ++
    [.literal Cursor.source.quotedRuleHead]

def actionInventory : List Action :=
  [.program 0, .program 1, .program 8, .program 128] ++
    arities.map .list ++
    (List.range (oracleSymbols.length + 1)).map .reference ++
    [.var 0, .var 1, .var 63]

def renderRole : Role → String
  | .atom => "atom"
  | .key => "key"
  | .pattern => "pattern"
  | .template => "template"
  | .inputSpec => "input-spec"
  | .inputFactor => "input-factor"
  | .outputSpec => "output-spec"
  | .outputSink => "output-sink"

def renderExpected : Expected → String
  | .program => "(program)"
  | .atom role => "(atom " ++ renderRole role ++ ")"
  | .listHead role totalArity =>
      "(list-head " ++ renderRole role ++ " " ++ toString totalArity ++ ")"
  | .literal name => "(literal \"" ++ name ++ "\")"

def renderAction : Action → String
  | .program arity => "(program " ++ toString arity ++ ")"
  | .list arity => "(list " ++ toString arity ++ ")"
  | .reference index => "(reference " ++ toString index ++ ")"
  | .var index => "(variable " ++ toString index ++ ")"

def renderResult : Option (List Expected) → String
  | none => "(none)"
  | some children =>
      "(some" ++ String.join (children.map (fun child =>
        " " ++ renderExpected child)) ++ ")"

def renderCase (expected : Expected) (action : Action) : String :=
  "  (case " ++ renderExpected expected ++ " " ++ renderAction action ++
    " " ++ renderResult (compileChildren? oracleSymbols expected action) ++
    ")\n"

def renderCases : String :=
  String.join <| expectedInventory.flatMap fun expected =>
    actionInventory.map (renderCase expected)

def renderSymbols : String :=
  "  (symbols" ++ String.join (oracleSymbols.map (fun symbol =>
    " \"" ++ symbol ++ "\"")) ++ ")\n"

def wire : String :=
  "(MM2TypedNativeTransitionOracleV1\n" ++ renderSymbols ++ renderCases ++ ")\n"

def writeWire (path : System.FilePath) : IO Unit :=
  IO.FS.writeFile path wire

theorem wire_nonempty : wire ≠ "" := by
  decide +kernel

theorem inventories_nonempty :
    expectedInventory ≠ [] ∧ actionInventory ≠ [] ∧ oracleSymbols ≠ [] := by
  decide +kernel

#print axioms wire_nonempty
#print axioms inventories_nonempty

end Mettapedia.GSLT.LanguageDef.TypedGraphDecoding.MM2TypedNativeTransitionOracle
