import Mettapedia.GSLT.LanguageDef.Interaction.Presentability
import Mettapedia.OSLF.Framework.PredFiniteSufficient
import Mettapedia.OSLF.MeTTaIL.BindingAgreement

/-!
# Where rewrites fire

A base rewrite is a ground event of a theory.  A rule with a reduction
hypothesis says where such events may take place: it lets one argument of a
constructor reduce, or one component of an unordered collection.  The contexts
generated by those rules are the contexts in which rewrites fire.

The main result is that a reduction of a theory whose rules are of these three
kinds is exactly a base rewrite applied beneath such a context.  For an
argument position the context is untouched by the reduction.  For a component
of a collection the reduct is returned at the front of the collection, so the
context is the same collection only up to the order of its components; the
context the reduct lands in is therefore carried alongside the context the
redex is found in.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.LanguageDef

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.Match
open Mettapedia.OSLF.MeTTaIL.MatchSpec
open Mettapedia.OSLF.MeTTaIL.Engine
open Mettapedia.OSLF.MeTTaIL.ContextualStep
open Mettapedia.OSLF.MeTTaIL.DerivedContexts
open Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical
open Mettapedia.OSLF.MeTTaIL.ReflectiveSubstitution
open Mettapedia.OSLF.MeTTaIL.Substitution (freeVars)
open Mettapedia.OSLF.Framework.PredFiniteSufficient

/-! ## Reading a variable -/

/-- A binding at the head of the list is the value of its variable. -/
theorem applyBindings_fvar_cons_self (name : String) (value : Pattern) (bindings : Bindings) :
    applyBindings ((name, value) :: bindings) (.fvar name) = value := by
  simp [applyBindings]

/-- A binding of another variable at the head of the list is skipped. -/
theorem applyBindings_fvar_cons_of_ne {name key : String} (distinct : key ≠ name)
    (value : Pattern) (bindings : Bindings) :
    applyBindings ((key, value) :: bindings) (.fvar name) =
      applyBindings bindings (.fvar name) := by
  have skip : (key == name) = false := by simpa using distinct
  simp [applyBindings, List.find?, skip]

/-- Instantiating a constructor applied to variables reads each variable. -/
theorem applyBindings_apply_variables (bindings : Bindings) (label : String)
    (names : List String) :
    applyBindings bindings (.apply label (names.map .fvar)) =
      .apply label (names.map fun name => applyBindings bindings (.fvar name)) := by
  conv_lhs => rw [applyBindings.eq_def]
  simp [List.map_map, Function.comp_def]

/-- Different variables zipped with as many values are bound to them in
order. -/
theorem applyBindings_zip_variables :
    ∀ (names : List String) (values : List Pattern), names.Nodup →
      names.length = values.length →
      (names.map fun name => applyBindings (names.zip values) (.fvar name)) = values
  | [], [], _, _ => rfl
  | [], _ :: _, _, lengths => by cases lengths
  | _ :: _, [], _, lengths => by cases lengths
  | name :: names, value :: values, nodup, lengths => by
      obtain ⟨fresh, nodupTail⟩ := List.nodup_cons.mp nodup
      have recurse := applyBindings_zip_variables names values nodupTail (by simpa using lengths)
      have tail : (names.map fun other =>
          applyBindings ((name, value) :: names.zip values) (.fvar other)) = values :=
        (List.map_congr_left fun other membership =>
          applyBindings_fvar_cons_of_ne
            (fun same : name = other => fresh (same ▸ membership)) value _).trans recurse
      simp only [List.zip_cons_cons, List.map_cons, applyBindings_fvar_cons_self, tail]

/-- A constructor applied to variables is built from constructors and
variables alone. -/
theorem isMatchCorrectAux_apply_variables (label : String) :
    ∀ names : List String, isMatchCorrectAux (.apply label (names.map .fvar)) = true := by
  intro names
  simp only [isMatchCorrectAux]
  induction names with
  | nil => rfl
  | cons name names recurse => simp [isMatchCorrectListAux, isMatchCorrectAux, recurse]

/-- The variables of a constructor applied to variables. -/
theorem freeVars_apply_variables (label : String) (names : List String) :
    freeVars (.apply label (names.map .fvar)) = names := by
  rw [freeVars.eq_def]
  induction names with
  | nil => rfl
  | cons name names recurse =>
      simp only [List.map_cons, List.flatMap_cons] at recurse ⊢
      rw [recurse, freeVars.eq_def]
      rfl

/-! ## Rules that say where rewrites fire -/

/-- A rule that lets one argument of a constructor reduce:
`C(a⃗, S, b⃗) ⟶ C(a⃗, T, b⃗)` when `S ⟶ T`, with all the variables different. -/
structure ArgumentCongruence (rule : RewriteRule) (label : String)
    (before after : List String) (source target : String) : Prop where
  premises : rule.premises = [.congruence (.fvar source) (.fvar target)]
  left : rule.left = .apply label ((before ++ source :: after).map .fvar)
  right : rule.right = .apply label ((before ++ target :: after).map .fvar)
  linear : (target :: (before ++ source :: after)).Nodup

/-- A rule that lets one component of an unordered collection reduce:
`{S | rest} ⟶ {T | rest}` when `S ⟶ T`. -/
structure ElementCongruence (rule : RewriteRule) (kind : CollType)
    (source target rest : String) : Prop where
  premises : rule.premises = [.congruence (.fvar source) (.fvar target)]
  left : rule.left = .collection kind [.fvar source] (some rest)
  right : rule.right = .collection kind [.fvar target] (some rest)
  unordered : kind ≠ .vec
  distinct : source ≠ rest ∧ target ≠ rest ∧ source ≠ target

/-- A rule whose single premise asks one variable of its left side to reduce
to a fresh variable, both sides being built from constructors and variables
alone, carries a reduction of that variable's value to a reduction of the
whole instance. -/
theorem step_of_exactCongruence {relEnv : RelationEnv} {language : LanguageDef}
    {rule : RewriteRule} {source target : String}
    (listed : rule ∈ language.rewrites)
    (premises : rule.premises = [.congruence (.fvar source) (.fvar target)])
    (leftExact : isMatchCorrectAux rule.left = true)
    (rightExact : isMatchCorrectAux rule.right = true)
    (sourceOccurs : source ∈ freeVars rule.left)
    (targetFresh : target ∉ freeVars rule.left)
    (rightVariables : ∀ name ∈ freeVars rule.right,
      name ∈ freeVars rule.left ∨ name = target)
    (bindings : Bindings) {reduct : Pattern}
    (inner : Step (engineBasePremises relEnv) language
      (applyBindings bindings (.fvar source)) reduct) :
    Step (engineBasePremises relEnv) language (applyBindings bindings rule.left)
      (applyBindings ((target, reduct) :: bindings) rule.right) := by
  have agreeLeft : ∀ name ∈ freeVars rule.left,
      lookupOrFvar ((target, reduct) :: bindings) name = lookupOrFvar bindings name := by
    intro name membership
    exact applyBindings_fvar_cons_of_ne
      (fun same : target = name => targetFresh (same ▸ membership)) reduct bindings
  have leftSame : applyBindings ((target, reduct) :: bindings) rule.left =
      applyBindings bindings rule.left :=
    applyBindings_eq_of_agree_isMatchCorrect leftExact agreeLeft
  obtain ⟨initial, matched, valued⟩ :=
    matchPattern_applyBindings_complete (bs := (target, reduct) :: bindings) leftExact
  rw [leftSame] at matched
  have initialLeft : applyBindings initial rule.left =
      applyBindings ((target, reduct) :: bindings) rule.left := by
    rw [leftSame]
    exact matchPattern_correct matched leftExact
  have initialSource : applyBindings initial (.fvar source) =
      applyBindings bindings (.fvar source) :=
    (applyBindings_injective_isMatchCorrect leftExact initialLeft source sourceOccurs).trans
      (agreeLeft source sourceOccurs)
  obtain ⟨final, merged, -⟩ :=
    mergeBindings_some_of_valued initial [(target, reduct)]
      (lookupOrFvar ((target, reduct) :: bindings)) valued (by
        intro name value membership
        obtain ⟨rfl, rfl⟩ := Prod.mk.inj (List.mem_singleton.mp membership)
        exact (applyBindings_fvar_cons_self name value bindings).symm)
  have finalLeft : applyBindings final rule.left =
      applyBindings ((target, reduct) :: bindings) rule.left := by
    rw [leftSame]
    exact matchRel_correct_of_extends (matchPattern_sound matched) leftExact
      (fun _ _ found => mergeBindings_subsumed_left merged found)
  refine step_of_single_congruence_rule listed (by simpa using matched) premises
    (by rw [initialSource]; exact inner) (matchRel_complete .fvar) merged ?_
  rw [applyBindingsForRule_eq_applyBindings _ _ _
    (ruleDepthAligned_of_binderFree rule (binderFree_of_isMatchCorrectAux _ leftExact)
      (binderFree_of_isMatchCorrectAux _ rightExact))]
  apply applyBindings_eq_of_agree_isMatchCorrect rightExact
  intro name membership
  rcases rightVariables name membership with inLeft | rfl
  · exact applyBindings_injective_isMatchCorrect leftExact finalLeft name inLeft
  · have found : final.find? (·.1 == name) = some (name, reduct) :=
      mergeBindings_subsumed_right merged (by simp)
    simp [lookupOrFvar, applyBindings, found]

/-- **A reduction of an argument is a reduction of the application.**  The
siblings are arbitrary terms and are left where they are. -/
theorem ArgumentCongruence.step {relEnv : RelationEnv} {language : LanguageDef}
    {rule : RewriteRule} {label : String} {before after : List String}
    {source target : String}
    (congruence : ArgumentCongruence rule label before after source target)
    (listed : rule ∈ language.rewrites) {beforeTerms afterTerms : List Pattern}
    (beforeLength : beforeTerms.length = before.length)
    (afterLength : afterTerms.length = after.length) {redex reduct : Pattern}
    (inner : Step (engineBasePremises relEnv) language redex reduct) :
    Step (engineBasePremises relEnv) language
      (.apply label (beforeTerms ++ redex :: afterTerms))
      (.apply label (beforeTerms ++ reduct :: afterTerms)) := by
  obtain ⟨targetFresh, nodup⟩ := List.nodup_cons.mp congruence.linear
  let bindings : Bindings :=
    (before ++ source :: after).zip (beforeTerms ++ redex :: afterTerms)
  have read := applyBindings_zip_variables (before ++ source :: after)
    (beforeTerms ++ redex :: afterTerms) nodup (by simp [beforeLength, afterLength])
  have readParts := read
  simp only [List.map_append, List.map_cons] at readParts
  obtain ⟨readBefore, readRest⟩ := List.append_inj readParts (by simp [beforeLength])
  obtain ⟨readSource, readAfter⟩ := List.cons.inj readRest
  have instanceLeft : applyBindings bindings rule.left =
      .apply label (beforeTerms ++ redex :: afterTerms) := by
    rw [congruence.left, applyBindings_apply_variables, read]
  have instanceRight : applyBindings ((target, reduct) :: bindings) rule.right =
      .apply label (beforeTerms ++ reduct :: afterTerms) := by
    rw [congruence.right, applyBindings_apply_variables]
    simp only [List.map_append, List.map_cons, applyBindings_fvar_cons_self]
    have skip : ∀ names : List String, (∀ name ∈ names, name ∈ before ++ source :: after) →
        (names.map fun name => applyBindings ((target, reduct) :: bindings) (.fvar name)) =
          names.map fun name => applyBindings bindings (.fvar name) := by
      intro names within
      exact List.map_congr_left fun name membership =>
        applyBindings_fvar_cons_of_ne
          (fun same : target = name => targetFresh (same ▸ within name membership))
          reduct bindings
    rw [skip before (fun name membership => List.mem_append_left _ membership),
      skip after (fun name membership =>
        List.mem_append_right _ (List.mem_cons_of_mem _ membership)),
      readBefore, readAfter]
  have stepped := step_of_exactCongruence (relEnv := relEnv) listed congruence.premises
    (by rw [congruence.left]; exact isMatchCorrectAux_apply_variables label _)
    (by rw [congruence.right]; exact isMatchCorrectAux_apply_variables label _)
    (by rw [congruence.left, freeVars_apply_variables]; simp)
    (by rw [congruence.left, freeVars_apply_variables]; exact targetFresh)
    (by
      rw [congruence.left, congruence.right, freeVars_apply_variables,
        freeVars_apply_variables]
      intro name membership
      rcases List.mem_append.mp membership with inBefore | inRest
      · exact .inl (List.mem_append_left _ inBefore)
      · rcases List.mem_cons.mp inRest with rfl | inAfter
        · exact .inr rfl
        · exact .inl (List.mem_append_right _ (List.mem_cons_of_mem _ inAfter)))
    bindings (reduct := reduct) (by rw [readSource]; exact inner)
  rwa [instanceLeft, instanceRight] at stepped

/-- **A reduction of a component is a reduction of the collection.**  The
reduct is returned at the front; the other components keep their order. -/
theorem ElementCongruence.step {relEnv : RelationEnv} {language : LanguageDef}
    {rule : RewriteRule} {kind : CollType} {source target rest : String}
    (congruence : ElementCongruence rule kind source target rest)
    (listed : rule ∈ language.rewrites) (before after : List Pattern)
    (tail : Option String) {redex reduct : Pattern}
    (inner : Step (engineBasePremises relEnv) language redex reduct) :
    Step (engineBasePremises relEnv) language
      (.collection kind (before ++ redex :: after) tail)
      (.collection kind (reduct :: (before ++ after)) none) := by
  obtain ⟨sourceRest, targetRest, sourceTarget⟩ := congruence.distinct
  have restSource : (rest == source) = false := by simpa using Ne.symm sourceRest
  have restTarget : (rest == target) = false := by simpa using Ne.symm targetRest
  have sourceTargetBeq : (source == target) = false := by simpa using sourceTarget
  have targetRestBeq : (target == rest) = false := by simpa using targetRest
  have sourceRestBeq : (source == rest) = false := by simpa using sourceRest
  have index : before.length < (before ++ redex :: after).length := by simp
  have selected : (before ++ redex :: after)[before.length] = redex := by simp
  have erased : (before ++ redex :: after).eraseIdx before.length = before ++ after := by
    rw [List.eraseIdx_append_of_length_le (Nat.le_refl _)]
    simp
  have first : MatchRel (.fvar source) (before ++ redex :: after)[before.length]
      [(source, redex)] := by
    rw [selected]
    exact .fvar
  have others : MatchBagRel [] (some rest) kind
      ((before ++ redex :: after).eraseIdx before.length)
      [(rest, .collection kind (before ++ after) none)] := by
    rw [erased]
    exact .nilRest
  have mergedBag : mergeBindings [(source, redex)]
      [(rest, Pattern.collection kind (before ++ after) none)] =
        some [(rest, Pattern.collection kind (before ++ after) none), (source, redex)] := by
    simp [mergeBindings, List.find?, sourceRestBeq]
  have matched : [(rest, Pattern.collection kind (before ++ after) none), (source, redex)] ∈
      matchPattern rule.left (.collection kind (before ++ redex :: after) tail) := by
    rw [congruence.left]
    exact matchRel_complete (.collection congruence.unordered
      (.cons before.length index first others mergedBag))
  have initialSource : applyBindings
      [(rest, Pattern.collection kind (before ++ after) none), (source, redex)]
      (.fvar source) = redex := by
    simp [applyBindings, List.find?, restSource]
  have merged : mergeBindings
      [(rest, Pattern.collection kind (before ++ after) none), (source, redex)]
      [(target, reduct)] =
        some [(target, reduct), (rest, Pattern.collection kind (before ++ after) none),
          (source, redex)] := by
    simp [mergeBindings, List.find?, restTarget, sourceTargetBeq]
  refine step_of_single_congruence_rule listed (by simpa using matched) congruence.premises
    (by rw [initialSource]; exact inner) (matchRel_complete .fvar) merged ?_
  rw [applyBindingsForRule_eq_applyBindings _ _ _
    (ruleDepthAligned_of_binderFree rule (by rw [congruence.left]; rfl)
      (by rw [congruence.right]; rfl)),
    congruence.right, applyBindings_collection]
  simp [restResolution, applyBindings, List.find?, targetRestBeq]

/-! ## The contexts in which rewrites fire -/

/-- The contexts in which rewrites fire, each with the context the reduct is
returned in. -/
inductive Reactive (language : LanguageDef) : OneHoleContext → OneHoleContext → Prop where
  | hole : Reactive language .hole .hole
  | argument {rule : RewriteRule} {label : String} {before after : List String}
      {source target : String} {inner residual : OneHoleContext}
      (beforeTerms afterTerms : List Pattern) :
      rule ∈ language.rewrites →
      ArgumentCongruence rule label before after source target →
      beforeTerms.length = before.length → afterTerms.length = after.length →
      Reactive language inner residual →
      Reactive language (.apply label beforeTerms inner afterTerms)
        (.apply label beforeTerms residual afterTerms)
  | element {rule : RewriteRule} {kind : CollType} {source target rest : String}
      {inner residual : OneHoleContext}
      (before after : List Pattern) (tail : Option String) :
      rule ∈ language.rewrites →
      ElementCongruence rule kind source target rest →
      Reactive language inner residual →
      Reactive language (.collection kind before inner after tail)
        (.collection kind [] residual (before ++ after) none)

/-- **Rewrites fire in these contexts.**  A reduction of the subterm is a
reduction of the term, and the reduct is returned in the paired context. -/
theorem Reactive.step {relEnv : RelationEnv} {language : LanguageDef}
    {context residual : OneHoleContext} (reactive : Reactive language context residual)
    {redex reduct : Pattern}
    (inner : Step (engineBasePremises relEnv) language redex reduct) :
    Step (engineBasePremises relEnv) language (context.fill redex) (residual.fill reduct) := by
  induction reactive with
  | hole => exact inner
  | argument beforeTerms afterTerms listed congruence beforeLength afterLength _ recurse =>
      exact congruence.step listed beforeLength afterLength recurse
  | element before after tail listed congruence _ recurse =>
      exact congruence.step listed before after tail recurse

/-- These contexts compose, and so do the contexts their reducts land in. -/
theorem Reactive.comp {language : LanguageDef} {outer outerResidual : OneHoleContext}
    (first : Reactive language outer outerResidual) {inner innerResidual : OneHoleContext}
    (second : Reactive language inner innerResidual) :
    Reactive language (outer.comp inner) (outerResidual.comp innerResidual) := by
  induction first with
  | hole => exact second
  | argument beforeTerms afterTerms listed congruence beforeLength afterLength _ recurse =>
      exact .argument beforeTerms afterTerms listed congruence beforeLength afterLength recurse
  | element before after tail listed congruence _ recurse =>
      exact .element before after tail listed congruence recurse

/-! ## Reductions are base rewrites in context -/

/-- A base rewrite has only side conditions among its premises. -/
theorem noncontextualPremises_of_isBaseRewrite {rule : RewriteRule}
    (base : IsBaseRewrite rule) : NoncontextualPremises rule.premises := by
  unfold IsBaseRewrite at base
  generalize rule.premises = premises at base
  induction premises with
  | nil => exact .nil
  | cons premise premises recurse =>
      have tail := recurse fun other membership => base other (List.mem_cons_of_mem _ membership)
      have head := base premise (List.mem_cons_self ..)
      cases premise with
      | freshness condition => exact .freshness tail
      | relationQuery relation arguments => exact .relationQuery tail
      | forAll collection parameter body => exact .forAll tail
      | congruence source target => simp [isReductionHypothesis] at head
      | scopedStep step => simp [isReductionHypothesis] at head

/-- A base contraction: an instance of a base rewrite whose side conditions
hold, applied at the root. -/
def BaseStep (relEnv : RelationEnv) (language : LanguageDef) (redex reduct : Pattern) : Prop :=
  ∃ rule ∈ language.rewrites, IsBaseRewrite rule ∧
    ∃ initial ∈ matchPatternForRule language rule redex,
      ∃ final ∈ applyPremisesWithEnv relEnv language rule.premises initial,
        applyBindingsForRule language rule final = reduct

/-- A base contraction is a reduction. -/
theorem BaseStep.step {relEnv : RelationEnv} {language : LanguageDef} {redex reduct : Pattern}
    (contraction : BaseStep relEnv language redex reduct) :
    Step (engineBasePremises relEnv) language redex reduct := by
  obtain ⟨rule, listed, base, initial, matched, final, premises, targetEq⟩ := contraction
  exact step_of_rule listed matched (noncontextualPremises_of_isBaseRewrite base) premises
    targetEq

/-- Every rule of the language is a base rewrite or says where rewrites
fire. -/
def FiresInContexts (language : LanguageDef) : Prop :=
  ∀ rule ∈ language.rewrites, IsBaseRewrite rule ∨
    (∃ label before after source target,
      ArgumentCongruence rule label before after source target) ∨
    (∃ kind source target rest, ElementCongruence rule kind source target rest)

/-- A derivation ends in a base contraction beneath a context in which
rewrites fire. -/
theorem exists_baseStep_of_stepAt {relEnv : RelationEnv} {language : LanguageDef}
    (rules : FiresInContexts language) :
    ∀ (fuel : Nat) (state next : Pattern),
      StepAt (engineBasePremises relEnv) language fuel state next →
        ∃ context residual redex reduct, Reactive language context residual ∧
          context.fill redex = state ∧ residual.fill reduct = next ∧
            BaseStep relEnv language redex reduct
  | 0, _, _, step => by cases step
  | fuel + 1, state, next, step => by
      cases step with
      | @rule _ _ _ rule initial final listed matched premises targetEq =>
          rcases rules rule listed with base |
            ⟨label, before, after, source, target, congruence⟩ |
            ⟨kind, source, target, rest, congruence⟩
          · exact ⟨.hole, .hole, state, next, .hole, rfl, rfl, rule, listed, base, initial,
              matched, final,
              (premisesAt_engineBase_iff_mem_applyPremisesWithEnv
                (noncontextualPremises_of_isBaseRewrite base)).mp premises, targetEq⟩
          · have leftExact : isMatchCorrectAux rule.left = true := by
              rw [congruence.left]
              exact isMatchCorrectAux_apply_variables label _
            have rightExact : isMatchCorrectAux rule.right = true := by
              rw [congruence.right]
              exact isMatchCorrectAux_apply_variables label _
            have matched' : initial ∈ matchPattern rule.left state := by simpa using matched
            rw [congruence.premises] at premises
            cases premises with
            | cons firstPremise restPremises =>
                cases restPremises
                cases firstPremise with
                | @congruence _ _ premiseBindings _ _ _ candidate innerStep premiseMatched
                    merged =>
                    obtain ⟨context, residual, redex, reduct, reactive, plugs, lands, base⟩ :=
                      exists_baseStep_of_stepAt rules fuel _ _ innerStep
                    have premiseShape : premiseBindings = [(target, candidate)] := by
                      have relation := matchPattern_sound premiseMatched
                      cases relation
                      rfl
                    subst premiseShape
                    have initialLeft : applyBindings initial rule.left = state :=
                      matchPattern_correct matched' leftExact
                    have finalLeft : applyBindings final rule.left = state :=
                      matchRel_correct_of_extends (matchPattern_sound matched') leftExact
                        (fun _ _ found => mergeBindings_subsumed_left merged found)
                    have finalTarget : applyBindings final (.fvar target) = candidate := by
                      have found : final.find? (·.1 == target) = some (target, candidate) :=
                        mergeBindings_subsumed_right merged (by simp)
                      simp [applyBindings, found]
                    have nextEq : applyBindings final rule.right = next := by
                      rw [← targetEq, applyBindingsForRule_eq_applyBindings _ _ _
                        (ruleDepthAligned_of_binderFree rule
                          (binderFree_of_isMatchCorrectAux _ leftExact)
                          (binderFree_of_isMatchCorrectAux _ rightExact))]
                    rw [congruence.left, applyBindings_apply_variables] at initialLeft finalLeft
                    rw [congruence.right, applyBindings_apply_variables] at nextEq
                    simp only [List.map_append, List.map_cons] at initialLeft finalLeft nextEq
                    have same : (before.map fun name => applyBindings final (.fvar name)) ++
                        applyBindings final (.fvar source) ::
                          (after.map fun name => applyBindings final (.fvar name)) =
                        (before.map fun name => applyBindings initial (.fvar name)) ++
                          applyBindings initial (.fvar source) ::
                            (after.map fun name => applyBindings initial (.fvar name)) := by
                      have equal := finalLeft.trans initialLeft.symm
                      injection equal
                    obtain ⟨sameBefore, sameRest⟩ := List.append_inj same (by simp)
                    obtain ⟨-, sameAfter⟩ := List.cons.inj sameRest
                    rw [sameBefore, sameAfter, finalTarget] at nextEq
                    refine ⟨.apply label (before.map fun name => applyBindings initial (.fvar name))
                        context (after.map fun name => applyBindings initial (.fvar name)),
                      .apply label (before.map fun name => applyBindings initial (.fvar name))
                        residual (after.map fun name => applyBindings initial (.fvar name)),
                      redex, reduct,
                      .argument _ _ listed congruence (by simp) (by simp) reactive, ?_, ?_, base⟩
                    · rw [← initialLeft]
                      simp [OneHoleContext.fill, plugs]
                    · rw [← nextEq]
                      simp [OneHoleContext.fill, lands]
          · obtain ⟨sourceRest, targetRest, sourceTarget⟩ := congruence.distinct
            have restSource : (rest == source) = false := by simpa using Ne.symm sourceRest
            have restTarget : (rest == target) = false := by simpa using Ne.symm targetRest
            have sourceTargetBeq : (source == target) = false := by simpa using sourceTarget
            have targetRestBeq : (target == rest) = false := by simpa using targetRest
            have sourceRestBeq : (source == rest) = false := by simpa using sourceRest
            have matched' : initial ∈ matchPattern rule.left state := by simpa using matched
            rw [congruence.left] at matched'
            rw [congruence.premises] at premises
            have relation := matchPattern_sound matched'
            cases relation with
            | vectorRest _ _ => exact absurd rfl congruence.unordered
            | @collection _ _ _ elements _ tail _ bag =>
                cases bag with
                | cons position bound firstMatch restMatch mergedBag =>
                    cases firstMatch
                    cases restMatch
                    obtain rfl : [(rest, Pattern.collection kind (elements.eraseIdx position) none),
                        (source, elements[position])] = initial := by
                      simpa [mergeBindings, List.find?, sourceRestBeq] using mergedBag
                    cases premises with
                    | cons firstPremise restPremises =>
                        cases restPremises
                        cases firstPremise with
                        | @congruence _ _ premiseBindings _ _ _ candidate innerStep
                            premiseMatched merged =>
                            have premiseShape : premiseBindings = [(target, candidate)] := by
                              have relation := matchPattern_sound premiseMatched
                              cases relation
                              rfl
                            subst premiseShape
                            have innerSource :
                                applyBindings
                                  [(rest, Pattern.collection kind
                                      (elements.eraseIdx position) none),
                                    (source, elements[position])] (.fvar source) =
                                  elements[position] := by
                              simp [applyBindings, List.find?, restSource]
                            rw [innerSource] at innerStep
                            obtain ⟨context, residual, redex, reduct, reactive, plugs, lands,
                                base⟩ := exists_baseStep_of_stepAt rules fuel _ _ innerStep
                            obtain rfl : [(target, candidate),
                                (rest, Pattern.collection kind (elements.eraseIdx position) none),
                                (source, elements[position])] = final := by
                              simpa [mergeBindings, List.find?, restTarget, sourceTargetBeq]
                                using merged
                            have nextEq : Pattern.collection kind
                                (candidate :: elements.eraseIdx position) none = next := by
                              rw [← targetEq, applyBindingsForRule_eq_applyBindings _ _ _
                                (ruleDepthAligned_of_binderFree rule
                                  (by rw [congruence.left]; rfl)
                                  (by rw [congruence.right]; rfl)),
                                congruence.right, applyBindings_collection]
                              simp [restResolution, applyBindings, List.find?, targetRestBeq]
                            refine ⟨.collection kind (elements.take position) context
                                (elements.drop (position + 1)) tail,
                              .collection kind [] residual
                                (elements.take position ++ elements.drop (position + 1)) none,
                              redex, reduct,
                              .element _ _ tail listed congruence reactive, ?_, ?_, base⟩
                            · simp only [OneHoleContext.fill, plugs]
                              rw [← List.drop_eq_getElem_cons bound, List.take_append_drop]
                            · rw [← nextEq, List.eraseIdx_eq_take_drop_succ]
                              simp [OneHoleContext.fill, lands]

/-- **A reduction is a base rewrite in a context in which rewrites fire.**
The right-to-left direction holds in every language; the left-to-right
direction needs every rule to be a base rewrite or a congruence. -/
theorem step_iff_baseStep_in_context {relEnv : RelationEnv} {language : LanguageDef}
    (rules : FiresInContexts language) {state next : Pattern} :
    Step (engineBasePremises relEnv) language state next ↔
      ∃ context residual redex reduct, Reactive language context residual ∧
        context.fill redex = state ∧ residual.fill reduct = next ∧
          BaseStep relEnv language redex reduct := by
  constructor
  · rintro ⟨fuel, step⟩
    exact exists_baseStep_of_stepAt rules fuel state next step
  · rintro ⟨context, residual, redex, reduct, reactive, rfl, rfl, base⟩
    exact reactive.step base.step

end Mettapedia.GSLT.LanguageDef
