/-- The frozen external test set contains exactly 31 statements. -/
theorem statements_length : statements.length = 31 := by rfl

/-- Every reified source statement survives the independent prefix parser. -/
theorem statement_roundTrip (statement : Statement) :
    Expr.decode statement.goal.encode = some statement.goal :=
  Expr.decode_encode statement.goal

/-- The round-trip theorem applies uniformly to every frozen statement. -/
theorem allStatements_roundTrip :
    ∀ statement ∈ statements,
      Expr.decode statement.goal.encode = some statement.goal := by
  intro statement _
  exact statement_roundTrip statement

/-- Every frozen statement is a closed goal of the Pure fragment. -/
theorem allStatements_wellScoped :
    ∀ statement ∈ statements, Expr.WellScoped 0 statement.goal := by
  intro statement _
  exact statement.goalWellScoped

