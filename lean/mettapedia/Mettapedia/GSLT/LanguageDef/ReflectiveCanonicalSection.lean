import Mettapedia.GSLT.LanguageDef.CanonicalSection
import Mettapedia.GSLT.LanguageDef.ContextSupport
import Mettapedia.GSLT.LanguageDef.ReflectiveEquationSemantics

/-!
# Canonical sections indexed by an admitted reflection extension

The five-field language determines the typed carrier.  An independently
admitted reflection profile can extend its equation relation without becoming
a field of that language.  The normalizer remains a function on the ordinary
typed carrier, which is the useful interface for staging, while its section
laws explicitly name the extended relation.  A separate preservation law
shows that the normalizer restricts to the profile's quote-safe subcarrier.
-/

namespace Mettapedia.GSLT.LanguageDef

open Mettapedia.OSLF.Framework.ConstructorCategory
open Mettapedia.OSLF.MeTTaIL.Syntax
open ReflectiveEquationSemantics
open ReflectionExtension

/-- One core or reflection-authorized equation step whose endpoints remain
in an exact ordinary typed open fibre. -/
def reflectiveOpenEquationGenerator (theory : IGSLT)
    (reflection : AdmittedProfile theory.presentation.presentation.language)
    (free : WellSorted.FreeTypeContext) (bound : List TypeExpr)
    (sort : LangSort theory.presentation.presentation.language)
    (left right : OpenTerm theory free bound sort) : Prop :=
  ReflectiveEquationContextStep reflection.1 defaultBasePremises
    theory.presentation.presentation.language left.1 right.1

/-- The equation setoid selected by a five-field presentation together with
one explicit admitted reflection extension. -/
def reflectiveOpenEquationSetoid (theory : IGSLT)
    (reflection : AdmittedProfile theory.presentation.presentation.language)
    (free : WellSorted.FreeTypeContext) (bound : List TypeExpr)
    (sort : LangSort theory.presentation.presentation.language) :
    Setoid (OpenTerm theory free bound sort) where
  r := Relation.EqvGen
    (reflectiveOpenEquationGenerator theory reflection free bound sort)
  iseqv :=
    { refl := Relation.EqvGen.refl
      symm := fun relation => Relation.EqvGen.symm _ _ relation
      trans := fun first second => Relation.EqvGen.trans _ _ _ first second }

/-- Erasing the ordinary typed endpoints of an open reflective equation path
retains its exact raw contextual equivalence. -/
theorem reflectiveOpenEquationSetoid_to_equiv
    {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    {free : WellSorted.FreeTypeContext} {bound : List TypeExpr}
    {sort : LangSort theory.presentation.presentation.language}
    {left right : OpenTerm theory free bound sort}
    (equivalent :
      (reflectiveOpenEquationSetoid theory reflection free bound sort).r
        left right) :
    ReflectiveEquationEquiv reflection.1 defaultBasePremises
      theory.presentation.presentation.language left.1 right.1 := by
  change Relation.EqvGen
    (reflectiveOpenEquationGenerator theory reflection free bound sort)
      left right at equivalent
  induction equivalent with
  | rel left right step => exact Relation.EqvGen.rel _ _ step
  | refl term => exact Relation.EqvGen.refl term.1
  | symm left right relation inductionHypothesis =>
      exact Relation.EqvGen.symm _ _ inductionHypothesis
  | trans left middle right first second firstIH secondIH =>
      exact Relation.EqvGen.trans _ _ _ firstIH secondIH

/-- Attaching reflection preserves every equation path generated by the
five-field core. -/
theorem openEquationSetoid_to_reflectiveOpenEquationSetoid
    {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    {free : WellSorted.FreeTypeContext} {bound : List TypeExpr}
    {sort : LangSort theory.presentation.presentation.language}
    {left right : OpenTerm theory free bound sort}
    (equivalent : (openEquationSetoid theory free bound sort).r left right) :
    (reflectiveOpenEquationSetoid theory reflection free bound sort).r
      left right := by
  induction equivalent with
  | rel left right generator =>
      exact Relation.EqvGen.rel _ _ (.core generator)
  | refl term => exact Relation.EqvGen.refl term
  | symm left right relation inductionHypothesis =>
      exact Relation.EqvGen.symm _ _ inductionHypothesis
  | trans left middle right first second firstIH secondIH =>
      exact Relation.EqvGen.trans _ _ _ firstIH secondIH

/-- The corresponding extended equation relation on the closed interacting
carrier.  Its carrier is still derived from the five-field language; only the
relation is selected by the independent extension. -/
def reflectiveClosedEquationGenerator (theory : IGSLT)
    (reflection : AdmittedProfile theory.presentation.presentation.language)
    (left right : theory.toGSLT.Term) : Prop :=
  ReflectiveEquationContextStep reflection.1 defaultBasePremises
    theory.presentation.presentation.language left.1 right.1

def reflectiveClosedEquationSetoid (theory : IGSLT)
    (reflection : AdmittedProfile theory.presentation.presentation.language) :
    Setoid theory.toGSLT.Term where
  r := Relation.EqvGen (reflectiveClosedEquationGenerator theory reflection)
  iseqv :=
    { refl := Relation.EqvGen.refl
      symm := fun relation => Relation.EqvGen.symm _ _ relation
      trans := fun first second => Relation.EqvGen.trans _ _ _ first second }

/-- Restrict a closed extended-equation path to the corresponding empty open
fibre. -/
theorem reflectiveClosedEquationSetoid_to_open
    {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    {left right : theory.toGSLT.Term}
    (equivalent :
      (reflectiveClosedEquationSetoid theory reflection).r left right) :
    (reflectiveOpenEquationSetoid theory reflection
      WellSorted.FreeTypeContext.empty []
      theory.presentation.interactingLangSort).r
        (closedTermToOpen left) (closedTermToOpen right) := by
  induction equivalent with
  | rel left right generator => exact Relation.EqvGen.rel _ _ generator
  | refl term => exact Relation.EqvGen.refl (closedTermToOpen term)
  | symm left right relation inductionHypothesis =>
      exact Relation.EqvGen.symm _ _ inductionHypothesis
  | trans left middle right first second firstIH secondIH =>
      exact Relation.EqvGen.trans _ _ _ firstIH secondIH

/-- Close an extended-equation path in the empty interacting fibre. -/
theorem reflectiveOpenEquationSetoid_to_closed
    {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    {left right : OpenTerm theory WellSorted.FreeTypeContext.empty []
      theory.presentation.interactingLangSort}
    (equivalent :
      (reflectiveOpenEquationSetoid theory reflection
        WellSorted.FreeTypeContext.empty []
        theory.presentation.interactingLangSort).r left right) :
    (reflectiveClosedEquationSetoid theory reflection).r
      (openTermEmptyToClosed left) (openTermEmptyToClosed right) := by
  induction equivalent with
  | rel left right generator => exact Relation.EqvGen.rel _ _ generator
  | refl term => exact Relation.EqvGen.refl (openTermEmptyToClosed term)
  | symm left right relation inductionHypothesis =>
      exact Relation.EqvGen.symm _ _ inductionHypothesis
  | trans left middle right first second firstIH secondIH =>
      exact Relation.EqvGen.trans _ _ _ firstIH secondIH

/-- A computable section for the equation theory selected by an explicit
reflection extension.  `normalize` deliberately accepts the ordinary typed
carrier; `preservesReflectiveScope` proves that its admitted subcarrier is
invariant. -/
structure ComputableReflectiveOpenSection (theory : IGSLT)
    (reflection : AdmittedProfile
      theory.presentation.presentation.language) where
  normalize : ∀ {free bound sort},
    OpenTerm theory free bound sort → OpenTerm theory free bound sort
  equivalent : ∀ {free bound sort}
      (term : OpenTerm theory free bound sort),
    (reflectiveOpenEquationSetoid theory reflection free bound sort).r
      (normalize term) term
  complete : ∀ {free bound sort}
      {left right : OpenTerm theory free bound sort},
    (reflectiveOpenEquationSetoid theory reflection free bound sort).r
        left right →
      normalize left = normalize right
  preservesReflectiveScope : ∀ {free bound sort}
      (term : OpenTerm theory free bound sort),
    ReflectiveWellSorted.ReflectiveScopeSafeAt reflection.1 bound.length
        term.1 →
      ReflectiveWellSorted.ReflectiveScopeSafeAt reflection.1 bound.length
        (normalize term).1

namespace ComputableReflectiveOpenSection

/-- Construct an extended open section from generator invariance. -/
def ofGeneratorInvariant {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (normalize : ∀ {free bound sort},
      OpenTerm theory free bound sort → OpenTerm theory free bound sort)
    (equivalent : ∀ {free bound sort}
      (term : OpenTerm theory free bound sort),
      (reflectiveOpenEquationSetoid theory reflection free bound sort).r
        (normalize term) term)
    (generatorInvariant : ∀ {free bound sort}
      {left right : OpenTerm theory free bound sort},
      reflectiveOpenEquationGenerator theory reflection free bound sort
          left right →
        normalize left = normalize right)
    (preservesReflectiveScope : ∀ {free bound sort}
      (term : OpenTerm theory free bound sort),
      ReflectiveWellSorted.ReflectiveScopeSafeAt reflection.1 bound.length
          term.1 →
        ReflectiveWellSorted.ReflectiveScopeSafeAt reflection.1 bound.length
          (normalize term).1) :
    ComputableReflectiveOpenSection theory reflection where
  normalize := normalize
  equivalent := equivalent
  complete := by
    intro free bound sort left right relation
    induction relation with
    | rel left right generator => exact generatorInvariant generator
    | refl term => rfl
    | symm left right relation inductionHypothesis =>
        exact inductionHypothesis.symm
    | trans left middle right first second firstIH secondIH =>
        exact firstIH.trans secondIH
  preservesReflectiveScope := preservesReflectiveScope

/-- Normalization commutes with proof-only transport between equal fibres. -/
theorem normalize_reindex {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (canonical : ComputableReflectiveOpenSection theory reflection)
    {sourceFree targetFree : WellSorted.FreeTypeContext}
    {sourceBound targetBound : List TypeExpr}
    {sourceSort targetSort : LangSort
      theory.presentation.presentation.language}
    (freeEquality : sourceFree = targetFree)
    (boundEquality : sourceBound = targetBound)
    (sortEquality : sourceSort = targetSort)
    (term : OpenTerm theory sourceFree sourceBound sourceSort) :
    canonical.normalize
        (reindexOpenTerm freeEquality boundEquality sortEquality term) =
      reindexOpenTerm freeEquality boundEquality sortEquality
        (canonical.normalize term) := by
  cases freeEquality
  cases boundEquality
  cases sortEquality
  rfl

theorem normalize_idempotent {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (canonical : ComputableReflectiveOpenSection theory reflection)
    {free bound sort} (term : OpenTerm theory free bound sort) :
    canonical.normalize (canonical.normalize term) =
      canonical.normalize term :=
  canonical.complete (canonical.equivalent term)

end ComputableReflectiveOpenSection

/-- The closed section induced by an extended open section. -/
structure ComputableReflectiveCanonicalSection (theory : IGSLT)
    (reflection : AdmittedProfile
      theory.presentation.presentation.language) where
  normalize : theory.toGSLT.Term → theory.toGSLT.Term
  equivalent : ∀ term,
    (reflectiveClosedEquationSetoid theory reflection).r (normalize term) term
  complete : ∀ {left right},
    (reflectiveClosedEquationSetoid theory reflection).r left right →
      normalize left = normalize right

namespace ComputableReflectiveCanonicalSection

theorem normalize_idempotent {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (canonical : ComputableReflectiveCanonicalSection theory reflection)
    (term : theory.toGSLT.Term) :
    canonical.normalize (canonical.normalize term) =
      canonical.normalize term :=
  canonical.complete (canonical.equivalent term)

end ComputableReflectiveCanonicalSection

def ComputableReflectiveOpenSection.toCanonicalSection
    {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (canonical : ComputableReflectiveOpenSection theory reflection) :
    ComputableReflectiveCanonicalSection theory reflection where
  normalize := fun term =>
    openTermEmptyToClosed (canonical.normalize (closedTermToOpen term))
  equivalent := by
    intro term
    simpa using reflectiveOpenEquationSetoid_to_closed
      (canonical.equivalent (closedTermToOpen term))
  complete := by
    intro left right equivalent
    exact congrArg openTermEmptyToClosed
      (canonical.complete
        (reflectiveClosedEquationSetoid_to_open equivalent))

/-- Contextual support laws for a reflection-indexed open section. -/
structure ComputableReflectiveContextualOpenSection (theory : IGSLT)
    (reflection : AdmittedProfile
      theory.presentation.presentation.language)
    extends ComputableReflectiveOpenSection theory reflection where
  preservesFreeVariableSupport : ∀ {free bound sort}
      (term : OpenTerm theory free bound sort) {name : String},
    name ∈ (normalize term).1.freeFvarNames → name ∈ term.1.freeFvarNames
  normalizeRecontextualizeFree :
    ∀ {sourceFree targetFree : WellSorted.FreeTypeContext}
      {bound : List TypeExpr}
      {sort : LangSort theory.presentation.presentation.language}
      (term : OpenTerm theory sourceFree bound sort)
      (preserves : ∀ {name freeType},
        name ∈ term.1.freeFvarNames →
        sourceFree name = some freeType →
          targetFree name = some freeType),
    (normalize (term.recontextualizeFree preserves)).1 =
      (normalize term).1
  preservesReflectiveSupport : ∀ {free bound sort}
      (term : OpenTerm theory free bound sort)
      (support : ContextSupport.Support) (available : List TypeExpr)
      (binderImage : TypeExpr → TypeExpr),
    term.2.1.ReflectiveSupportSafeAt reflection.1 support available binderImage →
      (normalize term).2.1.ReflectiveSupportSafeAt reflection.1 support
        available binderImage

namespace ComputableReflectiveContextualOpenSection

def toCanonicalSection {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (canonical : ComputableReflectiveContextualOpenSection theory reflection) :
    ComputableReflectiveCanonicalSection theory reflection :=
  canonical.toComputableReflectiveOpenSection.toCanonicalSection

theorem normalize_mem_of_restrictTo {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (canonical : ComputableReflectiveContextualOpenSection theory reflection)
    {free : WellSorted.FreeTypeContext} {names : List String}
    {bound : List TypeExpr}
    {sort : LangSort theory.presentation.presentation.language}
    (term : OpenTerm theory (free.restrictTo names) bound sort)
    {name : String}
    (membership : name ∈ (canonical.normalize term).1.freeFvarNames) :
    name ∈ names :=
  (canonical.normalize term).mem_of_restrictTo_freeFvarNames membership

theorem normalize_freeFvarNames_subset {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (canonical : ComputableReflectiveContextualOpenSection theory reflection)
    {free : WellSorted.FreeTypeContext} {bound : List TypeExpr}
    {sort : LangSort theory.presentation.presentation.language}
    (term : OpenTerm theory free bound sort) {name : String}
    (membership : name ∈ (canonical.normalize term).1.freeFvarNames) :
    name ∈ term.1.freeFvarNames :=
  canonical.preservesFreeVariableSupport term membership

end ComputableReflectiveContextualOpenSection

/-! ## Sections whose domain is the admitted reflective fibre

`ComputableReflectiveOpenSection` above is intentionally total on the core
typed carrier and separately proves preservation of quote safety.  Some
normalizers, including the generated Cost normalizer, are defined only when
the input already carries the quote-safety certificate.  The following
classes model that restriction directly; they do not manufacture reflection
evidence from ordinary typing. -/

/-- Recontextualize a reflection-certified term when the target free context
agrees on every name actually used by the term. -/
def ReflectiveWellSorted.OpenTerm.recontextualizeFree
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {language : LanguageDef}
    {source target : WellSorted.FreeTypeContext}
    {bound : List TypeExpr} {sort : LangSort language}
    (term : ReflectiveWellSorted.OpenTerm
      profile language source bound sort)
    (preserves : ∀ {name freeType},
      name ∈ term.1.freeFvarNames →
      source name = some freeType → target name = some freeType) :
    ReflectiveWellSorted.OpenTerm profile language target bound sort :=
  ⟨term.1, term.toCore.recontextualizeFree preserves |>.2, term.2.2⟩

@[simp]
theorem ReflectiveWellSorted.OpenTerm.recontextualizeFree_pattern
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {language : LanguageDef}
    {source target : WellSorted.FreeTypeContext}
    {bound : List TypeExpr} {sort : LangSort language}
    (term : ReflectiveWellSorted.OpenTerm
      profile language source bound sort)
    (preserves : ∀ {name freeType},
      name ∈ term.1.freeFvarNames →
      source name = some freeType → target name = some freeType) :
    (term.recontextualizeFree preserves).1 = term.1 :=
  rfl

/-- Transport a reflective open term along a structural language map whose
reflection action explicitly preserves quote-visible scope. -/
def ReflectiveWellSorted.OpenTerm.map
    {source target : ValidatedLanguageDef}
    {sourceProfile targetProfile :
      Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    (morphism : StructuralMorphism source target)
    (mapsScope : ∀ {depth pattern},
      ReflectiveWellSorted.ReflectiveScopeSafeAt sourceProfile depth pattern →
        ReflectiveWellSorted.ReflectiveScopeSafeAt targetProfile depth
          (mapPattern morphism.symbols pattern))
    {free : WellSorted.FreeTypeContext} {bound : List TypeExpr}
    {sort : LangSort source.language}
    (term : ReflectiveWellSorted.OpenTerm sourceProfile source.language free
      bound sort) :
    ReflectiveWellSorted.OpenTerm targetProfile target.language
      (free.map morphism.symbols)
      (bound.map (mapTypeExpr morphism.symbols))
      (WellSorted.mapLangSort morphism sort) :=
  ⟨(term.toCore.map morphism).1, (term.toCore.map morphism).2, by
    change ReflectiveWellSorted.ReflectiveScopeSafeAt targetProfile
      (bound.map (mapTypeExpr morphism.symbols)).length
        (mapPattern morphism.symbols term.1)
    simpa only [List.length_map] using mapsScope term.2.2⟩

@[simp]
theorem ReflectiveWellSorted.OpenTerm.map_pattern
    {source target : ValidatedLanguageDef}
    {sourceProfile targetProfile :
      Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    (morphism : StructuralMorphism source target)
    (mapsScope : ∀ {depth pattern},
      ReflectiveWellSorted.ReflectiveScopeSafeAt sourceProfile depth pattern →
        ReflectiveWellSorted.ReflectiveScopeSafeAt targetProfile depth
          (mapPattern morphism.symbols pattern))
    {free : WellSorted.FreeTypeContext} {bound : List TypeExpr}
    {sort : LangSort source.language}
    (term : ReflectiveWellSorted.OpenTerm sourceProfile source.language free
      bound sort) :
    (term.map morphism mapsScope).1 =
      mapPattern morphism.symbols term.1 :=
  rfl

/-- A computable section on exactly the quote-safe fibre selected by an
admitted reflection profile.  Its equivalence and completeness laws use the
least equation relation whose intermediate vertices remain in that fibre. -/
structure ComputableReflectiveFiberSection (theory : IGSLT)
    (reflection : AdmittedProfile
      theory.presentation.presentation.language) where
  normalize : ∀ {free bound sort},
    ReflectiveWellSorted.OpenTerm reflection.1
      theory.presentation.presentation.language free bound sort →
    ReflectiveWellSorted.OpenTerm reflection.1
      theory.presentation.presentation.language free bound sort
  equivalent : ∀ {free bound sort}
      (term : ReflectiveWellSorted.OpenTerm reflection.1
        theory.presentation.presentation.language free bound sort),
    (ReflectiveEquationSemantics.reflectiveOpenPatternEquationSetoid
      reflection.1 defaultBasePremises
        theory.presentation.presentation.language free bound
          (.base sort.1)).r (normalize term) term
  complete : ∀ {free bound sort}
      {left right : ReflectiveWellSorted.OpenTerm reflection.1
        theory.presentation.presentation.language free bound sort},
    (ReflectiveEquationSemantics.reflectiveOpenPatternEquationSetoid
      reflection.1 defaultBasePremises
        theory.presentation.presentation.language free bound
          (.base sort.1)).r left right →
      normalize left = normalize right

namespace ComputableReflectiveFiberSection

/-- Construct a fibre section by checking one authored generator. -/
def ofGeneratorInvariant {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (normalize : ∀ {free bound sort},
      ReflectiveWellSorted.OpenTerm reflection.1
        theory.presentation.presentation.language free bound sort →
      ReflectiveWellSorted.OpenTerm reflection.1
        theory.presentation.presentation.language free bound sort)
    (equivalent : ∀ {free bound sort}
      (term : ReflectiveWellSorted.OpenTerm reflection.1
        theory.presentation.presentation.language free bound sort),
      (ReflectiveEquationSemantics.reflectiveOpenPatternEquationSetoid
        reflection.1 defaultBasePremises
          theory.presentation.presentation.language free bound
            (.base sort.1)).r (normalize term) term)
    (generatorInvariant : ∀ {free bound sort}
      {left right : ReflectiveWellSorted.OpenTerm reflection.1
        theory.presentation.presentation.language free bound sort},
      ReflectiveEquationSemantics.reflectiveOpenPatternEquationGenerator
          reflection.1 defaultBasePremises
            theory.presentation.presentation.language free bound
              (.base sort.1) left right →
        normalize left = normalize right) :
    ComputableReflectiveFiberSection theory reflection where
  normalize := normalize
  equivalent := equivalent
  complete := by
    intro free bound sort left right relation
    induction relation with
    | rel left right generator => exact generatorInvariant generator
    | refl term => rfl
    | symm left right relation inductionHypothesis =>
        exact inductionHypothesis.symm
    | trans left middle right first second firstIH secondIH =>
        exact firstIH.trans secondIH

theorem normalize_idempotent {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (canonical : ComputableReflectiveFiberSection theory reflection)
    {free bound sort}
    (term : ReflectiveWellSorted.OpenTerm reflection.1
      theory.presentation.presentation.language free bound sort) :
    canonical.normalize (canonical.normalize term) =
      canonical.normalize term :=
  canonical.complete (canonical.equivalent term)

/-- Reflective-fibre normalization commutes with proof-only transport between
equal free, bound, and sort indices. -/
theorem normalize_reindex {theory : IGSLT}
    {reflection : AdmittedProfile
      theory.presentation.presentation.language}
    (canonical : ComputableReflectiveFiberSection theory reflection)
    {sourceFree targetFree : WellSorted.FreeTypeContext}
    {sourceBound targetBound : List TypeExpr}
    {sourceSort targetSort : LangSort
      theory.presentation.presentation.language}
    (freeEquality : sourceFree = targetFree)
    (boundEquality : sourceBound = targetBound)
    (sortEquality : sourceSort = targetSort)
    (term : ReflectiveWellSorted.OpenTerm reflection.1
      theory.presentation.presentation.language sourceFree sourceBound
        sourceSort) :
    canonical.normalize
        (term.reindex freeEquality boundEquality sortEquality) =
      (canonical.normalize term).reindex freeEquality boundEquality
        sortEquality := by
  cases freeEquality
  cases boundEquality
  cases sortEquality
  rfl

end ComputableReflectiveFiberSection

/-- Contextual laws for a section whose domain is the admitted reflective
fibre. -/
structure ComputableReflectiveFiberContextualSection (theory : IGSLT)
    (reflection : AdmittedProfile
      theory.presentation.presentation.language)
    extends ComputableReflectiveFiberSection theory reflection where
  preservesFreeVariableSupport : ∀ {free bound sort}
      (term : ReflectiveWellSorted.OpenTerm reflection.1
        theory.presentation.presentation.language free bound sort)
      {name : String},
    name ∈ (normalize term).1.freeFvarNames → name ∈ term.1.freeFvarNames
  normalizeRecontextualizeFree :
    ∀ {sourceFree targetFree : WellSorted.FreeTypeContext}
      {bound : List TypeExpr}
      {sort : LangSort theory.presentation.presentation.language}
      (term : ReflectiveWellSorted.OpenTerm reflection.1
        theory.presentation.presentation.language sourceFree bound sort)
      (preserves : ∀ {name freeType},
        name ∈ term.1.freeFvarNames →
        sourceFree name = some freeType →
          targetFree name = some freeType),
    (normalize (term.recontextualizeFree preserves)).1 =
      (normalize term).1
  preservesReflectiveSupport : ∀ {free bound sort}
      (term : ReflectiveWellSorted.OpenTerm reflection.1
        theory.presentation.presentation.language free bound sort)
      (support : ContextSupport.Support) (available : List TypeExpr)
      (binderImage : TypeExpr → TypeExpr),
    term.2.1.1.ReflectiveSupportSafeAt reflection.1 support available
        binderImage →
      (normalize term).2.1.1.ReflectiveSupportSafeAt reflection.1 support
        available binderImage

end Mettapedia.GSLT.LanguageDef
