import Mettapedia.OSLF.Framework.NativeTypeTheory
import Mettapedia.OSLF.Framework.RecursiveNativeType

/-!
# Native types of contextual Walters--Zantema DA reduction

The generated DA `LanguageDef` is the finite table of paper root rules.  Its
standard arithmetic meaning additionally closes those contractions under the
DA constructors.  This module runs OSLF over that contextual relation itself,
rather than silently replacing it by the root-only presentation.

The spatial endpoints below include both exact finite native types for
particular numerals and an indexed least-fixed-point native type for the full
unbounded canonical-numeral language.
-/

namespace Mettapedia.GSLT.LanguageDef.WaltersZantemaDA

open Mettapedia.GSLT
open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.Framework
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis
open Mettapedia.OSLF.Framework.LanguageIndexedModalFunctor
open Mettapedia.OSLF.Framework.DerivedModalities
open Mettapedia.OSLF.Framework.NativeTypeTheory

/-! ## The actual contextual operational GSLT -/

/-- The DA calculus whose one-step relation is closure of the generated paper
rules under exactly the DA constructors.  Equality is the only authored
equation in this typed presentation. -/
def contextualTheory (schema : Schema) : GSLT where
  Term := SemanticTerm
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites := Step schema
  rewrites_resp_left := by
    intro source source' target sourceEq step
    subst source'
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    intro source target target' step targetEq
    subst target'
    exact step

/-- OSLF applied to the actual contextual DA transition relation. -/
def contextualOSLF (schema : Schema) :=
  gsltOSLF (contextualTheory schema)

/-- The behavioral modalities of contextual DA form the OSLF adjunction. -/
theorem contextual_galois (schema : Schema) :
    GaloisConnection
      (gsltDiamond (contextualTheory schema))
      (gsltBox (contextualTheory schema)) :=
  gsltGalois (contextualTheory schema)

/-- Inhabiting the exact-target native type is exactly a contextual DA step. -/
theorem satisfies_exactTarget_iff_step (schema : Schema)
    (source target : SemanticTerm) :
    (contextualOSLF schema).satisfies source
        (exactTargetNativeType (contextualTheory schema) target).pred ↔
      Step schema source target :=
  satisfies_exactTargetNativeType_iff_step
    (contextualTheory schema) source target

/-- Generated one-step native evidence is denotationally sound.  This makes
the behavioral NTT observation consume the actual DA semantics rather than an
independent rule inventory. -/
theorem exactTarget_native_preserves_denotation (schema : Schema)
    {source target : SemanticTerm}
    (inhabited :
      (contextualOSLF schema).satisfies source
        (exactTargetNativeType (contextualTheory schema) target).pred)
    (valuation : String → Nat) :
    source.denote schema valuation = target.denote schema valuation := by
  exact Step.sound ((satisfies_exactTarget_iff_step schema source target).mp inhabited)
    valuation

/-! ## Guest-owned contextual-kernel structure -/

/-- One-hole contexts generated by the DA constructors. -/
inductive Context where
  | hole
  | digit (index : Nat) (inside : Context)
  | addLeft (inside : Context) (right : SemanticTerm)
  | addRight (left : SemanticTerm) (inside : Context)
  | mulLeft (inside : Context) (right : SemanticTerm)
  | mulRight (left : SemanticTerm) (inside : Context)
  | succ (inside : Context)
  | star (index : Nat) (inside : Context)
deriving Repr, DecidableEq

/-- Insert a DA term into a one-hole DA context. -/
def Context.plug : Context → SemanticTerm → SemanticTerm
  | .hole, term => term
  | .digit index inside, term => .digit index (inside.plug term)
  | .addLeft inside right, term => .add (inside.plug term) right
  | .addRight left inside, term => .add left (inside.plug term)
  | .mulLeft inside right, term => .mul (inside.plug term) right
  | .mulRight left inside, term => .mul left (inside.plug term)
  | .succ inside, term => .succ (inside.plug term)
  | .star index inside, term => .star index (inside.plug term)

namespace Context

theorem plug_step (schema : Schema) (context : Context)
    {source target : SemanticTerm} (step : Step schema source target) :
    Step schema (context.plug source) (context.plug target) := by
  induction context with
  | hole => exact step
  | digit index inside inductionHypothesis =>
      exact .digit index inductionHypothesis
  | addLeft inside right inductionHypothesis =>
      exact .addLeft inductionHypothesis
  | addRight left inside inductionHypothesis =>
      exact .addRight inductionHypothesis
  | mulLeft inside right inductionHypothesis =>
      exact .mulLeft inductionHypothesis
  | mulRight left inside inductionHypothesis =>
      exact .mulRight inductionHypothesis
  | succ inside inductionHypothesis =>
      exact .succ inductionHypothesis
  | star index inside inductionHypothesis =>
      exact .star index inductionHypothesis

end Context

/-- Context construction is an earned kernel capability of contextual DA. -/
def contextualClosure (schema : Schema) :
    EffectiveStructure.ContextualClosure
      (contextualTheory schema) Context Context.plug where
  mapEquiv := by
    intro context left right equivalent
    subst right
    rfl
  mapStep := Context.plug_step schema

/-! ## Exact finite spatial native types for numerals -/

/-- Pattern-level edge span obtained by erasing typed contextual DA steps.
Spatial native types use only its carrier; modal native types retain the exact
typed step witness in each edge. -/
def contextualPatternSpan (schema : Schema) : ReductionSpan Pattern where
  Edge := (contextualTheory schema).LabeledStep
  source := fun edge => edge.source.toPattern
  target := fun edge => edge.target.toPattern

/-- Exact finite spatial shape of one least-significant-digit-first numeral. -/
def numeralNativeType : List Nat → NativeType
  | [] => .headed "da:empty" []
  | index :: digits =>
      .headed (digitLabel index) [numeralNativeType digits]

/-- The generated finite spatial type denotes exactly its numeral pattern. -/
theorem satisfies_numeralNativeType_iff (schema : Schema)
    (digits : List Nat) (pattern : Pattern) :
    satisfiesOver (contextualPatternSpan schema)
        (numeralNativeType digits) pattern ↔
      pattern = patternOfDigits digits := by
  induction digits generalizing pattern with
  | nil =>
      constructor
      · rintro ⟨children, shape, childrenEvidence⟩
        cases children with
        | nil =>
            simpa [patternOfDigits, WaltersZantemaDA.empty, a] using shape
        | cons child children =>
            cases childrenEvidence
      · intro shape
        exact ⟨[], by simpa [patternOfDigits, WaltersZantemaDA.empty, a] using shape,
          trivial⟩
  | cons index digits inductionHypothesis =>
      constructor
      · rintro ⟨children, shape, childrenEvidence⟩
        cases children with
        | nil => cases childrenEvidence
        | cons child children =>
            cases children with
            | nil =>
                have childShape := (inductionHypothesis child).mp childrenEvidence.1
                simpa [patternOfDigits, WaltersZantemaDA.digit, a, childShape] using shape
            | cons next children =>
                cases childrenEvidence.2
      · intro shape
        refine ⟨[patternOfDigits digits], ?_, ?_⟩
        · simpa [patternOfDigits, WaltersZantemaDA.digit, a] using shape
        · exact ⟨(inductionHypothesis _).mpr rfl, trivial⟩

/-- Exact finite native shape of the canonical encoding of one natural. -/
def encodedNumeralNativeType (schema : Schema) (number : Nat) : NativeType :=
  numeralNativeType (encodeDigits schema number)

theorem satisfies_encodedNumeralNativeType_iff (schema : Schema)
    (number : Nat) (pattern : Pattern) :
    satisfiesOver (contextualPatternSpan schema)
        (encodedNumeralNativeType schema number) pattern ↔
      pattern = encodePattern schema number := by
  exact satisfies_numeralNativeType_iff schema (encodeDigits schema number) pattern

/-! ## Recursive spatial native type for all canonical numerals -/

namespace CanonicalRecursive

open Mettapedia.OSLF.Framework.RecursiveNativeType

/-- The recursive analysis distinguishes all canonical numerals from the
nonempty canonical numerals used beneath an outer digit. -/
inductive State where
  | canonical
  | positive
deriving Repr, DecidableEq

/-- Branches of the canonical-numeral polynomial.  Digit bounds and the
nonzero most-significant base digit are part of the branch evidence. -/
inductive Branch (schema : Schema) where
  | canonicalEmpty
  | canonicalBase (digit : Fin schema.radix) (nonzero : digit.val ≠ 0)
  | canonicalCons (digit : Fin schema.radix)
  | positiveBase (digit : Fin schema.radix) (nonzero : digit.val ≠ 0)
  | positiveCons (digit : Fin schema.radix)

private def emptyNativeType : NativeType := .headed "da:empty" []

def describe (schema : Schema) : Branch schema → BranchDescription State
  | .canonicalEmpty => ⟨.canonical, "da:empty", []⟩
  | .canonicalBase digit _ =>
      ⟨.canonical, digitLabel digit.val, [.native emptyNativeType]⟩
  | .canonicalCons digit =>
      ⟨.canonical, digitLabel digit.val, [.recur .positive]⟩
  | .positiveBase digit _ =>
      ⟨.positive, digitLabel digit.val, [.native emptyNativeType]⟩
  | .positiveCons digit =>
      ⟨.positive, digitLabel digit.val, [.recur .positive]⟩

/-- The recursive type is indexed over constructors witnessed in the actual
generated DA presentation. -/
def signature (schema : Schema) : Signature State where
  language := language schema
  Branch := Branch schema
  describe := describe schema
  declared := by
    intro branch
    cases branch with
    | canonicalEmpty => exact empty_constructor_declared schema
    | canonicalBase digit nonzero =>
        exact digit_constructor_declared schema digit.isLt
    | canonicalCons digit =>
        exact digit_constructor_declared schema digit.isLt
    | positiveBase digit nonzero =>
        exact digit_constructor_declared schema digit.isLt
    | positiveCons digit =>
        exact digit_constructor_declared schema digit.isLt

abbrev Inhabits (schema : Schema) (state : State) (pattern : Pattern) : Prop :=
  Satisfies (contextualPatternSpan schema) (signature schema) state pattern

/-- Guest-owned interpretation used to identify the least fixed point. -/
def Meaning (schema : Schema) : State → Pattern → Prop
  | .canonical, pattern =>
      ∃ digits, CanonicalDigits schema digits ∧ pattern = patternOfDigits digits
  | .positive, pattern =>
      ∃ digits, digits ≠ [] ∧ CanonicalDigits schema digits ∧
        pattern = patternOfDigits digits

private theorem empty_native_iff (schema : Schema) (pattern : Pattern) :
    satisfiesOver (contextualPatternSpan schema) emptyNativeType pattern ↔
      pattern = empty := by
  simpa [emptyNativeType, numeralNativeType, patternOfDigits] using
    satisfies_numeralNativeType_iff schema [] pattern

private theorem cons_canonical (schema : Schema) {digit : Nat} {digits : List Nat}
    (digitRange : digit < schema.radix)
    (tailCanonical : CanonicalDigits schema digits)
    (tailNonempty : digits ≠ []) :
    CanonicalDigits schema (digit :: digits) := by
  constructor
  · intro value member
    rcases List.mem_cons.mp member with rfl | member
    · exact digitRange
    · exact tailCanonical.1 value member
  · intro nonempty
    simpa only [List.getLast_cons tailNonempty] using tailCanonical.2 tailNonempty

private theorem canonical_tail (schema : Schema) {digit : Nat} {digits : List Nat}
    (canonical : CanonicalDigits schema (digit :: digits))
    (tailNonempty : digits ≠ []) :
    CanonicalDigits schema digits := by
  constructor
  · intro value member
    exact canonical.1 value (List.mem_cons_of_mem digit member)
  · intro nonempty
    simpa only [List.getLast_cons tailNonempty] using
      canonical.2 (List.cons_ne_nil digit digits)

private theorem positive_of_canonical (schema : Schema) {digits : List Nat}
    (nonempty : digits ≠ []) (canonical : CanonicalDigits schema digits) :
    Inhabits schema .positive (patternOfDigits digits) := by
  induction digits with
  | nil => contradiction
  | cons digit digits inductionHypothesis =>
      have digitRange : digit < schema.radix :=
        canonical.1 digit (List.mem_cons_self)
      by_cases tailNonempty : digits ≠ []
      · exact Satisfies.intro (signature := signature schema)
          (Branch.positiveCons ⟨digit, digitRange⟩)
          [patternOfDigits digits] rfl
          (.recur
            (inductionHypothesis tailNonempty
              (canonical_tail schema canonical tailNonempty))
            .nil)
      · have tailEmpty : digits = [] := not_ne_iff.mp tailNonempty
        subst digits
        have digitNonzero : digit ≠ 0 := by
          simpa using canonical.2 (List.cons_ne_nil digit [])
        exact Satisfies.intro (signature := signature schema)
          (Branch.positiveBase ⟨digit, digitRange⟩ digitNonzero)
          [empty] rfl (.native ((empty_native_iff schema empty).2 rfl) .nil)

private theorem canonical_inhabited (schema : Schema) {digits : List Nat}
    (canonical : CanonicalDigits schema digits) :
    Inhabits schema .canonical (patternOfDigits digits) := by
  cases digits with
  | nil =>
      exact Satisfies.intro (signature := signature schema)
        Branch.canonicalEmpty [] rfl .nil
  | cons digit digits =>
      have digitRange : digit < schema.radix :=
        canonical.1 digit (List.mem_cons_self)
      by_cases tailNonempty : digits ≠ []
      · exact Satisfies.intro (signature := signature schema)
          (Branch.canonicalCons ⟨digit, digitRange⟩)
          [patternOfDigits digits] rfl
          (.recur
            (positive_of_canonical schema tailNonempty
              (canonical_tail schema canonical tailNonempty))
            .nil)
      · have tailEmpty : digits = [] := not_ne_iff.mp tailNonempty
        subst digits
        have digitNonzero : digit ≠ 0 := by
          simpa using canonical.2 (List.cons_ne_nil digit [])
        exact Satisfies.intro (signature := signature schema)
          (Branch.canonicalBase ⟨digit, digitRange⟩ digitNonzero)
          [empty] rfl (.native ((empty_native_iff schema empty).2 rfl) .nil)

private theorem meaning_closed (schema : Schema) :
    Closed (contextualPatternSpan schema) (signature schema) (Meaning schema) := by
  intro state pattern evidence
  rcases evidence with ⟨branch, output, children, shape, childrenEvidence⟩
  cases branch with
  | canonicalEmpty =>
      cases children with
      | nil =>
          change State.canonical = state at output
          subst state
          refine ⟨[], ?_, ?_⟩
          · exact ⟨by simp, by simp⟩
          · simpa [signature, describe, patternOfDigits,
              WaltersZantemaDA.empty, WaltersZantemaDA.a] using shape
      | cons child children =>
          simp [signature, describe, layerAll] at childrenEvidence
  | canonicalBase digit nonzero =>
      cases children with
      | nil => simp [signature, describe, layerAll] at childrenEvidence
      | cons child children =>
          cases children with
          | nil =>
              change State.canonical = state at output
              subst state
              change satisfiesOver (contextualPatternSpan schema)
                emptyNativeType child ∧ True at childrenEvidence
              have childEmpty := (empty_native_iff schema child).1 childrenEvidence.1
              refine ⟨[digit.val], ?_, ?_⟩
              · simp [CanonicalDigits, digit.isLt, nonzero]
              · subst child
                simpa [signature, describe, patternOfDigits,
                  WaltersZantemaDA.digit, WaltersZantemaDA.empty,
                  WaltersZantemaDA.a] using shape
          | cons next rest =>
              simp [signature, describe, layerAll] at childrenEvidence
  | canonicalCons digit =>
      cases children with
      | nil => simp [signature, describe, layerAll] at childrenEvidence
      | cons child children =>
          cases children with
          | nil =>
              change State.canonical = state at output
              subst state
              change Meaning schema .positive child ∧ True at childrenEvidence
              rcases childrenEvidence.1 with
                ⟨digits, digitsNonempty, digitsCanonical, childShape⟩
              refine ⟨digit.val :: digits, ?_, ?_⟩
              · exact cons_canonical schema digit.isLt digitsCanonical digitsNonempty
              · rw [childShape] at shape
                simpa [signature, describe, patternOfDigits,
                  WaltersZantemaDA.digit, WaltersZantemaDA.empty,
                  WaltersZantemaDA.a] using shape
          | cons next rest =>
              simp [signature, describe, layerAll] at childrenEvidence
  | positiveBase digit nonzero =>
      cases children with
      | nil => simp [signature, describe, layerAll] at childrenEvidence
      | cons child children =>
          cases children with
          | nil =>
              change State.positive = state at output
              subst state
              change satisfiesOver (contextualPatternSpan schema)
                emptyNativeType child ∧ True at childrenEvidence
              have childEmpty := (empty_native_iff schema child).1 childrenEvidence.1
              refine ⟨[digit.val], by simp, ?_, ?_⟩
              · simp [CanonicalDigits, digit.isLt, nonzero]
              · subst child
                simpa [signature, describe, patternOfDigits,
                  WaltersZantemaDA.digit, WaltersZantemaDA.empty,
                  WaltersZantemaDA.a] using shape
          | cons next rest =>
              simp [signature, describe, layerAll] at childrenEvidence
  | positiveCons digit =>
      cases children with
      | nil => simp [signature, describe, layerAll] at childrenEvidence
      | cons child children =>
          cases children with
          | nil =>
              change State.positive = state at output
              subst state
              change Meaning schema .positive child ∧ True at childrenEvidence
              rcases childrenEvidence.1 with
                ⟨digits, digitsNonempty, digitsCanonical, childShape⟩
              refine ⟨digit.val :: digits, by simp, ?_, ?_⟩
              · exact cons_canonical schema digit.isLt digitsCanonical digitsNonempty
              · rw [childShape] at shape
                simpa [signature, describe, patternOfDigits,
                  WaltersZantemaDA.digit, WaltersZantemaDA.empty,
                  WaltersZantemaDA.a] using shape
          | cons next rest =>
              simp [signature, describe, layerAll] at childrenEvidence

/-- The NTT-derived least fixed point is exactly the authored canonical
numeral invariant, not merely a finite constructor inventory. -/
theorem inhabits_canonical_iff (schema : Schema) (pattern : Pattern) :
    Inhabits schema .canonical pattern ↔
      ∃ digits, CanonicalDigits schema digits ∧ pattern = patternOfDigits digits := by
  constructor
  · intro evidence
    exact evidence.least (meaning_closed schema)
  · rintro ⟨digits, canonical, rfl⟩
    exact canonical_inhabited schema canonical

/-- The auxiliary recursive state is exactly the nonempty canonical fibre. -/
theorem inhabits_positive_iff (schema : Schema) (pattern : Pattern) :
    Inhabits schema .positive pattern ↔
      ∃ digits, digits ≠ [] ∧ CanonicalDigits schema digits ∧
        pattern = patternOfDigits digits := by
  constructor
  · intro evidence
    exact evidence.least (meaning_closed schema)
  · rintro ⟨digits, nonempty, canonical, rfl⟩
    exact positive_of_canonical schema nonempty canonical

/-- Every encoded natural inhabits the recursive canonical spatial type. -/
theorem encodePattern_inhabits_canonical (schema : Schema) (number : Nat) :
    Inhabits schema .canonical (encodePattern schema number) := by
  apply (inhabits_canonical_iff schema _).2
  exact ⟨encodeDigits schema number, encodeDigits_canonical schema number, rfl⟩

/-- A non-numeral constructor is rejected by the recursive spatial type. -/
theorem add_not_inhabits_canonical (schema : Schema) :
    ¬ Inhabits schema .canonical (add empty empty) := by
  intro evidence
  rcases (inhabits_canonical_iff schema _).1 evidence with
    ⟨digits, canonical, equal⟩
  cases digits with
  | nil => simp [add, a, patternOfDigits, empty] at equal
  | cons digit digits =>
      simp [add, a, patternOfDigits, WaltersZantemaDA.digit, digitLabel] at equal

end CanonicalRecursive

/-! ## Behavioral controls over the actual contextual relation -/

private def binaryCarrySource : SemanticTerm :=
  .add (.digit 1 .empty) (.digit 1 .empty)

private def binaryCarryTarget : SemanticTerm :=
  .digit 0 (.succ (.add .empty .empty))

private def droppedCarryTarget : SemanticTerm :=
  .digit 0 (.add .empty .empty)

/-- The generated exact-target native type observes the actual paper carry. -/
theorem radixTwo_carry_inhabits_exactTarget :
    (contextualOSLF radixTwo).satisfies binaryCarrySource
      (exactTargetNativeType
        (contextualTheory radixTwo) binaryCarryTarget).pred := by
  rw [satisfies_exactTarget_iff_step]
  exact .root radixTwo_one_plus_one_root

/-- The same native observation rejects a dropped-carry mutation. -/
theorem radixTwo_droppedCarry_not_inhabited :
    ¬ (contextualOSLF radixTwo).satisfies binaryCarrySource
      (exactTargetNativeType
        (contextualTheory radixTwo) droppedCarryTarget).pred := by
  intro inhabited
  have denotation := exactTarget_native_preserves_denotation radixTwo inhabited
    (fun _ => 0)
  norm_num [binaryCarrySource, droppedCarryTarget, SemanticTerm.denote,
    radixTwo] at denotation

