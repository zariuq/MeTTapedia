import Mettapedia.GSLT.LanguageDef.TheoryGraphModels
import Mettapedia.TypeTheory.CwfSimpleDependentInstitution

/-!
# Canary: models over theories, transported and not transported

Controls for the satisfying-model fibration, on the global-point institutions
of the simple and dependent families CwFs.

* Positive: the global point selecting `false` satisfies the direct image of
  the simple theory generated by the unit type, and its reduct along the
  constant-family route is the simple global point selecting `false`; the
  reduct is a morphism of the total category over the route.
* Obstruction: along the arrow that adds the varying family as an axiom, the
  global point selecting `true` satisfies the source theory but is the reduct
  of no model of the target theory.  Models reduce; they do not expand, so no
  covariant transport of models along theory arrows exists.
* Forgetting: two distinct satisfying models have the same theory node.
* Theory versus model: a model satisfies a sentence its theory does not
  contain.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.LanguageDef.TheoryGraphModelsCanary

open _root_.CategoryTheory
open Mettapedia.GSLT.LanguageDef.NIKMetalogic
open Mettapedia.GSLT.LanguageDef.TheoryGraphModels
open Mettapedia.Logic
open Mettapedia.GSLT.Core.ContextualLadder
open Mettapedia.TypeTheory.CwfInhabitationInstitution
open Mettapedia.TypeTheory.CwfSimpleDependentInstitution

/-! ## Nodes -/

/-- The simple theory generated by the unit type at the Boolean context. -/
def simpleUnitNode : Node :=
  Node.mk' simpleInstitutionObject.{0}
    (PiInstitution.generatedTheory _ simpleBoolContext {PUnit})

/-- The direct image of that theory along the constant-family route. -/
def dependentUnitNode : Node :=
  Node.mk' dependentInstitutionObject.{0}
    (TheoryGraph.directImage (InstitutionConsequence.comorphismProjection simpleDependentRoute)
      simpleUnitNode.theory)

/-- The canonical arrow into the direct image. -/
def inclusion : simpleUnitNode ⟶ dependentUnitNode where
  base := simpleDependentRoute
  fiber := 𝟙 _

/-- The theory generated by no axioms at the Boolean context. -/
def emptyNode : Node :=
  Node.mk' dependentInstitutionObject.{0}
    (PiInstitution.generatedTheory _ boolContext ∅)

/-- The theory generated by the varying family at the Boolean context. -/
def varyingNode : Node :=
  Node.mk' dependentInstitutionObject.{0}
    (PiInstitution.generatedTheory _ boolContext {varyingBoolFamily})

/-- Strengthening the empty theory by the varying family, over the identity
comorphism. -/
def strengthen : emptyNode ⟶ varyingNode :=
  Node.Hom.mk (𝟙 _) (𝟙 boolContext) (by
    intro formula valid model _
    have satisfiesFormula : dependentInstitution.satisfies boolContext model formula :=
      valid model (fun _ premise => absurd premise (Set.notMem_empty _))
    exact satisfiesFormula)

/-! ## Positive transport -/

/-- The global point selecting `false` satisfies the direct-image theory. -/
theorem falseGlobal_satisfies : Satisfies dependentUnitNode falseGlobal := by
  refine (satisfies_generated_iff dependentInstitutionObject.{0} boolContext _ falseGlobal).2 ?_
  rintro _ ⟨formula, entailed, rfl⟩
  refine (satisfaction_iff simpleBoolContext falseGlobal formula).2 ?_
  refine entailed _ ?_
  intro premise premiseMember
  have equal : premise = PUnit := premiseMember
  subst equal
  exact ⟨fun _ => PUnit.unit⟩

/-- The satisfying model selecting `false`. -/
def falseModel : Model dependentUnitNode :=
  ⟨falseGlobal, falseGlobal_satisfies⟩

/-- Its reduct along the route is the simple global point selecting `false`. -/
theorem reduct_falseModel :
    ((reduct inclusion).obj falseModel).obj = Discrete.mk (fun _ => false) :=
  rfl

/-- The reduct as a morphism of the total category, the cartesian lift of the
route. -/
def transportedFalse :
    SatisfyingModel.mk' simpleUnitNode ((reduct inclusion).obj falseModel) ⟶
      SatisfyingModel.mk' dependentUnitNode falseModel :=
  transport inclusion falseModel

theorem transportedFalse_base : transportedFalse.base = inclusion :=
  rfl

/-! ## No expansion -/

/-- The global point selecting `true` satisfies the empty theory. -/
def trueModel : Model emptyNode :=
  ⟨trueGlobal, fun _ valid => valid trueGlobal (fun _ premise => absurd premise (Set.notMem_empty _))⟩

/-- Models reduce but do not expand: no model of the strengthened theory
reduces to the point selecting `true`, because every such model satisfies the
varying family and that point does not. -/
theorem no_expansion :
    ¬ ∃ model : Model varyingNode, ((reduct strengthen).obj model).obj = trueGlobal := by
  rintro ⟨model, reduced⟩
  have satisfiesVarying : dependentInstitution.satisfies boolContext model.obj varyingBoolFamily :=
    model.property varyingBoolFamily
      (((InstitutionConsequence.consequenceProjection dependentInstitution).consequence
        boolContext).le_closure _ (Set.mem_singleton _))
  have equal : model.obj = trueGlobal := reduced
  rw [equal] at satisfiesVarying
  exact varying_not_satisfied_at_true satisfiesVarying

/-! ## Forgetting models loses information -/

/-- The global point selecting `false` also satisfies the empty theory. -/
def falseEmptyModel : Model emptyNode :=
  ⟨falseGlobal, fun _ valid => valid falseGlobal (fun _ premise => absurd premise (Set.notMem_empty _))⟩

/-- The two points are distinct: one satisfies the varying family, the other
does not. -/
theorem falseGlobal_ne_trueGlobal : falseGlobal ≠ trueGlobal := by
  intro equal
  exact varying_not_satisfied_at_true (equal ▸ varying_satisfied_at_false)

/-- Two distinct satisfying models project to the same theory node. -/
theorem forgetting_models_loses_information :
    toNode.obj (SatisfyingModel.mk' emptyNode falseEmptyModel) =
        toNode.obj (SatisfyingModel.mk' emptyNode trueModel) ∧
      SatisfyingModel.mk' emptyNode falseEmptyModel ≠ SatisfyingModel.mk' emptyNode trueModel := by
  refine ⟨rfl, ?_⟩
  intro equal
  have fibres : falseEmptyModel = trueModel := by
    have equal' : (⟨emptyNode, falseEmptyModel⟩ : SatisfyingModel) =
        ⟨emptyNode, trueModel⟩ := equal
    exact eq_of_heq (Pseudofunctor.CoGrothendieck.mk.inj equal').2
  exact falseGlobal_ne_trueGlobal (congrArg ObjectProperty.FullSubcategory.obj fibres)

/-! ## A theory is not one of its models -/

/-- A model satisfies a sentence that its theory does not prove: the point
selecting `false` satisfies the varying family, which the empty theory does
not contain because the point selecting `true` refutes it. -/
theorem model_exceeds_theory :
    dependentInstitution.satisfies boolContext falseGlobal varyingBoolFamily ∧
      varyingBoolFamily ∉ emptyNode.theory.theory.1 :=
  ⟨varying_satisfied_at_false, fun valid =>
    varying_not_satisfied_at_true
      (valid trueGlobal (fun _ premise => absurd premise (Set.notMem_empty _)))⟩

#print axioms reduct_falseModel
#print axioms transportedFalse
#print axioms no_expansion
#print axioms forgetting_models_loses_information
#print axioms model_exceeds_theory

end Mettapedia.GSLT.LanguageDef.TheoryGraphModelsCanary
