theorem sexp_id_ne_of_ne_tc {a b : String} (h : a ≠ b) (as bs : List AST) :
    AST.sexp (Label.id a) as ≠ AST.sexp (Label.id b) bs := by
  intro hterm
  injection hterm with hlabel _
  injection hlabel with hstr
