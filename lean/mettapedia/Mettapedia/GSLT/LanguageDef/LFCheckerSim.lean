theorem atom_lpar_first_active_shiftable_raw_of_term_first_active_tc (fuel : Nat)
    (ctx : List String) (rest : List LF.Tok)
    (hfirst : FirstActiveMatchesParseShiftableRawTC (LF.pTerm fuel ctx rest)
