  | some pr =>
      rcases pr with ⟨a, rest⟩
      rw [hatom] at h
      rcases h with ⟨u, rfl, hu⟩
      have hstep :
          eval pTC 1
            (apmK (peano fuel) (Mettapedia.GSLT.LanguageDef.LFResolveSim.encCtx ctx)
              accAst (Mettapedia.GSLT.LanguageDef.LFEngineCorr.encToks toks)
