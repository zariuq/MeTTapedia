    typeS, kindS, iName, nProp, nNat, nA, nB, nZ, nPrf, nImp, nEqn, nRfl, nHImpAB,
    nHA, nMpAB, iPropT, iNatT, iA, iB, iZ, iPrf, iImp, iEqn, iImpAB, checkBad,
