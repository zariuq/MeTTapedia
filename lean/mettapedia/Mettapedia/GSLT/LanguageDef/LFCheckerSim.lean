      | lam A body =>
          simp [encTyCore?] at hfenc
          cases hA : encTyCore? A with
          | none => simp [hA] at hfenc
          | some AAst =>
              cases hbody : encTyCore? body with
              | none => simp [hA, hbody] at hfenc
              | some bodyAst =>
                  simp [hA, hbody] at hfenc
                  subst fVal
