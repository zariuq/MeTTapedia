    match LF.recognize 64 toks with
    | none =>
        ∃ e, eval pTC N
          (lfcheckK A (lfrec (Mettapedia.GSLT.LanguageDef.LFEngineCorr.encToks toks))) =
            lfcheckK A (Err e)
    | some t =>
        eval pTC N
          (lfcheckK A (lfrec (Mettapedia.GSLT.LanguageDef.LFEngineCorr.encToks toks))) =
            lfcheckK A (Ok (encTerm t))

