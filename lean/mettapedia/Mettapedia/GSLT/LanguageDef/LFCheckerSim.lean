  have hnext : FirstStrongNF resTerm resVal (nfApp1 fuel aenc (nfT fuel fraw)) := by
    exact FirstLiftableNF.toStrong
      (nfApp1_nfT_first_liftable (fTerm := fTerm) (resTerm := resTerm)
