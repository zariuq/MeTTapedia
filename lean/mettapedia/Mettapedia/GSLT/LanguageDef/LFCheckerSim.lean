          rfl
  | pi T U ihT ihU =>
      intro A h
      simp [encTyCore?] at h
      cases hT : encTyCore? T with
      | none => simp [hT] at h
      | some T' =>
          cases hU : encTyCore? U with
          | none => simp [hT, hU] at h
          | some U' =>
