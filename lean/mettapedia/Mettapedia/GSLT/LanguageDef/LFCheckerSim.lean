      (∀ k : Nat, ReplayablePayload (liftStack cs (Var (addN (peano k) (S Z))))
        (lfLiftStack cs (.var (k + 1)))))
    (b idx : Nat) :
    ReplayablePayload
      (liftStack cs (liftVarT (S Z) (peano b) (peano idx) (con0 "tt")))
