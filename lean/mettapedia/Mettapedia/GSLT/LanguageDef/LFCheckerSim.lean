  | lam T b ihT ihb =>
      intro A h
      simp [encTyCore?] at h
      cases hT : encTyCore? T with
      | none => simp [hT] at h
      | some T' =>
          cases hb : encTyCore? b with
          | none => simp [hT, hb] at h
          | some b' =>
              simp [hT, hb] at h
              subst A
