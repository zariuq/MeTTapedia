      refine FirstPayloadNF.intro (payload := Lam Aval bpre) (N := MA + (MBctx + 1))
        (M := MPayload) ?_ ?_ hMPayload
      · have hafterB : eval pTC (MA + MBctx) (nfLam2 Apre (nfT fuel b)) =
            nfLam2 Aval (someT bpre) := by
