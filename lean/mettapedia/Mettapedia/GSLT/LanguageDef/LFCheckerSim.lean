          (peano fuel) (Mettapedia.GSLT.LanguageDef.LFResolveSim.encCtx ctx)
          (PErr e))
  | some pr =>
      rcases pr with ⟨t, rest'⟩
      rw [hterm] at h
      rcases h with ⟨u, rfl, hu⟩
      cases rest' with
      | nil =>
          rw [show LF.pAtom (fuel + 1) ctx (.lpar :: rest) = none by
            simp [LF.pAtom, hterm]]
