def binderShiftStackTC (cs : List Nat) : List Nat :=
  cs.map Nat.succ

theorem lfShiftStack_app_tc :
    ∀ (cs : List Nat) (f a : LF.Term),
      lfShiftStackTC cs (.app f a) =
        .app (lfShiftStackTC cs f) (lfShiftStackTC cs a) := by
  intro cs
