  have hstep : eval pTC 1 (nfT (S fuel) (substT j sAst (App f a))) =
      nfT (S fuel) (App (substT j sAst f) (substT j sAst a)) := by
    simp only [eval,
      hcong_nfT_s_substT_arg_tc fuel j sAst (App f a)
        (App (substT j sAst f) (substT j sAst a))
