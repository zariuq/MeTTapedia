theorem target_fuel_boundary_checkerFuel_encTyCore?_eq_some_encTy :
    encTyCore? (LFTyping.nf LFTyping.corpusSig checkerFuel targetFuelBoundarySpec) =
      some (encTy targetFuelBoundarySpec) := by
