    · simpa [hlt] using henc
    · have hguard' : eval pTC Nguard
          (liftStack cs
            (liftVarT (S Z) (peano cutoff) (peano idx) (ltT (peano a) (peano b)))) =
          liftStack cs (Var (peano idx)) := by
        simpa [hlt] using hguard
