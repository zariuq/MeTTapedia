        simp [hx]
      have hrep := stackReplayablePayload_con_tc henc
      exact FirstReplayNF.intro (payload := Con k) (N := 1) (M := 0)
        henc
        (by simpa [lookupBody_corpusSig_none] using nfT_con_tc fuel k)
