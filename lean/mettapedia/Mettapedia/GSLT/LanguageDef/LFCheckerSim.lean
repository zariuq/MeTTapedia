theorem eqT_self_bool_first_tc (A : AST) :
    ∃ N v, MatchesBool true v ∧ eval pTC N (eqT A A) = v ∧
      ∀ k, k < N -> VerdictChildOpen (eval pTC k (eqT A A)) := by
