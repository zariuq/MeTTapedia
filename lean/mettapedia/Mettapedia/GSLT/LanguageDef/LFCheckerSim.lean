  rfl

theorem os_shv_tt_tc (c k : AST) :
    oneStep pTC (shiftVar c k (con0 "tt")) = some (Var k) := by
  apply oneStep_pTC_of_baseReducts_pLF_cons
  rfl

theorem os_shv_ff_tc (c k : AST) :
    oneStep pTC (shiftVar c k (con0 "ff")) = some (Var (S k)) := by
