          have hguardTail : ∀ k, k < n -> VerdictChildOpen (eval pTC k s') := by
            intro k hk
            have hkSucc : Nat.succ k < Nat.succ n := Nat.succ_lt_succ hk
            have hone : eval pTC 1 s = s' := by
