      (by intro c; rfl)
      (by intro fuel; exact nfT_srt_first_strong fuel .type)
  · exact stackReplayablePayload_srt_atom_tc .kind (Srt kindS) rfl
      (by intro c; rfl)
      (by intro fuel; exact nfT_srt_first_strong fuel .kind)

