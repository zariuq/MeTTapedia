theorem replayablePayload_liftVarT_guard_addN_one_tc :
    ∀ (k b cutoff idx : Nat),
      ReplayablePayload
        (liftVarT (S Z) (peano cutoff) (peano idx)
          (ltT (addN (peano k) (S Z)) (peano b)))
        (if k + 1 < b then .var idx else .var (idx + 1)) := by
  intro k
  induction k with
  | zero =>
      intro b cutoff idx
