def ReplayablePayload (u : AST) (t : LF.Term) : Prop :=
  LiftablePayload u t ∧
    ∀ fuelNat : Nat, ∃ v,
      FirstStrongNF (LFTyping.nf LFTyping.corpusSig fuelNat t) v
        (nfT (peano fuelNat) u)

def StackReplayablePayload (u : AST) (t : LF.Term) : Prop :=
