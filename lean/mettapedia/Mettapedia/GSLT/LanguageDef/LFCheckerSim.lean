          (fun s s' hstep =>
            hcong_nfT_s_liftStack_substVarLT2_lt_tc cs (peano fuelNat)
              (peano j) (peano k) (peano j) (peano k)
              (isnormal_peano_tc fuelNat) (isnormal_peano_tc j) s s' hstep)
