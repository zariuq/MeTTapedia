      | some tAst =>
          have hfirst := hinternSome t raw tAst hraw ht
          obtain ⟨Nintern, hNintern⟩ := lfcheckI_intern_success_to_checkT hAcore hfirst
          obtain ⟨Ncheck, hNcheck⟩ := hcheckT t A_spec tAst A ht hA
          refine ⟨Nintern + Ncheck, ?_⟩
          have htotal :
