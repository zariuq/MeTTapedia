import Mettapedia.GSLT.LanguageDef.BagNormalForm
import Mettapedia.GSLT.LanguageDef.WellSortedFillInversion

/-!
# Sorting is preserved by the laws of a bag theory

The static equivalence of a bag theory is generated by bag laws applied in
contexts.  This module shows that one such step, read from left to right,
takes a sorted object pattern with canonical binder metadata to another one of
the same type.

Two facts carry it.  Typing can be read off at the hole of a context and put
back around a replacement of the same type (`hasType_fill_replace`).  And each
bag law keeps the type of the bag it rewrites (`derived_hasType`): in a bag
theory a bag node at a type that mentions no collection is typed by the one
bag constructor, so its components all have the bag's sort.

Only the forward reading of the laws is used.  The backward reading of the
singleton law would wrap a subterm in a bag wherever it stands, which is
sorted only where the bag's sort is expected.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.LanguageDef.BagNormalForm

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.PatternCode
open Mettapedia.OSLF.MeTTaIL.ContextualStep
open Mettapedia.OSLF.MeTTaIL.DerivedContexts
open Mettapedia.OSLF.Framework.ConstructorCategory
open Mettapedia.GSLT.LanguageDef.EquationSemantics
open Mettapedia.GSLT.LanguageDef.WellSorted

variable {language : LanguageDef} {bag : GrammarRule} {unit : Option String}

/-! ## Lists read pointwise -/

/-- Element typing is pointwise. -/
theorem elementsHaveType_iff {free : FreeTypeContext} {bound : List TypeExpr}
    {elements : List Pattern} {elementType : TypeExpr} :
    ElementsHaveType language free bound elements elementType ↔
      ∀ element ∈ elements, HasType language free bound element elementType := by
  constructor
  · intro typed
    induction elements with
    | nil => intro element membership; cases membership
    | cons head tail recurse =>
        cases typed with
        | cons headTyped tailTyped =>
            intro element membership
            rcases List.mem_cons.mp membership with rfl | inTail
            · exact headTyped
            · exact recurse tailTyped element inTail
  · intro pointwise
    induction elements with
    | nil => exact .nil _ _
    | cons head tail recurse =>
        exact .cons (pointwise head (by simp))
          (recurse fun element membership => pointwise element (by simp [membership]))

/-- The object-pattern test on a list is pointwise. -/
theorem isObjectPatternList_iff {patterns : List Pattern} :
    isObjectPatternList patterns = true ↔
      ∀ pattern ∈ patterns, isObjectPattern pattern = true := by
  induction patterns with
  | nil => simp [isObjectPatternList]
  | cons pattern patterns recurse => simp [isObjectPatternList, recurse]

/-- The binder-metadata test on a list is pointwise. -/
theorem hasCanonicalBinderMetadataList_iff {patterns : List Pattern} :
    Pattern.hasCanonicalBinderMetadataList patterns = true ↔
      ∀ pattern ∈ patterns, pattern.hasCanonicalBinderMetadata = true := by
  induction patterns with
  | nil => simp [Pattern.hasCanonicalBinderMetadataList]
  | cons pattern patterns recurse =>
      simp [Pattern.hasCanonicalBinderMetadataList, recurse]

/-! ## Admissible patterns -/

/-- A pattern sorted at a type, with no pending substitution or open
collection tail, and with canonical binder metadata. -/
structure Admissible (language : LanguageDef) (free : FreeTypeContext)
    (bound : List TypeExpr) (type : TypeExpr) (pattern : Pattern) : Prop where
  typed : HasType language free bound pattern type
  canonical : pattern.hasCanonicalBinderMetadata = true
  object : isObjectPattern pattern = true

/-- The expected type of a parameter whose declared type mentions no
collection mentions none. -/
theorem collectionFree_parameterType {parameter : TermParam} {expected : TypeExpr}
    (free : collectionFree (TermParam.typeExpr parameter) = true)
    (expectedType : parameterType? parameter = some expected) :
    collectionFree expected = true := by
  cases parameter with
  | simple name type =>
      simp only [parameterType?, Option.some.injEq] at expectedType
      subst expectedType
      exact free
  | abstractionNamed binder body type =>
      cases type with
      | base sort =>
          simp only [parameterType?, Option.some.injEq] at expectedType
          subst expectedType
          rfl
      | arrow domain codomain =>
          simp only [parameterType?, Option.some.injEq] at expectedType
          subst expectedType
          exact free
      | multiBinder inner => simp [parameterType?] at expectedType
      | collection kind element => simp [parameterType?] at expectedType
  | multiAbstractionNamed binders body type =>
      cases type with
      | base sort =>
          simp only [parameterType?, Option.some.injEq] at expectedType
          subst expectedType
          rfl
      | arrow domain codomain =>
          cases domain with
          | multiBinder inner =>
              simp only [parameterType?, Option.some.injEq] at expectedType
              subst expectedType
              exact free
          | base sort => simp [parameterType?] at expectedType
          | arrow first second => simp [parameterType?] at expectedType
          | collection kind element => simp [parameterType?] at expectedType
      | multiBinder inner => simp [parameterType?] at expectedType
      | collection kind element => simp [parameterType?] at expectedType

/-- A bag node sorted at a collection-free type is sorted by the bag
constructor: its type is the bag's sort and its components have that sort. -/
theorem bag_typing (laws : BagTheory language bag unit) {free : FreeTypeContext}
    {bound : List TypeExpr} {kind : CollType} {elements : List Pattern}
    {rest : Option String} {type : TypeExpr}
    (typed : HasType language free bound (.collection kind elements rest) type)
    (collectionless : collectionFree type = true) :
    kind = .hashBag ∧ type = .base bag.category ∧
      ElementsHaveType language free bound elements (.base bag.category) := by
  rcases hasType_collection_inversion typed with
    ⟨elementType, typeEq, -⟩ | ⟨rule, parameterName, elementType, membership, shape,
      typeEq, elementsTyped⟩
  · subst typeEq
    simp [collectionFree] at collectionless
  · obtain ⟨rfl, kindEq, elementEq⟩ :=
      laws.eq_bag_of_collectionParameter membership shape
    subst elementEq
    exact ⟨kindEq, typeEq, elementsTyped⟩

/-- A list of components of the bag's sort is a bag of the bag's sort. -/
theorem bag_hasType (laws : BagTheory language bag unit) {free : FreeTypeContext}
    {bound : List TypeExpr} {elements : List Pattern} {rest : Option String}
    (elementsTyped : ElementsHaveType language free bound elements (.base bag.category)) :
    HasType language free bound (.collection .hashBag elements rest)
      (.base bag.category) := by
  obtain ⟨parameterName, shape⟩ := laws.bagShape
  exact HasType.collectionConstructor laws.bagAuthored shape elementsTyped

/-! ## Typing along a context -/

/-- Whatever parameter representation the first pattern meets, the second
meets. -/
def Represents (first second : Pattern) : Prop :=
  ∀ parameter, MatchesParameterRepresentation parameter first →
    MatchesParameterRepresentation parameter second

/-- A collection node stands only where an ordinary argument is expected, and
there anything may stand. -/
theorem represents_collection (kind : CollType) (elements : List Pattern)
    (rest : Option String) (other : Pattern) :
    Represents (.collection kind elements rest) other := by
  intro parameter matched
  cases parameter <;> simp_all [MatchesParameterRepresentation]

/-- Representation is decided by the outermost node, which a context keeps. -/
theorem represents_fill (context : OneHoleContext) {first second : Pattern}
    (transfer : Represents first second) :
    Represents (context.fill first) (context.fill second) := by
  cases context with
  | hole => exact transfer
  | apply label before inner after =>
      intro parameter matched
      cases parameter <;> simp_all [MatchesParameterRepresentation, OneHoleContext.fill]
  | lambda binder inner =>
      intro parameter matched
      cases parameter <;> cases binder <;>
        simp_all [MatchesParameterRepresentation, OneHoleContext.fill]
  | multiLambda arity binders inner =>
      intro parameter matched
      cases parameter <;> cases binders <;>
        simp_all [MatchesParameterRepresentation, OneHoleContext.fill]
  | substBody inner replacement =>
      intro parameter matched
      cases parameter <;> simp_all [MatchesParameterRepresentation, OneHoleContext.fill]
  | substReplacement body inner =>
      intro parameter matched
      cases parameter <;> simp_all [MatchesParameterRepresentation, OneHoleContext.fill]
  | collection kind before inner after rest =>
      intro parameter matched
      cases parameter <;> simp_all [MatchesParameterRepresentation, OneHoleContext.fill]

/-- Rejoin a typed argument spine around a new middle argument. -/
theorem argumentsHaveTypes_join {free : FreeTypeContext} {bound : List TypeExpr}
    {middle : Pattern} {after : List Pattern} {parameter : TermParam}
    {afterParameters : List TermParam} {expected : TypeExpr}
    (representation : MatchesParameterRepresentation parameter middle)
    (parameterType : parameterType? parameter = some expected)
    (middleTyped : HasType language free bound middle expected)
    (afterTyped : ArgumentsHaveTypes language free bound after afterParameters) :
    ∀ {before : List Pattern} {beforeParameters : List TermParam},
      ArgumentsHaveTypes language free bound before beforeParameters →
        ArgumentsHaveTypes language free bound (before ++ middle :: after)
          (beforeParameters ++ parameter :: afterParameters)
  | [], _, beforeTyped => by
      cases beforeTyped
      exact .cons representation parameterType middleTyped afterTyped
  | head :: tail, _, beforeTyped => by
      cases beforeTyped with
      | cons headRepresentation headType headTyped tailTyped =>
          exact .cons headRepresentation headType headTyped
            (argumentsHaveTypes_join representation parameterType middleTyped afterTyped
              tailTyped)

/-- **Typing at the hole of a context.**  A sorted object pattern of the form
`context.fill original` types `original` at some collection-free type under
the binders of the context, and any replacement of that type that meets the
same parameter representations can be put back. -/
theorem hasType_fill_replace (laws : BagTheory language bag unit)
    {free : FreeTypeContext} :
    ∀ (context : OneHoleContext) {bound : List TypeExpr} {original : Pattern}
      {type : TypeExpr},
      HasType language free bound (context.fill original) type →
      collectionFree type = true →
      isObjectPattern (context.fill original) = true →
      ∃ holeBound holeType, collectionFree holeType = true ∧
        HasType language free holeBound original holeType ∧
        ∀ replacement, Represents original replacement →
          HasType language free holeBound replacement holeType →
          HasType language free bound (context.fill replacement) type := by
  intro context
  induction context with
  | hole =>
      intro bound original type typed collectionless _
      exact ⟨bound, type, collectionless, typed, fun _ _ replaced => replaced⟩
  | apply label before inner after recurse =>
      intro bound original type typed collectionless object
      simp only [OneHoleContext.fill] at typed object
      obtain ⟨rule, membership, labelEq, notBare, typeEq, arguments⟩ :=
        hasType_apply_inversion typed
      obtain ⟨beforeParameters, parameter, afterParameters, expected, parametersEq, -,
          beforeTyped, representation, parameterType, middleTyped, afterTyped⟩ :=
        ArgumentsHaveTypes.append_cons_split arguments
      have ruleNotBag : rule ≠ bag := by
        rintro rfl
        obtain ⟨parameterName, shape⟩ := laws.bagShape
        exact notBare ⟨parameterName, .hashBag, .base _, shape⟩
      have expectedFree : collectionFree expected = true :=
        collectionFree_parameterType
          (laws.otherParameters rule membership ruleNotBag parameter
            (by rw [parametersEq]; simp))
          parameterType
      have objectMiddle : isObjectPattern (inner.fill original) = true := by
        simp only [isObjectPattern] at object
        exact isObjectPatternList_append_cons object
      obtain ⟨holeBound, holeType, holeFree, originalTyped, rebuild⟩ :=
        recurse middleTyped expectedFree objectMiddle
      refine ⟨holeBound, holeType, holeFree, originalTyped, ?_⟩
      intro replacement transfer replacementTyped
      subst typeEq labelEq
      simp only [OneHoleContext.fill]
      apply HasType.constructor membership notBare
      rw [parametersEq]
      exact argumentsHaveTypes_join
        (represents_fill inner transfer parameter representation) parameterType
        (rebuild replacement transfer replacementTyped) afterTyped beforeTyped
  | lambda binder inner recurse =>
      intro bound original type typed collectionless object
      simp only [OneHoleContext.fill] at typed object
      cases typed with
      | @lambda _ _ _ domain codomain bodyTyped =>
          simp only [collectionFree, Bool.and_eq_true] at collectionless
          simp only [isObjectPattern] at object
          obtain ⟨holeBound, holeType, holeFree, originalTyped, rebuild⟩ :=
            recurse bodyTyped collectionless.2 object
          exact ⟨holeBound, holeType, holeFree, originalTyped,
            fun replacement transfer replacementTyped =>
              HasType.lambda (rebuild replacement transfer replacementTyped)⟩
  | multiLambda arity binders inner recurse =>
      intro bound original type typed collectionless object
      simp only [OneHoleContext.fill] at typed object
      cases typed with
      | @multiLambda _ _ _ _ domain codomain bodyTyped =>
          simp only [collectionFree, Bool.and_eq_true] at collectionless
          simp only [isObjectPattern] at object
          obtain ⟨holeBound, holeType, holeFree, originalTyped, rebuild⟩ :=
            recurse bodyTyped collectionless.2 object
          exact ⟨holeBound, holeType, holeFree, originalTyped,
            fun replacement transfer replacementTyped =>
              HasType.multiLambda (rebuild replacement transfer replacementTyped)⟩
  | substBody inner replacement _ =>
      intro bound original type typed collectionless object
      simp [OneHoleContext.fill, isObjectPattern] at object
  | substReplacement body inner _ =>
      intro bound original type typed collectionless object
      simp [OneHoleContext.fill, isObjectPattern] at object
  | collection kind before inner after rest recurse =>
      intro bound original type typed collectionless object
      simp only [OneHoleContext.fill] at typed object
      obtain ⟨rfl, rfl, elementsTyped⟩ := bag_typing laws typed collectionless
      obtain ⟨beforeTyped, middleTyped, afterTyped⟩ :=
        ElementsHaveType.append_cons_split elementsTyped
      have objectMiddle : isObjectPattern (inner.fill original) = true := by
        simp only [isObjectPattern, Bool.and_eq_true] at object
        exact isObjectPatternList_append_cons object.2
      obtain ⟨holeBound, holeType, holeFree, originalTyped, rebuild⟩ :=
        recurse middleTyped rfl objectMiddle
      refine ⟨holeBound, holeType, holeFree, originalTyped, ?_⟩
      intro replacement transfer replacementTyped
      simp only [OneHoleContext.fill]
      apply bag_hasType laws
      apply elementsHaveType_iff.mpr
      intro element membership
      simp only [List.mem_append, List.mem_cons] at membership
      rcases membership with inBefore | rfl | inAfter
      · exact elementsHaveType_iff.mp beforeTyped element inBefore
      · exact rebuild replacement transfer replacementTyped
      · exact elementsHaveType_iff.mp afterTyped element inAfter

/-- The object-pattern test of a filled context depends on the filling only
through its own test. -/
theorem isObjectPattern_fill_replace :
    ∀ (context : OneHoleContext) {original replacement : Pattern},
      isObjectPattern (context.fill original) = true →
      (isObjectPattern original = true → isObjectPattern replacement = true) →
      isObjectPattern (context.fill replacement) = true
  | .hole, _, _, object, transfer => transfer object
  | .apply label before inner after, _, _, object, transfer => by
      simp only [OneHoleContext.fill, isObjectPattern, isObjectPatternList_iff,
        List.mem_append, List.mem_cons] at object ⊢
      rintro pattern (inBefore | rfl | inAfter)
      · exact object pattern (Or.inl inBefore)
      · exact isObjectPattern_fill_replace inner (object _ (Or.inr (Or.inl rfl))) transfer
      · exact object pattern (Or.inr (Or.inr inAfter))
  | .lambda _ inner, _, _, object, transfer => by
      simp only [OneHoleContext.fill, isObjectPattern] at object ⊢
      exact isObjectPattern_fill_replace inner object transfer
  | .multiLambda _ _ inner, _, _, object, transfer => by
      simp only [OneHoleContext.fill, isObjectPattern] at object ⊢
      exact isObjectPattern_fill_replace inner object transfer
  | .substBody inner _, _, _, object, _ => by
      simp [OneHoleContext.fill, isObjectPattern] at object
  | .substReplacement _ inner, _, _, object, _ => by
      simp [OneHoleContext.fill, isObjectPattern] at object
  | .collection kind before inner after rest, _, _, object, transfer => by
      simp only [OneHoleContext.fill, isObjectPattern, Bool.and_eq_true,
        isObjectPatternList_iff, List.mem_append, List.mem_cons] at object ⊢
      refine ⟨object.1, ?_⟩
      rintro pattern (inBefore | rfl | inAfter)
      · exact object.2 pattern (Or.inl inBefore)
      · exact isObjectPattern_fill_replace inner (object.2 _ (Or.inr (Or.inl rfl))) transfer
      · exact object.2 pattern (Or.inr (Or.inr inAfter))

/-- The binder-metadata test of a filled context depends on the filling only
through its own test. -/
theorem hasCanonicalBinderMetadata_fill_replace :
    ∀ (context : OneHoleContext) {original replacement : Pattern},
      (context.fill original).hasCanonicalBinderMetadata = true →
      (original.hasCanonicalBinderMetadata = true →
        replacement.hasCanonicalBinderMetadata = true) →
      (context.fill replacement).hasCanonicalBinderMetadata = true
  | .hole, _, _, canonical, transfer => transfer canonical
  | .apply label before inner after, _, _, canonical, transfer => by
      simp only [OneHoleContext.fill, Pattern.hasCanonicalBinderMetadata,
        hasCanonicalBinderMetadataList_iff, List.mem_append, List.mem_cons] at canonical ⊢
      rintro pattern (inBefore | rfl | inAfter)
      · exact canonical pattern (Or.inl inBefore)
      · exact hasCanonicalBinderMetadata_fill_replace inner
          (canonical _ (Or.inr (Or.inl rfl))) transfer
      · exact canonical pattern (Or.inr (Or.inr inAfter))
  | .lambda _ inner, _, _, canonical, transfer => by
      simp only [OneHoleContext.fill, Pattern.hasCanonicalBinderMetadata,
        Bool.and_eq_true] at canonical ⊢
      exact ⟨canonical.1,
        hasCanonicalBinderMetadata_fill_replace inner canonical.2 transfer⟩
  | .multiLambda _ _ inner, _, _, canonical, transfer => by
      simp only [OneHoleContext.fill, Pattern.hasCanonicalBinderMetadata,
        Bool.and_eq_true] at canonical ⊢
      exact ⟨canonical.1,
        hasCanonicalBinderMetadata_fill_replace inner canonical.2 transfer⟩
  | .substBody inner _, _, _, canonical, transfer => by
      simp only [OneHoleContext.fill, Pattern.hasCanonicalBinderMetadata,
        Bool.and_eq_true] at canonical ⊢
      exact ⟨hasCanonicalBinderMetadata_fill_replace inner canonical.1 transfer,
        canonical.2⟩
  | .substReplacement _ inner, _, _, canonical, transfer => by
      simp only [OneHoleContext.fill, Pattern.hasCanonicalBinderMetadata,
        Bool.and_eq_true] at canonical ⊢
      exact ⟨canonical.1,
        hasCanonicalBinderMetadata_fill_replace inner canonical.2 transfer⟩
  | .collection kind before inner after rest, _, _, canonical, transfer => by
      simp only [OneHoleContext.fill, Pattern.hasCanonicalBinderMetadata,
        hasCanonicalBinderMetadataList_iff, List.mem_append, List.mem_cons] at canonical ⊢
      rintro pattern (inBefore | rfl | inAfter)
      · exact canonical pattern (Or.inl inBefore)
      · exact hasCanonicalBinderMetadata_fill_replace inner
          (canonical _ (Or.inr (Or.inl rfl))) transfer
      · exact canonical pattern (Or.inr (Or.inr inAfter))

/-! ## The bag laws preserve admissibility -/

/-- Each bag law, read from left to right, keeps the type of the bag it
rewrites. -/
theorem derived_hasType (laws : BagTheory language bag unit)
    {free : FreeTypeContext} {bound : List TypeExpr} {type : TypeExpr}
    {source target : Pattern} (derived : DerivedInstance language source target)
    (typed : HasType language free bound source type)
    (collectionless : collectionFree type = true) :
    HasType language free bound target type := by
  cases derived with
  | bagPerm _ _ permutation =>
      obtain ⟨-, rfl, elementsTyped⟩ := bag_typing laws typed collectionless
      apply bag_hasType laws
      apply elementsHaveType_iff.mpr
      intro element membership
      exact elementsHaveType_iff.mp elementsTyped element (permutation.mem_iff.mpr membership)
  | setPerm declaration _ _ =>
      exact absurd (laws.carrier declaration).2 (by decide)
  | setDedup declaration _ =>
      exact absurd (laws.carrier declaration).2 (by decide)
  | @flatten rule kind algebra before inner after algebraRule _ _ =>
      obtain ⟨rfl, rfl, elementsTyped⟩ := bag_typing laws typed collectionless
      obtain ⟨beforeTyped, nestedTyped, afterTyped⟩ :=
        ElementsHaveType.append_cons_split elementsTyped
      obtain ⟨-, -, innerTyped⟩ := bag_typing laws nestedTyped rfl
      apply bag_hasType laws
      apply elementsHaveType_iff.mpr
      intro element membership
      simp only [List.mem_append] at membership
      rcases membership with (inBefore | inInner) | inAfter
      · exact elementsHaveType_iff.mp beforeTyped element inBefore
      · exact elementsHaveType_iff.mp innerTyped element inInner
      · exact elementsHaveType_iff.mp afterTyped element inAfter
  | @singleton rule kind algebra _ algebraRule _ _ =>
      obtain ⟨rfl, rfl, elementsTyped⟩ := bag_typing laws typed collectionless
      exact elementsHaveType_iff.mp elementsTyped target (by simp)
  | @unitElim rule kind algebra unitName before after algebraRule _ _ =>
      obtain ⟨rfl, rfl, elementsTyped⟩ := bag_typing laws typed collectionless
      apply bag_hasType laws
      apply elementsHaveType_iff.mpr
      intro element membership
      apply elementsHaveType_iff.mp elementsTyped element
      simp only [List.mem_append, List.mem_cons] at membership ⊢
      tauto
  | @emptyUnit rule kind algebra unitName algebraRule declaredUnit _ =>
      obtain ⟨-, rfl, -⟩ := bag_typing laws typed collectionless
      obtain ⟨rfl, -, -⟩ := laws.algebraRule algebraRule
      obtain ⟨unitRule, unitMember, rfl, categoryEq, parametersEq⟩ :=
        algebraRule.unitAuthored unitName declaredUnit
      rw [← categoryEq]
      apply HasType.constructor unitMember
      · rintro ⟨parameterName, collectionKind, elementType, shape⟩
        rw [parametersEq] at shape
        cases shape
      · rw [parametersEq]
        exact .nil

/-- Each bag law relates object patterns to object patterns. -/
theorem derived_isObjectPattern {source target : Pattern}
    (derived : DerivedInstance language source target)
    (object : isObjectPattern source = true) : isObjectPattern target = true := by
  cases derived with
  | bagPerm _ _ permutation =>
      simp only [isObjectPattern, Option.isNone_none, Bool.true_and,
        isObjectPatternList_iff] at object ⊢
      exact fun pattern membership => object pattern (permutation.mem_iff.mpr membership)
  | setPerm _ _ permutation =>
      simp only [isObjectPattern, Option.isNone_none, Bool.true_and,
        isObjectPatternList_iff] at object ⊢
      exact fun pattern membership => object pattern (permutation.mem_iff.mpr membership)
  | setDedup _ _ =>
      simp only [isObjectPattern, Option.isNone_none, Bool.true_and,
        isObjectPatternList_iff] at object ⊢
      exact fun pattern membership =>
        object pattern (List.mem_cons_of_mem _ membership)
  | flatten _ _ _ =>
      simp only [isObjectPattern, Option.isNone_none, Bool.true_and,
        isObjectPatternList_iff, List.mem_append, List.mem_cons] at object ⊢
      rintro pattern ((inBefore | inInner) | inAfter)
      · exact object pattern (Or.inl inBefore)
      · have nested := object _ (Or.inr (Or.inl rfl))
        simp only [isObjectPattern, Option.isNone_none, Bool.true_and,
          isObjectPatternList_iff] at nested
        exact nested pattern inInner
      · exact object pattern (Or.inr (Or.inr inAfter))
  | singleton _ _ _ =>
      simp only [isObjectPattern, Option.isNone_none, Bool.true_and,
        isObjectPatternList_iff] at object
      exact object target (by simp)
  | unitElim _ _ _ =>
      simp only [isObjectPattern, Option.isNone_none, Bool.true_and,
        isObjectPatternList_iff, List.mem_append, List.mem_cons] at object ⊢
      rintro pattern (inBefore | inAfter)
      · exact object pattern (Or.inl inBefore)
      · exact object pattern (Or.inr (Or.inr inAfter))
  | emptyUnit _ _ _ => simp [isObjectPattern, isObjectPatternList]

/-- Each bag law relates canonically bound patterns to canonically bound
patterns. -/
theorem derived_hasCanonicalBinderMetadata {source target : Pattern}
    (derived : DerivedInstance language source target)
    (canonical : source.hasCanonicalBinderMetadata = true) :
    target.hasCanonicalBinderMetadata = true := by
  cases derived with
  | bagPerm _ _ permutation =>
      simp only [Pattern.hasCanonicalBinderMetadata,
        hasCanonicalBinderMetadataList_iff] at canonical ⊢
      exact fun pattern membership => canonical pattern (permutation.mem_iff.mpr membership)
  | setPerm _ _ permutation =>
      simp only [Pattern.hasCanonicalBinderMetadata,
        hasCanonicalBinderMetadataList_iff] at canonical ⊢
      exact fun pattern membership => canonical pattern (permutation.mem_iff.mpr membership)
  | setDedup _ _ =>
      simp only [Pattern.hasCanonicalBinderMetadata,
        hasCanonicalBinderMetadataList_iff] at canonical ⊢
      exact fun pattern membership =>
        canonical pattern (List.mem_cons_of_mem _ membership)
  | flatten _ _ _ =>
      simp only [Pattern.hasCanonicalBinderMetadata,
        hasCanonicalBinderMetadataList_iff, List.mem_append, List.mem_cons] at canonical ⊢
      rintro pattern ((inBefore | inInner) | inAfter)
      · exact canonical pattern (Or.inl inBefore)
      · have nested := canonical _ (Or.inr (Or.inl rfl))
        simp only [Pattern.hasCanonicalBinderMetadata,
          hasCanonicalBinderMetadataList_iff] at nested
        exact nested pattern inInner
      · exact canonical pattern (Or.inr (Or.inr inAfter))
  | singleton _ _ _ =>
      simp only [Pattern.hasCanonicalBinderMetadata,
        hasCanonicalBinderMetadataList_iff] at canonical
      exact canonical target (by simp)
  | unitElim _ _ _ =>
      simp only [Pattern.hasCanonicalBinderMetadata,
        hasCanonicalBinderMetadataList_iff, List.mem_append, List.mem_cons] at canonical ⊢
      rintro pattern (inBefore | inAfter)
      · exact canonical pattern (Or.inl inBefore)
      · exact canonical pattern (Or.inr (Or.inr inAfter))
  | emptyUnit _ _ _ =>
      simp [Pattern.hasCanonicalBinderMetadata, Pattern.hasCanonicalBinderMetadataList]

/-- The source of a bag law is a collection node, so its target may stand
wherever it stood. -/
theorem derived_represents {source target : Pattern}
    (derived : DerivedInstance language source target) : Represents source target := by
  cases derived <;> exact represents_collection _ _ _ _

/-- **A step of the static equivalence of a bag theory preserves
admissibility.**  The step is a bag law in a context; the law keeps the type at
the hole and the context puts the result back. -/
theorem step_admissible (laws : BagTheory language bag unit)
    {base : BasePremiseEvaluator} {free : FreeTypeContext} {bound : List TypeExpr}
    {type : TypeExpr} {source target : Pattern}
    (step : EquationContextStep base language source target)
    (admissible : Admissible language free bound type source)
    (collectionless : collectionFree type = true) :
    Admissible language free bound type target := by
  generalize sourceEq : source = start at step
  cases step with
  | @inContext context redex contractum generator =>
      subst sourceEq
      rcases generator with authored | derived
      · exact absurd authored
          (no_equationInstance_of_equations_eq_nil laws.equationsEmpty redex contractum)
      · obtain ⟨holeBound, holeType, holeFree, redexTyped, rebuild⟩ :=
          hasType_fill_replace laws context admissible.typed collectionless admissible.object
        exact
          { typed := rebuild contractum (derived_represents derived)
              (derived_hasType laws derived redexTyped holeFree)
            canonical := hasCanonicalBinderMetadata_fill_replace context admissible.canonical
              (derived_hasCanonicalBinderMetadata derived)
            object := isObjectPattern_fill_replace context admissible.object
              (derived_isObjectPattern derived) }

end Mettapedia.GSLT.LanguageDef.BagNormalForm
