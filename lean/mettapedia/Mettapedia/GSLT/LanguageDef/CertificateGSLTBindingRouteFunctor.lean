import Mathlib.CategoryTheory.PathCategory.Basic
import Mettapedia.GSLT.LanguageDef.CertificateGSLTBindingAuthority

/-!
# Free binding-presentation routes and their generated NIK authorities

A binding-aware semantic embedding is one authored translation event.  Two
sequences of such events can have the same endpoints and even induce the same
observable answer without being the same revision or provenance route.  The
appropriate source category is therefore the free path category on the quiver
of binding-aware semantic presentations, not a quotient that identifies
routes through their composite action.

Every generating embedding already induces an exact heterogeneous NIK
authority translation.  The universal property of the path category extends
that generator action uniquely to a functor.  Consequently arbitrary authored
routes preserve checker results, proof scope, and independently supplied
meaning by composition, while the route itself remains proof-relevant.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.LanguageDef.CertificateGSLTBindingRouteFunctor

open CategoryTheory
open scoped CategoryTheory
open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.GSLT.LanguageDef.NIKAuthorityCategory
open Mettapedia.GSLT.LanguageDef.NIKHeterogeneousTheory
open Mettapedia.GSLT.LanguageDef.CertificateGSLTHeterogeneousAuthority
open Mettapedia.GSLT.LanguageDef.CertificateGSLTBindingAuthority

/-- One vertex of the authored binding-translation quiver. -/
@[ext]
structure BindingPresentation where
  semantic : SemanticPresentation

/-- Primitive arrows are binding-aware, proof-relevant, independently
meaning-preserving presentation embeddings. -/
instance : Quiver BindingPresentation where
  Hom source target :=
    BindingSemanticEmbedding source.semantic target.semantic

/-- Regard one semantic presentation as a vertex of the translation quiver. -/
def ofSemantic (presentation : SemanticPresentation) : BindingPresentation :=
  ⟨presentation⟩

/-- Authored translation histories are free paths of primitive binding-aware
embeddings. -/
abbrev Route (source target : BindingPresentation) :=
  Quiver.Path source target

/-- The generator action sends each presentation to its exact generated
authority and each authored binding embedding to its exact authority
translation. -/
def generatorAuthority : BindingPresentation ⥤q AuthorityObject where
  obj presentation := generatedAuthority presentation.semantic
  map embedding := BindingSemanticEmbedding.map embedding

/-- Universal NIK generation on occurrence-bearing binding-translation
routes.  `Paths.lift` supplies identity, composition, and uniqueness from the
generator action. -/
def generationFunctor :
    CategoryTheory.Functor
      (CategoryTheory.Paths BindingPresentation) AuthorityObject :=
  CategoryTheory.Paths.lift generatorAuthority

@[simp] theorem generationFunctor_obj (presentation : BindingPresentation) :
    generationFunctor.obj presentation =
      generatedAuthority presentation.semantic :=
  rfl

/-- A singleton authored route compiles to exactly the authority translation
generated by its binding-aware embedding. -/
@[simp] theorem generationFunctor_map_generator
    {source target : BindingPresentation}
    (embedding : Quiver.Hom source target) :
    generationFunctor.map embedding.toPath =
      BindingSemanticEmbedding.map embedding :=
  CategoryTheory.Paths.lift_toPath generatorAuthority embedding

/-- The empty authored route compiles to categorical identity. -/
@[simp] theorem generationFunctor_map_nil
    (presentation : BindingPresentation) :
    generationFunctor.map
        (Quiver.Path.nil : Route presentation presentation) =
      CategoryTheory.CategoryStruct.id
        (generatedAuthority presentation.semantic) :=
  rfl

/-- Appending one authored event compiles by categorical composition. -/
@[simp] theorem generationFunctor_map_cons
    {source middle target : BindingPresentation}
    (route : Route source middle)
    (embedding : Quiver.Hom middle target) :
    generationFunctor.map (route.cons embedding) =
      CategoryTheory.CategoryStruct.comp (generationFunctor.map route)
        (BindingSemanticEmbedding.map embedding) :=
  rfl

/-- General route append compiles compositionally. -/
theorem generationFunctor_map_comp
    {source middle target : BindingPresentation}
    (earlier : Route source middle) (later : Route middle target) :
    generationFunctor.map (earlier.comp later) =
      CategoryTheory.CategoryStruct.comp (generationFunctor.map earlier)
        (generationFunctor.map later) :=
  generationFunctor.map_comp earlier later

/-- The generated interpreter is uniquely determined by its action on
presentations and primitive binding embeddings. -/
theorem generationFunctor_unique
    (candidate : CategoryTheory.Functor
      (CategoryTheory.Paths BindingPresentation) AuthorityObject)
    (agreesOnGenerators :
      Prefunctor.comp (CategoryTheory.Paths.of BindingPresentation)
          candidate.toPrefunctor = generatorAuthority) :
    candidate = generationFunctor :=
  CategoryTheory.Paths.lift_unique generatorAuthority candidate
    agreesOnGenerators

/-- Exact checker replay, including rejection, composes along every authored
binding-translation route. -/
theorem route_check_commutes
    {source target : BindingPresentation}
    (route : Route source target) (claim : Pattern)
    (certificate : (contract source.semantic).Certificate ()) :
    ((contract target.semantic).checker ()).check
        ((generationFunctor.map route).mapClaim () claim)
        ((generationFunctor.map route).mapCertificate () certificate) =
      ((contract source.semantic).checker ()).check claim certificate :=
  (generationFunctor.map route).check_commutes () claim certificate

/-- Native proof scope is transported along every authored route. -/
theorem route_scope_preserved
    {source target : BindingPresentation}
    (route : Route source target) (claim : Pattern)
    (inScope : (theory source.semantic).Scope () claim) :
    (theory target.semantic).Scope ()
      ((generationFunctor.map route).mapClaim () claim) :=
  (generationFunctor.map route).scope_preserved () claim inScope

/-- Independent semantic meaning is transported along every authored route;
it is not reconstructed from certificate acceptance. -/
theorem route_meaning_preserved
    {source target : BindingPresentation}
    (route : Route source target) (claim : Pattern)
    (meaningful : source.semantic.Meaning claim) :
    target.semantic.Meaning
      ((generationFunctor.map route).mapClaim () claim) :=
  (generationFunctor.map route).meaning_preserved () claim meaningful

#print axioms generationFunctor
#print axioms generationFunctor_map_generator
#print axioms generationFunctor_map_comp
#print axioms generationFunctor_unique
#print axioms route_check_commutes
#print axioms route_scope_preserved
#print axioms route_meaning_preserved

end Mettapedia.GSLT.LanguageDef.CertificateGSLTBindingRouteFunctor
