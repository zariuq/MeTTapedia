import Mettapedia.GSLT.LanguageDef.IndexedContainerNativeVectorMethodReading
import Mettapedia.Logic.HOL.IndexedContainerConstructorPrograms
import Mettapedia.Logic.HOL.IndexedContainerDirectPositions
import Mettapedia.Logic.HOL.OrderedMixedPositionCoverage

/-!
# Position reading of the original mixed Vector source constructor

The source code is the existing erased declaration. Its shape telescope keeps
the length, payload and registered Vector shape; recursive values reside in
the child array. The parameterized payload guard is retained. Count programs
are generated by the existing compiler and remain explicit HOL syntax.
This is a source interpretation adapter, not a new parser or runtime route.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace Mettapedia.GSLT.LanguageDef.IndexedContainerNativeVectorPositionReading
open Mettapedia.Logic
open Mettapedia.Logic.HOL
open Mettapedia.TypeTheory.IndexedPolynomial.Description
open Mettapedia.TypeTheory.IndexedPositiveContainer
open Mettapedia.Logic.HOL.IndexedContainerPositionTerms
open Mettapedia.Logic.HOL.FiniteConstructorEncoding
open Mettapedia.Logic.HOL.CurriedPredicates
open Mettapedia.Logic.HOL.OrderedPositionPrograms
open IndexedContainerNativeVectorMethodReading (Base Const N E V original)

abbrev I := IndexedContainerNativeVectorMethodFormation.I
abbrev registry := IndexedContainerNativeVectorMethodFormation.registry
abbrev code := IndexedContainerNativeVectorMethodFormation.code

def indices : IndexedConstructorTerms.Reading I Const where
  sort
    | .length => N
    | .payload => E
  index := .prop
  parameters := [E ⇒ .prop]
  term _ := .top

def lengthVariable : {context : List I.SortCode} → VectorControl.LengthExpr context →
    Var (context.map indices.sort ++ indices.parameters) N
  | _, .here => .vz
  | _, .there expression => .vs (lengthVariable expression)

def reading : Reading I registry Const where
  indices := indices
  number := N
  one := .app original.successor original.zero
  shapeType := fun _ _ _ => N
  count := by
    intro context name entry registered output
    obtain rfl := IndexedPositiveContainerGuestControls.Vectors.registered_entry registered
    exact .lam (weaken (.var (lengthVariable output)))

def guards : FieldGuards reading where
  value
    | .length => .lam .top
    | .payload => .var .vz
  shape := by
    intro context name entry registered output
    exact .lam (.eq (.var .vz) (weakenCtx _ original.zero))

def numeral (Γ : Ctx Base) : Nat → Term Const Γ N
  | 0 => weakenCtx Γ original.zero
  | n + 1 => .app (weakenCtx Γ original.successor) (numeral Γ n)

def parameterMap {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop)) : Subst Const indices.parameters Γ
  | _, .vz => payload
  | _, .vs impossible => nomatch impossible

def constructors {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop)) :=
  guards.constructors [code] (parameterMap payload) (numeral Γ)

def plans {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop)) :=
  FieldGuards.plans (reading := reading) [code] (parameterMap payload)

def occurrence {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop)) :
    Fin (constructors payload).fields.length := ⟨0,by change 0 < 1; decide⟩

theorem source_fields : reading.fields code = [N,E,N] := rfl

def arguments {Γ : Ctx Base} (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    Arguments Const Γ (reading.fields code) := (length,tag,shape,PUnit.unit)

def rawPlan {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :=
  fieldTerms (reading.fields code) (reading.compile code (parameterMap payload)) Subst.id (arguments length tag shape)

theorem rawPlan_length {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    (rawPlan payload length tag shape).length = 3 := rfl

def middleBody {Γ : Ctx Base} : Term Const (N :: E :: N :: Γ) N :=
  .app (.lam (.var (.vs (.vs (.vs .vz))))) (.var .vz)

def middleFunction {Γ : Ctx Base} : Term Const Γ (N ⇒ E ⇒ N ⇒ N) :=
  .lam (.lam (.lam middleBody))

def countAt {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N)
    (position : Fin 3) : Term Const Γ N :=
  ((rawPlan payload length tag shape).get ⟨position.val,by rw [rawPlan_length]; exact position.isLt⟩).1

def labelAt {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N)
    (position : Fin 3) : Term Const Γ .prop :=
  ((rawPlan payload length tag shape).get ⟨position.val,by rw [rawPlan_length]; exact position.isLt⟩).2

theorem one_weaken (Γ : Ctx Base) : weakenCtx Γ reading.one =
    .app (weakenCtx Γ original.successor) (weakenCtx Γ original.zero) := by
  induction Γ with
  | nil => rfl
  | cons type Γ previous => simp only [weakenCtx_cons,previous,weaken,HOL.rename]

def firstCountProof {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    ProofSyntax Const Δ (.eq (countAt payload length tag shape 0)
      (.app (weakenCtx Γ original.successor) (weakenCtx Γ original.zero))) := by
  apply ProofSyntax.castIndices rfl ?_
    (Reading.directCountProof (reading := reading) code (parameterMap payload) (arguments length tag shape) 0 (by decide +kernel))
  simp only [countAt,rawPlan,fieldTerms,Reading.directSegment,Reading.directProgram,List.get_eq_getElem,List.getElem_map,subst_id]
  rw [one_weaken]
  rfl

def lastCountProof {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    ProofSyntax Const Δ (.eq (countAt payload length tag shape 2)
      (.app (weakenCtx Γ original.successor) (weakenCtx Γ original.zero))) := by
  apply ProofSyntax.castIndices rfl ?_
    (Reading.directCountProof (reading := reading) code (parameterMap payload) (arguments length tag shape) 2 (by decide +kernel))
  simp only [countAt,rawPlan,fieldTerms,Reading.directSegment,Reading.directProgram,List.get_eq_getElem,List.getElem_map,subst_id]
  rw [one_weaken]
  rfl

theorem firstCountProof_free {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    (firstCountProof (Δ := Δ) payload length tag shape).FunctionExtensionalityFree := by
  unfold firstCountProof
  apply (ProofSyntax.functionExtensionalityFree_castIndices _ _ _).mpr
  exact Reading.directCountProof_free (reading := reading) _ _ _ _ _

theorem lastCountProof_free {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    (lastCountProof (Δ := Δ) payload length tag shape).FunctionExtensionalityFree := by
  unfold lastCountProof
  apply (ProofSyntax.functionExtensionalityFree_castIndices _ _ _).mpr
  exact Reading.directCountProof_free (reading := reading) _ _ _ _ _

def middleCountProof {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    ProofSyntax Const Δ (.eq (countAt payload length tag shape 1) length) := by
  have first : ProofSyntax Const Δ (.eq (countAt payload length tag shape 1)
      (.app (.lam (weaken length)) shape)) := by
    apply ProofSyntax.castIndices rfl ?_ (CurriedGuardProgramProofs.beta3 middleBody length tag shape)
    apply congrArg₂ Term.eq
    · rfl
    · simp only [middleBody,instantiate,HOL.subst,Subst.lift,Subst.single]
      apply congrArg (fun body : Term Const (N :: Γ) N => Term.app (.lam body) shape)
      simp only [HOL.subst_rename,HOL.subst_comp,Subst.lift,Subst.single,HOL.rename,Rename.weaken]
      exact subst_ofRename Rename.weaken length
  have second : ProofSyntax Const Δ (.eq (.app (.lam (weaken length)) shape) length) := by
    apply ProofSyntax.castIndices rfl ?_ (.beta shape (weaken length))
    simp only [instantiate_weaken]
  exact .eqTrans first second

theorem middleCountProof_free {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    (middleCountProof (Δ := Δ) payload length tag shape).FunctionExtensionalityFree := by
  unfold middleCountProof
  constructor
  · apply (ProofSyntax.functionExtensionalityFree_castIndices _ _ _).mpr
    exact CurriedGuardProgramProofs.beta3_free _ _ _ _
  · apply (ProofSyntax.functionExtensionalityFree_castIndices _ _ _).mpr
    trivial

theorem labelAt_code {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) (position : Fin 3) :
    labelAt payload length tag shape position =
      applyFields [N,E,N] (Reading.ignoreFields [N,E,N] .top) (length,tag,shape,PUnit.unit) := by
  fin_cases position <;> rfl

def labelProof {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) (position : Fin 3) :
    ProofSyntax Const Δ (.eq (labelAt payload length tag shape position) .top) :=
  ProofSyntax.castIndices rfl (congrArg (fun term => Term.eq term .top) (labelAt_code payload length tag shape position)).symm
    (Reading.ignoreFields_beta [N,E,N] .top (length,tag,shape,PUnit.unit))

theorem labelProof_free {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) (position : Fin 3) :
    (labelProof (Δ := Δ) payload length tag shape position).FunctionExtensionalityFree := by
  unfold labelProof
  apply (ProofSyntax.functionExtensionalityFree_castIndices _ _ _).mpr
  exact Reading.ignoreFields_beta_free _ _ _

def planEquations {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    PlanEquations Δ (rawPlan payload length tag shape)
      (mixedPlan original.zero original.successor length .top .top .top) :=
  .cons (firstCountProof payload length tag shape) (labelProof payload length tag shape 0)
    (.cons (middleCountProof payload length tag shape) (labelProof payload length tag shape 1)
      (.cons (lastCountProof payload length tag shape) (labelProof payload length tag shape 2) .nil))

theorem planEquations_free {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    (planEquations (Δ := Δ) payload length tag shape).Free :=
  ⟨firstCountProof_free _ _ _ _,labelProof_free _ _ _ _ _,middleCountProof_free _ _ _ _,
    labelProof_free _ _ _ _ _,lastCountProof_free _ _ _ _,labelProof_free _ _ _ _ _,True.intro⟩

def sourceArguments {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) :
    Arguments Const Γ ((constructors payload).fields.get (occurrence payload)) := arguments length tag shape

def sourceAllowed {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) : Formula Const Γ :=
  applyArguments _ ((constructors payload).allowed (occurrence payload)) (sourceArguments payload length tag shape)

def sourceActivity {Γ : Ctx Base} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N) : Term Const Γ (N ⇒ .prop) :=
  IndexedConstructorGuards.PositionPrograms.sourceActive (constructors payload) original.zero original.successor
    (plans payload) (occurrence payload) (sourceArguments payload length tag shape)

def sourceCoverage {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N)
    (allowed : ProofSyntax Const Δ (sourceAllowed payload length tag shape))
    (principle : ProofSyntax Const Δ (NaturalRecursionProofs.inductionPrinciple
      (weakenCtx Γ original.zero) (weakenCtx Γ original.successor))) :
    SuccessorOrder.MixedCoverage original.successor original.zero (sourceActivity payload length tag shape) length Δ :=
  IndexedConstructorGuards.PositionPrograms.originalMixedCoverage (constructors payload) original.zero original.successor
    (plans payload) (occurrence payload) (sourceArguments payload length tag shape) length .top .top .top
    (planEquations payload length tag shape) allowed principle

theorem sourceCoverage_free {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape : Term Const Γ N)
    (allowed : ProofSyntax Const Δ (sourceAllowed payload length tag shape))
    (principle : ProofSyntax Const Δ (NaturalRecursionProofs.inductionPrinciple
      (weakenCtx Γ original.zero) (weakenCtx Γ original.successor)))
    (allowedFree : allowed.FunctionExtensionalityFree) (principleFree : principle.FunctionExtensionalityFree) :
    (sourceCoverage payload length tag shape allowed principle).Free :=
  IndexedConstructorGuards.PositionPrograms.originalMixedCoverage_free (constructors payload) original.zero original.successor
    (plans payload) (occurrence payload) (sourceArguments payload length tag shape) length .top .top .top
    (planEquations payload length tag shape) allowed principle (planEquations_free _ _ _ _) allowedFree principleFree

def sourceInactiveAddress {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape slot : Term Const Γ N)
    (allowed : ProofSyntax Const Δ (sourceAllowed payload length tag shape))
    (principle : ProofSyntax Const Δ (NaturalRecursionProofs.inductionPrinciple
      (weakenCtx Γ original.zero) (weakenCtx Γ original.successor)))
    (separate : ProofSyntax Const Δ (NaturalNumeralProofs.separation
      (weakenCtx Γ original.zero) (weakenCtx Γ original.successor)))
    (inactive : ProofSyntax Const Δ (.not (.app (sourceActivity payload length tag shape) slot))) :
    ProofSyntax Const Δ (SuccessorOrder.paddingAddress original.successor original.zero length slot) :=
  SuccessorOrder.inactiveAddress original.successor original.zero (sourceActivity payload length tag shape) length slot
    (sourceCoverage payload length tag shape allowed principle) principle separate inactive

theorem sourceInactiveAddress_free {Γ : Ctx Base} {Δ : List (Formula Const Γ)} (payload : Term Const Γ (E ⇒ .prop))
    (length : Term Const Γ N) (tag : Term Const Γ E) (shape slot : Term Const Γ N)
    (allowed : ProofSyntax Const Δ (sourceAllowed payload length tag shape))
    (principle : ProofSyntax Const Δ (NaturalRecursionProofs.inductionPrinciple
      (weakenCtx Γ original.zero) (weakenCtx Γ original.successor)))
    (separate : ProofSyntax Const Δ (NaturalNumeralProofs.separation
      (weakenCtx Γ original.zero) (weakenCtx Γ original.successor)))
    (inactive : ProofSyntax Const Δ (.not (.app (sourceActivity payload length tag shape) slot)))
    (allowedFree : allowed.FunctionExtensionalityFree) (principleFree : principle.FunctionExtensionalityFree)
    (separateFree : separate.FunctionExtensionalityFree) (inactiveFree : inactive.FunctionExtensionalityFree) :
    (sourceInactiveAddress payload length tag shape slot allowed principle separate inactive).FunctionExtensionalityFree :=
  SuccessorOrder.inactiveAddress_free _ _ _ _ _ _ principle separate inactive
    (sourceCoverage_free payload length tag shape allowed principle allowedFree principleFree)
    principleFree separateFree inactiveFree

#print axioms source_fields
#print axioms rawPlan_length
#print axioms planEquations_free
#print axioms sourceInactiveAddress_free
end Mettapedia.GSLT.LanguageDef.IndexedContainerNativeVectorPositionReading
