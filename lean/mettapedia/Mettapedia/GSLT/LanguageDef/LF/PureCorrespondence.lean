import Mettapedia.GSLT.LanguageDef.LF.ConversionProfileChecker
import Mettapedia.GSLT.LanguageDef.Pure.BetaEtaAtomicRefinement

/-!
# Pure to LF beta-eta correspondence

The Pure refinement language and the executable LF checker use the same
de Bruijn binding convention but different carriers.  This module gives the
total translation from the universe-free Pure carrier to the indexed LF
carrier and proves that the operations needed by conversion-aware proof
checking commute with that translation.

Pure's single sort is interpreted as LF `type`; the target LF profile remains
responsible for checking whether translated domains and products are
well-formed.  Thus this module translates syntax and conversion evidence, but
does not turn a merely structural Pure trace into a typed LF proof.
-/

namespace Mettapedia.GSLT.LanguageDef.LFPureCorrespondence

open Mettapedia.GSLT.LanguageDef

/-- Interpret Pure's single unlevelled sort as LF `type`. -/
def encodeExpr : Pure.Expr → LF.Term
  | .sort => .srt .type
  | .bvar index => .var index
  | .pi domain body => .pi (encodeExpr domain) (encodeExpr body)
  | .lam domain body => .lam (encodeExpr domain) (encodeExpr body)
  | .app function argument => .app (encodeExpr function) (encodeExpr argument)

/-- Decode precisely the LF fragment generated by `encodeExpr`. -/
def decodeExpr? : LF.Term → Option Pure.Expr
  | .srt .type => some .sort
  | .srt .kind => none
  | .con _ => none
  | .var index => some (.bvar index)
  | .pi domain body => do
      pure (.pi (← decodeExpr? domain) (← decodeExpr? body))
  | .lam domain body => do
      pure (.lam (← decodeExpr? domain) (← decodeExpr? body))
  | .app function argument => do
      pure (.app (← decodeExpr? function) (← decodeExpr? argument))

/-- Decoding after translation is the identity. -/
theorem decodeExpr?_encodeExpr (expression : Pure.Expr) :
    decodeExpr? (encodeExpr expression) = some expression := by
  induction expression <;>
    simp_all [decodeExpr?, encodeExpr]

/-- The carrier translation loses no Pure syntax. -/
theorem encodeExpr_injective : Function.Injective encodeExpr := by
  intro left right hequal
  have hdecoded := congrArg decodeExpr? hequal
  simpa [decodeExpr?_encodeExpr] using hdecoded

/-- Translate a Pure context pointwise, preserving innermost-first order. -/
def encodeContext (context : Pure.Ctx) : LFTyping.Ctx :=
  context.map encodeExpr

/-- Erase a Pure eta-long normal form and translate the resulting expression. -/
def encodeNf (term : Pure.Nf) : LF.Term :=
  encodeExpr term.erase

/-- Pure and LF lifting agree exactly under the translation. -/
theorem encodeExpr_lift (distance cutoff : Nat) (expression : Pure.Expr) :
    encodeExpr (Pure.Expr.lift distance cutoff expression) =
      LFTyping.lift distance cutoff (encodeExpr expression) := by
  induction expression generalizing cutoff with
  | sort =>
      simp [encodeExpr, Pure.Expr.lift, LFTyping.lift]
  | bvar index =>
      by_cases hindex : index < cutoff <;>
        simp [encodeExpr, Pure.Expr.lift, LFTyping.lift, hindex]
  | pi domain body domainIH bodyIH =>
      simp [encodeExpr, Pure.Expr.lift, LFTyping.lift, domainIH, bodyIH]
  | lam domain body domainIH bodyIH =>
      simp [encodeExpr, Pure.Expr.lift, LFTyping.lift, domainIH, bodyIH]
  | app function argument functionIH argumentIH =>
      simp [encodeExpr, Pure.Expr.lift, LFTyping.lift, functionIH, argumentIH]

/-- Pure and LF capture-avoiding substitution agree exactly. -/
theorem encodeExpr_subst
    (index : Nat) (replacement expression : Pure.Expr) :
    encodeExpr (Pure.Expr.subst index replacement expression) =
      LFTyping.subst index (encodeExpr replacement) (encodeExpr expression) := by
  induction expression generalizing index replacement with
  | sort =>
      simp [encodeExpr, Pure.Expr.subst, LFTyping.subst]
  | bvar current =>
      by_cases hequal : current = index
      · subst current
        simp [encodeExpr, Pure.Expr.subst, LFTyping.subst]
      · by_cases habove : index < current
        · simp [encodeExpr, Pure.Expr.subst, LFTyping.subst, hequal, habove]
        · simp [encodeExpr, Pure.Expr.subst, LFTyping.subst, hequal, habove]
  | pi domain body domainIH bodyIH =>
      simp [encodeExpr, Pure.Expr.subst, LFTyping.subst, domainIH, bodyIH,
        encodeExpr_lift]
  | lam domain body domainIH bodyIH =>
      simp [encodeExpr, Pure.Expr.subst, LFTyping.subst, domainIH, bodyIH,
        encodeExpr_lift]
  | app function argument functionIH argumentIH =>
      simp [encodeExpr, Pure.Expr.subst, LFTyping.subst, functionIH, argumentIH]

/-- Innermost substitution is preserved by the translation. -/
theorem encodeExpr_subst0 (argument body : Pure.Expr) :
    encodeExpr (Pure.Expr.subst0 argument body) =
      LFTyping.subst0 (encodeExpr argument) (encodeExpr body) := by
  exact encodeExpr_subst 0 argument body

/-- Syntactic Pure scope becomes syntactic LF scope at the same depth. -/
theorem encodeExpr_wellScoped {depth : Nat} {expression : Pure.Expr}
    (hscoped : Pure.Expr.WellScoped depth expression) :
    LF.WellScoped depth (encodeExpr expression) := by
  induction hscoped with
  | sort => exact .srt
  | bvar hindex => exact .var hindex
  | pi _ _ domainIH bodyIH => exact .pi domainIH bodyIH
  | lam _ _ domainIH bodyIH => exact .lam domainIH bodyIH
  | app _ _ functionIH argumentIH => exact .app functionIH argumentIH

theorem encodeContext_length (context : Pure.Ctx) :
    (encodeContext context).length = context.length := by
  simp [encodeContext]

/-- Context lookup, including all crossing-binder lifts, commutes with the
translation. -/
theorem encode_ctxLookupAux (depth : Nat) (context : Pure.Ctx) (index : Nat) :
    Option.map encodeExpr (Pure.ctxLookupAux depth context index) =
      LFTyping.ctxLookupAux depth (encodeContext context) index := by
  induction context generalizing depth index with
  | nil =>
      simp [Pure.ctxLookupAux, LFTyping.ctxLookupAux, encodeContext]
  | cons domain rest ih =>
      cases index with
      | zero =>
          simp [Pure.ctxLookupAux, LFTyping.ctxLookupAux, encodeContext,
            encodeExpr_lift]
      | succ index =>
          simpa [Pure.ctxLookupAux, LFTyping.ctxLookupAux, encodeContext] using
            ih (depth + 1) index

/-- Top-level context lookup commutes with the translation. -/
theorem encode_ctxLookup (context : Pure.Ctx) (index : Nat) :
    Option.map encodeExpr (Pure.ctxLookup context index) =
      LFTyping.ctxLookup (encodeContext context) index := by
  exact encode_ctxLookupAux 0 context index

/-- The normal-form translation is exactly translation after erasure. -/
theorem encodeNf_eq (term : Pure.Nf) :
    encodeNf term = encodeExpr term.erase := rfl

/-- Pure and LF unused-binder elimination agree. -/
theorem encodeExpr_unbind (cutoff : Nat) (expression : Pure.Expr) :
    Option.map encodeExpr (PureBetaEta.unbind cutoff expression) =
      LFBetaEta.unbind cutoff (encodeExpr expression) := by
  induction expression generalizing cutoff with
  | sort =>
      simp [PureBetaEta.unbind, LFBetaEta.unbind, encodeExpr]
  | bvar index =>
      by_cases hbelow : index < cutoff
      · simp [PureBetaEta.unbind, LFBetaEta.unbind, encodeExpr, hbelow]
      · by_cases hequal : index = cutoff
        · simp [PureBetaEta.unbind, LFBetaEta.unbind, encodeExpr, hequal]
        · simp [PureBetaEta.unbind, LFBetaEta.unbind, encodeExpr, hbelow, hequal]
  | pi domain body domainIH bodyIH =>
      cases hdomain : PureBetaEta.unbind cutoff domain <;>
        cases hbody : PureBetaEta.unbind (cutoff + 1) body
      all_goals
        have hdomainMap := (domainIH cutoff).symm
        have hbodyMap := (bodyIH (cutoff + 1)).symm
        rw [hdomain] at hdomainMap
        rw [hbody] at hbodyMap
        simp at hdomainMap hbodyMap
        simp [PureBetaEta.unbind, LFBetaEta.unbind, encodeExpr, hdomain, hbody,
          hdomainMap, hbodyMap]
  | lam domain body domainIH bodyIH =>
      cases hdomain : PureBetaEta.unbind cutoff domain <;>
        cases hbody : PureBetaEta.unbind (cutoff + 1) body
      all_goals
        have hdomainMap := (domainIH cutoff).symm
        have hbodyMap := (bodyIH (cutoff + 1)).symm
        rw [hdomain] at hdomainMap
        rw [hbody] at hbodyMap
        simp at hdomainMap hbodyMap
        simp [PureBetaEta.unbind, LFBetaEta.unbind, encodeExpr, hdomain, hbody,
          hdomainMap, hbodyMap]
  | app function argument functionIH argumentIH =>
      cases hfunction : PureBetaEta.unbind cutoff function <;>
        cases hargument : PureBetaEta.unbind cutoff argument
      all_goals
        have hfunctionMap := (functionIH cutoff).symm
        have hargumentMap := (argumentIH cutoff).symm
        rw [hfunction] at hfunctionMap
        rw [hargument] at hargumentMap
        simp at hfunctionMap hargumentMap
        simp [PureBetaEta.unbind, LFBetaEta.unbind, encodeExpr, hfunction, hargument,
          hfunctionMap, hargumentMap]

mutual

/-- Pure beta normalization is the empty-signature LF beta normalizer after
translation. -/
theorem encodeExpr_betaNf : ∀ fuel expression,
    encodeExpr (PureBetaEta.betaNf fuel expression) =
      LFTyping.nf [] fuel (encodeExpr expression)
  | 0, expression => by
      simp [PureBetaEta.betaNf, LFTyping.nf]
  | fuel + 1, expression => by
      cases expression with
      | sort =>
          simp [PureBetaEta.betaNf, LFTyping.nf, encodeExpr]
      | bvar index =>
          simp [PureBetaEta.betaNf, LFTyping.nf, encodeExpr]
      | pi domain body =>
          simp [PureBetaEta.betaNf, LFTyping.nf, encodeExpr, encodeExpr_betaNf]
      | lam domain body =>
          simp [PureBetaEta.betaNf, LFTyping.nf, encodeExpr, encodeExpr_betaNf]
      | app function argument =>
          simp [PureBetaEta.betaNf, LFTyping.nf, encodeExpr, encodeExpr_betaNf,
            encodeExpr_betaNfApp]

/-- The normalized application helper commutes as well. -/
theorem encodeExpr_betaNfApp : ∀ fuel function argument,
    encodeExpr (PureBetaEta.betaNfApp fuel function argument) =
      LFTyping.nfApp [] fuel (encodeExpr function) (encodeExpr argument)
  | 0, function, argument => by
      simp [PureBetaEta.betaNfApp, LFTyping.nfApp, encodeExpr]
  | fuel + 1, function, argument => by
      cases function with
      | lam domain body =>
          simp [PureBetaEta.betaNfApp, LFTyping.nfApp, encodeExpr, encodeExpr_betaNf,
            encodeExpr_subst0]
      | sort =>
          simp [PureBetaEta.betaNfApp, LFTyping.nfApp, encodeExpr]
      | bvar index =>
          simp [PureBetaEta.betaNfApp, LFTyping.nfApp, encodeExpr]
      | pi domain body =>
          simp [PureBetaEta.betaNfApp, LFTyping.nfApp, encodeExpr]
      | app nestedFunction nestedArgument =>
          simp [PureBetaEta.betaNfApp, LFTyping.nfApp, encodeExpr]

end

/-- Pure eta normalization commutes with LF eta normalization. -/
theorem encodeExpr_etaNf (expression : Pure.Expr) :
    encodeExpr (PureBetaEta.etaNf expression) = LFBetaEta.etaNf (encodeExpr expression) := by
  induction expression with
  | sort =>
      simp [PureBetaEta.etaNf, LFBetaEta.etaNf, encodeExpr]
  | bvar index =>
      simp [PureBetaEta.etaNf, LFBetaEta.etaNf, encodeExpr]
  | pi domain body domainIH bodyIH =>
      simp [PureBetaEta.etaNf, LFBetaEta.etaNf, encodeExpr, domainIH, bodyIH]
  | app function argument functionIH argumentIH =>
      simp [PureBetaEta.etaNf, LFBetaEta.etaNf, encodeExpr, functionIH, argumentIH]
  | lam domain body domainIH bodyIH =>
      simp only [PureBetaEta.etaNf, LFBetaEta.etaNf, encodeExpr]
      generalize hdomain : PureBetaEta.etaNf domain = normalizedDomain
      generalize hbody : PureBetaEta.etaNf body = normalizedBody
      rw [hdomain] at domainIH
      rw [hbody] at bodyIH
      rw [← domainIH, ← bodyIH]
      cases normalizedBody with
      | sort => rfl
      | bvar index =>
          cases index <;> rfl
      | pi bodyDomain bodyBody => rfl
      | lam bodyDomain bodyBody => rfl
      | app function argument =>
          cases argument with
          | sort => rfl
          | pi argumentDomain argumentBody => rfl
          | lam argumentDomain argumentBody => rfl
          | app argumentFunction argumentArgument => rfl
          | bvar index =>
              cases index with
              | succ index => rfl
              | zero =>
                  have hencoded := encodeExpr_unbind 0 function
                  cases hunbind : PureBetaEta.unbind 0 function
                  · simp [hunbind] at hencoded
                    simp [hunbind, encodeExpr, ← hencoded]
                  · rename_i reduced
                    simp [hunbind] at hencoded
                    simp [hunbind, encodeExpr, ← hencoded]

/-- The fixed Pure normal form is exactly LF's beta-eta normal form at the
same fuel and empty signature. -/
theorem encodeExpr_normalForm (expression : Pure.Expr) :
    encodeExpr (PureBetaEta.normalForm expression) =
      LFBetaEta.normalForm [] PureBetaEta.normalizationFuel (encodeExpr expression) := by
  simp [PureBetaEta.normalForm, LFBetaEta.normalForm, encodeExpr_etaNf, encodeExpr_betaNf]

/-- Pure's executable conversion Boolean is the LF conversion Boolean on
translated terms. -/
theorem encodeExpr_convBool (left right : Pure.Expr) :
    PureBetaEta.convBool left right =
      LFBetaEta.convBool [] PureBetaEta.normalizationFuel (encodeExpr left)
        (encodeExpr right) := by
  unfold PureBetaEta.convBool LFBetaEta.convBool
  apply Bool.eq_iff_iff.mpr
  simp only [beq_iff_eq]
  rw [← encodeExpr_normalForm left, ← encodeExpr_normalForm right]
  exact encodeExpr_injective.eq_iff.symm

/-- A Pure beta-eta reduction translates to an LF beta-eta reduction. -/
theorem encodeExpr_reduces {source target : Pure.Expr}
    (hreduces : PureBetaEta.Reduces source target) :
    LFBetaEta.Reduces [] (encodeExpr source) (encodeExpr target) := by
  induction hreduces with
  | refl => exact .refl
  | beta =>
      simpa [encodeExpr, encodeExpr_subst0] using
        (LFBetaEta.Reduces.beta (signature := []))
  | @eta domain function reduced hresult =>
      have hencoded := encodeExpr_unbind 0 function
      rw [hresult] at hencoded
      simp only [Option.map_some] at hencoded
      exact LFBetaEta.Reduces.eta hencoded.symm
  | pi _ _ domainIH bodyIH =>
      exact .pi domainIH bodyIH
  | lam _ _ domainIH bodyIH =>
      exact .lam domainIH bodyIH
  | app _ _ functionIH argumentIH =>
      exact .app functionIH argumentIH
  | trans _ _ firstIH secondIH =>
      exact .trans firstIH secondIH

/-- A Pure common-reduct conversion translates to an LF common-reduct
conversion. -/
theorem encodeExpr_conv {left right : Pure.Expr}
    (hconv : PureBetaEta.Conv left right) :
    LFBetaEta.Conv [] (encodeExpr left) (encodeExpr right) := by
  cases hconv with
  | common leftReduction rightReduction =>
      exact .common (encodeExpr_reduces leftReduction)
        (encodeExpr_reduces rightReduction)

/-! ## Executable boundaries -/

private def pureType : Pure.Expr := .sort
private def pureIdentity : Pure.Expr := .lam pureType (.bvar 0)
private def pureEtaExpanded : Pure.Expr :=
  .lam pureType (.app (.bvar 1) (.bvar 0))

/-- Positive: beta conversion is preserved across the carrier boundary. -/
example :
    LFBetaEta.convBool [] PureBetaEta.normalizationFuel
      (encodeExpr (.app pureIdentity pureType)) (encodeExpr pureType) = true := by
  decide

/-- Positive: eta conversion needed by dependent argument types is preserved. -/
example :
    LFBetaEta.convBool [] PureBetaEta.normalizationFuel
      (encodeExpr pureEtaExpanded) (encodeExpr (.bvar 0)) = true := by
  decide

/-- Negative: unrelated Pure expressions remain non-convertible in LF. -/
example :
    LFBetaEta.convBool [] PureBetaEta.normalizationFuel
      (encodeExpr (.bvar 0)) (encodeExpr pureType) = false := by
  decide

