import Mettapedia.GSLT.LanguageDef.CostRegionBoundaryValueSuffix
import Mettapedia.OSLF.MeTTaIL.ReflectiveCanonicalKeyed

/-!
# Restoration across an availability suffix

Moving an ambient binder suffix from inert outer context into active
availability changes the root restoration depth.  Below a reflective quote,
however, both endpoints reset to the same local depth.  This module records
those two regimes and supplies their structural substitution congruence.
-/

namespace Mettapedia.GSLT.LanguageDef

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.DerivedContexts
open Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical
open Mettapedia.OSLF.MeTTaIL.ReflectiveSubstitution

namespace CostStaticAvailabilityRegime

/-- The large endpoint depth determined by one small endpoint depth. -/
def largeDepth (ambient : List TypeExpr) :
    CostStaticAvailabilityRegime → Nat → Nat
  | .exposed, depth => depth + ambient.length
  | .sealed, depth => depth

/-- Advancing below an ordinary binder commutes with the endpoint-depth map. -/
theorem largeDepth_add (ambient : List TypeExpr)
    (regime : CostStaticAvailabilityRegime) (depth amount : Nat) :
    largeDepth ambient regime (depth + amount) =
      largeDepth ambient regime depth + amount := by
  cases regime <;>
    simp [largeDepth, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]

/-- A nonempty ambient suffix makes the two regimes observably different at
the root. -/
theorem exposed_ne_sealed_of_ambient_ne_nil
    (ambient : List TypeExpr) (notEmpty : ambient ≠ []) :
    largeDepth ambient .exposed 0 ≠ largeDepth ambient .sealed 0 := by
  simp [largeDepth, List.length_eq_zero_iff, notEmpty]

/-- Availability regime at one exact structural occurrence.  An authored
quote seals the moved ambient suffix; all other context frames preserve the
current regime. -/
def atContext
    (profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile) :
    CostStaticAvailabilityRegime → OneHoleContext →
      CostStaticAvailabilityRegime
  | regime, .hole => regime
  | regime, .apply constructor _ inner _ =>
      atContext profile
        (if ReflectiveContextSupport.isQuoteConstructor profile constructor
          then .sealed else regime) inner
  | regime, .lambda _ inner => atContext profile regime inner
  | regime, .multiLambda _ _ inner => atContext profile regime inner
  | regime, .substBody inner _ => atContext profile regime inner
  | regime, .substReplacement _ inner => atContext profile regime inner
  | regime, .collection _ _ inner _ _ => atContext profile regime inner

/-- Regime tracking is compositional in structural zipper composition. -/
theorem atContext_comp
    (profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile)
    (regime : CostStaticAvailabilityRegime) (outer inner : OneHoleContext) :
    atContext profile regime (outer.comp inner) =
      atContext profile (atContext profile regime outer) inner := by
  induction outer generalizing regime with
  | hole => rfl
  | apply constructor before outer after inductionHypothesis =>
      simp only [OneHoleContext.comp, atContext]
      exact inductionHypothesis _
  | lambda binder outer inductionHypothesis =>
      simp only [OneHoleContext.comp, atContext]
      exact inductionHypothesis _
  | multiLambda arity binders outer inductionHypothesis =>
      simp only [OneHoleContext.comp, atContext]
      exact inductionHypothesis _
  | substBody outer replacement inductionHypothesis =>
      simp only [OneHoleContext.comp, atContext]
      exact inductionHypothesis _
  | substReplacement body outer inductionHypothesis =>
      simp only [OneHoleContext.comp, atContext]
      exact inductionHypothesis _
  | collection collectionType before outer after rest inductionHypothesis =>
      simp only [OneHoleContext.comp, atContext]
      exact inductionHypothesis _

end CostStaticAvailabilityRegime

namespace ReflectiveContextSupport

/-- Two patterns restore equally throughout availability transposition.

The assignments and support maps are endpoint-local.  Equality is required
at every depth pair generated by the exposed-or-sealed regime, so the
property remains stable below ordinary binders and reflective quote resets. -/
def AvailabilityTransposedRestoresTogether
    (profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile)
    (smallSupport : ContextSupport.Support)
    (smallAssignment : ContextSupport.Assignment)
    (largeSupport : ContextSupport.Support)
    (largeAssignment : ContextSupport.Assignment)
    (ambient : List TypeExpr) (regime : CostStaticAvailabilityRegime)
    (small large : Pattern) : Prop :=
  ∀ depth,
    substituteAt profile smallSupport smallAssignment depth small =
      substituteAt profile largeSupport largeAssignment
        (CostStaticAvailabilityRegime.largeDepth ambient regime depth) large

namespace AvailabilityTransposedRestoresTogether

private theorem map_substituteAt_eq_of_forall₂
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {small large : List Pattern}
    (related : List.Forall₂
      (AvailabilityTransposedRestoresTogether profile smallSupport
        smallAssignment largeSupport largeAssignment ambient regime) small large)
    (depth : Nat) :
    small.map (substituteAt profile smallSupport smallAssignment depth) =
      large.map
        (substituteAt profile largeSupport largeAssignment
          (CostStaticAvailabilityRegime.largeDepth ambient regime depth)) := by
  induction related with
  | nil => rfl
  | cons head tail inductionHypothesis =>
      simp only [List.map_cons, List.cons.injEq]
      exact ⟨head depth, inductionHypothesis⟩

/-- Bound variables are rigid under endpoint-local supported substitution. -/
theorem bvar
    (profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile)
    (smallSupport : ContextSupport.Support)
    (smallAssignment : ContextSupport.Assignment)
    (largeSupport : ContextSupport.Support)
    (largeAssignment : ContextSupport.Assignment)
    (ambient : List TypeExpr) (regime : CostStaticAvailabilityRegime)
    (index : Nat) :
    AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (.bvar index) (.bvar index) := by
  intro depth
  simp [substituteAt]

/-- An exposed free-variable leaf restores equally when its large-endpoint
support is exactly the small support followed by the moved ambient suffix and
both endpoints carry the same compact value. -/
theorem fvar_exposed
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {name : String}
    (supportEq : largeSupport name = smallSupport name ++ ambient)
    (assignmentEq : largeAssignment name = smallAssignment name) :
    AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient .exposed
      (.fvar name) (.fvar name) := by
  intro depth
  simp only [substituteAt, CostStaticAvailabilityRegime.largeDepth]
  rw [supportEq, assignmentEq, List.length_append]
  congr 1
  omega

/-- A sealed free-variable leaf restores equally when quotation has made its
two support entries and compact values identical. -/
theorem fvar_sealed
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {name : String}
    (supportEq : largeSupport name = smallSupport name)
    (assignmentEq : largeAssignment name = smallAssignment name) :
    AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient .sealed
      (.fvar name) (.fvar name) := by
  intro depth
  simp [substituteAt, CostStaticAvailabilityRegime.largeDepth, supportEq,
    assignmentEq]

/-- A free-variable parameter whose two endpoint assignments are the same
rigid free variable is independent of both support entries and substitution
depth.  This is the exact source-variable case: unlike a boundary value, its
assignment contains no ambient bound indices that need suffix accounting. -/
theorem fvar_rigid
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {smallName largeName valueName : String}
    (smallValue : smallAssignment smallName = .fvar valueName)
    (largeValue : largeAssignment largeName = .fvar valueName) :
    AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (.fvar smallName) (.fvar largeName) := by
  intro depth
  simp [substituteAt, smallValue, largeValue,
    Mettapedia.OSLF.MeTTaIL.Substitution.liftBVars]

/-- Equal closed assignment values restore identically at every pair of
endpoint depths, independently of both support entries.  This is the
boundary-value analogue of `fvar_rigid`: it is used precisely when a quote
reset has stored a closed compact value and canonicalization later exposes
that atom outside the quote. -/
theorem fvar_closed
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {smallName largeName : String} {value : Pattern}
    (smallValue : smallAssignment smallName = value)
    (largeValue : largeAssignment largeName = value)
    (closed : value.isWellScopedAt 0 = true) :
    AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (.fvar smallName) (.fvar largeName) := by
  intro depth
  simp only [substituteAt, smallValue, largeValue]
  rw [Mettapedia.OSLF.MeTTaIL.Substitution.liftBVars_eq_self_of_isWellScopedAt
      closed,
    Mettapedia.OSLF.MeTTaIL.Substitution.liftBVars_eq_self_of_isWellScopedAt
      closed]

/-- Structural applications preserve transposed restoration.  A reflective
quote switches the recursive call to the sealed regime. -/
theorem apply
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {constructor : String}
    {smallArguments largeArguments : List Pattern}
    (arguments : List.Forall₂
      (AvailabilityTransposedRestoresTogether profile smallSupport
        smallAssignment largeSupport largeAssignment ambient
          (if isQuoteConstructor profile constructor then .sealed else regime))
      smallArguments largeArguments) :
    AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (.apply constructor smallArguments) (.apply constructor largeArguments) := by
  intro depth
  simp only [substituteAt, Pattern.apply.injEq, true_and]
  by_cases quoted : isQuoteConstructor profile constructor = true
  · simpa [quoted, CostStaticAvailabilityRegime.largeDepth] using
      (map_substituteAt_eq_of_forall₂ arguments 0)
  · have ordinary : isQuoteConstructor profile constructor = false :=
      Bool.eq_false_of_not_eq_true quoted
    simpa [ordinary] using
      (map_substituteAt_eq_of_forall₂ arguments depth)

theorem lambda
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {binder : Option String}
    {smallBody largeBody : Pattern}
    (body : AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime smallBody
      largeBody) :
    AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (.lambda binder smallBody) (.lambda binder largeBody) := by
  intro depth
  simp only [substituteAt, Pattern.lambda.injEq, true_and]
  rw [← CostStaticAvailabilityRegime.largeDepth_add]
  exact body (depth + 1)

theorem multiLambda
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {arity : Nat} {binders : List String}
    {smallBody largeBody : Pattern}
    (body : AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime smallBody
      largeBody) :
    AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (.multiLambda arity binders smallBody)
      (.multiLambda arity binders largeBody) := by
  intro depth
  simp only [substituteAt, Pattern.multiLambda.injEq, true_and]
  rw [← CostStaticAvailabilityRegime.largeDepth_add]
  exact body (depth + arity)

theorem subst
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {smallBody largeBody smallReplacement largeReplacement : Pattern}
    (body : AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime smallBody
        largeBody)
    (replacement : AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
        smallReplacement largeReplacement) :
    AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (.subst smallBody smallReplacement)
      (.subst largeBody largeReplacement) := by
  intro depth
  simp only [substituteAt, Pattern.subst.injEq]
  rw [← CostStaticAvailabilityRegime.largeDepth_add]
  exact ⟨body (depth + 1), replacement depth⟩

theorem collection
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {collectionType : CollType}
    {smallElements largeElements : List Pattern} {rest : Option String}
    (elements : List.Forall₂
      (AvailabilityTransposedRestoresTogether profile smallSupport
        smallAssignment largeSupport largeAssignment ambient regime)
      smallElements largeElements) :
    AvailabilityTransposedRestoresTogether profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (.collection collectionType smallElements rest)
      (.collection collectionType largeElements rest) := by
  intro depth
  simp only [substituteAt, Pattern.collection.injEq, true_and, and_true]
  exact map_substituteAt_eq_of_forall₂ elements depth

/-! ### Path-indexed structural alignment

A uniform leaf relation is insufficient here: entering a reflective quote
changes the regime of every descendant.  The following indexed structural
relation records that transition in its application constructor. -/

mutual
  inductive AvailabilityTransposedPatternAligned
      (profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile)
      (smallSupport : ContextSupport.Support)
      (smallAssignment : ContextSupport.Assignment)
      (largeSupport : ContextSupport.Support)
      (largeAssignment : ContextSupport.Assignment)
      (ambient : List TypeExpr) :
      CostStaticAvailabilityRegime → Pattern → Pattern → Prop where
    | fvar {regime : CostStaticAvailabilityRegime}
        (smallName largeName : String)
        (restores : AvailabilityTransposedRestoresTogether profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
            (.fvar smallName) (.fvar largeName))
        (reexposes : regime = .sealed →
          AvailabilityTransposedRestoresTogether profile smallSupport
            smallAssignment largeSupport largeAssignment ambient .exposed
              (.fvar smallName) (.fvar largeName)) :
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
            (.fvar smallName) (.fvar largeName)
    | bvar (regime : CostStaticAvailabilityRegime) (index : Nat) :
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
            (.bvar index) (.bvar index)
    | apply (regime : CostStaticAvailabilityRegime) (constructor : String)
        {smallArguments largeArguments : List Pattern}
        (arguments : AvailabilityTransposedPatternAlignedList profile
          smallSupport smallAssignment largeSupport largeAssignment ambient
          (if isQuoteConstructor profile constructor then .sealed else regime)
          smallArguments largeArguments) :
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          (.apply constructor smallArguments) (.apply constructor largeArguments)
    | lambda (regime : CostStaticAvailabilityRegime) (binder : Option String)
        {smallBody largeBody : Pattern}
        (body : AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          smallBody largeBody) :
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          (.lambda binder smallBody) (.lambda binder largeBody)
    | multiLambda (regime : CostStaticAvailabilityRegime) (arity : Nat)
        (binders : List String) {smallBody largeBody : Pattern}
        (body : AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          smallBody largeBody) :
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          (.multiLambda arity binders smallBody)
          (.multiLambda arity binders largeBody)
    | subst (regime : CostStaticAvailabilityRegime)
        {smallBody largeBody smallReplacement largeReplacement : Pattern}
        (body : AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          smallBody largeBody)
        (replacement : AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          smallReplacement largeReplacement) :
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          (.subst smallBody smallReplacement)
          (.subst largeBody largeReplacement)
    | collection (regime : CostStaticAvailabilityRegime)
        (collectionType : CollType) (rest : Option String)
        {smallElements largeElements : List Pattern}
        (elements : AvailabilityTransposedPatternAlignedList profile
          smallSupport smallAssignment largeSupport largeAssignment ambient
          regime smallElements largeElements) :
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          (.collection collectionType smallElements rest)
          (.collection collectionType largeElements rest)

  inductive AvailabilityTransposedPatternAlignedList
      (profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile)
      (smallSupport : ContextSupport.Support)
      (smallAssignment : ContextSupport.Assignment)
      (largeSupport : ContextSupport.Support)
      (largeAssignment : ContextSupport.Assignment)
      (ambient : List TypeExpr) :
      CostStaticAvailabilityRegime → List Pattern → List Pattern → Prop where
    | nil (regime : CostStaticAvailabilityRegime) :
        AvailabilityTransposedPatternAlignedList profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime [] []
    | cons (regime : CostStaticAvailabilityRegime)
        {smallHead largeHead : Pattern} {smallTail largeTail : List Pattern}
        (head : AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          smallHead largeHead)
        (tail : AvailabilityTransposedPatternAlignedList profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          smallTail largeTail) :
        AvailabilityTransposedPatternAlignedList profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          (smallHead :: smallTail) (largeHead :: largeTail)
end

mutual
  /-- Forget the structural certificate while retaining its exact
  transposed-restoration equality. -/
  def AvailabilityTransposedPatternAligned.toRestoresTogether
      {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
      {smallSupport largeSupport : ContextSupport.Support}
      {smallAssignment largeAssignment : ContextSupport.Assignment}
      {ambient : List TypeExpr} :
      ∀ {regime small large},
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime small
            large →
        AvailabilityTransposedRestoresTogether profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime small
            large
    | _, _, _, .fvar _ _ restores _ => restores
    | regime, _, _, .bvar _ index =>
        AvailabilityTransposedRestoresTogether.bvar profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime index
    | _, _, _, .apply _ _ arguments =>
        AvailabilityTransposedRestoresTogether.apply
          (AvailabilityTransposedPatternAlignedList.toForall₂ arguments)
    | _, _, _, .lambda _ _ body =>
        AvailabilityTransposedRestoresTogether.lambda
          (AvailabilityTransposedPatternAligned.toRestoresTogether body)
    | _, _, _, .multiLambda _ _ _ body =>
        AvailabilityTransposedRestoresTogether.multiLambda
          (AvailabilityTransposedPatternAligned.toRestoresTogether body)
    | _, _, _, .subst _ body replacement =>
        AvailabilityTransposedRestoresTogether.subst
          (AvailabilityTransposedPatternAligned.toRestoresTogether body)
          (AvailabilityTransposedPatternAligned.toRestoresTogether replacement)
    | _, _, _, .collection _ _ _ elements =>
        AvailabilityTransposedRestoresTogether.collection
          (AvailabilityTransposedPatternAlignedList.toForall₂ elements)

  /-- Listwise companion of the structural eliminator. -/
  def AvailabilityTransposedPatternAlignedList.toForall₂
      {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
      {smallSupport largeSupport : ContextSupport.Support}
      {smallAssignment largeAssignment : ContextSupport.Assignment}
      {ambient : List TypeExpr} :
      ∀ {regime small large},
        AvailabilityTransposedPatternAlignedList profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime small
            large →
        List.Forall₂
          (AvailabilityTransposedRestoresTogether profile smallSupport
            smallAssignment largeSupport largeAssignment ambient regime)
          small large
    | _, _, _, .nil _ => .nil
    | _, _, _, .cons _ head tail =>
        .cons
          (AvailabilityTransposedPatternAligned.toRestoresTogether head)
          (AvailabilityTransposedPatternAlignedList.toForall₂ tail)
end

mutual
  /-- A sealed structural alignment can be returned to the exposed regime
  exactly when every sealed free-variable token carries its own re-exposure
  certificate.  This is the mode transition used when Quote/Drop finishing
  erases a quote shell. -/
  def AvailabilityTransposedPatternAligned.reexpose
      {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
      {smallSupport largeSupport : ContextSupport.Support}
      {smallAssignment largeAssignment : ContextSupport.Assignment}
      {ambient : List TypeExpr} :
      ∀ {small large},
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient .sealed small
            large →
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient .exposed small
            large
    | _, _, .fvar smallName largeName _ reexposes =>
        .fvar smallName largeName (reexposes rfl) (by
          intro impossible
          cases impossible)
    | _, _, .bvar _ index => .bvar .exposed index
    | _, _, .apply _ constructor arguments => by
        by_cases quoted : isQuoteConstructor profile constructor = true
        · exact .apply .exposed constructor (by simpa [quoted] using arguments)
        · simp only [quoted] at arguments
          exact .apply .exposed constructor (by
            simpa [quoted] using
              AvailabilityTransposedPatternAlignedList.reexpose
                arguments)
    | _, _, .lambda _ binder body =>
        .lambda .exposed binder
          (AvailabilityTransposedPatternAligned.reexpose body)
    | _, _, .multiLambda _ arity binders body =>
        .multiLambda .exposed arity binders
          (AvailabilityTransposedPatternAligned.reexpose body)
    | _, _, .subst _ body replacement =>
        .subst .exposed
          (AvailabilityTransposedPatternAligned.reexpose body)
          (AvailabilityTransposedPatternAligned.reexpose replacement)
    | _, _, .collection _ collectionType rest elements =>
        .collection .exposed collectionType rest
          (AvailabilityTransposedPatternAlignedList.reexpose elements)

  /-- Listwise companion of sealed-to-exposed structural transport. -/
  def AvailabilityTransposedPatternAlignedList.reexpose
      {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
      {smallSupport largeSupport : ContextSupport.Support}
      {smallAssignment largeAssignment : ContextSupport.Assignment}
      {ambient : List TypeExpr} :
      ∀ {small large},
        AvailabilityTransposedPatternAlignedList profile smallSupport
          smallAssignment largeSupport largeAssignment ambient .sealed small
            large →
        AvailabilityTransposedPatternAlignedList profile smallSupport
          smallAssignment largeSupport largeAssignment ambient .exposed small
            large
    | _, _, .nil _ => .nil .exposed
    | _, _, .cons _ head tail =>
        .cons .exposed
          (AvailabilityTransposedPatternAligned.reexpose head)
          (AvailabilityTransposedPatternAlignedList.reexpose tail)
end

/-- Retarget a quote-sealed alignment to its enclosing regime. -/
def AvailabilityTransposedPatternAligned.ofSealed
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {small large : Pattern}
    (aligned : AvailabilityTransposedPatternAligned profile smallSupport
      smallAssignment largeSupport largeAssignment ambient .sealed small large) :
    ∀ regime,
      AvailabilityTransposedPatternAligned profile smallSupport
        smallAssignment largeSupport largeAssignment ambient regime small large
  | .exposed => aligned.reexpose
  | .sealed => aligned

mutual
  /-- Structural availability alignment is natural under a constructor-symbol
  map that preserves exactly the reflective quote boundary.  Free-variable
  restoration is profile-independent at the leaf; the quote comparison is
  the only place where the reflection profile affects the recursion. -/
  def AvailabilityTransposedPatternAligned.mapPattern
      {sourceProfile targetProfile :
        Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
      {smallSupport largeSupport : ContextSupport.Support}
      {smallAssignment largeAssignment : ContextSupport.Assignment}
      {ambient : List TypeExpr}
      (symbols : LanguageDefSymbolMap)
      (quotePreserved : ∀ constructor,
        isQuoteConstructor targetProfile (symbols.constructor constructor) =
          isQuoteConstructor sourceProfile constructor) :
      ∀ {regime small large},
        AvailabilityTransposedPatternAligned sourceProfile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime small
            large →
        AvailabilityTransposedPatternAligned targetProfile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          (Mettapedia.GSLT.LanguageDef.mapPattern symbols small)
          (Mettapedia.GSLT.LanguageDef.mapPattern symbols large)
    | _, _, _, .fvar smallName largeName restores reexposes =>
        .fvar smallName largeName (by
          simpa [AvailabilityTransposedRestoresTogether,
            ReflectiveContextSupport.substituteAt] using restores) (by
          intro sealed
          simpa [AvailabilityTransposedRestoresTogether,
            ReflectiveContextSupport.substituteAt] using reexposes sealed)
    | regime, _, _, .bvar _ index => .bvar regime index
    | regime, _, _, .apply _ constructor arguments =>
        .apply regime (symbols.constructor constructor) (by
          rw [quotePreserved]
          exact AvailabilityTransposedPatternAlignedList.mapPattern symbols
            quotePreserved arguments)
    | regime, _, _, .lambda _ binder body =>
        .lambda regime binder
          (AvailabilityTransposedPatternAligned.mapPattern symbols
            quotePreserved body)
    | regime, _, _, .multiLambda _ arity binders body =>
        .multiLambda regime arity binders
          (AvailabilityTransposedPatternAligned.mapPattern symbols
            quotePreserved body)
    | regime, _, _, .subst _ body replacement =>
        .subst regime
          (AvailabilityTransposedPatternAligned.mapPattern symbols
            quotePreserved body)
          (AvailabilityTransposedPatternAligned.mapPattern symbols
            quotePreserved replacement)
    | regime, _, _, .collection _ collectionType rest elements =>
        .collection regime collectionType rest
          (AvailabilityTransposedPatternAlignedList.mapPattern symbols
            quotePreserved elements)

  /-- Listwise companion of constructor-symbol naturality. -/
  def AvailabilityTransposedPatternAlignedList.mapPattern
      {sourceProfile targetProfile :
        Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
      {smallSupport largeSupport : ContextSupport.Support}
      {smallAssignment largeAssignment : ContextSupport.Assignment}
      {ambient : List TypeExpr}
      (symbols : LanguageDefSymbolMap)
      (quotePreserved : ∀ constructor,
        isQuoteConstructor targetProfile (symbols.constructor constructor) =
          isQuoteConstructor sourceProfile constructor) :
      ∀ {regime small large},
        AvailabilityTransposedPatternAlignedList sourceProfile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime small
            large →
        AvailabilityTransposedPatternAlignedList targetProfile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
          (Mettapedia.GSLT.LanguageDef.mapPatternList symbols small)
          (Mettapedia.GSLT.LanguageDef.mapPatternList symbols large)
    | regime, _, _, .nil _ => .nil regime
    | regime, _, _, .cons _ head tail =>
        .cons regime
          (AvailabilityTransposedPatternAligned.mapPattern symbols
            quotePreserved head)
          (AvailabilityTransposedPatternAlignedList.mapPattern symbols
            quotePreserved tail)
end

mutual
  /-- Structural availability alignment preserves ordinary locally nameless
  scope exactly.  In particular, the large endpoint cannot gain a reference
  to an ambient binder that was absent from the small endpoint. -/
  def AvailabilityTransposedPatternAligned.isWellScopedAt_eq
      {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
      {smallSupport largeSupport : ContextSupport.Support}
      {smallAssignment largeAssignment : ContextSupport.Assignment}
      {ambient : List TypeExpr} :
      ∀ {regime small large},
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime small
            large →
        ∀ depth,
          small.isWellScopedAt depth = large.isWellScopedAt depth
    | _, _, _, .fvar _ _ _ _ , _ => rfl
    | _, _, _, .bvar _ _, _ => rfl
    | _, _, _, .apply _ _ arguments, depth =>
        AvailabilityTransposedPatternAlignedList.isWellScopedListAt_eq
          arguments depth
    | _, _, _, .lambda _ _ body, depth =>
        AvailabilityTransposedPatternAligned.isWellScopedAt_eq body
          (depth + 1)
    | _, _, _, .multiLambda _ arity _ body, depth =>
        AvailabilityTransposedPatternAligned.isWellScopedAt_eq body
          (depth + arity)
    | _, _, _, .subst _ body replacement, depth => by
        simp only [Pattern.isWellScopedAt]
        rw [AvailabilityTransposedPatternAligned.isWellScopedAt_eq body
          (depth + 1)]
        rw [AvailabilityTransposedPatternAligned.isWellScopedAt_eq replacement
          depth]
    | _, _, _, .collection _ _ _ elements, depth =>
        AvailabilityTransposedPatternAlignedList.isWellScopedListAt_eq
          elements depth

  /-- Listwise companion of exact scope preservation. -/
  def AvailabilityTransposedPatternAlignedList.isWellScopedListAt_eq
      {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
      {smallSupport largeSupport : ContextSupport.Support}
      {smallAssignment largeAssignment : ContextSupport.Assignment}
      {ambient : List TypeExpr} :
      ∀ {regime small large},
        AvailabilityTransposedPatternAlignedList profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime small
            large →
        ∀ depth,
          Pattern.isWellScopedListAt depth small =
            Pattern.isWellScopedListAt depth large
    | _, _, _, .nil _, _ => rfl
    | _, _, _, .cons _ head tail, depth => by
        simp only [Pattern.isWellScopedListAt]
        rw [AvailabilityTransposedPatternAligned.isWellScopedAt_eq head depth]
        rw [AvailabilityTransposedPatternAlignedList.isWellScopedListAt_eq tail
          depth]
end

/-- Forget only the list wrapper while retaining the full structural relation
at every corresponding position. -/
def AvailabilityTransposedPatternAlignedList.toForall₂Aligned
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} :
    ∀ {regime small large},
      AvailabilityTransposedPatternAlignedList profile smallSupport
        smallAssignment largeSupport largeAssignment ambient regime small large →
      List.Forall₂
        (AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime)
        small large
  | _, _, _, .nil _ => .nil
  | _, _, _, .cons _ head tail =>
      .cons head
        (AvailabilityTransposedPatternAlignedList.toForall₂Aligned tail)

/-- Rebuild the structural list wrapper from its pointwise relation. -/
def AvailabilityTransposedPatternAlignedList.ofForall₂Aligned
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} :
    ∀ {regime small large},
      List.Forall₂
        (AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime)
        small large →
      AvailabilityTransposedPatternAlignedList profile smallSupport
        smallAssignment largeSupport largeAssignment ambient regime small large
  | regime, _, _, .nil => .nil regime
  | regime, _, _, .cons head tail =>
      .cons regime head
        (AvailabilityTransposedPatternAlignedList.ofForall₂Aligned tail)

/-- Structural list alignment preserves emptiness in both directions. -/
theorem AvailabilityTransposedPatternAlignedList.eq_nil_iff
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {small large : List Pattern}
    (aligned : AvailabilityTransposedPatternAlignedList profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime small large) :
    small = [] ↔ large = [] := by
  cases aligned <;> simp

/-- Structurally aligned patterns agree on whether they are the selected
parallel unit. -/
theorem AvailabilityTransposedPatternAligned.parallelUnit_iff
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {small large : Pattern}
    (aligned : AvailabilityTransposedPatternAligned profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime small large)
    (declaration : ReflectivePresentationDecl) :
    small = .apply declaration.parallelUnitConstructor [] ↔
      large = .apply declaration.parallelUnitConstructor [] := by
  cases aligned with
  | apply current constructor arguments =>
      simp only [Pattern.apply.injEq]
      constructor
      · rintro ⟨constructorEq, smallNil⟩
        exact ⟨constructorEq, arguments.eq_nil_iff.mp smallNil⟩
      · rintro ⟨constructorEq, largeNil⟩
        exact ⟨constructorEq, arguments.eq_nil_iff.mpr largeNil⟩
  | fvar => simp
  | bvar => simp
  | lambda => simp
  | multiLambda => simp
  | subst => simp
  | collection => simp

/-- One-step parallel flattening preserves exact structural pairing.  Only a
genuine selected parallel collection with no rest tail is spliced. -/
theorem AvailabilityTransposedPatternAligned.parallelSplice
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {small large : Pattern}
    (aligned : AvailabilityTransposedPatternAligned profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime small large)
    (declaration : ReflectivePresentationDecl) :
    List.Forall₂
      (AvailabilityTransposedPatternAligned profile smallSupport
        smallAssignment largeSupport largeAssignment ambient regime)
      (Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.parallelSplice declaration
        small)
      (Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.parallelSplice declaration
        large) := by
  open Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical in
    cases aligned with
    | fvar smallName largeName restores reexposes =>
        exact .cons (.fvar smallName largeName restores reexposes) .nil
    | bvar _ index =>
        exact .cons (.bvar regime index) .nil
    | apply _ constructor arguments =>
        exact .cons (.apply regime constructor arguments) .nil
    | lambda _ binder body =>
        exact .cons (.lambda regime binder body) .nil
    | multiLambda _ arity binders body =>
        exact .cons (.multiLambda regime arity binders body) .nil
    | subst _ body replacement =>
        exact .cons (.subst regime body replacement) .nil
    | collection _ collectionType rest elements =>
        cases rest with
        | some restName =>
            exact .cons (.collection regime collectionType (some restName)
              elements) .nil
        | none =>
            by_cases parallel :
                collectionType = declaration.parallelCollection
            · subst collectionType
              simpa only [
                Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.parallelSplice,
                beq_self_eq_true, if_true] using elements.toForall₂Aligned
            · have notParallel :
                  (collectionType == declaration.parallelCollection) = false :=
                beq_eq_false_iff_ne.mpr parallel
              simpa [
                Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.parallelSplice,
                notParallel] using
                  (List.Forall₂.cons
                    (.collection regime collectionType none elements) (.nil))

/-- Flattening selected parallel collections and removing selected units
preserves exact structural pairing and occurrence multiplicity. -/
theorem AvailabilityTransposedPatternAlignedList.parallelContents
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {small large : List Pattern}
    (aligned : AvailabilityTransposedPatternAlignedList profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime small large)
    (declaration : ReflectivePresentationDecl) :
    AvailabilityTransposedPatternAlignedList profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.parallelContents declaration
        small)
      (Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.parallelContents declaration
        large) := by
  open Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical in
    apply AvailabilityTransposedPatternAlignedList.ofForall₂Aligned
    unfold Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.parallelContents
    have flattened : List.Forall₂
        (AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime)
        (small.flatMap (parallelSplice declaration))
        (large.flatMap (parallelSplice declaration)) := by
      apply List.rel_flatMap aligned.toForall₂Aligned
      intro left right related
      exact related.parallelSplice declaration
    apply List.rel_filter _ flattened
    intro left right related
    change
      (decide (left ≠ .apply declaration.parallelUnitConstructor []) = true) ↔
        (decide (right ≠ .apply declaration.parallelUnitConstructor []) = true)
    rw [decide_eq_true_iff, decide_eq_true_iff]
    exact not_congr (related.parallelUnit_iff declaration)

/-- Stable semantic-key sorting preserves the exact transposed leaf pairing.
The endpoint keys may be different functions; equality after restoration is
the only comparison agreement required. -/
theorem AvailabilityTransposedPatternAlignedList.sortPatternsBy
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {small large : List Pattern}
    (aligned : AvailabilityTransposedPatternAlignedList profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime small large)
    (depth : Nat) :
    AvailabilityTransposedPatternAlignedList profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (Mettapedia.OSLF.MeTTaIL.PatternCode.sortPatternsBy
        (fun pattern =>
          Mettapedia.OSLF.MeTTaIL.PatternCode.patternCode
            (ReflectiveContextSupport.substituteAt profile smallSupport
              smallAssignment depth pattern)) small)
      (Mettapedia.OSLF.MeTTaIL.PatternCode.sortPatternsBy
        (fun pattern =>
          Mettapedia.OSLF.MeTTaIL.PatternCode.patternCode
            (ReflectiveContextSupport.substituteAt profile largeSupport
              largeAssignment
                (CostStaticAvailabilityRegime.largeDepth ambient regime depth)
                  pattern)) large) := by
  apply AvailabilityTransposedPatternAlignedList.ofForall₂Aligned
  apply Mettapedia.OSLF.MeTTaIL.PatternCode.sortPatternsBy_forall₂
    _ _ aligned.toForall₂Aligned
  intro smallPattern largePattern related
  exact congrArg Mettapedia.OSLF.MeTTaIL.PatternCode.patternCode
    (related.toRestoresTogether depth)

/-- The complete keyed parallel-frontier pass preserves positional
availability-transposed alignment: flattening, unit deletion, and stable
sorting are discharged by the preceding phase lemmas. -/
theorem AvailabilityTransposedPatternAlignedList.normalizeParallelElementsBy
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {small large : List Pattern}
    (aligned : AvailabilityTransposedPatternAlignedList profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime small large)
    (declaration : ReflectivePresentationDecl) (depth : Nat) :
    AvailabilityTransposedPatternAlignedList profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime
      (Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.normalizeParallelElementsBy
        (fun pattern =>
          Mettapedia.OSLF.MeTTaIL.PatternCode.patternCode
            (ReflectiveContextSupport.substituteAt profile smallSupport
              smallAssignment depth pattern)) declaration small)
      (Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.normalizeParallelElementsBy
        (fun pattern =>
          Mettapedia.OSLF.MeTTaIL.PatternCode.patternCode
            (ReflectiveContextSupport.substituteAt profile largeSupport
              largeAssignment
                (CostStaticAvailabilityRegime.largeDepth ambient regime depth)
                  pattern)) declaration large) := by
  unfold Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.normalizeParallelElementsBy
  exact (aligned.parallelContents declaration).sortPatternsBy depth

/-- Rebuilding a selected parallel frontier preserves alignment in the empty,
singleton, and proper-bag cases. -/
theorem AvailabilityTransposedPatternAlignedList.collapseParallel
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {small large : List Pattern}
    (aligned : AvailabilityTransposedPatternAlignedList profile smallSupport
      smallAssignment largeSupport largeAssignment ambient regime small large)
    (declaration : ReflectivePresentationDecl) :
    AvailabilityTransposedPatternAligned profile smallSupport smallAssignment
      largeSupport largeAssignment ambient regime
      (Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.collapseParallel declaration
        small)
      (Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.collapseParallel declaration
        large) := by
  cases aligned with
  | nil _ =>
      exact .apply regime declaration.parallelUnitConstructor
        (.nil (if isQuoteConstructor profile declaration.parallelUnitConstructor
          then .sealed else regime))
  | cons _ head tail =>
      cases tail with
      | nil _ =>
          simpa [Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.collapseParallel]
            using head
      | cons _ second rest =>
          simpa [Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.collapseParallel]
            using (.collection regime declaration.parallelCollection none
              (.cons regime head (.cons regime second rest)))

open Mettapedia.OSLF.MeTTaIL.ReflectiveSubstitution in
/-- Quote/Drop finishing preserves availability-transposed alignment.  The
only mode-changing case is an actual quote/drop fire; its sealed payload is
returned to the enclosing regime through the payload token's re-exposure
certificate. -/
theorem AvailabilityTransposedPatternAlignedList.finishNormalizeReflectiveApplyAligned
    {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
    {smallSupport largeSupport : ContextSupport.Support}
    {smallAssignment largeAssignment : ContextSupport.Assignment}
    {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
    {small large : List Pattern} (constructor : String)
    (aligned : AvailabilityTransposedPatternAlignedList profile smallSupport
      smallAssignment largeSupport largeAssignment ambient
        (if isQuoteConstructor profile constructor then .sealed else regime)
          small large)
    (declaration : ReflectivePresentationDecl)
    (quoteRecognized :
      isQuoteConstructor profile declaration.quoteConstructor = true) :
    AvailabilityTransposedPatternAligned profile smallSupport smallAssignment
      largeSupport largeAssignment ambient regime
      (finishNormalizeReflectiveApply declaration constructor small)
      (finishNormalizeReflectiveApply declaration constructor large) := by
  by_cases quoteHead :
      (constructor == declaration.quoteConstructor) = true
  · have constructorEq : constructor = declaration.quoteConstructor :=
      beq_iff_eq.mp quoteHead
    have sealedAligned : AvailabilityTransposedPatternAlignedList profile
        smallSupport smallAssignment largeSupport largeAssignment ambient
          .sealed small large := by
      simpa [constructorEq, quoteRecognized] using aligned
    have wrapArguments {left right : List Pattern}
        (arguments : AvailabilityTransposedPatternAlignedList profile
          smallSupport smallAssignment largeSupport largeAssignment ambient
            .sealed left right) :
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
            (.apply constructor left) (.apply constructor right) := by
      exact .apply regime constructor (by
        simpa [constructorEq, quoteRecognized] using arguments)
    have wrapSingleton {left right : Pattern}
        (head : AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient .sealed left
            right) :
        AvailabilityTransposedPatternAligned profile smallSupport
          smallAssignment largeSupport largeAssignment ambient regime
            (.apply constructor [left]) (.apply constructor [right]) :=
      wrapArguments (.cons .sealed head (.nil .sealed))
    cases sealedAligned with
    | nil _ =>
        simpa [finishNormalizeReflectiveApply, constructorEq] using
          wrapArguments (.nil .sealed)
    | cons _ head tail =>
        cases tail with
        | cons _ second rest =>
            simpa [finishNormalizeReflectiveApply, constructorEq] using
              wrapArguments (.cons .sealed head
                (.cons .sealed second rest))
        | nil _ =>
            cases head with
            | fvar smallName largeName restores reexposes =>
                simpa [finishNormalizeReflectiveApply, constructorEq] using
                  wrapSingleton (.fvar smallName largeName restores reexposes)
            | bvar _ index =>
                simpa [finishNormalizeReflectiveApply, constructorEq] using
                  wrapSingleton (.bvar .sealed index)
            | lambda _ binder body =>
                simpa [finishNormalizeReflectiveApply, constructorEq] using
                  wrapSingleton (.lambda .sealed binder body)
            | multiLambda _ arity binders body =>
                simpa [finishNormalizeReflectiveApply, constructorEq] using
                  wrapSingleton (.multiLambda .sealed arity binders body)
            | subst _ body replacement =>
                simpa [finishNormalizeReflectiveApply, constructorEq] using
                  wrapSingleton (.subst .sealed body replacement)
            | collection _ collectionType rest elements =>
                simpa [finishNormalizeReflectiveApply, constructorEq] using
                  wrapSingleton
                    (.collection .sealed collectionType rest elements)
            | apply _ innerHead innerArguments =>
                simp at innerArguments
                have wrapInner {left right : List Pattern}
                    (arguments : AvailabilityTransposedPatternAlignedList
                      profile smallSupport smallAssignment largeSupport
                        largeAssignment ambient .sealed left right) :
                    AvailabilityTransposedPatternAligned profile smallSupport
                      smallAssignment largeSupport largeAssignment ambient
                        .sealed (.apply innerHead left)
                          (.apply innerHead right) := by
                  exact .apply .sealed innerHead (by simpa using arguments)
                cases innerArguments with
                | nil _ =>
                    simpa [finishNormalizeReflectiveApply, constructorEq] using
                      wrapSingleton (wrapInner (.nil .sealed))
                | cons _ payload payloadTail =>
                    cases payloadTail with
                    | cons _ secondPayload restPayload =>
                        simpa [finishNormalizeReflectiveApply, constructorEq]
                          using wrapSingleton (wrapInner
                            (.cons .sealed payload
                              (.cons .sealed secondPayload restPayload)))
                    | nil _ =>
                        by_cases dropHead :
                            (innerHead == declaration.dropConstructor) = true
                        · simpa [finishNormalizeReflectiveApply, constructorEq,
                            dropHead] using payload.ofSealed regime
                        · simpa [finishNormalizeReflectiveApply, constructorEq,
                            dropHead] using
                            wrapSingleton (wrapInner
                              (.cons .sealed payload (.nil .sealed)))
  · have quoteHeadFalse :
        (constructor == declaration.quoteConstructor) = false :=
      Bool.eq_false_of_not_eq_true quoteHead
    simpa [finishNormalizeReflectiveApply, quoteHeadFalse] using
      (AvailabilityTransposedPatternAligned.apply regime constructor aligned)

mutual
  /-- Keyed reflective canonicalization preserves structural availability
  transposition when its ordering keys are the two endpoint-local restoration
  evaluations. -/
  def AvailabilityTransposedPatternAligned.canonicalizeByAt
      {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
      {smallSupport largeSupport : ContextSupport.Support}
      {smallAssignment largeAssignment : ContextSupport.Assignment}
      {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
      {small large : Pattern}
      (aligned : AvailabilityTransposedPatternAligned profile smallSupport
        smallAssignment largeSupport largeAssignment ambient regime small large)
      (declaration : ReflectivePresentationDecl)
      (quoteRecognized :
        isQuoteConstructor profile declaration.quoteConstructor = true)
      (supported : ConstructorsWithin
        (fun candidate => isQuoteConstructor profile candidate = true ↔
          candidate = declaration.quoteConstructor) small)
      (depth : Nat) :
      AvailabilityTransposedPatternAligned profile smallSupport
        smallAssignment largeSupport largeAssignment ambient regime
        (canonicalizeByAt
          (fun current pattern =>
            Mettapedia.OSLF.MeTTaIL.PatternCode.patternCode
              (ReflectiveContextSupport.substituteAt profile smallSupport
                smallAssignment current pattern))
          declaration depth small)
        (canonicalizeByAt
          (fun current pattern =>
            Mettapedia.OSLF.MeTTaIL.PatternCode.patternCode
              (ReflectiveContextSupport.substituteAt profile largeSupport
                largeAssignment current pattern))
          declaration
            (CostStaticAvailabilityRegime.largeDepth ambient regime depth)
              large) :=
    match aligned with
    | .fvar smallName largeName restores reexposes =>
        .fvar smallName largeName restores reexposes
    | .bvar current index => .bvar current index
    | .apply current constructor arguments => by
        by_cases quoted : constructor = declaration.quoteConstructor
        · have recognized : isQuoteConstructor profile constructor = true :=
            supported.1.mpr quoted
          have normalizedArguments :=
            AvailabilityTransposedPatternAlignedList.canonicalizeByAt
              arguments declaration quoteRecognized supported.2 0
          simpa [Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.canonicalizeByAt,
            quoted, recognized, quoteRecognized,
            CostStaticAvailabilityRegime.largeDepth] using
            normalizedArguments.finishNormalizeReflectiveApplyAligned
              constructor declaration quoteRecognized
        · have notRecognized :
              isQuoteConstructor profile constructor ≠ true := by
            intro recognized
            exact quoted (supported.1.mp recognized)
          have normalizedArguments :=
            AvailabilityTransposedPatternAlignedList.canonicalizeByAt
              arguments declaration quoteRecognized supported.2 depth
          simpa [Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.canonicalizeByAt,
            quoted, notRecognized] using
            normalizedArguments.finishNormalizeReflectiveApplyAligned
              constructor declaration quoteRecognized
    | .lambda current binder body => by
        simpa [Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.canonicalizeByAt,
          CostStaticAvailabilityRegime.largeDepth_add] using
          AvailabilityTransposedPatternAligned.lambda current binder
            (AvailabilityTransposedPatternAligned.canonicalizeByAt body
              declaration quoteRecognized supported (depth + 1))
    | .multiLambda current arity binders body => by
        simpa [Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.canonicalizeByAt,
          CostStaticAvailabilityRegime.largeDepth_add] using
          AvailabilityTransposedPatternAligned.multiLambda current arity
            binders
            (AvailabilityTransposedPatternAligned.canonicalizeByAt body
              declaration quoteRecognized supported (depth + arity))
    | .subst current body replacement => by
        simpa [Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.canonicalizeByAt,
          CostStaticAvailabilityRegime.largeDepth_add] using
          AvailabilityTransposedPatternAligned.subst current
            (AvailabilityTransposedPatternAligned.canonicalizeByAt body
              declaration quoteRecognized supported.1 (depth + 1))
            (AvailabilityTransposedPatternAligned.canonicalizeByAt replacement
              declaration quoteRecognized supported.2 depth)
    | .collection current collectionType rest elements => by
        have normalizedElements :=
          AvailabilityTransposedPatternAlignedList.canonicalizeByAt elements
            declaration quoteRecognized supported depth
        cases rest with
        | some restName =>
            simpa [Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.canonicalizeByAt]
              using AvailabilityTransposedPatternAligned.collection current
                collectionType (some restName) normalizedElements
        | none =>
            by_cases selected :
                collectionType = declaration.parallelCollection
            · subst collectionType
              have sorted := normalizedElements.normalizeParallelElementsBy
                declaration depth
              simpa [Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.canonicalizeByAt]
                using sorted.collapseParallel declaration
            · have selectedFalse :
                  (collectionType == declaration.parallelCollection) = false :=
                beq_eq_false_iff_ne.mpr selected
              simpa [Mettapedia.OSLF.MeTTaIL.ReflectiveCanonical.canonicalizeByAt,
                selectedFalse] using
                AvailabilityTransposedPatternAligned.collection current
                  collectionType none normalizedElements

  /-- Listwise companion of endpoint-local keyed canonicalization. -/
  def AvailabilityTransposedPatternAlignedList.canonicalizeByAt
      {profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile}
      {smallSupport largeSupport : ContextSupport.Support}
      {smallAssignment largeAssignment : ContextSupport.Assignment}
      {ambient : List TypeExpr} {regime : CostStaticAvailabilityRegime}
      {small large : List Pattern}
      (aligned : AvailabilityTransposedPatternAlignedList profile smallSupport
        smallAssignment largeSupport largeAssignment ambient regime small large)
      (declaration : ReflectivePresentationDecl)
      (quoteRecognized :
        isQuoteConstructor profile declaration.quoteConstructor = true)
      (supported : ConstructorListWithin
        (fun candidate => isQuoteConstructor profile candidate = true ↔
          candidate = declaration.quoteConstructor) small)
      (depth : Nat) :
      AvailabilityTransposedPatternAlignedList profile smallSupport
        smallAssignment largeSupport largeAssignment ambient regime
        (canonicalizeListByAt
          (fun current pattern =>
            Mettapedia.OSLF.MeTTaIL.PatternCode.patternCode
              (ReflectiveContextSupport.substituteAt profile smallSupport
                smallAssignment current pattern))
          declaration depth small)
        (canonicalizeListByAt
          (fun current pattern =>
            Mettapedia.OSLF.MeTTaIL.PatternCode.patternCode
              (ReflectiveContextSupport.substituteAt profile largeSupport
                largeAssignment current pattern))
          declaration
            (CostStaticAvailabilityRegime.largeDepth ambient regime depth)
              large) :=
    match aligned with
    | .nil current => .nil current
    | .cons current head tail =>
        .cons current
          (AvailabilityTransposedPatternAligned.canonicalizeByAt head
            declaration quoteRecognized supported.1 depth)
          (AvailabilityTransposedPatternAlignedList.canonicalizeByAt tail
            declaration quoteRecognized supported.2 depth)
end

/-- Negative canary: if both endpoints retain empty support for a genuinely
open assigned bound variable, exposing one ambient binder changes its value.
The exposed support suffix is therefore a load-bearing part of the later
boundary theorem. -/
theorem empty_support_bvar_assignment_not_availabilityTransposed
    (profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile)
    (binderType : TypeExpr) :
    let support : ContextSupport.Support := fun _ => []
    let assignment : ContextSupport.Assignment := fun _ => .bvar 0
    ¬ AvailabilityTransposedRestoresTogether profile support assignment
      support assignment [binderType] .exposed (.fvar "x") (.fvar "x") := by
  dsimp only
  intro restores
  have exposed := restores 0
  simp [substituteAt, CostStaticAvailabilityRegime.largeDepth,
    Mettapedia.OSLF.MeTTaIL.Substitution.liftBVars] at exposed

/-- Negative canary for quote-local binders: equal nonempty sealed supports
and equal open values do not imply that the atom may be re-exposed across an
ambient suffix.  Any producer of re-exposure must therefore retain ancestry
or a closed-value certificate, rather than derive it from the positional
value relation alone. -/
theorem nonempty_sealed_bvar_assignment_not_reexposed
    (profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile)
    (binderType : TypeExpr) :
    let support : ContextSupport.Support := fun _ => [binderType]
    let assignment : ContextSupport.Assignment := fun _ => .bvar 0
    ¬ AvailabilityTransposedRestoresTogether profile support assignment
      support assignment [binderType] .exposed (.fvar "x") (.fvar "x") := by
  dsimp only
  intro restores
  have exposed := restores 1
  simp [substituteAt, CostStaticAvailabilityRegime.largeDepth,
    Mettapedia.OSLF.MeTTaIL.Substitution.liftBVars] at exposed

/-- Positive canary: adding the ambient suffix to the support entry exactly
cancels the added exposed depth, even for an open bound-variable value. -/
theorem exposed_support_suffix_bvar_assignment_restores
    (profile : Mettapedia.OSLF.MeTTaIL.Reflection.ReflectionProfile)
    (binderType : TypeExpr) :
    let smallSupport : ContextSupport.Support := fun _ => []
    let largeSupport : ContextSupport.Support := fun name =>
      if name = "x" then [binderType] else []
    let assignment : ContextSupport.Assignment := fun _ => .bvar 0
    AvailabilityTransposedRestoresTogether profile smallSupport assignment
      largeSupport assignment [binderType] .exposed (.fvar "x") (.fvar "x") := by
  dsimp only
  apply fvar_exposed
  · simp
  · rfl

end AvailabilityTransposedRestoresTogether

end ReflectiveContextSupport

end Mettapedia.GSLT.LanguageDef
