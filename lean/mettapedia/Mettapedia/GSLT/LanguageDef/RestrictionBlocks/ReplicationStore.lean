import Mettapedia.GSLT.LanguageDef.RestrictionBlocks.ReplicationPresentations

/-!
# A store for a calculus with restriction and replication

A process is stored as its canonical block (`canonP`): its restrictions and its canonical components. Its steps are
read off the store by a plan the calculus gives (`StorePlan`): the keys a component reacts on, the parts of a redex
sharing one, and what parts in a redex's order leave (`fire`).

- **Entries** (`storeEntryOf`): a component stands for itself; a replicated component generates its copy, read again as an
  unfolding reads it, and is never consumed.
- **Candidates** (`StorePlan.candidates`): for each key, the words over the entries on that key, at most as long as the
  calculus's arity, that take each standing component at most as often as it stands.
- **Successors** (`StorePlan.successors`): what each candidate's parts leave, beside the store's components and the
  copies the candidate takes, less the parts, under the store's restrictions.

When every replicated component of the store copies one component (`flatServers`):

- **No invented step** (`StorePlan.successors_sound`): every successor is equivalent to the contractum of a step of an
  unfolding of the store within the arity, a presentation of the canonical form.
- **Every step covered** (`StorePlan.successors_complete`): every step of a process ends at a process equivalent to a
  successor of its store. The step is a reaction of an unfolding of the canonical form whose parts are components of
  the store or copies of its replicated components (`compress_parts`); its parts share a key, so the word of their
  entries is a candidate.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.LanguageDef.RestrictionBlocks

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.GSLT.LanguageDef.EquationSemantics (EquationEquiv)
open Mettapedia.OSLF.MeTTaIL.Engine (RelationEnv)
open Mettapedia.OSLF.MeTTaIL.ContextualStep (engineBasePremises)
open Mettapedia.GSLT.LanguageDef.WellSorted

/-! ## Entries -/

/-- **An entry of a store**: a guard that may react, standing in the store or generated by a replicated component. -/
structure StoreEntry where
  guard : Pattern
  generated : Bool
deriving DecidableEq

variable {block : ReplicationBlock}

/-- **The entry of a component**: a component stands for itself; a replicated component generates its copy, read again
as an unfolding reads it. -/
def storeEntryOf (block : ReplicationBlock) (component : Pattern) : StoreEntry :=
  match replicatedArgument block component with
  | some argument => ⟨recanon block argument, true⟩
  | none => ⟨component, false⟩

theorem replicatedArgument_of_plain {component : Pattern} (plain : isReplicated block component = false) :
    replicatedArgument block component = none := by
  match component, plain with
  | .apply label [argument], plain =>
      simp only [isReplicated, beq_eq_false_iff_ne, ne_eq] at plain
      simp [replicatedArgument, plain]
  | .bvar _, _ | .fvar _, _ | .lambda _ _, _ | .multiLambda _ _ _, _ | .subst _ _, _ | .collection _ _ _, _ => rfl
  | .apply _ [], _ => rfl
  | .apply _ (_ :: _ :: _), _ => rfl

/-- An entry stands for its component, or is generated by a replicated component. -/
theorem storeEntryOf_spec {component : Pattern} :
    (replicatedArgument block component = none ∧ storeEntryOf block component = ⟨component, false⟩) ∨
      ∃ argument, component = .apply block.replicate [argument] ∧
        storeEntryOf block component = ⟨recanon block argument, true⟩ := by
  unfold storeEntryOf
  split
  · rename_i argument replicated
    exact .inr ⟨argument, mem_replicatedArgument.mp replicated, rfl⟩
  · rename_i none
    exact .inl ⟨none, rfl⟩

/-- **The entries of a store.** -/
abbrev storeEntries (block : ReplicationBlock) (form : Prenex) : List StoreEntry := form.components.map (storeEntryOf block)

/-! ## Words -/

/-- The words of a length over an alphabet. -/
def words {α : Type} (alphabet : List α) : Nat → List (List α)
  | 0 => [[]]
  | length + 1 => (words alphabet length).flatMap fun word => alphabet.map (· :: word)

theorem mem_words {α : Type} {alphabet : List α} : ∀ {length : Nat} {word : List α},
    word ∈ words alphabet length ↔ word.length = length ∧ ∀ letter ∈ word, letter ∈ alphabet
  | 0, word => by
      simp only [words, List.mem_singleton]
      constructor
      · rintro rfl
        simp
      · rintro ⟨empty, -⟩
        exact List.eq_nil_of_length_eq_zero empty
  | length + 1, word => by
      simp only [words, List.mem_flatMap, List.mem_map]
      constructor
      · rintro ⟨rest, inWords, letter, inAlphabet, rfl⟩
        obtain ⟨restLength, restLetters⟩ := mem_words.mp inWords
        refine ⟨by simp [restLength], ?_⟩
        intro other member
        rcases List.mem_cons.mp member with rfl | later
        · exact inAlphabet
        · exact restLetters other later
      · rintro ⟨wordLength, letters⟩
        match word, wordLength with
        | letter :: rest, restLength =>
            refine ⟨rest, mem_words.mpr ⟨by simpa using restLength, fun other member =>
              letters other (List.mem_cons_of_mem _ member)⟩, letter, letters letter List.mem_cons_self, rfl⟩

/-! ## The plan -/

section Plan

variable {language : LanguageDef} [laws : ReplicationLanguage language block]
variable {step : Pattern → Pattern → Prop}

/-- **A store plan for a calculus's reactions**: the keys a component reacts on, a redex's parts sharing one, and
what parts in a redex's order leave, by every redex they make. -/
structure StorePlan (reactions : ReplicationReactions language block step) (Key : Type) where
  keys : Pattern → List Key
  fire : List Pattern → List (List Pattern)
  /-- What `fire` lists is left by a redex with those parts. -/
  fire_sound : ∀ {parts result : List Pattern}, result ∈ fire parts →
    ∃ redex, reactions.parts redex = parts ∧ reactions.result redex = result
  /-- `fire` lists what every redex leaves. -/
  fire_complete : ∀ redex, reactions.result redex ∈ fire (reactions.parts redex)
  /-- **A redex's parts share a key.** -/
  keys_complete : ∀ redex, reactions.parts redex ≠ [] → ∃ key, ∀ part ∈ reactions.parts redex, key ∈ keys part

variable {reactions : ReplicationReactions language block step} {Key : Type} [DecidableEq Key]

private instance : LawfulBEq Pattern where
  rfl := by intro value; change decide (value = value) = true; simp
  eq_of_beq := by intro left right same; change decide (left = right) = true at same; exact of_decide_eq_true same

/-- **A word takes each standing component of a store at most as often as it stands.** -/
def takesStanding (form : Prenex) (word : List StoreEntry) : Bool :=
  ((word.filter fun entry => !entry.generated).map StoreEntry.guard).isSubperm form.components

/-- The store's components beside the copies a word takes. -/
def wordElements (form : Prenex) (word : List StoreEntry) : List Pattern :=
  form.components ++ (word.filter StoreEntry.generated).map StoreEntry.guard

namespace StorePlan

variable (plan : StorePlan reactions Key)

/-- **The candidates of a store**: for each key, the words over the entries on that key, at most as long as the
arity, taking each standing component at most as often as it stands; and the empty word. -/
def candidates (form : Prenex) : List (List StoreEntry) :=
  let entries := storeEntries block form
  [] :: ((entries.flatMap fun entry => plan.keys entry.guard).dedup.flatMap fun key =>
    let group := (entries.filter fun entry => decide (key ∈ plan.keys entry.guard)).dedup
    ((List.range reactions.arity).flatMap fun length => words group (length + 1)).filter (takesStanding form))

/-- **What a word's parts leave**, beside the store's components and the copies the word takes, less the parts, under
the store's restrictions. -/
def fireWord (form : Prenex) (word : List StoreEntry) : List Pattern :=
  (plan.fire (word.map StoreEntry.guard)).map fun result =>
    Prenex.restricts block.toBlock form.count
      (.collection .hashBag (result ++ (wordElements form word).diff (word.map StoreEntry.guard)) none)

/-- **The successors of a store.** -/
def successors (form : Prenex) : List Pattern := (plan.candidates form).flatMap (plan.fireWord form)

omit laws in
/-- A candidate's letters are entries of the store, it takes each standing component at most as often as it stands,
and it is at most as long as the arity. -/
theorem candidates_spec {form : Prenex} {word : List StoreEntry} (member : word ∈ plan.candidates form) :
    (∀ letter ∈ word, letter ∈ storeEntries block form) ∧ takesStanding form word = true ∧
      word.length ≤ reactions.arity := by
  simp only [candidates, List.mem_cons, List.mem_flatMap, List.mem_filter, List.mem_range] at member
  rcases member with rfl | ⟨key, -, ⟨length, below, inWords⟩, takes⟩
  · refine ⟨by simp, ?_, by simp⟩
    simp [takesStanding, List.isSubperm_iff]
  · obtain ⟨wordLength, letters⟩ := mem_words.mp inWords
    refine ⟨fun letter member => ?_, takes, by omega⟩
    have inGroup := letters letter member
    rw [List.mem_dedup, List.mem_filter] at inGroup
    exact inGroup.1

omit laws in
/-- **A word of entries on one key is a candidate**, when it takes each standing component at most as often as it
stands and is at most as long as the arity. -/
theorem mem_candidates {form : Prenex} {word : List StoreEntry} {key : Key}
    (letters : ∀ letter ∈ word, letter ∈ storeEntries block form ∧ key ∈ plan.keys letter.guard)
    (takes : takesStanding form word = true) (short : word.length ≤ reactions.arity) :
    word ∈ plan.candidates form := by
  match word, letters, short with
  | [], _, _ => exact List.mem_cons_self
  | first :: rest, letters, short =>
      simp only [candidates]
      apply List.mem_cons_of_mem
      simp only [List.mem_flatMap, List.mem_filter, List.mem_range]
      obtain ⟨firstIn, firstKey⟩ := letters first List.mem_cons_self
      refine ⟨key, List.mem_dedup.mpr (List.mem_flatMap.mpr ⟨first, firstIn, firstKey⟩), ⟨rest.length,
        by simp only [List.length_cons] at short; omega, mem_words.mpr ⟨rfl, ?_⟩⟩, takes⟩
      intro letter member
      obtain ⟨letterIn, letterKey⟩ := letters letter member
      exact List.mem_dedup.mpr (List.mem_filter.mpr ⟨letterIn, decide_eq_true letterKey⟩)

omit laws in
theorem mem_successors {form : Prenex} {next : Pattern} :
    next ∈ plan.successors form ↔ ∃ word ∈ plan.candidates form, ∃ result ∈ plan.fire (word.map StoreEntry.guard),
      next = Prenex.restricts block.toBlock form.count
        (.collection .hashBag (result ++ (wordElements form word).diff (word.map StoreEntry.guard)) none) := by
  simp only [successors, fireWord, List.mem_flatMap, List.mem_map]
  constructor
  · rintro ⟨word, inCandidates, result, fired, rfl⟩
    exact ⟨word, inCandidates, result, fired, rfl⟩
  · rintro ⟨word, inCandidates, result, fired, rfl⟩
    exact ⟨word, inCandidates, result, fired, rfl⟩

end StorePlan

/-! ## Lists of parts -/

/-- The difference of a list beginning with another by that other is the rest. -/
theorem append_diff_self : ∀ (first rest : List Pattern), (first ++ rest).diff first = rest
  | [], rest => by simp
  | head :: tail, rest => by
      rw [List.diff_cons, List.cons_append, List.erase_cons_head]
      exact append_diff_self tail rest

/-- **Tagging the members of a permutation of two lists**: a word whose guards are the list, its standing letters
those of the first list, its generated letters those of the second. -/
theorem word_of_perm : ∀ {parts first second : List Pattern}, parts.Perm (first ++ second) →
    ∃ word : List StoreEntry, word.map StoreEntry.guard = parts ∧
      ((word.filter fun entry => !entry.generated).map StoreEntry.guard).Perm first ∧
      ((word.filter StoreEntry.generated).map StoreEntry.guard).Perm second
  | [], first, second, perm => by
      obtain ⟨firstNil, secondNil⟩ := List.append_eq_nil_iff.mp (List.perm_nil.mp perm.symm)
      subst firstNil secondNil
      exact ⟨[], rfl, List.Perm.refl _, List.Perm.refl _⟩
  | part :: parts, first, second, perm => by
      by_cases inFirst : part ∈ first
      · have rest : parts.Perm (first.erase part ++ second) :=
          (List.perm_cons part).mp (perm.trans ((List.perm_cons_erase inFirst).append_right second))
        obtain ⟨word, mapIs, standing, generated⟩ := word_of_perm rest
        refine ⟨⟨part, false⟩ :: word, by simp [mapIs], ?_, ?_⟩
        · rw [List.filter_cons_of_pos (by rfl), List.map_cons]
          exact (standing.cons part).trans (List.perm_cons_erase inFirst).symm
        · rw [List.filter_cons_of_neg (by simp)]
          exact generated
      · have inSecond : part ∈ second := by
          have inBoth := perm.subset (List.mem_cons_self (a := part) (l := parts))
          rcases List.mem_append.mp inBoth with here | there
          · exact absurd here inFirst
          · exact there
        have moved : (first ++ second).Perm (part :: (first ++ second.erase part)) :=
          ((List.perm_cons_erase inSecond).append_left first).trans List.perm_middle
        have rest : parts.Perm (first ++ second.erase part) := (List.perm_cons part).mp (perm.trans moved)
        obtain ⟨word, mapIs, standing, generated⟩ := word_of_perm rest
        refine ⟨⟨part, true⟩ :: word, by simp [mapIs], ?_, ?_⟩
        · rw [List.filter_cons_of_neg (by simp)]
          exact standing
        · rw [List.filter_cons_of_pos (by rfl), List.map_cons]
          exact (generated.cons part).trans (List.perm_cons_erase inSecond).symm

/-- A word's guards are its standing guards beside its generated ones. -/
theorem guards_perm (word : List StoreEntry) :
    (word.map StoreEntry.guard).Perm (((word.filter fun entry => !entry.generated).map StoreEntry.guard) ++
      (word.filter StoreEntry.generated).map StoreEntry.guard) := by
  rw [← List.map_append]
  refine List.Perm.map _ ?_
  have split := List.filter_append_perm (fun entry : StoreEntry => !entry.generated) word
  simp only [Bool.not_not] at split
  exact split.symm

/-- **The copies a word's generated entries take are copies of the store's replicated components**, when they copy
one component each. -/
theorem generated_pairs {form : Prenex} (flat : flatServers block form = true) :
    ∀ word : List StoreEntry, (∀ letter ∈ word, letter ∈ storeEntries block form) →
      ∃ pairs : List (Pattern × Pattern),
        pairs.map Prod.snd = (word.filter StoreEntry.generated).map StoreEntry.guard ∧ pairs.length ≤ word.length ∧
        ∀ pair ∈ pairs, ∃ argument, pair.1 = .apply block.replicate [argument] ∧ pair.1 ∈ form.components ∧
          decompose block.toBlock argument = Prenex.atom argument ∧ pair.2 = recanon block argument
  | [], _ => ⟨[], rfl, le_refl _, by simp⟩
  | letter :: word, letters => by
      obtain ⟨pairs, pairsMap, pairsLength, pairsFacts⟩ :=
        generated_pairs flat word fun other member => letters other (List.mem_cons_of_mem _ member)
      obtain ⟨component, inForm, found⟩ := List.mem_map.mp (letters letter List.mem_cons_self)
      rcases storeEntryOf_spec (block := block) (component := component) with ⟨-, standing⟩ | ⟨argument, componentIs, copy⟩
      · rw [standing] at found
        subst found
        refine ⟨pairs, by simpa using pairsMap, by simp only [List.length_cons]; omega, pairsFacts⟩
      · rw [copy] at found
        subst found
        refine ⟨(component, recanon block argument) :: pairs, by simp [pairsMap],
          by simp only [List.length_cons]; omega, ?_⟩
        intro pair member
        rcases List.mem_cons.mp member with rfl | later
        · exact ⟨argument, componentIs, inForm,
            (flatServers_spec flat component inForm argument componentIs).1, rfl⟩
        · exact pairsFacts pair later

/-! ## The store's components are typed -/

include laws in
/-- **The components of a store are processes**, past its restrictions, and object terms. -/
theorem store_members {free : FreeTypeContext} {bound : List TypeExpr} (context : BaseContext free bound)
    {source : Pattern} (sourceTyped : HasType language free bound source (.base block.proc))
    (sourceObject : isObjectPattern source = true) :
    Members language block.toBlock free
        (List.replicate (canonP block source).count (TypeExpr.base block.name) ++ bound)
        (canonP block source).components ∧
      ∀ component ∈ (canonP block source).components, isObjectPattern component = true := by
  have fresh := replicate_not_emptyUnit (block := block) (language := language)
  have restrictFresh := replicate_ne_restrict (block := block) (language := language)
  have facts := canonFacts fresh restrictFresh sourceObject (restrictionsBind_of_typed (block := block) source sourceTyped)
  have decomposed : decompose block.toBlock (canonR block source) = canonP block source := by
    unfold canonR
    exact decompose_toPattern facts.atomic facts.used
  obtain ⟨canonTyped, -⟩ := canonR_sound (block := block) context sourceTyped
  obtain ⟨members, -⟩ := decompose_sound (block := block.toBlock) canonTyped
  have objects := objects_of_decompose (block := block.toBlock) (isObject_canonR (block := block) sourceObject)
  rw [decomposed] at members objects
  exact ⟨members, objects⟩

/-! ## No invented step -/

include laws in
/-- **No invented step**: when the store's replicated components copy one component each, every successor of the store
is equivalent to the contractum of a step of an unfolding of the store within the arity. -/
theorem StorePlan.successors_sound (plan : StorePlan reactions Key) {free : FreeTypeContext}
    {bound : List TypeExpr} (context : BaseContext free bound) {source : Pattern}
    (sourceTyped : HasType language free bound source (.base block.proc))
    (sourceObject : isObjectPattern source = true) (flat : flatServers block (canonP block source) = true)
    {next : Pattern} (member : next ∈ plan.successors (canonP block source)) :
    (∃ unfolded, UnfoldsWithin block reactions.arity (canonP block source) unfolded ∧
      ∃ target, step (unfolded.toPattern block.toBlock) target ∧
        EquationEquiv (engineBasePremises RelationEnv.empty) language target next) ∧
      HasType language free bound next (.base block.proc) ∧ isObjectPattern next = true := by
  have fresh := replicate_not_emptyUnit (block := block) (language := language)
  have restrictFresh := replicate_ne_restrict (block := block) (language := language)
  set form := canonP block source with formIs
  obtain ⟨formMembers, formObjects⟩ := store_members context sourceTyped sourceObject
  rw [← formIs] at formMembers formObjects
  obtain ⟨word, inCandidates, result, fired, rfl⟩ := plan.mem_successors.mp member
  obtain ⟨letters, takes, short⟩ := plan.candidates_spec inCandidates
  obtain ⟨redex, partsIs, resultIs⟩ := plan.fire_sound fired
  -- the store beside the copies the word takes is an unfolding within the arity
  obtain ⟨pairs, pairsMap, pairsLength, pairsFacts⟩ := generated_pairs flat word letters
  have unfolds : UnfoldsWithin block reactions.arity form ⟨form.count, wordElements form word⟩ := by
    have within := unfoldsWithin_copies fresh restrictFresh pairs pairsFacts
    rw [pairsMap] at within
    exact within.mono (pairsLength.trans short)
  have members := unfolds.members context formMembers
  have objects := unfolds.objects formObjects
  -- the word's parts are among those components
  have partsSub : (word.map StoreEntry.guard).Subperm (wordElements form word) := by
    have standing : ((word.filter fun entry => !entry.generated).map StoreEntry.guard).Subperm form.components :=
      List.isSubperm_iff.mp takes
    unfold wordElements
    exact (guards_perm word).subperm_right.mpr ((List.subperm_append_right _).mpr standing)
  have split : (wordElements form word).Perm (reactions.parts redex ++
      (wordElements form word).diff (word.map StoreEntry.guard)) := by
    rw [partsIs]
    exact (List.subperm_append_diff_self_of_count_le fun part _ => List.Subperm.count_le partsSub part).symm
  obtain ⟨contracted, stepped, contractedIs⟩ := reactions.react redex split members objects
  -- what the parts leave is a process
  have partsMembers : Members language block.toBlock free
      (List.replicate form.count (TypeExpr.base block.name) ++ bound) (reactions.parts redex) := by
    rw [partsIs]
    exact fun part inParts => members part (partsSub.subset inParts)
  have partsObjects : ∀ part ∈ reactions.parts redex, isObjectPattern part = true := by
    rw [partsIs]
    exact fun part inParts => objects part (partsSub.subset inParts)
  have leftMembers : Members language block.toBlock free
      (List.replicate form.count (TypeExpr.base block.name) ++ bound)
      (result ++ (wordElements form word).diff (word.map StoreEntry.guard)) := by
    rw [← resultIs]
    intro element inLeft
    rcases List.mem_append.mp inLeft with inResult | inRest
    · exact reactions.result_members redex partsMembers element inResult
    · exact members element (List.diff_subset _ _ inRest)
  have leftObjects : ∀ element ∈ result ++ (wordElements form word).diff (word.map StoreEntry.guard),
      isObjectPattern element = true := by
    rw [← resultIs]
    intro element inLeft
    rcases List.mem_append.mp inLeft with inResult | inRest
    · exact reactions.result_objects redex partsObjects element inResult
    · exact objects element (List.diff_subset _ _ inRest)
  refine ⟨⟨⟨form.count, wordElements form word⟩, unfolds, Prenex.restricts block.toBlock form.count contracted,
    reactions.restricts_step form.count stepped, ?_⟩, restricts_typed form.count (bag_typed leftMembers), ?_⟩
  · rw [← resultIs]
    exact restricts_equation (block := block.toBlock) form.count contractedIs
  · rw [isObject_restricts, isObject_bag]
    exact leftObjects

/-! ## Every step covered -/

include laws in
/-- **Every step covered**: when the store's replicated components copy one component each, every step of a process
ends at a process equivalent to a successor of its store. -/
theorem StorePlan.successors_complete (plan : StorePlan reactions Key) {free : FreeTypeContext}
    {bound : List TypeExpr} (context : BaseContext free bound) {source target : Pattern} {count : Nat}
    {redex : reactions.Redex} {rest : List Pattern}
    (reached : ReplicationStepAt reactions free bound source target count redex rest)
    (sourceTyped : HasType language free bound source (.base block.proc))
    (sourceObject : isObjectPattern source = true) (flat : flatServers block (canonP block source) = true) :
    ∃ next ∈ plan.successors (canonP block source),
      EquationEquiv (engineBasePremises RelationEnv.empty) language next target := by
  -- the step is a reaction of an unfolding, its parts components of the store or copies of its replicated components
  obtain ⟨unfolded, unfolds, redex', restU, split, plain, members, -, reaches⟩ :=
    replication_reaction reactions context reached sourceTyped sourceObject
  obtain ⟨sameCount, taken, restK, chosen, formPerm, partsPerm, chosenFacts, inUnfolded, absorbed⟩ :=
    compress_parts reactions context (flatServers_spec flat) unfolds split plain members
  set form := canonP block source with formIs
  rw [sameCount] at members
  -- the word of the parts' entries
  obtain ⟨word, wordMap, standing, generated⟩ := word_of_perm partsPerm
  have letters : ∀ letter ∈ word, letter ∈ storeEntries block form := by
    intro letter member
    obtain ⟨guard, flag⟩ := letter
    have inParts : guard ∈ reactions.parts redex' := by
      rw [← wordMap]
      exact List.mem_map_of_mem (f := StoreEntry.guard) member
    cases flag with
    | false =>
        have inTaken : guard ∈ taken := standing.subset
          (List.mem_map_of_mem (f := StoreEntry.guard) (List.mem_filter.mpr ⟨member, rfl⟩))
        refine List.mem_map.mpr ⟨guard, formPerm.symm.subset (List.mem_append_left _ inTaken), ?_⟩
        unfold storeEntryOf
        rw [replicatedArgument_of_plain (plain guard inParts)]
    | true =>
        have inChosen : guard ∈ chosen.map Prod.snd := generated.subset
          (List.mem_map_of_mem (f := StoreEntry.guard) (List.mem_filter.mpr ⟨member, rfl⟩))
        obtain ⟨pair, pairIn, rfl⟩ := List.mem_map.mp inChosen
        obtain ⟨argument, serverIs, serverIn, -, copyIs⟩ := chosenFacts pair pairIn
        refine List.mem_map.mpr ⟨pair.1, formPerm.symm.subset (List.mem_append_right _ serverIn), ?_⟩
        unfold storeEntryOf
        rw [serverIs, mem_replicatedArgument.mpr rfl, copyIs]
  have takes : takesStanding form word = true :=
    List.isSubperm_iff.mpr (List.Subperm.trans (List.Subperm.trans standing.subperm
      (List.sublist_append_left taken restK).subperm) formPerm.symm.subperm)
  have short : word.length ≤ reactions.arity := by
    have sameLength := congrArg List.length wordMap
    rw [List.length_map] at sameLength
    rw [sameLength]
    exact reactions.arity_le redex'
  have candidate : word ∈ plan.candidates form := by
    by_cases empty : reactions.parts redex' = []
    · have wordNil : word = [] := List.map_eq_nil_iff.mp (wordMap.trans empty)
      subst wordNil
      exact List.mem_cons_self
    · obtain ⟨key, shared⟩ := plan.keys_complete redex' empty
      refine plan.mem_candidates (key := key) (fun letter member => ⟨letters letter member, ?_⟩) takes short
      exact shared letter.guard (wordMap ▸ List.mem_map_of_mem (f := StoreEntry.guard) member)
  have fired : reactions.result redex' ∈ plan.fire (word.map StoreEntry.guard) := by
    rw [wordMap]
    exact plan.fire_complete redex'
  refine ⟨_, plan.mem_successors.mpr ⟨word, candidate, _, fired, rfl⟩, ?_⟩
  -- what the parts leave beside the rest of the store
  have elementsPerm : (wordElements form word).Perm (reactions.parts redex' ++ restK) := by
    have middle : ((taken ++ restK) ++ chosen.map Prod.snd).Perm ((taken ++ chosen.map Prod.snd) ++ restK) := by
      rw [List.append_assoc, List.append_assoc]
      exact List.perm_append_comm.append_left taken
    exact (formPerm.append_right _).trans ((List.Perm.append_left _ generated).trans
      (middle.trans (partsPerm.symm.append_right restK)))
  have restPerm : ((wordElements form word).diff (word.map StoreEntry.guard)).Perm restK := by
    rw [wordMap]
    have diffed := elementsPerm.diff_right (reactions.parts redex')
    rwa [append_diff_self] at diffed
  have partsMembers : Members language block.toBlock free
      (List.replicate form.count (TypeExpr.base block.name) ++ bound) (reactions.parts redex') :=
    fun part member => members part (split.symm.subset (List.mem_append_left _ member))
  have bagMembers : Members language block.toBlock free
      (List.replicate form.count (TypeExpr.base block.name) ++ bound)
      (reactions.result redex' ++ (wordElements form word).diff (word.map StoreEntry.guard)) := by
    intro element member
    rcases List.mem_append.mp member with inResult | inRest
    · exact reactions.result_members redex' partsMembers element inResult
    · have inRestK := restPerm.subset inRest
      exact members element (inUnfolded element (List.mem_append_left _
        (formPerm.symm.subset (List.mem_append_right _ inRestK))))
  have same := restricts_equation (block := block.toBlock) form.count
    (bag_perm_equivalent (block := block) bagMembers (restPerm.append_left _)).toEquationEquiv
  exact Relation.EqvGen.trans _ _ _ same (Relation.EqvGen.trans _ _ _ absorbed reaches)

end Plan

end Mettapedia.GSLT.LanguageDef.RestrictionBlocks
