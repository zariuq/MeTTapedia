import Mathlib.CategoryTheory.Grothendieck
import Mettapedia.GSLT.LanguageDef.PiInstitutionCategory
import Mettapedia.GSLT.LanguageDef.ClosedTheorySemanticTarget

/-!
# The theory graph: closed theories over varying consequence institutions

The category of Pi-institutions lets whole logics vary, while the category
of closed theories fixes one institution.  The theory graph is their
Grothendieck construction: an object selects one institution and one closed
theory in it, and a morphism is an institution comorphism together with a
theory morphism from the direct image of the source theory to the target
theory.  This is the consequence-level Grothendieck institution of
Diaconescu, and the little-theories graph of Farmer, Guttman, and Thayer with
the logic allowed to change along an arrow.

Composition, the forgetful functor to institutions, and the faithful inclusion
of each fibre of closed theories over a fixed institution all come from
Mathlib's `Grothendieck`.  What is specific here is the functor of closed
theories along comorphisms: the direct image of a closed theory is the theory
generated by its translated theorems, and consequence preservation makes this
functorial.  A closed theory also has a semantic NIK reading, and every arrow
of the theory graph transports it.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace Mettapedia.GSLT.LanguageDef.TheoryGraph

open CategoryTheory
open scoped CategoryTheory
open Mettapedia.GSLT.LanguageDef.NIKMetalogic

universe uSignature uHom uSentence

/-! ## Direct image of closed theories along a comorphism -/

section DirectImage

variable {SourceSignature TargetSignature : Type uSignature}
  [CategoryTheory.Category.{uHom} SourceSignature]
  [CategoryTheory.Category.{uHom} TargetSignature]
  {source : PiInstitution.{uSignature, uHom, uSentence} SourceSignature}
  {target : PiInstitution.{uSignature, uHom, uSentence} TargetSignature}

/-- The closed theory generated by the translated theorems of a closed
theory. -/
def directImage (route : PiInstitution.Comorphism source target)
    (theory : PiInstitution.TheoryObject source) : PiInstitution.TheoryObject target :=
  PiInstitution.generatedTheory target (route.mapSignature.obj theory.signature)
    (Set.image (route.mapSentence theory.signature) theory.theory.1)

@[simp]
theorem directImage_signature (route : PiInstitution.Comorphism source target)
    (theory : PiInstitution.TheoryObject source) :
    (directImage route theory).signature = route.mapSignature.obj theory.signature :=
  rfl

theorem mem_directImage_iff (route : PiInstitution.Comorphism source target)
    (theory : PiInstitution.TheoryObject source)
    (formula : target.sentence.obj (route.mapSignature.obj theory.signature)) :
    formula ∈ (directImage route theory).theory.1 ↔
      formula ∈ target.consequence (route.mapSignature.obj theory.signature)
        (Set.image (route.mapSentence theory.signature) theory.theory.1) :=
  Iff.rfl

/-- Every translated source theorem is a theorem of the direct image. -/
theorem mapSentence_mem_directImage (route : PiInstitution.Comorphism source target)
    (theory : PiInstitution.TheoryObject source)
    {formula : source.sentence.obj theory.signature} (theoremhood : formula ∈ theory.theory.1) :
    route.mapSentence theory.signature formula ∈ (directImage route theory).theory.1 :=
  (target.consequence _).le_closure _ (Set.mem_image_of_mem _ theoremhood)

/-- Direct image acts on theory morphisms through the signature functor. -/
def directImageHom (route : PiInstitution.Comorphism source target)
    {first second : PiInstitution.TheoryObject source}
    (morphism : PiInstitution.TheoryHom first second) :
    PiInstitution.TheoryHom (directImage route first) (directImage route second) where
  mapSignature := route.mapSignature.map morphism.mapSignature
  preserves := by
    intro formula theoremhood
    have transported := target.translation (route.mapSignature.map morphism.mapSignature) _
      (Set.mem_image_of_mem _ theoremhood)
    refine (target.consequence _).monotone ?_ transported
    rintro _ ⟨_, ⟨sourceFormula, sourceMember, rfl⟩, rfl⟩
    rw [route.mapSentence_natural]
    exact ⟨_, morphism.preserves sourceMember, rfl⟩

/-- The direct-image functor of closed theories along a comorphism. -/
def directImageFunctor (route : PiInstitution.Comorphism source target) :
    CategoryTheory.Functor (PiInstitution.TheoryObject source)
      (PiInstitution.TheoryObject target) where
  obj := directImage route
  map := directImageHom route
  map_id theory := by
    apply PiInstitution.TheoryHom.ext
    exact route.mapSignature.map_id theory.signature
  map_comp earlier later := by
    apply PiInstitution.TheoryHom.ext
    exact route.mapSignature.map_comp earlier.mapSignature later.mapSignature

end DirectImage

/-! ## Functoriality in the comorphism -/

section Functoriality

variable {Signature : Type uSignature} [CategoryTheory.Category.{uHom} Signature]

theorem directImage_identity {institution : PiInstitution.{uSignature, uHom, uSentence} Signature}
    (theory : PiInstitution.TheoryObject institution) :
    directImage (PiInstitution.Comorphism.identity institution) theory = theory := by
  rcases theory with ⟨signature, formulas, closed⟩
  have closedImage :
      institution.consequence signature (Set.image (fun formula => formula) formulas) =
        formulas := by
    rw [Set.image_id']
    exact closed
  exact congrArg (fun theory : institution.Theory signature =>
    (⟨signature, theory⟩ : PiInstitution.TheoryObject institution)) (Subtype.ext closedImage)

variable {FirstSignature MiddleSignature LastSignature : Type uSignature}
  [CategoryTheory.Category.{uHom} FirstSignature]
  [CategoryTheory.Category.{uHom} MiddleSignature]
  [CategoryTheory.Category.{uHom} LastSignature]
  {first : PiInstitution.{uSignature, uHom, uSentence} FirstSignature}
  {middle : PiInstitution.{uSignature, uHom, uSentence} MiddleSignature}
  {last : PiInstitution.{uSignature, uHom, uSentence} LastSignature}

theorem directImage_comp (earlier : PiInstitution.Comorphism first middle)
    (later : PiInstitution.Comorphism middle last)
    (theory : PiInstitution.TheoryObject first) :
    directImage (PiInstitution.Comorphism.comp earlier later) theory =
      directImage later (directImage earlier theory) := by
  rcases theory with ⟨signature, formulas, closed⟩
  apply congrArg (fun theory : last.Theory (later.mapSignature.obj (earlier.mapSignature.obj signature)) =>
    (⟨later.mapSignature.obj (earlier.mapSignature.obj signature), theory⟩ :
      PiInstitution.TheoryObject last))
  apply Subtype.ext
  change last.consequence _
      (Set.image (fun formula => later.mapSentence _ (earlier.mapSentence signature formula)) formulas) =
    last.consequence _
      (Set.image (later.mapSentence _)
        (middle.consequence _ (Set.image (earlier.mapSentence signature) formulas)))
  apply le_antisymm
  · apply (last.consequence _).monotone
    rw [← Set.image_image]
    exact Set.image_mono ((middle.consequence _).le_closure _)
  · have inner : Set.image (later.mapSentence _)
        (middle.consequence _ (Set.image (earlier.mapSentence signature) formulas)) ⊆
          last.consequence _
            (Set.image (later.mapSentence _) (Set.image (earlier.mapSentence signature) formulas)) := by
      rintro _ ⟨formula, formulaMember, rfl⟩
      exact later.preserves _ _ formula formulaMember
    calc last.consequence _
          (Set.image (later.mapSentence _)
            (middle.consequence _ (Set.image (earlier.mapSentence signature) formulas)))
        ≤ last.consequence _ (last.consequence _
            (Set.image (later.mapSentence _) (Set.image (earlier.mapSentence signature) formulas))) :=
          (last.consequence _).monotone inner
      _ = last.consequence _
            (Set.image (later.mapSentence _) (Set.image (earlier.mapSentence signature) formulas)) :=
          (last.consequence _).idempotent _
      _ = last.consequence _
            (Set.image (fun formula => later.mapSentence _ (earlier.mapSentence signature formula))
              formulas) := by
          rw [Set.image_image]

end Functoriality

/-- The signature component of a theory-morphism equality transport. -/
theorem eqToHom_mapSignature {Signature : Type uSignature} [CategoryTheory.Category.{uHom} Signature]
    {institution : PiInstitution.{uSignature, uHom, uSentence} Signature}
    {left right : PiInstitution.TheoryObject institution} (equal : left = right) :
    (eqToHom equal).mapSignature = eqToHom (congrArg PiInstitution.TheoryObject.signature equal) := by
  subst equal
  rfl

@[simp]
theorem theoryHom_id_mapSignature {Signature : Type uSignature}
    [CategoryTheory.Category.{uHom} Signature]
    {institution : PiInstitution.{uSignature, uHom, uSentence} Signature}
    (theory : PiInstitution.TheoryObject institution) :
    (CategoryTheory.CategoryStruct.id theory : PiInstitution.TheoryHom theory theory).mapSignature =
      CategoryTheory.CategoryStruct.id theory.signature :=
  rfl

@[simp]
theorem theoryHom_comp_mapSignature {Signature : Type uSignature}
    [CategoryTheory.Category.{uHom} Signature]
    {institution : PiInstitution.{uSignature, uHom, uSentence} Signature}
    {first middle last : PiInstitution.TheoryObject institution}
    (earlier : first ⟶ middle) (later : middle ⟶ last) :
    (earlier ≫ later).mapSignature = earlier.mapSignature ≫ later.mapSignature :=
  rfl

@[simp]
theorem directImageHom_mapSignature {SourceSignature TargetSignature : Type uSignature}
    [CategoryTheory.Category.{uHom} SourceSignature]
    [CategoryTheory.Category.{uHom} TargetSignature]
    {source : PiInstitution.{uSignature, uHom, uSentence} SourceSignature}
    {target : PiInstitution.{uSignature, uHom, uSentence} TargetSignature}
    (route : PiInstitution.Comorphism source target)
    {first second : PiInstitution.TheoryObject source}
    (morphism : PiInstitution.TheoryHom first second) :
    (directImageHom route morphism).mapSignature = route.mapSignature.map morphism.mapSignature :=
  rfl

/-! ## Closed theories fibred over institutions -/

/-- Closed theories, fibred over consequence institutions: the functor whose
Grothendieck construction is the theory graph. -/
def closedTheories :
    CategoryTheory.Functor PiInstitutionCategory.Object.{uSignature, uHom, uSentence}
      Cat.{uHom, max uSignature uSentence} where
  obj institution := Cat.of (PiInstitution.TheoryObject institution.logic)
  map route := (directImageFunctor route).toCatHom
  map_id institution := by
    apply Cat.ext
    refine CategoryTheory.Functor.ext (fun theory => directImage_identity theory) ?_
    intro first second morphism
    apply PiInstitution.TheoryHom.ext
    change (directImageHom (CategoryTheory.CategoryStruct.id institution) morphism).mapSignature =
      (eqToHom _ ≫ morphism ≫ eqToHom _).mapSignature
    rw [theoryHom_comp_mapSignature, theoryHom_comp_mapSignature, eqToHom_mapSignature,
      eqToHom_mapSignature, directImageHom_mapSignature]
    change morphism.mapSignature =
      CategoryTheory.CategoryStruct.id first.signature ≫ morphism.mapSignature ≫
        CategoryTheory.CategoryStruct.id second.signature
    simp
  map_comp earlier later := by
    apply Cat.ext
    refine CategoryTheory.Functor.ext (fun theory => directImage_comp earlier later theory) ?_
    intro first second morphism
    apply PiInstitution.TheoryHom.ext
    change (directImageHom (earlier ≫ later) morphism).mapSignature =
      (eqToHom _ ≫ (directImageFunctor earlier ⋙ directImageFunctor later).map morphism ≫
        eqToHom _).mapSignature
    rw [theoryHom_comp_mapSignature, theoryHom_comp_mapSignature, eqToHom_mapSignature,
      eqToHom_mapSignature]
    change later.mapSignature.map (earlier.mapSignature.map morphism.mapSignature) =
      CategoryTheory.CategoryStruct.id _ ≫
        later.mapSignature.map (earlier.mapSignature.map morphism.mapSignature) ≫
          CategoryTheory.CategoryStruct.id _
    simp

/-- The theory graph: closed theories over varying consequence institutions,
as a Grothendieck construction. -/
abbrev Object := Grothendieck closedTheories.{uSignature, uHom, uSentence}

/-- The forgetful functor from the theory graph to institutions. -/
def forgetInstitution :
    CategoryTheory.Functor Object.{uSignature, uHom, uSentence}
      PiInstitutionCategory.Object.{uSignature, uHom, uSentence} :=
  Grothendieck.forget closedTheories

/-- The closed theories of one fixed institution are the vertical fibre over
it; the inclusion is faithful. -/
def fibre (institution : PiInstitutionCategory.Object.{uSignature, uHom, uSentence}) :
    CategoryTheory.Functor (PiInstitution.TheoryObject institution.logic)
      Object.{uSignature, uHom, uSentence} :=
  Grothendieck.ι closedTheories institution

instance fibre_faithful
    (institution : PiInstitutionCategory.Object.{uSignature, uHom, uSentence}) :
    (fibre institution).Faithful :=
  Grothendieck.faithful_ι (F := closedTheories) institution

/-! ## Convenient construction and destruction of arrows -/

/-- An object of the theory graph from its three components. -/
def Object.mk' {Signature : Type uSignature} [CategoryTheory.Category.{uHom} Signature]
    (institution : PiInstitution.{uSignature, uHom, uSentence} Signature)
    (logical : PiInstitution.TheoryObject institution) : Object.{uSignature, uHom, uSentence} :=
  ⟨⟨Cat.of Signature, institution⟩, logical⟩

/-- The institution selected by an object. -/
abbrev Object.institution (object : Object.{uSignature, uHom, uSentence}) :
    PiInstitution.{uSignature, uHom, uSentence} object.base.Signature :=
  object.base.logic

/-- The closed theory selected by an object. -/
abbrev Object.logical (object : Object.{uSignature, uHom, uSentence}) :
    PiInstitution.TheoryObject object.base.logic :=
  object.fiber

/-- Translate a sentence along the institution route and then along the
selected target-signature morphism. -/
def translateSentence {source target : Object.{uSignature, uHom, uSentence}}
    (institution : PiInstitution.Comorphism source.institution target.institution)
    (mapSignature : institution.mapSignature.obj source.logical.signature ⟶
      target.logical.signature)
    (formula : source.institution.sentence.obj source.logical.signature) :
    target.institution.sentence.obj target.logical.signature :=
  target.institution.sentence.map mapSignature
    (institution.mapSentence source.logical.signature formula)

/-- An arrow from a comorphism, a signature morphism out of the translated
signature, and preservation of the selected source theorems.  Preservation of
the whole direct image follows from closure. -/
def Hom.mk {source target : Object.{uSignature, uHom, uSentence}}
    (institution : PiInstitution.Comorphism source.institution target.institution)
    (mapSignature : institution.mapSignature.obj source.logical.signature ⟶
      target.logical.signature)
    (preserves : ∀ {formula}, formula ∈ source.logical.theory.1 →
      translateSentence institution mapSignature formula ∈ target.logical.theory.1) :
    source ⟶ target where
  base := institution
  fiber :=
    { mapSignature := mapSignature
      preserves := by
        intro formula theoremhood
        have transported := target.institution.translation mapSignature _
          (Set.mem_image_of_mem _ theoremhood)
        have closed : target.institution.consequence target.logical.signature
            target.logical.theory.1 = target.logical.theory.1 := target.logical.theory.2
        rw [← closed]
        refine (target.institution.consequence _).monotone ?_ transported
        rintro _ ⟨_, ⟨sourceFormula, sourceMember, rfl⟩, rfl⟩
        exact preserves sourceMember }

/-- The institution route of an arrow. -/
abbrev Hom.institution {source target : Object.{uSignature, uHom, uSentence}}
    (route : source ⟶ target) : PiInstitution.Comorphism source.institution target.institution :=
  route.base

/-- The selected-signature morphism of an arrow. -/
abbrev Hom.mapSignature {source target : Object.{uSignature, uHom, uSentence}}
    (route : source ⟶ target) :
    route.base.mapSignature.obj source.logical.signature ⟶ target.logical.signature :=
  route.fiber.mapSignature

/-- Every arrow sends selected source theorems to selected target theorems. -/
theorem Hom.preserves {source target : Object.{uSignature, uHom, uSentence}}
    (route : source ⟶ target) {formula : source.institution.sentence.obj source.logical.signature}
    (theoremhood : formula ∈ source.logical.theory.1) :
    translateSentence (Hom.institution route) (Hom.mapSignature route) formula ∈
      target.logical.theory.1 :=
  route.fiber.preserves (mapSentence_mem_directImage route.base source.logical theoremhood)

/-- The canonical arrow from a closed theory to its direct image. -/
def translate {source : Object.{uSignature, uHom, uSentence}}
    {TargetSignature : Type uSignature} [CategoryTheory.Category.{uHom} TargetSignature]
    {targetInstitution : PiInstitution.{uSignature, uHom, uSentence} TargetSignature}
    (route : PiInstitution.Comorphism source.institution targetInstitution) :
    source ⟶ Object.mk' targetInstitution (directImage route source.logical) where
  base := route
  fiber := CategoryTheory.CategoryStruct.id _

/-! ## The semantic NIK reading -/

/-- Read a selected closed theory as a one-fibre semantic NIK object.  This
forgets neither theorem scope nor sentence translation, and it adds no checker
and no certificate representation. -/
def toSemanticTarget (object : Object.{uSignature, uHom, uSentence}) :
    CertifiedTheoryCategory.TheoryObject.{0, uSignature, uSentence} where
  Kind := Unit
  family := ClosedTheorySemanticTarget.theoryFamily object.logical

/-- Every arrow of the theory graph has a semantic NIK reading. -/
def Hom.toTargetTranslation {source target : Object.{uSignature, uHom, uSentence}}
    (route : source ⟶ target) : toSemanticTarget source ⟶ toSemanticTarget target where
  mapKind := id
  mapSignature := fun _ => .selected
  signature_commutes := by intro kind; cases kind; rfl
  mapClaim := fun _ formula =>
    translateSentence (Hom.institution route) (Hom.mapSignature route) formula
  scope_preserved := by
    intro kind formula theoremhood
    cases kind
    exact Hom.preserves route theoremhood
  meaning_preserved := by
    intro kind formula theoremhood
    cases kind
    exact Hom.preserves route theoremhood

@[simp]
theorem translateSentence_id (object : Object.{uSignature, uHom, uSentence})
    (formula : object.institution.sentence.obj object.logical.signature) :
    translateSentence (Hom.institution (CategoryTheory.CategoryStruct.id object))
        (Hom.mapSignature (CategoryTheory.CategoryStruct.id object)) formula = formula := by
  show translateSentence (CategoryTheory.CategoryStruct.id object).base
    (CategoryTheory.CategoryStruct.id object).fiber.mapSignature formula = formula
  rw [Grothendieck.id_fiber, eqToHom_mapSignature]
  change object.institution.sentence.map (CategoryTheory.CategoryStruct.id object.logical.signature)
    formula = formula
  exact object.institution.sentence.map_id_apply _ formula

theorem translateSentence_comp {first middle last : Object.{uSignature, uHom, uSentence}}
    (earlier : first ⟶ middle) (later : middle ⟶ last)
    (formula : first.institution.sentence.obj first.logical.signature) :
    translateSentence (Hom.institution (earlier ≫ later)) (Hom.mapSignature (earlier ≫ later))
        formula =
      translateSentence (Hom.institution later) (Hom.mapSignature later)
        (translateSentence (Hom.institution earlier) (Hom.mapSignature earlier) formula) := by
  show translateSentence (earlier ≫ later).base (earlier ≫ later).fiber.mapSignature formula = _
  rw [Grothendieck.comp_fiber, theoryHom_comp_mapSignature, theoryHom_comp_mapSignature,
    eqToHom_mapSignature]
  change last.institution.sentence.map
      (CategoryTheory.CategoryStruct.id _ ≫
        later.base.mapSignature.map earlier.fiber.mapSignature ≫ later.fiber.mapSignature)
      (later.base.mapSentence _ (earlier.base.mapSentence _ formula)) =
    last.institution.sentence.map later.fiber.mapSignature
      (later.base.mapSentence _
        (middle.institution.sentence.map earlier.fiber.mapSignature
          (earlier.base.mapSentence _ formula)))
  rw [CategoryTheory.Category.id_comp, last.institution.sentence.map_comp_apply,
    later.base.mapSentence_natural]
  rfl

/-- The semantic NIK reading is a functor on the theory graph. -/
def semanticTargetFunctor :
    CategoryTheory.Functor Object.{uSignature, uHom, uSentence}
      CertifiedTheoryCategory.TheoryObject.{0, uSignature, uSentence} where
  obj := toSemanticTarget
  map := Hom.toTargetTranslation
  map_id object := by
    apply CertifiedTheoryCategory.TheoryTranslation.ext_data
    · intro kind; rfl
    · intro signature; cases signature; rfl
    · intro kind formula
      cases kind
      exact heq_of_eq (translateSentence_id object formula)
  map_comp earlier later := by
    apply CertifiedTheoryCategory.TheoryTranslation.ext_data
    · intro kind; rfl
    · intro signature; cases signature; rfl
    · intro kind formula
      cases kind
      exact heq_of_eq (translateSentence_comp earlier later formula)

#print axioms closedTheories
#print axioms fibre_faithful
#print axioms Hom.mk
#print axioms translate
#print axioms semanticTargetFunctor

end Mettapedia.GSLT.LanguageDef.TheoryGraph
