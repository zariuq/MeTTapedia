import Mettapedia.GSLT.Core.OperationalRealizationOSLF

/-!
# Two-step classifier lowerings

Many language transformations retain a small but important administrative
boundary: an authored transition is first classified into a target-owned row,
then that row is dispatched.  This module packages that shape without
identifying classification with the source semantics or collapsing the two
target steps into a fictional direct transition.

The stage is parameterized by the actual source operation, target classifier,
target dispatcher, and target row constructor.  It therefore consumes those
semantic operations as data; no identity, digest, or fixture name participates
in the lowering.  An instance supplies the equation relating its independently
authored source operation to target classification followed by dispatch.

The construction is deliberately semantic rather than a surface renderer.
A later presentation transformer may emit a finite target rule inventory for a
particular stage, while this module proves the reusable GSLT-to-GSLT path
realization that such an emitted inventory must realize.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.ClassifierLowering

open Mettapedia.GSLT
open Mettapedia.GSLT.IndexedOperational
open Mettapedia.OSLF.Framework.IndexedModalFunctor

/-! `ForwardModalPredicateTheory.Hom` is universe-homogeneous, so this core
keeps the four payload sorts in one universe.  Concrete language stages use
ordinary `Type`, while a cross-universe stage can lift its payloads explicitly
before applying closure OSLF. -/
universe u uStep

/-- A source operation and its independently target-owned classify/dispatch
realization.  `dispatch_correct` is the semantic adequacy obligation: the
target result must agree with the authored operation, but neither function is
defined in terms of the other. -/
structure Stage
    (Input : Type u) (Outcome : Type u)
    (Class : Type u) (Row : Type u) where
  authoredRun : Input -> Outcome
  classify : Input -> Class
  dispatch : Input -> Class -> Outcome
  row : Input -> Class -> Row
  dispatch_correct : forall input,
    dispatch input (classify input) = authoredRun input

/-- The authored source machine has a request and its one semantic outcome. -/
inductive SourceTerm (Input : Type u) (Outcome : Type u) where
  | request (input : Input)
  | outcome (input : Input) (outcome : Outcome)

/-- The target retains the input and selected row between its two
administrative steps.  The middle state is observable rather than erased. -/
inductive TargetTerm
    (Input : Type u) (Outcome : Type u)
    (Class : Type u) (Row : Type u) where
  | pending (input : Input)
  | classified (input : Input) (classification : Class) (row : Row)
  | result (input : Input) (outcome : Outcome)

/-- One source operation is genuinely a single authored transition. -/
inductive SourceStep
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) :
    SourceTerm Input Outcome -> SourceTerm Input Outcome -> Prop where
  | run (input : Input) :
      SourceStep stage (.request input)
        (.outcome input (stage.authoredRun input))

/-- The target operation makes classification and dispatch distinct. -/
inductive TargetStep
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) :
    TargetTerm Input Outcome Class Row ->
      TargetTerm Input Outcome Class Row -> Prop where
  | classify (input : Input) :
      TargetStep stage
        (.pending input)
        (.classified input (stage.classify input)
          (stage.row input (stage.classify input)))
  | dispatch (input : Input) :
      TargetStep stage
        (.classified input (stage.classify input)
          (stage.row input (stage.classify input)))
        (.result input (stage.dispatch input (stage.classify input)))

/-- The source GSLT generated by the supplied authored operation. -/
def sourceGSLT
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) : GSLT where
  Term := SourceTerm Input Outcome
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites := SourceStep stage
  rewrites_resp_left := by
    intro source source' target equal step
    subst source'
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    intro source target target' step equal
    subst target'
    exact step

/-- The target GSLT generated by the supplied classifier, row constructor,
and dispatcher. -/
def targetGSLT
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) : GSLT where
  Term := TargetTerm Input Outcome Class Row
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites := TargetStep stage
  rewrites_resp_left := by
    intro source source' target equal step
    subst source'
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    intro source target target' step equal
    subst target'
    exact step

/-- Embed source requests and outcomes into the target's observable states. -/
def mapTerm
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (source : SourceTerm Input Outcome) : TargetTerm Input Outcome Class Row :=
  match source with
  | .request input => .pending input
  | .outcome input outcome => .result input outcome

/-- The exact target path for one input before rewriting its endpoint through
the stage's semantic adequacy equation. -/
def targetPath
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) (input : Input) :
    ExecutionPath (targetGSLT stage)
      (.pending input)
      (.result input (stage.dispatch input (stage.classify input))) :=
  .cons ⟨TargetStep.classify input⟩
    (.cons ⟨TargetStep.dispatch input⟩ (.refl _))

/-- Reindex only the endpoint of a proof-relevant route.  This isolates the
ordinary equality transport required when a target dispatcher and the authored
operation have extensionally equal, but not definitionally identical, results. -/
def transportTarget
    {Object : Type u} {Step : Object -> Object -> Type uStep}
    {source left right : Object} (equal : left = right)
    (path : Mettapedia.GSLT.Ultrainfinite.Route Step source left) :
    Mettapedia.GSLT.Ultrainfinite.Route Step source right := by
  subst right
  exact path

/-- Endpoint transport preserves the recorded number of target steps. -/
theorem transportTarget_length
    {Object : Type u} {Step : Object -> Object -> Type uStep}
    {source left right : Object} (equal : left = right)
    (path : Mettapedia.GSLT.Ultrainfinite.Route Step source left) :
    (transportTarget equal path).length = path.length := by
  cases equal
  rfl

/-- The target's two-step path reindexed to the independently authored source
outcome.  The equality is carried transparently; it does not erase either
administrative target step. -/
def targetPathAtAuthored
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) (input : Input) :
    ExecutionPath (targetGSLT stage)
      (.pending input)
      (.result input (stage.authoredRun input)) :=
  transportTarget
    (congrArg (fun outcome => TargetTerm.result input outcome)
      (stage.dispatch_correct input))
    (targetPath stage input)

/-- Reindexing the target endpoint leaves the two-step lower bound exact. -/
theorem targetPathAtAuthored_length
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) (input : Input) :
    (targetPathAtAuthored stage input).length = 2 := by
  unfold targetPathAtAuthored
  rw [transportTarget_length]
  rfl

/-- Lower one source step without eliminating its proposition-valued proof
into target data.  Endpoint shape is first recovered propositionally; only
then is the independently constructed target route returned. -/
def lowerStep
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row)
    {source target : SourceTerm Input Outcome}
    (step : SourceStep stage source target) :
    ExecutionPath (targetGSLT stage) (mapTerm source) (mapTerm target) := by
  cases source with
  | request input =>
      have targetEqual :
          target = .outcome input (stage.authoredRun input) := by
        cases step
        rfl
      subst target
      exact targetPathAtAuthored stage input
  | outcome input outcome =>
      exact False.elim (by cases step)

/-- One authored operation lowers to a two-step target path. -/
def realization
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) :
    OperationalRealization (sourceGSLT stage) (targetGSLT stage) where
  mapTerm := mapTerm
  mapEquiv := by
    intro left right equal
    subst right
    rfl
  mapStep := lowerStep stage

/-- The emitted path really retains two target steps. -/
theorem targetPath_length
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) (input : Input) :
    (targetPath stage input).length = 2 := by
  rfl

/-- The realization retains the two-step classification/dispatch shape for a
source operation, rather than reducing it to an endpoint-only claim. -/
theorem realization_map_run_length
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) (input : Input) :
    ((realization stage).mapStep (SourceStep.run input)).length = 2 := by
  change (targetPathAtAuthored stage input).length = 2
  exact targetPathAtAuthored_length stage input

/-- The classified middle state records exactly the input, target class, and
target row selected by the supplied classifier. -/
theorem classified_row_exact
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) (input : Input) :
    TargetStep stage (.pending input)
      (.classified input (stage.classify input)
        (stage.row input (stage.classify input))) :=
  TargetStep.classify input

/-- A target classification cannot silently rewrite the input occurrence. -/
theorem classified_input_injective
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    {left right : Input} {leftClass rightClass : Class}
    {leftRow rightRow : Row}
    (equal :
      @TargetTerm.classified Input Outcome Class Row left leftClass leftRow =
        @TargetTerm.classified Input Outcome Class Row right rightClass rightRow) :
    left = right := by
  injection equal

/-- Negative control: the target does not pretend the source operation is a
single primitive target step.  Any such route must pass through a classified
state carrying its row. -/
theorem pending_to_result_not_targetStep
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) (input : Input) (outcome : Outcome) :
    Not (TargetStep stage (.pending input) (.result input outcome)) := by
  intro step
  cases step

/-- The closure OSLF arrow observes compiler macro-steps, with the expected
contravariant direction.  It is not identified with the target's primitive
one-step native theory. -/
def reachabilityNTT
    {Input : Type u} {Outcome : Type u}
    {Class : Type u} {Row : Type u}
    (stage : Stage Input Outcome Class Row) :
    ForwardModalPredicateTheory.Hom
      (oslfForwardModalObject (targetGSLT stage).closure)
      (oslfForwardModalObject (sourceGSLT stage).closure) :=
  (realization stage).closureOSLFPullback

/-! ## Small concrete controls -/

namespace Canary

def stage : Stage Bool Nat Bool Nat where
  authoredRun := fun input => if input then 1 else 0
  classify := id
  dispatch := fun _ classification => if classification then 1 else 0
  row := fun input _ => if input then 11 else 10
  dispatch_correct := by
    intro input
    cases input <;> rfl

/-- Positive control: a real input takes the two administrative target steps. -/
theorem true_input_has_two_step_route :
    (targetPath stage true).length = 2 := by
  exact targetPath_length stage true

/-- Negative control: no direct target step skips the classifier row. -/
theorem false_input_has_no_direct_result_step :
    Not (TargetStep stage (.pending false) (.result false 0)) :=
  pending_to_result_not_targetStep stage false 0

end Canary

#print axioms Stage
#print axioms targetPath_length
#print axioms transportTarget_length
#print axioms targetPathAtAuthored_length
#print axioms realization_map_run_length
#print axioms classified_input_injective
#print axioms pending_to_result_not_targetStep
#print axioms reachabilityNTT
#print axioms Canary.true_input_has_two_step_route
#print axioms Canary.false_input_has_no_direct_result_step

end Mettapedia.GSLT.ClassifierLowering
