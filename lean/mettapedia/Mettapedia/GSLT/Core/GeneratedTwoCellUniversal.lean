import Mettapedia.GSLT.Core.Ultrainfinite
import Mettapedia.TypeTheory.FreeWhiskeredCell

/-!
# The universal raw-cell form of GSLT generated two-cells

`Ultrainfinite.GeneratedTwoCell` predates the common free-whiskered-cell
interface.  This module proves that it is exactly an instance of that
representation-independent syntax: routes supply the retained one-cells,
append supplies whiskering, and authored comparison generators supply the
two-dimensional signature.

The equivalence is constructor preserving in both directions.  Consequently
every algebraic interpretation of the common syntax extends uniquely to the
existing GSLT cells.  No bicategorical equation is added by this bridge.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Ultrainfinite
namespace GeneratedTwoCellUniversal

open Mettapedia.TypeTheory.FreeWhiskeredCell

universe uObject uStep uGenerator uTarget

/-- Routes with identity and append form the raw one-dimensional base used by
the common cell syntax. -/
@[reducible] def routeBase (Object : Type uObject)
    (Step : Object → Object → Type uStep) : Base where
  Object := Object
  Hom := Route Step
  compose := Route.append

variable {Object : Type uObject}
    {Step : Object → Object → Type uStep}
    {Generator : {source target : Object} →
      Route Step source target → Route Step source target →
        Type uGenerator}

/-- Existing GSLT generated cells embed constructor-for-constructor in the
common raw-cell syntax. -/
def toCommon :
    {source target : Object} →
      {first second : Route Step source target} →
      GeneratedTwoCell Generator first second →
        Cell (routeBase Object Step) Generator first second
  | _, _, _, _, .refl route =>
      Cell.refl (base := routeBase Object Step)
        (Generator := Generator) route
  | _, _, _, _, .generator evidence =>
      Cell.generator (base := routeBase Object Step) evidence
  | _, _, _, _, .vertical earlier later =>
      Cell.vertical (toCommon earlier) (toCommon later)
  | _, _, _, _, .whiskerLeft prior cell =>
      Cell.whiskerLeft (base := routeBase Object Step)
        prior (toCommon cell)
  | _, _, _, _, .whiskerRight suffix cell =>
      Cell.whiskerRight (base := routeBase Object Step)
        suffix (toCommon cell)

/-- The common syntax reconstructs the existing GSLT cell tree without
erasing any route or generator. -/
def fromCommon :
    {source target : Object} →
      {first second : Route Step source target} →
      Cell (routeBase Object Step) Generator first second →
        GeneratedTwoCell Generator first second
  | _, _, _, _, .refl route =>
      GeneratedTwoCell.refl (Generator := Generator) route
  | _, _, _, _, .generator evidence =>
      GeneratedTwoCell.generator evidence
  | _, _, _, _, .vertical earlier later =>
      GeneratedTwoCell.vertical (fromCommon earlier) (fromCommon later)
  | _, _, _, _, .whiskerLeft prior cell =>
      GeneratedTwoCell.whiskerLeft prior (fromCommon cell)
  | _, _, _, _, .whiskerRight suffix cell =>
      GeneratedTwoCell.whiskerRight suffix (fromCommon cell)

@[simp] theorem fromCommon_toCommon
    {source target : Object}
    {first second : Route Step source target}
    (cell : GeneratedTwoCell Generator first second) :
    fromCommon (toCommon cell) = cell := by
  induction cell with
  | refl => rfl
  | generator => rfl
  | vertical earlier later earlierIH laterIH =>
      simp [toCommon, fromCommon, earlierIH, laterIH]
  | whiskerLeft prior cell cellIH =>
      simp [toCommon, fromCommon, cellIH]
  | whiskerRight suffix cell cellIH =>
      simp [toCommon, fromCommon, cellIH]

/-- The common cell algebra generated by the identity map on authored
two-generators. -/
def identityAlgebra :
    Algebra (routeBase Object Step) Generator
      (Cell (routeBase Object Step) Generator) :=
  generatedAlgebra (fun evidence => evidence)

/-- Translating to the legacy presentation and back preserves each of the
five constructors, hence forms a structural extension of the identity
algebra. -/
def commonRoundTripExtension : Extension
    (identityAlgebra (Object := Object) (Step := Step)
      (Generator := Generator)) where
  onCell := fun cell => toCommon (fromCommon cell)
  onRefl := by intros; rfl
  onGenerator := by intros; rfl
  onVertical := by intros; rfl
  onWhiskerLeft := by intros; rfl
  onWhiskerRight := by intros; rfl

/-- Literal identity is another structural extension of the same algebra. -/
def commonIdentityExtension : Extension
    (identityAlgebra (Object := Object) (Step := Step)
      (Generator := Generator)) where
  onCell := fun cell => cell
  onRefl := by intros; rfl
  onGenerator := by intros; rfl
  onVertical := by intros; rfl
  onWhiskerLeft := by intros; rfl
  onWhiskerRight := by intros; rfl

@[simp] theorem toCommon_fromCommon
    {source target : Object}
    {first second : Route Step source target}
    (cell : Cell (routeBase Object Step) Generator first second) :
    toCommon (fromCommon cell) = cell := by
  have extensionsEqual :
      commonRoundTripExtension (Object := Object) (Step := Step)
          (Generator := Generator) =
        commonIdentityExtension (Object := Object) (Step := Step)
          (Generator := Generator) :=
    Subsingleton.elim _ _
  have valuesEqual := congrArg
    (fun extension => extension.onCell cell) extensionsEqual
  exact valuesEqual

/-- Existing GSLT generated cells and the common free raw-cell syntax are
exactly equivalent, including their complete constructor trees. -/
def equivalence
    {source target : Object}
    (first second : Route Step source target) :
    GeneratedTwoCell Generator first second ≃
      Cell (routeBase Object Step) Generator first second where
  toFun := toCommon
  invFun := fromCommon
  left_inv := fromCommon_toCommon
  right_inv := toCommon_fromCommon

/-- Every interpretation of the common route-cell signature has a unique
structural extension.  This is the universal property inherited by the
existing GSLT syntax, before any coherence quotient or higher completion. -/
theorem commonExtensions_contractible
    {Target : {source target : Object} →
      Route Step source target → Route Step source target →
        Type uTarget}
    (algebra : Algebra (routeBase Object Step) Generator Target) :
    Nonempty (Extension algebra) ∧ Subsingleton (Extension algebra) :=
  Extension.contractible algebra

/-! ## A concrete canary transported through the common syntax -/

namespace Canary

inductive Node where
  | start
  | middle
  | done
  deriving DecidableEq

inductive Edge : Node → Node → Type where
  | direct : Edge .start .done
  | first : Edge .start .middle
  | second : Edge .middle .done

def directRoute : Route Edge Node.start Node.done :=
  Route.cons Edge.direct (Route.refl Node.done)

def detourRoute : Route Edge Node.start Node.done :=
  Route.cons Edge.first
    (Route.cons Edge.second (Route.refl Node.done))

theorem routes_remain_distinct : detourRoute ≠ directRoute := by
  intro equal
  have lengths := congrArg Route.length equal
  simp [detourRoute, directRoute, Route.length] at lengths

inductive OptimizationGenerator :
    {source target : Node} →
      Route Edge source target → Route Edge source target → Type where
  | collapse : OptimizationGenerator detourRoute directRoute

def collapseCell :
    GeneratedTwoCell OptimizationGenerator detourRoute directRoute :=
  .generator .collapse

/-- The existing optimization comparison remains one authored generator in
the common raw-cell language. -/
theorem collapseCell_toCommon :
    toCommon collapseCell =
      Cell.generator (base := routeBase Node Edge)
        OptimizationGenerator.collapse :=
  rfl

/-- Transport to the common syntax cannot identify the detour and direct
routes; both complete one-cell histories remain the indices of the cell. -/
theorem common_collapse_retains_distinct_routes :
    detourRoute ≠ directRoute ∧
      Nonempty
        (Cell (routeBase Node Edge) OptimizationGenerator
          detourRoute directRoute) :=
  ⟨routes_remain_distinct, ⟨toCommon collapseCell⟩⟩

end Canary

/-! ## Axiom audit -/

#print axioms fromCommon_toCommon
#print axioms toCommon_fromCommon
#print axioms equivalence
#print axioms commonExtensions_contractible
#print axioms Canary.collapseCell_toCommon
#print axioms Canary.common_collapse_retains_distinct_routes

end GeneratedTwoCellUniversal
end Mettapedia.GSLT.Ultrainfinite
