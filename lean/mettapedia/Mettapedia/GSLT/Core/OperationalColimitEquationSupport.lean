import Mettapedia.GSLT.Core.OperationalColimitRelationSupport

/-!
# Finite-stage witnesses for generated ambient equations

An ambient equation is generated by finite reflexive, symmetric and
transitive evidence from authored stage equations. Filteredness transports
that evidence to one stage, even when the middle representatives initially
come from different stages. Carrier identifications use actual diagram
routes; they are not silently treated as authored equations.

This is an existence theorem for equation witnesses in the constructed
operational colimit. It is not a computable stage selector, a compactness
theorem for authored syntax, or an effective Ind realization.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.IndexedOperational.OperationalColimits

open CategoryTheory

universe u

variable {J : Type u} [SmallCategory J]

/-- One authored-stage equation, with both ambient endpoints retained. -/
abbrev HasStageEquation (diagram : J ⥤ OperationalTheory.{u})
    (left right : Term diagram) : Prop :=
  HasStageRelation diagram (fun stage => (diagram.obj stage).theory.Equiv) left right

private theorem stageEquation_refl (diagram : J ⥤ OperationalTheory.{u})
    (term : Term diagram) : HasStageEquation diagram term term := by
  obtain ⟨stage, representative, same⟩ := term_from_stage diagram term
  exact ⟨stage, representative, representative, same, same,
    (diagram.obj stage).theory.equations.iseqv.refl representative⟩

private theorem stageEquation_symm (diagram : J ⥤ OperationalTheory.{u})
    {left right : Term diagram} (equation : HasStageEquation diagram left right) :
    HasStageEquation diagram right left := by
  obtain ⟨stage, before, after, first, last, equation⟩ := equation
  exact ⟨stage, after, before, last, first,
    (diagram.obj stage).theory.equations.iseqv.symm equation⟩

variable [IsFilteredOrEmpty J]

private theorem stageEquation_trans (diagram : J ⥤ OperationalTheory.{u})
    {first middle last : Term diagram}
    (earlier : HasStageEquation diagram first middle)
    (later : HasStageEquation diagram middle last) : HasStageEquation diagram first last := by
  exact stage_relations_compose diagram _ _ _
    (fun {_ _} route {_ _} equation => (diagram.map route).mapEquiv equation)
    (fun {_ _} route {_ _} equation => (diagram.map route).mapEquiv equation)
    (fun stage {_ _ _} first last => (diagram.obj stage).theory.equations.iseqv.trans first last)
    earlier later

/-- Every generated ambient equation has a witness at a common stage;
conversely, every such stage equation gives the claimed ambient equation. -/
theorem equivalent_iff_has_stage_equation (diagram : J ⥤ OperationalTheory.{u})
    {left right : Term diagram} :
    Equivalent diagram left right ↔ HasStageEquation diagram left right := by
  constructor
  · intro equation
    induction equation with
    | rel left right authored =>
        cases authored with
        | stage stage equivalent => exact ⟨stage, _, _, rfl, rfl, equivalent⟩
    | refl term => exact stageEquation_refl diagram term
    | symm _ _ _ ih => exact stageEquation_symm diagram ih
    | trans _ _ _ _ _ first last => exact stageEquation_trans diagram first last
  · rintro ⟨stage, before, after, first, last, equivalent⟩
    rw [← first, ← last]
    exact .rel _ _ (.stage stage equivalent)

#print axioms equivalent_iff_has_stage_equation

end Mettapedia.GSLT.IndexedOperational.OperationalColimits
