import Mettapedia.GSLT.Core.ContextualLadder
import Mettapedia.OSLF.Syntax.FiniteRulePremiseLists

/-!
# Judgment boundaries over a contextual structure

The context, type, term, and substitution indices come from the supplied
contextual structure. A boundary contains proposed data, without asserting its
formation or inhabitation. An authored finite rule presentation supplies those
judgments and retains an ordered derivation tree for every accepted instance.

For a simple type theory, the same interface uses its constant type families.
No dependent object-language constructors or decision procedure are imposed by
the interface. Rule modes and algorithmic admissibility are separate data.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Core.ContextualLadder

universe u v w w'

/-- Proposed contextual judgments; evidence is generated by an authored rule family. -/
inductive ContextualJudgment (C : Cwf.{u, v, w, w'}) : Type (max u v w w') where
  | context (Γ : C.Ctx)
  | type (Γ : C.Ctx) (A : C.Ty Γ)
  | term (Γ : C.Ctx) (A : C.Ty Γ) (t : C.Tm Γ A)
  | typeEquality (Γ : C.Ctx) (A B : C.Ty Γ)
  | termEquality (Γ : C.Ctx) (A : C.Ty Γ) (t u : C.Tm Γ A)
  | substitution (Γ Δ : C.Ctx) (σ : C.Sub Γ Δ)

/-- Ordered rule data may move to extended contexts in its recursive premises.
The full context travels with each judgment, so the polynomial base is fixed. -/
abbrev ContextualRulePresentation (C : Cwf.{u, v, w, w'}) :=
  Mettapedia.OSLF.Binding.FiniteRulePremiseLists.FinitePresentation
    Unit (fun _ => ContextualJudgment C)

end Mettapedia.GSLT.Core.ContextualLadder
