import Mettapedia.GSLT.Causality.Mazurkiewicz
import Mathlib.Data.Finset.Basic

/-!
# Event-level independence: residuals, tiles and traces

Independence of sites identifies an occurrence by its site, and is irreflexive.
It cannot relate two firings of one rule on disjoint resources, the ordinary
case in a calculus whose configurations are bags: both firings have the same
site.

Here independence relates two enabled events at one term. Independent events
have residuals, each firing after the other, and the two routes meet. A
residual keeps the site of its event, so the bag of sites survives every swap.

The trace equivalence is generated by any system of tiles, a family of squares
whose two routes are identified. Independence of sites and independence of
events are two such systems; the Mazurkiewicz equivalence of sites is the first.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Causality.EventConcurrency

open Mettapedia.GSLT
open Mettapedia.GSLT.Core.InteractionEvent
open Mettapedia.GSLT.Causality.OccurrenceHistory
open Mettapedia.GSLT.Causality.Mazurkiewicz
open CategoryTheory

universe uSite uEvent uTile

variable {theory : GSLT}

/-! ## Tile systems and the trace equivalence they generate -/

/-- A family of commuting squares: each tile at a source has two routes to one
target. -/
structure TileSystem (P : InteractionPresentation.{uSite, uEvent} theory) where
  Tile : theory.Term → Type uTile
  target : ∀ {s : theory.Term}, Tile s → theory.Term
  route : ∀ {s : theory.Term} (tile : Tile s), OccurrencePath P s (target tile)
  swapped : ∀ {s : theory.Term} (tile : Tile s), OccurrencePath P s (target tile)

/-- The smallest equivalence on paths identifying the two routes of every
tile, and closed under concatenation. -/
inductive TraceEq {P : InteractionPresentation.{uSite, uEvent} theory}
    (T : TileSystem.{uSite, uEvent, uTile} P) :
    {s t : theory.Term} → OccurrencePath P s t → OccurrencePath P s t → Prop
  | refl {s t : theory.Term} (p : OccurrencePath P s t) : TraceEq T p p
  | symm {s t : theory.Term} {p q : OccurrencePath P s t} :
      TraceEq T p q → TraceEq T q p
  | trans {s t : theory.Term} {p q r : OccurrencePath P s t} :
      TraceEq T p q → TraceEq T q r → TraceEq T p r
  | tile {s : theory.Term} (tile : T.Tile s) : TraceEq T (T.route tile) (T.swapped tile)
  | cong_left {s m t : theory.Term} (pre : OccurrencePath P s m)
      {p q : OccurrencePath P m t} :
      TraceEq T p q → TraceEq T (OccurrencePath.append pre p) (OccurrencePath.append pre q)
  | cong_right {s m t : theory.Term} {p q : OccurrencePath P s m}
      (post : OccurrencePath P m t) :
      TraceEq T p q → TraceEq T (OccurrencePath.append p post) (OccurrencePath.append q post)

namespace TraceEq

variable {P : InteractionPresentation.{uSite, uEvent} theory}
  (T : TileSystem.{uSite, uEvent, uTile} P)

theorem is_equivalence {s t : theory.Term} :
    Equivalence (fun p q : OccurrencePath P s t => TraceEq T p q) :=
  ⟨refl, fun h => symm h, fun h₁ h₂ => trans h₁ h₂⟩

end TraceEq

/-- The trace setoid of a tile system. -/
def traceSetoid {P : InteractionPresentation.{uSite, uEvent} theory}
    (T : TileSystem.{uSite, uEvent, uTile} P) (s t : theory.Term) :
    Setoid (OccurrencePath P s t) where
  r := TraceEq T
  iseqv := TraceEq.is_equivalence T

/-- Traces: occurrence paths modulo the tiles. -/
def Trace {P : InteractionPresentation.{uSite, uEvent} theory}
    (T : TileSystem.{uSite, uEvent, uTile} P) (s t : theory.Term) : Type _ :=
  Quotient (traceSetoid T s t)

namespace Trace

variable {P : InteractionPresentation.{uSite, uEvent} theory}
  {T : TileSystem.{uSite, uEvent, uTile} P}

/-- The trace of a path. -/
def mk {s t : theory.Term} (p : OccurrencePath P s t) : Trace T s t :=
  Quotient.mk (traceSetoid T s t) p

theorem mk_sound {s t : theory.Term} {p q : OccurrencePath P s t}
    (h : TraceEq T p q) : mk (T := T) p = mk q :=
  Quotient.sound h

/-- Concatenation of traces. -/
def append {s m t : theory.Term} (left : Trace T s m) (right : Trace T m t) :
    Trace T s t :=
  Quotient.liftOn left
    (fun p => Quotient.liftOn right (fun q => mk (OccurrencePath.append p q))
      (fun _ _ hq => mk_sound (TraceEq.cong_left p hq)))
    (fun _ _ hp => by
      refine Quotient.inductionOn right ?_
      intro q
      exact mk_sound (TraceEq.cong_right q hp))

theorem append_mk {s m t : theory.Term} (p : OccurrencePath P s m)
    (q : OccurrencePath P m t) :
    append (mk (T := T) p) (mk q) = mk (OccurrencePath.append p q) :=
  rfl

end Trace

/-- Terms with traces as arrows. -/
abbrev TraceCat {P : InteractionPresentation.{uSite, uEvent} theory}
    (_T : TileSystem.{uSite, uEvent, uTile} P) :=
  theory.Term

instance {P : InteractionPresentation.{uSite, uEvent} theory}
    (T : TileSystem.{uSite, uEvent, uTile} P) : Category (TraceCat T) where
  Hom := fun s t => Trace T s t
  id := fun s => Trace.mk (.refl s)
  comp := fun f g => Trace.append f g
  id_comp := by
    intro _ _ f
    refine Quotient.inductionOn f ?_
    intro p
    change Trace.append (Trace.mk (.refl _)) (Trace.mk p) = Trace.mk p
    rw [Trace.append_mk, OccurrencePath.refl_append]
  comp_id := by
    intro _ _ f
    refine Quotient.inductionOn f ?_
    intro p
    change Trace.append (Trace.mk p) (Trace.mk (.refl _)) = Trace.mk p
    rw [Trace.append_mk, OccurrencePath.append_refl]
  assoc := by
    intro _ _ _ _ f g h
    refine Quotient.inductionOn f ?_
    intro p
    refine Quotient.inductionOn g ?_
    intro q
    refine Quotient.inductionOn h ?_
    intro r
    change Trace.append (Trace.append (Trace.mk p) (Trace.mk q)) (Trace.mk r) =
      Trace.append (Trace.mk p) (Trace.append (Trace.mk q) (Trace.mk r))
    rw [Trace.append_mk, Trace.append_mk, Trace.append_mk, Trace.append_mk,
      OccurrencePath.append_assoc]

/-! ## Observations that are properties of the trace -/

/-- A valuation descends to traces when it is constant on trace-equivalent
paths. -/
def Descends {P : InteractionPresentation.{uSite, uEvent} theory}
    (T : TileSystem.{uSite, uEvent, uTile} P) {A : Type*} [AddMonoid A]
    (v : OccurrenceValuation P A) : Prop :=
  ∀ {s t : theory.Term} (p q : OccurrencePath P s t), TraceEq T p q → v.onPath p = v.onPath q

/-- **A valuation descends exactly when it agrees on the two routes of every
tile.** -/
theorem descends_iff_tiles {P : InteractionPresentation.{uSite, uEvent} theory}
    (T : TileSystem.{uSite, uEvent, uTile} P) {A : Type*} [AddMonoid A]
    (v : OccurrenceValuation P A) :
    Descends T v ↔ ∀ {s : theory.Term} (tile : T.Tile s),
      v.onPath (T.route tile) = v.onPath (T.swapped tile) := by
  constructor
  · intro h s tile
    exact h _ _ (.tile tile)
  · intro h s t p q related
    induction related with
    | refl _ => rfl
    | symm _ ih => exact ih.symm
    | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
    | tile tile => exact h tile
    | cong_left pre _ ih => rw [v.onPath_append, v.onPath_append, ih]
    | cong_right post _ ih => rw [v.onPath_append, v.onPath_append, ih]

/-! ## Where no tile occurs -/

/-- A property of terms that every occurrence preserves holds at the end of
every path from a term that has it. -/
theorem OccurrencePath.preserves {P : InteractionPresentation.{uSite, uEvent} theory}
    (Q : theory.Term → Prop)
    (closed : ∀ {s t : theory.Term}, Occurrence P s t → Q s → Q t) :
    ∀ {s t : theory.Term}, OccurrencePath P s t → Q s → Q t
  | _, _, .refl _, holds => holds
  | _, _, .cons o rest, holds => OccurrencePath.preserves Q closed rest (closed o holds)

/-- **Where no tile can occur, trace equivalence is equality.** If a property
of terms is preserved by every occurrence and excludes every tile, paths from a
term with the property are trace equivalent only when they are equal. -/
theorem TraceEq.eq_of_no_tile {P : InteractionPresentation.{uSite, uEvent} theory}
    (T : TileSystem.{uSite, uEvent, uTile} P) (Q : theory.Term → Prop)
    (closed : ∀ {s t : theory.Term}, Occurrence P s t → Q s → Q t)
    (noTile : ∀ {s : theory.Term}, Q s → T.Tile s → False) :
    ∀ {s t : theory.Term} {p q : OccurrencePath P s t}, TraceEq T p q → Q s → p = q := by
  intro s t p q related
  induction related with
  | refl _ => intro _; rfl
  | symm _ ih => intro holds; exact (ih holds).symm
  | trans _ _ ih₁ ih₂ => intro holds; exact (ih₁ holds).trans (ih₂ holds)
  | tile tile => intro holds; exact (noTile holds tile).elim
  | cong_left pre _ ih =>
      intro holds
      rw [ih (OccurrencePath.preserves Q closed pre holds)]
  | cong_right post _ ih =>
      intro holds
      rw [ih holds]

/-! ## Independence of sites is one tile system -/

/-- The tiles of an independence of sites. -/
def siteTiles {P : InteractionPresentation.{uSite, uEvent} theory}
    (indep : SiteIndependence P) : TileSystem P where
  Tile := fun s => IndependenceTile P indep s
  target := fun tile => tile.second.target
  route := fun tile => tile.path
  swapped := fun tile => tile.pathSwap'

/-- **The Mazurkiewicz equivalence of sites is the trace equivalence of its
tiles.** -/
theorem diamondEq_iff_traceEq {P : InteractionPresentation.{uSite, uEvent} theory}
    (indep : SiteIndependence P) {s t : theory.Term} (p q : OccurrencePath P s t) :
    DiamondEq indep p q ↔ TraceEq (siteTiles indep) p q := by
  constructor
  · intro h
    induction h with
    | refl p => exact .refl p
    | symm _ ih => exact .symm ih
    | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
    | swap tile => exact .tile (T := siteTiles indep) tile
    | cong_left pre _ ih => exact .cong_left pre ih
    | cong_right post _ ih => exact .cong_right post ih
  · intro h
    induction h with
    | refl p => exact .refl p
    | symm _ ih => exact .symm ih
    | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
    | tile tile => exact .swap tile
    | cong_left pre _ ih => exact .cong_left pre ih
    | cong_right post _ ih => exact .cong_right post ih

/-! ## Independence of events -/

/-- Independence of enabled events. Independent events each still fire after
the other, as a residual with the same site, and the two routes meet. -/
structure Concurrency (P : InteractionPresentation.{uSite, uEvent} theory) where
  Independent : ∀ {s : theory.Term}, P.Enabled s → P.Enabled s → Prop
  symm : ∀ {s : theory.Term} {a b : P.Enabled s}, Independent a b → Independent b a
  /-- The residual of `b` after `a`. -/
  residual : ∀ {s : theory.Term} {a b : P.Enabled s}, Independent a b → P.Enabled a.target
  residual_site : ∀ {s : theory.Term} {a b : P.Enabled s} (h : Independent a b),
    (residual h).site = b.site
  close : ∀ {s : theory.Term} {a b : P.Enabled s} (h : Independent a b),
    (residual h).target = (residual (symm h)).target

namespace Concurrency

variable {P : InteractionPresentation.{uSite, uEvent} theory} (C : Concurrency P)

/-- An enabled event as an occurrence from its source. -/
def occ {s : theory.Term} (e : P.Enabled s) : Occurrence P s e.target :=
  ⟨e.site, e.evidence⟩

/-- A pair of independent events at a source. -/
structure Pair (s : theory.Term) where
  first : P.Enabled s
  second : P.Enabled s
  independent : C.Independent first second

/-- The route that fires the first event, then the residual of the second. -/
def Pair.route {s : theory.Term} (pair : C.Pair s) :
    OccurrencePath P s (C.residual pair.independent).target :=
  .cons (occ pair.first)
    (.cons (occ (C.residual pair.independent)) (.refl _))

/-- The route that fires the second event, then the residual of the first,
cast to the common target. -/
def Pair.swapped {s : theory.Term} (pair : C.Pair s) :
    OccurrencePath P s (C.residual pair.independent).target :=
  (C.close pair.independent).symm ▸
    (.cons (occ pair.second)
      (.cons (occ (C.residual (C.symm pair.independent))) (.refl _)) :
        OccurrencePath P s (C.residual (C.symm pair.independent)).target)

/-- The tiles of an independence of events. -/
def tiles : TileSystem P where
  Tile := fun s => C.Pair s
  target := fun pair => (C.residual pair.independent).target
  route := fun pair => pair.route C
  swapped := fun pair => pair.swapped C

private theorem sites_cast {s t t' : theory.Term} (h : t = t')
    (p : OccurrencePath P s t) : OccurrencePath.sites (h ▸ p) = OccurrencePath.sites p := by
  cases h
  rfl

/-- **The bag of sites survives every swap of independent events.** -/
theorem siteBag_swap {s : theory.Term} (pair : C.Pair s) :
    OccurrencePath.siteBag (pair.route C) = OccurrencePath.siteBag (pair.swapped C) := by
  unfold OccurrencePath.siteBag Pair.swapped
  rw [sites_cast]
  simp only [Pair.route, OccurrencePath.sites, occ, C.residual_site]
  exact Multiset.coe_eq_coe.mpr (List.Perm.swap _ _ _)

/-- **The bag of sites is a property of the trace.** -/
theorem bagValuation_descends : Descends C.tiles (bagValuation P) := by
  refine (descends_iff_tiles C.tiles (bagValuation P)).2 ?_
  intro s pair
  change (bagValuation P).onPath (pair.route C) = (bagValuation P).onPath (pair.swapped C)
  rw [bagValuation_onPath, bagValuation_onPath]
  exact C.siteBag_swap pair

end Concurrency

/-! ## Controls: one rule on disjoint resources

A bag of named tokens and one rule that consumes a token. Two firings on
different tokens have the same site. They are independent events, and no
independence of sites relates them. -/

namespace Tokens

/-- Configurations are finite sets of token names. -/
abbrev tokenTheory : GSLT where
  Term := Finset ℕ
  equations := ⟨Eq, eq_equivalence⟩
  rewrites := fun s t => ∃ i ∈ s, t = s.erase i
  rewrites_resp_left := by
    intro s s' t equal step
    exact ⟨t, equal ▸ step, rfl⟩
  rewrites_resp_right := by
    intro s t t' step equal
    exact equal ▸ step

/-- One rule, consuming the named token. -/
def presentation : InteractionPresentation tokenTheory where
  Site := Unit
  Event := fun _ s t => {i : ℕ // i ∈ s ∧ t = s.erase i}
  sound := fun event => ⟨event.val, event.property.1, event.property.2⟩

/-- Consume token `i`. -/
def consume (s : Finset ℕ) (i : ℕ) (member : i ∈ s) : presentation.Enabled s where
  site := ()
  target := s.erase i
  evidence := ⟨i, member, rfl⟩

/-- The token an enabled event consumes. -/
def token {s : Finset ℕ} (e : presentation.Enabled s) : ℕ := e.evidence.val

/-- Two firings are independent when they consume different tokens. -/
def concurrency : Concurrency presentation where
  Independent := fun a b => token a ≠ token b
  symm := fun h => Ne.symm h
  residual := fun {s} {a} {b} h =>
    consume a.target (token b) (by
      rw [a.evidence.property.2]
      exact Finset.mem_erase.mpr ⟨Ne.symm h, b.evidence.property.1⟩)
  residual_site := fun _ => rfl
  close := by
    intro s a b h
    change a.target.erase (token b) = b.target.erase (token a)
    rw [a.evidence.property.2, b.evidence.property.2]
    exact Finset.erase_right_comm

/-- The two firings on tokens `0` and `1` of `{0, 1}`. -/
def pair : concurrency.Pair ({0, 1} : Finset ℕ) where
  first := consume {0, 1} 0 (by decide)
  second := consume {0, 1} 1 (by decide)
  independent := by change (0 : ℕ) ≠ 1; decide

/-- The two orders reach one configuration. -/
theorem pair_commutes :
    Trace.mk (T := concurrency.tiles) (pair.route concurrency) =
      Trace.mk (pair.swapped concurrency) :=
  Trace.mk_sound (.tile (T := concurrency.tiles) pair)

/-- **No independence of sites relates two firings of one rule.** -/
theorem no_site_tile (indep : SiteIndependence presentation)
    (tile : IndependenceTile presentation indep ({0, 1} : Finset ℕ)) : False :=
  tile.independent_ne rfl

end Tokens

#print axioms diamondEq_iff_traceEq
#print axioms descends_iff_tiles
#print axioms Concurrency.bagValuation_descends
#print axioms Tokens.pair_commutes
#print axioms Tokens.no_site_tile

end Mettapedia.GSLT.Causality.EventConcurrency
