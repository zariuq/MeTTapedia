import Mettapedia.GSLT.Causality.OccurrenceHistory
import Mathlib.Data.Setoid.Basic

/-!
# Generated diamond equivalence (Mazurkiewicz traces)

An independence tile is a 2-cell. The kernel equation is the smallest
equivalence on occurrence paths generated by those swaps, congruent under
path concatenation. That is the trace monoid, not abelianization: only
independent sites commute.

A valuation descends to the quotient iff it is constant on every tile.
Bags descend; ordered site lists do not.

No LanguageDef, no stored history, no dummy `True` on endpoints.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Causality.Mazurkiewicz

open Mettapedia.GSLT
open Mettapedia.GSLT.Core.InteractionEvent
open Mettapedia.GSLT.Causality.OccurrenceHistory
open CategoryTheory

universe uSite uEvent

variable {theory : GSLT}

/-- Smallest equivalence identifying the two routes of every independence
tile, and closed under concatenation. -/
inductive DiamondEq
    {P : InteractionPresentation.{uSite, uEvent} theory}
    (indep : SiteIndependence P) :
    {s t : theory.Term} → OccurrencePath P s t → OccurrencePath P s t → Prop
  | refl {s t : theory.Term} (p : OccurrencePath P s t) :
      DiamondEq indep p p
  | symm {s t : theory.Term} {p q : OccurrencePath P s t} :
      DiamondEq indep p q → DiamondEq indep q p
  | trans {s t : theory.Term} {p q r : OccurrencePath P s t} :
      DiamondEq indep p q → DiamondEq indep q r → DiamondEq indep p r
  | swap {source : theory.Term} (tile : IndependenceTile P indep source) :
      DiamondEq indep tile.path tile.pathSwap'
  | cong_left {s m t : theory.Term} (pre : OccurrencePath P s m)
      {p q : OccurrencePath P m t} :
      DiamondEq indep p q →
        DiamondEq indep (OccurrencePath.append pre p)
          (OccurrencePath.append pre q)
  | cong_right {s m t : theory.Term} {p q : OccurrencePath P s m}
      (post : OccurrencePath P m t) :
      DiamondEq indep p q →
        DiamondEq indep (OccurrencePath.append p post)
          (OccurrencePath.append q post)

namespace DiamondEq

variable {P : InteractionPresentation.{uSite, uEvent} theory}
  (indep : SiteIndependence P)

theorem is_equivalence {s t : theory.Term} :
    Equivalence (fun p q : OccurrencePath P s t => DiamondEq indep p q) :=
  ⟨refl, fun h => symm h, fun h₁ h₂ => trans h₁ h₂⟩

end DiamondEq

def diamondSetoid {P : InteractionPresentation.{uSite, uEvent} theory}
    (indep : SiteIndependence P) (s t : theory.Term) :
    Setoid (OccurrencePath P s t) where
  r := DiamondEq indep
  iseqv := DiamondEq.is_equivalence indep

/-- Mazurkiewicz traces: occurrence paths modulo generated diamonds. -/
def TraceHom {P : InteractionPresentation.{uSite, uEvent} theory}
    (indep : SiteIndependence P) (s t : theory.Term) : Type _ :=
  Quotient (diamondSetoid indep s t)

def mkTrace {P : InteractionPresentation.{uSite, uEvent} theory}
    {indep : SiteIndependence P} {s t : theory.Term}
    (p : OccurrencePath P s t) : TraceHom indep s t :=
  Quotient.mk (diamondSetoid indep s t) p

theorem mkTrace_sound {P : InteractionPresentation.{uSite, uEvent} theory}
    {indep : SiteIndependence P} {s t : theory.Term}
    {p q : OccurrencePath P s t} (h : DiamondEq indep p q) :
    mkTrace (indep := indep) p = mkTrace (indep := indep) q :=
  Quotient.sound h

def appendTrace {P : InteractionPresentation.{uSite, uEvent} theory}
    {indep : SiteIndependence P} {s m t : theory.Term}
    (left : TraceHom indep s m) (right : TraceHom indep m t) :
    TraceHom indep s t :=
  Quotient.liftOn left
    (fun p =>
      Quotient.liftOn right
        (fun q => mkTrace (OccurrencePath.append p q))
        (fun q₁ q₂ hq => mkTrace_sound (DiamondEq.cong_left p hq)))
    (fun p₁ p₂ hp => by
      refine Quotient.inductionOn right ?_
      intro q
      exact mkTrace_sound (DiamondEq.cong_right q hp))

theorem appendTrace_mk {P : InteractionPresentation.{uSite, uEvent} theory}
    {indep : SiteIndependence P} {s m t : theory.Term}
    (p : OccurrencePath P s m) (q : OccurrencePath P m t) :
    appendTrace (indep := indep) (mkTrace p) (mkTrace q) =
      mkTrace (OccurrencePath.append p q) :=
  rfl

abbrev TraceObject {P : InteractionPresentation.{uSite, uEvent} theory}
    (_indep : SiteIndependence P) :=
  theory.Term

instance {P : InteractionPresentation.{uSite, uEvent} theory}
    (indep : SiteIndependence P) : Category (TraceObject (P := P) indep) where
  Hom := fun s t => TraceHom indep s t
  id := fun s => mkTrace (.refl s)
  comp := fun f g => appendTrace f g
  id_comp := by
    intro _ _ f
    refine Quotient.inductionOn f ?_
    intro p
    change appendTrace (mkTrace (.refl _)) (mkTrace p) = mkTrace p
    rw [appendTrace_mk, OccurrencePath.refl_append]
  comp_id := by
    intro _ _ f
    refine Quotient.inductionOn f ?_
    intro p
    change appendTrace (mkTrace p) (mkTrace (.refl _)) = mkTrace p
    rw [appendTrace_mk, OccurrencePath.append_refl]
  assoc := by
    intro _ _ _ _ f g h
    refine Quotient.inductionOn f ?_
    intro p
    refine Quotient.inductionOn g ?_
    intro q
    refine Quotient.inductionOn h ?_
    intro r
    change appendTrace (appendTrace (mkTrace p) (mkTrace q)) (mkTrace r) =
      appendTrace (mkTrace p) (appendTrace (mkTrace q) (mkTrace r))
    rw [appendTrace_mk, appendTrace_mk, appendTrace_mk, appendTrace_mk,
      OccurrencePath.append_assoc]

/-- A valuation descends to Mazurkiewicz traces when it is constant on
generated diamonds. -/
def Descends {P : InteractionPresentation.{uSite, uEvent} theory}
    (indep : SiteIndependence P) {A : Type*} [AddMonoid A]
    (v : OccurrenceValuation P A) : Prop :=
  ∀ {s t : theory.Term} (p q : OccurrencePath P s t),
    DiamondEq indep p q → v.onPath p = v.onPath q

theorem descends_iff_tile_invariant
    {P : InteractionPresentation.{uSite, uEvent} theory}
    (indep : SiteIndependence P) {A : Type*} [AddMonoid A]
    (v : OccurrenceValuation P A) :
    Descends indep v ↔ IndependenceTile.TileInvariant (indep := indep) v := by
  constructor
  · intro h src tile
    exact h tile.path tile.pathSwap' (.swap tile)
  · intro h s t p q rel
    induction rel with
    | refl _ => rfl
    | symm _ ih => exact ih.symm
    | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
    | swap tile => exact h tile
    | cong_left pre _ ih =>
        rw [v.onPath_append, v.onPath_append, ih]
    | cong_right post _ ih =>
        rw [v.onPath_append, v.onPath_append, ih]

theorem bagValuation_descends
    {P : InteractionPresentation.{uSite, uEvent} theory}
    (indep : SiteIndependence P) :
    Descends indep (bagValuation P) :=
  (descends_iff_tile_invariant indep (bagValuation P)).2
    (bagValuation_tile_invariant indep)

/-! Ordered site lists as a noncommutative valuation. -/

structure SiteWord (α : Type*) where
  toList : List α

instance (α : Type*) : Add (SiteWord α) where
  add x y := ⟨x.toList ++ y.toList⟩

instance (α : Type*) : Zero (SiteWord α) where
  zero := ⟨[]⟩

@[simp] theorem SiteWord.zero_toList {α : Type*} :
    (0 : SiteWord α).toList = [] :=
  rfl

@[simp] theorem SiteWord.add_toList {α : Type*} (x y : SiteWord α) :
    (x + y).toList = x.toList ++ y.toList :=
  rfl

@[ext] theorem SiteWord.ext {α : Type*} {x y : SiteWord α}
    (h : x.toList = y.toList) : x = y := by
  cases x
  cases y
  cases h
  rfl

instance (α : Type*) : AddMonoid (SiteWord α) where
  add_assoc := by
    intro x y z
    ext
    simp [List.append_assoc]
  zero_add := by
    intro x
    ext
    simp
  add_zero := by
    intro x
    ext
    simp
  nsmul := nsmulRec
  nsmul_zero := fun _ => rfl
  nsmul_succ := fun _ _ => rfl

def siteListValuation {P : InteractionPresentation.{uSite, uEvent} theory} :
    OccurrenceValuation P (SiteWord P.Site) where
  grade := fun o => ⟨[o.site]⟩

theorem siteListValuation_onPath
    {P : InteractionPresentation.{uSite, uEvent} theory}
    {s t : theory.Term} (p : OccurrencePath P s t) :
    ((siteListValuation (P := P)).onPath p).toList = OccurrencePath.sites p := by
  induction p with
  | refl =>
      simp [OccurrenceValuation.onPath, OccurrencePath.sites]
  | cons o rest ih =>
      calc
        ((siteListValuation (P := P)).onPath (.cons o rest)).toList
            = [o.site] ++ ((siteListValuation (P := P)).onPath rest).toList := by
              simp [OccurrenceValuation.onPath, siteListValuation]
        _ = o.site :: OccurrencePath.sites rest := by
              rw [ih]; rfl
        _ = OccurrencePath.sites (.cons o rest) :=
          rfl

theorem grid_diamond :
    DiamondEq gridIndep gridTile.path gridTile.pathSwap' :=
  .swap gridTile

theorem grid_siteList_not_tile_invariant :
    ¬ IndependenceTile.TileInvariant (indep := gridIndep)
        (siteListValuation (P := gridPresentation)) := by
  intro h
  have same := congrArg SiteWord.toList (h gridTile)
  rw [siteListValuation_onPath, siteListValuation_onPath] at same
  exact grid_not_tile_invariant_sites same

theorem grid_siteList_not_descends :
    ¬ Descends gridIndep (siteListValuation (P := gridPresentation)) := by
  intro h
  exact grid_siteList_not_tile_invariant
    ((descends_iff_tile_invariant gridIndep
        (siteListValuation (P := gridPresentation))).1 h)

theorem grid_bag_descends : Descends gridIndep (bagValuation gridPresentation) :=
  bagValuation_descends gridIndep

#print axioms descends_iff_tile_invariant
#print axioms bagValuation_descends
#print axioms grid_diamond
#print axioms grid_siteList_not_descends
#print axioms grid_bag_descends

end Mettapedia.GSLT.Causality.Mazurkiewicz
