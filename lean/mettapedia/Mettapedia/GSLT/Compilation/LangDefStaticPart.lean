/-!
# Static reducts of canonical LanguageDef semantics

Forgetting operational steps always keeps the semantic equation relation.
Deleting the rewrite declarations of a presentation realizes the same
reduct when its equation premises agree before and after the deletion.
This includes authored equations and the equations generated by grammar
declarations. A conditional equation that asks for a rewrite makes the
premise agreement substantive.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Compilation.LangDefStaticPart

open _root_.CategoryTheory
open scoped _root_.CategoryTheory
open Mettapedia.GSLT.IndexedOperational
open Mettapedia.OSLF.MeTTaIL.Syntax (LanguageDef Pattern GrammarRule)
open Mettapedia.OSLF.MeTTaIL.Engine (RelationEnv)
open Mettapedia.OSLF.MeTTaIL.ContextualStep
  (engineBasePremises NoncontextualPremises not_step_of_matchPatternForRule_eq_nil)
open Mettapedia.OSLF.Framework.TypeSynthesis
open Mettapedia.GSLT.LanguageDef (ValidatedLanguageDef)
open Mettapedia.GSLT.LanguageDef.EquationSemantics (EquationEquiv DerivedInstance derivedInstance_equivalent)
open Mettapedia.GSLT.LanguageDef.WellSorted (FreeTypeContext checkOpenPatternWellSorted_sound)
open Mettapedia.GSLT.LanguageDef.WellSorted (FreeTypeContext.empty)
open Mettapedia.GSLT.LanguageDef.EquationPremiseStability
  (PremisesAgree equationEquiv_iff premisesAgree_of_noncontextual)
open Mettapedia.GSLT.LanguageDef.RewriteValidationCertificate (validate_eq_nil_iff_signature_and_rewrites)

/-- Remove the directed rules while retaining authored equations and the
grammar that generates the collection equations. -/
def withoutRewrites (language : LanguageDef) : LanguageDef := { language with rewrites := [] }

def validatedReduct (language : ValidatedLanguageDef) : ValidatedLanguageDef :=
  ⟨withoutRewrites language.language,
    ((validate_eq_nil_iff_signature_and_rewrites _).mp language.valid).1⟩

abbrev semantics (relations : RelationEnv) (language : LanguageDef) : OperationalTheory :=
  ⟨langGSLTUsing relations language⟩

theorem no_step (relations : RelationEnv) (language : LanguageDef) :
    StaticPart.StepFree (semantics relations (withoutRewrites language)) := by
  rintro s t ⟨before, after, _, stepped, _⟩
  exact (not_step_of_matchPatternForRule_eq_nil fun _ member =>
    (List.not_mem_nil member).elim) stepped

/-- An erased presentation realizes the categorical reduct when the
premises of its equations have the same meaning at this boundary. -/
def reductIso (relations : RelationEnv) (language : ValidatedLanguageDef)
    (agreement : PremisesAgree (engineBasePremises relations) (engineBasePremises relations)
      language.language (withoutRewrites language.language)) :
    semantics relations (withoutRewrites language.language) ≅
      (StaticPart.forgetSteps.obj (semantics relations language.language)).obj where
  hom :=
    { mapTerm := id
      mapEquiv := fun {s t} =>
        (equationEquiv_iff language (validatedReduct language) rfl rfl rfl agreement s t).mpr
      mapStep := fun {s t} h => (no_step relations language.language s t h).elim }
  inv :=
    { mapTerm := id
      mapEquiv := fun {s t} =>
        (equationEquiv_iff language (validatedReduct language) rfl rfl rfl agreement s t).mp
      mapStep := fun h => h.elim }
  hom_inv_id := by
    apply OperationalTranslation.ext
    rfl
  inv_hom_id := by
    apply OperationalTranslation.ext
    rfl

/-- The standard base evaluator is independent of the program rewrite list.
Consequently, nonrecursive equation premises need no semantic side check. -/
theorem agreement_of_noncontextual (relations : RelationEnv) (language : LanguageDef)
    (noncontextual : ∀ equation ∈ language.equations, NoncontextualPremises equation.premises) :
    PremisesAgree (engineBasePremises relations) (engineBasePremises relations)
      language (withoutRewrites language) := by
  apply premisesAgree_of_noncontextual noncontextual
  intro _ _ premise _ bindings
  cases premise <;> rfl

/-- The canonical semantic reduct is represented by the erased LangDef
for all noncontextual equation premises, including the premise-free case. -/
def reductIso_of_noncontextual (relations : RelationEnv) (language : ValidatedLanguageDef)
    (noncontextual : ∀ equation ∈ language.language.equations, NoncontextualPremises equation.premises) :
    semantics relations (withoutRewrites language.language) ≅
      (StaticPart.forgetSteps.obj (semantics relations language.language)).obj :=
  reductIso relations language (agreement_of_noncontextual relations language.language noncontextual)

/-- The syntax comparison also applies to this erasure, regardless of any
operational dependencies of the authored equations. -/
def reductFrames (language : LanguageDef) :=
  SyntaxOnFrames.contextsEquivalence (left := withoutRewrites language) (right := language) rfl

namespace Controls

open Mettapedia.GSLT.LanguageDef.EquationPremiseStability.Controls

/-- The unconditional equality is present in the reduct and its distinct
representatives remain distinct pieces of syntax. -/
theorem reduct_keeps_nontrivial_equation :
    a ≠ b ∧ (langGSLTUsing RelationEnv.empty (withoutRewrites unconditionalAfter)).Equiv a b :=
  unconditional_nontrivial

/-- An identity-on-terms translation in the reverse direction can fail
when an unchanged equation requires a removed rewrite. -/
theorem deleting_rewrites_can_lose_equality :
    ¬ ∃ f : (StaticPart.forgetSteps.obj (semantics RelationEnv.empty after)).obj ⟶
        semantics RelationEnv.empty (withoutRewrites after),
      ∀ s, f.mapTerm s = s := by
  rintro ⟨translation, same⟩
  have lost := translation.mapEquiv after_equivalent
  change EquationEquiv base before (translation.mapTerm a) (translation.mapTerm b) at lost
  have fixed (p : Pattern) : translation.mapTerm p = p := same p
  rw [fixed a, fixed b] at lost
  exact before_not_equivalent lost

def bagConstructor : GrammarRule :=
  { label := "Bag", category := "Term"
    params := [.simple "elements" (.collection .hashBag (.base "Term"))]
    syntaxPattern := [] }

def bagLanguage : LanguageDef :=
  { before with terms := [constant "A", constant "B", bagConstructor], equations := [], rewrites := [] }

def bag (elements : List Pattern) : Pattern := .collection .hashBag elements none

/-- Grammar declarations alone suffice for the generated permutation law. -/
theorem syntax_keeps_bag_equation :
    bag [a, b] ≠ bag [b, a] ∧
      (langGSLTUsing RelationEnv.empty (SyntaxOnFrames.syntaxPart bagLanguage)).Equiv
        (bag [a, b]) (bag [b, a]) := by
  refine ⟨by decide, derivedInstance_equivalent ?_⟩
  exact DerivedInstance.bagPerm_of_sorted (category := "Term")
    ⟨FreeTypeContext.empty, [], (checkOpenPatternWellSorted_sound (by decide +kernel)).1⟩
    (List.Perm.swap b a [])

end Controls

