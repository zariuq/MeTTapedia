import Mettapedia.GSLT.Dedukti.LanguageDefSteps
import Mettapedia.GSLT.Contexts.TermsAlone

/-!
# The generated context theory of a λΠ-modulo language, against `rewritingTheory`

**What the existing `lfLanguageDef` generates.**  Its rewrite `Beta` writes its
contractum as `eval(B, X)`, which elaborates to the node `$eval`; the rule
semantics of `ContextualStep` does not execute that node.  Every step of
`lfLanguageDef` ends in a `$eval` node (`lfStep_target`), which is a term of
no interface, because no constructor is called `$eval` (`not_hasType_eval`).
So **the context theory generated by `lfLanguageDef` has no transition at
all** (`lfPresentation_no_rewrites`), while the pure calculus has beta steps
(`beta_not_in_lfPresentation`): beta is a rule that `rewritingTheory` admits
and the `LanguageDef` does not.

**What `dkLanguage` generates.**  It has no equation and no collection, so its
static equivalence is identity (`dk_termSetoid_iff`), and a transition is a
step of the language (`dk_termStep_iff`).  Take the interface of the terms of
sort `LFTerm` beneath `depth` binders (`termInterface depth`), and the λΠ
terms whose encodings are well sorted there (`EncodedAt`: every term well
scoped at `depth` whose constants are declared, `encode_encodedAt`).  On
these, **the encoding is a bijection onto the terms of the interface**
(`encode_bijective`; every term of the interface is an encoding,
`exists_encode`).  The theory given by those λΠ terms, compared by identity
and reduced by the steps of the theory (`encodedRewriting`), maps into the
generated context theory by the encoding (`encodeMap`), and the terms of the
interface map back by the decoding (`decodeMap`); **both maps are hosting**
(`encodeMap_hosting`, `decodeMap_hosting`).

**What `rewritingTheory` and the generated context theory are to each
other.**  They are not the same object of the category: one has one
interface, the other one interface for each type and binder stage
(`rewritingTheory_ne_contextTheory`).  The identity on terms is defined on
part of the terms of `rewritingTheory` only: a term with a constant that is
not declared, or with a variable beyond the scope, has no encoding at the
interface (`not_encodedAt_undeclared`, `not_encodedAt_var` in
`LanguageDefExamples`).  So the comparison is made on terms alone, scope by
scope, and there it is exact: the terms of `rewritingTheory` with declared
constants at a scope and the terms of the matching interface are hosted by
each other, by the encoding one way and the decoding the other, and the
encoding is a bijection between them.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Dedukti.Language

open Mettapedia.GSLT
open Mettapedia.GSLT.LanguageDef
open Mettapedia.GSLT.LanguageDef.LF
open Mettapedia.GSLT.LanguageDef.WellSorted
open Mettapedia.GSLT.LanguageDef.EquationSemantics
open Mettapedia.GSLT.LanguageDef.Contexts (contextTheory termSetoid TermStep)
open Mettapedia.OSLF.MeTTaIL.Syntax (Pattern GrammarRule LanguageDef Premise TermParam TypeExpr
  Equation SyntaxItem)
open Mettapedia.OSLF.MeTTaIL.Match
open Mettapedia.OSLF.MeTTaIL.ContextualStep (BasePremiseEvaluator StepAt PremiseAt PremisesAt)
open Mettapedia.OSLF.MeTTaIL.ReflectiveSubstitution (applyBindingsForRule_eq_syntactic)
open Mettapedia.GSLT.LanguageDef.DerivedHosting (lfLanguageDef)

/-! ## The rows of `lfLanguageDef` -/

/-- The binder parameter of `Pi` and `Lam`. -/
def lfBody : TermParam := .abstractionNamed (some "x") "body" (.base "LFTerm")

/-- `Type`, a sort. -/
def sortTypeRule : GrammarRule :=
  { label := "SortType", category := "LFSort", params := [], syntaxPattern := [.terminal "Type"] }

/-- `Kind`, a sort. -/
def sortKindRule : GrammarRule :=
  { label := "SortKind", category := "LFSort", params := [], syntaxPattern := [.terminal "Kind"] }

/-- `Srt(s)`, a sort as a term. -/
def srtRule : GrammarRule :=
  { label := "Srt", category := "LFTerm", params := [.simple "s" (.base "LFSort")],
    syntaxPattern := [.terminal "Srt", .terminal "(", .nonTerminal "s", .terminal ")"] }

/-- `Con(n)`, a constant. -/
def conRule : GrammarRule :=
  { label := "Con", category := "LFTerm", params := [.simple "n" (.base "LFName")],
    syntaxPattern := [.terminal "Con", .terminal "(", .nonTerminal "n", .terminal ")"] }

/-- `Var(i)`, a variable by index. -/
def varRule : GrammarRule :=
  { label := "Var", category := "LFTerm", params := [.simple "i" (.base "LFIndex")],
    syntaxPattern := [.terminal "Var", .terminal "(", .nonTerminal "i", .terminal ")"] }

/-- `Pi(a, x. body)`. -/
def piRule : GrammarRule :=
  { label := "Pi", category := "LFTerm", params := [.simple "a" (.base "LFTerm"), lfBody],
    syntaxPattern := [.terminal "Pi", .terminal "(", .nonTerminal "a", .terminal ",",
      .nonTerminal "x", .terminal ".", .nonTerminal "body", .terminal ")"] }

/-- `Lam(a, x. body)`. -/
def lamRule : GrammarRule :=
  { label := "Lam", category := "LFTerm", params := [.simple "a" (.base "LFTerm"), lfBody],
    syntaxPattern := [.terminal "Lam", .terminal "(", .nonTerminal "a", .terminal ",",
      .nonTerminal "x", .terminal ".", .nonTerminal "body", .terminal ")"] }

/-- `App(f, a)`. -/
def appRule : GrammarRule :=
  { label := "App", category := "LFTerm",
    params := [.simple "f" (.base "LFTerm"), .simple "a" (.base "LFTerm")],
    syntaxPattern := [.terminal "App", .terminal "(", .nonTerminal "f", .terminal ",",
      .nonTerminal "a", .terminal ")"] }

/-- The constructors of `lfLanguageDef`. -/
def lfTermRules : List GrammarRule :=
  [sortTypeRule, sortKindRule, srtRule, conRule, varRule, piRule, lamRule, appRule]

theorem lfLanguageDef_terms : lfLanguageDef.terms = lfTermRules := by rfl

/-- The rewrite of `lfLanguageDef`, as elaborated: its right side is the
authored `eval`, the node `$eval`. -/
def lfBeta : Mettapedia.OSLF.MeTTaIL.Syntax.RewriteRule :=
  { «name» := "Beta", typeContext := [], premises := [],
    left := .apply "App" [.apply "Lam" [.fvar "A", .lambda (some "x") (.fvar "B")], .fvar "X"],
    right := .apply "$eval" [.fvar "B", .fvar "X"] }

theorem lfLanguageDef_rewrites : lfLanguageDef.rewrites = [lfBeta] := by rfl

def lfAlphaPi : Equation :=
  { «name» := "AlphaPi", typeContext := [], premises := [],
    left := .apply "Pi" [.fvar "A", .lambda (some "x") (.fvar "B")],
    right := .apply "Pi" [.fvar "A", .lambda (some "y") (.fvar "B")] }

def lfAlphaLam : Equation :=
  { «name» := "AlphaLam", typeContext := [], premises := [],
    left := .apply "Lam" [.fvar "A", .lambda (some "x") (.fvar "B")],
    right := .apply "Lam" [.fvar "A", .lambda (some "y") (.fvar "B")] }

def lfBetaEq : Equation :=
  { «name» := "BetaEq", typeContext := [], premises := [],
    left := .apply "App" [.apply "Lam" [.fvar "A", .lambda (some "x") (.fvar "B")], .fvar "X"],
    right := .apply "$eval" [.fvar "B", .fvar "X"] }

theorem lfLanguageDef_equations : lfLanguageDef.equations = [lfAlphaPi, lfAlphaLam, lfBetaEq] := by
  rfl

/-- The sorts of `lfLanguageDef`. -/
def lfSorts : List String := ["LFSort", "LFTerm", "LFName", "LFIndex"]

/-- The constructors of `lfLanguageDef` pass validation in every language with
its sorts. -/
theorem lfTermRules_valid (lang : LanguageDef) (sorts : lang.typeNames = lfSorts) :
    ∀ term ∈ lfTermRules, LanguageDef.validateTerm lang term = [] := by
  intro term member
  simp only [lfTermRules, List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [LanguageDef.validateTerm, sorts, lfSorts, sortTypeRule, sortKindRule, srtRule, conRule,
      varRule, piRule, lamRule, appRule, lfBody, TermParam.typeExpr, TermParam.bodyName,
      TermParam.binderNames]
  all_goals exact LanguageDef.validateTypeExpr_eq_nil_of_baseNames _ _ _ (by decide)

theorem lfLanguageDef_validate : lfLanguageDef.validate = [] := by
  apply LanguageDef.validate_eq_nil_of_rows
  · decide
  · decide
  · rw [lfLanguageDef_equations]; decide
  · rw [lfLanguageDef_rewrites]; decide
  · rw [lfLanguageDef_terms]; exact lfTermRules_valid _ rfl
  · intro equation member
    rw [lfLanguageDef_equations] at member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl | rfl <;>
    · apply LanguageDef.validateEquation_eq_nil_of_premiseFree
      · rfl
      · simp [lfAlphaPi, lfAlphaLam, lfBetaEq]
      · decide
      · decide
      · intro context
        simp [LanguageDef.validateRulePatterns, Pattern.isWellScoped, Pattern.isWellScopedAt,
          Pattern.isWellScopedListAt, LanguageDef.patternFvarNames, Pattern.freeFvarNames,
          LanguageDef.patternBinderNames, lfAlphaPi, lfAlphaLam, lfBetaEq]
        decide
  · intro rewrite member
    rw [lfLanguageDef_rewrites] at member
    rw [List.mem_singleton.mp member]
    apply LanguageDef.validateRewrite_eq_nil_of_premiseFree
    · rfl
    · simp [lfBeta]
    · decide
    · decide
    · intro context
      simp [LanguageDef.validateRulePatterns, Pattern.isWellScoped, Pattern.isWellScopedAt,
        Pattern.isWellScopedListAt, LanguageDef.patternFvarNames, Pattern.freeFvarNames,
        LanguageDef.patternBinderNames, lfBeta]
      decide

/-- **`lfLanguageDef`, validated.** -/
def lfPresentation : ValidatedLanguageDef := ⟨lfLanguageDef, lfLanguageDef_validate⟩

/-! ## No step of `lfLanguageDef` ends in a term -/

variable {base : BasePremiseEvaluator}

/-- **Every step of `lfLanguageDef` ends in a `$eval` node.** -/
theorem lfStep_target {source target : Pattern}
    (step : Mettapedia.OSLF.MeTTaIL.ContextualStep.Step base lfLanguageDef source target) :
    ∃ arguments, target = .apply "$eval" arguments := by
  obtain ⟨fuel, step⟩ := step
  cases step with
  | @rule fuel source target rule initial final member _ _ targetEq =>
      rw [lfLanguageDef_rewrites] at member
      rw [List.mem_singleton.mp member] at targetEq
      rw [applyBindingsForRule_eq_syntactic] at targetEq
      refine ⟨[applyBindingsScoped lfBeta.left final 0 (.fvar "B"),
        applyBindingsScoped lfBeta.left final 0 (.fvar "X")], ?_⟩
      rw [← targetEq]
      rfl

/-- **No pattern headed by `$eval` has a type**, in a language with no
constructor of that name. -/
theorem not_hasType_eval {language : LanguageDef}
    (absent : ∀ rule ∈ language.terms, rule.label ≠ "$eval") {free : FreeTypeContext}
    {bound : List TypeExpr} {arguments : List Pattern} {type : TypeExpr} :
    ¬ WellSorted.HasType language free bound (Pattern.apply "$eval" arguments) type := by
  intro typed
  generalize same : Pattern.apply "$eval" arguments = pattern at typed
  cases typed with
  | constructor member _ _ =>
      simp only [Pattern.apply.injEq] at same
      exact absent _ member same.1.symm
  | bvar _ => cases same
  | fvar _ => cases same
  | lambda _ => cases same
  | multiLambda _ => cases same
  | subst _ _ => cases same
  | collection _ => cases same
  | collectionConstructor _ _ _ => cases same

/-- **The context theory generated by `lfLanguageDef` has no transition.** -/
theorem lfPresentation_no_rewrites {interface : (contextTheory base lfPresentation).Interface}
    (source target : (contextTheory base lfPresentation).Term interface) :
    ¬ (contextTheory base lfPresentation).rewrites source target := by
  rintro ⟨redex, contractum, _, step, _⟩
  obtain ⟨arguments, eval⟩ := lfStep_target step
  have sorted := contractum.2.1
  rw [eval] at sorted
  refine not_hasType_eval (language := lfLanguageDef) ?_ sorted
  rw [lfLanguageDef_terms]
  decide

/-- The redex `(λ x : Type. x) Type`. -/
def identityRedex : Term := .app (.lam (.srt .type) (.var 0)) (.srt .type)

/-- **Beta is a rule that `rewritingTheory` admits and the context theory of
`lfLanguageDef` does not**: the pure calculus contracts the redex, and
`lfLanguageDef` has no transition at all. -/
theorem beta_not_in_lfPresentation :
    (rewritingTheory Theory.empty).rewrites (interface := ()) identityRedex (.srt .type) ∧
      ∀ (interface : (contextTheory base lfPresentation).Interface)
        (source target : (contextTheory base lfPresentation).Term interface),
          ¬ (contextTheory base lfPresentation).rewrites source target :=
  ⟨Step.root (.beta (.srt .type) (.var 0) (.srt .type)), fun _ => lfPresentation_no_rewrites⟩

/-! ## The generated context theory of `dkLanguage` -/

variable {names : List String} {rules : List RewriteRule}

/-- `dkLanguage`, validated. -/
def dkPresentation (names : List String) (rules : List RewriteRule)
    (valid : (dkLanguage names rules).validate = []) : ValidatedLanguageDef :=
  ⟨dkLanguage names rules, valid⟩

private theorem dkLanguage_terms_shape : ∀ rule ∈ (dkLanguage names rules).terms,
    rule.algebra? = none ∧
      ¬ ∃ (parameterName : String) (kind : OSLF.MeTTaIL.Syntax.CollType) (elementType : TypeExpr),
        rule.params = [.simple parameterName (.collection kind elementType)] := by
  intro rule member
  rcases List.mem_append.mp member with lf | named
  · rw [lfLanguageDef_terms] at lf
    simp only [lfTermRules, List.mem_cons, List.not_mem_nil, or_false] at lf
    rcases lf with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp [sortTypeRule, sortKindRule, srtRule, conRule, varRule, piRule, lamRule,
        appRule, lfBody]
  · obtain ⟨symbol, _, rfl⟩ := List.mem_map.mp named
    simp [nameRule]

/-- No constructor of `dkLanguage` is a collection or carries a collection
algebra. -/
theorem dkLanguage_terms_plain : ∀ rule ∈ (dkLanguage names rules).terms,
    rule.algebra? = none ∧ ¬ UsesBareCollection rule := by
  intro rule member
  obtain ⟨noAlgebra, noCollection⟩ := dkLanguage_terms_shape rule member
  refine ⟨noAlgebra, ?_⟩
  rintro ⟨parameterName, kind, elementType, shape⟩
  exact noCollection ⟨parameterName, kind, elementType,
    ((GrammarRule.bareParams_cons_iff _ _ _).mp shape).2⟩

private theorem dkLanguage_collection_parameters_absent :
    ∀ rule ∈ (dkLanguage names rules).terms, ∀ kind : OSLF.MeTTaIL.Syntax.CollType,
      rule.params.all (fun parameter => !parameter.typeExpr.mentionsCollection kind) = true := by
  intro rule member kind
  rcases List.mem_append.mp member with lf | named
  · rw [lfLanguageDef_terms] at lf
    simp only [lfTermRules, List.mem_cons, List.not_mem_nil, or_false] at lf
    rcases lf with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp [sortTypeRule, sortKindRule, srtRule, conRule, varRule, piRule, lamRule,
        appRule, lfBody, TermParam.typeExpr, TypeExpr.mentionsCollection]
  · obtain ⟨symbol, _, rfl⟩ := List.mem_map.mp named
    simp [nameRule]

private theorem dk_not_collectionTypedAt {rule : GrammarRule}
    {kind : OSLF.MeTTaIL.Syntax.CollType} {elements : List Pattern}
    (authored : rule ∈ (dkLanguage names rules).terms)
    (typed : CollectionTypedAt (dkLanguage names rules) rule kind elements) : False := by
  obtain ⟨parameter, member, mentions⟩ := typed.mentions
  have absent := List.all_eq_true.mp (dkLanguage_collection_parameters_absent rule authored kind) parameter member
  rw [mentions] at absent
  cases absent

theorem dkLanguage_equations : (dkLanguage names rules).equations = [] := rfl

/-- **`dkLanguage` has no equation step.** -/
theorem dk_not_equationContextStep {left right : Pattern} :
    ¬ EquationContextStep base (dkLanguage names rules) left right := by
  rintro ⟨context, generator⟩
  rcases generator with ⟨fuel, generated⟩ | derived
  · cases generated with
    | forward member _ _ _ => rw [dkLanguage_equations] at member; cases member
    | reverse member _ _ _ => rw [dkLanguage_equations] at member; cases member
    | declared member _ _ => rw [dkLanguage_equations] at member; cases member
  · cases derived with
    | bagPerm authored typed _ => exact dk_not_collectionTypedAt authored typed
    | setPerm authored typed _ => exact dk_not_collectionTypedAt authored typed
    | setDedup authored typed => exact dk_not_collectionTypedAt authored typed
    | flatten algebra _ _ =>
        have none := (dkLanguage_terms_plain _ algebra.authored).1
        rw [algebra.declared] at none
        cases none
    | singleton algebra _ _ =>
        have none := (dkLanguage_terms_plain _ algebra.authored).1
        rw [algebra.declared] at none
        cases none
    | unitElim algebra _ _ =>
        have none := (dkLanguage_terms_plain _ algebra.authored).1
        rw [algebra.declared] at none
        cases none
    | emptyUnit algebra _ _ =>
        have none := (dkLanguage_terms_plain _ algebra.authored).1
        rw [algebra.declared] at none
        cases none

/-- **The static equivalence of the generated context theory is identity.** -/
theorem dk_termSetoid_iff {interface : Contexts.Interface}
    (first second : Contexts.Term (dkLanguage names rules) interface) :
    (termSetoid base (dkLanguage names rules) interface).r first second ↔ first = second := by
  constructor
  · intro related
    induction related with
    | rel _ _ step => exact (dk_not_equationContextStep step).elim
    | refl => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ihFirst ihSecond => exact ihFirst.trans ihSecond
  · rintro rfl
    exact Relation.EqvGen.refl _

/-- **A transition is a step of the language.** -/
theorem dk_termStep_iff {interface : Contexts.Interface}
    (source target : Contexts.Term (dkLanguage names rules) interface) :
    TermStep base (dkLanguage names rules) source target ↔
      Mettapedia.OSLF.MeTTaIL.ContextualStep.Step base (dkLanguage names rules) source.1 target.1 := by
  constructor
  · rintro ⟨redex, contractum, before, step, after⟩
    rw [dk_termSetoid_iff] at before after
    subst before
    subst after
    exact step
  · intro step
    exact ⟨source, target, Relation.EqvGen.refl _, step, Relation.EqvGen.refl _⟩

/-! ## Terms of one scope, and the encoding as a hosting map -/

/-- The interface of the terms of sort `LFTerm` beneath `depth` binders. -/
def termInterface (depth : Nat) : Contexts.Interface :=
  ⟨.base "LFTerm", List.replicate depth (.base "LFTerm")⟩

/-- The λΠ terms whose encodings are terms of the interface. -/
def EncodedAt (language : LanguageDef) (depth : Nat) (term : Term) : Prop :=
  OpenPatternWellSorted language FreeTypeContext.empty (List.replicate depth (.base "LFTerm"))
    (.base "LFTerm") (encode term)

/-- **The calculus as it runs, on the terms of one scope**: compared by
identity, reduced by the steps of the theory. -/
def encodedRewriting (theory : Theory) (language : LanguageDef) (depth : Nat) : GSLT.{0} where
  Term := {term : Term // EncodedAt language depth term}
  «equations» := ⟨Eq, ⟨fun _ => rfl, fun same => same.symm, fun first second => first.trans second⟩⟩
  «rewrites» := fun source target => Dedukti.Step theory source.1 target.1
  rewrites_resp_left := fun same step => ⟨_, same ▸ step, rfl⟩
  rewrites_resp_right := fun step same => same ▸ step

/-- **The encoding, as a map of theories** into the generated context theory. -/
def encodeMap (theory : Theory) (valid : (dkLanguage names rules).validate = []) (depth : Nat) :
    ContextMap (encodedRewriting theory (dkLanguage names rules) depth).termsAlone
      (contextTheory base (dkPresentation names rules valid)) :=
  ContextMap.ofTerms (source := encodedRewriting theory (dkLanguage names rules) depth)
    (target := contextTheory base (dkPresentation names rules valid)) (termInterface depth)
    (fun term => ⟨encode term.1, term.2⟩)
    (fun same => by subst same; exact Relation.EqvGen.refl _)

/-- **The encoding is hosting**: it identifies no two terms, and the
transitions of the image of a term are the images of its steps. -/
theorem encodeMap_hosting {theory : Theory} (presents : Presents theory rules)
    (valid : (dkLanguage names rules).validate = []) (depth : Nat) :
    (encodeMap (base := base) theory valid depth).Hosting := by
  refine (ContextMap.ofTerms_hosting_iff (source := encodedRewriting theory (dkLanguage names rules) depth)
    (target := contextTheory base (dkPresentation names rules valid)) (termInterface depth)
    (fun term => ⟨encode term.1, term.2⟩)
    (fun same => by subst same; exact Relation.EqvGen.refl _)).mpr ⟨?_, ?_, ?_⟩
  · intro first second related
    have same := (dk_termSetoid_iff _ _).mp related
    exact Subtype.ext (encode_injective (congrArg Subtype.val same))
  · intro first next step
    exact (dk_termStep_iff _ _).mpr ((step_encode_iff presents).mpr ⟨_, rfl, step⟩)
  · intro first next step
    obtain ⟨target, targetEq, sourceStep⟩ := (step_encode_iff presents).mp ((dk_termStep_iff _ _).mp step)
    refine ⟨⟨target, ?_⟩, sourceStep, ?_⟩
    · have sorted := next.2
      rw [targetEq] at sorted
      exact sorted
    · exact (dk_termSetoid_iff _ _).mpr (Subtype.ext targetEq)

/-- **`rewritingTheory` and the generated context theory are not the same
object**: the first has one interface, the second many. -/
theorem rewritingTheory_ne_contextTheory (theory : Theory) (presentation : ValidatedLanguageDef) :
    rewritingTheory theory ≠ contextTheory base presentation := by
  intro same
  have interfaces : (Unit : Type) = Contexts.Interface := congrArg ContextTheory.Interface same
  have distinct : (⟨.base "a", []⟩ : Contexts.Interface) ≠ ⟨.base "b", []⟩ := by simp
  exact distinct ((Equiv.cast interfaces).symm.injective (Subsingleton.elim _ _))

/-! ## Which terms are encoded at a scope -/

/-- The constants of a term. -/
def constants : Term → List String
  | .con symbol => [symbol]
  | .pi domain body => constants domain ++ constants body
  | .lam domain body => constants domain ++ constants body
  | .app function argument => constants function ++ constants argument
  | .var _ => []
  | .srt _ => []

theorem lfRule_mem {rule : GrammarRule} (member : rule ∈ lfTermRules) :
    rule ∈ (dkLanguage names rules).terms :=
  List.mem_append_left _ (by rw [lfLanguageDef_terms]; exact member)

/-- **The encoding of a term whose constants are declared is typed**, at the
scope of its free variables. -/
theorem encode_hasType (term : Term) :
    ∀ depth : Nat, WellScoped depth term → (∀ symbol ∈ constants term, symbol ∈ names) →
      WellSorted.HasType (dkLanguage names rules) FreeTypeContext.empty
        (List.replicate depth (.base "LFTerm")) (encode term) (.base "LFTerm") := by
  induction term with
  | var index =>
      intro depth wellScoped _
      cases wellScoped with
      | var bound => exact .bvar (by simp [bound])
  | srt sort =>
      intro depth _ _
      cases sort with
      | type =>
          exact .constructor (rule := srtRule) (lfRule_mem (by simp [lfTermRules]))
            (by simp [UsesBareCollection, srtRule])
            (.cons trivial rfl (.constructor (rule := sortTypeRule)
              (lfRule_mem (by simp [lfTermRules])) (by simp [UsesBareCollection, sortTypeRule]) .nil) .nil)
      | kind =>
          exact .constructor (rule := srtRule) (lfRule_mem (by simp [lfTermRules]))
            (by simp [UsesBareCollection, srtRule])
            (.cons trivial rfl (.constructor (rule := sortKindRule)
              (lfRule_mem (by simp [lfTermRules])) (by simp [UsesBareCollection, sortKindRule]) .nil) .nil)
  | con symbol =>
      intro depth _ declared
      have named : nameRule symbol ∈ (dkLanguage names rules).terms :=
        List.mem_append_right _ (List.mem_map_of_mem (declared symbol (by simp [constants])))
      exact .constructor (rule := conRule) (lfRule_mem (by simp [lfTermRules]))
        (by simp [UsesBareCollection, conRule])
        (.cons trivial rfl (.constructor (rule := nameRule symbol) named
          (by simp [UsesBareCollection, nameRule]) .nil) .nil)
  | pi domain body ihDomain ihBody =>
      intro depth wellScoped declared
      cases wellScoped with
      | pi domainScoped bodyScoped =>
          have bodyTyped := ihBody (depth + 1) bodyScoped fun symbol member =>
            declared symbol (List.mem_append_right _ member)
          rw [List.replicate_succ] at bodyTyped
          exact .constructor (rule := piRule) (lfRule_mem (by simp [lfTermRules]))
            (by simp [UsesBareCollection, piRule])
            (.cons trivial rfl (ihDomain depth domainScoped fun symbol member =>
                declared symbol (List.mem_append_left _ member))
              (.cons trivial rfl (.lambda bodyTyped) .nil))
  | lam domain body ihDomain ihBody =>
      intro depth wellScoped declared
      cases wellScoped with
      | lam domainScoped bodyScoped =>
          have bodyTyped := ihBody (depth + 1) bodyScoped fun symbol member =>
            declared symbol (List.mem_append_right _ member)
          rw [List.replicate_succ] at bodyTyped
          exact .constructor (rule := lamRule) (lfRule_mem (by simp [lfTermRules]))
            (by simp [UsesBareCollection, lamRule])
            (.cons trivial rfl (ihDomain depth domainScoped fun symbol member =>
                declared symbol (List.mem_append_left _ member))
              (.cons trivial rfl (.lambda bodyTyped) .nil))
  | app function argument ihFunction ihArgument =>
      intro depth wellScoped declared
      cases wellScoped with
      | app functionScoped argumentScoped =>
          exact .constructor (rule := appRule) (lfRule_mem (by simp [lfTermRules]))
            (by simp [UsesBareCollection, appRule])
            (.cons trivial rfl (ihFunction depth functionScoped fun symbol member =>
                declared symbol (List.mem_append_left _ member))
              (.cons trivial rfl (ihArgument depth argumentScoped fun symbol member =>
                declared symbol (List.mem_append_right _ member)) .nil))

theorem encode_canonical (term : Term) : (encode term).hasCanonicalBinderMetadata = true := by
  induction term with
  | srt sort => cases sort <;> simp [encode, Pattern.hasCanonicalBinderMetadata,
      Pattern.hasCanonicalBinderMetadataList]
  | _ => simp_all [encode, Pattern.hasCanonicalBinderMetadata, Pattern.hasCanonicalBinderMetadataList]

theorem encode_object (term : Term) : isObjectPattern (encode term) = true := by
  induction term with
  | srt sort => cases sort <;> simp [encode, isObjectPattern, isObjectPatternList]
  | _ => simp_all [encode, isObjectPattern, isObjectPatternList]

theorem isWellScopedAt_encode {term : Term} {depth : Nat} (wellScoped : WellScoped depth term) :
    (encode term).isWellScopedAt depth = true := by
  induction wellScoped with
  | @srt _ sort => cases sort <;> simp [encode, Pattern.isWellScopedAt, Pattern.isWellScopedListAt]
  | con => simp [encode, Pattern.isWellScopedAt, Pattern.isWellScopedListAt]
  | var bound => simp [encode, Pattern.isWellScopedAt, bound]
  | _ => simp_all [encode, Pattern.isWellScopedAt, Pattern.isWellScopedListAt]

/-- **Every term well scoped at a depth whose constants are declared is
encoded at that depth.** -/
theorem encode_encodedAt {term : Term} {depth : Nat} (wellScoped : WellScoped depth term)
    (declared : ∀ symbol ∈ constants term, symbol ∈ names) :
    EncodedAt (dkLanguage names rules) depth term := by
  refine ⟨encode_hasType term depth wellScoped declared, encode_canonical term, encode_object term, ?_⟩
  show (encode term).isWellScopedAt (List.replicate depth (TypeExpr.base "LFTerm")).length = true
  rw [List.length_replicate]
  exact isWellScopedAt_encode wellScoped

/-! ## Every term of the interface is an encoding -/

theorem sort_of_getElem?_replicate {depth index : Nat} {sort : String}
    (found : (List.replicate depth (TypeExpr.base "LFTerm"))[index]? = some (.base sort)) :
    sort = "LFTerm" := by
  rw [List.getElem?_replicate] at found
  split at found
  · exact (TypeExpr.base.inj (Option.some.inj found)).symm
  · exact absurd found (by simp)

/-- A term of a base sort of `dkLanguage` is a variable or a constructor
application. -/
theorem hasType_base_inv {bound : List TypeExpr} {pattern : Pattern} {sort : String}
    (typed : WellSorted.HasType (dkLanguage names rules) FreeTypeContext.empty bound pattern
      (.base sort))
    (object : isObjectPattern pattern = true) :
    (∃ index, pattern = .bvar index ∧ bound[index]? = some (.base sort)) ∨
      ∃ rule ∈ (dkLanguage names rules).terms, ∃ arguments, pattern = .apply rule.label arguments ∧
        rule.category = sort ∧
        WellSorted.ArgumentsHaveTypes (dkLanguage names rules) FreeTypeContext.empty bound arguments
          rule.params := by
  generalize same : TypeExpr.base sort = type at typed
  cases typed with
  | bvar found => exact .inl ⟨_, rfl, found⟩
  | fvar found => simp [FreeTypeContext.empty] at found
  | constructor member _ arguments =>
      exact .inr ⟨_, member, _, rfl, (TypeExpr.base.inj same).symm, arguments⟩
  | lambda _ => cases same
  | multiLambda _ => cases same
  | subst _ _ => simp [isObjectPattern] at object
  | collection _ => cases same
  | collectionConstructor member parameters _ =>
      exact absurd ⟨_, _, _, parameters⟩ (dkLanguage_terms_plain _ member).2

/-- The constructors of `dkLanguage`. -/
theorem mem_dkLanguage_terms {rule : GrammarRule} (member : rule ∈ (dkLanguage names rules).terms) :
    rule = sortTypeRule ∨ rule = sortKindRule ∨ rule = srtRule ∨ rule = conRule ∨ rule = varRule ∨
      rule = piRule ∨ rule = lamRule ∨ rule = appRule ∨ ∃ symbol ∈ names, rule = nameRule symbol := by
  rcases List.mem_append.mp member with lf | named
  · rw [lfLanguageDef_terms] at lf
    simp only [lfTermRules, List.mem_cons, List.not_mem_nil, or_false] at lf
    rcases lf with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp
  · obtain ⟨symbol, listed, rfl⟩ := List.mem_map.mp named
    exact .inr (.inr (.inr (.inr (.inr (.inr (.inr (.inr ⟨symbol, listed, rfl⟩)))))))

/-- The terms of sort `LFSort` are the two sorts. -/
theorem sort_inv {depth : Nat} {pattern : Pattern}
    (typed : WellSorted.HasType (dkLanguage names rules) FreeTypeContext.empty
      (List.replicate depth (.base "LFTerm")) pattern (.base "LFSort"))
    (object : isObjectPattern pattern = true) :
    pattern = .apply "SortType" [] ∨ pattern = .apply "SortKind" [] := by
  rcases hasType_base_inv typed object with
    ⟨_, _, found⟩ | ⟨rule, member, arguments, rfl, category, typedArguments⟩
  · exact absurd (sort_of_getElem?_replicate found) (by decide)
  · have noArguments := typedArguments.length_eq
    rcases mem_dkLanguage_terms member with
      rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | ⟨symbol, _, rfl⟩
    · simp [sortTypeRule] at noArguments
      subst noArguments
      exact .inl rfl
    · simp [sortKindRule] at noArguments
      subst noArguments
      exact .inr rfl
    all_goals simp [srtRule, conRule, varRule, piRule, lamRule, appRule, nameRule] at category

/-- The terms of sort `LFName` are the names. -/
theorem name_inv {depth : Nat} {pattern : Pattern}
    (typed : WellSorted.HasType (dkLanguage names rules) FreeTypeContext.empty
      (List.replicate depth (.base "LFTerm")) pattern (.base "LFName"))
    (object : isObjectPattern pattern = true) :
    ∃ symbol ∈ names, pattern = .apply (nameLabel symbol) [] := by
  rcases hasType_base_inv typed object with
    ⟨_, _, found⟩ | ⟨rule, member, arguments, rfl, category, typedArguments⟩
  · exact absurd (sort_of_getElem?_replicate found) (by decide)
  · have noArguments := typedArguments.length_eq
    rcases mem_dkLanguage_terms member with
      rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | ⟨symbol, named, rfl⟩
    · simp [sortTypeRule] at category
    · simp [sortKindRule] at category
    · simp [srtRule] at category
    · simp [conRule] at category
    · simp [varRule] at category
    · simp [piRule] at category
    · simp [lamRule] at category
    · simp [appRule] at category
    · simp [nameRule] at noArguments
      subst noArguments
      exact ⟨symbol, named, rfl⟩

/-- No term has sort `LFIndex`. -/
theorem not_hasType_index {depth : Nat} {pattern : Pattern}
    (typed : WellSorted.HasType (dkLanguage names rules) FreeTypeContext.empty
      (List.replicate depth (.base "LFTerm")) pattern (.base "LFIndex"))
    (object : isObjectPattern pattern = true) : False := by
  rcases hasType_base_inv typed object with
    ⟨_, _, found⟩ | ⟨rule, member, arguments, rfl, category, _⟩
  · exact absurd (sort_of_getElem?_replicate found) (by decide)
  · rcases mem_dkLanguage_terms member with
      rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | ⟨symbol, _, rfl⟩ <;>
      simp [sortTypeRule, sortKindRule, srtRule, conRule, varRule, piRule, lamRule, appRule,
        nameRule] at category

/-- **Every object pattern of sort `LFTerm` beneath `depth` binders is an
encoding.** -/
theorem exists_encode_of_hasType :
    ∀ (size : Nat) (pattern : Pattern) (depth : Nat), sizeOf pattern < size →
      WellSorted.HasType (dkLanguage names rules) FreeTypeContext.empty
        (List.replicate depth (.base "LFTerm")) pattern (.base "LFTerm") →
      isObjectPattern pattern = true → ∃ term, encode term = pattern := by
  intro size
  induction size with
  | zero => intro _ _ small; exact absurd small (Nat.not_lt_zero _)
  | succ size ih =>
      intro pattern depth small typed object
      rcases hasType_base_inv typed object with
        ⟨index, rfl, _⟩ | ⟨rule, member, arguments, rfl, category, typedArguments⟩
      · exact ⟨.var index, rfl⟩
      · rcases mem_dkLanguage_terms member with
          rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | ⟨symbol, _, rfl⟩
        · simp [sortTypeRule] at category
        · simp [sortKindRule] at category
        · simp only [srtRule] at typedArguments
          cases typedArguments with
          | cons _ parameterType argumentTyped rest =>
              cases rest
              simp only [parameterType?, Option.some.injEq] at parameterType
              subst parameterType
              simp only [isObjectPattern, isObjectPatternList, Bool.and_true] at object
              rcases sort_inv argumentTyped object with rfl | rfl
              · exact ⟨.srt .type, rfl⟩
              · exact ⟨.srt .kind, rfl⟩
        · simp only [conRule] at typedArguments
          cases typedArguments with
          | cons _ parameterType argumentTyped rest =>
              cases rest
              simp only [parameterType?, Option.some.injEq] at parameterType
              subst parameterType
              simp only [isObjectPattern, isObjectPatternList, Bool.and_true] at object
              obtain ⟨symbol, _, rfl⟩ := name_inv argumentTyped object
              exact ⟨.con symbol, rfl⟩
        · simp only [varRule] at typedArguments
          cases typedArguments with
          | cons _ parameterType argumentTyped rest =>
              cases rest
              simp only [parameterType?, Option.some.injEq] at parameterType
              subst parameterType
              simp only [isObjectPattern, isObjectPatternList, Bool.and_true] at object
              exact (not_hasType_index argumentTyped object).elim
        · simp only [piRule] at typedArguments
          cases typedArguments with
          | cons _ domainType domainTyped rest =>
              cases rest with
              | cons representation bodyType bodyTyped rest =>
                  cases rest
                  simp only [parameterType?, Option.some.injEq] at domainType
                  subst domainType
                  obtain ⟨body, rfl⟩ :=
                    (matchesParameterRepresentation_abstractionNamed_iff _ _ _ _).mp representation
                  simp only [lfBody, parameterType?, Option.some.injEq] at bodyType
                  subst bodyType
                  cases bodyTyped with
                  | lambda bodyTyped =>
                      rw [← List.replicate_succ] at bodyTyped
                      simp only [isObjectPattern, isObjectPatternList, Bool.and_true,
                        Bool.and_eq_true] at object
                      simp only [Pattern.apply.sizeOf_spec, List.cons.sizeOf_spec,
                        List.nil.sizeOf_spec, Pattern.lambda.sizeOf_spec] at small
                      obtain ⟨domain, rfl⟩ := ih _ depth (by omega) domainTyped object.1
                      obtain ⟨body, rfl⟩ := ih _ (depth + 1) (by omega) bodyTyped object.2
                      exact ⟨.pi domain body, rfl⟩
        · simp only [lamRule] at typedArguments
          cases typedArguments with
          | cons _ domainType domainTyped rest =>
              cases rest with
              | cons representation bodyType bodyTyped rest =>
                  cases rest
                  simp only [parameterType?, Option.some.injEq] at domainType
                  subst domainType
                  obtain ⟨body, rfl⟩ :=
                    (matchesParameterRepresentation_abstractionNamed_iff _ _ _ _).mp representation
                  simp only [lfBody, parameterType?, Option.some.injEq] at bodyType
                  subst bodyType
                  cases bodyTyped with
                  | lambda bodyTyped =>
                      rw [← List.replicate_succ] at bodyTyped
                      simp only [isObjectPattern, isObjectPatternList, Bool.and_true,
                        Bool.and_eq_true] at object
                      simp only [Pattern.apply.sizeOf_spec, List.cons.sizeOf_spec,
                        List.nil.sizeOf_spec, Pattern.lambda.sizeOf_spec] at small
                      obtain ⟨domain, rfl⟩ := ih _ depth (by omega) domainTyped object.1
                      obtain ⟨body, rfl⟩ := ih _ (depth + 1) (by omega) bodyTyped object.2
                      exact ⟨.lam domain body, rfl⟩
        · simp only [appRule] at typedArguments
          cases typedArguments with
          | cons _ functionType functionTyped rest =>
              cases rest with
              | cons _ argumentType argumentTyped rest =>
                  cases rest
                  simp only [parameterType?, Option.some.injEq] at functionType argumentType
                  subst functionType argumentType
                  simp only [isObjectPattern, isObjectPatternList, Bool.and_true,
                    Bool.and_eq_true] at object
                  simp only [Pattern.apply.sizeOf_spec, List.cons.sizeOf_spec,
                    List.nil.sizeOf_spec] at small
                  obtain ⟨function, rfl⟩ := ih _ depth (by omega) functionTyped object.1
                  obtain ⟨argument, rfl⟩ := ih _ depth (by omega) argumentTyped object.2
                  exact ⟨.app function argument, rfl⟩
        · simp [nameRule] at category

/-- **Every term of the interface is the encoding of a term encoded there.** -/
theorem exists_encode {depth : Nat}
    (term : Contexts.Term (dkLanguage names rules) (termInterface depth)) :
    ∃ (source : Term) (encoded : EncodedAt (dkLanguage names rules) depth source),
      (⟨encode source, encoded⟩ : Contexts.Term (dkLanguage names rules) (termInterface depth)) =
        term := by
  obtain ⟨source, same⟩ :=
    exists_encode_of_hasType _ term.1 depth (Nat.lt_succ_self _) term.2.1 term.2.2.2.1
  refine ⟨source, ?_, Subtype.ext same⟩
  have sorted := term.2
  rw [← same] at sorted
  exact sorted

/-- **On the terms of one scope, the encoding is a bijection onto the terms
of the interface.** -/
theorem encode_bijective (theory : Theory) (depth : Nat) :
    Function.Bijective fun term : (encodedRewriting theory (dkLanguage names rules) depth).Term =>
      (⟨encode term.1, term.2⟩ : Contexts.Term (dkLanguage names rules) (termInterface depth)) := by
  refine ⟨fun first second same => Subtype.ext (encode_injective (congrArg Subtype.val same)), ?_⟩
  intro term
  obtain ⟨source, encoded, same⟩ := exists_encode term
  exact ⟨⟨source, encoded⟩, same⟩

/-! ## The way back: decoding the terms of the interface -/

theorem encode_decode_term {depth : Nat}
    (term : Contexts.Term (dkLanguage names rules) (termInterface depth)) :
    encode (decode term.1) = term.1 := by
  obtain ⟨source, _, same⟩ := exists_encode term
  rw [← same, decode_encode]

/-- The decoding of a term of the interface. -/
def decodeTerm (theory : Theory) {depth : Nat}
    (term : Contexts.Term (dkLanguage names rules) (termInterface depth)) :
    (encodedRewriting theory (dkLanguage names rules) depth).Term :=
  ⟨decode term.1, by
    have sorted := term.2
    rw [← encode_decode_term term] at sorted
    exact sorted⟩

/-- **The decoding, as a map of theories** from the terms of the interface,
with the transitions of the generated context theory, to the terms of the
scope with the steps of the theory. -/
def decodeMap (theory : Theory) (valid : (dkLanguage names rules).validate = []) (depth : Nat) :
    ContextMap ((contextTheory base (dkPresentation names rules valid)).gslt (termInterface depth)).termsAlone
      (encodedRewriting theory (dkLanguage names rules) depth).termsAlone :=
  ContextMap.ofTerms
    (source := (contextTheory base (dkPresentation names rules valid)).gslt (termInterface depth))
    (target := (encodedRewriting theory (dkLanguage names rules) depth).termsAlone) ()
    (decodeTerm theory)
    (fun related => by
      have same := (dk_termSetoid_iff _ _).mp related
      subst same
      exact (encodedRewriting theory (dkLanguage names rules) depth).equations.iseqv.refl _)

/-- **The decoding is hosting**: it identifies no two terms of the interface,
and the steps of the decoding of a term are the decodings of its
transitions. -/
theorem decodeMap_hosting {theory : Theory} (presents : Presents theory rules)
    (valid : (dkLanguage names rules).validate = []) (depth : Nat) :
    (decodeMap (base := base) theory valid depth).Hosting := by
  refine (ContextMap.ofTerms_hosting_iff
    (source := (contextTheory base (dkPresentation names rules valid)).gslt (termInterface depth))
    (target := (encodedRewriting theory (dkLanguage names rules) depth).termsAlone) ()
    (decodeTerm theory)
    (fun related => by
      have same := (dk_termSetoid_iff _ _).mp related
      subst same
      exact (encodedRewriting theory (dkLanguage names rules) depth).equations.iseqv.refl _)).mpr
    ⟨?_, ?_, ?_⟩
  · intro first second same
    have decoded : decode first.1 = decode second.1 :=
      congrArg Subtype.val (show decodeTerm theory first = decodeTerm theory second from same)
    refine (dk_termSetoid_iff _ _).mpr (Subtype.ext ?_)
    rw [← encode_decode_term first, ← encode_decode_term second, decoded]
  · intro first next step
    have raw := (dk_termStep_iff _ _).mp step
    rw [← encode_decode_term first] at raw
    obtain ⟨target, targetEq, sourceStep⟩ := (step_encode_iff presents).mp raw
    have decoded : decode next.1 = target := by rw [targetEq, decode_encode]
    show Dedukti.Step theory (decode first.1) (decode next.1)
    rw [decoded]
    exact sourceStep
  · intro first next step
    refine ⟨⟨encode next.1, next.2⟩, ?_, ?_⟩
    · apply (dk_termStep_iff _ _).mpr
      show Mettapedia.OSLF.MeTTaIL.ContextualStep.Step base (dkLanguage names rules) first.1
        (encode next.1)
      rw [← encode_decode_term first]
      exact (step_encode_iff presents).mpr ⟨_, rfl, step⟩
    · exact Subtype.ext (decode_encode next.1).symm

