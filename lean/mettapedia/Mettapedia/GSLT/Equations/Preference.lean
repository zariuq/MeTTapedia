import Mathlib.Logic.Relation
import Mathlib.Data.List.Perm.Basic

/-! # Equation classes and their presentations

A variadic equality needs only consecutive links to join all members.
Presentation arrows are independent: the admissible representatives are
vertices in sink strongly connected components. Reversal changes the
preference, not the equality being presented. No sorting order for
admissible representatives is prescribed here.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Equations.Preference

open Relation

variable {V L R : Type*}

def consecutive : List V → List (V × V)
  | x :: y :: xs => (x, y) :: consecutive (y :: xs)
  | _ => []

def Edge (edges : List (V × V)) (a b : V) : Prop := (a, b) ∈ edges

theorem consecutive_length (xs : List V) : (consecutive xs).length = xs.length - 1 := by
  match xs with
  | [] => rfl
  | [_] => rfl
  | x :: y :: xs =>
    simp only [consecutive, List.length_cons, consecutive_length (y :: xs)]
    omega

theorem consecutive_inside {xs : List V} {a b : V}
    (h : Edge (consecutive xs) a b) : a ∈ xs ∧ b ∈ xs := by
  match xs with
  | [] => simp [Edge, consecutive] at h
  | [_] => simp [Edge, consecutive] at h
  | x :: y :: xs =>
    rcases List.mem_cons.mp h with equal | rest
    · cases equal; simp
    · exact (consecutive_inside (xs := y :: xs) rest).imp
        (List.mem_cons_of_mem x) (List.mem_cons_of_mem x)

private theorem from_first (x : V) (xs : List V) {y : V} (known : y ∈ x :: xs) :
    EqvGen (Edge (consecutive (x :: xs))) x y := by
  induction xs generalizing x with
  | nil => simp at known; subst y; exact .refl _
  | cons a as ih =>
    rcases List.mem_cons.mp known with rfl | rest
    · exact .refl _
    · refine EqvGen.trans x a y (.rel _ _ (by simp [Edge, consecutive])) ?_
      exact (ih a rest).mono (fun _ _ h => List.mem_cons_of_mem _ h)

/-- A chain has exactly the equivalence generated by the clique. This also
allows duplicate members and numeric terms without a special flag value. -/
theorem consecutive_eq_clique (xs : List V) (a b : V) :
    EqvGen (Edge (consecutive xs)) a b ↔ EqvGen (fun x y => x ∈ xs ∧ y ∈ xs) a b := by
  constructor
  · exact fun h => h.mono (fun _ _ known => consecutive_inside known)
  · intro h
    induction h with
    | rel x y known =>
      cases xs with
      | nil => simp at known
      | cons z zs =>
        exact .trans _ _ _ (.symm _ _ (from_first z zs known.1)) (from_first z zs known.2)
    | refl x => exact .refl x
    | symm x y _ ih => exact .symm x y ih
    | trans x y z _ _ ih₁ ih₂ => exact .trans x y z ih₁ ih₂

theorem reversing_keeps_equivalence (edge : V → V → Prop) (x y : V) :
    EqvGen (fun a b => edge b a) x y ↔ EqvGen edge x y := by
  constructor <;> intro h
  · induction h with
    | rel a b h => exact .symm _ _ (.rel _ _ h)
    | refl a => exact .refl _
    | symm a b _ ih => exact .symm _ _ ih
    | trans a b c _ _ ha hb => exact .trans _ _ _ ha hb
  · induction h with
    | rel a b h => exact .symm _ _ (.rel _ _ h)
    | refl a => exact .refl _
    | symm a b _ ih => exact .symm _ _ ih
    | trans a b c _ _ ha hb => exact .trans _ _ _ ha hb

abbrev Reach {X : Type*} (edge : X → X → Prop) := ReflTransGen edge

/-- A vertex belongs to a sink component iff everything reachable from it
can return to it. This does not require selecting an SCC numbering. -/
def Eligible {X : Type*} (edge : X → X → Prop) (x : X) : Prop :=
  ∀ y, Reach edge x y → Reach edge y x

theorem eligible_perm (xs ys : List (V × V)) (h : xs.Perm ys) (v : V) :
    Eligible (Edge xs) v ↔ Eligible (Edge ys) v := by
  have same : Edge xs = Edge ys := by
    funext a b
    exact propext h.mem_iff
  rw [same]

/-- One new directed link between two previously disjoint components of
the *undirected* equation graph. Each side may have many preference SCCs. -/
def bridge (left : L → L → Prop) (right : R → R → Prop) (exit : L) (entry : R) :
    L ⊕ R → L ⊕ R → Prop
  | .inl x, .inl y => left x y
  | .inr x, .inr y => right x y
  | .inl x, .inr y => x = exit ∧ y = entry
  | .inr _, .inl _ => False

section Bridge

variable (left : L → L → Prop) (right : R → R → Prop) (exit : L) (entry : R)
local notation "B" => bridge left right exit entry

private theorem right_paths (x : R) {target : L ⊕ R} (path : Reach B (.inr x) target) :
    match target with
    | .inl _ => False
    | .inr y => Reach right x y := by
  induction path with
  | refl => exact .refl
  | @tail middle target _ edge ih =>
    cases middle with
    | inl a => exact False.elim ih
    | inr a =>
      cases target with
      | inl b => exact edge
      | inr b => exact ih.tail edge

private theorem left_paths (x : L) {target : L ⊕ R} (path : Reach B (.inl x) target) :
    match target with
    | .inl y => Reach left x y
    | .inr y => Reach left x exit ∧ Reach right entry y := by
  induction path with
  | refl => exact .refl
  | @tail middle target _ edge ih =>
    cases middle with
    | inl a =>
      cases target with
      | inl b => exact ih.tail edge
      | inr b =>
        obtain ⟨ha, hb⟩ := edge
        exact ⟨ha ▸ ih, hb ▸ .refl⟩
    | inr a =>
      cases target with
      | inl b => exact False.elim edge
      | inr b => exact ⟨ih.1, ih.2.tail edge⟩

private theorem lift_left {x y : L} (path : Reach left x y) : Reach B (.inl x) (.inl y) := by
  induction path with
  | refl => exact .refl
  | tail _ edge ih => exact ih.tail edge

private theorem lift_right {x y : R} (path : Reach right x y) : Reach B (.inr x) (.inr y) := by
  induction path with
  | refl => exact .refl
  | tail _ edge ih => exact ih.tail edge

theorem no_return (x : R) (y : L) : ¬ Reach B (.inr x) (.inl y) :=
  right_paths left right exit entry x

theorem left_reach (x y : L) : Reach B (.inl x) (.inl y) ↔ Reach left x y :=
  ⟨left_paths left right exit entry x, lift_left left right exit entry⟩

theorem right_reach (x y : R) : Reach B (.inr x) (.inr y) ↔ Reach right x y :=
  ⟨right_paths left right exit entry x, lift_right left right exit entry⟩

theorem cross_reach (x : L) (y : R) :
    Reach B (.inl x) (.inr y) ↔ Reach left x exit ∧ Reach right entry y := by
  refine ⟨left_paths left right exit entry x, ?_⟩
  rintro ⟨before, after⟩
  exact ((lift_left left right exit entry before).tail
    (show B (.inl exit) (.inr entry) from ⟨rfl, rfl⟩)).trans
    (lift_right left right exit entry after)

theorem eligible_right (x : R) : Eligible B (.inr x) ↔ Eligible right x := by
  constructor
  · intro h y xy
    exact (right_reach left right exit entry y x).1
      (h _ ((right_reach left right exit entry x y).2 xy))
  · intro h y xy
    cases y with
    | inl y => exact False.elim (no_return left right exit entry x y xy)
    | inr y =>
      exact (right_reach left right exit entry y x).2
        (h y ((right_reach left right exit entry x y).1 xy))

/-- Only an old sink SCC containing the exit can be disqualified.
This says which eligibility facts change, not how much it costs to maintain
the minima of arbitrarily many candidate components. -/
theorem eligible_left (x : L) :
    Eligible B (.inl x) ↔ Eligible left x ∧ ¬ Reach left x exit := by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · intro y xy
      exact (left_reach left right exit entry y x).1
        (h _ ((left_reach left right exit entry x y).2 xy))
    · intro reaches
      exact no_return left right exit entry entry x
        (h _ ((cross_reach left right exit entry x entry).2 ⟨reaches, .refl⟩))
  · rintro ⟨old, noExit⟩ y xy
    cases y with
    | inl y =>
      exact (left_reach left right exit entry y x).2
        (old y ((left_reach left right exit entry x y).1 xy))
    | inr y => exact False.elim (noExit ((cross_reach left right exit entry x y).1 xy).1)

end Bridge

end Mettapedia.GSLT.Equations.Preference
