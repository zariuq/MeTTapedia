import Mettapedia.Languages.ProcessCalculi.RhoCalculus.QuotedChannelBubbles
import Mettapedia.GSLT.GraphTheory.BudgetedBetaEtaObserver
import Mettapedia.Cybernetics.DistinctionCalculus.Ledger

/-!
# Graded observers over bubbles: two senses of "weakest", and grades as readouts

**Generated against observational.** For an admissible class `A` and a
relation `R` of stipulated identifications, `Generated A R` is the least
equivalence containing `R` and the equations and preserved by the contexts of
`A`. When every stipulation is observationally valid it lies inside the
bubble's equality `A.RelEquiv` (`generated_le_relEquiv`). The converse is a
completeness property of the stipulations:

* for the βη bubble, whose observers read the equational class, the
  congruence generated by the β- and η-steps *is* the bubble's equality
  (`betaEta_generated_iff`);
* for the sealed bubble of the quoted-channel calculus, no stipulation relates
  `nil ∣ nil` and `nil`, yet the guarded observers cannot separate them
  (`sealed_generated_strict`).

**A grade is a readout, never permission to substitute.** On the open bubble
(observers may use output payloads, so its equality is syntactic identity) the
depth-truncation distance `2^{-k}`, with `k` the first depth at which two
processes differ, is a metric tolerance whose zero kernel is the bubble's
equality (`depthTolerance_indistinguishable_iff`). For every `ε > 0` there are
two processes at positive distance below `ε` that the bubble does not identify,
and substituting one for the other in an admissible context changes an
observed barb (`grade_never_licenses_substitution`).
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.GradedObserverBridge

open Mettapedia.GSLT
open Mettapedia.GSLT.MinimalEnablingContext
open Mettapedia.GSLT.AdmissibleContextCongruence

universe uS uContext uRule uAtom

/-! ## The generated congruence of a bubble -/

section Generated

variable {S : GSLT.{uS}} {rules : ContextualRules.{uContext, uRule} S}

/-- The least equivalence containing the stipulations `R` and the equations,
preserved by every context of `A`. -/
inductive Generated (A : AdmissibleClass rules) (R : S.Term → S.Term → Prop) :
    S.Term → S.Term → Prop where
  | rel {left right : S.Term} : R left right → Generated A R left right
  | equiv {left right : S.Term} : S.Equiv left right → Generated A R left right
  | symm {left right : S.Term} : Generated A R left right → Generated A R right left
  | trans {left middle right : S.Term} : Generated A R left middle →
      Generated A R middle right → Generated A R left right
  | plug {context : rules.Context} {left right : S.Term} : A.Admissible context →
      Generated A R left right →
      Generated A R (rules.plug context left) (rules.plug context right)

/-- The generated congruence lies inside every equivalence that contains the
stipulations and the equations and is preserved by the admissible contexts. -/
theorem generated_le {A : AdmissibleClass rules} {R E : S.Term → S.Term → Prop}
    (equivalence : Equivalence E) (contains : ∀ {left right}, R left right → E left right)
    (base : ∀ {left right}, S.Equiv left right → E left right)
    (closed : ∀ {context left right}, A.Admissible context → E left right →
      E (rules.plug context left) (rules.plug context right))
    {left right : S.Term} (generated : Generated A R left right) : E left right := by
  induction generated with
  | rel related => exact contains related
  | equiv equivalent => exact base equivalent
  | symm _ ih => exact equivalence.symm ih
  | trans _ _ ih ih' => exact equivalence.trans ih ih'
  | plug admissible _ ih => exact closed admissible ih

/-- **Soundness of the generated end**: stipulations that the bubble's
observers validate generate only identifications that the bubble makes. -/
theorem generated_le_relEquiv (A : AdmissibleClass rules)
    (observations : ContextualRules.Observations.{uAtom} S) {R : S.Term → S.Term → Prop}
    (valid : ∀ {left right}, R left right → A.RelEquiv observations left right)
    {left right : S.Term} (generated : Generated A R left right) :
    A.RelEquiv observations left right := by
  induction generated with
  | rel related => exact valid related
  | equiv equivalent => exact A.relEquiv_of_equiv observations equivalent
  | symm _ ih => exact A.relEquiv_symm observations ih
  | trans _ _ ih ih' => exact A.relEquiv_trans observations ih ih'
  | plug admissible _ ih => exact A.relEquiv_closedUnder observations admissible ih

end Generated

/-! ## βη: the generated congruence is the bubble's equality -/

section BetaEta

open Mettapedia.GSLT.GraphTheory
open Mettapedia.GSLT.GraphTheory.BetaEta
open Mettapedia.GSLT.ObserverBubble

/-- βη-conversion lies in the congruence generated by the β- and η-steps. -/
theorem generated_of_betaEtaConv (A : AdmissibleClass betaEtaApplicativeRules)
    {left right : LambdaTerm} (convertible : BetaEtaConv left right) :
    Generated A BetaEtaStep left right := by
  induction convertible with
  | rel _ _ step => exact Generated.rel step
  | refl term => exact Generated.equiv (betaEtaConv_equivalence.refl term)
  | symm _ _ _ ih => exact Generated.symm ih
  | trans _ _ _ _ _ ih ih' => exact Generated.trans ih ih'

/-- **Completeness for the βη bubble**: the congruence generated by the β- and
η-steps is exactly the equality of every applicative observer class reading
the βη-class. -/
theorem betaEta_generated_iff (A : AdmissibleClass betaEtaApplicativeRules)
    (left right : LambdaTerm) :
    Generated A BetaEtaStep left right ↔
      A.RelEquiv (classObservations betaEtaGSLT) left right := by
  constructor
  · exact generated_le_relEquiv A (classObservations betaEtaGSLT)
      fun step => (relEquiv_betaEta_iff A _ _).mpr (Relation.EqvGen.rel _ _ step)
  · exact fun related => generated_of_betaEtaConv A ((relEquiv_betaEta_iff A left right).mp related)

end BetaEta

/-! ## The sealed bubble: observational is strictly coarser -/

section Sealed

open Mettapedia.Languages.ProcessCalculi.RhoCalculus.QuotedChannel

/-- With no stipulations, the generated congruence of the quoted-channel
calculus is syntactic identity. -/
theorem generated_empty_eq {A : AdmissibleClass quotedRules} {left right : Proc}
    (generated : Generated A (fun _ _ => False) left right) : left = right :=
  generated_le (E := fun left right : Proc => left = right) ⟨fun _ => rfl, Eq.symm, Eq.trans⟩
    (fun impossible => impossible.elim) (fun equal => equal)
    (fun {context _ _} _ equal => congrArg (Ctx.fill context) equal) generated

/-- **Strict for the sealed bubble**: no stipulation relates `nil ∣ nil` and
`nil`, yet the guarded observers identify them. -/
theorem sealed_generated_strict :
    guarded.RelEquiv barbs (.par .nil .nil) .nil ∧
      ¬ Generated guarded (fun _ _ => False) (.par .nil .nil) .nil :=
  ⟨relEquiv_guarded_parNil_nil, fun generated => Proc.noConfusion (generated_empty_eq generated)⟩

end Sealed

/-! ## A grade is a readout, never permission to substitute -/

section Readout

open Mettapedia.Languages.ProcessCalculi.RhoCalculus.QuotedChannel
open Mettapedia.Cybernetics.DistinctionCalculus

/-- Truncation at depth `n`: subterms at depth `n` become `nil`. -/
def cut : ℕ → Proc → Proc
  | 0, _ => .nil
  | _ + 1, .nil => .nil
  | n + 1, .par left right => .par (cut n left) (cut n right)
  | n + 1, .out channel payload => .out (cut n channel) (cut n payload)
  | n + 1, .inp channel body => .inp (cut n channel) (cut n body)
  | n + 1, .echo channel => .echo (cut n channel)

/-- The height of a process. -/
def height : Proc → ℕ
  | .nil => 0
  | .par left right => max (height left) (height right) + 1
  | .out channel payload => max (height channel) (height payload) + 1
  | .inp channel body => max (height channel) (height body) + 1
  | .echo channel => height channel + 1

theorem cut_nil (n : ℕ) : cut n .nil = .nil := by
  cases n <;> rfl

/-- Truncating twice truncates at the smaller depth. -/
theorem cut_cut : ∀ (m n : ℕ) (term : Proc), m ≤ n → cut m (cut n term) = cut m term
  | 0, _, _, _ => rfl
  | m + 1, n + 1, .nil, _ => rfl
  | m + 1, n + 1, .par left right, le => by
      simp only [cut, cut_cut m n _ (Nat.le_of_succ_le_succ le)]
  | m + 1, n + 1, .out channel payload, le => by
      simp only [cut, cut_cut m n _ (Nat.le_of_succ_le_succ le)]
  | m + 1, n + 1, .inp channel body, le => by
      simp only [cut, cut_cut m n _ (Nat.le_of_succ_le_succ le)]
  | m + 1, n + 1, .echo channel, le => by
      simp only [cut, cut_cut m n _ (Nat.le_of_succ_le_succ le)]
  | _ + 1, 0, _, le => absurd le (Nat.not_succ_le_zero _)

/-- Truncating at or above the height changes nothing. -/
theorem cut_of_height_le : ∀ (n : ℕ) (term : Proc), height term ≤ n → cut n term = term
  | _, .nil, _ => cut_nil _
  | 0, .par _ _, le => absurd le (by simp [height])
  | n + 1, .par left right, le => by
      simp only [height, Nat.add_le_add_iff_right, max_le_iff] at le
      simp only [cut, cut_of_height_le n left le.1, cut_of_height_le n right le.2]
  | 0, .out _ _, le => absurd le (by simp [height])
  | n + 1, .out channel payload, le => by
      simp only [height, Nat.add_le_add_iff_right, max_le_iff] at le
      simp only [cut, cut_of_height_le n channel le.1, cut_of_height_le n payload le.2]
  | 0, .inp _ _, le => absurd le (by simp [height])
  | n + 1, .inp channel body, le => by
      simp only [height, Nat.add_le_add_iff_right, max_le_iff] at le
      simp only [cut, cut_of_height_le n channel le.1, cut_of_height_le n body le.2]
  | 0, .echo _, le => absurd le (by simp [height])
  | n + 1, .echo channel, le => by
      simp only [height, Nat.add_le_add_iff_right] at le
      simp only [cut, cut_of_height_le n channel le]

/-- Distinct processes differ at some depth. -/
theorem exists_cut_ne {left right : Proc} (distinct : left ≠ right) :
    ∃ n, cut n left ≠ cut n right :=
  ⟨max (height left) (height right), by
    rw [cut_of_height_le _ left (le_max_left _ _), cut_of_height_le _ right (le_max_right _ _)]
    exact distinct⟩

/-- Agreement at a depth persists at every smaller depth. -/
theorem cut_eq_of_le {m n : ℕ} {left right : Proc} (le : m ≤ n) (same : cut n left = cut n right) :
    cut m left = cut m right := by
  rw [← cut_cut m n left le, same, cut_cut m n right le]

/-- The depth-truncation distance: `2^{-k}` with `k` the first depth at which
the processes differ, and `0` for equal processes. -/
def depthDistance (left right : Proc) : ℚ :=
  if distinct : left = right then 0 else (1 / 2) ^ Nat.find (exists_cut_ne distinct)

theorem depthDistance_self (term : Proc) : depthDistance term term = 0 := by
  simp [depthDistance]

theorem depthDistance_of_ne {left right : Proc} (distinct : left ≠ right) :
    depthDistance left right = (1 / 2) ^ Nat.find (exists_cut_ne distinct) := by
  simp [depthDistance, distinct]

theorem depthDistance_nonneg (left right : Proc) : 0 ≤ depthDistance left right := by
  unfold depthDistance
  split_ifs
  · exact le_rfl
  · positivity

theorem depthDistance_le_one (left right : Proc) : depthDistance left right ≤ 1 := by
  unfold depthDistance
  split_ifs
  · norm_num
  · exact pow_le_one₀ (by norm_num) (by norm_num)

theorem find_symm {left right : Proc} (distinct : left ≠ right) :
    Nat.find (exists_cut_ne distinct) = Nat.find (exists_cut_ne (Ne.symm distinct)) :=
  le_antisymm (Nat.find_min' _ (Ne.symm (Nat.find_spec (exists_cut_ne (Ne.symm distinct)))))
    (Nat.find_min' _ (Ne.symm (Nat.find_spec (exists_cut_ne distinct))))

theorem depthDistance_symm (left right : Proc) :
    depthDistance left right = depthDistance right left := by
  by_cases equal : left = right
  · subst equal
    rfl
  · rw [depthDistance_of_ne equal, depthDistance_of_ne (Ne.symm equal), find_symm equal]

/-- **The ultrametric inequality**: two processes agreeing with a third up to
some depth agree with each other up to the smaller depth. -/
theorem depthDistance_ultrametric (first second third : Proc) :
    depthDistance first third ≤ max (depthDistance first second) (depthDistance second third) := by
  by_cases outer : first = third
  · subst outer
    rw [depthDistance_self]
    exact le_max_of_le_left (depthDistance_nonneg _ _)
  by_cases left : first = second
  · subst left
    exact le_max_right _ _
  by_cases right : second = third
  · subst right
    exact le_max_left _ _
  rw [depthDistance_of_ne outer, depthDistance_of_ne left, depthDistance_of_ne right]
  have deeper : min (Nat.find (exists_cut_ne left)) (Nat.find (exists_cut_ne right)) ≤
      Nat.find (exists_cut_ne outer) := by
    rw [Nat.le_find_iff]
    intro n lt
    rw [Decidable.not_not]
    have agreeFirst : cut n first = cut n second :=
      Decidable.not_not.mp
        (Nat.find_min (exists_cut_ne left) (lt_of_lt_of_le lt (min_le_left _ _)))
    have agreeSecond : cut n second = cut n third :=
      Decidable.not_not.mp
        (Nat.find_min (exists_cut_ne right) (lt_of_lt_of_le lt (min_le_right _ _)))
    exact agreeFirst.trans agreeSecond
  have monotone : (1 / 2 : ℚ) ^ Nat.find (exists_cut_ne outer) ≤
      (1 / 2 : ℚ) ^ min (Nat.find (exists_cut_ne left)) (Nat.find (exists_cut_ne right)) :=
    pow_le_pow_of_le_one (by norm_num) (by norm_num) deeper
  refine monotone.trans ?_
  rcases le_total (Nat.find (exists_cut_ne left)) (Nat.find (exists_cut_ne right)) with le | le
  · rw [min_eq_left le]
    exact le_max_left _ _
  · rw [min_eq_right le]
    exact le_max_right _ _

/-- **The depth-truncation observer**, a metric tolerance on processes. -/
def depthTolerance : Tolerance Proc where
  similarity left right := 1 - depthDistance left right
  nonnegative left right := sub_nonneg.mpr (depthDistance_le_one left right)
  bounded left right := by linarith [depthDistance_nonneg left right]
  reflexive term := by rw [depthDistance_self, sub_zero]
  symmetric left right := by rw [depthDistance_symm]

theorem depthTolerance_distance (left right : Proc) :
    depthTolerance.distance left right = depthDistance left right := by
  simp [Tolerance.distance, depthTolerance]

theorem depthTolerance_metric : depthTolerance.Metric := by
  intro first second third
  rw [depthTolerance_distance, depthTolerance_distance, depthTolerance_distance]
  exact (depthDistance_ultrametric first second third).trans
    (max_le_add_of_nonneg (depthDistance_nonneg _ _) (depthDistance_nonneg _ _))

/-- **Its zero kernel is the open bubble's equality.** -/
theorem depthTolerance_indistinguishable_iff (left right : Proc) :
    depthTolerance.Indistinguishable left right ↔ quoteFree.RelEquiv barbs left right := by
  rw [relEquiv_quoteFree_iff_eq]
  unfold Tolerance.Indistinguishable
  rw [depthTolerance_distance]
  constructor
  · intro zero
    by_contra distinct
    rw [depthDistance_of_ne distinct] at zero
    exact absurd zero (by positivity)
  · rintro rfl
    exact depthDistance_self _

/-- Nest a payload `n` levels deep in outputs on `nil`. -/
def deep : ℕ → Proc → Proc
  | 0, payload => payload
  | n + 1, payload => .out .nil (deep n payload)

theorem cut_deep (k : ℕ) : ∀ (n : ℕ) (payload : Proc), cut (k + n) (deep n payload) =
    deep n (cut k payload)
  | 0, _ => rfl
  | n + 1, payload => by
      rw [show k + (n + 1) = (k + n) + 1 from rfl]
      simp only [deep, cut, cut_nil, cut_deep k n payload]

theorem deep_injective (n : ℕ) {payload payload' : Proc} (same : deep n payload = deep n payload') :
    payload = payload' := by
  induction n with
  | zero => exact same
  | succ n ih =>
      simp only [deep, Proc.out.injEq, true_and] at same
      exact ih same

/-- Two processes nested `n` deep: payload `nil` against `nil ∣ nil`. -/
def nearPair (n : ℕ) : Proc × Proc :=
  (deep n .nil, deep n (.par .nil .nil))

theorem nearPair_distinct (n : ℕ) : (nearPair n).1 ≠ (nearPair n).2 :=
  fun same => Proc.noConfusion (deep_injective n same)

theorem nearPair_find (n : ℕ) : Nat.find (exists_cut_ne (nearPair_distinct n)) = n + 1 := by
  apply le_antisymm
  · apply Nat.find_min'
    have first := cut_deep 1 n .nil
    have second := cut_deep 1 n (.par .nil .nil)
    rw [show 1 + n = n + 1 by omega] at first second
    simp only [nearPair, first, second]
    intro same
    exact Proc.noConfusion (deep_injective n same)
  · rw [Nat.le_find_iff]
    intro m lt
    rw [Decidable.not_not]
    have le : m ≤ n := Nat.lt_succ_iff.mp lt
    apply cut_eq_of_le le
    have first := cut_deep 0 n .nil
    have second := cut_deep 0 n (.par .nil .nil)
    rw [Nat.zero_add] at first second
    simp only [nearPair, first, second, cut]

/-- The pair nested `n` deep is `2^{-(n+1)}` apart. -/
theorem nearPair_distance (n : ℕ) :
    depthDistance (nearPair n).1 (nearPair n).2 = (1 / 2) ^ (n + 1) := by
  rw [depthDistance_of_ne (nearPair_distinct n), nearPair_find]

/-- Every output on `nil` exposes exactly its own channel as an output barb. -/
theorem barbed_out_output_iff {channel payload target : Proc} :
    Barbed (.out channel payload) (.output target) ↔ channel = target := by
  constructor
  · intro barbed
    cases barbed
    rfl
  · rintro rfl
    exact Barbed.output channel payload

/-- **A grade is a readout, never permission to substitute.** For every
`ε > 0` there are two processes whose depth-truncation distance is positive
and below `ε`, which the open bubble does not identify, and for which an
admissible context turns the substitution of one for the other into a change
of an observed barb. -/
theorem grade_never_licenses_substitution {ε : ℚ} (positive : 0 < ε) :
    ∃ left right : Proc,
      0 < depthTolerance.distance left right ∧ depthTolerance.distance left right < ε ∧
      ¬ quoteFree.RelEquiv barbs left right ∧
      ∃ context : Ctx, quoteFree.Admissible context ∧
        (∃ target, Step (context.fill left) target ∧ Barbed target (.output left)) ∧
        ∀ target, Step (context.fill right) target → ¬ Barbed target (.output left) := by
  obtain ⟨n, small⟩ := exists_pow_lt_of_lt_one positive (by norm_num : (1 / 2 : ℚ) < 1)
  refine ⟨(nearPair n).1, (nearPair n).2, ?_, ?_, ?_, echoPayload, echoPayload_quoteFree, ?_, ?_⟩
  · rw [depthTolerance_distance, nearPair_distance]
    positivity
  · rw [depthTolerance_distance, nearPair_distance]
    calc (1 / 2 : ℚ) ^ (n + 1) ≤ (1 / 2) ^ n := pow_le_pow_of_le_one (by norm_num) (by norm_num)
          (Nat.le_succ n)
      _ < ε := small
  · rw [relEquiv_quoteFree_iff_eq]
    exact nearPair_distinct n
  · exact ⟨.out (nearPair n).1 .nil, Step.echo .nil (nearPair n).1,
      Barbed.output (nearPair n).1 .nil⟩
  · intro target step barbed
    have echoed : target = .out (nearPair n).2 .nil := step_out_echo step
    subst echoed
    exact nearPair_distinct n (barbed_out_output_iff.mp barbed).symm

end Readout

end Mettapedia.GSLT.GradedObserverBridge
