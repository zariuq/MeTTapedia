import Mettapedia.GSLT.Logic.ObserverPresheaf
import Mettapedia.GSLT.Logic.SaturatedRelativeBisimilarityControls

/-!
# Controls for the observer presheaf

* **An oracle tower** (`OracleTower`).  Terms carry levels, and the probe of
  level `k` opens exactly the live leaf of level `k`.  Stage `n` admits the probes
  of levels below `n`.  The stages form a strictly increasing chain, the observer
  presheaf restricts to a presheaf on `ℕ` (`oracleTower`), and every restriction
  from stage `n + 1` to stage `n` forgets something: the live and the dead leaf of
  level `n` are equivalent at stage `n` and separated at stage `n + 1`
  (`oracleTower_strict`).

* **A non-functorial assignment** (`Determination`).  Determination, the class of
  all contexts preserving a class's equivalence, is neither monotone nor antitone
  on the four-point system of the mixed-variance control, so it is not a functor
  on the observer lattice in either variance (`no_functor_determined`,
  `no_opFunctor_determined`).  The stages themselves do not see this: the stage of
  the determined class is the stage of the class (`determinedStageEquiv`).

* **Three squares of inert observers** (`Incompatible`, `Emergent`,
  `Independent`).  Contexts are functions on a finite set and the one observation
  asks whether a point is `yes`.
  - Two observers that each isolate a different point do not amalgamate, so
    Beck–Chevalley fails along forgetting (`beckChevalley_fails`).
  - Two observers that each see nothing on a pair separate it when composed, so the
    join is not separated (`not_separated_join`): combining observers creates a
    distinction neither has.
  - Two observers reading independent coordinates amalgamate and their join is
    separated (`amalgamates`, `separated_join`), so both gluing conditions hold.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.AdmissibleContextCongruence.ObserverPresheafControls

open CategoryTheory Opposite
open Mettapedia.GSLT
open Mettapedia.GSLT.HennessyMilner
open Mettapedia.GSLT.MinimalEnablingContext
open Mettapedia.GSLT.AdmissibleContextCongruence
open Mettapedia.GSLT.AdmissibleContextCongruence.AdmissibleClass

/-! ## An oracle tower -/

namespace OracleTower

/-- Leaves of each level, live or dead; the opened residue; and probes. -/
inductive Tm where
  | leaf (level : ℕ) (live : Bool)
  | opened
  | probe (level : ℕ) (body : Tm)
  deriving DecidableEq

/-- The probe of level `k` opens the live leaf of level `k`, and nothing else
steps. -/
inductive Opens : Tm → Tm → Prop where
  | fire (level : ℕ) : Opens (.probe level (.leaf level true)) .opened

abbrev towerGSLT : GSLT where
  Term := Tm
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites := Opens
  rewrites_resp_left := by
    intro source source' target equal step
    subst equal
    exact ⟨target, step, rfl⟩
  rewrites_resp_right := by
    intro source target target' step equal
    subst equal
    exact step

/-- Wrap a term in a list of probes, outermost first. -/
def plugProbes (levels : List ℕ) (term : Tm) : Tm :=
  levels.foldr Tm.probe term

theorem plugProbes_append (outer inner : List ℕ) (term : Tm) :
    plugProbes (outer ++ inner) term = plugProbes outer (plugProbes inner term) :=
  List.foldr_append

/-- Contexts are lists of probes. -/
abbrev towerRules : ContextualRules towerGSLT where
  Context := List ℕ
  identity := []
  compose outer inner := outer ++ inner
  plug := plugProbes
  plug_identity _ := rfl
  plug_compose := plugProbes_append
  plug_resp context := by
    intro left right equal
    subst equal
    rfl
  Rule := Unit
  fires _ := Opens
  fires_resp_left := by
    intro _ left right target equal fires
    subst equal
    exact ⟨target, fires, rfl⟩
  fires_resp_right := by
    intro _ source target target' fires equal
    subst equal
    exact fires
  fires_step := fun fires => fires

/-- No base observations: every distinction is made by a probe. -/
abbrev silent : ContextualRules.Observations towerGSLT where
  Atom := Empty
  observes atom _ := atom.elim
  observes_resp atom := atom.elim

/-- The contexts all of whose probes have level below `n`. -/
def below (n : ℕ) : AdmissibleClass towerRules where
  Admissible levels := ∀ level ∈ levels, level < n
  identity_mem := fun _ member => (List.not_mem_nil member).elim
  compose_mem := by
    intro outer inner outerBelow innerBelow level member
    rcases List.mem_append.mp member with inOuter | inInner
    · exact outerBelow level inOuter
    · exact innerBelow level inInner

/-- **Stage `n` of the tower**: the class generated by the probes of level below
`n`. -/
def stage (n : ℕ) : AdmissibleClass towerRules :=
  AdmissibleClass.generatedBy {levels | ∃ level < n, levels = [level]}

theorem stage_le_below (n : ℕ) : stage n ≤ below n := by
  apply AdmissibleClass.generatedBy_le_iff.mpr
  rintro _ ⟨level, lt, rfl⟩ k member
  rw [List.mem_singleton] at member
  exact member ▸ lt

theorem probe_admissible {n level : ℕ} (lt : level < n) : (stage n).Admissible [level] :=
  AdmissibleClass.generator_mem ⟨level, lt, rfl⟩

theorem stage_monotone : Monotone stage := by
  intro m n le
  apply AdmissibleClass.generatedBy_le_iff.mpr
  rintro _ ⟨level, lt, rfl⟩
  exact probe_admissible (lt_of_lt_of_le lt le)

/-- A filled leaf steps only under the single probe of its own level, and only
when it is live. -/
theorem step_plug_leaf {levels : List ℕ} {level : ℕ} {live : Bool} {target : Tm}
    (step : Opens (plugProbes levels (.leaf level live)) target) :
    levels = [level] ∧ live = true := by
  match levels, step with
  | [k], step =>
    cases step
    exact ⟨rfl, rfl⟩
  | _ :: _ :: _, step => cases step

/-- **At stage `n`, the live and the dead leaf of any level `m ≥ n` are
equivalent.** -/
theorem stage_relEquiv_leaves {n m : ℕ} (le : n ≤ m) :
    (stage n).RelEquiv silent (.leaf m true) (.leaf m false) := by
  refine ⟨fun left right => (∃ live, left = .leaf m live) ∧ ∃ live, right = .leaf m live,
    ⟨?_, ?_, ?_⟩, ⟨true, rfl⟩, ⟨false, rfl⟩⟩
  · rintro _ _ ⟨⟨live, rfl⟩, _⟩ label target step
    have fires := step_plug_leaf (show Opens (plugProbes label.1 (.leaf m live)) target from step)
    have lt := stage_le_below n label.1 label.2 m (by rw [fires.1]; exact List.mem_singleton_self m)
    exact absurd le (Nat.not_le.mpr lt)
  · rintro _ _ ⟨_, ⟨live, rfl⟩⟩ label target step
    have fires := step_plug_leaf (show Opens (plugProbes label.1 (.leaf m live)) target from step)
    have lt := stage_le_below n label.1 label.2 m (by rw [fires.1]; exact List.mem_singleton_self m)
    exact absurd le (Nat.not_le.mpr lt)
  · intro _ _ _ atom
    exact atom.1.elim

/-- **At stage `n + 1`, the probe of level `n` separates the live and the dead
leaf of level `n`.** -/
theorem not_stage_succ_relEquiv_leaves (n : ℕ) :
    ¬ (stage (n + 1)).RelEquiv silent (.leaf n true) (.leaf n false) := by
  intro related
  obtain ⟨_, step, _⟩ := AdmissibleContextCongruence.bisimilar_forward related
    ⟨[n], probe_admissible (Nat.lt_succ_self n)⟩ (Opens.fire n)
  have fires := step_plug_leaf (show Opens (plugProbes [n] (.leaf n false)) _ from step)
  exact Bool.false_ne_true fires.2

/-- The stages increase strictly. -/
theorem stage_lt_succ (n : ℕ) : stage n < stage (n + 1) := by
  refine lt_of_le_of_ne (stage_monotone (Nat.le_succ n)) fun equal => ?_
  apply not_stage_succ_relEquiv_leaves n
  rw [← equal]
  exact stage_relEquiv_leaves le_rfl

/-- **The oracle tower**: the observer presheaf restricted to the chain of
stages. -/
def oracleTower : ℕᵒᵖ ⥤ Type :=
  restrictedPresheaf silent stage_monotone

/-- **Every restriction of the tower forgets something**: the map from stage
`n + 1` to stage `n` is not injective. -/
theorem oracleTower_strict (n : ℕ) :
    ¬ Function.Injective (oracleTower.map (homOfLE (Nat.le_succ n)).op) := by
  intro injective
  have reflects := (restrict_injective_iff silent (stage_monotone (Nat.le_succ n))).mp injective
  exact not_stage_succ_relEquiv_leaves n (reflects _ _ (stage_relEquiv_leaves le_rfl))

/-- Positive control: an identity step of the tower forgets nothing. -/
theorem oracleTower_refl_injective (n : ℕ) :
    Function.Injective (oracleTower.map (𝟙 (op n))) := by
  intro first second equal
  rw [oracleTower.map_id] at equal
  exact equal

end OracleTower

/-! ## Determination is not functorial; the stages are -/

namespace Determination

open Mettapedia.GSLT.AdmissibleContextCongruence.SaturatedControls.MixedVariance

/-- Determination is not antitone either: `release` preserves the finer
equivalence and not the coarser one. -/
theorem determined_not_antitone :
    bottom ≤ splitting ∧ ¬ splitting.determined inCD ≤ bottom.determined inCD := by
  refine ⟨bottom_le_splitting, fun le => ?_⟩
  exact release_not_preserves_bottom (le release release_preserves_splitting)

/-- **Determination is neither monotone nor antitone.** -/
theorem determined_neither :
    ¬ Monotone (fun D : AdmissibleClass pointRules => D.determined inCD) ∧
      ¬ Antitone (fun D : AdmissibleClass pointRules => D.determined inCD) :=
  ⟨fun monotone => determined_not_monotone.2 (monotone bottom_le_splitting),
    fun antitone => determined_not_antitone.2 (antitone bottom_le_splitting)⟩

/-- **No functor on the observer lattice acts on objects by determination.** -/
theorem no_functor_determined :
    ¬ ∃ F : AdmissibleClass pointRules ⥤ AdmissibleClass pointRules,
      ∀ D, F.obj D = D.determined inCD := by
  rintro ⟨F, objects⟩
  have le := leOfHom (F.map (homOfLE bottom_le_splitting))
  rw [objects, objects] at le
  exact determined_not_monotone.2 le

/-- **Nor does a contravariant one.** -/
theorem no_opFunctor_determined :
    ¬ ∃ F : (AdmissibleClass pointRules)ᵒᵖ ⥤ AdmissibleClass pointRules,
      ∀ D, F.obj (op D) = D.determined inCD := by
  rintro ⟨F, objects⟩
  have le := leOfHom (F.map (homOfLE bottom_le_splitting).op)
  rw [objects, objects] at le
  exact determined_not_antitone.2 le

end Determination

section DeterminedStage

variable {S : GSLT} {rules : ContextualRules S} (observations : ContextualRules.Observations S)

/-- **The stage of the determined class is the stage of the class.**  The
presheaf sees an observer class only through its equivalence, which
determination does not change, although determination itself is not
functorial. -/
def determinedStageEquiv (D : AdmissibleClass rules) :
    Stage observations (D.determined observations) ≃ Stage observations D :=
  Quotient.congr (Equiv.refl S.Term) fun left right =>
    D.relEquiv_determined_iff observations (left := left) (right := right)

theorem determinedStageEquiv_stageClass (D : AdmissibleClass rules) (term : S.Term) :
    determinedStageEquiv observations D (stageClass observations (D.determined observations) term) =
      stageClass observations D term :=
  rfl

end DeterminedStage

/-! ## Inert observers: contexts are functions, one observation -/

namespace InertFunctions

variable (α : Type)

/-- A set of points with no steps. -/
abbrev inertGSLT : GSLT where
  Term := α
  equations := ⟨Eq, ⟨Eq.refl, Eq.symm, Eq.trans⟩⟩
  rewrites _ _ := False
  rewrites_resp_left := fun _ impossible => impossible.elim
  rewrites_resp_right := fun impossible _ => impossible.elim

/-- Every function on the points is a context. -/
abbrev functionRules : ContextualRules (inertGSLT α) where
  Context := α → α
  identity := id
  compose outer inner := outer ∘ inner
  plug context term := context term
  plug_identity _ := rfl
  plug_compose _ _ _ := rfl
  plug_resp context := by
    intro left right equal
    subst equal
    rfl
  Rule := Empty
  fires _ _ _ := False
  fires_resp_left := fun _ impossible => impossible.elim
  fires_resp_right := fun impossible _ => impossible.elim
  fires_step := fun impossible => impossible.elim

/-- The one observation: the point is `target`. -/
abbrev hits (target : α) : ContextualRules.Observations (inertGSLT α) where
  Atom := Unit
  observes _ point := point = target
  observes_resp := by
    intro _ left right equal
    subst equal
    exact Iff.rfl

/-- The class of the contexts in a set of functions that contains the identity
and is closed under composition. -/
def closedClass (K : (α → α) → Prop) (identity : K id)
    (closed : ∀ outer inner, K outer → K inner → K (outer ∘ inner)) :
    AdmissibleClass (functionRules α) where
  Admissible := K
  identity_mem := identity
  compose_mem := fun {outer inner} outerMember innerMember =>
    closed outer inner outerMember innerMember

variable {α}

/-- **In an inert system the relative equivalence is agreement of the observation
under every admissible context.** -/
theorem relEquiv_iff (D : AdmissibleClass (functionRules α)) (target : α) (left right : α) :
    D.RelEquiv (hits α target) left right ↔
      ∀ context, D.Admissible context → (context left = target ↔ context right = target) := by
  constructor
  · intro related context admissible
    exact AdmissibleContextCongruence.bisimilar_observes related ((), ⟨context, admissible⟩)
  · intro agree
    refine ⟨fun first second => ∀ context, D.Admissible context →
      (context first = target ↔ context second = target), ⟨?_, ?_, ?_⟩, agree⟩
    · intro _ _ _ _ _ impossible
      exact impossible.elim
    · intro _ _ _ _ _ impossible
      exact impossible.elim
    · intro _ _ held atom
      exact held atom.2.1 atom.2.2

end InertFunctions

open InertFunctions

/-! ### Incompatible observers: amalgamation fails -/

namespace Incompatible

/-- Three silent points and the observed point. -/
inductive Pt where
  | p1
  | p2
  | p3
  | yes
  deriving DecidableEq

/-- Isolates `p3`. -/
def f : Pt → Pt
  | .p3 => .yes
  | .yes => .yes
  | _ => .p1

/-- Isolates `p1`. -/
def g : Pt → Pt
  | .p1 => .yes
  | .yes => .yes
  | _ => .p2

theorem f_idem : f ∘ f = f := by
  funext x
  cases x <;> rfl

theorem g_idem : g ∘ g = g := by
  funext x
  cases x <;> rfl

/-- The identity alone. -/
def A : AdmissibleClass (functionRules Pt) :=
  closedClass Pt (fun c => c = id) rfl (by rintro _ _ rfl rfl; rfl)

/-- The identity and `f`. -/
def B : AdmissibleClass (functionRules Pt) :=
  closedClass Pt (fun c => c = id ∨ c = f) (Or.inl rfl) (by
    rintro _ _ (rfl | rfl) (rfl | rfl)
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact Or.inr rfl
    · exact Or.inr f_idem)

/-- The identity and `g`. -/
def C : AdmissibleClass (functionRules Pt) :=
  closedClass Pt (fun c => c = id ∨ c = g) (Or.inl rfl) (by
    rintro _ _ (rfl | rfl) (rfl | rfl)
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact Or.inr rfl
    · exact Or.inr g_idem)

theorem A_le_B : A ≤ B := fun _ member => Or.inl member

theorem A_le_C : A ≤ C := fun _ member => Or.inl member

theorem A_relEquiv_iff (x y : Pt) : A.RelEquiv (hits Pt .yes) x y ↔ (x = .yes ↔ y = .yes) := by
  rw [relEquiv_iff]
  exact ⟨fun agree => agree id rfl, fun agree _ admissible => by
    change _ = id at admissible
    subst admissible
    exact agree⟩

theorem B_relEquiv_iff (x y : Pt) :
    B.RelEquiv (hits Pt .yes) x y ↔ (x = .yes ↔ y = .yes) ∧ (f x = .yes ↔ f y = .yes) := by
  rw [relEquiv_iff]
  refine ⟨fun agree => ⟨agree id (Or.inl rfl), agree f (Or.inr rfl)⟩, ?_⟩
  rintro ⟨atId, atF⟩ _ (rfl | rfl)
  · exact atId
  · exact atF

theorem C_relEquiv_iff (x y : Pt) :
    C.RelEquiv (hits Pt .yes) x y ↔ (x = .yes ↔ y = .yes) ∧ (g x = .yes ↔ g y = .yes) := by
  rw [relEquiv_iff]
  refine ⟨fun agree => ⟨agree id (Or.inl rfl), agree g (Or.inr rfl)⟩, ?_⟩
  rintro ⟨atId, atG⟩ _ (rfl | rfl)
  · exact atId
  · exact atG

/-- **The two observers do not amalgamate**: `p3` and `p1` are equivalent for
the identity alone, but only `p3` is `B`-equivalent to `p3` and only `p1` is
`C`-equivalent to `p1`. -/
theorem not_amalgamates : ¬ Amalgamates (hits Pt .yes) A B C := by
  intro amalgamates
  obtain ⟨glued, gluedB, gluedC⟩ :=
    amalgamates ((A_relEquiv_iff .p3 .p1).mpr (by decide))
  rw [B_relEquiv_iff] at gluedB
  rw [C_relEquiv_iff] at gluedC
  revert gluedB gluedC
  cases glued <;> decide

/-- **Beck–Chevalley fails along forgetting** for the square `A ≤ B, C ≤ B ⊔ C`,
in both forms. -/
theorem beckChevalley_fails :
    ¬ (∀ φ : Set (Stage (hits Pt .yes) B),
        reindex (hits Pt .yes) A_le_C (existsAlong (hits Pt .yes) A_le_B φ) =
          existsAlong (hits Pt .yes) (le_sup_right : C ≤ B ⊔ C)
            (reindex (hits Pt .yes) (le_sup_left : B ≤ B ⊔ C) φ)) ∧
    ¬ (∀ φ : Set (Stage (hits Pt .yes) B),
        reindex (hits Pt .yes) A_le_C (forallAlong (hits Pt .yes) A_le_B φ) =
          forallAlong (hits Pt .yes) (le_sup_right : C ≤ B ⊔ C)
            (reindex (hits Pt .yes) (le_sup_left : B ≤ B ⊔ C) φ)) :=
  ⟨fun square => not_amalgamates
      ((beckChevalley_exists_iff_amalgamates A_le_B A_le_C le_sup_left le_sup_right).mp square),
    fun square => not_amalgamates
      ((beckChevalley_forall_iff_amalgamates A_le_B A_le_C le_sup_left le_sup_right).mp square)⟩

end Incompatible

/-! ### Emergent distinction: the join is not separated -/

namespace Emergent

/-- Two silent points `s`, `t`, two intermediate points `m`, `n`, and the
answers `yes`, `no`. -/
inductive Pt where
  | s
  | t
  | m
  | n
  | yes
  | no
  deriving DecidableEq

/-- Moves `s` to `m` and `t` to `n`; fixes the rest. -/
def g : Pt → Pt
  | .s => .m
  | .t => .n
  | x => x

/-- Answers `yes` on `m` and `yes`, `no` elsewhere. -/
def f : Pt → Pt
  | .m => .yes
  | .yes => .yes
  | _ => .no

theorem f_idem : f ∘ f = f := by
  funext x
  cases x <;> rfl

theorem g_idem : g ∘ g = g := by
  funext x
  cases x <;> rfl

def B : AdmissibleClass (functionRules Pt) :=
  closedClass Pt (fun c => c = id ∨ c = f) (Or.inl rfl) (by
    rintro _ _ (rfl | rfl) (rfl | rfl)
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact Or.inr rfl
    · exact Or.inr f_idem)

def C : AdmissibleClass (functionRules Pt) :=
  closedClass Pt (fun c => c = id ∨ c = g) (Or.inl rfl) (by
    rintro _ _ (rfl | rfl) (rfl | rfl)
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact Or.inr rfl
    · exact Or.inr g_idem)

/-- `f` alone does not separate `s` from `t`. -/
theorem B_relEquiv : B.RelEquiv (hits Pt .yes) .s .t := by
  rw [relEquiv_iff]
  rintro _ (rfl | rfl) <;> decide

/-- `g` alone does not separate `s` from `t`. -/
theorem C_relEquiv : C.RelEquiv (hits Pt .yes) .s .t := by
  rw [relEquiv_iff]
  rintro _ (rfl | rfl) <;> decide

/-- **Composed, they do**: `f ∘ g` sends `s` to `yes` and `t` to `no`. -/
theorem not_join_relEquiv : ¬ (B ⊔ C).RelEquiv (hits Pt .yes) .s .t := by
  intro related
  have admissible : (B ⊔ C).Admissible (f ∘ g) :=
    (B ⊔ C).compose_mem ((le_sup_left : B ≤ B ⊔ C) f (Or.inr rfl))
      ((le_sup_right : C ≤ B ⊔ C) g (Or.inr rfl))
  have agree := (relEquiv_iff (B ⊔ C) .yes .s .t).mp related (f ∘ g) admissible
  exact absurd (agree.mp rfl) (by decide)

/-- **The join of the two observers is not separated**: combining them creates
a distinction that neither makes. -/
theorem not_separated_join : ¬ Separated (hits Pt .yes) B C (B ⊔ C) :=
  fun separated => not_join_relEquiv (separated B_relEquiv C_relEquiv)

/-- Equivalently, the comparison map into the pullback is not injective. -/
theorem pairing_not_injective :
    ¬ Function.Injective (fun x : Stage (hits Pt .yes) (B ⊔ C) =>
      (restrict (hits Pt .yes) (le_sup_left : B ≤ B ⊔ C) x,
        restrict (hits Pt .yes) (le_sup_right : C ≤ B ⊔ C) x)) :=
  fun injective => not_separated_join
    ((pairing_injective_iff_separated le_sup_left le_sup_right).mp injective)

end Emergent

/-! ### Independent observers: both gluing conditions hold -/

namespace Independent

/-- Points with two Boolean coordinates, and the answers `yes`, `no`. -/
inductive Pt where
  | pt (first second : Bool)
  | yes
  | no
  deriving DecidableEq

/-- Reads the first coordinate. -/
def f : Pt → Pt
  | .pt true _ => .yes
  | .pt false _ => .no
  | x => x

/-- Reads the second coordinate. -/
def g : Pt → Pt
  | .pt _ true => .yes
  | .pt _ false => .no
  | x => x

theorem f_idem : f ∘ f = f := by
  funext x
  rcases x with ⟨_ | _, _ | _⟩ | _ | _ <;> rfl

theorem g_idem : g ∘ g = g := by
  funext x
  rcases x with ⟨_ | _, _ | _⟩ | _ | _ <;> rfl

theorem f_comp_g : f ∘ g = g := by
  funext x
  rcases x with ⟨_ | _, _ | _⟩ | _ | _ <;> rfl

theorem g_comp_f : g ∘ f = f := by
  funext x
  rcases x with ⟨_ | _, _ | _⟩ | _ | _ <;> rfl

def A : AdmissibleClass (functionRules Pt) :=
  closedClass Pt (fun c => c = id) rfl (by rintro _ _ rfl rfl; rfl)

def B : AdmissibleClass (functionRules Pt) :=
  closedClass Pt (fun c => c = id ∨ c = f) (Or.inl rfl) (by
    rintro _ _ (rfl | rfl) (rfl | rfl)
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact Or.inr rfl
    · exact Or.inr f_idem)

def C : AdmissibleClass (functionRules Pt) :=
  closedClass Pt (fun c => c = id ∨ c = g) (Or.inl rfl) (by
    rintro _ _ (rfl | rfl) (rfl | rfl)
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact Or.inr rfl
    · exact Or.inr g_idem)

/-- The identity, `f` and `g`: closed under composition. -/
def D : AdmissibleClass (functionRules Pt) :=
  closedClass Pt (fun c => c = id ∨ c = f ∨ c = g) (Or.inl rfl) (by
    rintro _ _ (rfl | rfl | rfl) (rfl | rfl | rfl)
    · exact Or.inl rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr rfl)
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inl f_idem)
    · exact Or.inr (Or.inr f_comp_g)
    · exact Or.inr (Or.inr rfl)
    · exact Or.inr (Or.inl g_comp_f)
    · exact Or.inr (Or.inr g_idem))

theorem A_le_B : A ≤ B := fun _ member => Or.inl member

theorem A_le_C : A ≤ C := fun _ member => Or.inl member

/-- `D` is the join of `B` and `C`. -/
theorem D_eq_sup : D = B ⊔ C := by
  apply le_antisymm
  · rintro _ (rfl | rfl | rfl)
    · exact (B ⊔ C).identity_mem
    · exact (le_sup_left : B ≤ B ⊔ C) f (Or.inr rfl)
    · exact (le_sup_right : C ≤ B ⊔ C) g (Or.inr rfl)
  · refine sup_le ?_ ?_
    · rintro _ (rfl | rfl)
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
    · rintro _ (rfl | rfl)
      · exact Or.inl rfl
      · exact Or.inr (Or.inr rfl)

theorem A_relEquiv_iff (x y : Pt) : A.RelEquiv (hits Pt .yes) x y ↔ (x = .yes ↔ y = .yes) := by
  rw [relEquiv_iff]
  exact ⟨fun agree => agree id rfl, fun agree _ admissible => by
    change _ = id at admissible
    subst admissible
    exact agree⟩

theorem B_relEquiv_iff (x y : Pt) :
    B.RelEquiv (hits Pt .yes) x y ↔ (x = .yes ↔ y = .yes) ∧ (f x = .yes ↔ f y = .yes) := by
  rw [relEquiv_iff]
  refine ⟨fun agree => ⟨agree id (Or.inl rfl), agree f (Or.inr rfl)⟩, ?_⟩
  rintro ⟨atId, atF⟩ _ (rfl | rfl)
  · exact atId
  · exact atF

theorem C_relEquiv_iff (x y : Pt) :
    C.RelEquiv (hits Pt .yes) x y ↔ (x = .yes ↔ y = .yes) ∧ (g x = .yes ↔ g y = .yes) := by
  rw [relEquiv_iff]
  refine ⟨fun agree => ⟨agree id (Or.inl rfl), agree g (Or.inr rfl)⟩, ?_⟩
  rintro ⟨atId, atG⟩ _ (rfl | rfl)
  · exact atId
  · exact atG

theorem D_relEquiv_iff (x y : Pt) :
    D.RelEquiv (hits Pt .yes) x y ↔
      (x = .yes ↔ y = .yes) ∧ (f x = .yes ↔ f y = .yes) ∧ (g x = .yes ↔ g y = .yes) := by
  rw [relEquiv_iff]
  refine ⟨fun agree => ⟨agree id (Or.inl rfl), agree f (Or.inr (Or.inl rfl)),
    agree g (Or.inr (Or.inr rfl))⟩, ?_⟩
  rintro ⟨atId, atF, atG⟩ _ (rfl | rfl | rfl)
  · exact atId
  · exact atF
  · exact atG

/-- The glued point: the first coordinate as `f` reads the left point, the second
as `g` reads the right point. -/
def glue : Pt → Pt → Pt
  | .yes, _ => .yes
  | x, y => .pt (decide (f x = .yes)) (decide (g y = .yes))

theorem glue_spec (x y : Pt) (related : x = .yes ↔ y = .yes) :
    ((glue x y = .yes ↔ x = .yes) ∧ (f (glue x y) = .yes ↔ f x = .yes)) ∧
      ((glue x y = .yes ↔ y = .yes) ∧ (g (glue x y) = .yes ↔ g y = .yes)) := by
  revert related
  rcases x with ⟨_ | _, _ | _⟩ | _ | _ <;> rcases y with ⟨_ | _, _ | _⟩ | _ | _ <;> decide

/-- **Independent observers amalgamate.** -/
theorem amalgamates : Amalgamates (hits Pt .yes) A B C := by
  intro x y related
  obtain ⟨gluedB, gluedC⟩ := glue_spec x y ((A_relEquiv_iff x y).mp related)
  exact ⟨glue x y, (B_relEquiv_iff _ x).mpr gluedB, (C_relEquiv_iff _ y).mpr gluedC⟩

/-- **So Beck–Chevalley holds along forgetting**, in both forms, for the square
`A ≤ B, C ≤ D`. -/
theorem beckChevalley_holds :
    (∀ φ : Set (Stage (hits Pt .yes) B),
        reindex (hits Pt .yes) A_le_C (existsAlong (hits Pt .yes) A_le_B φ) =
          existsAlong (hits Pt .yes) (le_sup_right : C ≤ B ⊔ C)
            (reindex (hits Pt .yes) (le_sup_left : B ≤ B ⊔ C) φ)) ∧
    (∀ φ : Set (Stage (hits Pt .yes) B),
        reindex (hits Pt .yes) A_le_C (forallAlong (hits Pt .yes) A_le_B φ) =
          forallAlong (hits Pt .yes) (le_sup_right : C ≤ B ⊔ C)
            (reindex (hits Pt .yes) (le_sup_left : B ≤ B ⊔ C) φ)) :=
  ⟨(beckChevalley_exists_iff_amalgamates A_le_B A_le_C le_sup_left le_sup_right).mpr amalgamates,
    (beckChevalley_forall_iff_amalgamates A_le_B A_le_C le_sup_left le_sup_right).mpr amalgamates⟩

/-- **The join of independent observers is separated.** -/
theorem separated_join : Separated (hits Pt .yes) B C (B ⊔ C) := by
  rw [← D_eq_sup]
  intro x y relatedB relatedC
  rw [B_relEquiv_iff] at relatedB
  rw [C_relEquiv_iff] at relatedC
  exact (D_relEquiv_iff x y).mpr ⟨relatedB.1, relatedB.2, relatedC.2⟩

end Independent

