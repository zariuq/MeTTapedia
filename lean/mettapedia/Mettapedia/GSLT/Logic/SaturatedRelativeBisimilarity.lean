import Mettapedia.GSLT.Logic.AdmissibleContextCongruence
import Mettapedia.GSLT.Logic.ObserverRefinement
import Mathlib.Order.CompleteLattice.Defs
import Mathlib.Order.GaloisConnection.Defs

/-!
# Saturated bisimilarity relative to an admissible class of contexts

For a class `A` of admissible contexts, the *saturated* system of `A` labels a
step by any admissible context: a term `t` steps under `c` to whatever
`c[t]` reduces to, and a base observation is read through any admissible
context.  Its bisimilarity `A.RelEquiv obs` is the `A`-relative equivalence.

This module proves, with no relative-pushout, least-enabler or
observation-respect hypothesis:

* **congruence** (`relEquiv_closedUnder`): `A.RelEquiv obs` is preserved by
  every context of `A`;
* **antitonicity** (`relEquiv_antitone`): a larger class gives a finer
  equivalence, through an `ObserverRefinement` between the saturated systems,
  with the forgetting map `classMapOfLe` on behavioural classes;
* **coarsest bisimulation congruence** (`relEquiv_iff_exists`):
  `A.RelEquiv obs` is the largest relation that is both a reduction
  bisimulation with base observations and closed under `A`.

It also records the contextual variant (`ContextualEquiv`, the largest
`A`-closed relation contained in reduction bisimilarity), which contains
`A.RelEquiv obs`, and relates the least-enabler system `labelledSystem` to the
saturated one: least-enabler bisimilarity is contained in `A.RelEquiv obs`
whenever it is an `A`-congruence and every reduction is a rule firing
(`labelledBisimilar_le_relEquiv`).  The inclusion can be strict; the controls
module exhibits a pair related by `A.RelEquiv obs` and separated by
least-enabler bisimilarity.

Admissible classes form a complete lattice, and `generatedBy` is left adjoint
to reading off the set of admissible contexts.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.AdmissibleContextCongruence

open Mettapedia.GSLT
open Mettapedia.GSLT.HennessyMilner
open Mettapedia.GSLT.MinimalEnablingContext

universe uS uContext uRule uAtom

variable {S : GSLT.{uS}} {rules : ContextualRules.{uContext, uRule} S}

/-! ## Equation bookkeeping -/

private theorem equiv_refl (t : S.Term) : S.Equiv t t := S.equations.iseqv.refl t

private theorem equiv_symm {a b : S.Term} (h : S.Equiv a b) : S.Equiv b a :=
  S.equations.iseqv.symm h

private theorem equiv_trans {a b c : S.Term} (h : S.Equiv a b) (h' : S.Equiv b c) :
    S.Equiv a c :=
  S.equations.iseqv.trans h h'

namespace AdmissibleClass

/-! ## The order on admissible classes -/

@[ext]
theorem ext {A B : AdmissibleClass rules}
    (h : ∀ context, A.Admissible context ↔ B.Admissible context) : A = B := by
  cases A with
  | mk admissibleA _ _ =>
    cases B with
    | mk admissibleB _ _ =>
      have : admissibleA = admissibleB := funext fun context => propext (h context)
      subst this
      rfl

instance : PartialOrder (AdmissibleClass rules) where
  le A B := ∀ context, A.Admissible context → B.Admissible context
  le_refl _ _ admissible := admissible
  le_trans _ _ _ first second context admissible := second context (first context admissible)
  le_antisymm _ _ first second := ext fun context => ⟨first context, second context⟩

theorem le_def {A B : AdmissibleClass rules} :
    A ≤ B ↔ ∀ context, A.Admissible context → B.Admissible context :=
  Iff.rfl

/-- Intersections of admissible classes are admissible classes. -/
instance : InfSet (AdmissibleClass rules) where
  sInf family :=
    { Admissible := fun context => ∀ A ∈ family, A.Admissible context
      identity_mem := fun A _ => A.identity_mem
      compose_mem := fun outer inner A member =>
        A.compose_mem (outer A member) (inner A member) }

theorem isGLB_sInf (family : Set (AdmissibleClass rules)) :
    IsGLB family (sInf family) :=
  ⟨fun A member _ admissible => admissible A member,
    fun _ lower context admissible _ member => lower member context admissible⟩

/-- Admissible classes form a complete lattice, with intersection as meet. -/
instance : CompleteLattice (AdmissibleClass rules) :=
  completeLatticeOfInf _ isGLB_sInf

/-- The top class admits every context. -/
theorem top_admissible (context : rules.Context) :
    (⊤ : AdmissibleClass rules).Admissible context := by
  have top_le : (⊤ : AdmissibleClass rules) ≥
      { Admissible := fun _ => True
        identity_mem := trivial
        compose_mem := fun _ _ => trivial } := le_top
  exact top_le context trivial

/-! ## The class generated by a set of contexts -/

/-- Closure of a set of contexts under the identity and composition. -/
inductive GeneratedBy (generators : Set rules.Context) : rules.Context → Prop
  | identity : GeneratedBy generators rules.identity
  | generator {context : rules.Context} : context ∈ generators →
      GeneratedBy generators context
  | compose {outer inner : rules.Context} : GeneratedBy generators outer →
      GeneratedBy generators inner → GeneratedBy generators (rules.compose outer inner)

/-- The admissible class generated by a set of contexts. -/
def generatedBy (generators : Set rules.Context) : AdmissibleClass rules where
  Admissible := GeneratedBy generators
  identity_mem := .identity
  compose_mem := fun outer inner => .compose outer inner

theorem generator_mem {generators : Set rules.Context} {context : rules.Context}
    (member : context ∈ generators) : (generatedBy generators).Admissible context :=
  .generator member

theorem generatedBy_le_iff {generators : Set rules.Context} {A : AdmissibleClass rules} :
    generatedBy generators ≤ A ↔ generators ⊆ {context | A.Admissible context} := by
  constructor
  · intro le context member
    exact le context (.generator member)
  · intro sub context generated
    induction generated with
    | identity => exact A.identity_mem
    | generator member => exact sub member
    | compose _ _ outer inner => exact A.compose_mem outer inner

/-- Generation is left adjoint to reading off the admissible contexts, and the
adjunction is an insertion: a class is generated by its own contexts. -/
def generatedByInsertion :
    GaloisInsertion (generatedBy (rules := rules))
      (fun A : AdmissibleClass rules => {context | A.Admissible context}) :=
  GaloisConnection.toGaloisInsertion (fun _ _ => generatedBy_le_iff)
    (fun _ _ admissible => .generator admissible)

/-! ## The saturated system -/

/-- **The saturated system of a class.**  Labels are all admissible contexts, a
step under a label is any reduction of the filled context, and an atom is a
base observation read through an admissible context.  Observations therefore
respect the class by construction. -/
def saturated (A : AdmissibleClass rules)
    (observations : ContextualRules.Observations.{uAtom} S) :
    System.{max uAtom uContext, uContext} S where
  Atom := observations.Atom × {context : rules.Context // A.Admissible context}
  observes atom term := observations.observes atom.1 (rules.plug atom.2.1 term)
  observes_resp atom _ _ equivalent :=
    observations.observes_resp atom.1 (rules.plug_resp atom.2.1 equivalent)
  Label := {context : rules.Context // A.Admissible context}
  act label source target := S.Step (rules.plug label.1 source) target
  act_resp_left {label} _ _ _ equivalent step :=
    S.rewrites_resp_left (rules.plug_resp label.1 equivalent) step
  act_resp_right step equivalent := S.rewrites_resp_right step equivalent

/-- **The `A`-relative equivalence**: bisimilarity of the saturated system. -/
def RelEquiv (A : AdmissibleClass rules)
    (observations : ContextualRules.Observations.{uAtom} S) (left right : S.Term) : Prop :=
  (A.saturated observations).Bisimilar left right

/-- A relation is closed under a class when every admissible context preserves
it. -/
def ClosedUnder (A : AdmissibleClass rules) (relation : S.Term → S.Term → Prop) : Prop :=
  ∀ ⦃context : rules.Context⦄ ⦃left right : S.Term⦄, A.Admissible context →
    relation left right → relation (rules.plug context left) (rules.plug context right)

variable (A : AdmissibleClass rules) (observations : ContextualRules.Observations.{uAtom} S)

theorem relEquiv_refl (term : S.Term) : A.RelEquiv observations term term :=
  (A.saturated observations).bisimilar_refl term

theorem relEquiv_symm {left right : S.Term} (related : A.RelEquiv observations left right) :
    A.RelEquiv observations right left :=
  (A.saturated observations).bisimilar_symm related

theorem relEquiv_trans {left middle right : S.Term}
    (first : A.RelEquiv observations left middle)
    (second : A.RelEquiv observations middle right) :
    A.RelEquiv observations left right :=
  (A.saturated observations).bisimilar_trans first second

theorem relEquiv_equivalence : Equivalence (A.RelEquiv observations) :=
  ⟨A.relEquiv_refl observations, A.relEquiv_symm observations,
    A.relEquiv_trans observations⟩

theorem relEquiv_of_equiv {left right : S.Term} (equivalent : S.Equiv left right) :
    A.RelEquiv observations left right :=
  (A.saturated observations).bisimilar_of_equiv equivalent

/-- The relative equivalence is invariant under the equations on both sides. -/
theorem relEquiv_of_equiv_of_equiv {left left' right right' : S.Term}
    (leftEquivalent : S.Equiv left left') (rightEquivalent : S.Equiv right right')
    (related : A.RelEquiv observations left right) :
    A.RelEquiv observations left' right' :=
  A.relEquiv_trans observations
    (A.relEquiv_trans observations
      (A.relEquiv_of_equiv observations (equiv_symm leftEquivalent)) related)
    (A.relEquiv_of_equiv observations rightEquivalent)

/-! ## T1: congruence for the class, with no further hypothesis -/

/-- A step of a filled context under a label is a step of the inner term under
the composed label. -/
theorem step_plug_to_compose {outer inner : rules.Context} {term target : S.Term}
    (step : S.Step (rules.plug outer (rules.plug inner term)) target) :
    ∃ target', S.Step (rules.plug (rules.compose outer inner) term) target' ∧
      S.Equiv target target' :=
  S.rewrites_resp_left (equiv_symm (rules.plug_compose outer inner term)) step

/-- Conversely, a step under the composed label is a step of the filled context. -/
theorem step_compose_to_plug {outer inner : rules.Context} {term target : S.Term}
    (step : S.Step (rules.plug (rules.compose outer inner) term) target) :
    ∃ target', S.Step (rules.plug outer (rules.plug inner term)) target' ∧
      S.Equiv target target' :=
  S.rewrites_resp_left (rules.plug_compose outer inner term) step

/-- Reading an observation through a label on a filled context is reading it
through the composed label. -/
theorem observes_plug_compose (atom : observations.Atom) (outer inner : rules.Context)
    (term : S.Term) :
    observations.observes atom (rules.plug outer (rules.plug inner term)) ↔
      observations.observes atom (rules.plug (rules.compose outer inner) term) :=
  (observations.observes_resp atom (rules.plug_compose outer inner term)).symm

/-- The relation used for congruence: pairs obtained by filling one admissible
context with related terms, up to the equations. -/
def plugClosure (left right : S.Term) : Prop :=
  ∃ (context : rules.Context) (inner innerRight : S.Term),
    A.Admissible context ∧ A.RelEquiv observations inner innerRight ∧
      S.Equiv left (rules.plug context inner) ∧ S.Equiv right (rules.plug context innerRight)

theorem plugClosure_of_relEquiv {left right : S.Term}
    (related : A.RelEquiv observations left right) :
    A.plugClosure observations left right :=
  ⟨rules.identity, left, right, A.identity_mem, related,
    equiv_symm (rules.plug_identity left), equiv_symm (rules.plug_identity right)⟩

/-- One direction of the transfer property of `plugClosure`. -/
private theorem plugClosure_forward {first second : S.Term}
    (related : A.plugClosure observations first second)
    (label : (A.saturated observations).Label) {first' : S.Term}
    (step : (A.saturated observations).act label first first') :
    ∃ second', (A.saturated observations).act label second second' ∧
      A.plugClosure observations first' second' := by
  obtain ⟨context, inner, innerRight, admissible, innerRelated, firstEq, secondEq⟩ := related
  -- move the step onto the filled context, then onto the inner term
  obtain ⟨atFilled, stepFilled, equivFilled⟩ :=
    S.rewrites_resp_left (rules.plug_resp label.1 firstEq) step
  obtain ⟨atInner, stepInner, equivInner⟩ := step_plug_to_compose stepFilled
  -- match it on the right inner term under the composed label
  obtain ⟨rightInner', stepRightInner, relatedInner⟩ :=
    AdmissibleContextCongruence.bisimilar_forward innerRelated
      ⟨rules.compose label.1 context, A.compose_mem label.2 admissible⟩ stepInner
  -- and move it back out to `second`
  obtain ⟨rightFilled, stepRightFilled, equivRightFilled⟩ :=
    step_compose_to_plug stepRightInner
  obtain ⟨second', stepSecond, equivSecond⟩ :=
    S.rewrites_resp_left (rules.plug_resp label.1 (equiv_symm secondEq)) stepRightFilled
  refine ⟨second', stepSecond, A.plugClosure_of_relEquiv observations ?_⟩
  exact A.relEquiv_of_equiv_of_equiv observations
    (equiv_symm (equiv_trans equivFilled equivInner))
    (equiv_trans equivRightFilled equivSecond) relatedInner

private theorem plugClosure_symm {first second : S.Term}
    (related : A.plugClosure observations first second) :
    A.plugClosure observations second first := by
  obtain ⟨context, inner, innerRight, admissible, innerRelated, firstEq, secondEq⟩ := related
  exact ⟨context, innerRight, inner, admissible,
    A.relEquiv_symm observations innerRelated, secondEq, firstEq⟩

theorem isBisimulation_plugClosure :
    (A.saturated observations).IsBisimulation (A.plugClosure observations) := by
  refine ⟨?_, ?_, ?_⟩
  · intro first second related label first' step
    exact A.plugClosure_forward observations related label step
  · intro first second related label second' step
    obtain ⟨first', stepFirst, related'⟩ :=
      A.plugClosure_forward observations (A.plugClosure_symm observations related) label step
    exact ⟨first', stepFirst, A.plugClosure_symm observations related'⟩
  · intro first second related atom
    obtain ⟨context, inner, innerRight, admissible, innerRelated, firstEq, secondEq⟩ := related
    have innerAgree := AdmissibleContextCongruence.bisimilar_observes innerRelated
      (atom.1, ⟨rules.compose atom.2.1 context, A.compose_mem atom.2.2 admissible⟩)
    change observations.observes atom.1 (rules.plug atom.2.1 first) ↔
      observations.observes atom.1 (rules.plug atom.2.1 second)
    change observations.observes atom.1
        (rules.plug (rules.compose atom.2.1 context) inner) ↔
      observations.observes atom.1
        (rules.plug (rules.compose atom.2.1 context) innerRight) at innerAgree
    calc observations.observes atom.1 (rules.plug atom.2.1 first)
        ↔ observations.observes atom.1 (rules.plug atom.2.1 (rules.plug context inner)) :=
          observations.observes_resp atom.1 (rules.plug_resp atom.2.1 firstEq)
      _ ↔ observations.observes atom.1 (rules.plug (rules.compose atom.2.1 context) inner) :=
          observes_plug_compose observations atom.1 atom.2.1 context inner
      _ ↔ observations.observes atom.1
            (rules.plug (rules.compose atom.2.1 context) innerRight) := innerAgree
      _ ↔ observations.observes atom.1
            (rules.plug atom.2.1 (rules.plug context innerRight)) :=
          (observes_plug_compose observations atom.1 atom.2.1 context innerRight).symm
      _ ↔ observations.observes atom.1 (rules.plug atom.2.1 second) :=
          (observations.observes_resp atom.1 (rules.plug_resp atom.2.1 secondEq)).symm

/-- **T1 (congruence).**  The `A`-relative equivalence is preserved by every
context of `A`.  No least-enabler, relative-pushout or observation-respect
hypothesis is used: labels and atoms range over the whole class, so a step or
an observation of a filled context is one of the inner term under a composed
admissible context. -/
theorem relEquiv_closedUnder : A.ClosedUnder (A.RelEquiv observations) := by
  intro context left right admissible related
  exact ⟨A.plugClosure observations, A.isBisimulation_plugClosure observations,
    context, left, right, admissible, related, equiv_refl _, equiv_refl _⟩

/-! ## T2: antitone in the class -/

/-- A larger class refines the saturated system of a smaller one: every label
and atom of the smaller class is one of the larger class, with the same
transitions and observations. -/
def refinementOfLe {A B : AdmissibleClass rules} (le : A ≤ B) :
    ObserverRefinement (A.saturated observations) (B.saturated observations) where
  mapAtom atom := (atom.1, ⟨atom.2.1, le _ atom.2.2⟩)
  mapLabel label := ⟨label.1, le _ label.2⟩
  observes_iff _ _ := Iff.rfl
  act_iff _ _ _ := Iff.rfl

/-- **T2 (antitone).**  More admissible observers give a finer equivalence. -/
theorem relEquiv_antitone {A B : AdmissibleClass rules} (le : A ≤ B) {left right : S.Term}
    (related : B.RelEquiv observations left right) : A.RelEquiv observations left right :=
  (refinementOfLe observations le).bisimilar_forget related

/-- The forgetting map from the classes of a finer observer class to those of a
coarser one. -/
def classMapOfLe {A B : AdmissibleClass rules} (le : A ≤ B) :
    (B.saturated observations).BehavioralClass → (A.saturated observations).BehavioralClass :=
  (refinementOfLe observations le).classMap

theorem classMapOfLe_mk {A B : AdmissibleClass rules} (le : A ≤ B) (term : S.Term) :
    classMapOfLe observations le ((B.saturated observations).toBehavioralClass term) =
      (A.saturated observations).toBehavioralClass term :=
  rfl

theorem classMapOfLe_refl (A : AdmissibleClass rules) :
    classMapOfLe observations (le_refl A) = id := by
  funext stateClass
  induction stateClass using Quotient.inductionOn with
  | _ term => rfl

theorem classMapOfLe_trans {A B C : AdmissibleClass rules} (first : A ≤ B) (second : B ≤ C) :
    classMapOfLe observations (le_trans first second) =
      classMapOfLe observations first ∘ classMapOfLe observations second := by
  funext stateClass
  induction stateClass using Quotient.inductionOn with
  | _ term => rfl

/-! ## T3: the coarsest bisimulation congruence -/

end AdmissibleClass

/-- A reduction bisimulation that also preserves every base observation. -/
def IsReductionBisimulation (observations : ContextualRules.Observations.{uAtom} S)
    (relation : S.Term → S.Term → Prop) : Prop :=
  S.IsBisimulation relation ∧
    ∀ ⦃left right : S.Term⦄, relation left right →
      ∀ atom, observations.observes atom left ↔ observations.observes atom right

/-- Reduction bisimilarity with base observations. -/
def ReductionBisimilar (observations : ContextualRules.Observations.{uAtom} S)
    (left right : S.Term) : Prop :=
  ∃ relation, IsReductionBisimulation observations relation ∧ relation left right

namespace AdmissibleClass

variable (A : AdmissibleClass rules) (observations : ContextualRules.Observations.{uAtom} S)

/-- The `A`-relative equivalence is a reduction bisimulation: the identity
context is admissible. -/
theorem isReductionBisimulation_relEquiv :
    IsReductionBisimulation observations (A.RelEquiv observations) := by
  let identity : (A.saturated observations).Label := ⟨rules.identity, A.identity_mem⟩
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · intro left right related left' step
    obtain ⟨atIdentity, stepIdentity, equivIdentity⟩ :=
      S.rewrites_resp_left (equiv_symm (rules.plug_identity left)) step
    obtain ⟨right', stepRight, related'⟩ :=
      AdmissibleContextCongruence.bisimilar_forward related identity stepIdentity
    obtain ⟨right'', stepRight', equivRight⟩ :=
      S.rewrites_resp_left (rules.plug_identity right) stepRight
    exact ⟨right'', stepRight',
      A.relEquiv_of_equiv_of_equiv observations (equiv_symm equivIdentity) equivRight related'⟩
  · intro left right related right' step
    obtain ⟨atIdentity, stepIdentity, equivIdentity⟩ :=
      S.rewrites_resp_left (equiv_symm (rules.plug_identity right)) step
    obtain ⟨left', stepLeft, related'⟩ :=
      AdmissibleContextCongruence.bisimilar_backward related identity stepIdentity
    obtain ⟨left'', stepLeft', equivLeft⟩ :=
      S.rewrites_resp_left (rules.plug_identity left) stepLeft
    exact ⟨left'', stepLeft',
      A.relEquiv_of_equiv_of_equiv observations equivLeft (equiv_symm equivIdentity) related'⟩
  · intro left right related atom
    have agree := AdmissibleContextCongruence.bisimilar_observes related (atom, identity)
    change observations.observes atom (rules.plug rules.identity left) ↔
      observations.observes atom (rules.plug rules.identity right) at agree
    exact ((observations.observes_resp atom (rules.plug_identity left)).symm.trans agree).trans
      (observations.observes_resp atom (rules.plug_identity right))

/-- Every reduction bisimulation closed under `A` is a bisimulation of the
saturated system of `A`. -/
theorem isBisimulation_of_isReductionBisimulation {relation : S.Term → S.Term → Prop}
    (bisimulation : IsReductionBisimulation observations relation)
    (closed : A.ClosedUnder relation) :
    (A.saturated observations).IsBisimulation relation := by
  refine ⟨?_, ?_, ?_⟩
  · intro left right related label left' step
    exact bisimulation.1.1 (closed label.2 related) step
  · intro left right related label right' step
    exact bisimulation.1.2 (closed label.2 related) step
  · intro left right related atom
    exact bisimulation.2 (closed atom.2.2 related) atom.1

/-- **T3 (coarsest), maximality half.**  Every reduction bisimulation that is
closed under `A` is contained in the `A`-relative equivalence. -/
theorem relEquiv_of_isReductionBisimulation {relation : S.Term → S.Term → Prop}
    (bisimulation : IsReductionBisimulation observations relation)
    (closed : A.ClosedUnder relation) {left right : S.Term} (related : relation left right) :
    A.RelEquiv observations left right :=
  ⟨relation, A.isBisimulation_of_isReductionBisimulation observations bisimulation closed,
    related⟩

/-- **T3 (coarsest).**  The `A`-relative equivalence is exactly the union of the
reduction bisimulations closed under `A`: the coarsest bisimulation congruence
for `A` (Bonchi, König and Montanari, LICS 2006, Theorem 1, relativised). -/
theorem relEquiv_iff_exists {left right : S.Term} :
    A.RelEquiv observations left right ↔
      ∃ relation, IsReductionBisimulation observations relation ∧ A.ClosedUnder relation ∧
        relation left right :=
  ⟨fun related => ⟨A.RelEquiv observations, A.isReductionBisimulation_relEquiv observations,
      A.relEquiv_closedUnder observations, related⟩,
    fun ⟨_, bisimulation, closed, related⟩ =>
      A.relEquiv_of_isReductionBisimulation observations bisimulation closed related⟩

/-- The `A`-relative equivalence is contained in reduction bisimilarity. -/
theorem reductionBisimilar_of_relEquiv {left right : S.Term}
    (related : A.RelEquiv observations left right) :
    ReductionBisimilar observations left right :=
  ⟨A.RelEquiv observations, A.isReductionBisimulation_relEquiv observations, related⟩

end AdmissibleClass

/-! ## Reduction bisimilarity -/

theorem isReductionBisimulation_equiv (observations : ContextualRules.Observations.{uAtom} S) :
    IsReductionBisimulation observations S.Equiv := by
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · intro left right equivalent left' step
    obtain ⟨right', stepRight, equivalent'⟩ := S.rewrites_resp_left equivalent step
    exact ⟨right', stepRight, equivalent'⟩
  · intro left right equivalent right' step
    obtain ⟨left', stepLeft, equivalent'⟩ := S.rewrites_resp_left (equiv_symm equivalent) step
    exact ⟨left', stepLeft, equiv_symm equivalent'⟩
  · intro left right equivalent atom
    exact observations.observes_resp atom equivalent

theorem reductionBisimilar_of_equiv (observations : ContextualRules.Observations.{uAtom} S)
    {left right : S.Term} (equivalent : S.Equiv left right) :
    ReductionBisimilar observations left right :=
  ⟨S.Equiv, isReductionBisimulation_equiv observations, equivalent⟩

theorem reductionBisimilar_symm (observations : ContextualRules.Observations.{uAtom} S)
    {left right : S.Term} (related : ReductionBisimilar observations left right) :
    ReductionBisimilar observations right left := by
  obtain ⟨relation, ⟨⟨forward, backward⟩, atoms⟩, holds⟩ := related
  refine ⟨fun first second => relation second first, ⟨⟨?_, ?_⟩, ?_⟩, holds⟩
  · intro first second held first' step
    exact backward held step
  · intro first second held second' step
    exact forward held step
  · intro first second held atom
    exact (atoms held atom).symm

theorem reductionBisimilar_trans (observations : ContextualRules.Observations.{uAtom} S)
    {left middle right : S.Term} (first : ReductionBisimilar observations left middle)
    (second : ReductionBisimilar observations middle right) :
    ReductionBisimilar observations left right := by
  obtain ⟨firstRelation, ⟨⟨firstForward, firstBackward⟩, firstAtoms⟩, leftMiddle⟩ := first
  obtain ⟨secondRelation, ⟨⟨secondForward, secondBackward⟩, secondAtoms⟩, middleRight⟩ :=
    second
  refine ⟨fun source target => ∃ bridge, firstRelation source bridge ∧
      secondRelation bridge target, ⟨⟨?_, ?_⟩, ?_⟩, middle, leftMiddle, middleRight⟩
  · rintro source target ⟨bridge, sourceBridge, bridgeTarget⟩ source' step
    obtain ⟨bridge', bridgeStep, sourceBridge'⟩ := firstForward sourceBridge step
    obtain ⟨target', targetStep, bridgeTarget'⟩ := secondForward bridgeTarget bridgeStep
    exact ⟨target', targetStep, bridge', sourceBridge', bridgeTarget'⟩
  · rintro source target ⟨bridge, sourceBridge, bridgeTarget⟩ target' step
    obtain ⟨bridge', bridgeStep, bridgeTarget'⟩ := secondBackward bridgeTarget step
    obtain ⟨source', sourceStep, sourceBridge'⟩ := firstBackward sourceBridge bridgeStep
    exact ⟨source', sourceStep, bridge', sourceBridge', bridgeTarget'⟩
  · rintro source target ⟨bridge, sourceBridge, bridgeTarget⟩ atom
    exact (firstAtoms sourceBridge atom).trans (secondAtoms bridgeTarget atom)

/-! ## The contextual variant -/

namespace AdmissibleClass

variable (A : AdmissibleClass rules) (observations : ContextualRules.Observations.{uAtom} S)

/-- **Contextual `A`-equivalence**: reduction bisimilarity of every admissible
filling.  Contexts are applied once, before any step; the saturated
equivalence instead lets the observer add a context after every step. -/
def ContextualEquiv (left right : S.Term) : Prop :=
  ∀ ⦃context : rules.Context⦄, A.Admissible context →
    ReductionBisimilar observations (rules.plug context left) (rules.plug context right)

/-- The saturated equivalence is contained in the contextual one. -/
theorem contextualEquiv_of_relEquiv {left right : S.Term}
    (related : A.RelEquiv observations left right) : A.ContextualEquiv observations left right :=
  fun _ admissible => A.reductionBisimilar_of_relEquiv observations
    (A.relEquiv_closedUnder observations admissible related)

/-- The contextual equivalence is contained in reduction bisimilarity. -/
theorem reductionBisimilar_of_contextualEquiv {left right : S.Term}
    (related : A.ContextualEquiv observations left right) :
    ReductionBisimilar observations left right :=
  reductionBisimilar_trans observations
    (reductionBisimilar_of_equiv observations (equiv_symm (rules.plug_identity left)))
    (reductionBisimilar_trans observations (related A.identity_mem)
      (reductionBisimilar_of_equiv observations (rules.plug_identity right)))

/-- The contextual equivalence is closed under the class. -/
theorem contextualEquiv_closedUnder : A.ClosedUnder (A.ContextualEquiv observations) := by
  intro context left right admissible related outer outerAdmissible
  have composed := related (A.compose_mem outerAdmissible admissible)
  exact reductionBisimilar_trans observations
    (reductionBisimilar_of_equiv observations (equiv_symm (rules.plug_compose outer context left)))
    (reductionBisimilar_trans observations composed
      (reductionBisimilar_of_equiv observations (rules.plug_compose outer context right)))

/-- The contextual equivalence is the largest `A`-closed relation contained in
reduction bisimilarity. -/
theorem contextualEquiv_largest {relation : S.Term → S.Term → Prop}
    (closed : A.ClosedUnder relation)
    (contained : ∀ ⦃left right⦄, relation left right → ReductionBisimilar observations left right)
    {left right : S.Term} (related : relation left right) :
    A.ContextualEquiv observations left right :=
  fun _ admissible => contained (closed admissible related)

/-! ## Minimal labels are a proof technique

The least-enabler system `labelledSystem` labels a transition only by a least
enabling context.  Its bisimilarity is contained in the saturated one as soon
as it is an `A`-congruence and every reduction is a rule firing: it is then an
`A`-closed reduction bisimulation, and T3 applies.  This is the direction
Bonchi, König and Montanari prove for IPO bisimilarity; the converse fails,
and the controls module exhibits the failure. -/

/-- Every authored reduction is a firing of some rule. -/
def _root_.Mettapedia.GSLT.MinimalEnablingContext.ContextualRules.StepsAreFirings
    (rules : ContextualRules.{uContext, uRule} S) : Prop :=
  ∀ ⦃source target : S.Term⦄, S.Step source target → ∃ rule, rules.fires rule source target

/-- The identity context is a least enabler of every rule that fires. -/
theorem identity_isLeastEnabler {source target : S.Term} {rule : rules.Rule}
    (fires : rules.fires rule source target) :
    ∃ target', rules.IsLeastEnabler rules.identity source rule ∧
      rules.fires rule (rules.plug rules.identity source) target' ∧ S.Equiv target target' := by
  obtain ⟨target', fires', equivalent⟩ :=
    rules.fires_resp_left (equiv_symm (rules.plug_identity source)) fires
  refine ⟨target', ⟨⟨target', fires'⟩, ?_⟩, fires', equivalent⟩
  intro other _
  exact ⟨other, fun term => rules.plug_resp other (equiv_symm (rules.plug_identity term))⟩

/-- When every reduction is a rule firing, least-enabler bisimilarity is a
reduction bisimulation with base observations. -/
theorem isReductionBisimulation_labelled (steps : rules.StepsAreFirings) :
    IsReductionBisimulation observations (A.labelledSystem observations).Bisimilar := by
  let identity : (A.labelledSystem observations).Label := ⟨rules.identity, A.identity_mem⟩
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · intro left right related left' step
    obtain ⟨rule, fires⟩ := steps step
    obtain ⟨left'', least, fires', equivalent⟩ := identity_isLeastEnabler fires
    obtain ⟨right', actRight, related'⟩ :=
      AdmissibleContextCongruence.bisimilar_forward related identity
        (⟨rule, least, fires'⟩ : rules.Act rules.identity left left'')
    obtain ⟨_, _, firesRight⟩ := actRight
    obtain ⟨right'', stepRight, equivRight⟩ :=
      S.rewrites_resp_left (rules.plug_identity right) (rules.fires_step firesRight)
    exact ⟨right'', stepRight, (A.labelledSystem observations).bisimilar_trans
      ((A.labelledSystem observations).bisimilar_of_equiv equivalent)
      ((A.labelledSystem observations).bisimilar_trans related'
        ((A.labelledSystem observations).bisimilar_of_equiv equivRight))⟩
  · intro left right related right' step
    obtain ⟨rule, fires⟩ := steps step
    obtain ⟨right'', least, fires', equivalent⟩ := identity_isLeastEnabler fires
    obtain ⟨left', actLeft, related'⟩ :=
      AdmissibleContextCongruence.bisimilar_backward related identity
        (⟨rule, least, fires'⟩ : rules.Act rules.identity right right'')
    obtain ⟨_, _, firesLeft⟩ := actLeft
    obtain ⟨left'', stepLeft, equivLeft⟩ :=
      S.rewrites_resp_left (rules.plug_identity left) (rules.fires_step firesLeft)
    exact ⟨left'', stepLeft, (A.labelledSystem observations).bisimilar_trans
      ((A.labelledSystem observations).bisimilar_symm
        ((A.labelledSystem observations).bisimilar_of_equiv equivLeft))
      ((A.labelledSystem observations).bisimilar_trans related'
        ((A.labelledSystem observations).bisimilar_symm
          ((A.labelledSystem observations).bisimilar_of_equiv equivalent)))⟩
  · intro left right related atom
    exact AdmissibleContextCongruence.bisimilar_observes related atom

/-- **Least-enabler bisimilarity is contained in the saturated equivalence**
whenever it is an `A`-congruence and every reduction is a rule firing. -/
theorem labelledBisimilar_le_relEquiv (steps : rules.StepsAreFirings)
    (congruence : A.ClosedUnder (A.labelledSystem observations).Bisimilar)
    {left right : S.Term} (related : (A.labelledSystem observations).Bisimilar left right) :
    A.RelEquiv observations left right :=
  A.relEquiv_of_isReductionBisimulation observations
    (A.isReductionBisimulation_labelled observations steps) congruence related

/-- The same inclusion, with the congruence discharged by
`bisimilar_plug_labelled` from its two hypotheses. -/
theorem labelledBisimilar_le_relEquiv_of_composes (steps : rules.StepsAreFirings)
    (composes : A.LeastEnablerComposes)
    (respects : A.ObservationsRespectClass (A.labelledSystem observations))
    {left right : S.Term} (related : (A.labelledSystem observations).Bisimilar left right) :
    A.RelEquiv observations left right :=
  A.labelledBisimilar_le_relEquiv observations steps
    (fun _ _ _ admissible bisimilar =>
      bisimilar_plug_labelled A composes respects admissible bisimilar)
    related

end AdmissibleClass

end Mettapedia.GSLT.AdmissibleContextCongruence
