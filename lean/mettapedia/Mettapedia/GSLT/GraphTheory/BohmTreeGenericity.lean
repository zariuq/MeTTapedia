import Mettapedia.GSLT.GraphTheory.BohmTreeSemantics
import Mettapedia.GSLT.GraphTheory.SensibleTheories

/-!
# Unsolvable subterms and exact Böhm observations

Replacing unsolvable subterms of a term by arbitrary terms can only add
information to its exact Böhm observation, at every depth. Replacing them by
unsolvable terms changes nothing. So contexts are monotone at bottom, and the
exact tree equivalence contains the theory `H` generated by equating all
unsolvable terms.

## Main results

* `UnsolvableFilling.tree_informationLE`: filling unsolvable subterms adds
  information to the exact observation.
* `LambdaContext.tree_plug_informationLE`: the observation of `C[U]`, with `U`
  unsolvable, lies below the observation of `C[M]` for every `M`.
* `LambdaContext.equivalent_plug_of_unsolvable`: exchanging one unsolvable
  subterm for another preserves exact tree equivalence.
* `BohmObservation.equivalent_of_unsolvableTheory`: terms equated by `H` have
  the same exact observations.

Closure of exact tree equivalence under application to arbitrary arguments is
not proved here.

## Method

The head reduction of the filled term follows the head reduction of the
original term (`UnsolvableFilling.headStep`), so the two terms reach head
normal forms with the same binders and head variable and with related
arguments. The statement for depth `d + 1` then follows from depth `d`.
-/

namespace Mettapedia.GSLT.GraphTheory

namespace UnsolvableFilling

private theorem collectArgs {t t' : LambdaTerm} (h : UnsolvableFilling t t')
    {acc acc' : List LambdaTerm} (hAcc : List.Forall₂ UnsolvableFilling acc acc')
    {head : Nat} {arguments : List LambdaTerm}
    (hExtract : extractHNF.collectArgs t acc = some (head, arguments)) :
    ∃ arguments', extractHNF.collectArgs t' acc' = some (head, arguments') ∧
      List.Forall₂ UnsolvableFilling arguments arguments' := by
  induction h generalizing acc acc' head arguments with
  | var n =>
      simp only [extractHNF.collectArgs, Option.some.injEq, Prod.mk.injEq] at hExtract
      rcases hExtract with ⟨rfl, rfl⟩
      exact ⟨acc', rfl, hAcc⟩
  | lam _ _ => simp [extractHNF.collectArgs] at hExtract
  | app _ ha ihf _ => exact ihf (List.Forall₂.cons ha hAcc) hExtract
  | @fill t t' hU =>
      have spine : t.isAppHead = true := by
        rw [← collectArgs_isSome_eq t acc, hExtract]
        rfl
      exact absurd (LambdaTerm.solvable_of_isHNF (LambdaTerm.isHNF_of_isAppHead spine)) hU

/-- Filling a head normal form keeps its binders and head variable and fills
its arguments. -/
theorem extractHNF {t t' : LambdaTerm} (h : UnsolvableFilling t t')
    {numLams head : Nat} {arguments : List LambdaTerm}
    (hExtract : extractHNF t = some (numLams, head, arguments)) :
    ∃ arguments', GraphTheory.extractHNF t' = some (numLams, head, arguments') ∧
      List.Forall₂ UnsolvableFilling arguments arguments' := by
  induction h generalizing numLams head arguments with
  | var n =>
      simp only [GraphTheory.extractHNF, Option.some.injEq, Prod.mk.injEq] at hExtract
      rcases hExtract with ⟨rfl, rfl, rfl⟩
      exact ⟨[], rfl, .nil⟩
  | @lam body body' _ ih =>
      cases hInner : GraphTheory.extractHNF body with
      | none => simp [GraphTheory.extractHNF, hInner] at hExtract
      | some value =>
          rcases value with ⟨count, innerHead, innerArguments⟩
          simp only [GraphTheory.extractHNF, hInner, Option.some.injEq, Prod.mk.injEq] at hExtract
          rcases hExtract with ⟨rfl, rfl, rfl⟩
          obtain ⟨arguments', hResult, hArguments⟩ := ih hInner
          exact ⟨arguments', by simp only [GraphTheory.extractHNF, hResult], hArguments⟩
  | @app function function' argument argument' hFn hArg _ _ =>
      rw [extractHNF_app_eq] at hExtract
      cases hCollected : extractHNF.collectArgs (.app function argument) [] with
      | none => simp [hCollected] at hExtract
      | some value =>
          rcases value with ⟨innerHead, innerArguments⟩
          simp only [hCollected, Option.map_some, Option.some.injEq, Prod.mk.injEq] at hExtract
          rcases hExtract with ⟨rfl, rfl, rfl⟩
          obtain ⟨arguments', hResult, hArguments⟩ :=
            collectArgs (UnsolvableFilling.app hFn hArg) List.Forall₂.nil hCollected
          exact ⟨arguments', by rw [extractHNF_app_eq, hResult]; rfl, hArguments⟩
  | @fill t t' hU =>
      have headForm : t.isHNF = true := by
        rw [← extractHNF_isSome_eq_isHNF, hExtract]
        rfl
      exact absurd (LambdaTerm.solvable_of_isHNF headForm) hU

/-- The head reduction of a filling follows the head reduction of the term up
to a head normal form. -/
theorem exists_hnf {t : LambdaTerm} (hn : HeadNormalizes t) :
    ∀ {t' : LambdaTerm}, UnsolvableFilling t t' →
      ∃ hnf hnf', (t ⇛* hnf) ∧ (t' ⇛* hnf') ∧ hnf.isHNF = true ∧
        UnsolvableFilling hnf hnf' := by
  induction hn with
  | @hnf t hhead =>
      intro t' hfill
      exact ⟨t, t', Relation.ReflTransGen.refl, Relation.ReflTransGen.refl, hhead, hfill⟩
  | @step t t₁ hstep hn ih =>
      intro t' hfill
      obtain ⟨t₁', hstep', hfill'⟩ := headStep hstep hfill (HeadNormalizes.step hstep hn).solvable
      obtain ⟨hnf, hnf', path, path', hhead, related⟩ := ih hfill'
      exact ⟨hnf, hnf', Relation.ReflTransGen.head hstep.parRed path,
        Relation.ReflTransGen.head hstep'.parRed path', hhead, related⟩

/-- **Filling unsolvable subterms adds information to the exact Böhm
observation**, at every depth. -/
theorem tree_informationLE {t t' : LambdaTerm} (hfill : UnsolvableFilling t t') (depth : Nat) :
    BohmTree.InformationLE (BohmObservation.tree depth t) (BohmObservation.tree depth t') := by
  classical
  induction depth generalizing t t' with
  | zero =>
      rw [BohmObservation.tree_zero]
      exact .bottom _
  | succ depth ih =>
      by_cases solvable : t.Solvable
      · obtain ⟨hnf, hnf', path, path', hhead, related⟩ :=
          exists_hnf (headNormalizes_of_solvable solvable) hfill
        have headSome := (extractHNF_isSome_eq_isHNF hnf).trans hhead
        cases headForm : GraphTheory.extractHNF hnf with
        | none => simp only [headForm, Option.isSome_none, Bool.false_eq_true] at headSome
        | some value =>
            rcases value with ⟨numLams, head, arguments⟩
            obtain ⟨arguments', headForm', filled⟩ := related.extractHNF headForm
            rw [BohmObservation.tree_node_of_reaches path headForm depth,
              BohmObservation.tree_node_of_reaches path' headForm' depth]
            exact .node (List.forall₂_map_left_iff.mpr (List.forall₂_map_right_iff.mpr
              (filled.imp fun _ _ argumentFilled => ih argumentFilled)))
      · rw [(BohmObservation.tree_bot_iff depth t).mpr solvable]
        exact .bottom _

end UnsolvableFilling

namespace BohmObservation

/-- Terms that are fillings of each other have the same exact observations. -/
theorem equivalent_of_mutual_filling {t t' : LambdaTerm} (forward : UnsolvableFilling t t')
    (backward : UnsolvableFilling t' t) : Equivalent t t' :=
  (equivalent_iff t t').mpr fun depth =>
    BohmTree.InformationLE.antisymm (forward.tree_informationLE depth)
      (backward.tree_informationLE depth)

end BohmObservation

namespace LambdaContext

/-- **Contexts are monotone at bottom.** The exact observation of `C[U]`, with
`U` unsolvable, lies below the exact observation of `C[M]` for every `M`. -/
theorem tree_plug_informationLE (context : LambdaContext) {u : LambdaTerm} (hU : u.Unsolvable)
    (m : LambdaTerm) (depth : Nat) :
    BohmTree.InformationLE (BohmObservation.tree depth (context.plug u))
      (BohmObservation.tree depth (context.plug m)) :=
  (context.unsolvableFilling_plug hU m).tree_informationLE depth

/-- Exchanging one unsolvable subterm for another preserves exact tree
equivalence. -/
theorem equivalent_plug_of_unsolvable (context : LambdaContext) {t t' : LambdaTerm}
    (ht : t.Unsolvable) (ht' : t'.Unsolvable) :
    BohmObservation.Equivalent (context.plug t) (context.plug t') :=
  BohmObservation.equivalent_of_mutual_filling (context.unsolvableFilling_plug ht t')
    (context.unsolvableFilling_plug ht' t)

end LambdaContext

namespace BohmObservation

/-- Exact tree equivalence contains the equivalence closure of β-steps and
exchanges of unsolvable subterms. -/
theorem equivalent_of_eqvGen_unsolvableStep {t s : LambdaTerm}
    (h : Relation.EqvGen UnsolvableStep t s) : Equivalent t s := by
  induction h with
  | rel _ _ step =>
      rcases step with hred | ⟨context, u, u', hu, hu', rfl, rfl⟩
      · exact equivalent_of_reduction (Relation.ReflTransGen.single hred)
      · exact context.equivalent_plug_of_unsolvable hu hu'
  | refl => exact equivalent_equivalence.refl _
  | symm _ _ _ ih => exact equivalent_equivalence.symm ih
  | trans _ _ _ _ _ ih ih' => exact equivalent_equivalence.trans ih ih'

/-- **Exact tree equivalence contains the theory `H`.** -/
theorem equivalent_of_unsolvableTheory {t s : LambdaTerm} (h : unsolvableTheory.equates t s) :
    Equivalent t s :=
  equivalent_of_eqvGen_unsolvableStep h

end BohmObservation

end Mettapedia.GSLT.GraphTheory
