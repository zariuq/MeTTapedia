import Mettapedia.GSLT.GraphTheory.Genericity
import Mettapedia.GSLT.GraphTheory.Interpretation
import Mettapedia.GSLT.GraphTheory.ParallelReduction

/-!
# The least and the greatest sensible theory

Bucciarelli–Salibra, *Graph Lambda Theories*, §2.1, recall two λ-theories:
`H`, generated by equating all unsolvable terms, and `H*`, its unique maximal
consistent extension. A λ-theory is sensible when it is consistent and
contains `H`; `H` is the least sensible theory and `H*` the greatest; a
λ-theory is semisensible exactly when it is contained in `H*`.

This file constructs both theories and proves these statements. `H*` is
defined as in Barendregt, §16.2: it equates two terms when no context
separates them by solvability. That it is the greatest consistent theory
containing `H` is then a theorem
(`le_observationalTheory_of_consistent_of_unsolvableTheory_le`).

## Main definitions

* `unsolvableTheory`: the theory `H`, the equivalence closure of parallel
  β-reduction and of exchanging one unsolvable subterm for another.
* `observationalTheory`: the theory `H*`.

## Main results

* `unsolvableTheory_le_iff`: `H ≤ T` exactly when `T` equates all unsolvable
  terms.
* `LambdaTheory.sensible_iff_consistent_and_unsolvableTheory_le`: a theory is
  sensible exactly when it is consistent and contains `H`.
* `semisensible_iff_le_observationalTheory`: a theory is semisensible exactly
  when it is contained in `H*`.
* `unsolvableTheory_sensible`, `observationalTheory_sensible`: both theories
  are sensible; in particular `H` is consistent.
* `LambdaTheory.Sensible.unsolvableTheory_le`,
  `LambdaTheory.Sensible.le_observationalTheory`: every sensible theory lies
  between `H` and `H*`.
* `graphTheory_sensible_iff`: the theory of a graph model is sensible exactly
  when it contains `H`.

## Method

`H*` is a λ-theory because contexts compose and solvability is invariant under
reduction. It equates all unsolvable terms by the genericity lemma
(`LambdaContext.solvable_plug_iff_of_unsolvable`), and it separates `I` from
`K` by the context `[·] I Ω`. Hence `H ≤ H*`, which gives the consistency of
`H`. A semisensible theory is contained in `H*` because a λ-theory is closed
under contexts.

## References

* A. Bucciarelli, A. Salibra, *Graph Lambda Theories*, Mathematical Structures
  in Computer Science 18 (2008), §2.1.
* H. P. Barendregt, *The Lambda Calculus: Its Syntax and Semantics*,
  chapters 4 and 16.
-/

namespace Mettapedia.GSLT.GraphTheory

namespace LambdaTheory

/-- A λ-theory is closed under contexts. -/
theorem equates_plug (T : LambdaTheory) (context : LambdaContext) {t t' : LambdaTerm}
    (h : T.equates t t') : T.equates (context.plug t) (context.plug t') := by
  induction context with
  | hole => exact h
  | lam _ ih => exact T.congLam ih
  | appLeft _ _ ih => exact T.congAppLeft ih
  | appRight _ _ ih => exact T.congAppRight ih

/-- A theory contained in a consistent theory is consistent. -/
theorem Consistent.of_le {T S : LambdaTheory} (hS : S.Consistent) (h : T ≤ S) : T.Consistent :=
  fun hT => hS (h hT)

end LambdaTheory

/-! ## The theory of observational equivalence for solvability -/

/-- Two terms are observationally equivalent when no context separates them
by solvability. -/
def ObservationallyEquivalent (t s : LambdaTerm) : Prop :=
  ∀ context : LambdaContext, (context.plug t).Solvable ↔ (context.plug s).Solvable

/-- The theory `H*` of observational equivalence for solvability. -/
def observationalTheory : LambdaTheory where
  equations := {equation | ObservationallyEquivalent equation.lhs equation.rhs}
  refl _ := fun _ => Iff.rfl
  symm h := fun context => (h context).symm
  trans h h' := fun context => (h context).trans (h' context)
  beta t s := fun context =>
    solvable_iff_of_parRedStar
      (Relation.ReflTransGen.single (context.parRed_plug (beta_to_parRed t s)))
  congLam h := fun context => by
    have key := h (context.comp (.lam .hole))
    rw [LambdaContext.plug_comp, LambdaContext.plug_comp] at key
    exact key
  congAppLeft {_ _ s} h := fun context => by
    have key := h (context.comp (.appLeft .hole s))
    rw [LambdaContext.plug_comp, LambdaContext.plug_comp] at key
    exact key
  congAppRight {t _ _} h := fun context => by
    have key := h (context.comp (.appRight t .hole))
    rw [LambdaContext.plug_comp, LambdaContext.plug_comp] at key
    exact key

theorem observationalTheory_equates_iff {t s : LambdaTerm} :
    observationalTheory.equates t s ↔ ObservationallyEquivalent t s := Iff.rfl

/-- `H*` equates all unsolvable terms: genericity through contexts. -/
theorem observationalTheory_equatesUnsolvables : observationalTheory.EquatesUnsolvables :=
  fun _ _ ht hs context => context.solvable_plug_iff_of_unsolvable ht hs

/-- `I I Ω` reduces to `Ω`. -/
theorem identity_applied_unsolvable :
    (LambdaTerm.app (.app LambdaTerm.I LambdaTerm.I) LambdaTerm.Omega).Unsolvable :=
  (unsolvable_iff_of_parRedStar
    (Relation.ReflTransGen.head
      (ParRed.app (ParRed.beta (ParRed.var 0) (ParRed.refl LambdaTerm.I))
        (ParRed.refl LambdaTerm.Omega))
      (Relation.ReflTransGen.single
        (ParRed.beta (ParRed.var 0) (ParRed.refl LambdaTerm.Omega))))).2 Omega_unsolvable

/-- `K I Ω` reduces to `I`. -/
theorem constant_applied_solvable :
    (LambdaTerm.app (.app LambdaTerm.K LambdaTerm.I) LambdaTerm.Omega).Solvable :=
  LambdaTerm.solvable_of_reduces
    (Relation.ReflTransGen.head
      (ParRed.app (ParRed.beta (ParRed.refl (.lam (.var 1))) (ParRed.refl LambdaTerm.I))
        (ParRed.refl LambdaTerm.Omega))
      (Relation.ReflTransGen.single
        (ParRed.beta (ParRed.refl LambdaTerm.I) (ParRed.refl LambdaTerm.Omega))))
    (LambdaTerm.solvable_of_isHNF (t := LambdaTerm.I) rfl)

/-- `H*` is consistent: the context `[·] I Ω` separates `I` from `K`. -/
theorem observationalTheory_consistent : observationalTheory.Consistent := fun h =>
  identity_applied_unsolvable
    ((h (.appLeft (.appLeft .hole LambdaTerm.I) LambdaTerm.Omega)).2 constant_applied_solvable)

/-- `H*` is sensible. -/
theorem observationalTheory_sensible : observationalTheory.Sensible :=
  ⟨observationalTheory_consistent, observationalTheory_equatesUnsolvables⟩

/-- **A theory is semisensible exactly when it is contained in `H*`.** -/
theorem semisensible_iff_le_observationalTheory {T : LambdaTheory} :
    T.Semisensible ↔ T ≤ observationalTheory := by
  constructor
  · rintro hT ⟨t, s⟩ hts context
    have hc : T.equates (context.plug t) (context.plug s) := T.equates_plug context hts
    constructor
    · intro ht
      by_contra hs
      exact hT _ _ hs (T.symm hc) ht
    · intro hs
      by_contra ht
      exact hT _ _ ht hc hs
  · intro hle t s ht hts hs
    exact ht ((hle hts .hole).2 hs)

/-- `H*` is semisensible. -/
theorem observationalTheory_semisensible : observationalTheory.Semisensible :=
  semisensible_iff_le_observationalTheory.2 fun _ h => h

/-- Every sensible theory is contained in `H*`. -/
theorem LambdaTheory.Sensible.le_observationalTheory {T : LambdaTheory} (h : T.Sensible) :
    T ≤ observationalTheory :=
  semisensible_iff_le_observationalTheory.1 (sensible_imp_semisensible h)

/-- `H*` is a maximal sensible theory: a sensible theory containing it has the
same equations. -/
theorem LambdaTheory.Sensible.equations_eq_of_observationalTheory_le {T : LambdaTheory}
    (h : T.Sensible) (hle : observationalTheory ≤ T) :
    T.equations = observationalTheory.equations :=
  Set.Subset.antisymm h.le_observationalTheory hle

/-! ## The theory generated by equating all unsolvable terms -/

/-- One step of the theory `H`: a parallel β-step, or the exchange of an
unsolvable subterm for another unsolvable term. -/
def UnsolvableStep (t s : LambdaTerm) : Prop :=
  (t ⇛ s) ∨ ∃ (context : LambdaContext) (u u' : LambdaTerm),
    u.Unsolvable ∧ u'.Unsolvable ∧ t = context.plug u ∧ s = context.plug u'

/-- Steps are compatible with contexts. -/
theorem UnsolvableStep.plug (context : LambdaContext) {t s : LambdaTerm}
    (h : UnsolvableStep t s) : UnsolvableStep (context.plug t) (context.plug s) := by
  rcases h with hred | ⟨inner, u, u', hu, hu', rfl, rfl⟩
  · exact Or.inl (context.parRed_plug hred)
  · exact Or.inr ⟨context.comp inner, u, u', hu, hu',
      (LambdaContext.plug_comp context inner u).symm,
      (LambdaContext.plug_comp context inner u').symm⟩

/-- The equivalence closure of the steps is compatible with contexts. -/
theorem eqvGen_unsolvableStep_plug (context : LambdaContext) {t s : LambdaTerm}
    (h : Relation.EqvGen UnsolvableStep t s) :
    Relation.EqvGen UnsolvableStep (context.plug t) (context.plug s) := by
  induction h with
  | rel _ _ step => exact .rel _ _ (step.plug context)
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ ih ih' => exact .trans _ _ _ ih ih'

/-- The theory `H` generated by equating all unsolvable terms. -/
def unsolvableTheory : LambdaTheory where
  equations := {equation | Relation.EqvGen UnsolvableStep equation.lhs equation.rhs}
  refl t := Relation.EqvGen.refl t
  symm h := Relation.EqvGen.symm _ _ h
  trans h h' := Relation.EqvGen.trans _ _ _ h h'
  beta t s := Relation.EqvGen.rel _ _ (Or.inl (beta_to_parRed t s))
  congLam h := eqvGen_unsolvableStep_plug (.lam .hole) h
  congAppLeft {_ _ s} h := eqvGen_unsolvableStep_plug (.appLeft .hole s) h
  congAppRight {t _ _} h := eqvGen_unsolvableStep_plug (.appRight t .hole) h

theorem unsolvableTheory_equates_iff {t s : LambdaTerm} :
    unsolvableTheory.equates t s ↔ Relation.EqvGen UnsolvableStep t s := Iff.rfl

/-- `H` equates all unsolvable terms. -/
theorem unsolvableTheory_equatesUnsolvables : unsolvableTheory.EquatesUnsolvables :=
  fun t s ht hs => Relation.EqvGen.rel _ _ (Or.inr ⟨.hole, t, s, ht, hs, rfl, rfl⟩)

/-- A theory equating all unsolvable terms equates whatever `H` equates. -/
theorem LambdaTheory.EquatesUnsolvables.equates_of_eqvGen {T : LambdaTheory}
    (hT : T.EquatesUnsolvables) {t s : LambdaTerm} (h : Relation.EqvGen UnsolvableStep t s) :
    T.equates t s := by
  induction h with
  | rel _ _ step =>
      rcases step with hred | ⟨context, u, u', hu, hu', rfl, rfl⟩
      · exact T.equates_of_parRed hred
      · exact T.equates_plug context (hT u u' hu hu')
  | refl => exact T.refl _
  | symm _ _ _ ih => exact T.symm ih
  | trans _ _ _ _ _ ih ih' => exact T.trans ih ih'

/-- **`H` is the least theory equating all unsolvable terms.** -/
theorem unsolvableTheory_le_iff {T : LambdaTheory} :
    unsolvableTheory ≤ T ↔ T.EquatesUnsolvables :=
  ⟨fun hle t s ht hs => hle (unsolvableTheory_equatesUnsolvables t s ht hs),
    fun hT _ h => hT.equates_of_eqvGen h⟩

/-- `H` is contained in `H*`. -/
theorem unsolvableTheory_le_observationalTheory : unsolvableTheory ≤ observationalTheory :=
  unsolvableTheory_le_iff.2 observationalTheory_equatesUnsolvables

/-- **`H` is consistent.** -/
theorem unsolvableTheory_consistent : unsolvableTheory.Consistent :=
  observationalTheory_consistent.of_le unsolvableTheory_le_observationalTheory

/-- `H` is sensible. -/
theorem unsolvableTheory_sensible : unsolvableTheory.Sensible :=
  ⟨unsolvableTheory_consistent, unsolvableTheory_equatesUnsolvables⟩

/-- `H` is semisensible. -/
theorem unsolvableTheory_semisensible : unsolvableTheory.Semisensible :=
  sensible_imp_semisensible unsolvableTheory_sensible

/-- **A theory is sensible exactly when it is consistent and contains `H`**,
the definition of Bucciarelli–Salibra, §2.1. -/
theorem LambdaTheory.sensible_iff_consistent_and_unsolvableTheory_le {T : LambdaTheory} :
    T.Sensible ↔ T.Consistent ∧ unsolvableTheory ≤ T :=
  and_congr_right fun _ => unsolvableTheory_le_iff.symm

/-- Every sensible theory contains `H`. -/
theorem LambdaTheory.Sensible.unsolvableTheory_le {T : LambdaTheory} (h : T.Sensible) :
    unsolvableTheory ≤ T :=
  unsolvableTheory_le_iff.2 h.equates_unsolvables

/-- **`H*` is the greatest consistent theory containing `H`.** -/
theorem le_observationalTheory_of_consistent_of_unsolvableTheory_le {T : LambdaTheory}
    (hConsistent : T.Consistent) (hle : unsolvableTheory ≤ T) : T ≤ observationalTheory :=
  LambdaTheory.Sensible.le_observationalTheory
    (LambdaTheory.sensible_iff_consistent_and_unsolvableTheory_le.2 ⟨hConsistent, hle⟩)

/-! ## Graph theories -/

/-- The theory of a graph model is consistent, so it is sensible exactly when
it contains `H`, that is, when the model equates all unsolvable terms. -/
theorem graphTheory_sensible_iff (D : Mettapedia.GSLT.Core.GraphModel) :
    (lambdaTheoryOf D).Sensible ↔ unsolvableTheory ≤ lambdaTheoryOf D :=
  LambdaTheory.sensible_iff_consistent_and_unsolvableTheory_le.trans
    (and_iff_right (lambdaTheoryOf_consistent D))

/-- A sensible graph theory lies between `H` and `H*`. -/
theorem graphTheory_between_of_sensible (D : Mettapedia.GSLT.Core.GraphModel)
    (h : (lambdaTheoryOf D).Sensible) :
    unsolvableTheory ≤ lambdaTheoryOf D ∧ lambdaTheoryOf D ≤ observationalTheory :=
  ⟨h.unsolvableTheory_le, h.le_observationalTheory⟩

end Mettapedia.GSLT.GraphTheory
