import Mettapedia.GSLT.GraphTheory.SensibleTheories
import Mettapedia.GSLT.GraphTheory.SolvabilityControls

/-! Positive and negative controls for genericity and for the least and the
greatest sensible theory. -/

namespace Mettapedia.GSLT.GraphTheory.SensibleTheoriesControls

open Mettapedia.GSLT.GraphTheory
open Mettapedia.GSLT.GraphTheory.SolvabilityControls

/-! ### Genericity -/

/-- `K I M` is solvable for every `M`, by genericity from `K I Ω`. -/
theorem constant_applied_any_solvable (M : LambdaTerm) :
    (LambdaTerm.app (.app LambdaTerm.K LambdaTerm.I) M).Solvable :=
  LambdaContext.solvable_plug_of_unsolvable
    (.appRight (.app LambdaTerm.K LambdaTerm.I) .hole) Omega_unsolvable
    constant_applied_solvable M

/-- The replaced subterm must be unsolvable: `x ω` is solvable, and replacing
the solvable `x` by `ω` gives `Ω`. -/
theorem replacing_solvable_can_destroy_solvability :
    ((LambdaContext.appLeft .hole LambdaTerm.omega).plug (.var 0)).Solvable ∧
      ((LambdaContext.appLeft .hole LambdaTerm.omega).plug LambdaTerm.omega).Unsolvable :=
  ⟨LambdaTerm.solvable_of_isHNF rfl, Omega_unsolvable⟩

/-- Genericity has no converse: filling `Ω` with `I` creates solvability. -/
theorem filling_can_create_solvability :
    UnsolvableFilling LambdaTerm.Omega LambdaTerm.I ∧
      LambdaTerm.Omega.Unsolvable ∧ LambdaTerm.I.Solvable :=
  ⟨.fill _ Omega_unsolvable, Omega_unsolvable, I_solvable⟩

/-! ### The theory generated by the unsolvable terms -/

/-- `H` contains β-conversion. -/
theorem betaTheory_le_unsolvableTheory : betaTheory ≤ unsolvableTheory :=
  fun _ h => Relation.EqvGen.mono (fun _ _ step => Or.inl step) _ _ h

/-- `H` is strictly larger than β-conversion: it equates `Ω` with `λx. Ω`. -/
theorem unsolvableTheory_not_le_betaTheory : ¬unsolvableTheory ≤ betaTheory := fun hle =>
  Omega_not_betaConv_lam_Omega
    (hle (unsolvableTheory_equatesUnsolvables _ _ Omega_unsolvable lam_Omega_unsolvable))

/-- A sensible theory exists, so `sensible_imp_semisensible` is not vacuous. -/
theorem exists_sensible : ∃ T : LambdaTheory, T.Sensible ∧ T.Semisensible :=
  ⟨unsolvableTheory, unsolvableTheory_sensible, unsolvableTheory_semisensible⟩

/-- `H` does not equate `I` with `K`, nor `I` with `Ω`. -/
theorem unsolvableTheory_separates :
    ¬unsolvableTheory.equates LambdaTerm.I LambdaTerm.K ∧
      ¬unsolvableTheory.equates LambdaTerm.Omega LambdaTerm.I :=
  ⟨unsolvableTheory_consistent,
    fun h => unsolvableTheory_semisensible _ _ Omega_unsolvable h I_solvable⟩

/-! ### The theory of observational equivalence -/

/-- β-conversion is semisensible, hence contained in `H*`. -/
theorem betaTheory_le_observationalTheory : betaTheory ≤ observationalTheory :=
  semisensible_iff_le_observationalTheory.1 betaTheory_semisensible

/-- The total theory is not contained in `H*`. -/
theorem totalTheory_not_le_observationalTheory : ¬totalTheory ≤ observationalTheory :=
  fun hle => totalTheory_not_semisensible (semisensible_iff_le_observationalTheory.2 hle)

/-- `H*` separates a solvable term from an unsolvable one already by the
empty context. -/
theorem observationalTheory_separates_I_Omega :
    ¬observationalTheory.equates LambdaTerm.I LambdaTerm.Omega :=
  fun h => Omega_unsolvable ((h .hole).1 I_solvable)

end Mettapedia.GSLT.GraphTheory.SensibleTheoriesControls
