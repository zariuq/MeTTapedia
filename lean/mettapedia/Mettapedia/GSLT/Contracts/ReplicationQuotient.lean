import Mettapedia.GSLT.Contracts.FixedReplication
import Mathlib.Data.Finsupp.Multiset
import Mathlib.GroupTheory.QuotientGroup.Defs
import Mathlib.Tactic.Abel

/-!
# The integer quotient of a fixed replication bank

The ambient group is the free integer inventory of atoms. For a fixed
bank, its equivalence identifies two ordinary inventories exactly when
their difference lies in the subgroup generated by the bodies. This
describes the key independently of a basis or normal-form algorithm.
The bank remains part of the state, and may not be discarded.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Contracts.FixedReplication

noncomputable section

variable {Atom : Type*} [DecidableEq Atom]

def counts : Multiset Atom →+ (Atom →₀ ℤ) where
  toFun rows := rows.toFinsupp.mapRange (fun n : Nat => (n : ℤ)) Nat.cast_zero
  map_zero' := by ext; simp
  map_add' _ _ := by ext; simp

theorem counts_injective : Function.Injective (counts (Atom := Atom)) := by
  intro a b same
  apply Multiset.ext.mpr
  intro atom
  exact Int.ofNat_inj.mp (DFunLike.congr_fun same atom)

def bodyLattice (bank : Bank Atom) : AddSubgroup (Atom →₀ ℤ) :=
  AddSubgroup.closure (counts '' {body | body ∈ bank})

omit [DecidableEq Atom] in
private theorem allowed_add {bank : Bank Atom} {first second : Multiset (Multiset Atom)}
    (hf : Available bank first) (hs : Available bank second) : Available bank (first + second) :=
  fun body member => (Multiset.mem_add.mp member).elim (hf body) (hs body)

private def witnessed (bank : Bank Atom) : AddSubgroup (Atom →₀ ℤ) where
  carrier := {v | ∃ l r : Multiset (Multiset Atom), Available bank l ∧ Available bank r ∧
    v = counts l.sum - counts r.sum}
  zero_mem' := ⟨0, 0, by simp [Available], by simp [Available], by simp⟩
  add_mem' := by
    rintro a b ⟨l, r, hl, hr, h⟩ ⟨l', r', hl', hr', h'⟩
    refine ⟨l + l', r + r', allowed_add hl hl', allowed_add hr hr', ?_⟩
    rw [h, h', Multiset.sum_add, Multiset.sum_add, map_add, map_add]
    abel
  neg_mem' := by
    rintro a ⟨l, r, hl, hr, h⟩
    exact ⟨r, l, hr, hl, by rw [h, neg_sub]⟩

private theorem total_mem_lattice (bank : Bank Atom) (copies : Multiset (Multiset Atom))
    (held : Available bank copies) : counts copies.sum ∈ bodyLattice bank := by
  induction copies using Multiset.induction_on with
  | empty => simp
  | cons body rest ih =>
      rw [Multiset.sum_cons, map_add]
      exact (bodyLattice bank).add_mem
        (AddSubgroup.subset_closure ⟨body, held body (Multiset.mem_cons_self _ _), rfl⟩)
        (ih fun p member => held p (Multiset.mem_cons_of_mem member))

theorem mem_lattice_iff (bank : Bank Atom) (v : Atom →₀ ℤ) :
    v ∈ bodyLattice bank ↔
      ∃ l r : Multiset (Multiset Atom), Available bank l ∧ Available bank r ∧
        v = counts l.sum - counts r.sum := by
  constructor
  · have included : bodyLattice bank ≤ witnessed bank := (AddSubgroup.closure_le _).2 (by
      rintro _ ⟨body, member, rfl⟩
      exact ⟨{body}, 0, by simpa [Available] using member, by simp [Available], by simp⟩)
    exact fun member => included member
  · rintro ⟨l, r, hl, hr, rfl⟩
    exact (bodyLattice bank).sub_mem (total_mem_lattice bank l hl) (total_mem_lattice bank r hr)

/-- The signed difference is an exact test, not merely an invariant. -/
theorem equiv_iff_lattice (bank : Bank Atom) {a b : Multiset Atom} :
    Equiv bank a b ↔ counts b - counts a ∈ bodyLattice bank := by
  rw [equiv_iff_common, mem_lattice_iff]
  constructor
  · rintro ⟨l, r, hl, hr, same⟩
    refine ⟨l, r, hl, hr, sub_eq_sub_iff_add_eq_add.mpr ?_⟩
    have equal := congrArg counts same.symm
    simpa [map_add, add_comm (counts l.sum) (counts a)] using equal
  · rintro ⟨l, r, hl, hr, same⟩
    refine ⟨l, r, hl, hr, counts_injective ?_⟩
    have equal := (sub_eq_sub_iff_add_eq_add.mp same).symm
    simpa [map_add, add_comm (counts l.sum) (counts a)] using equal

def residue (bank : Bank Atom) (rows : Multiset Atom) : (Atom →₀ ℤ) ⧸ bodyLattice bank :=
  QuotientAddGroup.mk (counts rows)

theorem residue_eq_iff (bank : Bank Atom) {a b : Multiset Atom} :
    residue bank a = residue bank b ↔ Equiv bank a b :=
  ⟨fun same => (equiv_iff_lattice bank).mpr (QuotientAddGroup.eq_iff_sub_mem.mp same.symm),
   fun same => (QuotientAddGroup.eq_iff_sub_mem.mpr ((equiv_iff_lattice bank).mp same)).symm⟩

namespace Controls

private def overlapping : Bank Nat := {{0, 1}, {1, 2}}

/-- Two distinct inventories can both be irreducible by greedy folding
and still represent the same state. Choosing an order in which to take
available folds does not by itself solve canonicalization. -/
theorem greedily_irreducible_does_not_mean_canonical :
    residue overlapping {0} = residue overlapping {2} ∧
      ({0} : Multiset Nat) ≠ {2} ∧
      ∀ body ∈ overlapping, ¬ body ≤ {0} ∧ ¬ body ≤ {2} := by
  refine ⟨(residue_eq_iff _).mpr ((equiv_iff_common _).mpr
    ⟨{{1, 2}}, {{0, 1}}, by simp [Available, overlapping], by simp [Available, overlapping],
      by decide⟩), by decide, by decide⟩

end Controls

#print axioms mem_lattice_iff
#print axioms equiv_iff_lattice
#print axioms residue_eq_iff
#print axioms Controls.greedily_irreducible_does_not_mean_canonical

end

end Mettapedia.GSLT.Contracts.FixedReplication
