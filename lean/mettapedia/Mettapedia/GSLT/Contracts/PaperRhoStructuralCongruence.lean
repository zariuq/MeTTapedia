#print axioms output_sugar
#print axioms procEq_refutes_output_sugar
#print axioms procEq_strictly_finer
#print axioms Reduces.reduction
#print axioms Reduction.preserves_closed_scope
#print axioms StructuralControls.output_not_input
#print axioms output_sugar_reduces
#print axioms StructuralControls.quoted_code_congruent
#print axioms StructuralControls.another_component_prevents_hit
