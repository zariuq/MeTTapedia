import Mettapedia.GSLT.Contracts.PaperRhoBinder

/-!
# Structural congruence as the rho paper uses it

Meredith and Radestock define structural congruence as the least congruence
containing alpha-equivalence and the parallel monoid laws, with name equivalence
`≡N` generated by quote-drop and by structural congruence under a quote. Their
alpha-equivalence is built from a substitution that replaces every name
`≡N`-equivalent to the bound one, and the output sugar on p. 58 is justified by
`P{⌜*z⌝/y} ≡ P{z/y}` "using the comm rule and name equivalence". Lybech's
presentation states the same reading as a rule: an input is congruent to an input
whose subject is name-equivalent and whose continuation is congruent.

This file gives that reading over the independent syntax of `PaperRho`:
`Congruence` compares the names in subject and drop positions by
`NameEquivalence`, and the two relations are mutually inductive. The relations
`ProcEq` and `NameEq` of `PaperRho` never compare names inside a process; they
are strictly finer, and they refute the displayed equation of p. 58
(`procEq_refutes_output_sugar`).

The whole-name binder test is the same in both readings
(`nameEquivalence_bound_iff_nameEq`), so semantic substitution and the
communication premise against a binder do not depend on the choice.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Contracts.PaperRho

mutual
  /-- Structural congruence: the parallel monoid laws, closed under every
  constructor, with names compared by name equivalence. -/
  inductive Congruence : Process → Process → Prop
    | refl (p : Process) : Congruence p p
    | symm {p q : Process} : Congruence p q → Congruence q p
    | trans {p q r : Process} : Congruence p q → Congruence q r → Congruence p r
    | unit (p : Process) : Congruence (.par p .zero) p
    | swap (p q : Process) : Congruence (.par p q) (.par q p)
    | assoc (p q r : Process) : Congruence (.par (.par p q) r) (.par p (.par q r))
    | par {p p' q q' : Process} :
        Congruence p p' → Congruence q q' → Congruence (.par p q) (.par p' q')
    | send {x y : Name} {p q : Process} :
        NameEquivalence x y → Congruence p q → Congruence (.send x p) (.send y q)
    | receive {x y : Name} {p q : Process} :
        NameEquivalence x y → Congruence p q → Congruence (.receive x p) (.receive y q)
    | drop {x y : Name} : NameEquivalence x y → Congruence (.drop x) (.drop y)

  /-- Name equivalence: quote-drop, and congruent code under a quote. -/
  inductive NameEquivalence : Name → Name → Prop
    | refl (x : Name) : NameEquivalence x x
    | symm {x y : Name} : NameEquivalence x y → NameEquivalence y x
    | trans {x y z : Name} : NameEquivalence x y → NameEquivalence y z → NameEquivalence x z
    | quote_drop (x : Name) : NameEquivalence (.quote (.drop x)) x
    | quote {p q : Process} : Congruence p q → NameEquivalence (.quote p) (.quote q)
end

/-! ## The finer relations are contained -/

theorem ProcEq.congruence {p q : Process} (equal : ProcEq p q) : Congruence p q := by
  induction equal with
  | refl p => exact .refl p
  | symm _ ih => exact .symm ih
  | trans _ _ first second => exact .trans first second
  | unit p => exact .unit p
  | swap p q => exact .swap p q
  | assoc p q r => exact .assoc p q r
  | par _ _ first second => exact .par first second
  | send name _ ih => exact .send (.refl name) ih
  | receive name _ ih => exact .receive (.refl name) ih

theorem NameEq.nameEquivalence {x y : Name} (equal : NameEq x y) : NameEquivalence x y := by
  induction equal with
  | refl x => exact .refl x
  | symm _ ih => exact .symm ih
  | trans _ _ first second => exact .trans first second
  | quote_drop x => exact .quote_drop x
  | quote processes => exact .quote processes.congruence

/-! ## The binder test does not depend on the reading -/

private theorem combine_comm (a b : BinderView) : a.combine b = b.combine a := by
  cases a <;> cases b <;> rfl

private theorem combine_assoc (a b c : BinderView) :
    (a.combine b).combine c = a.combine (b.combine c) := by
  cases a <;> cases b <;> cases c <;> rfl

mutual
  theorem Congruence.binderView_eq {p q : Process} :
      Congruence p q → binderView p = binderView q
    | .refl _ => rfl
    | .symm same => (Congruence.binderView_eq same).symm
    | .trans first second =>
        (Congruence.binderView_eq first).trans (Congruence.binderView_eq second)
    | .unit p => by cases view : binderView p <;> simp [binderView, view, BinderView.combine]
    | .swap _ _ => combine_comm _ _
    | .assoc _ _ _ => combine_assoc _ _ _
    | .par first second => by
        simp only [binderView, Congruence.binderView_eq first, Congruence.binderView_eq second]
    | .send _ _ => rfl
    | .receive _ _ => rfl
    | .drop names => by simp only [binderView, NameEquivalence.binderIndex_eq names]

  theorem NameEquivalence.binderIndex_eq {x y : Name} :
      NameEquivalence x y → binderIndex x = binderIndex y
    | .refl _ => rfl
    | .symm same => (NameEquivalence.binderIndex_eq same).symm
    | .trans first second =>
        (NameEquivalence.binderIndex_eq first).trans (NameEquivalence.binderIndex_eq second)
    | .quote_drop _ => rfl
    | .quote code => by simp only [binderIndex, Congruence.binderView_eq code]
end

theorem nameEquivalence_bound_iff (n : Name) (index : Nat) :
    NameEquivalence n (.bound index) ↔ binderIndex n = some index :=
  ⟨fun same => same.binderIndex_eq,
    fun hit => ((nameEq_bound_iff n index).mpr hit).nameEquivalence⟩

/-- Asking whether a name denotes a binder slot gives the same answer in both
readings, so `Subst`, `substitute` and their whole-name tests are shared. -/
theorem nameEquivalence_bound_iff_nameEq (n : Name) (index : Nat) :
    NameEquivalence n (.bound index) ↔ NameEq n (.bound index) :=
  (nameEquivalence_bound_iff n index).trans (nameEq_bound_iff n index).symm

/-! ## Scope is invariant under the paper's congruence -/

private theorem scope_par {depth : Nat} {p q : Process} :
    ScopedProcess depth (.par p q) ↔ ScopedProcess depth p ∧ ScopedProcess depth q :=
  ⟨fun hay => by cases hay with | par left right => exact ⟨left, right⟩,
    fun both => .par both.1 both.2⟩

private theorem scope_send {depth : Nat} {subject : Name} {p : Process} :
    ScopedProcess depth (.send subject p) ↔ ScopedName depth subject ∧ ScopedProcess depth p :=
  ⟨fun hay => by cases hay with | send head tail => exact ⟨head, tail⟩,
    fun both => .send both.1 both.2⟩

private theorem scope_receive {depth : Nat} {subject : Name} {p : Process} :
    ScopedProcess depth (.receive subject p) ↔
      ScopedName depth subject ∧ ScopedProcess (depth + 1) p :=
  ⟨fun hay => by cases hay with | receive head tail => exact ⟨head, tail⟩,
    fun both => .receive both.1 both.2⟩

private theorem scope_drop {depth : Nat} {name : Name} :
    ScopedProcess depth (.drop name) ↔ ScopedName depth name :=
  ⟨fun hay => by cases hay with | drop held => exact held, .drop⟩

/-- A name that denotes a binder slot below `depth` is admitted at `depth`,
whichever spelling it has. -/
private theorem scopedName_of_binderIndex {depth index : Nat} (name : Name)
    (hit : binderIndex name = some index) (below : index < depth) : ScopedName depth name := by
  cases name with
  | bound slot =>
      have same : slot = index := Option.some.inj hit
      exact .bound (same ▸ below)
  | quote code => exact .binderAlias below ((nameEq_bound_iff _ _).mpr hit)

private theorem scopedName_quote_drop_iff {depth : Nat} (z : Name) :
    ScopedName depth (.quote (.drop z)) ↔ ScopedName depth z := by
  constructor
  · intro admitted
    cases admitted with
    | literal held =>
        cases held with
        | drop inner => exact inner.weaken (Nat.zero_le _)
    | binderAlias below agrees =>
        rename_i index
        have hit : binderIndex z = some index := (nameEq_bound_iff (.quote (.drop z)) index).mp agrees
        exact scopedName_of_binderIndex z hit below
  · intro admitted
    cases admitted with
    | bound below => exact .binderAlias below (.quote_drop _)
    | literal held => exact .literal (.drop (.literal held))
    | binderAlias below agrees => exact .binderAlias below (.trans (.quote_drop _) agrees)

private theorem scopedName_quote_of {depth : Nat} {code code' : Process}
    (closed : ScopedProcess 0 code → ScopedProcess 0 code')
    (views : binderView code = binderView code') :
    ScopedName depth (.quote code) → ScopedName depth (.quote code') := by
  intro admitted
  cases admitted with
  | literal held => exact .literal (closed held)
  | binderAlias below agrees =>
      have hit := (nameEq_bound_iff _ _).mp agrees
      simp only [binderIndex, views] at hit
      exact .binderAlias below ((nameEq_bound_iff _ _).mpr (by simpa only [binderIndex] using hit))

mutual
  theorem Congruence.scoped_iff {p q : Process} :
      Congruence p q → ∀ depth, ScopedProcess depth p ↔ ScopedProcess depth q
    | .refl _ => fun _ => Iff.rfl
    | .symm same => fun depth => (Congruence.scoped_iff same depth).symm
    | .trans first second => fun depth =>
        (Congruence.scoped_iff first depth).trans (Congruence.scoped_iff second depth)
    | .unit _ => fun depth => by simp [scope_par, show ScopedProcess depth .zero from .zero]
    | .swap _ _ => fun _ => by simp [scope_par, and_comm]
    | .assoc _ _ _ => fun _ => by simp [scope_par, and_assoc]
    | .par first second => fun depth => by
        simp only [scope_par, Congruence.scoped_iff first depth, Congruence.scoped_iff second depth]
    | .send names code => fun depth => by
        simp only [scope_send, NameEquivalence.scoped_iff names depth,
          Congruence.scoped_iff code depth]
    | .receive names code => fun depth => by
        simp only [scope_receive, NameEquivalence.scoped_iff names depth,
          Congruence.scoped_iff code (depth + 1)]
    | .drop names => fun depth => by
        simp only [scope_drop, NameEquivalence.scoped_iff names depth]

  theorem NameEquivalence.scoped_iff {x y : Name} :
      NameEquivalence x y → ∀ depth, ScopedName depth x ↔ ScopedName depth y
    | .refl _ => fun _ => Iff.rfl
    | .symm same => fun depth => (NameEquivalence.scoped_iff same depth).symm
    | .trans first second => fun depth =>
        (NameEquivalence.scoped_iff first depth).trans (NameEquivalence.scoped_iff second depth)
    | .quote_drop z => fun _ => scopedName_quote_drop_iff z
    | .quote code => fun _ =>
        ⟨scopedName_quote_of (Congruence.scoped_iff code 0).mp code.binderView_eq,
          scopedName_quote_of (Congruence.scoped_iff code 0).mpr code.binderView_eq.symm⟩
end

/-! ## The output sugar of p. 58 -/

/-- The paper's substitution of a name for the selected binder: a matching
subject becomes `z` and a matching drop becomes `*z`. The comparison is over
whole names and does not open quoted code. -/
def rename (z : Name) (depth : Nat) (body : Process) : Process :=
  match body with
  | .zero => .zero
  | .par a b => .par (rename z depth a) (rename z depth b)
  | .send n tail => .send (if binderIndex n = some depth then z else n) (rename z depth tail)
  | .receive n tail =>
      .receive (if binderIndex n = some depth then z else n) (rename z (depth + 1) tail)
  | .drop n => .drop (if binderIndex n = some depth then z else n)
termination_by structural body

private theorem bindName_drop_equivalent (z : Name) (depth : Nat) (n : Name) :
    NameEquivalence (bindName (.drop z) depth n) (if binderIndex n = some depth then z else n) := by
  unfold bindName
  split
  · exact .quote_drop z
  · exact .refl n

/-- Receiving the code `*z` is congruent to receiving the name `z`:
`P{⌜*z⌝/y} ≡ P{z/y}` for every body. -/
theorem output_sugar (z : Name) (depth : Nat) (body : Process) :
    Congruence (substitute (.drop z) depth body) (rename z depth body) := by
  cases body with
  | zero => simpa [substitute, rename] using Congruence.refl Process.zero
  | par a b =>
      simpa only [substitute, rename] using (output_sugar z depth a).par (output_sugar z depth b)
  | send n tail =>
      simpa only [substitute, rename] using
        Congruence.send (bindName_drop_equivalent z depth n) (output_sugar z depth tail)
  | receive n tail =>
      simpa only [substitute, rename] using
        Congruence.receive (bindName_drop_equivalent z depth n) (output_sugar z (depth + 1) tail)
  | drop n =>
      simp only [substitute, rename]
      split
      · exact .refl _
      · exact .refl _
termination_by structural body

/-- The finer relation refutes the same equation on the one-output body. -/
theorem procEq_refutes_output_sugar :
    ¬ ProcEq (substitute (.drop Separation.base) 0 (.send (.bound 0) .zero))
      (rename Separation.base 0 (.send (.bound 0) .zero)) := by
  have result : substitute (.drop Separation.base) 0 (.send (.bound 0) .zero) =
      .send Separation.wrapped .zero := by
    simp [substitute, bindName, binderIndex, Separation.wrapped]
  have renamed : rename Separation.base 0 (.send (.bound 0) .zero) =
      .send Separation.base .zero := by
    simp [rename, binderIndex]
  rw [result, renamed]
  exact Separation.alias_separation.2.1

/-- `ProcEq` is strictly finer than the paper's structural congruence. -/
theorem procEq_strictly_finer :
    (∀ {p q : Process}, ProcEq p q → Congruence p q) ∧
      ∃ p q : Process, Congruence p q ∧ ¬ ProcEq p q :=
  ⟨ProcEq.congruence, _, _, output_sugar _ 0 _, procEq_refutes_output_sugar⟩

/-! ## Reduction under the paper's congruence -/

/-- The paper's reduction: COMM with its name-equivalence premise, PAR, and
EQUIV over `Congruence`. Semantic substitution is `Subst`, whose binder test is
reading-independent. -/
inductive Reduction : Process → Process → Prop
  | comm {offered waiting : Name} {payload body target : Process} :
      ScopedName 0 offered → ScopedName 0 waiting →
      ScopedProcess 0 payload → ScopedProcess 1 body →
      NameEquivalence offered waiting → Subst payload 0 body target →
      Reduction (.par (.send offered payload) (.receive waiting body)) target
  | par {p q : Process} (frame : Process) : Reduction p q → Reduction (.par p frame) (.par q frame)
  | equiv {p p' q q' : Process} :
      Congruence p p' → Reduction p' q' → Congruence q' q → Reduction p q

theorem Reduces.reduction {p q : Process} (step : Reduces p q) : Reduction p q := by
  induction step with
  | comm offered waiting payload body agree substitution =>
      exact .comm offered waiting payload body agree.nameEquivalence substitution
  | par frame _ ih => exact .par frame ih
  | equiv before _ after ih => exact .equiv before.congruence ih after.congruence

theorem Reduction.preserves_closed_scope {source target : Process} (step : Reduction source target)
    (closed : ScopedProcess 0 source) : ScopedProcess 0 target := by
  induction step with
  | comm _ _ payload body _ substitution => exact substitution.lowers_scope body payload
  | par frame _ ih =>
      obtain ⟨left, right⟩ := scope_par.mp closed
      exact .par (ih left) right
  | equiv before _ after ih =>
      exact (after.scoped_iff 0).mp (ih ((before.scoped_iff 0).mp closed))

/-- The p. 58 derivation: `x[z] | x(y).P → P{⌜*z⌝/y} ≡ P{z/y}`. -/
theorem output_sugar_reduces {channel z : Name} {body : Process}
    (channelScoped : ScopedName 0 channel) (zScoped : ScopedName 0 z)
    (bodyScoped : ScopedProcess 1 body) :
    Reduction (.par (.send channel (.drop z)) (.receive channel body)) (rename z 0 body) :=
  .equiv (.refl _)
    (.comm channelScoped channelScoped (.drop zScoped) bodyScoped (.refl _)
      (substitute_fits (.drop z) 0 body))
    (output_sugar z 0 body)

namespace StructuralControls

open Separation (base wrapped)

/-- Positive: a wrapped subject and its unwrapped name are congruent outputs. -/
theorem wrapped_output_congruent : Congruence (.send wrapped .zero) (.send base .zero) :=
  .send (.quote_drop base) (.refl _)

/-- Positive: the congruence reaches names inside quoted code. -/
theorem quoted_code_congruent :
    NameEquivalence (.quote (.send wrapped .zero)) (.quote (.send base .zero)) :=
  .quote wrapped_output_congruent

/-- Negative: a second parallel component still prevents a binder hit. -/
theorem another_component_prevents_hit :
    ¬ NameEquivalence (.quote (.par (.drop (.bound 0)) (.drop (.bound 0)))) (.bound 0) := by
  rw [nameEquivalence_bound_iff]
  decide

private def outputs : Process → Nat
  | .zero => 0
  | .par a b => outputs a + outputs b
  | .send .. => 1
  | .receive .. | .drop .. => 0

private theorem outputs_eq {p q : Process} (same : Congruence p q) : outputs p = outputs q :=
  Congruence.rec (motive_1 := fun p q _ => outputs p = outputs q) (motive_2 := fun _ _ _ => True)
    (fun _ => rfl) (fun _ ih => ih.symm) (fun _ _ first second => first.trans second)
    (fun _ => by simp [outputs]) (fun _ _ => by simp [outputs, Nat.add_comm])
    (fun _ _ _ => by simp [outputs, Nat.add_assoc])
    (fun _ _ first second => by simp [outputs, first, second])
    (fun _ _ _ _ => rfl) (fun _ _ _ _ => rfl) (fun _ _ => rfl)
    (fun _ => trivial) (fun _ _ => trivial) (fun _ _ _ _ => trivial) (fun _ => trivial)
    (fun _ _ => trivial) same

/-- **Forwarding a payload as a literal subject respects the paper's ≡.**
A receiver that sends on the quotation of what it received yields congruent
outputs for congruent payloads, so the forwarder acts on congruence classes.
The separation `PaperRho.forwarding_observes_payload_representative` holds only
for the finer reading without congruence at name positions. -/
theorem literal_forwarder_descends {p q : Process} (same : Congruence p q) :
    Congruence (.send (.quote p) .zero) (.send (.quote q) .zero) :=
  .send (.quote same) (.refl _)

/-- The instance that separates the finer reading: `*@0` and `*@0 | 0`,
forwarded as literal subjects, are congruent outputs. -/
theorem forwarded_unit_congruent :
    Congruence (.send (.quote (.drop base)) .zero) (.send (.quote (.par (.drop base) .zero)) .zero) :=
  literal_forwarder_descends (.symm (.unit _))

/-- Negative: an output and an input are never congruent, whatever their names. -/
theorem output_not_input (x y : Name) (p q : Process) :
    ¬ Congruence (.send x p) (.receive y q) := by
  intro same
  have counted := outputs_eq same
  simp [outputs] at counted

end StructuralControls

