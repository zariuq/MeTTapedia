import Mettapedia.CognitiveArchitecture.ForegroundChainingPremiseService
import Mettapedia.CognitiveArchitecture.CognitiveSchematicAttentionEconomy
import Mettapedia.GSLT.Core.AgePrioritySchedule

/-!
# Scheduled and attention-funded background premise selection

The worked background premise service is strengthened with two independent
operational witnesses:

1. an age-protected priority portfolio eventually selects the exact service
   occurrence;
2. an ECAN request settles only after the exact foreground proof completion,
   conserving its selected attention instrument.

Scheduling, attention payment, store admission, and proof success remain
different objects.  The attention transfer is not an engine cost meter, and a
scheduled funded but unavailable service still has no fulfillment.
-/

set_option autoImplicit false

namespace Mettapedia.CognitiveArchitecture.FundedScheduledPremiseService

noncomputable section

open Mettapedia.CognitiveArchitecture.AttentionEconomy
open Mettapedia.CognitiveArchitecture.CognitiveSchematic
open Mettapedia.CognitiveArchitecture.CognitiveSchematicAttentionEconomy
open Mettapedia.CognitiveArchitecture.ForegroundChainingPremiseService
open Mettapedia.GSLT.Core.AgePrioritySchedule
open Mettapedia.GSLT.Core.BranchingTemporal
open Mettapedia.GSLT.Core.WeightedOccurrenceControl

/-! ## A proof-relevant request for the actual chaining service -/

abbrev Currency := ℤ

/-- The request applies only at the exact saturated foreground state. -/
def premiseSchematic : Schematic ForegroundState ForegroundState where
  context source := PLift (source = stalledSnapshot)
  procedure source target :=
    PLift (target =
      Mettapedia.GSLT.Core.GivenClauseLoop.Snapshot.run
        chainingSystem
        Mettapedia.GSLT.Core.GivenClauseLoop.Snapshot.breadthOnly 2
        (admitAuthorized source (authorizedSelectionAt 0)))
  goal target :=
    PLift (target.events =
      [⟨goalFrom (selectedOccurrenceAt 0), ProofResult.proved⟩])

def premiseMayAchieve : premiseSchematic.MayAchieve := by
  intro source contextWitness
  have sourceIsStalled : source = stalledSnapshot := contextWitness.down
  subst source
  exact ⟨solvedSnapshot, ⟨⟨rfl⟩, ⟨rfl⟩⟩⟩

/-- The foreground chainer promises two STI units to the background selector.
This promise neither triggers nor executes the service. -/
def premiseRequest :
    ServiceRequest Nat MindAgent .shortTerm Currency
      ForegroundState ForegroundState where
  payment :=
    { occurrence := 0
      issuer := .foregroundChainer
      beneficiary := .premiseSelector
      amount := 2 }
  schematic := premiseSchematic

def attentionFund : Fund .shortTerm MindAgent Currency where
  balances := Finsupp.single .foregroundChainer 10

def premiseFulfillment : premiseRequest.Fulfillment :=
  ServiceRequest.fulfillmentOfMay premiseRequest premiseMayAchieve
    (source := stalledSnapshot) ⟨rfl⟩

def premiseRedemption : premiseRequest.payment.Redemption attentionFund where
  actor := .premiseSelector
  authorized := rfl
  admission := by
    constructor <;>
      simp [attentionFund, premiseRequest, RequestForService.asTransfer]

def premiseSettlement : premiseRequest.Settlement attentionFund where
  fulfillment := premiseFulfillment
  redemption := premiseRedemption

/-- Settling the exact successful service conserves STI currency. -/
theorem settlement_conserves_attention :
    Fund.total premiseSettlement.after = Fund.total attentionFund :=
  premiseSettlement.total_after

/-- Payment retains rather than replaces the exact foreground goal witness. -/
theorem settlement_retains_goal_receipt :
    Nonempty
      (premiseRequest.schematic.goal premiseSettlement.fulfillment.target) :=
  ⟨premiseSettlement.achieved⟩

/-! ## The exact service occurrence under an age-protected priority schedule -/

/-- A genuine depth-biased priority view, protected by a separate FIFO age
lane in `premisePortfolio`. -/
def premisePriority : PriorityField ClauseOccurrence where
  discipline := QueueDiscipline.depthFirst
  distinguishesAge :=
    ⟨[seedOccurrence], [goalFrom seedOccurrence], by decide⟩

def premisePortfolio : Spec ClauseOccurrence 2 :=
  paired premisePriority

def schedulingSystem : BranchingSystem ClauseOccurrence Unit where
  emit _occurrence := none
  successors _occurrence := []

/-- The existing age-priority theorem selects the exact occurrence generated by
the premise service, independently of the priority lane's depth bias. -/
theorem exact_service_occurrence_eventually_scheduled :
    ∃ fuel,
      selectedOccurrenceAt 0 ∈
        (PortfolioSnapshot.run schedulingSystem
          premisePortfolio.schedule.disciplines fuel
          (premisePortfolio.initial (Answer := Unit)
            [selectedOccurrenceAt 0] 0)).selections :=
  premisePortfolio.eventually_selects_root schedulingSystem
    [selectedOccurrenceAt 0] 0 (by simp)

/-- One end-to-end operational receipt retains scheduling, settlement, and the
exact proof event without identifying them. -/
structure FundedScheduledRun where
  scheduleFuel : Nat
  scheduled :
    selectedOccurrenceAt 0 ∈
      (PortfolioSnapshot.run schedulingSystem
        premisePortfolio.schedule.disciplines scheduleFuel
        (premisePortfolio.initial (Answer := Unit)
          [selectedOccurrenceAt 0] 0)).selections
  settlement : premiseRequest.Settlement attentionFund
  exactGoalEvent :
    settlement.fulfillment.target.events =
      [⟨goalFrom (selectedOccurrenceAt 0), ProofResult.proved⟩]

theorem funded_scheduled_run_exists : Nonempty FundedScheduledRun := by
  obtain ⟨fuel, scheduled⟩ := exact_service_occurrence_eventually_scheduled
  exact ⟨⟨fuel, scheduled, premiseSettlement,
    premiseSettlement.fulfillment.goalWitness.down⟩⟩

/-! ## Scheduling and funding still do not manufacture semantics -/

def unavailableSchematic : Schematic ForegroundState ForegroundState where
  context _source := PUnit
  procedure _source _target := Empty
  goal _target := PUnit

def unavailableRequest :
    ServiceRequest Nat MindAgent .shortTerm Currency
      ForegroundState ForegroundState where
  payment := premiseRequest.payment
  schematic := unavailableSchematic

def unavailableRedemption :
    unavailableRequest.payment.Redemption attentionFund := by
  simpa [unavailableRequest] using premiseRedemption

theorem unavailableRequest_has_no_fulfillment :
    IsEmpty unavailableRequest.Fulfillment := by
  constructor
  intro fulfillment
  exact fulfillment.execution.elim

/-- Negative control: the provider can be selected and the attention promise
can be funded while the requested semantic service remains impossible. -/
theorem scheduling_and_attention_do_not_prove_service :
    (∃ fuel,
      selectedOccurrenceAt 0 ∈
        (PortfolioSnapshot.run schedulingSystem
          premisePortfolio.schedule.disciplines fuel
          (premisePortfolio.initial (Answer := Unit)
            [selectedOccurrenceAt 0] 0)).selections) ∧
      Nonempty (unavailableRequest.payment.Redemption attentionFund) ∧
      IsEmpty unavailableRequest.Fulfillment :=
  ⟨exact_service_occurrence_eventually_scheduled,
    ⟨unavailableRedemption⟩,
    unavailableRequest_has_no_fulfillment⟩

#print axioms settlement_conserves_attention
#print axioms settlement_retains_goal_receipt
#print axioms exact_service_occurrence_eventually_scheduled
#print axioms funded_scheduled_run_exists
#print axioms unavailableRequest_has_no_fulfillment
#print axioms scheduling_and_attention_do_not_prove_service

end
end Mettapedia.CognitiveArchitecture.FundedScheduledPremiseService
