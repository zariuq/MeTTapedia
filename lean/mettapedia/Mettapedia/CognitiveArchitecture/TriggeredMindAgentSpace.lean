import Mettapedia.CognitiveArchitecture.MindAgentServiceScheduling

/-!
# Triggered spaces for recurrent background mind-agents

A finite service wave licenses occurrences which already exist.  Persistent
background services need a separate source of fresh occurrences.  This module
models an authored triggered space: resident service descriptions remain in the
space, external trigger occurrences generate epoch-indexed work occurrences,
and a scheduler separately selects generated work.

Recurring triggers do not by themselves prove scheduling.  The positive bridge
combines bounded trigger coverage with bounded selection of every generated
occurrence, yielding the recurring-occurrence condition required by ECAN LTI.
Generation, selection, service fulfillment, and payment remain distinct.
-/

set_option autoImplicit false

namespace Mettapedia.CognitiveArchitecture.TriggeredMindAgentSpace

noncomputable section

open Mettapedia.CognitiveArchitecture.AttentionEconomy
open Mettapedia.CognitiveArchitecture.MindAgentServiceScheduling

universe uTrigger uResident uActor uCurrency

/-- One fresh work occurrence records when it was generated, the exact trigger
occurrence, and the resident service description which received it. -/
structure TriggeredOccurrence (Trigger : Type uTrigger)
    (Resident : Type uResident) where
  generatedAt : Nat
  trigger : Trigger
  resident : Resident
deriving DecidableEq, Repr

/-- A triggered service-space policy.  Residency and trigger enablement are
separate, and every enabled service must be resident. -/
structure Space (Trigger : Type uTrigger) (Resident : Type uResident) where
  resident : Resident → Prop
  enabled : Trigger → Resident → Prop
  enabled_resident : ∀ trigger service,
    enabled trigger service → resident service

namespace Space

variable {Trigger : Type uTrigger} {Resident : Type uResident}

/-- A trace supplies at most one exact external trigger occurrence per cycle.
Multiple-trigger traces can be represented by taking `Trigger` itself to be an
occurrence bag. -/
abbrev TriggerTrace (Trigger : Type uTrigger) := Nat → Option Trigger

/-- The exact occurrence generated by one trigger/resident pair. -/
def occurrenceAt (cycle : Nat) (trigger : Trigger) (resident : Resident) :
    TriggeredOccurrence Trigger Resident :=
  ⟨cycle, trigger, resident⟩

/-- An exact generated occurrence must agree with the trace at its epoch and
with the space's authored enablement relation. -/
def Generated (space : Space Trigger Resident)
    (trace : TriggerTrace Trigger) (cycle : Nat)
    (occurrence : TriggeredOccurrence Trigger Resident) : Prop :=
  occurrence.generatedAt = cycle ∧
    trace cycle = some occurrence.trigger ∧
    space.enabled occurrence.trigger occurrence.resident

theorem generated_occurrenceAt
    (space : Space Trigger Resident) (trace : TriggerTrace Trigger)
    (cycle : Nat) (trigger : Trigger) (resident : Resident)
    (atCycle : trace cycle = some trigger)
    (enabled : space.enabled trigger resident) :
    space.Generated trace cycle (occurrenceAt cycle trigger resident) :=
  ⟨rfl, atCycle, enabled⟩

/-- Generated work always names a resident service. -/
theorem generated_is_resident
    {space : Space Trigger Resident} {trace : TriggerTrace Trigger}
    {cycle : Nat} {occurrence : TriggeredOccurrence Trigger Resident}
    (generated : space.Generated trace cycle occurrence) :
    space.resident occurrence.resident :=
  space.enabled_resident occurrence.trigger occurrence.resident generated.2.2

/-- No ambient polling is smuggled in: a cycle with no trigger generates no
service occurrence. -/
theorem no_generated_of_no_trigger
    (space : Space Trigger Resident) (trace : TriggerTrace Trigger)
    (cycle : Nat) (silent : trace cycle = none) :
    ¬ ∃ occurrence, space.Generated trace cycle occurrence := by
  rintro ⟨occurrence, generated⟩
  have triggerAt := generated.2.1
  rw [silent] at triggerAt
  simp at triggerAt

/-- An inert space may retain the same resident descriptions while authorizing
no trigger firing. -/
def inert (resident : Resident → Prop) : Space Trigger Resident where
  resident := resident
  enabled := fun _ _ => False
  enabled_resident := by
    intro trigger service impossible
    exact impossible.elim

theorem inert_has_no_generated
    (resident : Resident → Prop) (trace : TriggerTrace Trigger) (cycle : Nat) :
    ¬ ∃ occurrence,
      (inert (Trigger := Trigger) resident).Generated trace cycle occurrence := by
  rintro ⟨occurrence, generated⟩
  exact generated.2.2

/-- Repeated equal trigger values at distinct epochs remain distinct work
occurrences. -/
theorem occurrenceAt_epoch_injective
    {first second : Nat} (different : first ≠ second)
    (trigger : Trigger) (resident : Resident) :
    occurrenceAt first trigger resident ≠ occurrenceAt second trigger resident := by
  intro equalOccurrences
  exact different (congrArg TriggeredOccurrence.generatedAt equalOccurrences)

end Space

/-! ## From recurrent triggers to recurrent selected occurrences -/

/-- Every protected actor receives an enabled resident trigger within each
future trigger window.  This establishes generation, not selection. -/
structure RecurringTriggerCoverage
    {Trigger : Type uTrigger} {Resident : Type uResident}
    {Actor : Type uActor} {Currency : Type uCurrency}
    [Zero Currency] [LE Currency]
    (economy : Economy Actor Currency) (floor : Currency)
    (triggerWindow : Nat)
    (space : Space Trigger Resident) (trace : Space.TriggerTrace Trigger)
    (residentOwner : Resident → Actor) : Prop where
  covers : ∀ actor, economy.LongTermProtected floor actor →
    ∀ start, ∃ offset trigger resident,
      offset < triggerWindow ∧
      trace (start + offset) = some trigger ∧
      space.enabled trigger resident ∧
      residentOwner resident = actor

/-- Every generated occurrence is selected within a separate bounded window.
This is the scheduler/store adequacy premise; trigger semantics cannot prove it
alone. -/
structure BoundedGeneratedSelection
    {Trigger : Type uTrigger} {Resident : Type uResident}
    (space : Space Trigger Resident) (trace : Space.TriggerTrace Trigger)
    (selectionWindow : Nat)
    (selected : Nat → TriggeredOccurrence Trigger Resident → Prop) : Prop where
  selects : ∀ cycle occurrence, space.Generated trace cycle occurrence →
    ∃ offset, offset < selectionWindow ∧
      selected (cycle + offset) occurrence

namespace RecurringTriggerCoverage

variable {Trigger : Type uTrigger} {Resident : Type uResident}
variable {Actor : Type uActor} {Currency : Type uCurrency}
variable [Zero Currency] [LE Currency]
variable {economy : Economy Actor Currency} {floor : Currency}
variable {triggerWindow selectionWindow : Nat}
variable {space : Space Trigger Resident} {trace : Space.TriggerTrace Trigger}
variable {residentOwner : Resident → Actor}
variable {selected : Nat → TriggeredOccurrence Trigger Resident → Prop}

/-- Bounded trigger generation followed by bounded selection yields recurrent
selected occurrences.  The summed bound is conservative and compositional. -/
theorem toRecurringOccurrenceCoverage
    (triggerCoverage : RecurringTriggerCoverage economy floor triggerWindow
      space trace residentOwner)
    (selection : BoundedGeneratedSelection space trace selectionWindow selected) :
    RecurringOccurrenceCoverage economy floor
      (triggerWindow + selectionWindow)
      (fun occurrence => residentOwner occurrence.resident) selected := by
  constructor
  intro actor isProtected start
  obtain ⟨triggerOffset, trigger, resident, beforeTriggerDeadline,
      triggerAt, enabled, owned⟩ :=
    triggerCoverage.covers actor isProtected start
  let occurrence := Space.occurrenceAt (start + triggerOffset) trigger resident
  have generated :
      space.Generated trace (start + triggerOffset) occurrence :=
    space.generated_occurrenceAt trace (start + triggerOffset) trigger resident
      triggerAt enabled
  obtain ⟨selectionOffset, beforeSelectionDeadline, selectedAt⟩ :=
    selection.selects (start + triggerOffset) occurrence generated
  refine ⟨occurrence, triggerOffset + selectionOffset, by omega, ?_, ?_⟩
  · exact owned
  · simpa only [Nat.add_assoc] using selectedAt

/-- The composed trigger/scheduler bridge therefore discharges ECAN's bounded
long-term protection contract. -/
theorem honorsLongTerm
    (triggerCoverage : RecurringTriggerCoverage economy floor triggerWindow
      space trace residentOwner)
    (selection : BoundedGeneratedSelection space trace selectionWindow selected) :
    HonorsLongTermProtection economy floor
      (triggerWindow + selectionWindow)
      (scheduledFromOccurrences
        (fun occurrence => residentOwner occurrence.resident) selected) :=
  (triggerCoverage.toRecurringOccurrenceCoverage selection).honorsLongTerm

end RecurringTriggerCoverage

/-! ## Background-service canaries -/

namespace ServiceCanary

abbrev Actor :=
  Mettapedia.CognitiveArchitecture.CognitiveSchematicAttentionEconomy.Canary.Actor
abbrev Currency :=
  Mettapedia.CognitiveArchitecture.CognitiveSchematicAttentionEconomy.Canary.Currency
abbrev Resident := Fin
  Mettapedia.CognitiveArchitecture.CognitiveSynergyWave.Canary.batch.length
abbrev Trigger := Unit
abbrev Occurrence := TriggeredOccurrence Trigger Resident

def providerPosition : Resident :=
  Mettapedia.CognitiveArchitecture.CognitiveSynergyWave.Canary.serviceWave.providerPosition

def residentOwner (resident : Resident) : Actor :=
  (Mettapedia.CognitiveArchitecture.CognitiveSynergyWave.Canary.batch.get
    resident).actor

/-- Only the background service is resident in this triggered space. -/
def serviceSpace : Space Trigger Resident where
  resident position := position = providerPosition
  enabled _trigger position := position = providerPosition
  enabled_resident _trigger _position enabled := enabled

/-- A heartbeat trigger arrives at every cycle. -/
def heartbeatTrace (_cycle : Nat) : Option Trigger := some ()

def serviceTriggerCoverage :
    RecurringTriggerCoverage
      Mettapedia.CognitiveArchitecture.MindAgentServiceScheduling.Canary.longTermServiceEconomy
      1 1
      serviceSpace heartbeatTrace residentOwner where
  covers actor isProtected start := by
    have actorIsAnalyst : actor = .analyst := by
      cases actor <;>
        simp [Economy.LongTermProtected,
          Mettapedia.CognitiveArchitecture.MindAgentServiceScheduling.Canary.longTermServiceEconomy]
          at isProtected ⊢
    subst actor
    exact ⟨0, (), providerPosition, by omega, rfl, rfl, rfl⟩

/-- The scheduler selects the exact generated occurrence in the same cycle. -/
def selectedGenerated (cycle : Nat) (occurrence : Occurrence) : Prop :=
  serviceSpace.Generated heartbeatTrace cycle occurrence

def generatedSelection :
    BoundedGeneratedSelection serviceSpace heartbeatTrace 1
      selectedGenerated where
  selects cycle occurrence generated :=
    ⟨0, by omega, by simpa [selectedGenerated] using generated⟩

/-- Positive control: authored heartbeat triggers plus bounded generated-work
selection imply the ECAN LTI contract for the background service. -/
theorem triggered_background_service_honorsLongTerm :
    HonorsLongTermProtection
      Mettapedia.CognitiveArchitecture.MindAgentServiceScheduling.Canary.longTermServiceEconomy
      1 2
      (scheduledFromOccurrences
        (fun occurrence : Occurrence => residentOwner occurrence.resident)
        selectedGenerated) :=
  serviceTriggerCoverage.honorsLongTerm generatedSelection

def silentTrace (_cycle : Nat) : Option Trigger := none

/-- Negative activation control: residency without an authored trigger produces
no occurrence. -/
theorem resident_without_trigger_is_inert (cycle : Nat) :
    ¬ ∃ occurrence, serviceSpace.Generated silentTrace cycle occurrence :=
  serviceSpace.no_generated_of_no_trigger silentTrace cycle rfl

/-- Selection may fail even while triggers recur and occurrences are generated. -/
def neverSelected (_cycle : Nat) (_occurrence : Occurrence) : Prop := False

/-- Negative scheduler control: recurring triggers do not themselves discharge
the LTI scheduling promise. -/
theorem recurring_triggers_without_selection_do_not_honorLongTerm :
    Nonempty
        (RecurringTriggerCoverage
          Mettapedia.CognitiveArchitecture.MindAgentServiceScheduling.Canary.longTermServiceEconomy
          1 1
          serviceSpace heartbeatTrace residentOwner) ∧
      ¬ HonorsLongTermProtection
        Mettapedia.CognitiveArchitecture.MindAgentServiceScheduling.Canary.longTermServiceEconomy
        1 2
        (scheduledFromOccurrences
          (fun occurrence : Occurrence => residentOwner occurrence.resident)
          neverSelected) := by
  constructor
  · exact ⟨serviceTriggerCoverage⟩
  · intro honors
    have isProtected :
        Mettapedia.CognitiveArchitecture.MindAgentServiceScheduling.Canary.longTermServiceEconomy.LongTermProtected
          1 .analyst := by
      simp [Economy.LongTermProtected,
        Mettapedia.CognitiveArchitecture.MindAgentServiceScheduling.Canary.longTermServiceEconomy]
    obtain ⟨offset, _beforeDeadline, occurrence, selectedAt, _owned⟩ :=
      honors .analyst isProtected 0
    exact selectedAt

/-- Equal heartbeat and resident payloads at different epochs remain distinct
occurrences. -/
theorem repeated_trigger_keeps_epoch_identity :
    let first := Space.occurrenceAt 0 () providerPosition
    let second := Space.occurrenceAt 1 () providerPosition
    first.trigger = second.trigger ∧
      first.resident = second.resident ∧
      first ≠ second := by
  refine ⟨rfl, rfl, ?_⟩
  exact Space.occurrenceAt_epoch_injective (by decide) () providerPosition

end ServiceCanary

#print axioms Space.generated_is_resident
#print axioms Space.no_generated_of_no_trigger
#print axioms Space.inert_has_no_generated
#print axioms Space.occurrenceAt_epoch_injective
#print axioms RecurringTriggerCoverage.toRecurringOccurrenceCoverage
#print axioms RecurringTriggerCoverage.honorsLongTerm
#print axioms ServiceCanary.triggered_background_service_honorsLongTerm
#print axioms ServiceCanary.resident_without_trigger_is_inert
#print axioms
  ServiceCanary.recurring_triggers_without_selection_do_not_honorLongTerm
#print axioms ServiceCanary.repeated_trigger_keeps_epoch_identity

end
end Mettapedia.CognitiveArchitecture.TriggeredMindAgentSpace
