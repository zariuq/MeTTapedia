import Mettapedia.Algebra.ConcurrentCostValuation
import Mettapedia.Computability.ReflectiveCode
import Mettapedia.GSLT.Dynamics.IndexedEventValuation

/-!
# Valuations of proof-relevant reflective execution

Reflective execution witnesses are authentic events.  Cost, provenance,
authority, and attention may value those events, but a valuation is not the
event and does not add or remove an execution step.

This module packages dependent step witnesses with their endpoints, lifts an
operational quote/drop beta family to chronological event histories, and
proves that generic event valuation composes over those histories.  Product
valuations retain independent coordinates.

The separating model has two distinct receipts for the same endpoints.  Its
endpoint and WorkSpan readout is non-injective, while a product with the
chronological receipt valuation preserves the distinction.  Thus endpoint
equality and cost equality do not license receipt erasure.
-/

set_option autoImplicit false

namespace Mettapedia.Computability.ReflectiveExecutionValuation

open Mettapedia.Algebra
open Mettapedia.Algebra.ConcurrentCostValuation
open Mettapedia.Computability.ReflectiveCode
open Mettapedia.GSLT.Dynamics.IndexedEventValuation

universe uProcess uStep uGrade uOtherGrade

/-- A proof-relevant transition packaged with its exact endpoints. -/
structure ExecutionEvent {Process : Type uProcess}
    (Step : Process -> Process -> Type uStep) where
  source : Process
  target : Process
  witness : Step source target

namespace ExecutionEvent

variable {Process : Type uProcess}
variable {Step : Process -> Process -> Type uStep}

/-- Endpoint erasure forgets the proof-relevant transition witness. -/
def endpoints (event : ExecutionEvent Step) : Process × Process :=
  (event.source, event.target)

@[simp] theorem endpoints_mk (source target : Process)
    (witness : Step source target) :
    endpoints (ExecutionEvent.mk source target witness) = (source, target) :=
  rfl

end ExecutionEvent

/-- The authentic event generated by operational beta for one process. -/
def betaEvent {Process : Type uProcess} {Name : Type*}
    (interface : Interface Process Name)
    {Step : Process -> Process -> Type uStep}
    (execution : interface.OperationalBeta Step)
    (process : Process) : ExecutionEvent Step where
  source := interface.drop (interface.quote process)
  target := process
  witness := execution process

@[simp] theorem betaEvent_endpoints
    {Process : Type uProcess} {Name : Type*}
    (interface : Interface Process Name)
    {Step : Process -> Process -> Type uStep}
    (execution : interface.OperationalBeta Step)
    (process : Process) :
    (betaEvent interface execution process).endpoints =
      (interface.drop (interface.quote process), process) :=
  rfl

/-- A chronological process request list induces a chronological authentic
event history without erasing receipts. -/
def betaHistory {Process : Type uProcess} {Name : Type*}
    (interface : Interface Process Name)
    {Step : Process -> Process -> Type uStep}
    (execution : interface.OperationalBeta Step) :
    List Process -> List (ExecutionEvent Step) :=
  List.map (betaEvent interface execution)

@[simp] theorem betaHistory_append
    {Process : Type uProcess} {Name : Type*}
    (interface : Interface Process Name)
    {Step : Process -> Process -> Type uStep}
    (execution : interface.OperationalBeta Step)
    (first second : List Process) :
    betaHistory interface execution (first ++ second) =
      betaHistory interface execution first ++
        betaHistory interface execution second := by
  simp [betaHistory]

/-- Value a reflective beta history independently of its endpoint meaning. -/
def betaHistoryGrade {Process : Type uProcess} {Name : Type*}
    (interface : Interface Process Name)
    {Step : Process -> Process -> Type uStep}
    (execution : interface.OperationalBeta Step)
    (valuation : Valuation.{max uProcess uStep, uGrade}
      (ExecutionEvent Step))
    (processes : List Process) : Option valuation.Grade :=
  valuation.historyGrade (betaHistory interface execution processes)

/-- Reflective-history valuation composes in chronological order. -/
theorem betaHistoryGrade_append
    {Process : Type uProcess} {Name : Type*}
    (interface : Interface Process Name)
    {Step : Process -> Process -> Type uStep}
    (execution : interface.OperationalBeta Step)
    (valuation : Valuation.{max uProcess uStep, uGrade}
      (ExecutionEvent Step))
    (first second : List Process) :
    betaHistoryGrade interface execution valuation (first ++ second) =
      (betaHistoryGrade interface execution valuation first).bind fun left =>
        (betaHistoryGrade interface execution valuation second).bind fun right =>
          valuation.algebra.op left right := by
  unfold betaHistoryGrade
  rw [betaHistory_append, Valuation.historyGrade_append]

/-- Product valuation retains both selected coordinates on the same authentic
reflective event history. -/
theorem betaHistoryGrade_prod
    {Process : Type uProcess} {Name : Type*}
    (interface : Interface Process Name)
    {Step : Process -> Process -> Type uStep}
    (execution : interface.OperationalBeta Step)
    (left : Valuation.{max uProcess uStep, uGrade} (ExecutionEvent Step))
    (right : Valuation.{max uProcess uStep, uOtherGrade} (ExecutionEvent Step))
    (processes : List Process) :
    betaHistoryGrade interface execution (left.prod right) processes =
      (betaHistoryGrade interface execution left processes).bind
        fun leftGrade =>
          (betaHistoryGrade interface execution right processes).bind
            fun rightGrade => some (leftGrade, rightGrade) := by
  exact Valuation.prod_historyGrade left right
    (betaHistory interface execution processes)

/-! ## Receipt-retention canary -/

namespace Canary

open Mettapedia.Computability.ReflectiveCode.Canary

/-- The two-receipt step family from the reflective-code independence model. -/
abbrev ReceiptStep : Bool -> Bool -> Type := TwoReceiptStep

def falseReceiptEvent : ExecutionEvent ReceiptStep where
  source := false
  target := false
  witness := false

def trueReceiptEvent : ExecutionEvent ReceiptStep where
  source := false
  target := false
  witness := true

theorem receiptEvents_sameEndpoints :
    falseReceiptEvent.endpoints = trueReceiptEvent.endpoints :=
  rfl

theorem receiptEvents_distinct : falseReceiptEvent ≠ trueReceiptEvent := by
  intro equalEvents
  cases equalEvents

/-- Assign one unit of work and span to every authentic event, composing
chronologically. -/
def unitWorkSpan : Valuation (ExecutionEvent ReceiptStep) where
  Grade := WorkSpan
  algebra := workSpanSequential
  grade := fun _ => some ⟨1, 1⟩

theorem unitWorkSpan_total : unitWorkSpan.IsTotal := by
  constructor
  · intro event
    exact ⟨⟨1, 1⟩, rfl⟩
  · intro first second
    exact ⟨WorkSpan.sequential first second, rfl⟩

/-- Retain the exact receipt chronology as a separate valuation axis. -/
abbrev receiptChronology : Valuation (ExecutionEvent ReceiptStep) :=
  chronological fun event => event.witness

theorem receiptChronology_total : receiptChronology.IsTotal :=
  chronological_isTotal fun event : ExecutionEvent ReceiptStep => event.witness

/-- Endpoint plus WorkSpan is a deliberately lossy readout. -/
def endpointWorkSpanReadout
    (event : ExecutionEvent ReceiptStep) :
    (Bool × Bool) × WorkSpan :=
  (event.endpoints, ⟨1, 1⟩)

/-- Equal endpoints and equal cost do not determine the authentic event. -/
theorem endpointWorkSpanReadout_not_injective :
    ¬ Function.Injective endpointWorkSpanReadout := by
  intro injective
  apply receiptEvents_distinct
  apply injective
  rfl

@[simp] theorem falseReceipt_workSpan :
    unitWorkSpan.historyGrade [falseReceiptEvent] = some ⟨1, 1⟩ :=
  rfl

@[simp] theorem trueReceipt_workSpan :
    unitWorkSpan.historyGrade [trueReceiptEvent] = some ⟨1, 1⟩ :=
  rfl

@[simp] theorem falseReceipt_chronology :
    receiptChronology.historyGrade [falseReceiptEvent] = some [false] :=
  rfl

@[simp] theorem trueReceipt_chronology :
    receiptChronology.historyGrade [trueReceiptEvent] = some [true] :=
  rfl

/-- The product valuation retains both the cost and exact receipt axes. -/
abbrev costAndReceipt : Valuation (ExecutionEvent ReceiptStep) :=
  unitWorkSpan.prod receiptChronology

theorem product_valuation_separates_receipts :
    costAndReceipt.historyGrade [falseReceiptEvent] ≠
      costAndReceipt.historyGrade [trueReceiptEvent] := by
  change
    (some (⟨⟨1, 1⟩, [false]⟩ : WorkSpan × List Bool)) ≠
      some ⟨⟨1, 1⟩, [true]⟩
  decide

/-- Erasing the total receipt coordinate recovers WorkSpan accounting exactly;
the reverse reconstruction is impossible by the separating canary above. -/
theorem erase_receipt_recovers_workSpan
    (events : List (ExecutionEvent ReceiptStep)) :
    Option.map Prod.fst (costAndReceipt.historyGrade events) =
      unitWorkSpan.historyGrade events :=
  Valuation.map_fst_prod_historyGrade_of_right_total
    unitWorkSpan receiptChronology receiptChronology_total events

end Canary

#print axioms betaHistoryGrade_append
#print axioms betaHistoryGrade_prod
#print axioms Canary.receiptEvents_distinct
#print axioms Canary.endpointWorkSpanReadout_not_injective
#print axioms Canary.product_valuation_separates_receipts
#print axioms Canary.erase_receipt_recovers_workSpan

end Mettapedia.Computability.ReflectiveExecutionValuation
