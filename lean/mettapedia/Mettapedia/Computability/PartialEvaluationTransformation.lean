import Mettapedia.Computability.PartialEvaluation
import Mettapedia.GSLT.LanguageDef.LanguageDefTransformation

/-!
# Partial evaluation as a presentation-sensitive transformation

The semantic equation of a partial evaluator can be exposed through the
existing source-to-target transformation interface.  A source presentation is
an interpreter paired with its static input, the artifact is residual code,
and the declared observation is the residual program's behavior on every
dynamic input.

An explicit admission predicate keeps support partial even though the abstract
specializer is total.  Successful compilation preserves the whole extensional
runtime observation, while rejection remains `none`.  This is a
function-semantics result; it does not by itself claim operational-path or
proof-fibre equivalence for a concrete compiler.

References:

- Y. Futamura, *Partial Evaluation of Computation Process—An Approach to a
  Compiler-Compiler* (1971; English retrospective edition 1999).
- M. Wand, *Specifying the Correctness of Binding-Time Analysis* (1993).
- N. D. Jones, C. K. Gomard, and P. Sestoft, *Partial Evaluation and Automatic
  Program Generation* (1993).
-/

set_option autoImplicit false

namespace Mettapedia.Computability.PartialEvaluationTransformation

open Mettapedia.Computability.PartialEvaluation
open Mettapedia.GSLT.LanguageDef.LanguageDefTransformation

universe uCode

/-- An interpreter and the static source program supplied to it. -/
abbrev SourceDefinition (Code : Type uCode) := Code × Code

/-- The behavior of the unspecialized interpreter after fixing its source
program, observed on every remaining dynamic input. -/
def sourceObservation {Code : Type uCode}
    (system : SelfApplicableSpecializer Code)
    (source : SourceDefinition Code) : Code → Code :=
  fun runtime =>
    system.evaluate source.1 (system.pair source.2 runtime)

/-- The extensional runtime behavior of residual code. -/
def artifactObservation {Code : Type uCode}
    (system : SelfApplicableSpecializer Code) (artifact : Code) : Code → Code :=
  fun runtime => system.evaluate artifact runtime

/-- Restrict specialization by an explicit interpreter/source admission
predicate and expose it as the existing presentation-sensitive
transformation. -/
def transformation {Code : Type uCode}
    (system : SelfApplicableSpecializer Code)
    (admitted : Code → Code → Bool) :
    Transformation (SourceDefinition Code) Unit
      (fun _ => Code) (fun _ => Code → Code) where
  accepts := fun _ source => admitted source.1 source.2
  compile := fun _ source _ =>
    system.objectProgram source.1 source.2
  observeSource := fun _ source => sourceObservation system source
  observeArtifact := fun _ artifact => artifactObservation system artifact
  adequate := by
    intro target source accepted
    funext runtime
    exact system.first_projection source.1 source.2 runtime

/-- An admitted specialization request returns exactly the residual program
from the first Futamura projection. -/
theorem transform?_eq_some_of_admitted {Code : Type uCode}
    (system : SelfApplicableSpecializer Code)
    (admitted : Code → Code → Bool) (interpreter source : Code)
    (accepted : admitted interpreter source = true) :
    (transformation system admitted).transform? (interpreter, source) () =
      some (system.objectProgram interpreter source) := by
  simpa [transformation] using
    (Transformation.transform?_eq_some
      (transformation system admitted) (interpreter, source) () accepted)

/-- A rejected specialization request remains an explicit absence of an
artifact. -/
theorem transform?_eq_none_of_rejected {Code : Type uCode}
    (system : SelfApplicableSpecializer Code)
    (admitted : Code → Code → Bool) (interpreter source : Code)
    (rejected : admitted interpreter source ≠ true) :
    (transformation system admitted).transform? (interpreter, source) () =
      none := by
  exact Transformation.transform?_eq_none
    (transformation system admitted) (interpreter, source) () rejected

/-- The compiler generated by the second Futamura projection agrees with the
artifact selected by the transformation interface. -/
theorem generatedCompiler_agrees_with_compile {Code : Type uCode}
    (system : SelfApplicableSpecializer Code)
    (admitted : Code → Code → Bool) (interpreter source : Code)
    (accepted : admitted interpreter source = true) :
    system.evaluate (system.compiler interpreter) source =
      (transformation system admitted).compile ()
        (interpreter, source) accepted := by
  simpa [transformation] using system.second_projection interpreter source

/-- Extensional correctness of a candidate specializer over every dynamic
input. -/
def ObservationCorrect {Code : Type uCode}
    (system : SelfApplicableSpecializer Code)
    (candidate : Code → Code → Code) : Prop :=
  ∀ interpreter source,
    artifactObservation system (candidate interpreter source) =
      sourceObservation system (interpreter, source)

/-- The declared specializer satisfies the extensional observation contract. -/
theorem specialize_observationCorrect {Code : Type uCode}
    (system : SelfApplicableSpecializer Code) :
    ObservationCorrect system system.specialize := by
  intro interpreter source
  funext runtime
  exact system.specialization_correct interpreter source runtime

/-! ## Negative control -/

open PartialEvaluation.ResidualSyntaxCanary

/-- Erasing static input cannot satisfy the extensional observation contract
even though it always returns syntactically valid code. -/
theorem badSpecialize_not_observationCorrect :
    ¬ ObservationCorrect system badSpecialize := by
  intro correct
  exact badSpecialize_not_correct (fun interpreter source runtime =>
    congrFun (correct interpreter source) runtime)

end Mettapedia.Computability.PartialEvaluationTransformation

#print axioms Mettapedia.Computability.PartialEvaluationTransformation.transform?_eq_some_of_admitted
#print axioms Mettapedia.Computability.PartialEvaluationTransformation.generatedCompiler_agrees_with_compile
#print axioms Mettapedia.Computability.PartialEvaluationTransformation.specialize_observationCorrect
#print axioms Mettapedia.Computability.PartialEvaluationTransformation.badSpecialize_not_observationCorrect
