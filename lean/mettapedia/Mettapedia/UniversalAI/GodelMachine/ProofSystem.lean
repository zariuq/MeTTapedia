import Mathlib.Tactic.DeriveEncodable
import Mettapedia.UniversalAI.GodelMachine.Basic

/-!
# Syntactic proof systems for Gödel-machine representations

The semantic shell in `Basic` uses `Prop` and an abstract provability predicate.
That is sufficient for the proved safe-improvement theorems, but it cannot
serve as its own Gödel encoding.  This module supplies an honest syntactic
layer: an encodable arithmetic language, proof-relevant derivations, and a
sound interpretation interface.

It deliberately does **not** claim a diagonal lemma, a halting formula, or an
encoding of `GodelMachineState`.  Those require concrete substitution,
arithmetization, and a representable machine state.  In particular, a
reflexive equality is not treated as a self-description theorem.

## References

* Kurt Gödel (1931), *On Formally Undecidable Propositions*.
* Jürgen Schmidhuber (2003), *Gödel Machines: Self-Referential Universal
  Problem Solvers Making Provably Optimal Self-Improvements*.
-/

namespace Mettapedia.UniversalAI.GodelMachine

universe uAxiom uInference

/-- First-order arithmetic terms used by a concrete syntactic proof system. -/
inductive ArithTerm where
  | zero : ArithTerm
  | succ : ArithTerm → ArithTerm
  | var : ℕ → ArithTerm
  | add : ArithTerm → ArithTerm → ArithTerm
  | mul : ArithTerm → ArithTerm → ArithTerm
  deriving DecidableEq, Repr, Encodable

/-- Numerals embedded in arithmetic syntax. -/
def ArithTerm.ofNat : ℕ → ArithTerm
  | 0 => .zero
  | n + 1 => .succ (ofNat n)

/-- Arithmetic formulas with numeric variable identifiers.  A future
substitution development must state and prove its binding laws. -/
inductive ArithFormula where
  | eq : ArithTerm → ArithTerm → ArithFormula
  | lt : ArithTerm → ArithTerm → ArithFormula
  | neg : ArithFormula → ArithFormula
  | conj : ArithFormula → ArithFormula → ArithFormula
  | disj : ArithFormula → ArithFormula → ArithFormula
  | impl : ArithFormula → ArithFormula → ArithFormula
  | forall_ : ℕ → ArithFormula → ArithFormula
  | exists_ : ℕ → ArithFormula → ArithFormula
  deriving DecidableEq, Repr, Encodable

/-- A genuine injective code for arithmetic terms, obtained from the derived
`Encodable` instance rather than an ad-hoc collision-prone arithmetic score. -/
def termCode : ArithTerm → ℕ := Encodable.encode

theorem termCode_injective : Function.Injective termCode :=
  Encodable.encode_injective

/-- A genuine injective code for arithmetic formulas. -/
def formulaCode : ArithFormula → ℕ := Encodable.encode

theorem formulaCode_injective : Function.Injective formulaCode :=
  Encodable.encode_injective

/-- A syntactic theory with proof-relevant axioms and inference receipts.

`Inference premises conclusion` may have several inhabitants, preserving
distinct rule applications with the same endpoints. -/
structure ArithmetizedTheory where
  Axiom : ArithFormula → Type uAxiom
  Inference : List ArithFormula → ArithFormula → Type uInference
  interpret : ArithFormula → Prop
  axiomSound : ∀ {formula}, Axiom formula → interpret formula
  inferenceSound : ∀ {premises conclusion},
    Inference premises conclusion →
      (∀ premise, premise ∈ premises → interpret premise) →
      interpret conclusion

namespace ArithmetizedTheory

/-- Proof-relevant derivations generated by the theory's own axioms and
inference rules. -/
inductive Derivation (theory : ArithmetizedTheory) : ArithFormula → Type _ where
  | fromAxiom {formula} : theory.Axiom formula → Derivation theory formula
  | fromInference {premises conclusion} :
      theory.Inference premises conclusion →
      (∀ premise, premise ∈ premises → Derivation theory premise) →
      Derivation theory conclusion

/-- Every generated derivation is sound in the theory's stated
interpretation. -/
theorem derivation_sound (theory : ArithmetizedTheory) :
    ∀ {formula}, theory.Derivation formula → theory.interpret formula := by
  intro formula derivation
  induction derivation with
  | fromAxiom evidence => exact theory.axiomSound evidence
  | @fromInference premises conclusion ruleEvidence premiseEvidence inductionHypotheses =>
      exact theory.inferenceSound ruleEvidence (fun premise membership =>
        inductionHypotheses premise membership)

end ArithmetizedTheory

/-- A concrete state encoding is additional structure, not a consequence of
having a semantic state type. -/
structure StateEncoding (State : Type*) where
  encode : State → ℕ
  injective : Function.Injective encode

/-- Distinct states receive distinct codes under a genuine state encoding. -/
theorem StateEncoding.ne_code_ne {State : Type*} (encoding : StateEncoding State)
    {left right : State} (different : left ≠ right) :
    encoding.encode left ≠ encoding.encode right := by
  exact fun equalCodes => different (encoding.injective equalCodes)

end Mettapedia.UniversalAI.GodelMachine
