import Mettapedia.Ethics.NativeParadigmCapabilities
import Mettapedia.Ethics.TargetCenteredVirtue

/-!
# Empirical Optimizers as Virtue-Learning Theories

Moral Paradigm Equivalence requires more than showing that naturally chosen
examples from different paradigms can disagree.  A virtue theory must also be
able to reproduce the behavior of a declared empirical optimizer.

This module constructs that theory explicitly.  The optimizer's score remains
an empirical consequential object; the corresponding virtue has optimality as
its target; and a learning policy selects exactly the optimizer's action after
updating its disposition.  The construction is exact but may be an unusual
virtue theory.  Its computability, succinctness, and learnability are separate
properties of the supplied selector and update function.
-/

set_option autoImplicit false

namespace Mettapedia.Ethics.OptimizerVirtueBridge

open Mettapedia.Ethics
open Mettapedia.Ethics.NativeParadigmCapabilities
open Mettapedia.Ethics.TargetCenteredVirtue

universe uSituation uAction uObservation uScore uExperience uDisposition

variable {Situation : Type uSituation} {Action : Type uAction}
  {Observation : Type uObservation} {Score : Type uScore}
  {Experience : Type uExperience} {Disposition : Type uDisposition}
  [Preorder Score]

/-- The target-centered virtue whose field is every situation, whose basis is
empirical optimality, and whose target is to choose an action optimal under the
declared observation/score model. -/
def empiricalOptimalityVirtue
    (policy : EmpiricalConsequentialPolicy Situation Action Observation Score) :
    VirtueSpec Unit Situation Action Unit where
  valence := .virtue
  field _ := True
  basis := {()}
  basis_nonempty := ⟨(), by simp⟩
  mode _ _ _ := True
  target _ situation action := policy.IsOptimal situation action

/-- The one-virtue target-centered theory generated by a declared empirical
optimizer. -/
def empiricalOptimalityTheory
    (policy : EmpiricalConsequentialPolicy Situation Action Observation Score) :
    TargetCenteredVirtue.Theory Unit Unit Situation Action Unit where
  included := {()}
  spec _ := empiricalOptimalityVirtue policy

theorem empiricalOptimalityTheory_supports_good_iff_optimal
    (policy : EmpiricalConsequentialPolicy Situation Action Observation Score)
    (situation : Situation) (action : Action) :
    (empiricalOptimalityTheory policy).SupportsVerdict
        () situation action .MorallyGood ↔
      policy.IsOptimal situation action := by
  constructor
  · rintro ⟨virtue, included, hits, valence⟩
    have virtueEq : virtue = () := Subsingleton.elim _ _
    subst virtue
    exact hits.2.2
  · intro optimal
    exact ⟨(), by simp [empiricalOptimalityTheory],
      ⟨trivial, trivial, optimal⟩, rfl⟩

/-- Turn an exact optimizer and a disposition update into a virtue-learning
policy.  Its action function is definitionally the supplied optimizer, while
its active target records the optimizer's global optimality proof. -/
def optimizerVirtueLearningPolicy
    (policy : EmpiricalConsequentialPolicy Situation Action Observation Score)
    (update : Disposition → Experience → Disposition)
    (select : Disposition → Situation → Action) :
    VirtueLearningPolicy Situation Action Experience Disposition Unit where
  update := update
  act := select
  field _ _ := True
  mode _ _ _ := True
  target _ situation action := policy.IsOptimal situation action

@[simp] theorem optimizerVirtueLearningPolicy_act
    (policy : EmpiricalConsequentialPolicy Situation Action Observation Score)
    (update : Disposition → Experience → Disposition)
    (select : Disposition → Situation → Action)
    (disposition : Disposition) (situation : Situation) :
    (optimizerVirtueLearningPolicy policy update select).act
        disposition situation = select disposition situation :=
  rfl

theorem optimizerVirtueLearningPolicy_hitsActiveTargets
    (policy : EmpiricalConsequentialPolicy Situation Action Observation Score)
    (update : Disposition → Experience → Disposition)
    (select : Disposition → Situation → Action)
    (select_optimal : ∀ disposition situation,
      policy.IsOptimal situation (select disposition situation))
    (disposition : Disposition) (situation : Situation) :
    (optimizerVirtueLearningPolicy policy update select).HitsActiveTargets
      disposition situation := by
  intro virtue _active
  exact ⟨trivial, select_optimal disposition situation⟩

/-- Every update step of the optimizer-derived virtue policy has a native
learning receipt for the exact action selected after the update. -/
def optimizerVirtueLearningReceipt
    (policy : EmpiricalConsequentialPolicy Situation Action Observation Score)
    (update : Disposition → Experience → Disposition)
    (select : Disposition → Situation → Action)
    (select_optimal : ∀ disposition situation,
      policy.IsOptimal situation (select disposition situation))
    (before : Disposition) (experience : Experience)
    (situation : Situation) :
    VirtueLearningReceipt
      (optimizerVirtueLearningPolicy policy update select)
      before experience situation (select (update before experience) situation) where
  after := update before experience
  updated := rfl
  acted := rfl
  hitsTargets :=
    optimizerVirtueLearningPolicy_hitsActiveTargets policy
      update select select_optimal (update before experience) situation

/-! ## Rescue optimizer specimen -/

open NativeParadigmCapabilities in
def shortHorizonVirtuePolicy :
    VirtueLearningPolicy
      NativeParadigmCapabilities.RescueSituation
      NativeParadigmCapabilities.RescueAction Unit Unit Unit :=
  optimizerVirtueLearningPolicy shortHorizonConsequentialPolicy
    (fun _ _ => ())
    (fun _ _ => .wait)

open NativeParadigmCapabilities in
theorem shortHorizonVirtuePolicy_selects_same_action :
    shortHorizonVirtuePolicy.act () .emergency = .wait :=
  rfl

open NativeParadigmCapabilities in
theorem shortHorizonVirtuePolicy_hits_optimizer_target :
    shortHorizonVirtuePolicy.HitsActiveTargets () .emergency := by
  exact optimizerVirtueLearningPolicy_hitsActiveTargets
    shortHorizonConsequentialPolicy
    (fun _ _ => ()) (fun _ _ => .wait)
    (fun _ situation => wait_is_shortHorizon_optimal situation) () .emergency

open NativeParadigmCapabilities in
theorem courage_and_optimizerVirtue_are_different_theories :
    courageLearningPolicy.act .trained .emergency ≠
      shortHorizonVirtuePolicy.act () .emergency := by
  decide

