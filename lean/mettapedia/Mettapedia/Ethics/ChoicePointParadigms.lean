/-! ## The action fragment and its generated modality -/

/-- Whether a rule takes one of the declared actions. -/
noncomputable def isActionRule (actionCount : ℕ) (rule : RewriteRule) : Bool :=
  decide (∃ action < actionCount, rule = chooseRule action)

/-- The action fragment: the choice language restricted to its `Choose` rules. -/
noncomputable def actionsLanguage (actionCount : ℕ) : LanguageDef :=
  (choiceLanguage actionCount).restrictRewrites (isActionRule actionCount)

theorem actionsLanguage_rewrites (actionCount : ℕ) :
    (actionsLanguage actionCount).rewrites = actionRules actionCount := by
  have notScene := fun rule (member : rule ∈ rewrites ++ [deliberationStepRule, decidedRule]) =>
    List.all_eq_true.mp machine_rules_not_at_scene rule member
  have machine : rewrites.filter (isActionRule actionCount) = [] :=
    List.filter_eq_nil_iff.mpr fun rule member => by
      simp only [isActionRule, decide_eq_true_eq, not_exists, not_and]
      intro action _ same
      have := notScene rule (List.mem_append_left _ member)
      subst same
      simp [chooseRule] at this
  have actions : (actionRules actionCount).filter (isActionRule actionCount) = actionRules actionCount :=
    List.filter_eq_self.mpr fun rule member => by
      simp only [actionRules, List.mem_map, List.mem_range] at member
      obtain ⟨action, inRange, rfl⟩ := member
      exact decide_eq_true ⟨action, inRange, rfl⟩
  have world : [deliberateRule, deliberationStepRule, decidedRule].filter (isActionRule actionCount) = [] :=
    List.filter_eq_nil_iff.mpr fun rule member => by
      simp only [isActionRule, decide_eq_true_eq, not_exists, not_and]
      intro action _ same
      subst same
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at member
      rcases member with same | same | same
      · have := congrArg RewriteRule.right same
        simp [chooseRule, deliberateRule] at this
      · have := notScene deliberationStepRule (by simp)
        rw [← same] at this
        simp [chooseRule] at this
      · have := notScene decidedRule (by simp)
        rw [← same] at this
        simp [chooseRule] at this
  simp only [actionsLanguage, LanguageDef.restrictRewrites_rewrites, choiceLanguage_rewrites,
    choiceRewrites, List.filter_append, machine, actions, world, List.nil_append, List.append_nil]

theorem actionsLanguage_equationFree (actionCount : ℕ) :
    (actionsLanguage actionCount).isEquationFree = true :=
  ((choiceLanguage actionCount).isEquationFree_restrictRewrites _).trans
    (choiceLanguage_equationFree actionCount)

theorem actionsLanguage_unconditional (actionCount : ℕ) :
    Mettapedia.OSLF.MeTTaIL.NonrecursiveReduction.isUnconditionalAligned (actionsLanguage actionCount) =
      true := by
  simp only [Mettapedia.OSLF.MeTTaIL.NonrecursiveReduction.isUnconditionalAligned,
    actionsLanguage_rewrites, List.all_eq_true, actionRules, List.mem_map, List.mem_range,
    Bool.and_eq_true, List.isEmpty_iff]
  rintro _ ⟨action, -, rfl⟩
  exact chooseRule_unconditional action

/-- The OSLF step-future modality of the action fragment, on a raw predicate. -/
def generatedDiamond (actionCount : ℕ) (predicate : Pattern → Prop) : Pattern → Prop :=
  Mettapedia.OSLF.Framework.RuleRestriction.generatedDiamond (actionsLanguage actionCount)
    (actionsLanguage_equationFree actionCount) predicate

/-- **The action fragment's modality is the join of the actions' modalities.** -/
theorem generatedDiamond_iff_exists_action (actionCount : ℕ) (predicate : Pattern → Prop)
    (world : Pattern) :
    generatedDiamond actionCount predicate world ↔
      ∃ action < actionCount, ruleDiamond (choiceLanguage actionCount)
        (choiceLanguage_equationFree actionCount) (chooseRule action) predicate world := by
  unfold generatedDiamond
  rw [generatedDiamond_iff_exists_ruleDiamond _ _ (actionsLanguage_unconditional actionCount),
    actionsLanguage_rewrites]
  simp only [actionRules, List.mem_map, List.mem_range]
  constructor
  · rintro ⟨_, ⟨action, inRange, rfl⟩, holds⟩
    refine ⟨action, inRange, ?_⟩
    rw [ruleDiamond_iff _ _ (chooseRule_unconditional action)] at holds ⊢
    exact ⟨chooseRule_mem inRange, holds.2⟩
  · rintro ⟨action, inRange, holds⟩
    refine ⟨_, ⟨action, inRange, rfl⟩, ?_⟩
    rw [ruleDiamond_iff _ _ (chooseRule_unconditional action)] at holds ⊢
    refine ⟨?_, holds.2⟩
    rw [actionsLanguage_rewrites]
    exact List.mem_map.mpr ⟨action, List.mem_range.mpr inRange, rfl⟩

/-- **At a scene the generated modality ranges over the declared actions.** -/
theorem generatedDiamond_scene (actionCount : ℕ) (predicate : Pattern → Prop) (agent : Code)
    (situation : ℕ) :
    generatedDiamond actionCount predicate (scene agent situation) ↔
      ∃ action < actionCount, predicate (did action situation) := by
  rw [generatedDiamond_iff_exists_action]
  simp only [chooseDiamond_scene]
  constructor
  · rintro ⟨action, inRange, -, holds⟩
    exact ⟨action, inRange, holds⟩
  · rintro ⟨action, inRange, holds⟩
    exact ⟨action, inRange, inRange, holds⟩

/-- **Types generated by the action fragment at a scene do not see the agent.** -/
theorem generatedDiamond_agent_independent (actionCount : ℕ) (predicate : Pattern → Prop)
    (first second : Code) (situation : ℕ) :
    generatedDiamond actionCount predicate (scene first situation) ↔
      generatedDiamond actionCount predicate (scene second situation) := by
  rw [generatedDiamond_scene, generatedDiamond_scene]

/-- **The deliberation modality does see the agent.**  At a scene of `Code.id` it
reaches the pending evaluation of `Code.id`; at a scene of `zero'` it does not. -/
theorem deliberation_sees_agent (actionCount situation : ℕ) :
    ruleDiamond (choiceLanguage actionCount) (choiceLanguage_equationFree actionCount) deliberateRule
        (· = deciding (normalTerm .id .halt [situation]) situation) (scene .id situation) ∧
      ¬ ruleDiamond (choiceLanguage actionCount) (choiceLanguage_equationFree actionCount)
        deliberateRule (· = deciding (normalTerm .id .halt [situation]) situation)
        (scene .zero' situation) := by
  rw [deliberateDiamond_scene, deliberateDiamond_scene]
  refine ⟨rfl, fun same => ?_⟩
  simp only [deciding, normalTerm, Pattern.apply.injEq, List.cons.injEq, and_true, true_and] at same
  exact absurd (encCode_injective same) (by decide)

/-! ## Acts and derived choice points -/

/-- The formula "the world is the outcome of doing `action`". -/
def doing (action : ℕ) : Formula Pattern := fun world => ∃ situation, world = did action situation

theorem did_injective {action action' situation situation' : ℕ}
    (same : did action situation = did action' situation') :
    action = action' ∧ situation = situation' := by
  simp only [did, Pattern.apply.injEq, List.cons.injEq, and_true, true_and] at same
  exact ⟨encNat_injective same.1, encNat_injective same.2⟩

theorem doing_did_iff (action action' situation : ℕ) :
    doing action (did action' situation) ↔ action = action' := by
  constructor
  · rintro ⟨_, same⟩
    exact (did_injective same).1.symm
  · rintro rfl
    exact ⟨situation, rfl⟩

/-- The choice point at every scene: doing each declared action. -/
def choicePointAt (actionCount : ℕ) : ChoicePoint Pattern :=
  {formula | ∃ action < actionCount, formula = doing action}

/-- The action sites enabled at a world: the declared actions whose rule matches it
at the root. -/
def enabledActions (actionCount : ℕ) (world : Pattern) : List ℕ :=
  (List.range actionCount).filter fun action => !(matchPattern (chooseRule action).left world).isEmpty

theorem enabledAction_site_mem {actionCount : ℕ} {world : Pattern} {action : ℕ}
    (enabled : action ∈ enabledActions actionCount world) :
    actionSite action ∈ Mettapedia.OSLF.Framework.GeneratedModalFamily.redexSites
      (choiceLanguage actionCount) :=
  actionSite_mem_redexSites (List.mem_range.mp (List.mem_filter.mp enabled).1)

/-- The choice point derived from a world: doing each enabled action. -/
def choicePointOf (actionCount : ℕ) (world : Pattern) : ChoicePoint Pattern :=
  {formula | ∃ action ∈ enabledActions actionCount world, formula = doing action}

theorem enabledActions_scene (actionCount : ℕ) (agent : Code) (situation : ℕ) :
    enabledActions actionCount (scene agent situation) = List.range actionCount := by
  unfold enabledActions
  rw [List.filter_eq_self]
  intro action _
  simp [chooseRule, scene, matchPattern, matchArgs, mergeBindings]

/-- **At a scene every declared action is enabled.** -/
theorem choicePointOf_scene (actionCount : ℕ) (agent : Code) (situation : ℕ) :
    choicePointOf actionCount (scene agent situation) = choicePointAt actionCount := by
  ext formula
  simp [choicePointOf, choicePointAt, enabledActions_scene]

/-- **At an outcome nothing is enabled**: an outcome is not a choice point. -/
theorem choicePointOf_did (actionCount action situation : ℕ) :
    choicePointOf actionCount (did action situation) = ∅ := by
  ext formula
  simp [choicePointOf, enabledActions, chooseRule, did, matchPattern]

/-- Whether doing `action` at a scene reaches a world satisfying `predicate`. -/
def ActReaches (actionCount : ℕ) (predicate : Pattern → Prop) (agent : Code)
    (situation action : ℕ) : Prop :=
  generatedDiamond actionCount (fun world => doing action world ∧ predicate world)
    (scene agent situation)

theorem actReaches_iff (actionCount : ℕ) (predicate : Pattern → Prop) (agent : Code)
    (situation action : ℕ) :
    ActReaches actionCount predicate agent situation action ↔
      action < actionCount ∧ predicate (did action situation) := by
  unfold ActReaches
  rw [generatedDiamond_scene]
  constructor
  · rintro ⟨action', inRange, doingIt, holds⟩
    obtain rfl := (doing_did_iff action action' situation).mp doingIt
    exact ⟨inRange, holds⟩
  · rintro ⟨inRange, holds⟩
    exact ⟨action, inRange, ⟨situation, rfl⟩, holds⟩

/-- **Doing an action is its own generated modality.**  The formula "doing
`action`" under the action fragment's modality is the action's rule-indexed
modality. -/
theorem doing_faithful (actionCount action : ℕ) (predicate : Pattern → Prop) (agent : Code)
    (situation : ℕ) :
    generatedDiamond actionCount (fun world => doing action world ∧ predicate world)
        (scene agent situation) ↔
      ruleDiamond (choiceLanguage actionCount) (choiceLanguage_equationFree actionCount)
        (chooseRule action) predicate (scene agent situation) := by
  rw [chooseDiamond_scene]
  exact actReaches_iff actionCount predicate agent situation action

/-- The ontology's situated choice point at a scene: the enabled actions, with
capability being that the action's generated modality is enabled. -/
noncomputable def situatedChoicePoint (actionCount : ℕ) (hasAction : 0 < actionCount) (agent : Code)
    (situation : ℕ) : MetaEthicsOntology.SituatedChoicePoint Code ℕ ℕ where
  agent := agent
  situation := situation
  options := {action | action ∈ enabledActions actionCount (scene agent situation)}
  options_nonempty := ⟨0, by simpa [enabledActions_scene] using hasAction⟩
  capable agent situation action :=
    ruleDiamond (choiceLanguage actionCount) (choiceLanguage_equationFree actionCount)
      (chooseRule action) (fun _ => True) (scene agent situation)
  options_capable := fun action member =>
    (chooseDiamond_scene _ _ _ _ _).mpr ⟨by simpa [enabledActions_scene] using member, trivial⟩

/-! ## Generated deontic and value semantics -/

/-- Deontic operators read off the generated modality over a violation
predicate: permitted when some way of doing it avoids violation, prohibited when
none does, obligatory when no way of doing otherwise avoids violation. -/
def generatedDeonticSemantics (actionCount : ℕ) (violation : Pattern → Prop) :
    DeonticSemantics Pattern where
  deontic
    | .Permission, formula, world =>
        generatedDiamond actionCount (fun w => formula w ∧ ¬ violation w) world
    | .Prohibition, formula, world =>
        ¬ generatedDiamond actionCount (fun w => formula w ∧ ¬ violation w) world
    | .Obligation, formula, world =>
        ¬ generatedDiamond actionCount (fun w => ¬ formula w ∧ ¬ violation w) world

/-- Value judgments read off the generated modality from an ideal and a violation
predicate: good when some way of doing it reaches the ideal, bad when none avoids
violation, permissible when some avoids violation and none reaches the ideal. -/
def generatedValueSemantics (actionCount : ℕ) (ideal violation : Pattern → Prop) :
    ValueSemantics Pattern where
  morally
    | .MorallyGood, formula, world =>
        generatedDiamond actionCount (fun w => formula w ∧ ideal w) world
    | .MorallyBad, formula, world =>
        ¬ generatedDiamond actionCount (fun w => formula w ∧ ¬ violation w) world
    | .MorallyPermissible, formula, world =>
        generatedDiamond actionCount (fun w => formula w ∧ ¬ violation w) world ∧
          ¬ generatedDiamond actionCount (fun w => formula w ∧ ideal w) world

/-- Bad is prohibited, and permitted is not prohibited. -/
theorem generated_agreeOnProhibition (actionCount : ℕ) (ideal violation : Pattern → Prop) :
    AgreeOnProhibition (generatedDeonticSemantics actionCount violation)
      (generatedValueSemantics actionCount ideal violation) :=
  ⟨fun _ _ => Iff.rfl, fun _ _ => not_not.symm⟩

theorem permission_doing_scene (actionCount : ℕ) (violation : Pattern → Prop) (agent : Code)
    (situation action : ℕ) :
    (generatedDeonticSemantics actionCount violation).deontic .Permission (doing action)
        (scene agent situation) ↔
      action < actionCount ∧ ¬ violation (did action situation) :=
  actReaches_iff actionCount (fun world => ¬ violation world) agent situation action

theorem prohibition_doing_scene (actionCount : ℕ) (violation : Pattern → Prop) (agent : Code)
    (situation action : ℕ) :
    (generatedDeonticSemantics actionCount violation).deontic .Prohibition (doing action)
        (scene agent situation) ↔
      ¬ (action < actionCount ∧ ¬ violation (did action situation)) :=
  not_congr (permission_doing_scene actionCount violation agent situation action)

/-- **Obligation is that every other declared action violates.** -/
theorem obligation_doing_scene (actionCount : ℕ) (violation : Pattern → Prop) (agent : Code)
    (situation action : ℕ) :
    (generatedDeonticSemantics actionCount violation).deontic .Obligation (doing action)
        (scene agent situation) ↔
      ∀ other < actionCount, other ≠ action → violation (did other situation) := by
  simp only [generatedDeonticSemantics, generatedDiamond_scene, doing_did_iff, not_exists, not_and,
    not_not]
  constructor
  · intro obligatory other inRange different
    exact obligatory other inRange (Ne.symm different)
  · intro obligatory other inRange different
    exact obligatory other inRange (Ne.symm different)

theorem good_doing_scene (actionCount : ℕ) (ideal violation : Pattern → Prop) (agent : Code)
    (situation action : ℕ) :
    (generatedValueSemantics actionCount ideal violation).morally .MorallyGood (doing action)
        (scene agent situation) ↔
      action < actionCount ∧ ideal (did action situation) :=
  actReaches_iff actionCount ideal agent situation action

/-- **Deontic dilemmas at a derived choice point.**  Every enabled action is
prohibited exactly when every declared action's outcome is a violation. -/
theorem deonticDilemma_iff (actionCount : ℕ) (violation : Pattern → Prop) (agent : Code)
    (situation : ℕ) :
    DeonticMoralDilemma (generatedDeonticSemantics actionCount violation)
        (scene agent situation) (choicePointOf actionCount (scene agent situation)) ↔
      ∀ action < actionCount, violation (did action situation) := by
  rw [choicePointOf_scene]
  constructor
  · intro dilemma action inRange
    have prohibited := (prohibition_doing_scene actionCount violation agent situation action).mp
      (dilemma (doing action) ⟨action, inRange, rfl⟩)
    exact not_not.mp fun avoids => prohibited ⟨inRange, avoids⟩
  · intro violations formula member
    obtain ⟨action, inRange, rfl⟩ := member
    exact (prohibition_doing_scene actionCount violation agent situation action).mpr
      fun ⟨_, avoids⟩ => avoids (violations action inRange)

/-- Value dilemmas and deontic dilemmas coincide. -/
theorem valueDilemma_iff_deonticDilemma (actionCount : ℕ) (ideal violation : Pattern → Prop)
    (world : Pattern) (choicePoint : ChoicePoint Pattern) :
    ValueMoralDilemma (generatedValueSemantics actionCount ideal violation) world choicePoint ↔
      DeonticMoralDilemma (generatedDeonticSemantics actionCount violation) world choicePoint :=
  Iff.rfl

/-! ## Target-centered virtue is deontology in disguise -/

/-- A virtue whose target is reaching an ideal outcome through the act. -/
def idealVirtue (actionCount : ℕ) (field : ℕ → Prop) (ideal : Pattern → Prop) :
    VirtueSpec Code ℕ ℕ Unit where
  valence := .virtue
  field := field
  basis := Set.univ
  basis_nonempty := ⟨(), trivial⟩
  mode _ _ action := action < actionCount
  target agent situation action := ActReaches actionCount ideal agent situation action

/-- **The target is the generated permission type** for the violation predicate
"not ideal". -/
theorem tcve_target_is_permission (actionCount : ℕ) (field : ℕ → Prop) (ideal : Pattern → Prop) :
    (idealVirtue actionCount field ideal).target =
      fun agent situation action =>
        (generatedDeonticSemantics actionCount fun world => ¬ ideal world).deontic .Permission
          (doing action) (scene agent situation) := by
  funext agent situation action
  simp only [idealVirtue, ActReaches, generatedDeonticSemantics, not_not]

/-- And missing it is the generated prohibition type. -/
theorem tcve_miss_is_prohibition (actionCount : ℕ) (field : ℕ → Prop) (ideal : Pattern → Prop)
    (agent : Code) (situation action : ℕ) :
    ¬ (idealVirtue actionCount field ideal).target agent situation action ↔
      (generatedDeonticSemantics actionCount fun world => ¬ ideal world).deontic .Prohibition
        (doing action) (scene agent situation) := by
  rw [tcve_target_is_permission]
  rfl

/-- **Agent-centered virtue is not act-level.**  Two agents are indistinguishable
by every type the action fragment generates at every scene, yet one possesses
faithful reporting and the other does not. -/
theorem possession_not_act_level :
    (∀ (actionCount : ℕ) (predicate : Pattern → Prop) (situation : ℕ),
        generatedDiamond actionCount predicate (scene .id situation) ↔
          generatedDiamond actionCount predicate (scene .zero' situation)) ∧
      HostPossesses faithfulReport .id ∧ ¬ HostPossesses faithfulReport .zero' :=
  ⟨fun actionCount predicate situation =>
      generatedDiamond_agent_independent actionCount predicate .id .zero' situation,
    id_possesses_faithfulReport, zero'_not_possesses_faithfulReport⟩

/-- **The agent enters through deliberation.**  A response of the agent is an
action that deliberation takes. -/
theorem respondsWith_deliberates (actionCount : ℕ) {agent : Code} {situation response : ℕ}
    (responds : RespondsWith agent situation response) :
    Relation.ReflTransGen (ChoiceStep actionCount) (scene agent situation) (did response situation) := by
  obtain ⟨rest, halts⟩ := responds
  exact deliberation_reaches actionCount halts

/-! ## Verdicts over the language -/

section Verdicts

variable (actionCount : ℕ) (ideal violation : Pattern → Prop)

/-- The deontic verdict on doing an action at a scene. -/
noncomputable def deonticVerdict (agent : Code) (situation action : ℕ) : DeonticAttribute :=
  (generatedDeonticSemantics actionCount violation).verdict (doing action) (scene agent situation)

/-- The value verdict on doing an action at a scene. -/
noncomputable def valueVerdict (agent : Code) (situation action : ℕ) : MoralValueAttribute :=
  (generatedValueSemantics actionCount ideal violation).verdict (doing action) (scene agent situation)

/-- **Deontic and value verdicts agree exactly away from the three divergences.** -/
theorem deontic_value_agree_iff (agent : Code) (situation action : ℕ) :
    deonticToMoralValue (deonticVerdict actionCount violation agent situation action) =
        valueVerdict actionCount ideal violation agent situation action ↔
      ¬ Supererogatory (generatedDeonticSemantics actionCount violation)
          (generatedValueSemantics actionCount ideal violation) (doing action) (scene agent situation) ∧
        ¬ ObligatoryNotGood (generatedDeonticSemantics actionCount violation)
          (generatedValueSemantics actionCount ideal violation) (doing action) (scene agent situation) ∧
        ¬ ProhibitedGood (generatedDeonticSemantics actionCount violation)
          (generatedValueSemantics actionCount ideal violation) (doing action) (scene agent situation) :=
  verdicts_agree_iff _ _ (generated_agreeOnProhibition actionCount ideal violation) _ _

/-- The utility of an outcome world. -/
noncomputable def outcomeUtility (world : Pattern) : ℤ :=
  if ideal world then 1 else if violation world then -1 else 0

/-- The utility of an act at a scene: the utility of the outcome the generated
modality reaches through it. -/
noncomputable def actUtility (agent : Code) (situation action : ℕ) : ℤ :=
  if reaches : ∃ value : ℤ, ActReaches actionCount
      (fun world => outcomeUtility ideal violation world = value) agent situation action
  then reaches.choose else 0

noncomputable def utilityVerdict (agent : Code) (situation action : ℕ) : MoralValueAttribute :=
  utilityToMoralValue (actUtility actionCount ideal violation agent situation action)

/-- The vice whose target is reaching a violation through the act. -/
def violationVice : VirtueSpec Code ℕ ℕ Unit where
  valence := .vice
  field _ := True
  basis := Set.univ
  basis_nonempty := ⟨(), trivial⟩
  mode _ _ action := action < actionCount
  target agent situation action := ActReaches actionCount violation agent situation action

noncomputable def targetVirtueVerdict (agent : Code) (situation action : ℕ) : MoralValueAttribute :=
  if (idealVirtue actionCount (fun _ => True) ideal).ActionHitsTarget agent situation action then
    .MorallyGood
  else if (violationVice actionCount violation).ActionHitsTarget agent situation action then
    .MorallyBad
  else .MorallyPermissible

theorem actUtility_eq {agent : Code} {situation action : ℕ} (inRange : action < actionCount) :
    actUtility actionCount ideal violation agent situation action =
      outcomeUtility ideal violation (did action situation) := by
  have reaches : ∃ value : ℤ, ActReaches actionCount
      (fun world => outcomeUtility ideal violation world = value) agent situation action :=
    ⟨_, (actReaches_iff _ _ _ _ _).mpr ⟨inRange, rfl⟩⟩
  rw [actUtility, dif_pos reaches]
  exact ((actReaches_iff _ _ _ _ _).mp reaches.choose_spec).2.symm

theorem valueVerdict_eq {agent : Code} {situation action : ℕ} (inRange : action < actionCount) :
    valueVerdict actionCount ideal violation agent situation action =
      if ideal (did action situation) then .MorallyGood
      else if violation (did action situation) then .MorallyBad else .MorallyPermissible := by
  have bad : (generatedValueSemantics actionCount ideal violation).morally .MorallyBad (doing action)
      (scene agent situation) ↔ violation (did action situation) :=
    (prohibition_doing_scene actionCount violation agent situation action).trans
      ⟨fun notAvoids => not_not.mp fun avoids => notAvoids ⟨inRange, avoids⟩,
        fun violates avoids => avoids.2 violates⟩
  simp only [valueVerdict, ValueSemantics.verdict, good_doing_scene, bad, inRange, true_and]

/-- **Utilitarian and target-centered verdicts equal the value verdict** at every
declared action. -/
theorem paradigms_agree_over_language (agent : Code) (situation : ℕ) {action : ℕ}
    (inRange : action < actionCount) :
    utilityVerdict actionCount ideal violation agent situation action =
        valueVerdict actionCount ideal violation agent situation action ∧
      targetVirtueVerdict actionCount ideal violation agent situation action =
        valueVerdict actionCount ideal violation agent situation action := by
  rw [valueVerdict_eq actionCount ideal violation inRange]
  by_cases reachesIdeal : ideal (did action situation)
  · simp [utilityVerdict, targetVirtueVerdict, actUtility_eq _ _ _ inRange, outcomeUtility,
      actReaches_iff, VirtueSpec.ActionHitsTarget, idealVirtue, inRange, reachesIdeal,
      utilityToMoralValue]
  · by_cases reachesViolation : violation (did action situation)
    · simp [utilityVerdict, targetVirtueVerdict, actUtility_eq _ _ _ inRange, outcomeUtility,
        actReaches_iff, VirtueSpec.ActionHitsTarget, idealVirtue, violationVice, inRange,
        reachesIdeal, reachesViolation, utilityToMoralValue]
    · simp [utilityVerdict, targetVirtueVerdict, actUtility_eq _ _ _ inRange, outcomeUtility,
        actReaches_iff, VirtueSpec.ActionHitsTarget, idealVirtue, violationVice, inRange,
        reachesIdeal, reachesViolation, utilityToMoralValue]

end Verdicts

/-! ## The rescue specimen -/

open Mettapedia.Ethics.MoralParadigmEquivalence

def situationIndex : MoralParadigmEquivalence.RescueSituation → ℕ
  | .ordinary => 0
  | .emergency => 1

def actionIndex : MoralParadigmEquivalence.RescueAction → ℕ
  | .wait => 0
  | .cross => 1

theorem actionIndex_lt_two (action : MoralParadigmEquivalence.RescueAction) : actionIndex action < 2 := by
  cases action <;> decide

/-- Crossing in an emergency. -/
def rescueIdeal (world : Pattern) : Prop := world = did 1 1

/-- Crossing when there is no emergency. -/
def rescueViolation (world : Pattern) : Prop := world = did 1 0

theorem did_ne_did_left {action action' situation situation' : ℕ} (different : action ≠ action') :
    did action situation ≠ did action' situation' := fun same => different (did_injective same).1

theorem did_ne_did_right {action action' situation situation' : ℕ}
    (different : situation ≠ situation') : did action situation ≠ did action' situation' :=
  fun same => different (did_injective same).2

/-- The value verdict over the language is the rescue judgment. -/
theorem rescue_value_verdict (agent : Code) :
    JudgmentEquivalent
      (fun (_ : Unit) situation action =>
        valueVerdict 2 rescueIdeal rescueViolation agent (situationIndex situation) (actionIndex action))
      rescueJudgment := by
  intro _ situation action
  dsimp only
  rw [valueVerdict_eq 2 rescueIdeal rescueViolation (actionIndex_lt_two action)]
  cases situation <;> cases action <;>
    simp [situationIndex, actionIndex, rescueIdeal, rescueViolation, rescueJudgment, did_ne_did_left,
      did_ne_did_right]

/-- **The utilitarian and target-centered readings over the language agree with the
rescue judgment.** -/
theorem rescue_paradigms_agree_over_language (agent : Code) :
    JudgmentEquivalent (fun (_ : Unit) situation action =>
        utilityVerdict 2 rescueIdeal rescueViolation agent (situationIndex situation)
          (actionIndex action)) rescueJudgment ∧
      JudgmentEquivalent (fun (_ : Unit) situation action =>
        targetVirtueVerdict 2 rescueIdeal rescueViolation agent (situationIndex situation)
          (actionIndex action)) rescueJudgment := by
  have agree := fun (situation : MoralParadigmEquivalence.RescueSituation)
      (action : MoralParadigmEquivalence.RescueAction) =>
    paradigms_agree_over_language 2 rescueIdeal rescueViolation agent
      (situationIndex situation) (actionIndex_lt_two action)
  refine ⟨fun trivialAgent situation action => ?_, fun trivialAgent situation action => ?_⟩
  · exact (agree situation action).1.trans (rescue_value_verdict agent trivialAgent situation action)
  · exact (agree situation action).2.trans (rescue_value_verdict agent trivialAgent situation action)

/-- The deontic verdicts of the rescue specimen: crossing is prohibited in the
ordinary situation, so waiting is obligatory there; in an emergency neither
action violates, so both are permitted. -/
theorem rescue_deontic_verdict (agent : Code) :
    deonticVerdict 2 rescueViolation agent 0 1 = .Prohibition ∧
      deonticVerdict 2 rescueViolation agent 0 0 = .Obligation ∧
      deonticVerdict 2 rescueViolation agent 1 1 = .Permission ∧
      deonticVerdict 2 rescueViolation agent 1 0 = .Permission := by
  simp only [deonticVerdict, DeonticSemantics.verdict, prohibition_doing_scene, obligation_doing_scene,
    rescueViolation]
  refine ⟨by simp, ?_, ?_, ?_⟩
  · rw [if_neg (by simp [did_ne_did_left]), if_pos]
    intro other inRange different
    interval_cases other
    · exact absurd rfl different
    · rfl
  · rw [if_neg (by simp [did_ne_did_right]), if_neg]
    intro obligatory
    exact did_ne_did_left (by decide) (obligatory 0 (by decide) (by decide))
  · rw [if_neg (by simp [did_ne_did_left]), if_neg]
    intro obligatory
    exact did_ne_did_right (by decide) (obligatory 1 (by decide) (by decide))

/-- **Crossing in an emergency is supererogatory.** -/
theorem rescue_emergency_crossing_supererogatory (agent : Code) :
    Supererogatory (generatedDeonticSemantics 2 rescueViolation)
      (generatedValueSemantics 2 rescueIdeal rescueViolation) (doing 1) (scene agent 1) := by
  refine ⟨(good_doing_scene _ _ _ _ _ _).mpr ⟨by decide, rfl⟩,
    (permission_doing_scene _ _ _ _ _).mpr ⟨by decide, did_ne_did_right (by decide)⟩, fun obligatory => ?_⟩
  exact did_ne_did_left (by decide)
    ((obligation_doing_scene _ _ _ _ _).mp obligatory 0 (by decide) (by decide))

/-- **Waiting in the ordinary situation is obligatory but not good.** -/
theorem rescue_ordinary_waiting_obligatory_not_good (agent : Code) :
    ObligatoryNotGood (generatedDeonticSemantics 2 rescueViolation)
      (generatedValueSemantics 2 rescueIdeal rescueViolation) (doing 0) (scene agent 0) := by
  refine ⟨(obligation_doing_scene _ _ _ _ _).mpr fun other inRange different => ?_,
    (permission_doing_scene _ _ _ _ _).mpr ⟨by decide, did_ne_did_left (by decide)⟩,
    fun good => did_ne_did_left (by decide) ((good_doing_scene _ _ _ _ _ _).mp good).2⟩
  interval_cases other
  · exact absurd rfl different
  · rfl

/-- **No violation predicate alone yields the rescue judgment.**  Crossing in an
emergency is good, so it must be obligatory, so waiting must violate; but waiting
in an emergency is permissible. -/
theorem rescue_judgment_not_deontic :
    ¬ ∃ violation : Pattern → Prop, ∀ agent situation action,
      deonticToMoralValue (deonticVerdict 2 violation agent (situationIndex situation)
        (actionIndex action)) = rescueJudgment () situation action := by
  rintro ⟨violation, same⟩
  have cross := (deonticToMoralValue_eq_iff _ _).mp (same .zero' .emergency .cross)
  have wait := (deonticToMoralValue_eq_iff _ _).mp (same .zero' .emergency .wait)
  simp only [situationIndex, actionIndex, rescueJudgment, moralValueToDeontic] at cross wait
  obtain ⟨-, crossObligatory⟩ := (DeonticSemantics.verdict_eq_obligation_iff _ _ _).mp cross
  have waitViolates := (obligation_doing_scene _ _ _ _ _).mp crossObligatory 0 (by decide) (by decide)
  obtain ⟨waitNotProhibited, -⟩ := (DeonticSemantics.verdict_eq_permission_iff _ _ _).mp wait
  exact waitNotProhibited
    ((prohibition_doing_scene _ _ _ _ _).mpr fun ⟨_, avoids⟩ => avoids waitViolates)

/-- The generated semantics do not satisfy the ontology's pointwise alignment of
deontic tags with value tags. -/
theorem rescue_not_aligned :
    ¬ ∀ tag formula world, (generatedDeonticSemantics 2 rescueViolation).deontic tag formula world ↔
      (generatedValueSemantics 2 rescueIdeal rescueViolation).morally (deonticToMoralValue tag)
        formula world := by
  intro aligned
  have superogatory := rescue_emergency_crossing_supererogatory .zero'
  exact ((aligned .Permission (doing 1) (scene .zero' 1)).mp superogatory.2.1).2 superogatory.1

/-- **A prohibited good**: an outcome that is both ideal and a violation. -/
theorem conflict_prohibited_good (agent : Code) :
    ProhibitedGood (generatedDeonticSemantics 2 fun world => world = did 0 0)
      (generatedValueSemantics 2 (fun world => world = did 0 0) fun world => world = did 0 0)
      (doing 0) (scene agent 0) :=
  ⟨(good_doing_scene _ _ _ _ _ _).mpr ⟨by decide, rfl⟩,
    (prohibition_doing_scene _ _ _ _ _).mpr fun ⟨_, avoids⟩ => avoids rfl⟩

/-! ## The rescue specimen in grades -/

/-- The graded reading of the generated deontic and value semantics. -/
noncomputable def generatedGradedSemantics (actionCount : ℕ) (ideal violation : Pattern → Prop) :
    GradedSemantics Pattern :=
  GradedSemantics.ofDeonticValue (generatedDeonticSemantics actionCount violation)
    (generatedValueSemantics actionCount ideal violation)

theorem generated_grade_exists_iff (actionCount : ℕ) (ideal violation : Pattern → Prop)
    (formula : Formula Pattern) (world : Pattern) :
    (∃ grade, (generatedGradedSemantics actionCount ideal violation).graded grade formula world) ↔
      ¬ ObligatoryNotGood (generatedDeonticSemantics actionCount violation)
          (generatedValueSemantics actionCount ideal violation) formula world ∧
        ¬ ProhibitedGood (generatedDeonticSemantics actionCount violation)
          (generatedValueSemantics actionCount ideal violation) formula world :=
  GradedSemantics.ofDeonticValue_exists_iff (generated_agreeOnProhibition actionCount ideal violation)
    formula world

/-- **The rescue specimen in grades.** -/
theorem rescue_grades (agent : Code) :
    (generatedGradedSemantics 2 rescueIdeal rescueViolation).graded .supererogatory (doing 1)
        (scene agent 1) ∧
      (generatedGradedSemantics 2 rescueIdeal rescueViolation).graded .permissible (doing 0)
        (scene agent 1) ∧
      (generatedGradedSemantics 2 rescueIdeal rescueViolation).graded .prohibited (doing 1)
        (scene agent 0) ∧
      ¬ ∃ grade, (generatedGradedSemantics 2 rescueIdeal rescueViolation).graded grade (doing 0)
        (scene agent 0) := by
  obtain ⟨ordinaryCross, -, emergencyCross, emergencyWait⟩ := rescue_deontic_verdict agent
  have value := rescue_value_verdict agent ()
  refine ⟨(GradedSemantics.ofDeonticValue_supererogatory_iff (generated_agreeOnProhibition _ _ _) _ _).mpr
      (rescue_emergency_crossing_supererogatory agent), ⟨emergencyWait, value .emergency .wait⟩,
    ⟨ordinaryCross, value .ordinary .cross⟩, fun graded => ?_⟩
  exact ((generated_grade_exists_iff _ _ _ _ _).mp graded).1
    (rescue_ordinary_waiting_obligatory_not_good agent)

/-- A dilemma in the language, and its absence in the rescue specimen. -/
theorem dilemma_controls (agent : Code) :
    DeonticMoralDilemma (generatedDeonticSemantics 2 fun world => doing 0 world ∨ doing 1 world)
        (scene agent 0) (choicePointOf 2 (scene agent 0)) ∧
      ¬ DeonticMoralDilemma (generatedDeonticSemantics 2 rescueViolation) (scene agent 0)
        (choicePointOf 2 (scene agent 0)) := by
  refine ⟨(deonticDilemma_iff _ _ _ _).mpr fun action inRange => ?_, fun dilemma => ?_⟩
  · interval_cases action
    · exact .inl ⟨0, rfl⟩
    · exact .inr ⟨0, rfl⟩
  · have := ((deonticDilemma_iff _ _ _ _).mp dilemma) 0 (by decide)
    exact did_ne_did_left (by decide) this

