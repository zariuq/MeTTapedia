import Mathlib.Tactic
import Mathlib.Analysis.InnerProductSpace.PiL2

/-!
# Gradient-based sample selection

Aljundi, Lin, Goujaud, and Bengio (2019), *Gradient Based Sample
Selection for Online Continual Learning*, formulate replay-buffer selection
as reduction of the half-space constraints generated by previous sample
gradients.  Their Equation (8) identifies minimization of the sum of pairwise
cosine similarities with maximization of directional variance.

This file proves the finite-dimensional algebra behind that identity and
isolates two boundaries needed when the surrogate is used as a retention
certificate:

* removing constraints can only enlarge the feasible cone, and the
  enlargement can be strict;
* the pairwise-similarity surrogate is exactly the squared norm of the sum of
  the normalized gradients, so equal surrogate values need not determine
  equal feasible cones.

The source's numerical correlation between the surrogate and solid angle is
therefore kept as empirical evidence, not promoted to a theorem.  The
normalization hypothesis is also explicit: adding one to a unit-vector cosine
makes the score nonnegative, not strictly positive, because antipodal vectors
attain zero.
-/

namespace Mettapedia.MachineLearning.ContinualLearning

namespace GradientBasedSampleSelection

noncomputable section

open scoped BigOperators InnerProductSpace

/-! ## Constraint reduction -/

variable {Parameter : Type*}
  [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]

/-- The cone of proposed descent directions satisfying every retained
first-order replay constraint.  This is the set-theoretic form of Equations
(3) and (4). -/
def FeasibleCone (constraints : Set Parameter) : Set Parameter :=
  { direction |
    ∀ reference ∈ constraints, 0 ≤ ⟪direction, reference⟫_ℝ }

/-- Selecting a subset of replay constraints relaxes the feasible region:
the original cone is contained in the selected cone. -/
theorem feasibleCone_antitone
    {selected original : Set Parameter}
    (selection : selected ⊆ original) :
    FeasibleCone original ⊆ FeasibleCone selected := by
  intro direction feasible reference retained
  exact feasible reference (selection retained)

/-! ### Strict executable constraint-reduction fixture -/

abbrev ConstraintPlane := EuclideanSpace ℝ (Fin 2)

noncomputable def firstAxis : ConstraintPlane :=
  EuclideanSpace.single 0 1

noncomputable def secondAxis : ConstraintPlane :=
  EuclideanSpace.single 1 1

noncomputable def bothAxisConstraints : Set ConstraintPlane :=
  {firstAxis, secondAxis}

noncomputable def secondAxisConstraint : Set ConstraintPlane :=
  {secondAxis}

/-- This direction satisfies the retained second-axis constraint but violates
the discarded first-axis constraint. -/
noncomputable def releasedDirection : ConstraintPlane :=
  -firstAxis + secondAxis

/-- Constraint reduction can enlarge the feasible cone strictly, not merely
weakly. -/
theorem constraint_reduction_strictly_enlarges :
    secondAxisConstraint ⊆ bothAxisConstraints ∧
      releasedDirection ∈ FeasibleCone secondAxisConstraint ∧
      releasedDirection ∉ FeasibleCone bothAxisConstraints := by
  constructor
  · rintro reference rfl
    simp [bothAxisConstraints]
  constructor
  · intro reference retained
    simp [secondAxisConstraint] at retained
    subst reference
    norm_num [releasedDirection, firstAxis, secondAxis,
      EuclideanSpace.inner_single_right]
  · intro feasible
    have firstConstraint :=
      feasible firstAxis (by simp [bothAxisConstraints])
    norm_num [releasedDirection, firstAxis, secondAxis,
      EuclideanSpace.inner_single_right] at firstConstraint

/-! ## Pairwise similarity and directional variance -/

variable {Index : Type*} [Fintype Index]

/-- Arithmetic mean of the supplied gradient directions. -/
def meanDirection (gradient : Index → Parameter) : Parameter :=
  ((Fintype.card Index : ℝ)⁻¹) • ∑ index, gradient index

/-- The pairwise inner-product objective.  On normalized gradients this is
the source's cosine-similarity surrogate. -/
def pairwiseSimilarity (gradient : Index → Parameter) : ℝ :=
  ∑ left, ∑ right, ⟪gradient left, gradient right⟫_ℝ

/-- Directional variance in the form displayed in the first line of the
source's Equation (8). -/
def directionalVariance (gradient : Index → Parameter) : ℝ :=
  ((Fintype.card Index : ℝ)⁻¹) *
      ∑ index, ‖gradient index‖ ^ 2 -
    ⟪meanDirection gradient, meanDirection gradient⟫_ℝ

/-- The pairwise-similarity objective is the squared norm of the resultant
gradient direction. -/
theorem pairwiseSimilarity_eq_norm_sum_sq
    (gradient : Index → Parameter) :
    pairwiseSimilarity gradient =
      ‖∑ index, gradient index‖ ^ 2 := by
  rw [← real_inner_self_eq_norm_sq]
  unfold pairwiseSimilarity
  rw [sum_inner]
  simp_rw [inner_sum]

/-- In particular, the source surrogate is always nonnegative. -/
theorem pairwiseSimilarity_nonnegative
    (gradient : Index → Parameter) :
    0 ≤ pairwiseSimilarity gradient := by
  rw [pairwiseSimilarity_eq_norm_sum_sq]
  positivity

omit [Fintype Index] in
/-- Scaling both slots of the mean inner product extracts the square of the
inverse cardinality. -/
private theorem meanDirection_inner_self
    [Fintype Index] (gradient : Index → Parameter) :
    ⟪meanDirection gradient, meanDirection gradient⟫_ℝ =
      ((Fintype.card Index : ℝ)⁻¹) ^ 2 *
        pairwiseSimilarity gradient := by
  unfold meanDirection pairwiseSimilarity
  rw [real_inner_smul_left, real_inner_smul_right]
  rw [sum_inner]
  simp_rw [inner_sum]
  ring

/-- General variance identity, before assuming that the gradients have been
normalized. -/
theorem directionalVariance_eq_averageNormSq_sub_similarity
    (gradient : Index → Parameter) :
    directionalVariance gradient =
      ((Fintype.card Index : ℝ)⁻¹) *
          ∑ index, ‖gradient index‖ ^ 2 -
        ((Fintype.card Index : ℝ)⁻¹) ^ 2 *
          pairwiseSimilarity gradient := by
  rw [directionalVariance, meanDirection_inner_self]

variable [Nonempty Index]

/-- Equation (8): for unit gradient directions, variance is one minus the
cardinality-normalized pairwise cosine objective. -/
theorem directionalVariance_eq_one_sub_similarity
    (gradient : Index → Parameter)
    (unit : ∀ index, ‖gradient index‖ = 1) :
    directionalVariance gradient =
      1 - ((Fintype.card Index : ℝ)⁻¹) ^ 2 *
        pairwiseSimilarity gradient := by
  rw [directionalVariance_eq_averageNormSq_sub_similarity]
  have normSum :
      ∑ index, ‖gradient index‖ ^ 2 =
        (Fintype.card Index : ℝ) := by
    simp_rw [unit]
    simp
  rw [normSum]
  have cardNonzero : (Fintype.card Index : ℝ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  rw [inv_mul_cancel₀ cardNonzero]

/-- For two fixed-size collections of unit directions, minimizing pairwise
similarity is exactly equivalent to maximizing directional variance. -/
theorem pairwiseSimilarity_le_iff_variance_ge
    (first second : Index → Parameter)
    (firstUnit : ∀ index, ‖first index‖ = 1)
    (secondUnit : ∀ index, ‖second index‖ = 1) :
    pairwiseSimilarity first ≤ pairwiseSimilarity second ↔
      directionalVariance second ≤ directionalVariance first := by
  rw [directionalVariance_eq_one_sub_similarity first firstUnit,
    directionalVariance_eq_one_sub_similarity second secondUnit]
  have positiveScale :
      0 < ((Fintype.card Index : ℝ)⁻¹) ^ 2 := by
    positivity
  constructor <;> intro comparison <;> nlinarith

/-! ## Equal-objective buffers with different feasible cones -/

noncomputable def oppositeFirstAxis : Fin 2 → ConstraintPlane :=
  fun index => if index = 0 then firstAxis else -firstAxis

noncomputable def oppositeSecondAxis : Fin 2 → ConstraintPlane :=
  fun index => if index = 0 then secondAxis else -secondAxis

theorem oppositeFirstAxis_unit
    (index : Fin 2) :
    ‖oppositeFirstAxis index‖ = 1 := by
  fin_cases index <;>
    simp [oppositeFirstAxis, firstAxis]

theorem oppositeSecondAxis_unit
    (index : Fin 2) :
    ‖oppositeSecondAxis index‖ = 1 := by
  fin_cases index <;>
    simp [oppositeSecondAxis, secondAxis]

theorem oppositeFirstAxis_pairwiseSimilarity :
    pairwiseSimilarity oppositeFirstAxis = 0 := by
  norm_num [pairwiseSimilarity, oppositeFirstAxis, firstAxis,
    Fin.sum_univ_two, EuclideanSpace.inner_single_left]

theorem oppositeSecondAxis_pairwiseSimilarity :
    pairwiseSimilarity oppositeSecondAxis = 0 := by
  norm_num [pairwiseSimilarity, oppositeSecondAxis, secondAxis,
    Fin.sum_univ_two, EuclideanSpace.inner_single_left]

theorem oppositeFirstAxis_directionalVariance :
    directionalVariance oppositeFirstAxis = 1 := by
  rw [directionalVariance_eq_one_sub_similarity
    oppositeFirstAxis oppositeFirstAxis_unit,
    oppositeFirstAxis_pairwiseSimilarity]
  norm_num

theorem oppositeSecondAxis_directionalVariance :
    directionalVariance oppositeSecondAxis = 1 := by
  rw [directionalVariance_eq_one_sub_similarity
    oppositeSecondAxis oppositeSecondAxis_unit,
    oppositeSecondAxis_pairwiseSimilarity]
  norm_num

/-- Finite-family feasibility, used to compare two same-size replay buffers. -/
def FamilyFeasible
    {FamilyIndex : Type*}
    (gradient : FamilyIndex → Parameter)
    (direction : Parameter) : Prop :=
  ∀ index, 0 ≤ ⟪direction, gradient index⟫_ℝ

theorem firstAxis_feasible_for_oppositeSecondAxis :
    FamilyFeasible oppositeSecondAxis firstAxis := by
  intro index
  fin_cases index <;>
    norm_num [FamilyFeasible, oppositeSecondAxis, firstAxis, secondAxis,
      EuclideanSpace.inner_single_left]

theorem firstAxis_not_feasible_for_oppositeFirstAxis :
    ¬ FamilyFeasible oppositeFirstAxis firstAxis := by
  intro feasible
  have negativeConstraint := feasible 1
  norm_num [oppositeFirstAxis, firstAxis,
    EuclideanSpace.inner_single_left] at negativeConstraint

/-- The diversity surrogate and directional variance do not determine the
retained feasible cone.  Two buffers have the same optimal objective values,
yet one permits `firstAxis` and the other forbids it. -/
theorem equal_surrogate_and_variance_but_different_feasible_cones :
    pairwiseSimilarity oppositeFirstAxis =
        pairwiseSimilarity oppositeSecondAxis ∧
      directionalVariance oppositeFirstAxis =
        directionalVariance oppositeSecondAxis ∧
      FamilyFeasible oppositeSecondAxis firstAxis ∧
      ¬ FamilyFeasible oppositeFirstAxis firstAxis := by
  exact ⟨by
      rw [oppositeFirstAxis_pairwiseSimilarity,
        oppositeSecondAxis_pairwiseSimilarity],
    by
      rw [oppositeFirstAxis_directionalVariance,
        oppositeSecondAxis_directionalVariance],
    firstAxis_feasible_for_oppositeSecondAxis,
    firstAxis_not_feasible_for_oppositeFirstAxis⟩

/-! ## The shifted-cosine score boundary -/

/-- The score used by the source's online greedy selector after its gradient
directions have been normalized. -/
def shiftedUnitSimilarity
    (first second : Parameter) : ℝ :=
  ⟪first, second⟫_ℝ + 1

/-- Unit-vector cosine bounds place the shifted score in the closed interval
`[0, 2]`. -/
theorem shiftedUnitSimilarity_mem_Icc
    (first second : Parameter)
    (firstUnit : ‖first‖ = 1)
    (secondUnit : ‖second‖ = 1) :
    shiftedUnitSimilarity first second ∈ Set.Icc 0 2 := by
  have absoluteBound := abs_real_inner_le_norm first second
  rw [firstUnit, secondUnit] at absoluteBound
  have lower := neg_le_of_abs_le absoluteBound
  have upper := le_of_abs_le absoluteBound
  constructor <;> unfold shiftedUnitSimilarity <;> linarith

/-- Adding one does not make the score strictly positive: antipodal unit
directions attain the zero boundary.  Any normalized sampling distribution
therefore needs a separately checked positive-total premise. -/
theorem antipodal_shiftedUnitSimilarity_eq_zero
    (direction : Parameter)
    (unit : ‖direction‖ = 1) :
    shiftedUnitSimilarity direction (-direction) = 0 := by
  simp [shiftedUnitSimilarity, unit]

/-! ## Missing-normalization boundary -/

abbrev SingletonIndex := Fin 1

def zeroDirection : SingletonIndex → ℝ :=
  fun _ => 0

/-- The constant-one form of Equation (8) is false without unit
normalization.  The general average-norm-square identity above remains valid. -/
theorem zero_direction_breaks_unit_variance_identity :
    directionalVariance zeroDirection ≠
      1 - ((Fintype.card SingletonIndex : ℝ)⁻¹) ^ 2 *
        pairwiseSimilarity zeroDirection := by
  norm_num [directionalVariance, meanDirection,
    pairwiseSimilarity, zeroDirection]

#print axioms feasibleCone_antitone
#print axioms constraint_reduction_strictly_enlarges
#print axioms pairwiseSimilarity_eq_norm_sum_sq
#print axioms directionalVariance_eq_one_sub_similarity
#print axioms pairwiseSimilarity_le_iff_variance_ge
#print axioms equal_surrogate_and_variance_but_different_feasible_cones
#print axioms antipodal_shiftedUnitSimilarity_eq_zero
#print axioms zero_direction_breaks_unit_variance_identity

end

end GradientBasedSampleSelection

end Mettapedia.MachineLearning.ContinualLearning
