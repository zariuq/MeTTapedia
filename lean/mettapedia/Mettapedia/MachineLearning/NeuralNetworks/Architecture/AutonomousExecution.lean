#print axioms commands_eq_of_observationTrajectory_eq
#print axioms autonomous_observation_eq_scheduled_iff_generatedCommands_eq
#print axioms autonomousTrajectory_eq_replicate_of_absorbingHalt
#print axioms autonomousObservationTrajectory_eq_replicate_of_absorbingHalt
#print axioms alternatingController_realizes_itinerary
#print axioms frozenZeroController_fails_alternating_itinerary
#print axioms frozenController_alwaysHalt_absorbing
#print axioms declaredHalt_without_absorption_can_move
#print axioms jointFixedPoint_does_not_imply_declaredHalt
#print axioms observation_equivalence_does_not_identify_opaque_commands

end Mettapedia.MachineLearning.NeuralNetworks.Architecture
