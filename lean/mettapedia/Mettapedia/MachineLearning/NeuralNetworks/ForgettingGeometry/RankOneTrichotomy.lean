import Mettapedia.MachineLearning.NeuralNetworks.ForgettingGeometry.MetricDictionary
import Mettapedia.MachineLearning.NeuralNetworks.PredictiveCoding.CausalDirectionIdentifiability

/-!
# Rank-one curvature trichotomy

Two symmetric rank-one task curvatures are put in a two-dimensional normal
form.  Parallel directions commute but can still duplicate evidence,
orthogonal directions have zero cross-action, and genuinely oblique
directions have a nonzero commutator.

The final bridge keeps two notions separate: absence of task-order signal for
commuting curvatures and observational energy blindness in a fitted Gaussian
DAG are both proved boundaries, but they are not asserted to be equivalent
causal-identifiability criteria.
-/

namespace Mettapedia.MachineLearning.NeuralNetworks.ForgettingGeometry

open Mettapedia.MachineLearning.NeuralNetworks.PredictiveCoding

/-- Projection onto the first coordinate axis. -/
noncomputable def axisRankOneCurvature : Matrix (Fin 2) (Fin 2) ℝ :=
  !![1, 0; 0, 0]

/-- Rank-one curvature generated by the direction `(x,y)`. -/
noncomputable def directionRankOneCurvature (x y : ℝ) :
    Matrix (Fin 2) (Fin 2) ℝ :=
  !![x ^ 2, x * y; x * y, y ^ 2]

/-- The displayed curvature really is the outer product of its direction. -/
theorem directionRankOneCurvature_eq_vecMulVec (x y : ℝ) :
    directionRankOneCurvature x y =
      Matrix.vecMulVec (![x, y] : Fin 2 → ℝ) ![x, y] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [directionRankOneCurvature, Matrix.vecMulVec] <;> ring

theorem axisRankOneCurvature_isSymm : axisRankOneCurvature.IsSymm := by
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [axisRankOneCurvature]

theorem directionRankOneCurvature_isSymm (x y : ℝ) :
    (directionRankOneCurvature x y).IsSymm := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [directionRankOneCurvature]

/-- Exact connection-curvature normal form. -/
theorem rankOne_commutator_exact (x y : ℝ) :
    directionRankOneCurvature x y * axisRankOneCurvature -
        axisRankOneCurvature * directionRankOneCurvature x y =
      !![0, -(x * y); x * y, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [directionRankOneCurvature, axisRankOneCurvature]

/-- Parallel rank-one directions have zero curvature commutator. -/
theorem parallel_rankOne_commutator_zero (x : ℝ) :
    directionRankOneCurvature x 0 * axisRankOneCurvature -
        axisRankOneCurvature * directionRankOneCurvature x 0 = 0 := by
  rw [rankOne_commutator_exact]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

/-- Orthogonal rank-one directions have no cross-action in either order. -/
theorem orthogonal_rankOne_crossAction_zero (y : ℝ) :
    directionRankOneCurvature 0 y * axisRankOneCurvature = 0 ∧
      axisRankOneCurvature * directionRankOneCurvature 0 y = 0 := by
  constructor <;>
    ext i j <;> fin_cases i <;> fin_cases j <;>
      simp [directionRankOneCurvature, axisRankOneCurvature,
        Matrix.mul_apply, Fin.sum_univ_two]

/-- Genuinely oblique rank-one directions have nonzero connection
curvature. -/
theorem oblique_rankOne_commutator_nonzero
    (x y : ℝ) (hxy : x * y ≠ 0) :
    directionRankOneCurvature x y * axisRankOneCurvature -
        axisRankOneCurvature * directionRankOneCurvature x y ≠ 0 := by
  rw [rankOne_commutator_exact]
  intro hzero
  have h01 := congrArg (fun matrix => matrix 0 1) hzero
  change -(x * y) = 0 at h01
  exact hxy (neg_eq_zero.mp h01)

/-- Exact three-regime classification in the chosen rank-one normal form.
The oblique branch is stated using the algebraically exact condition
`x*y ≠ 0`. -/
theorem rankOne_parallel_orthogonal_oblique_trichotomy
    (x y : ℝ) :
    (y = 0 →
      directionRankOneCurvature x y * axisRankOneCurvature -
          axisRankOneCurvature * directionRankOneCurvature x y = 0) ∧
    (x = 0 →
      directionRankOneCurvature x y * axisRankOneCurvature = 0 ∧
        axisRankOneCurvature * directionRankOneCurvature x y = 0) ∧
    (x * y ≠ 0 →
      directionRankOneCurvature x y * axisRankOneCurvature -
          axisRankOneCurvature * directionRankOneCurvature x y ≠ 0) := by
  constructor
  · rintro rfl
    exact parallel_rankOne_commutator_zero x
  constructor
  · rintro rfl
    exact orthogonal_rankOne_crossAction_zero y
  · exact oblique_rankOne_commutator_nonzero x y

/-- Concrete negative fixture for the claim that every pair of rank-one
tasks is order independent. -/
theorem unitOblique_rankOne_noncommuting_negativeExample :
    directionRankOneCurvature 1 1 * axisRankOneCurvature ≠
      axisRankOneCurvature * directionRankOneCurvature 1 1 := by
  intro heq
  apply oblique_rankOne_commutator_nonzero 1 1 (by norm_num)
  exact sub_eq_zero.mpr heq

/-- Scope bridge, not an equivalence: the parallel task fixture erases the
quadratic update-order signal, while every fitted positive bivariate
covariance is independently blind to direction under observational PC
energy.  Intervention remains the identifying operation in the cited PC
model. -/
theorem commutingOrderSignal_and_observationalEnergyBlindness
    (covariance : PositiveBivariateCovariance) (x : ℝ) :
    directionRankOneCurvature x 0 * axisRankOneCurvature =
        axisRankOneCurvature * directionRankOneCurvature x 0 ∧
      ¬ covariance.SeparatesDirectionsByEnergy := by
  constructor
  · exact sub_eq_zero.mp (parallel_rankOne_commutator_zero x)
  · exact covariance.not_separatesDirectionsByEnergy

#print axioms rankOne_commutator_exact
#print axioms rankOne_parallel_orthogonal_oblique_trichotomy
#print axioms unitOblique_rankOne_noncommuting_negativeExample
#print axioms commutingOrderSignal_and_observationalEnergyBlindness

end Mettapedia.MachineLearning.NeuralNetworks.ForgettingGeometry
