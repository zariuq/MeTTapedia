import Mettapedia.MachineLearning.NeuralNetworks.CreditTransport.SettledCreditSpectralGeometry

/-!
# Output-latent credit geometry

This file gives a minimal two-stage nonlinear decoder in which prospective
settling at one deep latent site leaves the backpropagated-credit line after
two steps while retaining a strict descent inner product.  The output stage
is one scalar latent with decoder

`decoder (x, y) = x^2 + (3/2) y`

and half-squared output loss at target zero.  An exact line expansion verifies
that the declared task field is the first-order coefficient of this composed
loss; the departure is therefore generated by output-latent geometry rather
than by an unrelated vector field.
-/

namespace Mettapedia.MachineLearning.NeuralNetworks.CreditTransport

namespace OutputLatentCreditGeometry

open scoped BigOperators InnerProductSpace
open ProspectiveResidualSemantics
open SettledCreditSpectralGeometry
open CarrierCutHybridDescent
open DirectionalTaskDescent

noncomputable section

abbrev Plane := EuclideanSpace ℝ (Fin 2)

/-- A convenient constructor for the two deep-latent coordinates. -/
noncomputable def plane (first second : ℝ) : Plane :=
  (WithLp.equiv 2 (Fin 2 → ℝ)).symm ![first, second]

/-- Read Euclidean coordinates for comparison with logged credit vectors. -/
def coordinates (state : Plane) : Fin 2 → ℝ :=
  WithLp.equiv 2 (Fin 2 → ℝ) state

@[simp] theorem coordinates_plane_zero (first second : ℝ) :
    coordinates (plane first second) 0 = first := by
  simp [coordinates, plane, WithLp.equiv]

@[simp] theorem coordinates_plane_one (first second : ℝ) :
    coordinates (plane first second) 1 = second := by
  simp [coordinates, plane, WithLp.equiv]

/-- Nonlinear deep-to-output decoder with one scalar output latent. -/
def decoder (state : Plane) : ℝ :=
  (state 0) ^ 2 + (3 / 2 : ℝ) * state 1

/-- Gradient of the decoder with respect to the two deep coordinates. -/
noncomputable def decoderGradient (state : Plane) : Plane :=
  plane (2 * state 0) (3 / 2)

/-- Half-squared scalar output loss at target zero. -/
def outputHalfSquaredLoss (state : Plane) : ℝ :=
  (1 / 2 : ℝ) * decoder state ^ 2

/-- Chain-rule task field at the deep latent site. -/
noncomputable def outputLatentTaskGradient (state : Plane) : Plane :=
  decoder state • decoderGradient state

/-- Linear coefficient of the decoder along a deep-latent direction. -/
def decoderLinearCoefficient (state direction : Plane) : ℝ :=
  2 * state 0 * direction 0 + (3 / 2 : ℝ) * direction 1

/-- Quadratic coefficient of the decoder along a deep-latent direction. -/
def decoderQuadraticCoefficient (direction : Plane) : ℝ :=
  direction 0 ^ 2

/-- Exact decoder expansion along every line. -/
theorem decoder_line_expansion (state direction : Plane) (time : ℝ) :
    decoder (state + time • direction) =
      decoder state + time * decoderLinearCoefficient state direction +
        time ^ 2 * decoderQuadraticCoefficient direction := by
  simp only [decoder, decoderLinearCoefficient, decoderQuadraticCoefficient,
    PiLp.add_apply, PiLp.smul_apply]
  ring

/-- The chain-rule field has exactly the first-order loss coefficient. -/
theorem taskGradient_inner_eq_lossLinearCoefficient
    (state direction : Plane) :
    coordinateInner (coordinates (outputLatentTaskGradient state))
        (coordinates direction) =
      decoder state * decoderLinearCoefficient state direction := by
  simp [coordinateInner, coordinates, outputLatentTaskGradient,
    decoderGradient, decoderLinearCoefficient, plane, WithLp.equiv,
    Fin.sum_univ_two]
  ring

/-- Exact line expansion of the composed output loss.  The term linear in
`time` is the inner product with `outputLatentTaskGradient`; all remaining
terms have degree at least two. -/
theorem outputHalfSquaredLoss_line_expansion
    (state direction : Plane) (time : ℝ) :
    outputHalfSquaredLoss (state + time • direction) =
      outputHalfSquaredLoss state +
        time * coordinateInner
          (coordinates (outputLatentTaskGradient state))
          (coordinates direction) +
        time ^ 2 *
          ((1 / 2 : ℝ) * decoderLinearCoefficient state direction ^ 2 +
            decoder state * decoderQuadraticCoefficient direction) +
        time ^ 3 *
          (decoderLinearCoefficient state direction *
            decoderQuadraticCoefficient direction) +
        (1 / 2 : ℝ) * time ^ 4 *
          decoderQuadraticCoefficient direction ^ 2 := by
  rw [outputHalfSquaredLoss, decoder_line_expansion,
    outputHalfSquaredLoss, taskGradient_inner_eq_lossLinearCoefficient]
  ring

/-! ## Explicit two-step departure witness -/

/-- Feed-forward deep prediction. -/
noncomputable def prediction : Plane := plane 1 0

/-- Backpropagated task credit at the prediction. -/
noncomputable def bpCredit : Plane := outputLatentTaskGradient prediction

/-- The first prospective step, at unit precision and rate `1/2`. -/
noncomputable def firstState : Plane :=
  prospectiveGradientStep prediction 1 (1 / 2)
    outputLatentTaskGradient prediction

/-- The second prospective step. -/
noncomputable def settledState : Plane :=
  prospectiveGradientStep prediction 1 (1 / 2)
    outputLatentTaskGradient firstState

/-- State-space credit read after the two settling steps. -/
noncomputable def settledCredit : Plane := prediction - settledState

theorem bpCredit_eval : bpCredit = plane 2 (3 / 2) := by
  apply (WithLp.equiv 2 (Fin 2 → ℝ)).injective
  funext index
  fin_cases index <;>
    simp [bpCredit, outputLatentTaskGradient, decoderGradient, decoder,
      prediction, plane, WithLp.equiv]

theorem firstState_eval : firstState = plane 0 (-3 / 4) := by
  apply (WithLp.equiv 2 (Fin 2 → ℝ)).injective
  funext index
  fin_cases index <;>
    norm_num [firstState, prospectiveGradientStep, prospectiveEnergyGradient,
      outputLatentTaskGradient, decoderGradient, decoder, prediction, plane,
      WithLp.equiv]

theorem settledState_eval : settledState = plane (1 / 2) (15 / 32) := by
  rw [settledState, firstState_eval]
  apply (WithLp.equiv 2 (Fin 2 → ℝ)).injective
  funext index
  fin_cases index <;>
    norm_num [prospectiveGradientStep, prospectiveEnergyGradient,
      outputLatentTaskGradient, decoderGradient, decoder, prediction, plane,
      WithLp.equiv]

theorem settledCredit_eval : settledCredit = plane (1 / 2) (-15 / 32) := by
  rw [settledCredit, prediction, settledState_eval]
  apply (WithLp.equiv 2 (Fin 2 → ℝ)).injective
  funext index
  fin_cases index <;> norm_num [plane, WithLp.equiv]

/-- Positive example: the first prospective step is exactly rate-scaled BP,
as required by the general ignition theorem. -/
theorem firstStepCredit_eq_half_smul_bpCredit :
    prediction - firstState = (1 / 2 : ℝ) • bpCredit := by
  rw [prediction, firstState_eval, bpCredit_eval]
  apply (WithLp.equiv 2 (Fin 2 → ℝ)).injective
  funext index
  fin_cases index <;> norm_num [plane, WithLp.equiv]

/-- After the nonlinear second step, the deep settled credit is not any scalar
multiple of BP. -/
theorem settledCredit_not_smul_bpCredit :
    ¬ ∃ scale : ℝ, settledCredit = scale • bpCredit := by
  rintro ⟨scale, proportional⟩
  rw [settledCredit_eval, bpCredit_eval] at proportional
  have coordinates_equal := congrArg (WithLp.linearEquiv 2 ℝ (Fin 2 → ℝ))
    proportional
  rw [map_smul] at coordinates_equal
  have first := congrFun coordinates_equal 0
  have second := congrFun coordinates_equal 1
  simp [WithLp.linearEquiv, WithLp.equiv, plane] at first second
  norm_num at first second
  nlinarith

/-- The departed direction remains a strict descent direction for the task
gradient at the prediction. -/
theorem settledCredit_inner_bpCredit_pos :
    0 < ⟪settledCredit, bpCredit⟫_ℝ := by
  rw [settledCredit_eval, bpCredit_eval, PiLp.inner_apply]
  simp [RCLike.inner_apply, plane, WithLp.equiv, Fin.sum_univ_two]
  norm_num

/-- The positive deep-block margin lifts additively through an exact
supervised head, so the complete carrier-cut hybrid direction is aligned. -/
theorem hybridDirection_inner_productTaskGradient_pos
    {Head : Type*} [NormedAddCommGroup Head] [InnerProductSpace ℝ Head]
    (headGradient : Head) :
    0 < ⟪productTaskGradient bpCredit headGradient,
      hybridDirection settledCredit headGradient⟫_ℝ := by
  rw [productTaskGradient_inner_hybridDirection]
  have upstream_pos : 0 < ⟪bpCredit, settledCredit⟫_ℝ := by
    rw [real_inner_comm]
    exact settledCredit_inner_bpCredit_pos
  nlinarith [sq_nonneg ‖headGradient‖]

/-- With a directional quadratic upper model and a step inside its trust
bound, the departed output-latent credit yields a strict finite task decrease
for the full hybrid update. -/
theorem hybridDirection_strictTaskDescent
    {Head : Type*} [NormedAddCommGroup Head] [InnerProductSpace ℝ Head]
    {loss : ProductParameter Plane Head → ℝ}
    {parameter : ProductParameter Plane Head}
    (headGradient : Head) {curvature step : ℝ}
    (certificate : HasDirectionalTaskUpperModelAt loss parameter
      (productTaskGradient bpCredit headGradient)
      (hybridDirection settledCredit headGradient) curvature)
    (step_pos : 0 < step)
    (trust : step * curvature / 2 <
      ⟪productTaskGradient bpCredit headGradient,
        hybridDirection settledCredit headGradient⟫_ℝ) :
    loss (parameter - step • hybridDirection settledCredit headGradient) <
      loss parameter := by
  exact directionalTask_strict_descent certificate step_pos trust

theorem settledCredit_coordinateInner_bpCredit :
    coordinateInner (coordinates settledCredit) (coordinates bpCredit) =
      19 / 64 := by
  rw [settledCredit_eval, bpCredit_eval]
  norm_num [coordinateInner, coordinates, plane, WithLp.equiv,
    Fin.sum_univ_two]

theorem settledCredit_coordinateNormSq :
    coordinateNormSq (coordinates settledCredit) = 481 / 1024 := by
  rw [settledCredit_eval]
  norm_num [coordinateNormSq, coordinateInner, coordinates, plane,
    WithLp.equiv, Fin.sum_univ_two]

theorem bpCredit_coordinateNormSq :
    coordinateNormSq (coordinates bpCredit) = 25 / 4 := by
  rw [bpCredit_eval]
  norm_num [coordinateNormSq, coordinateInner, coordinates, plane,
    WithLp.equiv, Fin.sum_univ_two]

/-- Quantitative angle separation: the two-step settled credit has cosine
strictly below `1/5` with BP, while the preceding theorem proves its inner
product remains positive. -/
theorem settledCredit_coordinateCosine_lt_one_fifth :
    coordinateCosine (coordinates settledCredit) (coordinates bpCredit) <
      1 / 5 := by
  rw [coordinateCosine, settledCredit_coordinateInner_bpCredit,
    settledCredit_coordinateNormSq, bpCredit_coordinateNormSq]
  have root_pos : 0 < Real.sqrt ((481 / 1024 : ℝ) * (25 / 4)) := by
    positivity
  have threshold_sq_lt :
      (95 / 64 : ℝ) ^ 2 < (481 / 1024 : ℝ) * (25 / 4) := by
    norm_num
  have threshold_lt_root :
      (95 / 64 : ℝ) < Real.sqrt ((481 / 1024 : ℝ) * (25 / 4)) := by
    rw [Real.lt_sqrt (by norm_num : (0 : ℝ) ≤ 95 / 64)]
    exact threshold_sq_lt
  rw [div_lt_iff₀ root_pos]
  nlinarith

/-- The minimal output-latent witness simultaneously departs from BP, remains
a descent direction, and has a nontrivial angle gap. -/
theorem exists_outputLatent_departure_with_descent_and_angle :
    (¬ ∃ scale : ℝ, settledCredit = scale • bpCredit) ∧
      0 < ⟪settledCredit, bpCredit⟫_ℝ ∧
      coordinateCosine (coordinates settledCredit) (coordinates bpCredit) <
        1 / 5 :=
  ⟨settledCredit_not_smul_bpCredit, settledCredit_inner_bpCredit_pos,
    settledCredit_coordinateCosine_lt_one_fifth⟩

#print axioms outputHalfSquaredLoss_line_expansion
#print axioms firstStepCredit_eq_half_smul_bpCredit
#print axioms settledCredit_not_smul_bpCredit
#print axioms settledCredit_inner_bpCredit_pos
#print axioms hybridDirection_inner_productTaskGradient_pos
#print axioms hybridDirection_strictTaskDescent
#print axioms settledCredit_coordinateCosine_lt_one_fifth
#print axioms exists_outputLatent_departure_with_descent_and_angle

end
end OutputLatentCreditGeometry

end Mettapedia.MachineLearning.NeuralNetworks.CreditTransport
