import Mettapedia.MachineLearning.NeuralNetworks.WorkspaceDecoder.RoutedCaromCommutation
import Mathlib.Analysis.Calculus.MeanValue

/-!
# Routed CAROM: nonlinear command-order bounds

This file extends the exact affine command-order boundary to nonlinear
near-identity phases.  It separates three levels that must not be conflated:

* the exact finite-step swap discrepancy;
* its vector-field Lie-bracket leading term;
* a quantitative remainder derived from Lipschitz variation of the derivative.

It also transports a local adjacent-swap bound through the remaining command
schedule and accumulates a finite path of such swaps.  Thus a sampled JVP is a
diagnostic, while a schedule certificate additionally needs a state region,
derivative control, and tail amplification bounds.
-/

namespace Mettapedia.MachineLearning.NeuralNetworks.WorkspaceDecoder

open Function Set
open scoped Matrix
open Mettapedia.MachineLearning.NeuralNetworks.ForgettingGeometry

namespace RoutedCarom

universe uState uCommand

section NonlinearPhase

variable {State : Type uState} [NormedAddCommGroup State] [NormedSpace ℝ State]

/-- One explicit near-identity phase generated by a nonlinear vector field. -/
noncomputable def nearIdentityPhase
    (step : ℝ) (field : State → State) (state : State) : State :=
  state + step • field state

/-- Exact difference between the two orders `first; second` and
`second; first`. -/
noncomputable def nonlinearSwapDiscrepancy
    (step : ℝ) (first second : State → State) (state : State) : State :=
  nearIdentityPhase step second (nearIdentityPhase step first state) -
    nearIdentityPhase step first (nearIdentityPhase step second state)

/-- Finite-step commutator of two vector fields.  Unlike a Lie bracket, this
uses the actually displaced evaluation points. -/
noncomputable def finiteStepFieldCommutator
    (step : ℝ) (first second : State → State) (state : State) : State :=
  (second (state + step • first state) - second state) -
    (first (state + step • second state) - first state)

/-- The nonlinear swap discrepancy is exactly one further factor of the step
times the finite-step field commutator. -/
theorem nonlinearSwapDiscrepancy_exact
    (step : ℝ) (first second : State → State) (state : State) :
    nonlinearSwapDiscrepancy step first second state =
      step • finiteStepFieldCommutator step first second state := by
  simp only [nonlinearSwapDiscrepancy, nearIdentityPhase,
    finiteStepFieldCommutator]
  module

/-- First-order Taylor remainder at `base` along `increment`. -/
noncomputable def firstOrderRemainder
    (field : State → State) (derivative : State → State →L[ℝ] State)
    (base increment : State) : State :=
  field (base + increment) - field base - derivative base increment

/-- Pointwise vector-field Lie bracket in the execution-order convention used
by `matrixCommutator`: derivative of `second` along `first`, minus derivative
of `first` along `second`. -/
noncomputable def vectorFieldBracket
    (first second : State → State)
    (firstDerivative secondDerivative : State → State →L[ℝ] State)
    (state : State) : State :=
  secondDerivative state (first state) -
    firstDerivative state (second state)

/-- Exact decomposition of the finite-step field commutator into its linear
Lie-bracket term and the two Taylor remainders. -/
theorem finiteStepFieldCommutator_decomposition
    (step : ℝ) (first second : State → State)
    (firstDerivative secondDerivative : State → State →L[ℝ] State)
    (state : State) :
    finiteStepFieldCommutator step first second state =
      step • vectorFieldBracket first second firstDerivative secondDerivative state +
        firstOrderRemainder second secondDerivative state (step • first state) -
        firstOrderRemainder first firstDerivative state (step • second state) := by
  simp only [finiteStepFieldCommutator, vectorFieldBracket,
    firstOrderRemainder, map_smul]
  module

/-! ## A reusable derivative-Lipschitz Taylor bound -/

/-- A globally Lipschitz derivative gives a quadratic first-order remainder
bound.  The constant is deliberately conservative (`L`, rather than `L/2`),
because the mean-value theorem only uses the largest derivative variation on
the segment. -/
theorem norm_firstOrderRemainder_le
    (field : State → State) (derivative : State → State →L[ℝ] State)
    (lipschitz : NNReal)
    (hasDerivative : ∀ state, HasFDerivAt field (derivative state) state)
    (derivativeLipschitz : LipschitzWith lipschitz derivative)
    (base increment : State) :
    ‖firstOrderRemainder field derivative base increment‖ ≤
      (lipschitz : ℝ) * ‖increment‖ ^ 2 := by
  let remainder : State → State := fun state => field state - derivative base state
  let segmentSet : Set State := segment ℝ base (base + increment)
  have remainderDerivative : ∀ state ∈ segmentSet,
      HasFDerivWithinAt remainder (derivative state - derivative base)
        segmentSet state := by
    intro state hstate
    exact ((hasDerivative state).sub
      (derivative base).hasFDerivAt).hasFDerivWithinAt
  have derivativeBound : ∀ state ∈ segmentSet,
      ‖derivative state - derivative base‖ ≤
        (lipschitz : ℝ) * ‖increment‖ := by
    intro state hstate
    calc
      ‖derivative state - derivative base‖ ≤
          (lipschitz : ℝ) * ‖state - base‖ :=
        derivativeLipschitz.norm_sub_le state base
      _ ≤ (lipschitz : ℝ) * ‖(base + increment) - base‖ := by
        exact mul_le_mul_of_nonneg_left
          (norm_sub_le_of_mem_segment hstate) lipschitz.coe_nonneg
      _ = (lipschitz : ℝ) * ‖increment‖ := by simp
  have meanValue :=
    (convex_segment base (base + increment)).norm_image_sub_le_of_norm_hasFDerivWithin_le
      remainderDerivative derivativeBound
      (left_mem_segment ℝ base (base + increment))
      (right_mem_segment ℝ base (base + increment))
  calc
    ‖firstOrderRemainder field derivative base increment‖ =
        ‖remainder (base + increment) - remainder base‖ := by
      congr 1
      simp only [firstOrderRemainder, remainder, map_add]
      module
    _ ≤ ((lipschitz : ℝ) * ‖increment‖) *
          ‖(base + increment) - base‖ := meanValue
    _ = (lipschitz : ℝ) * ‖increment‖ ^ 2 := by
      simp [pow_two, mul_assoc]

/-- Nonlinear crown: the exact swap differs from `step²` times the Lie bracket
by a cubic bound controlled by derivative variation and the local field
magnitudes. -/
theorem norm_nonlinearSwapDiscrepancy_sub_lie_le
    (step : ℝ) (first second : State → State)
    (firstDerivative secondDerivative : State → State →L[ℝ] State)
    (firstLipschitz secondLipschitz : NNReal)
    (firstHasDerivative : ∀ state,
      HasFDerivAt first (firstDerivative state) state)
    (secondHasDerivative : ∀ state,
      HasFDerivAt second (secondDerivative state) state)
    (firstDerivativeLipschitz : LipschitzWith firstLipschitz firstDerivative)
    (secondDerivativeLipschitz : LipschitzWith secondLipschitz secondDerivative)
    (state : State) :
    ‖nonlinearSwapDiscrepancy step first second state -
        step ^ 2 • vectorFieldBracket first second
          firstDerivative secondDerivative state‖ ≤
      |step| ^ 3 *
        ((secondLipschitz : ℝ) * ‖first state‖ ^ 2 +
          (firstLipschitz : ℝ) * ‖second state‖ ^ 2) := by
  let secondRemainder :=
    firstOrderRemainder second secondDerivative state (step • first state)
  let firstRemainder :=
    firstOrderRemainder first firstDerivative state (step • second state)
  have exactDifference :
      nonlinearSwapDiscrepancy step first second state -
          step ^ 2 • vectorFieldBracket first second
            firstDerivative secondDerivative state =
        step • (secondRemainder - firstRemainder) := by
    rw [nonlinearSwapDiscrepancy_exact,
      finiteStepFieldCommutator_decomposition]
    dsimp only [secondRemainder, firstRemainder]
    module
  have secondBound : ‖secondRemainder‖ ≤
      (secondLipschitz : ℝ) * ‖step • first state‖ ^ 2 := by
    exact norm_firstOrderRemainder_le second secondDerivative secondLipschitz
      secondHasDerivative secondDerivativeLipschitz state (step • first state)
  have firstBound : ‖firstRemainder‖ ≤
      (firstLipschitz : ℝ) * ‖step • second state‖ ^ 2 := by
    exact norm_firstOrderRemainder_le first firstDerivative firstLipschitz
      firstHasDerivative firstDerivativeLipschitz state (step • second state)
  rw [exactDifference, norm_smul, Real.norm_eq_abs]
  calc
    |step| * ‖secondRemainder - firstRemainder‖ ≤
        |step| * (‖secondRemainder‖ + ‖firstRemainder‖) :=
      mul_le_mul_of_nonneg_left (norm_sub_le _ _) (abs_nonneg step)
    _ ≤ |step| *
        ((secondLipschitz : ℝ) * ‖step • first state‖ ^ 2 +
          (firstLipschitz : ℝ) * ‖step • second state‖ ^ 2) := by
      gcongr
    _ = |step| ^ 3 *
        ((secondLipschitz : ℝ) * ‖first state‖ ^ 2 +
          (firstLipschitz : ℝ) * ‖second state‖ ^ 2) := by
      simp only [norm_smul, Real.norm_eq_abs]
      ring

/-- A directly usable swap budget: the exact nonlinear discrepancy is at most
the quadratic Lie-bracket contribution plus the cubic Taylor remainder. -/
theorem norm_nonlinearSwapDiscrepancy_le
    (step : ℝ) (first second : State → State)
    (firstDerivative secondDerivative : State → State →L[ℝ] State)
    (firstLipschitz secondLipschitz : NNReal)
    (firstHasDerivative : ∀ state,
      HasFDerivAt first (firstDerivative state) state)
    (secondHasDerivative : ∀ state,
      HasFDerivAt second (secondDerivative state) state)
    (firstDerivativeLipschitz : LipschitzWith firstLipschitz firstDerivative)
    (secondDerivativeLipschitz : LipschitzWith secondLipschitz secondDerivative)
    (state : State) :
    ‖nonlinearSwapDiscrepancy step first second state‖ ≤
      |step| ^ 2 *
          ‖vectorFieldBracket first second
            firstDerivative secondDerivative state‖ +
        |step| ^ 3 *
          ((secondLipschitz : ℝ) * ‖first state‖ ^ 2 +
            (firstLipschitz : ℝ) * ‖second state‖ ^ 2) := by
  let leading := step ^ 2 • vectorFieldBracket first second
    firstDerivative secondDerivative state
  have remainderBound := norm_nonlinearSwapDiscrepancy_sub_lie_le
    step first second firstDerivative secondDerivative
    firstLipschitz secondLipschitz firstHasDerivative secondHasDerivative
    firstDerivativeLipschitz secondDerivativeLipschitz state
  calc
    ‖nonlinearSwapDiscrepancy step first second state‖ =
        ‖(nonlinearSwapDiscrepancy step first second state - leading) +
          leading‖ := by
      congr 1
      abel
    _ ≤ ‖nonlinearSwapDiscrepancy step first second state - leading‖ +
        ‖leading‖ := norm_add_le _ _
    _ ≤ |step| ^ 3 *
          ((secondLipschitz : ℝ) * ‖first state‖ ^ 2 +
            (firstLipschitz : ℝ) * ‖second state‖ ^ 2) +
        ‖leading‖ := by
      gcongr
    _ = |step| ^ 2 *
          ‖vectorFieldBracket first second
            firstDerivative secondDerivative state‖ +
        |step| ^ 3 *
          ((secondLipschitz : ℝ) * ‖first state‖ ^ 2 +
            (firstLipschitz : ℝ) * ‖second state‖ ^ 2) := by
      simp only [leading, norm_smul, Real.norm_eq_abs, abs_pow]
      ring

/-! ## Affine specialization -/

/-- Bias part of the Lie bracket of two affine vector fields.  Unlike
`affineBiasCommutator` for two directly composed affine phases, there is no
outer-minus-inner bias term: only each linear part acting on the other bias
remains. -/
noncomputable def affineVectorFieldBiasCommutator
    {Index : Type*} [Fintype Index]
    (first second : AffinePhase Index) : Index → ℝ :=
  second.linear *ᵥ first.bias - first.linear *ᵥ second.bias

/-- Affine vector fields recover an exact matrix-commutator plus vector-field
bias obstruction, scaled by `step²`; their nonlinear Taylor remainder is
zero. -/
theorem affineFields_nonlinearSwapDiscrepancy_exact
    {Index : Type*} [Fintype Index]
    (step : ℝ) (first second : AffinePhase Index) (state : Index → ℝ) :
    nonlinearSwapDiscrepancy step first.act second.act state =
      step ^ 2 •
        (matrixCommutator first.linear second.linear *ᵥ state +
          affineVectorFieldBiasCommutator first second) := by
  rw [nonlinearSwapDiscrepancy_exact]
  simp only [finiteStepFieldCommutator, AffinePhase.act, Matrix.mulVec_add,
    Matrix.mulVec_smul, smul_add]
  simp only [matrixCommutator, affineVectorFieldBiasCommutator, Matrix.sub_mulVec,
    Matrix.mulVec_mulVec]
  module

/-- Turn an affine vector field into its explicit near-identity Euler phase. -/
noncomputable def eulerAffinePhase
    {Index : Type*} [Fintype Index] [DecidableEq Index]
    (step : ℝ) (field : AffinePhase Index) : AffinePhase Index where
  linear := 1 + step • field.linear
  bias := step • field.bias

@[simp] theorem eulerAffinePhase_act
    {Index : Type*} [Fintype Index] [DecidableEq Index]
    (step : ℝ) (field : AffinePhase Index) (state : Index → ℝ) :
    (eulerAffinePhase step field).act state =
      nearIdentityPhase step field.act state := by
  simp [eulerAffinePhase, AffinePhase.act, nearIdentityPhase,
    Matrix.add_mulVec, Matrix.smul_mulVec]
  module

/-- The nonlinear swap of affine vector fields is literally the existing
affine-phase discrepancy after the Euler lift. -/
theorem eulerAffinePhase_discrepancy_eq_nonlinearSwap
    {Index : Type*} [Fintype Index] [DecidableEq Index]
    (step : ℝ) (first second : AffinePhase Index) (state : Index → ℝ) :
    affineCompositionDiscrepancy (eulerAffinePhase step first)
        (eulerAffinePhase step second) state =
      nonlinearSwapDiscrepancy step first.act second.act state := by
  simp [affineCompositionDiscrepancy, nonlinearSwapDiscrepancy]

/-- Corollary form connecting the nonlinear theorem back to the sealed affine
composition boundary. -/
theorem eulerAffinePhase_discrepancy_exact
    {Index : Type*} [Fintype Index] [DecidableEq Index]
    (step : ℝ) (first second : AffinePhase Index) (state : Index → ℝ) :
    affineCompositionDiscrepancy (eulerAffinePhase step first)
        (eulerAffinePhase step second) state =
      step ^ 2 •
        (matrixCommutator first.linear second.linear *ᵥ state +
          affineVectorFieldBiasCommutator first second) := by
  rw [eulerAffinePhase_discrepancy_eq_nonlinearSwap]
  exact affineFields_nonlinearSwapDiscrepancy_exact step first second state

/-! ## Schedule transport and finite accumulation -/

/-- Execute a finite list of nonlinear command maps in list order. -/
def runMapSchedule
    {Command : Type uCommand} (phase : Command → State → State) :
    List Command → State → State
  | [], state => state
  | command :: schedule, state =>
      runMapSchedule phase schedule (phase command state)

omit [NormedAddCommGroup State] [NormedSpace ℝ State] in
@[simp] theorem runMapSchedule_append
    {Command : Type uCommand} (phase : Command → State → State)
    (before after : List Command) (state : State) :
    runMapSchedule phase (before ++ after) state =
      runMapSchedule phase after (runMapSchedule phase before state) := by
  induction before generalizing state with
  | nil => rfl
  | cons command before ih =>
      simp only [List.cons_append, runMapSchedule]
      exact ih (phase command state)

omit [NormedSpace ℝ State] in
/-- A local adjacent swap is amplified only by the Lipschitz constant of the
remaining suffix.  The prefix merely determines the state at which the local
discrepancy must be certified. -/
theorem norm_runMapSchedule_adjacentSwap_le
    {Command : Type uCommand} (phase : Command → State → State)
    (before after : List Command) (first second : Command)
    (initial : State) (tailLipschitz : NNReal)
    (suffixBound : LipschitzWith tailLipschitz (runMapSchedule phase after)) :
    ‖runMapSchedule phase (before ++ first :: second :: after) initial -
        runMapSchedule phase (before ++ second :: first :: after) initial‖ ≤
      (tailLipschitz : ℝ) *
        ‖phase second (phase first (runMapSchedule phase before initial)) -
          phase first (phase second (runMapSchedule phase before initial))‖ := by
  rw [runMapSchedule_append, runMapSchedule_append]
  simp only [runMapSchedule]
  exact suffixBound.norm_sub_le _ _

/-- Schedule-level nonlinear crown.  The suffix amplification, quadratic
Lie-bracket contribution, and cubic derivative-variation remainder remain
separate in the final budget.  The prefix enters only through the reached
state, so the theorem applies to any prior command history. -/
theorem norm_nearIdentitySchedule_adjacentSwap_le
    {Command : Type uCommand}
    (step : ℝ) (field : Command → State → State)
    (derivative : Command → State → State →L[ℝ] State)
    (derivativeLipschitzConstant : Command → NNReal)
    (hasDerivative : ∀ command state,
      HasFDerivAt (field command) (derivative command state) state)
    (derivativeLipschitz : ∀ command,
      LipschitzWith (derivativeLipschitzConstant command)
        (derivative command))
    (before after : List Command) (first second : Command)
    (initial : State) (tailLipschitz : NNReal)
    (suffixBound : LipschitzWith tailLipschitz
      (runMapSchedule
        (fun command => nearIdentityPhase step (field command)) after)) :
    let prefixState := runMapSchedule
      (fun command => nearIdentityPhase step (field command)) before initial
    ‖runMapSchedule (fun command => nearIdentityPhase step (field command))
          (before ++ first :: second :: after) initial -
        runMapSchedule (fun command => nearIdentityPhase step (field command))
          (before ++ second :: first :: after) initial‖ ≤
      (tailLipschitz : ℝ) *
        (|step| ^ 2 *
            ‖vectorFieldBracket (field first) (field second)
              (derivative first) (derivative second) prefixState‖ +
          |step| ^ 3 *
            (((derivativeLipschitzConstant second : NNReal) : ℝ) *
                ‖field first prefixState‖ ^ 2 +
              ((derivativeLipschitzConstant first : NNReal) : ℝ) *
                ‖field second prefixState‖ ^ 2)) := by
  dsimp only
  let phase : Command → State → State :=
    fun command => nearIdentityPhase step (field command)
  let prefixState := runMapSchedule phase before initial
  calc
    ‖runMapSchedule phase (before ++ first :: second :: after) initial -
        runMapSchedule phase (before ++ second :: first :: after) initial‖ ≤
      (tailLipschitz : ℝ) *
        ‖phase second (phase first prefixState) -
          phase first (phase second prefixState)‖ :=
      norm_runMapSchedule_adjacentSwap_le phase before after first second
        initial tailLipschitz suffixBound
    _ = (tailLipschitz : ℝ) *
        ‖nonlinearSwapDiscrepancy step (field first) (field second)
          prefixState‖ := rfl
    _ ≤ (tailLipschitz : ℝ) *
        (|step| ^ 2 *
            ‖vectorFieldBracket (field first) (field second)
              (derivative first) (derivative second) prefixState‖ +
          |step| ^ 3 *
            (((derivativeLipschitzConstant second : NNReal) : ℝ) *
                ‖field first prefixState‖ ^ 2 +
              ((derivativeLipschitzConstant first : NNReal) : ℝ) *
                ‖field second prefixState‖ ^ 2)) := by
      exact mul_le_mul_of_nonneg_left
        (norm_nonlinearSwapDiscrepancy_le step (field first) (field second)
          (derivative first) (derivative second)
          (derivativeLipschitzConstant first)
          (derivativeLipschitzConstant second)
          (hasDerivative first) (hasDerivative second)
          (derivativeLipschitz first) (derivativeLipschitz second) prefixState)
        tailLipschitz.coe_nonneg

/-! ## Region-aware schedule certificates -/

/-- A complete certificate for one adjacent command swap.  The declared
region controls the state reached by the prefix and carries uniform local
bracket and field-magnitude bounds.  The suffix has its own Lipschitz
amplification factor, and the resulting transported estimate must fit inside
the declared error budget.

The certificate is intentionally stronger than a commutator measurement at
one sampled state: every analytic bound used at the reached prefix state is
justified by membership in `region`. -/
structure NearIdentityAdjacentSwapCertificate
    {Command : Type uCommand}
    (step : ℝ) (field : Command → State → State)
    (derivative : Command → State → State →L[ℝ] State)
    (derivativeLipschitzConstant : Command → NNReal)
    (initial : State) where
  before : List Command
  after : List Command
  first : Command
  second : Command
  region : Set State
  prefix_mem :
    runMapSchedule (fun command => nearIdentityPhase step (field command))
      before initial ∈ region
  firstHasDerivative : ∀ state,
    HasFDerivAt (field first) (derivative first state) state
  secondHasDerivative : ∀ state,
    HasFDerivAt (field second) (derivative second state) state
  firstDerivativeLipschitz :
    LipschitzWith (derivativeLipschitzConstant first) (derivative first)
  secondDerivativeLipschitz :
    LipschitzWith (derivativeLipschitzConstant second) (derivative second)
  bracketBound : ℝ
  firstFieldBound : ℝ
  secondFieldBound : ℝ
  bracketBound_nonneg : 0 ≤ bracketBound
  firstFieldBound_nonneg : 0 ≤ firstFieldBound
  secondFieldBound_nonneg : 0 ≤ secondFieldBound
  bracket_le : ∀ state ∈ region,
    ‖vectorFieldBracket (field first) (field second)
      (derivative first) (derivative second) state‖ ≤ bracketBound
  firstField_le : ∀ state ∈ region, ‖field first state‖ ≤ firstFieldBound
  secondField_le : ∀ state ∈ region, ‖field second state‖ ≤ secondFieldBound
  tailLipschitz : NNReal
  suffixBound : LipschitzWith tailLipschitz
    (runMapSchedule (fun command => nearIdentityPhase step (field command)) after)
  errorBudget : ℝ
  errorBudget_nonneg : 0 ≤ errorBudget
  transportedBound_le_budget :
    (tailLipschitz : ℝ) *
        (|step| ^ 2 * bracketBound +
          |step| ^ 3 *
            (((derivativeLipschitzConstant second : NNReal) : ℝ) *
                firstFieldBound ^ 2 +
              ((derivativeLipschitzConstant first : NNReal) : ℝ) *
                secondFieldBound ^ 2)) ≤
      errorBudget

namespace NearIdentityAdjacentSwapCertificate

variable {Command : Type uCommand}
variable {step : ℝ} {field : Command → State → State}
variable {derivative : Command → State → State →L[ℝ] State}
variable {derivativeLipschitzConstant : Command → NNReal}
variable {initial : State}

/-- Schedule before applying the certified adjacent transposition. -/
def leftSchedule
    (certificate : NearIdentityAdjacentSwapCertificate step field derivative
      derivativeLipschitzConstant initial) : List Command :=
  certificate.before ++ certificate.first :: certificate.second :: certificate.after

/-- Schedule after applying the certified adjacent transposition. -/
def rightSchedule
    (certificate : NearIdentityAdjacentSwapCertificate step field derivative
      derivativeLipschitzConstant initial) : List Command :=
  certificate.before ++ certificate.second :: certificate.first :: certificate.after

/-- The two schedules named by a region-aware certificate differ in output by
at most its declared budget. -/
theorem norm_run_leftSchedule_sub_rightSchedule_le
    (certificate : NearIdentityAdjacentSwapCertificate step field derivative
      derivativeLipschitzConstant initial) :
    ‖runMapSchedule (fun command => nearIdentityPhase step (field command))
          certificate.leftSchedule initial -
        runMapSchedule (fun command => nearIdentityPhase step (field command))
          certificate.rightSchedule initial‖ ≤
      certificate.errorBudget := by
  let phase : Command → State → State :=
    fun command => nearIdentityPhase step (field command)
  let prefixState := runMapSchedule phase certificate.before initial
  have prefixMem : prefixState ∈ certificate.region := certificate.prefix_mem
  have firstSquare : ‖field certificate.first prefixState‖ ^ 2 ≤
      certificate.firstFieldBound ^ 2 :=
    pow_le_pow_left₀ (norm_nonneg _)
      (certificate.firstField_le prefixState prefixMem) 2
  have secondSquare : ‖field certificate.second prefixState‖ ^ 2 ≤
      certificate.secondFieldBound ^ 2 :=
    pow_le_pow_left₀ (norm_nonneg _)
      (certificate.secondField_le prefixState prefixMem) 2
  calc
    ‖runMapSchedule phase certificate.leftSchedule initial -
        runMapSchedule phase certificate.rightSchedule initial‖ ≤
      (certificate.tailLipschitz : ℝ) *
        ‖nonlinearSwapDiscrepancy step
          (field certificate.first) (field certificate.second) prefixState‖ := by
      exact norm_runMapSchedule_adjacentSwap_le phase certificate.before
        certificate.after certificate.first certificate.second initial
        certificate.tailLipschitz certificate.suffixBound
    _ ≤ (certificate.tailLipschitz : ℝ) *
        (|step| ^ 2 *
            ‖vectorFieldBracket (field certificate.first) (field certificate.second)
              (derivative certificate.first) (derivative certificate.second)
              prefixState‖ +
          |step| ^ 3 *
            (((derivativeLipschitzConstant certificate.second : NNReal) : ℝ) *
                ‖field certificate.first prefixState‖ ^ 2 +
              ((derivativeLipschitzConstant certificate.first : NNReal) : ℝ) *
                ‖field certificate.second prefixState‖ ^ 2)) := by
      exact mul_le_mul_of_nonneg_left
        (norm_nonlinearSwapDiscrepancy_le step
          (field certificate.first) (field certificate.second)
          (derivative certificate.first) (derivative certificate.second)
          (derivativeLipschitzConstant certificate.first)
          (derivativeLipschitzConstant certificate.second)
          certificate.firstHasDerivative certificate.secondHasDerivative
          certificate.firstDerivativeLipschitz
          certificate.secondDerivativeLipschitz prefixState)
        certificate.tailLipschitz.coe_nonneg
    _ ≤ (certificate.tailLipschitz : ℝ) *
        (|step| ^ 2 * certificate.bracketBound +
          |step| ^ 3 *
            (((derivativeLipschitzConstant certificate.second : NNReal) : ℝ) *
                certificate.firstFieldBound ^ 2 +
              ((derivativeLipschitzConstant certificate.first : NNReal) : ℝ) *
                certificate.secondFieldBound ^ 2)) := by
      gcongr
      · exact certificate.bracket_le prefixState prefixMem
    _ ≤ certificate.errorBudget := certificate.transportedBound_le_budget

end NearIdentityAdjacentSwapCertificate

omit [NormedSpace ℝ State] in
/-- A path of `steps` certified local changes accumulates at most linearly.
This generic endpoint bound can be instantiated by a path of schedules linked
by adjacent swaps. -/
theorem norm_path_endpoint_le
    (path : ℕ → State) (steps : ℕ) (error : ℝ)
    (stepBound : ∀ index < steps,
      ‖path (index + 1) - path index‖ ≤ error) :
    ‖path steps - path 0‖ ≤ (steps : ℝ) * error := by
  induction steps with
  | zero => simp
  | succ steps ih =>
      calc
        ‖path (steps + 1) - path 0‖ ≤
            ‖path (steps + 1) - path steps‖ + ‖path steps - path 0‖ := by
          rw [show path (steps + 1) - path 0 =
            (path (steps + 1) - path steps) + (path steps - path 0) by abel]
          exact norm_add_le _ _
        _ ≤ error + (steps : ℝ) * error := by
          gcongr
          · exact stepBound steps (Nat.lt_succ_self steps)
          · exact ih (fun index hindex =>
              stepBound index (Nat.lt_trans hindex (Nat.lt_succ_self steps)))
        _ = ((steps + 1 : ℕ) : ℝ) * error := by
          rw [Nat.cast_add, Nat.cast_one]
          ring

omit [NormedSpace ℝ State] in
/-- Heterogeneous local bounds accumulate additively along a finite path.
Unlike `norm_path_endpoint_le`, this theorem retains the individual budget of
each change rather than replacing all of them by one worst-case value. -/
theorem norm_path_endpoint_le_sum
    (path : ℕ → State) (steps : ℕ) (error : ℕ → ℝ)
    (stepBound : ∀ index < steps,
      ‖path (index + 1) - path index‖ ≤ error index) :
    ‖path steps - path 0‖ ≤ ∑ index ∈ Finset.range steps, error index := by
  induction steps with
  | zero => simp
  | succ steps ih =>
      calc
        ‖path (steps + 1) - path 0‖ ≤
            ‖path (steps + 1) - path steps‖ + ‖path steps - path 0‖ := by
          rw [show path (steps + 1) - path 0 =
            (path (steps + 1) - path steps) + (path steps - path 0) by abel]
          exact norm_add_le _ _
        _ ≤ error steps + ∑ index ∈ Finset.range steps, error index := by
          gcongr
          · exact stepBound steps (Nat.lt_succ_self steps)
          · exact ih (fun index hindex =>
              stepBound index (Nat.lt_trans hindex (Nat.lt_succ_self steps)))
        _ = ∑ index ∈ Finset.range (steps + 1), error index := by
          rw [Finset.sum_range_succ]
          abel

/-- A finite path of schedules linked by region-aware adjacent-swap
certificates has endpoint error bounded by the sum of the declared budgets.
This is the schedule-level certificate: each edge carries its own reached
region, local commutator bound, nonlinear remainder, and tail amplification. -/
theorem norm_certifiedSchedulePath_endpoint_le
    {Command : Type uCommand}
    (step : ℝ) (field : Command → State → State)
    (derivative : Command → State → State →L[ℝ] State)
    (derivativeLipschitzConstant : Command → NNReal)
    (initial : State) (schedules : ℕ → List Command) (steps : ℕ)
    (certificate : ℕ → NearIdentityAdjacentSwapCertificate step field
      derivative derivativeLipschitzConstant initial)
    (leftSchedule_eq : ∀ index < steps,
      (certificate index).leftSchedule = schedules index)
    (rightSchedule_eq : ∀ index < steps,
      (certificate index).rightSchedule = schedules (index + 1)) :
    ‖runMapSchedule (fun command => nearIdentityPhase step (field command))
          (schedules steps) initial -
        runMapSchedule (fun command => nearIdentityPhase step (field command))
          (schedules 0) initial‖ ≤
      ∑ index ∈ Finset.range steps, (certificate index).errorBudget := by
  apply norm_path_endpoint_le_sum
    (path := fun index =>
      runMapSchedule (fun command => nearIdentityPhase step (field command))
        (schedules index) initial)
  intro index hindex
  rw [← leftSchedule_eq index hindex, ← rightSchedule_eq index hindex]
  rw [norm_sub_rev]
  exact (certificate index).norm_run_leftSchedule_sub_rightSchedule_le

/-! ## Positive and negative fixtures -/

def zeroCommandField (_ : Bool) (_ : ℝ) : ℝ := 0

noncomputable def zeroCommandDerivative (_ : Bool) (_ : ℝ) : ℝ →L[ℝ] ℝ := 0

def zeroCommandDerivativeLipschitz (_ : Bool) : NNReal := 0

/-- The certificate type is inhabited non-vacuously: two distinct commands
with zero vector fields commute on the universal region, the empty suffix is
one-Lipschitz, and the exact schedule budget is zero. -/
noncomputable def zeroFieldRegionCertificate :
    NearIdentityAdjacentSwapCertificate (1 : ℝ) zeroCommandField
      zeroCommandDerivative zeroCommandDerivativeLipschitz (0 : ℝ) where
  before := []
  after := []
  first := false
  second := true
  region := Set.univ
  prefix_mem := Set.mem_univ _
  firstHasDerivative := fun state => by
    change HasFDerivAt (fun _ : ℝ => (0 : ℝ)) (0 : ℝ →L[ℝ] ℝ) state
    fun_prop
  secondHasDerivative := fun state => by
    change HasFDerivAt (fun _ : ℝ => (0 : ℝ)) (0 : ℝ →L[ℝ] ℝ) state
    fun_prop
  firstDerivativeLipschitz := by
    change LipschitzWith 0 (fun _ : ℝ => (0 : ℝ →L[ℝ] ℝ))
    exact LipschitzWith.const _
  secondDerivativeLipschitz := by
    change LipschitzWith 0 (fun _ : ℝ => (0 : ℝ →L[ℝ] ℝ))
    exact LipschitzWith.const _
  bracketBound := 0
  firstFieldBound := 0
  secondFieldBound := 0
  bracketBound_nonneg := le_rfl
  firstFieldBound_nonneg := le_rfl
  secondFieldBound_nonneg := le_rfl
  bracket_le := by simp [vectorFieldBracket, zeroCommandField,
    zeroCommandDerivative]
  firstField_le := by simp [zeroCommandField]
  secondField_le := by simp [zeroCommandField]
  tailLipschitz := 1
  suffixBound := by
    intro first second
    simp [runMapSchedule]
  errorBudget := 0
  errorBudget_nonneg := le_rfl
  transportedBound_le_budget := by
    simp [zeroCommandDerivativeLipschitz]

theorem zeroFieldRegionCertificate_positiveExample :
    ‖runMapSchedule
          (fun command => nearIdentityPhase (1 : ℝ) (zeroCommandField command))
          zeroFieldRegionCertificate.leftSchedule 0 -
        runMapSchedule
          (fun command => nearIdentityPhase (1 : ℝ) (zeroCommandField command))
          zeroFieldRegionCertificate.rightSchedule 0‖ ≤
      zeroFieldRegionCertificate.errorBudget :=
  zeroFieldRegionCertificate.norm_run_leftSchedule_sub_rightSchedule_le

def squareConstantCommandField (command : Bool) (state : ℝ) : ℝ :=
  if command then 1 else state ^ 2

/-- The certificate cannot hide a real order effect inside a zero budget.
For the schedules `square; constant` and `constant; square`, one unit Euler
steps from zero end at one and two respectively. -/
theorem squareAndConstant_zeroBudget_certificate_impossible
    {derivative : Bool → ℝ → ℝ →L[ℝ] ℝ}
    {derivativeLipschitzConstant : Bool → NNReal}
    (certificate : NearIdentityAdjacentSwapCertificate (1 : ℝ)
      squareConstantCommandField derivative derivativeLipschitzConstant 0)
    (hbefore : certificate.before = []) (hafter : certificate.after = [])
    (hfirst : certificate.first = false) (hsecond : certificate.second = true)
    (hbudget : certificate.errorBudget = 0) : False := by
  have bound := certificate.norm_run_leftSchedule_sub_rightSchedule_le
  have leftSchedule : certificate.leftSchedule = [false, true] := by
    simp [NearIdentityAdjacentSwapCertificate.leftSchedule,
      hbefore, hafter, hfirst, hsecond]
  have rightSchedule : certificate.rightSchedule = [true, false] := by
    simp [NearIdentityAdjacentSwapCertificate.rightSchedule,
      hbefore, hafter, hfirst, hsecond]
  rw [leftSchedule, rightSchedule, hbudget] at bound
  norm_num [runMapSchedule, nearIdentityPhase, squareConstantCommandField] at bound

/-- Constant vector fields commute for every state and every step. -/
theorem constantFields_orderIndependent_positiveExample
    (step : ℝ) (first second state : State) :
    nonlinearSwapDiscrepancy step (fun _ => first) (fun _ => second) state = 0 := by
  simp [nonlinearSwapDiscrepancy, nearIdentityPhase]
  module

/-- A genuinely nonlinear scalar pair is order-sensitive after one unit step:
the constant field acts before or after squaring with different results. -/
theorem squareAndConstant_orderSensitive_negativeExample :
    nonlinearSwapDiscrepancy (1 : ℝ) (fun state : ℝ => state ^ 2)
      (fun _ : ℝ => (1 : ℝ)) (0 : ℝ) = -1 := by
  norm_num [nonlinearSwapDiscrepancy, nearIdentityPhase]

