import Mettapedia.MachineLearning.NeuralNetworks.LayeredWeightSpace
import Mettapedia.MachineLearning.NeuralNetworks.WeightSpaceRelationEquivariance

/-!
# Arbitrary-depth structural minimality in weight space

The minimal-equivariance argument for a neural functional separates false
weight-coordinate symmetries into three kinds: moving weights between
matrices, mixing rows or columns within one matrix, and decoupling the two
appearances of one hidden layer in adjacent matrices.

This module treats the latter two cases for an arbitrary heterogeneous list
of finite neuron layers.  A layerwise weight permutation preserves the row
and column grids of every matrix and the hidden-neuron incidence between
every adjacent pair exactly when it is generated by one neuron permutation
per layer.

The construction is witness-producing.  Nonempty layer anchors recover row
and column permutations from each rectangular grid; adjacent incidence then
proves that the independently recovered permutations of every shared hidden
layer are equal.
-/

namespace Mettapedia.MachineLearning.NeuralNetworks

noncomputable section

universe u

/-- One independent permutation for every adjacent weight matrix. -/
def LayerwiseMatrixPermutation :
    List (FiniteNeuronLayer.{u}) → Type u
  | _input :: output :: rest =>
      Equiv.Perm (output.carrier × _input.carrier) ×
        LayerwiseMatrixPermutation (output :: rest)
  | _ => PUnit.{u + 1}

/-- Apply a family of independent matrix permutations to the heterogeneous
global weight-coordinate type. -/
def layerwiseMatrixWeightEquiv :
    (layers : List (FiniteNeuronLayer.{u})) →
      LayerwiseMatrixPermutation layers →
      Equiv.Perm (LayeredWeightCoordinate layers)
  | _input :: output :: rest, permutation =>
      Equiv.sumCongr permutation.1
        (layerwiseMatrixWeightEquiv (output :: rest) permutation.2)
  | [], _ => Equiv.refl PEmpty
  | [_], _ => Equiv.refl PEmpty

/-- The matrix-permutation family generated by one permutation of every
neuron layer. -/
def layerNeuronMatrixPermutation :
    (layers : List (FiniteNeuronLayer.{u})) →
      LayerNeuronPermutation layers →
      LayerwiseMatrixPermutation layers
  | _input :: output :: rest, permutation =>
      (Equiv.prodCongr permutation.2.1 permutation.1,
        layerNeuronMatrixPermutation (output :: rest) permutation.2)
  | [], _ => PUnit.unit
  | [_], _ => PUnit.unit

/-- The two global coordinate actions induced by a genuine neuron
permutation are definitionally the same. -/
theorem layerNeuronMatrixPermutation_weightEquiv :
    ∀ (layers : List (FiniteNeuronLayer.{u}))
      (permutation : LayerNeuronPermutation layers),
      layerwiseMatrixWeightEquiv layers
          (layerNeuronMatrixPermutation layers permutation) =
        genuineLayerWeightEquiv layers permutation
  | [], _ => rfl
  | [_], _ => rfl
  | _input :: output :: rest, permutation => by
      simp only [layerwiseMatrixWeightEquiv,
        layerNeuronMatrixPermutation, genuineLayerWeightEquiv]
      rw [layerNeuronMatrixPermutation_weightEquiv
        (output :: rest) permutation.2]

/-- One chosen neuron in every layer.  These witnesses are required only to
construct product permutations from grid-relation preservation. -/
def LayerAnchors :
    List (FiniteNeuronLayer.{u}) → Type u
  | [] => PUnit.{u + 1}
  | layer :: rest => layer.carrier × LayerAnchors rest

/-- Every matrix permutation preserves both same-row and same-column
relations. -/
def PreservesAllMatrixGrids :
    (layers : List (FiniteNeuronLayer.{u})) →
      LayerwiseMatrixPermutation layers → Prop
  | _input :: output :: rest, permutation =>
      EquivPreservesRelation permutation.1 SameFirst ∧
        EquivPreservesRelation permutation.1 SameSecond ∧
        PreservesAllMatrixGrids (output :: rest) permutation.2
  | _, _ => True

/-- Adjacent matrix permutations use the same transported coordinate for
their shared hidden layer. -/
def PreservesAllAdjacentIncidences :
    (layers : List (FiniteNeuronLayer.{u})) →
      LayerwiseMatrixPermutation layers → Prop
  | _input :: middle :: next :: rest, permutation =>
      PreservesTwoLayerHiddenIncidence
          permutation.1 permutation.2.1 ∧
        PreservesAllAdjacentIncidences
          (middle :: next :: rest) permutation.2
  | _, _ => True

/-- A layerwise matrix permutation is genuine when it is produced by one
permutation of every neuron layer. -/
def IsLayerNeuronMatrixPermutation
    (layers : List (FiniteNeuronLayer.{u}))
    (permutation : LayerwiseMatrixPermutation layers) : Prop :=
  ∃ neuronPermutation : LayerNeuronPermutation layers,
    permutation =
      layerNeuronMatrixPermutation layers neuronPermutation

/-- An arbitrary global coordinate permutation preserves every matrix-layer
label. -/
def PreservesLayeredWeightLayer
    (layers : List (FiniteNeuronLayer.{u}))
    (permutation : Equiv.Perm (LayeredWeightCoordinate layers)) : Prop :=
  ∀ coordinate,
    layeredWeightLayer layers (permutation coordinate) =
      layeredWeightLayer layers coordinate

/-- An arbitrary global coordinate permutation factors into one independent
permutation of every adjacent weight matrix. -/
def IsLayerwiseMatrixWeightPermutation
    (layers : List (FiniteNeuronLayer.{u}))
    (permutation : Equiv.Perm (LayeredWeightCoordinate layers)) : Prop :=
  ∃ matrixPermutation : LayerwiseMatrixPermutation layers,
    permutation =
      layerwiseMatrixWeightEquiv layers matrixPermutation

/-- Independent matrix permutations preserve the recursive matrix-layer
label. -/
theorem layerwiseMatrixWeightEquiv_preservesLayeredWeightLayer :
    ∀ (layers : List (FiniteNeuronLayer.{u}))
      (matrixPermutation : LayerwiseMatrixPermutation layers),
      PreservesLayeredWeightLayer layers
        (layerwiseMatrixWeightEquiv layers matrixPermutation)
  | [], _, coordinate => nomatch coordinate
  | [_], _, coordinate => nomatch coordinate
  | _input :: _output :: _rest, _, Sum.inl _ => rfl
  | input :: output :: rest, matrixPermutation,
      Sum.inr coordinate => by
      exact congrArg Nat.succ
        (layerwiseMatrixWeightEquiv_preservesLayeredWeightLayer
          (output :: rest) matrixPermutation.2 coordinate)

/-- Constructively recover one permutation per weight matrix from an
arbitrary global coordinate bijection that preserves matrix-layer labels. -/
theorem preservesLayeredWeightLayer_implies_isLayerwiseMatrixWeightPermutation :
    ∀ (layers : List (FiniteNeuronLayer.{u}))
      (permutation : Equiv.Perm (LayeredWeightCoordinate layers)),
      PreservesLayeredWeightLayer layers permutation →
      IsLayerwiseMatrixWeightPermutation layers permutation
  | [], permutation, _ => by
      refine ⟨PUnit.unit, ?_⟩
      apply Equiv.ext
      intro coordinate
      exact nomatch coordinate
  | [_input], permutation, _ => by
      refine ⟨PUnit.unit, ?_⟩
      apply Equiv.ext
      intro coordinate
      exact nomatch coordinate
  | input :: output :: rest, permutation, preserves => by
      have preservesSide :
          PreservesSumSide permutation := by
        intro coordinate
        have labelEquality := preserves coordinate
        rcases coordinate with firstCoordinate | tailCoordinate
        · cases imageEquality :
            permutation (Sum.inl firstCoordinate) with
          | inl _ => rfl
          | inr _ =>
              simp [imageEquality, layeredWeightLayer] at labelEquality
        · cases imageEquality :
            permutation (Sum.inr tailCoordinate) with
          | inl _ =>
              simp [imageEquality, layeredWeightLayer] at labelEquality
          | inr _ => rfl
      obtain
          ⟨firstMatrixPermutation, tailPermutation,
            layerwiseEquality⟩ :=
        preservesSumSide_implies_isSumPermutation
          permutation preservesSide
      have tailPreserves :
          PreservesLayeredWeightLayer
            (output :: rest) tailPermutation := by
        intro coordinate
        have labelEquality := preserves (Sum.inr coordinate)
        rw [layerwiseEquality] at labelEquality
        change
          Nat.succ
              (layeredWeightLayer (output :: rest)
                (tailPermutation coordinate)) =
            Nat.succ
              (layeredWeightLayer (output :: rest) coordinate)
            at labelEquality
        exact Nat.succ.inj labelEquality
      obtain ⟨tailMatrixPermutation, tailEquality⟩ :=
        preservesLayeredWeightLayer_implies_isLayerwiseMatrixWeightPermutation
          (output :: rest) tailPermutation tailPreserves
      refine
        ⟨(firstMatrixPermutation, tailMatrixPermutation), ?_⟩
      rw [layerwiseEquality]
      simp only [layerwiseMatrixWeightEquiv]
      rw [tailEquality]

/-- Exact arbitrary-depth matrix-label boundary: preserving the natural
matrix label is equivalent to decomposing the global coordinate action into
one permutation per matrix. -/
theorem preservesLayeredWeightLayer_iff_isLayerwiseMatrixWeightPermutation
    (layers : List (FiniteNeuronLayer.{u}))
    (permutation : Equiv.Perm (LayeredWeightCoordinate layers)) :
    PreservesLayeredWeightLayer layers permutation ↔
      IsLayerwiseMatrixWeightPermutation layers permutation := by
  constructor
  · exact
      preservesLayeredWeightLayer_implies_isLayerwiseMatrixWeightPermutation
        layers permutation
  · intro layerwise
    rcases layerwise with ⟨matrixPermutation, rfl⟩
    exact
      layerwiseMatrixWeightEquiv_preservesLayeredWeightLayer
        layers matrixPermutation

/-- The recursive action faithfully remembers every independent matrix
permutation. -/
theorem layerwiseMatrixWeightEquiv_injective :
    ∀ (layers : List (FiniteNeuronLayer.{u})),
      Function.Injective (layerwiseMatrixWeightEquiv layers)
  | [], left, right, _ => by
      cases left
      cases right
      rfl
  | [_input], left, right, _ => by
      cases left
      cases right
      rfl
  | input :: output :: rest, left, right, equality => by
      apply Prod.ext
      · apply Equiv.ext
        intro coordinate
        have applied :=
          congrArg
            (fun permutation =>
              permutation (Sum.inl coordinate))
            equality
        change
          Sum.inl (left.1 coordinate) =
            Sum.inl (right.1 coordinate) at applied
        exact Sum.inl.inj applied
      · apply layerwiseMatrixWeightEquiv_injective (output :: rest)
        apply Equiv.ext
        intro coordinate
        have applied :=
          congrArg
            (fun permutation =>
              permutation (Sum.inr coordinate))
            equality
        change
          Sum.inr
              (layerwiseMatrixWeightEquiv
                (output :: rest) left.2 coordinate) =
            Sum.inr
              (layerwiseMatrixWeightEquiv
                (output :: rest) right.2 coordinate)
            at applied
        exact Sum.inr.inj applied

/-- A global coordinate permutation preserves the complete layered weight
structure when it preserves matrix labels and every compatible matrixwise
decomposition preserves each rectangular grid and each adjacent
shared-neuron incidence.  Quantifying over every decomposition avoids
building a preferred witness into the definition. -/
def PreservesCompleteLayeredWeightStructure
    (layers : List (FiniteNeuronLayer.{u}))
    (permutation : Equiv.Perm (LayeredWeightCoordinate layers)) : Prop :=
  PreservesLayeredWeightLayer layers permutation ∧
    ∀ matrixPermutation : LayerwiseMatrixPermutation layers,
      permutation =
          layerwiseMatrixWeightEquiv layers matrixPermutation →
        PreservesAllMatrixGrids layers matrixPermutation ∧
          PreservesAllAdjacentIncidences layers matrixPermutation

/-- A global coordinate permutation is induced by one neuron permutation
per layer. -/
def IsGenuineLayerWeightPermutation
    (layers : List (FiniteNeuronLayer.{u}))
    (permutation : Equiv.Perm (LayeredWeightCoordinate layers)) : Prop :=
  ∃ neuronPermutation : LayerNeuronPermutation layers,
    permutation =
      genuineLayerWeightEquiv layers neuronPermutation

/-- Genuine neuron permutations preserve every matrix grid. -/
theorem layerNeuronMatrixPermutation_preservesAllMatrixGrids :
    ∀ (layers : List (FiniteNeuronLayer.{u}))
      (permutation : LayerNeuronPermutation layers),
      PreservesAllMatrixGrids layers
        (layerNeuronMatrixPermutation layers permutation)
  | [], _ => trivial
  | [_], _ => trivial
  | input :: output :: rest, permutation => by
      refine ⟨?_, ?_,
        layerNeuronMatrixPermutation_preservesAllMatrixGrids
          (output :: rest) permutation.2⟩
      · exact
          (isProductPermutation_implies_preservesGridRelations
            (Equiv.prodCongr permutation.2.1 permutation.1)
            ⟨permutation.2.1, permutation.1,
              fun _ _ => rfl⟩).1
      · exact
          (isProductPermutation_implies_preservesGridRelations
            (Equiv.prodCongr permutation.2.1 permutation.1)
            ⟨permutation.2.1, permutation.1,
              fun _ _ => rfl⟩).2

/-- Genuine neuron permutations preserve every shared-hidden incidence. -/
theorem layerNeuronMatrixPermutation_preservesAllAdjacentIncidences :
    ∀ (layers : List (FiniteNeuronLayer.{u}))
      (permutation : LayerNeuronPermutation layers),
      PreservesAllAdjacentIncidences layers
        (layerNeuronMatrixPermutation layers permutation)
  | [], _ => trivial
  | [_], _ => trivial
  | [_input, _output], _ => trivial
  | input :: middle :: next :: rest, permutation => by
      constructor
      · intro hidden inputCoordinate outputCoordinate hidden'
        simp [layerNeuronMatrixPermutation]
      · exact
          layerNeuronMatrixPermutation_preservesAllAdjacentIncidences
            (middle :: next :: rest) permutation.2

/-- The easy direction of arbitrary-depth minimality. -/
theorem isLayerNeuronMatrixPermutation_implies_preservesStructure
    (layers : List (FiniteNeuronLayer.{u}))
    (permutation : LayerwiseMatrixPermutation layers)
    (genuine : IsLayerNeuronMatrixPermutation layers permutation) :
    PreservesAllMatrixGrids layers permutation ∧
      PreservesAllAdjacentIncidences layers permutation := by
  rcases genuine with ⟨neuronPermutation, rfl⟩
  exact
    ⟨layerNeuronMatrixPermutation_preservesAllMatrixGrids
        layers neuronPermutation,
      layerNeuronMatrixPermutation_preservesAllAdjacentIncidences
        layers neuronPermutation⟩

/-- Constructive arbitrary-depth recovery: matrix-grid preservation and
adjacent hidden-incidence preservation determine one neuron permutation per
layer. -/
theorem preservesStructure_implies_isLayerNeuronMatrixPermutation :
    ∀ (layers : List (FiniteNeuronLayer.{u}))
      (_anchors : LayerAnchors layers)
      (permutation : LayerwiseMatrixPermutation layers),
      PreservesAllMatrixGrids layers permutation →
      PreservesAllAdjacentIncidences layers permutation →
      IsLayerNeuronMatrixPermutation layers permutation
  | [], _, permutation, _, _ => by
      cases permutation
      exact ⟨PUnit.unit, rfl⟩
  | [input], _, permutation, _, _ => by
      cases permutation
      refine
        ⟨(Equiv.refl input.carrier, PUnit.unit), ?_⟩
      rfl
  | [input, output],
      (inputAnchor, (outputAnchor, _)),
      (matrixPermutation, terminalPermutation),
      preservesGrids, _ => by
      obtain
          ⟨outputPermutation, inputPermutation, matrixForm⟩ :=
        preservesGridRelations_implies_isProductPermutation
          outputAnchor inputAnchor matrixPermutation
          preservesGrids.1 preservesGrids.2.1
      have matrixEquality :
          matrixPermutation =
            Equiv.prodCongr outputPermutation inputPermutation := by
        apply Equiv.ext
        rintro ⟨outputCoordinate, inputCoordinate⟩
        simpa using matrixForm outputCoordinate inputCoordinate
      refine
        ⟨(inputPermutation,
            (outputPermutation, PUnit.unit)), ?_⟩
      change
        (matrixPermutation, terminalPermutation) =
          (Equiv.prodCongr outputPermutation inputPermutation,
            PUnit.unit)
      cases terminalPermutation
      exact Prod.ext matrixEquality rfl
  | input :: middle :: next :: rest,
      (inputAnchor,
        (middleAnchor, (nextAnchor, restAnchors))),
      (matrixPermutation, tailPermutation),
      preservesGrids, preservesIncidences => by
      obtain
          ⟨middlePermutation, inputPermutation, matrixForm⟩ :=
        preservesGridRelations_implies_isProductPermutation
          middleAnchor inputAnchor matrixPermutation
          preservesGrids.1 preservesGrids.2.1
      obtain ⟨tailNeuronPermutation, tailEquality⟩ :=
        preservesStructure_implies_isLayerNeuronMatrixPermutation
          (middle :: next :: rest)
          (middleAnchor, (nextAnchor, restAnchors))
          tailPermutation
          preservesGrids.2.2
          preservesIncidences.2
      have tailFirstEquality :
          tailPermutation.1 =
            Equiv.prodCongr
              tailNeuronPermutation.2.1
              tailNeuronPermutation.1 := by
        rw [tailEquality]
        rfl
      have sharedPermutation :
          middlePermutation = tailNeuronPermutation.1 := by
        apply Equiv.ext
        intro hidden
        have coupled :=
          (preservesIncidences.1
            hidden inputAnchor nextAnchor hidden).2 rfl
        rw [matrixForm, tailFirstEquality] at coupled
        simpa using coupled
      subst middlePermutation
      have matrixEquality :
          matrixPermutation =
            Equiv.prodCongr
              tailNeuronPermutation.1 inputPermutation := by
        apply Equiv.ext
        rintro ⟨middleCoordinate, inputCoordinate⟩
        simpa using matrixForm middleCoordinate inputCoordinate
      refine
        ⟨(inputPermutation, tailNeuronPermutation), ?_⟩
      change
        (matrixPermutation, tailPermutation) =
          (Equiv.prodCongr
              tailNeuronPermutation.1 inputPermutation,
            layerNeuronMatrixPermutation
              (middle :: next :: rest) tailNeuronPermutation)
      exact Prod.ext matrixEquality tailEquality

/-- Arbitrary-depth layerwise minimality crown.  For networks with a chosen
neuron in every layer, the complete matrix-grid and adjacent-incidence
signature has exactly the genuine layerwise neuron-permutation group. -/
theorem preservesStructure_iff_isLayerNeuronMatrixPermutation
    (layers : List (FiniteNeuronLayer.{u}))
    (anchors : LayerAnchors layers)
    (permutation : LayerwiseMatrixPermutation layers) :
    (PreservesAllMatrixGrids layers permutation ∧
        PreservesAllAdjacentIncidences layers permutation) ↔
      IsLayerNeuronMatrixPermutation layers permutation := by
  constructor
  · intro preserves
    exact
      preservesStructure_implies_isLayerNeuronMatrixPermutation
        layers anchors permutation preserves.1 preserves.2
  · exact
      isLayerNeuronMatrixPermutation_implies_preservesStructure
        layers permutation

/-- Arbitrary-global-permutation minimality crown.  For a network with a
chosen neuron in every layer, the complete layer label, matrix-grid, and
adjacent-incidence structure has exactly the genuine neuron-permutation
group. -/
theorem preservesCompleteLayeredWeightStructure_iff_isGenuineLayerWeightPermutation
    (layers : List (FiniteNeuronLayer.{u}))
    (anchors : LayerAnchors layers)
    (permutation : Equiv.Perm (LayeredWeightCoordinate layers)) :
    PreservesCompleteLayeredWeightStructure layers permutation ↔
      IsGenuineLayerWeightPermutation layers permutation := by
  constructor
  · intro preservesComplete
    obtain ⟨matrixPermutation, matrixEquality⟩ :=
      preservesLayeredWeightLayer_implies_isLayerwiseMatrixWeightPermutation
        layers permutation preservesComplete.1
    have matrixStructure :=
      preservesComplete.2 matrixPermutation matrixEquality
    obtain ⟨neuronPermutation, neuronEquality⟩ :=
      preservesStructure_implies_isLayerNeuronMatrixPermutation
        layers anchors matrixPermutation
        matrixStructure.1 matrixStructure.2
    refine ⟨neuronPermutation, ?_⟩
    calc
      permutation =
          layerwiseMatrixWeightEquiv layers matrixPermutation :=
        matrixEquality
      _ =
          layerwiseMatrixWeightEquiv layers
            (layerNeuronMatrixPermutation
              layers neuronPermutation) := by
        rw [neuronEquality]
      _ = genuineLayerWeightEquiv layers neuronPermutation :=
        layerNeuronMatrixPermutation_weightEquiv
          layers neuronPermutation
  · rintro ⟨neuronPermutation, permutationEquality⟩
    constructor
    · intro coordinate
      rw [permutationEquality]
      exact
        genuineLayerWeightEquiv_preserves_layer
          layers neuronPermutation coordinate
    · intro matrixPermutation matrixEquality
      have actionEquality :
          layerwiseMatrixWeightEquiv layers matrixPermutation =
            layerwiseMatrixWeightEquiv layers
              (layerNeuronMatrixPermutation
                layers neuronPermutation) := by
        calc
          layerwiseMatrixWeightEquiv layers matrixPermutation =
              permutation :=
            matrixEquality.symm
          _ = genuineLayerWeightEquiv layers neuronPermutation :=
            permutationEquality
          _ =
              layerwiseMatrixWeightEquiv layers
                (layerNeuronMatrixPermutation
                  layers neuronPermutation) :=
            (layerNeuronMatrixPermutation_weightEquiv
              layers neuronPermutation).symm
      have matrixFamilyEquality :
          matrixPermutation =
            layerNeuronMatrixPermutation
              layers neuronPermutation :=
        layerwiseMatrixWeightEquiv_injective layers actionEquality
      rw [matrixFamilyEquality]
      exact
        ⟨layerNeuronMatrixPermutation_preservesAllMatrixGrids
            layers neuronPermutation,
          layerNeuronMatrixPermutation_preservesAllAdjacentIncidences
            layers neuronPermutation⟩

namespace LayeredWeightSpaceMinimalityFixtures

open LayeredWeightSpaceFixtures

/-- Concrete anchors for the nonempty `1 → 2 → 1` fixture. -/
def tinyAnchors : LayerAnchors tinyThreeLayerShape :=
  (0, (0, (0, PUnit.unit)))

/-- The genuine hidden-neuron swap expressed as one permutation per matrix. -/
def tinyGenuineMatrixPermutation :
    LayerwiseMatrixPermutation tinyThreeLayerShape :=
  layerNeuronMatrixPermutation tinyThreeLayerShape tinyHiddenSwap

/-- Positive fixture: the nontrivial shared hidden swap preserves the full
arbitrary-depth structural signature. -/
theorem tinyGenuineMatrixPermutation_preservesStructure :
    PreservesAllMatrixGrids tinyThreeLayerShape
        tinyGenuineMatrixPermutation ∧
      PreservesAllAdjacentIncidences tinyThreeLayerShape
        tinyGenuineMatrixPermutation := by
  exact
    isLayerNeuronMatrixPermutation_implies_preservesStructure
      tinyThreeLayerShape tinyGenuineMatrixPermutation
      ⟨tinyHiddenSwap, rfl⟩

/-- The genuine matrix action really moves a weight: it swaps the first two
rows of the incoming matrix. -/
theorem tinyGenuineMatrixPermutation_moves_incoming_weight :
    layerwiseMatrixWeightEquiv tinyThreeLayerShape
        tinyGenuineMatrixPermutation firstIncoming =
      secondIncoming := by
  rw [show
    layerwiseMatrixWeightEquiv tinyThreeLayerShape
        tinyGenuineMatrixPermutation =
      genuineLayerWeightEquiv tinyThreeLayerShape tinyHiddenSwap by
        exact
          layerNeuronMatrixPermutation_weightEquiv
            tinyThreeLayerShape tinyHiddenSwap]
  exact hiddenSwap_moves_firstMatrix_row

/-- Swap the hidden rows of the incoming matrix but leave the outgoing
matrix fixed.  Both rectangular matrix grids are preserved independently,
yet the two appearances of the hidden layer are decoupled. -/
def tinyDecoupledHiddenSwap :
    LayerwiseMatrixPermutation tinyThreeLayerShape :=
  (Equiv.prodCongr (Equiv.swap 0 1) (Equiv.refl (Fin 1)),
    (Equiv.refl (Fin 1 × Fin 2), PUnit.unit))

/-- Each matrix grid is still preserved by the decoupled action.  The
failure below is therefore specifically a failure of inter-matrix
incidence, not a row/column defect within either matrix. -/
theorem tinyDecoupledHiddenSwap_preservesAllMatrixGrids :
    PreservesAllMatrixGrids tinyThreeLayerShape
      tinyDecoupledHiddenSwap := by
  have incomingProduct :
      IsProductPermutation
        (Equiv.prodCongr
          (Equiv.swap (0 : Fin 2) 1) (Equiv.refl (Fin 1))) :=
    ⟨Equiv.swap 0 1, Equiv.refl (Fin 1), fun _ _ => rfl⟩
  have outgoingProduct :
      IsProductPermutation (Equiv.refl (Fin 1 × Fin 2)) :=
    ⟨Equiv.refl (Fin 1), Equiv.refl (Fin 2), fun _ _ => rfl⟩
  have incoming :=
    isProductPermutation_implies_preservesGridRelations
      (Equiv.prodCongr
        (Equiv.swap (0 : Fin 2) 1) (Equiv.refl (Fin 1)))
      incomingProduct
  have outgoing :=
    isProductPermutation_implies_preservesGridRelations
      (Equiv.refl (Fin 1 × Fin 2)) outgoingProduct
  exact
    ⟨incoming.1, incoming.2, outgoing.1, outgoing.2, trivial⟩

/-- Negative fixture: the decoupled matrix action violates shared-hidden
incidence, despite being a legitimate bijection within each matrix. -/
theorem tinyDecoupledHiddenSwap_does_not_preserveAdjacentIncidences :
    ¬ PreservesAllAdjacentIncidences tinyThreeLayerShape
        tinyDecoupledHiddenSwap := by
  intro preserves
  have coupled :=
    (preserves.1
      (0 : Fin 2) (0 : Fin 1) (0 : Fin 1) (0 : Fin 2)).2 rfl
  norm_num
    [tinyThreeLayerShape, tinyDecoupledHiddenSwap,
      PreservesAllAdjacentIncidences,
      PreservesTwoLayerHiddenIncidence, Equiv.swap_apply_def] at coupled

/-- Consequently the independently swapped matrices cannot arise from one
permutation of each neuron layer. -/
theorem tinyDecoupledHiddenSwap_is_not_genuine :
    ¬ IsLayerNeuronMatrixPermutation tinyThreeLayerShape
        tinyDecoupledHiddenSwap := by
  intro genuine
  exact tinyDecoupledHiddenSwap_does_not_preserveAdjacentIncidences
    (isLayerNeuronMatrixPermutation_implies_preservesStructure
      tinyThreeLayerShape tinyDecoupledHiddenSwap genuine).2

/-- The decoupled action is nevertheless layer-label preserving, showing
that layer labels alone do not enforce shared hidden-neuron coupling. -/
theorem tinyDecoupledHiddenSwap_preservesLayeredWeightLayer :
    PreservesLayeredWeightLayer tinyThreeLayerShape
      (layerwiseMatrixWeightEquiv
        tinyThreeLayerShape tinyDecoupledHiddenSwap) :=
  layerwiseMatrixWeightEquiv_preservesLayeredWeightLayer
    tinyThreeLayerShape tinyDecoupledHiddenSwap

/-- Because it fails adjacent incidence, the decoupled action does not
preserve the complete global structure. -/
theorem tinyDecoupledHiddenSwap_does_not_preserveCompleteStructure :
    ¬ PreservesCompleteLayeredWeightStructure tinyThreeLayerShape
        (layerwiseMatrixWeightEquiv
          tinyThreeLayerShape tinyDecoupledHiddenSwap) := by
  intro preservesComplete
  exact
    tinyDecoupledHiddenSwap_does_not_preserveAdjacentIncidences
      (preservesComplete.2 tinyDecoupledHiddenSwap rfl).2

/-- A genuine nontrivial hidden swap preserves the complete global
structure. -/
theorem tinyGenuineHiddenSwap_preservesCompleteStructure :
    PreservesCompleteLayeredWeightStructure tinyThreeLayerShape
      (genuineLayerWeightEquiv tinyThreeLayerShape tinyHiddenSwap) := by
  exact
    (preservesCompleteLayeredWeightStructure_iff_isGenuineLayerWeightPermutation
      tinyThreeLayerShape tinyAnchors
      (genuineLayerWeightEquiv tinyThreeLayerShape tinyHiddenSwap)).2
      ⟨tinyHiddenSwap, rfl⟩

/-- The explicit cross-layer swap fails the matrix-layer label. -/
theorem crossLayerSwap_does_not_preserveLayeredWeightLayer :
    ¬ PreservesLayeredWeightLayer tinyThreeLayerShape
        crossLayerSwap := by
  intro preserves
  have equality := preserves firstIncoming
  obtain ⟨movedLayer, originalLayer⟩ := crossLayerSwap_changes_layer
  rw [movedLayer, originalLayer] at equality
  omega

/-- Hence the cross-layer swap cannot be decomposed into independent
within-matrix coordinate permutations. -/
theorem crossLayerSwap_is_not_layerwiseMatrixWeightPermutation :
    ¬ IsLayerwiseMatrixWeightPermutation tinyThreeLayerShape
        crossLayerSwap := by
  intro layerwise
  exact crossLayerSwap_does_not_preserveLayeredWeightLayer
    ((preservesLayeredWeightLayer_iff_isLayerwiseMatrixWeightPermutation
      tinyThreeLayerShape crossLayerSwap).2 layerwise)

end LayeredWeightSpaceMinimalityFixtures

