import Mettapedia.MachineLearning.NeuralNetworks.PredictiveCoding.CausalDirectionIdentifiability

/-!
# Causal-direction selection by fitted interventional energy

An unequal energy landscape is not yet a learning result.  This module lets
both two-node orientations fit their own structural coefficient on a finite
batch of `do(X)` samples.  Every candidate is converted to the same
node-indexed residual model, and every score is obtained through the uniform
`intervene` operation.

For data generated by the forward interventional response
`Y = (covXY / varX) X`, the forward family can fit the dependence exactly.
The reverse family's free `Y -> X` coefficient belongs to the residual row
deleted by `do(X)`, so its remaining root-`Y` score cannot fit the dependence.
On any excited finite design, the minimized forward score is strictly lower
exactly when `covXY != 0`.
-/

namespace Mettapedia.MachineLearning.NeuralNetworks.PredictiveCoding
namespace PositiveBivariateCovariance

/-! ## B1: both orientations fit their own parameter -/

/-- The forward structural family with a freely fitted `X -> Y` coefficient.
Its residual variances are held at the covariance's positive scales so that
the comparison isolates orientation and coefficient fitting. -/
noncomputable def forwardCandidateResidualModel
    (covariance : PositiveBivariateCovariance) (coefficient : ℝ) :
    TwoNodeQuadraticResidualModel where
  residualMatrix := !![1, 0; -coefficient, 1]
  residualVariance := ![covariance.varX, covariance.forwardResidualVariance]
  residualVariance_pos := by
    intro node
    fin_cases node
    · exact covariance.varX_pos
    · exact covariance.forwardResidualVariance_pos
  ySelfCoefficient := by simp

/-- The reverse structural family with a freely fitted `Y -> X` coefficient.
The coefficient occupies the residual row owned by `X`, exactly as required
by the reverse orientation. -/
noncomputable def reverseCandidateResidualModel
    (covariance : PositiveBivariateCovariance) (coefficient : ℝ) :
    TwoNodeQuadraticResidualModel where
  residualMatrix := !![1, -coefficient; 0, 1]
  residualVariance := ![covariance.reverseResidualVariance, covariance.varY]
  residualVariance_pos := by
    intro node
    fin_cases node
    · exact covariance.reverseResidualVariance_pos
    · exact covariance.varY_pos
  ySelfCoefficient := by simp

theorem forwardCandidateResidualModel_injective
    (covariance : PositiveBivariateCovariance) {first second : ℝ}
    (hne : first ≠ second) :
    covariance.forwardCandidateResidualModel first ≠
      covariance.forwardCandidateResidualModel second := by
  intro hmodel
  have hentry := congrArg
    (fun model : TwoNodeQuadraticResidualModel => model.residualMatrix 1 0)
    hmodel
  simp [forwardCandidateResidualModel] at hentry
  exact hne hentry

theorem reverseCandidateResidualModel_injective
    (covariance : PositiveBivariateCovariance) {first second : ℝ}
    (hne : first ≠ second) :
    covariance.reverseCandidateResidualModel first ≠
      covariance.reverseCandidateResidualModel second := by
  intro hmodel
  have hentry := congrArg
    (fun model : TwoNodeQuadraticResidualModel => model.residualMatrix 0 1)
    hmodel
  simp [reverseCandidateResidualModel] at hentry
  exact hne hentry

/-- One forward candidate's score on a severed `do(X=x)` observation. -/
noncomputable def forwardCandidateInterventionalEnergy
    (covariance : PositiveBivariateCovariance)
    (coefficient x y : ℝ) : ℝ :=
  (covariance.forwardCandidateResidualModel coefficient).intervene
    0 x (twoNodeState 0 y)

/-- One reverse candidate's score on the identical severed observation. -/
noncomputable def reverseCandidateInterventionalEnergy
    (covariance : PositiveBivariateCovariance)
    (coefficient x y : ℝ) : ℝ :=
  (covariance.reverseCandidateResidualModel coefficient).intervene
    0 x (twoNodeState 0 y)

theorem forwardCandidateInterventionalEnergy_exact
    (covariance : PositiveBivariateCovariance)
    (coefficient x y : ℝ) :
    covariance.forwardCandidateInterventionalEnergy coefficient x y =
      (y - coefficient * x) ^ 2 /
        (2 * covariance.forwardResidualVariance) := by
  simp [forwardCandidateInterventionalEnergy,
    TwoNodeQuadraticResidualModel.intervene,
    TwoNodeQuadraticResidualModel.residualContribution,
    forwardCandidateResidualModel, twoNodeState, Matrix.mulVec,
    Function.update]
  ring

theorem reverseCandidateInterventionalEnergy_exact
    (covariance : PositiveBivariateCovariance)
    (coefficient x y : ℝ) :
    covariance.reverseCandidateInterventionalEnergy coefficient x y =
      y ^ 2 / (2 * covariance.varY) := by
  simp [reverseCandidateInterventionalEnergy,
    TwoNodeQuadraticResidualModel.intervene,
    TwoNodeQuadraticResidualModel.residualContribution,
    reverseCandidateResidualModel, twoNodeState, Matrix.mulVec,
    Function.update]

/-- Finite interventional batch score for a forward candidate. -/
noncomputable def forwardCandidateInterventionalBatchEnergy
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance)
    (x y : Sample → ℝ) (coefficient : ℝ) : ℝ :=
  ∑ sample,
    covariance.forwardCandidateInterventionalEnergy coefficient
      (x sample) (y sample)

/-- Finite interventional batch score for a reverse candidate. -/
noncomputable def reverseCandidateInterventionalBatchEnergy
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance)
    (x y : Sample → ℝ) (coefficient : ℝ) : ℝ :=
  ∑ sample,
    covariance.reverseCandidateInterventionalEnergy coefficient
      (x sample) (y sample)

/-- Responses of the true forward mechanism on a finite intervention design. -/
noncomputable def trueForwardInterventionResponse
    {Sample : Type*}
    (covariance : PositiveBivariateCovariance) (x : Sample → ℝ) :
    Sample → ℝ :=
  fun sample => covariance.forwardCoefficient * x sample

theorem forwardCandidate_batchEnergy_on_trueResponse
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance)
    (x : Sample → ℝ) (coefficient : ℝ) :
    covariance.forwardCandidateInterventionalBatchEnergy x
        (covariance.trueForwardInterventionResponse x) coefficient =
      ((covariance.forwardCoefficient - coefficient) ^ 2 /
        (2 * covariance.forwardResidualVariance)) *
        ∑ sample, x sample ^ 2 := by
  simp only [forwardCandidateInterventionalBatchEnergy,
    covariance.forwardCandidateInterventionalEnergy_exact,
    trueForwardInterventionResponse]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro sample _hsample
  ring

theorem reverseCandidate_batchEnergy_on_trueResponse
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance)
    (x : Sample → ℝ) (coefficient : ℝ) :
    covariance.reverseCandidateInterventionalBatchEnergy x
        (covariance.trueForwardInterventionResponse x) coefficient =
      (covariance.forwardCoefficient ^ 2 / (2 * covariance.varY)) *
        ∑ sample, x sample ^ 2 := by
  simp only [reverseCandidateInterventionalBatchEnergy,
    covariance.reverseCandidateInterventionalEnergy_exact,
    trueForwardInterventionResponse]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro sample _hsample
  ring

/-- A fitted forward coefficient is an actual minimizer of its own batch
objective, not a parameter fixed in advance. -/
def IsMinimizedForwardInterventionalBatchEnergy
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance)
    (x y : Sample → ℝ) (coefficient : ℝ) : Prop :=
  IsMinOn
    (covariance.forwardCandidateInterventionalBatchEnergy x y)
    Set.univ coefficient

/-- A fitted reverse coefficient is an actual minimizer of its own batch
objective. -/
def IsMinimizedReverseInterventionalBatchEnergy
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance)
    (x y : Sample → ℝ) (coefficient : ℝ) : Prop :=
  IsMinOn
    (covariance.reverseCandidateInterventionalBatchEnergy x y)
    Set.univ coefficient

theorem forwardCoefficient_isMinimized_on_trueResponse
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance) (x : Sample → ℝ) :
    covariance.IsMinimizedForwardInterventionalBatchEnergy x
      (covariance.trueForwardInterventionResponse x)
      covariance.forwardCoefficient := by
  have hpointwise : ∀ coefficient : ℝ,
      covariance.forwardCandidateInterventionalBatchEnergy x
          (covariance.trueForwardInterventionResponse x)
          covariance.forwardCoefficient ≤
        covariance.forwardCandidateInterventionalBatchEnergy x
          (covariance.trueForwardInterventionResponse x) coefficient := by
    intro coefficient
    rw [covariance.forwardCandidate_batchEnergy_on_trueResponse,
      covariance.forwardCandidate_batchEnergy_on_trueResponse]
    simp only [sub_self, zero_pow (by norm_num : (2 : ℕ) ≠ 0), zero_div,
      zero_mul]
    have hdenominator : 0 ≤ 2 * covariance.forwardResidualVariance :=
      le_of_lt (mul_pos (by norm_num) covariance.forwardResidualVariance_pos)
    have hsum : 0 ≤ ∑ sample, x sample ^ 2 :=
      Finset.sum_nonneg fun sample _ => sq_nonneg (x sample)
    exact mul_nonneg (div_nonneg (sq_nonneg _) hdenominator) hsum
  simpa [IsMinimizedForwardInterventionalBatchEnergy, IsMinOn,
    IsMinFilter] using hpointwise

/-- On an excited design, coefficient fitting in the forward family is
non-vacuous: the true structural coefficient is the unique minimizer. -/
theorem isMinimizedForwardInterventionalBatchEnergy_iff
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance) (x : Sample → ℝ)
    (hexcited : 0 < ∑ sample, x sample ^ 2) (coefficient : ℝ) :
    covariance.IsMinimizedForwardInterventionalBatchEnergy x
        (covariance.trueForwardInterventionResponse x) coefficient ↔
      coefficient = covariance.forwardCoefficient := by
  constructor
  · intro hmin
    have hpointwise : ∀ other : ℝ,
        covariance.forwardCandidateInterventionalBatchEnergy x
            (covariance.trueForwardInterventionResponse x) coefficient ≤
          covariance.forwardCandidateInterventionalBatchEnergy x
            (covariance.trueForwardInterventionResponse x) other := by
      simpa [IsMinimizedForwardInterventionalBatchEnergy, IsMinOn,
        IsMinFilter] using hmin
    have hle := hpointwise covariance.forwardCoefficient
    rw [covariance.forwardCandidate_batchEnergy_on_trueResponse,
      covariance.forwardCandidate_batchEnergy_on_trueResponse] at hle
    simp only [sub_self, zero_pow (by norm_num : (2 : ℕ) ≠ 0), zero_div,
      zero_mul] at hle
    by_contra hne
    have hsub : covariance.forwardCoefficient - coefficient ≠ 0 :=
      sub_ne_zero.mpr (Ne.symm hne)
    have hsquare : 0 < (covariance.forwardCoefficient - coefficient) ^ 2 :=
      sq_pos_of_ne_zero hsub
    have hdenominator : 0 < 2 * covariance.forwardResidualVariance :=
      mul_pos (by norm_num) covariance.forwardResidualVariance_pos
    have hpositive :
        0 < ((covariance.forwardCoefficient - coefficient) ^ 2 /
          (2 * covariance.forwardResidualVariance)) *
            ∑ sample, x sample ^ 2 :=
      mul_pos (div_pos hsquare hdenominator) hexcited
    linarith
  · rintro rfl
    exact covariance.forwardCoefficient_isMinimized_on_trueResponse x

/-- Every reverse coefficient is a genuine minimizer because `do(X)` deletes
the reverse `Y -> X` residual row.  The candidate models remain distinct;
the score invariance is a consequence of the uniform intervention. -/
theorem every_reverseCoefficient_isMinimized_on_trueResponse
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance)
    (x : Sample → ℝ) (coefficient : ℝ) :
    covariance.IsMinimizedReverseInterventionalBatchEnergy x
      (covariance.trueForwardInterventionResponse x) coefficient := by
  have hpointwise : ∀ other : ℝ,
      covariance.reverseCandidateInterventionalBatchEnergy x
          (covariance.trueForwardInterventionResponse x) coefficient ≤
        covariance.reverseCandidateInterventionalBatchEnergy x
          (covariance.trueForwardInterventionResponse x) other := by
    intro other
    rw [covariance.reverseCandidate_batchEnergy_on_trueResponse,
      covariance.reverseCandidate_batchEnergy_on_trueResponse]
  simpa [IsMinimizedReverseInterventionalBatchEnergy, IsMinOn,
    IsMinFilter] using hpointwise

/-- Anti-vacuity for B1: the reverse candidates with coefficients `0` and
`1` are distinct structural models, although severing `X` makes their batch
scores equal. -/
theorem reverseCandidates_distinct_but_intervention_deletes_parameter
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance) (x y : Sample → ℝ) :
    covariance.reverseCandidateResidualModel 0 ≠
        covariance.reverseCandidateResidualModel 1 ∧
      covariance.reverseCandidateInterventionalBatchEnergy x y 0 =
        covariance.reverseCandidateInterventionalBatchEnergy x y 1 := by
  constructor
  · exact covariance.reverseCandidateResidualModel_injective (by norm_num)
  · simp only [reverseCandidateInterventionalBatchEnergy,
      covariance.reverseCandidateInterventionalEnergy_exact]

/-! ## B2: minimized-energy causal selection -/

/-- The true forward orientation wins after both orientations minimize their
own free coefficient on the same finite interventional batch. -/
def ForwardOrientationWinsByMinimizedInterventionalEnergy
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance) (x : Sample → ℝ) : Prop :=
  ∃ forwardCoefficient reverseCoefficient : ℝ,
    covariance.IsMinimizedForwardInterventionalBatchEnergy x
        (covariance.trueForwardInterventionResponse x) forwardCoefficient ∧
      covariance.IsMinimizedReverseInterventionalBatchEnergy x
        (covariance.trueForwardInterventionResponse x) reverseCoefficient ∧
      covariance.forwardCandidateInterventionalBatchEnergy x
          (covariance.trueForwardInterventionResponse x) forwardCoefficient <
        covariance.reverseCandidateInterventionalBatchEnergy x
          (covariance.trueForwardInterventionResponse x) reverseCoefficient

/-- B2 crown: on any finite intervention design with positive total squared
input, fitting selects the true `X -> Y` orientation exactly when the
observational covariance is nonzero.  This adds minimization over both
orientation-specific parameter families; the earlier landscape witness did
not imply it. -/
theorem forwardOrientationWinsByMinimizedInterventionalEnergy_iff
    {Sample : Type*} [Fintype Sample]
    (covariance : PositiveBivariateCovariance) (x : Sample → ℝ)
    (hexcited : 0 < ∑ sample, x sample ^ 2) :
    covariance.ForwardOrientationWinsByMinimizedInterventionalEnergy x ↔
      covariance.covXY ≠ 0 := by
  constructor
  · rintro ⟨fittedForward, fittedReverse,
      hforwardMin, _hreverseMin, hstrict⟩
    have hfitted : fittedForward = covariance.forwardCoefficient :=
      (covariance.isMinimizedForwardInterventionalBatchEnergy_iff
        x hexcited fittedForward).mp hforwardMin
    subst fittedForward
    intro hzero
    rw [covariance.forwardCandidate_batchEnergy_on_trueResponse,
      covariance.reverseCandidate_batchEnergy_on_trueResponse] at hstrict
    have hforwardCoefficient : covariance.forwardCoefficient = 0 := by
      simp [PositiveBivariateCovariance.forwardCoefficient, hzero]
    rw [hforwardCoefficient] at hstrict
    norm_num at hstrict
  · intro hcorrelated
    refine ⟨covariance.forwardCoefficient, 0,
      covariance.forwardCoefficient_isMinimized_on_trueResponse x,
      covariance.every_reverseCoefficient_isMinimized_on_trueResponse x 0, ?_⟩
    rw [covariance.forwardCandidate_batchEnergy_on_trueResponse,
      covariance.reverseCandidate_batchEnergy_on_trueResponse]
    have hcoefficient : covariance.forwardCoefficient ≠ 0 := by
      exact div_ne_zero hcorrelated covariance.varX_ne_zero
    have hreversePositive :
        0 < (covariance.forwardCoefficient ^ 2 /
          (2 * covariance.varY)) * ∑ sample, x sample ^ 2 := by
      have hsquare : 0 < covariance.forwardCoefficient ^ 2 :=
        sq_pos_of_ne_zero hcoefficient
      have hdenominator : 0 < 2 * covariance.varY := by
        exact mul_pos (by norm_num) covariance.varY_pos
      exact mul_pos (div_pos hsquare hdenominator) hexcited
    norm_num
    exact hreversePositive

/-! ## B3: positive and negative finite fixtures -/

noncomputable def singletonInterventionDesign : Fin 1 → ℝ := fun _ => 1

theorem singletonInterventionDesign_excited :
    0 < ∑ sample, singletonInterventionDesign sample ^ 2 := by
  norm_num [singletonInterventionDesign]

/-- Positive fixture at the correlated covariance from the intervention
certificate: honest fitting selects the forward orientation. -/
theorem unitNoiseForwardCovariance_minimizedIntervention_selects_forward :
    unitNoiseForwardCovariance.ForwardOrientationWinsByMinimizedInterventionalEnergy
      singletonInterventionDesign := by
  rw [unitNoiseForwardCovariance.forwardOrientationWinsByMinimizedInterventionalEnergy_iff
    singletonInterventionDesign singletonInterventionDesign_excited]
  norm_num [unitNoiseForwardCovariance]

/-- Negative fixture: at independent equal variance both orientation
families attain the same minimum `0`, so fitted intervention does not select
a direction. -/
theorem independentEqualVariance_minimizedIntervention_tied :
    ¬ independentEqualVarianceCovariance.ForwardOrientationWinsByMinimizedInterventionalEnergy
        singletonInterventionDesign ∧
      ∃ forwardCoefficient reverseCoefficient : ℝ,
        independentEqualVarianceCovariance.IsMinimizedForwardInterventionalBatchEnergy
            singletonInterventionDesign
            (independentEqualVarianceCovariance.trueForwardInterventionResponse
              singletonInterventionDesign) forwardCoefficient ∧
          independentEqualVarianceCovariance.IsMinimizedReverseInterventionalBatchEnergy
            singletonInterventionDesign
            (independentEqualVarianceCovariance.trueForwardInterventionResponse
              singletonInterventionDesign) reverseCoefficient ∧
          independentEqualVarianceCovariance.forwardCandidateInterventionalBatchEnergy
              singletonInterventionDesign
              (independentEqualVarianceCovariance.trueForwardInterventionResponse
                singletonInterventionDesign) forwardCoefficient =
            independentEqualVarianceCovariance.reverseCandidateInterventionalBatchEnergy
              singletonInterventionDesign
              (independentEqualVarianceCovariance.trueForwardInterventionResponse
                singletonInterventionDesign) reverseCoefficient := by
  constructor
  · rw [independentEqualVarianceCovariance
      |>.forwardOrientationWinsByMinimizedInterventionalEnergy_iff
        singletonInterventionDesign singletonInterventionDesign_excited]
    norm_num [independentEqualVarianceCovariance]
  · refine ⟨independentEqualVarianceCovariance.forwardCoefficient, 0,
      independentEqualVarianceCovariance.forwardCoefficient_isMinimized_on_trueResponse
        singletonInterventionDesign,
      independentEqualVarianceCovariance.every_reverseCoefficient_isMinimized_on_trueResponse
        singletonInterventionDesign 0, ?_⟩
    rw [independentEqualVarianceCovariance.forwardCandidate_batchEnergy_on_trueResponse,
      independentEqualVarianceCovariance.reverseCandidate_batchEnergy_on_trueResponse]
    norm_num [forwardCoefficient, independentEqualVarianceCovariance]

end PositiveBivariateCovariance
end Mettapedia.MachineLearning.NeuralNetworks.PredictiveCoding
