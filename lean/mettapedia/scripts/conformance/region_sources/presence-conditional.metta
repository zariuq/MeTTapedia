(sat tag 7)
(sat tag 7)
(sat tag 8)

(= (present $x)
  (not (== (collapse (once (match &self (sat tag $x) t))) ())))
(= (choose $x)
  (if (present $x) (add-atom &self (picked yes)) (add-atom &self (picked no))))
(= (condition)
  (let $ignored (add-atom &self (tested)) (present 7)))

!(choose 7)
!(choose 9)
!(collapse (match &self (picked $branch) $branch))
!(if (present 7) (quote kept) (add-atom missing-space (wrong)))
!(if (present 9) (add-atom missing-space (wrong)) (quote missing))
!(if (condition) (quote chosen) (quote rejected))
!(size-atom (collapse (match &self (tested) t)))
!(collapse (if (superpose (False True)) (quote yes) (quote no)))
