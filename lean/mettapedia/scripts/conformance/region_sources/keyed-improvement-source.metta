(sd 0 10)
(sd 1 5)
(sd 2 7)
(sd 2 7)
(distance 6 8)

(= (improve $space $vertex $candidate)
  (let $current (collapse (match $space (sd $vertex $previous) $previous))
    (if (== $current ())
      (let $discard (add-atom $space (sd $vertex $candidate)) $vertex)
      (let ($previous) $current
        (if (< $candidate $previous)
          (let* (($discard (remove-atom $space (sd $vertex $previous)))
                 ($discard (add-atom $space (sd $vertex $candidate)))) $vertex)
          (empty))))))
(= (improve 7 0 7) unreachable)

(= (lower-renamed $destination $node $proposed)
  (let $found (collapse (match $destination (distance $node $old) $old))
    (if (== $found ())
      (let $written (add-atom $destination (distance $node $proposed)) $node)
      (let ($old) $found
        (if (< $proposed $old)
          (let* (($written (remove-atom $destination (distance $node $old)))
                 ($written (add-atom $destination (distance $node $proposed)))) $node)
          (empty))))))

!(collapse (improve &self 0 7))
!(collapse (improve &self 0 12))
!(collapse (improve &self 5 9))
!(collapse (improve &self 2 1))
!(collapse (match &self (sd $vertex $distance) (quote ($vertex $distance))))
!(collapse (lower-renamed &self 6 3))
!(collapse (match &self (distance $vertex $distance) (quote ($vertex $distance))))
