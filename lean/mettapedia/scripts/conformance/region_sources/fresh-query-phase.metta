(phase-step b)
(phase-cell seed)

!(+ (size-atom (collapse (match &self (phase-p $x)
      (let $payload (quote (phase-q $x))
        (if (== (collapse (match &self $payload true)) ())
          (add-atom &self $payload) (empty))))))
    (+ (size-atom (collapse (match &self (phase-q $x)
      (let $payload (quote (phase-r $x))
        (if (== (collapse (match &self $payload true)) ())
          (add-atom &self $payload) (empty)))))) 0))
!(+ (size-atom (collapse (match &self (phase-p $x)
      (let $payload (quote (phase-q $x))
        (if (== (collapse (match &self $payload true)) ())
          (add-atom &self $payload) (empty))))))
    (+ (size-atom (collapse (match &self (phase-q $x)
      (let $payload (quote (phase-r $x))
        (if (== (collapse (match &self $payload true)) ())
          (add-atom &self $payload) (empty)))))) 0))
!(size-atom (collapse (match &self (phase-p $x) $x)))
!(size-atom (collapse (match &self (phase-step $x)
    (match &self (phase-cell $y)
      (let $payload (quote (phase-cell (pair $x $y)))
        (if (== (collapse (match &self $payload true)) ())
          (add-atom &self $payload) (empty)))))))
!(collapse (match &self (phase-cell $x) $x))
