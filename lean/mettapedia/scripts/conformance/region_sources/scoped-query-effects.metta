(row 7)
(row 7)
(row 8)
(payload (add-atom &self (unexpected)))

!(size-atom (collapse (match &self (row $x) (add-atom &self (mark $x)))))
!(collapse (match &self (mark $x) $x))
!(size-atom (collapse (match &self (row $x)
  (if (not (== (collapse (once (match &self (fresh $x) t))) ()))
    (empty)
    (add-atom &self (fresh $x))))))
!(collapse (match &self (fresh $x) $x))
!(size-atom (collapse (match &self (row $x) (add-atom &self (row $x)))))
!(size-atom (collapse (match &self (row $x) $x)))
!(size-atom (collapse (match &self (payload $x) $x)))
!(collapse (match &self (unexpected) t))
