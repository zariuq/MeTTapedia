(fr f 0 2)
(fr f 1 2)
(fr f 0 2)
(rt 2 1)
(rt 7 99)
(rt 2 1)
(sat a 1)
(sat other 1)
(sat a 1)

(= (in $f $x) (not (== (collapse (once (match &self (sat $f $x) t))) ())))
(= (try $x)
  (if (in f $x) (empty)
    (let $ignored (add-atom &self (sat f $x))
      (add-atom &self (fr f 1 $x)))))
(= (round)
  (size-atom (collapse
    (match &self (fr f 0 $y)
      (match &self (rt $y $x)
        (match &self (sat a $x) (try $x)))))))

!(collapse (match &self (fr f 0 $y)
  (match &self (rt $y $x) (match &self (sat a $x) $x))))
!(round)
!(round)
!(collapse (match &self (sat f $x) $x))
