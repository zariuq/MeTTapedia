(= (cycle-a $space)
   (let $row (quote (node a))
     (if (== (collapse (match $space $row true)) ())
       (let $written (add-atom $space $row) (cycle-b $space))
       (empty))))
(= (cycle-b $space)
   (let $row (quote (node b))
     (if (== (collapse (match $space $row true)) ())
       (let $written (add-atom $space $row) (cycle-a $space))
       (empty))))

!(collapse (cycle-a &self))
!(collapse (match &self (node $x) $x))
!(collapse (cycle-a &self))
!(collapse (match &self (node $x) $x))
