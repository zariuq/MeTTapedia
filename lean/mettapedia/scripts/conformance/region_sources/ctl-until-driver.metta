(rt 1 0)
(rt 2 1)
(sat a 0)
(sat a 1)
(sat a 3)
(sat b 2)

(= (in $f $x) (not (== (collapse (once (match &self (sat $f $x) t))) ())))
(= (eu-round $f $a $k $k1)
  (size-atom (collapse (match &self (fr $f $k $y)
    (match &self (rt $y $x) (match &self (sat $a $x)
      (if (in $f $x) (empty)
        (let $ignored (add-atom &self (sat $f $x))
          (add-atom &self (fr $f $k1 $x))))))))))
(= (drop $f $k)
  (size-atom (collapse (match &self (fr $f $k $x) (remove-atom &self (fr $f $k $x))))))
(= (eu-loop $f $a $k)
  (let* (($k1 (+ $k 1)) ($n (eu-round $f $a $k $k1)) ($d (drop $f $k)))
    (if (== $n 0) $k1 (eu-loop $f $a $k1))))
(= (do-eu $f $a $b)
  (let $n (size-atom (collapse (match &self (sat $b $x)
    (let $ignored (add-atom &self (sat $f $x)) (add-atom &self (fr $f 0 $x))))))
    (eu-loop $f $a 0)))

!(do-eu f a b)
!(collapse (match &self (sat f $x) $x))
!(collapse (match &self (fr f $k $x) ($k $x)))
!(do-eu empty-result a absent)
!(collapse (match &self (sat empty-result $x) $x))
