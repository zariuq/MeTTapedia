(= (install $f $k $x)
  (let $ignored (add-atom &self (sat $f $x))
    (add-atom &self (fr $f $k $x))))

!(install out 1 7)
!(collapse (match &self (sat out $x) $x))
!(collapse (match &self (fr out 1 $x) $x))
!(let $ignored (add-atom &self (twice 7)) (add-atom &self (twice 7)))
!(size-atom (collapse (match &self (twice $x) $x)))
!(let $held (quote (payload (add-atom &self (unexpected))))
  (let $ignored (add-atom &self $held) (add-atom &self (finished))))
!(size-atom (collapse (match &self (payload $x) $x)))
!(collapse (match &self (unexpected) t))
!(collapse (match &self (finished) t))
