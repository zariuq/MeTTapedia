(payload $unrelated)
(fr 10 0 2)
(sat 20 1)
(rt 2 1)
(= (irrelevant $x) $x)
(fr 10 0 2)
(rt 2 1)
(sat 20 1)
(fr 10 1 9)
(sat 99 1)

(= (in $f $x) (not (== (collapse (once (match &self (sat $f $x) t))) ())))
(= (try $x)
  (if (in 10 $x) (empty)
    (let $ignored (add-atom &self (sat 10 $x))
      (add-atom &self (fr 10 1 $x)))))
(= (round)
  (size-atom (collapse
    (match &self (fr 10 0 $y)
      (match &self (rt $y $x)
        (match &self (sat 20 $x) (try $x)))))))

!(collapse (match &self (fr 10 0 $y)
  (match &self (rt $y $x) (match &self (sat 20 $x) $x))))
!(round)
!(round)
!(collapse (match &self (sat 10 $x) $x))
!(collapse (match &self (sat 20 $x) $x))
