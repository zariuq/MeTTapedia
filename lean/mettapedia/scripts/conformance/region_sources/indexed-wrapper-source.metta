(r 0 1)
(r 0 1)
(s 1 2)
(s 1 0)

(= (count-paths $space)
   (size-atom (collapse
     (match $space (r $x $y)
       (match $space (s $y $z) true)))))
(= (wrapper $table) (count-paths $table))
(= (empty-wrapper $table) (wrapper $table))
(= (empty-wrapper $unused) (empty))
(= (extra-wrapper $table) (wrapper $table))
(= (extra-wrapper $unused) 99)
(= (inert-wrapper $table) (wrapper $table))
(= (inert-wrapper 42) 99)

!(wrapper &self)
!(tag (< (wrapper &self) 5))
!(collapse (empty-wrapper &self))
!(collapse (extra-wrapper &self))
!(collapse (inert-wrapper &self))
!(let $saved (quote &self) (wrapper $saved))
!(size-atom (collapse (extra-wrapper &self)))
