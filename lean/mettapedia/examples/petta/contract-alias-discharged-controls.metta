; The first case must reject; the disjoint, clean and ground cases succeed.
(: Known (-> Number Tag))
(: alias-typed (-> $t %Undefined% $t))
(= (alias-typed $a $b) (let $b Known $a))
(: alias-clean (-> $t %Undefined% $t))
(= (alias-clean $a $b) (let $b UnknownHead $a))
(: bad-launch (-> Number Number))
(= (bad-launch $ignored) (let $result (alias-typed ($x 1) $x) 1))
(: disjoint-launch (-> Number Number))
(= (disjoint-launch $ignored) (let $result (alias-typed ($x 1) $y) 1))
(: clean-launch (-> Number Number))
(= (clean-launch $ignored) (let $result (alias-clean ($x 1) $x) 1))
(: ground-launch (-> Number Number))
(= (ground-launch $ignored) (let $result (alias-typed (Known 1) $y) 1))
!(collapse (bad-launch 0))
!(collapse (disjoint-launch 0))
!(collapse (clean-launch 0))
!(collapse (ground-launch 0))
