Module MobileAmbientsNu {
  Theory MobileAmbientsNu() {
    Types {
      Proc;
      Name;
    }
    Terms {
      "AZero" .  |- "0" : Proc;
      "APar" . ps:HashBag(Proc) |- "{" ps sep("|") "}" : Proc ![flatten, unit "AZero"];
      "ANu" . ^body:[Name -> Proc] |- "ν" body : Proc;
      "ARep" . p:Proc |- "!" p : Proc;
      "AAmb" . n:Name, p:Proc |- n "[" p "]" : Proc;
      "AIn" . n:Name, p:Proc |- "in" n "." p : Proc;
      "AOut" . n:Name, p:Proc |- "out" n "." p : Proc;
      "AOpen" . n:Name, p:Proc |- "open" n "." p : Proc;
    }
    Equations {
      "RestrictionNil" .  |- "ANu"(^."AZero") = "AZero";
      "RestrictionExchange" . P:Proc |- "ANu"(^x0."ANu"(^x1.P)) = "ANu"(^x1."ANu"(^x0.P));
      "ScopeExtrusion" . P:Proc, rest:HashBag(Proc) |- {"ANu"(^x0.P), ...rest} = "ANu"(^x0. {P, ...rest});
      "ReplicationUnfold" . P:Proc |- "ARep"(P) = {P, "ARep"(P)};
      "ReplicationNil" .  |- "ARep"("AZero") = "AZero";
      "ReplicationTwice" . P:Proc |- "ARep"("ARep"(P)) = "ARep"(P);
      "ReplicationPar" . P:Proc, Q:Proc |- "ARep"({P, Q}) = {"ARep"(P), "ARep"(Q)};
      "ReplicationIdempotent" . P:Proc |- {"ARep"(P), "ARep"(P)} = "ARep"(P);
      "AmbientBoundary" . m:Name, P:Proc |- "AAmb"(m, "ANu"(^x0.P)) = "ANu"(^x0."AAmb"(m, P));
    }
    Rewrites {
      "In" . n:Name, m:Name, p:Proc, s:Proc |- {"AAmb"(n, {"AIn"(m, p), ...inner}), "AAmb"(m, s), ...rest} ~> {"AAmb"(m, {"AAmb"(n, {p, ...inner}), s}), ...rest};
      "Out" . n:Name, m:Name, p:Proc |- "AAmb"(m, {"AAmb"(n, {"AOut"(m, p), ...inner}), ...rest}) ~> {"AAmb"(n, {p, ...inner}), "AAmb"(m, {...rest})};
      "Open" . n:Name, p:Proc, q:Proc |- {"AOpen"(n, p), "AAmb"(n, q), ...rest} ~> {p, q, ...rest};
      ParCong : if S ~> T then {S, ...rest} ~> {T, ...rest};
      ResCong : if S ~> T then "ANu"(^.S) ~> "ANu"(^.T);
      "AmbCong" . n:Name | S ~> T |- "AAmb"(n, S) ~> "AAmb"(n, T);
    }
  }
  theory MobileAmbientsNu()
}
