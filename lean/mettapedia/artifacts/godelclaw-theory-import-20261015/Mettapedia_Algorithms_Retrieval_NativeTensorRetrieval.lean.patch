 variable {I B : Type*} [DecidableEq I] [LinearOrder B]
 
-/-- `key` includes a stable tie ordinal. Smaller keys rank first. The numerical
-score and tie order must agree between the two kernels and the final merge. -/
+/-- Smaller keys rank first. A caller can include a unique stable tie ordinal;
+the definition does not enforce uniqueness. The numerical score and tie order
+must agree between the two kernels and the final merge. -/
 def rank (key : I → B) (source : Finset I) (i : I) : Nat :=
   (source.filter (fun j => key j < key i)).card
 
+/-- Retain all items with fewer than k strictly better keys. Tied keys may
+select more than k items. A cardinality bound requires a separate distinct-key
+assumption on the source; no such bound is proved here. -/
 def topK (key : I → B) (k : Nat) (source : Finset I) : Finset I :=
   source.filter (fun i => rank key source i < k)
 
