diff --git a/docbuild/lakefile.toml b/docbuild/lakefile.toml
index 8e91b9c3..fa1e373a 100644
--- a/docbuild/lakefile.toml
+++ b/docbuild/lakefile.toml
@@ -10,18 +10,12 @@ version = "0.1.0"
 # revision the parent pins. See https://github.com/leanprover/doc-gen4#usage.
 packagesDir = "../.lake/packages"
 
-# doc-gen4 with interproject linking (https://github.com/leanprover/doc-gen4/pull/396),
-# pinned to the fork branch until that PR lands upstream. It lets us document only TauCeti's
-# own modules and link references to Mathlib out to the hosted mathlib4_docs (see the
-# `DOCGEN_LOCAL_MODULE_ROOTS` / `DOCGEN_DEPS_DOCS_URL` env vars set in the Pages workflow),
-# instead of rendering the whole Mathlib closure locally. The revision is built against Lean
-# v4.33.0-rc1. This nested project inherits the root `lean-toolchain`; when it moves forward,
-# bump this to a compatible doc-gen4 revision and re-run
-# `MATHLIB_NO_CACHE_ON_UPDATE=1 lake update doc-gen4` in this directory.
+# This local fork preserves TauCeti's interproject linking on Lean 4.33.1.
+# DOCGEN_LOCAL_MODULE_ROOTS selects the modules rendered locally;
+# DOCGEN_DEPS_DOCS_URL supplies the documentation site for dependency links.
 [[require]]
 name = "doc-gen4"
-git = "https://github.com/kim-em/doc-gen4"
-rev = "4cac5a75c52048204e6d015554fbc10ce3f269a2"
+path = "../../doc-gen4-tauceti"
 
 [[require]]
 name = "TauCeti"
