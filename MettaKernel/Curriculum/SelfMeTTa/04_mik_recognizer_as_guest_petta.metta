!(import! &self /home/aimama/aihub/hyperon/PeTTa/lib/lib_he)

; ============================================================================
; SelfMeTTa 04: MIK LF recognizer hosted as guest rewrite data.
;
; The imported checker is the same generic v2 witness substrate as SelfMeTTa 02:
; explicit position paths, repeated-pattern-variable matching, ordered rules,
; and trace checking without searching for the rewritten position.  The pLF table
; and traces are guest data derived from the current LF recognizer encoding.
; ============================================================================

!(import! &self selfmetta_v2_substrate)

(= (sm_ld $rules) (sm_v2_ld SelfMeTTa04 $rules))

; ---------- guest AST builders ----------------------------------------------
(= (g0 $name) (MSym $name))
(= (g1 $h $a) (MApp (MSym $h) $a))
(= (g2 $h $a $b) (MApp (MApp (MSym $h) $a) $b))
(= (g3 $h $a $b $c) (MApp (MApp (MApp (MSym $h) $a) $b) $c))
(= (g4 $h $a $b $c $d) (MApp (MApp (MApp (MApp (MSym $h) $a) $b) $c) $d))
(= (g5 $h $a $b $c $d $e) (MApp (MApp (MApp (MApp (MApp (MSym $h) $a) $b) $c) $d) $e))
(= (tid $s) (g1 Tid (g0 $s)))

(= (p0) (g0 Z))
(= (p1) (g1 S (p0)))
