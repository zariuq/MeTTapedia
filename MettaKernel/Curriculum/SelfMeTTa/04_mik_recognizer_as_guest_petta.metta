                                    (RCons (Rule sh_app (g2 shift (MVar c) (g2 App (MVar f) (MVar a))) (g2 App (g2 shift (MVar c) (MVar f)) (g2 shift (MVar c) (MVar a))))
                                       (RCons (Rule ctx_nil (g2 ctxidx (g0 Nil) (MVar s)) (g0 NF))
                                          (RCons (Rule ctx_hit (g2 ctxidx (g2 Cons (MVar h) (MVar t)) (MVar h)) (g1 Idx (p0)))
                                             (RCons (Rule ctx_miss (g2 ctxidx (g2 Cons (MVar h) (MVar t)) (MVar s)) (g1 ctxK (g2 ctxidx (MVar t) (MVar s))))
                                                (RCons (Rule ctxK_nf (g1 ctxK (g0 NF)) (g0 NF))
                                                   (RCons (Rule ctxK_idx (g1 ctxK (g1 Idx (MVar k))) (g1 Idx (g1 S (MVar k))))
                                                      (RCons (Rule res (g2 resolve (MVar ctx) (MVar s)) (g2 resolveK (MVar s) (g2 ctxidx (MVar ctx) (MVar s))))
                                                         (RCons (Rule res_idx (g2 resolveK (MVar s) (g1 Idx (MVar k))) (g1 Var (MVar k)))
                                                            (RCons (Rule res_nf (g2 resolveK (MVar s) (g0 NF)) (g1 Con (MVar s)))
                                                               (RCons (Rule tm_z (g3 tm (p0) (MVar c) (MVar t)) (g1 PErr (g0 no-fuel)))
                                                                  (RCons (Rule tm_pi (g3 tm (g1 S (MVar f)) (MVar c) (g2 Cons (g0 PI) (g2 Cons (g1 Tid (MVar x)) (g2 Cons (g0 COLON) (MVar rest))))) (g4 tmPi1 (MVar f) (MVar c) (MVar x) (g3 ap (MVar f) (MVar c) (MVar rest))))
                                                                     (RCons (Rule tm_lam (g3 tm (g1 S (MVar f)) (MVar c) (g2 Cons (g0 LAM) (g2 Cons (g1 Tid (MVar x)) (g2 Cons (g0 COLON) (MVar rest))))) (g4 tmLam1 (MVar f) (MVar c) (MVar x) (g3 ap (MVar f) (MVar c) (MVar rest))))
                                                                        (RCons (Rule tm_fall (g3 tm (g1 S (MVar f)) (MVar c) (MVar t)) (g3 ar (MVar f) (MVar c) (MVar t)))
                                                                           (RCons (Rule tmPi1_dot (g4 tmPi1 (MVar f) (MVar c) (MVar x) (g2 P (MVar A) (g2 Cons (g0 DOT) (MVar r2)))) (g2 tmPi2 (MVar A) (g3 tm (MVar f) (g2 Cons (MVar x) (MVar c)) (MVar r2))))
                                                                              (RCons (Rule tmPi1_cons (g4 tmPi1 (MVar f) (MVar c) (MVar x) (g2 P (MVar A) (g2 Cons (MVar tok) (MVar r2)))) (g1 PErr (g0 pi-malformed)))
                                                                                 (RCons (Rule tmPi1_nil (g4 tmPi1 (MVar f) (MVar c) (MVar x) (g2 P (MVar A) (g0 Nil))) (g1 PErr (g0 pi-malformed)))
                                                                                    (RCons (Rule tmPi1_err (g4 tmPi1 (MVar f) (MVar c) (MVar x) (g1 PErr (MVar e))) (g1 PErr (g0 pi-malformed)))
                                                                                       (RCons (Rule tmPi2_p (g2 tmPi2 (MVar A) (g2 P (MVar B) (MVar r3))) (g2 P (g2 Pi (MVar A) (MVar B)) (MVar r3)))
                                                                                          (RCons (Rule tmPi2_err (g2 tmPi2 (MVar A) (g1 PErr (MVar e))) (g1 PErr (MVar e)))
                                                                                             (RCons (Rule tmLam1_dot (g4 tmLam1 (MVar f) (MVar c) (MVar x) (g2 P (MVar A) (g2 Cons (g0 DOT) (MVar r2)))) (g2 tmLam2 (MVar A) (g3 tm (MVar f) (g2 Cons (MVar x) (MVar c)) (MVar r2))))
                                                                                                (RCons (Rule tmLam1_cons (g4 tmLam1 (MVar f) (MVar c) (MVar x) (g2 P (MVar A) (g2 Cons (MVar tok) (MVar r2)))) (g1 PErr (g0 lam-malformed)))
                                                                                                   (RCons (Rule tmLam1_nil (g4 tmLam1 (MVar f) (MVar c) (MVar x) (g2 P (MVar A) (g0 Nil))) (g1 PErr (g0 lam-malformed)))
                                                                                                      (RCons (Rule tmLam1_err (g4 tmLam1 (MVar f) (MVar c) (MVar x) (g1 PErr (MVar e))) (g1 PErr (g0 lam-malformed)))
                                                                                                         (RCons (Rule tmLam2_p (g2 tmLam2 (MVar A) (g2 P (MVar b) (MVar r3))) (g2 P (g2 Lam (MVar A) (MVar b)) (MVar r3)))
                                                                                                            (RCons (Rule tmLam2_err (g2 tmLam2 (MVar A) (g1 PErr (MVar e))) (g1 PErr (MVar e)))
                                                                                                               (RCons (Rule ar_z (g3 ar (p0) (MVar c) (MVar t)) (g1 PErr (g0 no-fuel)))
                                                                                                                  (RCons (Rule ar_s (g3 ar (g1 S (MVar f)) (MVar c) (MVar t)) (g3 arK (MVar f) (MVar c) (g3 ap (MVar f) (MVar c) (MVar t))))
