                                                                                                                                 (RCons (Rule arK2_p (g2 arK2 (MVar a) (g2 P (MVar b) (MVar r2))) (g2 P (g2 Pi (MVar a) (g2 shift (p0) (MVar b))) (MVar r2)))
                                                                                                                                    (RCons (Rule arK2_err (g2 arK2 (MVar a) (g1 PErr (MVar e))) (g1 PErr (MVar e)))
                                                                                                                                       (RCons (Rule ap_z (g3 ap (p0) (MVar c) (MVar t)) (g1 PErr (g0 no-fuel)))
                                                                                                                                          (RCons (Rule ap_s (g3 ap (g1 S (MVar f)) (MVar c) (MVar t)) (g3 apK (MVar f) (MVar c) (g3 at (MVar f) (MVar c) (MVar t))))
                                                                                                                                             (RCons (Rule apK_p (g3 apK (MVar f) (MVar c) (g2 P (MVar a0) (MVar r0))) (g4 apm (MVar f) (MVar c) (MVar a0) (MVar r0)))
                                                                                                                                                (RCons (Rule apK_err (g3 apK (MVar f) (MVar c) (g1 PErr (MVar e))) (g1 PErr (MVar e)))
                                                                                                                                                   (RCons (Rule apm_z (g4 apm (p0) (MVar c) (MVar acc) (MVar t)) (g2 P (MVar acc) (MVar t)))
                                                                                                                                                      (RCons (Rule apm_s (g4 apm (g1 S (MVar f)) (MVar c) (MVar acc) (MVar t)) (g5 apmK (MVar f) (MVar c) (MVar acc) (MVar t) (g3 at (MVar f) (MVar c) (MVar t))))
                                                                                                                                                         (RCons (Rule apmK_p (g5 apmK (MVar f) (MVar c) (MVar acc) (MVar toks) (g2 P (MVar a) (MVar rest))) (g4 apm (MVar f) (MVar c) (g2 App (MVar acc) (MVar a)) (MVar rest)))
                                                                                                                                                            (RCons (Rule apmK_err (g5 apmK (MVar f) (MVar c) (MVar acc) (MVar toks) (g1 PErr (MVar e))) (g2 P (MVar acc) (MVar toks)))
                                                                                                                                                               (RCons (Rule at_z (g3 at (p0) (MVar c) (MVar t)) (g1 PErr (g0 no-fuel)))
