                                                                                                                                                                              (RCons (Rule atLPk_rp (g3 atLPk (MVar f) (MVar c) (g2 P (MVar t) (g2 Cons (g0 RP) (MVar r2)))) (g2 P (MVar t) (MVar r2)))
