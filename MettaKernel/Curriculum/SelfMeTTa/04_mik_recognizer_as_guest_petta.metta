   (RCons (Rule lt_z_s (g2 lt (p0) (g1 S (MVar m))) (g0 tt))
      (RCons (Rule lt_z_z (g2 lt (p0) (p0)) (g0 ff))
         (RCons (Rule lt_s_z (g2 lt (g1 S (MVar n)) (p0)) (g0 ff))
            (RCons (Rule lt_s_s (g2 lt (g1 S (MVar n)) (g1 S (MVar m))) (g2 lt (MVar n) (MVar m)))
               (RCons (Rule sh_var (g2 shift (MVar c) (g1 Var (MVar k))) (g3 shiftVar (MVar c) (MVar k) (g2 lt (MVar k) (MVar c))))
                  (RCons (Rule sh_var_lt (g3 shiftVar (MVar c) (MVar k) (g0 tt)) (g1 Var (MVar k)))
                     (RCons (Rule sh_var_ge (g3 shiftVar (MVar c) (MVar k) (g0 ff)) (g1 Var (g1 S (MVar k))))
                        (RCons (Rule sh_srt (g2 shift (MVar c) (g1 Srt (MVar s))) (g1 Srt (MVar s)))
                           (RCons (Rule sh_con (g2 shift (MVar c) (g1 Con (MVar x))) (g1 Con (MVar x)))
