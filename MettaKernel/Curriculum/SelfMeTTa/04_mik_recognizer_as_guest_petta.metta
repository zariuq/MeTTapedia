                                                                                                                                                                                       (RCons (Rule atLPk_err (g3 atLPk (MVar f) (MVar c) (g1 PErr (MVar e))) (g1 PErr (g0 paren-malformed)))
                                                                                                                                                                                          (RCons (Rule rec (g1 lfrec (MVar t)) (g1 recK (g3 tm (p64) (g0 Nil) (MVar t))))
                                                                                                                                                                                             (RCons (Rule recK_nil (g1 recK (g2 P (MVar t) (g0 Nil))) (g1 Ok (MVar t)))
