(= (mm-target-wrong-goal)
   (PApp "$mm.j.vars"
     (LCons (PApp "$mm.nil" LNil)
       (LCons (PApp "$mm.nil" LNil) LNil))))
(= (mm-target-child-cardinality-mutation (GProof $ri PrNil))
   (GProof $ri
     (PrCons (GProof (GRuleInst "$mm.missing-rule" LNil) PrNil) PrNil)))
(= (mm-target-child-cardinality-mutation
      (GProof $ri (PrCons $p $ps)))
   (GProof $ri $ps))
(= (mm-target-wrong-child-count-proof)
   (mm-target-child-cardinality-mutation (mm-target-proof)))

!(assertEqual
  (gslt-source-check-batch-v1 (mm-target-source)
    (CheckCons
      (GCheck (mm-target-goal) (mm-target-proof) True)
      (CheckCons
        (GCheck (mm-target-goal)
          (GProof (GRuleInst "$mm.missing-rule" LNil) PrNil) False)
        (CheckCons
          (GCheck (mm-target-goal)
            (mm-target-wrong-child-count-proof) False)
          (CheckCons
            (GCheck (mm-target-goal)
              (GProof (GRuleInst "jca" LNil) PrNil) False)
            (CheckCons
              (GCheck (mm-target-wrong-goal)
                (mm-target-proof) False)
              CheckNil))))))
  True)
