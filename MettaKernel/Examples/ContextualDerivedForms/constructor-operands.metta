(= (choose a) left)
(= (choose b) right)
!(collapse (record (choose $x) $x))
!(record (let $ignored1 (add-atom &self (mark first)) a)
         (let $ignored2 (add-atom &self (mark second)) b))
!(collapse (match &self (mark $x) $x))
!(collapse (record (let $ignored3 (add-atom &self (mark retained)) a) (empty)))
!(collapse (match &self (mark retained) present))
!(let (record $a $b) (record $x $x) (== $a $b))
!(let* (((record $a $b) (record a b))
        ($r (record $a $b))) $r)
!(case a ((a (record selected)) ($any (record fallback))))
