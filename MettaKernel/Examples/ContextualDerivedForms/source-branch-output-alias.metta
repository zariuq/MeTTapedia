(= (effect-choice $x $y)
   (superpose ((let $ignored1 (add-atom &self (event left)) $x)
               (let $ignored2 (add-atom &self (event right)) $y))))
(= (pure-choice $x $y) (superpose ($x $y)))
!(collapse (effect-choice a b))
!(collapse (match &self (event $x) $x))
!(collapse (pure-choice a b))
!(collapse (effect-choice a a))
!(collapse (match &self (event $x) $x))
