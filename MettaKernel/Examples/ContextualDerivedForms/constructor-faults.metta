!(let $f (|-> ()
    (superpose ((record kept)
                (record (let $ignored1 (add-atom &self (mark caught))
                          (+ bad-value 3))))))
   (collapse ($f)))
!(collapse (match &self (mark caught) present))
!(let $f (|-> ()
    (record (let $ignored2 (add-atom &self (mark answerless)) a)
            (empty)))
   (collapse ($f)))
!(collapse (match &self (mark answerless) present))
!(let $f (|-> ()
    (record (let $ignored3 (add-atom &self (mark error-only)) a)
            (+ bad-value 3)))
   (collapse ($f)))
!(collapse (match &self (mark error-only) present))
