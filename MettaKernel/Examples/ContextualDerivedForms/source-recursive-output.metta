(= (walk-output 0) done)
(= (walk-output $n)
   (if (> $n 0)
       (let $ignored (add-atom &self (visit $n)) (walk-output (- $n 1)))
       (empty)))
!(collapse (walk-output 3))
!(collapse (match &self (visit $n) $n))
!(collapse (let impossible (walk-output 2) chosen))
!(collapse (match &self (visit $n) $n))
!(collapse (walk-output -1))
