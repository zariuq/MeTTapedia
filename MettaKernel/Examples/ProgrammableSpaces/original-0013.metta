!(bind! &jobs (new-space))
!(add-atom &jobs (selected (query A C)))
!(add-atom &jobs (edge A B))
!(add-atom &jobs (edge B C))
!(add-atom &jobs (edge A D))
!(add-atom &jobs (edge D C))
!(add-atom &jobs (edge C E))
!(add-atom &jobs (exec first (, (selected (query $from $to)) (edge $from $middle) (edge $middle $to)) (O (+ (reachable $from $to)) (+ (exec second (, (reachable A $to) (edge $to E)) (O (+ (finished $to))))))))
!(select 100 (search-policy (control FIFO (resources MM2) (budget 10000))) &jobs)
!(collapse (get-atoms &jobs))