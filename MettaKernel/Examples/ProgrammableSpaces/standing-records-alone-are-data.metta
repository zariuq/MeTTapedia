!(bind! &jobs (new-space))
!(add-atom &jobs (p a))
!(add-atom &jobs (standing consumer (, (p $x)) (O (+ (q $x)))))
!(add-atom &jobs (standing producer (,) (O (+ (p b)))))
!(add-atom &jobs (next consumer producer))
!(add-atom &jobs (next producer consumer))
!(add-atom &jobs (turn consumer))
!(select 100 (search-policy (control FIFO (resources MM2) (budget 100000))) &jobs)
!(collapse (get-atoms &jobs))
