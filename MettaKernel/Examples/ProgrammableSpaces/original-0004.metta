!(bind! &jobs (new-space))
!(add-atom &jobs (selected (query A C)))
!(add-atom &jobs (edge A B))
!(add-atom &jobs (edge B C))
!(add-atom &jobs (edge A D))
!(add-atom &jobs (edge D C))
!(add-atom &jobs (exec inference (, (selected (query $from $to)) (edge $from $middle) (edge $middle $to)) (O (+ (reachable $from $to)))))
!(let (Observation $v (satisfied $s) (closed $c) (residual $r) (work $w) (status $t) (agenda $a)) (select 100 (search-policy (control FIFO (resources MM2) (budget 19))) &jobs) (Split $v (select 100 (search-policy (control FIFO (resources MM2) (budget 9981))) $r)))
!(collapse (get-atoms &jobs))