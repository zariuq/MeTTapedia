!(bind! &jobs (new-space))
!(add-atom &jobs (p a))
!(add-atom &jobs (standing consumer (, (p $x)) (O (+ (q $x)))))
!(add-atom &jobs (standing producer (,) (O (+ (p b)))))
!(add-atom &jobs (next consumer producer))
!(add-atom &jobs (next producer consumer))
!(add-atom &jobs (exec (1 dispatch) (, (turn $name) (next $name $next) (standing $name $input $output) (exec (1 dispatch) $selfinput $selfoutput)) (O (- (turn $name)) (+ (turn $next)) (+ (exec (0 instance) $input $output)) (+ (exec (1 dispatch) $selfinput $selfoutput)))))
!(add-atom &jobs (turn producer))
!(select 8 (search-policy (control FIFO (resources MM2) (budget 100000))) &jobs)
!(collapse (get-atoms &jobs))
