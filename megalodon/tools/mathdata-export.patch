+(* Mathdata admits polymorphic definitions that Proofgold cannot represent.
+   Its checked source stream can still be exported when no Proofgold or HTML
+   output was requested. Other failures, including proof failures, propagate. *)
+let optional_pfg_metadata compute =
+  try Some (compute ()) with
+  | Failure message as error ->
+      let unsupported =
+        String.starts_with ~prefix:"no polymorphism allowed in pfg:" message ||
+        String.starts_with ~prefix:"Could not find corresponding obj id for TmH(" message in
+      if !sexprinfo && not !pfgout && not !pfgsummary && !html = None && unsupported then
+        None
+      else
+        raise error
 
