; Controls for program resumption and publication. The fixture is the
; four-origins driver control with its second rule rewriting to Successor,
; so that the two jobs' receipts differ.

; Helpers for the resumption controls.
(= (gslt:control:prefix LNil $any) true)
(= (gslt:control:prefix (LCons $x $xs) LNil) false)
(= (gslt:control:prefix (LCons $x $xs) (LCons $y $ys))
   (if (== $x $y) (gslt:control:prefix $xs $ys) false))
(= (gslt:control:snapshot (ProgramObservation $jobs $receipts)) $receipts)
(= (gslt:control:released (ProgramPublication $receipts $status)) $receipts)
(= (gslt:control:status (ProgramPublication $receipts $status)) $status)
