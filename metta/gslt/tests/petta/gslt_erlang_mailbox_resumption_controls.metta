; Interrupt the emitted mailbox search, including both cursor phases.
; Equality includes the complete search and receipt accounts.
(: er-resume-control:pending (-> Atom Bool))
(= (er-resume-control:pending $result)
  (case $result (((ErRhoKernelPending $account) True) ($other False))))

(: er-resume-control:cursor (-> Atom Atom Atom Atom Atom Atom Bool))
(= (er-resume-control:cursor $operation $expected $mailbox $machine $continuation $system)
  (let* (($peekSource (gslt:er:pack1 "ErPeek" $mailbox))
         ($peekBegin (gslt:er-rho:mailbox-begin $peekSource))
         ($peekPartial (gslt:er-rho:mailbox-resume 1 2 $peekBegin))
         ($beforePeek (gslt:er-actor:mailbox-result 0 (ErCursorPeek $operation $expected)
           $mailbox $machine $continuation $peekPartial $system))
         ($afterPeek (gslt:er-actor:continue 1999 2 $beforePeek))
         ($direct (gslt:er-actor:cursor 0 $mailbox $machine $operation $expected $continuation $system))
         ($peekDone (gslt:er-rho:mailbox-resume 1999 2 $peekPartial)))
    (case $peekDone
      (((ErRhoKernelDone (PApp "ErPeekValue" (LCons $message (LCons $normalized LNil))) $peekAccount)
        (let* (($cursorSource (gslt:er:pack1 $operation $normalized))
               ($cursorBegin (gslt:er-rho:mailbox-begin $cursorSource))
               ($cursorPartial (gslt:er-rho:mailbox-resume 1 2 $cursorBegin))
               ($afterFirst (gslt:er-actor:mailbox-result 0 (ErCursorApply $operation $expected $peekAccount)
                 $normalized $machine $continuation $cursorPartial $system))
               ($resumed (gslt:er-actor:continue 1999 2 $afterFirst)))
          (case $afterFirst
            (((ErActorMailboxPending $pid (ErCursorApply $savedOperation $savedExpected $savedPeek)
                 $box $vm $kont $progress $oldSystem)
              (if (== $savedPeek $peekAccount)
                (if (== $afterPeek $direct) (== $resumed $direct) False) False))
             ($notPending False)))))
       ($bad False)))))

!(let* (($machine (er-actors:begin))
         ($first (gslt:er:integer 7)) ($second (gslt:er:integer 9))
         ($tail (gslt:er:pack2 "ErValuesCons" $second (PApp "ErValuesNil" LNil)))
         ($messages (gslt:er:pack2 "ErValuesCons" $first $tail))
         ($mailbox (gslt:er:pack3 "ErMailbox" (PApp "ErValuesNil" LNil) $messages (PApp "ErValuesNil" LNil)))
         ($network (LCons (ErEnvelope 1 0 $second) LNil))
         ($system (ErActorSystem (LCons (ErLocal 0 $mailbox $machine) LNil) $network 2 LNil))
         ($continuation (PApp "ErKDone" LNil))
         ($peekSource (gslt:er:pack1 "ErPeek" $mailbox))
         ($initial (gslt:er-rho:mailbox-begin $peekSource))
         ($zero (gslt:er-rho:mailbox-resume 0 2 $initial))
         ($partial (gslt:er-rho:mailbox-resume 1 2 $initial))
         ($finished (gslt:er-rho:mailbox-resume 1999 2 $partial))
         ($directKernel (gslt:er-rho:mailbox-kernel $peekSource))
         ($peekPending (gslt:er-actor:mailbox-result 0 ErPeek $mailbox $machine $continuation $partial $system))
         ($peekResumed (gslt:er-actor:continue 1999 2 $peekPending))
         ($peekDirect (gslt:er-actor:peek 0 $mailbox $machine $continuation $system))
         ($next (er-resume-control:cursor "ErNext" "ErAdvanced" $mailbox $machine $continuation $system))
         ($remove (er-resume-control:cursor "ErRemove" "ErRemoved" $mailbox $machine $continuation $system))
         ($waitSource (gslt:er:pack1 "ErWait" $mailbox))
         ($waitBegin (gslt:er-rho:mailbox-begin $waitSource))
         ($waitPartial (gslt:er-rho:mailbox-resume 1 2 $waitBegin))
         ($waitPending (gslt:er-actor:mailbox-result 0 ErWait $mailbox $machine $continuation $waitPartial $system))
         ($waitResumed (gslt:er-actor:continue 1999 2 $waitPending))
         ($waitDirect (gslt:er-actor:wait 0 $mailbox $machine $continuation $system))
         ($deliverySource (gslt:er:pack2 "ErDeliver" $second $mailbox))
         ($deliveryBegin (gslt:er-rho:mailbox-begin $deliverySource))
         ($deliveryPartial (gslt:er-rho:mailbox-resume 1 2 $deliveryBegin))
         ($deliveryPending (gslt:er-actor:delivery-result (ErDelivery 1 0 $second LNil) $deliveryPartial $system))
         ($deliveryResumed (gslt:er-actor:continue 1999 2 $deliveryPending))
         ($deliveryDirect (gslt:er-actor:deliver 0 $system))
         ($rest (LCons (ErDeliver 0) LNil))
         ($sequence (ErActorChoicesPending $rest $peekPending))
         ($sequenceResumed (gslt:er-actor:continue 1999 2 $sequence))
         ($sequenceDirect (gslt:er-actor:choices $rest $peekDirect))
         ($sequenceZero (gslt:er-actor:continue 0 2 $sequence))
         ($empty (gslt:er-actor:empty-mailbox))
         ($emptyCursor (gslt:er-actor:cursor 0 $empty $machine "ErNext" "ErAdvanced" $continuation $system))
         ($emptyRefused (case $emptyCursor (((ErActorDiagnostic EmptyMailboxCursor $vm $world) True) ($bad False))))
         ($malformed (gslt:er-actor:mailbox-result 0 ErPeek $mailbox $machine $continuation InvalidProgress $system))
         ($malformedRefused (case $malformed (((ErActorDiagnostic MailboxProgress InvalidProgress $world) True) ($bad False)))))
   (println! (ErlangMailboxResumeControl
     (== $zero $initial) (er-resume-control:pending $partial) (== $finished $directKernel)
     (== $peekResumed $peekDirect) $next $remove (== $waitResumed $waitDirect)
     (== $deliveryResumed $deliveryDirect) (== $sequenceResumed $sequenceDirect)
     (== $sequenceZero $sequence) $emptyRefused $malformedRefused)))
