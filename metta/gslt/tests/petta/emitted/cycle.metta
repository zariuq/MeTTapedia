(: cycle:begin (-> Atom %Undefined%))
(= (cycle:begin $source) (gslt:live:begin (LivePlan (PremiseEnvironment (LCons (GrammarTypingV1 "A" "State" LNil) (LCons (GrammarTypingV1 "B" "State" LNil) LNil)) (LCons (ScopedRewriteRuleV1 "a-to-b" LNil LNil (PApp "A" LNil) (PApp "B" LNil) (RuleBindingSome (RuleBindingSpec LNil LNil))) (LCons (ScopedRewriteRuleV1 "b-to-a" LNil LNil (PApp "B" LNil) (PApp "A" LNil) (RuleBindingSome (RuleBindingSpec LNil LNil))) LNil)) (LCons (PremiseSpecification 0 (RuleBindingSpec LNil LNil)) (LCons (PremiseSpecification 1 (RuleBindingSpec LNil LNil)) LNil)) (PremiseProvider LNil LNil) (PremiseReflection LNil LNil) LNil) LNil (OperationalPermissions PermissionYes PermissionNo LNil PermissionNo PermissionNo LNil) LNil (TBase "State") (LCons (RuleJobDeclaration 0 (ScopedRewriteRuleV1 "a-to-b" LNil LNil (PApp "A" LNil) (PApp "B" LNil) RuleBindingNone) (RuleBindingPlan (RuleBindingSpec LNil LNil) BindingInferredRootInputs)) (LCons (RuleJobDeclaration 1 (ScopedRewriteRuleV1 "b-to-a" LNil LNil (PApp "B" LNil) (PApp "A" LNil) RuleBindingNone) (RuleBindingPlan (RuleBindingSpec LNil LNil) BindingInferredRootInputs)) LNil))) $source))
(: cycle:run (-> Atom Atom Atom %Undefined%))
(= (cycle:run $source $ticks $quantum) (let $machine (gslt:live:begin (LivePlan (PremiseEnvironment (LCons (GrammarTypingV1 "A" "State" LNil) (LCons (GrammarTypingV1 "B" "State" LNil) LNil)) (LCons (ScopedRewriteRuleV1 "a-to-b" LNil LNil (PApp "A" LNil) (PApp "B" LNil) (RuleBindingSome (RuleBindingSpec LNil LNil))) (LCons (ScopedRewriteRuleV1 "b-to-a" LNil LNil (PApp "B" LNil) (PApp "A" LNil) (RuleBindingSome (RuleBindingSpec LNil LNil))) LNil)) (LCons (PremiseSpecification 0 (RuleBindingSpec LNil LNil)) (LCons (PremiseSpecification 1 (RuleBindingSpec LNil LNil)) LNil)) (PremiseProvider LNil LNil) (PremiseReflection LNil LNil) LNil) LNil (OperationalPermissions PermissionYes PermissionNo LNil PermissionNo PermissionNo LNil) LNil (TBase "State") (LCons (RuleJobDeclaration 0 (ScopedRewriteRuleV1 "a-to-b" LNil LNil (PApp "A" LNil) (PApp "B" LNil) RuleBindingNone) (RuleBindingPlan (RuleBindingSpec LNil LNil) BindingInferredRootInputs)) (LCons (RuleJobDeclaration 1 (ScopedRewriteRuleV1 "b-to-a" LNil LNil (PApp "B" LNil) (PApp "A" LNil) RuleBindingNone) (RuleBindingPlan (RuleBindingSpec LNil LNil) BindingInferredRootInputs)) LNil))) $source) (let $paged (gslt:live:advance $machine $ticks $quantum) (gslt:live:trace $paged))))
