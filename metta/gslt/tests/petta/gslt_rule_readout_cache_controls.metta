(: cache-control:permissions (-> Atom %Undefined%))
(= (cache-control:permissions
     (RuleJobRequestProjection $environment
       (OperationalPermissions $enabled $all $slots $lambda $multi $kinds)
       $bound $expected $source $job))
   (RuleJobRequestProjection $environment
     (OperationalPermissions PermissionNo $all $slots $lambda $multi $kinds)
     $bound $expected $source $job))
(: cache-control:snapshot (-> Atom %Undefined%))
(= (cache-control:snapshot
     (RuleJobRequestProjection
       (PremiseEnvironment $grammar $rules $free (PremiseProvider $signatures $rows) $reflection $equations)
       $permissions $bound $expected $source $job))
   (RuleJobRequestProjection
     (PremiseEnvironment $grammar $rules $free (PremiseProvider $signatures LNil) $reflection $equations)
     $permissions $bound $expected $source $job))
(: cache-control:target (-> Atom %Undefined%))
(= (cache-control:target
     (PremiseResult $goal (RootAnswer $trace $captured $completed $history $target)))
   (PremiseResult $goal (RootAnswer $trace $captured $completed $history (PApp "Zero" LNil))))
(: cache-control:goal (-> Atom %Undefined%))
(= (cache-control:goal
     (PremiseResult (RootGoal $bound $type $source $ordinal) $answer))
   (PremiseResult (RootGoal $bound $type $source 999) $answer))
(: cache-control:effect-payload (-> Atom %Undefined%))
(= (cache-control:effect-payload
     (PremiseResult $goal (RootAnswer $trace $captured $completed $history $target)))
   (PremiseResult $goal
     (RootAnswer (quote (println! "CACHE-PAYLOAD-MUST-NOT-PRINT")) $captured $completed $history $target)))
(: cache-control:effect-receipt (-> Atom %Undefined%))
(= (cache-control:effect-receipt
     (Some (RuleJobReceipt $job $trace $captured $completed $history $local $target)))
   (Some (RuleJobReceipt $job (quote (println! "CACHE-PAYLOAD-MUST-NOT-PRINT"))
     $captured $completed $history $local $target)))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (== (gslt:rule:job-readouts-accounted $request LNil) (ReadoutBatch LNil 0)) (println! (ReadoutCacheControl "empty" $ok))))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (== (gslt:rule:job-readouts-accounted $request (LCons $result LNil)) (ReadoutBatch (LCons $receipt LNil) 1)) (println! (ReadoutCacheControl "one-miss" $ok))))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (== (gslt:rule:job-readouts-accounted $request (LCons $result (LCons $result LNil))) (ReadoutBatch (LCons $receipt (LCons $receipt LNil)) 1)) (println! (ReadoutCacheControl "duplicate-occurrences-one-miss" $ok))))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (== (gslt:rule:job-readouts $request (LCons $result (LCons $result LNil))) (LCons $receipt (LCons $receipt LNil))) (println! (ReadoutCacheControl "ordinary-list" $ok))))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (let (ReadoutCached $first $cache $miss) (gslt:rule:job-readout-cache-step $request $result None)
 (let $changed (cache-control:permissions $request)
  (case (gslt:rule:job-readout-cache-step $changed $result $cache)
   (((ReadoutCached $answer $next 1) (== $answer None)) ($_ False))))) (println! (ReadoutCacheControl "changed-permission" $ok))))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (let (ReadoutCached $first $cache $miss) (gslt:rule:job-readout-cache-step $request $result None)
 (let $changed (cache-control:snapshot $request)
  (case (gslt:rule:job-readout-cache-step $changed $result $cache)
   (((ReadoutCached $answer $next 1) (== $answer $receipt)) ($_ False))))) (println! (ReadoutCacheControl "changed-snapshot" $ok))))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (let (ReadoutCached $first $cache $miss) (gslt:rule:job-readout-cache-step $request $result None)
 (let $changed (cache-control:goal $result)
  (case (gslt:rule:job-readout-cache-step $request $changed $cache)
   (((ReadoutCached None $next 1) True) ($_ False))))) (println! (ReadoutCacheControl "changed-goal" $ok))))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (let (ReadoutCached $first $cache $miss) (gslt:rule:job-readout-cache-step $request $result None)
 (let $changed (cache-control:target $result)
  (let $reference (gslt:rule:job-finish-root $request $changed)
   (case (gslt:rule:job-readout-cache-step $request $changed $cache)
    (((ReadoutCached $answer $next 1) (== $answer $reference)) ($_ False)))))) (println! (ReadoutCacheControl "changed-local-target" $ok))))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (let $changed (cache-control:target $result)
 (case (gslt:rule:job-readouts-accounted $request (LCons $result (LCons $changed (LCons $result LNil))))
  (((ReadoutBatch $answers 3) True) ($_ False)))) (println! (ReadoutCacheControl "evicted-key-is-miss" $ok))))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (let $changed (cache-control:permissions $request)
 (== (gslt:rule:job-readouts-accounted $changed (LCons $result (LCons $result LNil))) (ReadoutBatch (LCons None (LCons None LNil)) 1))) (println! (ReadoutCacheControl "refusal-also-shares" $ok))))
!(let* (($request (cache-control:request)) ($result (cache-control:result)) ($receipt (cache-control:receipt))) (let $ok (let (ReadoutCached $first $cache $miss) (gslt:rule:job-readout-cache-step $request $result None)
 (let $changed (cache-control:effect-payload $result)
  (let $expected (cache-control:effect-receipt $receipt)
   (case (gslt:rule:job-readout-cache-step $request $changed $cache)
    (((ReadoutCached $answer $next 0) (== $answer $expected)) ($_ False)))))) (println! (ReadoutCacheControl "captured-effect-is-data" $ok))))
