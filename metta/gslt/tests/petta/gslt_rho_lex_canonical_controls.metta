; Expected values are the Lean function LexCanonical.lexCanon on the same patterns.
!(let $actual (rho:lex:canonical (PApp "PZero" LNil))
  (println! (RhoLexCanonicalControl "zero" (== $actual (quote (PApp "PZero" LNil))))))
!(let $actual (rho:lex:canonical (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PZero" LNil) (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) LNil)) RNone))
  (println! (RhoLexCanonicalControl "unit-removed" (== $actual (quote (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))))))))
!(let $actual (rho:lex:canonical (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) LNil) RNone))
  (println! (RhoLexCanonicalControl "singleton-collapsed" (== $actual (quote (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))))))))
!(let $actual (rho:lex:canonical (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" LNil RNone))
  (println! (RhoLexCanonicalControl "empty-is-zero" (== $actual (quote (PApp "PZero" LNil))))))
!(let $actual (rho:lex:canonical (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) (LCons (PApp "PZero" LNil) LNil)) RNone) (LCons (PApp "PInput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PLam BNone (PApp "PDrop" (LCons (Var 0) LNil))) LNil))) LNil)) RNone))
  (println! (RhoLexCanonicalControl "flattened" (== $actual (quote (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PInput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PLam BNone (PApp "PDrop" (LCons (Var 0) LNil))) LNil))) (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) LNil)) RNone))))))
!(let $actual (rho:lex:canonical (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) (LCons (PApp "PInput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PLam BNone (PApp "PDrop" (LCons (Var 0) LNil))) LNil))) (LCons (PApp "PDrop" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) LNil)) LNil))) RNone))
  (println! (RhoLexCanonicalControl "sorted" (== $actual (quote (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PDrop" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) LNil)) (LCons (PApp "PInput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PLam BNone (PApp "PDrop" (LCons (Var 0) LNil))) LNil))) (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) LNil))) RNone))))))
!(let $actual (rho:lex:canonical (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PDrop" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) LNil)) LNil)) (LCons (PApp "PZero" LNil) LNil))))
  (println! (RhoLexCanonicalControl "quote-drop" (== $actual (quote (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))))))))
!(let $actual (rho:lex:canonical (PApp "POutput" (LCons (PApp "NQuote" (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PZero" LNil) (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) (LCons (PApp "PDrop" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) LNil)) LNil))) RNone) LNil)) (LCons (PApp "PZero" LNil) LNil))))
  (println! (RhoLexCanonicalControl "nested-quote-bag" (== $actual (quote (PApp "POutput" (LCons (PApp "NQuote" (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PDrop" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) LNil)) (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) LNil)) RNone) LNil)) (LCons (PApp "PZero" LNil) LNil))))))))
!(let $actual (rho:lex:canonical (PApp "PInput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PLam BNone (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PDrop" (LCons (Var 0) LNil)) (LCons (PApp "PZero" LNil) (LCons (PApp "POutput" (LCons (Var 0) (LCons (PApp "PZero" LNil) LNil))) LNil))) RNone)) LNil))))
  (println! (RhoLexCanonicalControl "under-binder" (== $actual (quote (PApp "PInput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PLam BNone (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PDrop" (LCons (Var 0) LNil)) (LCons (PApp "POutput" (LCons (Var 0) (LCons (PApp "PZero" LNil) LNil))) LNil)) RNone)) LNil))))))))
!(let* (($first (rho:lex:canonical (PApp "POutput" (LCons (PApp "NQuote" (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PZero" LNil) (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) (LCons (PApp "PDrop" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) LNil)) LNil))) RNone) LNil)) (LCons (PApp "PZero" LNil) LNil))))) ($second (rho:lex:canonical $first)))
  (println! (RhoLexCanonicalControl "nested-quote-bag-idempotent" (== $first $second))))
!(let* (($left (rho:lex:canonical (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) (LCons (PApp "PDrop" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) LNil)) LNil)) RNone))) ($right (rho:lex:canonical (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PDrop" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) LNil)) (LCons (PApp "PZero" LNil) (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) LNil))) RNone))))
  (println! (RhoLexCanonicalControl "commuted-bags-one-form" (== (== $left $right) True))))
!(let* (($left (rho:lex:canonical (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))))) ($right (rho:lex:canonical (PApp "PDrop" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) LNil)))))
  (println! (RhoLexCanonicalControl "different-processes-two-forms" (== (== $left $right) False))))
