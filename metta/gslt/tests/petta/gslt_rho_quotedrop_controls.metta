; Controls for the emitted rho module committing quote-drop normal forms (rhoqd), against the
; canonical module (rho). Every expected readout is the Lean explorer's.
!(let $s (rhoqd:explore (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PDrop" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) LNil)) LNil)) (LCons (PApp "PZero" LNil) LNil))) (LCons (PApp "PInput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PLam BNone (PApp "PDrop" (LCons (Var 0) LNil))) LNil))) LNil)) RNone) 200)
  (println! (RhoQuoteDropControl "named-quotedrop" (== $s (quote (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PInput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PLam BNone (PApp "PDrop" (LCons (Var 0) LNil))) LNil))) (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) LNil)) RNone) (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" LNil RNone) LNil)))))))
