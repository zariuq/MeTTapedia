; Controls for the emitted rho module committing model normal forms (rhomodel), against the
; module committing quote-drop normal forms (rhoqd). Every expected readout is the Lean explorer's.
!(let $s (rhomodel:explore (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" LNil RNone) LNil)) (LCons (PApp "PZero" LNil) LNil))) (LCons (PApp "PInput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PLam BNone (PApp "PDrop" (LCons (Var 0) LNil))) LNil))) LNil)) RNone) 200)
  (println! (RhoModelControl "empty-model" (== $s (quote (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashBag" (LCons (PApp "PInput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PLam BNone (PApp "PDrop" (LCons (Var 0) LNil))) LNil))) (LCons (PApp "POutput" (LCons (PApp "NQuote" (LCons (PApp "PZero" LNil) LNil)) (LCons (PApp "PZero" LNil) LNil))) LNil)) RNone) (LCons (PApp "PZero" LNil) LNil)))))))
