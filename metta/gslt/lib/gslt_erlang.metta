; Typed finite service snapshots for the indexed Erlang machine.
; Machine transitions remain in the authored GSLT rules.

(: gslt:er:pack1 (-> Atom Atom %Undefined%))
(= (gslt:er:pack1 $name $v0) (PApp $name (LCons $v0 LNil)))

(: gslt:er:pack2 (-> Atom Atom Atom %Undefined%))
(= (gslt:er:pack2 $name $v0 $v1) (PApp $name (LCons $v0 (LCons $v1 LNil))))

(: gslt:er:pack3 (-> Atom Atom Atom Atom %Undefined%))
(= (gslt:er:pack3 $name $v0 $v1 $v2) (PApp $name (LCons $v0 (LCons $v1 (LCons $v2 LNil)))))

(: gslt:er:pack4 (-> Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:er:pack4 $name $v0 $v1 $v2 $v3) (PApp $name (LCons $v0 (LCons $v1 (LCons $v2 (LCons $v3 LNil))))))

(: gslt:er:true (-> %Undefined%))
(= (gslt:er:true) (PApp "ErAtom" (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.vec" (LCons (PApp "R16Nibble7" LNil) (LCons (PApp "R16Nibble4" LNil) (LCons (PApp "R16Nibble7" LNil) (LCons (PApp "R16Nibble2" LNil) (LCons (PApp "R16Nibble7" LNil) (LCons (PApp "R16Nibble5" LNil) (LCons (PApp "R16Nibble6" LNil) (LCons (PApp "R16Nibble5" LNil) LNil)))))))) RNone) LNil)))

(: gslt:er:false (-> %Undefined%))
(= (gslt:er:false) (PApp "ErAtom" (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.vec" (LCons (PApp "R16Nibble6" LNil) (LCons (PApp "R16Nibble6" LNil) (LCons (PApp "R16Nibble6" LNil) (LCons (PApp "R16Nibble1" LNil) (LCons (PApp "R16Nibble6" LNil) (LCons (PApp "R16Nibble12" LNil) (LCons (PApp "R16Nibble7" LNil) (LCons (PApp "R16Nibble3" LNil) (LCons (PApp "R16Nibble6" LNil) (LCons (PApp "R16Nibble5" LNil) LNil)))))))))) RNone) LNil)))


(: gslt:er:boolean (-> Bool %Undefined%))
(= (gslt:er:boolean $flag) (if $flag (gslt:er:true) (gslt:er:false)))
(: gslt:er:boolean-value (-> Atom %Undefined%))
(= (gslt:er:boolean-value $value)
   (let* (($true (gslt:er:true)) ($false (gslt:er:false)))
     (if (== $value $true) (Some True) (if (== $value $false) (Some False) None))))
(: gslt:er:integer (-> Number %Undefined%))
(= (gslt:er:integer $number)
   (let* (($negative (< $number 0)) ($magnitude (if $negative (- 0 $number) $number))
          ($sign (PApp (if $negative "ErNegative" "ErNonnegative") LNil))
          ($digits (gslt:word16:digits $magnitude))
          ($word (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.vec" $digits RNone)))
     (gslt:er:pack2 "ErInteger" $sign $word)))
(: gslt:er:integer-value (-> Atom %Undefined%))
(= (gslt:er:integer-value $value)
   (case $value
     (((PApp "ErInteger" (LCons (PApp $sign LNil) (LCons $word LNil)))
       (case (gslt:word16:vector-value $word)
         ((None None) ((Some $magnitude)
           (case $sign (("ErNonnegative" (Some $magnitude))
             ("ErNegative" (let $number (- 0 $magnitude) (Some $number))) ($bad None)))))))
      ($bad None))))
(: gslt:er:result-integer (-> Number %Undefined%))
(= (gslt:er:result-integer $number)
   (let* (($value (gslt:er:integer $number)) ($result (gslt:er:pack1 "ErPrimitiveValue" $value))) (Some $result)))
(: gslt:er:result-boolean (-> Bool %Undefined%))
(= (gslt:er:result-boolean $flag)
   (let* (($value (gslt:er:boolean $flag)) ($result (gslt:er:pack1 "ErPrimitiveValue" $value))) (Some $result)))
(: gslt:er:result-fault (-> Atom %Undefined%))
(= (gslt:er:result-fault $name)
   (let* (($fault (PApp $name LNil)) ($result (gslt:er:pack1 "ErPrimitiveFault" $fault))) (Some $result)))
(: gslt:er:values (-> Atom %Undefined%))
(= (gslt:er:values $values)
   (case $values
     (((PApp "ErValuesNil" LNil) (Some LNil))
      ((PApp "ErValuesCons" (LCons $head (LCons $tail LNil)))
       (case (gslt:er:values $tail) ((None None) ((Some $rest) (Some (LCons $head $rest))))))
      ($bad None))))
(: gslt:er:count-value (-> Atom %Undefined%))
(= (gslt:er:count-value $count)
   (case $count (((PApp "ErZero" LNil) (Some 0))
     ((PApp "ErSucc" (LCons $before LNil))
      (case (gslt:er:count-value $before) ((None None) ((Some $n) (let $next (+ $n 1) (Some $next))))))
     ($bad None))))
(: gslt:er:proper-list (-> Atom Bool))
(= (gslt:er:proper-list $value)
   (case $value (((PApp "ErNil" LNil) True)
     ((PApp "ErCons" (LCons $head (LCons $tail LNil))) (gslt:er:proper-list $tail)) ($other False))))
(: gslt:er:integer-binary (-> Atom Atom Atom %Undefined%))
(= (gslt:er:integer-binary $operator $left $right)
   (case (gslt:er:integer-value $left)
     ((None (gslt:er:result-fault "ErBadarith"))
      ((Some $first) (case (gslt:er:integer-value $right)
        ((None (gslt:er:result-fault "ErBadarith"))
         ((Some $second) (case $operator
           (("ErAdd" (gslt:er:result-integer (+ $first $second)))
            ("ErSubtract" (gslt:er:result-integer (- $first $second)))
            ("ErMultiply" (gslt:er:result-integer (* $first $second)))
            ($division
             (if (== $second 0) (gslt:er:result-fault "ErBadarith")
               (let* (($negativeFirst (< $first 0)) ($negativeSecond (< $second 0))
                      ($firstAbs (if $negativeFirst (- 0 $first) $first))
                      ($secondAbs (if $negativeSecond (- 0 $second) $second)))
                 (case (gslt:integer:divmod $firstAbs $secondAbs)
                   (((IntegerDivmod $quotient $remainder)
                     (case $division
                       (("ErDivide" (gslt:er:result-integer (if (== $negativeFirst $negativeSecond) $quotient (- 0 $quotient))))
                        ("ErRemainder" (gslt:er:result-integer (if $negativeFirst (- 0 $remainder) $remainder)))
                        ($bad None))))))))))))))))))
(: gslt:er:order (-> Number Number %Undefined%))
(= (gslt:er:order $left $right)
   (if (< $left $right) ErLessOrder (if (== $left $right) ErEqualOrder ErGreaterOrder)))
(: gslt:er:values-length (-> Atom Number))
(= (gslt:er:values-length $values)
   (case $values (((PApp "ErValuesNil" LNil) 0)
     ((PApp "ErValuesCons" (LCons $head (LCons $tail LNil)))
      (let $length (gslt:er:values-length $tail) (+ 1 $length))))))
(: gslt:er:compare-words (-> Atom Atom %Undefined%))
(= (gslt:er:compare-words $left $right)
   (case (ErComparePair $left $right)
     (((ErComparePair LNil LNil) ErEqualOrder)
      ((ErComparePair LNil (LCons $head $tail)) ErLessOrder)
      ((ErComparePair (LCons $head $tail) LNil) ErGreaterOrder)
      ((ErComparePair (LCons $first $rest) (LCons $second $tail))
       (case (gslt:word16:nibble-value $first)
         ((None ErIncomparable) ((Some $one) (case (gslt:word16:nibble-value $second)
           ((None ErIncomparable) ((Some $two)
             (case (gslt:er:order $one $two)
               ((ErEqualOrder (gslt:er:compare-words $rest $tail)) ($order $order))))))))))
      ($bad ErIncomparable))))
(: gslt:er:rank (-> Atom Number))
(= (gslt:er:rank $value)
   (case $value (((PApp "ErInteger" $fields) 0) ((PApp "ErAtom" $fields) 1)
     ((PApp "ErClosure" $fields) 2) ((PApp "ErPid" $fields) 3) ((PApp "ErTuple" $fields) 4)
     ((PApp "ErNil" $fields) 5) ((PApp "ErCons" $fields) 6) ($other 7))))
(: gslt:er:compare-fields (-> Atom Atom %Undefined%))
(= (gslt:er:compare-fields $left $right)
   (case (ErComparePair $left $right)
     (((ErComparePair (PApp "ErValuesNil" LNil) (PApp "ErValuesNil" LNil)) ErEqualOrder)
      ((ErComparePair (PApp "ErValuesCons" (LCons $head (LCons $tail LNil)))
                      (PApp "ErValuesCons" (LCons $first (LCons $rest LNil))))
       (case (gslt:er:compare $head $first)
         ((ErEqualOrder (gslt:er:compare-fields $tail $rest)) ($order $order))))
      ($other ErIncomparable))))
(: gslt:er:compare (-> Atom Atom %Undefined%))
(= (gslt:er:compare $left $right)
   (let* (($firstRank (gslt:er:rank $left)) ($secondRank (gslt:er:rank $right)))
     (if (== $firstRank $secondRank)
       (case $firstRank
         ((0 (case (gslt:er:integer-value $left) ((None ErIncomparable) ((Some $one)
              (case (gslt:er:integer-value $right) ((None ErIncomparable) ((Some $two) (gslt:er:order $one $two))))))))
          (1 (case (ErComparePair $left $right)
             (((ErComparePair (PApp "ErAtom" (LCons (PCollection $kind $one RNone) LNil))
                              (PApp "ErAtom" (LCons (PCollection $kind $two RNone) LNil)))
               (gslt:er:compare-words $one $two)) ($bad ErIncomparable))))
          (2 ErIncomparable)
          (3 (if (== $left $right) ErEqualOrder ErIncomparable))
          (4 (case (ErComparePair $left $right)
             (((ErComparePair (PApp "ErTuple" (LCons $one LNil)) (PApp "ErTuple" (LCons $two LNil)))
               (let* (($n (gslt:er:values-length $one)) ($m (gslt:er:values-length $two)))
                 (if (== $n $m) (gslt:er:compare-fields $one $two) (gslt:er:order $n $m)))) ($bad ErIncomparable))))
          (5 ErEqualOrder)
          (6 (case (ErComparePair $left $right)
             (((ErComparePair (PApp "ErCons" (LCons $one (LCons $tail LNil)))
                              (PApp "ErCons" (LCons $two (LCons $rest LNil))))
               (case (gslt:er:compare $one $two)
                 ((ErEqualOrder (gslt:er:compare $tail $rest)) ($order $order)))) ($bad ErIncomparable))))
          ($bad ErIncomparable)))
       (gslt:er:order $firstRank $secondRank))))
(: gslt:er:comparison (-> Atom Atom %Undefined%))
(= (gslt:er:comparison $operator $order)
   (case $order ((ErIncomparable None)
     ($valid (case $operator
       (("ErLess" (gslt:er:result-boolean (== $order ErLessOrder)))
        ("ErLessEqual" (gslt:er:result-boolean (if (== $order ErGreaterOrder) False True)))
        ("ErGreater" (gslt:er:result-boolean (== $order ErGreaterOrder)))
        ("ErGreaterEqual" (gslt:er:result-boolean (if (== $order ErLessOrder) False True))) ($bad None)))))))
(: gslt:er:has-closure-values (-> Atom Bool))
(= (gslt:er:has-closure-values $values)
   (case $values (((PApp "ErValuesNil" LNil) False)
     ((PApp "ErValuesCons" (LCons $head (LCons $tail LNil)))
      (if (gslt:er:has-closure $head) True (gslt:er:has-closure-values $tail))) ($bad True))))
(: gslt:er:has-closure (-> Atom Bool))
(= (gslt:er:has-closure $value)
   (case $value (((PApp "ErClosure" $fields) True)
     ((PApp "ErTuple" (LCons $fields LNil)) (gslt:er:has-closure-values $fields))
     ((PApp "ErCons" (LCons $head (LCons $tail LNil)))
      (if (gslt:er:has-closure $head) True (gslt:er:has-closure $tail))) ($other False))))
(: gslt:er:type-test (-> Atom Atom %Undefined%))
(= (gslt:er:type-test $operator $value)
   (case $operator
     (("ErIsInteger" (gslt:er:result-boolean (case $value (((PApp "ErInteger" $fields) True) ($other False)))))
      ("ErIsAtom" (gslt:er:result-boolean (case $value (((PApp "ErAtom" $fields) True) ($other False)))))
      ("ErIsTuple" (gslt:er:result-boolean (case $value (((PApp "ErTuple" $fields) True) ($other False)))))
      ("ErIsPid" (gslt:er:result-boolean (case $value (((PApp "ErPid" $fields) True) ($other False)))))
      ("ErIsFunction" (gslt:er:result-boolean (case $value (((PApp "ErClosure" $fields) True) ($other False)))))
      ("ErIsList" (gslt:er:result-boolean (gslt:er:proper-list $value))) ($bad None))))
(: gslt:er:primitive (-> Atom Atom %Undefined%))
(= (gslt:er:primitive $operator $arguments) (case $operator (((PApp $name LNil) (case (gslt:er:values $arguments) ((None None) ((Some $values) (case $values (((LCons $value LNil) (case $name (("ErNegate" (case (gslt:er:integer-value $value) ((None (gslt:er:result-fault "ErBadarith")) ((Some $n) (gslt:er:result-integer (- 0 $n)))))) ("ErNot" (case (gslt:er:boolean-value $value) ((None (gslt:er:result-fault "ErBadarg")) ((Some $b) (gslt:er:result-boolean (if $b False True)))))) ($test (gslt:er:type-test $test $value))))) ((LCons $left (LCons $right LNil)) (case $name (("ErAdd" (gslt:er:integer-binary $name $left $right)) ("ErSubtract" (gslt:er:integer-binary $name $left $right)) ("ErMultiply" (gslt:er:integer-binary $name $left $right)) ("ErDivide" (gslt:er:integer-binary $name $left $right)) ("ErRemainder" (gslt:er:integer-binary $name $left $right)) ("ErEqual" (if (gslt:er:has-closure $left) None (if (gslt:er:has-closure $right) None (gslt:er:result-boolean (== $left $right))))) ("ErDifferent" (if (gslt:er:has-closure $left) None (if (gslt:er:has-closure $right) None (gslt:er:result-boolean (if (== $left $right) False True))))) ("ErIsFunctionArity" (case (gslt:er:integer-value $right) ((None (gslt:er:result-fault "ErBadarg")) ((Some $n) (if (< $n 0) (gslt:er:result-fault "ErBadarg") (case $left (((PApp "ErClosure" (LCons $arity (LCons $function (LCons $environment LNil)))) (case (gslt:er:count-value $arity) ((None None) ((Some $m) (gslt:er:result-boolean (== $n $m)))))) ($other (gslt:er:result-boolean False))))))))) ("ErAnd" (gslt:er:bool-binary $name $left $right)) ("ErOr" (gslt:er:bool-binary $name $left $right)) ("ErXor" (gslt:er:bool-binary $name $left $right)) ($comparison (let $order (gslt:er:compare $left $right) (gslt:er:comparison $comparison $order)))))) ($bad None))))))) ($bad None))))

(: gslt:er:bool-binary (-> Atom Atom Atom %Undefined%))
(= (gslt:er:bool-binary $operator $left $right)
   (case (gslt:er:boolean-value $left)
     ((None (gslt:er:result-fault "ErBadarg")) ((Some $one)
       (case (gslt:er:boolean-value $right)
         ((None (gslt:er:result-fault "ErBadarg")) ((Some $two)
           (case $operator
             (("ErAnd" (gslt:er:result-boolean (if $one $two False)))
              ("ErOr" (gslt:er:result-boolean (if $one True $two)))
              ("ErXor" (gslt:er:result-boolean (if (== $one $two) False True))) ($bad None))))))))))

; Each completed service query freezes its plan and complete runner. Query
; receipts use row positions, so past receipts keep their original provider.
(: gslt:er:begin (-> Atom Atom Atom %Undefined%))
(= (gslt:er:begin $plan $standard $source)
   (let $runner (gslt:runner:begin ClassSearch $plan $standard $source)
     (ErMachine ErRunning $plan $standard $runner LNil)))

(: gslt:er:install (-> Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:er:install $plan $standard $runner $epochs $row)
   (gslt:er:install-relation $plan $standard $runner $epochs "er-primitive" $row))
(: gslt:er:install-relation (-> Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:er:install-relation $plan $standard $runner $epochs $relation $row)
   (case (gslt:snapshot:plan $plan $relation LNil (LCons $row LNil))
     ((None (ErMachine ErInvalid $plan $standard $runner $epochs))
      ((Some $nextPlan)
       (case $runner
         (((ClassMachine ClassDone $state $query $states $receipts)
           (let* (($fresh (gslt:runner:begin ClassSearch $nextPlan $standard $state))
                  ($history (LCons (ErEpoch $plan $runner) $epochs)))
             (ErMachine ErRunning $nextPlan $standard $fresh $history)))
          ($bad (ErMachine ErInvalid $plan $standard $runner $epochs))))))))

(: gslt:er:service (-> Atom Atom Atom Atom %Undefined%))
(= (gslt:er:service $plan $standard $runner $epochs)
   (case $runner
     (((ClassMachine ClassDone $state $query $states $receipts)
       (let* (($status (gslt:search:status ClassSearch $plan $query))
              ($published (gslt:search:publication ClassSearch $query)))
         (if (== $status SearchComplete)
           (if (== $published LNil)
             (case $state
               (((PApp "ErDone" $arguments) (ErMachine ErComplete $plan $standard $runner $epochs))
                ((PApp "ErFault" $arguments) (ErMachine ErComplete $plan $standard $runner $epochs))
                ((PApp "ErPrimitiveRequest" (LCons $operator (LCons $arguments (LCons $continuation LNil))))
                 (case (gslt:er:primitive $operator $arguments)
                   ((None (ErMachine ErInvalid $plan $standard $runner $epochs))
                    ((Some $result)
                     (let $row (PremiseProviderRow "er-primitive"
                           (LCons $operator (LCons $arguments (LCons $result LNil))))
                       (gslt:er:install $plan $standard $runner $epochs $row))))))

                ((PApp "ErGuardRequest" (LCons $values (LCons $arguments (LCons $later (LCons $body (LCons $bound (LCons $outer (LCons $continuation LNil))))))))
                 (let* (($true (gslt:er:true))
                        ($expected (gslt:er:pack2 "ErValuesCons" $true (PApp "ErValuesNil" LNil)))
                        ($decision (PApp (if (== $values $expected) "ErYes" "ErNo") LNil))
                        ($row (PremiseProviderRow "er-guard" (LCons $values (LCons $decision LNil)))))
                   (gslt:er:install-relation $plan $standard $runner $epochs "er-guard" $row)))
                ((PApp "ErTryClause" (LCons $pattern (LCons $arguments (LCons $environment (LCons $guard (LCons $body (LCons $later (LCons $continuation LNil))))))))
                 (let $row (PremiseProviderRow "er-pattern-failure"
                       (LCons $pattern (LCons $arguments (LCons $environment LNil))))
                   (gslt:er:install-relation $plan $standard $runner $epochs "er-pattern-failure" $row)))
                ((PApp "ErActorRequest" $arguments) (ErMachine ErSuspended $plan $standard $runner $epochs))
                ((PApp "ErInvalid" $arguments) (ErMachine ErInvalid $plan $standard $runner $epochs))
                ($bad (ErMachine ErInvalid $plan $standard $runner $epochs))))
             (ErMachine ErInvalid $plan $standard $runner $epochs))
           (ErMachine ErRunning $plan $standard $runner $epochs))))
      ($bad (ErMachine ErInvalid $plan $standard $runner $epochs)))))

(: gslt:er:tick (-> Atom Number %Undefined%))
(= (gslt:er:tick $machine $quantum)
   (case $machine
     (((ErMachine ErRunning $plan $standard $runner $epochs)
       (case $runner
         (((ClassMachine ClassRunning $state $query $states $receipts)
           (let $next (gslt:runner:tick ClassSearch $plan $standard $runner $quantum)
             (ErMachine ErRunning $plan $standard $next $epochs)))
          ((ClassMachine ClassDone $state $query $states $receipts)
           (gslt:er:service $plan $standard $runner $epochs))
          ((ClassMachine ClassBlocked $state $query $states $receipts)
           (ErMachine ErBlocked $plan $standard $runner $epochs))
          ($bad (ErMachine ErInvalid $plan $standard $runner $epochs)))))
      ($stopped $machine))))

(: gslt:er:advance (-> Number Number Atom %Undefined%))
(= (gslt:er:advance $ticks $quantum $machine)
   (if (== $ticks 0) $machine
     (case $machine
       (((ErMachine ErRunning $plan $standard $runner $epochs)
         (let* (($next (gslt:er:tick $machine $quantum)) ($remaining (- $ticks 1)))
           (gslt:er:advance $remaining $quantum $next)))
        ($stopped $machine)))))

(: gslt:er:result (-> Atom %Undefined%))
(= (gslt:er:result $machine)
   (case $machine
     (((ErMachine $phase $plan $standard $runner $epochs)
       (case $runner
         (((ClassMachine $status $state $query $states $receipts)
           (ErResult $phase $state $epochs (ErEpoch $plan $runner)))))))))

