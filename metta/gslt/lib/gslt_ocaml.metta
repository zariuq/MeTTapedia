; Indexed OCaml runtime services. GSLT rules perform machine transitions;
; these ordinary services supply checked finite primitive/failure snapshots.

(: gslt:ml:pack1 (-> Atom Atom %Undefined%))
(= (gslt:ml:pack1 $name $value) (PApp $name (LCons $value LNil)))
(: gslt:ml:pack2 (-> Atom Atom Atom %Undefined%))
(= (gslt:ml:pack2 $name $first $second) (PApp $name (LCons $first (LCons $second LNil))))

(: gslt:ml:integer (-> Number %Undefined%))
(= (gslt:ml:integer $number)
   (let* (($negative (< $number 0))
          ($magnitude (if $negative (- 0 $number) $number))
          ($sign (PApp (if $negative "MlNegative" "MlNonnegative") LNil))
          ($digits (gslt:word16:digits $magnitude))
          ($word (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.vec" $digits RNone)))
     (gslt:ml:pack2 "MlInteger" $sign $word)))

(: gslt:ml:integer-value (-> Atom %Undefined%))
(= (gslt:ml:integer-value $value)
   (case $value
     (((PApp "MlInteger" (LCons (PApp $sign LNil) (LCons $word LNil)))
       (case (gslt:word16:vector-value $word)
         ((None None)
          ((Some $magnitude)
           (case $sign
             (("MlNonnegative" (Some $magnitude))
              ("MlNegative" (let $number (- 0 $magnitude) (Some $number)))
              ($bad None)))))))
      ($bad None))))

; Each completed service query freezes its plan and complete runner. Query
; receipts use row positions, so past receipts keep their original provider.
(: gslt:ml:begin (-> Atom Atom Atom %Undefined%))
(= (gslt:ml:begin $plan $standard $source)
   (let $runner (gslt:runner:begin ClassSearch $plan $standard $source)
     (MlMachine MlRunning $plan $standard $runner LNil)))

(: gslt:ml:install (-> Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:ml:install $plan $standard $runner $epochs $row)
   (case (gslt:provider-cache:append $plan (LCons $row LNil))
     ((None (MlMachine MlInvalid $plan $standard $runner $epochs))
      ((Some $nextPlan)
       (case $runner
         (((ClassMachine ClassDone $state $query $states $receipts)
           (let* (($fresh (gslt:runner:begin ClassSearch $nextPlan $standard $state))
                  ($history (LCons (MlEpoch $plan $runner) $epochs)))
             (MlMachine MlRunning $nextPlan $standard $fresh $history)))
          ($bad (MlMachine MlInvalid $plan $standard $runner $epochs))))))))

(: gslt:ml:service (-> Atom Atom Atom Atom %Undefined%))
(= (gslt:ml:service $plan $standard $runner $epochs)
   (case $runner
     (((ClassMachine ClassDone $state $query $states $receipts)
       (let* (($status (gslt:search:status ClassSearch $plan $query))
              ($published (gslt:search:publication ClassSearch $query)))
         (if (== $status SearchComplete)
           (if (== $published LNil)
             (case $state
               (((PApp "MlDone" $arguments) (MlMachine MlComplete $plan $standard $runner $epochs))
                ((PApp "MlFault" $arguments) (MlMachine MlComplete $plan $standard $runner $epochs))
                ((PApp "MlPrimitiveRequest" (LCons $operator (LCons $arguments (LCons $continuation LNil))))
                 (case (gslt:ml:primitive $operator $arguments)
                   ((None (MlMachine MlInvalid $plan $standard $runner $epochs))
                    ((Some $result)
                     (let $row (PremiseProviderRow "ml-primitive"
                           (LCons $operator (LCons $arguments (LCons $result LNil))))
                       (gslt:ml:install $plan $standard $runner $epochs $row))))))
                ((PApp "MlMatchOne" (LCons $pattern (LCons $value (LCons $body (LCons $environment (LCons $continuation LNil))))))
                 (let $row (PremiseProviderRow "ml-pattern-failure" (LCons $pattern (LCons $value LNil)))
                   (gslt:ml:install $plan $standard $runner $epochs $row)))
                ((PApp "MlTryClause" (LCons $pattern (LCons $value (LCons $body (LCons $later (LCons $environment (LCons $continuation LNil)))))))
                 (let $row (PremiseProviderRow "ml-pattern-failure" (LCons $pattern (LCons $value LNil)))
                   (gslt:ml:install $plan $standard $runner $epochs $row)))
                ($bad (MlMachine MlInvalid $plan $standard $runner $epochs))))
             (MlMachine MlInvalid $plan $standard $runner $epochs))
           (MlMachine MlRunning $plan $standard $runner $epochs))))
      ($bad (MlMachine MlInvalid $plan $standard $runner $epochs)))))

(: gslt:ml:tick (-> Atom Number %Undefined%))
(= (gslt:ml:tick $machine $quantum)
   (case $machine
     (((MlMachine MlRunning $plan $standard $runner $epochs)
       (case $runner
         (((ClassMachine ClassRunning $state $query $states $receipts)
           (let $next (gslt:runner:tick ClassSearch $plan $standard $runner $quantum)
             (MlMachine MlRunning $plan $standard $next $epochs)))
          ((ClassMachine ClassDone $state $query $states $receipts)
           (gslt:ml:service $plan $standard $runner $epochs))
          ((ClassMachine ClassBlocked $state $query $states $receipts)
           (MlMachine MlBlocked $plan $standard $runner $epochs))
          ($bad (MlMachine MlInvalid $plan $standard $runner $epochs)))))
      ($stopped $machine))))

(: gslt:ml:advance (-> Number Number Atom %Undefined%))
(= (gslt:ml:advance $ticks $quantum $machine)
   (if (== $ticks 0) $machine
     (case $machine
       (((MlMachine MlRunning $plan $standard $runner $epochs)
         (let* (($next (gslt:ml:tick $machine $quantum)) ($remaining (- $ticks 1)))
           (gslt:ml:advance $remaining $quantum $next)))
        ($stopped $machine)))))

(: gslt:ml:result (-> Atom %Undefined%))
(= (gslt:ml:result $machine)
   (case $machine
     (((MlMachine $phase $plan $standard $runner $epochs)
       (case $runner
         (((ClassMachine $status $state $query $states $receipts)
           (MlResult $phase $state $epochs (MlEpoch $plan $runner)))))))))

(: gslt:ml:boolean (-> Bool %Undefined%))
(= (gslt:ml:boolean $value) (PApp (if $value "MlTrue" "MlFalse") LNil))

(: gslt:ml:wrap (-> Number %Undefined%))
(= (gslt:ml:wrap $number)
   (let* (($negative (< $number 0))
          ($magnitude (if $negative (- 0 $number) $number)))
     (case (gslt:integer:divmod $magnitude 9223372036854775808)
       (((IntegerDivmod $quotient $remainder)
         (let $unsigned (if $negative
                  (if (== $remainder 0) 0 (- 9223372036854775808 $remainder)) $remainder)
           (if (< $unsigned 4611686018427387904) $unsigned (- $unsigned 9223372036854775808))))))))

(: gslt:ml:result-integer (-> Number %Undefined%))
(= (gslt:ml:result-integer $number)
   (let* (($wrapped (gslt:ml:wrap $number)) ($value (gslt:ml:integer $wrapped))
          ($result (gslt:ml:pack1 "MlPrimitiveValue" $value))) (Some $result)))
(: gslt:ml:result-boolean (-> Bool %Undefined%))
(= (gslt:ml:result-boolean $boolean)
   (let* (($value (gslt:ml:boolean $boolean))
          ($result (gslt:ml:pack1 "MlPrimitiveValue" $value))) (Some $result)))
(: gslt:ml:result-fault (-> Atom %Undefined%))
(= (gslt:ml:result-fault $name)
   (let* (($fault (PApp $name LNil)) ($result (gslt:ml:pack1 "MlPrimitiveFault" $fault))) (Some $result)))

(: gslt:ml:values (-> Atom %Undefined%))
(= (gslt:ml:values $values)
   (case $values
     (((PApp "MlValueNil" LNil) (Some LNil))
      ((PApp "MlValueCons" (LCons $head (LCons $tail LNil)))
       (case (gslt:ml:values $tail)
         ((None None) ((Some $rest) (Some (LCons $head $rest))))))
      ($bad None))))

(: gslt:ml:order (-> Number Number %Undefined%))
(= (gslt:ml:order $left $right)
   (if (< $left $right) MlLessOrder (if (== $left $right) MlEqualOrder MlGreaterOrder)))

(: gslt:ml:compare-fields (-> Atom Atom %Undefined%))
(= (gslt:ml:compare-fields $left $right)
   (case (MlComparePair $left $right)
     (((MlComparePair (PApp "MlValueNil" LNil) (PApp "MlValueNil" LNil)) MlEqualOrder)
      ((MlComparePair (PApp "MlValueNil" LNil) (PApp "MlValueCons" $rightFields)) MlLessOrder)
      ((MlComparePair (PApp "MlValueCons" $leftFields) (PApp "MlValueNil" LNil)) MlGreaterOrder)
      ((MlComparePair (PApp "MlValueCons" (LCons $first (LCons $rest LNil)))
                      (PApp "MlValueCons" (LCons $second (LCons $tail LNil))))
       (case (gslt:ml:compare $first $second)
         ((MlEqualOrder (gslt:ml:compare-fields $rest $tail)) ($other $other))))
      ($bad MlIncomparable))))

(: gslt:ml:byte-value (-> Atom %Undefined%))
(= (gslt:ml:byte-value $byte)
   (case $byte
     (((PApp "MlByteValue" (LCons $high (LCons $low LNil)))
       (case (gslt:word16:nibble-value $high)
         ((None None) ((Some $h) (case (gslt:word16:nibble-value $low)
           ((None None) ((Some $l) (let $number (+ (* 16 $h) $l) (Some $number)))))))))
      ($bad None))))

(: gslt:ml:compare-bytes (-> Atom Atom %Undefined%))
(= (gslt:ml:compare-bytes $left $right)
   (case (MlComparePair $left $right)
     (((MlComparePair LNil LNil) MlEqualOrder)
      ((MlComparePair LNil (LCons $head $tail)) MlLessOrder)
      ((MlComparePair (LCons $head $tail) LNil) MlGreaterOrder)
      ((MlComparePair (LCons $head $tail) (LCons $other $rest))
       (case (gslt:ml:byte-value $head)
         ((None MlIncomparable) ((Some $first) (case (gslt:ml:byte-value $other)
           ((None MlIncomparable) ((Some $second)
             (case (gslt:ml:order $first $second)
               ((MlEqualOrder (gslt:ml:compare-bytes $tail $rest)) ($order $order))))))))))
      ($bad MlIncomparable))))

(: gslt:ml:tag-value (-> Atom %Undefined%))
(= (gslt:ml:tag-value $tag)
   (case $tag
     (((PApp "MlTagNumber" (LCons $type (LCons $constructor LNil)))
       (case (gslt:word16:vector-value $type)
         ((None None) ((Some $typeId) (case (gslt:word16:vector-value $constructor)
           ((None None) ((Some $ordinal) (Some (MlTagValue $typeId $ordinal)))))))))
      ($bad None))))

(: gslt:ml:compare-variants (-> Atom Atom Atom Atom %Undefined%))
(= (gslt:ml:compare-variants $leftTag $left $rightTag $right)
   (case (gslt:ml:tag-value $leftTag)
     ((None MlIncomparable)
      ((Some (MlTagValue $leftType $leftOrdinal))
       (case (gslt:ml:tag-value $rightTag)
         ((None MlIncomparable)
          ((Some (MlTagValue $rightType $rightOrdinal))
           (if (== $leftType $rightType)
             (case (MlComparePair $left $right)
               (((MlComparePair (PApp "MlValueNil" LNil) (PApp "MlValueCons" $rightFields)) MlLessOrder)
                ((MlComparePair (PApp "MlValueCons" $leftFields) (PApp "MlValueNil" LNil)) MlGreaterOrder)
                ($other (case (gslt:ml:order $leftOrdinal $rightOrdinal)
                  ((MlEqualOrder (gslt:ml:compare-fields $left $right)) ($order $order))))))
             MlIncomparable))))))))

(: gslt:ml:compare (-> Atom Atom %Undefined%))
(= (gslt:ml:compare $left $right)
   (case (MlComparePair $left $right)
     (((MlComparePair (PApp "MlClosure" $fields) $other) MlFunctionalOrder)
      ((MlComparePair $other (PApp "MlClosure" $fields)) MlFunctionalOrder)
      ((MlComparePair (PApp "MlInteger" $leftFields) (PApp "MlInteger" $rightFields))
       (case (gslt:ml:integer-value $left)
         ((None MlIncomparable) ((Some $first) (case (gslt:ml:integer-value $right)
           ((None MlIncomparable) ((Some $second) (gslt:ml:order $first $second))))))))
      ((MlComparePair (PApp "MlFalse" LNil) (PApp "MlTrue" LNil)) MlLessOrder)
      ((MlComparePair (PApp "MlTrue" LNil) (PApp "MlFalse" LNil)) MlGreaterOrder)
      ((MlComparePair (PApp "MlFalse" LNil) (PApp "MlFalse" LNil)) MlEqualOrder)
      ((MlComparePair (PApp "MlTrue" LNil) (PApp "MlTrue" LNil)) MlEqualOrder)
      ((MlComparePair (PApp "MlUnit" LNil) (PApp "MlUnit" LNil)) MlEqualOrder)
      ((MlComparePair (PApp "MlNil" LNil) (PApp "MlNil" LNil)) MlEqualOrder)
      ((MlComparePair (PApp "MlNil" LNil) (PApp "MlCons" $fields)) MlLessOrder)
      ((MlComparePair (PApp "MlCons" $fields) (PApp "MlNil" LNil)) MlGreaterOrder)
      ((MlComparePair (PApp "MlCons" (LCons $first (LCons $rest LNil)))
                      (PApp "MlCons" (LCons $second (LCons $tail LNil))))
       (case (gslt:ml:compare $first $second)
         ((MlEqualOrder (gslt:ml:compare $rest $tail)) ($order $order))))
      ((MlComparePair (PApp "MlTuple" (LCons $leftFields LNil))
                      (PApp "MlTuple" (LCons $rightFields LNil)))
       (case (gslt:ml:values $leftFields)
         ((None MlIncomparable) ((Some $first) (case (gslt:ml:values $rightFields)
           ((None MlIncomparable) ((Some $second)
             (if (== (gslt:automata:length $first) (gslt:automata:length $second))
               (gslt:ml:compare-fields $leftFields $rightFields) MlIncomparable))))))))
      ((MlComparePair (PApp "MlVariant" (LCons $leftTag (LCons $leftFields LNil)))
                      (PApp "MlVariant" (LCons $rightTag (LCons $rightFields LNil))))
       (gslt:ml:compare-variants $leftTag $leftFields $rightTag $rightFields))
      ((MlComparePair (PApp "MlString" (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.vec" $first RNone) LNil))
                      (PApp "MlString" (LCons (PCollection "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.vec" $second RNone) LNil)))
       (gslt:ml:compare-bytes $first $second))
      ($bad MlIncomparable))))

(: gslt:ml:comparison (-> Atom Atom %Undefined%))
(= (gslt:ml:comparison $operator $order)
   (case $order
     ((MlFunctionalOrder (gslt:ml:result-fault "MlFunctionalComparison"))
      (MlIncomparable None)
      ($ordinary
       (case $operator
         (("MlEqual" (gslt:ml:result-boolean (== $order MlEqualOrder)))
          ("MlDifferent" (gslt:ml:result-boolean (if (== $order MlEqualOrder) False True)))
          ("MlLess" (gslt:ml:result-boolean (== $order MlLessOrder)))
          ("MlLessEqual" (gslt:ml:result-boolean (if (== $order MlGreaterOrder) False True)))
          ("MlGreater" (gslt:ml:result-boolean (== $order MlGreaterOrder)))
          ("MlGreaterEqual" (gslt:ml:result-boolean (if (== $order MlLessOrder) False True)))
          ($bad None)))))))

(: gslt:ml:integer-binary (-> Atom Atom Atom %Undefined%))
(= (gslt:ml:integer-binary $operator $left $right)
   (case (gslt:ml:integer-value $left)
     ((None None) ((Some $first)
      (case (gslt:ml:integer-value $right)
        ((None None) ((Some $second)
         (case $operator
           (("MlAdd" (gslt:ml:result-integer (+ $first $second)))
            ("MlSubtract" (gslt:ml:result-integer (- $first $second)))
            ("MlMultiply" (gslt:ml:result-integer (* $first $second)))
            ($division
             (if (== $second 0) (gslt:ml:result-fault "MlDivisionByZero")
               (let* (($negativeFirst (< $first 0)) ($negativeSecond (< $second 0))
                      ($leftMagnitude (if $negativeFirst (- 0 $first) $first))
                      ($rightMagnitude (if $negativeSecond (- 0 $second) $second)))
                 (case (gslt:integer:divmod $leftMagnitude $rightMagnitude)
                   (((IntegerDivmod $quotient $remainder)
                     (case $operator
                       (("MlDivide" (gslt:ml:result-integer
                          (if (== $negativeFirst $negativeSecond) $quotient (- 0 $quotient))))
                        ("MlModulo" (gslt:ml:result-integer (if $negativeFirst (- 0 $remainder) $remainder)))
                        ($bad None))))))))))))))))))

(: gslt:ml:primitive (-> Atom Atom %Undefined%))
(= (gslt:ml:primitive $operator $arguments)
   (case $operator
     (((PApp $name LNil)
       (case (gslt:ml:values $arguments)
         ((None None)
          ((Some $values)
           (case (MlPrimitiveCall $name $values)
             (((MlPrimitiveCall "MlNegate" (LCons $value LNil))
               (case (gslt:ml:integer-value $value)
                 ((None None) ((Some $number) (gslt:ml:result-integer (- 0 $number))))))
              ((MlPrimitiveCall "MlNotBool" (LCons (PApp "MlTrue" LNil) LNil)) (gslt:ml:result-boolean False))
              ((MlPrimitiveCall "MlNotBool" (LCons (PApp "MlFalse" LNil) LNil)) (gslt:ml:result-boolean True))
              ((MlPrimitiveCall $binary (LCons $left (LCons $right LNil)))
               (case $binary
                 (("MlAdd" (gslt:ml:integer-binary $binary $left $right))
                  ("MlSubtract" (gslt:ml:integer-binary $binary $left $right))
                  ("MlMultiply" (gslt:ml:integer-binary $binary $left $right))
                  ("MlDivide" (gslt:ml:integer-binary $binary $left $right))
                  ("MlModulo" (gslt:ml:integer-binary $binary $left $right))
                  ($comparison (let $order (gslt:ml:compare $left $right)
                    (gslt:ml:comparison $comparison $order))))))
              ($bad None)))))))
      ($bad None))))
