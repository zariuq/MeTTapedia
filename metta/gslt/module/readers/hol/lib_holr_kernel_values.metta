!(import! &self "../bytes/lib_raw_bytes.metta")

; Value representation between the byte decoder and HOLLightKernel records.
; The two language authorities retain their own sorts. No theorem is published.
(= (holr:kernel-nat (NatZero)) (hl:nz))
(= (holr:kernel-nat (NatBit (Bit0) $n)) (hl:nb0 (holr:kernel-nat $n)))
(= (holr:kernel-nat (NatBit (Bit1) $n)) (hl:nb1 (holr:kernel-nat $n)))

(= (holr:kernel-nibble (Bit0) (Bit0) (Bit0) (Bit0)) (hl:x0))
(= (holr:kernel-nibble (Bit0) (Bit0) (Bit0) (Bit1)) (hl:x1))
(= (holr:kernel-nibble (Bit0) (Bit0) (Bit1) (Bit0)) (hl:x2))
(= (holr:kernel-nibble (Bit0) (Bit0) (Bit1) (Bit1)) (hl:x3))
(= (holr:kernel-nibble (Bit0) (Bit1) (Bit0) (Bit0)) (hl:x4))
(= (holr:kernel-nibble (Bit0) (Bit1) (Bit0) (Bit1)) (hl:x5))
(= (holr:kernel-nibble (Bit0) (Bit1) (Bit1) (Bit0)) (hl:x6))
(= (holr:kernel-nibble (Bit0) (Bit1) (Bit1) (Bit1)) (hl:x7))
(= (holr:kernel-nibble (Bit1) (Bit0) (Bit0) (Bit0)) (hl:x8))
(= (holr:kernel-nibble (Bit1) (Bit0) (Bit0) (Bit1)) (hl:x9))
(= (holr:kernel-nibble (Bit1) (Bit0) (Bit1) (Bit0)) (hl:xa))
(= (holr:kernel-nibble (Bit1) (Bit0) (Bit1) (Bit1)) (hl:xb))
(= (holr:kernel-nibble (Bit1) (Bit1) (Bit0) (Bit0)) (hl:xc))
(= (holr:kernel-nibble (Bit1) (Bit1) (Bit0) (Bit1)) (hl:xd))
(= (holr:kernel-nibble (Bit1) (Bit1) (Bit1) (Bit0)) (hl:xe))
(= (holr:kernel-nibble (Bit1) (Bit1) (Bit1) (Bit1)) (hl:xf))

(= (holr:kernel-byte (Byte8 $b7 $b6 $b5 $b4 $b3 $b2 $b1 $b0))
   (hl:byte (holr:kernel-nibble $b7 $b6 $b5 $b4) (holr:kernel-nibble $b3 $b2 $b1 $b0)))
(= (holr:kernel-name (BNil)) (hl:nnil))
(= (holr:kernel-name (BCons $b $rest))
   (hl:ncons (holr:kernel-byte $b) (holr:kernel-name $rest)))
(= (holr:kernel-ids (WordsNil)) (hl:ids-nil))
(= (holr:kernel-ids (WordsCons $n $rest))
   (hl:ids-cons (holr:kernel-nat $n) (holr:kernel-ids $rest)))
(= (holr:kernel-pairs (PairsNil)) (hl:idp-nil))
(= (holr:kernel-pairs (PairsCons (BPair $a $b) $rest))
   (hl:idp-cons (holr:kernel-nat $a) (holr:kernel-nat $b) (holr:kernel-pairs $rest)))
(= (holr:kernel-operand $field)
   (case $field
     (((BWord $n) (holr:kernel-nat $n))
      ((BBytes $s) (holr:kernel-name $s))
      ((BWords $ns) (holr:kernel-ids $ns))
      ((BPairs $ps) (holr:kernel-pairs $ps)))))
(= (holr:kernel-fields (OperandsNil)) ())
(= (holr:kernel-fields (OperandsCons $field $rest))
   (let* (($head (holr:kernel-operand $field)) ($tail (holr:kernel-fields $rest)))
     (cons-atom $head $tail)))

(= (holr:kernel-constructor $opcode)
   (case $opcode
     ((1 (KernelConstructor holr:NAME))
      (2 (KernelConstructor holr:TYVAR))
      (3 (KernelConstructor holr:TYAPP))
      (4 (KernelConstructor holr:VAR))
      (5 (KernelConstructor holr:CONST))
      (6 (KernelConstructor holr:COMB))
      (7 (KernelConstructor holr:ABS))
      (16 (KernelConstructor holr:REFL))
      (17 (KernelConstructor holr:TRANS))
      (18 (KernelConstructor holr:MK_COMB))
      (19 (KernelConstructor holr:ABS_RULE))
      (20 (KernelConstructor holr:BETA))
      (21 (KernelConstructor holr:ASSUME))
      (22 (KernelConstructor holr:EQ_MP))
      (23 (KernelConstructor holr:DEDUCT_ANTISYM_RULE))
      (24 (KernelConstructor holr:INST_TYPE))
      (25 (KernelConstructor holr:INST))
      (32 (KernelConstructor holr:NEW_TYPE))
      (33 (KernelConstructor holr:NEW_CONSTANT))
      (34 (KernelConstructor holr:NEW_AXIOM))
      (35 (KernelConstructor holr:NEW_DEFINITION))
      (36 (KernelConstructor holr:NEW_TYPEDEF))
      (37 (KernelConstructor holr:POLICY))
      (48 (KernelConstructor holr:EXPECT))
      (53 (KernelConstructor holr:EXPECT_ALPHA))
      (52 (KernelConstructor holr:EXPECT_AXIOMS))
      (51 (KernelConstructor holr:EXPECT_REFUSED))
      (49 (KernelConstructor holr:LABEL))
      (50 (KernelConstructor holr:EMIT))
      (64 (KernelConstructor holr:DROP_TYPE))
      (65 (KernelConstructor holr:DROP_TERM))
      (66 (KernelConstructor holr:DROP_THM))
      ($other (KernelRecordRefused UnknownOpcode $other)))))

(= (holr:kernel-record (BRecord $opcode $fields))
   (let $tag (byte:unsigned $opcode)
     (case (holr:kernel-constructor $tag)
       (((KernelConstructor $constructor)
         (let $args (holr:kernel-fields $fields)
           (let $value (cons-atom $constructor $args) (KernelRecordValue $value))))
        ($other $other)))))
(= (holr:kernel-records (RecordsNil)) (KernelRecordsValue (hl:rnil)))
(= (holr:kernel-records (RecordsCons $record $rest))
   (case (holr:kernel-record $record)
     (((KernelRecordValue $head)
       (case (holr:kernel-records $rest)
         (((KernelRecordsValue $tail) (KernelRecordsValue (hl:rcons $head $tail)))
          ($other $other))))
      ($other $other))))

(= (holr:kernel-policy (NatZero)) (hl:open))
(= (holr:kernel-policy (NatBit (Bit1) (NatZero))) (hl:standard))
(= (holr:kernel-policy (NatBit (Bit0) (NatBit (Bit1) (NatZero)))) (hl:sealed))
(= (holr:kernel-mode (NatZero)) (hl:strict))
(= (holr:kernel-mode (NatBit (Bit1) (NatZero))) (hl:probe))
(= (holr:kernel-header (HOLRHeaderBytes $kernel $version $profile $policy $flags))
   (hl:header (holr:kernel-policy $policy) (holr:kernel-mode $flags)))
(= (holr:kernel-reason $reason)
   (case $reason
     (((BadHeader) (hl:bad-header))
      ((BadVersion) (hl:bad-version))
      ((BadOpcode) (hl:bad-opcode))
      ((BadCount) (hl:count-mismatch))
      ((BadChecksum) (hl:checksum-mismatch))
      ((TrailingBytes) (hl:trailing-bytes))
      ((MissingEnd) (hl:missing-end))
      ((Truncated) (hl:truncated))
      ((IntegerEncoding) (hl:bad-integer))
      ((FieldLimit) (hl:limit-exceeded)))))
(= (holr:kernel-terminal $terminal)
   (case $terminal
     (((HOLRPrefixOK) (hl:end-ok))
      ((HOLRPrefixError $reason) (hl:end-malformed (holr:kernel-reason $reason)))
      ((HOLRPrefixIncomplete) (hl:end-malformed (hl:truncated))))))
(= (holr:kernel-decoded $result)
   (case $result
     (((HOLRDecoded $header $records $terminal)
       (case (holr:kernel-records $records)
         (((KernelRecordsValue $values)
           (KernelDecodedValue (hl:decoded $values (holr:kernel-header $header) (holr:kernel-terminal $terminal))))
          ($other $other))))
      ((HOLRMalformed $reason)
       (KernelDecodedValue (hl:decoded (hl:rnil) (hl:header-malformed)
                             (hl:end-malformed (holr:kernel-reason $reason)))))
      ((NeedInput)
       (KernelDecodedValue (hl:decoded (hl:rnil) (hl:header-malformed) (hl:end-malformed (hl:truncated)))))
      ($other (KernelRecordRefused InvalidDecodedValue $other)))))
