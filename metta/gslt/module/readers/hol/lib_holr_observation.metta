; Representation conversion after decoding. This does not read input bytes.
!(import! &self "../bytes/lib_raw_bytes.metta")
(= (holr:byte-list (BNil)) LNil)
(= (holr:byte-list (BCons $byte $rest))
   (LCons (byte:unsigned $byte) (holr:byte-list $rest)))
(= (holr:word-list (WordsNil)) LNil)
(= (holr:word-list (WordsCons $n $rest))
   (LCons (byte:natural $n) (holr:word-list $rest)))
(= (holr:pair-list (PairsNil)) LNil)
(= (holr:pair-list (PairsCons (BPair $left $right) $rest))
   (LCons (BPair (byte:natural $left) (byte:natural $right)) (holr:pair-list $rest)))
(= (holr:operand $value)
   (case $value
     (((BWord $n) (BWord (byte:natural $n)))
      ((BBytes $bytes) (BBytes (holr:byte-list $bytes)))
      ((BWords $words) (BWords (holr:word-list $words)))
      ((BPairs $pairs) (BPairs (holr:pair-list $pairs)))
      ($other (ByteFormatObservationRefused $other)))))
(= (holr:operands (OperandsNil)) LNil)
(= (holr:operands (OperandsCons $value $rest))
   (LCons (holr:operand $value) (holr:operands $rest)))
(= (holr:records (RecordsNil)) LNil)
(= (holr:records (RecordsCons (BRecord $opcode $fields) $rest))
   (LCons (BRecord (byte:unsigned $opcode) (holr:operands $fields)) (holr:records $rest)))
(= (holr:header (HOLRHeaderBytes $kernel $version $profile $policy $flags))
   (HOLRHeader (BBytes (holr:byte-list $kernel))
     (byte:natural $version) (byte:natural $profile)
     (byte:natural $policy) (byte:natural $flags)))
(= (holr:observation $result)
   (case $result
     (((HOLRAccepted $header $records)
       (ByteFormatRead (holr:header $header) (holr:records $records)))
      ((HOLRMalformed $reason) (ByteFormatRefused $reason))
      ((NeedInput) ByteFormatNeedInput)
      ($other (ByteFormatObservationRefused $other)))))

; Complete-file observation retaining the decoded prefix before a failure.
(= (holr:prefix-terminal $terminal)
   (case $terminal
     (((HOLRPrefixOK) (ByteFormatEndOK))
      ((HOLRPrefixError $reason) (ByteFormatEndError $reason))
      ((HOLRPrefixIncomplete) (ByteFormatEndError (Truncated))))))
(= (holr:prefix-observation $result)
   (case $result
     (((HOLRDecoded $header $records $terminal)
       (ByteFormatPrefix (holr:header $header) (holr:records $records) (holr:prefix-terminal $terminal)))
      ((HOLRMalformed $reason) (ByteFormatRefused $reason))
      ((NeedInput) (ByteFormatRefused (Truncated)))
      ($other (ByteFormatObservationRefused $other)))))
