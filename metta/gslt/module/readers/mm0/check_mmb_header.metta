!(import! &self "../bytes/lib_raw_bytes.metta")
!(import! &self "../bytes/lib_module_rules.metta")
!(import! &self "../bytes/lib_byte_modules.metta")
!(import! &self "../bytes/lib_module_authoring.metta")
!(import! &self fs)
!(import! &self proc)
!(import! &self system)

(= (mmb:fail $detail)
   (let $printed (println! (MMBComponentGateFailed $detail)) (system:exit 1)))
(= (mmb:header-value
      (MMBHeaderValue $magic $version $sorts $reserved $terms $thms $pterms $pthms $pproof $reserved2 $pindex))
   (MMBHeaderValue (byte:natural $magic) (byte:natural $version) (byte:natural $sorts)
     (byte:natural $reserved) (byte:natural $terms) (byte:natural $thms)
     (byte:natural $pterms) (byte:natural $pthms) (byte:natural $pproof)
     (byte:natural $reserved2) (byte:natural $pindex)))
(= (mmb:oracle-header $oracle $path)
   (case (proc:run ($oracle "header" $path) ())
     (((proc:result (proc:exited 0) proc:normal $stdout $stderr $capture) (parse $stdout))
      ($other (mmb:fail (Oracle $path $other))))))
(= (mmb:header-case $oracle $alphabet $path)
   (let* (($owner (fs:open-read $path))
          ((fs:chunk $raw $offset) (fs:read-chunk $owner 40))
          ($closed (fs:close $owner))
          ($bytes (byte:constructors $alphabet $raw 0 (str:byte-length $raw)))
          ($answers (collapse (eval (ReadMMBHeader $bytes)))))
     (case $answers
       ((((MMBHeaderDecoded $header (BNil)))
         (let* (($actual (mmb:header-value $header))
                ($expected (mmb:oracle-header $oracle $path)))
           (if (== $actual $expected) 1 (mmb:fail (DifferentHeader $path $actual $expected)))))
        ($other (mmb:fail (HeaderOutcome $path $other)))))))
(= (mmb:files $oracle $alphabet $paths)
   (case $paths
     ((LNil 0)
      ((LCons $path $rest) (+ (mmb:header-case $oracle $alphabet $path) (mmb:files $oracle $alphabet $rest)))
      ($other (mmb:fail InvalidPathList)))))
(= (mmb:command-case $alphabet $label $escaped $op $n $remaining)
   (let* (($raw (str:unescape metta $escaped))
          ($input (byte:constructors $alphabet $raw 0 (str:byte-length $raw)))
          ($answers (collapse (eval (ReadMMBCommand $input)))))
     (case $answers
       ((((MMBCommand $opcode $value $rest))
         (if (and (== (byte:unsigned $opcode) $op)
                  (and (== (byte:natural $value) $n) (== (byte-count $rest) $remaining)))
           1 (mmb:fail (CommandValue $label))))
        ($other (mmb:fail (CommandOutcome $label $other)))))))
(= (byte-count (BNil)) 0)
(= (byte-count (BCons $byte $rest)) (+ 1 (byte-count $rest)))
(= (mmb:short-case $alphabet $escaped)
   (let* (($raw (str:unescape metta $escaped))
          ($input (byte:constructors $alphabet $raw 0 (str:byte-length $raw)))
          ($answers (collapse (eval (ReadMMBCommand $input)))))
     (if (== $answers ((NeedInput))) 1 (mmb:fail (ExpectedNeedInput $answers)))))

; Checks header values on complete source files and the local command codec.
; Table extents, statement/proof streams and the debugging index are separate.
!(let* (($readers (system:arg 0))
         ($compiler-arg (system:arg 1)) ($compiler (str:concat "" $compiler-arg))
         ($budget-arg (system:arg 2)) ($budget (str:concat "" $budget-arg))
         ($directory (system:arg 3))
         ($oracle-arg (system:arg 4)) ($oracle (str:concat "" $oracle-arg))
         ($list-file (system:arg 5))
         ((ByteModuleContext $decode $arithmetic $records $root $d $a $r $h $catalog)
           (byte-module:holr-context (str:concat $readers "/bytes") (str:concat $readers "/hol")))
         ($reader (langdef:load-baked-parser "module-core-reader"))
         ($source (str:concat $readers "/mm0/MMBHeader.module"))
         ($module (byte-module:read-source $reader "mmb:header" $source))
         ($closed (langdef:close-parser $reader))
         ($request (ModuleCompilePipeline $module (LCons "Format" LNil) (LCons $r LNil) $catalog "MMBHeader"))
         ($exported (module-authoring:export $request $compiler $budget
                       (str:concat $directory "/MMBHeader.request.metta")
                       (str:concat $directory "/MMBHeader.rules.metta")))
         ($installed (byte-module:install-export &self $exported)))
   (if (== $installed true)
     (let* (($alphabet (byte:alphabet))
            ($list-text (fs:read-text $list-file))
            ($paths (parse $list-text))
            ($count (mmb:files $oracle $alphabet $paths))
            ($c0 (mmb:command-case $alphabet bare "\\x3f\\x00\\x00\\x00\\x00" 63 0 4))
            ($c1 (mmb:command-case $alphabet u8 "\\x72\\xff\\x00\\x00\\x00" 50 255 3))
            ($c2 (mmb:command-case $alphabet u16 "\\xb2\\x34\\x12\\x00\\x00" 50 4660 2))
            ($c4 (mmb:command-case $alphabet u32 "\\xf2\\xff\\xff\\xff\\xff" 50 4294967295 0))
            ($s0 (mmb:short-case $alphabet ""))
            ($s1 (mmb:short-case $alphabet "\\xf2"))
            ($s4 (mmb:short-case $alphabet "\\xf2\\xff\\xff\\xff")))
       (println! (MMBComponentGatePassed $count (+ $c0 (+ $c1 (+ $c2 (+ $c4 (+ $s0 (+ $s1 $s4)))))))))
     (mmb:fail (Compilation $installed))))
