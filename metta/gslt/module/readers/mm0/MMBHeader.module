      HeaderInteger: (MMBHeaderFields (BadInteger)) ~> (BadInteger);
      HeaderLimit: (MMBHeaderFields (LimitExceeded)) ~> (LimitExceeded);
      CommandEmpty: (ReadMMBCommand (BNil)) ~> (NeedInput);
      CommandBare: (ReadMMBCommand (BCons (Byte8 (Bit0) (Bit0) b5 b4 b3 b2 b1 b0) rest)) ~> (MMBCommand (Byte8 (Bit0) (Bit0) b5 b4 b3 b2 b1 b0) (NatZero) rest);
      Command1: (ReadMMBCommand (BCons (Byte8 (Bit0) (Bit1) b5 b4 b3 b2 b1 b0) rest)) ~> (MMBCommandFinish (Byte8 (Bit0) (Bit0) b5 b4 b3 b2 b1 b0) (ReadFixedLE (NatBit (Bit1) (NatZero)) rest));
      Command2: (ReadMMBCommand (BCons (Byte8 (Bit1) (Bit0) b5 b4 b3 b2 b1 b0) rest)) ~> (MMBCommandFinish (Byte8 (Bit0) (Bit0) b5 b4 b3 b2 b1 b0) (ReadFixedLE (NatBit (Bit0) (NatBit (Bit1) (NatZero))) rest));
      Command4: (ReadMMBCommand (BCons (Byte8 (Bit1) (Bit1) b5 b4 b3 b2 b1 b0) rest)) ~> (MMBCommandFinish (Byte8 (Bit0) (Bit0) b5 b4 b3 b2 b1 b0) (ReadFixedLE (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatZero)))) rest));
