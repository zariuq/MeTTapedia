      MMBHeaderGuard . CodecState ::= "mmb_header_guard" "(" Ordering "," Ordering "," Ordering "," Ordering "," MMBHeader "," Bytes ")";
      MMBHeaderDecoded . CodecState ::= "mmb_header_decoded" "(" MMBHeader "," Bytes ")";
      MMBHeaderRefused . CodecState ::= "mmb_header_refused" "(" MMBReason ")";
      ReadMMBCommand . CodecState ::= "read_mmb_command" "(" Bytes ")";
      MMBCommandFinish . CodecState ::= "mmb_command_finish" "(" Byte "," CodecState ")";
      MMBCommand . CodecState ::= "mmb_command" "(" Byte "," Nat "," Bytes ")";
    }
  }
  Theory Decoder(s: Signature) {
    s Rewrites {
      FixedOperand: (ReadOperand limit (FixedField width) xs) ~> (OperandWord (ReadFixedLE width xs));
      HeaderLayout: (MMBHeaderLayout) ~> (FieldNext (FixedField (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatZero))))) (FieldNext (FixedField (NatBit (Bit1) (NatZero))) (FieldNext (FixedField (NatBit (Bit1) (NatZero))) (FieldNext (FixedField (NatBit (Bit0) (NatBit (Bit1) (NatZero)))) (FieldNext (FixedField (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatZero))))) (FieldNext (FixedField (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatZero))))) (FieldNext (FixedField (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatZero))))) (FieldNext (FixedField (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatZero))))) (FieldNext (FixedField (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatZero))))) (FieldNext (FixedField (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatZero))))) (FieldNext (FixedField (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatZero)))))) (FieldsEnd))))))))))));
      HeaderRead: (ReadMMBHeader xs) ~> (MMBHeaderFields (DecodeFields (NatZero) (MMBHeaderLayout) xs));
      HeaderFields: (MMBHeaderFields (FieldsDecoded (OperandsCons (BWord magic) (OperandsCons (BWord version) (OperandsCons (BWord sorts) (OperandsCons (BWord reserved) (OperandsCons (BWord terms) (OperandsCons (BWord thms) (OperandsCons (BWord pterms) (OperandsCons (BWord pthms) (OperandsCons (BWord pproof) (OperandsCons (BWord reserved2) (OperandsCons (BWord pindex) (OperandsNil)))))))))))) rest)) ~> (MMBHeaderGuard (NatCompare magic (NatBit (Bit1) (NatBit (Bit0) (NatBit (Bit1) (NatBit (Bit1) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatBit (Bit0) (NatBit (Bit1) (NatBit (Bit0) (NatBit (Bit1) (NatBit (Bit1) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatBit (Bit1) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit0) (NatBit (Bit1) (NatZero))))))))))))))))))))))))))))))))) (NatCompare version (NatBit (Bit1) (NatZero))) (NatCompare reserved (NatZero)) (NatCompare reserved2 (NatZero)) (MMBHeaderValue magic version sorts reserved terms thms pterms pthms pproof reserved2 pindex) rest);
      HeaderValid: (MMBHeaderGuard (Equal) (Equal) (Equal) (Equal) h rest) ~> (MMBHeaderDecoded h rest);
      HeaderMagicLess: (MMBHeaderGuard (Less) version r1 r2 h rest) ~> (MMBHeaderRefused (MMBBadMagic));
      HeaderMagicGreater: (MMBHeaderGuard (Greater) version r1 r2 h rest) ~> (MMBHeaderRefused (MMBBadMagic));
      HeaderVersionLess: (MMBHeaderGuard (Equal) (Less) r1 r2 h rest) ~> (MMBHeaderRefused (MMBBadVersion));
      HeaderVersionGreater: (MMBHeaderGuard (Equal) (Greater) r1 r2 h rest) ~> (MMBHeaderRefused (MMBBadVersion));
      HeaderReservedLess: (MMBHeaderGuard (Equal) (Equal) (Less) r2 h rest) ~> (MMBHeaderRefused (MMBReserved));
      HeaderReservedGreater: (MMBHeaderGuard (Equal) (Equal) (Greater) r2 h rest) ~> (MMBHeaderRefused (MMBReserved));
      HeaderReservedSecondLess: (MMBHeaderGuard (Equal) (Equal) (Equal) (Less) h rest) ~> (MMBHeaderRefused (MMBReserved));
      HeaderReservedSecondGreater: (MMBHeaderGuard (Equal) (Equal) (Equal) (Greater) h rest) ~> (MMBHeaderRefused (MMBReserved));
