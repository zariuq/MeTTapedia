    Terms {
      FixedField . FieldKind ::= "fixed_field" "(" Nat ")";
      MMBHeaderValue . MMBHeader ::= "mmb_header" "(" Nat "," Nat "," Nat "," Nat "," Nat "," Nat "," Nat "," Nat "," Nat "," Nat "," Nat ")";
      MMBBadMagic . MMBReason ::= "mmb_bad_magic";
      MMBBadVersion . MMBReason ::= "mmb_bad_version";
      MMBReserved . MMBReason ::= "mmb_reserved";
      MMBHeaderLayout . FieldLayout ::= "mmb_header_layout";
