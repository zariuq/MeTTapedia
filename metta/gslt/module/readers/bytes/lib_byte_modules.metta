!(import! &self (library lib_module))
!(import! &self fs)
!(import! &self str)

(= (byte-module:read-source $reader $name $path)
   (let* (($text (fs:read-text $path))
          ($digest (str:sha256 $text))
          ($origin (str:concat $name (str:concat ":" $digest))))
     (module:read-text $reader $origin $text)))

; Explicit paths are provided by the caller. The same source values populate
; each import spelling, so dependency identity is retained across the joins.
(= (byte-module:holr-context $bytes-directory $hol-directory)
   (let* (($reader (langdef:load-baked-parser "module-core-reader"))
          ($bytes-path (str:concat $bytes-directory "/ByteValues.module"))
          ($scalars-path (str:concat $bytes-directory "/ByteScalars.module"))
          ($decode-path (str:concat $bytes-directory "/ByteDecode.module"))
          ($arithmetic-path (str:concat $bytes-directory "/ByteArithmetic.module"))
          ($records-path (str:concat $bytes-directory "/ByteRecords.module"))
          ($holr-path (str:concat $hol-directory "/HOLRStream.module"))
          ($bytes (byte-module:read-source $reader "bytes:values" $bytes-path))
          ($scalars (byte-module:read-source $reader "bytes:scalars" $scalars-path))
          ($decode (byte-module:read-source $reader "bytes:decode" $decode-path))
          ($arithmetic (byte-module:read-source $reader "bytes:arithmetic" $arithmetic-path))
          ($records (byte-module:read-source $reader "bytes:records" $records-path))
          ($holr (byte-module:read-source $reader "holr:stream" $holr-path))
          ($shared (byte-module:read-source $reader "holr:data" (str:concat $hol-directory "/HOLRData.module")))
          ($prefix (byte-module:read-source $reader "holr:prefix" (str:concat $hol-directory "/HOLRPrefix.module")))
          ($schema (byte-module:read-source $reader "holr:schema" (str:concat $hol-directory "/HOLRSchema.module")))
          ($equality (byte-module:read-source $reader "holr:equality" (str:concat $hol-directory "/HOLREquality.module")))
          ($header (byte-module:read-source $reader "holr:header" (str:concat $hol-directory "/HOLRHeader.module")))
          ($stream (byte-module:read-source $reader "holr:records" (str:concat $hol-directory "/HOLRRecords.module")))
          ($trailer (byte-module:read-source $reader "holr:trailer" (str:concat $hol-directory "/HOLRTrailer.module")))
          ($final (byte-module:read-source $reader "holr:final" (str:concat $hol-directory "/HOLRFinal.module")))
          ($closed (langdef:close-parser $reader))
          ($catalog
            (LCons (ModuleCatalogEntryV1 "HOLRData.module" $shared)
            (LCons (ModuleCatalogEntryV1 "HOLRPrefix.module" $prefix)
            (LCons (ModuleCatalogEntryV1 "HOLRSchema.module" $schema)
            (LCons (ModuleCatalogEntryV1 "HOLREquality.module" $equality)
            (LCons (ModuleCatalogEntryV1 "HOLRHeader.module" $header)
            (LCons (ModuleCatalogEntryV1 "HOLRRecords.module" $stream)
            (LCons (ModuleCatalogEntryV1 "HOLRTrailer.module" $trailer)
            (LCons (ModuleCatalogEntryV1 "HOLRFinal.module" $final)
            (LCons (ModuleCatalogEntryV1 "ByteScalars.module" $scalars)
            (LCons (ModuleCatalogEntryV1 "../bytes/ByteScalars.module" $scalars)
            (LCons (ModuleCatalogEntryV1 "ByteValues.module" $bytes)
            (LCons (ModuleCatalogEntryV1 "ByteDecode.module" $decode)
            (LCons (ModuleCatalogEntryV1 "ByteArithmetic.module" $arithmetic)
            (LCons (ModuleCatalogEntryV1 "ByteRecords.module" $records)
            (LCons (ModuleCatalogEntryV1 "../bytes/ByteValues.module" $bytes)
            (LCons (ModuleCatalogEntryV1 "../bytes/ByteDecode.module" $decode)
            (LCons (ModuleCatalogEntryV1 "../bytes/ByteArithmetic.module" $arithmetic)
            (LCons (ModuleCatalogEntryV1 "../bytes/ByteRecords.module" $records) LNil)))))))))))))))))))
          ($v (module:assemble $scalars "Values" LNil $catalog OriginViewV1 "bytes:values"))
          ($d $v)
          ($a $v)
          ($r (module:assemble $records "Data" (LCons $a LNil) $catalog OriginViewV1 "bytes:records"))
          ($h (module:assemble $shared "Data" (LCons $r LNil) $catalog OriginViewV1 "holr:shared")))
     (ByteModuleContext $decode $arithmetic $records $holr $d $a $r $h $catalog)))

(= (byte-module:lookup $key $catalog)
   (case $catalog
     ((LNil (ByteModuleRefused MissingModule $key))
      ((LCons (ModuleCatalogEntryV1 $name $module) $rest)
       (if (== $key $name) (ByteModuleFound $module) (byte-module:lookup $key $rest))))))

(= (byte-module:holr-component
      (ByteModuleContext $decode $arithmetic $records $holr $d $a $r $h $catalog) $theory)
   (if (== $theory "Format")
     (module:assemble $holr "Format" (LCons $h LNil) $catalog OriginViewV1 "HOLRStream")
     (let $key (str:concat "HOLR" (str:concat $theory ".module"))
       (case (byte-module:lookup $key $catalog)
         (((ByteModuleFound $module)
           (let $signature (module:assemble $module "Signature" (LCons $h LNil) $catalog OriginViewV1 $theory)
             (case $signature
               (((ModulePresentationV1 $presentationName $presentationPolicy $presentationEntries $presentationSources $presentationMetadata)
                 (module:assemble $module "Format" (LCons $signature LNil) $catalog OriginViewV1 $theory))
                ($other $other)))))
          ($other $other))))))

(= (byte-module:holr-presentation $bytes-directory $hol-directory)
   (let $context (byte-module:holr-context $bytes-directory $hol-directory)
     (byte-module:holr-component $context "Format")))

(= (byte-module:common-component
      (ByteModuleContext $decode $arithmetic $records $holr $d $a $r $h $catalog) $family $theory)
   (case $family
     ((decode (module:assemble $decode $theory (LCons $d LNil) $catalog OriginViewV1 $theory))
      (arithmetic (module:assemble $arithmetic $theory (LCons $a LNil) $catalog OriginViewV1 $theory))
      (records (module:assemble $records $theory (LCons $r LNil) $catalog OriginViewV1 $theory))
      ($other (ByteModuleRefused UnknownFamily $other)))))
