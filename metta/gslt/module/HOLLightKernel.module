-- HOL Light's kernel (fusion.ml, SHA-256 29544be92d9cc1e6b3b59ba5b210604b9a748366a68b3bcdc2619717d68fd98a,
-- with lib.ml of 233b83c for union, subtract, subset, rev_assocd, sort) as a pure calculus, and a checker that
-- folds over a decoded HOLR v1 record sequence.
--
-- Reading:
--   * Every judgment is a function written as big-step rules: "J"(arguments) ~> result, its premises being
--     calls of other judgments.  Rules of one judgment do not overlap, so each call has at most one result.
--   * All data is constructor data.  A name is its list of bytes; a byte is two hexadecimal digits.  Ids,
--     counts and arities are binary numerals, least significant digit first.
--   * The kernel's state is explicit: a theory value (type constants, term constants, axioms, definitions)
--     goes into each theory operation and a new theory value comes out.  Theorems are values of sort Thm.
--   * fusion.ml uses OCaml's physical equality (==) in a few places.  Where it can change a result
--     (vsubst's "s' == s"), it is read as structural equality: the result is then a function of the
--     arguments.  Elsewhere (qmap, inst, orda, term_image) the test cannot change a result.
--   * OCaml evaluates "let a = e1 and b = e2" left to right; inst's Comb case is written that way.
--
-- Layers: Data (bytes, names, numerals, orderings); Syntax (types and terms, OCaml's compare, lib.ml's lists);
-- Kernel (fusion.ml's functions, ten primitive rules, theory operations); Replay (HOLR v1: id tables,
-- validation, records, axiom policy with its standard certification, verdicts).
Module HOLLightKernel {
  Theory Kernel() {
    Empty
    Types {
      Flag; Ord; Nib; Byte; Str; Strs; Nat; Ids; IdPairs; Bits4;
      Type; Tys; Term; Tms; Thm; Thms; TyPairs; TmPairs;
      FunTy; SplitEq; InstR; VsR; KR; TR; YR; MatchR; OptTy; OptNat;
      TyCons; Cons; Thy; ThyR; ThyThmR; TydefR;
      Reason; Status; Policy; Mode; Std; StdDef; StdDefs;
      Obj; Cell; Trie; Table; Tables; Labels; Book; Kern; Replay;
      Record; Records; Header; Terminal; Decoded; Verdict; Step; Validity; Exec; Out;
    }
    Terms {
      -- ---------------------------------------------------------------- data
      "hl:yes". |- "yes" : Flag;
      "hl:no". |- "no" : Flag;
      "hl:lt". |- "lt" : Ord;
      "hl:eq". |- "eq" : Ord;
      "hl:gt". |- "gt" : Ord;
      "hl:x0". |- "x0" : Nib;  "hl:x1". |- "x1" : Nib;  "hl:x2". |- "x2" : Nib;  "hl:x3". |- "x3" : Nib;
      "hl:x4". |- "x4" : Nib;  "hl:x5". |- "x5" : Nib;  "hl:x6". |- "x6" : Nib;  "hl:x7". |- "x7" : Nib;
      "hl:x8". |- "x8" : Nib;  "hl:x9". |- "x9" : Nib;  "hl:xa". |- "xa" : Nib;  "hl:xb". |- "xb" : Nib;
      "hl:xc". |- "xc" : Nib;  "hl:xd". |- "xd" : Nib;  "hl:xe". |- "xe" : Nib;  "hl:xf". |- "xf" : Nib;
      "hl:bits4". a:Flag, b:Flag, c:Flag, d:Flag |- "bits4" a b c d : Bits4;
      "hl:byte". hi:Nib, lo:Nib |- "byte" hi lo : Byte;
      "hl:nnil". |- "nnil" : Str;
      "hl:ncons". x:Byte, xs:Str |- "ncons" x xs : Str;
      "hl:ss-nil". |- "ss-nil" : Strs;
      "hl:ss-cons". x:Str, xs:Strs |- "ss-cons" x xs : Strs;
      "hl:nz". |- "nz" : Nat;
      "hl:nb0". n:Nat |- "nb0" n : Nat;
      "hl:nb1". n:Nat |- "nb1" n : Nat;
      "hl:ids-nil". |- "ids-nil" : Ids;
      "hl:ids-cons". x:Nat, xs:Ids |- "ids-cons" x xs : Ids;
      "hl:idp-nil". |- "idp-nil" : IdPairs;
      "hl:idp-cons". a:Nat, b:Nat, xs:IdPairs |- "idp-cons" a b xs : IdPairs;
      "hl:not". a:Flag |- "not" a : Flag;
      "hl:and". a:Flag, b:Flag |- "and" a b : Flag;
      "hl:or". a:Flag, b:Flag |- "or" a b : Flag;
      "hl:then". o:Ord, p:Ord |- "then" o p : Ord;
      "hl:ord-is-eq". o:Ord |- "ord-is-eq" o : Flag;
      "hl:cmp-flag". a:Flag, b:Flag |- "cmp-flag" a b : Ord;
      "hl:nib-bits". a:Nib |- "nib-bits" a : Bits4;
      "hl:cmp-nib". a:Nib, b:Nib |- "cmp-nib" a b : Ord;
      "hl:cmp-byte". a:Byte, b:Byte |- "cmp-byte" a b : Ord;
      "hl:cmp-str". a:Str, b:Str |- "cmp-str" a b : Ord;
      "hl:cmp-str-k". o:Ord, a:Str, b:Str |- "cmp-str-k" o a b : Ord;
      "hl:str-eq". a:Str, b:Str |- "str-eq" a b : Flag;
      "hl:str-prime". a:Str |- "str-prime" a : Str;
      "hl:ss-mem". x:Str, xs:Strs |- "ss-mem" x xs : Flag;
      "hl:ss-mem-k". e:Flag, x:Str, xs:Strs |- "ss-mem-k" e x xs : Flag;
      "hl:nat-inc". n:Nat |- "nat-inc" n : Nat;
      "hl:cmp-nat". a:Nat, b:Nat |- "cmp-nat" a b : Ord;
      "hl:ids-merge". a:Ids, b:Ids |- "ids-merge" a b : Ids;
      "hl:ids-merge-k". o:Ord, x:Nat, xs:Ids, y:Nat, ys:Ids |- "ids-merge-k" o x xs y ys : Ids;
      "hl:ids-set". a:Ids |- "ids-set" a : Ids;
      "hl:ids-count". a:Ids |- "ids-count" a : Nat;
      "hl:ids-eq". a:Ids, b:Ids |- "ids-eq" a b : Flag;
      "hl:ids-eq-k". o:Ord, xs:Ids, ys:Ids |- "ids-eq-k" o xs ys : Flag;

      -- names that fusion.ml and CeTTa's standard theory spell out
      "hl:nm-bool". |- "nm-bool" : Str;   "hl:nm-fun". |- "nm-fun" : Str;     "hl:nm-eq". |- "nm-eq" : Str;
      "hl:nm-A". |- "nm-A" : Str;         "hl:nm-B". |- "nm-B" : Str;         "hl:nm-a". |- "nm-a" : Str;
      "hl:nm-r". |- "nm-r" : Str;         "hl:nm-ind". |- "nm-ind" : Str;     "hl:nm-at". |- "nm-at" : Str;
      "hl:nm-T". |- "nm-T" : Str;         "hl:nm-and". |- "nm-and" : Str;     "hl:nm-imp". |- "nm-imp" : Str;
      "hl:nm-all". |- "nm-all" : Str;     "hl:nm-ex". |- "nm-ex" : Str;       "hl:nm-F". |- "nm-F" : Str;
      "hl:nm-neg". |- "nm-neg" : Str;     "hl:nm-one-one". |- "nm-one-one" : Str;
      "hl:nm-onto". |- "nm-onto" : Str;   "hl:nm-p". |- "nm-p" : Str;         "hl:nm-q". |- "nm-q" : Str;
      "hl:nm-f". |- "nm-f" : Str;         "hl:nm-P". |- "nm-P" : Str;         "hl:nm-x". |- "nm-x" : Str;
      "hl:nm-t". |- "nm-t" : Str;         "hl:nm-x1". |- "nm-x1" : Str;       "hl:nm-x2". |- "nm-x2" : Str;
      "hl:nm-y". |- "nm-y" : Str;         "hl:nm-g2064". |- "nm-g2064" : Str; "hl:nm-g2069". |- "nm-g2069" : Str;

      -- -------------------------------------------------------------- syntax
      "hl:Tyvar". n:Str |- "Tyvar" n : Type;
      "hl:Tyapp". n:Str, args:Tys |- "Tyapp" n args : Type;
      "hl:tynil". |- "tynil" : Tys;
      "hl:tycons". x:Type, xs:Tys |- "tycons" x xs : Tys;
      "hl:Var". n:Str, ty:Type |- "Var" n ty : Term;
      "hl:Const". n:Str, ty:Type |- "Const" n ty : Term;
      "hl:Comb". f:Term, x:Term |- "Comb" f x : Term;
      "hl:Abs". v:Term, b:Term |- "Abs" v b : Term;
      "hl:tmnil". |- "tmnil" : Tms;
      "hl:tmcons". x:Term, xs:Tms |- "tmcons" x xs : Tms;
      "hl:Sequent". asl:Tms, c:Term |- "Sequent" asl c : Thm;
      "hl:thnil". |- "thnil" : Thms;
      "hl:thcons". x:Thm, xs:Thms |- "thcons" x xs : Thms;
      "hl:typ-nil". |- "typ-nil" : TyPairs;
      "hl:typ-cons". val:Type, key:Type, xs:TyPairs |- "typ-cons" val key xs : TyPairs;
      "hl:tmp-nil". |- "tmp-nil" : TmPairs;
      "hl:tmp-cons". val:Term, key:Term, xs:TmPairs |- "tmp-cons" val key xs : TmPairs;
      "hl:fun-parts". d:Type, r:Type |- "fun-parts" d r : FunTy;
      "hl:not-fun". |- "not-fun" : FunTy;
      "hl:eqn". op:Term, l:Term, r:Term |- "eqn" op l r : SplitEq;
      "hl:no-eqn". |- "no-eqn" : SplitEq;
      "hl:some-ty". ty:Type |- "some-ty" ty : OptTy;
      "hl:none-ty". |- "none-ty" : OptTy;
      "hl:some-nat". n:Nat |- "some-nat" n : OptNat;
      "hl:none-nat". |- "none-nat" : OptNat;

      "hl:bool-ty". |- "bool_ty" : Type;
      "hl:aty". |- "aty" : Type;
      "hl:mk-fun-ty". d:Type, r:Type |- "mk_fun_ty" d r : Type;
      "hl:dest-fun-ty". ty:Type |- "dest-fun-ty" ty : FunTy;
      "hl:dest-fun-k". e:Flag, d:Type, r:Type |- "dest-fun-k" e d r : FunTy;
      "hl:cmp-type". a:Type, b:Type |- "cmp-type" a b : Ord;
      "hl:cmp-type-k". o:Ord, a:Tys, b:Tys |- "cmp-type-k" o a b : Ord;
      "hl:cmp-types". a:Tys, b:Tys |- "cmp-types" a b : Ord;
      "hl:cmp-types-k". o:Ord, a:Tys, b:Tys |- "cmp-types-k" o a b : Ord;
      "hl:ty-eq". a:Type, b:Type |- "ty-eq" a b : Flag;
      "hl:cmp-leaf". n1:Str, t1:Type, n2:Str, t2:Type |- "cmp-leaf" n1 t1 n2 t2 : Ord;
      "hl:cmp-leaf-k". o:Ord, t1:Type, t2:Type |- "cmp-leaf-k" o t1 t2 : Ord;
      "hl:cmp-term". a:Term, b:Term |- "cmp-term" a b : Ord;
      "hl:cmp-term-k". o:Ord, a:Term, b:Term |- "cmp-term-k" o a b : Ord;
      "hl:tm-eq". a:Term, b:Term |- "tm-eq" a b : Flag;
      "hl:tms-eq". a:Tms, b:Tms |- "tms-eq" a b : Flag;
      "hl:tms-eq-k". e:Flag, a:Tms, b:Tms |- "tms-eq-k" e a b : Flag;
      "hl:ty-mem". x:Type, xs:Tys |- "ty-mem" x xs : Flag;
      "hl:ty-mem-k". e:Flag, x:Type, xs:Tys |- "ty-mem-k" e x xs : Flag;
      "hl:ty-insert". x:Type, xs:Tys |- "ty-insert" x xs : Tys;
      "hl:ty-insert-k". e:Flag, x:Type, xs:Tys |- "ty-insert-k" e x xs : Tys;
      "hl:ty-union". a:Tys, b:Tys |- "ty-union" a b : Tys;
      "hl:ty-subset". a:Tys, b:Tys |- "ty-subset" a b : Flag;
      "hl:ty-subset-k". e:Flag, a:Tys, b:Tys |- "ty-subset-k" e a b : Flag;
      "hl:ty-sort". a:Tys |- "ty-sort" a : Tys;
      "hl:ty-sort-insert". x:Type, xs:Tys |- "ty-sort-insert" x xs : Tys;
      "hl:ty-sort-insert-k". o:Ord, x:Type, y:Type, ys:Tys |- "ty-sort-insert-k" o x y ys : Tys;
      "hl:ty-length". a:Tys |- "ty-length" a : Nat;
      "hl:tyvars". ty:Type |- "tyvars" ty : Tys;
      "hl:tyvars-list". a:Tys |- "tyvars-list" a : Tys;
      "hl:typ-rev-assocd". key:Type, xs:TyPairs, d:Type |- "typ-rev-assocd" key xs d : Type;
      "hl:typ-rev-assocd-k". e:Flag, key:Type, val:Type, xs:TyPairs, d:Type |- "typ-rev-assocd-k" e key val xs d : Type;
      "hl:type-subst". i:TyPairs, ty:Type |- "type_subst" i ty : Type;
      "hl:type-subst-list". i:TyPairs, a:Tys |- "type-subst-list" i a : Tys;
      "hl:tm-mem". x:Term, xs:Tms |- "tm-mem" x xs : Flag;
      "hl:tm-mem-k". e:Flag, x:Term, xs:Tms |- "tm-mem-k" e x xs : Flag;
      "hl:tm-insert". x:Term, xs:Tms |- "tm-insert" x xs : Tms;
      "hl:tm-insert-k". e:Flag, x:Term, xs:Tms |- "tm-insert-k" e x xs : Tms;
      "hl:tm-union". a:Tms, b:Tms |- "tm-union" a b : Tms;
      "hl:tm-subtract". a:Tms, b:Tms |- "tm-subtract" a b : Tms;
      "hl:tm-subtract-k". e:Flag, x:Term, rest:Tms |- "tm-subtract-k" e x rest : Tms;
      "hl:tmp-rev-assocd". key:Term, xs:TmPairs, d:Term |- "tmp-rev-assocd" key xs d : Term;
      "hl:tmp-rev-assocd-k". e:Flag, key:Term, val:Term, xs:TmPairs, d:Term |- "tmp-rev-assocd-k" e key val xs d : Term;

      -- -------------------------------------------------------------- kernel
      "hl:type-of". tm:Term |- "type_of" tm : Type;
      "hl:frees". tm:Term |- "frees" tm : Tms;
      "hl:freesl". a:Tms |- "freesl" a : Tms;
      "hl:freesin". acc:Tms, tm:Term |- "freesin" acc tm : Flag;
      "hl:freesin-k". e:Flag, acc:Tms, tm:Term |- "freesin-k" e acc tm : Flag;
      "hl:vfree-in". v:Term, tm:Term |- "vfree_in" v tm : Flag;
      "hl:vfree-in-abs-k". e:Flag, v:Term, tm:Term |- "vfree-in-abs-k" e v tm : Flag;
      "hl:vfree-in-comb-k". e:Flag, v:Term, tm:Term |- "vfree-in-comb-k" e v tm : Flag;
      "hl:exists-vfree-in". v:Term, xs:Tms |- "exists-vfree-in" v xs : Flag;
      "hl:exists-vfree-in-k". e:Flag, v:Term, xs:Tms |- "exists-vfree-in-k" e v xs : Flag;
      "hl:type-vars-in-term". tm:Term |- "type_vars_in_term" tm : Tys;
      "hl:variant". avoid:Tms, v:Term |- "variant" avoid v : Term;
      "hl:variant-k". e:Flag, avoid:Tms, n:Str, ty:Type |- "variant-k" e avoid n ty : Term;
      "hl:vs-ok". tm:Term |- "vs-ok" tm : VsR;
      "hl:vs-bad". |- "vs-bad" : VsR;
      "hl:vsubst". theta:TmPairs, tm:Term |- "vsubst" theta tm : VsR;
      "hl:vsubst-k". e:Flag, theta:TmPairs, tm:Term |- "vsubst-k" e theta tm : VsR;
      "hl:vsubst-good". theta:TmPairs |- "vsubst-good" theta : Flag;
      "hl:vsubst-good-k". e:Flag, rest:TmPairs |- "vsubst-good-k" e rest : Flag;
      "hl:vsubst-pair-good". t:Term, x:Term |- "vsubst-pair-good" t x : Flag;
      "hl:vsubst-rec". il:TmPairs, tm:Term |- "vsubst-rec" il tm : Term;
      "hl:vs-filter". il:TmPairs, v:Term |- "vs-filter" il v : TmPairs;
      "hl:vs-filter-k". e:Flag, t:Term, x:Term, rest:TmPairs, v:Term |- "vs-filter-k" e t x rest v : TmPairs;
      "hl:vs-abs-1". il:TmPairs, v:Term, s:Term |- "vs-abs-1" il v s : Term;
      "hl:vs-abs-2". e:Flag, il:TmPairs, v:Term, s:Term, s1:Term |- "vs-abs-2" e il v s s1 : Term;
      "hl:vs-abs-3". e:Flag, il:TmPairs, v:Term, s:Term, s1:Term |- "vs-abs-3" e il v s s1 : Term;
      "hl:vs-capture". il:TmPairs, v:Term, s:Term |- "vs-capture" il v s : Flag;
      "hl:vs-capture-k". e:Flag, x:Term, rest:TmPairs, v:Term, s:Term |- "vs-capture-k" e x rest v s : Flag;
      "hl:vs-capture-k2". e:Flag, rest:TmPairs, v:Term, s:Term |- "vs-capture-k2" e rest v s : Flag;
      "hl:inst". tyin:TyPairs, tm:Term |- "inst" tyin tm : Term;
      "hl:inst-ok". tm:Term |- "inst-ok" tm : InstR;
      "hl:inst-clash". tm:Term |- "inst-clash" tm : InstR;
      "hl:inst-rec". env:TmPairs, tyin:TyPairs, tm:Term |- "inst-rec" env tyin tm : InstR;
      "hl:inst-var-k". e:Flag, tm1:Term |- "inst-var-k" e tm1 : InstR;
      "hl:inst-comb-1". r:InstR, env:TmPairs, tyin:TyPairs, x:Term |- "inst-comb-1" r env tyin x : InstR;
      "hl:inst-comb-2". f1:Term, r:InstR |- "inst-comb-2" f1 r : InstR;
      "hl:inst-abs-1". r:InstR, env:TmPairs, tyin:TyPairs, y:Term, y1:Term, t:Term |- "inst-abs-1" r env tyin y y1 t : InstR;
      "hl:inst-abs-2". e:Flag, w:Term, env:TmPairs, tyin:TyPairs, y:Term, y1:Term, t:Term |- "inst-abs-2" e w env tyin y y1 t : InstR;
      "hl:inst-frees". tyin:TyPairs, a:Tms |- "inst-frees" tyin a : Tms;
      "hl:safe-mk-eq". l:Term, r:Term |- "safe_mk_eq" l r : Term;
      "hl:split-eq". tm:Term |- "split-eq" tm : SplitEq;
      "hl:split-eq-k". e:Flag, n:Str, ty:Type, l:Term, r:Term |- "split-eq-k" e n ty l r : SplitEq;
      "hl:alphaorder". a:Term, b:Term |- "alphaorder" a b : Ord;
      "hl:orda". env:TmPairs, a:Term, b:Term |- "orda" env a b : Ord;
      "hl:orda-comb-k". o:Ord, env:TmPairs, a:Term, b:Term |- "orda-comb-k" o env a b : Ord;
      "hl:orda-abs-k". o:Ord, env:TmPairs, a:Term, b:Term |- "orda-abs-k" o env a b : Ord;
      "hl:ordav". env:TmPairs, a:Term, b:Term |- "ordav" env a b : Ord;
      "hl:ordav-k". e1:Flag, e2:Flag, env:TmPairs, a:Term, b:Term |- "ordav-k" e1 e2 env a b : Ord;
      "hl:term-union". a:Tms, b:Tms |- "term_union" a b : Tms;
      "hl:term-union-k". o:Ord, h1:Term, t1:Tms, h2:Term, t2:Tms |- "term-union-k" o h1 t1 h2 t2 : Tms;
      "hl:term-remove". t:Term, l:Tms |- "term_remove" t l : Tms;
      "hl:term-remove-k". o:Ord, t:Term, s:Term, ss:Tms |- "term-remove-k" o t s ss : Tms;
      "hl:term-image-inst". tyin:TyPairs, l:Tms |- "term-image-inst" tyin l : Tms;
      "hl:term-image-vsubst". theta:TmPairs, l:Tms |- "term-image-vsubst" theta l : Tms;
      "hl:term-image-k". e:Flag, l:Tms, h1:Term, t1:Tms |- "term-image-k" e l h1 t1 : Tms;
      "hl:exists-aconv". x:Term, xs:Tms |- "exists-aconv" x xs : Flag;
      "hl:exists-aconv-k". o:Ord, x:Term, xs:Tms |- "exists-aconv-k" o x xs : Flag;
      "hl:forall-exists-aconv". a:Tms, b:Tms |- "forall-exists-aconv" a b : Flag;
      "hl:forall-exists-aconv-k". e:Flag, a:Tms, b:Tms |- "forall-exists-aconv-k" e a b : Flag;

      "hl:ok". th:Thm |- "ok" th : KR;
      "hl:fail". r:Reason |- "fail" r : KR;
      "hl:tm-ok". tm:Term |- "tm-ok" tm : TR;
      "hl:tm-fail". r:Reason |- "tm-fail" r : TR;
      "hl:ty-ok". ty:Type |- "ty-ok" ty : YR;
      "hl:ty-fail". r:Reason |- "ty-fail" r : YR;
      "hl:match-ok". b:TyPairs |- "match-ok" b : MatchR;
      "hl:match-fail". |- "match-fail" : MatchR;

      "hl:mk-type". thy:Thy, n:Str, args:Tys |- "mk_type" thy n args : YR;
      "hl:mk-type-k". o:OptNat, n:Str, args:Tys |- "mk-type-k" o n args : YR;
      "hl:mk-type-k2". o:Ord, n:Str, args:Tys |- "mk-type-k2" o n args : YR;
      "hl:mk-const-at". thy:Thy, n:Str, ty:Type |- "mk-const-at" thy n ty : TR;
      "hl:mk-const-k". o:OptTy, n:Str, ty:Type |- "mk-const-k" o n ty : TR;
      "hl:mk-const-k2". m:MatchR, n:Str, ty:Type |- "mk-const-k2" m n ty : TR;
      "hl:ty-match". pat:Type, ty:Type, b:TyPairs |- "ty-match" pat ty b : MatchR;
      "hl:ty-match-var". o:OptTy, pat:Type, ty:Type, b:TyPairs |- "ty-match-var" o pat ty b : MatchR;
      "hl:ty-match-var-k". e:Flag, b:TyPairs |- "ty-match-var-k" e b : MatchR;
      "hl:ty-match-app". e:Flag, pa:Tys, ta:Tys, b:TyPairs |- "ty-match-app" e pa ta b : MatchR;
      "hl:ty-match-list". pa:Tys, ta:Tys, b:TyPairs |- "ty-match-list" pa ta b : MatchR;
      "hl:ty-match-list-k". m:MatchR, pa:Tys, ta:Tys |- "ty-match-list-k" m pa ta : MatchR;
      "hl:typ-lookup". key:Type, xs:TyPairs |- "typ-lookup" key xs : OptTy;
      "hl:typ-lookup-k". e:Flag, val:Type, key:Type, xs:TyPairs |- "typ-lookup-k" e val key xs : OptTy;
      "hl:mk-comb". f:Term, a:Term |- "mk_comb" f a : TR;
      "hl:mk-comb-k". ft:FunTy, f:Term, a:Term |- "mk-comb-k" ft f a : TR;
      "hl:mk-comb-k2". e:Flag, f:Term, a:Term |- "mk-comb-k2" e f a : TR;
      "hl:mk-abs". v:Term, b:Term |- "mk_abs" v b : TR;

      "hl:REFL". tm:Term |- "REFL" tm : Thm;
      "hl:TRANS". a:Thm, b:Thm |- "TRANS" a b : KR;
      "hl:trans-k". a1:Tms, s1:SplitEq, a2:Tms, s2:SplitEq |- "trans-k" a1 s1 a2 s2 : KR;
      "hl:trans-k2". o:Ord, a1:Tms, a2:Tms, op:Term, l:Term, r:Term |- "trans-k2" o a1 a2 op l r : KR;
      "hl:MK_COMB". a:Thm, b:Thm |- "MK_COMB" a b : KR;
      "hl:mk-comb-rule-k". a1:Tms, s1:SplitEq, a2:Tms, s2:SplitEq |- "mk-comb-rule-k" a1 s1 a2 s2 : KR;
      "hl:mk-comb-rule-k2". ft:FunTy, a1:Tms, a2:Tms, l1:Term, r1:Term, l2:Term, r2:Term |- "mk-comb-rule-k2" ft a1 a2 l1 r1 l2 r2 : KR;
      "hl:mk-comb-rule-k3". e:Flag, a1:Tms, a2:Tms, l1:Term, r1:Term, l2:Term, r2:Term |- "mk-comb-rule-k3" e a1 a2 l1 r1 l2 r2 : KR;
      "hl:ABS". v:Term, th:Thm |- "ABS" v th : KR;
      "hl:abs-k". s:SplitEq, v:Term, asl:Tms |- "abs-k" s v asl : KR;
      "hl:abs-k2". e:Flag, v:Term, asl:Tms, l:Term, r:Term |- "abs-k2" e v asl l r : KR;
      "hl:BETA". tm:Term |- "BETA" tm : KR;
      "hl:beta-k". e:Flag, tm:Term, bod:Term |- "beta-k" e tm bod : KR;
      "hl:ASSUME". tm:Term |- "ASSUME" tm : KR;
      "hl:assume-k". e:Flag, tm:Term |- "assume-k" e tm : KR;
      "hl:EQ_MP". a:Thm, b:Thm |- "EQ_MP" a b : KR;
      "hl:eq-mp-k". s:SplitEq, a1:Tms, a2:Tms, c:Term |- "eq-mp-k" s a1 a2 c : KR;
      "hl:eq-mp-k2". o:Ord, a1:Tms, a2:Tms, r:Term |- "eq-mp-k2" o a1 a2 r : KR;
      "hl:DEDUCT_ANTISYM_RULE". a:Thm, b:Thm |- "DEDUCT_ANTISYM_RULE" a b : Thm;
      "hl:INST_TYPE". theta:TyPairs, th:Thm |- "INST_TYPE" theta th : Thm;
      "hl:INST". theta:TmPairs, th:Thm |- "INST" theta th : KR;
      "hl:inst-rule-k". e:Flag, theta:TmPairs, asl:Tms, c:Term |- "inst-rule-k" e theta asl c : KR;

      "hl:tc-nil". |- "tc-nil" : TyCons;
      "hl:tc-cons". n:Str, k:Nat, xs:TyCons |- "tc-cons" n k xs : TyCons;
      "hl:cc-nil". |- "cc-nil" : Cons;
      "hl:cc-cons". n:Str, ty:Type, xs:Cons |- "cc-cons" n ty xs : Cons;
      "hl:Theory". tys:TyCons, cons:Cons, axioms:Thms, defs:Thms |- "Theory" tys cons axioms defs : Thy;
      "hl:thy-ok". thy:Thy |- "thy-ok" thy : ThyR;
      "hl:thy-fail". r:Reason |- "thy-fail" r : ThyR;
      "hl:thy-thm". thy:Thy, th:Thm |- "thy-thm" thy th : ThyThmR;
      "hl:thy-thm-fail". r:Reason |- "thy-thm-fail" r : ThyThmR;
      "hl:tydef-ok". thy:Thy, th1:Thm, th2:Thm |- "tydef-ok" thy th1 th2 : TydefR;
      "hl:tydef-fail". r:Reason |- "tydef-fail" r : TydefR;
      "hl:tydef-fail-partial". thy:Thy, r:Reason |- "tydef-fail-partial" thy r : TydefR;
      "hl:initial-theory". |- "initial-theory" : Thy;
      "hl:get-type-arity". xs:TyCons, n:Str |- "get_type_arity" xs n : OptNat;
      "hl:get-type-arity-k". e:Flag, k:Nat, xs:TyCons, n:Str |- "get-type-arity-k" e k xs n : OptNat;
      "hl:get-const-type". xs:Cons, n:Str |- "get_const_type" xs n : OptTy;
      "hl:get-const-type-k". e:Flag, ty:Type, xs:Cons, n:Str |- "get-const-type-k" e ty xs n : OptTy;
      "hl:new-type". thy:Thy, n:Str, k:Nat |- "new_type" thy n k : ThyR;
      "hl:new-type-k". o:OptNat, thy:Thy, n:Str, k:Nat |- "new-type-k" o thy n k : ThyR;
      "hl:new-constant". thy:Thy, n:Str, ty:Type |- "new_constant" thy n ty : ThyR;
      "hl:new-constant-k". o:OptTy, thy:Thy, n:Str, ty:Type |- "new-constant-k" o thy n ty : ThyR;
      "hl:new-axiom". thy:Thy, tm:Term |- "new_axiom" thy tm : ThyThmR;
      "hl:new-axiom-k". e:Flag, thy:Thy, tm:Term |- "new-axiom-k" e thy tm : ThyThmR;
      "hl:new-basic-definition". thy:Thy, tm:Term |- "new_basic_definition" thy tm : ThyThmR;
      "hl:new-def-k". s:SplitEq, thy:Thy |- "new-def-k" s thy : ThyThmR;
      "hl:new-def-k2". e:Flag, thy:Thy, n:Str, ty:Type, r:Term |- "new-def-k2" e thy n ty r : ThyThmR;
      "hl:new-def-k3". e:Flag, thy:Thy, n:Str, ty:Type, r:Term |- "new-def-k3" e thy n ty r : ThyThmR;
      "hl:new-def-k4". o:ThyR, n:Str, ty:Type, r:Term |- "new-def-k4" o n ty r : ThyThmR;
      "hl:new-basic-type-definition". thy:Thy, tyname:Str, absname:Str, repname:Str, th:Thm |- "new_basic_type_definition" thy tyname absname repname th : TydefR;
      "hl:tydef-1". e:Flag, thy:Thy, tyname:Str, absname:Str, repname:Str, asl:Tms, c:Term |- "tydef-1" e thy tyname absname repname asl c : TydefR;
      "hl:tydef-2". thy:Thy, tyname:Str, absname:Str, repname:Str, c:Term |- "tydef-2" thy tyname absname repname c : TydefR;
      "hl:tydef-3". e:Flag, thy:Thy, tyname:Str, absname:Str, repname:Str, p:Term, x:Term |- "tydef-3" e thy tyname absname repname p x : TydefR;
      "hl:tydef-4". o:ThyR, tyname:Str, absname:Str, repname:Str, p:Term, x:Term, tvs:Tys |- "tydef-4" o tyname absname repname p x tvs : TydefR;
      "hl:tydef-5". o:ThyR, thy:Thy, absname:Str, absty:Type, repname:Str, p:Term, aty:Type, rty:Type |- "tydef-5" o thy absname absty repname p aty rty : TydefR;
      "hl:tydef-5b". o:ThyR, thy:Thy, absname:Str, absty:Type, repname:Str, repty:Type, p:Term, aty:Type, rty:Type |- "tydef-5b" o thy absname absty repname repty p aty rty : TydefR;
      "hl:tydef-6". thy:Thy, p:Term, abs:Term, rep:Term, aty:Type, rty:Type |- "tydef-6" thy p abs rep aty rty : TydefR;
      "hl:can-get-const". xs:Cons, n:Str |- "can-get-const" xs n : Flag;
      "hl:can-get-const-k". o:OptTy |- "can-get-const-k" o : Flag;

      -- reasons: fusion.ml's failure messages, then the replay's
      "hl:r-mk-type-undeclared". |- "mk_type: undeclared" : Reason;
      "hl:r-mk-type-arity". |- "mk_type: arity" : Reason;
      "hl:r-mk-const-undeclared". |- "mk_const: not a constant name" : Reason;
      "hl:r-const-not-instance". |- "CONST: not an instance" : Reason;
      "hl:r-mk-abs-not-var". |- "mk_abs: not a variable" : Reason;
      "hl:r-mk-comb-types". |- "mk_comb: types do not agree" : Reason;
      "hl:r-vsubst-bad". |- "vsubst: Bad substitution list" : Reason;
      "hl:r-trans". |- "TRANS" : Reason;
      "hl:r-mk-comb-not-eqs". |- "MK_COMB: not both equations" : Reason;
      "hl:r-mk-comb-rule-types". |- "MK_COMB: types do not agree" : Reason;
      "hl:r-abs". |- "ABS" : Reason;
      "hl:r-beta". |- "BETA: not a trivial beta-redex" : Reason;
      "hl:r-assume". |- "ASSUME: not a proposition" : Reason;
      "hl:r-eq-mp". |- "EQ_MP" : Reason;
      "hl:r-type-exists". |- "new_type: already declared" : Reason;
      "hl:r-const-exists". |- "new_constant: already declared" : Reason;
      "hl:r-axiom-not-bool". |- "new_axiom: Not a proposition" : Reason;
      "hl:r-def-shape". |- "new_basic_definition" : Reason;
      "hl:r-def-already-const". |- "new_basic_definition: already defined" : Reason;
      "hl:r-def-not-closed". |- "new_definition: term not closed" : Reason;
      "hl:r-def-tyvars". |- "new_definition: Type variables not reflected in constant" : Reason;
      "hl:r-tydef-consts". |- "new_basic_type_definition: Constant(s) already in use" : Reason;
      "hl:r-tydef-hyps". |- "new_basic_type_definition: Assumptions in theorem" : Reason;
      "hl:r-tydef-not-comb". |- "new_basic_type_definition: Not a combination" : Reason;
      "hl:r-tydef-not-closed". |- "new_basic_type_definition: Predicate is not closed" : Reason;
      "hl:r-tydef-type-exists". |- "new_basic_type_definition: Type already defined" : Reason;
      "hl:r-axiom-policy". |- "axiom policy" : Reason;
      "hl:r-future-ref". |- "future reference" : Reason;
      "hl:r-dropped-ref". |- "dropped reference" : Reason;
      "hl:r-expect". |- "expectation failed" : Reason;
      "hl:r-bad-value". |- "bad value" : Reason;
      "hl:bad-magic". |- "bad magic" : Reason;
      "hl:bad-version". |- "unsupported version" : Reason;
      "hl:bad-header". |- "bad header" : Reason;
      "hl:truncated". |- "truncated" : Reason;
      "hl:bad-integer". |- "bad integer encoding" : Reason;
      "hl:bad-opcode". |- "unknown opcode" : Reason;
      "hl:trailing-bytes". |- "trailing bytes" : Reason;
      "hl:checksum-mismatch". |- "checksum mismatch" : Reason;
      "hl:count-mismatch". |- "record count mismatch" : Reason;
      "hl:limit-exceeded". |- "limit exceeded" : Reason;
      "hl:missing-end". |- "missing END" : Reason;
      "hl:decoder-out-of-memory". |- "decoder out of memory" : Reason;
      "hl:decoder-other". |- "decoder failure" : Reason;

      -- -------------------------------------------------------------- replay
      "hl:st-refused". |- "REFUSED" : Status;
      "hl:st-policy". |- "POLICY" : Status;
      "hl:open". |- "open" : Policy;
      "hl:standard". |- "standard" : Policy;
      "hl:sealed". |- "sealed" : Policy;
      "hl:strict". |- "strict" : Mode;
      "hl:probe". |- "probe" : Mode;
      "hl:policy-max". a:Policy, b:Policy |- "policy-max" a b : Policy;
      "hl:policy-of-nat". n:Nat |- "policy-of-nat" n : Policy;
      "hl:std". tys:Strs, cons:Strs |- "std" tys cons : Std;
      "hl:sd". n:Str, ty:Type, body:Term |- "sd" n ty body : StdDef;
      "hl:sd-nil". |- "sd-nil" : StdDefs;
      "hl:sd-cons". d:StdDef, ds:StdDefs |- "sd-cons" d ds : StdDefs;
      "hl:initial-std". |- "initial-std" : Std;
      "hl:std-defs". |- "std-defs" : StdDefs;
      "hl:std-def-T". |- "std-def-T" : StdDef;
      "hl:std-def-and". |- "std-def-and" : StdDef;
      "hl:std-def-imp". |- "std-def-imp" : StdDef;
      "hl:std-def-all". |- "std-def-all" : StdDef;
      "hl:std-def-ex". |- "std-def-ex" : StdDef;
      "hl:std-def-F". |- "std-def-F" : StdDef;
