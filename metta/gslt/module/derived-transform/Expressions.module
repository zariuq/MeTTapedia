import "Data.module" as data

Module Expressions {
  Theory Grammar() {
    data.Grammar()
    Types { DCode; DCodes; DCaseRow; DCases; }
    Terms {
      DProgram . a0:SrcTrivia, a1:DCode, a2:SrcTrivia |- a0 a1 a2 : SourceProgram;
      DValue . a0:SrcSpacing, a1:DTerm |- "(value" a0 a1 ")" : DCode;
      DMatch . a0:SrcSpacing, a1:DTerm, a2:SrcSpacing, a3:DTerm, a4:SrcSpacing, a5:DCode |- "(match" a0 a1 a2 a3 a4 a5 ")" : DCode;
      DAdd . a0:SrcSpacing, a1:DTerm, a2:SrcSpacing, a3:DTerm |- "(add-atom" a0 a1 a2 a3 ")" : DCode;
      DRemove . a0:SrcSpacing, a1:DTerm, a2:SrcSpacing, a3:DTerm |- "(remove-atom" a0 a1 a2 a3 ")" : DCode;
      DTransform . a0:SrcSpacing, a1:DTerm, a2:SrcSpacing, a3:DTerm, a4:SrcSpacing, a5:DTerm |- "(transform" a0 a1 a2 a3 a4 a5 ")" : DCode;
      DInto . a0:SrcSpacing, a1:DTerm, a2:SrcSpacing, a3:DTerm, a4:SrcSpacing, a5:DTerm, a6:SrcSpacing, a7:DTerm |- "(transform" a0 a1 a2 a3 a4 a5 a6 a7 ")" : DCode;
      DOnce . a0:SrcSpacing, a1:DCode |- "(once" a0 a1 ")" : DCode;
      DCollapse . a0:SrcSpacing, a1:DCode |- "(collapse" a0 a1 ")" : DCode;
      DChoice . a0:SrcSpacing, a1:DCodes |- "(superpose" a0 "(" a1 "))" : DCode;
      DEmptyChoice . a0:SrcSpacing |- "(superpose" a0 "())" : DCode;
      DLet . a0:SrcSpacing, a1:DTerm, a2:SrcSpacing, a3:DCode, a4:SrcSpacing, a5:DCode |- "(let" a0 a1 a2 a3 a4 a5 ")" : DCode;
      DChain . a0:SrcSpacing, a1:DCode, a2:SrcSpacing, a3:DTerm, a4:SrcSpacing, a5:DCode |- "(chain" a0 a1 a2 a3 a4 a5 ")" : DCode;
      DCount . a0:SrcSpacing, a1:DCode |- "(count" a0 a1 ")" : DCode;
      DFold . a0:SrcSpacing, a1:DTerm, a2:SrcSpacing, a3:DCode, a4:SrcSpacing, a5:DCode |- "(foldall" a0 a1 a2 a3 a4 a5 ")" : DCode;
      DCase . a0:SrcSpacing, a1:DCode, a2:SrcSpacing, a3:DCases |- "(case" a0 a1 a2 "(" a3 "))" : DCode;
      DEmpty .  |- "(empty)" : DCode;
      DCodesOne . a0:DCode |- a0 : DCodes;
      DCodesMore . a0:DCode, a1:SrcSpacing, a2:DCodes |- a0 a1 a2 : DCodes;
      DCaseClause . a0:DTerm, a1:SrcSpacing, a2:DCode |- "(" a0 a1 a2 ")" : DCaseRow;
      DCasesOne . a0:DCaseRow |- a0 : DCases;
      DCasesMore . a0:DCaseRow, a1:SrcSpacing, a2:DCases |- a0 a1 a2 : DCases;
    }
  }
  Theory LexicalProfile() { data.LexicalProfile() }
  theory Grammar()
}
