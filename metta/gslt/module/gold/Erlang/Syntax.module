  Theory Grammar() {
    let s = Sorts(lex.Grammar()) in (Modules(s) \/ Expressions(s) \/ Patterns(s) \/ Literals(s) \/ Comments(s))
  }
  Theory LexicalProfile() { lex.LexicalProfile() }
  theory Grammar()
}
