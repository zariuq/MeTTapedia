Module PrologCommonSyntax {
  Theory Grammar() {
    Types {
      PlSentence;
      PlLayout;
      PlExpr1200;
      PlSpace;
      PlLine;
      PlComment;
      PlCommentScalar;
      PlCommentStar;
      PlCommentAfterStar;
      PlLineScalar;
      PlNameTail;
      PlNameRest;
      PlWord;
      PlLower;
      PlVariableName;
      PlVariableStart;
      PlGraphicWord;
      PlGraphic;
      PlAtom;
      PlSingleBody;
      PlSingleScalar;
      PlEscape;
      PlEscapeScalar;
      PlHexDigits;
      PlOctDigits;
      PlDoubleBody;
      PlDoubleScalar;
      PlDigits;
      PlDigit;
      PlHex;
      PlOct;
      PlBinDigits;
      PlBin;
      PlNumber;
      PlCodeScalar;
      PlExponent;
      PlSignedDigits;
      PlExpr0;
      PlArguments;
      PlExpr999;
    }
    Terms {
      "pl:sentence" . a0:PlLayout, a1:PlExpr1200, a2:PlLayout, a4:PlLayout |- a0 a1 a2 "." a4 : PlSentence;
      "pl:layout-empty" .  |-  : PlLayout;
      "pl:layout-space" . a0:PlSpace, a1:PlLayout |- a0 a1 : PlLayout;
      "pl:layout-line" . a1:PlLine, a3:PlLayout |- "%" a1 "\n" a3 : PlLayout;
      "pl:layout-line-end" . a1:PlLine |- "%" a1 : PlLayout;
      "pl:layout-block" . a1:PlComment, a2:PlLayout |- "/*" a1 a2 : PlLayout;
      "pl:comment-more" . a0:PlCommentScalar, a1:PlComment |- a0 a1 : PlComment;
      "pl:comment-star" . a1:PlCommentStar |- "*" a1 : PlComment;
      "pl:comment-end" .  |- "/" : PlCommentStar;
      "pl:comment-stars" . a1:PlCommentStar |- "*" a1 : PlCommentStar;
      "pl:comment-after-star" . a0:PlCommentAfterStar, a1:PlComment |- a0 a1 : PlCommentStar;
      "pl:line-empty" .  |-  : PlLine;
      "pl:line-more" . a0:PlLineScalar, a1:PlLine |- a0 a1 : PlLine;
      "pl:name-tail-empty" .  |-  : PlNameTail;
      "pl:name-tail-more" . a0:PlNameRest, a1:PlNameTail |- a0 a1 : PlNameTail;
      "pl:word" . a0:PlLower, a1:PlNameTail |- a0 a1 : PlWord;
      "pl:variable-name" . a0:PlVariableStart, a1:PlNameTail |- a0 a1 : PlVariableName;
      "pl:graphic-one" . a0:PlGraphic |- a0 : PlGraphicWord;
      "pl:graphic-more" . a0:PlGraphic, a1:PlGraphicWord |- a0 a1 : PlGraphicWord;
      "pl:atom-word" . a0:PlWord |- a0 : PlAtom;
      "pl:atom-graphic" . a0:PlGraphicWord |- a0 : PlAtom;
      "pl:atom-quoted" . a1:PlSingleBody |- "'" a1 "'" : PlAtom;
      "pl:atom-cut" .  |- "!" : PlAtom;
      "pl:atom-semicolon" .  |- ";" : PlAtom;
      "pl:single-empty" .  |-  : PlSingleBody;
      "pl:single-more" . a0:PlSingleScalar, a1:PlSingleBody |- a0 a1 : PlSingleBody;
      "pl:single-escape" . a1:PlEscape, a2:PlSingleBody |- "\\" a1 a2 : PlSingleBody;
      "pl:escape-named" . a0:PlEscapeScalar |- a0 : PlEscape;
      "pl:escape-hex-code" . a1:PlHexDigits |- "x" a1 "\\" : PlEscape;
      "pl:escape-octal-code" . a0:PlOctDigits |- a0 "\\" : PlEscape;
      "pl:single-double" . a1:PlSingleBody |- "''" a1 : PlSingleBody;
      "pl:double-empty" .  |-  : PlDoubleBody;
      "pl:double-more" . a0:PlDoubleScalar, a1:PlDoubleBody |- a0 a1 : PlDoubleBody;
      "pl:double-escape" . a1:PlEscape, a2:PlDoubleBody |- "\\" a1 a2 : PlDoubleBody;
      "pl:double-double" . a1:PlDoubleBody |- "\"\"" a1 : PlDoubleBody;
      "pl:digits-one" . a0:PlDigit |- a0 : PlDigits;
      "pl:digits-more" . a0:PlDigit, a1:PlDigits |- a0 a1 : PlDigits;
      "pl:hex-one" . a0:PlHex |- a0 : PlHexDigits;
      "pl:hex-more" . a0:PlHex, a1:PlHexDigits |- a0 a1 : PlHexDigits;
      "pl:oct-one" . a0:PlOct |- a0 : PlOctDigits;
      "pl:oct-more" . a0:PlOct, a1:PlOctDigits |- a0 a1 : PlOctDigits;
      "pl:bin-one" . a0:PlBin |- a0 : PlBinDigits;
      "pl:bin-more" . a0:PlBin, a1:PlBinDigits |- a0 a1 : PlBinDigits;
      "pl:integer" . a0:PlDigits |- a0 : PlNumber;
      "pl:hex" . a1:PlHexDigits |- "0x" a1 : PlNumber;
      "pl:oct" . a1:PlOctDigits |- "0o" a1 : PlNumber;
      "pl:bin" . a1:PlBinDigits |- "0b" a1 : PlNumber;
      "pl:character-code" . a1:PlCodeScalar |- "0'" a1 : PlNumber;
      "pl:character-escape" . a1:PlEscape |- "0'\\" a1 : PlNumber;
      "pl:float" . a0:PlDigits, a2:PlDigits |- a0 "." a2 : PlNumber;
      "pl:float-exponent" . a0:PlDigits, a2:PlDigits, a3:PlExponent |- a0 "." a2 a3 : PlNumber;
      "pl:exponent-lower" . a1:PlSignedDigits |- "e" a1 : PlExponent;
      "pl:exponent-upper" . a1:PlSignedDigits |- "E" a1 : PlExponent;
      "pl:exponent-positive" . a1:PlDigits |- "+" a1 : PlSignedDigits;
      "pl:exponent-negative" . a1:PlDigits |- "-" a1 : PlSignedDigits;
      "pl:exponent-unsigned" . a0:PlDigits |- a0 : PlSignedDigits;
      "pl:term-atom" . a0:PlAtom |- a0 : PlExpr0;
      "pl:term-variable" . a0:PlVariableName |- a0 : PlExpr0;
      "pl:term-number" . a0:PlNumber |- a0 : PlExpr0;
      "pl:term-negative" . a1:PlNumber |- "-" a1 : PlExpr0;
      "pl:term-text" . a1:PlDoubleBody |- "\"" a1 "\"" : PlExpr0;
      "pl:term-compound" . a0:PlAtom, a2:PlLayout, a3:PlArguments, a4:PlLayout |- a0 "(" a2 a3 a4 ")" : PlExpr0;
      "pl:term-parens" . a1:PlLayout, a2:PlExpr1200, a3:PlLayout |- "(" a1 a2 a3 ")" : PlExpr0;
      "pl:term-nil" . a1:PlLayout |- "[" a1 "]" : PlExpr0;
      "pl:term-list" . a1:PlLayout, a2:PlArguments, a3:PlLayout |- "[" a1 a2 a3 "]" : PlExpr0;
      "pl:term-list-tail" . a1:PlLayout, a2:PlArguments, a3:PlLayout, a5:PlLayout, a6:PlExpr999, a7:PlLayout |- "[" a1 a2 a3 "|" a5 a6 a7 "]" : PlExpr0;
      "pl:term-braces-empty" . a1:PlLayout |- "{" a1 "}" : PlExpr0;
      "pl:term-braces" . a1:PlLayout, a2:PlExpr1200, a3:PlLayout |- "{" a1 a2 a3 "}" : PlExpr0;
      "pl:arguments-one" . a0:PlExpr999 |- a0 : PlArguments;
      "pl:arguments-more" . a0:PlExpr999, a1:PlLayout, a3:PlLayout, a4:PlArguments |- a0 a1 "," a3 a4 : PlArguments;
    }
  }
  theory Grammar()
}
