; Haskell-compatible string effects over an independently started MM0 session.
; Source obligations and proof steps remain ordered. Only completed accepted
; theory data is interpreted; outputs are returned together after every effect
; succeeds. Decoder fuel exhaustion is separate from an effect refusal.
!(import! &self str)

(: mm0:string-io:matched (-> Atom Atom %Undefined%))
(= (mm0:string-io:matched $value $value) MM0:StringIOMatched)
(: mm0:string-io:same (-> Atom Atom %Undefined%))
(= (mm0:string-io:same $first $second)
   (case (collapse (mm0:string-io:matched (quote $first) (quote $second)))
     (((MM0:StringIOMatched) True) ($bad False))))

(: mm0:string-io:logical-row (-> Atom %Undefined%))
(= (mm0:string-io:logical-row $row)
   (case $row
     (((MM0DeclaredSortV1 $position $name $flags)
       (Some (MM0:StringLogical $position MM0:MMUSort $name 0)))
      ((MM0DeclaredTermV1 $position $name $signature)
       (Some (MM0:StringLogical $position MM0:MMUTerm $name 1)))
      ((MM0DeclaredDefinitionV1 $position $name $signature $dummies $body)
       (Some (MM0:StringLogical $position MM0:MMUDefinition $name 1)))
      ((MM0DeclaredAssertionV1 $position MM0AxiomDeclarationV1 $name $signature)
       (Some (MM0:StringLogical $position MM0:MMUAxiom $name 0)))
      ((MM0DeclaredAssertionV1 $position MM0TheoremDeclarationV1 $name $signature)
       (Some (MM0:StringLogical $position MM0:MMUTheorem $name 0)))
      ($other None))))
(: mm0:string-io:notation-position (-> Atom %Undefined%))
(= (mm0:string-io:notation-position $row)
   (case $row
     (((MM0DeclaredDelimitersV1 $position $kind) (mm0:text:index $position))
      ((MM0DeclaredSimpleNotationV1 $position $name $kind $token) (mm0:text:index $position))
      ((MM0DeclaredGeneralNotationV1 $position $name $token $pattern) (mm0:text:index $position))
      ((MM0DeclaredCoercionV1 $position $name $from $to) (mm0:text:index $position))
      ($other None))))

; Weave the retained history into the independently projected public slots.
; Mathematical notation does not consume a proof declaration, while each I/O
; row consumes its own proof step and does not change any logical namespace.
(: mm0:string-io:obligations (-> Atom Atom Atom Number Number %Undefined%))
(= (mm0:string-io:obligations $public $declarations $history $position $termLimit)
   (case $history
     ((MM0SourceHistoryNilV1
       (case (mm0:list-view $public)
         ((List:Nil (Some (MM0:L ()))) ($bad None))))
      ((MM0SourceHistoryConsV1 $row $rest)
       (case $row
         (((MM0StringDirectiveV1 $stamp $direction $expression MM0HaskellStringProfileV1)
           (if (is-member $direction (MM0StringInputV1 MM0StringOutputV1))
             (case (mm0:text:index $stamp)
               (((Some $index)
                 (if (== $index $position)
                   (let* (($value (mm0:text:expression $declarations $termLimit nil $expression))
                          ($tail (mm0:string-io:obligations $public $declarations $rest (+ $position 1) $termLimit)))
                     (case ($value $tail)
                       ((((Some $encoded) (Some $after))
                         (let $entry (MM0:StringPublic $position $direction $encoded MM0HaskellStringProfileV1)
                           (Some (mm0:list-cons $entry $after))))
                        ($bad None))))
                   None))
                ($bad None)))
             None))
          ($other
           (case (mm0:string-io:logical-row $other)
             (((Some (MM0:StringLogical $stamp $kind $rawName $termIncrement))
               (let* (($index (mm0:text:index $stamp))
                      ($name (mm0:mmu:source-name $rawName)))
                 (case ($index $name (mm0:list-view $public))
                   ((((Some $sourcePosition) (Some $text)
                      (List:Cons (MM0:MMUPublic $wanted $expected $id $specification) $remaining))
                     (if (and (== $sourcePosition $position)
                           (and (== $text $wanted) (== $kind $expected)))
                       (case (mm0:string-io:obligations $remaining $declarations $rest
                               (+ $position 1) (+ $termLimit $termIncrement))
                         (((Some $after)
                           (Some (mm0:list-cons (MM0:MMUPublic $wanted $expected $id $specification) $after)))
                          ($bad None)))
                       None))
                    ($bad None)))))
              (None
               (case (mm0:string-io:notation-position $other)
                 (((Some $sourcePosition)
                   (if (== $sourcePosition $position)
                     (mm0:string-io:obligations $public $declarations $rest (+ $position 1) $termLimit)
                     None))
                  ($bad None))))
              ($bad None)))))))
      ($bad None))))
(: mm0:string-io:prepare (-> Atom %Undefined%))
(= (mm0:string-io:prepare
     (MM0:NativeSpecification $path $specification $public
       (MM0:IncludedEnvironment $file $digest $ast
         (MM0SourceStateV1 (MM0TextualEnvironmentV1 $sorts $declarations) $notation)
         $history $provenance)))
   (mm0:string-io:obligations $public $declarations $history 0 0))
(: mm0:string-io:has-obligations (-> Atom %Undefined%))
(= (mm0:string-io:has-obligations $history)
   (case $history
     ((MM0SourceHistoryNilV1 False)
      ((MM0SourceHistoryConsV1 $first $rest)
       (case $first
         (((MM0StringDirectiveV1 $position $direction $expression $profile) True)
          ($other (mm0:string-io:has-obligations $rest)))))
      ($bad True))))
(: mm0:string-io:source-has-obligations (-> Atom %Undefined%))
(= (mm0:string-io:source-has-obligations $source)
   (case $source
     (((MM0:IncludedEnvironment $file $digest $ast $state $history $provenance)
       (mm0:string-io:has-obligations $history))
      ($bad True))))

; Existing maxima reserve all public IDs before local proof declarations.
; The augmented pending list is used only by this explicit profile.
(: mm0:string-io:state (-> Atom Atom %Undefined%))
(= (mm0:string-io:state $public $obligations)
   (case (mm0:mmu:state $public)
     (((MM0:MMUState $pending $sorts $terms $theorems $ns $nt $nh $images)
       (MM0:MMUState $obligations $sorts $terms $theorems $ns $nt $nh $images))
      ($bad MM0:Malformed))))
(: mm0:string-io:resolve-file (-> Atom Atom %Undefined%))
(= (mm0:string-io:resolve-file
     (MM0:NativeSpecification $path $specification $public $source) $proofPath)
   (let* (($obligations (mm0:string-io:prepare (MM0:NativeSpecification $path $specification $public $source)))
          ($parsed (mm0:mmu:read-file $proofPath)))
     (case ($obligations $parsed)
       ((((Some $ordered) (Some (MM0:MMUSource $text $forms $lexemes)))
         (let $state (mm0:string-io:state $public $ordered)
           (mm0:string-io:resolve-forms $state $forms (MM0:L ()) (MM0:L ())
             (MM0:MMUSource $text $forms $lexemes))))
        ($bad None)))))
(: mm0:string-io:resolve-forms (-> Atom Atom Atom Atom Atom %Undefined%))
(= (mm0:string-io:resolve-forms $state (MM0:L $forms) (MM0:L $commands) (MM0:L $effects) $source)
   (case $forms
     ((()
       (case $state
         (((MM0:MMUState (MM0:L ()) $sorts $terms $theorems $ns $nt $nh $images)
           (let* (($ordered (reverse $commands)) ($recorded (reverse $effects)))
             (Some (MM0:MMUProgram MM0:MMUHaskellString $state (MM0:L $ordered) (MM0:L $recorded) $source))))
          ($bad None))))
      ((cons ("input" "string") $rest)
       (mm0:string-io:resolve-effect $state MM0StringInputV1 (MM0:L $rest) (MM0:L $commands) (MM0:L $effects) $source))
      ((cons ("output" "string") $rest)
       (mm0:string-io:resolve-effect $state MM0StringOutputV1 (MM0:L $rest) (MM0:L $commands) (MM0:L $effects) $source))
      ((cons $first $rest)
       (case (mm0:mmu:resolve-declaration $state $first)
         (((Some (MM0:MMUResolved $after $command))
           (let $next (cons $command $commands)
             (mm0:string-io:resolve-forms $after (MM0:L $rest) (MM0:L $next) (MM0:L $effects) $source)))
          ($bad None))))
      ($bad None))))
(: mm0:string-io:resolve-effect (-> Atom Atom Atom Atom Atom Atom %Undefined%))
(= (mm0:string-io:resolve-effect
     (MM0:MMUState $pending $sorts $terms $theorems $ns $nt $nh $images)
     $direction $rest $commands (MM0:L $effects) $source)
   (case (mm0:list-view $pending)
     (((List:Cons (MM0:StringPublic $position $wanted $expression MM0HaskellStringProfileV1) $remaining)
       (if (== $direction $wanted)
         (case (mm0:mmu:lookup $sorts "string")
           (((Some $sort)
             (let* (($next (MM0:MMUState $remaining $sorts $terms $theorems $ns $nt $nh $images))
                    ($entry (MM0:StringIOEvidence
                      (MM0:StringPublic $position $wanted $expression MM0HaskellStringProfileV1)
                      $sort $sorts $terms))
                    ($recorded (cons $entry $effects)))
               (mm0:string-io:resolve-forms $next $rest $commands (MM0:L $recorded) $source)))
            ($bad None)))
         None))
      ($bad None))))

(: mm0:string-io:root-bytes (-> Atom %Undefined%))
(= (mm0:string-io:root-bytes $prepared)
   (case $prepared
     (((MM0:NativeSpecification $path $specification $public
        (MM0:IncludedEnvironment $file $grammarDigest $ast $state $history
          (MM0:IncludeProvenance $files $edges)))
       (if (< 0 (size-atom $files))
         (case (index-atom $files (- (size-atom $files) 1))
           (((MM0:IncludeFile $root $bytes $digest)
             (if (and (== $path $file) (and (== $file $root) (== (str:sha256 $bytes) $digest)))
               (Some (MM0:StringRootBytes $root $bytes $digest)) None))
            ($bad None)))
         None))
      ($bad None))))
(: mm0:string-io:scope-has-id (-> Atom Number %Undefined%))
(= (mm0:string-io:scope-has-id (MM0:L $bindings) $id)
   (case $bindings
     ((() False)
      ((cons (MM0:MMUBinding $name $index) $rest)
       (if (== $index $id) True (mm0:string-io:scope-has-id (MM0:L $rest) $id)))
      ($bad False))))
(: mm0:string-io:source-term-name (-> Atom Number %Undefined%))
(= (mm0:string-io:source-term-name (MM0:L $public) $id)
   (case $public
     ((() None)
      ((cons (MM0:MMUPublic $name $kind $index $specification) $rest)
       (if (and (== $kind MM0:MMUTerm) (== $index $id))
         (Some $name) (mm0:string-io:source-term-name (MM0:L $rest) $id)))
      ($bad None))))

; Only primitive names independently declared by the source are recognized.
; Resolve the sorts and exact signatures of encountered primitives only.
(: mm0:string-io:sort-indices (-> Atom Atom %Undefined%))
(= (mm0:string-io:sort-indices $sorts $names)
   (case $names
     ((() (Some (MM0:L ())))
      ((cons $name $rest)
       (let* (($first (mm0:mmu:lookup $sorts $name))
              ($tail (mm0:string-io:sort-indices $sorts $rest)))
         (case ($first $tail)
           ((((Some $index) (Some $after)) (Some (mm0:list-cons $index $after)))
            ($bad None)))))
      ($bad None))))
(: mm0:string-io:primitive-shape (-> Atom Atom Atom Atom %Undefined%))
(= (mm0:string-io:primitive-shape $sorts $names $result $tag)
   (let* (($args (mm0:string-io:sort-indices $sorts $names))
          ($sort (mm0:mmu:lookup $sorts $result)))
     (case ($args $sort)
       ((((Some $indices) (Some $index)) (Some (MM0:StringPrimitive $tag $indices $index)))
        ($bad None)))))
(: mm0:string-io:primitive (-> Atom Atom Number %Undefined%))
(= (mm0:string-io:primitive $public $sorts $id)
   (case (mm0:string-io:source-term-name $public $id)
     (((Some $name)
       (case $name
         (("s0" (mm0:string-io:primitive-shape $sorts () "string" MM0:StringEmptyPrimitive))
          ("s1" (mm0:string-io:primitive-shape $sorts ("char") "string" MM0:StringSingletonPrimitive))
          ("sadd" (mm0:string-io:primitive-shape $sorts ("string" "string") "string" MM0:StringAppendPrimitive))
          ("ch" (mm0:string-io:primitive-shape $sorts ("hex" "hex") "char" MM0:StringCharPrimitive))
          ($other
           (if (is-member $other ("x0" "x1" "x2" "x3" "x4" "x5" "x6" "x7"
                                  "x8" "x9" "xa" "xb" "xc" "xd" "xe" "xf"))
             (let* (($digit (str:byte-slice $other 1 2))
                    ($value (str:find "0123456789abcdef" $digit)))
               (mm0:string-io:primitive-shape $sorts () "hex" (MM0:StringHexPrimitive $value)))
             None)))))
      ($bad None))))
(: mm0:string-io:primitive-binders (-> Atom Atom %Undefined%))
(= (mm0:string-io:primitive-binders $formal $expected)
   (case ((mm0:list-view $formal) (mm0:list-view $expected))
     (((List:Nil List:Nil) True)
      (((List:Cons (MM0:L (MM0:Regular $sort $dependencies)) $rest)
        (List:Cons $wanted $tail))
       (case (mm0:list-view $dependencies)
         ((List:Nil
           (and (== $sort $wanted) (mm0:string-io:primitive-binders $rest $tail)))
          ($bad False))))
      ($bad False))))
(: mm0:string-io:primitive-signature (-> Atom Atom Number %Undefined%))
(= (mm0:string-io:primitive-signature $declaration $arguments $result)
   (case $declaration
     (((MM0:L (MM0:TermDecl $formal $sort $dependencies))
       (case (mm0:list-view $dependencies)
         ((List:Nil (and (== $sort $result) (mm0:string-io:primitive-binders $formal $arguments)))
          ($bad False))))
      ($bad False))))
(: mm0:string-io:propagate (-> Atom %Undefined%))
(= (mm0:string-io:propagate $result)
   (case $result
     (((MM0:StringIOExhausted $remaining) $result)
      ((MM0:StringIORefused $reason) $result)
      ($bad (MM0:StringIORefused MM0:StringValueKind)))))

; The only unfolding authority is the accepted definition table and the
; existing checked MM0 unfold/substitution operation, with empty dummy images.
(: mm0:string-io:decode (-> Atom Atom Atom Atom Number Atom %Undefined%))
(= (mm0:string-io:decode $theory $public $sorts $terms $fuel $expression)
   (mm0:string-io:decode-spine $theory $public $sorts $terms $fuel $expression (MM0:L ())))
(: mm0:string-io:decode-spine (-> Atom Atom Atom Atom Number Atom Atom %Undefined%))
(= (mm0:string-io:decode-spine $theory $public $sorts $terms $fuel $expression $arguments)
   (if (<= $fuel 0) (MM0:StringIOExhausted $fuel)
     (case $expression
       (((MM0:App $function $argument)
         (let $next (mm0:list-cons $argument $arguments)
           (mm0:string-io:decode-spine $theory $public $sorts $terms (- $fuel 1) $function $next)))
        ((MM0:Term $id)
         (if (mm0:string-io:scope-has-id $terms $id)
           (mm0:string-io:decode-term $theory $public $sorts $terms (- $fuel 1) $id $arguments)
           (MM0:StringIORefused (MM0:StringTermNotPreceding $id))))
        ((MM0:Var $index) (MM0:StringIORefused (MM0:StringFreeVariable $index)))
        ($bad (MM0:StringIORefused MM0:StringExpressionMalformed))))))
(: mm0:string-io:decode-term (-> Atom Atom Atom Atom Number Number Atom %Undefined%))
(= (mm0:string-io:decode-term
     (MM0:L (MM0:Theory $sortTable $termTable $definitionTable $theoremTable))
     $public $sorts $terms $fuel $id $arguments)
   (case (mm0:nat-table-get $definitionTable $id)
     (((Some (MM0:L (MM0:Definition $dummies $body)))
       (case (mm0:list-view $dummies)
         ((List:Nil
           (case (mm0:unfold $termTable $definitionTable (MM0:L ()) $id $arguments (MM0:L ()))
             (((Some $expression)
               (mm0:string-io:decode
                 (MM0:L (MM0:Theory $sortTable $termTable $definitionTable $theoremTable))
                 $public $sorts $terms $fuel $expression))
              ($bad (MM0:StringIORefused (MM0:StringDefinitionArguments $id))))))
          ($bad (MM0:StringIORefused (MM0:StringDefinitionDummies $id))))))
      (None
       (let* (($primitive (mm0:string-io:primitive $public $sorts $id))
              ($declaration (mm0:declaration $termTable $id)))
         (case ($primitive $declaration)
           ((((Some (MM0:StringPrimitive $tag $argumentSorts $resultSort))
              (Some (MM0:L (MM0:TermDecl $formal $sort $dependencies))))
             (if (mm0:string-io:primitive-signature
                   (MM0:L (MM0:TermDecl $formal $sort $dependencies)) $argumentSorts $resultSort)
               (if (mm0:check-arguments $termTable (MM0:L ()) $arguments $formal)
                 (mm0:string-io:decode-primitive
                   (MM0:L (MM0:Theory $sortTable $termTable $definitionTable $theoremTable))
                   $public $sorts $terms $fuel $tag $arguments)
                 (MM0:StringIORefused (MM0:StringPrimitiveArguments $id)))
               (MM0:StringIORefused (MM0:StringPrimitiveSignature $id))))
            ($bad (MM0:StringIORefused (MM0:StringUnsupportedPrimitive $id)))))))
      ($bad (MM0:StringIORefused (MM0:StringDefinitionMalformed $id))))))

; String concatenation constructs a rope. Materialization makes one native
; join after every ordered obligation has passed, avoiding prefix recopying.
(: mm0:string-io:decode-primitive (-> Atom Atom Atom Atom Number Atom Atom %Undefined%))
(= (mm0:string-io:decode-primitive $theory $public $sorts $terms $fuel $tag (MM0:L $arguments))
   (case ($tag $arguments)
     ((((MM0:StringHexPrimitive $value) ()) (MM0:StringIODecodedHex $value $fuel))
      ((MM0:StringEmptyPrimitive ()) (MM0:StringIODecodedString MM0:StringRopeEmpty $fuel))
      ((MM0:StringSingletonPrimitive ($argument))
       (case (mm0:string-io:decode $theory $public $sorts $terms $fuel $argument)
         (((MM0:StringIODecodedChar $byte $remaining)
           (MM0:StringIODecodedString (MM0:StringRopeLeaf $byte) $remaining))
          ($bad (mm0:string-io:propagate $bad)))))
      ((MM0:StringCharPrimitive ($first $second))
       (case (mm0:string-io:decode $theory $public $sorts $terms $fuel $first)
         (((MM0:StringIODecodedHex $high $remaining)
           (case (mm0:string-io:decode $theory $public $sorts $terms $remaining $second)
             (((MM0:StringIODecodedHex $low $after)
               (case (mm0:mmb:byte-string (+ (* 16 $high) $low))
                 (((Some $byte) (MM0:StringIODecodedChar $byte $after))
                  ($bad (MM0:StringIORefused MM0:StringByteMalformed)))))
              ($bad (mm0:string-io:propagate $bad)))))
          ($bad (mm0:string-io:propagate $bad)))))
      ((MM0:StringAppendPrimitive ($first $second))
       (case (mm0:string-io:decode $theory $public $sorts $terms $fuel $first)
         (((MM0:StringIODecodedString $left $remaining)
           (case (mm0:string-io:decode $theory $public $sorts $terms $remaining $second)
             (((MM0:StringIODecodedString $right $after)
               (MM0:StringIODecodedString (MM0:StringRopeAppend $left $right) $after))
              ($bad (mm0:string-io:propagate $bad)))))
          ($bad (mm0:string-io:propagate $bad)))))
      ($bad (MM0:StringIORefused MM0:StringPrimitiveArity)))))
(: mm0:string-io:rope-chunks (-> Atom Atom %Undefined%))
(= (mm0:string-io:rope-chunks $rope $tail)
   (case $rope
     ((MM0:StringRopeEmpty (Some $tail))
      ((MM0:StringRopeLeaf $byte)
       (if (== (str:byte-length $byte) 1)
         (let $chunks (cons-atom $byte $tail) (Some $chunks)) None))
      ((MM0:StringRopeAppend $first $second)
       (case (mm0:string-io:rope-chunks $second $tail)
         (((Some $after) (mm0:string-io:rope-chunks $first $after)) ($bad None))))
      ($bad None))))
(: mm0:string-io:rope-bytes (-> Atom %Undefined%))
(= (mm0:string-io:rope-bytes $rope)
   (case (mm0:string-io:rope-chunks $rope ())
     (((Some $chunks)
       (case (str:join "" $chunks)
         (((Error $source $reason) None) ($bytes (Some $bytes)))))
      ($bad None))))
(: mm0:string-io:input-rope (-> Atom Atom Number %Undefined%))
(= (mm0:string-io:input-rope $rope $bytes $position)
   (case $rope
     ((MM0:StringRopeEmpty (Some $position))
      ((MM0:StringRopeLeaf $byte)
       (if (and (== (str:byte-length $byte) 1) (< $position (str:byte-length $bytes)))
         (if (== $byte (str:byte-slice $bytes $position (+ $position 1)))
           (Some (+ $position 1)) (MM0:StringIORefused (MM0:StringInputMismatch $position)))
         (MM0:StringIORefused (MM0:StringInputMismatch $position))))
      ((MM0:StringRopeAppend $first $second)
       (case (mm0:string-io:input-rope $first $bytes $position)
         (((Some $after) (mm0:string-io:input-rope $second $bytes $after))
          ($bad $bad))))
      ($bad (MM0:StringIORefused MM0:StringRopeMalformed)))))

(: mm0:string-io:only-effects (-> Atom %Undefined%))
(= (mm0:string-io:only-effects (MM0:L $entries))
   (case $entries
     ((() (Some (MM0:L ())))
      ((cons $first $rest)
       (case (mm0:string-io:only-effects (MM0:L $rest))
         (((Some $tail)
           (case $first
             (((MM0:StringPublic $position $direction $expression MM0HaskellStringProfileV1)
               (Some (mm0:list-cons $first $tail)))
              ((MM0:MMUPublic $name $kind $id $specification) (Some $tail))
              ($bad None))))
          ($bad None))))
      ($bad None))))
(: mm0:string-io:output-bytes (-> Atom %Undefined%))
(= (mm0:string-io:output-bytes (MM0:L $outputs))
   (case $outputs
     ((() (Some (MM0:L ())))
      ((cons (MM0:StringPendingOutput $position $rope) $rest)
       (let* (($first (mm0:string-io:rope-bytes $rope))
              ($tail (mm0:string-io:output-bytes (MM0:L $rest))))
         (case ($first $tail)
           ((((Some $bytes) (Some $after))
             (let $digest (str:sha256 $bytes)
               (Some (mm0:list-cons (MM0:StringOutput $position $bytes $digest) $after))))
            ($bad None)))))
      ($bad None))))
(: mm0:string-io:effect-type (-> Atom Atom Number %Undefined%))
(= (mm0:string-io:effect-type $terms $expression $sort)
   (case (mm0:infer $terms (MM0:L ()) $expression)
     (((MM0:Inferred $arguments $actual)
       (case (mm0:list-view $arguments)
         ((List:Nil (== $sort $actual)) ($bad False))))
      ($bad False))))
(: mm0:string-io:effects (-> Atom Atom Atom Atom Atom Atom Atom Number %Undefined%))
(= (mm0:string-io:effects $theory $public
     (MM0:StringRootBytes $path $bytes $digest)
     (MM0:L $expected) (MM0:L $evidence) (MM0:L $outputs) (MM0:L $inputs) $fuel)
   (case ($expected $evidence)
     (((() ())
       (let* (($ordered (reverse $outputs))
              ($inputOrder (reverse $inputs))
              ($materialized (mm0:string-io:output-bytes (MM0:L $ordered))))
         (case $materialized
           (((Some $finished)
             (MM0:StringIOAccepted
               (MM0:StringEffectsReceipt MM0HaskellStringProfileV1
                 (MM0:StringRootBytes $path $bytes $digest) $finished (MM0:L $inputOrder) $fuel)))
            ($bad (MM0:StringIORefused MM0:StringOutputMalformed))))))
      (((cons (MM0:StringPublic $position $direction $expression MM0HaskellStringProfileV1) $restExpected)
        (cons (MM0:StringIOEvidence $actual $sort $sorts $terms) $restEvidence))
       (if (mm0:string-io:same $actual
             (MM0:StringPublic $position $direction $expression MM0HaskellStringProfileV1))
         (case $theory
           (((MM0:L (MM0:Theory $sortTable $termTable $defs $theorems))
             (if (mm0:string-io:effect-type $termTable $expression $sort)
               (case (mm0:string-io:decode $theory $public $sorts $terms $fuel $expression)
                 (((MM0:StringIODecodedString $rope $remaining)
                   (case $direction
                     ((MM0StringInputV1
                       (case (mm0:string-io:input-rope $rope $bytes 0)
                         (((Some $end)
                           (if (== $end (str:byte-length $bytes))
                             (let $next (cons (MM0:StringInputReceipt $position $digest $end) $inputs)
                               (mm0:string-io:effects $theory $public
                                 (MM0:StringRootBytes $path $bytes $digest)
                                 (MM0:L $restExpected) (MM0:L $restEvidence)
                                 (MM0:L $outputs) (MM0:L $next) $remaining))
                             (MM0:StringIORefused (MM0:StringInputMismatch $end))))
                          ($bad (mm0:string-io:propagate $bad)))))
                      (MM0StringOutputV1
                       (let $next (cons (MM0:StringPendingOutput $position $rope) $outputs)
                         (mm0:string-io:effects $theory $public
                           (MM0:StringRootBytes $path $bytes $digest)
                           (MM0:L $restExpected) (MM0:L $restEvidence)
                           (MM0:L $next) (MM0:L $inputs) $remaining)))
                      ($bad (MM0:StringIORefused MM0:StringDirectionMalformed)))))
                  ($bad (mm0:string-io:propagate $bad))))
               (MM0:StringIORefused (MM0:StringExpressionType $position))))
            ($bad (MM0:StringIORefused MM0:StringTheoryMalformed))))
         (MM0:StringIORefused (MM0:StringEvidenceMismatch $position))))
      ($bad (MM0:StringIORefused MM0:StringEvidenceCount)))))

; A resolver result supplies names and steps; it does not authorize a theory.
; Obtain the completed theory from the same session that accepted every
; retained command and matched the independent logical specification.
(: mm0:string-io:finish (-> Atom Number %Undefined%))
(= (mm0:string-io:finish $receipt $fuel)
   (case $receipt
     (((MM0:NativeReceipt MM0:MMUHaskellString True True True True
        (MM0:NativeSpecification $path $specification $public $source)
        (MM0:MMUProgram MM0:MMUHaskellString $state $commands $extensions $proofSource))
       (let* (($prepared (MM0:NativeSpecification $path $specification $public $source))
              ($session (get-state mm0-session))
              ($theory (mm0:spec-finish $session))
              ($root (mm0:string-io:root-bytes $prepared))
              ($obligations (mm0:string-io:prepare $prepared)))
         (case ($theory $root $obligations)
           ((((Some $accepted) (Some $bytes) (Some $all))
             (case (mm0:string-io:only-effects $all)
               (((Some $effects)
                 (mm0:string-io:effects $accepted $public $bytes $effects $extensions
                   (MM0:L ()) (MM0:L ()) $fuel))
                ($bad (MM0:StringIORefused MM0:StringSourceObligations)))))
            ($bad (MM0:StringIORefused MM0:StringAcceptedSessionMissing))))))
      ($bad (MM0:StringIORefused MM0:StringKernelNotAccepted)))))
(: mm0:string-io:verdict (-> Atom %Undefined%))
(= (mm0:string-io:verdict $result)
   (case $result
     (((MM0:StringIOAccepted $receipt) True)
      ((MM0:StringIORefused $reason) False)
      ((MM0:StringIOExhausted $remaining) (MM0:StringIOExhausted $remaining))
      ($bad (MM0:UnexpectedStringIOResult $bad)))))
(: mm0:string-io:outputs (-> Atom %Undefined%))
(= (mm0:string-io:outputs $result)
   (case $result
     (((MM0:StringIOAccepted
        (MM0:StringEffectsReceipt MM0HaskellStringProfileV1 $root $outputs $inputs $fuel))
       (Some $outputs))
      ($bad None))))
