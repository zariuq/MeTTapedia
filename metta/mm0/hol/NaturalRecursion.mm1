def holRecursor (A: type) (a f: term) =
  $ (\ number: holNatural. ((sel A) @ (\ value: A. holRecursionGraph A a f number value))) $;

pub theorem holRecursorT (G: wff) (A: type) (a f: term)
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $):
  $ G |- holRecursor A a f: (holNatural -> A) $ =
'(!! lamT number (appT selT (!! lamT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr))));

theorem holRecursorBeta (G: wff) (A: type) (a f n: term)
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $)
  (hn: $ G |- n: holNatural $):
  $ G |- (=[A] (holRecursor A a f @ n) = ((sel A) @ (\ value: A. holRecursionGraph A a f n value))) $ =
'(trans (aeq1 (!! cbv number argument45 (appT selT (!! lamT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl
  hf)) (anwl anr) anr))) (appT selT (!! lamT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr)
  anr))) (aeq (refl selT) (!! leq value (holRecursionGraphCong (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) (refl
  anr))))) hn) (!! betac argument45 (appT selT (!! lamT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf))
  (anwl anr) anr))) hn (appT selT (!! lamT value (holRecursionGraphT (anwl ha) (anwl hf) (anwl hn) anr))) (aeq (refl
  selT) (!! leq value (holRecursionGraphCong (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) (refl anr))))));

pub theorem holRecursorGraph (G: wff) (A: type) (a f n: term)
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $)
  (hn: $ G |- n: holNatural $):
  $ G |- holRecursionGraph A a f n (holRecursor A a f @ n) $ =
'(eqmp (holRecursionGraphCong ha hf (refl hn) (sym (holRecursorBeta ha hf hn))) (eqmp (trans (aeq1 (!! cbv value
  argument46 (holRecursionGraphT (anwl ha) (anwl hf) (anwl hn) anr) (holRecursionGraphT (anwl ha) (anwl hf) (anwl
  hn) anr) (holRecursionGraphCong (anwl ha) (anwl hf) (refl (anwl hn)) anr)) (appT selT (!! lamT value
  (holRecursionGraphT (anwl ha) (anwl hf) (anwl hn) anr)))) (!! betac argument46 (holRecursionGraphT (anwl ha) (anwl
  hf) (anwl hn) anr) (appT selT (!! lamT value (holRecursionGraphT (anwl ha) (anwl hf) (anwl hn) anr)))
  (holRecursionGraphT ha hf hn (appT selT (!! lamT value (holRecursionGraphT (anwl ha) (anwl hf) (anwl hn) anr))))
  (holRecursionGraphCong (anwl ha) (anwl hf) (refl (anwl hn)) anr))) (selectFromEx (!! lamT value
  (holRecursionGraphT (anwl ha) (anwl hf) (anwl hn) anr)) (holRecursionGraphExists ha hf hn))));

pub theorem holRecursorZero (G: wff) (A: type) (a f: term)
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $):
  $ G |- (=[A] (holRecursor A a f @ holZero) = a) $ =
'(holRecursionGraphZeroUnique ha hf (appT (holRecursorT ha hf) holZeroT) (holRecursorGraph ha hf holZeroT));

pub theorem holRecursorSuccessor (G: wff) (A: type) (a f n: term)
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $)
  (hn: $ G |- n: holNatural $):
  $ G |- (=[A] (holRecursor A a f @ (holSuccessor @ n)) = ((f @ (holRecursor A a f @ n)) @ n)) $ =
'(holRecursionGraphFunctional ha hf (appT holSuccessorT hn) (appT (holRecursorT ha hf) (appT holSuccessorT hn))
  (appT (appT hf (appT (holRecursorT ha hf) hn)) hn) (holRecursorGraph ha hf (appT holSuccessorT hn))
  (holRecursionGraphSuccessor ha hf hn (appT (holRecursorT ha hf) hn) (holRecursorGraph ha hf hn)));

pub theorem holNaturalRecursion (G: wff) (A: type) {a f g n: term}:
  $ G |- (! a: A. (! f: (A -> (holNatural -> A)). (? g: (holNatural -> A). ((=[A] (g @ holZero) = a) /\ (! n: holNatural. (=[A] (g @ (holSuccessor @ n)) = ((f @ (g @ n)) @ n))))))) $ =
'(!! GEN a (!! GEN f (eqmpr (aeq2 exT (!! cbv g witness47 (andcT (eqcT (appT anr holZeroT) (anwl (anwl anr))) (!!
  allcT n (eqcT (appT (anwl anr) (appT holSuccessorT anr)) (appT (appT (anwl (anwl anr)) (appT (anwl anr) anr))
  anr)))) (andcT (eqcT (appT anr holZeroT) (anwl (anwl anr))) (!! allcT n (eqcT (appT (anwl anr) (appT holSuccessorT
  anr)) (appT (appT (anwl (anwl anr)) (appT (anwl anr) anr)) anr)))) (bineq andT (bineq eqT (aeq anr (refl
  holZeroT)) (refl (anwl (anwl anr)))) (!! alleq n (bineq eqT (aeq (anwl anr) (refl (appT holSuccessorT anr))) (aeq
  (aeq (refl (anwl (anwl anr))) (aeq (anwl anr) (refl anr))) (refl anr))))))) (!! EXISTS witness47 (andcT (eqcT
  (appT anr holZeroT) (anwl (anwl anr))) (!! allcT n (eqcT (appT (anwl anr) (appT holSuccessorT anr)) (appT (appT
  (anwl (anwl anr)) (appT (anwl anr) anr)) anr)))) (holRecursorT (anwl anr) anr) (bineq andT (bineq eqT (aeq anr
  (refl holZeroT)) (refl (anwl (anwl anr)))) (!! alleq n (bineq eqT (aeq (anwl anr) (refl (appT holSuccessorT anr)))
  (aeq (aeq (refl (anwl (anwl anr))) (aeq (anwl anr) (refl anr))) (refl anr))))) (CONJ (holRecursorZero (anwl anr)
  anr) (!! GEN n (holRecursorSuccessor (anwl (anwl anr)) (anwl anr) anr)))))));
