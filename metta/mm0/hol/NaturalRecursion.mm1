import "NaturalType.mm1";

-- The least binary recursion graph uses result-first primitive-recursion methods.
-- Every result below is derived from the existing HOL rules and natural subtype.
def holRecursionGraph (A: type) (a f n v: term) =
  $ !r: holNatural -> A -> bool. r @ holZero @ a ==>
    (!k: holNatural. !w: A. r @ k @ w ==>
      r @ (holSuccessor @ k) @ (f @ w @ k)) ==> r @ n @ v $;

theorem holRecursionGraphT (G: wff) (A: type) (a f n v: term)
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $)
  (hn: $ G |- n: holNatural $)
  (hv: $ G |- v: A $):
  $ G |- holRecursionGraph A a f n v: bool $ =
'(!! allcT r (impcT (appT (appT anr holZeroT) (anwl ha)) (impcT (!! allcT previousIndex (!! allcT previousValue
  (impcT (appT (appT (anwl (anwl anr)) (anwl anr)) anr) (appT (appT (anwl (anwl anr)) (appT holSuccessorT (anwl
  anr))) (appT (appT (anwl (anwl (anwl hf))) anr) (anwl anr)))))) (appT (appT anr (anwl hn)) (anwl hv)))));

theorem holRecursionGraphCong (G: wff) (A: type) (a f n m v w: term)
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $)
  (hnumber: $ G |- (=[holNatural] n = m) $)
  (hvalue: $ G |- (=[A] v = w) $):
  $ G |- (=[bool] holRecursionGraph A a f n v = holRecursionGraph A a f m w) $ =
'(trans (mp (!! alleq r (bineq impT (refl (appT (appT anr holZeroT) (anwl (anwl ha)))) (bineq impT (refl (!! allcT
  previousIndex (!! allcT previousValue (impcT (appT (appT (anwl (anwl anr)) (anwl anr)) anr) (appT (appT (anwl
  (anwl anr)) (appT holSuccessorT (anwl anr))) (appT (appT (anwl (anwl (anwl (anwl hf)))) anr) (anwl anr))))))) (aeq
  (aeq (refl anr) (anwl anr)) (refl (anwl (anwl (eqR1 hvalue)))))))) hnumber) (mp (!! alleq r (bineq impT (refl
  (appT (appT anr holZeroT) (anwl (anwl ha)))) (bineq impT (refl (!! allcT previousIndex (!! allcT previousValue
  (impcT (appT (appT (anwl (anwl anr)) (anwl anr)) anr) (appT (appT (anwl (anwl anr)) (appT holSuccessorT (anwl
  anr))) (appT (appT (anwl (anwl (anwl (anwl hf)))) anr) (anwl anr))))))) (aeq (refl (appT anr (anwl (anwl (eqR2
  hnumber))))) (anwl anr))))) hvalue));

pub theorem holRecursionGraphElimination (G: wff) (A: type) (a f n v r: term) {previousIndex previousValue: term}
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $)
  (hn: $ G |- n: holNatural $)
  (hv: $ G |- v: A $)
  (hr: $ G |- r: (holNatural -> (A -> bool)) $)
  (h: $ G |- holRecursionGraph A a f n v $)
  (hzero: $ G |- ((r @ holZero) @ a) $)
  (hstep: $ G |- (! previousIndex: holNatural. (! previousValue: A. (((r @ previousIndex) @ previousValue) ==> ((r @ (holSuccessor @ previousIndex)) @ ((f @ previousValue) @ previousIndex))))) $):
  $ G |- ((r @ n) @ v) $ =
'(MP (MP (MP (!! spec relation4 (impcT (appT (appT anr holZeroT) (anwl ha)) (impcT (!! allcT previousIndex (!! allcT
  previousValue (impcT (appT (appT (anwl (anwl anr)) (anwl anr)) anr) (appT (appT (anwl (anwl anr)) (appT
  holSuccessorT (anwl anr))) (appT (appT (anwl (anwl (anwl hf))) anr) (anwl anr)))))) (appT (appT anr (anwl hn))
  (anwl hv)))) hr (impcT (appT (appT hr holZeroT) ha) (impcT (!! allcT previousIndex (!! allcT previousValue (impcT
  (appT (appT (anwl (anwl hr)) (anwl anr)) anr) (appT (appT (anwl (anwl hr)) (appT holSuccessorT (anwl anr))) (appT
  (appT (anwl (anwl hf)) anr) (anwl anr)))))) (appT (appT hr hn) hv))) (bineq impT (aeq (aeq anr (refl holZeroT))
  (refl (anwl ha))) (bineq impT (!! alleq previousIndex (!! alleq previousValue (bineq impT (aeq (aeq (anwl (anwl
  anr)) (refl (anwl anr))) (refl anr)) (aeq (aeq (anwl (anwl anr)) (refl (appT holSuccessorT (anwl anr)))) (refl
  (appT (appT (anwl (anwl (anwl hf))) anr) (anwl anr))))))) (aeq (aeq anr (refl (anwl hn))) (refl (anwl hv)))))) h)
  hzero) hstep);

pub theorem holRecursionGraphZero (G: wff) (A: type) (a f: term)
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $):
  $ G |- holRecursionGraph A a f holZero a $ =
'(!! GEN r (DISCH (appT (appT anr holZeroT) (anwl ha)) (impcT (!! allcT previousIndex (!! allcT previousValue (impcT
  (appT (appT (anwl (anwl anr)) (anwl anr)) anr) (appT (appT (anwl (anwl anr)) (appT holSuccessorT (anwl anr)))
  (appT (appT (anwl (anwl (anwl hf))) anr) (anwl anr)))))) (appT (appT anr holZeroT) (anwl ha))) (DISCH (syl (ian
  (anwl (anwl id)) (anwl anr)) (!! allcT previousIndex (!! allcT previousValue (impcT (appT (appT (anwl (anwl anr))
  (anwl anr)) anr) (appT (appT (anwl (anwl anr)) (appT holSuccessorT (anwl anr))) (appT (appT (anwl (anwl (anwl
  hf))) anr) (anwl anr))))))) (syl (ian (anwl (anwl id)) (anwl anr)) (appT (appT anr holZeroT) (anwl ha))) (anwl
  anr))));

pub theorem holRecursionGraphSuccessor (G: wff) (A: type) (a f n v: term)
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $)
  (hn: $ G |- n: holNatural $)
  (hv: $ G |- v: A $)
  (h: $ G |- holRecursionGraph A a f n v $):
  $ G |- holRecursionGraph A a f (holSuccessor @ n) ((f @ v) @ n) $ =
'(!! GEN r (DISCH (appT (appT anr holZeroT) (anwl ha)) (impcT (!! allcT previousIndex (!! allcT previousValue (impcT
  (appT (appT (anwl (anwl anr)) (anwl anr)) anr) (appT (appT (anwl (anwl anr)) (appT holSuccessorT (anwl anr)))
  (appT (appT (anwl (anwl (anwl hf))) anr) (anwl anr)))))) (appT (appT anr (appT holSuccessorT (anwl hn))) (appT
  (appT (anwl hf) (anwl hv)) (anwl hn)))) (DISCH (syl (ian (anwl (anwl id)) (anwl anr)) (!! allcT previousIndex (!!
  allcT previousValue (impcT (appT (appT (anwl (anwl anr)) (anwl anr)) anr) (appT (appT (anwl (anwl anr)) (appT
  holSuccessorT (anwl anr))) (appT (appT (anwl (anwl (anwl hf))) anr) (anwl anr))))))) (syl (ian (anwl (anwl id))
  (anwl anr)) (appT (appT anr (appT holSuccessorT (anwl hn))) (appT (appT (anwl hf) (anwl hv)) (anwl hn)))) (MP (MP
  (syl (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) (!! spec bound2 (impcT (appT (appT (anwl anr) (anwl (anwl
  hn))) anr) (appT (appT (anwl anr) (appT holSuccessorT (anwl (anwl hn)))) (appT (appT (anwl (anwl hf)) anr) (anwl
  (anwl hn))))) (anwl hv) (impcT (appT (appT anr (anwl hn)) (anwl hv)) (appT (appT anr (appT holSuccessorT (anwl
  hn))) (appT (appT (anwl hf) (anwl hv)) (anwl hn)))) (bineq impT (aeq (refl (appT (anwl anr) (anwl (anwl hn))))
  anr) (aeq (refl (appT (anwl anr) (appT holSuccessorT (anwl (anwl hn))))) (aeq (aeq (refl (anwl (anwl hf))) anr)
  (refl (anwl (anwl hn)))))))) (eqmp (syl (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) (aeq2 allT (!! cbv
  previousValue bound2 (impcT (appT (appT (anwl anr) (anwl (anwl hn))) anr) (appT (appT (anwl anr) (appT
  holSuccessorT (anwl (anwl hn)))) (appT (appT (anwl (anwl hf)) anr) (anwl (anwl hn))))) (impcT (appT (appT (anwl
  anr) (anwl (anwl hn))) anr) (appT (appT (anwl anr) (appT holSuccessorT (anwl (anwl hn)))) (appT (appT (anwl (anwl
  hf)) anr) (anwl (anwl hn))))) (bineq impT (aeq (refl (appT (anwl anr) (anwl (anwl hn)))) anr) (aeq (refl (appT
  (anwl anr) (appT holSuccessorT (anwl (anwl hn))))) (aeq (aeq (refl (anwl (anwl hf))) anr) (refl (anwl (anwl
  hn))))))))) (MP (syl (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) (!! spec bound1 (!! allcT previousValue
  (impcT (appT (appT (anwl (anwl anr)) (anwl anr)) anr) (appT (appT (anwl (anwl anr)) (appT holSuccessorT (anwl
  anr))) (appT (appT (anwl (anwl (anwl hf))) anr) (anwl anr))))) (anwl hn) (!! allcT previousValue (impcT (appT
  (appT (anwl anr) (anwl (anwl hn))) anr) (appT (appT (anwl anr) (appT holSuccessorT (anwl (anwl hn)))) (appT (appT
  (anwl (anwl hf)) anr) (anwl (anwl hn)))))) (!! alleq previousValue (bineq impT (aeq (aeq (refl (anwl (anwl anr)))
  (anwl anr)) (refl anr)) (aeq (aeq (refl (anwl (anwl anr))) (aeq (refl holSuccessorT) (anwl anr))) (aeq (refl (appT
  (anwl (anwl (anwl hf))) anr)) (anwl anr))))))) (eqmp (syl (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) (aeq2
  allT (!! cbv previousIndex bound1 (!! allcT previousValue (impcT (appT (appT (anwl (anwl anr)) (anwl anr)) anr)
  (appT (appT (anwl (anwl anr)) (appT holSuccessorT (anwl anr))) (appT (appT (anwl (anwl (anwl hf))) anr) (anwl
  anr))))) (!! allcT previousValue (impcT (appT (appT (anwl (anwl anr)) (anwl anr)) anr) (appT (appT (anwl (anwl
  anr)) (appT holSuccessorT (anwl anr))) (appT (appT (anwl (anwl (anwl hf))) anr) (anwl anr))))) (!! alleq
  previousValue (bineq impT (aeq (aeq (refl (anwl (anwl anr))) (anwl anr)) (refl anr)) (aeq (aeq (refl (anwl (anwl
  anr))) (aeq (refl holSuccessorT) (anwl anr))) (aeq (refl (appT (anwl (anwl (anwl hf))) anr)) (anwl anr))))))))
  anr)))) (MP (MP (MP (syl (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) (!! spec relation3 (impcT (appT (appT anr
  holZeroT) (anwl (anwl ha))) (impcT (!! allcT previousIndex (!! allcT previousValue (impcT (appT (appT (anwl (anwl
  anr)) (anwl anr)) anr) (appT (appT (anwl (anwl anr)) (appT holSuccessorT (anwl anr))) (appT (appT (anwl (anwl
  (anwl (anwl hf)))) anr) (anwl anr)))))) (appT (appT anr (anwl (anwl hn))) (anwl (anwl hv))))) anr (impcT (appT
  (appT anr holZeroT) (anwl ha)) (impcT (!! allcT previousIndex (!! allcT previousValue (impcT (appT (appT (anwl
  (anwl anr)) (anwl anr)) anr) (appT (appT (anwl (anwl anr)) (appT holSuccessorT (anwl anr))) (appT (appT (anwl
  (anwl (anwl hf))) anr) (anwl anr)))))) (appT (appT anr (anwl hn)) (anwl hv)))) (bineq impT (aeq (aeq anr (refl
  holZeroT)) (refl (anwl (anwl ha)))) (bineq impT (!! alleq previousIndex (!! alleq previousValue (bineq impT (aeq
  (aeq (anwl (anwl anr)) (refl (anwl anr))) (refl anr)) (aeq (aeq (anwl (anwl anr)) (refl (appT holSuccessorT (anwl
  anr)))) (refl (appT (appT (anwl (anwl (anwl (anwl hf)))) anr) (anwl anr))))))) (aeq (aeq anr (refl (anwl (anwl
  hn)))) (refl (anwl (anwl hv)))))))) (anwl (anwl (anwl h)))) (anwl anr)) anr)))));

pub theorem holRecursionGraphExists (G: wff) (A: type) (a f n: term) {value: term}
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $)
  (hn: $ G |- n: holNatural $):
  $ G |- (? value: A. holRecursionGraph A a f n value) $ =
'(eqmp (trans (aeq1 (!! cbv number argument11 (!! excT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf))
  (anwl anr) anr)) (!! excT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr)) (!! exeq
  value (holRecursionGraphCong (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) (refl anr)))) hn) (!! betac argument11
  (!! excT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr)) hn (!! excT value
  (holRecursionGraphT (anwl ha) (anwl hf) (anwl hn) anr)) (!! exeq value (holRecursionGraphCong (anwl (anwl ha))
  (anwl (anwl hf)) (anwl anr) (refl anr))))) (!! holNaturalInduction j hn (!! lamT number (!! excT value
  (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr))) (eqmpr (trans (aeq1 (!! cbv number
  argument6 (!! excT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr)) (!! excT value
  (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr)) (!! exeq value (holRecursionGraphCong (anwl
  (anwl ha)) (anwl (anwl hf)) (anwl anr) (refl anr)))) holZeroT) (!! betac argument6 (!! excT value
  (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr)) holZeroT (!! excT value (holRecursionGraphT
  (anwl ha) (anwl hf) holZeroT anr)) (!! exeq value (holRecursionGraphCong (anwl (anwl ha)) (anwl (anwl hf)) (anwl
  anr) (refl anr))))) (eqmpr (aeq2 exT (!! cbv value witness5 (holRecursionGraphT (anwl ha) (anwl hf) holZeroT anr)
  (holRecursionGraphT (anwl ha) (anwl hf) holZeroT anr) (holRecursionGraphCong (anwl ha) (anwl hf) (refl holZeroT)
  anr))) (!! EXISTS witness5 (holRecursionGraphT (anwl ha) (anwl hf) holZeroT anr) ha (holRecursionGraphCong (anwl
  ha) (anwl hf) (refl holZeroT) anr) (holRecursionGraphZero ha hf)))) (!! GEN j (DISCH (appT (!! lamT number (!!
  excT value (holRecursionGraphT (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) anr))) anr) (appT (!!
  lamT number (!! excT value (holRecursionGraphT (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) anr)))
  (appT holSuccessorT anr)) (eqmpr (trans (aeq1 (syl (ian (anwl (anwl id)) (anwl anr)) (!! cbv number argument10 (!!
  excT value (holRecursionGraphT (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) anr)) (!! excT value
  (holRecursionGraphT (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) anr)) (!! exeq value
  (holRecursionGraphCong (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) (refl anr))))) (syl (ian (anwl
  (anwl id)) (anwl anr)) (appT holSuccessorT anr))) (!! betac argument10 (syl (ian (ian (anwl (anwl (anwl id)))
  (anwl (anwl anr))) anr) (!! excT value (holRecursionGraphT (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl
  anr) anr))) (syl (ian (anwl (anwl id)) (anwl anr)) (appT holSuccessorT anr)) (syl (ian (anwl (anwl id)) (anwl
  anr)) (!! excT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (appT holSuccessorT (anwl anr)) anr)))
  (syl (ian (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) anr) (!! exeq value (holRecursionGraphCong (anwl (anwl
  (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) (refl anr)))))) (eqmpr (syl (ian (anwl (anwl id)) (anwl anr)) (aeq2
  exT (!! cbv value witness9 (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (appT holSuccessorT (anwl anr))
  anr) (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (appT holSuccessorT (anwl anr)) anr)
  (holRecursionGraphCong (anwl (anwl ha)) (anwl (anwl hf)) (refl (appT holSuccessorT (anwl anr))) anr)))) (!! EXISTS
  witness9 (syl (ian (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) anr) (holRecursionGraphT (anwl (anwl ha)) (anwl
  (anwl hf)) (appT holSuccessorT (anwl anr)) anr)) (syl (ian (anwl (anwl id)) (anwl anr)) (appT (appT (anwl hf)
  (appT selT (!! lamT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr)))) anr)) (syl (ian
  (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) anr) (holRecursionGraphCong (anwl (anwl ha)) (anwl (anwl hf))
  (refl (appT holSuccessorT (anwl anr))) anr)) (holRecursionGraphSuccessor (syl (ian (anwl (anwl id)) (anwl anr))
  (anwl ha)) (syl (ian (anwl (anwl id)) (anwl anr)) (anwl hf)) (syl (ian (anwl (anwl id)) (anwl anr)) anr) (syl (ian
  (anwl (anwl id)) (anwl anr)) (appT selT (!! lamT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl
  anr) anr)))) (eqmp (trans (aeq1 (syl (ian (anwl (anwl id)) (anwl anr)) (!! cbv value argument8 (holRecursionGraphT
  (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr) (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr)
  anr) (holRecursionGraphCong (anwl (anwl ha)) (anwl (anwl hf)) (refl (anwl anr)) anr))) (syl (ian (anwl (anwl id))
  (anwl anr)) (appT selT (!! lamT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr)))))
  (!! betac argument8 (syl (ian (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) anr) (holRecursionGraphT (anwl (anwl
  ha)) (anwl (anwl hf)) (anwl anr) anr)) (syl (ian (anwl (anwl id)) (anwl anr)) (appT selT (!! lamT value
  (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr)))) (syl (ian (anwl (anwl id)) (anwl anr))
  (holRecursionGraphT (anwl ha) (anwl hf) anr (appT selT (!! lamT value (holRecursionGraphT (anwl (anwl ha)) (anwl
  (anwl hf)) (anwl anr) anr))))) (syl (ian (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) anr)
  (holRecursionGraphCong (anwl (anwl ha)) (anwl (anwl hf)) (refl (anwl anr)) anr)))) (selectFromEx (syl (ian (anwl
  (anwl id)) (anwl anr)) (!! lamT value (holRecursionGraphT (anwl (anwl ha)) (anwl (anwl hf)) (anwl anr) anr)))
  (eqmp (trans (aeq1 (syl (ian (anwl (anwl id)) (anwl anr)) (!! cbv number argument7 (!! excT value
  (holRecursionGraphT (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) anr)) (!! excT value
  (holRecursionGraphT (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) anr)) (!! exeq value
  (holRecursionGraphCong (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) (refl anr))))) (syl (ian (anwl
  (anwl id)) (anwl anr)) anr)) (!! betac argument7 (syl (ian (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) anr)
  (!! excT value (holRecursionGraphT (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) anr))) (syl (ian
  (anwl (anwl id)) (anwl anr)) anr) (syl (ian (anwl (anwl id)) (anwl anr)) (!! excT value (holRecursionGraphT (anwl
  (anwl ha)) (anwl (anwl hf)) (anwl anr) anr))) (syl (ian (ian (anwl (anwl (anwl id))) (anwl (anwl anr))) anr) (!!
  exeq value (holRecursionGraphCong (anwl (anwl (anwl ha))) (anwl (anwl (anwl hf))) (anwl anr) (refl anr))))))
  anr)))))))))));

pub theorem holRecursionGraphZeroUnique (G: wff) (A: type) (a f v: term)
  (ha: $ G |- a: A $)
  (hf: $ G |- f: (A -> (holNatural -> A)) $)
  (hv: $ G |- v: A $)
  (h: $ G |- holRecursionGraph A a f holZero v $):
  $ G |- (=[A] v = a) $ =
'(MP (eqmp (trans (aeq1 (trans (aeq1 (!! cbv inputIndex argument16 (!! lamT inputValue (impcT (eqcT (anwl anr)
  holZeroT) (eqcT anr (anwl (anwl ha))))) (!! lamT inputValue (impcT (eqcT (anwl anr) holZeroT) (eqcT anr (anwl
  (anwl ha))))) (!! leq inputValue (bineq impT (bineq eqT (anwl anr) (refl holZeroT)) (refl (eqcT anr (anwl (anwl
  ha))))))) holZeroT) (!! betac argument16 (!! lamT inputValue (impcT (eqcT (anwl anr) holZeroT) (eqcT anr (anwl
  (anwl ha))))) holZeroT (!! lamT inputValue (impcT (eqcT holZeroT holZeroT) (eqcT anr (anwl ha)))) (!! leq
  inputValue (bineq impT (bineq eqT (anwl anr) (refl holZeroT)) (refl (eqcT anr (anwl (anwl ha)))))))) hv) (trans
